fn display_court_backlog(bl: CourtBacklogSnapshot, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Court Backlog ===\n"));
    let mut line: Str(256) = Str::from("Pending: ");
    line.append(bl.pending_sessions as Str(16));
    line.append(Str::from("  Active: "));
    line.append(bl.active_sessions as Str(16));
    line.append(Str::from("  Completed: "));
    line.append(bl.completed_sessions as Str(16));
    line.append(Str::from("\n"));
    console.write(line);

