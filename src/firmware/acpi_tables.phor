// ──────────────────────────────────────────────
// MADT Entry: Interrupt Source Override (ISO)
// ──────────────────────────────────────────────

pub type MADT_ISO : struct {
    entry_type: u8,
    record_length: u8,
    bus_source: u8,
    irq_source: u8,
    global_system_interrupt: Word32,
    flags: Word16,
}

impl MADT_ISO {
    pub fn new() -> MADT_ISO
        effects: [deterministic]
    {
        MADT_ISO {
            entry_type: MADT_TYPE_INT_OVERRIDE,
            record_length: 10,
            bus_source: 0,
            irq_source: 0,
            global_system_interrupt: 0,
            flags: 0,
        }
    }

    pub fn is_active_high(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x02) == 0
    }

    pub fn is_level_triggered(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x08) != 0
    }

    pub fn original_irq(self) -> u8
        effects: [deterministic]
    {
        self.irq_source
    }

    pub fn global_interrupt(self) -> Word32
        effects: [deterministic]
    {
        self.global_system_interrupt
    }
}

