// court_viewer.phor — Court proceeding viewer and trust analysis
//
// Demonstrates:
//   - Live court session monitoring with state tracking
//   - Verdict history with timeline navigation
//   - Oracle comparison viewer for byte/structure/divergent modes
//   - Trust promotion timeline visualization
//   - Divergence analysis display with classification
//   - Evidence chain graph with hierarchical display
//   - Court residual recording at each step
//   - Bounded loops and fixed-capacity collections
//
// Expected behavior:
//   - Monitors court sessions through full lifecycle
//   - Displays verdict history with timestamps
//   - Shows oracle comparison results for multiple modes
//   - Visualizes trust ladder progression over time
//   - Classifies and displays divergences with root cause
//   - Renders evidence chain as hierarchical graph
//   - All operations bounded, effect-declared, residual-recorded
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:court_viewer:v1.0";

const MAX_SESSIONS: u64 = 32;
const MAX_VERDICTS: u64 = 64;
const MAX_EVIDENCE: u64 = 128;
const MAX_DIVERGENCES: u64 = 32;
const MAX_SAMPLES: u64 = 64;
const MAX_CHAIN_DEPTH: u64 = 10;
const MAX_COMPARISON_MODES: u64 = 4;
const MAX_TIMELINE_EVENTS: u64 = 128;
const MAX_PROMOTION_STEPS: u64 = 8;

enum VerdictType : u8 {
    Accept = 0,
    Reject = 1,
    Pending = 2,
    RequiresReview = 3,
}

enum ComparisonMode : u8 {
    ByteIdentical = 0,
    StructurallyEquivalent = 1,
    KnownDrift = 2,
    Divergent = 3,
}

enum TrustLadder : u8 {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

struct CourtSessionMonitor {
    session_id: u64,
    object_id: u64,
    oracle_name: Str(32),
    status: u8,
    opened: u64,
    evidence_submitted: u64,
    replay_done: bool,
    comparison_done: bool,
    verdict: VerdictType,
    trust_before: TrustLadder,
    trust_after: TrustLadder,
    closed: bool,
}

struct VerdictRecord {
    verdict_id: u64,
    session_id: u64,
    object_id: u64,
    verdict: VerdictType,
    trust_before: TrustLadder,
    trust_after: TrustLadder,
    comparison_mode: ComparisonMode,
    timestamp: u64,
    oracle: Str(32),
    evidence_count: u64,
}

struct OracleComparisonResult {
    session_id: u64,
    mode: ComparisonMode,
    match_percent: u64,
    total_bytes: u64,
    matching_bytes: u64,
    diverging_bytes: u64,
    structurally_different: bool,
    timestamp_diff: u64,
    details: Str(128),
}

struct DivergenceInfo {
    divergence_id: u64,
    session_id: u64,
    offset: u64,
    expected: u64,
    actual: u64,
    classification: Str(32),
    severity: u8,
    description: Str(128),
    resolved: bool,
}

struct TrustPromotionEvent {
    event_id: u64,
    object_id: u64,
    from_state: TrustLadder,
    to_state: TrustLadder,
    timestamp: u64,
    method: Str(32),
    session_id: u64,
}

struct EvidenceChainNode {
    node_id: u64,
    parent_id: u64,
    evidence_type: Str(24),
    hash: u64,
    verified: bool,
    depth: u64,
    description: Str(128),
    children: Array(u64, 16),
    child_count: u64,
}

struct CourtViewerState {
    sessions: Array(CourtSessionMonitor, 32),
    session_count: u64,
    verdicts: Array(VerdictRecord, 64),
    verdict_count: u64,
    divergences: Array(DivergenceInfo, 32),
    divergence_count: u64,
    promotions: RingBuf(TrustPromotionEvent, 128),
    evidence_chain: Array(EvidenceChainNode, 128),
    chain_count: u64,
    current_session: u64,
}

const VERDICT_ACCEPT: u8 = 0;
const VERDICT_REJECT: u8 = 1;
const VERDICT_PENDING: u8 = 2;
const VERDICT_REVIEW: u8 = 3;

fn get_verdict_name(v: VerdictType) -> Str(16)
    effect [compute]
{
    match v {
        VerdictType::Accept => return Str::from("Accept"),
        VerdictType::Reject => return Str::from("Reject"),
        VerdictType::Pending => return Str::from("Pending"),
        VerdictType::RequiresReview => return Str::from("Review"),
        _ => return Str::from("Unknown"),
    }
}

fn get_trust_name(t: TrustLadder) -> Str(20)
    effect [compute]
{
    match t {
        TrustLadder::Unknown => return Str::from("Unknown"),
        TrustLadder::Observed => return Str::from("Observed"),
        TrustLadder::Replayed => return Str::from("Replayed"),
        TrustLadder::OracleCompared => return Str::from("OracleCmp"),
        TrustLadder::ResidualStable => return Str::from("ResidualStable"),
        TrustLadder::Sealed => return Str::from("Sealed"),
        TrustLadder::Promoted => return Str::from("Promoted"),
        _ => return Str::from("Unknown"),
    }
}

fn get_comparison_name(m: ComparisonMode) -> Str(24)
    effect [compute]
{
    match m {
        ComparisonMode::ByteIdentical => return Str::from("ByteIdentical"),
        ComparisonMode::StructurallyEquivalent => return Str::from("StructEquivalent"),
        ComparisonMode::KnownDrift => return Str::from("KnownDrift"),
        ComparisonMode::Divergent => return Str::from("Divergent"),
        _ => return Str::from("Unknown"),
    }
}

fn render_trust_ladder_visual(t: TrustLadder) -> Str(32)
    effect [compute]
{
    let mut result: Str(32) = Str::from("[");
    let labels: Array(Str(3), 7) = Array::splat(Str::from(""));
    labels[0] = Str::from("U");
    labels[1] = Str::from("O");
    labels[2] = Str::from("R");
    labels[3] = Str::from("C");
    labels[4] = Str::from("S");
    labels[5] = Str::from("L");
    labels[6] = Str::from("P");

    let tv: u64 = t as u64;
    for i in 0..7 {
        if i <= tv {
            result.append(labels[i]);
        } else {
            result.append(Str::from("-"));
        }
        if i < 6 {
            result.append(Str::from("|"));
        }
    }
    result.append(Str::from("]"));
    return result;
}

fn create_court_session(object_id: u64, oracle: Str(32), session_id: u64) -> CourtSessionMonitor
    effect [court:request, residual]
{
    let monitor: CourtSessionMonitor = CourtSessionMonitor{
        session_id: session_id,
        object_id: object_id,
        oracle_name: oracle,
        status: 0,
        opened: 1000,
        evidence_submitted: 0,
        replay_done: false,
        comparison_done: false,
        verdict: VerdictType::Pending,
        trust_before: TrustLadder::Unknown,
        trust_after: TrustLadder::Unknown,
        closed: false,
    };

    residual emit {
        op: "court_viewer.session_open",
        session: session_id,
        object: object_id,
        oracle: oracle,
    };

    return monitor;
}

fn submit_court_evidence(mut session: CourtSessionMonitor, count: u64) -> CourtSessionMonitor
    effect [court:request, residual]
{
    session.evidence_submitted = session.evidence_submitted + count;

    residual emit {
        op: "court_viewer.evidence",
        session: session.session_id,
        count: count,
        total: session.evidence_submitted,
    };

    return session;
}

fn run_court_replay(mut session: CourtSessionMonitor) -> CourtSessionMonitor
    effect [court:request, residual]
{
    session.replay_done = true;

    residual emit {
        op: "court_viewer.replay",
        session: session.session_id,
        status: "completed",
    };

    return session;
}

fn compare_with_oracle_court(mut session: CourtSessionMonitor, mode: ComparisonMode) -> CourtSessionMonitor
    effect [court:request, residual]
{
    session.comparison_done = true;

    residual emit {
        op: "court_viewer.compare",
        session: session.session_id,
        mode: mode as u64,
    };

    return session;
}

fn issue_court_verdict(mut session: CourtSessionMonitor, verdict: VerdictType,
                        trust_before: TrustLadder, trust_after: TrustLadder) -> CourtSessionMonitor
    effect [court:request, residual]
{
    session.verdict = verdict;
    session.trust_before = trust_before;
    session.trust_after = trust_after;

    residual emit {
        op: "court_viewer.verdict",
        session: session.session_id,
        verdict: verdict as u64,
        trust_before: trust_before as u64,
        trust_after: trust_after as u64,
    };

    return session;
}

fn close_court_session(mut session: CourtSessionMonitor) -> CourtSessionMonitor
    effect [court:request, residual]
{
    session.closed = true;

    residual emit {
        op: "court_viewer.session_close",
        session: session.session_id,
        final_verdict: session.verdict as u64,
    };

    return session;
}

fn build_oracle_comparison(session: CourtSessionMonitor, mode: ComparisonMode,
                            total: u64, matching: u64, diverging: u64) -> OracleComparisonResult
    effect [compute]
{
    let match_pct: u64 = if total > 0 { (matching * 100) / total } else { 0 };
    let result: OracleComparisonResult = OracleComparisonResult{
        session_id: session.session_id,
        mode: mode,
        match_percent: match_pct,
        total_bytes: total,
        matching_bytes: matching,
        diverging_bytes: diverging,
        structurally_different: false,
        timestamp_diff: 0,
        details: Str::from(""),
    };
    return result;
}

fn classify_divergence(offset: u64, expected: u64, actual: u64) -> DivergenceInfo
    effect [compute]
{
    let classification: Str(32);
    let severity: u8;
    let diff: u64 = if expected > actual { expected - actual } else { actual - expected };

    if expected == actual {
        classification = Str::from("no_divergence");
        severity = 0;
    } else if diff < 256 {
        classification = Str::from("byte_mutation");
        severity = 1;
    } else if diff < 65536 {
        classification = Str::from("block_mismatch");
        severity = 2;
    } else {
        classification = Str::from("structure_change");
        severity = 3;
    }

    let desc: Str(128) = Str::from("");
    let info: DivergenceInfo = DivergenceInfo{
        divergence_id: 0,
        session_id: 0,
        offset: offset,
        expected: expected,
        actual: actual,
        classification: classification,
        severity: severity,
        description: desc,
        resolved: false,
    };
    return info;
}

fn analyze_divergences(result: OracleComparisonResult,
                        expected_bytes: Array(u8, 64), actual_bytes: Array(u8, 64)) -> Array(DivergenceInfo, 32)
    effect [compute]
{
    let divergences: Array(DivergenceInfo, 32) = Array::splat(
        DivergenceInfo{ divergence_id: 0, session_id: 0, offset: 0,
                        expected: 0, actual: 0, classification: Str::from(""),
                        severity: 0, description: Str::from(""), resolved: false }
    );
    let mut div_count: u64 = 0;

    for i in 0..result.total_bytes {
        if i >= 64 || i >= actual_bytes.capacity() || i >= expected_bytes.capacity() { break; }
        if expected_bytes[i] != actual_bytes[i] && div_count < 32 {
            let info: DivergenceInfo = classify_divergence(
                i, expected_bytes[i] as u64, actual_bytes[i] as u64
            );
            divergences[div_count] = info;
            div_count = div_count + 1;
        }
    }
    return divergences;
}

fn create_trust_promotion_event(object_id: u64, from_state: TrustLadder, to_state: TrustLadder,
                                 method: Str(32), session_id: u64, event_id: u64) -> TrustPromotionEvent
    effect [residual]
{
    let event: TrustPromotionEvent = TrustPromotionEvent{
        event_id: event_id,
        object_id: object_id,
        from_state: from_state,
        to_state: to_state,
        timestamp: 1000,
        method: method,
        session_id: session_id,
    };

    residual emit {
        op: "court_viewer.promotion",
        object: object_id,
        from: from_state as u64,
        to: to_state as u64,
        method: method,
    };

    return event;
}

fn display_session_monitor(session: CourtSessionMonitor, console: Cap(Console)) -> void
    effect [io:write]
{
    let mut line: Str(256) = Str::from("Session ");
    line.append(session.session_id as Str(16));
    line.append(Str::from(": "));
    if session.closed {
        line.append(Str::from("CLOSED"));
    } else {
        line.append(Str::from("ACTIVE"));
    }
    line.append(Str::from("  Object: "));
    line.append(session.object_id as Str(16));
    line.append(Str::from("  Oracle: "));
    line.append(session.oracle_name);
    line.append(Str::from("\n"));
    console.write(line);

    let mut line2: Str(256) = Str::from("  Evidence: ");
    line2.append(session.evidence_submitted as Str(16));
    line2.append(Str::from("  Replay: "));
    if session.replay_done { line2.append(Str::from("done")); }
    else { line2.append(Str::from("pending")); }
    line2.append(Str::from("  Compare: "));
    if session.comparison_done { line2.append(Str::from("done")); }
    else { line2.append(Str::from("pending")); }
    line2.append(Str::from("\n"));
    console.write(line2);

    let trust_before: Str(20) = get_trust_name(session.trust_before);
    let trust_after: Str(20) = get_trust_name(session.trust_after);
    let mut line3: Str(256) = Str::from("  Trust: ");
    line3.append(trust_before);
    line3.append(Str::from(" -> "));
    line3.append(trust_after);
    line3.append(Str::from("\n"));
    console.write(line3);
}

fn display_verdict_history(verdicts: Array(VerdictRecord, 64), count: u64,
                            console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Verdict History ===\n"));
    let header: Str(128) = Str::from("ID  Session  Object  Verdict    Trust  Mode            Timestamp\n");
    console.write(header);

    for i in 0..count {
        let rec: VerdictRecord = verdicts[i];
        if rec.verdict_id == 0 { break; }
        let vname: Str(16) = get_verdict_name(rec.verdict);
        let tname: Str(20) = get_trust_name(rec.trust_after);
        let mname: Str(24) = get_comparison_name(rec.comparison_mode);
        let mut line: Str(256) = Str::from("");
        line.append(rec.verdict_id as Str(16));
        line.append(Str::from("  "));
        line.append(rec.session_id as Str(16));
        line.append(Str::from("       "));
        line.append(rec.object_id as Str(16));
        line.append(Str::from("  "));
        line.append(vname);
        line.append(Str::from("  "));
        line.append(tname);
        line.append(Str::from("  "));
        line.append(mname);
        line.append(Str::from("  "));
        line.append(rec.timestamp as Str(16));
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn display_oracle_comparison(result: OracleComparisonResult, console: Cap(Console)) -> void
    effect [io:write]
{
    let mode_name: Str(24) = get_comparison_name(result.mode);
    let mut line: Str(256) = Str::from("=== Oracle Comparison: ");
    line.append(mode_name);
    line.append(Str::from(" ===\n"));
    console.write(line);

    let mut line2: Str(256) = Str::from("Match: ");
    line2.append(result.match_percent as Str(16));
    line2.append(Str::from("% ("));
    line2.append(result.matching_bytes as Str(16));
    line2.append(Str::from("/"));
    line2.append(result.total_bytes as Str(16));
    line2.append(Str::from(" bytes)\n"));
    console.write(line2);

    let mut line3: Str(256) = Str::from("Diverging: ");
    line3.append(result.diverging_bytes as Str(16));
    line3.append(Str::from(" bytes\n"));
    console.write(line3);

    if result.mode == ComparisonMode::ByteIdentical {
        let is_identical: bool = result.match_percent == 100;
        if is_identical {
            console.write(Str::from("Status: BYTE-IDENTICAL - Strong positive trust\n"));
        } else {
            console.write(Str::from("Status: MISMATCH - Divergence detected\n"));
        }
    } else if result.mode == ComparisonMode::StructurallyEquivalent {
        console.write(Str::from("Status: Structurally equivalent (non-semantic differences)\n"));
    } else if result.mode == ComparisonMode::KnownDrift {
        console.write(Str::from("Status: Known drift - documented and acceptable\n"));
    } else if result.mode == ComparisonMode::Divergent {
        console.write(Str::from("Status: DIVERGENT - Requires investigation\n"));
    }
}

fn display_divergences(divs: Array(DivergenceInfo, 32), count: u64, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Divergence Analysis ===\n"));

    if count == 0 {
        console.write(Str::from("No divergences detected.\n"));
        return;
    }

    for i in 0..count {
        let d: DivergenceInfo = divs[i];
        if d.offset == 0 && d.expected == 0 && d.actual == 0 { break; }
        let mut line: Str(256) = Str::from("");
        line.append(Str::from("  ["));
        line.append(d.classification);
        line.append(Str::from("] @ offset "));
        line.append(d.offset as Str(16));
        line.append(Str::from(": expected 0x"));
        line.append(d.expected as Str(16));
        line.append(Str::from(", actual 0x"));
        line.append(d.actual as Str(16));
        line.append(Str::from("  severity="));
        line.append(d.severity as Str(16));
        if d.resolved {
            line.append(Str::from(" [resolved]"));
        }
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn display_trust_timeline(events: RingBuf(TrustPromotionEvent, 128), console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Trust Promotion Timeline ===\n"));
    let total: u64 = events.len();

    for i in 0..total {
        let e: TrustPromotionEvent = events[i];
        let from_name: Str(20) = get_trust_name(e.from_state);
        let to_name: Str(20) = get_trust_name(e.to_state);
        let from_vis: Str(32) = render_trust_ladder_visual(e.from_state);
        let to_vis: Str(32) = render_trust_ladder_visual(e.to_state);

        let mut line: Str(512) = Str::from("");
        line.append(e.event_id as Str(16));
        line.append(Str::from(". @"));
        line.append(e.timestamp as Str(16));
        line.append(Str::from("  obj="));
        line.append(e.object_id as Str(16));
        line.append(Str::from("  "));
        line.append(from_name);
        line.append(Str::from(" "));
        line.append(from_vis);
        line.append(Str::from(" -> "));
        line.append(to_name);
        line.append(Str::from(" "));
        line.append(to_vis);
        line.append(Str::from("  via "));
        line.append(e.method);
        line.append(Str::from(" (session "));
        line.append(e.session_id as Str(16));
        line.append(Str::from(")\n"));
        console.write(line);
    }
}

fn display_evidence_chain(chain: Array(EvidenceChainNode, 128), count: u64,
                           console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Evidence Chain Graph ===\n"));

    for i in 0..count {
        let node: EvidenceChainNode = chain[i];
        if node.node_id == 0 { break; }

        let mut indent: Str(32) = Str::from("");
        for d in 0..node.depth {
            indent.append(Str::from("  "));
        }

        let mut line: Str(256) = Str::from("");
        line.append(indent);
        line.append(Str::from("+-- "));
        line.append(node.evidence_type);
        line.append(Str::from(" ("));
        line.append(node.node_id as Str(16));
        line.append(Str::from(") hash="));
        line.append(node.hash as Str(16));
        if node.verified {
            line.append(Str::from(" [OK]"));
        } else {
            line.append(Str::from(" [??]"));
        }
        line.append(Str::from("  "));
        line.append(node.description);
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn build_evidence_chain(object_id: u64, session_id: u64) -> Array(EvidenceChainNode, 128)
    effect [court:request]
{
    let chain: Array(EvidenceChainNode, 128) = Array::splat(
        EvidenceChainNode{ node_id: 0, parent_id: 0, evidence_type: Str::from(""),
                           hash: 0, verified: false, depth: 0,
                           description: Str::from(""), children: Array::splat(0),
                           child_count: 0 }
    );
    let mut count: u64 = 0;

    let root: EvidenceChainNode = EvidenceChainNode{
        node_id: 1001, parent_id: 0, evidence_type: Str::from("root"),
        hash: 0xAAAAAAAA, verified: true, depth: 0,
        description: Str::from("Court session evidence root"),
        children: Array::splat(0), child_count: 2,
    };
    root.children[0] = 1002;
    root.children[1] = 1003;
    chain[0] = root;
    count = 1;

    let compile_ev: EvidenceChainNode = EvidenceChainNode{
        node_id: 1002, parent_id: 1001, evidence_type: Str::from("compile"),
        hash: 0xBBBBBBBB, verified: true, depth: 1,
        description: Str::from("Compilation receipts"),
        children: Array::splat(0), child_count: 3,
    };
    compile_ev.children[0] = 1004;
    compile_ev.children[1] = 1005;
    compile_ev.children[2] = 1006;
    chain[1] = compile_ev;
    count = 2;

    let oracle_ev: EvidenceChainNode = EvidenceChainNode{
        node_id: 1003, parent_id: 1001, evidence_type: Str::from("oracle"),
        hash: 0xCCCCCCCC, verified: true, depth: 1,
        description: Str::from("Oracle comparison results"),
        children: Array::splat(0), child_count: 1,
    };
    oracle_ev.children[0] = 1007;
    chain[2] = oracle_ev;
    count = 3;

    let parse_rec: EvidenceChainNode = EvidenceChainNode{
        node_id: 1004, parent_id: 1002, evidence_type: Str::from("parse"),
        hash: 0xDDDDDDDD, verified: true, depth: 2,
        description: Str::from("Parse phase receipt"),
        children: Array::splat(0), child_count: 0,
    };
    chain[3] = parse_rec;
    count = 4;

    let lower_rec: EvidenceChainNode = EvidenceChainNode{
        node_id: 1005, parent_id: 1002, evidence_type: Str::from("lower"),
        hash: 0xEEEEEEEE, verified: true, depth: 2,
        description: Str::from("Lower phase receipt"),
        children: Array::splat(0), child_count: 0,
    };
    chain[4] = lower_rec;
    count = 5;

    let codegen_rec: EvidenceChainNode = EvidenceChainNode{
        node_id: 1006, parent_id: 1002, evidence_type: Str::from("codegen"),
        hash: 0xFFFFFFFF, verified: true, depth: 2,
        description: Str::from("Codegen phase receipt"),
        children: Array::splat(0), child_count: 0,
    };
    chain[5] = codegen_rec;
    count = 6;

    let compare_rec: EvidenceChainNode = EvidenceChainNode{
        node_id: 1007, parent_id: 1003, evidence_type: Str::from("compare"),
        hash: 0xABCD1234, verified: true, depth: 2,
        description: Str::from("Oracle comparison result"),
        children: Array::splat(0), child_count: 0,
    };
    chain[6] = compare_rec;
    count = 7;

    return chain;
}

fn analyze_promotion_path(initial: TrustLadder, final_state: TrustLadder) -> u64
    effect [compute]
{
    let initial_val: u64 = initial as u64;
    let final_val: u64 = final_state as u64;
    if final_val > initial_val {
        return final_val - initial_val;
    }
    return 0;
}

fn divergence_severity_counts(divs: Array(DivergenceInfo, 32), count: u64) -> Array(u64, 4)
    effect [compute]
{
    let counts: Array(u64, 4) = Array::splat(0);
    for i in 0..count {
        let d: DivergenceInfo = divs[i];
        if d.offset == 0 && d.expected == 0 && d.actual == 0 { break; }
        let sev: u64 = d.severity as u64;
        if sev < 4 {
            counts[sev] = counts[sev] + 1;
        }
    }
    return counts;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, court:request, residual]
{
    console.write(Str::from("Court Proceeding Viewer v1.0\n"));
    console.write(Str::from("============================\n"));

    // Step 1: Create and monitor court sessions
    console.write(Str::from("\n--- Live Court Session Monitoring ---\n"));
    let mut session1: CourtSessionMonitor = create_court_session(
        0xAABB, Str::from("reference-phc-v2.0.0"), 5001
    );
    session1 = submit_court_evidence(session1, 5);
    session1 = run_court_replay(session1);
    session1 = compare_with_oracle_court(session1, ComparisonMode::ByteIdentical);
    session1 = issue_court_verdict(session1, VerdictType::Accept,
        TrustLadder::Observed, TrustLadder::Promoted);
    session1 = close_court_session(session1);
    display_session_monitor(session1, console);
    assert(session1.closed, "cv: session 1 closed");

    // Step 2: Create a divergent session
    let mut session2: CourtSessionMonitor = create_court_session(
        0xCCDD, Str::from("reference-phc-v1.0.0"), 5002
    );
    session2 = submit_court_evidence(session2, 3);
    session2 = run_court_replay(session2);
    session2 = compare_with_oracle_court(session2, ComparisonMode::Divergent);
    session2 = issue_court_verdict(session2, VerdictType::Reject,
        TrustLadder::Observed, TrustLadder::Observed);
    session2 = close_court_session(session2);
    display_session_monitor(session2, console);
    assert(session2.verdict == VerdictType::Reject, "cv: session 2 rejected");

    // Step 3: Build verdict history
    let verdicts: Array(VerdictRecord, 64) = Array::splat(
        VerdictRecord{ verdict_id: 0, session_id: 0, object_id: 0,
                       verdict: VerdictType::Pending, trust_before: TrustLadder::Unknown,
                       trust_after: TrustLadder::Unknown, comparison_mode: ComparisonMode::ByteIdentical,
                       timestamp: 0, oracle: Str::from(""), evidence_count: 0 }
    );
    verdicts[0] = VerdictRecord{
        verdict_id: 1, session_id: 5001, object_id: 0xAABB,
        verdict: VerdictType::Accept, trust_before: TrustLadder::Observed,
        trust_after: TrustLadder::Promoted, comparison_mode: ComparisonMode::ByteIdentical,
        timestamp: 1000, oracle: Str::from("reference-phc-v2.0.0"), evidence_count: 5,
    };
    verdicts[1] = VerdictRecord{
        verdict_id: 2, session_id: 5002, object_id: 0xCCDD,
        verdict: VerdictType::Reject, trust_before: TrustLadder::Observed,
        trust_after: TrustLadder::Observed, comparison_mode: ComparisonMode::Divergent,
        timestamp: 1005, oracle: Str::from("reference-phc-v1.0.0"), evidence_count: 3,
    };
    display_verdict_history(verdicts, 2, console);

    // Step 4: Display oracle comparisons
    console.write(Str::from("\n--- Oracle Comparison Viewer ---\n"));
    let comp1: OracleComparisonResult = build_oracle_comparison(session1, ComparisonMode::ByteIdentical, 1024, 1024, 0);
    display_oracle_comparison(comp1, console);
    assert(comp1.match_percent == 100, "cv: byte-identical 100% match");

    let comp2: OracleComparisonResult = build_oracle_comparison(session2, ComparisonMode::Divergent, 1024, 890, 134);
    display_oracle_comparison(comp2, console);
    assert(comp2.diverging_bytes == 134, "cv: 134 diverging bytes");

    // Step 5: Divergence analysis
    let expected_bytes: Array(u8, 64) = Array::splat(0x41);
    let actual_bytes: Array(u8, 64) = Array::splat(0x41);
    actual_bytes[10] = 0x42;
    actual_bytes[20] = 0x43;
    actual_bytes[100] = 0xFF;

    let divergences: Array(DivergenceInfo, 32) = analyze_divergences(comp2, expected_bytes, actual_bytes);
    let div_count: u64 = divergences.len();
    display_divergences(divergences, div_count, console);
    assert(div_count > 0, "cv: divergences detected");

    let sev_counts: Array(u64, 4) = divergence_severity_counts(divergences, div_count);

    // Step 6: Trust promotion timeline
    console.write(Str::from("\n--- Trust Promotion Timeline ---\n"));
    let mut promotions: RingBuf(TrustPromotionEvent, 128) = RingBuf::new();
    let p1: TrustPromotionEvent = create_trust_promotion_event(
        0xAABB, TrustLadder::Unknown, TrustLadder::Observed,
        Str::from("first_compile"), 5001, 1
    );
    promotions.push(p1);
    let p2: TrustPromotionEvent = create_trust_promotion_event(
        0xAABB, TrustLadder::Observed, TrustLadder::Replayed,
        Str::from("replay"), 5001, 2
    );
    promotions.push(p2);
    let p3: TrustPromotionEvent = create_trust_promotion_event(
        0xAABB, TrustLadder::Replayed, TrustLadder::OracleCompared,
        Str::from("oracle_compare"), 5001, 3
    );
    promotions.push(p3);
    let p4: TrustPromotionEvent = create_trust_promotion_event(
        0xAABB, TrustLadder::OracleCompared, TrustLadder::Promoted,
        Str::from("court_verdict_accept"), 5001, 4
    );
    promotions.push(p4);
    display_trust_timeline(promotions, console);
    assert(promotions.len() == 4, "cv: 4 promotion events");

    // Step 7: Evidence chain graph
    console.write(Str::from("\n--- Evidence Chain Graph ---\n"));
    let chain: Array(EvidenceChainNode, 128) = build_evidence_chain(0xAABB, 5001);
    let chain_count: u64 = 7;
    display_evidence_chain(chain, chain_count, console);
    assert(chain_count >= 3, "cv: evidence chain has multiple nodes");

    // Step 8: Analyze promotion path
    let steps: u64 = analyze_promotion_path(TrustLadder::Unknown, TrustLadder::Promoted);
    assert(steps == 6, "cv: promotion from Unknown to Promoted = 6 steps");

    // Final
    console.write(Str::from("\n=== All court viewer displays complete ===\n"));

    residual emit {
        op: "court_viewer.complete",
        sessions_monitored: 2,
        verdicts_shown: 2,
        comparisons_shown: 2,
        divergences_found: div_count,
        promotions_tracked: promotions.len(),
        chain_nodes: chain_count,
    };
}
