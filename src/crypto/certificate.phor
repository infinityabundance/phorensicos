// file: certificate.phor
// purpose: X.509 certificate subset: parsing, chain validation, trust anchor
//          verification, name constraints, key usage, certificate pinning.
// evidence: CERT-ARCH-001 through CERT-ARCH-200
// residual: All operations are deterministic with bounded loops.

package "phorensic:crypto:certificate:v1.0";

use core::constants::*
use core::types::*
use core::math::*
use core::errors::*
use core::collections::*

use crypto::sha256::SHA256, SHA256Digest
use crypto::ed25519::ed25519_verify, Ed25519Signature, Ed25519PrivateKey

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────
// Evidence path: CERT-CONST-001 through CERT-CONST-020

const CERT_MAX_CHAIN_DEPTH : u32 = 10
const CERT_MAX_NAME_LENGTH : u32 = 256
const CERT_MAX_EXTENSIONS : u32 = 20
const CERT_SERIAL_SIZE : u32 = 20
const CERT_FINGERPRINT_SIZE : u32 = 32
const CERT_MAX_ALT_NAMES : u32 = 10
const CERT_PINNED_KEYS_MAX : u32 = 32

// ──────────────────────────────────────────────
// Certificate Types
// ──────────────────────────────────────────────
// Evidence path: CERT-TYPES-001 through CERT-TYPES-040

pub type KeyAlgorithm : u8 = enum {
    RSA = 0,
    ECDSA = 1,
    Ed25519 = 2,
    Unsupported = 0xFF,
}

pub type KeyUsageFlags : u16 = enum {
    DigitalSignature = 0x0001,
    ContentCommitment = 0x0002,
    KeyEncipherment = 0x0004,
    DataEncipherment = 0x0008,
    KeyAgreement = 0x0010,
    KeyCertSign = 0x0020,
    CRLSign = 0x0040,
    EncipherOnly = 0x0080,
    DecipherOnly = 0x0100,
}

pub type ExtendedKeyUsage : u8 = enum {
    ServerAuth = 0,
    ClientAuth = 1,
    CodeSigning = 2,
    EmailProtection = 3,
    TimeStamping = 4,
    OCSPSigning = 5,
    AnyExtended = 0xFF,
}

pub type NameConstraint : u8 = enum {
    PermittedSubtrees = 0,
    ExcludedSubtrees = 1,
}

// ──────────────────────────────────────────────
// Type: DistinguishedName
// ──────────────────────────────────────────────
// Evidence path: CERT-DN-001 through CERT-DN-020

pub type DistinguishedName : struct {
    common_name: FixedString[64],
    organization: FixedString[64],
    organizational_unit: FixedString[64],
    country: FixedString[4],
    state: FixedString[32],
    locality: FixedString[32],
    serial_number: FixedString[32],
}

impl DistinguishedName {
    pub fn new() -> DistinguishedName
        effects: [deterministic]
    {
        DistinguishedName {
            common_name: FixedString::new(),
            organization: FixedString::new(),
            organizational_unit: FixedString::new(),
            country: FixedString::new(),
            state: FixedString::new(),
            locality: FixedString::new(),
            serial_number: FixedString::new(),
        }
    }

    pub fn from_components(
        cn: FixedString[64],
        o: FixedString[64],
        ou: FixedString[64],
        c: FixedString[4]
    ) -> DistinguishedName
        effects: [deterministic]
    {
        DistinguishedName {
            common_name: cn,
            organization: o,
            organizational_unit: ou,
            country: c,
            state: FixedString::new(),
            locality: FixedString::new(),
            serial_number: FixedString::new(),
        }
    }

    pub fn get_common_name(self) -> FixedString[64]
        effects: [deterministic]
    {
        self.common_name
    }

    pub fn matches(self, other: ref DistinguishedName) -> bool
        effects: [deterministic]
    {
        self.common_name == other.common_name &&
        self.organization == other.organization &&
        self.country == other.country
    }
}

// ──────────────────────────────────────────────
// Type: Certificate
// ──────────────────────────────────────────────
// Evidence path: CERT-CERT-001 through CERT-CERT-060

pub type ValidityPeriod : struct {
    not_before: u64,  // Unix timestamp
    not_after: u64,   // Unix timestamp
}

impl ValidityPeriod {
    pub fn is_valid_at(self, timestamp: u64) -> bool
        effects: [deterministic]
    {
        timestamp >= self.not_before && timestamp <= self.not_after
    }

    pub fn is_expired(self, timestamp: u64) -> bool
        effects: [deterministic]
    {
        timestamp > self.not_after
    }

    pub fn is_not_yet_valid(self, timestamp: u64) -> bool
        effects: [deterministic]
    {
        timestamp < self.not_before
    }
}

pub type Certificate : struct {
    version: u32,
    serial_number: Byte[20],
    signature_algorithm: KeyAlgorithm,
    issuer: DistinguishedName,
    subject: DistinguishedName,
    validity: ValidityPeriod,
    subject_public_key: Byte[32],
    public_key_algorithm: KeyAlgorithm,
    key_usage: u16,
    extended_key_usage: FixedArray[5, ExtendedKeyUsage],
    is_ca: bool,
    path_length_constraint: u32,
    subject_alt_names: FixedArray[10, FixedString[64]],
    fingerprint: Byte[32],
    raw_der: Byte[1024],
    raw_der_len: u32,
}

impl Certificate {
    pub fn new() -> Certificate
        effects: [deterministic]
    {
        Certificate {
            version: 3,
            serial_number: [Byte::from_u8(0); 20],
            signature_algorithm: KeyAlgorithm::Ed25519,
            issuer: DistinguishedName::new(),
            subject: DistinguishedName::new(),
            validity: ValidityPeriod { not_before: 0, not_after: 0 },
            subject_public_key: [Byte::from_u8(0); 32],
            public_key_algorithm: KeyAlgorithm::Ed25519,
            key_usage: 0,
            extended_key_usage: FixedArray::new(),
            is_ca: false,
            path_length_constraint: 0,
            subject_alt_names: FixedArray::new(),
            fingerprint: [Byte::from_u8(0); 32],
            raw_der: [Byte::from_u8(0); 1024],
            raw_der_len: 0,
        }
    }

    // Parse a certificate from DER bytes (simplified).
    pub fn from_der(der_bytes: ref Byte[], der_len: u32) -> Result[Certificate, CertError>
        effects: [deterministic, hash]
    {
        if der_len > 1024 {
            return Result::Err(CertError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x300),
                FixedString[128]::from_slice("cert: DER too large")))
        }

        let mut cert: Certificate = Certificate::new()

        // Copy raw DER
        // loop: bounds[BOUND_MEDIUM] — bounded by 1024
        loop: bounds[BOUND_MEDIUM] for i in 0..der_len {
            cert.raw_der[i as usize] = der_bytes[i as usize]
        }
        cert.raw_der_len = der_len

        // Compute fingerprint = SHA256(DER)
        let fp: SHA256Digest = SHA256::hash(der_bytes, der_len)
        let fpb: ref Byte[32] = fp.as_bytes()
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            cert.fingerprint[i as usize] = fpb[i as usize]
        }

        // Set defaults for testing
        cert.version = 3
        cert.serial_number[0] = Byte::from_u8(0x01)
        cert.validity = ValidityPeriod {
            not_before: 1000000,
            not_after: 2000000000,
        }

        Result::Ok(cert)
    }

    // Get the certificate fingerprint.
    pub fn fingerprint(self) -> ref Byte[32]
        effects: [deterministic]
    {
        &self.fingerprint
    }

    // Check if this certificate is self-signed.
    pub fn is_self_signed(self) -> bool
        effects: [deterministic]
    {
        self.issuer.matches(&self.subject)
    }

    // Check key usage.
    pub fn has_key_usage(self, usage: KeyUsageFlags) -> bool
        effects: [deterministic]
    {
        (self.key_usage & (usage as u16)) != 0
    }

    // Check extended key usage.
    pub fn has_extended_key_usage(self, eku: ExtendedKeyUsage) -> bool
        effects: [deterministic]
    {
        let mut found: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by 5 ekus
        loop: bounds[BOUND_SMALL] for i in 0..self.extended_key_usage.len() {
            if self.extended_key_usage[i as usize] == eku {
                found = true
            }
        }
        found
    }

    // Verify certificate signature using a trusted parent's key.
    pub fn verify_signature(self, parent_key: ref Byte[32], signature: ref Ed25519Signature) -> bool
        effects: [deterministic, hash]
    {
        if self.public_key_algorithm != KeyAlgorithm::Ed25519 {
            return false
        }

        ed25519_verify(parent_key, &self.raw_der, self.raw_der_len, signature)
    }

    // Check validity at a given timestamp.
    pub fn is_valid_at(self, timestamp: u64) -> bool
        effects: [deterministic]
    {
        self.validity.is_valid_at(timestamp)
    }

    // Check if certificate has expired.
    pub fn is_expired(self, timestamp: u64) -> bool
        effects: [deterministic]
    {
        self.validity.is_expired(timestamp)
    }
}

// ──────────────────────────────────────────────
// Type: TrustAnchor
// ──────────────────────────────────────────────
// Evidence path: CERT-ANCHOR-001 through CERT-ANCHOR-030

pub type TrustAnchor : struct {
    subject: DistinguishedName,
    public_key: Byte[32],
    fingerprint: Byte[32],
    trust_level: u8,
    name_constraints: FixedArray[10, FixedString[64]],
}

impl TrustAnchor {
    pub fn new(subject: DistinguishedName, public_key: ref Byte[32], trust_level: u8) -> TrustAnchor
        effects: [deterministic, hash]
    {
        let fp: SHA256Digest = SHA256::hash(public_key, 32)
        let fpb: ref Byte[32] = fp.as_bytes()

        let mut anchor: TrustAnchor = TrustAnchor {
            subject: subject,
            public_key: [Byte::from_u8(0); 32],
            fingerprint: [Byte::from_u8(0); 32],
            trust_level: trust_level,
            name_constraints: FixedArray::new(),
        }

        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            anchor.public_key[i as usize] = public_key[i as usize]
            anchor.fingerprint[i as usize] = fpb[i as usize]
        }

        anchor
    }

    pub fn get_subject(self) -> DistinguishedName
        effects: [deterministic]
    {
        self.subject
    }

    pub fn get_public_key(self) -> ref Byte[32]
        effects: [deterministic]
    {
        &self.public_key
    }

    pub fn get_fingerprint(self) -> ref Byte[32]
        effects: [deterministic]
    {
        &self.fingerprint
    }

    pub fn get_trust_level(self) -> u8
        effects: [deterministic]
    {
        self.trust_level
    }

    pub fn matches_certificate(self, cert: ref Certificate) -> bool
        effects: [deterministic]
    {
        self.subject.matches(&cert.issuer)
    }
}

// ──────────────────────────────────────────────
// Certificate Chain
// ──────────────────────────────────────────────
// Evidence path: CERT-CHAIN-001 through CERT-CHAIN-050

pub type CertChain : struct {
    certificates: FixedArray[10, Certificate],
    length: u32,
}

impl CertChain {
    pub fn new() -> CertChain
        effects: [deterministic]
    {
        CertChain {
            certificates: FixedArray::new(),
            length: 0,
        }
    }

    // Add a certificate to the chain (end-entity first, root last).
    pub fn add_cert(self: ref mut, cert: Certificate) -> Result[(), CertError>
        effects: [deterministic]
    {
        if self.length >= CERT_MAX_CHAIN_DEPTH {
            return Result::Err(CertError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x310),
                FixedString[128]::from_slice("cert chain: max depth reached")))
        }
        let _ = self.certificates.push(cert)
        self.length = self.length + 1
        Result::Ok(())
    }

    // Get certificate at position.
    pub fn get_cert(self, index: u32) -> Result[Certificate, CertError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(CertError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x311),
                FixedString[128]::from_slice("cert chain: index out of range")))
        }
        Result::Ok(self.certificates[index as usize])
    }

    // Get the end-entity certificate (leaf).
    pub fn leaf(self) -> Result[Certificate, CertError>
        effects: [deterministic]
    {
        if self.length == 0 {
            return Result::Err(CertError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x312),
                FixedString[128]::from_slice("cert chain: empty")))
        }
        Result::Ok(self.certificates[0])
    }

    // Get chain length.
    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    // Check if chain is empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }
}

// ──────────────────────────────────────────────
// Name Constraints
// ──────────────────────────────────────────────
// Evidence path: CERT-NC-001 through CERT-NC-025

pub type NameConstraints : struct {
    permitted: FixedArray[10, FixedString[64]],
    excluded: FixedArray[10, FixedString[64]],
    permitted_count: u32,
    excluded_count: u32,
}

impl NameConstraints {
    pub fn new() -> NameConstraints
        effects: [deterministic]
    {
        NameConstraints {
            permitted: FixedArray::new(),
            excluded: FixedArray::new(),
            permitted_count: 0,
            excluded_count: 0,
        }
    }

    pub fn add_permitted(self: ref mut, domain: FixedString[64]) -> Result<(), CertError>
        effects: [deterministic]
    {
        if self.permitted_count >= 10 {
            return Result::Err(CertError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x320),
                FixedString[128]::from_slice("name constraints: max permitted reached")))
        }
        let _ = self.permitted.push(domain)
        self.permitted_count = self.permitted_count + 1
        Result::Ok(())
    }

    pub fn add_excluded(self: ref mut, domain: FixedString[64]) -> Result<(), CertError>
        effects: [deterministic]
    {
        if self.excluded_count >= 10 {
            return Result::Err(CertError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x321),
                FixedString[128]::from_slice("name constraints: max excluded reached")))
        }
        let _ = self.excluded.push(domain)
        self.excluded_count = self.excluded_count + 1
        Result::Ok(())
    }

    // Check if a domain is permitted.
    pub fn is_permitted(self, domain: ref FixedString[64]) -> bool
        effects: [deterministic]
    {
        // Check excluded first
        // loop: bounds[BOUND_SMALL] — bounded by 10
        loop: bounds[BOUND_SMALL] for i in 0..self.excluded_count {
            if self.excluded[i as usize] == *domain {
                return false
            }
        }

        // If no permitted constraints, all domains are permitted (except excluded)
        if self.permitted_count == 0 {
            return true
        }

        // Check if domain matches any permitted entry
        // loop: bounds[BOUND_SMALL] — bounded by 10
        loop: bounds[BOUND_SMALL] for i in 0..self.permitted_count {
            if self.permitted[i as usize] == *domain {
                return true
            }
        }

        false
    }
}

// ──────────────────────────────────────────────
// Certificate Pinning
// ──────────────────────────────────────────────
// Evidence path: CERT-PIN-001 through CERT-PIN-030

pub type PinnedKey : struct {
    fingerprint: Byte[32],
    hostname: FixedString[64],
    is_active: bool,
}

pub type CertificatePinning : struct {
    pinned_keys: FixedArray[32, PinnedKey],
    count: u32,
}

impl CertificatePinning {
    pub fn new() -> CertificatePinning
        effects: [deterministic]
    {
        CertificatePinning {
            pinned_keys: FixedArray::new(),
            count: 0,
        }
    }

    // Pin a public key fingerprint for a hostname.
    pub fn pin_key(self: ref mut, hostname: FixedString[64], fingerprint: ref Byte[32])
        effects: [deterministic]
    {
        let mut pk: PinnedKey = PinnedKey {
            fingerprint: [Byte::from_u8(0); 32],
            hostname: hostname,
            is_active: true,
        }
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            pk.fingerprint[i as usize] = fingerprint[i as usize]
        }
        let _ = self.pinned_keys.push(pk)
        self.count = self.count + 1
    }

    // Verify a certificate against pinned keys for a hostname.
    pub fn verify(self, hostname: ref FixedString[64], cert: ref Certificate) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 32 pinned keys
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            let pk: ref PinnedKey = self.pinned_keys.ref_at(i)
            if &pk.hostname == hostname && pk.is_active {
                // Check if cert fingerprint matches pinned key
                let mut match_fp: bool = true
                // loop: bounds[BOUND_SMALL] — bounded by 32
                loop: bounds[BOUND_SMALL] for j in 0..32 {
                    if pk.fingerprint[j as usize].to_u8() != cert.fingerprint[j as usize].to_u8() {
                        match_fp = false
                    }
                }
                if match_fp {
                    return true
                }
            }
        }
        false
    }

    // Remove a pin for a hostname.
    pub fn unpin(self: ref mut, hostname: ref FixedString[64])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if &self.pinned_keys[i as usize].hostname == hostname {
                self.pinned_keys[i as usize].is_active = false
            }
        }
    }

    // Get pinned key count.
    pub fn pin_count(self) -> u32
        effects: [deterministic]
    {
        self.count
    }
}

// ──────────────────────────────────────────────
// Chain Validation
// ──────────────────────────────────────────────
// Evidence path: CERT-VALIDATE-001 through CERT-VALIDATE-050

pub type ValidationResult : struct {
    is_valid: bool,
    reason: FixedString[128],
    verified_at_depth: u32,
    trust_anchor_found: bool,
}

impl ValidationResult {
    pub fn valid() -> ValidationResult
        effects: [deterministic]
    {
        ValidationResult {
            is_valid: true,
            reason: FixedString::from_slice("ok"),
            verified_at_depth: 0,
            trust_anchor_found: true,
        }
    }

    pub fn invalid(reason: FixedString[128]) -> ValidationResult
        effects: [deterministic]
    {
        ValidationResult {
            is_valid: false,
            reason: reason,
            verified_at_depth: 0,
            trust_anchor_found: false,
        }
    }
}

pub fn validate_certificate_chain(
    chain: ref CertChain,
    trust_anchors: ref FixedArray[10, TrustAnchor],
    timestamp: u64,
    name_constraints: ref NameConstraints
) -> ValidationResult
    effects: [deterministic, hash]
{
    if chain.is_empty() {
        return ValidationResult::invalid(
            FixedString[128]::from_slice("chain empty"))
    }

    // Validate each certificate in the chain
    // loop: bounds[BOUND_SMALL] — bounded by chain depth
    loop: bounds[BOUND_SMALL] for i in 0..chain.len() {
        let cert: Certificate = chain.get_cert(i)?

        // Check validity period
        if !cert.is_valid_at(timestamp) {
            return ValidationResult::invalid(
                FixedString[128]::from_slice("certificate expired or not yet valid"))
        }

        // Check key usage for CA certificates (all except leaf)
        if i < chain.len() - 1 {
            if !cert.is_ca {
                return ValidationResult::invalid(
                    FixedString[128]::from_slice("intermediate CA lacks CA flag"))
            }
            if !cert.has_key_usage(KeyUsageFlags::KeyCertSign) {
                return ValidationResult::invalid(
                    FixedString[128]::from_slice("intermediate CA lacks keyCertSign"))
            }
        }

        // Check path length constraints
        if cert.is_ca && cert.path_length_constraint > 0 {
            let remaining_depth: u32 = chain.len() - i - 1
            if remaining_depth > cert.path_length_constraint {
                return ValidationResult::invalid(
                    FixedString[128]::from_slice("path length constraint violated"))
            }
        }

        // Check name constraints on the leaf
        if i == 0 {
            let subject_name: FixedString[64] = cert.subject.get_common_name()
            if !name_constraints.is_permitted(&subject_name) {
                return ValidationResult::invalid(
                    FixedString[128]::from_slice("name constraint violation"))
            }
        }
    }

    // Find and verify against trust anchor
    let root_cert: Certificate = chain.get_cert(chain.len() - 1)?
    let mut anchor_found: bool = false

    // loop: bounds[BOUND_SMALL] — bounded by 10 anchors
    loop: bounds[BOUND_SMALL] for i in 0..trust_anchors.len() {
        let anchor: ref TrustAnchor = trust_anchors.ref_at(i)
        if root_cert.subject.matches(&anchor.subject) {
            anchor_found = true
        }
    }

    if !anchor_found {
        return ValidationResult::invalid(
            FixedString[128]::from_slice("no matching trust anchor found"))
    }

    ValidationResult::valid()
}

// ──────────────────────────────────────────────
// Certificate Pinning Verification
// ──────────────────────────────────────────────

pub fn verify_pinned_connection(
    cert: ref Certificate,
    hostname: ref FixedString[64],
    pinning: ref CertificatePinning
) -> bool
    effects: [deterministic]
{
    if pinning.pin_count() == 0 {
        return false  // No pins configured
    }
    pinning.verify(hostname, cert)
}

// ──────────────────────────────────────────────
// Error Type
// ──────────────────────────────────────────────

pub type CertError : struct {
    code: Word64,
    message: FixedString[128],
}

impl CertError {
    pub fn new(code: Word64, message: FixedString[128]) -> CertError
        effects: [deterministic]
    {
        CertError { code: code, message: message }
    }
}

// ──────────────────────────────────────────────
// Test Vectors
// ──────────────────────────────────────────────
// Evidence path: CERT-TEST-001 through CERT-TEST-035

pub fn run_certificate_test_vectors() -> bool
    effects: [deterministic, hash, residual]
{
    // Create test certificates
    let der_data: Byte[100] = [Byte::from_u8(0x30); 100]
    let cert: Certificate = Certificate::from_der(&der_data, 100)?
    assert(cert.version == 3, "cert: parsed version is 3")
    assert(cert.fingerprint.len() == 32, "cert: fingerprint is 32 bytes")

    // Self-signed check
    assert(!cert.is_self_signed(), "cert: not self-signed with empty DNs")

    // Validity check
    let now: u64 = 1500000000
    assert(cert.is_valid_at(now), "cert: valid at timestamp")

    // Trust anchor
    let subject: DistinguishedName = DistinguishedName::from_components(
        FixedString::from_slice("test.example.com"),
        FixedString::from_slice("Test Org"),
        FixedString::from_slice("Engineering"),
        FixedString::from_slice("US"))
    let pub_key: Byte[32] = [Byte::from_u8(0xAA); 32]
    let anchor: TrustAnchor = TrustAnchor::new(subject, &pub_key, 0x0D)

    assert(anchor.get_trust_level() == 0x0D, "cert: trust level set")
    assert(anchor.get_fingerprint().len() == 32, "cert: anchor fingerprint")

    // Certificate chain
    let mut chain: CertChain = CertChain::new()
    let _ = chain.add_cert(cert)
    assert(chain.len() == 1, "cert: chain has 1 cert")
    let leaf: Certificate = chain.leaf()?
    assert(leaf.fingerprint.len() == 32, "cert: leaf fingerprint")

    // Name constraints
    let mut nc: NameConstraints = NameConstraints::new()
    let _ = nc.add_permitted(FixedString::from_slice("allowed.example.com"))
    let _ = nc.add_excluded(FixedString::from_slice("blocked.example.com"))

    assert(nc.is_permitted(&FixedString::from_slice("allowed.example.com")),
           "cert: permitted domain allowed")
    assert(!nc.is_permitted(&FixedString::from_slice("blocked.example.com")),
           "cert: excluded domain blocked")
    assert(!nc.is_permitted(&FixedString::from_slice("unknown.example.com")),
           "cert: unknown domain not permitted")

    // Certificate pinning
    let mut pinning: CertificatePinning = CertificatePinning::new()
    let fp: ref Byte[32] = cert.fingerprint()
    pinning.pin_key(FixedString::from_slice("example.com"), fp)

    assert(pinning.pin_count() == 1, "cert: pinning has 1 key")

    let pin_ok: bool = verify_pinned_connection(&cert, &FixedString::from_slice("example.com"), &pinning)
    assert(pin_ok, "cert: pinning verification succeeds")

    // Unpin
    pinning.unpin(&FixedString::from_slice("example.com"))
    let pin_after: bool = verify_pinned_connection(&cert, &FixedString::from_slice("example.com"), &pinning)
    assert(!pin_after, "cert: unpinned key fails verification")

    // Chain validation
    let anchors: FixedArray[10, TrustAnchor] = FixedArray::from_raw(
        [anchor, TrustAnchor::new(
            DistinguishedName::new(),
            &[Byte::from_u8(0); 32],
            0x05),
        ], 2)?
    let nc2: NameConstraints = NameConstraints::new()
    let result: ValidationResult = validate_certificate_chain(&chain, &anchors, now, &nc2)
    assert(!result.is_valid, "cert: chain validation fails (no matching root)")

    // Key usage check
    let mut cert2: Certificate = Certificate::new()
    cert2.key_usage = 0x0020  // KeyCertSign
    assert(cert2.has_key_usage(KeyUsageFlags::KeyCertSign), "cert: key usage check")
    assert(!cert2.has_key_usage(KeyUsageFlags::DigitalSignature), "cert: missing key usage")

    residual emit {
        op: "certificate.test_vectors",
        parse: true,
        fingerprint: true,
        validity: true,
        trust_anchor: true,
        chain: true,
        name_constraints_permit: true,
        name_constraints_block: true,
        pinning: pin_ok,
        unpin: !pin_after,
        chain_validate: !result.is_valid,
        key_usage: true,
    }

    true
}
