    line.append(cap.total_caps as Str(16));
    line.append(Str::from("  Sessions: "));
    line.append(cap.session_count as Str(16));
    line.append(Str::from("  Types: "));
    line.append(cap.type_count as Str(16));
    line.append(Str::from("\n"));
    console.write(line);

    let mut line2: Str(256) = Str::from("Granted: ");
    line2.append(cap.total_granted as Str(16));
    line2.append(Str::from("  Derived: "));
    line2.append(cap.total_derived as Str(16));
    line2.append(Str::from("  Revoked: "));
    line2.append(cap.total_revoked as Str(16));
    line2.append(Str::from("  Transferred: "));
    line2.append(cap.total_transferred as Str(16));
