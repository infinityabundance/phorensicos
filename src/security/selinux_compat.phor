// selinux_compat.phor — SELinux Dialect Cage Compatibility
//
// Provides:
//   - SELinux policy parsing (context, type enforcement, roles)
//   - Context translation to Phorensic capabilities
//   - AVC (Access Vector Cache) simulation
//   - Denial residualization for SELinux-compatible audit
//   - Type enforcement rule evaluation
//   - Security context computation and validation
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every security decision produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:selinux_compat:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_SELINUX_USERS: u64 = 128;
const MAX_SELINUX_ROLES: u64 = 64;
const MAX_SELINUX_TYPES: u64 = 512;
const MAX_SELINUX_CLASSES: u64 = 64;
const MAX_SELINUX_PERMISSIONS: u64 = 256;
const MAX_SELINUX_RULES: u64 = 2048;
const MAX_AVC_ENTRIES: u64 = 1024;
const MAX_SECONTEXT_STR_LEN: u64 = 256;
const MAX_SELINUX_CONDITIONS: u64 = 64;
const MAX_AVC_CACHE_ENTRIES: u64 = 256;
const MAX_DENIAL_RESIDUALS: u64 = 512;
const MAX_POLICY_CAPABILITIES: u64 = 32;
const MAX_DOMAIN_TRANSITIONS: u64 = 128;
const MAX_CONSTRAINT_RULES: u64 = 128;
const MAX_TYPE_ATTRIBUTES: u64 = 64;
const MAX_CONTEXT_COMPONENTS: u64 = 5;
const MAX_SID_TABLE_SIZE: u64 = 1024;
const MAX_AVC_STATS_BUCKETS: u64 = 16;
const MAX_BOOLEAN_CONDITIONS: u64 = 32;

effect selinux:parse;
effect selinux:translate;
effect selinux:avc;
effect selinux:enforce;

// ──────────────────────────────────────────────
// SELinux Types
// ──────────────────────────────────────────────

enum SELinuxDecision {
    Allow,
    DontAudit,
    AuditAllow,
    DontDontAudit,
    Deny,
    Error,
}

enum AVCState {
    Active,
    Expired,
    Validating,
    Invalid,
    Cached,
}

enum SELinuxClass {
    File,
    Dir,
    Socket,
    IPC,
    Process,
    Capability,
    Security,
    System,
    Netlink,
    Node,
    Netif,
    Association,
    Binder,
    Service,
    Database,
}

enum ContextValidationResult {
    Valid,
    InvalidUser,
    InvalidRole,
    InvalidType,
    InvalidRange,
    MLSMismatch,
    ConstraintViolation,
}

// ──────────────────────────────────────────────
// SELinux Data Structures
// ──────────────────────────────────────────────

struct SELinuxUser {
    user_id: u64,
    name: Str(64),
    default_role: u64,
    roles_count: u64,
    roles: Array(u64, MAX_SELINUX_ROLES),
    mls_level: u64,
    mls_range: u64,
    enabled: bool,
}

struct SELinuxRole {
    role_id: u64,
    name: Str(64),
    types_count: u64,
    types: Array(u64, MAX_SELINUX_TYPES),
    dominates: u64,
}

struct SELinuxType {
    type_id: u64,
    name: Str(64),
    attributes_count: u64,
    attributes: Array(u64, MAX_TYPE_ATTRIBUTES),
    alias_count: u64,
    aliases: Array(u64, MAX_TYPE_ATTRIBUTES),
    is_domain: bool,
    default_context: u64,
}

struct SELinuxClassDef {
    class_id: u64,
    name: Str(64),
    permissions_count: u64,
    permissions: Array(u64, MAX_SELINUX_PERMISSIONS),
    default_allow: bool,
}

struct SELinuxPermission {
    perm_id: u64,
    name: Str(64),
    class_id: u64,
    value: u64,
}

struct SELinuxRule {
    rule_id: u64,
    source_type: u64,
    target_type: u64,
    class_id: u64,
    permission_set: u64,
    decision: SELinuxDecision,
    conditional: bool,
    boolean_id: u64,
    enabled: bool,
    priority: u64,
}

struct SecurityContext {
    user_id: u64,
    role_id: u64,
    type_id: u64,
    mls_level: u64,
    mls_category: u64,
    raw: Str(MAX_SECONTEXT_STR_LEN),
    validated: bool,
    validation_result: ContextValidationResult,
}

struct AVCEntry {
    cache_id: u64,
    source_context: SecurityContext,
    target_context: SecurityContext,
    class_id: u64,
    requested_perms: u64,
    decision: SELinuxDecision,
    state: AVCState,
    hit_count: u64,
    last_access: u64,
    audit_required: bool,
    residual_emitted: bool,
}

struct DenialResidual {
    residual_id: u64,
    timestamp: u64,
    source_secctx: SecurityContext,
    target_secctx: SecurityContext,
    class_id: u64,
    permission: u64,
    denied_by_rule: u64,
    audit_message: Str(256),
    residual_hash: Array(u8, 32),
    correlated_event: u64,
}

struct ConstraintRule {
    constraint_id: u64,
    source_type: u64,
    target_type: u64,
    class_id: u64,
    permission_set: u64,
    expression: u64,
    enabled: bool,
}

struct DomainTransition {
    trans_id: u64,
    from_type: u64,
    to_type: u64,
    class_id: u64,
    entry_point: u64,
    allowed: bool,
    auto_transition: bool,
}

struct SELinuxPolicy {
    user_count: u64,
    users: Array(SELinuxUser, MAX_SELINUX_USERS),
    role_count: u64,
    roles: Array(SELinuxRole, MAX_SELINUX_ROLES),
    type_count: u64,
    types: Array(SELinuxType, MAX_SELINUX_TYPES),
    class_count: u64,
    classes: Array(SELinuxClassDef, MAX_SELINUX_CLASSES),
    perm_count: u64,
    permissions: Array(SELinuxPermission, MAX_SELINUX_PERMISSIONS),
    rule_count: u64,
    rules: Array(SELinuxRule, MAX_SELINUX_RULES),
    constraint_count: u64,
    constraints: Array(ConstraintRule, MAX_CONSTRAINT_RULES),
    trans_count: u64,
    transitions: Array(DomainTransition, MAX_DOMAIN_TRANSITIONS),
    avc_entries: Array(AVCEntry, MAX_AVC_ENTRIES),
    avc_count: u64,
    denial_residuals: Array(DenialResidual, MAX_DENIAL_RESIDUALS),
    denial_count: u64,
    policy_version: u64,
    policy_name: Str(64),
}

// ──────────────────────────────────────────────
// Security Context Operations
// ──────────────────────────────────────────────

fn create_security_context(
    user_id: u64,
    role_id: u64,
    type_id: u64,
    level: u64,
    category: u64,
) -> SecurityContext
    effect [selinux:parse, compute, residual]
{
    residual emit {
        op: "selinux.context_create",
        user: user_id,
        role: role_id,
        type: type_id,
        level: level,
        category: category,
    };

    return SecurityContext{
        user_id: user_id,
        role_id: role_id,
        type_id: type_id,
        mls_level: level,
        mls_category: category,
        raw: Str::from(""),
        validated: false,
        validation_result: ContextValidationResult::Valid,
    };
}

fn format_security_context(ctx: SecurityContext) -> Str(MAX_SECONTEXT_STR_LEN)
    effect [compute]
{
    let mut result: Str(MAX_SECONTEXT_STR_LEN) = Str::from("user:");
    let _: bool = result.append(Str::from(":role:type:s0"));
    return result;
}

fn parse_security_context(raw: Str(MAX_SECONTEXT_STR_LEN)) -> SecurityContext
    effect [selinux:parse, compute]
{
    let ctx: SecurityContext = SecurityContext{
        user_id: 0,
        role_id: 0,
        type_id: 0,
        mls_level: 0,
        mls_category: 0,
        raw: raw,
        validated: false,
        validation_result: ContextValidationResult::Valid,
    };
    return ctx;
}

fn validate_security_context(
    ctx: SecurityContext,
    policy: SELinuxPolicy,
) -> ContextValidationResult
    effect [selinux:parse, compute]
{
    let mut user_found: bool = false;
    for i in 0..policy.user_count {
        if policy.users[i].user_id == ctx.user_id && policy.users[i].enabled {
            user_found = true;
            break;
        }
    }
    if !user_found {
        return ContextValidationResult::InvalidUser;
    }

    let mut role_found: bool = false;
    for i in 0..policy.role_count {
        if policy.roles[i].role_id == ctx.role_id {
            role_found = true;
            break;
        }
    }
    if !role_found {
        return ContextValidationResult::InvalidRole;
    }

    let mut type_found: bool = false;
    for i in 0..policy.type_count {
        if policy.types[i].type_id == ctx.type_id {
            type_found = true;
            break;
        }
    }
    if !type_found {
        return ContextValidationResult::InvalidType;
    }

    return ContextValidationResult::Valid;
}

fn context_to_capability_mask(ctx: SecurityContext) -> u64
    effect [selinux:translate, compute]
{
    let mut mask: u64 = 0;
    if ctx.mls_level >= 3 {
        mask = mask | 0x01;
    }
    if ctx.role_id == 1 {
        mask = mask | 0x02;
    }
    if ctx.type_id < 100 {
        mask = mask | 0x04;
    }
    return mask;
}

fn contexts_are_compatible(a: SecurityContext, b: SecurityContext) -> bool
    effect [compute]
{
    if a.mls_level > b.mls_level {
        return false;
    }
    return true;
}

fn dom_relationship(src: SecurityContext, tgt: SecurityContext) -> bool
    effect [compute]
{
    return src.mls_level >= tgt.mls_level;
}

// ──────────────────────────────────────────────
// Type Enforcement Rules
// ──────────────────────────────────────────────

fn evaluate_te_rule(
    rule: SELinuxRule,
    source_type: u64,
    target_type: u64,
    class_id: u64,
    perm_set: u64,
) -> bool
    effect [selinux:enforce, compute]
{
    if !rule.enabled {
        return false;
    }
    if rule.source_type != source_type && rule.source_type != 0 {
        return false;
    }
    if rule.target_type != target_type && rule.target_type != 0 {
        return false;
    }
    if rule.class_id != class_id && rule.class_id != 0 {
        return false;
    }
    if rule.permission_set & perm_set == 0 {
        return false;
    }
    return true;
}

fn find_applicable_rules(
    policy: SELinuxPolicy,
    source_type: u64,
    target_type: u64,
    class_id: u64,
    perm_set: u64,
) -> Array(SELinuxRule, MAX_SELINUX_RULES)
    effect [selinux:enforce, compute]
{
    let mut matching: Array(SELinuxRule, MAX_SELINUX_RULES) = Array::zeroed();
    let mut match_count: u64 = 0;

    for i in 0..policy.rule_count {
        let rule: SELinuxRule = policy.rules[i];
        if evaluate_te_rule(rule, source_type, target_type, class_id, perm_set) {
            if match_count < MAX_SELINUX_RULES {
                matching[match_count] = rule;
                match_count = match_count + 1;
            }
        }
    }
    return matching;
}

fn type_enforcement_decision(
    policy: SELinuxPolicy,
    source_type: u64,
    target_type: u64,
    class_id: u64,
    perm_set: u64,
) -> SELinuxDecision
    effect [selinux:enforce, compute, residual]
{
    let mut final_decision: SELinuxDecision = SELinuxDecision::Deny;

    for i in 0..policy.rule_count {
        let rule: SELinuxRule = policy.rules[i];
        if !rule.enabled {
            continue;
        }
        if evaluate_te_rule(rule, source_type, target_type, class_id, perm_set) {
            if rule.decision == SELinuxDecision::Allow || rule.decision == SELinuxDecision::AuditAllow {
                final_decision = SELinuxDecision::Allow;
            } else if rule.decision == SELinuxDecision::DontAudit {
                if final_decision != SELinuxDecision::Allow {
                    final_decision = SELinuxDecision::DontAudit;
                }
            }
        }
    }

    residual emit {
        op: "selinux.te_decision",
        source: source_type,
        target: target_type,
        class: class_id,
        perms: perm_set,
        decision: final_decision as u8,
    };

    return final_decision;
}

fn check_contraint_rules(
    policy: SELinuxPolicy,
    source_type: u64,
    target_type: u64,
    class_id: u64,
    perm_set: u64,
) -> bool
    effect [selinux:enforce, compute]
{
    for i in 0..policy.constraint_count {
        let c: ConstraintRule = policy.constraints[i];
        if !c.enabled {
            continue;
        }
        if c.class_id != class_id {
            continue;
        }
        if c.permission_set & perm_set == 0 {
            continue;
        }
        if c.source_type == source_type && c.target_type == target_type {
            return false;
        }
    }
    return true;
}

// ──────────────────────────────────────────────
// AVC (Access Vector Cache)
// ──────────────────────────────────────────────

fn avc_lookup(
    policy: SELinuxPolicy,
    source: SecurityContext,
    target: SecurityContext,
    class_id: u64,
    perm_set: u64,
) -> (AVCEntry, bool)
    effect [selinux:avc, compute]
{
    let mut found: bool = false;
    let mut entry: AVCEntry = AVCEntry{
        cache_id: 0,
        source_context: source,
        target_context: target,
        class_id: class_id,
        requested_perms: perm_set,
        decision: SELinuxDecision::Deny,
        state: AVCState::Active,
        hit_count: 0,
        last_access: 0,
        audit_required: true,
        residual_emitted: false,
    };

    for i in 0..policy.avc_count {
        let cached: AVCEntry = policy.avc_entries[i];
        if cached.source_context.type_id == source.type_id &&
           cached.target_context.type_id == target.type_id &&
           cached.class_id == class_id &&
           cached.requested_perms == perm_set &&
           cached.state == AVCState::Active {
            entry = cached;
            entry.hit_count = entry.hit_count + 1;
            found = true;
            break;
        }
    }

    return (entry, found);
}

fn avc_insert(
    policy: SELinuxPolicy,
    source: SecurityContext,
    target: SecurityContext,
    class_id: u64,
    perm_set: u64,
    decision: SELinuxDecision,
) -> SELinuxPolicy
    effect [selinux:avc, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.avc_count < MAX_AVC_ENTRIES {
        let entry: AVCEntry = AVCEntry{
            cache_id: updated.avc_count + 1,
            source_context: source,
            target_context: target,
            class_id: class_id,
            requested_perms: perm_set,
            decision: decision,
            state: AVCState::Active,
            hit_count: 1,
            last_access: 0,
            audit_required: true,
            residual_emitted: false,
        };
        updated.avc_entries[updated.avc_count] = entry;
        updated.avc_count = updated.avc_count + 1;

        residual emit {
            op: "selinux.avc_insert",
            entry: updated.avc_count - 1,
            source: source.type_id,
            target: target.type_id,
            class: class_id,
            decision: decision as u8,
        };
    }
    return updated;
}

fn avc_invalidate_entry(policy: SELinuxPolicy, cache_id: u64) -> SELinuxPolicy
    effect [selinux:avc, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    for i in 0..updated.avc_count {
        if updated.avc_entries[i].cache_id == cache_id {
            updated.avc_entries[i].state = AVCState::Invalid;

            residual emit {
                op: "selinux.avc_invalidate",
                entry: cache_id,
            };
            break;
        }
    }
    return updated;
}

fn avc_flush(policy: SELinuxPolicy) -> SELinuxPolicy
    effect [selinux:avc, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    updated.avc_count = 0;
    updated.avc_entries = Array::zeroed();

    residual emit {
        op: "selinux.avc_flush",
    };

    return updated;
}

fn avc_stats(policy: SELinuxPolicy) -> (u64, u64, u64)
    effect [selinux:avc, compute]
{
    let mut total_hits: u64 = 0;
    let mut active_entries: u64 = 0;
    let mut invalid_entries: u64 = 0;

    for i in 0..policy.avc_count {
        total_hits = total_hits + policy.avc_entries[i].hit_count;
        match policy.avc_entries[i].state {
            AVCState::Active => {
                active_entries = active_entries + 1;
            },
            AVCState::Invalid => {
                invalid_entries = invalid_entries + 1;
            },
            _ => {},
        }
    }

    return (total_hits, active_entries, invalid_entries);
}

// ──────────────────────────────────────────────
// SELinux Access Decision
// ──────────────────────────────────────────────

fn compute_access_decision(
    policy: SELinuxPolicy,
    source_ctx: SecurityContext,
    target_ctx: SecurityContext,
    class_id: u64,
    perm_set: u64,
) -> (SELinuxDecision, DenialResidual)
    effect [selinux:enforce, selinux:avc, compute, residual]
{
    let (cached_entry, found): (AVCEntry, bool) = avc_lookup(
        policy, source_ctx, target_ctx, class_id, perm_set,
    );

    let decision: SELinuxDecision = if found {
        cached_entry.decision
    } else {
        let te_decision: SELinuxDecision = type_enforcement_decision(
            policy, source_ctx.type_id, target_ctx.type_id, class_id, perm_set,
        );

        let constraints_pass: bool = check_contraint_rules(
            policy, source_ctx.type_id, target_ctx.type_id, class_id, perm_set,
        );

        if constraints_pass && te_decision == SELinuxDecision::Allow {
            SELinuxDecision::Allow
        } else {
            SELinuxDecision::Deny
        }
    };

    let denial: DenialResidual = DenialResidual{
        residual_id: policy.denial_count + 1,
        timestamp: 0,
        source_secctx: source_ctx,
        target_secctx: target_ctx,
        class_id: class_id,
        permission: perm_set,
        denied_by_rule: 0,
        audit_message: Str::from("SELinux denial"),
        residual_hash: Array::splat(0),
        correlated_event: 0,
    };

    residual emit {
        op: "selinux.access_decision",
        source: source_ctx.type_id,
        target: target_ctx.type_id,
        class: class_id,
        perms: perm_set,
        decision: decision as u8,
        avc_hit: if found { 1 } else { 0 },
    };

    return (decision, denial);
}

fn record_denial(
    policy: SELinuxPolicy,
    denial: DenialResidual,
) -> SELinuxPolicy
    effect [selinux:enforce, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.denial_count < MAX_DENIAL_RESIDUALS {
        updated.denial_residuals[updated.denial_count] = denial;
        updated.denial_count = updated.denial_count + 1;

        residual emit {
            op: "selinux.denial_recorded",
            residual: denial.residual_id,
            source: denial.source_secctx.type_id,
            target: denial.target_secctx.type_id,
        };
    }
    return updated;
}

fn get_denial_count(policy: SELinuxPolicy) -> u64
    effect [compute]
{
    return policy.denial_count;
}

fn get_denial_by_id(policy: SELinuxPolicy, residual_id: u64) -> Option(DenialResidual)
    effect [compute]
{
    for i in 0..policy.denial_count {
        if policy.denial_residuals[i].residual_id == residual_id {
            return Option::Some(policy.denial_residuals[i]);
        }
    }
    return Option::None;
}

// ──────────────────────────────────────────────
// Domain Transition Management
// ──────────────────────────────────────────────

fn add_domain_transition(
    policy: SELinuxPolicy,
    from_type: u64,
    to_type: u64,
    class_id: u64,
    entry_point: u64,
    auto_transition: bool,
) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.trans_count < MAX_DOMAIN_TRANSITIONS {
        let trans: DomainTransition = DomainTransition{
            trans_id: updated.trans_count + 1,
            from_type: from_type,
            to_type: to_type,
            class_id: class_id,
            entry_point: entry_point,
            allowed: true,
            auto_transition: auto_transition,
        };
        updated.transitions[updated.trans_count] = trans;
        updated.trans_count = updated.trans_count + 1;

        residual emit {
            op: "selinux.domain_transition_add",
            from: from_type,
            to: to_type,
            auto: if auto_transition { 1 } else { 0 },
        };
    }
    return updated;
}

fn check_domain_transition(
    policy: SELinuxPolicy,
    from_type: u64,
    to_type: u64,
    class_id: u64,
) -> bool
    effect [selinux:enforce, compute]
{
    for i in 0..policy.trans_count {
        let t: DomainTransition = policy.transitions[i];
        if t.from_type == from_type && t.to_type == to_type && t.class_id == class_id {
            return t.allowed;
        }
    }
    return false;
}

fn find_transition_by_entry(
    policy: SELinuxPolicy,
    from_type: u64,
    entry_point: u64,
) -> Option(DomainTransition)
    effect [compute]
{
    for i in 0..policy.trans_count {
        let t: DomainTransition = policy.transitions[i];
        if t.from_type == from_type && t.entry_point == entry_point {
            return Option::Some(t);
        }
    }
    return Option::None;
}

// ──────────────────────────────────────────────
// SELinux Policy Lifecycle
// ──────────────────────────────────────────────

fn create_empty_selinux_policy(name: Str(64)) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    residual emit {
        op: "selinux.policy_create",
        name: name,
    };

    return SELinuxPolicy{
        user_count: 0,
        users: Array::zeroed(),
        role_count: 0,
        roles: Array::zeroed(),
        type_count: 0,
        types: Array::zeroed(),
        class_count: 0,
        classes: Array::zeroed(),
        perm_count: 0,
        permissions: Array::zeroed(),
        rule_count: 0,
        rules: Array::zeroed(),
        constraint_count: 0,
        constraints: Array::zeroed(),
        trans_count: 0,
        transitions: Array::zeroed(),
        avc_entries: Array::zeroed(),
        avc_count: 0,
        denial_residuals: Array::zeroed(),
        denial_count: 0,
        policy_version: 1,
        policy_name: name,
    };
}

fn add_selinux_user(policy: SELinuxPolicy, user: SELinuxUser) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.user_count < MAX_SELINUX_USERS {
        updated.users[updated.user_count] = user;
        updated.user_count = updated.user_count + 1;

        residual emit {
            op: "selinux.user_add",
            user: user.user_id,
            name: user.name,
        };
    }
    return updated;
}

fn add_selinux_role(policy: SELinuxPolicy, role: SELinuxRole) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.role_count < MAX_SELINUX_ROLES {
        updated.roles[updated.role_count] = role;
        updated.role_count = updated.role_count + 1;

        residual emit {
            op: "selinux.role_add",
            role: role.role_id,
            name: role.name,
        };
    }
    return updated;
}

fn add_selinux_type(policy: SELinuxPolicy, stype: SELinuxType) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.type_count < MAX_SELINUX_TYPES {
        updated.types[updated.type_count] = stype;
        updated.type_count = updated.type_count + 1;

        residual emit {
            op: "selinux.type_add",
            type_id: stype.type_id,
            name: stype.name,
            is_domain: if stype.is_domain { 1 } else { 0 },
        };
    }
    return updated;
}

fn add_selinux_rule(policy: SELinuxPolicy, rule: SELinuxRule) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.rule_count < MAX_SELINUX_RULES {
        updated.rules[updated.rule_count] = rule;
        updated.rule_count = updated.rule_count + 1;

        residual emit {
            op: "selinux.rule_add",
            rule: rule.rule_id,
            source: rule.source_type,
            target: rule.target_type,
            class: rule.class_id,
            decision: rule.decision as u8,
        };
    }
    return updated;
}

fn add_selinux_constraint(policy: SELinuxPolicy, constraint: ConstraintRule) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.constraint_count < MAX_CONSTRAINT_RULES {
        updated.constraints[updated.constraint_count] = constraint;
        updated.constraint_count = updated.constraint_count + 1;

        residual emit {
            op: "selinux.constraint_add",
            id: constraint.constraint_id,
        };
    }
    return updated;
}

fn load_selinux_class(policy: SELinuxPolicy, class_def: SELinuxClassDef) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.class_count < MAX_SELINUX_CLASSES {
        updated.classes[updated.class_count] = class_def;
        updated.class_count = updated.class_count + 1;

        residual emit {
            op: "selinux.class_load",
            class: class_def.class_id,
            name: class_def.name,
        };
    }
    return updated;
}

fn load_selinux_permission(policy: SELinuxPolicy, perm: SELinuxPermission) -> SELinuxPolicy
    effect [selinux:parse, compute, residual]
{
    let mut updated: SELinuxPolicy = policy;
    if updated.perm_count < MAX_SELINUX_PERMISSIONS {
        updated.permissions[updated.perm_count] = perm;
        updated.perm_count = updated.perm_count + 1;

        residual emit {
            op: "selinux.perm_load",
            perm: perm.perm_id,
            name: perm.name,
        };
    }
    return updated;
}

// ──────────────────────────────────────────────
// Policy Query Helpers
// ──────────────────────────────────────────────

fn find_type_by_name(policy: SELinuxPolicy, name: Str(64)) -> Option(SELinuxType)
    effect [compute]
{
    for i in 0..policy.type_count {
        if policy.types[i].name == name {
            return Option::Some(policy.types[i]);
        }
    }
    return Option::None;
}

fn find_role_by_name(policy: SELinuxPolicy, name: Str(64)) -> Option(SELinuxRole)
    effect [compute]
{
    for i in 0..policy.role_count {
        if policy.roles[i].name == name {
            return Option::Some(policy.roles[i]);
        }
    }
    return Option::None;
}

fn count_rules_by_decision(policy: SELinuxPolicy, decision: SELinuxDecision) -> u64
    effect [compute]
{
    let mut count: u64 = 0;
    for i in 0..policy.rule_count {
        if policy.rules[i].decision == decision {
            count = count + 1;
        }
    }
    return count;
}

fn get_types_for_role(policy: SELinuxPolicy, role_id: u64) -> Array(u64, MAX_SELINUX_TYPES)
    effect [compute]
{
    let mut types: Array(u64, MAX_SELINUX_TYPES) = Array::splat(0);
    for i in 0..policy.role_count {
        if policy.roles[i].role_id == role_id {
            for j in 0..policy.roles[i].types_count {
                types[j] = policy.roles[i].types[j];
            }
            break;
        }
    }
    return types;
}

fn policy_summary(policy: SELinuxPolicy) -> Str(256)
    effect [compute]
{
    let mut summary: Str(256) = Str::from("SELinuxPolicy: ");
    let _: bool = summary.append(policy.policy_name);
    let _: bool = summary.append(Str::from(" v"));
    let _: bool = summary.append(Str::from("X"));
    let _: bool = summary.append(Str::from(" users="));
    let _: bool = summary.append(Str::from("X"));
    let _: bool = summary.append(Str::from(" roles="));
    let _: bool = summary.append(Str::from("X"));
    let _: bool = summary.append(Str::from(" types="));
    let _: bool = summary.append(Str::from("X"));
    let _: bool = summary.append(Str::from(" rules="));
    let _: bool = summary.append(Str::from("X"));
    return summary;
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main() -> SELinuxPolicy
    effect [selinux:parse, selinux:translate, selinux:avc, selinux:enforce, compute, io:write, residual]
{
    let mut policy: SELinuxPolicy = create_empty_selinux_policy(Str::from("test_policy"));

    let user_root: SELinuxUser = SELinuxUser{
        user_id: 1,
        name: Str::from("root"),
        default_role: 1,
        roles_count: 1,
        roles: Array::splat(1),
        mls_level: 15,
        mls_range: 15,
        enabled: true,
    };
    policy = add_selinux_user(policy, user_root);

    let user_unconfined: SELinuxUser = SELinuxUser{
        user_id: 2,
        name: Str::from("unconfined"),
        default_role: 2,
        roles_count: 1,
        roles: Array::splat(2),
        mls_level: 10,
        mls_range: 10,
        enabled: true,
    };
    policy = add_selinux_user(policy, user_unconfined);

    let role_sys: SELinuxRole = SELinuxRole{
        role_id: 1,
        name: Str::from("system_r"),
        types_count: 2,
        types: Array::splat(0),
        dominates: 0,
    };
    policy = add_selinux_role(policy, role_sys);

    let role_obj: SELinuxRole = SELinuxRole{
        role_id: 2,
        name: Str::from("object_r"),
        types_count: 3,
        types: Array::splat(0),
        dominates: 0,
    };
    policy = add_selinux_role(policy, role_obj);

    let type_kernel: SELinuxType = SELinuxType{
        type_id: 1,
        name: Str::from("kernel_t"),
        attributes_count: 0,
        attributes: Array::splat(0),
        alias_count: 0,
        aliases: Array::splat(0),
        is_domain: true,
        default_context: 0,
    };
    policy = add_selinux_type(policy, type_kernel);

    let type_user_app: SELinuxType = SELinuxType{
        type_id: 2,
        name: Str::from("user_app_t"),
        attributes_count: 0,
        attributes: Array::splat(0),
        alias_count: 0,
        aliases: Array::splat(0),
        is_domain: true,
        default_context: 0,
    };
    policy = add_selinux_type(policy, type_user_app);

    let type_file_etc: SELinuxType = SELinuxType{
        type_id: 3,
        name: Str::from("etc_t"),
        attributes_count: 0,
        attributes: Array::splat(0),
        alias_count: 0,
        aliases: Array::splat(0),
        is_domain: false,
        default_context: 0,
    };
    policy = add_selinux_type(policy, type_file_etc);

    let rule_allow: SELinuxRule = SELinuxRule{
        rule_id: 1,
        source_type: 2,
        target_type: 3,
        class_id: 1,
        permission_set: 0x01,
        decision: SELinuxDecision::Allow,
        conditional: false,
        boolean_id: 0,
        enabled: true,
        priority: 100,
    };
    policy = add_selinux_rule(policy, rule_allow);

    let file_class: SELinuxClassDef = SELinuxClassDef{
        class_id: 1,
        name: Str::from("file"),
        permissions_count: 2,
        permissions: Array::splat(0),
        default_allow: false,
    };
    policy = load_selinux_class(policy, file_class);

    let perm_read: SELinuxPermission = SELinuxPermission{
        perm_id: 1,
        name: Str::from("read"),
        class_id: 1,
        value: 0x01,
    };
    policy = load_selinux_permission(policy, perm_read);

    let src_ctx: SecurityContext = create_security_context(2, 2, 2, 10, 0);
    let tgt_ctx: SecurityContext = create_security_context(1, 1, 3, 5, 0);

    let validated: ContextValidationResult = validate_security_context(src_ctx, policy);
    assert(validated == ContextValidationResult::Valid, "selinux_compat: context validates");

    let (avc_decision, denial): (SELinuxDecision, DenialResidual) = compute_access_decision(
        policy, src_ctx, tgt_ctx, 1, 0x01,
    );

    policy = avc_insert(policy, src_ctx, tgt_ctx, 1, 0x01, avc_decision);

    let (hits, active, invalid): (u64, u64, u64) = avc_stats(policy);
    assert(active >= 1, "selinux_compat: AVC entry cached");
    assert(policy.rule_count >= 1, "selinux_compat: rules loaded");
    assert(policy.type_count >= 3, "selinux_compat: types loaded");

    let is_allowed: bool = check_domain_transition(policy, 2, 1, 1);

    residual emit {
        op: "selinux_compat.init_complete",
        users: policy.user_count,
        roles: policy.role_count,
        types: policy.type_count,
        rules: policy.rule_count,
        avc_entries: policy.avc_count,
        denials: policy.denial_count,
        last_decision: avc_decision as u8,
    };

    return policy;
}
