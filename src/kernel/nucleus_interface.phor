}

type CapabilityTokenType = enum {
    TrapHandlerToken   = 0,
    InterruptToken     = 1,
    NucleusCallToken   = 2,
    MemoryMapToken     = 3,
    IOPortToken        = 4,
    WatchdogToken      = 5,
    DebugOutputToken   = 6,
