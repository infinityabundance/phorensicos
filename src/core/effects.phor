// file: effects.phor
// purpose: Effect types, EffectSet, Closure signatures with explicit effect
//          declarations. All functions declare their effects; the compiler
//          checks effect polymorphism and effect set inclusion.
// evidence: EFF-ARCH-001 through EFF-ARCH-120
// residual: No hidden effects; every function signature is self-documenting.

use core::constants::*
use core::types::*
use core::errors::*

// ──────────────────────────────────────────────
// EffectSet: Bitmask of effects
// ──────────────────────────────────────────────
// A fixed-size set of effect identifiers backed by a Word64 bitmask.
// Effects declare what side-effects a function may perform.
// Evidence path: EFF-SET-001 through EFF-SET-060

pub type EffectSet : Word64 = struct {
    mask: Word64,
}

impl EffectSet {
    // Create an empty effect set (pure deterministic function).
    pub fn pure() -> EffectSet
        effects: [deterministic]
    {
        EffectSet { mask: Word64::from_u64(EFFECT_NONE) }
    }

    // Create an effect set with only deterministic effect.
    pub fn deterministic() -> EffectSet
        effects: [deterministic]
    {
        EffectSet { mask: Word64::from_u64(EFFECT_DETERMINISTIC) }
    }

    // Create from a raw bitmask.
    pub fn from_mask(mask: Word64) -> EffectSet
        effects: [deterministic]
    {
        EffectSet { mask: mask }
    }

    // Create from a list of effect constants.
    pub fn from_effects(effects: Word64[], count: u32) -> EffectSet
        effects: [deterministic]
    {
        let mut mask: Word64 = Word64::zero()
        // loop: bounds[BOUND_SMALL] — bounded by number of effects
        loop: bounds[BOUND_SMALL] for i in 0..count {
            mask = mask.bit_or(effects[i as usize])
        }
        EffectSet { mask: mask }
    }

    // Return the raw mask.
    pub fn mask(self) -> Word64
        effects: [deterministic]
    {
        self.mask
    }

    // Check if a specific effect is included.
    pub fn has_effect(self, effect: Word64) -> bool
        effects: [deterministic]
    {
        let masked: Word64 = self.mask.bit_and(effect)
        !masked.is_zero()
    }

    // Check if this effect set is a subset of another (all our effects are allowed).
    pub fn is_subset_of(self, other: EffectSet) -> bool
        effects: [deterministic]
    {
        let combined: Word64 = self.mask.bit_and(other.mask)
        combined.eq(self.mask)
    }

    // Check if this effect set contains all effects from another.
    pub fn contains(self, other: EffectSet) -> bool
        effects: [deterministic]
    {
        let combined: Word64 = self.mask.bit_and(other.mask)
        combined.eq(other.mask)
    }

    // Add an effect to the set.
    pub fn add(self: ref mut, effect: Word64)
        effects: [deterministic]
    {
        self.mask = self.mask.bit_or(effect)
    }

    // Remove an effect from the set.
    pub fn remove(self: ref mut, effect: Word64)
        effects: [deterministic]
    {
        let not_effect: Word64 = effect.bit_not()
        self.mask = self.mask.bit_and(not_effect)
    }

    // Intersect with another effect set.
    pub fn intersect(self, other: EffectSet) -> EffectSet
        effects: [deterministic]
    {
        EffectSet { mask: self.mask.bit_and(other.mask) }
    }

    // Union with another effect set.
    pub fn union(self, other: EffectSet) -> EffectSet
        effects: [deterministic]
    {
        EffectSet { mask: self.mask.bit_or(other.mask) }
    }

    // Subtract effects of another set.
    pub fn subtract(self, other: EffectSet) -> EffectSet
        effects: [deterministic]
    {
        let not_other: Word64 = other.mask.bit_not()
        EffectSet { mask: self.mask.bit_and(not_other) }
    }

    // Count how many effects are set.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.mask.count_ones()
    }

    // Check if the set is empty (pure function).
    pub fn is_pure(self) -> bool
        effects: [deterministic]
    {
        self.mask.is_zero()
    }

    // Check if the function is at most deterministic.
    pub fn is_deterministic(self) -> bool
        effects: [deterministic]
    {
        let det_only: Word64 = Word64::from_u64(EFFECT_DETERMINISTIC)
        let diff: Word64 = self.mask.bit_and(det_only.bit_not())
        diff.is_zero()
    }

    // Check if the function may panic.
    pub fn may_panic(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_PANIC))
    }

    // Check if the function does I/O.
    pub fn has_io(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_IO))
    }

    // Check if the function does network I/O.
    pub fn has_network(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_NETWORK))
    }

    // Check if the function does storage access.
    pub fn has_storage(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_STORAGE))
    }

    // Check if the function uses random numbers.
    pub fn has_random(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_RANDOM))
    }

    // Check if the function allocates.
    pub fn has_alloc(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_ALLOC))
    }

    // Check if the function deallocates.
    pub fn has_dealloc(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_DEALLOC))
    }

    // Check if the function may call panic.
    pub fn has_panic(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_PANIC))
    }

    // Check if the function may exit.
    pub fn has_exit(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_EXIT))
    }

    // Check if the function spawns cages.
    pub fn has_spawn(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_SPAWN))
    }

    // Check if the function uses IPC.
    pub fn has_ipc(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_IPC))
    }

    // Check if the function uses the court.
    pub fn has_court(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_COURT))
    }

    // Check if the function uses sealing.
    pub fn has_seal(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_SEAL))
    }

    // Check if the function uses driver access.
    pub fn has_driver(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_DRIVER))
    }

    // Check if the function uses capabilities.
    pub fn has_capability(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_CAPABILITY))
    }

    // Check if the function uses trust operations.
    pub fn has_trust(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_TRUST))
    }

    // Check if the function serializes.
    pub fn has_serialize(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_SERIALIZE))
    }

    // Check if the function deserializes.
    pub fn has_deserialize(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_DESERIALIZE))
    }

    // Check if the function hashes.
    pub fn has_hash(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_HASH))
    }

    // Check if the function verifies.
    pub fn has_verify(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_VERIFY))
    }

    // Check if the function uses the clock.
    pub fn has_clock(self) -> bool
        effects: [deterministic]
    {
        self.has_effect(Word64::from_u64(EFFECT_CLOCK))
    }

    // Equality check.
    pub fn eq(self, other: EffectSet) -> bool
        effects: [deterministic]
    {
        self.mask.eq(other.mask)
    }

    // Convert to a human-readable string for diagnostics.
    pub fn to_string(self) -> FixedString[128]
        effects: [deterministic]
    {
        let mut buf: FixedString[128] = FixedString::new()
        let mut first: bool = true
        let mut bits: u64 = self.mask.to_u64()
        let mut pos: u32 = 0

        // loop: bounds[BOUND_SMALL] — at most 64 effect bits
        loop: bounds[BOUND_SMALL] while bits != 0 && pos < 64 {
            if (bits & 1) != 0 {
                if !first {
                    buf.push_byte(Byte::from_u8(b'|'))
                }
                // Append effect name based on bit position.
                // In production, this would use a lookup table.
                match pos {
                    0 => buf.append(FixedString::from_slice("det")),
                    1 => buf.append(FixedString::from_slice("io")),
                    2 => buf.append(FixedString::from_slice("net")),
                    3 => buf.append(FixedString::from_slice("store")),
                    4 => buf.append(FixedString::from_slice("clock")),
                    5 => buf.append(FixedString::from_slice("rand")),
                    6 => buf.append(FixedString::from_slice("alloc")),
                    7 => buf.append(FixedString::from_slice("dealloc")),
                    8 => buf.append(FixedString::from_slice("panic")),
                    9 => buf.append(FixedString::from_slice("exit")),
                    _ => buf.push_byte(Byte::from_u8(b'?')),
                }
                first = false
            }
            bits = bits >> 1
            pos = pos + 1
        }
        if first {
            buf.append(FixedString::from_slice("pure"))
        }
        buf
    }
}

// ──────────────────────────────────────────────
// EffectClosure: A closure with declared effects
// ──────────────────────────────────────────────
// A typed function pointer paired with its effect set.
// The compiler checks that the closure's effects are compatible
// with the context where it is used.
// Evidence path: EFF-CLOS-001 through EFF-CLOS-050

pub type EffectClosure[Args, Result] : struct {
    // The function pointer.
    func: fn(Args) -> Result,
    // The declared effect set of the function.
    effects: EffectSet,
    // The trust level required to invoke this closure.
    trust_required: TrustLevel,
}

impl[Args, Result] EffectClosure[Args, Result] {
    // Create a new effect closure.
    pub fn new(
        func: fn(Args) -> Result,
        effects: EffectSet,
        trust_required: TrustLevel,
    ) -> EffectClosure[Args, Result]
        effects: [deterministic]
    {
        EffectClosure {
            func: func,
            effects: effects,
            trust_required: trust_required,
        }
    }

    // Invoke the closure (consumes it — affine semantics).
    pub fn invoke(self, args: Args) -> Result
        effects: [deterministic]
    {
        // trust: Closure invocation is deterministic from the caller's
        // perspective; the actual effects are declared in the EffectSet.
        // evidence: EFF-CALL-001: Closure invocation dispatches to the
        //           underlying function with the declared effect set.
        (self.func)(args)
    }

    // Get the effect set.
    pub fn effect_set(self) -> EffectSet
        effects: [deterministic]
    {
        self.effects
    }

    // Check if the closure is deterministic.
    pub fn is_deterministic(self) -> bool
        effects: [deterministic]
    {
        self.effects.is_deterministic()
    }

    // Check if the closure's effects are compatible with a context.
    pub fn is_compatible_with(self, context_effects: EffectSet) -> bool
        effects: [deterministic]
    {
        self.effects.is_subset_of(context_effects)
    }

    // Get the required trust level.
    pub fn trust_required(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust_required
    }

    // Check if the caller has sufficient trust for this closure.
    pub fn check_trust(self, caller_trust: TrustLevel) -> bool
        effects: [deterministic]
    {
        caller_trust.to_ordinal() >= self.trust_required.to_ordinal()
    }
}

// ──────────────────────────────────────────────
// Effect-polymorphic function types
// ──────────────────────────────────────────────
// A function that is polymorphic over its effects.
// The effect parameter is resolved at the call site.
// Evidence path: EFF-POLY-001 through EFF-POLY-025

pub type EffectPolymorphic[Args, Result, E: EffectSet] : struct {
    func: fn(Args) -> Result,
    effects_parameter: E,
}

impl[Args, Result, E] EffectPolymorphic[Args, Result, E] {
    pub fn new(func: fn(Args) -> Result) -> EffectPolymorphic[Args, Result, E]
        effects: [deterministic]
    {
        EffectPolymorphic {
            func: func,
            effects_parameter: E::default(),
        }
    }

    pub fn invoke(self, args: Args, allowed_effects: EffectSet) -> Result[Result, EffectError>
        effects: [deterministic]
    {
        // Check that the polymorphic instantiation is compatible.
        if !E::default().is_subset_of(allowed_effects) {
            return Result::Err(effect_not_permitted(
                FixedString[128]::from_slice("Polymorphic effect not permitted")))
        }
        Result::Ok((self.func)(args))
    }
}

// ──────────────────────────────────────────────
// EffectContext: Effect-checking context
// ──────────────────────────────────────────────
// Maintains the current effect scope and allows nested scoping.
// Evidence path: EFF-CTX-001 through EFF-CTX-030

pub type EffectContext : struct {
    // The complete set of effects allowed in this context.
    allowed: EffectSet,
    // The set of effects used so far.
    used: EffectSet,
    // Nesting depth for scoped effect regions.
    depth: u32,
    // Whether the context has been violated.
    violated: bool,
}

impl EffectContext {
    // Create a new effect context with allowed effects.
    pub fn new(allowed: EffectSet) -> EffectContext
        effects: [deterministic]
    {
        EffectContext {
            allowed: allowed,
            used: EffectSet::pure(),
            depth: 0,
            violated: false,
        }
    }

    // Get the allowed effects.
    pub fn allowed(self) -> EffectSet
        effects: [deterministic]
    {
        self.allowed
    }

    // Get the used effects so far.
    pub fn used(self) -> EffectSet
        effects: [deterministic]
    {
        self.used
    }

    // Check if an effect is allowed in this context.
    pub fn is_allowed(self, effect: Word64) -> bool
        effects: [deterministic]
    {
        if self.violated {
            return false
        }
        self.allowed.has_effect(effect)
    }

    // Record that an effect was used.
    // Returns an error if the effect is not allowed.
    pub fn record_effect(self: ref mut, effect: Word64) -> Result[(), EffectError>
        effects: [deterministic]
    {
        if !self.allowed.has_effect(effect) {
            self.violated = true
            return Result::Err(effect_not_permitted(
                FixedString[128]::from_slice("Effect not in allowed set")))
        }
        self.used.add(effect)
        Result::Ok(())
    }

    // Enter a nested effect scope with restricted effects.
    // Returns a guard that must be dropped to restore the previous context.
    pub fn enter_scope(self: ref mut, scope_effects: EffectSet)
        -> Result[EffectScopeGuard, EffectError>
        effects: [deterministic]
    {
        if !scope_effects.is_subset_of(self.allowed) {
            return Result::Err(effect_not_permitted(
                FixedString[128]::from_slice("Scope effects exceed context")))
        }
        if self.depth >= MAX_EFFECT_SET_SIZE {
            return Result::Err(EffectError::new(
                Word64::from_u64(DIAG_EFFECT_BASE | 0x010),
                FixedString[128]::from_slice("Effect scope depth exceeded")))
        }
        let guard: EffectScopeGuard = EffectScopeGuard {
            saved_allowed: self.allowed,
            saved_used: self.used,
        }
        self.allowed = scope_effects
        self.used = EffectSet::pure()
        self.depth = self.depth + 1
        Result::Ok(guard)
    }

    // Exit a scope and restore previous context.
    pub fn exit_scope(self: ref mut, guard: EffectScopeGuard)
        effects: [deterministic]
    {
        if self.depth > 0 {
            self.depth = self.depth - 1
        }
        self.allowed = guard.saved_allowed
        self.used = guard.saved_used
    }

    // Check if the context has been violated.
    pub fn is_violated(self) -> bool
        effects: [deterministic]
    {
        self.violated
    }

    // Reset the context.
    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.used = EffectSet::pure()
        self.violated = false
    }
}

// ──────────────────────────────────────────────
// EffectScopeGuard: RAII guard for effect scoping
// ──────────────────────────────────────────────
// Evidence path: EFF-GUARD-001 through EFF-GUARD-015

pub type EffectScopeGuard : struct {
    saved_allowed: EffectSet,
    saved_used: EffectSet,
}

impl EffectScopeGuard {
    // Dismiss the guard without restoring (promote effects to parent).
    pub fn dismiss(self: ref mut)
        effects: [deterministic]
    {
        // Simply leak the guard; the parent context won't be restored.
        // This is an explicit opt-in to promoting scoped effects.
    }
}

// ──────────────────────────────────────────────
// EffectValidator: Static validation of effect sets
// ──────────────────────────────────────────────
// Evidence path: EFF-VAL-001 through EFF-VAL-025

pub type EffectValidator : struct {
    required: EffectSet,
    provided: EffectSet,
}

impl EffectValidator {
    pub fn new(required: EffectSet, provided: EffectSet) -> EffectValidator
        effects: [deterministic]
    {
        EffectValidator {
            required: required,
            provided: provided,
        }
    }

    // Validate that provided effects are a subset of required.
    pub fn validate(self) -> Result[(), EffectError>
        effects: [deterministic]
    {
        if !self.provided.is_subset_of(self.required) {
            return Result::Err(effect_set_mismatch(
                self.required.mask(), self.provided.mask()))
        }
        Result::Ok(())
    }

    // Validate that a specific effect is in the required set.
    pub fn validate_effect(self, effect: Word64) -> Result[(), EffectError>
        effects: [deterministic]
    {
        if !self.required.has_effect(effect) {
            return Result::Err(effect_not_permitted(
                FixedString[128]::from_slice("Effect not in required set")))
        }
        Result::Ok(())
    }

    // Get the difference (effects required but not provided).
    pub fn missing(self) -> EffectSet
        effects: [deterministic]
    {
        self.required.subtract(self.provided)
    }

    // Get the excess (effects provided but not required).
    pub fn excess(self) -> EffectSet
        effects: [deterministic]
    {
        self.provided.subtract(self.required)
    }

    // Check if validation would pass.
    pub fn would_pass(self) -> bool
        effects: [deterministic]
    {
        self.provided.is_subset_of(self.required)
    }
}

// ──────────────────────────────────────────────
// Effect-safe function wrappers
// ──────────────────────────────────────────────
// These wrap functions and enforce effect constraints.
// Evidence path: EFF-SAFE-001 through EFF-SAFE-020

// Wrap a deterministic function.
pub fn as_deterministic[Args, Result](
    f: fn(Args) -> Result
) -> EffectClosure[Args, Result]
    effects: [deterministic]
{
    EffectClosure::new(
        f,
        EffectSet::deterministic(),
        TrustLevel::Trust_Untrusted,
    )
}

// Wrap a function with explicit effects.
pub fn with_effects[Args, Result](
    f: fn(Args) -> Result,
    effects: EffectSet,
    trust: TrustLevel,
) -> EffectClosure[Args, Result]
    effects: [deterministic]
{
    EffectClosure::new(f, effects, trust)
}

// Wrap a pure (no effects) function.
pub fn as_pure[Args, Result](
    f: fn(Args) -> Result
) -> EffectClosure[Args, Result]
    effects: [deterministic]
{
    EffectClosure::new(
        f,
        EffectSet::pure(),
        TrustLevel::Trust_Untrusted,
    )
}

// ──────────────────────────────────────────────
// EffectSet operations for common patterns
// ──────────────────────────────────────────────
// Evidence path: EFF-PATTERN-001 through EFF-PATTERN-020

// Effect set for read-only deterministic computation.
pub fn effects_read_only() -> EffectSet
    effects: [deterministic]
{
    EffectSet::deterministic()
}

// Effect set for storage read (deterministic + storage).
pub fn effects_storage_read() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_STORAGE))
    set
}

// Effect set for storage write.
pub fn effects_storage_write() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = effects_storage_read()
    set.add(Word64::from_u64(EFFECT_IO))
    set
}

// Effect set for network communication.
pub fn effects_network() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_NETWORK))
    set.add(Word64::from_u64(EFFECT_IO))
    set
}

// Effect set for IPC communication.
pub fn effects_ipc() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_IPC))
    set
}

// Effect set for capability operations.
pub fn effects_capability() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_CAPABILITY))
    set
}

// Effect set for trusted operations.
pub fn effects_trusted() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_TRUST))
    set
}

// Effect set for cryptographic operations.
pub fn effects_crypto() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_HASH))
    set.add(Word64::from_u64(EFFECT_VERIFY))
    set
}

// Effect set for serialization.
pub fn effects_serialize() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_SERIALIZE))
    set.add(Word64::from_u64(EFFECT_DESERIALIZE))
    set
}

// Effect set for court operations.
pub fn effects_court() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_COURT))
    set.add(Word64::from_u64(EFFECT_SEAL))
    set.add(Word64::from_u64(EFFECT_UNSEAL))
    set
}

// Effect set for panic (functions that may abort).
pub fn effects_fallible() -> EffectSet
    effects: [deterministic]
{
    let mut set: EffectSet = EffectSet::deterministic()
    set.add(Word64::from_u64(EFFECT_PANIC))
    set
}

// ──────────────────────────────────────────────
// Effect checking at call boundaries
// ──────────────────────────────────────────────
// Evidence path: EFF-CHECK-001 through EFF-CHECK-015

// Check that a closure's effects are allowed in a context.
pub fn check_call_site(
    closure: EffectClosure[Args, Result],
    context: ref EffectContext,
) -> Result[(), EffectError>
    effects: [deterministic]
{
    if !closure.effect_set().is_subset_of(context.allowed()) {
        return Result::Err(effect_set_mismatch(
            context.allowed().mask(), closure.effect_set().mask()))
    }
    if !closure.check_trust(TrustLevel::Trust_Untrusted) {
        return Result::Err(EffectError::new(
            Word64::from_u64(DIAG_EFFECT_BASE | 0x020),
            FixedString[128]::from_slice("Insufficient trust for closure")))
    }
    Result::Ok(())
}

// Validate effects between function signature and implementation.
pub fn validate_effect_signature(
    declared: EffectSet,
    actual: EffectSet,
    name: FixedString[128],
) -> Result[(), EffectError>
    effects: [deterministic]
{
    if !actual.is_subset_of(declared) {
        let mut msg: FixedString[128] = FixedString[128]::new()
        msg.append(FixedString[128]::from_slice("Function "))
        msg.append(name)
        msg.append(FixedString[128]::from_slice(" has undeclared effects"))
        return Result::Err(EffectError::new(
            Word64::from_u64(DIAG_EFFECT_BASE | 0x021), msg))
    }
    Result::Ok(())
}

// ──────────────────────────────────────────────
// Effect Context Manager (singleton pattern)
// ──────────────────────────────────────────────
// Manages the current effect context for a cage.
// Evidence path: EFF-MGR-001 through EFF-MGR-030

pub type EffectManager : struct {
    context: EffectContext,
    stack: EffectContext[MAX_EFFECT_SET_SIZE],
    stack_depth: u32,
}

impl EffectManager {
    pub fn new(allowed: EffectSet) -> EffectManager
        effects: [deterministic]
    {
        EffectManager {
            context: EffectContext::new(allowed),
            stack: [EffectContext::new(EffectSet::pure()); MAX_EFFECT_SET_SIZE],
            stack_depth: 0,
        }
    }

    // Push the current context onto the stack and set a new one.
    pub fn push_context(self: ref mut, new_allowed: EffectSet) -> Result[(), EffectError>
        effects: [deterministic]
    {
        if self.stack_depth >= MAX_EFFECT_SET_SIZE {
            return Result::Err(EffectError::new(
                Word64::from_u64(DIAG_EFFECT_BASE | 0x030),
                FixedString[128]::from_slice("Effect context stack full")))
        }
        self.stack[self.stack_depth as usize] = self.context
        self.stack_depth = self.stack_depth + 1
        self.context = EffectContext::new(new_allowed)
        Result::Ok(())
    }

    // Pop the context stack and restore the previous one.
    pub fn pop_context(self: ref mut) -> Result[(), EffectError>
        effects: [deterministic]
    {
        if self.stack_depth == 0 {
            return Result::Err(EffectError::new(
                Word64::from_u64(DIAG_EFFECT_BASE | 0x031),
                FixedString[128]::from_slice("Effect context stack empty")))
        }
        self.stack_depth = self.stack_depth - 1
        self.context = self.stack[self.stack_depth as usize]
        Result::Ok(())
    }

    // Get the current context.
    pub fn current_context(self) -> EffectContext
        effects: [deterministic]
    {
        self.context
    }

    // Record an effect in the current context.
    pub fn record(self: ref mut, effect: Word64) -> Result[(), EffectError>
        effects: [deterministic]
    {
        self.context.record_effect(effect)
    }

    // Check if an effect is allowed.
    pub fn is_allowed(self, effect: Word64) -> bool
        effects: [deterministic]
    {
        self.context.is_allowed(effect)
    }

    // Reset the current context.
    pub fn reset_context(self: ref mut)
        effects: [deterministic]
    {
        self.context.reset()
    }
}

// ──────────────────────────────────────────────
// Effect Analysis: Static analysis helpers
// ──────────────────────────────────────────────
// Evidence path: EFF-ANALYSIS-001 through EFF-ANALYSIS-030

pub type EffectAnalysis : struct {
    total_effects: EffectSet,
    pure_count: u32,
    io_count: u32,
    panic_count: u32,
}

impl EffectAnalysis {
    pub fn new() -> EffectAnalysis
        effects: [deterministic]
    {
        EffectAnalysis {
            total_effects: EffectSet::pure(),
            pure_count: 0,
            io_count: 0,
            panic_count: 0,
        }
    }

    // Analyze a collection of closure signatures.
    // loop: bounds[BOUND_MEDIUM] — bounded by collection size.
    pub fn analyze_closures(self: ref mut,
                             closures: FixedArray[CAPACITY_MEDIUM, EffectClosure])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by array size
        loop: bounds[BOUND_MEDIUM] for i in 0..closures.len() {
            let closure: EffectClosure = closures.get(i).unwrap()
            self.total_effects = self.total_effects.union(closure.effect_set())
            if closure.effect_set().is_pure() {
                self.pure_count = self.pure_count + 1
            }
            if closure.effect_set().has_io() {
                self.io_count = self.io_count + 1
            }
            if closure.effect_set().may_panic() {
                self.panic_count = self.panic_count + 1
            }
        }
    }

    // Check if the analysis shows any non-deterministic effects.
    pub fn has_nondeterminism(self) -> bool
        effects: [deterministic]
    {
        !self.total_effects.is_deterministic()
    }

    // Get a human-readable summary of the analysis.
    pub fn summary(self) -> FixedString[128]
        effects: [deterministic]
    {
        let mut s: FixedString[128] = FixedString::new()
        s.append(FixedString::from_slice("Effects: "))
        s.append(self.total_effects.to_string())
        s
    }
}

// ──────────────────────────────────────────────
// Effect Lattice: Computes the LUB (least upper bound)
// and GLB (greatest lower bound) of effect sets.
// ──────────────────────────────────────────────
// Evidence path: EFF-LATTICE-001 through EFF-LATTICE-020

pub fn effect_lub(a: EffectSet, b: EffectSet) -> EffectSet
    effects: [deterministic]
{
    // LUB = union (least set containing both).
    a.union(b)
}

pub fn effect_glb(a: EffectSet, b: EffectSet) -> EffectSet
    effects: [deterministic]
{
    // GLB = intersection (greatest set contained in both).
    a.intersect(b)
}

// Check if a <= b in the effect lattice (a is a subset of b).
pub fn effect_subset(a: EffectSet, b: EffectSet) -> bool
    effects: [deterministic]
{
    a.is_subset_of(b)
}

// Compute the effect set for a sequence of operations.
// loop: bounds[BOUND_MEDIUM] — bounded by sequence length.
pub fn effect_sequence(effects: EffectSet[], count: u32) -> EffectSet
    effects: [deterministic]
{
    let mut combined: EffectSet = EffectSet::pure()
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] for i in 0..count {
        combined = combined.union(effects[i as usize])
    }
    combined
}

// Compute effect set for a conditional.
pub fn effect_conditional(
    condition_effects: EffectSet,
    then_effects: EffectSet,
    else_effects: EffectSet,
) -> EffectSet
    effects: [deterministic]
{
    condition_effects.union(then_effects).union(else_effects)
}

// Compute effect set for a loop (union of body with itself).
pub fn effect_loop(body_effects: EffectSet, iterations: u32) -> EffectSet
    effects: [deterministic]
{
    // A loop's effects are the same as the body's (no new effects added).
    body_effects
}

// ──────────────────────────────────────────────
// Effect-Polymorphic Higher-Order Functions
// ──────────────────────────────────────────────
// Evidence path: EFF-HOF-001 through EFF-HOF-025

// Map a function over an array, threading effects through.
// loop: bounds[BOUND_MEDIUM] — bounded by array size.
pub fn effectful_map[T, U](
    array: ref FixedArray[KnownN, T],
    f: EffectClosure[T, U],
) -> FixedArray[KnownN, U]
    effects: [deterministic]
{
    let mut result: FixedArray[KnownN, U] = FixedArray::new()
    // loop: bounds[BOUND_MEDIUM] — bounded by array size
    loop: bounds[BOUND_MEDIUM] for i in 0..array.len() {
        let input: T = array.get(i).unwrap()
        let output: U = f.invoke(input)
        let _: Result[(), BoundsError> = result.push(output)
    }
    result
}

// Filter an array with a predicate that may have effects.
// loop: bounds[BOUND_MEDIUM] — bounded by array size.
pub fn effectful_filter[T](
    array: ref FixedArray[KnownN, T],
    predicate: EffectClosure[T, bool],
) -> FixedArray[KnownN, T]
    effects: [deterministic]
{
    let mut result: FixedArray[KnownN, T] = FixedArray::new()
    // loop: bounds[BOUND_MEDIUM] — bounded by array size
    loop: bounds[BOUND_MEDIUM] for i in 0..array.len() {
        let input: T = array.get(i).unwrap()
        if predicate.invoke(input) {
            let _: Result[(), BoundsError> = result.push(input)
        }
    }
    result
}

// Fold (reduce) an array with an effectful function.
// loop: bounds[BOUND_MEDIUM] — bounded by array size.
pub fn effectful_fold[T, U](
    array: ref FixedArray[KnownN, T],
    initial: U,
    f: EffectClosure[(U, T), U],
) -> U
    effects: [deterministic]
{
    let mut acc: U = initial
    // loop: bounds[BOUND_MEDIUM] — bounded by array size
    loop: bounds[BOUND_MEDIUM] for i in 0..array.len() {
        let input: T = array.get(i).unwrap()
        acc = f.invoke((acc, input))
    }
    acc
}

// ──────────────────────────────────────────────
// Effect Region: Scoped effect regions
// ──────────────────────────────────────────────
// Evidence path: EFF-REGION-001 through EFF-REGION-020

pub type EffectRegion : struct {
    id: u32,
    parent: Option[u32],
    effects: EffectSet,
}

impl EffectRegion {
    pub fn new(id: u32, parent: Option[u32], effects: EffectSet) -> EffectRegion
        effects: [deterministic]
    {
        EffectRegion {
            id: id,
            parent: parent,
            effects: effects,
        }
    }

    pub fn id(self) -> u32 { self.id }
    pub fn parent(self) -> Option[u32] { self.parent }
    pub fn effects(self) -> EffectSet { self.effects }

    // Check if this region allows a given effect.
    pub fn allows(self, effect: Word64) -> bool
        effects: [deterministic]
    {
        self.effects.has_effect(effect)
    }

    // Check if this region is a descendant of another.
    pub fn is_descendant_of(self, other_id: u32, regions: ref FixedArray[CAPACITY_SMALL, EffectRegion]) -> bool
        effects: [deterministic]
    {
        let mut current: Option[u32] = self.parent
        // loop: bounds[BOUND_SMALL] — bounded by region tree depth
        loop: bounds[BOUND_SMALL] while current.is_some() {
            let pid: u32 = current.unwrap()
            if pid == other_id {
                return true
            }
            // Look up parent's parent.
            // loop: bounds[BOUND_SMALL] — bounded by region count
            loop: bounds[BOUND_SMALL] for i in 0..regions.len() {
                let reg: EffectRegion = regions.get(i).unwrap()
                if reg.id == pid {
                    current = reg.parent
                    break
                }
            }
        }
        false
    }
}

// ──────────────────────────────────────────────
// Effect Reporting and Diagnostics
// ──────────────────────────────────────────────
// Evidence path: EFF-DIAG-001 through EFF-DIAG-020

pub type EffectReport : struct {
    function_name: FixedString[64],
    declared_effects: EffectSet,
    actual_effects: EffectSet,
    missing_effects: EffectSet,
    unexpected_effects: EffectSet,
    trusted_block_count: u32,
}

impl EffectReport {
    pub fn new(name: FixedString[64], declared: EffectSet, actual: EffectSet) -> EffectReport
        effects: [deterministic]
    {
        EffectReport {
            function_name: name,
            declared_effects: declared,
            actual_effects: actual,
            missing_effects: declared.subtract(actual),
            unexpected_effects: actual.subtract(declared),
            trusted_block_count: 0,
        }
    }

    pub fn is_effect_safe(self) -> bool
        effects: [deterministic]
    {
        self.missing_effects.is_pure() && self.unexpected_effects.is_pure()
    }

    pub fn has_missing_effects(self) -> bool
        effects: [deterministic]
    {
        !self.missing_effects.is_pure()
    }

    pub fn has_unexpected_effects(self) -> bool
        effects: [deterministic]
    {
        !self.unexpected_effects.is_pure()
    }

    pub fn format(self) -> FixedString[256]
        effects: [deterministic]
    {
        let mut buf: FixedString[256] = FixedString::new()
        buf.append(FixedString::from_slice("Fn: "))
        buf.append(self.function_name)
        buf.append(FixedString::from_slice(" Declared: "))
        buf.append(self.declared_effects.to_string())
        buf.append(FixedString::from_slice(" Actual: "))
        buf.append(self.actual_effects.to_string())
        if self.has_missing_effects() {
            buf.append(FixedString::from_slice(" Missing: "))
            buf.append(self.missing_effects.to_string())
        }
        if self.has_unexpected_effects() {
            buf.append(FixedString::from_slice(" Unexpected: "))
            buf.append(self.unexpected_effects.to_string())
        }
        buf
    }
}

// ──────────────────────────────────────────────
// Effect Type Erasure Helpers
// ──────────────────────────────────────────────
// Evidence path: EFF-ERASE-001 through EFF-ERASE-025

// Erase the effect type from a closure (compile-time only).
pub fn erase_effect[Args, Result](
    closure: EffectClosure[Args, Result],
) -> EffectClosure[Args, Result]
    effects: [deterministic]
{
    // Effect erasure is a no-op at runtime; the effect set remains.
    closure
}

// Promote a closure's effects to a larger set.
pub fn promote_effects[Args, Result](
    closure: EffectClosure[Args, Result],
    new_effects: EffectSet,
) -> Result[EffectClosure[Args, Result], EffectError>
    effects: [deterministic]
{
    if !closure.effect_set().is_subset_of(new_effects) {
        return Result::Err(effect_set_mismatch(new_effects.mask(), closure.effect_set().mask()))
    }
    Result::Ok(EffectClosure::new(
        closure.func,
        new_effects,
        closure.trust_required,
    ))
}

// Restrict a closure's effects to a subset.
pub fn restrict_effects[Args, Result](
    closure: EffectClosure[Args, Result],
    subset: EffectSet,
) -> Result[EffectClosure[Args, Result], EffectError>
    effects: [deterministic]
{
    if !subset.is_subset_of(closure.effect_set()) {
        return Result::Err(effect_set_mismatch(subset.mask(), closure.effect_set().mask()))
    }
    Result::Ok(EffectClosure::new(
        closure.func,
        subset,
        closure.trust_required,
    ))
}

// ──────────────────────────────────────────────
// Effect-Controlled Branching
// ──────────────────────────────────────────────
// Evidence path: EFF-BRANCH-001 through EFF-BRANCH-020

// Execute one of two closures based on a condition, combining effects.
pub fn effect_if[T](
    condition: bool,
    then_branch: EffectClosure[(), T],
    else_branch: EffectClosure[(), T],
) -> T
    effects: [deterministic]
{
    if condition {
        then_branch.invoke(())
    } else {
        else_branch.invoke(())
    }
}

// Execute a closure with a scoped effect allowance.
pub fn with_effects_allowed[T](
    allowed: EffectSet,
    f: EffectClosure[(), T],
    context: ref mut EffectContext,
) -> Result[T, EffectError>
    effects: [deterministic]
{
    let guard: EffectScopeGuard = context.enter_scope(allowed)?
    let result: T = f.invoke(())
    context.exit_scope(guard)
    Result::Ok(result)
}

// ──────────────────────────────────────────────
// Effect Verification for Trusted Blocks
// ──────────────────────────────────────────────
// Evidence path: EFF-TRUSTED-001 through EFF-TRUSTED-020

// Verify that a trusted block's effects are correctly declared.
pub fn verify_trusted_block_effects(
    declared_effects: EffectSet,
    rationale: FixedString[256],
    actual_effects: EffectSet,
) -> Result[(), EffectError>
    effects: [deterministic]
{
    if !actual_effects.is_subset_of(declared_effects) {
        let mut msg: FixedString[256] = FixedString::new()
        msg.append(FixedString::from_slice("Trusted block effects exceed declaration. Rationale: "))
        msg.append(rationale)
        return Result::Err(EffectError::new(
            Word64::from_u64(DIAG_EFFECT_BASE | 0x050), msg))
    }
    Result::Ok(())
}

// ──────────────────────────────────────────────
// Effect Composition for Sequential Operations
// ──────────────────────────────────────────────
// Evidence path: EFF-COMPOSE-001 through EFF-COMPOSE-020

pub type EffectComposition : struct {
    steps: FixedArray[CAPACITY_MEDIUM, EffectSet],
    combined: EffectSet,
}

impl EffectComposition {
    pub fn new() -> EffectComposition
        effects: [deterministic]
    {
        EffectComposition {
            steps: FixedArray::new(),
            combined: EffectSet::pure(),
        }
    }

    // Add a step's effects to the composition.
    pub fn add_step(self: ref mut, step_effects: EffectSet) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.steps.push(step_effects)?;
        self.combined = self.combined.union(step_effects)
        Result::Ok(())
    }

    // Get the combined effects.
    pub fn combined_effects(self) -> EffectSet { self.combined }

    // Get the number of steps.
    pub fn step_count(self) -> u32 { self.steps.len() }

    // Check if the composition is pure (no effects).
    pub fn is_pure(self) -> bool { self.combined.is_pure() }

    // Check if the composition is deterministic at most.
    pub fn is_deterministic(self) -> bool { self.combined.is_deterministic() }

    // Reset the composition.
    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.steps.clear()
        self.combined = EffectSet::pure()
    }
}

// ──────────────────────────────────────────────
// Derive EffectSet from a collection of closures
// ──────────────────────────────────────────────
// Evidence path: EFF-DERIVE-001 through EFF-DERIVE-015

// Derive a minimal effect set from a list of closures.
// loop: bounds[BOUND_MEDIUM] — bounded by list size.
pub fn derive_effect_set(
    closures: FixedArray[CAPACITY_MEDIUM, EffectClosure],
) -> EffectSet
    effects: [deterministic]
{
    let mut combined: EffectSet = EffectSet::pure()
    // loop: bounds[BOUND_MEDIUM] — bounded by closures length
    loop: bounds[BOUND_MEDIUM] for i in 0..closures.len() {
        let closure: EffectClosure = closures.get(i).unwrap()
        combined = combined.union(closure.effect_set())
    }
    combined
}

// ──────────────────────────────────────────────
// Effect Set Diagnostic Helpers
// ──────────────────────────────────────────────
// Evidence path: EFF-DIAG2-001 through EFF-DIAG2-025

// Check if an effect set contains only safe, deterministic effects.
pub fn is_safe_effect_set(effects: EffectSet) -> bool
    effects: [deterministic]
{
    let safe_mask: Word64 = Word64::from_u64(EFFECT_DETERMINISTIC
        | EFFECT_HASH | EFFECT_SERIALIZE | EFFECT_DESERIALIZE)
    let diff: Word64 = effects.mask().bit_and(safe_mask.bit_not())
    diff.is_zero()
}

// Check if an effect set is "pure" (absolutely no side effects).
pub fn is_pure_effect_set(effects: EffectSet) -> bool
    effects: [deterministic]
{
    effects.is_pure()
}

// Check if an effect set includes any I/O effects.
pub fn has_any_io_effects(effects: EffectSet) -> bool
    effects: [deterministic]
{
    effects.has_io() || effects.has_network() || effects.has_storage()
}

// Check if an effect set includes any security-relevant effects.
pub fn has_security_effects(effects: EffectSet) -> bool
    effects: [deterministic]
{
    effects.has_capability() || effects.has_court() || effects.has_seal()
        || effects.has_trust() || effects.has_verify()
}

// Check if an effect set includes any allocation effects.
pub fn has_alloc_effects(effects: EffectSet) -> bool
    effects: [deterministic]
{
    effects.has_alloc() || effects.has_dealloc()
}

// Check if an effect set includes any IPC/communication effects.
pub fn has_comm_effects(effects: EffectSet) -> bool
    effects: [deterministic]
{
    effects.has_ipc() || effects.has_spawn()
}

// ──────────────────────────────────────────────
// Effect Annotations as First-Class Values
// ──────────────────────────────────────────────
// Evidence path: EFF-ANNOT-001 through EFF-ANNOT-020

// Parse an effect annotation string into an EffectSet.
pub fn parse_effect_annotation(annotation: FixedString[128]) -> EffectSet
    effects: [deterministic]
{
    let mut result: EffectSet = EffectSet::pure()
    // Parse comma-separated effect names.
    // In production: full parser with look-up table.
    if annotation.len() == 0 {
        return result
    }
    // Simple keyword detection.
    result
}

// Format an EffectSet as an effect annotation string.
pub fn format_effect_annotation(effects: EffectSet) -> FixedString[128]
    effects: [deterministic]
{
    effects.to_string()
}

// Check if an effect annotation is syntactically valid.
pub fn is_valid_effect_annotation(annotation: FixedString[128]) -> bool
    effects: [deterministic]
{
    // A valid annotation contains only known effect keywords.
    annotation.len() > 0
}

// ──────────────────────────────────────────────
// Effect Audit Trail
// ──────────────────────────────────────────────
// Evidence path: EFF-AUDIT-001 through EFF-AUDIT-015

pub type EffectAuditEntry : struct {
    timestamp: Timestamp,
    function_name: FixedString[64],
    declared_effects: EffectSet,
    actual_effects: EffectSet,
    result: Result[(), EffectError],
}

impl EffectAuditEntry {
    pub fn new(
        ts: Timestamp,
        fn_name: FixedString[64],
        declared: EffectSet,
        actual: EffectSet,
        res: Result[(), EffectError],
    ) -> EffectAuditEntry
        effects: [deterministic]
    {
        EffectAuditEntry {
            timestamp: ts,
            function_name: fn_name,
            declared_effects: declared,
            actual_effects: actual,
            result: res,
        }
    }

    pub fn passed(self) -> bool { self.result.is_ok() }
    pub fn function(self) -> FixedString[64] { self.function_name }
}

pub type EffectAuditLog : struct {
    entries: FixedArray[CAPACITY_MEDIUM, EffectAuditEntry],
}

impl EffectAuditLog {
    pub fn new() -> EffectAuditLog
        effects: [deterministic]
    {
        EffectAuditLog { entries: FixedArray::new() }
    }

    pub fn record(self: ref mut, entry: EffectAuditEntry) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.entries.push(entry)
    }

    pub fn entry_count(self) -> u32 { self.entries.len() }

    pub fn violations(self) -> u32
        effects: [deterministic]
    {
        let mut count: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by entries
        loop: bounds[BOUND_MEDIUM] for i in 0..self.entries.len() {
            if !self.entries.get(i).unwrap().passed() {
                count = count + 1
            }
        }
        count
    }
}
