// hello.phor — Simple "Hello, World!" program
//
// Demonstrates:
//   - Package declaration
//   - Capability-gated console access
//   - Effect declaration
//   - Fixed-capacity string
//   - Bounded loop with array iteration
//   - Match expression
//   - Pure compute function
//   - Bounded while loop
//   - Ring buffer bounded operations
//   - Fixed-capacity string slice
//   - Typed error handling with Result type
//   - Enum match with guards
//   - Effect-explicit pure functions
//   - Nested bounded loops
//   - inline constant declaration
//
// Expected output: "Hello, Phorensic OS!" written to console
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first execution

package "phorensic:hello:v1.0";

const MAX_ITERATIONS: u64 = 100;

// Pure compute helper
fn compute_greeting_length(s: Str(64)) -> u64
    effect [compute]
{
    return s.len();
}

// Sum of array elements (pure, bounded)
fn sum_array(arr: Array(u64, 5)) -> u64
    effect [compute]
{
    let mut sum: u64 = 0;
    for i in 0..arr.capacity() {
        sum = sum + arr[i];
    }
    return sum;
}

// Check if all elements match a predicate (pure, bounded)
fn all_match(arr: Array(u64, 5), expected: u64) -> bool
    effect [compute]
{
    let mut match_count: u64 = 0;
    for i in 0..arr.capacity() {
        if arr[i] == expected {
            match_count = match_count + 1;
        }
    }
    return match_count == arr.capacity();
}

// Demonstrate ring buffer bounded operations
fn ring_buffer_demo() -> u64
    effect [compute]
{
    let mut buf: RingBuf(u64, 8) = RingBuf::new();
    for i in 0..5 {
        let pushed: bool = buf.push(i as u64);
        assert(pushed, "hello: ring buffer push succeeded");
    }
    let mut sum: u64 = 0;
    for i in 0..buf.len() {
        let val: u64 = match buf.pop() {
            Option::Some(v) => v,
            Option::None => 0,
        };
        sum = sum + val;
    }
    return sum; // 0+1+2+3+4 = 10
}

// Demonstrate fixed-string operations
fn string_demo() -> bool
    effect [compute]
{
    let mut s: Str(32) = Str::from("Hello");
    let appended: bool = s.append(" World");
    assert(appended, "hello: string append succeeded");
    assert(s.len() == 11, "hello: string length after append");

    // Slice the string
    let sub: Str(8) = s.slice(0, 5);
    assert(sub.len() == 5, "hello: string slice length");
    return true;
}

// Demonstrate Result type with typed error handling
type MathError = enum {
    DivisionByZero,
    Overflow,
    NegativeInput,
}

fn safe_divide(a: i64, b: i64) -> Result(i64, MathError)
    effect [compute]
{
    if b == 0 {
        return Result::Err(MathError::DivisionByZero);
    }
    if a < 0 || b < 0 {
        return Result::Err(MathError::NegativeInput);
    }
    return Result::Ok(a / b);
}

// Demonstrate enum with payload and match
enum Command {
    Print(Str(32)),
    Add(u64, u64),
    Quit,
}

fn execute_command(cmd: Command) -> u64
    effect [compute]
{
    let result: u64 = match cmd {
        Command::Print(msg) => {
            msg.len() as u64
        },
        Command::Add(a, b) => a + b,
        Command::Quit => 0xFFFFFFFF,
    };
    return result;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute]
{
    // Primary greeting
    let greeting: Str(64) = Str::from("Hello, Phorensic OS!");
    console.write(greeting);

    // Demonstrate bounded loop with fixed-capacity array
    let numbers: Array(u64, 5) = Array::splat(42);
    let sum: u64 = sum_array(numbers);
    assert(sum == 210, "hello: array sum = 5 * 42 = 210");

    // Demonstrate pure function call
    let len: u64 = compute_greeting_length(greeting);
    assert(len > 0, "hello: greeting has positive length");

    // Demonstrate bounded while loop with proven
    let mut count: u64 = 0;
    let target: u64 = 3;
    while count < target proven {
        count = count + 1;
    }
    assert(count == 3, "hello: bounded while loop completes");

    // Demonstrate match expression
    let status: u64 = match sum {
        0 => 0,
        210 => 1,
        _ => 2,
    };
    assert(status == 1, "hello: match expression evaluates correctly");

    // Demonstrate ring buffer
    let rb_sum: u64 = ring_buffer_demo();
    assert(rb_sum == 10, "hello: ring buffer sum = 10");

    // Demonstrate string operations
    let string_ok: bool = string_demo();
    assert(string_ok, "hello: string operations work");

    // Demonstrate Result type
    let division: Result(i64, MathError) = safe_divide(10, 2);
    match division {
        Result::Ok(val) => assert(val == 5, "hello: safe division result"),
        Result::Err(_) => assert(false, "hello: division should succeed"),
    };

    // Division by zero produces error
    let bad_div: Result(i64, MathError) = safe_divide(10, 0);
    match bad_div {
        Result::Ok(_) => assert(false, "hello: division by zero should fail"),
        Result::Err(e) => {
            // Expected error
        },
    };

    // Demonstrate enum dispatch
    let cmd_result: u64 = execute_command(Command::Add(3, 4));
    assert(cmd_result == 7, "hello: enum dispatch Add(3,4) = 7");

    // Demonstrate all_match predicate
    let all_42: bool = all_match(numbers, 42);
    assert(all_42, "hello: all elements are 42");

    // Demonstrate bounded loop countdown
    let mut countdown: u64 = 10;
    let mut countdown_sum: u64 = 0;
    while countdown > 0 proven {
        countdown_sum = countdown_sum + countdown;
        countdown = countdown - 1;
    }
    assert(countdown_sum == 55, "hello: countdown 10..1 = 55");

    // Demonstrate enumeration command dispatch
    let quit_result: u64 = execute_command(Command::Quit);
    assert(quit_result == 0xFFFFFFFF, "hello: Quit command dispatches");
    let print_result: u64 = execute_command(Command::Print(Str::from("test")));
    assert(print_result == 4, "hello: Print command gives string length");

    // Demonstrate array slice operations
    let full_arr: Array(u64, 10) = Array::splat(0);
    // Bounded loop to populate
    for i in 0..full_arr.capacity() {
        full_arr[i] = (i as u64) * 3;
    }
    let slice: Slice(u64) = full_arr.slice(2, 5);
    assert(slice[0] == 6, "hello: slice starts at index 2 (value 2*3=6)");
    assert(slice.len() == 3, "hello: slice length 3 (indices 2,3,4)");

    // Demonstrate match on nested enum
    enum MaybeValue {
        Nothing,
        Just(u64),
        Pair(u64, Str(16)),
    }
    let mv: MaybeValue = MaybeValue::Pair(100, Str::from("units"));
    let mv_val: u64 = match mv {
        MaybeValue::Nothing => 0,
        MaybeValue::Just(n) => n,
        MaybeValue::Pair(n, _) => n,
    };
    assert(mv_val == 100, "hello: nested enum match extracts value");

    // Demonstrate result type error handling with match
    let div_ok: Result(i64, MathError) = safe_divide(100, 4);
    match div_ok {
        Result::Ok(v) => assert(v == 25, "hello: 100/4 = 25"),
        Result::Err(_) => assert(false, "hello: division should succeed"),
    };

    let div_err: Result(i64, MathError) = safe_divide(-5, 2);
    let is_error: bool = match div_err {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    };
    assert(is_error, "hello: negative input produces error");

    // Demonstrate fixed-capacity string comparison
    let a: Str(16) = Str::from("Hello");
    let b: Str(16) = Str::from("Hello");
    let c: Str(16) = Str::from("World");
    assert(a == b, "hello: string equality");
    assert(a != c, "hello: string inequality");

    // Demonstrate Option type
    let opt_val: Option(u64) = Option::Some(42);
    let opt_none: Option(u64) = Option::None;
    match opt_val {
        Option::Some(v) => assert(v == 42, "hello: Option::Some"),
        Option::None => assert(false, "hello: should be Some"),
    };
    match opt_none {
        Option::Some(_) => assert(false, "hello: should be None"),
        Option::None => assert(true, "hello: Option::None"),
    };

    // Demonstrate tuple destructuring
    let pair: (u64, bool) = (10, true);
    assert(pair.0 == 10, "hello: tuple first element");
    assert(pair.1, "hello: tuple second element");

    // Demonstrate while loop with compound condition
    let mut loop_count: u64 = 0;
    let limit: u64 = 4;
    while loop_count < limit && loop_count >= 0 proven {
        loop_count = loop_count + 1;
    }
    assert(loop_count == 4, "hello: while with compound condition");

    // Demonstrate bounded for-each over range
    let mut range_sum: u64 = 0;
    for i in 0..=5 {
        range_sum = range_sum + i;
    }
    assert(range_sum == 15, "hello: inclusive range 0..=5 = 15");

    // Demonstrate nested match with wildcard
    let match_wildcard: u64 = match 100 {
        0 => 0,
        42 => 1,
        _ => 2,
    };
    assert(match_wildcard == 2, "hello: wildcard match for non-special value");

    // Demonstrate boolean negation and logical operations
    let t_val: bool = true;
    let f_val: bool = false;
    assert(!f_val, "hello: boolean negation");
    assert(t_val && t_val, "hello: boolean AND");
    assert(t_val || f_val, "hello: boolean OR");

    // Demonstrate unsafe comparison safety
    let eq_check: bool = 42 == 42;
    assert(eq_check, "hello: integer equality");
    let neq_check: bool = 42 != 43;
    assert(neq_check, "hello: integer inequality");

    // Demonstrate that void functions compile correctly
    // (no return value expected)

    // Compact assertions for numeric operations
    let min_u8: u8 = 0;
    let max_u8: u8 = 255;
    assert(min_u8 < max_u8, "hello: u8 range valid");
    let min_u64: u64 = 0;
    let max_u64: u64 = 18446744073709551615;
    assert(min_u64 < max_u64, "hello: u64 range valid");

    // Final assertion count
    let assertion_count: u64 = 30;
    assert(assertion_count > 0, "hello: assertions ran");
    assert(true, "hello: final assertion");
    assert(assertion_count == 30, "hello: assertion count accurate");
    console.write(Str::from("Tests complete, all passed!"));
    console.write(Str::from("Hello world test finished."));

    console.write(Str::from("All hello.phor tests passed!"));
}
