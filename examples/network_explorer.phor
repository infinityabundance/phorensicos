// network_explorer.phor — Network exploration and diagnostic tool
//
// Demonstrates:
//   - Network interface enumeration with address display
//   - ARP cache viewer with dynamic/static entry tracking
//   - TCP connection table display with state machine tracking
//   - DNS resolver with A/AAAA/CNAME record support
//   - Ping utility with RTT statistics
//   - Trace route with hop-by-hop display
//   - Packet capture summary with protocol breakdown
//   - Bandwidth monitor with per-interface throughput
//   - Socket browser with capability-gated access
//   - Bounded loops and fixed-capacity collections
//
// Expected behavior:
//   - Lists network interfaces with addresses and flags
//   - Displays ARP cache with IP/MAC mappings
//   - Shows TCP connections with full state information
//   - Resolves DNS names to addresses
//   - Runs ping with sequence and RTT tracking
//   - Traces route through network hops
//   - Captures and summarizes packet data
//   - Monitors bandwidth usage per interface
//   - All operations bounded, effect-declared, residual-recorded
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:network_explorer:v1.0";

const MAX_INTERFACES: u64 = 16;
const MAX_ARP_ENTRIES: u64 = 64;
const MAX_TCP_CONNECTIONS: u64 = 128;
const MAX_DNS_RESULTS: u64 = 8;
const MAX_PING_SEQUENCES: u64 = 16;
const MAX_TRACE_HOPS: u64 = 32;
const MAX_CAPTURE_PACKETS: u64 = 256;
const MAX_PROTOCOLS: u64 = 8;
const MAX_SOCKETS: u64 = 64;
const MAX_BANDWIDTH_SAMPLES: u64 = 60;
const BANDWIDTH_WINDOW_SEC: u64 = 60;

struct NetworkInterface {
    name: Str(16),
    if_index: u32,
    mac: Array(u8, 6),
    ipv4: Array(u8, 4),
    netmask: Array(u8, 4),
    gateway: Array(u8, 4),
    flags: u32,
    mtu: u32,
    speed_mbps: u32,
    rx_bytes: u64,
    tx_bytes: u64,
    rx_packets: u64,
    tx_packets: u64,
    up: bool,
    loopback: bool,
}

struct ArpCacheEntry {
    ip: Array(u8, 4),
    mac: Array(u8, 6),
    interface: Str(16),
    is_static: bool,
    timestamp: u64,
    ttl_remaining: u64,
    resolved: bool,
}

struct TcpConnection {
    local_ip: Array(u8, 4),
    local_port: u16,
    remote_ip: Array(u8, 4),
    remote_port: u16,
    state: u8,
    recv_bytes: u64,
    sent_bytes: u64,
    retransmits: u32,
    rtt_us: u64,
    window_size: u32,
    socket_id: u64,
    established_sec: u64,
}

struct DnsResult {
    hostname: Str(64),
    record_type: u8,
    ttl: u32,
    ipv4_addresses: Array(Array(u8, 4), 8),
    ipv4_count: u64,
    ipv6_addresses: Array(Array(u16, 8), 8),
    ipv6_count: u64,
    cname: Str(64),
    authority: Str(64),
}

struct PingStats {
    target: Array(u8, 4),
    sent: u64,
    received: u64,
    lost: u64,
    min_rtt_ms: u64,
    max_rtt_ms: u64,
    avg_rtt_ms: u64,
    last_rtt_ms: u64,
    ttl: u8,
    packet_size: u64,
}

struct TraceHop {
    hop_number: u8,
    hop_ip: Array(u8, 4),
    rtt1_ms: u64,
    rtt2_ms: u64,
    rtt3_ms: u64,
    hostname: Str(64),
    responded: bool,
}

struct PacketSummary {
    protocol: Str(8),
    packet_count: u64,
    total_bytes: u64,
    min_size: u64,
    max_size: u64,
    avg_size: u64,
}

struct BandwidthSample {
    timestamp: u64,
    rx_rate_kbps: u32,
    tx_rate_kbps: u32,
    interface: Str(16),
}

struct SocketInfo {
    socket_id: u64,
    domain: u8,
    socket_type: u8,
    protocol: u8,
    local_addr: Array(u8, 6),
    remote_addr: Array(u8, 6),
    state: u8,
    recv_buf: u64,
    send_buf: u64,
    capability: u64,
    bound: bool,
    connected: bool,
}

fn list_interfaces() -> Array(NetworkInterface, 16)
    effect [io:read, residual]
{
    let ifaces: Array(NetworkInterface, 16) = Array::splat(
        NetworkInterface{ name: Str::from(""), if_index: 0, mac: Array::splat(0),
                          ipv4: Array::splat(0), netmask: Array::splat(0),
                          gateway: Array::splat(0), flags: 0, mtu: 0, speed_mbps: 0,
                          rx_bytes: 0, tx_bytes: 0, rx_packets: 0, tx_packets: 0,
                          up: false, loopback: false }
    );

    let mac0: Array(u8, 6) = Array::splat(0);
    mac0[0] = 0xAA; mac0[1] = 0xBB; mac0[2] = 0xCC; mac0[3] = 0xDD; mac0[4] = 0xEE; mac0[5] = 0x01;
    let ip0: Array(u8, 4) = Array::splat(0);
    ip0[0] = 192; ip0[1] = 168; ip0[2] = 1; ip0[3] = 10;
    let nm0: Array(u8, 4) = Array::splat(0);
    nm0[0] = 255; nm0[1] = 255; nm0[2] = 255; nm0[3] = 0;
    let gw0: Array(u8, 4) = Array::splat(0);
    gw0[0] = 192; gw0[1] = 168; gw0[2] = 1; gw0[3] = 1;

    ifaces[0] = NetworkInterface{
        name: Str::from("eth0"), if_index: 1, mac: mac0, ipv4: ip0,
        netmask: nm0, gateway: gw0, flags: 0x43, mtu: 1500, speed_mbps: 1000,
        rx_bytes: 1024000, tx_bytes: 512000, rx_packets: 8000, tx_packets: 4000,
        up: true, loopback: false,
    };

    let mac1: Array(u8, 6) = Array::splat(0);
    mac1[0] = 0x00; mac1[1] = 0x00; mac1[2] = 0x00; mac1[3] = 0x00; mac1[4] = 0x00; mac1[5] = 0x01;
    let ip1: Array(u8, 4) = Array::splat(0);
    ip1[0] = 127; ip1[1] = 0; ip1[2] = 0; ip1[3] = 1;

    ifaces[1] = NetworkInterface{
        name: Str::from("lo"), if_index: 2, mac: mac1, ipv4: ip1,
        netmask: nm0, gateway: Array::splat(0), flags: 0x49, mtu: 65536, speed_mbps: 0,
        rx_bytes: 128000, tx_bytes: 128000, rx_packets: 1000, tx_packets: 1000,
        up: true, loopback: true,
    };

    residual emit {
        op: "network_explorer.iflist",
        interfaces: 2,
    };

    return ifaces;
}

fn list_arp_cache() -> Array(ArpCacheEntry, 64)
    effect [io:read, residual]
{
    let entries: Array(ArpCacheEntry, 64) = Array::splat(
        ArpCacheEntry{ ip: Array::splat(0), mac: Array::splat(0), interface: Str::from(""),
                       is_static: false, timestamp: 0, ttl_remaining: 0, resolved: false }
    );

    let ip1: Array(u8, 4) = Array::splat(0);
    ip1[0] = 192; ip1[1] = 168; ip1[2] = 1; ip1[3] = 1;
    let mac1: Array(u8, 6) = Array::splat(0);
    mac1[0] = 0xAA; mac1[1] = 0xBB; mac1[2] = 0xCC; mac1[3] = 0xDD; mac1[4] = 0xEE; mac1[5] = 0x01;
    entries[0] = ArpCacheEntry{ ip: ip1, mac: mac1, interface: Str::from("eth0"),
                                is_static: false, timestamp: 1000, ttl_remaining: 300, resolved: true };

    let ip2: Array(u8, 4) = Array::splat(0);
    ip2[0] = 192; ip2[1] = 168; ip2[2] = 1; ip2[3] = 2;
    let mac2: Array(u8, 6) = Array::splat(0);
    mac2[0] = 0xAA; mac2[1] = 0xBB; mac2[2] = 0xCC; mac2[3] = 0xDD; mac2[4] = 0xEE; mac2[5] = 0x02;
    entries[1] = ArpCacheEntry{ ip: ip2, mac: mac2, interface: Str::from("eth0"),
                                is_static: true, timestamp: 1000, ttl_remaining: 0, resolved: true };

    residual emit {
        op: "network_explorer.arp",
        entries: 2,
    };

    return entries;
}

fn list_tcp_connections() -> Array(TcpConnection, 128)
    effect [io:read, residual]
{
    let conns: Array(TcpConnection, 128) = Array::splat(
        TcpConnection{ local_ip: Array::splat(0), local_port: 0, remote_ip: Array::splat(0),
                       remote_port: 0, state: 0, recv_bytes: 0, sent_bytes: 0,
                       retransmits: 0, rtt_us: 0, window_size: 0, socket_id: 0, established_sec: 0 }
    );

    let lip: Array(u8, 4) = Array::splat(0);
    lip[0] = 192; lip[1] = 168; lip[2] = 1; lip[3] = 10;
    let rip: Array(u8, 4) = Array::splat(0);
    rip[0] = 93; rip[1] = 184; rip[2] = 216; rip[3] = 34;

    conns[0] = TcpConnection{
        local_ip: lip, local_port: 54321, remote_ip: rip, remote_port: 80,
        state: 4, recv_bytes: 4096, sent_bytes: 1024, retransmits: 0,
        rtt_us: 15000, window_size: 65535, socket_id: 1001, established_sec: 120,
    };

    residual emit {
        op: "network_explorer.tcp",
        connections: 1,
    };

    return conns;
}

fn resolve_dns_hostname(hostname: Str(64)) -> DnsResult
    effect [io:read, residual]
{
    let ipv4s: Array(Array(u8, 4), 8) = Array::splat(Array::splat(0));
    let ip: Array(u8, 4) = Array::splat(0);
    ip[0] = 93; ip[1] = 184; ip[2] = 216; ip[3] = 34;
    ipv4s[0] = ip;

    let result: DnsResult = DnsResult{
        hostname: hostname,
        record_type: 1,
        ttl: 300,
        ipv4_addresses: ipv4s,
        ipv4_count: 1,
        ipv6_addresses: Array::splat(Array::splat(0)),
        ipv6_count: 0,
        cname: Str::from(""),
        authority: Str::from("ns1.example.com"),
    };

    residual emit {
        op: "network_explorer.dns_resolve",
        hostname: hostname,
        results: 1,
    };

    return result;
}

fn run_ping(target: Array(u8, 4), count: u64) -> PingStats
    effect [io:write, io:read, residual]
{
    let mut received: u64 = 0;
    let mut total_rtt: u64 = 0;
    let mut min_rtt: u64 = 0xFFFFFFFFFFFFFFFF;
    let mut max_rtt: u64 = 0;
    let mut last_rtt: u64 = 0;

    for i in 0..count {
        let seq_rtt: u64 = 10 + i * 2;
        received = received + 1;
        total_rtt = total_rtt + seq_rtt;
        if seq_rtt < min_rtt { min_rtt = seq_rtt; }
        if seq_rtt > max_rtt { max_rtt = seq_rtt; }
        last_rtt = seq_rtt;
    }

    let avg_rtt: u64 = if received > 0 { total_rtt / received } else { 0 };
    let lost: u64 = count - received;

    let stats: PingStats = PingStats{
        target: target,
        sent: count,
        received: received,
        lost: lost,
        min_rtt_ms: min_rtt,
        max_rtt_ms: max_rtt,
        avg_rtt_ms: avg_rtt,
        last_rtt_ms: last_rtt,
        ttl: 64,
        packet_size: 64,
    };

    residual emit {
        op: "network_explorer.ping",
        target_ip: target[0],
        sent: count,
        received: received,
        avg_rtt: avg_rtt,
    };

    return stats;
}

fn run_traceroute(target: Array(u8, 4), max_hops: u64) -> Array(TraceHop, 32)
    effect [io:write, io:read, residual]
{
    let hops: Array(TraceHop, 32) = Array::splat(
        TraceHop{ hop_number: 0, hop_ip: Array::splat(0), rtt1_ms: 0, rtt2_ms: 0,
                  rtt3_ms: 0, hostname: Str::from(""), responded: false }
    );

    for i in 0..max_hops {
        if i >= 32 { break; }
        let h: TraceHop = TraceHop{
            hop_number: i as u8 + 1,
            hop_ip: target,
            rtt1_ms: 5 + i as u64 * 3,
            rtt2_ms: 6 + i as u64 * 2,
            rtt3_ms: 4 + i as u64 * 4,
            hostname: Str::from(""),
            responded: true,
        };
        hops[i] = h;
    }

    residual emit {
        op: "network_explorer.traceroute",
        target: target[0],
        hops: max_hops,
    };

    return hops;
}

fn capture_packets(count: u64) -> Array(PacketSummary, 8)
    effect [io:read, residual]
{
    let summaries: Array(PacketSummary, 8) = Array::splat(
        PacketSummary{ protocol: Str::from(""), packet_count: 0, total_bytes: 0,
                       min_size: 0, max_size: 0, avg_size: 0 }
    );

    summaries[0] = PacketSummary{
        protocol: Str::from("TCP"), packet_count: 500, total_bytes: 320000,
        min_size: 40, max_size: 1500, avg_size: 640,
    };
    summaries[1] = PacketSummary{
        protocol: Str::from("UDP"), packet_count: 120, total_bytes: 48000,
        min_size: 30, max_size: 1400, avg_size: 400,
    };
    summaries[2] = PacketSummary{
        protocol: Str::from("ICMP"), packet_count: 20, total_bytes: 1600,
        min_size: 64, max_size: 84, avg_size: 80,
    };
    summaries[3] = PacketSummary{
        protocol: Str::from("ARP"), packet_count: 15, total_bytes: 840,
        min_size: 28, max_size: 28, avg_size: 56,
    };

    residual emit {
        op: "network_explorer.capture",
        packets: count,
        protocols: 4,
    };

    return summaries;
}

fn collect_bandwidth_samples(interface: Str(16)) -> RingBuf(BandwidthSample, 60)
    effect [io:read]
{
    let samples: RingBuf(BandwidthSample, 60) = RingBuf::new();
    for i in 0..10 {
        let s: BandwidthSample = BandwidthSample{
            timestamp: 1000 + i * 1000,
            rx_rate_kbps: (500 + i * 50) as u32,
            tx_rate_kbps: (200 + i * 25) as u32,
            interface: interface,
        };
        samples.push(s);
    }
    return samples;
}

fn list_sockets() -> Array(SocketInfo, 64)
    effect [io:read, residual]
{
    let sockets: Array(SocketInfo, 64) = Array::splat(
        SocketInfo{ socket_id: 0, domain: 0, socket_type: 0, protocol: 0,
                    local_addr: Array::splat(0), remote_addr: Array::splat(0),
                    state: 0, recv_buf: 0, send_buf: 0, capability: 0,
                    bound: false, connected: false }
    );

    sockets[0] = SocketInfo{
        socket_id: 1001, domain: 2, socket_type: 1, protocol: 6,
        local_addr: Array::splat(0), remote_addr: Array::splat(0),
        state: 4, recv_buf: 65536, send_buf: 65536, capability: 0x0007,
        bound: true, connected: true,
    };
    sockets[1] = SocketInfo{
        socket_id: 1002, domain: 2, socket_type: 2, protocol: 17,
        local_addr: Array::splat(0), remote_addr: Array::splat(0),
        state: 0, recv_buf: 65536, send_buf: 65536, capability: 0x0003,
        bound: true, connected: false,
    };

    residual emit {
        op: "network_explorer.sockets",
        sockets: 2,
    };

    return sockets;
}

fn format_mac(mac: Array(u8, 6)) -> Str(24)
    effect [compute]
{
    let mut result: Str(24) = Str::from("");
    for i in 0..6 {
        let hi: u8 = (mac[i] >> 4) & 0x0F;
        let lo: u8 = mac[i] & 0x0F;
        let hex_digits: Array(u8, 16) = Array::splat(0);
        hex_digits[0] = 48; hex_digits[1] = 49; hex_digits[2] = 50; hex_digits[3] = 51;
        hex_digits[4] = 52; hex_digits[5] = 53; hex_digits[6] = 54; hex_digits[7] = 55;
        hex_digits[8] = 56; hex_digits[9] = 57; hex_digits[10] = 65; hex_digits[11] = 66;
        hex_digits[12] = 67; hex_digits[13] = 68; hex_digits[14] = 69; hex_digits[15] = 70;

        result.append_char(hex_digits[hi] as char);
        result.append_char(hex_digits[lo] as char);
        if i < 5 {
            result.append_char(58 as char);
        }
    }
    return result;
}

fn format_ip4(ip: Array(u8, 4)) -> Str(16)
    effect [compute]
{
    let mut result: Str(16) = Str::from("");
    for i in 0..4 {
        result.append(ip[i] as Str(4));
        if i < 3 {
            result.append(Str::from("."));
        }
    }
    return result;
}

fn display_interfaces(ifaces: Array(NetworkInterface, 16), console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Network Interfaces ===\n"));
    for i in 0..ifaces.capacity() {
        let iface: NetworkInterface = ifaces[i];
        if iface.if_index == 0 { break; }
        let mac_str: Str(24) = format_mac(iface.mac);
        let ip_str: Str(16) = format_ip4(iface.ipv4);
        let mut line: Str(256) = Str::from("");
        line.append(iface.name);
        line.append(Str::from(": "));
        line.append(ip_str);
        line.append(Str::from("  MAC: "));
        line.append(mac_str);
        line.append(Str::from("  MTU: "));
        line.append(iface.mtu as Str(16));
        line.append(Str::from("  Speed: "));
        line.append(iface.speed_mbps as Str(16));
        line.append(Str::from("Mbps\n"));
        console.write(line);
    }
}

fn display_arp(entries: Array(ArpCacheEntry, 64), console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== ARP Cache ===\n"));
    for i in 0..entries.capacity() {
        let e: ArpCacheEntry = entries[i];
        if !e.resolved && e.ttl_remaining == 0 && i > 0 { break; }
        if e.ttl_remaining == 0 && !e.is_static && i > 0 { break; }
        let ip_str: Str(16) = format_ip4(e.ip);
        let mac_str: Str(24) = format_mac(e.mac);
        let mut line: Str(256) = Str::from("");
        line.append(ip_str);
        line.append(Str::from(" -> "));
        line.append(mac_str);
        line.append(Str::from("  ["));
        if e.is_static { line.append(Str::from("STATIC")); }
        else { line.append(Str::from("dynamic")); }
        line.append(Str::from("] TTL: "));
        line.append(e.ttl_remaining as Str(16));
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn display_tcp_connections(conns: Array(TcpConnection, 128), console: Cap(Console)) -> void
    effect [io:write]
{
    let state_names: Array(Str(12), 12) = Array::splat(Str::from(""));
    state_names[0] = Str::from("CLOSED");
    state_names[1] = Str::from("LISTEN");
    state_names[2] = Str::from("SYN_SENT");
    state_names[3] = Str::from("SYN_RCVD");
    state_names[4] = Str::from("ESTAB");
    state_names[5] = Str::from("FIN_W1");
    state_names[6] = Str::from("FIN_W2");
    state_names[7] = Str::from("CLOSE_W");
    state_names[8] = Str::from("CLOSING");
    state_names[9] = Str::from("LAST_ACK");
    state_names[10] = Str::from("TIME_W");
    state_names[11] = Str::from("UNKNOWN");

    console.write(Str::from("=== TCP Connections ===\n"));
    for i in 0..conns.capacity() {
        let c: TcpConnection = conns[i];
        if c.socket_id == 0 { break; }
        let lip: Str(16) = format_ip4(c.local_ip);
        let rip: Str(16) = format_ip4(c.remote_ip);
        let sname: Str(12) = state_names[c.state as u64];
        let mut line: Str(256) = Str::from("");
        line.append(lip);
        line.append(Str::from(":"));
        line.append(c.local_port as Str(16));
        line.append(Str::from(" -> "));
        line.append(rip);
        line.append(Str::from(":"));
        line.append(c.remote_port as Str(16));
        line.append(Str::from("  "));
        line.append(sname);
        line.append(Str::from("  RTT: "));
        line.append(c.rtt_us as Str(16));
        line.append(Str::from("us  RX: "));
        line.append(c.recv_bytes as Str(16));
        line.append(Str::from(" TX: "));
        line.append(c.sent_bytes as Str(16));
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn format_ip6(ip: Array(u16, 8)) -> Str(40)
    effect [compute]
{
    let mut result: Str(40) = Str::from("");
    for i in 0..8 {
        result.append(ip[i] as Str(4));
        if i < 7 {
            result.append(Str::from(":"));
        }
    }
    return result;
}

fn test_mtu_discovery(iface_mtu: u32, remote_mtu: u32) -> u32
    effect [compute]
{
    if iface_mtu < remote_mtu {
        return iface_mtu;
    }
    return remote_mtu;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, io:read, residual]
{
    console.write(Str::from("Network Explorer v1.0\n"));
    console.write(Str::from("======================\n"));

    // Interface list
    let ifaces: Array(NetworkInterface, 16) = list_interfaces();
    display_interfaces(ifaces, console);
    assert(ifaces[0].if_index > 0, "ne: interface 0 exists");

    // ARP cache
    let arp: Array(ArpCacheEntry, 64) = list_arp_cache();
    display_arp(arp, console);
    assert(arp[0].resolved, "ne: ARP entry resolved");

    // TCP connections
    let tcp_conns: Array(TcpConnection, 128) = list_tcp_connections();
    display_tcp_connections(tcp_conns, console);
    assert(tcp_conns[0].socket_id > 0, "ne: TCP connection exists");

    // DNS resolution
    console.write(Str::from("=== DNS Resolution ===\n"));
    let dns: DnsResult = resolve_dns_hostname(Str::from("example.com"));
    let dns_ip: Str(16) = format_ip4(dns.ipv4_addresses[0]);
    let mut dns_line: Str(256) = Str::from("");
    dns_line.append(dns.hostname);
    dns_line.append(Str::from(" -> "));
    dns_line.append(dns_ip);
    dns_line.append(Str::from(" (TTL: "));
    dns_line.append(dns.ttl as Str(16));
    dns_line.append(Str::from(")\n"));
    console.write(dns_line);
    assert(dns.ipv4_count > 0, "ne: DNS returned address");

    // Ping
    console.write(Str::from("=== Ping Statistics ===\n"));
    let target: Array(u8, 4) = Array::splat(0);
    target[0] = 8; target[1] = 8; target[2] = 8; target[3] = 8;
    let ping: PingStats = run_ping(target, 4);
    let target_str: Str(16) = format_ip4(ping.target);
    let mut ping_line: Str(256) = Str::from("PING ");
    ping_line.append(target_str);
    ping_line.append(Str::from(": sent="));
    ping_line.append(ping.sent as Str(16));
    ping_line.append(Str::from(" received="));
    ping_line.append(ping.received as Str(16));
    ping_line.append(Str::from(" lost="));
    ping_line.append(ping.lost as Str(16));
    ping_line.append(Str::from(" avg="));
    ping_line.append(ping.avg_rtt_ms as Str(16));
    ping_line.append(Str::from("ms\n"));
    console.write(ping_line);
    assert(ping.sent > 0, "ne: ping sent packets");

    // Traceroute
    console.write(Str::from("=== Traceroute ===\n"));
    let hops: Array(TraceHop, 32) = run_traceroute(target, 5);
    for i in 0..5 {
        let h: TraceHop = hops[i];
        let hop_ip: Str(16) = format_ip4(h.hop_ip);
        let mut hop_line: Str(256) = Str::from("  ");
        hop_line.append(h.hop_number as Str(16));
        hop_line.append(Str::from(". "));
        hop_line.append(hop_ip);
        hop_line.append(Str::from("  "));
        hop_line.append(h.rtt1_ms as Str(16));
        hop_line.append(Str::from("ms "));
        hop_line.append(h.rtt2_ms as Str(16));
        hop_line.append(Str::from("ms "));
        hop_line.append(h.rtt3_ms as Str(16));
        hop_line.append(Str::from("ms\n"));
        console.write(hop_line);
    }
    assert(hops[0].hop_number > 0, "ne: trace route has hops");

    // Packet capture summary
    console.write(Str::from("=== Packet Capture Summary ===\n"));
    let pkt_summaries: Array(PacketSummary, 8) = capture_packets(1000);
    for i in 0..4 {
        let ps: PacketSummary = pkt_summaries[i];
        if ps.packet_count == 0 { break; }
        let mut ps_line: Str(256) = Str::from("  ");
        ps_line.append(ps.protocol);
        ps_line.append(Str::from(": "));
        ps_line.append(ps.packet_count as Str(16));
        ps_line.append(Str::from(" packets, "));
        ps_line.append(ps.total_bytes as Str(16));
        ps_line.append(Str::from(" bytes (avg "));
        ps_line.append(ps.avg_size as Str(16));
        ps_line.append(Str::from(")\n"));
        console.write(ps_line);
    }
    assert(pkt_summaries[0].packet_count > 0, "ne: packets captured");

    // Bandwidth monitor
    console.write(Str::from("=== Bandwidth Monitor (eth0) ===\n"));
    let bw_samples: RingBuf(BandwidthSample, 60) = collect_bandwidth_samples(Str::from("eth0"));
    for i in 0..bw_samples.len() {
        let s: BandwidthSample = bw_samples[i];
        let mut bw_line: Str(128) = Str::from("  @");
        bw_line.append(s.timestamp as Str(16));
        bw_line.append(Str::from(" RX: "));
        bw_line.append(s.rx_rate_kbps as Str(16));
        bw_line.append(Str::from(" Kbps TX: "));
        bw_line.append(s.tx_rate_kbps as Str(16));
        bw_line.append(Str::from(" Kbps\n"));
        console.write(bw_line);
    }
    assert(bw_samples.len() > 0, "ne: bandwidth samples collected");

    // Socket browser
    console.write(Str::from("=== Socket Browser ===\n"));
    let sockets: Array(SocketInfo, 64) = list_sockets();
    for i in 0..sockets.capacity() {
        let s: SocketInfo = sockets[i];
        if s.socket_id == 0 { break; }
        let mut sock_line: Str(256) = Str::from("  Socket ");
        sock_line.append(s.socket_id as Str(16));
        sock_line.append(Str::from(": domain="));
        sock_line.append(s.domain as Str(16));
        sock_line.append(Str::from(" type="));
        sock_line.append(s.socket_type as Str(16));
        sock_line.append(Str::from(" proto="));
        sock_line.append(s.protocol as Str(16));
        sock_line.append(Str::from(" state="));
        sock_line.append(s.state as Str(16));
        sock_line.append(Str::from(" cap=0x"));
        sock_line.append(s.capability as Str(16));
        sock_line.append(Str::from("\n"));
        console.write(sock_line);
    }
    assert(sockets[0].socket_id > 0, "ne: socket browser works");

    // MTU discovery test
    let path_mtu: u32 = test_mtu_discovery(1500, 1460);
    assert(path_mtu == 1460, "ne: path MTU discovery correct");

    // IPv6 address formatting
    let ip6: Array(u16, 8) = Array::splat(0);
    ip6[0] = 0x2001; ip6[1] = 0x0DB8; ip6[2] = 0x0000; ip6[3] = 0x0000;
    ip6[4] = 0x0000; ip6[5] = 0x0000; ip6[6] = 0x0000; ip6[7] = 0x0001;
    let ip6_str: Str(40) = format_ip6(ip6);
    assert(ip6_str.len() > 0, "ne: IPv6 formatted");

    // Network protocol detection
    console.write(Str::from("\n=== Protocol Detection ===\n"));
    let protocols: Array(Str(8), 6) = Array::splat(Str::from(""));
    protocols[0] = Str::from("TCP");
    protocols[1] = Str::from("UDP");
    protocols[2] = Str::from("ICMP");
    protocols[3] = Str::from("ARP");
    protocols[4] = Str::from("DNS");
    protocols[5] = Str::from("DHCP");
    for i in 0..6 {
        let mut pline: Str(64) = Str::from("  Protocol: ");
        pline.append(protocols[i]);
        pline.append(Str::from("\n"));
        console.write(pline);
    }

    // Connection tracking statistics
    console.write(Str::from("\n=== Connection Tracking Stats ===\n"));
    let tracked_conns: u64 = 15;
    let tracked_tcp: u64 = 10;
    let tracked_udp: u64 = 5;
    assert(tracked_conns == tracked_tcp + tracked_udp, "ne: connection tracking consistent");
    let mut tline: Str(128) = Str::from("Tracked: ");
    tline.append(tracked_conns as Str(16));
    tline.append(Str::from(" (TCP: "));
    tline.append(tracked_tcp as Str(16));
    tline.append(Str::from(", UDP: "));
    tline.append(tracked_udp as Str(16));
    tline.append(Str::from(")\n"));
    console.write(tline);

    // Multicast group membership
    console.write(Str::from("\n=== Multicast Groups ===\n"));
    let mcast_groups: Array(Str(16), 4) = Array::splat(Str::from(""));
    mcast_groups[0] = Str::from("224.0.0.1");
    mcast_groups[1] = Str::from("224.0.0.251");
    for i in 0..2 {
        let mut mline: Str(64) = Str::from("  Group: ");
        mline.append(mcast_groups[i]);
        mline.append(Str::from("\n"));
        console.write(mline);
    }

    // Summary statistics
    console.write(Str::from("\n=== Network Summary Statistics ===\n"));
    let total_rx_bytes: u64 = 1024000;
    let total_tx_bytes: u64 = 512000;
    let total_rx_packets: u64 = 8000;
    let total_tx_packets: u64 = 4000;
    let avg_rx_rate_kbps: u64 = total_rx_bytes / 60;
    let avg_tx_rate_kbps: u64 = total_tx_bytes / 60;
    assert(avg_rx_rate_kbps > 0, "ne: average RX rate computed");

    console.write(Str::from("\n=== Network exploration complete ===\n"));

    residual emit {
        op: "network_explorer.complete",
        interfaces: 2,
        arp_entries: 2,
        tcp_conns: 1,
        dns_results: dns.ipv4_count,
        ping_sent: ping.sent,
        ping_lost: ping.lost,
        trace_hops: 5,
        protocols_captured: 4,
        bandwidth_samples: bw_samples.len(),
        sockets: 2,
    };
}
