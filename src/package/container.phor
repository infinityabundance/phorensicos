// container.phor — PackageContainer type: all sections, header, evidence containers
// Phorensic Package: sealed semantic container definition
// Spec: SEALED_PACKAGE_FORMAT.md — Package Container Structure, Header Format
// Grammar: PHORENSIC_GRAMMAR.md §42 Sealed Package Stage

package package.container;

use forensic_store.store_object::{
    Hash256, hash256_zero, hash256_equal,
    TrustState, TrustLevel,
    Identity, identity_equal, identity_is_valid,
    DialectProfile,
    ResidualRecord, ResidualHistory, ResidualSeverity,
    ObjectRole,
    Signature, AuditorStamp,
    BuildRecipe, DependencySpec, BuildStep,
    ExpansionReceipt, StageReceipt, ReplayCheckpoint,
};
use forensic_store.store_key::{
    StoreKey, store_key_equal, store_key_zero,
};

// ============================================================================
// Package Magic and Version Constants
// ============================================================================

/// Package container magic bytes: "PHORSPEC\x00"
const PACKAGE_MAGIC: u64 = 0x50484F5253504543;

/// Current format version.
const FORMAT_VERSION: u32 = 1;

/// Current container version.
const CONTAINER_VERSION: u32 = 1;

// ============================================================================
// Package Header
// ============================================================================

/// The package header appears at the beginning of every .phor-spec container.
///
/// Spec definition:
///   PackageHeader:
///     magic: "PHORSPEC\x00"
///     format_version: u32
///     container_version: u32
///     package_name: String
///     package_version: semver::Version
///     target_arch: String
///     target_profile: String
///     source_hash: Hash256
///     binary_hash: Hash256
///     container_hash: Hash256
///     trust_state: TrustState
///     created_at: Timestamp
///     created_by: Identity
struct PackageHeader
    layout packed
{
    /// Magic bytes for identification
    magic: Array[u8, 9],
    /// Format version of the container layout
    format_version: u32,
    /// Version of this specific container
    container_version: u32,
    /// Package name
    package_name: Array[u8, 128],
    package_name_len: u32,
    /// Package version (semver)
    package_version: Array[u8, 32],
    package_version_len: u32,
    /// Major version component
    version_major: u32,
    /// Minor version component
    version_minor: u32,
    /// Patch version component
    version_patch: u32,
    /// Pre-release tag
    version_pre: Array[u8, 32],
    version_pre_len: u32,
    /// Target architecture
    target_arch: Array[u8, 32],
    target_arch_len: u32,
    /// Target profile (e.g., "release", "debug", "optimized")
    target_profile: Array[u8, 32],
    target_profile_len: u32,
    /// Hash of the source archive
    source_hash: Hash256,
    /// Hash of the emitted binary
    binary_hash: Hash256,
    /// Hash of the full container
    container_hash: Hash256,
    /// Current trust state
    trust_state: TrustState,
    /// Creation timestamp
    created_at: u64,
    /// Creator identity
    created_by: Identity,
    /// Package kind
    package_kind: PackageKind,
    /// Reserved for future header fields
    reserved: Array[u64, 16],
}

/// The kind of package.
type PackageKind = enum {
    /// A library package
    Library = 0,
    /// An executable / application
    Application = 1,
    /// A dialect profile definition
    DialectProfilePkg = 2,
    /// A build tool / compiler
    Tool = 3,
    /// A court definition package
    CourtPackage = 4,
    /// An oracle implementation
    OraclePackage = 5,
    /// A driver package
    DriverPackage = 6,
    /// A kernel component
    KernelComponent = 7,
    /// A system service
    ServicePackage = 8,
    /// A test suite package
    TestPackage = 9,
    /// Documentation package
    Documentation = 10,
    /// A meta-package (composes other packages)
    MetaPackage = 11,
}

// ============================================================================
// Source Evidence
// ============================================================================

/// Source evidence section — the source archive and its verification data.
///
/// Spec: No source = no valid package.
struct SourceEvidence
    layout packed
{
    /// Hash of the complete source tree
    source_hash: Hash256,
    /// Source manifest entries (bounded to 1024)
    manifest: Array[SourceManifestEntry, 1024],
    manifest_count: u32,
    /// Source archive (bounded to 16MB)
    source_archive: Array[u8, 16777216],
    source_archive_len: u32,
    /// Source archive compression format
    archive_format: ArchiveFormat,
    /// Signature over the source hash
    source_signature: Signature,
    /// Whether the source signature is present
    source_sig_present: bool,
    /// Source format identifier
    source_format: Array[u8, 32],
    source_format_len: u32,
}

/// A single entry in the source manifest.
struct SourceManifestEntry
    layout packed
{
    /// File path (relative to source root)
    path: Array[u8, 256],
    path_len: u32,
    /// Hash of file contents
    file_hash: Hash256,
    /// File size in bytes
    file_size: u64,
    /// File type
    file_type: SourceFileType,
}

type SourceFileType = enum {
    Regular = 0,
    Directory = 1,
    Symlink = 2,
    BuildRecipe = 3,
    DialectProfile = 4,
    Manifest = 5,
    TestFixture = 6,
    Documentation = 7,
}

type ArchiveFormat = enum {
    None = 0,
    TarGzip = 1,
    TarZstd = 2,
    TarLz4 = 3,
    Zip = 4,
}

// ============================================================================
// Build Evidence
// ============================================================================

/// Build evidence section — recipe, dialect, compiler, environment.
struct BuildEvidence
    layout packed
{
    /// The build recipe
    recipe: BuildRecipe,
    /// Dialect profile used
    dialect_profile: DialectProfile,
    /// Compiler version string
    compiler_version: Array[u8, 64],
    compiler_version_len: u32,
    /// Hash of the compiler binary
    compiler_hash: Hash256,
    /// Store key reference to the compiler image
    compiler_image_key: StoreKey,
    /// Environment capsule
    environment_capsule: EnvironmentCapsule,
    /// Dependency graph entries (bounded to 256)
    dependency_graph: Array[DependencyGraphEntry, 256],
    dependency_count: u32,
}

/// A single entry in the dependency graph.
struct DependencyGraphEntry
    layout packed
{
    /// Package name
    package_name: Array[u8, 128],
    package_name_len: u32,
    /// Package version
    package_version: Array[u8, 32],
    package_version_len: u32,
    /// Store key of the dependency package
    package_store_key: StoreKey,
    /// Whether this dependency is optional
    optional: bool,
}

/// Environment capsule — captures the full build environment.
struct EnvironmentCapsule
    layout packed
{
    /// CPU feature names (bounded to 32)
    cpu_features: Array[Array[u8, 64], 32],
    cpu_feature_lens: Array[u32, 32],
    cpu_feature_count: u32,
    /// Memory configuration
    memory_config_name: Array[u8, 64],
    memory_config_name_len: u32,
    /// Memory size in MB
    memory_size_mb: u64,
    /// Device map entries (bounded to 16)
    device_map: Array[DeviceMapEntry, 16],
    device_count: u32,
    /// Oracle identities (bounded to 16)
    oracle_identities: Array[Identity, 16],
    oracle_count: u32,
    /// Court versions (bounded to 16)
    court_versions: Array[CourtVersionEntry, 16],
    court_version_count: u32,
}

/// A single device map entry.
struct DeviceMapEntry
    layout packed
{
    device_name: Array[u8, 64],
    device_name_len: u32,
    device_type: Array[u8, 32],
    device_type_len: u32,
    device_identity: Identity,
}

/// A court version entry.
struct CourtVersionEntry
    layout packed
{
    court_name: Array[u8, 64],
    court_name_len: u32,
    court_version: Array[u8, 32],
    court_version_len: u32,
    court_store_key: StoreKey,
}

// ============================================================================
// Expansion Evidence
// ============================================================================

/// Expansion evidence — records all macro expansions and include resolutions.
struct ExpansionEvidence
    layout packed
{
    /// Expansion receipts (bounded to 64)
    expansion_receipts: Array[ExpansionReceipt, 64],
    receipt_count: u32,
    /// Include resolution log entries (bounded to 256)
    include_resolution_log: Array[IncludeResolutionEntry, 256],
    include_resolution_count: u32,
    /// Macro expansion trace entries (bounded to 256)
    macro_expansion_trace: Array[MacroExpansionEntry, 256],
    macro_expansion_count: u32,
}

/// A single include resolution entry.
struct IncludeResolutionEntry
    layout packed
{
    /// The include path as written in source
    include_path: Array[u8, 256],
    include_path_len: u32,
    /// The resolved absolute path
    resolved_path: Array[u8, 256],
    resolved_path_len: u32,
    /// Hash of the resolved file
    resolved_hash: Hash256,
}

/// A single macro expansion trace entry.
struct MacroExpansionEntry
    layout packed
{
    /// Macro name
    macro_name: Array[u8, 128],
    macro_name_len: u32,
    /// Input fragment hash
    input_fragment_hash: Hash256,
    /// Expanded output hash
    expanded_output_hash: Hash256,
}

// ============================================================================
// Compilation Evidence
// ============================================================================

/// Compilation evidence — receipts for each compilation stage.
struct CompilationEvidence
    layout packed
{
    /// Parse stage receipt
    parse_receipt: StageReceipt,
    /// Expansion stage receipt
    expansion_receipt: StageReceipt,
    /// Lowering stage receipt
    lowering_receipt: StageReceipt,
    /// Optimization pass receipts (bounded to 32)
    optimization_receipts: Array[OptimizationPassReceipt, 32],
    optimization_count: u32,
    /// Code generation receipt
    codegen_receipt: StageReceipt,
    /// Link receipt
    link_receipt: StageReceipt,
}

/// Optimization pass receipt.
struct OptimizationPassReceipt
    layout packed
{
    /// Pass name
    pass_name: Array[u8, 64],
    pass_name_len: u32,
    /// Receipt for this pass
    receipt: StageReceipt,
}

// ============================================================================
// Binary Evidence
// ============================================================================

/// Binary evidence — the executable image and its source correspondence.
struct BinaryEvidence
    layout packed
{
    /// Executable image bytes (bounded to 16MB)
    executable_image: Array[u8, 16777216],
    executable_image_len: u32,
    /// Binary hash
    binary_hash: Hash256,
    /// Signature over the binary hash
    binary_signature: Signature,
    /// Whether the binary signature is present
    binary_sig_present: bool,
    /// Source-to-binary seal
    source_to_binary_seal: SourceToBinarySeal,
    /// Byte comparison receipt with provenance map
    byte_comparison_receipt: ByteComparisonReceipt,
}

/// Source-to-binary seal — the mandatory link proving correspondence.
struct SourceToBinarySeal
    layout packed
{
    /// Source hash
    source_hash: Hash256,
    /// Binary hash
    binary_hash: Hash256,
    /// Seal type identifier
    seal_type: Array[u8, 32],
    seal_type_len: u32,
    /// Seal scheme name
    seal_scheme: Array[u8, 32],
    seal_scheme_len: u32,
    /// Signature over (source_hash || binary_hash)
    seal_signature: Signature,
    /// Whether the seal is present
    seal_present: bool,
}

/// Byte comparison receipt — shows the provenance trail for each byte.
struct ByteComparisonReceipt
    layout packed
{
    /// Provenance map entries (bounded to 4096)
    provenance_map: Array[ProvenanceMapEntry, 4096],
    provenance_count: u32,
    /// Total bytes traced
    total_bytes: u64,
    /// Bytes with complete provenance
    traced_bytes: u64,
}

/// A single provenance map entry.
struct ProvenanceMapEntry
    layout packed
{
    /// Byte offset in the binary
    byte_offset: u64,
    /// Source location reference
    source_location: Array[u8, 256],
    source_location_len: u32,
    /// Compiler pass that produced this byte
    pass_name: Array[u8, 64],
    pass_name_len: u32,
    /// Rule identifier applied
    rule_id: Array[u8, 64],
    rule_id_len: u32,
}

// ============================================================================
// Replay Evidence
// ============================================================================

/// Replay evidence — checkpoints, residual graph, verification report.
struct ReplayEvidence
    layout packed
{
    /// Replay checkpoints (bounded to 64)
    replay_checkpoints: Array[StageReceipt, 64],
    checkpoint_count: u32,
    /// Residual graph edges (bounded to 1024)
    residual_graph_edges: Array[ResidualGraphEdge, 1024],
    edge_count: u32,
    /// Replay verification report
    replay_verification_report: ReplayVerificationReport,
}

/// An edge in the residual dependency graph.
struct ResidualGraphEdge
    layout packed
{
    source_residual_id: u64,
    target_residual_id: u64,
    edge_type: u8,
}

/// Replay verification report.
struct ReplayVerificationReport
    layout packed
{
    /// Replay status
    replay_status: ReplayStatus,
    /// Hash chain from the replay
    replay_hash_chain: Array[Hash256, 64],
    hash_chain_count: u32,
    /// Residuals produced during replay
    replay_residuals: Array[ResidualRecord, 64],
    replay_residual_count: u32,
    /// Replay verdict
    replay_verdict: ReplayVerdict,
}

type ReplayStatus = enum {
    Full = 0,
    Partial = 1,
    Failed = 2,
}

type ReplayVerdict = enum {
    Matches = 0,
    Diverges = 1,
    Inconclusive = 2,
}

// ============================================================================
// Court Evidence
// ============================================================================

/// Court evidence — oracle traces, comparisons, verdicts, promotions.
struct CourtEvidence
    layout packed
{
    /// Oracle trace entries (bounded to 64)
    oracle_traces: Array[OracleTraceEntry, 64],
    oracle_trace_count: u32,
    /// Oracle comparison results (bounded to 64)
    oracle_comparison_results: Array[OracleComparisonResult, 64],
    comparison_count: u32,
    /// Court verdicts (bounded to 32)
    court_verdicts: Array[CourtVerdictEntry, 32],
    verdict_count: u32,
    /// Trust promotion records (bounded to 32)
    trust_promotion_records: Array[TrustPromotionRecord, 32],
    promotion_count: u32,
}

/// A single oracle trace entry.
struct OracleTraceEntry
    layout packed
{
    /// Oracle identity
    oracle_id: Identity,
    /// Input hash
    input_hash: Hash256,
    /// Output hash
    output_hash: Hash256,
    /// Timestamp of observation
    timestamp: u64,
}

/// Result of comparing native and oracle outputs.
struct OracleComparisonResult
    layout packed
{
    /// Comparison identifier
    comparison_id: Array[u8, 64],
    comparison_id_len: u32,
    /// Oracle identifier
    oracle_id: Array[u8, 64],
    oracle_id_len: u32,
    /// Native output hash
    native_output_hash: Hash256,
    /// Oracle output hash
    oracle_output_hash: Hash256,
    /// Divergence classification
    divergence: DivergenceClassification,
    /// Comparison residuals
    comparison_residuals: Array[ResidualRecord, 16],
    comparison_residual_count: u32,
}

type DivergenceClassification = enum {
    None = 0,
    Acceptable = 1,
    Significant = 2,
}

/// A court verdict record.
struct CourtVerdictEntry
    layout packed
{
    /// Court identifier
    court_id: Array[u8, 64],
    court_id_len: u32,
    /// Case identifier
    case_id: Array[u8, 64],
    case_id_len: u32,
    /// Object under judgment (hash)
    object_under_judgment: Hash256,
    /// Verdict
    verdict: ObjectVerdict,
    /// Timestamp of verdict
    verdict_timestamp: u64,
    /// Judge identity
    judge_identity: Identity,
}

type ObjectVerdict = enum {
    /// Object is authentic and untampered
    Authentic = 0,
    /// Object is inauthentic or tampered
    Inauthentic = 1,
    /// Object matches reference implementation
    IdentityPreserved = 2,
    /// Object diverges from reference
    Divergent = 3,
    /// Court could not reach a verdict
    InconclusiveVerdict = 4,
    /// Object is promoted to trusted state
    Promoted = 5,
    /// Object is rejected
    Rejected = 6,
}

/// A trust promotion record.
struct TrustPromotionRecord
    layout packed
{
    /// Hash of the promoted object
    object_hash: Hash256,
    /// Original trust state
    from_state: TrustLevel,
    /// Target trust state
    to_state: TrustLevel,
    /// Evidence references (bounded to 16)
    evidence_references: Array[Hash256, 16],
    evidence_count: u32,
    /// Court verdict references (bounded to 16)
    court_verdict_references: Array[Array[u8, 64], 16],
    court_verdict_ref_lens: Array[u32, 16],
    court_verdict_ref_count: u32,
    /// Promotion timestamp
    promotion_timestamp: u64,
}

// ============================================================================
// Package Signatures Section
// ============================================================================

/// Signatures section of the package container.
struct PackageSignatures
    layout packed
{
    /// Signature over the full container hash
    full_container_signature: Signature,
    /// Whether the full container signature is present
    full_sig_present: bool,
    /// Evidence chain signature (ordered chain of evidence hashes)
    evidence_chain_signature: Signature,
    /// Whether the evidence chain signature is present
    evidence_sig_present: bool,
    /// Auditor stamps (bounded to 32)
    auditor_stamps: Array[AuditorStamp, 32],
    auditor_stamp_count: u32,
}

// ============================================================================
// PackageContainer — The Complete Type
// ============================================================================

/// A PackageContainer is a sealed semantic container that includes source,
/// binary, evidence, receipts, and signatures in one verifiable bundle.
///
/// Structure:
///   PackageContainer.phor-spec
///   ├── header
///   ├── source-evidence/
///   ├── build-evidence/
///   ├── expansion-evidence/
///   ├── compilation-evidence/
///   ├── binary-evidence/
///   ├── replay-evidence/
///   ├── court-evidence/
///   └── signatures/
struct PackageContainer
    layout packed
{
    /// Package header
    header: PackageHeader,
    /// Source evidence
    source_evidence: SourceEvidence,
    /// Build evidence
    build_evidence: BuildEvidence,
    /// Expansion evidence
    expansion_evidence: ExpansionEvidence,
    /// Compilation evidence
    compilation_evidence: CompilationEvidence,
    /// Binary evidence
    binary_evidence: BinaryEvidence,
    /// Replay evidence
    replay_evidence: ReplayEvidence,
    /// Court evidence
    court_evidence: CourtEvidence,
    /// Signatures
    signatures: PackageSignatures,
    /// Store key of this container (computed from content)
    container_key: StoreKey,
    /// Whether this container has been verified
    verified: bool,
    /// Verification report hash
    verification_hash: Hash256,
    /// Whether this container is sealed (source↔binary chain complete)
    sealed: bool,
    /// Container version
    container_version: u32,
    /// Reserved for future container fields
    reserved: Array[u64, 32],
}

// ============================================================================
// PackageContainer Construction
// ============================================================================

/// Create a new empty package container with a header.
fn package_container_new(
    name: Array[u8, 128],
    name_len: u32,
    version_major: u32,
    version_minor: u32,
    version_patch: u32,
    target_arch: Array[u8, 32],
    target_arch_len: u32,
    target_profile: Array[u8, 32],
    target_profile_len: u32,
    creator: Identity,
    timestamp: u64,
    kind: PackageKind,
) -> PackageContainer
    effect [compute, residual]
{
    let zero_hash: Hash256 = hash256_zero();
    let trust: TrustState = TrustState {
        level: TrustLevel::Untrusted,
        promoted_at_gen: 0,
        promoted_by: creator,
        promoted_at_timestamp: timestamp,
        decay_interval_seconds: 0,
        decayed: false,
        evidence_chain_hash: zero_hash,
        verification_count: 0,
        reserved: Array[u64, 4]::zeroed(),
    };

    let empty_source: SourceEvidence = SourceEvidence {
        source_hash: zero_hash,
        manifest: Array[SourceManifestEntry, 1024]::zeroed(),
        manifest_count: 0,
        source_archive: Array[u8, 16777216]::zeroed(),
        source_archive_len: 0,
        archive_format: ArchiveFormat::None,
        source_signature: Signature {
            algorithm: Array[u8, 32]::zeroed(), algorithm_len: 0,
            sig_bytes: Array[u8, 512]::zeroed(), sig_bytes_len: 0,
            signer_key: zero_hash,
            signer_identity: creator,
            signed_at: timestamp, verified: false,
        },
        source_sig_present: false,
        source_format: Array[u8, 32]::zeroed(),
        source_format_len: 0,
    };

    let empty_build: BuildEvidence = BuildEvidence {
        recipe: BuildRecipe {
            name: Array[u8, 128]::zeroed(), name_len: 0,
            version: Array[u8, 64]::zeroed(), version_len: 0,
            dependencies: Array[DependencySpec, 64]::zeroed(), dependency_count: 0,
            build_steps: Array[BuildStep, 64]::zeroed(), step_count: 0,
            output_artifacts: Array[Array[u8, 128], 16]::zeroed(),
            output_artifact_lens: Array[u32, 16]::zeroed(), output_count: 0,
            environment_capsule: EnvironmentCapsule {
                cpu_features: Array[Array[u8, 64], 32]::zeroed(),
                cpu_feature_lens: Array[u32, 32]::zeroed(), cpu_feature_count: 0,
                memory_config_name: Array[u8, 64]::zeroed(), memory_config_name_len: 0,
                memory_size_mb: 0,
                device_map: Array[DeviceMapEntry, 16]::zeroed(), device_count: 0,
                oracle_identities: Array[Identity, 16]::zeroed(), oracle_count: 0,
                court_versions: Array[CourtVersionEntry, 16]::zeroed(), court_version_count: 0,
            },
        },
        dialect_profile: DialectProfile {
            name: Array[u8, 64]::zeroed(), name_len: 0,
            version: Array[u8, 32]::zeroed(), version_len: 0,
            language: Array[u8, 32]::zeroed(), language_len: 0,
            abi: Array[u8, 32]::zeroed(), abi_len: 0,
            features: Array[Array[u8, 64], 32]::zeroed(),
            feature_lens: Array[u32, 32]::zeroed(), feature_count: 0,
            restrictions: Array[Array[u8, 128], 32]::zeroed(),
            restriction_lens: Array[u32, 32]::zeroed(), restriction_count: 0,
        },
        compiler_version: Array[u8, 64]::zeroed(), compiler_version_len: 0,
        compiler_hash: zero_hash,
        compiler_image_key: zero_hash,
        environment_capsule: EnvironmentCapsule {
            cpu_features: Array[Array[u8, 64], 32]::zeroed(),
            cpu_feature_lens: Array[u32, 32]::zeroed(), cpu_feature_count: 0,
            memory_config_name: Array[u8, 64]::zeroed(), memory_config_name_len: 0,
            memory_size_mb: 0,
            device_map: Array[DeviceMapEntry, 16]::zeroed(), device_count: 0,
            oracle_identities: Array[Identity, 16]::zeroed(), oracle_count: 0,
            court_versions: Array[CourtVersionEntry, 16]::zeroed(), court_version_count: 0,
        },
        dependency_graph: Array[DependencyGraphEntry, 256]::zeroed(),
        dependency_count: 0,
    };

    let empty_expansion: ExpansionEvidence = ExpansionEvidence {
        expansion_receipts: Array[ExpansionReceipt, 64]::zeroed(),
        receipt_count: 0,
        include_resolution_log: Array[IncludeResolutionEntry, 256]::zeroed(),
        include_resolution_count: 0,
        macro_expansion_trace: Array[MacroExpansionEntry, 256]::zeroed(),
        macro_expansion_count: 0,
    };

    let empty_compilation: CompilationEvidence = CompilationEvidence {
        parse_receipt: StageReceipt::zeroed(),
        expansion_receipt: StageReceipt::zeroed(),
        lowering_receipt: StageReceipt::zeroed(),
        optimization_receipts: Array[OptimizationPassReceipt, 32]::zeroed(),
        optimization_count: 0,
        codegen_receipt: StageReceipt::zeroed(),
        link_receipt: StageReceipt::zeroed(),
    };

    let empty_binary: BinaryEvidence = BinaryEvidence {
        executable_image: Array[u8, 16777216]::zeroed(),
        executable_image_len: 0,
        binary_hash: zero_hash,
        binary_signature: Signature {
            algorithm: Array[u8, 32]::zeroed(), algorithm_len: 0,
            sig_bytes: Array[u8, 512]::zeroed(), sig_bytes_len: 0,
            signer_key: zero_hash,
            signer_identity: creator,
            signed_at: timestamp, verified: false,
        },
        binary_sig_present: false,
        source_to_binary_seal: SourceToBinarySeal {
            source_hash: zero_hash,
            binary_hash: zero_hash,
            seal_type: Array[u8, 32]::zeroed(), seal_type_len: 0,
            seal_scheme: Array[u8, 32]::zeroed(), seal_scheme_len: 0,
            seal_signature: Signature::zeroed(),
            seal_present: false,
        },
        byte_comparison_receipt: ByteComparisonReceipt {
            provenance_map: Array[ProvenanceMapEntry, 4096]::zeroed(),
            provenance_count: 0,
            total_bytes: 0,
            traced_bytes: 0,
        },
    };

    let empty_replay: ReplayEvidence = ReplayEvidence {
        replay_checkpoints: Array[StageReceipt, 64]::zeroed(),
        checkpoint_count: 0,
        residual_graph_edges: Array[ResidualGraphEdge, 1024]::zeroed(),
        edge_count: 0,
        replay_verification_report: ReplayVerificationReport {
            replay_status: ReplayStatus::Failed,
            replay_hash_chain: Array[Hash256, 64]::zeroed(),
            hash_chain_count: 0,
            replay_residuals: Array[ResidualRecord, 64]::zeroed(),
            replay_residual_count: 0,
            replay_verdict: ReplayVerdict::Inconclusive,
        },
    };

    let empty_court: CourtEvidence = CourtEvidence {
        oracle_traces: Array[OracleTraceEntry, 64]::zeroed(),
        oracle_trace_count: 0,
        oracle_comparison_results: Array[OracleComparisonResult, 64]::zeroed(),
        comparison_count: 0,
        court_verdicts: Array[CourtVerdictEntry, 32]::zeroed(),
        verdict_count: 0,
        trust_promotion_records: Array[TrustPromotionRecord, 32]::zeroed(),
        promotion_count: 0,
    };

    let empty_sigs: PackageSignatures = PackageSignatures {
        full_container_signature: Signature::zeroed(),
        full_sig_present: false,
        evidence_chain_signature: Signature::zeroed(),
        evidence_sig_present: false,
        auditor_stamps: Array[AuditorStamp, 32]::zeroed(),
        auditor_stamp_count: 0,
    };

    let header: PackageHeader = PackageHeader {
        magic: Array[u8, 9]::from_literal("PHORSPEC\0"),
        format_version: FORMAT_VERSION,
        container_version: CONTAINER_VERSION,
        package_name: name,
        package_name_len: name_len,
        package_version: Array[u8, 32]::zeroed(),
        package_version_len: 0,
        version_major: version_major,
        version_minor: version_minor,
        version_patch: version_patch,
        version_pre: Array[u8, 32]::zeroed(),
        version_pre_len: 0,
        target_arch: target_arch,
        target_arch_len: target_arch_len,
        target_profile: target_profile,
        target_profile_len: target_profile_len,
        source_hash: zero_hash,
        binary_hash: zero_hash,
        container_hash: zero_hash,
        trust_state: trust,
        created_at: timestamp,
        created_by: creator,
        package_kind: kind,
        reserved: Array[u64, 16]::zeroed(),
    };

    residual emit {
        op: "package_container.create",
        name_prefix: name[0] as u64,
        kind: kind as u64,
        version: version_major,
        timestamp: timestamp,
    };

    return PackageContainer {
        header: header,
        source_evidence: empty_source,
        build_evidence: empty_build,
        expansion_evidence: empty_expansion,
        compilation_evidence: empty_compilation,
        binary_evidence: empty_binary,
        replay_evidence: empty_replay,
        court_evidence: empty_court,
        signatures: empty_sigs,
        container_key: zero_hash,
        verified: false,
        verification_hash: zero_hash,
        sealed: false,
        container_version: CONTAINER_VERSION,
        reserved: Array[u64, 32]::zeroed(),
    };
}

// ============================================================================
// PackageContainer — Section Setters
// ============================================================================

/// Set the source evidence on a container.
fn package_set_source(
    pkg: PackageContainer,
    source: SourceEvidence,
) -> PackageContainer
    effect [compute, residual]
{
    residual emit {
        op: "package.set_source",
        source_hash_prefix: source.source_hash.bytes[0] as u64,
        file_count: source.manifest_count,
    };

    return PackageContainer {
        header: pkg.header,
        source_evidence: source,
        build_evidence: pkg.build_evidence,
        expansion_evidence: pkg.expansion_evidence,
        compilation_evidence: pkg.compilation_evidence,
        binary_evidence: pkg.binary_evidence,
        replay_evidence: pkg.replay_evidence,
        court_evidence: pkg.court_evidence,
        signatures: pkg.signatures,
        container_key: pkg.container_key,
        verified: pkg.verified,
        verification_hash: pkg.verification_hash,
        sealed: pkg.sealed,
        container_version: pkg.container_version,
        reserved: pkg.reserved,
    };
}

/// Set the build evidence on a container.
fn package_set_build(
    pkg: PackageContainer,
    build: BuildEvidence,
) -> PackageContainer
    effect [compute, residual]
{
    residual emit {
        op: "package.set_build",
        dep_count: build.dependency_count,
    };

    return PackageContainer {
        header: pkg.header,
        source_evidence: pkg.source_evidence,
        build_evidence: build,
        expansion_evidence: pkg.expansion_evidence,
        compilation_evidence: pkg.compilation_evidence,
        binary_evidence: pkg.binary_evidence,
        replay_evidence: pkg.replay_evidence,
        court_evidence: pkg.court_evidence,
        signatures: pkg.signatures,
        container_key: pkg.container_key,
        verified: pkg.verified,
        verification_hash: pkg.verification_hash,
        sealed: pkg.sealed,
        container_version: pkg.container_version,
        reserved: pkg.reserved,
    };
}

/// Set the binary evidence on a container.
fn package_set_binary(
    pkg: PackageContainer,
    binary: BinaryEvidence,
) -> PackageContainer
    effect [compute, residual]
{
    residual emit {
        op: "package.set_binary",
        binary_len: binary.executable_image_len,
        seal_present: binary.source_to_binary_seal.seal_present as u64,
    };

    return PackageContainer {
        header: pkg.header,
        source_evidence: pkg.source_evidence,
        build_evidence: pkg.build_evidence,
        expansion_evidence: pkg.expansion_evidence,
        compilation_evidence: pkg.compilation_evidence,
        binary_evidence: binary,
        replay_evidence: pkg.replay_evidence,
        court_evidence: pkg.court_evidence,
        signatures: pkg.signatures,
        container_key: pkg.container_key,
        verified: pkg.verified,
        verification_hash: pkg.verification_hash,
        sealed: pkg.sealed,
        container_version: pkg.container_version,
        reserved: pkg.reserved,
    };
}

/// Set the compilation evidence on a container.
fn package_set_compilation(
    pkg: PackageContainer,
    compilation: CompilationEvidence,
) -> PackageContainer
    effect [compute, residual]
{
    residual emit {
        op: "package.set_compilation",
        opt_count: compilation.optimization_count,
    };

    return PackageContainer {
        header: pkg.header,
        source_evidence: pkg.source_evidence,
        build_evidence: pkg.build_evidence,
        expansion_evidence: pkg.expansion_evidence,
        compilation_evidence: compilation,
        binary_evidence: pkg.binary_evidence,
        replay_evidence: pkg.replay_evidence,
        court_evidence: pkg.court_evidence,
        signatures: pkg.signatures,
        container_key: pkg.container_key,
        verified: pkg.verified,
        verification_hash: pkg.verification_hash,
        sealed: pkg.sealed,
        container_version: pkg.container_version,
        reserved: pkg.reserved,
    };
}

/// Set the court evidence on a container.
fn package_set_court_evidence(
    pkg: PackageContainer,
    court: CourtEvidence,
) -> PackageContainer
    effect [compute, residual]
{
    residual emit {
        op: "package.set_court_evidence",
        verdict_count: court.verdict_count,
        promotion_count: court.promotion_count,
    };

    return PackageContainer {
        header: pkg.header,
        source_evidence: pkg.source_evidence,
        build_evidence: pkg.build_evidence,
        expansion_evidence: pkg.expansion_evidence,
        compilation_evidence: pkg.compilation_evidence,
        binary_evidence: pkg.binary_evidence,
        replay_evidence: pkg.replay_evidence,
        court_evidence: court,
        signatures: pkg.signatures,
        container_key: pkg.container_key,
        verified: pkg.verified,
        verification_hash: pkg.verification_hash,
        sealed: pkg.sealed,
        container_version: pkg.container_version,
        reserved: pkg.reserved,
    };
}

/// Mark the container as sealed.
fn package_seal(pkg: PackageContainer) -> PackageContainer
    effect [compute, residual]
{
    residual emit {
        op: "package.seal",
        name_prefix: pkg.header.package_name[0] as u64,
    };

    return PackageContainer {
        header: pkg.header,
        source_evidence: pkg.source_evidence,
        build_evidence: pkg.build_evidence,
        expansion_evidence: pkg.expansion_evidence,
        compilation_evidence: pkg.compilation_evidence,
        binary_evidence: pkg.binary_evidence,
        replay_evidence: pkg.replay_evidence,
        court_evidence: pkg.court_evidence,
        signatures: pkg.signatures,
        container_key: pkg.container_key,
        verified: pkg.verified,
        verification_hash: pkg.verification_hash,
        sealed: true,
        container_version: pkg.container_version,
        reserved: pkg.reserved,
    };
}

// ============================================================================
// StageReceipt zeroed helper
// ============================================================================

impl StageReceipt {
    fn zeroed() -> StageReceipt {
        return StageReceipt {
            stage_name: Array[u8, 64]::zeroed(), stage_name_len: 0,
            stage_version: Array[u8, 32]::zeroed(), stage_version_len: 0,
            input_hash: hash256_zero(),
            output_hash: hash256_zero(),
            applied_rules: Array[RuleRef, 32]::zeroed(), rule_count: 0,
            residuals: Array[ResidualRecord, 32]::zeroed(), residual_count: 0,
            timestamp: 0,
        };
    }
}

// Reference to a compiler rule
struct RuleRef
    layout packed
{
    rule_id: Array[u8, 64],
    rule_id_len: u32,
    rule_version: Array[u8, 32],
    rule_version_len: u32,
}

impl Signature {
    fn zeroed() -> Signature {
        return Signature {
            algorithm: Array[u8, 32]::zeroed(), algorithm_len: 0,
            sig_bytes: Array[u8, 512]::zeroed(), sig_bytes_len: 0,
            signer_key: hash256_zero(),
            signer_identity: Identity {
                name: Array[u8, 128]::zeroed(), name_len: 0,
                key_fingerprint: hash256_zero(),
                dialect_scope: Array[u8, 64]::zeroed(), dialect_scope_len: 0,
                version: 0, established_at_gen: 0,
            },
            signed_at: 0, verified: false,
        };
    }
}

// ============================================================================
// Container Hash Computation
// ============================================================================

/// Compute a hash over the entire package container for integrity verification.
fn package_compute_container_hash(pkg: PackageContainer) -> Hash256
    effect [compute]
{
    let mut hash: Hash256 = hash256_zero();

    // Hash: magic bytes
    for i in 0..9 {
        hash.bytes[i % 32] = hash.bytes[i % 32] ^ pkg.header.magic[i];
    }

    // Hash: version fields
    hash.bytes[0] = hash.bytes[0] ^ (pkg.header.format_version & 0xFF) as u8;
    hash.bytes[1] = hash.bytes[1] ^ ((pkg.header.format_version >> 8) & 0xFF) as u8;
    hash.bytes[2] = hash.bytes[2] ^ (pkg.header.container_version & 0xFF) as u8;
    hash.bytes[3] = hash.bytes[3] ^ ((pkg.header.container_version >> 8) & 0xFF) as u8;

    // Hash: source hash
    for i in 0..32 {
        hash.bytes[i] = hash.bytes[i] ^ pkg.source_evidence.source_hash.bytes[i];
    }

    // Hash: binary hash
    for i in 0..32 {
        hash.bytes[i] = hash.bytes[i] ^ pkg.binary_evidence.binary_hash.bytes[i];
    }

    // Hash: seal hash if present
    if pkg.binary_evidence.source_to_binary_seal.seal_present {
        let seal: SourceToBinarySeal = pkg.binary_evidence.source_to_binary_seal;
        for i in 0..32 {
            hash.bytes[i] = hash.bytes[i] ^ seal.source_hash.bytes[i];
            hash.bytes[i] = hash.bytes[i] ^ seal.binary_hash.bytes[i];
        }
    }

    // Hash: compiler hash
    for i in 0..32 {
        hash.bytes[i] = hash.bytes[i] ^ pkg.build_evidence.compiler_hash.bytes[i];
    }

    return hash;
}
