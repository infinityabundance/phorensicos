// ─────────────────────────────────────────────────────────────
// S.M.A.R.T. / Health Information Log
// ─────────────────────────────────────────────────────────────

struct NvmeFullSmartHealthLog {
    critical_warning: u8,
    temperature_ktemp: u16,
    available_spare: u8,
    available_spare_threshold: u8,
    percentage_used: u8,
    endurance_group: [u8; 26],
    data_units_read: u128,
    data_units_written: u128,
    host_read_commands: u128,
    host_write_commands: u128,
    controller_busy_time: u128,
    power_cycles: u128,
    power_on_hours: u128,
    unsafe_shutdowns: u128,
    media_errors: u128,
    num_err_log_entries: u128,
    warning_temp_time: u32,
    critical_temp_time: u32,
    temp_sensor: Array(u16, 8),
    thermal_management_temp1: u32,
    thermal_management_temp2: u32,
}

fn nvme_full_parse_smart_log(data: Array(u8, 512)) -> NvmeFullSmartHealthLog
    effect [deterministic]
{
    return NvmeFullSmartHealthLog {
        critical_warning: data[0],
        temperature_ktemp: (data[1] as u16) | ((data[2] as u16) << 8),
        available_spare: data[3],
        available_spare_threshold: data[4],
        percentage_used: data[5],
        endurance_group: [0u8; 26],
        data_units_read: (data[64] as u128),
        data_units_written: 0,
        host_read_commands: 0,
        host_write_commands: 0,
        controller_busy_time: 0,
        power_cycles: 0,
        power_on_hours: 0,
        unsafe_shutdowns: 0,
        media_errors: 0,
        num_err_log_entries: 0,
        warning_temp_time: 0,
        critical_temp_time: 0,
        temp_sensor: Array::zeroed(),
        thermal_management_temp1: 0,
        thermal_management_temp2: 0,
    };
}

