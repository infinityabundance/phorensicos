// ============================================================================
// trust_ladder.phor — TrustState Enum, Promotion Logic, Demotion Logic,
//                     Policy
// ============================================================================
// The trust ladder is the core trust model for Phorensic OS. Every object
// in the system — code, data, package, capability — has a trust state that
// determines what operations are permitted. Trust progresses strictly
// upward through the ladder as evidence accumulates.
//
// Ladder: Unknown (0) → Observed (1) → Replayed (2) → OracleCompared (3)
//         → ResidualStable (4) → Sealed (5) → Promoted (6)
//
// Demotion is possible when new evidence contradicts prior understanding.
// ============================================================================

package "phorensic:trust_ladder:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type TrustLadderError = enum {
    PromotionDenied = 0x01,
    DemotionDenied = 0x02,
    InvalidPromotionPath = 0x03,
    InvalidDemotionPath = 0x04,
    RequirementsNotMet = 0x05,
    MissingEvidence = 0x06,
    EvidenceContradicted = 0x07,
    TrustStateLocked = 0x08,
    MaximumPromotionsExceeded = 0x09,
    PromotionAlreadyApplied = 0x0A,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

type Option[T] = enum {
    Some(value: T),
    None,
}

// ============================================================================
// Trust State Enum
// ============================================================================

type TrustState = enum {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

// ============================================================================
// Promotion Requirements per Step
// ============================================================================

type PromotionRequirements = struct {
    from_state: TrustState,
    to_state: TrustState,
    minimum_observations: u64,
    minimum_replays: u64,
    minimum_oracle_comparisons: u64,
    need_residual_stability_check: bool,
    need_court_verification: bool,
    need_oracle_verification: bool,
    maximum_allowed_divergences: u64,
    need_evidence_chain_sealed: bool,
    description: FixedString[256],
}

// ============================================================================
// Trust State Info
// ============================================================================

type TrustStateInfo = struct {
    state: TrustState,
    state_name: FixedString[32],
    level: u64,
    description: FixedString[256],
    can_execute: bool,
    can_load: bool,
    can_access_capabilities: bool,
    can_promote: bool,
    can_demote: bool,
}

// ============================================================================
// Trust Record for an Object
// ============================================================================

type TrustRecord = struct {
    object_key: Hash256,
    current_state: TrustState,
    previous_states: Array[TrustState, 16],
    state_count: u64,
    promoted_at: Array[u64, 16],
    promotion_count: u64,
    demoted_at: Array[u64, 8],
    demotion_count: u64,
    last_verified_at: u64,
    total_observations: u64,
    total_replays: u64,
    total_oracle_comparisons: u64,
    total_divergences: u64,
    is_locked: bool,
    last_verdict: Option[Hash256],
    residual_stability_hash: Hash256,
    evidence_chain_hash: Hash256,
}

// ============================================================================
// Trust Policy
// ============================================================================

type TrustPolicy = struct {
    policy_name: FixedString[128],
    allow_promotion_without_court: bool,
    allow_promotion_without_oracle: bool,
    require_human_review_for_sealed: bool,
    minimum_replays_for_promotion: u64,
    maximum_divergence_ratio: u64,
    auto_demote_on_divergence: bool,
    require_evidence_chain: bool,
    description: FixedString[512],
}

// ============================================================================
// Trust Ladder Manager
// ============================================================================

type TrustLadderManager = struct {
    records: Array[TrustRecord, 1024],
    record_count: u64,
    policy: TrustPolicy,
    generation: u64,
}

// ============================================================================
// Create Trust Record
// ============================================================================

fn create_trust_record(object_key: Hash256) -> TrustRecord
    effects: [compute]
{
    let empty_states: Array[TrustState, 16] = Array[TrustState, 16]::zeroed();
    let empty_promoted_at: Array[u64, 16] = Array[u64, 16]::zeroed();
    let empty_demoted_at: Array[u64, 8] = Array[u64, 8]::zeroed();

    empty_states[0] = TrustState::Unknown;

    return TrustRecord {
        object_key: object_key,
        current_state: TrustState::Unknown,
        previous_states: empty_states,
        state_count: 1,
        promoted_at: empty_promoted_at,
        promotion_count: 0,
        demoted_at: empty_demoted_at,
        demotion_count: 0,
        last_verified_at: kernel.tick_count(),
        total_observations: 0,
        total_replays: 0,
        total_oracle_comparisons: 0,
        total_divergences: 0,
        is_locked: false,
        last_verdict: Option::None,
        residual_stability_hash: Hash256 { bytes: Array[u8, 32]::zeroed() },
        evidence_chain_hash: Hash256 { bytes: Array[u8, 32]::zeroed() },
    };
}

// ============================================================================
// Create Default Trust Policy
// ============================================================================

fn create_default_trust_policy() -> TrustPolicy
    effects: [compute]
{
    return TrustPolicy {
        policy_name: FixedString[128]::from_literal("default"),
        allow_promotion_without_court: false,
        allow_promotion_without_oracle: false,
        require_human_review_for_sealed: true,
        minimum_replays_for_promotion: 3,
        maximum_divergence_ratio: 5,
        auto_demote_on_divergence: true,
        require_evidence_chain: true,
        description: FixedString[512]::from_literal("Default strict trust policy"),
    };
}

// ============================================================================
// Create Trust Ladder Manager
// ============================================================================

fn create_trust_ladder_manager() -> TrustLadderManager
    effects: [compute]
{
    let empty_records: Array[TrustRecord, 1024] = Array[TrustRecord, 1024]::zeroed();
    let policy: TrustPolicy = create_default_trust_policy();

    return TrustLadderManager {
        records: empty_records,
        record_count: 0,
        policy: policy,
        generation: 1,
    };
}

// ============================================================================
// Register Object in Trust Ladder
// ============================================================================

fn register_object(manager: &mut TrustLadderManager, object_key: Hash256) -> Result<u64, TrustLadderError>
    effects: [compute, residual]
{
    if manager.record_count >= 1024 {
        return Err(TrustLadderError::MaximumPromotionsExceeded);
    }

    // Check for duplicate
    for i in 0..manager.record_count {
        if manager.records[i].object_key == object_key {
            return Ok(i);
        }
    }

    let record: TrustRecord = create_trust_record(object_key);
    let idx: u64 = manager.record_count;
    manager.records[idx] = record;
    manager.record_count = idx + 1;

    @emit_residual("trust_ladder.register", "object_registered", idx);

    return Ok(idx);
}

// ============================================================================
// Get Promotion Requirements
// ============================================================================

fn get_promotion_requirements(from: TrustState, to: TrustState) -> Result[PromotionRequirements, TrustLadderError>
    effects: [compute]
{
    if to as u64 <= from as u64 {
        return Err(TrustLadderError::InvalidPromotionPath);
    }

    if to as u64 > from as u64 + 2 {
        // Allow promotion by at most 2 levels (e.g., Observed → OracleCompared)
        return Err(TrustLadderError::InvalidPromotionPath);
    }

    match from {
        TrustState::Unknown => {
            if to == TrustState::Observed {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 1, minimum_replays: 0,
                    minimum_oracle_comparisons: 0, need_residual_stability_check: false,
                    need_court_verification: false, need_oracle_verification: false,
                    maximum_allowed_divergences: 100, need_evidence_chain_sealed: false,
                    description: FixedString[256]::from_literal("Promote from Unknown to Observed after first execution capture"),
                });
            }
        }
        TrustState::Observed => {
            if to == TrustState::Replayed {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 3, minimum_replays: 1,
                    minimum_oracle_comparisons: 0, need_residual_stability_check: false,
                    need_court_verification: false, need_oracle_verification: false,
                    maximum_allowed_divergences: 50, need_evidence_chain_sealed: false,
                    description: FixedString[256]::from_literal("Promote from Observed to Replayed after successful replay"),
                });
            }
            if to == TrustState::OracleCompared {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 3, minimum_replays: 1,
                    minimum_oracle_comparisons: 1, need_residual_stability_check: false,
                    need_court_verification: false, need_oracle_verification: true,
                    maximum_allowed_divergences: 10, need_evidence_chain_sealed: false,
                    description: FixedString[256]::from_literal("Promote from Observed to OracleCompared after oracle verification"),
                });
            }
        }
        TrustState::Replayed => {
            if to == TrustState::OracleCompared {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 5, minimum_replays: 3,
                    minimum_oracle_comparisons: 1, need_residual_stability_check: false,
                    need_court_verification: false, need_oracle_verification: true,
                    maximum_allowed_divergences: 5, need_evidence_chain_sealed: false,
                    description: FixedString[256]::from_literal("Promote from Replayed to OracleCompared after oracle comparison"),
                });
            }
            if to == TrustState::ResidualStable {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 10, minimum_replays: 5,
                    minimum_oracle_comparisons: 3, need_residual_stability_check: true,
                    need_court_verification: false, need_oracle_verification: true,
                    maximum_allowed_divergences: 2, need_evidence_chain_sealed: false,
                    description: FixedString[256]::from_literal("Promote from Replayed to ResidualStable after consistent residual patterns"),
                });
            }
        }
        TrustState::OracleCompared => {
            if to == TrustState::ResidualStable {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 10, minimum_replays: 5,
                    minimum_oracle_comparisons: 5, need_residual_stability_check: true,
                    need_court_verification: false, need_oracle_verification: true,
                    maximum_allowed_divergences: 1, need_evidence_chain_sealed: false,
                    description: FixedString[256]::from_literal("Promote from OracleCompared to ResidualStable"),
                });
            }
            if to == TrustState::Sealed {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 20, minimum_replays: 10,
                    minimum_oracle_comparisons: 10, need_residual_stability_check: true,
                    need_court_verification: true, need_oracle_verification: true,
                    maximum_allowed_divergences: 0, need_evidence_chain_sealed: true,
                    description: FixedString[256]::from_literal("Promote from OracleCompared to Sealed after court verification"),
                });
            }
        }
        TrustState::ResidualStable => {
            if to == TrustState::Sealed {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 30, minimum_replays: 15,
                    minimum_oracle_comparisons: 15, need_residual_stability_check: true,
                    need_court_verification: true, need_oracle_verification: true,
                    maximum_allowed_divergences: 0, need_evidence_chain_sealed: true,
                    description: FixedString[256]::from_literal("Promote from ResidualStable to Sealed after evidence chain sealed"),
                });
            }
        }
        TrustState::Sealed => {
            if to == TrustState::Promoted {
                return Ok(PromotionRequirements {
                    from_state: from, to_state: to,
                    minimum_observations: 50, minimum_replays: 25,
                    minimum_oracle_comparisons: 25, need_residual_stability_check: true,
                    need_court_verification: true, need_oracle_verification: true,
                    maximum_allowed_divergences: 0, need_evidence_chain_sealed: true,
                    description: FixedString[256]::from_literal("Promote from Sealed to Promoted after full verification"),
                });
            }
        }
        TrustState::Promoted => {
            return Err(TrustLadderError::PromotionAlreadyApplied);
        }
    }

    return Err(TrustLadderError::InvalidPromotionPath);
}

// ============================================================================
// Promote Object
// ============================================================================

fn promote_object(record: &mut TrustRecord, target_state: TrustState, requirements_met: bool, verdict_hash: Option[Hash256]) -> Result[TrustState, TrustLadderError]
    effects: [compute, residual]
{
    if record.is_locked {
        return Err(TrustLadderError::TrustStateLocked);
    }

    if !requirements_met {
        return Err(TrustLadderError::RequirementsNotMet);
    }

    let current_val: u64 = record.current_state as u64;
    let target_val: u64 = target_state as u64;

    if target_val <= current_val {
        return Err(TrustLadderError::PromotionAlreadyApplied);
    }

    if target_val > current_val + 2 {
        return Err(TrustLadderError::InvalidPromotionPath);
    }

    // Record history
    if record.state_count < 16 {
        record.previous_states[record.state_count] = record.current_state;
        record.state_count = record.state_count + 1;
    }

    if record.promotion_count < 16 {
        record.promoted_at[record.promotion_count] = kernel.tick_count();
        record.promotion_count = record.promotion_count + 1;
    }

    match verdict_hash {
        Option::Some(hash) => {
            record.last_verdict = Option::Some(hash);
        }
        Option::None => {}
    }

    let old_state: TrustState = record.current_state;
    record.current_state = target_state;
    record.last_verified_at = kernel.tick_count();

    @emit_residual("trust_ladder.promote", "object_promoted", target_val);

    return Ok(target_state);
}

// ============================================================================
// Demote Object
// ============================================================================
// Demotes an object to a lower trust state when evidence contradicts
// prior understanding.

fn demote_object(record: &mut TrustRecord, target_state: TrustState, reason: &FixedString[512]) -> Result[TrustState, TrustLadderError]
    effects: [compute, residual]
{
    if record.is_locked {
        return Err(TrustLadderError::TrustStateLocked);
    }

    let current_val: u64 = record.current_state as u64;
    let target_val: u64 = target_state as u64;

    if target_val >= current_val {
        return Err(TrustLadderError::InvalidDemotionPath);
    }

    // Can only demote by one level at a time
    if current_val - target_val > 1 {
        return Err(TrustLadderError::InvalidDemotionPath);
    }

    // Record demotion
    if record.demotion_count < 8 {
        record.demoted_at[record.demotion_count] = kernel.tick_count();
        record.demotion_count = record.demotion_count + 1;
    }

    let old_state: TrustState = record.current_state;
    record.current_state = target_state;

    @emit_residual("trust_ladder.demote", "object_demoted", target_val);

    return Ok(target_state);
}

// ============================================================================
// Check Residual Stability
// ============================================================================
// Checks whether an object's residual pattern is consistent across
// multiple executions.

fn check_residual_stability(record: &TrustRecord, current_residual_hash: Hash256) -> bool
    effects: [compute]
{
    if record.residual_stability_hash == current_residual_hash {
        return true;
    }

    // If the previous hash is zero, this is the first measurement
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    if record.residual_stability_hash == zero_hash {
        return true;  // First measurement: stable by default
    }

    return false;  // Residual hash changed — not stable
}

// ============================================================================
// Update Residual Stability Hash
// ============================================================================

fn update_residual_stability(record: &mut TrustRecord, residual_hash: Hash256)
    effects: [compute]
{
    record.residual_stability_hash = residual_hash;
}

// ============================================================================
// Set Evidence Chain Hash
// ============================================================================

fn set_evidence_chain_hash(record: &mut TrustRecord, chain_hash: Hash256)
    effects: [compute]
{
    record.evidence_chain_hash = chain_hash;
}

// ============================================================================
// Recor Observations
// ============================================================================

fn record_observation(record: &mut TrustRecord, count: u64)
    effects: [compute]
{
    record.total_observations = record.total_observations + count;
}

fn record_replay(record: &mut TrustRecord, count: u64)
    effects: [compute]
{
    record.total_replays = record.total_replays + count;
}

fn record_oracle_comparison(record: &mut TrustRecord, count: u64)
    effects: [compute]
{
    record.total_oracle_comparisons = record.total_oracle_comparisons + count;
}

fn record_divergence(record: &mut TrustRecord, count: u64)
    effects: [compute]
{
    record.total_divergences = record.total_divergences + count;
}

// ============================================================================
// Get Trust State Info
// ============================================================================

fn get_trust_state_info(state: TrustState) -> TrustStateInfo
    effects: [compute]
{
    match state {
        TrustState::Unknown => {
            return TrustStateInfo {
                state: state, state_name: FixedString[32]::from_literal("unknown"),
                level: 0, description: FixedString[256]::from_literal("Object has not been observed"),
                can_execute: false, can_load: false, can_access_capabilities: false,
                can_promote: true, can_demote: false,
            };
        }
        TrustState::Observed => {
            return TrustStateInfo {
                state: state, state_name: FixedString[32]::from_literal("observed"),
                level: 1, description: FixedString[256]::from_literal("Object has been observed in cage execution"),
                can_execute: true, can_load: true, can_access_capabilities: false,
                can_promote: true, can_demote: true,
            };
        }
        TrustState::Replayed => {
            return TrustStateInfo {
                state: state, state_name: FixedString[32]::from_literal("replayed"),
                level: 2, description: FixedString[256]::from_literal("Object execution has been replayed successfully"),
                can_execute: true, can_load: true, can_access_capabilities: false,
                can_promote: true, can_demote: true,
            };
        }
        TrustState::OracleCompared => {
            return TrustStateInfo {
                state: state, state_name: FixedString[32]::from_literal("oracle_compared"),
                level: 3, description: FixedString[256]::from_literal("Object compared against oracle"),
                can_execute: true, can_load: true, can_access_capabilities: true,
                can_promote: true, can_demote: true,
            };
        }
        TrustState::ResidualStable => {
            return TrustStateInfo {
                state: state, state_name: FixedString[32]::from_literal("residual_stable"),
                level: 4, description: FixedString[256]::from_literal("Object has consistent residual pattern"),
                can_execute: true, can_load: true, can_access_capabilities: true,
                can_promote: true, can_demote: true,
            };
        }
        TrustState::Sealed => {
            return TrustStateInfo {
                state: state, state_name: FixedString[32]::from_literal("sealed"),
                level: 5, description: FixedString[256]::from_literal("Object sealed with evidence chain"),
                can_execute: true, can_load: true, can_access_capabilities: true,
                can_promote: true, can_demote: false,
            };
        }
        TrustState::Promoted => {
            return TrustStateInfo {
                state: state, state_name: FixedString[32]::from_literal("promoted"),
                level: 6, description: FixedString[256]::from_literal("Object fully trusted"),
                can_execute: true, can_load: true, can_access_capabilities: true,
                can_promote: false, can_demote: false,
            };
        }
    }
}

// ============================================================================
// Check Capability Access
// ============================================================================

fn can_access_capabilities(state: TrustState) -> bool
    effects: [compute]
{
    return state as u64 >= TrustState::OracleCompared as u64;
}

// ============================================================================
// Check Execution Allowed
// ============================================================================

fn is_execution_allowed(state: TrustState) -> bool
    effects: [compute]
{
    return state as u64 >= TrustState::Observed as u64;
}

// ============================================================================
// Check Load Allowed
// ============================================================================

fn is_load_allowed(state: TrustState) -> bool
    effects: [compute]
{
    return state as u64 >= TrustState::Observed as u64;
}

// ============================================================================
// Get Record by Object Key
// ============================================================================

fn get_record(manager: &TrustLadderManager, object_key: Hash256) -> Result<&TrustRecord, TrustLadderError>
    effects: [compute]
{
    for i in 0..manager.record_count {
        if manager.records[i].object_key == object_key {
            return Ok(manager.records[i]);
        }
    }
    return Err(TrustLadderError::PromotionDenied);
}

fn get_record_mut(manager: &mut TrustLadderManager, object_key: Hash256) -> Result<&mut TrustRecord, TrustLadderError>
    effects: [compute]
{
    for i in 0..manager.record_count {
        if manager.records[i].object_key == object_key {
            return Ok(manager.records[i]);
        }
    }
    return Err(TrustLadderError::PromotionDenied);
}

// ============================================================================
// Lock Object Trust State
// ============================================================================
// Prevents further promotion or demotion.

fn lock_trust_state(record: &mut TrustRecord) -> Result<(), TrustLadderError>
    effects: [compute, residual]
{
    record.is_locked = true;

    @emit_residual("trust_ladder.lock", "trust_state_locked", record.current_state as u64);

    return Ok(());
}

// ============================================================================
// Unlock Object Trust State
// ============================================================================

fn unlock_trust_state(record: &mut TrustRecord) -> Result<(), TrustLadderError>
    effects: [compute, residual]
{
    record.is_locked = false;

    @emit_residual("trust_ladder.unlock", "trust_state_unlocked", record.current_state as u64);

    return Ok(());
}

// ============================================================================
// Get Trust Ladder Summary
// ============================================================================

type TrustLadderSummary = struct {
    total_objects: u64,
    unknown_count: u64,
    observed_count: u64,
    replayed_count: u64,
    oracle_compared_count: u64,
    residual_stable_count: u64,
    sealed_count: u64,
    promoted_count: u64,
    locked_count: u64,
    total_promotions: u64,
    total_demotions: u64,
}

fn get_ladder_summary(manager: &TrustLadderManager) -> TrustLadderSummary
    effects: [compute]
{
    let mut unknown: u64 = 0;
    let mut observed: u64 = 0;
    let mut replayed: u64 = 0;
    let mut oracle_compared: u64 = 0;
    let mut residual_stable: u64 = 0;
    let mut sealed: u64 = 0;
    let mut promoted: u64 = 0;
    let mut locked: u64 = 0;
    let mut total_prom: u64 = 0;
    let mut total_dem: u64 = 0;

    for i in 0..manager.record_count {
        match manager.records[i].current_state {
            TrustState::Unknown => unknown = unknown + 1,
            TrustState::Observed => observed = observed + 1,
            TrustState::Replayed => replayed = replayed + 1,
            TrustState::OracleCompared => oracle_compared = oracle_compared + 1,
            TrustState::ResidualStable => residual_stable = residual_stable + 1,
            TrustState::Sealed => sealed = sealed + 1,
            TrustState::Promoted => promoted = promoted + 1,
        }
        if manager.records[i].is_locked {
            locked = locked + 1;
        }
        total_prom = total_prom + manager.records[i].promotion_count;
        total_dem = total_dem + manager.records[i].demotion_count;
    }

    return TrustLadderSummary {
        total_objects: manager.record_count,
        unknown_count: unknown,
        observed_count: observed,
        replayed_count: replayed,
        oracle_compared_count: oracle_compared,
        residual_stable_count: residual_stable,
        sealed_count: sealed,
        promoted_count: promoted,
        locked_count: locked,
        total_promotions: total_prom,
        total_demotions: total_dem,
    };
}

// ============================================================================
// Get Record Summary
// ============================================================================

type RecordSummary = struct {
    object_key: Hash256,
    current_state: TrustState,
    state_level: u64,
    state_name: FixedString[32],
    state_count: u64,
    promotion_count: u64,
    demotion_count: u64,
    total_observations: u64,
    total_replays: u64,
    total_oracle_comparisons: u64,
    total_divergences: u64,
    is_locked: bool,
}

fn get_record_summary(record: &TrustRecord) -> RecordSummary
    effects: [compute]
{
    let info: TrustStateInfo = get_trust_state_info(record.current_state);

    return RecordSummary {
        object_key: record.object_key,
        current_state: record.current_state,
        state_level: info.level,
        state_name: info.state_name,
        state_count: record.state_count,
        promotion_count: record.promotion_count,
        demotion_count: record.demotion_count,
        total_observations: record.total_observations,
        total_replays: record.total_replays,
        total_oracle_comparisons: record.total_oracle_comparisons,
        total_divergences: record.total_divergences,
        is_locked: record.is_locked,
    };
}

// ============================================================================
// Bulk Promote Multiple Objects
// ============================================================================
// Promotes multiple objects that share the same evidence chain.

fn bulk_promote_objects(manager: &mut TrustLadderManager, object_keys: &Array[Hash256, 64], object_count: u64, target_state: TrustState, requirements_met: bool, verdict_hash: Option[Hash256]) -> Result<u64, TrustLadderError>
    effects: [compute, residual]
{
    let mut promoted_count: u64 = 0;

    for i in 0..object_count {
        let key: Hash256 = object_keys[i];
        let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
        if key == zero_hash {
            break;
        }

        let record_result: Result<&mut TrustRecord, TrustLadderError> = get_record_mut(manager, key);
        match record_result {
            Ok(record) => {
                match promote_object(record, target_state, requirements_met, verdict_hash) {
                    Ok(_) => {
                        promoted_count = promoted_count + 1;
                    }
                    Err(_) => {
                        // Skip objects that can't be promoted
                    }
                }
            }
            Err(_) => {
                // Register then promote
                let idx: u64 = register_object(manager, key)?;
                let _ = promote_object(&mut manager.records[idx], target_state, requirements_met, verdict_hash);
                promoted_count = promoted_count + 1;
            }
        }
    }

    @emit_residual("trust_ladder.bulk_promote", "bulk_promotion_complete", promoted_count);

    return Ok(promoted_count);
}

// ============================================================================
// Audit Trail Query
// ============================================================================
// Returns the full state history for an object.

type AuditTrail = struct {
    object_key: Hash256,
    state_transitions: Array[(TrustState, u64), 16],  // (state, timestamp)
    transition_count: u64,
    promotion_timestamps: Array[u64, 16],
    promotion_count: u64,
    demotion_timestamps: Array[u64, 8],
    demotion_count: u64,
    is_locked: bool,
    final_state: TrustState,
}

fn get_audit_trail(record: &TrustRecord) -> AuditTrail
    effects: [compute]
{
    let mut transitions: Array[(TrustState, u64), 16] = Array[(TrustState, u64), 16]::zeroed();
    let count: u64 = if record.state_count < 16 { record.state_count } else { 16 };

    for i in 0..count {
        let ts: u64 = if i < record.promotion_count { record.promoted_at[i] } else { 0 };
        transitions[i] = (record.previous_states[i], ts);
    }

    return AuditTrail {
        object_key: record.object_key,
        state_transitions: transitions,
        transition_count: count,
        promotion_timestamps: record.promoted_at,
        promotion_count: record.promotion_count,
        demotion_timestamps: record.demoted_at,
        demotion_count: record.demotion_count,
        is_locked: record.is_locked,
        final_state: record.current_state,
    };
}

// ============================================================================
// Apply Trust Policy Check
// ============================================================================
// Checks whether a promotion would be allowed under the current policy.

fn check_policy_for_promotion(record: &TrustRecord, policy: &TrustPolicy, target: TrustState) -> Result<bool, TrustLadderError>
    effects: [compute]
{
    if target == TrustState::Sealed || target == TrustState::Promoted {
        if policy.require_human_review_for_sealed {
            // Human review required — policy allows but flags it
        }
        if !policy.allow_promotion_without_court {
            // Need to verify court verification happened
            if record.last_verdict == Option::None {
                return Err(TrustLadderError::RequirementsNotMet);
            }
        }
    }

    if target >= TrustState::Replayed {
        if record.total_replays < policy.minimum_replays_for_promotion {
            return Err(TrustLadderError::RequirementsNotMet);
        }
    }

    if record.total_divergences > 0 && policy.auto_demote_on_divergence {
        // Auto-demotion policy would apply after promotion check
    }

    return Ok(true);
}
