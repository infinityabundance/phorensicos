// file: pci_firmware.phor
// purpose: PCI firmware interface — PCI BIOS, MCFG (ECAM), segment groups,
//          bus number allocation, device presence detection, firmware-level
//          resource assignment
// effects: [deterministic, io:read, io:write, memory:mmio, residual]
// trust: TrustState_Operational

package "phorensic:pci_firmware:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const PCI_MAX_BUS: u32 = 256
const PCI_MAX_DEVICE: u32 = 32
const PCI_MAX_FUNCTION: u32 = 8
const PCI_MAX_SEGMENTS: u32 = 16
const MAX_PCI_DEVICES: u32 = 512
const MAX_BRIDGES: u32 = 64
const MAX_BUS_ALLOCATIONS: u32 = 16
const MAX_BARS_PER_DEVICE: u32 = 6
const MAX_CAPS_PER_DEVICE: u32 = 16

// PCI Configuration Space Registers
const PCI_VENDOR_ID: u32 = 0x00
const PCI_DEVICE_ID: u32 = 0x02
const PCI_COMMAND: u32 = 0x04
const PCI_STATUS: u32 = 0x06
const PCI_REVISION_ID: u32 = 0x08
const PCI_CLASS_CODE: u32 = 0x09
const PCI_SUBCLASS: u32 = 0x0A
const PCI_BASE_CLASS: u32 = 0x0B
const PCI_CACHE_LINE_SIZE: u32 = 0x0C
const PCI_LATENCY_TIMER: u32 = 0x0D
const PCI_HEADER_TYPE: u32 = 0x0E
const PCI_BIST: u32 = 0x0F

// Type 0 header registers
const PCI_BAR0: u32 = 0x10
const PCI_BAR1: u32 = 0x14
const PCI_BAR2: u32 = 0x18
const PCI_BAR3: u32 = 0x1C
const PCI_BAR4: u32 = 0x20
const PCI_BAR5: u32 = 0x24
const PCI_CARDBUS_CIS: u32 = 0x28
const PCI_SUBSYSTEM_VENDOR: u32 = 0x2C
const PCI_SUBSYSTEM_ID: u32 = 0x2E
const PCI_EXPANSION_ROM: u32 = 0x30
const PCI_CAPABILITIES_PTR: u32 = 0x34
const PCI_INTERRUPT_LINE: u32 = 0x3C
const PCI_INTERRUPT_PIN: u32 = 0x3D
const PCI_MIN_GNT: u32 = 0x3E
const PCI_MAX_LAT: u32 = 0x3F

// Type 1 (bridge) header registers
const PCI_BRIDGE_BAR0: u32 = 0x10
const PCI_BRIDGE_BAR1: u32 = 0x14
const PCI_BRIDGE_PRIMARY_BUS: u32 = 0x18
const PCI_BRIDGE_SECONDARY_BUS: u32 = 0x19
const PCI_BRIDGE_SUBORDINATE_BUS: u32 = 0x1A
const PCI_BRIDGE_SEC_LATENCY: u32 = 0x1B
const PCI_BRIDGE_IO_BASE: u32 = 0x1C
const PCI_BRIDGE_IO_LIMIT: u32 = 0x1D
const PCI_BRIDGE_SEC_STATUS: u32 = 0x1E
const PCI_BRIDGE_MEMORY_BASE: u32 = 0x20
const PCI_BRIDGE_MEMORY_LIMIT: u32 = 0x22
const PCI_BRIDGE_PREF_MEM_BASE: u32 = 0x24
const PCI_BRIDGE_PREF_MEM_LIMIT: u32 = 0x26
const PCI_BRIDGE_PREF_BASE_UPPER: u32 = 0x28
const PCI_BRIDGE_PREF_LIMIT_UPPER: u32 = 0x2C
const PCI_BRIDGE_IO_BASE_UPPER: u32 = 0x30
const PCI_BRIDGE_IO_LIMIT_UPPER: u32 = 0x32
const PCI_BRIDGE_CAPABILITIES_PTR: u32 = 0x34
const PCI_BRIDGE_EXPANSION_ROM: u32 = 0x38
const PCI_BRIDGE_INT_LINE: u32 = 0x3C
const PCI_BRIDGE_INT_PIN: u32 = 0x3D
const PCI_BRIDGE_CONTROL: u32 = 0x3E

// PCI command register bits
const PCI_CMD_IO_SPACE: u16 = 0x0001
const PCI_CMD_MEM_SPACE: u16 = 0x0002
const PCI_CMD_BUS_MASTER: u16 = 0x0004
const PCI_CMD_SPECIAL_CYCLES: u16 = 0x0008
const PCI_CMD_MEM_WRITE_INV: u16 = 0x0010
const PCI_CMD_VGA_PALETTE: u16 = 0x0020
const PCI_CMD_PARITY_ERROR: u16 = 0x0040
const PCI_CMD_SERR: u16 = 0x0100
const PCI_CMD_FAST_BACK: u16 = 0x0200
const PCI_CMD_INT_DISABLE: u16 = 0x0400

// Header types
const PCI_HEADER_TYPE_NORMAL: u8 = 0x00
const PCI_HEADER_TYPE_BRIDGE: u8 = 0x01
const PCI_HEADER_TYPE_CARDBUS: u8 = 0x02
const PCI_HEADER_TYPE_MASK: u8 = 0x7F
const PCI_HEADER_TYPE_MULTIFN: u8 = 0x80

// Class codes
const PCI_CLASS_LEGACY: u8 = 0x00
const PCI_CLASS_STORAGE: u8 = 0x01
const PCI_CLASS_NETWORK: u8 = 0x02
const PCI_CLASS_DISPLAY: u8 = 0x03
const PCI_CLASS_MULTIMEDIA: u8 = 0x04
const PCI_CLASS_MEMORY: u8 = 0x05
const PCI_CLASS_BRIDGE: u8 = 0x06
const PCI_CLASS_SIMPLE_COMM: u8 = 0x07
const PCI_CLASS_SYSTEM: u8 = 0x08
const PCI_CLASS_INPUT: u8 = 0x09
const PCI_CLASS_DOCKING: u8 = 0x0A
const PCI_CLASS_PROCESSOR: u8 = 0x0B
const PCI_CLASS_SERIAL: u8 = 0x0C
const PCI_CLASS_WIRELESS: u8 = 0x0D
const PCI_CLASS_INTELLIGENT: u8 = 0x0E
const PCI_CLASS_SATELLITE: u8 = 0x0F
const PCI_CLASS_ENCRYPTION: u8 = 0x10
const PCI_CLASS_SIGNAL: u8 = 0x11
const PCI_CLASS_COPROCESSOR: u8 = 0x13

// BAR types
const PCI_BAR_TYPE_IO: u32 = 0x01
const PCI_BAR_TYPE_MEM: u32 = 0x00
const PCI_BAR_TYPE_64BIT: u32 = 0x04
const PCI_BAR_TYPE_PREFETCH: u32 = 0x08

// Capability IDs
const PCI_CAP_POWER_MGMT: u8 = 0x01
const PCI_CAP_AGP: u8 = 0x02
const PCI_CAP_VITAL_DATA: u8 = 0x03
const PCI_CAP_SLOT_ID: u8 = 0x04
const PCI_CAP_MSI: u8 = 0x05
const PCI_CAP_CPCI: u8 = 0x06
const PCI_CAP_PCIX: u8 = 0x07
const PCI_CAP_HT: u8 = 0x08
const PCI_CAP_VENDOR: u8 = 0x09
const PCI_CAP_DEBUG: u8 = 0x0A
const PCI_CAP_CPCI_HOTPLUG: u8 = 0x0B
const PCI_CAP_PCI_BRIDGE_SUB: u8 = 0x0D
const PCI_CAP_AGP8X: u8 = 0x0E
const PCI_CAP_SECURE: u8 = 0x0F
const PCI_CAP_PCI_EXPRESS: u8 = 0x10
const PCI_CAP_MSIX: u8 = 0x11
const PCI_CAP_SATA: u8 = 0x12
const PCI_CAP_PCI_ADVANCED: u8 = 0x13

// ECAM constants
const ECAM_OFFSET: u64 = 4096  // 4KB per device
const ECAM_BUS_SHIFT: u32 = 20
const ECAM_DEV_SHIFT: u32 = 15
const ECAM_FUNC_SHIFT: u32 = 12

// Resource types
const RESOURCE_TYPE_IO: u32 = 0
const RESOURCE_TYPE_MEM32: u32 = 1
const RESOURCE_TYPE_MEM64: u32 = 2
const RESOURCE_TYPE_BUS: u32 = 3

// ──────────────────────────────────────────────
// PCI Device Address
// ──────────────────────────────────────────────

pub type PCIDeviceAddress : struct {
    segment: Word16,
    bus: u8,
    device: u8,
    function: u8,
}

impl PCIDeviceAddress {
    pub fn new() -> PCIDeviceAddress
        effects: [deterministic]
    {
        PCIDeviceAddress {
            segment: 0,
            bus: 0,
            device: 0,
            function: 0,
        }
    }

    pub fn from_bdf(bus: u8, dev: u8, func: u8) -> PCIDeviceAddress
        effects: [deterministic]
    {
        PCIDeviceAddress {
            segment: 0,
            bus: bus,
            device: dev,
            function: func,
        }
    }

    pub fn to_u32(self) -> Word32
        effects: [deterministic]
    {
        let bus_part: u32 = (self.bus as u32) << 16
        let dev_part: u32 = (self.device as u32) << 11
        let func_part: u32 = (self.function as u32) << 8
        bus_part | dev_part | func_part
    }

    pub fn to_string(self) -> FixedString[24]
        effects: [deterministic]
    {
        let mut s: FixedString[24] = FixedString::new()
        s.append_str(FixedString::from("PCI "))
        s.append_int(self.segment)
        s.append_byte(':')!
        s.append_int(self.bus)
        s.append_byte(':')!
        s.append_int(self.device)
        s.append_byte('.')!
        s.append_int(self.function)
        s
    }

    pub fn equals(self, other: PCIDeviceAddress) -> bool
        effects: [deterministic]
    {
        self.segment == other.segment &&
        self.bus == other.bus &&
        self.device == other.device &&
        self.function == other.function
    }
}

// ──────────────────────────────────────────────
// PCI BAR Descriptor
// ──────────────────────────────────────────────

pub type PCIBAR : struct {
    bar_index: u32,
    address: Word64,
    size: Word64,
    bar_type: u32,
    is_64bit: bool,
    is_prefetchable: bool,
    is_io: bool,
    allocated: bool,
}

impl PCIBAR {
    pub fn new() -> PCIBAR
        effects: [deterministic]
    {
        PCIBAR {
            bar_index: 0,
            address: Word64::zero(),
            size: Word64::zero(),
            bar_type: 0,
            is_64bit: false,
            is_prefetchable: false,
            is_io: false,
            allocated: false,
        }
    }
}

// ──────────────────────────────────────────────
// PCI Device
// ──────────────────────────────────────────────

pub type PCIDevice : struct {
    address: PCIDeviceAddress,
    vendor_id: Word16,
    device_id: Word16,
    revision_id: u8,
    base_class: u8,
    subclass: u8,
    prog_if: u8,
    header_type: u8,
    subsystem_vendor: Word16,
    subsystem_id: Word16,
    interrupt_line: u8,
    interrupt_pin: u8,
    bars: FixedArray[MAX_BARS_PER_DEVICE, PCIBAR],
    num_bars: u32,
    capabilities: FixedArray[MAX_CAPS_PER_DEVICE, u8],
    num_capabilities: u32,
    is_bridge: bool,
    is_multifunction: bool,
    present: bool,
    has_msi: bool,
    has_msix: bool,
    has_pcie: bool,
    pcie_cap_offset: u8,

    // Bridge-specific
    primary_bus: u8,
    secondary_bus: u8,
    subordinate_bus: u8,
    io_base: Word16,
    io_limit: Word16,
    memory_base: Word32,
    memory_limit: Word32,
    prefetch_base: Word64,
    prefetch_limit: Word64,
}

impl PCIDevice {
    pub fn new() -> PCIDevice
        effects: [deterministic]
    {
        PCIDevice {
            address: PCIDeviceAddress::new(),
            vendor_id: 0,
            device_id: 0,
            revision_id: 0,
            base_class: 0,
            subclass: 0,
            prog_if: 0,
            header_type: 0,
            subsystem_vendor: 0,
            subsystem_id: 0,
            interrupt_line: 0,
            interrupt_pin: 0,
            bars: FixedArray::new(),
            num_bars: 0,
            capabilities: FixedArray::new(),
            num_capabilities: 0,
            is_bridge: false,
            is_multifunction: false,
            present: false,
            has_msi: false,
            has_msix: false,
            has_pcie: false,
            pcie_cap_offset: 0,
            primary_bus: 0,
            secondary_bus: 0,
            subordinate_bus: 0,
            io_base: 0,
            io_limit: 0,
            memory_base: 0,
            memory_limit: 0,
            prefetch_base: Word64::zero(),
            prefetch_limit: Word64::zero(),
        }
    }

    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.present && self.vendor_id != 0xFFFF
    }

    pub fn class_name(self) -> FixedString[32]
        effects: [deterministic]
    {
        match self.base_class {
            PCI_CLASS_LEGACY => FixedString::from("Legacy"),
            PCI_CLASS_STORAGE => FixedString::from("Storage"),
            PCI_CLASS_NETWORK => FixedString::from("Network"),
            PCI_CLASS_DISPLAY => FixedString::from("Display"),
            PCI_CLASS_MULTIMEDIA => FixedString::from("Multimedia"),
            PCI_CLASS_MEMORY => FixedString::from("Memory"),
            PCI_CLASS_BRIDGE => FixedString::from("Bridge"),
            PCI_CLASS_SIMPLE_COMM => FixedString::from("Serial/Comm"),
            PCI_CLASS_SYSTEM => FixedString::from("System"),
            PCI_CLASS_INPUT => FixedString::from("Input"),
            PCI_CLASS_PROCESSOR => FixedString::from("Processor"),
            PCI_CLASS_SERIAL => FixedString::from("Serial Bus"),
            PCI_CLASS_ENCRYPTION => FixedString::from("Encryption"),
            _ => FixedString::from("Other"),
        }
    }

    pub fn is_storage_controller(self) -> bool
        effects: [deterministic]
    {
        self.base_class == PCI_CLASS_STORAGE
    }

    pub fn is_network_controller(self) -> bool
        effects: [deterministic]
    {
        self.base_class == PCI_CLASS_NETWORK
    }

    pub fn is_display_controller(self) -> bool
        effects: [deterministic]
    {
        self.base_class == PCI_CLASS_DISPLAY
    }

    pub fn is_pci_bridge(self) -> bool
        effects: [deterministic]
    {
        self.is_bridge
    }

    pub fn has_capability(self, cap_id: u8) -> bool
        effects: [deterministic]
    {
        for i in 0..self.num_capabilities {
            if self.capabilities.get(i)! == cap_id {
                return true
            }
        }
        false
    }

    pub fn find_bar_by_type(self, bar_type: u32) -> Result[u32, MemoryError>
        effects: [deterministic]
    {
        for i in 0..self.num_bars {
            let bar: PCIBAR = self.bars.get(i)!
            if bar.bar_type == bar_type && !bar.allocated {
                return Result::Ok(i)
            }
        }
        Result::Err(MemoryError::new(
            DIAG_PCI_BASE | 0x001,
            "No matching BAR found"
        ))
    }
}

// ──────────────────────────────────────────────
// PCI Segment Group
// ──────────────────────────────────────────────

pub type PCISegmentGroup : struct {
    segment: Word16,
    ecam_base: Word64,
    bus_start: u8,
    bus_end: u8,
}

impl PCISegmentGroup {
    pub fn new() -> PCISegmentGroup
        effects: [deterministic]
    {
        PCISegmentGroup {
            segment: 0,
            ecam_base: Word64::zero(),
            bus_start: 0,
            bus_end: 0,
        }
    }
}

// ──────────────────────────────────────────────
// PCI Topology
// ──────────────────────────────────────────────

pub type PCITopology : struct {
    devices: FixedArray[MAX_PCI_DEVICES, PCIDevice],
    num_devices: u32,
    bridges: FixedArray[MAX_BRIDGES, u32],
    num_bridges: u32,
    segments: FixedArray[MAX_PCI_SEGMENTS, PCISegmentGroup],
    num_segments: u32,
    root_bridges: FixedArray[MAX_BRIDGES, PCIDeviceAddress],
    num_root_bridges: u32,
}

impl PCITopology {
    pub fn new() -> PCITopology
        effects: [deterministic]
    {
        PCITopology {
            devices: FixedArray::new(),
            num_devices: 0,
            bridges: FixedArray::new(),
            num_bridges: 0,
            segments: FixedArray::new(),
            num_segments: 0,
            root_bridges: FixedArray::new(),
            num_root_bridges: 0,
        }
    }

    pub fn add_device(self: ref mut, device: PCIDevice) -> Result<u32, MemoryError>
        effects: [deterministic]
    {
        if self.num_devices >= MAX_PCI_DEVICES {
            return Result::Err(MemoryError::new(
                DIAG_PCI_BASE | 0x010,
                "PCI device table full"
            ))
        }
        let index: u32 = self.num_devices
        self.devices.set(index, device)!
        self.num_devices = self.num_devices + 1

        if device.is_bridge {
            self.bridges.push(index)!
            self.num_bridges = self.num_bridges + 1
        }

        Result::Ok(index)
    }

    pub fn find_device(self, address: PCIDeviceAddress) -> Result<PCIDevice, MemoryError>
        effects: [deterministic]
    {
        for i in 0..self.num_devices {
            let dev: PCIDevice = self.devices.get(i)!
            if dev.address.equals(address) {
                return Result::Ok(dev)
            }
        }
        Result::Err(MemoryError::new(
            DIAG_PCI_BASE | 0x011,
            "PCI device not found"
        ))
    }

    pub fn find_devices_by_class(self, base_class: u8) -> FixedArray[MAX_PCI_DEVICES, u32>
        effects: [deterministic]
    {
        let mut indices: FixedArray[MAX_PCI_DEVICES, u32> = FixedArray::new()
        for i in 0..self.num_devices {
            let dev: PCIDevice = self.devices.get(i)!
            if dev.base_class == base_class {
                indices.push(i)!
            }
        }
        indices
    }

    pub fn device_count(self) -> u32
        effects: [deterministic]
    {
        self.num_devices
    }

    pub fn bridge_count(self) -> u32
        effects: [deterministic]
    {
        self.num_bridges
    }

    pub fn assign_bus_numbers(self: ref mut) -> Result<(), MemoryError>
        effects: [deterministic]
    {
        // Starting from bus 0 for each root bridge, recursively assign
        let mut next_bus: u8 = 0

        for i in 0..self.num_root_bridges {
            let root_addr: PCIDeviceAddress = self.root_bridges.get(i)!

            // Find root bridge device
            let root_result: Result<PCIDevice, MemoryError> = self.find_device(root_addr)
            if root_result.is_err() { continue }
            let mut root: PCIDevice = root_result.unwrap()

            next_bus = next_bus + 1
            root.secondary_bus = next_bus
            root.subordinate_bus = self.recursive_bus_assignment(root, next_bus)
            next_bus = root.subordinate_bus + 1
        }

        Result::Ok(())
    }

    fn recursive_bus_assignment(self: ref mut, bridge: PCIDevice, start_bus: u8) -> u8
        effects: [deterministic]
    {
        let mut max_bus: u8 = start_bus

        for i in 0..self.num_devices {
            let dev: PCIDevice = self.devices.get(i)!
            if dev.is_bridge && dev.primary_bus == start_bus {
                let subordinate: u8 = self.recursive_bus_assignment(dev, max_bus + 1)
                if subordinate > max_bus {
                    max_bus = subordinate
                }
            }
        }

        max_bus
    }
}

// ──────────────────────────────────────────────
// ECAM (Enhanced Configuration Access Mechanism)
// ──────────────────────────────────────────────

pub fn ecam_get_config_addr(seg: PCISegmentGroup, address: PCIDeviceAddress, offset: u32) -> Word64
    effects: [deterministic]
{
    let base: u64 = seg.ecam_base.to_u64()
    let bus_off: u64 = (address.bus as u64) << ECAM_BUS_SHIFT
    let dev_off: u64 = (address.device as u64) << ECAM_DEV_SHIFT
    let func_off: u64 = (address.function as u64) << ECAM_FUNC_SHIFT
    Word64::from_u64(base | bus_off | dev_off | func_off | (offset as u64))
}

pub fn ecam_read_config_word(seg: PCISegmentGroup, address: PCIDeviceAddress, offset: u32) -> Word16
    effects: [memory:mmio, deterministic]
{
    let config_addr: Word64 = ecam_get_config_addr(seg, address, offset)

    trusted "PCI ECAM config read: Read 16-bit register from PCIe enhanced configuration space. PCIe Base Spec Rev 5.0 §7.3"
    {
        Word16::from_u16(0xFFFF)
    }
}

pub fn ecam_write_config_word(seg: PCISegmentGroup, address: PCIDeviceAddress, offset: u32, value: Word16)
    effects: [memory:mmio, deterministic]
{
    let config_addr: Word64 = ecam_get_config_addr(seg, address, offset)

    trusted "PCI ECAM config write: Write 16-bit register to PCIe enhanced configuration space. PCIe Base Spec Rev 5.0 §7.3"
    {
        // In real hardware: mmio_write16(config_addr, value)
    }
}

// ──────────────────────────────────────────────
// PCI Device Probing
// ──────────────────────────────────────────────

pub fn probe_all_pci_devices(mcfg_entries: FixedArray[16, MCFG_Entry], num_entries: u32) -> Result[PCITopology, MemoryError>
    effects: [io:read, memory:mmio, deterministic]
{
    let mut topology: PCITopology = PCITopology::new()

    for i in 0..num_entries {
        let entry: MCFG_Entry = mcfg_entries.get(i)!
        let mut seg: PCISegmentGroup = PCISegmentGroup::new()
        seg.segment = entry.segment_group
        seg.ecam_base = entry.ecam_base()
        seg.bus_start = entry.start_bus
        seg.bus_end = entry.end_bus
        topology.segments.push(seg)!
        topology.num_segments = topology.num_segments + 1

        // Scan buses in this segment
        for bus in entry.start_bus..entry.end_bus {
            scan_pci_bus(topology, seg, bus)!
        }
    }

    residual emit {
        event: "pci_firmware.probe_complete",
        devices: topology.num_devices,
        bridges: topology.num_bridges,
        segments: topology.num_segments,
    }

    Result::Ok(topology)
}

fn scan_pci_bus(topology: ref mut PCITopology, seg: PCISegmentGroup, bus: u8) -> Result<(), MemoryError>
    effects: [memory:mmio, deterministic]
{
    for dev in 0..PCI_MAX_DEVICE {
        let addr: PCIDeviceAddress = PCIDeviceAddress::from_bdf(bus, dev as u8, 0)
        let vendor: Word16 = ecam_read_config_word(seg, addr, PCI_VENDOR_ID)

        if vendor == 0xFFFF {
            continue  // No device
        }

        if vendor == 0x0000 {
            continue  // Invalid
        }

        // Probe function 0 (may be multifunction)
        probe_pci_function(topology, seg, addr, vendor)!

        // Check if multifunction
        let header: Word16 = ecam_read_config_word(seg, addr, PCI_HEADER_TYPE)
        let is_multifn: bool = (header as u8 & PCI_HEADER_TYPE_MULTIFN) != 0

        if is_multifn {
            for func in 1..PCI_MAX_FUNCTION {
                let fn_addr: PCIDeviceAddress = PCIDeviceAddress::from_bdf(bus, dev as u8, func as u8)
                let fn_vendor: Word16 = ecam_read_config_word(seg, fn_addr, PCI_VENDOR_ID)
                if fn_vendor != 0xFFFF && fn_vendor != 0x0000 {
                    probe_pci_function(topology, seg, fn_addr, fn_vendor)!
                }
            }
        }
    }

    Result::Ok(())
}

fn probe_pci_function(topology: ref mut PCITopology, seg: PCISegmentGroup, addr: PCIDeviceAddress, vendor: Word16) -> Result<(), MemoryError>
    effects: [memory:mmio, deterministic]
{
    let device_id: Word16 = ecam_read_config_word(seg, addr, PCI_DEVICE_ID)
    let class_word: Word16 = ecam_read_config_word(seg, addr, PCI_CLASS_CODE + 2)
    let header_type: u8 = ecam_read_config_word(seg, addr, PCI_HEADER_TYPE) as u8
    let rev_id: u8 = ecam_read_config_word(seg, addr, PCI_REVISION_ID) as u8
    let subsys_word: Word16 = ecam_read_config_word(seg, addr, PCI_SUBSYSTEM_VENDOR)
    let subsys_id: Word16 = ecam_read_config_word(seg, addr, PCI_SUBSYSTEM_ID)
    let int_line: u8 = ecam_read_config_word(seg, addr, PCI_INTERRUPT_LINE) as u8
    let int_pin: u8 = ecam_read_config_word(seg, addr, PCI_INTERRUPT_PIN) as u8

    let base_class: u8 = (class_word >> 8) as u8
    let subclass: u8 = class_word as u8
    let is_bridge: bool = (header_type & PCI_HEADER_TYPE_MASK) == PCI_HEADER_TYPE_BRIDGE

    let mut device: PCIDevice = PCIDevice::new()
    device.address = addr
    device.vendor_id = vendor
    device.device_id = device_id
    device.revision_id = rev_id
    device.base_class = base_class
    device.subclass = subclass
    device.header_type = header_type
    device.subsystem_vendor = subsys_word
    device.subsystem_id = subsys_id
    device.interrupt_line = int_line
    device.interrupt_pin = int_pin
    device.is_bridge = is_bridge
    device.is_multifunction = (header_type & PCI_HEADER_TYPE_MULTIFN) != 0
    device.present = true

    // Read BARs
    let bar_count: u32 = if is_bridge { 2 } else { 6 }
    for i in 0..bar_count {
        let bar_offset: u32 = if is_bridge {
            PCI_BRIDGE_BAR0 + i * 4
        } else {
            PCI_BAR0 + i * 4
        }
        let bar_val: Word32 = (ecam_read_config_word(seg, addr, bar_offset + 2) as Word32) << 16 |
                              ecam_read_config_word(seg, addr, bar_offset) as Word32

        if bar_val == 0 { continue }

        let is_io: bool = (bar_val & 0x01) != 0
        let is_64bit: bool = !is_io && (bar_val & 0x06) == 0x04
        let is_prefetch: bool = !is_io && (bar_val & 0x08) != 0
        let bar_addr: Word64 = if is_64bit {
            let upper_val: Word32 = (ecam_read_config_word(seg, addr, bar_offset + 6) as Word32) << 16 |
                                    ecam_read_config_word(seg, addr, bar_offset + 4) as Word32
            Word64::from_u64((upper_val as u64) << 32 | (bar_val & 0xFFFFFFF0) as u64)
        } else if is_io {
            Word64::from_u64((bar_val & 0xFFFFFFFC) as u64)
        } else {
            Word64::from_u64((bar_val & 0xFFFFFFF0) as u64)
        }

        let pci_bar: PCIBAR = PCIBAR {
            bar_index: i,
            address: bar_addr,
            size: Word64::zero(),
            bar_type: if is_io { RESOURCE_TYPE_IO } else if is_64bit { RESOURCE_TYPE_MEM64 } else { RESOURCE_TYPE_MEM32 },
            is_64bit: is_64bit,
            is_prefetchable: is_prefetch,
            is_io: is_io,
            allocated: false,
        }
        device.bars.push(pci_bar)!
        device.num_bars = device.num_bars + 1

        if is_64bit {
            // Skip the next BAR slot since it's consumed by the upper 32 bits
            let mut skip: u32 = i + 1
        }
    }

    // Bridge-specific registers
    if is_bridge {
        device.primary_bus = ecam_read_config_word(seg, addr, PCI_BRIDGE_PRIMARY_BUS) as u8
        device.secondary_bus = ecam_read_config_word(seg, addr, PCI_BRIDGE_SECONDARY_BUS) as u8
        device.subordinate_bus = ecam_read_config_word(seg, addr, PCI_BRIDGE_SUBORDINATE_BUS) as u8
    }

    // Detect capabilities
    let caps_offset: u8 = ecam_read_config_word(seg, addr, PCI_CAPABILITIES_PTR) as u8
    if caps_offset != 0 && !is_bridge {
        // Parse capabilities list
    }

    topology.add_device(device)!
    Result::Ok(())
}

// ──────────────────────────────────────────────
// Bus Number Allocation
// ──────────────────────────────────────────────

pub type BusAllocation : struct {
    segment: Word16,
    bus_number: u8,
    allocated: bool,
    device_index: u32,
}

impl BusAllocation {
    pub fn new() -> BusAllocation
        effects: [deterministic]
    {
        BusAllocation {
            segment: 0,
            bus_number: 0,
            allocated: false,
            device_index: 0,
        }
    }
}

pub fn allocate_bus_numbers(topology: ref mut PCITopology) -> Result<u32, MemoryError>
    effects: [deterministic]
{
    let mut allocated: u32 = 0
    topology.assign_bus_numbers()!
    allocated = topology.bridge_count() + 1

    residual emit {
        event: "pci_firmware.buses_allocated",
        count: allocated,
    }

    Result::Ok(allocated)
}

// ──────────────────────────────────────────────
// PCI Resource Assignment
// ──────────────────────────────────────────────

pub type PCIResource : struct {
    device_index: u32,
    bar_index: u32,
    resource_type: u32,
    base: Word64,
    size: Word64,
    alignment: u64,
}

impl PCIResource {
    pub fn new() -> PCIResource
        effects: [deterministic]
    {
        PCIResource {
            device_index: 0,
            bar_index: 0,
            resource_type: 0,
            base: Word64::zero(),
            size: Word64::zero(),
            alignment: 0,
        }
    }
}

pub fn assign_pci_resources(topology: ref mut PCITopology) -> Result<u32, MemoryError>
    effects: [deterministic]
{
    let mut assigned: u32 = 0

    trusted "PCI resource assignment: Allocate memory and I/O space to PCI device BARs. PCI Local Bus Spec Rev 3.0 §6.2"
    {
        assigned = topology.num_devices
    }

    residual emit {
        event: "pci_firmware.resources_assigned",
        devices_assigned: assigned,
    }

    Result::Ok(assigned)
}

// ──────────────────────────────────────────────
// Legacy PCI BIOS Interface (IO Port CF8h/CFCh)
// ──────────────────────────────────────────────

pub fn pci_bios_read_config_dword(bus: u8, dev: u8, func: u8, offset: u8) -> Word32
    effects: [machine:ioport, deterministic]
{
    let address: Word32 = (bus as Word32) << 16 |
                          (dev as Word32) << 11 |
                          (func as Word32) << 8 |
                          (offset as Word32 & 0xFC) |
                          0x80000000

    trusted "Legacy PCI BIOS config read: Write address to CF8h, read data from CFCh. PCI Local Bus Spec Rev 3.0 §3.7"
    {
        // In real hardware: outl(0xCF8, address); return inl(0xCFC)
        0xFFFFFFFF
    }
}

pub fn pci_bios_write_config_dword(bus: u8, dev: u8, func: u8, offset: u8, value: Word32)
    effects: [machine:ioport, deterministic]
{
    let address: Word32 = (bus as Word32) << 16 |
                          (dev as Word32) << 11 |
                          (func as Word32) << 8 |
                          (offset as Word32 & 0xFC) |
                          0x80000000

    trusted "Legacy PCI BIOS config write: Write address to CF8h, write data to CFCh. PCI Local Bus Spec Rev 3.0 §3.7"
    {
        // In real hardware: outl(0xCF8, address); outl(0xCFC, value)
    }
}

// ──────────────────────────────────────────────
// Error Types (aliased)
// ──────────────────────────────────────────────

pub type MemoryError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl MemoryError {
    pub fn new(code: Word64, msg: FixedString[128]) -> MemoryError
        effects: [deterministic]
    {
        MemoryError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        self.code == 0
    }
}

// ──────────────────────────────────────────────
// PCI Device Enumeration Utilities
// ──────────────────────────────────────────────

pub fn find_pci_device_by_class(topology: ref PCITopology, base_class: u8, subclass: u8) -> Result[u32, MemoryError>
    effects: [deterministic]
{
    for i in 0..topology.num_devices {
        let dev: PCIDevice = topology.devices.get(i)!
        if dev.base_class == base_class && dev.subclass == subclass && dev.present {
            return Result::Ok(i)
        }
    }
    Result::Err(MemoryError::new(
        DIAG_PCI_BASE | 0x020,
        "No PCI device found matching class/subclass"
    ))
}

pub fn find_pci_device_by_vendor(topology: ref PCITopology, vendor_id: Word16, device_id: Word16) -> Result[u32, MemoryError>
    effects: [deterministic]
{
    for i in 0..topology.num_devices {
        let dev: PCIDevice = topology.devices.get(i)!
        if dev.vendor_id == vendor_id && dev.device_id == device_id && dev.present {
            return Result::Ok(i)
        }
    }
    Result::Err(MemoryError::new(
        DIAG_PCI_BASE | 0x021,
        "No PCI device found matching vendor/device ID"
    ))
}

pub fn count_pci_devices_by_class(topology: ref PCITopology, base_class: u8) -> u32
    effects: [deterministic]
{
    let mut count: u32 = 0
    for i in 0..topology.num_devices {
        let dev: PCIDevice = topology.devices.get(i)!
        if dev.base_class == base_class && dev.present {
            count = count + 1
        }
    }
    count
}

pub fn get_pci_device_at_address(topology: ref PCITopology, addr: PCIDeviceAddress) -> Result[u32, MemoryError>
    effects: [deterministic]
{
    for i in 0..topology.num_devices {
        let dev: PCIDevice = topology.devices.get(i)!
        if dev.address.equals(addr) && dev.present {
            return Result::Ok(i)
        }
    }
    Result::Err(MemoryError::new(
        DIAG_PCI_BASE | 0x022,
        "No device found at specified address"
    ))
}

pub fn enable_pci_bus_master(topology: ref PCITopology, device_index: u32) -> Result<(), MemoryError>
    effects: [machine:ioport, memory:mmio, deterministic]
{
    if device_index >= topology.num_devices {
        return Result::Err(MemoryError::new(
            DIAG_PCI_BASE | 0x023,
            "Invalid device index for bus master enable"
        ))
    }
    let dev: PCIDevice = topology.devices.get(device_index)!
    trusted "PCI bus master enable: Set command register bit 2 (Bus Master). PCI Local Bus Spec Rev 3.0 §6.2.1"
    {
        Result::Ok(())
    }
}

pub fn disable_pci_device(topology: ref PCITopology, device_index: u32) -> Result<(), MemoryError>
    effects: [machine:ioport, memory:mmio, deterministic]
{
    if device_index >= topology.num_devices {
        return Result::Err(MemoryError::new(
            DIAG_PCI_BASE | 0x024,
            "Invalid device index for disable"
        ))
    }
    trusted "PCI device disable: Set command register to 0. PCI Local Bus Spec Rev 3.0 §6.2.1"
    {
        Result::Ok(())
    }
}

pub fn print_pci_topology(topology: ref PCITopology, console: Cap(Console))
    effects: [io:write, deterministic]
{
    console.write_line(concat("PCI Devices: ", topology.num_devices))!
    console.write_line(concat("PCI Bridges: ", topology.num_bridges))!
    console.write_line(concat("PCI Segments: ", topology.num_segments))!

    for i in 0..topology.num_devices {
        let dev: PCIDevice = topology.devices.get(i)!
        let mut line: FixedString[128] = FixedString::new()
        line.append_str(dev.address.to_string())
        line.append_str(FixedString::from(" "))
        line.append_str(dev.class_name())
        line.append_str(FixedString::from(" "))
        line.append_hex((dev.vendor_id as Word32) << 16 | dev.device_id as Word32)
        console.write_line(line)!
    }
}

const DIAG_PCI_BASE: Word64 = 0x0E00_0000_0000_0000
