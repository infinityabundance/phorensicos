// jit_port_memcmp.phor — second JIT-Porting Court target (native candidate)
//
// Clean-room native port of libc `memcmp` at the ordering boundary. The
// observable is the SIGN of the return value (less | equal | greater), compared
// byte-wise and UNSIGNED over n bytes. This file is the *candidate source* bound
// into the sealed package
// (phost/evidence/porting/memcmp/sealed_package.json: candidate_source_hash).
//
// Buffers are modelled as up to 8 bytes packed BIG-ENDIAN into a u64 (byte 0 in
// the most-significant position); the 312-case corpus never exceeds 8 bytes. That
// packing makes unsigned integer comparison of the two masked words exactly the C
// memcmp ordering, because the first differing byte (lowest index) is the most
// significant difference.
//
// ABI — the executed entry point (see phost::porting::exec):
//   symbol `_phor_phor_memcmp_sign`; SysV AMD64 (RDI, RSI, RDX) -> RAX, i.e.
//   `phor_memcmp_sign(wa: u64, wb: u64, n: u64) -> u64`.
//   The result is an i64 whose sign is the memcmp sign (-1 | 0 | 1).
//   The function is a leaf: no calls, no relocations, no heap, no syscalls.
//
// Scope: API-surface JIT-porting. NOT arbitrary binary translation. The cage
// observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_memcmp:v1.0";

// ── Domain constants ─────────────────────────────────────

const WIDTH: u64 = 8;         // bytes packed per buffer word
const CORPUS_CASES: u64 = 312;

// ── Target and evidence records ──────────────────────────
// These mirror the residuals the court seals for this target.

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    input_schema: Str(64),
    output_schema: Str(64),
}

struct ReplayVerdict {
    target: Str(32),
    cases_run: u64,
    cases_passed: u64,
    cases_failed: u64,
    verdict: u8,
}

struct SealedPackage {
    target: Str(32),
    dialect_name: Str(16),
    trust_level: u8,
    case_count: u64,
    oracle_hash: Str(64),
    candidate_hash: Str(64),
}

// ── Native clean-room candidate ──────────────────────────
//
// Branchless and leaf. `ones` is built by wrapping subtraction; the mask selects
// the top n bytes (bytes 0..n-1 of the packed buffer); `n == 0` yields mask 0 so
// the comparison is Equal regardless of the buffers. The `& 63` clamp makes the
// shift explicit (n == 0 would otherwise shift by 64).

fn phor_memcmp_sign(wa: u64, wb: u64, n: u64) -> u64
    effect [compute]
{
    let ones: u64 = 0 - 1;
    let nonzero: u64 = (n != 0) as u64;
    let shift: u64 = ((WIDTH - n) * 8) & 63;
    let mask: u64 = (ones << shift) * nonzero;

    let xa: u64 = wa & mask;
    let xb: u64 = wb & mask;

    let is_less: u64 = (xa < xb) as u64;
    let is_greater: u64 = (xa > xb) as u64;
    return is_greater - is_less;
}
