// sound_tests.phor — Comprehensive sound subsystem tests
// Tests: audio buffer ring, sample format conversion, mixer routing,
//        PCM stream management, HDA register operations
//
// Expected outcomes:
//   - Audio ring buffer correctly handles producer/consumer with wraparound
//   - Sample format conversion between all supported formats is lossless
//   - Mixer routes correctly sum multiple input channels to output
//   - PCM stream management handles start/stop/pause/resume correctly
//   - HDA register read/write operations work with correct bitfield access
//   - All operations bounded, effect-declared, and residual-recorded

package "phorensic:sound_tests:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*

// ============================================================================
// Constants
// ============================================================================

const AUDIO_RING_SIZE: u64 = 4096;
const MAX_CHANNELS: u64 = 8;
const MAX_MIXER_INPUTS: u64 = 16;
const SAMPLE_RATES: u64 = 4;
const PCM_MAX_STREAMS: u64 = 8;
const HDA_MAX_NODES: u64 = 64;
const HDA_REG_COUNT: u64 = 256;
const BUFFER_THRESHOLD_LOW: u64 = 512;
const BUFFER_THRESHOLD_HIGH: u64 = 3072;

// ============================================================================
// Data Structures
// ============================================================================

struct AudioRingBuffer {
    data: Array(u8, 4096),
    capacity: u64,
    read_pos: u64,
    write_pos: u64,
    bytes_available: u64,
    underrun_count: u64,
    overrun_count: u64,
}

enum SampleFormat : u8 {
    U8  = 0,
    S16 = 1,
    S24 = 2,
    S32 = 3,
    F32 = 4,
}

struct SampleFormatInfo {
    format: SampleFormat,
    bits_per_sample: u8,
    bytes_per_sample: u8,
    is_float: bool,
    is_signed: bool,
}

struct AudioBuffer {
    samples: Array(u8, 4096),
    format: SampleFormat,
    channels: u8,
    sample_count: u64,
    sample_rate: u32,
}

struct MixerInput {
    input_id: u64,
    buffer: AudioBuffer,
    gain: f32,
    muted: bool,
    invert_phase: bool,
    active: bool,
}

struct Mixer {
    inputs: Array(MixerInput, 16),
    input_count: u64,
    output: AudioBuffer,
    master_gain: f32,
    sample_rate: u32,
}

enum PCMState : u8 {
    Stopped = 0,
    Running = 1,
    Paused  = 2,
    Draining = 3,
}

struct PCMStream {
    stream_id: u64,
    state: PCMState,
    format: SampleFormat,
    channels: u8,
    sample_rate: u32,
    ring_buffer: AudioRingBuffer,
    latency_us: u64,
    period_size: u64,
    buffer_size: u64,
    underruns: u64,
    overruns: u64,
    hw_ptr: u64,
    app_ptr: u64,
}

struct HDARegister {
    offset: u16,
    value: u32,
    mask: u32,
    read_only: bool,
}

struct HDAController {
    registers: Array(HDARegister, 256),
    reg_count: u64,
    codec_present: bool,
    stream_count: u8,
    dma_position: Array(u32, 8),
    last_irq_status: u32,
}

// ============================================================================
// Sound Error Types
// ============================================================================

type SoundError : u32 = enum {
    RingBufferEmpty       = 0x9001,
    RingBufferFull        = 0x9002,
    InvalidSampleFormat   = 0x9003,
    ConversionOverflow    = 0x9004,
    MixerInputNotFound    = 0x9005,
    MixerOutputClipping   = 0x9006,
    PCMStreamNotRunning   = 0x9007,
    PCMStreamAlreadyRunning = 0x9008,
    HDARegisterInvalid    = 0x9009,
    HDAInvalidNode        = 0x900A,
    PeriodSizeMismatch    = 0x900B,
    BufferUnderrun        = 0x900C,
    BufferOverrun         = 0x900D,
    UnsupportedFormat     = 0x900E,
    ChannelCountMismatch  = 0x900F,
}

// ============================================================================
// Test: Audio Buffer Ring
// ============================================================================

fn test_ring_buffer_write_read() -> void
    effect [compute, residual]
{
    let mut ring: AudioRingBuffer = AudioRingBuffer{
        data: Array::zeroed(),
        capacity: 256,
        read_pos: 0,
        write_pos: 0,
        bytes_available: 0,
        underrun_count: 0,
        overrun_count: 0,
    };

    // Write 100 bytes
    for i in 0..100 {
        ring.data[ring.write_pos] = (i & 0xFF) as u8;
        ring.write_pos = (ring.write_pos + 1) % ring.capacity;
        ring.bytes_available = ring.bytes_available + 1;
    }

    assert(ring.bytes_available == 100, "sound: 100 bytes in ring buffer");
    assert(ring.write_pos == 100, "sound: write position at 100");

    // Read 50 bytes
    for i in 0..50 {
        let val: u8 = ring.data[ring.read_pos];
        assert(val == (i & 0xFF) as u8, "sound: read byte matches written");
        ring.read_pos = (ring.read_pos + 1) % ring.capacity;
        ring.bytes_available = ring.bytes_available - 1;
    }

    assert(ring.bytes_available == 50, "sound: 50 bytes remaining");
    assert(ring.read_pos == 50, "sound: read position at 50");

    residual emit {
        op: "sound.test.ring_write_read",
        capacity: ring.capacity,
        written: 100,
        read: 50,
        remaining: ring.bytes_available,
    };
}

fn test_ring_buffer_wraparound() -> void
    effect [compute, residual]
{
    let mut ring: AudioRingBuffer = AudioRingBuffer{
        data: Array::zeroed(),
        capacity: 64,
        read_pos: 60,
        write_pos: 60,
        bytes_available: 0,
        underrun_count: 0,
        overrun_count: 0,
    };

    // Write 10 bytes at end of buffer (wraps around)
    for i in 0..10 {
        ring.data[ring.write_pos] = (i + 100) as u8;
        ring.write_pos = (ring.write_pos + 1) % ring.capacity;
        ring.bytes_available = ring.bytes_available + 1;
    }

    assert(ring.write_pos == 6, "sound: write position wrapped to 6");
    assert(ring.bytes_available == 10, "sound: 10 bytes after wrap");

    // Read all 10 (will wrap)
    for i in 0..10 {
        let val: u8 = ring.data[ring.read_pos];
        assert(val == (i + 100) as u8, "sound: wrapped read matches");
        ring.read_pos = (ring.read_pos + 1) % ring.capacity;
        ring.bytes_available = ring.bytes_available - 1;
    }

    assert(ring.read_pos == 6, "sound: read position wrapped");
    assert(ring.bytes_available == 0, "sound: buffer empty after read");

    residual emit {
        op: "sound.test.ring_wraparound",
        wrapped_write: true,
        wrapped_read: true,
    };
}

fn test_ring_buffer_underrun() -> void
    effect [compute, residual]
{
    let mut ring: AudioRingBuffer = AudioRingBuffer{
        data: Array::zeroed(),
        capacity: 128,
        read_pos: 0,
        write_pos: 20,
        bytes_available: 20,
        underrun_count: 0,
        overrun_count: 0,
    };

    // Try to read more than available
    let read_request: u64 = 50;
    let can_read: u64 = if ring.bytes_available < read_request {
        ring.underrun_count = ring.underrun_count + 1;
        ring.bytes_available
    } else {
        read_request
    };

    assert(can_read == 20, "sound: underrun, only 20 bytes available");
    assert(ring.underrun_count == 1, "sound: 1 underrun recorded");

    residual emit {
        op: "sound.test.ring_underrun",
        underrun_detected: true,
        available: ring.bytes_available,
        requested: read_request,
    };
}

fn test_ring_buffer_overrun() -> void
    effect [compute, residual]
{
    let mut ring: AudioRingBuffer = AudioRingBuffer{
        data: Array::zeroed(),
        capacity: 64,
        read_pos: 0,
        write_pos: 30,
        bytes_available: 60,
        overrun_count: 0,
        underrun_count: 0,
    };

    // Try to write more than space available
    let write_request: u64 = 20;
    let available_space: u64 = ring.capacity - ring.bytes_available;
    let can_write: u64 = if write_request > available_space {
        ring.overrun_count = ring.overrun_count + 1;
        available_space
    } else {
        write_request
    };

    assert(available_space == 4, "sound: only 4 bytes space available");
    assert(can_write == 4, "sound: overrun prevented");
    assert(ring.overrun_count == 1, "sound: 1 overrun recorded");

    residual emit {
        op: "sound.test.ring_overrun",
        overrun_detected: true,
        space_available: available_space,
        requested: write_request,
    };
}

// ============================================================================
// Test: Sample Format Conversion
// ============================================================================

fn test_sample_format_info() -> void
    effect [compute, residual]
{
    // U8
    let u8_info: SampleFormatInfo = SampleFormatInfo{
        format: SampleFormat::U8, bits_per_sample: 8, bytes_per_sample: 1,
        is_float: false, is_signed: false,
    };
    assert(u8_info.bytes_per_sample == 1, "sound: U8 is 1 byte");
    assert(!u8_info.is_signed, "sound: U8 is unsigned");

    // S16_LE
    let s16_info: SampleFormatInfo = SampleFormatInfo{
        format: SampleFormat::S16, bits_per_sample: 16, bytes_per_sample: 2,
        is_float: false, is_signed: true,
    };
    assert(s16_info.bytes_per_sample == 2, "sound: S16 is 2 bytes");
    assert(s16_info.is_signed, "sound: S16 is signed");

    // S32_LE
    let s32_info: SampleFormatInfo = SampleFormatInfo{
        format: SampleFormat::S32, bits_per_sample: 32, bytes_per_sample: 4,
        is_float: false, is_signed: true,
    };
    assert(s32_info.bytes_per_sample == 4, "sound: S32 is 4 bytes");

    // F32
    let f32_info: SampleFormatInfo = SampleFormatInfo{
        format: SampleFormat::F32, bits_per_sample: 32, bytes_per_sample: 4,
        is_float: true, is_signed: true,
    };
    assert(f32_info.is_float, "sound: F32 is float");

    residual emit {
        op: "sound.test.format_info",
        formats_tested: 4,
    };
}

fn test_sample_conversion_s16_to_s32() -> void
    effect [compute, residual]
{
    let input: i16 = -32768; // S16_MIN
    let expected: i32 = (input as i32) << 16; // -2147483648
    let converted: i32 = (input as i32) << 16;

    assert(converted == expected, "sound: S16_MIN -> S32 conversion correct");
    assert(converted == -2147483648, "sound: S16_MIN == -32768 -> -2147483648");

    // 0 -> 0
    let zero: i16 = 0;
    let conv_zero: i32 = (zero as i32) << 16;
    assert(conv_zero == 0, "sound: S16 0 -> S32 0");

    residual emit {
        op: "sound.test.conv_s16_s32",
        min_converted: true,
        zero_converted: true,
    };
}

// ============================================================================
// Test: Mixer Routing
// ============================================================================

fn test_mixer_add_input() -> void
    effect [compute, residual]
{
    let mut mixer: Mixer = Mixer{
        inputs: Array::zeroed(),
        input_count: 0,
        output: AudioBuffer{
            samples: Array::zeroed(), format: SampleFormat::S16,
            channels: 2, sample_count: 0, sample_rate: 48000,
        },
        master_gain: 1.0,
        sample_rate: 48000,
    };

    // Add input 1
    mixer.inputs[0] = MixerInput{
        input_id: 1,
        buffer: AudioBuffer{
            samples: Array::zeroed(), format: SampleFormat::S16,
            channels: 2, sample_count: 100, sample_rate: 48000,
        },
        gain: 0.8, muted: false, invert_phase: false, active: true,
    };
    mixer.input_count = 1;

    // Add input 2
    mixer.inputs[1] = MixerInput{
        input_id: 2,
        buffer: AudioBuffer{
            samples: Array::zeroed(), format: SampleFormat::S16,
            channels: 2, sample_count: 100, sample_rate: 48000,
        },
        gain: 0.5, muted: false, invert_phase: false, active: true,
    };
    mixer.input_count = 2;

    // Add muted input 3
    mixer.inputs[2] = MixerInput{
        input_id: 3,
        buffer: AudioBuffer{
            samples: Array::zeroed(), format: SampleFormat::S16,
            channels: 2, sample_count: 100, sample_rate: 48000,
        },
        gain: 1.0, muted: true, invert_phase: false, active: true,
    };
    mixer.input_count = 3;

    assert(mixer.input_count == 3, "sound: mixer has 3 inputs");
    assert(mixer.inputs[0].gain == 0.8, "sound: input 1 gain = 0.8");
    assert(mixer.inputs[2].muted, "sound: input 3 is muted");

    residual emit {
        op: "sound.test.mixer_add",
        input_count: mixer.input_count,
        active_inputs: 2,
        muted_inputs: 1,
    };
}

fn test_mixer_levels() -> void
    effect [compute, residual]
{
    let mixer: Mixer = Mixer{
        inputs: Array::zeroed(),
        input_count: 2,
        output: AudioBuffer{
            samples: Array::zeroed(), format: SampleFormat::S16,
            channels: 1, sample_count: 0, sample_rate: 44100,
        },
        master_gain: 0.75,
        sample_rate: 44100,
    };

    // Input gains: 0.8 and 0.5, master: 0.75
    // Total gain per input: 0.8 * 0.75 = 0.6 and 0.5 * 0.75 = 0.375
    let input1_gain: f32 = 0.8;
    let input2_gain: f32 = 0.5;
    let master_gain: f32 = 0.75;
    let total1: f32 = input1_gain * master_gain;
    let total2: f32 = input2_gain * master_gain;
    assert(total1 > total2, "sound: input 1 louder than input 2");

    residual emit {
        op: "sound.test.mixer_levels",
        input1_total_level: total1 as u64,
        input2_total_level: total2 as u64,
        master: master_gain as u64,
    };
}

// ============================================================================
// Test: PCM Stream Management
// ============================================================================

fn test_pcm_stream_lifecycle() -> void
    effect [compute, residual]
{
    let mut stream: PCMStream = PCMStream{
        stream_id: 1,
        state: PCMState::Stopped,
        format: SampleFormat::S16,
        channels: 2,
        sample_rate: 48000,
        ring_buffer: AudioRingBuffer{
            data: Array::zeroed(), capacity: 2048,
            read_pos: 0, write_pos: 0, bytes_available: 0,
            underrun_count: 0, overrun_count: 0,
        },
        latency_us: 10000,
        period_size: 512,
        buffer_size: 2048,
        underruns: 0,
        overruns: 0,
        hw_ptr: 0,
        app_ptr: 0,
    };

    assert(stream.state == PCMState::Stopped, "sound: PCM initially stopped");
    assert(stream.format == SampleFormat::S16, "sound: format S16_LE");
    assert(stream.channels == 2, "sound: stereo");

    // Start
    stream.state = PCMState::Running;
    assert(stream.state == PCMState::Running, "sound: PCM started");

    // Pause
    stream.state = PCMState::Paused;
    assert(stream.state == PCMState::Paused, "sound: PCM paused");

    // Resume
    stream.state = PCMState::Running;
    assert(stream.state == PCMState::Running, "sound: PCM resumed");

    // Stop
    stream.state = PCMState::Stopped;
    assert(stream.state == PCMState::Stopped, "sound: PCM stopped");

    residual emit {
        op: "sound.test.pcm_lifecycle",
        transitions: 4,
        final_state: PCMState::Stopped as u64,
    };
}

fn test_pcm_buffer_management() -> void
    effect [compute, residual]
{
    let mut stream: PCMStream = PCMStream{
        stream_id: 2,
        state: PCMState::Running,
        format: SampleFormat::S16,
        channels: 1,
        sample_rate: 44100,
        ring_buffer: AudioRingBuffer{
            data: Array::zeroed(), capacity: 4096,
            read_pos: 0, write_pos: 2048, bytes_available: 2048,
            underrun_count: 0, overrun_count: 0,
        },
        latency_us: 0,
        period_size: 1024,
        buffer_size: 4096,
        underruns: 0,
        overruns: 0,
        hw_ptr: 1024,
        app_ptr: 2048,
    };

    assert(stream.buffer_size == 4096, "sound: buffer size 4096 bytes");
    assert(stream.period_size == 1024, "sound: period size 1024 bytes");

    // Advance hardware pointer
    stream.hw_ptr = stream.hw_ptr + stream.period_size;
    assert(stream.hw_ptr == 2048, "sound: hw_ptr advanced by one period");

    // Calculate available space for application writes
    let avail: u64 = stream.buffer_size - (stream.app_ptr - stream.hw_ptr);
    let expected_avail: u64 = 2048;
    assert(avail == expected_avail, "sound: available space = buffer - (app - hw)");

    // Check latency
    let bytes_per_sample: u64 = 2; // S16
    let frame_size: u64 = bytes_per_sample * (stream.channels as u64);
    let frames_buffered: u64 = stream.ring_buffer.bytes_available / frame_size;
    let latency_us: u64 = (frames_buffered * 1000000) / (stream.sample_rate as u64);
    assert(latency_us > 0, "sound: latency > 0 with buffered data");

    residual emit {
        op: "sound.test.pcm_buffers",
        buffer_size: stream.buffer_size,
        period_size: stream.period_size,
        hw_ptr: stream.hw_ptr,
        app_ptr: stream.app_ptr,
        latency_us: latency_us,
    };
}

// ============================================================================
// Test: HDA Register Operations
// ============================================================================

fn test_hda_register_read_write() -> void
    effect [compute, residual]
{
    let mut hda: HDAController = HDAController{
        registers: Array::zeroed(),
        reg_count: 4,
        codec_present: true,
        stream_count: 4,
        dma_position: Array::zeroed(),
        last_irq_status: 0,
    };

    // Initialize registers
    hda.registers[0] = HDARegister{ offset: 0x00, value: 0x01, mask: 0xFFFFFFFF, read_only: false }; // GCAP
    hda.registers[1] = HDARegister{ offset: 0x04, value: 0x00112233, mask: 0xFFFFFFFF, read_only: false }; // VMIN/VMAJ
    hda.registers[2] = HDARegister{ offset: 0x08, value: 0x00000000, mask: 0x0000000F, read_only: false }; // OUTPAY
    hda.registers[3] = HDARegister{ offset: 0x0C, value: 0x00000000, mask: 0xFFFFFFFF, read_only: true }; // INPAY (read-only)

    // Read GCAP register
    let gcap: u32 = hda.registers[0].value;
    assert(gcap == 0x01, "sound: HDA GCAP = 0x01");

    // Write to OUTPAY (bits 0-3 writable)
    let write_val: u32 = 0x00000005;
    let masked_val: u32 = write_val & hda.registers[2].mask;
    hda.registers[2].value = masked_val;
    assert(hda.registers[2].value == 0x00000005, "sound: OUTPAY written with mask");

    // Try to write read-only register (should not change)
    let ro_val: u32 = 0xDEADBEEF;
    if !hda.registers[3].read_only {
        hda.registers[3].value = ro_val;
    }
    assert(hda.registers[3].value == 0x00000000, "sound: read-only register unchanged");

    residual emit {
        op: "sound.test.hda_registers",
        regs_tested: hda.reg_count,
        gcap: gcap as u64,
        masked_write: true,
        read_only_protected: true,
    };
}

fn test_hda_codec_detect() -> void
    effect [compute, residual]
{
    let mut hda: HDAController = HDAController{
        registers: Array::zeroed(),
        reg_count: 2,
        codec_present: false,
        stream_count: 0,
        dma_position: Array::zeroed(),
        last_irq_status: 0,
    };

    // Codec detect via STATS register (bit 0 = codec 0 present)
    let stats_reg: u32 = 0x01; // Codec 0 present
    hda.codec_present = (stats_reg & 0x01) != 0;
    assert(hda.codec_present, "sound: codec detected");

    // With no codec
    let stats_reg_empty: u32 = 0x00;
    let codec_present: bool = (stats_reg_empty & 0x01) != 0;
    assert(!codec_present, "sound: no codec detected");

    residual emit {
        op: "sound.test.hda_codec",
        codec_detected: true,
        no_codec_detected: true,
    };
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, SoundError)
    effects: [compute, io:write, residual]
{
    console.write_line("Sound Subsystem Tests")!;
    console.write_line("======================")!;

    // Ring buffer tests
    test_ring_buffer_write_read();
    console.write_line("  [PASS] Ring buffer write/read")!;
    test_ring_buffer_wraparound();
    console.write_line("  [PASS] Ring buffer wraparound")!;
    test_ring_buffer_underrun();
    console.write_line("  [PASS] Ring buffer underrun")!;
    test_ring_buffer_overrun();
    console.write_line("  [PASS] Ring buffer overrun")!;

    // Sample format tests
    test_sample_format_info();
    console.write_line("  [PASS] Sample format info")!;
    test_sample_conversion_s16_to_s32();
    console.write_line("  [PASS] Sample conversion S16->S32")!;

    // Mixer tests
    test_mixer_add_input();
    console.write_line("  [PASS] Mixer add input")!;
    test_mixer_levels();
    console.write_line("  [PASS] Mixer levels")!;

    // PCM stream tests
    test_pcm_stream_lifecycle();
    console.write_line("  [PASS] PCM stream lifecycle")!;
    test_pcm_buffer_management();
    console.write_line("  [PASS] PCM buffer management")!;

    // HDA tests
    test_hda_register_read_write();
    console.write_line("  [PASS] HDA register read/write")!;
    test_hda_codec_detect();
    console.write_line("  [PASS] HDA codec detect")!;

    residual emit {
        op: "sound_tests.complete",
        ring_tests: 4,
        format_tests: 2,
        mixer_tests: 2,
        pcm_tests: 2,
        hda_tests: 2,
        total_tests: 12,
        result: "all_passed",
    };

    console.write_line("")!;
fn test_hda_irq_handling() -> void
    effect [compute, residual]
{
    let mut irq_status: u32 = 0;
    let irq_count: u64 = 5;

    for i in 0..irq_count {
        irq_status = irq_status | (1 << i);
    }
    assert(irq_status == 0x1F, "sound: HDA IRQ status bits 0-4 set");

    // Clear IRQ
    irq_status = 0;
    assert(irq_status == 0, "sound: HDA IRQ cleared");

    residual emit {
        op: "sound.test.hda_irq",
        irqs_raised: irq_count,
        irqs_cleared: true,
    };
}

fn test_hda_stream_descriptor() -> void
    effect [compute, residual]
{
    let stream_number: u8 = 0;
    let stream_format: u16 = 0x0031; // 48kHz, 16-bit, stereo
    let buffer_size: u32 = 8192;
    let cyclic_buffer_length: u16 = 8;

    let bdpl: u32 = buffer_size;
    let cbl: u16 = cyclic_buffer_length;
    let fmt: u16 = stream_format;

    assert((fmt & 0x0031) != 0, "sound: HDA stream format PCM bits set");
    assert(bdpl == 8192, "sound: HDA BDLPL = 8192");
    assert(cbl == 8, "sound: HDA CBL = 8 entries");

    residual emit {
        op: "sound.test.hda_stream",
        stream: stream_number as u64,
        fmt: fmt as u64,
        buffer: bdpl as u64,
    };
}

    console.write_line("All 12 sound tests passed!")!;
    return Ok(void);
}

fn test_audio_channel_mapping() -> void
    effect [compute, residual]
{
    let mono: u8 = 1;
    let stereo: u8 = 2;
    let quad: u8 = 4;
    let surround51: u8 = 6;
    let surround71: u8 = 8;

    assert(mono == 1, "sound: mono = 1 channel");
    assert(stereo == 2, "sound: stereo = 2 channels");
    assert(quad == 4, "sound: quad = 4 channels");
    assert(surround51 == 6, "sound: 5.1 = 6 channels");
    assert(surround71 == 8, "sound: 7.1 = 8 channels");

    residual emit {
        op: "sound.test.channel_map",
        configs: 5,
    };
}

fn test_audio_bit_depth_conversion() -> void
    effect [compute, residual]
{
    let u8_max: u16 = 255;
    let s16_max: i32 = 32767;
    let s24_max: i32 = 8388607;
    let s32_max: i64 = 2147483647;

    // U8 to S16: scale
    let u8_val: u16 = 128;
    let s16_val: i32 = ((u8_val as i32) - 128) * 256;
    assert(s16_val == 0, "sound: U8 mid-scale maps to S16 zero");

    residual emit {
        op: "sound.test.bit_depth",
        u8_max: u8_max as u64,
        s16_max: s16_max as u64,
        s24_max: s24_max as u64,
        s32_max: s32_max as u64,
    };
}

fn test_audio_latency_calculation() -> void
    effect [compute, residual]
{
    let buffer_size: u64 = 512;
    let sample_rate: u32 = 48000;
    let channels: u8 = 2;
    let bytes_per_sample: u64 = 2;
    let frames: u64 = buffer_size / ((channels as u64) * bytes_per_sample);
    let latency_us: u64 = (frames * 1000000) / (sample_rate as u64);

    assert(frames == 128, "sound: 128 frames in 512 byte buffer");
    assert(latency_us < 10000, "sound: latency under 10ms");

    residual emit {
        op: "sound.test.latency",
        frames: frames,
        latency_us: latency_us,
    };
}
