// file: capabilities.phor
// purpose: Capability types with affine semantics, RightsSet, CapabilityManager.
//          Implements linear/affine type behavior — capabilities cannot be
//          duplicated, only moved or consumed. Generation-tagged for revocation.
// evidence: CAP-ARCH-001 through CAP-ARCH-120
// residual: All types are affine (linear at runtime); consumption is explicit.

use core::constants::*
use core::types::*
use core::errors::*

// ──────────────────────────────────────────────
// RightsSet: Bitmask of capability rights
// ──────────────────────────────────────────────
// A fixed-size set of capability rights backed by a Word64 bitmask.
// Evidence path: CAP-RIGHTS-001 through CAP-RIGHTS-045

pub type RightsSet : Word64 = struct {
    // Bitmask of rights. Each bit corresponds to a CAP_RIGHT_* constant.
    mask: Word64,
}

impl RightsSet {
    // Create an empty rights set.
    pub fn empty() -> RightsSet
        effects: [deterministic]
    {
        RightsSet { mask: Word64::from_u64(CAP_RIGHT_NONE) }
    }

    // Create a rights set with all bits set.
    pub fn all() -> RightsSet
        effects: [deterministic]
    {
        RightsSet { mask: Word64::from_u64(CAP_RIGHT_ALL) }
    }

    // Create from a raw bitmask.
    pub fn from_mask(mask: Word64) -> RightsSet
        effects: [deterministic]
    {
        RightsSet { mask: mask }
    }

    // Create from a list of right identifiers.
    pub fn from_rights(rights: Word64[], count: u32) -> RightsSet
        effects: [deterministic]
    {
        let mut mask: Word64 = Word64::zero()
        // loop: bounds[BOUND_SMALL] — bounded by max rights
        loop: bounds[BOUND_SMALL] for i in 0..count {
            mask = mask.bit_or(rights[i as usize])
        }
        RightsSet { mask: mask }
    }

    // Return the raw mask.
    pub fn mask(self) -> Word64
        effects: [deterministic]
    {
        self.mask
    }

    // Check if a specific right is present.
    pub fn has_right(self, right: Word64) -> bool
        effects: [deterministic]
    {
        let masked: Word64 = self.mask.bit_and(right)
        !masked.is_zero()
    }

    // Check if all rights from another set are present.
    pub fn has_all(self, required: RightsSet) -> bool
        effects: [deterministic]
    {
        let combined: Word64 = self.mask.bit_and(required.mask)
        combined.eq(required.mask)
    }

    // Check if any right from another set is present.
    pub fn has_any(self, rights: RightsSet) -> bool
        effects: [deterministic]
    {
        let combined: Word64 = self.mask.bit_and(rights.mask)
        !combined.is_zero()
    }

    // Add a right to the set.
    pub fn add(self: ref mut, right: Word64)
        effects: [deterministic]
    {
        self.mask = self.mask.bit_or(right)
    }

    // Remove a right from the set.
    pub fn remove(self: ref mut, right: Word64)
        effects: [deterministic]
    {
        let not_right: Word64 = right.bit_not()
        self.mask = self.mask.bit_and(not_right)
    }

    // Intersect with another rights set.
    pub fn intersect(self, other: RightsSet) -> RightsSet
        effects: [deterministic]
    {
        RightsSet { mask: self.mask.bit_and(other.mask) }
    }

    // Union with another rights set.
    pub fn union(self, other: RightsSet) -> RightsSet
        effects: [deterministic]
    {
        RightsSet { mask: self.mask.bit_or(other.mask) }
    }

    // Subtract rights of another set.
    pub fn subtract(self, other: RightsSet) -> RightsSet
        effects: [deterministic]
    {
        let not_other: Word64 = other.mask.bit_not()
        RightsSet { mask: self.mask.bit_and(not_other) }
    }

    // Count how many rights are set.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.mask.count_ones()
    }

    // Check if the set is empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.mask.is_zero()
    }

    // Check if the set has full rights.
    pub fn is_all(self) -> bool
        effects: [deterministic]
    {
        self.mask.eq(Word64::from_u64(CAP_RIGHT_ALL))
    }

    // Equality check.
    pub fn eq(self, other: RightsSet) -> bool
        effects: [deterministic]
    {
        self.mask.eq(other.mask)
    }

    // Iterate over set rights, calling a function for each.
    // loop: bounds[BOUND_SMALL] — up to 64 bits checked.
    pub fn for_each(self, f: fn(Word64))
        effects: [deterministic]
    {
        let mut bits: Word64 = self.mask
        let mut bit_pos: u32 = 0
        // loop: bounds[BOUND_SMALL] — at most 64 iterations
        loop: bounds[BOUND_SMALL] while !bits.is_zero() && bit_pos < 64 {
            let current_bit: Word64 = Word64::from_u64(1 << bit_pos)
            if bits.bit_and(current_bit).neq(Word64::zero()) {
                f(current_bit)
                bits = bits.bit_and(current_bit.bit_not())
            }
            bit_pos = bit_pos + 1
        }
    }

    // Convert to a sorted array of right values.
    pub fn to_array(self) -> Word64[MAX_RIGHTS_SET_SIZE]
        effects: [deterministic]
    {
        let mut result: Word64[MAX_RIGHTS_SET_SIZE] = [Word64::zero(); MAX_RIGHTS_SET_SIZE]
        let mut idx: u32 = 0
        let mut bits: u64 = self.mask.to_u64()
        let mut bit_pos: u32 = 0
        // loop: bounds[BOUND_SMALL] — at most 64 iterations
        loop: bounds[BOUND_SMALL] while bits != 0 && bit_pos < 64 {
            if (bits & 1) != 0 {
                result[idx as usize] = Word64::from_u64(1 << bit_pos)
                idx = idx + 1
            }
            bits = bits >> 1
            bit_pos = bit_pos + 1
        }
        result
    }
}

// ──────────────────────────────────────────────
// Capability Base Type
// ──────────────────────────────────────────────
// An affine capability: cannot be copied, only moved.
// The compiler enforces single-use semantics at compile time.
// Evidence path: CAP-BASE-001 through CAP-BASE-050

pub type Capability : struct {
    // The rights granted by this capability.
    rights: RightsSet,
    // The identity this capability targets.
    target: Identity,
    // The identity that issued this capability.
    issuer: Identity,
    // Generation tag for revocation checking.
    generation: Word32,
    // Trust level required to use this capability.
    trust_required: TrustLevel,
    // Whether this capability has been consumed (moved).
    // Runtime check for linearity enforcement.
    consumed: bool,
}

// Capability is affine — no `Copy` or `Clone` is defined.
// The compiler will enforce that capabilities are not duplicated.

impl Capability {
    // Create a new capability (consumes the issuer's authority).
    // Note: This is a linear operation — the issuer's right to grant
    // this capability is consumed in the process.
    pub fn new(
        rights: RightsSet,
        target: Identity,
        issuer: Identity,
        generation: Word32,
        trust_required: TrustLevel,
    ) -> Capability
        effects: [deterministic, capability]
    {
        Capability {
            rights: rights,
            target: target,
            issuer: issuer,
            generation: generation,
            trust_required: trust_required,
            consumed: false,
        }
    }

    // Create a minimal (empty) capability.
    pub fn empty() -> Capability
        effects: [deterministic, capability]
    {
        Capability {
            rights: RightsSet::empty(),
            target: Identity::null(),
            issuer: Identity::null(),
            generation: 0,
            trust_required: TrustLevel::Trust_Untrusted,
            consumed: false,
        }
    }

    // Check if this capability has been consumed.
    pub fn is_consumed(self) -> bool
        effects: [deterministic]
    {
        self.consumed
    }

    // Mark this capability as consumed. Called when moving.
    // This is an intrinsic operation for the linear type system.
    fn consume(self: ref mut)
        effects: [deterministic]
    {
        // trust: Only callable by the runtime/compiler.
        // evidence: CONSUME-RATIONALE-001: Prevents double-use of affine capabilities.
        trusted("consume: marks capability as used to enforce linearity") {
            self.consumed = true
        }
    }

    // Check if this capability has a specific right.
    pub fn has_right(self, right: Word64) -> bool
        effects: [deterministic]
    {
        if self.consumed {
            return false
        }
        self.rights.has_right(right)
    }

    // Check if this capability has all the required rights.
    pub fn has_rights(self, required: RightsSet) -> bool
        effects: [deterministic]
    {
        if self.consumed {
            return false
        }
        self.rights.has_all(required)
    }

    // Get the rights from this capability.
    pub fn rights(self) -> RightsSet
        effects: [deterministic]
    {
        self.rights
    }

    // Get the target identity.
    pub fn target(self) -> Identity
        effects: [deterministic]
    {
        self.target
    }

    // Get the issuer identity.
    pub fn issuer(self) -> Identity
        effects: [deterministic]
    {
        self.issuer
    }

    // Get the generation tag.
    pub fn generation(self) -> Word32
        effects: [deterministic]
    {
        self.generation
    }

    // Get the required trust level.
    pub fn trust_required(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust_required
    }

    // Check the generation against a known value.
    // Returns false if generation is stale.
    pub fn check_generation(self, expected: Word32) -> bool
        effects: [deterministic]
    {
        if self.consumed {
            return false
        }
        self.generation == expected
    }

    // Check if the capability is valid (not consumed, generation non-zero).
    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        !self.consumed && self.generation != 0
    }

    // Create a restricted copy with a subset of rights.
    // Note: This consumes the original capability (affine semantics).
    // The original capability is consumed and cannot be used after this call.
    pub fn restrict(self, subset: RightsSet) -> Result[Capability, CapabilityError]
        effects: [deterministic, capability]
    {
        if self.consumed {
            return Result::Err(cap_use_after_move())
        }
        if !self.rights.has_all(subset) {
            return Result::Err(cap_insufficient_rights(subset.mask(), self.rights.mask()))
        }
        // Consume the original capability.
        self.consumed = true

        // Create a restricted capability with subset rights.
        // trust: The subset is guaranteed to be a subset of the original rights.
        // evidence: CAP-RESTRICT-001: Capability restriction is monotonic (can only reduce rights).
        let restricted: Capability = Capability {
            rights: subset,
            target: self.target,
            issuer: self.issuer,
            generation: self.generation,
            trust_required: self.trust_required,
            consumed: false,
        }
        Result::Ok(restricted)
    }

    // Split a capability into two capabilities with separate rights.
    // Both left and right are subsets of the original rights.
    // The original capability is consumed.
    pub fn split(self, left_rights: RightsSet, right_rights: RightsSet)
        -> Result[(Capability, Capability), CapabilityError]
        effects: [deterministic, capability]
    {
        if self.consumed {
            return Result::Err(cap_use_after_move())
        }
        // Check both subsets are within the original rights.
        if !self.rights.has_all(left_rights) {
            return Result::Err(cap_insufficient_rights(left_rights.mask(), self.rights.mask()))
        }
        if !self.rights.has_all(right_rights) {
            return Result::Err(cap_insufficient_rights(right_rights.mask(), self.rights.mask()))
        }
        // Check that split is valid (no double-counting of authority).
        // trust: Both capabilities descend from the same original.
        // evidence: CAP-SPLIT-001: Splitting preserves the invariant that the
        //           combined rights do not exceed the original.
        self.consumed = true

        let left: Capability = Capability {
            rights: left_rights,
            target: self.target,
            issuer: self.issuer,
            generation: self.generation,
            trust_required: self.trust_required,
            consumed: false,
        }
        let right: Capability = Capability {
            rights: right_rights,
            target: self.target,
            issuer: self.issuer,
            generation: self.generation,
            trust_required: self.trust_required,
            consumed: false,
        }
        Result::Ok((left, right))
    }

    // Delegate a capability to another identity with optional right reduction.
    // The original capability is consumed.
    pub fn delegate(self, to: Identity, subset: RightsSet) -> Result[Capability, CapabilityError]
        effects: [deterministic, capability]
    {
        if self.consumed {
            return Result::Err(cap_use_after_move())
        }
        if !self.rights.has_all(subset) {
            return Result::Err(cap_insufficient_rights(subset.mask(), self.rights.mask()))
        }
        // Consume the original.
        self.consumed = true

        // trust: Delegation preserves the monotonic rights property.
        // evidence: CAP-DELEGATE-001: Delegated capability always has <= rights of original.
        let delegated: Capability = Capability {
            rights: subset,
            target: to,
            issuer: self.issuer,
            generation: self.generation,
            trust_required: self.trust_required,
            consumed: false,
        }
        Result::Ok(delegated)
    }

    // Revoke a capability by consuming it.
    // This is the terminal operation for a capability.
    pub fn revoke(self) -> Result[(), CapabilityError]
        effects: [deterministic, capability]
    {
        if self.consumed {
            return Result::Err(cap_use_after_move())
        }
        // Consuming is the revocation.
        self.consumed = true
        Result::Ok(())
    }

    // Temporarily borrow the capability for a read operation.
    // The capability is consumed for the duration of the closure,
    // then reconstituted. This is a zero-cost abstraction.
    pub fn borrow_read[T](self, f: fn(ref Capability) -> T) -> Result[T, CapabilityError]
        effects: [deterministic]
    {
        if self.consumed {
            return Result::Err(cap_use_after_move())
        }
        // trust: The closure only gets a reference, not ownership.
        // evidence: CAP-BORROW-001: Borrowing does not duplicate affine state.
        let result: T = f(&self)
        Result::Ok(result)
    }

    // Equality comparison (only valid for non-consumed capabilities).
    pub fn eq(self, other: Capability) -> bool
        effects: [deterministic]
    {
        if self.consumed || other.consumed {
            return false
        }
        self.rights.eq(other.rights)
            && self.target.eq(other.target)
            && self.issuer.eq(other.issuer)
            && self.generation == other.generation
    }
}

// ──────────────────────────────────────────────
// Capability Slot: A slot in a capability table
// ──────────────────────────────────────────────
// Evidence path: CAP-SLOT-001 through CAP-SLOT-020

pub type CapabilitySlot : struct {
    cap: Capability,
    generation: Word32,   // Bumped on each allocation
    in_use: bool,
}

impl CapabilitySlot {
    pub fn empty() -> CapabilitySlot
        effects: [deterministic]
    {
        CapabilitySlot {
            cap: Capability::empty(),
            generation: 0,
            in_use: false,
        }
    }

    pub fn is_free(self) -> bool
        effects: [deterministic]
    {
        !self.in_use
    }

    pub fn generation(self) -> Word32
        effects: [deterministic]
    {
        self.generation
    }
}

// ──────────────────────────────────────────────
// CapabilityTable: Fixed-capacity table of capabilities
// ──────────────────────────────────────────────
// Evidence path: CAP-TABLE-001 through CAP-TABLE-040

pub type CapabilityTable : struct {
    slots: [CapabilitySlot; MAX_HANDLE_SLOTS],
    count: u32,
}

impl CapabilityTable {
    pub fn new() -> CapabilityTable
        effects: [deterministic]
    {
        let mut slots: [CapabilitySlot; MAX_HANDLE_SLOTS] = [CapabilitySlot::empty(); MAX_HANDLE_SLOTS]
        CapabilityTable {
            slots: slots,
            count: 0,
        }
    }

    // Allocate a new capability slot, returning the slot index.
    pub fn allocate(self: ref mut, cap: Capability) -> Result[Word32, CapabilityError>
        effects: [deterministic, capability]
    {
        if self.count >= MAX_HANDLE_SLOTS {
            return Result::Err(CapabilityError::new(
                Word64::from_u64(DIAG_CAPABILITY_BASE | 0x010),
                FixedString[128]::from_slice("Capability table full")))
        }

        // Find a free slot.
        let mut idx: u32 = 0
        let mut found: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by MAX_HANDLE_SLOTS (256)
        loop: bounds[BOUND_LARGE] while idx < MAX_HANDLE_SLOTS {
            if self.slots[idx as usize].is_free() {
                found = true
                break
            }
            idx = idx + 1
        }

        if !found {
            return Result::Err(CapabilityError::new(
                Word64::from_u64(DIAG_CAPABILITY_BASE | 0x011),
                FixedString[128]::from_slice("No free capability slot")))
        }

        let gen: Word32 = self.slots[idx as usize].generation + 1
        self.slots[idx as usize] = CapabilitySlot {
            cap: cap,
            generation: gen,
            in_use: true,
        }
        self.count = self.count + 1
        Result::Ok(idx as Word32)
    }

    // Get a capability by slot index.
    pub fn get(self, idx: Word32) -> Result[Capability, CapabilityError>
        effects: [deterministic]
    {
        let i: u32 = idx as u32
        if i >= MAX_HANDLE_SLOTS {
            return Result::Err(CapabilityError::new(
                Word64::from_u64(DIAG_CAPABILITY_BASE | 0x012),
                FixedString[128]::from_slice("Capability slot index out of bounds")))
        }
        if !self.slots[i as usize].in_use {
            return Result::Err(CapabilityError::new(
                Word64::from_u64(DIAG_CAPABILITY_BASE | 0x013),
                FixedString[128]::from_slice("Capability slot is free")))
        }
        // trust: The slot is in use, so the capability is valid.
        // evidence: CAP-GET-001: Capability extraction from in-use slot is sound.
        Result::Ok(self.slots[i as usize].cap)
    }

    // Remove (consume) a capability from the table.
    pub fn remove(self: ref mut, idx: Word32) -> Result<Capability, CapabilityError>
        effects: [deterministic, capability]
    {
        let i: u32 = idx as u32
        if i >= MAX_HANDLE_SLOTS {
            return Result::Err(CapabilityError::new(
                Word64::from_u64(DIAG_CAPABILITY_BASE | 0x014),
                FixedString[128]::from_slice("Capability slot index out of bounds")))
        }
        if !self.slots[i as usize].in_use {
            return Result::Err(CapabilityError::new(
                Word64::from_u64(DIAG_CAPABILITY_BASE | 0x015),
                FixedString[128]::from_slice("Capability slot already free")))
        }

        let cap: Capability = self.slots[i as usize].cap
        self.slots[i as usize].in_use = false
        self.count = self.count - 1
        Result::Ok(cap)
    }

    // Check if a specific right exists for a slot.
    pub fn has_right(self, idx: Word32, right: Word64) -> Result[bool, CapabilityError>
        effects: [deterministic]
    {
        let cap: Capability = self.get(idx)?
        Result::Ok(cap.has_right(right))
    }

    // Get the number of allocated slots.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.count
    }

    // Check if the table is full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.count >= MAX_HANDLE_SLOTS
    }

    // Check if the table is empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.count == 0
    }

    // Clear all capabilities (for cage teardown).
    pub fn clear(self: ref mut)
        effects: [deterministic, capability]
    {
        // loop: bounds[BOUND_LARGE] — bounded by MAX_HANDLE_SLOTS (256)
        loop: bounds[BOUND_LARGE] for i in 0..MAX_HANDLE_SLOTS {
            if self.slots[i as usize].in_use {
                // Consume the capability (affine cleanup).
                self.slots[i as usize].cap.consumed = true
                self.slots[i as usize].in_use = false
            }
        }
        self.count = 0
    }
}

// ──────────────────────────────────────────────
// CapabilityManager: High-level capability management
// ──────────────────────────────────────────────
// Manages capabilities for a single cage with scoped creation,
// delegation, and revocation.
// Evidence path: CAP-MGR-001 through CAP-MGR-050

pub type CapabilityManager : struct {
    table: CapabilityTable,
    cage_id: Identity,
    max_depth: u32,
    current_depth: u32,
    revoked: bool,
}

impl CapabilityManager {
    // Create a new manager for a cage.
    pub fn new(cage_id: Identity, max_depth: u32) -> CapabilityManager
        effects: [deterministic, capability]
    {
        if max_depth > MAX_CAPABILITY_DEPTH {
            max_depth = MAX_CAPABILITY_DEPTH
        }
        CapabilityManager {
            table: CapabilityTable::new(),
            cage_id: cage_id,
            max_depth: max_depth,
            current_depth: 0,
            revoked: false,
        }
    }

    // Grant a capability to this cage.
    pub fn grant(self: ref mut, cap: Capability) -> Result[Word32, CapabilityError>
        effects: [deterministic, capability]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        if self.current_depth >= self.max_depth {
            return Result::Err(cap_scope_exceeded(
                FixedString[128]::from_slice("Capability depth exceeded")))
        }
        let idx: Word32 = self.table.allocate(cap)?
        self.current_depth = self.current_depth + 1
        Result::Ok(idx)
    }

    // Revoke a capability by index.
    pub fn revoke(self: ref mut, idx: Word32) -> Result<(), CapabilityError>
        effects: [deterministic, capability]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        let cap: Capability = self.table.remove(idx)?
        cap.revoke()?  // Consume the capability
        if self.current_depth > 0 {
            self.current_depth = self.current_depth - 1
        }
        Result::Ok(())
    }

    // Check if a capability index has a specific right.
    pub fn check_right(self, idx: Word32, right: Word64) -> Result<bool, CapabilityError>
        effects: [deterministic]
    {
        if self.revoked {
            return Result::Ok(false)
        }
        self.table.has_right(idx, right)
    }

    // Check if a capability index has all rights in a set.
    pub fn check_rights(self, idx: Word32, required: RightsSet) -> Result<bool, CapabilityError>
        effects: [deterministic]
    {
        if self.revoked {
            return Result::Ok(false)
        }
        let cap: Capability = self.table.get(idx)?
        Result::Ok(cap.has_rights(required))
    }

    // Get the rights set for a capability.
    pub fn get_rights(self, idx: Word32) -> Result[RightsSet, CapabilityError>
        effects: [deterministic]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        let cap: Capability = self.table.get(idx)?
        Result::Ok(cap.rights())
    }

    // Delegate a capability to another cage.
    pub fn delegate(self: ref mut, idx: Word32, to: Identity,
                     subset: RightsSet) -> Result[Word32, CapabilityError>
        effects: [deterministic, capability]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        let cap: Capability = self.table.remove(idx)?
        let delegated: Capability = cap.delegate(to, subset)?
        let new_idx: Word32 = self.table.allocate(delegated)?
        Result::Ok(new_idx)
    }

    // Restrict a capability to a subset of rights.
    pub fn restrict(self: ref mut, idx: Word32,
                     subset: RightsSet) -> Result[Word32, CapabilityError>
        effects: [deterministic, capability]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        let cap: Capability = self.table.remove(idx)?
        let restricted: Capability = cap.restrict(subset)?
        let new_idx: Word32 = self.table.allocate(restricted)?
        Result::Ok(new_idx)
    }

    // Split a capability into two.
    pub fn split(self: ref mut, idx: Word32,
                  left_rights: RightsSet,
                  right_rights: RightsSet) -> Result[(Word32, Word32), CapabilityError>
        effects: [deterministic, capability]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        let cap: Capability = self.table.remove(idx)?
        let (left, right): (Capability, Capability) = cap.split(left_rights, right_rights)?
        let li: Word32 = self.table.allocate(left)?
        let ri: Word32 = self.table.allocate(right)?
        Result::Ok((li, ri))
    }

    // Get the number of capabilities managed.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.table.count()
    }

    // Get the current depth.
    pub fn depth(self) -> u32
        effects: [deterministic]
    {
        self.current_depth
    }

    // Check if the manager has been revoked.
    pub fn is_revoked(self) -> bool
        effects: [deterministic]
    {
        self.revoked
    }

    // Revoke all capabilities (cage teardown).
    pub fn revoke_all(self: ref mut)
        effects: [deterministic, capability]
    {
        self.table.clear()
        self.current_depth = 0
        self.revoked = true
    }

    // Validate that a capability's generation matches.
    pub fn validate_generation(self, idx: Word32, expected: Word32) -> Result[bool, CapabilityError>
        effects: [deterministic]
    {
        if self.revoked {
            return Result::Ok(false)
        }
        let cap: Capability = self.table.get(idx)?
        Result::Ok(cap.check_generation(expected))
    }

    // Get the target identity of a capability.
    pub fn get_target(self, idx: Word32) -> Result[Identity, CapabilityError>
        effects: [deterministic]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        let cap: Capability = self.table.get(idx)?
        Result::Ok(cap.target())
    }

    // Get the issuer identity of a capability.
    pub fn get_issuer(self, idx: Word32) -> Result[Identity, CapabilityError>
        effects: [deterministic]
    {
        if self.revoked {
            return Result::Err(cap_revoked())
        }
        let cap: Capability = self.table.get(idx)?
        Result::Ok(cap.issuer())
    }
}

// ──────────────────────────────────────────────
// ScopedCapability: RAII-style scoped capability
// ──────────────────────────────────────────────
// Automatically revokes on scope exit.
// Affine: cannot be duplicated.
// Evidence path: CAP-SCOPED-001 through CAP-SCOPED-020

pub type ScopedCapability : struct {
    cap: Capability,
    manager: ref mut CapabilityManager,
    slot_index: Word32,
    active: bool,
}

impl ScopedCapability {
    // Create a new scoped capability from a manager.
    pub fn acquire(manager: ref mut CapabilityManager,
                    cap: Capability) -> Result[ScopedCapability, CapabilityError>
        effects: [deterministic, capability]
    {
        let idx: Word32 = manager.grant(cap)?
        Result::Ok(ScopedCapability {
            cap: Capability::empty(),  // placeholder; actual cap is in manager
            manager: manager,
            slot_index: idx,
            active: true,
        })
    }

    // Access the capability for operation.
    pub fn borrow(self) -> Result[Capability, CapabilityError>
        effects: [deterministic]
    {
        if !self.active {
            return Result::Err(cap_use_after_move())
        }
        self.manager.get_rights(self.slot_index)
        // Return a reference-like view.
        let cap: Capability = self.manager.table.get(self.slot_index)?
        Result::Ok(cap)
    }

    // Check a specific right.
    pub fn has_right(self, right: Word64) -> Result[bool, CapabilityError>
        effects: [deterministic]
    {
        if !self.active {
            return Result::Ok(false)
        }
        self.manager.check_right(self.slot_index, right)
    }

    // Release the capability (consumes the scoped wrapper).
    pub fn release(self) -> Result<(), CapabilityError>
        effects: [deterministic, capability]
    {
        if !self.active {
            return Result::Err(cap_use_after_move())
        }
        self.active = false
        self.manager.revoke(self.slot_index)
    }
}

// ──────────────────────────────────────────────
// Capability Builder: Builder pattern for capabilities
// ──────────────────────────────────────────────
// Evidence path: CAP-BUILDER-001 through CAP-BUILDER-015

pub type CapabilityBuilder : struct {
    rights: RightsSet,
    target: Identity,
    issuer: Identity,
    generation: Word32,
    trust_required: TrustLevel,
}

impl CapabilityBuilder {
    pub fn new() -> CapabilityBuilder
        effects: [deterministic]
    {
        CapabilityBuilder {
            rights: RightsSet::empty(),
            target: Identity::null(),
            issuer: Identity::null(),
            generation: 0,
            trust_required: TrustLevel::Trust_Untrusted,
        }
    }

    pub fn with_rights(self: ref mut, rights: RightsSet) -> ref mut CapabilityBuilder
        effects: [deterministic]
    {
        self.rights = rights
        self
    }

    pub fn add_right(self: ref mut, right: Word64) -> ref mut CapabilityBuilder
        effects: [deterministic]
    {
        self.rights.add(right)
        self
    }

    pub fn with_target(self: ref mut, target: Identity) -> ref mut CapabilityBuilder
        effects: [deterministic]
    {
        self.target = target
        self
    }

    pub fn with_issuer(self: ref mut, issuer: Identity) -> ref mut CapabilityBuilder
        effects: [deterministic]
    {
        self.issuer = issuer
        self
    }

    pub fn with_generation(self: ref mut, gen: Word32) -> ref mut CapabilityBuilder
        effects: [deterministic]
    {
        self.generation = gen
        self
    }

    pub fn with_trust(self: ref mut, trust: TrustLevel) -> ref mut CapabilityBuilder
        effects: [deterministic]
    {
        self.trust_required = trust
        self
    }

    // Build the capability.
    pub fn build(self) -> Capability
        effects: [deterministic, capability]
    {
        Capability::new(
            self.rights,
            self.target,
            self.issuer,
            self.generation,
            self.trust_required,
        )
    }
}

// ──────────────────────────────────────────────
// CapabilitySet: A fixed-capacity set of capabilities
// ──────────────────────────────────────────────
// Multiple capabilities of varying rights grouped together.
// Evidence path: CAP-SET-001 through CAP-SET-045

pub type CapabilitySet : struct {
    caps: FixedArray[CAPACITY_MEDIUM, Capability],
}

impl CapabilitySet {
    pub fn new() -> CapabilitySet
        effects: [deterministic]
    {
        CapabilitySet { caps: FixedArray::new() }
    }

    // Add a capability to the set (consumes it — affine).
    pub fn add(self: ref mut, cap: Capability) -> Result[(), BoundsError>
        effects: [deterministic, capability]
    {
        self.caps.push(cap)
    }

    // Check if any capability in the set has a specific right.
    pub fn has_right(self, right: Word64) -> bool
        effects: [deterministic]
    {
        let mut found: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by set size
        loop: bounds[BOUND_SMALL] for i in 0..self.caps.len() {
            let cap: Capability = self.caps.get(i).unwrap()
            if cap.has_right(right) {
                found = true
                break
            }
        }
        found
    }

    // Check if every capability in the set has all required rights.
    pub fn has_all_rights(self, required: RightsSet) -> bool
        effects: [deterministic]
    {
        if self.caps.is_empty() {
            return false
        }
        // loop: bounds[BOUND_SMALL] — bounded by set size
        loop: bounds[BOUND_SMALL] for i in 0..self.caps.len() {
            let cap: Capability = self.caps.get(i).unwrap()
            if !cap.has_rights(required) {
                return false
            }
        }
        true
    }

    // Consume all capabilities in the set.
    // Used during cage teardown.
    pub fn consume_all(self: ref mut)
        effects: [deterministic, capability]
    {
        // loop: bounds[BOUND_SMALL] — bounded by set size
        loop: bounds[BOUND_SMALL] for i in 0..self.caps.len() {
            let mut cap: Capability = self.caps.get(i).unwrap()
            cap.revoke().unwrap_or(())
        }
        self.caps.clear()
    }

    // Get the number of capabilities.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.caps.len()
    }

    // Check if the set is empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.caps.is_empty()
    }

    // Get a capability by index.
    pub fn get(self, index: u32) -> Result[Capability, BoundsError>
        effects: [deterministic]
    {
        self.caps.get(index)
    }

    // Remove and return a capability by index.
    pub fn remove(self: ref mut, index: u32) -> Result[Capability, BoundsError>
        effects: [deterministic, capability]
    {
        self.caps.remove(index)
    }

    // Check if the set contains a capability targeting a specific identity.
    pub fn has_target(self, target: Identity) -> bool
        effects: [deterministic]
    {
        let mut found: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by set size
        loop: bounds[BOUND_SMALL] for i in 0..self.caps.len() {
            let cap: Capability = self.caps.get(i).unwrap()
            if cap.target().eq(target) {
                found = true
                break
            }
        }
        found
    }

    // Get the union of all rights in the set.
    pub fn union_rights(self) -> RightsSet
        effects: [deterministic]
    {
        let mut combined: RightsSet = RightsSet::empty()
        // loop: bounds[BOUND_SMALL] — bounded by set size
        loop: bounds[BOUND_SMALL] for i in 0..self.caps.len() {
            let cap: Capability = self.caps.get(i).unwrap()
            combined = combined.union(cap.rights())
        }
        combined
    }
}

// ──────────────────────────────────────────────
// CapabilityFilter: Filter rights from a set
// ──────────────────────────────────────────────
// Evidence path: CAP-FILTER-001 through CAP-FILTER-025

pub type CapabilityFilter : struct {
    allow: RightsSet,
    deny: RightsSet,
}

impl CapabilityFilter {
    pub fn new(allow: RightsSet, deny: RightsSet) -> CapabilityFilter
        effects: [deterministic]
    {
        CapabilityFilter { allow: allow, deny: deny }
    }

    pub fn allow_all() -> CapabilityFilter
        effects: [deterministic]
    {
        CapabilityFilter {
            allow: RightsSet::all(),
            deny: RightsSet::empty(),
        }
    }

    pub fn deny_all() -> CapabilityFilter
        effects: [deterministic]
    {
        CapabilityFilter {
            allow: RightsSet::empty(),
            deny: RightsSet::all(),
        }
    }

    // Apply the filter to a capability, returning filtered rights.
    pub fn apply(self, rights: RightsSet) -> RightsSet
        effects: [deterministic]
    {
        let allowed: RightsSet = rights.intersect(self.allow)
        allowed.subtract(self.deny)
    }

    // Filter a capability directly.
    pub fn filter_capability(self, cap: Capability) -> Result[Capability, CapabilityError>
        effects: [deterministic, capability]
    {
        let filtered: RightsSet = self.apply(cap.rights())
        cap.restrict(filtered)
    }

    // Check if a right would pass the filter.
    pub fn allows(self, right: Word64) -> bool
        effects: [deterministic]
    {
        self.allow.has_right(right) && !self.deny.has_right(right)
    }
}

// ──────────────────────────────────────────────
// DelegationChain: Chain of delegated capabilities
// ──────────────────────────────────────────────
// Tracks the delegation provenance of a capability.
// Evidence path: CAP-DELEG-CHAIN-001 through CAP-DELEG-CHAIN-025

pub type DelegationLink : struct {
    from: Identity,
    to: Identity,
    rights: RightsSet,
    timestamp: Timestamp,
    generation: Word32,
}

impl DelegationLink {
    pub fn new(from: Identity, to: Identity, rights: RightsSet,
                timestamp: Timestamp, generation: Word32) -> DelegationLink
        effects: [deterministic]
    {
        DelegationLink {
            from: from,
            to: to,
            rights: rights,
            timestamp: timestamp,
            generation: generation,
        }
    }
}

pub type DelegationChain : struct {
    links: FixedArray[MAX_CAPABILITY_DEPTH, DelegationLink],
    length: u32,
}

impl DelegationChain {
    pub fn new() -> DelegationChain
        effects: [deterministic]
    {
        DelegationChain { links: FixedArray::new(), length: 0 }
    }

    // Add a delegation link.
    pub fn add_link(self: ref mut, link: DelegationLink) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.links.push(link)?;
        self.length = self.length + 1
        Result::Ok(())
    }

    // Get the length of the chain.
    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    // Get the original issuer (first link in the chain).
    pub fn original_issuer(self) -> Option[Identity]
        effects: [deterministic]
    {
        if self.length > 0 {
            Option::Some(self.links.get(0).unwrap().from)
        } else {
            Option::None
        }
    }

    // Get the current holder (last link in the chain).
    pub fn current_holder(self) -> Option[Identity]
        effects: [deterministic]
    {
        if self.length > 0 {
            Option::Some(self.links.get(self.length - 1).unwrap().to)
        } else {
            Option::None
        }
    }

    // Check if the chain is valid (no cycles).
    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by chain length
        loop: bounds[BOUND_SMALL] for i in 0..self.length {
            let link_i: DelegationLink = self.links.get(i).unwrap()
            // loop: bounds[BOUND_SMALL] — bounded by chain length
            loop: bounds[BOUND_SMALL] for j in (i + 1)..self.length {
                let link_j: DelegationLink = self.links.get(j).unwrap()
                if link_i.from.eq(link_j.from) && link_i.to.eq(link_j.to) {
                    return false  // Cycle detected
                }
            }
        }
        true
    }

    // Verify monotonic rights decrease along the chain.
    pub fn rights_are_monotonic(self) -> bool
        effects: [deterministic]
    {
        if self.length <= 1 {
            return true
        }
        // loop: bounds[BOUND_SMALL] — bounded by chain length
        loop: bounds[BOUND_SMALL] for i in 0..(self.length - 1) {
            let current: DelegationLink = self.links.get(i).unwrap()
            let next: DelegationLink = self.links.get(i + 1).unwrap()
            // Next rights must be a subset of current rights.
            if !current.rights.has_all(next.rights) {
                return false
            }
        }
        true
    }
}

// ──────────────────────────────────────────────
// Capability Revocation Token
// ──────────────────────────────────────────────
// Evidence path: CAP-REVTOK-001 through CAP-REVTOK-025

pub type RevocationToken : struct {
    capability_index: Word32,
    generation: Word32,
    manager_id: Identity,
    issued: Timestamp,
    consumed: bool,
}

impl RevocationToken {
    pub fn new(index: Word32, gen: Word32, mgr: Identity, ts: Timestamp) -> RevocationToken
        effects: [deterministic]
    {
        RevocationToken {
            capability_index: index,
            generation: gen,
            manager_id: mgr,
            issued: ts,
            consumed: false,
        }
    }

    pub fn index(self) -> Word32 { self.capability_index }
    pub fn generation(self) -> Word32 { self.generation }
    pub fn manager(self) -> Identity { self.manager_id }

    pub fn is_consumed(self) -> bool { self.consumed }

    pub fn consume(self: ref mut)
        effects: [deterministic]
    {
        self.consumed = true
    }

    pub fn eq(self, other: RevocationToken) -> bool
        effects: [deterministic]
    {
        self.capability_index == other.capability_index
            && self.generation == other.generation
            && self.manager_id.eq(other.manager_id)
    }
}

// ──────────────────────────────────────────────
// Capability Rights Combinators
// ──────────────────────────────────────────────
// Evidence path: CAP-COMB-001 through CAP-COMB-020

// Combine multiple rights into a single RightsSet.
pub fn rights_read() -> RightsSet
    effects: [deterministic]
{
    RightsSet::from_mask(Word64::from_u64(CAP_RIGHT_READ))
}

pub fn rights_write() -> RightsSet
    effects: [deterministic]
{
    RightsSet::from_mask(Word64::from_u64(CAP_RIGHT_WRITE))
}

pub fn rights_read_write() -> RightsSet
    effects: [deterministic]
{
    let mut rs: RightsSet = RightsSet::empty()
    rs.add(Word64::from_u64(CAP_RIGHT_READ))
    rs.add(Word64::from_u64(CAP_RIGHT_WRITE))
    rs
}

pub fn rights_file_full() -> RightsSet
    effects: [deterministic]
{
    RightsSet::from_mask(Word64::from_u64(CAP_RIGHT_FILE_FULL))
}

pub fn rights_network_basic() -> RightsSet
    effects: [deterministic]
{
    RightsSet::from_mask(Word64::from_u64(CAP_RIGHT_NET_BASIC))
}

pub fn rights_crypto_basic() -> RightsSet
    effects: [deterministic]
{
    RightsSet::from_mask(Word64::from_u64(CAP_RIGHT_CRYPTO_BASIC))
}

// ──────────────────────────────────────────────
// Capability Rights Verification Utilities
// ──────────────────────────────────────────────
// Evidence path: CAP-VERIFY-001 through CAP-VERIFY-020

// Verify a capability has READ access.
pub fn require_read(cap: Capability) -> Result<(), CapabilityError>
    effects: [deterministic]
{
    if cap.has_right(Word64::from_u64(CAP_RIGHT_READ)) {
        Result::Ok(())
    } else {
        Result::Err(cap_insufficient_rights(
            Word64::from_u64(CAP_RIGHT_READ), cap.rights().mask()))
    }
}

// Verify a capability has WRITE access.
pub fn require_write(cap: Capability) -> Result<(), CapabilityError>
    effects: [deterministic]
{
    if cap.has_right(Word64::from_u64(CAP_RIGHT_WRITE)) {
        Result::Ok(())
    } else {
        Result::Err(cap_insufficient_rights(
            Word64::from_u64(CAP_RIGHT_WRITE), cap.rights().mask()))
    }
}

// Verify a capability has EXECUTE access.
pub fn require_execute(cap: Capability) -> Result<(), CapabilityError>
    effects: [deterministic]
{
    if cap.has_right(Word64::from_u64(CAP_RIGHT_EXECUTE)) {
        Result::Ok(())
    } else {
        Result::Err(cap_insufficient_rights(
            Word64::from_u64(CAP_RIGHT_EXECUTE), cap.rights().mask()))
    }
}

// Verify a capability has all required rights.
pub fn require_rights(cap: Capability, required: RightsSet) -> Result<(), CapabilityError>
    effects: [deterministic]
{
    if cap.has_rights(required) {
        Result::Ok(())
    } else {
        Result::Err(cap_insufficient_rights(required.mask(), cap.rights().mask()))
    }
}

// ──────────────────────────────────────────────
// Capability-Aware Access Control
// ──────────────────────────────────────────────
// Evidence path: CAP-ACL-001 through CAP-ACL-020

type AccessControlEntry : struct {
    subject: Identity,
    rights: RightsSet,
    grantor: Identity,
    expires: Option[Timestamp],
}

impl AccessControlEntry {
    pub fn new(subject: Identity, rights: RightsSet, grantor: Identity) -> AccessControlEntry
        effects: [deterministic]
    {
        AccessControlEntry {
            subject: subject,
            rights: rights,
            grantor: grantor,
            expires: Option::None,
        }
    }

    pub fn with_expiry(subject: Identity, rights: RightsSet,
                        grantor: Identity, expiry: Timestamp) -> AccessControlEntry
        effects: [deterministic]
    {
        AccessControlEntry {
            subject: subject,
            rights: rights,
            grantor: grantor,
            expires: Option::Some(expiry),
        }
    }

    pub fn is_valid_at(self, time: Timestamp) -> bool
        effects: [deterministic]
    {
        match self.expires {
            Option::Some(expiry) => time.lte(expiry),
            Option::None => true,
        }
    }

    pub fn subject(self) -> Identity { self.subject }
    pub fn rights(self) -> RightsSet { self.rights }
    pub fn grantor(self) -> Identity { self.grantor }
}

type AccessControlList : struct {
    entries: FixedArray[CAPACITY_MEDIUM, AccessControlEntry],
}

impl AccessControlList {
    pub fn new() -> AccessControlList
        effects: [deterministic]
    {
        AccessControlList { entries: FixedArray::new() }
    }

    pub fn add_entry(self: ref mut, entry: AccessControlEntry) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.entries.push(entry)
    }

    pub fn check_access(self, subject: Identity, required: RightsSet, time: Timestamp) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by entry count
        loop: bounds[BOUND_MEDIUM] for i in 0..self.entries.len() {
            let entry: AccessControlEntry = self.entries.get(i).unwrap()
            if entry.subject().eq(subject) && entry.is_valid_at(time) {
                if entry.rights().has_all(required) {
                    return true
                }
            }
        }
        false
    }

    pub fn revoke_subject(self: ref mut, subject: Identity) -> u32
        effects: [deterministic]
    {
        let mut removed: u32 = 0
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by entry count
        loop: bounds[BOUND_MEDIUM] while i < self.entries.len() {
            let entry: AccessControlEntry = self.entries.get(i).unwrap()
            if entry.subject().eq(subject) {
                let _: Result<(), BoundsError> = self.entries.remove(i)
                removed = removed + 1
            } else {
                i = i + 1
            }
        }
        removed
    }

    pub fn entry_count(self) -> u32 { self.entries.len() }

    pub fn is_empty(self) -> bool { self.entries.is_empty() }
}

// ──────────────────────────────────────────────
// Capability-Aware Memory Protection
// ──────────────────────────────────────────────
// Evidence path: CAP-MEM-001 through CAP-MEM-015

pub type MemoryCapability : struct {
    cap: Capability,
    base_address: Word64,
    page_count: Word64,
    protection: u8,
}

impl MemoryCapability {
    pub fn new(cap: Capability, base: Word64, pages: Word64, prot: u8) -> MemoryCapability
        effects: [deterministic, capability]
    {
        MemoryCapability {
            cap: cap,
            base_address: base,
            page_count: pages,
            protection: prot,
        }
    }

    pub fn base(self) -> Word64 { self.base_address }
    pub fn pages(self) -> Word64 { self.page_count }
    pub fn protection(self) -> u8 { self.protection }
    pub fn capability(self) -> Capability { self.cap }

    pub fn has_protection(self, prot: u8) -> bool
        effects: [deterministic]
    {
        (self.protection & prot) == prot
    }

    // Check if an address range is within this memory capability.
    pub fn covers(self, addr: Word64, size: Word64) -> bool
        effects: [deterministic]
    {
        let start: Word64 = self.base_address
        let end: Word64 = start.checked_add(
            self.page_count.checked_mul(Word64::from_u64(PAGE_SIZE_4K))
                .unwrap_or(Word64::max())
        ).unwrap_or(Word64::max())
        addr.gte(start) && addr.checked_add(size).unwrap_or(Word64::max()).lte(end)
    }
}
