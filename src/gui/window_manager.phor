// ──────────────────────────────────────────────
// Enumeration
// ──────────────────────────────────────────────

struct WindowEnumerator {
    ids: Array(u64, MAX_WINDOWS),
    count: u64,
}

fn wm_enumerate_windows(wm: WindowManager) -> WindowEnumerator
    effect [compute]
    bound iterations MAX_WINDOWS
{
    let mut enumerator: WindowEnumerator = WindowEnumerator {
        ids: Array::zeroed(),
        count: 0,
    };
    for i in 0..MAX_WINDOWS {
        let w_opt: Option(surface.WindowSurface) = wm.windows[i];
        match w_opt {
            Option::Some(ws) => {
                enumerator.ids[enumerator.count] = ws.common.id;
                enumerator.count = enumerator.count + 1;
            }
            Option::None => {}
        }
    }
    return enumerator;
}

fn wm_surface_at_point(wm: WindowManager, px: i32, py: i32) -> u64
    effect [compute]
    bound iterations MAX_STACK_DEPTH
{
    // Check from top of stack to bottom
    for i in 0..MAX_STACK_DEPTH {
        let s_opt: Option(u64) = wm.stacking_order[MAX_STACK_DEPTH - 1 - i];
        match s_opt {
            Option::Some(sid) => {
                if sid == 0 { break; }
                match wm_find_window(wm, sid) {
                    Option::Some(ws) => {
                        if ws.common.visible {
                            let r: protocol.Rectangle = protocol.make_rect(
                                ws.common.position.x, ws.common.position.y,
                                ws.common.size.width, ws.common.size.height);
                            if protocol.rect_contains(r, px, py) {
                                return sid;
                            }
                        }
                    }
                    Option::None => {}
                }
            }
            Option::None => {}
        }
    }
    return 0;
}

// ──────────────────────────────────────────────
// Policy
// ──────────────────────────────────────────────

fn wm_set_policy(wm: WindowManager, click_focus: bool, raise_click: bool, focus_mouse: bool) -> WindowManager
    effect [compute, residual]
{
    residual emit {
        op: "wm:policy",
        click_to_focus: click_focus,
        raise_on_click: raise_click,
        focus_follows_mouse: focus_mouse,
    };
    return WindowManager {
        initialized: wm.initialized,
        windows: wm.windows,
        window_count: wm.window_count,
        focused_surface_id: wm.focused_surface_id,
        focus_timestamp: wm.focus_timestamp,
        focus_history: wm.focus_history,
        history_depth: wm.history_depth,
        stacking_order: wm.stacking_order,
        stack_depth: wm.stack_depth,
        next_stacking_id: wm.next_stacking_id,
        decoration_style: wm.decoration_style,
        decoration_enabled: wm.decoration_enabled,
        pending_configures: wm.pending_configures,
        configure_count: wm.configure_count,
        configure_serial: wm.configure_serial,
        allow_fullscreen: wm.allow_fullscreen,
        allow_minimize: wm.allow_minimize,
        allow_maximize: wm.allow_maximize,
        allow_resize: wm.allow_resize,
        allow_move: wm.allow_move,
        focus_follows_mouse: focus_mouse,
        click_to_focus: click_focus,
        raise_on_click: raise_click,
        default_width: wm.default_width,
        default_height: wm.default_height,
        min_width: wm.min_width,
        min_height: wm.min_height,
        max_width: wm.max_width,
        max_height: wm.max_height,
        created_count: wm.created_count,
        destroyed_count: wm.destroyed_count,
        configure_count_total: wm.configure_count_total,
        focus_change_count: wm.focus_change_count,
        stack_change_count: wm.stack_change_count,
    };
}

// ──────────────────────────────────────────────
// WM Info
// ──────────────────────────────────────────────

struct WMInfo {
    initialized: bool,
    window_count: u64,
    focused_surface_id: u64,
    stack_depth: u64,
    decoration_enabled: bool,
    pending_configures: u64,
    created_count: u64,
    destroyed_count: u64,
    focus_change_count: u64,
    click_to_focus: bool,
    focus_follows_mouse: bool,
    default_width: u32,
    default_height: u32,
}

fn wm_get_info(wm: WindowManager) -> WMInfo
    effect [compute]
{
    return WMInfo {
        initialized: wm.initialized,
        window_count: wm.window_count,
        focused_surface_id: wm.focused_surface_id,
        stack_depth: wm.stack_depth,
        decoration_enabled: wm.decoration_enabled,
        pending_configures: wm.configure_count,
        created_count: wm.created_count,
        destroyed_count: wm.destroyed_count,
        focus_change_count: wm.focus_change_count,
        click_to_focus: wm.click_to_focus,
        focus_follows_mouse: wm.focus_follows_mouse,
        default_width: wm.default_width,
        default_height: wm.default_height,
    };
}
