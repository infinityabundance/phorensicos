// ahci_full.phor — Full AHCI/SATA driver
// HBA initialization, port management, command list, FIS management,
// NCQ (native command queuing), SATA power management, port multiplier,
// ATAPI passthrough, S.M.A.R.T. data, hotplug.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/ahci_full.phor
// Court: ahci_full_driver:v2

package drivers.ahci_full;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type AhciFullError = enum {
    AhciNotInitialized          = 0x800,
    AhciHbaNotFound             = 0x801,
    AhciPortNotFound            = 0x802,
    AhciPortNotPresent          = 0x803,
    AhciPortNotEnabled          = 0x804,
    AhciCommandListFull         = 0x805,
    AhciFisError                = 0x806,
    AhciNcqError                = 0x807,
    AhciDmaError                = 0x808,
    AhciTimeout                 = 0x809,
    AhciDeviceError             = 0x80A,
    AhciCapabilityError         = 0x80B,
    AhciHotplugError            = 0x80C,
    AhciPortMultiplierError     = 0x80D,
    AhciAtapiError              = 0x80E,
    AhciSmartError              = 0x80F,
    AhciPowerStateError         = 0x810,
    AhciInvalidSlot             = 0x811,
    AhciCmdError                = 0x812,
    AhciSataLinkError           = 0x813,
    AhciNoDevice                = 0x814,
    AhciResidualStoreFull       = 0x815,
    AhciMaxPortsExceeded        = 0x816,
    AhciNcqQueueFull            = 0x817,
    AhciSataPhyError            = 0x818,
    AhciInterfaceNotSupported   = 0x819,
}

// ─────────────────────────────────────────────────────────────
// AHCI Full Capability
// ─────────────────────────────────────────────────────────────

struct AhciFullCapability {
    object_id: Identity,
    generation: u64,
    can_read: bool,
    can_write: bool,
    can_identify: bool,
    can_trim: bool,
    can_ncq: bool,
    can_atapi: bool,
    can_hotplug: bool,
    can_power_mgmt: bool,
    can_smart: bool,
    max_ports: u64,
}

// ─────────────────────────────────────────────────────────────
// AHCI Generic Host Control Register Offsets
// ─────────────────────────────────────────────────────────────

struct AhciFullHbaRegs {
    mmio_base: u64,
}

impl AhciFullHbaRegs {
    fn cap_offset() -> u64 { return 0x00; }
    fn ghc_offset() -> u64 { return 0x04; }
    fn is_offset() -> u64 { return 0x08; }
    fn pi_offset() -> u64 { return 0x0C; }
    fn vs_offset() -> u64 { return 0x10; }
    fn ccc_ctl_offset() -> u64 { return 0x14; }
    fn ccc_pts_offset() -> u64 { return 0x18; }
    fn em_loc_offset() -> u64 { return 0x1C; }
    fn em_ctl_offset() -> u64 { return 0x20; }
    fn cap2_offset() -> u64 { return 0x24; }
    fn bohc_offset() -> u64 { return 0x28; }

    fn port_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80; }
    fn port_clb_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x00; }
    fn port_clbu_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x04; }
    fn port_fb_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x08; }
    fn port_fbu_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x0C; }
    fn port_is_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x10; }
    fn port_ie_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x14; }
    fn port_cmd_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x18; }
    fn port_tfd_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x20; }
    fn port_sig_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x24; }
    fn port_ssts_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x28; }
    fn port_sctl_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x2C; }
    fn port_serr_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x30; }
    fn port_sact_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x34; }
    fn port_ci_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x38; }
    fn port_sntf_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x3C; }
    fn port_fbs_offset(port: u8) -> u64 { return 0x100 + (port as u64) * 0x80 + 0x40; }

    fn read32(self, offset: u64) -> u32
        effect [memory:mmio]
    {
        return trusted reason "AHCI MMIO register read, AHCI Spec §3.1" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            return *ptr;
        };
    }

    fn write32(self, offset: u64, value: u32) -> void
        effect [memory:mmio]
    {
        trusted reason "AHCI MMIO register write, AHCI Spec §3.1" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            *ptr = value;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// AHCI HBA Capabilities
// ─────────────────────────────────────────────────────────────

struct AhciFullHbaCap {
    np: u8,
    sxs: bool,
    ems: bool,
    cccs: bool,
    ncs: u8,
    psc: bool,
    ssc: bool,
    pmd: bool,
    fbss: bool,
    spm: bool,
    sam: bool,
    iss: u8,
    snzo: bool,
    s24a: bool,
    s32a: bool,
    s64a: bool,
    apst: bool,
    nvmp: bool,
    boh: bool,
}

fn ahci_full_parse_cap(reg: u32) -> AhciFullHbaCap
    effect [deterministic]
{
    return AhciFullHbaCap {
        np: ((reg >> 0) & 0x1F) as u8,
        sxs: ((reg >> 5) & 0x01) != 0,
        ems: ((reg >> 6) & 0x01) != 0,
        cccs: ((reg >> 7) & 0x01) != 0,
        ncs: ((reg >> 8) & 0x1F) as u8,
        psc: ((reg >> 13) & 0x01) != 0,
        ssc: ((reg >> 14) & 0x01) != 0,
        pmd: ((reg >> 15) & 0x01) != 0,
        fbss: ((reg >> 16) & 0x01) != 0,
        spm: ((reg >> 17) & 0x01) != 0,
        sam: ((reg >> 18) & 0x01) != 0,
        iss: ((reg >> 20) & 0x0F) as u8,
        snzo: ((reg >> 25) & 0x01) != 0,
        s24a: ((reg >> 26) & 0x01) != 0,
        s32a: ((reg >> 27) & 0x01) != 0,
        s64a: ((reg >> 28) & 0x01) != 0,
        apst: ((reg >> 29) & 0x01) != 0,
        nvmp: ((reg >> 30) & 0x01) != 0,
        boh: ((reg >> 31) & 0x01) != 0,
    };
}

// ─────────────────────────────────────────────────────────────
// SATA Device Signature
// ─────────────────────────────────────────────────────────────

struct AhciFullDeviceSignature {
    raw: u32,
    device_type: AhciFullDeviceType,
    interface_speed: AhciFullSpeed,
}

type AhciFullDeviceType = enum {
    NoDevice       = 0,
    Ata            = 1,
    Atapi          = 2,
    PortMultiplier = 3,
    Semb           = 4,
    UnknownDevice  = 5,
}

type AhciFullSpeed = enum {
    Gen1 = 0,
    Gen2 = 1,
    Gen3 = 2,
    UnknownSpeed = 3,
}

fn ahci_full_parse_sig(sig: u32) -> AhciFullDeviceSignature
    effect [deterministic]
{
    let dev_type: AhciFullDeviceType;
    if sig == 0x00000101 {
        dev_type = AhciFullDeviceType::PortMultiplier;
    } else if sig == 0xEB140101 {
        dev_type = AhciFullDeviceType::Atapi;
    } else if sig == 0x00000100 || sig == 0x00000120 {
        dev_type = AhciFullDeviceType::Ata;
    } else if sig == 0xC33C0101 {
        dev_type = AhciFullDeviceType::Semb;
    } else if sig == 0xFFFFFFFF || sig == 0x00000000 {
        dev_type = AhciFullDeviceType::NoDevice;
    } else {
        dev_type = AhciFullDeviceType::UnknownDevice;
    };

    return AhciFullDeviceSignature { raw: sig, device_type: dev_type, interface_speed: AhciFullSpeed::UnknownSpeed };
}

// ─────────────────────────────────────────────────────────────
// SATA Status Register Fields
// ─────────────────────────────────────────────────────────────

struct AhciFullSataStatus {
    det: u8,
    spd: u8,
    ipm: u8,
}

fn ahci_full_parse_ssts(ssts: u32) -> AhciFullSataStatus
    effect [deterministic]
{
    return AhciFullSataStatus {
        det: (ssts & 0x0F) as u8,
        spd: ((ssts >> 4) & 0x0F) as u8,
        ipm: ((ssts >> 8) & 0x0F) as u8,
    };
}

// ─────────────────────────────────────────────────────────────
// SATA Error Register
// ─────────────────────────────────────────────────────────────

struct AhciFullSataError {
    raw: u32,
    recovered: bool,
    transient: bool,
    phy_error: bool,
    protocol_error: bool,
    internal_error: bool,
    diagnostic: bool,
    handshake_error: bool,
    crc_error: bool,
}

fn ahci_full_parse_serr(serr: u32) -> AhciFullSataError
    effect [deterministic]
{
    return AhciFullSataError {
        raw: serr,
        recovered: (serr & 0x01) != 0,
        transient: (serr & 0x02) != 0,
        phy_error: ((serr >> 4) & 0x01) != 0,
        protocol_error: ((serr >> 5) & 0x01) != 0,
        internal_error: ((serr >> 6) & 0x01) != 0,
        diagnostic: (serr & 0x00010000) != 0,
        handshake_error: (serr & 0x00020000) != 0,
        crc_error: (serr & 0x00040000) != 0,
    };
}

// ─────────────────────────────────────────────────────────────
// Port State
// ─────────────────────────────────────────────────────────────

struct AhciFullPortState {
    present: bool,
    enabled: bool,
    command_issue: u32,
    active_slots: u32,
    ncq_active: u32,
    interrupt_status: u32,
    fis_received: bool,
    port_multiplier: bool,
    pm_port_count: u8,
}

// ─────────────────────────────────────────────────────────────
// Command Header (CH)
// ─────────────────────────────────────────────────────────────

struct AhciFullCmdHeader {
    opts: u16,
    prdtl: u16,
    prdbc: u32,
    ctba: u32,
    ctbau: u32,
    reserved: Array(u32, 4),
}

// ─────────────────────────────────────────────────────────────
// Command Table (CT)
// ─────────────────────────────────────────────────────────────

struct AhciFullCmdTable {
    cfis: Array(u8, 64),
    acmd: Array(u8, 16),
    reserved: Array(u8, 48),
    prdt: Array(AhciFullPrdtEntry, 8),
}

struct AhciFullPrdtEntry {
    dba: u64,
    dbc: u32,
    reserved: u32,
}

// ─────────────────────────────────────────────────────────────
// Received FIS (FIS-based Switching)
// ─────────────────────────────────────────────────────────────

struct AhciFullReceivedFis {
    dsfis: Array(u8, 28),
    psfis: Array(u8, 28),
    rfis: Array(u8, 32),
    sdbfis: Array(u8, 16),
    ufis: Array(u8, 64),
}

// ─────────────────────────────────────────────────────────────
// NCQ (Native Command Queuing) State
// ─────────────────────────────────────────────────────────────

struct AhciFullNcqState {
    enabled: bool,
    max_slots: u8,
    active_slots: Bitmap(u32),
    slot_queue: Array(u8, 32),
    slot_count: u8,
    receive_fis_enabled: bool,
    ncq_pending: u32,
}

// ─────────────────────────────────────────────────────────────
// ATAPI State
// ─────────────────────────────────────────────────────────────

struct AhciFullAtapiState {
    atapi_device: bool,
    max_lun: u8,
    cdb_size: u8,
    atapi_sense_key: u8,
    atapi_asc: u8,
    atapi_ascq: u8,
}

// ─────────────────────────────────────────────────────────────
// S.M.A.R.T. Data
// ─────────────────────────────────────────────────────────────

struct AhciFullSmartData {
    raw_data: Array(u8, 512),
    device_health: bool,
    prefail_count: u8,
    online_count: u8,
    temperature: u16,
    reallocated_sectors: u64,
    pending_sectors: u64,
    uncorrectable_sectors: u64,
    power_on_hours: u64,
    power_cycles: u64,
}

// ─────────────────────────────────────────────────────────────
// Port Multiplier State
// ─────────────────────────────────────────────────────────────

struct AhciFullPmState {
    present: bool,
    port_count: u8,
    ports: Array(AhciFullPmPortState, 15),
}

struct AhciFullPmPortState {
    present: bool,
    device_type: AhciFullDeviceType,
    signature: u32,
    ncq_enabled: bool,
}

// ─────────────────────────────────────────────────────────────
// Port (Full)
// ─────────────────────────────────────────────────────────────

struct AhciFullPort {
    port_number: u8,
    cmd_list_phys: u64,
    fis_phys: u64,
    cmd_tables: Array(u64, 32),
    cmd_headers: Array(AhciFullCmdHeader, 32),
    cmd_table_dmas: Array(u64, 32),
    rcv_fis: AhciFullReceivedFis,
    state: AhciFullPortState,
    sig: AhciFullDeviceSignature,
    sata_status: AhciFullSataStatus,
    sata_error: AhciFullSataError,
    ncq: AhciFullNcqState,
    atapi: AhciFullAtapiState,
    smart: AhciFullSmartData,
    pm: AhciFullPmState,
    initialized: bool,
    slot_inuse: Array(bool, 32),
    residual_log: RingBuf(ResidualRecord, 32),
}

// ─────────────────────────────────────────────────────────────
// HBA State
// ─────────────────────────────────────────────────────────────

struct AhciFullHba {
    hba_identity: Identity,
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    cap: AhciFullHbaCap,
    cap2: u32,
    version: u32,
    ports: Array(AhciFullPort, 32),
    port_count: u8,
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct AhciFullDriverState {
    driver_identity: Identity,
    hbas: Array(AhciFullHba, 4),
    hba_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_io_operations: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Build Command FIS (Host-to-Device)
// ─────────────────────────────────────────────────────────────

fn ahci_full_build_cmd_fis(
    cfis: Handle(Array(u8, 64)),
    is_atapi: bool,
    is_ncq: bool,
    ata_command: u8,
    lba: u64,
    block_count: u16,
    feature: u8,
    device: u8,
    tag: u8,
) -> void
    effect [deterministic]
    court "ahci_full_build_fis:v1"
{
    cfis.val[0] = 0x27;
    cfis.val[1] = 0x80;

    if is_atapi {
        cfis.val[1] = cfis.val[1] | 0x01;
    };

    cfis.val[2] = ata_command;
    cfis.val[3] = feature;

    cfis.val[4] = (lba & 0xFF) as u8;
    cfis.val[5] = ((lba >> 8) & 0xFF) as u8;
    cfis.val[6] = ((lba >> 16) & 0xFF) as u8;
    cfis.val[7] = device & 0x0F;

    cfis.val[8] = ((lba >> 24) & 0xFF) as u8;
    cfis.val[9] = ((lba >> 32) & 0xFF) as u8;
    cfis.val[10] = ((lba >> 40) & 0xFF) as u8;

    cfis.val[12] = (block_count & 0xFF) as u8;
    cfis.val[13] = ((block_count >> 8) & 0xFF) as u8;

    if is_ncq {
        cfis.val[3] = tag;
    };
}

// ─────────────────────────────────────────────────────────────
// Port Reset
// ─────────────────────────────────────────────────────────────

fn ahci_full_port_reset(
    hba: Handle(AhciFullHba),
    port_num: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_port_reset:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_cmd_offset: u64 = AhciFullHbaRegs::port_cmd_offset(port_num);
    let port_serr_offset: u64 = AhciFullHbaRegs::port_serr_offset(port_num);
    let port_ssts_offset: u64 = AhciFullHbaRegs::port_ssts_offset(port_num);

    let cmd_val: u32 = regs.read32(port_cmd_offset);
    regs.write32(port_cmd_offset, cmd_val & !0x01);

    loop bound 50 {
        let cmd: u32 = regs.read32(port_cmd_offset);
        if (cmd & 0x80000000) == 0 {
            break;
        };
    };

    regs.write32(port_serr_offset, 0xFFFFFFFF);

    let sctl_offset: u64 = AhciFullHbaRegs::port_sctl_offset(port_num);
    let sctl_val: u32 = regs.read32(sctl_offset);
    regs.write32(sctl_offset, (sctl_val & !0x0F) | 0x01);

    loop bound 100 {
        let ssts: u32 = regs.read32(port_ssts_offset);
        if (ssts & 0x0F) != 0 {
            break;
        };
    };

    regs.write32(sctl_offset, sctl_val & !0x0F);
    regs.write32(port_serr_offset, 0xFFFFFFFF);

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    let ssts_raw: u32 = regs.read32(port_ssts_offset);
    port.sata_status = ahci_full_parse_ssts(ssts_raw);

    if port.sata_status.det == 0 {
        return Result::Err(AhciFullError::AhciNoDevice);
    };

    residual emit {
        op: "ahci_full.port_reset",
        port: port_num as u64,
        sata_det: port.sata_status.det as u64,
        sata_spd: port.sata_status.spd as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Port Initialize
// ─────────────────────────────────────────────────────────────

fn ahci_full_port_init(
    hba: Handle(AhciFullHba),
    port_num: u8,
    cmd_list_phys: u64,
    fis_phys: u64,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_port_init:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_clb: u64 = AhciFullHbaRegs::port_clb_offset(port_num);
    let port_clbu: u64 = AhciFullHbaRegs::port_clbu_offset(port_num);
    let port_fb: u64 = AhciFullHbaRegs::port_fb_offset(port_num);
    let port_fbu: u64 = AhciFullHbaRegs::port_fbu_offset(port_num);
    let port_ie: u64 = AhciFullHbaRegs::port_ie_offset(port_num);
    let port_cmd: u64 = AhciFullHbaRegs::port_cmd_offset(port_num);
    let port_serr: u64 = AhciFullHbaRegs::port_serr_offset(port_num);

    regs.write32(port_clb, (cmd_list_phys & 0xFFFFFFFF) as u32);
    regs.write32(port_clbu, ((cmd_list_phys >> 32) & 0xFFFFFFFF) as u32);
    regs.write32(port_fb, (fis_phys & 0xFFFFFFFF) as u32);
    regs.write32(port_fbu, ((fis_phys >> 32) & 0xFFFFFFFF) as u32);

    regs.write32(port_serr, 0xFFFFFFFF);

    let ie: u32 = 0x0F8000FF;
    regs.write32(port_ie, ie);

    let cmd: u32 = regs.read32(port_cmd);
    regs.write32(port_cmd, cmd | 0x01);

    loop bound 50 {
        let cmd_check: u32 = regs.read32(port_cmd);
        if (cmd_check & 0x80000000) != 0 {
            break;
        };
    };

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    port.initialized = true;
    port.state.present = true;
    port.state.enabled = true;

    let sig_raw: u32 = regs.read32(AhciFullHbaRegs::port_sig_offset(port_num));
    port.sig = ahci_full_parse_sig(sig_raw);

    residual emit {
        op: "ahci_full.port_init",
        port: port_num as u64,
        sig: sig_raw as u64,
        cmd_list_phys: cmd_list_phys,
        fis_phys: fis_phys,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Start Command DMA Engine
// ─────────────────────────────────────────────────────────────

fn ahci_full_start_dma(
    hba: Handle(AhciFullHba),
    port_num: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_start_dma:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_cmd: u64 = AhciFullHbaRegs::port_cmd_offset(port_num);

    let cmd: u32 = regs.read32(port_cmd);
    regs.write32(port_cmd, cmd | 0x10);

    loop bound 50 {
        let cmd_check: u32 = regs.read32(port_cmd);
        if (cmd_check & 0x10) != 0 {
            break;
        };
    };

    let cmd_st: u32 = regs.read32(port_cmd);
    regs.write32(port_cmd, cmd_st | 0x01);

    residual emit {
        op: "ahci_full.start_dma",
        port: port_num as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Prepare Command Slot
// ─────────────────────────────────────────────────────────────

fn ahci_full_prepare_slot(
    hba: Handle(AhciFullHba),
    port_num: u8,
) -> Result(u8, AhciFullError)
    effect [deterministic]
    court "ahci_full_prepare_slot:v1"
{
    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);

    loop bound 32 {
        let mut slot: u8 = 0;
        loop bound 32 {
            if !port.slot_inuse[slot as u64] {
                port.slot_inuse[slot as u64] = true;
                return Result::Ok(slot);
            };
            slot = slot + 1;
            if slot >= 32 {
                break;
            };
        };
    };

    return Result::Err(AhciFullError::AhciCommandListFull);
}

// ─────────────────────────────────────────────────────────────
// Issue Non-Data Command
// ─────────────────────────────────────────────────────────────

fn ahci_full_issue_non_data(
    hba: Handle(AhciFullHba),
    port_num: u8,
    ata_cmd: u8,
    feature: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_issue_non_data:v1"
{
    let slot_result: Result(u8, AhciFullError) = ahci_full_prepare_slot(hba, port_num);
    match slot_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(slot) => {},
    };

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    let ch: Handle(AhciFullCmdHeader) = Handle(AhciFullCmdHeader)::from_ptr(&port.cmd_headers[0]);

    let cfis_ptr: u64 = port.cmd_table_dmas[0];
    let cfis_handle: Handle(Array(u8, 64)) = Handle(Array(u8, 64))::from_ptr(cfis_ptr as *(Array(u8, 64)));
    ahci_full_build_cmd_fis(cfis_handle, false, false, ata_cmd, 0, 0, feature, 0, slot);

    ch.opts = 0;
    ch.prdtl = 0;
    ch.prdbc = 0;
    ch.ctba = (cfis_ptr & 0xFFFFFFFF) as u32;
    ch.ctbau = ((cfis_ptr >> 32) & 0xFFFFFFFF) as u32;

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    regs.write32(AhciFullHbaRegs::port_ci_offset(port_num), 1 << slot);

    residual emit {
        op: "ahci_full.issue_non_data",
        port: port_num as u64,
        cmd: ata_cmd as u64,
        slot: slot as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Issue ATA Read/Write Command (DMA)
// ─────────────────────────────────────────────────────────────

fn ahci_full_issue_rw_dma(
    hba: Handle(AhciFullHba),
    port_num: u8,
    lba: u64,
    block_count: u16,
    data_phys: u64,
    is_write: bool,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(u8, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_issue_rw_dma:v1"
{
    if is_write && !cap.can_write {
        return Result::Err(AhciFullError::AhciCapabilityError);
    };
    if !is_write && !cap.can_read {
        return Result::Err(AhciFullError::AhciCapabilityError);
    };

    let slot_result: Result(u8, AhciFullError) = ahci_full_prepare_slot(hba, port_num);
    match slot_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(slot) => {},
    };

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    let ata_cmd: u8;
    if is_write {
        ata_cmd = 0x35;
    } else {
        ata_cmd = 0x25;
    };

    let ch: Handle(AhciFullCmdHeader) = Handle(AhciFullCmdHeader)::from_ptr(&port.cmd_headers[slot as u64]);
    let cfis_ptr: u64 = port.cmd_table_dmas[slot as u64];
    let cfis_handle: Handle(Array(u8, 64)) = Handle(Array(u8, 64))::from_ptr(cfis_ptr as *(Array(u8, 64)));
    ahci_full_build_cmd_fis(cfis_handle, false, false, ata_cmd, lba, block_count, 0, 0x40, slot);

    ch.opts = (1 << 14);
    ch.prdtl = 1;
    ch.prdbc = 0;
    ch.ctba = (cfis_ptr & 0xFFFFFFFF) as u32;
    ch.ctbau = ((cfis_ptr >> 32) & 0xFFFFFFFF) as u32;

    let ct_handle: Handle(AhciFullCmdTable) = Handle(AhciFullCmdTable)::from_ptr(cfis_ptr as *(AhciFullCmdTable));
    ct_handle.prdt[0] = AhciFullPrdtEntry {
        dba: data_phys,
        dbc: ((block_count as u32) * 512 - 1),
        reserved: 0,
    };

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    regs.write32(AhciFullHbaRegs::port_ci_offset(port_num), 1 << slot);

    let op_name: String(16);
    if is_write {
        op_name = "ahci_full.write";
    } else {
        op_name = "ahci_full.read";
    };

    residual emit {
        op: op_name,
        port: port_num as u64,
        lba: lba,
        block_count: block_count as u64,
        slot: slot as u64,
        timestamp: timestamp,
    };

    return Result::Ok(slot);
}

// ─────────────────────────────────────────────────────────────
// Issue NCQ Command
// ─────────────────────────────────────────────────────────────

fn ahci_full_issue_ncq(
    hba: Handle(AhciFullHba),
    port_num: u8,
    lba: u64,
    block_count: u16,
    data_phys: u64,
    is_write: bool,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(u8, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_issue_ncq:v1"
{
    if !cap.can_ncq {
        return Result::Err(AhciFullError::AhciCapabilityError);
    };

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    if !port.ncq.enabled {
        return Result::Err(AhciFullError::AhciNcqError);
    };

    let slot_result: Result(u8, AhciFullError) = ahci_full_prepare_slot(hba, port_num);
    match slot_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(slot) => {},
    };

    let tag: u8 = slot;
    let ata_cmd: u8;
    if is_write {
        ata_cmd = 0x61;
    } else {
        ata_cmd = 0x60;
    };

    let ch: Handle(AhciFullCmdHeader) = Handle(AhciFullCmdHeader)::from_ptr(&port.cmd_headers[tag as u64]);
    let cfis_ptr: u64 = port.cmd_table_dmas[tag as u64];
    let cfis_handle: Handle(Array(u8, 64)) = Handle(Array(u8, 64))::from_ptr(cfis_ptr as *(Array(u8, 64)));
    ahci_full_build_cmd_fis(cfis_handle, false, true, ata_cmd, lba, block_count, tag, 0x40, tag);

    ch.opts = (1 << 14) | (1 << 6);
    ch.prdtl = 1;
    ch.ctba = (cfis_ptr & 0xFFFFFFFF) as u32;
    ch.ctbau = ((cfis_ptr >> 32) & 0xFFFFFFFF) as u32;

    let ct_handle: Handle(AhciFullCmdTable) = Handle(AhciFullCmdTable)::from_ptr(cfis_ptr as *(AhciFullCmdTable));
    ct_handle.prdt[0] = AhciFullPrdtEntry {
        dba: data_phys,
        dbc: ((block_count as u32) * 512 - 1),
        reserved: 0,
    };

    port.ncq.active_slots = port.ncq.active_slots | (1 << tag);
    port.ncq.ncq_pending = port.ncq.ncq_pending + 1;

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    regs.write32(AhciFullHbaRegs::port_sact_offset(port_num), port.ncq.active_slots);
    regs.write32(AhciFullHbaRegs::port_ci_offset(port_num), 1 << tag);

    residual emit {
        op: "ahci_full.ncq",
        port: port_num as u64,
        lba: lba,
        block_count: block_count as u64,
        tag: tag as u64,
        is_write: is_write,
        timestamp: timestamp,
    };

    return Result::Ok(tag);
}

// ─────────────────────────────────────────────────────────────
// Issue ATAPI Passthrough Command
// ─────────────────────────────────────────────────────────────

fn ahci_full_issue_atapi(
    hba: Handle(AhciFullHba),
    port_num: u8,
    cdb: Array(u8, 16),
    cdb_len: u8,
    data_phys: u64,
    data_size: u32,
    is_write: bool,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(u8, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_issue_atapi:v1"
{
    if !cap.can_atapi {
        return Result::Err(AhciFullError::AhciCapabilityError);
    };

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    if !port.atapi.atapi_device {
        return Result::Err(AhciFullError::AhciAtapiError);
    };

    let slot_result: Result(u8, AhciFullError) = ahci_full_prepare_slot(hba, port_num);
    match slot_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(slot) => {},
    };

    let ch: Handle(AhciFullCmdHeader) = Handle(AhciFullCmdHeader)::from_ptr(&port.cmd_headers[slot as u64]);
    let cfis_ptr: u64 = port.cmd_table_dmas[slot as u64];
    let cfis_handle: Handle(Array(u8, 64)) = Handle(Array(u8, 64))::from_ptr(cfis_ptr as *(Array(u8, 64)));
    ahci_full_build_cmd_fis(cfis_handle, true, false, 0xA0, 0, 0, 0, 0, slot);

    let ct_handle: Handle(AhciFullCmdTable) = Handle(AhciFullCmdTable)::from_ptr(cfis_ptr as *(AhciFullCmdTable));

    loop bound 16 {
        let mut i: u64 = 0;
        if i >= (cdb_len as u64) {
            break;
        };
        ct_handle.acmd[i] = cdb[i];
        i = i + 1;
    };

    ch.opts = (1 << 14) | (1 << 7);
    if data_size > 0 {
        ch.prdtl = 1;
        let ct2: Handle(AhciFullCmdTable) = Handle(AhciFullCmdTable)::from_ptr(cfis_ptr as *(AhciFullCmdTable));
        ct2.prdt[0] = AhciFullPrdtEntry {
            dba: data_phys,
            dbc: data_size - 1,
            reserved: 0,
        };
    } else {
        ch.prdtl = 0;
    };
    ch.ctba = (cfis_ptr & 0xFFFFFFFF) as u32;
    ch.ctbau = ((cfis_ptr >> 32) & 0xFFFFFFFF) as u32;

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    regs.write32(AhciFullHbaRegs::port_ci_offset(port_num), 1 << slot);

    residual emit {
        op: "ahci_full.atapi",
        port: port_num as u64,
        cdb_first: cdb[0] as u64,
        cdb_len: cdb_len as u64,
        slot: slot as u64,
        timestamp: timestamp,
    };

    return Result::Ok(slot);
}

// ─────────────────────────────────────────────────────────────
// Poll Command Completion
// ─────────────────────────────────────────────────────────────

fn ahci_full_poll_completion(
    hba: Handle(AhciFullHba),
    port_num: u8,
    slot: u8,
    timeout_ms: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic]
    court "ahci_full_poll_completion:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let ci_offset: u64 = AhciFullHbaRegs::port_ci_offset(port_num);

    loop bound 10000 {
        let ci: u32 = regs.read32(ci_offset);
        if (ci & (1 << slot)) == 0 {
            let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
            port.slot_inuse[slot as u64] = false;
            return Result::Ok(void);
        };
    };

    return Result::Err(AhciFullError::AhciTimeout);
}

// ─────────────────────────────────────────────────────────────
// Poll NCQ Completion
// ─────────────────────────────────────────────────────────────

fn ahci_full_poll_ncq_completion(
    hba: Handle(AhciFullHba),
    port_num: u8,
    tag: u8,
    timeout_ms: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic]
    court "ahci_full_poll_ncq:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let sact_offset: u64 = AhciFullHbaRegs::port_sact_offset(port_num);

    loop bound 10000 {
        let sact: u32 = regs.read32(sact_offset);
        if (sact & (1 << tag)) == 0 {
            let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
            port.ncq.active_slots = port.ncq.active_slots & !(1 << tag);
            port.ncq.ncq_pending = port.ncq.ncq_pending - 1;
            port.slot_inuse[tag as u64] = false;
            return Result::Ok(void);
        };
    };

    return Result::Err(AhciFullError::AhciNcqQueueFull);
}

// ─────────────────────────────────────────────────────────────
// Handle Port Interrupt
// ─────────────────────────────────────────────────────────────

fn ahci_full_handle_interrupt(
    hba: Handle(AhciFullHba),
    port_num: u8,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_handle_irq:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_is_offset: u64 = AhciFullHbaRegs::port_is_offset(port_num);
    let port_serr_offset: u64 = AhciFullHbaRegs::port_serr_offset(port_num);

    let is: u32 = regs.read32(port_is_offset);
    regs.write32(port_is_offset, is);

    if (is & 0x80000000) != 0 {
        regs.write32(port_serr_offset, 0xFFFFFFFF);
        residual emit {
            op: "ahci_full.irq_error",
            port: port_num as u64,
            isr: is as u64,
            timestamp: timestamp,
        };
        return Result::Err(AhciFullError::AhciSataPhyError);
    };

    if (is & 0x40000000) != 0 {
        let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
        let ssts_raw: u32 = regs.read32(AhciFullHbaRegs::port_ssts_offset(port_num));
        port.sata_status = ahci_full_parse_ssts(ssts_raw);
        if port.sata_status.det == 3 {
            port.state.present = true;
        } else {
            port.state.present = false;
        };
        residual emit {
            op: "ahci_full.hotplug",
            port: port_num as u64,
            present: port.state.present,
            timestamp: timestamp,
        };
    };

    if (is & 0x02) != 0 {
        let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
        port.state.fis_received = true;
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Read S.M.A.R.T. Data
// ─────────────────────────────────────────────────────────────

fn ahci_full_read_smart(
    hba: Handle(AhciFullHba),
    port_num: u8,
    data_buffer: u64,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(AhciFullSmartData, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_read_smart:v1"
{
    if !cap.can_smart {
        return Result::Err(AhciFullError::AhciCapabilityError);
    };

    let slot_result: Result(u8, AhciFullError) = ahci_full_prepare_slot(hba, port_num);
    match slot_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(slot) => {},
    };

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    let ata_cmd: u8 = 0xB0;
    let feature: u8 = 0xD0;

    let ch: Handle(AhciFullCmdHeader) = Handle(AhciFullCmdHeader)::from_ptr(&port.cmd_headers[slot as u64]);
    let cfis_ptr: u64 = port.cmd_table_dmas[slot as u64];
    let cfis_handle: Handle(Array(u8, 64)) = Handle(Array(u8, 64))::from_ptr(cfis_ptr as *(Array(u8, 64)));
    ahci_full_build_cmd_fis(cfis_handle, false, false, ata_cmd, 0, 1, feature, 0x40, slot);

    ch.opts = (1 << 14) | (1 << 6);
    ch.prdtl = 1;
    ch.ctba = (cfis_ptr & 0xFFFFFFFF) as u32;
    ch.ctbau = ((cfis_ptr >> 32) & 0xFFFFFFFF) as u32;

    let ct_handle: Handle(AhciFullCmdTable) = Handle(AhciFullCmdTable)::from_ptr(cfis_ptr as *(AhciFullCmdTable));
    ct_handle.prdt[0] = AhciFullPrdtEntry {
        dba: data_buffer,
        dbc: 511,
        reserved: 0,
    };

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    regs.write32(AhciFullHbaRegs::port_ci_offset(port_num), 1 << slot);

    let smart_data: AhciFullSmartData = AhciFullSmartData {
        raw_data: Array::zeroed(),
        device_health: true,
        prefail_count: 0,
        online_count: 0,
        temperature: 0,
        reallocated_sectors: 0,
        pending_sectors: 0,
        uncorrectable_sectors: 0,
        power_on_hours: 0,
        power_cycles: 0,
    };

    residual emit {
        op: "ahci_full.read_smart",
        port: port_num as u64,
        slot: slot as u64,
        timestamp: timestamp,
    };

    return Result::Ok(smart_data);
}

// ─────────────────────────────────────────────────────────────
// Enable Port Multiplier
// ─────────────────────────────────────────────────────────────

fn ahci_full_enable_pm(
    hba: Handle(AhciFullHba),
    port_num: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_enable_pm:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_cmd_offset: u64 = AhciFullHbaRegs::port_cmd_offset(port_num);

    if !hba.cap.pmd {
        return Result::Err(AhciFullError::AhciPortMultiplierError);
    };

    let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
    let cmd_val: u32 = regs.read32(port_cmd_offset);
    regs.write32(port_cmd_offset, cmd_val | (1 << 19));

    port.state.port_multiplier = true;

    residual emit {
        op: "ahci_full.enable_pm",
        port: port_num as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set SATA Power Management
// ─────────────────────────────────────────────────────────────

fn ahci_full_set_power_state(
    hba: Handle(AhciFullHba),
    port_num: u8,
    ipm_state: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_set_power:v1"
{
    if !cap.can_power_mgmt {
        return Result::Err(AhciFullError::AhciCapabilityError);
    };

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_sctl_offset: u64 = AhciFullHbaRegs::port_sctl_offset(port_num);

    let sctl: u32 = regs.read32(port_sctl_offset);
    let new_sctl: u32 = (sctl & !0x0F0) | ((ipm_state as u32) << 8);
    regs.write32(port_sctl_offset, new_sctl);

    residual emit {
        op: "ahci_full.set_power_state",
        port: port_num as u64,
        ipm: ipm_state as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enable FIS-based Switching (for PM)
// ─────────────────────────────────────────────────────────────

fn ahci_full_enable_fbs(
    hba: Handle(AhciFullHba),
    port_num: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_enable_fbs:v1"
{
    if !hba.cap.fbss {
        return Result::Err(AhciFullError::AhciPortMultiplierError);
    };

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_fbs_offset: u64 = AhciFullHbaRegs::port_fbs_offset(port_num);

    let fbs: u32 = regs.read32(port_fbs_offset);
    regs.write32(port_fbs_offset, fbs | 0x01);

    residual emit {
        op: "ahci_full.enable_fbs",
        port: port_num as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// HBA Initialization
// ─────────────────────────────────────────────────────────────

fn ahci_full_hba_init(
    hba: Handle(AhciFullHba),
    mmio_base: u64,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_hba_init:v1"
{
    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: mmio_base };

    let cap_raw: u32 = regs.read32(AhciFullHbaRegs::cap_offset());
    hba.cap = ahci_full_parse_cap(cap_raw);

    hba.cap2 = regs.read32(AhciFullHbaRegs::cap2_offset());
    hba.version = regs.read32(AhciFullHbaRegs::vs_offset());

    let pi: u32 = regs.read32(AhciFullHbaRegs::pi_offset());

    let ghc: u32 = regs.read32(AhciFullHbaRegs::ghc_offset());
    regs.write32(AhciFullHbaRegs::ghc_offset(), ghc | (1 << 31));

    loop bound 10 {
        let ghc_check: u32 = regs.read32(AhciFullHbaRegs::ghc_offset());
        if (ghc_check & (1 << 31)) != 0 {
            break;
        };
    };

    regs.write32(AhciFullHbaRegs::ghc_offset(), (1 << 31) | (1 << 0));

    let mut ports_found: u8 = 0;
    loop bound 32 {
        let port_num: u8 = ports_found;
        if port_num >= 32 {
            break;
        };
        if (pi & (1 << port_num)) == 0 {
            ports_found = ports_found + 1;
            continue;
        };
        let port: Handle(AhciFullPort) = Handle(AhciFullPort)::from_ptr(&hba.ports[port_num as u64]);
        port.port_number = port_num;
        port.initialized = false;
        port.state.present = true;
        ports_found = ports_found + 1;
    };

    hba.port_count = ports_found;
    hba.initialized = true;

    residual emit {
        op: "ahci_full.hba_init",
        mmio_base: mmio_base,
        port_count: ports_found as u64,
        version: hba.version as u64,
        np: hba.cap.np as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn ahci_full_driver_init(
    driver_identity: Identity,
    cap: AhciFullCapability,
    timestamp: u64,
) -> AhciFullDriverState
    effect [deterministic, residual]
    court "ahci_full_driver_init:v1"
{
    let state: AhciFullDriverState = AhciFullDriverState {
        driver_identity: driver_identity,
        hbas: Array::zeroed(),
        hba_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_io_operations: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "ahci_full.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add HBA from PCI Discovery
// ─────────────────────────────────────────────────────────────

fn ahci_full_add_hba(
    state: Handle(AhciFullDriverState),
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(u64, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_add_hba:v1"
{
    if state.hba_count >= 4 {
        return Result::Err(AhciFullError::AhciMaxPortsExceeded);
    };

    let idx: u64 = state.hba_count;
    let hba_identity: Identity = identity_new(0x414843, timestamp, idx, pci_bus as u64);

    let hba: AhciFullHba = AhciFullHba {
        hba_identity: hba_identity,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        irq_vector: irq_vector,
        cap: AhciFullHbaCap { np: 0, sxs: false, ems: false, cccs: false, ncs: 0, psc: false, ssc: false, pmd: false, fbss: false, spm: false, sam: false, iss: 0, snzo: false, s24a: false, s32a: false, s64a: false, apst: false, nvmp: false, boh: false },
        cap2: 0,
        version: 0,
        ports: Array::zeroed(),
        port_count: 0,
        initialized: false,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.hbas[idx] = hba;

    let hba_handle: Handle(AhciFullHba) = Handle(AhciFullHba)::from_ptr(&state.hbas[idx]);
    let init_result: Result(void, AhciFullError) = ahci_full_hba_init(hba_handle, mmio_base, cap, timestamp);
    match init_result {
        Result::Err(e) => {
            state.hbas[idx].initialized = false;
            return Result::Err(e);
        },
        Result::Ok(_) => {},
    };

    state.hba_count = state.hba_count + 1;

    residual emit {
        op: "ahci_full.add_hba",
        hba_idx: idx,
        mmio_base: mmio_base,
        pci_bus: pci_bus as u64,
        pci_device: pci_device as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// Enable Hotplug on Port
// ─────────────────────────────────────────────────────────────

fn ahci_full_enable_hotplug(
    hba: Handle(AhciFullHba),
    port_num: u8,
    cap: AhciFullCapability,
    timestamp: u64,
) -> Result(void, AhciFullError)
    effect [memory:mmio, deterministic, residual]
    court "ahci_full_enable_hotplug:v1"
{
    if !cap.can_hotplug {
        return Result::Err(AhciFullError::AhciCapabilityError);
    };

    let regs: AhciFullHbaRegs = AhciFullHbaRegs { mmio_base: hba.mmio_base };
    let port_ie_offset: u64 = AhciFullHbaRegs::port_ie_offset(port_num);

    let ie: u32 = regs.read32(port_ie_offset);
    regs.write32(port_ie_offset, ie | (0x0F << 26));

    let pi: u32 = regs.read32(AhciFullHbaRegs::pi_offset());
    regs.write32(AhciFullHbaRegs::is_offset(), 1 << port_num);

    residual emit {
        op: "ahci_full.enable_hotplug",
        port: port_num as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}
