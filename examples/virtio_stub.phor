// virtio_stub.phor — VirtIO Transport Stub
//
// Demonstrates:
//   - VirtIO PCI device discovery model
//   - Queue management with fixed-capacity arrays
//   - Capability-gated MMIO access
//   - Device feature negotiation
//   - Bounded descriptor chains
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:virtio_stub:v1.0";

// ── VirtIO Constants ────────────────────────────────────

const VIRTIO_PCI_VENDOR: u16 = 0x1AF4;
const VIRTIO_PCI_DEVICE_BASE: u16 = 0x1000;

const VIRTIO_PCI_CAP_COMMON_CFG: u8 = 1;
const VIRTIO_PCI_CAP_NOTIFY_CFG: u8 = 2;
const VIRTIO_PCI_CAP_DEVICE_CFG: u8 = 4;

const MAX_QUEUES: u64 = 8;
const MAX_DESC_PER_CHAIN: u64 = 16;
const MAX_QUEUE_SIZE: u64 = 256;

// ── Common Configuration Structure ─────────────────────

struct VirtioCommonCfg {
    device_feature_select: u32,
    device_feature: u32,
    driver_feature_select: u32,
    driver_feature: u32,
    config_msix_vector: u16,
    num_queues: u16,
    device_status: u8,
    config_generation: u8,
    queue_select: u16,
    queue_size: u16,
    queue_msix_vector: u16,
    queue_enable: u16,
    queue_notify_off: u16,
    queue_desc: u64,
    queue_driver: u64,
    queue_device: u64,
    queue_notify_data: u16,
}

// ── Descriptor ──────────────────────────────────────────

struct VirtioDesc {
    addr: u64,
    len: u32,
    flags: u16,
    next: u16,
}

// ── VirtioDevice ────────────────────────────────────────

struct VirtioDevice {
    pci_vendor: u16,
    pci_device: u16,
    mmio_base: u64,
    mmio_size: u64,
    common_offset: u64,
    notify_offset: u64,
    device_offset: u64,
    initialized: bool,
    queues: Array(u16, 8),
    queue_count: u64,
    device_features: u32,
    driver_features: u32,
}

impl VirtioDevice {
    fn new(pci_vendor: u16, pci_device: u16, mmio_base: u64) -> VirtioDevice
        effect [compute]
    {
        return VirtioDevice {
            pci_vendor: pci_vendor,
            pci_device: pci_device,
            mmio_base: mmio_base,
            mmio_size: 0,
            common_offset: 0,
            notify_offset: 0,
            device_offset: 0,
            initialized: false,
            queues: Array::zeroed(),
            queue_count: 0,
            device_features: 0,
            driver_features: 0,
        };
    }

    fn probe(pci_vendor: u16, pci_device: u16) -> bool
        effect [compute]
    {
        return pci_vendor == 0x1AF4 && pci_device >= 0x1000 && pci_device <= 0x107F;
    }

    fn init(mut self, features: u32) -> VirtioDevice
        effect [compute, residual]
    {
        self.initialized = true;
        self.driver_features = features;

        residual emit {
            op: "virtio.device_init",
            vendor: self.pci_vendor,
            device: self.pci_device,
            features: features,
        };

        return self;
    }

    fn add_queue(mut self, queue_size: u16) -> VirtioDevice
        effect [compute]
    {
        if self.queue_count < MAX_QUEUES {
            self.queues[self.queue_count] = queue_size;
            self.queue_count = self.queue_count + 1;
        }
        return self;
    }

    fn is_initialized(self) -> bool
        effect [compute]
    {
        return self.initialized;
    }

    fn queue_count(self) -> u64
        effect [compute]
    {
        return self.queue_count;
    }
}

// ── Descriptor Chain ────────────────────────────────────

struct DescChain {
    descriptors: Array(VirtioDesc, 16),
    count: u64,
    total_len: u64,
}

impl DescChain {
    fn new() -> DescChain
        effect [compute]
    {
        return DescChain {
            descriptors: Array::zeroed(),
            count: 0,
            total_len: 0,
        };
    }

    fn add_desc(mut self, addr: u64, len: u32, flags: u16, next: u16) -> DescChain
        effect [compute]
    {
        if self.count < MAX_DESC_PER_CHAIN {
            self.descriptors[self.count] = VirtioDesc {
                addr: addr,
                len: len,
                flags: flags,
                next: next,
            };
            self.count = self.count + 1;
            self.total_len = self.total_len + (len as u64);
        }
        return self;
    }

    fn total_length(self) -> u64
        effect [compute]
    {
        return self.total_len;
    }

    fn desc_count(self) -> u64
        effect [compute]
    {
        return self.count;
    }
}

// ── Feature Negotiation ────────────────────────────────

fn negotiate_features(device_features: u32, driver_features: u32) -> u32
    effect [compute]
{
    return device_features & driver_features;
}

fn has_feature(features: u32, bit: u32) -> bool
    effect [compute]
{
    return (features & (1 << bit)) != 0;
}

// ── Test Function ──────────────────────────────────────

fn test_virtio_stub() -> bool
    effect [compute, residual]
{
    // Test device probing
    let valid: bool = VirtioDevice::probe(0x1AF4, 0x1000);
    assert(valid, "virtio: valid PCI vendor/device");
    let invalid: bool = VirtioDevice::probe(0x8086, 0x1234);
    assert(!invalid, "virtio: non-VirtIO device rejected");

    // Create and initialize device
    let mut dev: VirtioDevice = VirtioDevice::new(0x1AF4, 0x1045, 0xF0000000);
    assert(!dev.is_initialized(), "virtio: device starts uninitialized");

    dev = dev.init(0x7FFFFFFF);  // negotiate all features
    assert(dev.is_initialized(), "virtio: device initialized");

    // Add queues
    dev = dev.add_queue(256);
    dev = dev.add_queue(256);
    dev = dev.add_queue(128);
    assert(dev.queue_count() == 3, "virtio: 3 queues added");

    // Test descriptor chain
    let mut chain: DescChain = DescChain::new();
    chain = chain.add_desc(0x1000, 4096, 0x01, 1);  // readable 4KB buffer
    chain = chain.add_desc(0x5000, 64, 0x02, 2);     // writable 64B status
    chain = chain.add_desc(0x6000, 1024, 0x00, 0);   // next=0 means end
    assert(chain.desc_count() == 3, "virtio: 3 descriptors in chain");
    assert(chain.total_length() == 5184, "virtio: total chain length");

    // Test feature negotiation
    let negotiated: u32 = negotiate_features(0x7FFFFFFF, 0x00000001);
    assert(negotiated == 0x00000001, "virtio: negotiated features");

    let has: bool = has_feature(negotiated, 0);
    assert(has, "virtio: feature bit 0 is set");
    let not_has: bool = has_feature(negotiated, 1);
    assert(!not_has, "virtio: feature bit 1 is clear");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute, residual]
{
    let passed: bool = test_virtio_stub();
    assert(passed, "virtio stub: all tests pass");

    console.write(Str::from("VirtIO Transport Stub:"));
    console.write(Str::from("  - PCI device probing: PASS"));
    console.write(Str::from("  - Device initialization: PASS"));
    console.write(Str::from("  - Queue management: PASS"));
    console.write(Str::from("  - Descriptor chains: PASS"));
    console.write(Str::from("  - Feature negotiation: PASS"));
    console.write(Str::from("VirtIO stub driver validated!"));
}
