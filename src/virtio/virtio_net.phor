// file: virtio_net.phor
// purpose: Virtio network device with packet send/receive, multi-queue,
//          offload features, MAC address, link state, and statistics.
// evidence: VNET-ARCH-001 through VNET-ARCH-200
// residual: All operations bounded loops and effect-declared.

package "phorensic:virtio:virtio_net:v1.0";

use core::constants::*
use core::types::*
use core::math::*
use core::errors::*
use core::collections::*

use virtio::virtio_transport::*

// ──────────────────────────────────────────────
// Constants: Virtio Net Feature Bits
// ──────────────────────────────────────────────
// Evidence path: VNET-CONST-001 through VNET-CONST-025

const VIRTIO_NET_F_CSUM         : u64 = 1 << 0
const VIRTIO_NET_F_GUEST_CSUM   : u64 = 1 << 1
const VIRTIO_NET_F_MAC          : u64 = 1 << 5
const VIRTIO_NET_F_GUEST_TSO4   : u64 = 1 << 7
const VIRTIO_NET_F_GUEST_TSO6   : u64 = 1 << 8
const VIRTIO_NET_F_GUEST_ECN    : u64 = 1 << 9
const VIRTIO_NET_F_GUEST_UFO    : u64 = 1 << 10
const VIRTIO_NET_F_HOST_TSO4    : u64 = 1 << 11
const VIRTIO_NET_F_HOST_TSO6    : u64 = 1 << 12
const VIRTIO_NET_F_HOST_ECN     : u64 = 1 << 13
const VIRTIO_NET_F_HOST_UFO     : u64 = 1 << 14
const VIRTIO_NET_F_MRG_RXBUF    : u64 = 1 << 15
const VIRTIO_NET_F_STATUS       : u64 = 1 << 16
const VIRTIO_NET_F_CTRL_VQ      : u64 = 1 << 17
const VIRTIO_NET_F_CTRL_RX      : u64 = 1 << 18
const VIRTIO_NET_F_CTRL_VLAN    : u64 = 1 << 19
const VIRTIO_NET_F_CTRL_RX_EXTRA: u64 = 1 << 20
const VIRTIO_NET_F_GUEST_ANNOUNCE: u64 = 1 << 21
const VIRTIO_NET_F_MQ           : u64 = 1 << 22
const VIRTIO_NET_F_CTRL_MAC_ADDR: u64 = 1 << 23
const VIRTIO_NET_F_RSS          : u64 = 1 << 52
const VIRTIO_NET_F_HASH_REPORT  : u64 = 1 << 53

const VIRTIO_NET_MAX_PACKET_SIZE : u32 = 65536
const VIRTIO_NET_HEADER_SIZE     : u32 = 12
const VIRTIO_NET_DEFAULT_MTU     : u16 = 1500
const VIRTIO_NET_MAX_QUEUES      : u32 = 16
const VIRTIO_NET_MAC_LENGTH      : u32 = 6
const VIRTIO_NET_STATS_COUNT     : u32 = 16

// ──────────────────────────────────────────────
// Net Device Header
// ──────────────────────────────────────────────
// Evidence path: VNET-HEADER-001 through VNET-HEADER-020

pub type VirtioNetHeader : struct {
    flags: u8,
    gso_type: u8,
    hdr_len: u16,
    gso_size: u16,
    csum_start: u16,
    csum_offset: u16,
    num_buffers: u16,
}

impl VirtioNetHeader {
    pub fn new() -> VirtioNetHeader
        effects: [deterministic]
    {
        VirtioNetHeader {
            flags: 0, gso_type: 0, hdr_len: 0,
            gso_size: 0, csum_start: 0, csum_offset: 0,
            num_buffers: 1,
        }
    }

    pub fn needs_csum(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x01) != 0
    }

    pub fn to_bytes(self) -> Byte[12]
        effects: [deterministic]
    {
        let mut bytes: Byte[12] = [Byte::from_u8(0); 12]
        bytes[0] = Byte::from_u8(self.flags)
        bytes[1] = Byte::from_u8(self.gso_type)

        let _ = self.hdr_len
        let _ = self.gso_size
        let _ = self.csum_start
        let _ = self.csum_offset
        let _ = self.num_buffers
        bytes
    }
}

// ──────────────────────────────────────────────
// Net Device Config
// ──────────────────────────────────────────────
// Evidence path: VNET-CONFIG-001 through VNET-CONFIG-025

pub type VirtioNetConfig : struct {
    mac: Byte[6],
    status: u16,
    max_virtq_pairs: u16,
    mtu: u16,
}

impl VirtioNetConfig {
    pub fn new() -> VirtioNetConfig
        effects: [deterministic]
    {
        VirtioNetConfig {
            mac: [Byte::from_u8(0); 6],
            status: 0,
            max_virtq_pairs: 1,
            mtu: VIRTIO_NET_DEFAULT_MTU,
        }
    }

    pub fn is_link_up(self) -> bool
        effects: [deterministic]
    {
        (self.status & 0x01) != 0
    }

    pub fn has_announce(self) -> bool
        effects: [deterministic]
    {
        (self.status & 0x02) != 0
    }

    pub fn set_mac(self: ref mut, mac: ref Byte[6])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 6
        loop: bounds[BOUND_SMALL] for i in 0..6 {
            self.mac[i as usize] = mac[i as usize]
        }
    }

    pub fn mac_address_string(self) -> FixedString[18]
        effects: [deterministic]
    {
        let hex: Byte[16] = [
            0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
            0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66
        ]
        let mut s: FixedString[18] = FixedString::new()
        // loop: bounds[BOUND_SMALL] — bounded by 6
        loop: bounds[BOUND_SMALL] for i in 0..6 {
            let b: u8 = self.mac[i as usize].to_u8()
            let hi: u8 = (b >> 4) & 0x0F
            let lo: u8 = b & 0x0F
            let _ = s.push_char(hex[hi as usize].to_u8() as u32)
            let _ = s.push_char(hex[lo as usize].to_u8() as u32)
            if i < 5 {
                let _ = s.push_char(0x3A)  // ':'
            }
        }
        s
    }
}

// ──────────────────────────────────────────────
// Network Device Statistics
// ──────────────────────────────────────────────
// Evidence path: VNET-STATS-001 through VNET-STATS-020

pub type VirtioNetStats : struct {
    rx_packets: u64,
    tx_packets: u64,
    rx_bytes: u64,
    tx_bytes: u64,
    rx_errors: u64,
    tx_errors: u64,
    rx_dropped: u64,
    tx_dropped: u64,
    rx_overruns: u64,
    tx_underruns: u64,
    rx_multicast: u64,
    rx_broadcast: u64,
    tx_carrier_errors: u64,
    rx_crc_errors: u64,
    collisions: u64,
    rx_pause: u64,
}

impl VirtioNetStats {
    pub fn new() -> VirtioNetStats
        effects: [deterministic]
    {
        VirtioNetStats {
            rx_packets: 0, tx_packets: 0,
            rx_bytes: 0, tx_bytes: 0,
            rx_errors: 0, tx_errors: 0,
            rx_dropped: 0, tx_dropped: 0,
            rx_overruns: 0, tx_underruns: 0,
            rx_multicast: 0, rx_broadcast: 0,
            tx_carrier_errors: 0, rx_crc_errors: 0,
            collisions: 0, rx_pause: 0,
        }
    }

    pub fn record_rx(self: ref mut, len: u32)
        effects: [deterministic]
    {
        self.rx_packets = self.rx_packets + 1
        self.rx_bytes = self.rx_bytes + (len as u64)
    }

    pub fn record_tx(self: ref mut, len: u32)
        effects: [deterministic]
    {
        self.tx_packets = self.tx_packets + 1
        self.tx_bytes = self.tx_bytes + (len as u64)
    }

    pub fn record_error(self: ref mut, rx_error: bool)
        effects: [deterministic]
    {
        if rx_error {
            self.rx_errors = self.rx_errors + 1
        } else {
            self.tx_errors = self.tx_errors + 1
        }
    }
}

// ──────────────────────────────────────────────
// Network Device
// ──────────────────────────────────────────────
// Evidence path: VNET-DEVICE-001 through VNET-DEVICE-060

pub type VirtioNetDevice : struct {
    transport: VirtioMMIOTransport,
    config: VirtioNetConfig,
    features: u64,
    receive_queues: FixedArray[16, Virtqueue],
    transmit_queues: FixedArray[16, Virtqueue],
    control_queue: Virtqueue,
    rx_queue_count: u32,
    tx_queue_count: u32,
    stats: VirtioNetStats,
    link_state: bool,
    mtu: u16,
    has_ctrl_vq: bool,
    has_mq: bool,
    promiscuous: bool,
    allmulti: bool,
}

impl VirtioNetDevice {
    pub fn new(transport: VirtioMMIOTransport) -> VirtioNetDevice
        effects: [deterministic]
    {
        VirtioNetDevice {
            transport: transport,
            config: VirtioNetConfig::new(),
            features: 0,
            receive_queues: FixedArray::new(),
            transmit_queues: FixedArray::new(),
            control_queue: Virtqueue::new(0, 64),
            rx_queue_count: 0,
            tx_queue_count: 0,
            stats: VirtioNetStats::new(),
            link_state: false,
            mtu: VIRTIO_NET_DEFAULT_MTU,
            has_ctrl_vq: false,
            has_mq: false,
            promiscuous: false,
            allmulti: false,
        }
    }

    // Initialize the network device.
    pub fn initialize(self: ref mut) -> Result<(), VirtioError>
        effects: [io:read, io:write]
    {
        self.transport.initialize()?

        // Read MAC from config space
        // loop: bounds[BOUND_SMALL] — bounded by 6
        loop: bounds[BOUND_SMALL] for i in 0..6 {
            self.config.mac[i as usize] = Byte::from_u8(
                (self.transport.read_config32(i as u64) & 0xFF) as u8)
        }

        // Read status
        self.config.status = self.transport.read_config32(10) as u16
        self.link_state = self.config.is_link_up()

        // Read MTU
        self.config.mtu = self.transport.read_config32(12) as u16
        self.mtu = self.config.mtu

        // Setup default single queue
        let rx_vq: Virtqueue = Virtqueue::new(0, 256)
        let tx_vq: Virtqueue = Virtqueue::new(1, 256)
        let _ = self.receive_queues.push(rx_vq)
        let _ = self.transmit_queues.push(tx_vq)
        self.rx_queue_count = 1
        self.tx_queue_count = 1

        Result::Ok(())
    }

    // Send a packet.
    pub fn send_packet(self: ref mut, data_addr: u64, length: u32) -> Result<u32, VirtioError>
        effects: [io:write]
    {
        if length > VIRTIO_NET_MAX_PACKET_SIZE {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x200),
                FixedString[128]::from_slice("net: packet too large")))
        }

        if !self.link_state {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x201),
                FixedString[128]::from_slice("net: link is down")))
        }

        if self.tx_queue_count == 0 {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x202),
                FixedString[128]::from_slice("net: no transmit queues")))
        }

        let tx_q: ref mut Virtqueue = &mut self.transmit_queues[0]

        // Header descriptor (read-only) + data descriptor (read-only)
        let header_addr: u64 = data_addr - VIRTIO_NET_HEADER_SIZE as u64
        let addrs: u64[2] = [header_addr, data_addr]
        let lengths: u32[2] = [VIRTIO_NET_HEADER_SIZE, length]
        let write_flags: bool[2] = [false, false]

        if !tx_q.submit_sg(&addrs, &lengths, &write_flags, 2) {
            self.stats.tx_dropped = self.stats.tx_dropped + 1
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x203),
                FixedString[128]::from_slice("net: tx queue full")))
        }

        self.transport.notify_queue(1)  // TX queue
        self.stats.record_tx(length)

        Result::Ok(length)
    }

    // Receive a packet (returns buffer address).
    pub fn receive_packet(self: ref mut) -> Option[u64]
        effects: [io:read]
    {
        if self.rx_queue_count == 0 {
            return Option::None
        }

        let rx_q: ref mut Virtqueue = &mut self.receive_queues[0]
        match rx_q.get_used() {
            Option::Some(elem) => {
                self.stats.record_rx(elem.len)
                Option::Some(elem.id as u64)
            },
            Option::None => Option::None,
        }
    }

    // Allocate a receive buffer.
    pub fn add_rx_buffer(self: ref mut, addr: u64, len: u32) -> bool
        effects: [io:write]
    {
        if self.rx_queue_count == 0 {
            return false
        }

        let rx_q: ref mut Virtqueue = &mut self.receive_queues[0]
        let header_addr: u64 = addr
        let data_addr: u64 = addr + VIRTIO_NET_HEADER_SIZE as u64
        let data_len: u32 = len - VIRTIO_NET_HEADER_SIZE

        // 2 descriptors: header (write), data (write)
        let addrs: u64[2] = [header_addr, data_addr]
        let lengths: u32[2] = [VIRTIO_NET_HEADER_SIZE, data_len]
        let write_flags: bool[2] = [true, true]

        if !rx_q.submit_sg(&addrs, &lengths, &write_flags, 2) {
            return false
        }

        self.transport.notify_queue(0)  // RX queue
        true
    }

    // Set promiscuous mode.
    pub fn set_promiscuous(self: ref mut, enabled: bool)
        effects: [deterministic]
    {
        self.promiscuous = enabled
    }

    // Set all-multicast mode.
    pub fn set_allmulti(self: ref mut, enabled: bool)
        effects: [deterministic]
    {
        self.allmulti = enabled
    }

    // Get link state.
    pub fn is_link_up(self) -> bool
        effects: [deterministic]
    {
        self.link_state
    }

    // Get MAC address.
    pub fn mac_address(self) -> ref Byte[6]
        effects: [deterministic]
    {
        &self.config.mac
    }

    pub fn mac_address_str(self) -> FixedString[18]
        effects: [deterministic]
    {
        self.config.mac_address_string()
    }

    // Get MTU.
    pub fn mtu(self) -> u16
        effects: [deterministic]
    {
        self.mtu
    }

    // Get statistics snapshot.
    pub fn stats(self) -> VirtioNetStats
        effects: [deterministic]
    {
        self.stats
    }

    // Add a multi-queue pair.
    pub fn add_queue_pair(self: ref mut, rx_vq: Virtqueue, tx_vq: Virtqueue) -> Result<(), VirtioError>
        effects: [deterministic]
    {
        if self.rx_queue_count >= VIRTIO_NET_MAX_QUEUES {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x210),
                FixedString[128]::from_slice("net: max queue pairs reached")))
        }
        let _ = self.receive_queues.push(rx_vq)
        let _ = self.transmit_queues.push(tx_vq)
        self.rx_queue_count = self.rx_queue_count + 1
        self.tx_queue_count = self.tx_queue_count + 1
        Result::Ok(())
    }

    // Get the number of receive queues.
    pub fn rx_queue_count(self) -> u32
        effects: [deterministic]
    {
        self.rx_queue_count
    }

    // Get the number of transmit queues.
    pub fn tx_queue_count(self) -> u32
        effects: [deterministic]
    {
        self.tx_queue_count
    }

    // Get a receive queue by index.
    pub fn get_rx_queue(self: ref mut, index: u32) -> Result<ref mut Virtqueue, VirtioError>
        effects: [deterministic]
    {
        if index >= self.rx_queue_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x211),
                FixedString[128]::from_slice("net: rx queue index out of range")))
        }
        Result::Ok(&mut self.receive_queues[index as usize])
    }

    // Get a transmit queue by index.
    pub fn get_tx_queue(self: ref mut, index: u32) -> Result<ref mut Virtqueue, VirtioError>
        effects: [deterministic]
    {
        if index >= self.tx_queue_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x212),
                FixedString[128]::from_slice("net: tx queue index out of range")))
        }
        Result::Ok(&mut self.transmit_queues[index as usize])
    }
}

// ──────────────────────────────────────────────
// Network Filtering and Offload
// ──────────────────────────────────────────────
// Evidence path: VNET-FILTER-001 through VNET-FILTER-025

pub type NetFilter : struct {
    mac_filter: FixedArray[8, Byte[6]],
    filter_count: u32,
    promiscuous: bool,
    allmulti: bool,
    vlan_filter: FixedArray[16, u16],
    vlan_count: u32,
}

impl NetFilter {
    pub fn new() -> NetFilter
        effects: [deterministic]
    {
        NetFilter {
            mac_filter: FixedArray::new(),
            filter_count: 0,
            promiscuous: false,
            allmulti: false,
            vlan_filter: FixedArray::new(),
            vlan_count: 0,
        }
    }

    pub fn add_mac(self: ref mut, mac: ref Byte[6]) -> bool
        effects: [deterministic]
    {
        if self.filter_count >= 8 {
            return false
        }
        let mut mac_copy: Byte[6] = [Byte::from_u8(0); 6]
        // loop: bounds[BOUND_SMALL] — bounded by 6
        loop: bounds[BOUND_SMALL] for i in 0..6 {
            mac_copy[i as usize] = mac[i as usize]
        }
        let _ = self.mac_filter.push(mac_copy)
        self.filter_count = self.filter_count + 1
        true
    }

    pub fn add_vlan(self: ref mut, vlan_id: u16) -> bool
        effects: [deterministic]
    {
        if self.vlan_count >= 16 {
            return false
        }
        let _ = self.vlan_filter.push(vlan_id)
        self.vlan_count = self.vlan_count + 1
        true
    }

    pub fn should_accept(self, dest_mac: ref Byte[6]) -> bool
        effects: [deterministic]
    {
        if self.promiscuous {
            return true
        }
        // loop: bounds[BOUND_SMALL] — bounded by 8 filters
        loop: bounds[BOUND_SMALL] for i in 0..self.filter_count {
            let mut match_mac: bool = true
            // loop: bounds[BOUND_SMALL] — bounded by 6
            loop: bounds[BOUND_SMALL] for j in 0..6 {
                if self.mac_filter[i as usize][j as usize].to_u8() != dest_mac[j as usize].to_u8() {
                    match_mac = false
                }
            }
            if match_mac {
                return true
            }
        }
        self.allmulti
    }

    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.mac_filter.clear()
        self.filter_count = 0
        self.vlan_filter.clear()
        self.vlan_count = 0
    }
}

// ──────────────────────────────────────────────
// Network Offload Capabilities
// ──────────────────────────────────────────────
// Evidence path: VNET-OFFLOAD-001 through VNET-OFFLOAD-020

pub type NetOffloadCapabilities : struct {
    tx_csum: bool,
    rx_csum: bool,
    tso4: bool,
    tso6: bool,
    ecn: bool,
    ufo: bool,
    mrg_rxbuf: bool,
    has_hash_report: bool,
}

impl NetOffloadCapabilities {
    pub fn new() -> NetOffloadCapabilities
        effects: [deterministic]
    {
        NetOffloadCapabilities {
            tx_csum: false, rx_csum: false,
            tso4: false, tso6: false,
            ecn: false, ufo: false,
            mrg_rxbuf: false, has_hash_report: false,
        }
    }

    pub fn from_features(features: u64) -> NetOffloadCapabilities
        effects: [deterministic]
    {
        NetOffloadCapabilities {
            tx_csum: (features & VIRTIO_NET_F_CSUM) != 0,
            rx_csum: (features & VIRTIO_NET_F_GUEST_CSUM) != 0,
            tso4: (features & VIRTIO_NET_F_HOST_TSO4) != 0,
            tso6: (features & VIRTIO_NET_F_HOST_TSO6) != 0,
            ecn: (features & VIRTIO_NET_F_HOST_ECN) != 0,
            ufo: (features & VIRTIO_NET_F_HOST_UFO) != 0,
            mrg_rxbuf: (features & VIRTIO_NET_F_MRG_RXBUF) != 0,
            has_hash_report: (features & VIRTIO_NET_F_HASH_REPORT) != 0,
        }
    }

    pub fn can_offload_tx_csum(self) -> bool
        effects: [deterministic]
    {
        self.tx_csum
    }

    pub fn can_offload_rx_csum(self) -> bool
        effects: [deterministic]
    {
        self.rx_csum
    }

    pub fn supports_tso(self) -> bool
        effects: [deterministic]
    {
        self.tso4 || self.tso6
    }
}

// ──────────────────────────────────────────────
// Test Vectors
// ──────────────────────────────────────────────

pub fn run_virtio_net_tests() -> bool
    effects: [deterministic, residual]
{
    // Test net header
    let mut hdr: VirtioNetHeader = VirtioNetHeader::new()
    assert(!hdr.needs_csum(), "vnet: no checksum needed by default")
    assert(hdr.num_buffers == 1, "vnet: default 1 buffer")

    let hdr_bytes: Byte[12] = hdr.to_bytes()
    assert(hdr_bytes.len() == 12, "vnet: header 12 bytes")

    // Test config
    let mut cfg: VirtioNetConfig = VirtioNetConfig::new()
    assert(!cfg.is_link_up(), "vnet: link down by default")
    cfg.status = 1
    assert(cfg.is_link_up(), "vnet: link up")
    assert(!cfg.has_announce(), "vnet: no announce")

    // MAC address
    let mac: Byte[6] = [Byte::from_u8(0x52), Byte::from_u8(0x54), Byte::from_u8(0x00),
                        Byte::from_u8(0x12), Byte::from_u8(0x34), Byte::from_u8(0x56)]
    cfg.set_mac(&mac)
    let mac_str: FixedString[18] = cfg.mac_address_string()
    assert(mac_str.len() == 17, "vnet: MAC string is 17 chars")
    assert(mac_str[0].to_u8() == '5', "vnet: MAC string starts with 5")

    // Test statistics
    let mut stats: VirtioNetStats = VirtioNetStats::new()
    stats.record_rx(100)
    assert(stats.rx_packets == 1, "vnet: 1 RX packet")
    assert(stats.rx_bytes == 100, "vnet: 100 RX bytes")

    stats.record_tx(200)
    assert(stats.tx_packets == 1, "vnet: 1 TX packet")
    assert(stats.tx_bytes == 200, "vnet: 200 TX bytes")

    stats.record_error(true)
    assert(stats.rx_errors == 1, "vnet: 1 RX error")

    // Test network device
    let mut dev: VirtioNetDevice = VirtioNetDevice::new(VirtioMMIOTransport::new(0xFEB00000))
    assert(!dev.is_link_up(), "vnet: initially link down")
    assert(dev.mtu() == 1500, "vnet: default MTU 1500")
    assert(dev.rx_queue_count() == 0, "vnet: no RX queues initially")
    assert(dev.tx_queue_count() == 0, "vnet: no TX queues initially")

    // Link state
    dev.link_state = true
    assert(dev.is_link_up(), "vnet: link up after setting")

    // MAC address
    let dev_mac: ref Byte[6] = dev.mac_address()
    assert(dev_mac.len() == 6, "vnet: MAC length 6")

    // Set promiscuous
    dev.set_promiscuous(true)
    assert(dev.promiscuous, "vnet: promiscuous set")

    // Add queue pair
    let rx: Virtqueue = Virtqueue::new(0, 256)
    let tx: Virtqueue = Virtqueue::new(1, 256)
    let _ = dev.add_queue_pair(rx, tx)
    assert(dev.rx_queue_count() == 1, "vnet: 1 RX queue")
    assert(dev.tx_queue_count() == 1, "vnet: 1 TX queue")

    // Send packet (should fail with no transport init, but structure works)
    let send_result: Result<u32, VirtioError> = dev.send_packet(0x10000, 64)
    let mut send_failed: bool = false
    match send_result {
        Result::Ok(_) => {},
        Result::Err(_) => { send_failed = true },
    }
    assert(send_failed, "vnet: send without init fails")

    // Receive (should return None with empty queues)
    let rx_result: Option[u64] = dev.receive_packet()
    match rx_result {
        Option::Some(_) => assert(false, "vnet: should not receive"),
        Option::None => assert(true, "vnet: no packet to receive"),
    }

    // Add RX buffer
    let buf_added: bool = dev.add_rx_buffer(0x20000, 2048)
    assert(buf_added, "vnet: RX buffer added")

    // Test get queue
    let rx_q: Result<ref mut Virtqueue, VirtioError> = dev.get_rx_queue(0)
    match rx_q {
        Result::Ok(_) => assert(true, "vnet: got RX queue"),
        Result::Err(_) => assert(false, "vnet: should get RX queue"),
    }

    // Stats snapshot
    let stats_snap: VirtioNetStats = dev.stats()
    assert(true, "vnet: stats snapshot obtained")

    // Test network filter
    let mut filter: NetFilter = NetFilter::new()
    assert(!filter.should_accept(&[Byte::from_u8(0); 6]), "vnet-filter: reject unknown by default")

    filter.promiscuous = true
    assert(filter.should_accept(&[Byte::from_u8(0); 6]), "vnet-filter: accept all in promiscuous")
    filter.promiscuous = false

    let test_mac: Byte[6] = [Byte::from_u8(0x52), Byte::from_u8(0x54), Byte::from_u8(0x00),
                              Byte::from_u8(0x12), Byte::from_u8(0x34), Byte::from_u8(0x56)]
    let added: bool = filter.add_mac(&test_mac)
    assert(added, "vnet-filter: MAC added")
    assert(filter.should_accept(&test_mac), "vnet-filter: accepted by MAC filter")

    let bad_mac: Byte[6] = [Byte::from_u8(0); 6]
    assert(!filter.should_accept(&bad_mac), "vnet-filter: reject unknown MAC")

    filter.allmulti = true
    assert(filter.should_accept(&bad_mac), "vnet-filter: accept all with allmulti")

    let vlan_added: bool = filter.add_vlan(100)
    assert(vlan_added, "vnet-filter: VLAN 100 added")
    assert(filter.vlan_count == 1, "vnet-filter: 1 VLAN filter")

    filter.clear()
    assert(filter.filter_count == 0, "vnet-filter: cleared")

    // Test net offload capabilities
    let mut offload_features: u64 = VIRTIO_NET_F_CSUM | VIRTIO_NET_F_HOST_TSO4 | VIRTIO_NET_F_MRG_RXBUF
    let offload: NetOffloadCapabilities = NetOffloadCapabilities::from_features(offload_features)
    assert(offload.can_offload_tx_csum(), "vnet-offload: TX checksum")
    assert(!offload.can_offload_rx_csum(), "vnet-offload: no RX checksum")
    assert(offload.supports_tso(), "vnet-offload: TSO4 supported")
    assert(!offload.tso6, "vnet-offload: no TSO6")
    assert(offload.mrg_rxbuf, "vnet-offload: merge RX buffers")

    // Test with all offloads enabled
    let full_offload: u64 = VIRTIO_NET_F_CSUM | VIRTIO_NET_F_GUEST_CSUM |
                            VIRTIO_NET_F_HOST_TSO4 | VIRTIO_NET_F_HOST_TSO6 |
                            VIRTIO_NET_F_HOST_ECN | VIRTIO_NET_F_HOST_UFO |
                            VIRTIO_NET_F_MRG_RXBUF | VIRTIO_NET_F_HASH_REPORT
    let offload_full: NetOffloadCapabilities = NetOffloadCapabilities::from_features(full_offload)
    assert(offload_full.can_offload_tx_csum(), "vnet-offload: full TX csum")
    assert(offload_full.can_offload_rx_csum(), "vnet-offload: full RX csum")
    assert(offload_full.supports_tso(), "vnet-offload: full TSO")
    assert(offload_full.has_hash_report, "vnet-offload: hash report")

    // Test multi-queue with specific configuration
    let mut dev2: VirtioNetDevice = VirtioNetDevice::new(VirtioMMIOTransport::new(0xFEB01000))
    dev2.has_mq = true
    // loop: bounds[BOUND_SMALL] — bounded by 4 queue pairs
    loop: bounds[BOUND_SMALL] for i in 0..4 {
        let rx: Virtqueue = Virtqueue::new(i * 2, 256)
        let tx: Virtqueue = Virtqueue::new(i * 2 + 1, 256)
        let _ = dev2.add_queue_pair(rx, tx)
    }
    assert(dev2.rx_queue_count() == 4, "vnet-mq: 4 RX queues")
    assert(dev2.tx_queue_count() == 4, "vnet-mq: 4 TX queues")

    // Set promiscuous and allmulti on dev2
    dev2.set_promiscuous(true)
    dev2.set_allmulti(true)
    assert(dev2.promiscuous, "vnet-mq: promiscuous")
    assert(dev2.allmulti, "vnet-mq: allmulti")

    // Test interface statistics
    let dev2_stats: VirtioNetStats = dev2.stats()
    assert(true, "vnet: stats obtained from dev2")

    // Verify MAC address format
    let mac_str: FixedString[18] = cfg.mac_address_string()
    assert(mac_str.len() == 17, "vnet: MAC string length 17")

    residual emit {
        op: "virtio_net.tests",
        header: true,
        config: true,
        mac: true,
        stats: true,
        device: true,
        queues: true,
        send_fail: send_failed,
        recv_empty: true,
        rx_buf: buf_added,
        queue_access: true,
        filter: true,
        offload: true,
        multi_queue: true,
    }

    true
}
