// canvas_demo.phor — Canvas rendering primitives in native Phorensic
//
// Demonstrates:
//   - Software pixel buffer with fixed-capacity storage
//   - Bounded iteration over pixel coordinates
//   - Pure compute functions for pixel manipulation
//   - Framebuffer simulation through Array(u8, N)
//   - Capability-gated display access
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:canvas_demo:v1.0";

const CANVAS_W: u64 = 64;
const CANVAS_H: u64 = 64;
const CANVAS_BYTES: u64 = 16384; // 64*64*4 (RGBA)

// Pixel color
struct Pixel {
    r: u8,
    g: u8,
    b: u8,
    a: u8,
}

// Software framebuffer
struct Canvas {
    pixels: Array(u8, 16384),
    width: u64,
    height: u64,
}

impl Canvas {
    // Create a new canvas
    fn new(w: u64, h: u64) -> Canvas
        effect [compute]
    {
        return Canvas {
            pixels: Array::zeroed(),
            width: w,
            height: h,
        };
    }

    // Set a pixel at (x, y) to a color
    fn set_pixel(mut self, x: u64, y: u64, color: Pixel) -> Canvas
        effect [compute]
    {
        if x < CANVAS_W && y < CANVAS_H {
            let idx: u64 = (y * CANVAS_W + x) * 4;
            self.pixels[idx] = color.r;
            self.pixels[idx + 1] = color.g;
            self.pixels[idx + 2] = color.b;
            self.pixels[idx + 3] = color.a;
        }
        return self;
    }

    // Get a pixel at (x, y)
    fn get_pixel(self, x: u64, y: u64) -> Pixel
        effect [compute]
    {
        if x < CANVAS_W && y < CANVAS_H {
            let idx: u64 = (y * CANVAS_W + x) * 4;
            return Pixel {
                r: self.pixels[idx],
                g: self.pixels[idx + 1],
                b: self.pixels[idx + 2],
                a: self.pixels[idx + 3],
            };
        }
        return Pixel { r: 0, g: 0, b: 0, a: 0 };
    }

    // Clear entire canvas to a color
    fn clear(mut self, color: Pixel) -> Canvas
        effect [compute]
    {
        for i in 0..CANVAS_BYTES / 4 {
            let idx: u64 = i * 4;
            self.pixels[idx] = color.r;
            self.pixels[idx + 1] = color.g;
            self.pixels[idx + 2] = color.b;
            self.pixels[idx + 3] = color.a;
        }
        return self;
    }

    // Draw a filled rectangle
    fn fill_rect(mut self, x: u64, y: u64, w: u64, h: u64, color: Pixel) -> Canvas
        effect [compute]
    {
        let x_start: u64 = x;
        let y_start: u64 = y;
        let x_limit: u64 = CANVAS_W;
        let y_limit: u64 = CANVAS_H;
        let x_end: u64 = if x + w < x_limit { x + w } else { x_limit };
        let y_end: u64 = if y + h < y_limit { y + h } else { y_limit };
        let mut py: u64 = y_start;
        while py < y_end proven {
            let mut px: u64 = x_start;
            while px < x_end proven {
                self = self.set_pixel(px, py, color);
                px = px + 1;
            }
            py = py + 1;
        }
        return self;
    }

    // Draw a horizontal line
    fn hline(mut self, x: u64, y: u64, w: u64, color: Pixel) -> Canvas
        effect [compute]
    {
        let x_limit: u64 = CANVAS_W;
        let x_end: u64 = if x + w < x_limit { x + w } else { x_limit };
        let mut px: u64 = x;
        while px < x_end proven {
            self = self.set_pixel(px, y, color);
            px = px + 1;
        }
        return self;
    }

    // Draw a vertical line
    fn vline(mut self, x: u64, y: u64, h: u64, color: Pixel) -> Canvas
        effect [compute]
    {
        let y_limit: u64 = CANVAS_H;
        let y_end: u64 = if y + h < y_limit { y + h } else { y_limit };
        let mut py: u64 = y;
        while py < y_end proven {
            self = self.set_pixel(x, py, color);
            py = py + 1;
        }
        return self;
    }

    // Count non-black pixels (simple image analysis)
    fn count_non_black(self) -> u64
        effect [compute]
    {
        let mut count: u64 = 0;
        for i in 0..CANVAS_BYTES / 4 {
            let idx: u64 = i * 4;
            if self.pixels[idx] > 0 || self.pixels[idx + 1] > 0 || self.pixels[idx + 2] > 0 {
                count = count + 1;
            }
        }
        return count;
    }
}

// Create a demo pattern
fn create_demo_pattern(mut canvas: Canvas) -> Canvas
    effect [compute]
{
    // Red rectangle
    let red: Pixel = Pixel { r: 255, g: 0, b: 0, a: 255 };
    canvas = canvas.fill_rect(10, 10, 20, 20, red);

    // Green line
    let green: Pixel = Pixel { r: 0, g: 255, b: 0, a: 255 };
    canvas = canvas.hline(5, 40, 30, green);

    // Blue line
    let blue: Pixel = Pixel { r: 0, g: 0, b: 255, a: 255 };
    canvas = canvas.vline(40, 5, 30, blue);

    return canvas;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute]
{
    // Create canvas
    let mut canvas: Canvas = Canvas::new(64, 64);

    // Clear to dark background
    let bg: Pixel = Pixel { r: 10, g: 10, b: 14, a: 255 };
    canvas = canvas.clear(bg);

    // Draw pattern
    canvas = create_demo_pattern(canvas);

    // Verify pixel count
    let count: u64 = canvas.count_non_black();
    assert(count > 0, "canvas_demo: non-black pixels present");

    // Check specific pixels
    let red: Pixel = canvas.get_pixel(10, 10);
    assert(red.r == 255, "canvas_demo: red pixel at (10,10)");
    assert(red.g == 0, "canvas_demo: green channel at (10,10)");
    assert(red.b == 0, "canvas_demo: blue channel at (10,10)");

    console.write(Str::from("Canvas demo passed!"));
    assert(count > 400, "canvas_demo: many pixels rendered");
    console.write(Str::from("Canvas demo complete."));
}
