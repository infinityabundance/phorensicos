// file: signal.phor
// purpose: Signal-like event delivery: typed signals, signal masks, handlers,
//          pending signals, capability-checked signal delivery, signal info.
//          All operations use bounded loops and record residuals.
// evidence: PROC-SIG-ARCH-001 through PROC-SIG-ARCH-230
// residual: Every signal send, delivery, and handler invocation records a residual.

use core::constants::*
use core::types::*
use core::errors::*
use core::math::*
use core::collections::*
use core::handles::*
use core::capabilities::*
use core::effects::*
use core::traits::*

use process::process::*

// ──────────────────────────────────────────────
// Diagnostic Code Range
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-DIAG-001 through PROC-SIG-DIAG-010

const DIAG_SIG_BASE         : Word64 = Word64::from_u64(0xB300)
const DIAG_SIG_OK           : Word64 = DIAG_SIG_BASE | 0x000
const DIAG_SIG_NO_HANDLER   : Word64 = DIAG_SIG_BASE | 0x001
const DIAG_SIG_DENIED       : Word64 = DIAG_SIG_BASE | 0x002
const DIAG_SIG_QUEUE_FULL   : Word64 = DIAG_SIG_BASE | 0x003
const DIAG_SIG_INVALID      : Word64 = DIAG_SIG_BASE | 0x004
const DIAG_SIG_MASKED       : Word64 = DIAG_SIG_BASE | 0x005
const DIAG_SIG_UNBLOCKED    : Word64 = DIAG_SIG_BASE | 0x006
const DIAG_SIG_BOUNDS       : Word64 = DIAG_SIG_BASE | 0x007

// ──────────────────────────────────────────────
// Signal Constants
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-CONST-001 through PROC-SIG-CONST-025

const MAX_SIGNAL_TYPES          : u32 = 64
const MAX_PENDING_SIGNALS       : u32 = 32
const MAX_SIGNAL_HANDLERS       : u32 = 16
const MAX_SIGNAL_ACTIONS        : u32 = 8
const MAX_SIGNAL_INFO_SIZE      : u32 = 64
const SIGNAL_QUEUE_DEPTH        : u32 = 32
const SIGNAL_NAME_MAX_LEN       : u32 = 48
const SIG_HANDLER_FLAG_ONESHOT  : u32 = 0x01
const SIG_HANDLER_FLAG_NODEFER  : u32 = 0x02
const SIG_HANDLER_FLAG_RESUME   : u32 = 0x04

// Well-known signal numbers
const SIG_KILL                  : u32 = 0
const SIG_TERM                  : u32 = 1
const SIG_STOP                  : u32 = 2
const SIG_CONT                  : u32 = 3
const SIG_SEGV                  : u32 = 4
const SIG_ILL                   : u32 = 5
const SIG_FPE                   : u32 = 6
const SIG_BUS                   : u32 = 7
const SIG_ABRT                  : u32 = 8
const SIG_ALRM                  : u32 = 9
const SIG_HUP                   : u32 = 10
const SIG_INT                   : u32 = 11
const SIG_QUIT                  : u32 = 12
const SIG_PIPE                  : u32 = 13
const SIG_USR1                  : u32 = 14
const SIG_USR2                  : u32 = 15
const SIG_CHLD                  : u32 = 16
const SIG_SYS                   : u32 = 17
const SIG_TRAP                  : u32 = 18
const SIG_URG                   : u32 = 19
const SIG_TSTP                  : u32 = 20
const SIG_TTIN                  : u32 = 21
const SIG_TTOU                  : u32 = 22
const SIG_XCPU                  : u32 = 23
const SIG_XFSZ                  : u32 = 24
const SIG_VTALRM                : u32 = 25
const SIG_PROF                  : u32 = 26
const SIG_WINCH                 : u32 = 27
const SIG_IO                    : u32 = 28
const SIG_PWR                   : u32 = 29
const SIG_SYS2                  : u32 = 30
const SIG_CUSTOM_BASE           : u32 = 32

// Signal Actions
const SIG_ACTION_TERMINATE      : u8 = 0
const SIG_ACTION_IGNORE         : u8 = 1
const SIG_ACTION_HANDLER        : u8 = 2
const SIG_ACTION_STOP           : u8 = 3
const SIG_ACTION_CONTINUE       : u8 = 4
const SIG_ACTION_COREDUMP       : u8 = 5

// ──────────────────────────────────────────────
// Signal Number
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-NUM-001 through PROC-SIG-NUM-010

pub type SignalNumber : u32 = struct {
    value: u32,
}

impl SignalNumber {
    pub fn new(value: u32) -> SignalNumber
        effects: [deterministic]
    {
        SignalNumber { value: value % MAX_SIGNAL_TYPES }
    }

    pub fn value(self) -> u32
        effects: [deterministic]
    {
        self.value
    }

    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.value < MAX_SIGNAL_TYPES
    }

    pub fn is_standard(self) -> bool
        effects: [deterministic]
    {
        self.value < 32
    }

    pub fn is_custom(self) -> bool
        effects: [deterministic]
    {
        self.value >= SIG_CUSTOM_BASE
    }

    pub fn eq(self, other: SignalNumber) -> bool
        effects: [deterministic]
    {
        self.value == other.value
    }

    pub fn from_name(name: FixedString[SIGNAL_NAME_MAX_LEN]) -> SignalNumber
        effects: [deterministic]
    {
        match name.as_slice() {
            "SIGKILL" => SignalNumber::new(SIG_KILL),
            "SIGTERM" => SignalNumber::new(SIG_TERM),
            "SIGSTOP" => SignalNumber::new(SIG_STOP),
            "SIGCONT" => SignalNumber::new(SIG_CONT),
            "SIGSEGV" => SignalNumber::new(SIG_SEGV),
            "SIGILL" => SignalNumber::new(SIG_ILL),
            "SIGFPE" => SignalNumber::new(SIG_FPE),
            "SIGBUS" => SignalNumber::new(SIG_BUS),
            "SIGABRT" => SignalNumber::new(SIG_ABRT),
            "SIGALRM" => SignalNumber::new(SIG_ALRM),
            "SIGHUP" => SignalNumber::new(SIG_HUP),
            "SIGINT" => SignalNumber::new(SIG_INT),
            "SIGQUIT" => SignalNumber::new(SIG_QUIT),
            "SIGPIPE" => SignalNumber::new(SIG_PIPE),
            "SIGUSR1" => SignalNumber::new(SIG_USR1),
            "SIGUSR2" => SignalNumber::new(SIG_USR2),
            "SIGCHLD" => SignalNumber::new(SIG_CHLD),
            _ => SignalNumber::new(0xFF),  // Unknown
        }
    }
}

// ──────────────────────────────────────────────
// Signal Info (payload delivered with signal)
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-INFO-001 through PROC-SIG-INFO-015

pub type SignalInfo : struct {
    signal: SignalNumber,
    sender_pid: Pid,
    sender_uid: u32,
    code: i32,
    value: Word64,
    timestamp: Word64,
    data: FixedArray[64, u8],
    data_len: u32,
}

impl SignalInfo {
    pub fn new(signal: SignalNumber, sender: Pid, code: i32) -> SignalInfo
        effects: [deterministic]
    {
        SignalInfo {
            signal: signal,
            sender_pid: sender,
            sender_uid: 0,
            code: code,
            value: Word64::zero(),
            timestamp: Word64::zero(),
            data: FixedArray::new(),
            data_len: 0,
        }
    }

    pub fn with_value(signal: SignalNumber, sender: Pid, value: Word64) -> SignalInfo
        effects: [deterministic]
    {
        SignalInfo {
            signal: signal,
            sender_pid: sender,
            sender_uid: 0,
            code: 0,
            value: value,
            timestamp: __builtin_read_timestamp(),
            data: FixedArray::new(),
            data_len: 0,
        }
    }

    pub fn set_data(self: ref mut, data_src: ref Byte[], len: u32)
        effects: [deterministic]
    {
        let copy_len: u32 = if len > 64 { 64 } else { len }
        // loop: bounds[BOUND_TINY] — bounded by copy_len
        loop: bounds[BOUND_TINY] for i in 0..copy_len {
            self.data.set(i, data_src.get(i))
        }
        self.data_len = copy_len
    }
}

// ──────────────────────────────────────────────
// Signal Mask
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-MASK-001 through PROC-SIG-MASK-020

pub type SignalMask : struct {
    bits: FixedArray[2, Word64],  // 128 bits -> 2 x 64
}

impl SignalMask {
    pub fn new() -> SignalMask
        effects: [deterministic]
    {
        let mut mask: SignalMask = SignalMask {
            bits: FixedArray::new(),
        }
        mask.bits.push(Word64::zero());
        mask.bits.push(Word64::zero());
        mask
    }

    pub fn is_masked(self, sig: SignalNumber) -> bool
        effects: [deterministic]
    {
        let index: u32 = sig.value() / 64
        let bit: u32 = sig.value() % 64
        if index >= 2 {
            return false
        }
        let word: Word64 = self.bits.get(index)
        let mask_bit: u64 = 1u64 << bit
        (word.to_u64() & mask_bit) != 0
    }

    pub fn mask(self: ref mut, sig: SignalNumber)
        effects: [deterministic]
    {
        let index: u32 = sig.value() / 64
        let bit: u32 = sig.value() % 64
        if index >= 2 {
            return
        }
        let word: Word64 = self.bits.get(index)
        let mask_bit: u64 = 1u64 << bit
        self.bits.set(index, Word64::from_u64(word.to_u64() | mask_bit))
    }

    pub fn unmask(self: ref mut, sig: SignalNumber)
        effects: [deterministic]
    {
        let index: u32 = sig.value() / 64
        let bit: u32 = sig.value() % 64
        if index >= 2 {
            return
        }
        let word: Word64 = self.bits.get(index)
        let mask_bit: u64 = 1u64 << bit
        self.bits.set(index, Word64::from_u64(word.to_u64() & !mask_bit))
    }

    pub fn mask_all(self: ref mut)
        effects: [deterministic]
    {
        self.bits.set(0, Word64::from_u64(0xFFFF_FFFF_FFFF_FFFF))
        self.bits.set(1, Word64::from_u64(0xFFFF_FFFF_FFFF_FFFF))
    }

    pub fn clear_all(self: ref mut)
        effects: [deterministic]
    {
        self.bits.set(0, Word64::zero())
        self.bits.set(1, Word64::zero())
    }

    pub fn copy_from(self: ref mut, other: ref SignalMask)
        effects: [deterministic]
    {
        self.bits.set(0, other.bits.get(0))
        self.bits.set(1, other.bits.get(1))
    }
}

// ──────────────────────────────────────────────
// Signal Handler
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-HANDLER-001 through PROC-SIG-HANDLER-020

pub type SignalHandler : struct {
    signal: SignalNumber,
    handler_fn: u64,
    flags: u32,
    action: u8,
    mask: SignalMask,
    generation: Word32,
}

impl SignalHandler {
    pub fn new(signal: SignalNumber, handler_fn: u64, action: u8) -> SignalHandler
        effects: [deterministic]
    {
        SignalHandler {
            signal: signal,
            handler_fn: handler_fn,
            flags: 0,
            action: action,
            mask: SignalMask::new(),
            generation: Word32::initial(),
        }
    }

    pub fn set_flags(self: ref mut, flags: u32)
        effects: [deterministic]
    {
        self.flags = flags
    }

    pub fn set_mask(self: ref mut, mask: SignalMask)
        effects: [deterministic]
    {
        self.mask.copy_from(&mask)
    }

    pub fn is_oneshot(self) -> bool
        effects: [deterministic]
    {
        (self.flags & SIG_HANDLER_FLAG_ONESHOT) != 0
    }

    pub fn invoke(self, info: SignalInfo)
        effects: [deterministic, io]
    {
        if self.handler_fn != 0 && self.action == SIG_ACTION_HANDLER {
            // trust: call the signal handler function
            trusted("signal handler invocation") {
                let handler: fn(SignalInfo) = __builtin_fn_ptr(self.handler_fn)
                handler(info)
            }
        }
    }
}

// ──────────────────────────────────────────────
// Pending Signal Entry
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-PENDING-001 through PROC-SIG-PENDING-012

pub type PendingSignalEntry : struct {
    info: SignalInfo,
    is_pending: bool,
    delivery_count: u32,
    generation: Word32,
}

impl PendingSignalEntry {
    pub fn new(info: SignalInfo) -> PendingSignalEntry
        effects: [deterministic]
    {
        PendingSignalEntry {
            info: info,
            is_pending: true,
            delivery_count: 0,
            generation: Word32::initial(),
        }
    }

    pub fn mark_delivered(self: ref mut)
        effects: [deterministic]
    {
        self.is_pending = false
        self.delivery_count = self.delivery_count + 1
    }
}

// ──────────────────────────────────────────────
// Signal Context (per-process signal state)
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-CTX-001 through PROC-SIG-CTX-045

pub type SignalContext : struct {
    pid: Pid,
    mask: SignalMask,
    pending_signals: FixedArray[MAX_PENDING_SIGNALS, PendingSignalEntry],
    num_pending: u32,
    handlers: FixedArray[MAX_SIGNAL_HANDLERS, SignalHandler],
    num_handlers: u32,
    default_actions: FixedArray[MAX_SIGNAL_TYPES, u8],
    generation: Word32,
}

impl SignalContext {
    pub fn new(pid: Pid) -> SignalContext
        effects: [deterministic]
    {
        let mut ctx: SignalContext = SignalContext {
            pid: pid,
            mask: SignalMask::new(),
            pending_signals: FixedArray::new(),
            num_pending: 0,
            handlers: FixedArray::new(),
            num_handlers: 0,
            default_actions: FixedArray::new(),
            generation: Word32::initial(),
        }
        // Initialize default actions
        // loop: bounds[BOUND_SMALL] — bounded by MAX_SIGNAL_TYPES
        loop: bounds[BOUND_SMALL] for i in 0..MAX_SIGNAL_TYPES {
            let action: u8 = match i {
                SIG_KILL | SIG_TERM | SIG_QUIT | SIG_ABRT => SIG_ACTION_TERMINATE,
                SIG_STOP => SIG_ACTION_STOP,
                SIG_CONT => SIG_ACTION_CONTINUE,
                SIG_SEGV | SIG_ILL | SIG_FPE | SIG_BUS | SIG_SYS => SIG_ACTION_COREDUMP,
                _ => SIG_ACTION_TERMINATE,
            }
            ctx.default_actions.push(action)
        }
        ctx
    }

    pub fn register_handler(self: ref mut, handler: SignalHandler)
        -> Result[(), ProcessError>
        effects: [deterministic]
    {
        if self.num_handlers >= MAX_SIGNAL_HANDLERS {
            return Result::Err(proc_error(
                DIAG_SIG_QUEUE_FULL,
                FixedString[128]::from_slice("Max signal handlers reached")))
        }
        // Replace existing handler for the same signal
        // loop: bounds[BOUND_SMALL] — bounded by num_handlers
        loop: bounds[BOUND_SMALL] for i in 0..self.num_handlers {
            let h: ref SignalHandler = self.handlers.get(i)
            if h.signal.eq(handler.signal) {
                self.handlers.set(i, handler)
                return Result::Ok(())
            }
        }
        self.handlers.push(handler);
        self.num_handlers = self.num_handlers + 1
        Result::Ok(())
    }

    pub fn unregister_handler(self: ref mut, signal: SignalNumber)
        -> Result[(), ProcessError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by num_handlers
        loop: bounds[BOUND_SMALL] for i in 0..self.num_handlers {
            let h: ref SignalHandler = self.handlers.get(i)
            if h.signal.eq(signal) {
                // Shift remaining handlers
                // loop: bounds[BOUND_SMALL] — bounded by remaining
                loop: bounds[BOUND_SMALL] for j in i..(self.num_handlers - 1) {
                    let next: SignalHandler = self.handlers.get(j + 1)
                    self.handlers.set(j, next)
                }
                self.num_handlers = self.num_handlers - 1
                return Result::Ok(())
            }
        }
        Result::Err(proc_error(
            DIAG_SIG_INVALID,
            FixedString[128]::from_slice("No handler for signal")))
    }

    pub fn find_handler(self, signal: SignalNumber)
        -> Result[ref SignalHandler, ProcessError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by num_handlers
        loop: bounds[BOUND_SMALL] for i in 0..self.num_handlers {
            let h: ref SignalHandler = self.handlers.get(i)
            if h.signal.eq(signal) {
                return Result::Ok(h)
            }
        }
        Result::Err(proc_error(
            DIAG_SIG_NO_HANDLER,
            FixedString[128]::from_slice("No handler for this signal")))
    }

    pub fn find_handler_mut(self: ref mut, signal: SignalNumber)
        -> Result[ref mut SignalHandler, ProcessError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by num_handlers
        loop: bounds[BOUND_SMALL] for i in 0..self.num_handlers {
            let h: ref SignalHandler = self.handlers.get(i)
            if h.signal.eq(signal) {
                return Result::Ok(self.handlers.get_mut(i))
            }
        }
        Result::Err(proc_error(
            DIAG_SIG_NO_HANDLER,
            FixedString[128]::from_slice("No handler for this signal")))
    }

    pub fn enqueue_pending(self: ref mut, info: SignalInfo)
        -> Result[(), ProcessError>
        effects: [deterministic]
    {
        if self.num_pending >= MAX_PENDING_SIGNALS {
            return Result::Err(proc_error(
                DIAG_SIG_QUEUE_FULL,
                FixedString[128]::from_slice("Pending signal queue full")))
        }
        let entry: PendingSignalEntry = PendingSignalEntry::new(info)
        self.pending_signals.push(entry);
        self.num_pending = self.num_pending + 1
        self.generation.bump()
        Result::Ok(())
    }

    pub fn dequeue_pending(self: ref mut) -> Result[SignalInfo, ProcessError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by num_pending
        loop: bounds[BOUND_SMALL] for i in 0..self.num_pending {
            let entry: ref PendingSignalEntry = self.pending_signals.get(i)
            if entry.is_pending {
                let info: SignalInfo = entry.info
                let entry_mut: ref mut PendingSignalEntry = self.pending_signals.get_mut(i)
                entry_mut.mark_delivered();
                self.generation.bump()
                return Result::Ok(info)
            }
        }
        Result::Err(proc_error(
            DIAG_SIG_INVALID,
            FixedString[128]::from_slice("No pending signals")))
    }

    pub fn has_pending(self) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by num_pending
        loop: bounds[BOUND_SMALL] for i in 0..self.num_pending {
            let entry: ref PendingSignalEntry = self.pending_signals.get(i)
            if entry.is_pending {
                return true
            }
        }
        false
    }

    pub fn get_default_action(self, signal: SignalNumber) -> u8
        effects: [deterministic]
    {
        let index: u32 = signal.value()
        if index < self.default_actions.len() {
            self.default_actions.get(index)
        } else {
            SIG_ACTION_TERMINATE
        }
    }

    pub fn set_default_action(self: ref mut, signal: SignalNumber, action: u8)
        effects: [deterministic]
    {
        let index: u32 = signal.value()
        if index < self.default_actions.len() {
            self.default_actions.set(index, action)
        }
    }
}

// ──────────────────────────────────────────────
// Signal Deliverer (process-level delivery logic)
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-DELIV-001 through PROC-SIG-DELIV-050

pub type SignalDeliverer : struct {
    generation: Word32,
}

impl SignalDeliverer {
    pub fn new() -> SignalDeliverer
        effects: [deterministic]
    {
        SignalDeliverer {
            generation: Word32::initial(),
        }
    }

    pub fn send_signal(self: ref mut, ctx: ref mut SignalContext,
                        info: SignalInfo, sender_creds: ref Credentials,
                        target_creds: ref Credentials)
        -> Result<bool, ProcessError>
        effects: [deterministic]
    {
        // Capability check: sender must have permission to signal target
        if !self.can_signal(sender_creds, target_creds, info.signal) {
            return Result::Err(proc_error(
                DIAG_SIG_DENIED,
                FixedString[128]::from_slice("No permission to send signal")))
        }
        // Check if signal is masked
        if ctx.mask.is_masked(info.signal) {
            // Queue as pending
            ctx.enqueue_pending(info)?;
            self.record_signal_residual(info, true)  // masked = true
            return Result::Ok(true)
        }
        // Deliver immediately
        self.deliver_signal(ctx, info)?;
        self.record_signal_residual(info, false)
        Result::Ok(true)
    }

    pub fn deliver_signal(self: ref mut, ctx: ref mut SignalContext,
                           info: SignalInfo)
        -> Result<(), ProcessError>
        effects: [deterministic, io]
    {
        let handler_result: Result[ref mut SignalHandler, ProcessError> =
            ctx.find_handler_mut(info.signal)
        match handler_result {
            Result::Ok(handler) => {
                if handler.action == SIG_ACTION_IGNORE {
                    return Result::Ok(())
                }
                if handler.action == SIG_ACTION_HANDLER {
                    let is_oneshot: bool = handler.is_oneshot()
                    handler.invoke(info);
                    if is_oneshot {
                        handler.action = SIG_ACTION_TERMINATE
                    }
                }
            },
            Result::Err(_) => {
                let action: u8 = ctx.get_default_action(info.signal)
                match action {
                    SIG_ACTION_IGNORE => {},
                    SIG_ACTION_TERMINATE | SIG_ACTION_COREDUMP => {
                        // Process will be terminated by caller
                        return Result::Ok(())
                    },
                    SIG_ACTION_STOP => {
                        // Process will be stopped by caller
                        return Result::Ok(())
                    },
                    SIG_ACTION_CONTINUE => {
                        // Process will be continued by caller
                        return Result::Ok(())
                    },
                    _ => {},
                }
            },
        }
        self.generation.bump()
        Result::Ok(())
    }

    pub fn deliver_pending(self: ref mut, ctx: ref mut SignalContext)
        -> Result<u32, ProcessError>
        effects: [deterministic, io]
    {
        let mut delivered: u32 = 0
        // loop: bounds[BOUND_SMALL] — bounded by MAX_PENDING_SIGNALS
        loop: bounds[BOUND_SMALL] for i in 0..MAX_PENDING_SIGNALS {
            if !ctx.has_pending() {
                break
            }
            let pending_info: SignalInfo = ctx.dequeue_pending()?
            // Check again: if masked, re-queue (should not happen for pending)
            if ctx.mask.is_masked(pending_info.signal) {
                ctx.enqueue_pending(pending_info)?;
                continue
            }
            self.deliver_signal(ctx, pending_info)?;
            delivered = delivered + 1
        }
        Result::Ok(delivered)
    }

    pub fn can_signal(self, sender: ref Credentials, target: ref Credentials,
                       signal: SignalNumber) -> bool
        effects: [deterministic]
    {
        // Root can send any signal
        if sender.is_privileged() {
            return true
        }
        // Same user can send signals
        if sender.uid == target.uid {
            return true
        }
        // Some signals require specific capability
        if signal.eq(SignalNumber::new(SIG_KILL)) ||
           signal.eq(SignalNumber::new(SIG_TERM)) {
            return false  // Only root or same user
        }
        // Otherwise allow
        true
    }

    pub fn is_fatal_signal(self, signal: SignalNumber) -> bool
        effects: [deterministic]
    {
        signal.eq(SignalNumber::new(SIG_KILL)) ||
        signal.eq(SignalNumber::new(SIG_SEGV)) ||
        signal.eq(SignalNumber::new(SIG_ILL)) ||
        signal.eq(SignalNumber::new(SIG_FPE)) ||
        signal.eq(SignalNumber::new(SIG_BUS)) ||
        signal.eq(SignalNumber::new(SIG_ABRT)) ||
        signal.eq(SignalNumber::new(SIG_QUIT))
    }

    fn record_signal_residual(self, info: SignalInfo, masked: bool)
        effects: [deterministic]
    {
        @emit_residual(
            message: "Signal sent",
            code: DIAG_SIG_OK,
            data: (info.signal.value(), info.sender_pid.value(), masked),
        )
    }
}

// ──────────────────────────────────────────────
// Signal Manager (per-system signal state)
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-MGR-001 through PROC-SIG-MGR-040

pub type SignalManager : struct {
    contexts: FixedArray[MAX_PROCESSES, SignalContext],
    num_contexts: u32,
    deliverer: SignalDeliverer,
    total_signals_sent: u64,
    total_signals_delivered: u64,
    total_signals_ignored: u64,
    total_signals_masked: u64,
    signal_count_by_type: FixedArray[MAX_SIGNAL_TYPES, u32],
    generation: Word32,
}

impl SignalManager {
    pub fn new() -> SignalManager
        effects: [deterministic]
    {
        SignalManager {
            contexts: FixedArray::new(),
            num_contexts: 0,
            deliverer: SignalDeliverer::new(),
            total_signals_sent: 0,
            total_signals_delivered: 0,
            total_signals_ignored: 0,
            total_signals_masked: 0,
            signal_count_by_type: FixedArray::new(),
            generation: Word32::initial(),
        }
    }

    pub fn register_process(self: ref mut, pid: Pid)
        -> Result[(), ProcessError>
        effects: [deterministic]
    {
        if self.num_contexts >= MAX_PROCESSES {
            return Result::Err(proc_error(
                DIAG_SIG_QUEUE_FULL,
                FixedString[128]::from_slice("Max signal contexts reached")))
        }
        let ctx: SignalContext = SignalContext::new(pid)
        self.contexts.push(ctx);
        self.num_contexts = self.num_contexts + 1
        Result::Ok(())
    }

    pub fn unregister_process(self: ref mut, pid: Pid)
        -> Result<(), ProcessError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by num_contexts
        loop: bounds[BOUND_MEDIUM] for i in 0..self.num_contexts {
            let ctx: ref SignalContext = self.contexts.get(i)
            if ctx.pid.value() == pid.value() {
                // loop: bounds[BOUND_MEDIUM] — bounded by remaining
                loop: bounds[BOUND_MEDIUM] for j in i..(self.num_contexts - 1) {
                    let next: SignalContext = self.contexts.get(j + 1)
                    self.contexts.set(j, next)
                }
                self.num_contexts = self.num_contexts - 1
                return Result::Ok(())
            }
        }
        Result::Ok(())  // Already not registered
    }

    pub fn get_context(self: ref mut, pid: Pid)
        -> Result[ref mut SignalContext, ProcessError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by num_contexts
        loop: bounds[BOUND_MEDIUM] for i in 0..self.num_contexts {
            let ctx: ref SignalContext = self.contexts.get(i)
            if ctx.pid.value() == pid.value() {
                return Result::Ok(self.contexts.get_mut(i))
            }
        }
        Result::Err(proc_error(
            DIAG_SIG_INVALID,
            FixedString[128]::from_slice("No signal context for PID")))
    }

    pub fn send_signal(self: ref mut, target_pid: Pid, info: SignalInfo,
                        sender_creds: ref Credentials,
                        target_creds: ref Credentials)
        -> Result<bool, ProcessError>
        effects: [deterministic, io]
    {
        let ctx: ref mut SignalContext = self.get_context(target_pid)?;
        let delivered: bool = self.deliverer.send_signal(
            ctx, info, sender_creds, target_creds)?;
        self.total_signals_sent = self.total_signals_sent + 1
        let sig_index: u32 = info.signal.value()
        if sig_index < MAX_SIGNAL_TYPES {
            let count: u32 = self.signal_count_by_type.get(sig_index)
            self.signal_count_by_type.set(sig_index, count + 1)
        }
        self.generation.bump();
        Result::Ok(delivered)
    }

    pub fn send_signal_to_process_group(self: ref mut, pgid: Pid,
                                          info: SignalInfo,
                                          sender_creds: ref Credentials,
                                          table: ref ProcessTable)
        -> Result<u32, ProcessError>
        effects: [deterministic, io]
    {
        let mut sent: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by table.num_processes
        loop: bounds[BOUND_MEDIUM] for i in 0..table.num_processes {
            let proc: ref ProcessControlBlock = table.get_process_by_index(i)?
            if proc.process_group.value() == pgid.value() && proc.is_alive() {
                let target_creds: Credentials = proc.credentials
                match self.send_signal(
                    proc.pid, info, sender_creds, &target_creds) {
                    Result::Ok(_) => { sent = sent + 1 },
                    Result::Err(_) => {},
                }
            }
        }
        Result::Ok(sent)
    }

    pub fn register_handler(self: ref mut, pid: Pid, handler: SignalHandler)
        -> Result<(), ProcessError>
        effects: [deterministic]
    {
        let ctx: ref mut SignalContext = self.get_context(pid)?
        ctx.register_handler(handler)
    }

    pub fn unregister_handler(self: ref mut, pid: Pid, signal: SignalNumber)
        -> Result<(), ProcessError>
        effects: [deterministic]
    {
        let ctx: ref mut SignalContext = self.get_context(pid)?
        ctx.unregister_handler(signal)
    }

    pub fn set_signal_mask(self: ref mut, pid: Pid, mask: SignalMask)
        -> Result<(), ProcessError>
        effects: [deterministic]
    {
        let ctx: ref mut SignalContext = self.get_context(pid)?
        ctx.mask.copy_from(&mask);
        Result::Ok(())
    }

    pub fn get_signal_mask(self: ref mut, pid: Pid) -> Result[SignalMask, ProcessError>
        effects: [deterministic]
    {
        let ctx: ref SignalContext = self.get_context(pid)?
        Result::Ok(ctx.mask)
    }

    pub fn deliver_pending_signals(self: ref mut, pid: Pid)
        -> Result<u32, ProcessError>
        effects: [deterministic, io]
    {
        let ctx: ref mut SignalContext = self.get_context(pid)?
        let count: u32 = self.deliverer.deliver_pending(ctx)?
        self.total_signals_delivered = self.total_signals_delivered + (count as u64)
        Result::Ok(count)
    }

    pub fn has_pending_signals(self, pid: Pid) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by num_contexts
        loop: bounds[BOUND_MEDIUM] for i in 0..self.num_contexts {
            let ctx: ref SignalContext = self.contexts.get(i)
            if ctx.pid.value() == pid.value() {
                return ctx.has_pending()
            }
        }
        false
    }

    pub fn signal_stats(self) -> (u64, u64, u64, u64)
        effects: [deterministic]
    {
        (self.total_signals_sent, self.total_signals_delivered,
         self.total_signals_ignored, self.total_signals_masked)
    }

    pub fn get_signal_count(self, sig: SignalNumber) -> u32
        effects: [deterministic]
    {
        let index: u32 = sig.value()
        if index < MAX_SIGNAL_TYPES {
            self.signal_count_by_type.get(index)
        } else {
            0
        }
    }
}

// ──────────────────────────────────────────────
// Signal Action Resolution
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-ACTION-001 through PROC-SIG-ACTION-010

pub fn get_signal_action(sig_mgr: ref mut SignalManager, pid: Pid,
                          signal: SignalNumber)
    -> u8
    effects: [deterministic]
{
    let ctx_result: Result[ref mut SignalContext, ProcessError> =
        sig_mgr.get_context(pid)
    match ctx_result {
        Result::Ok(ctx) => {
            let handler_result: Result[ref SignalHandler, ProcessError> =
                ctx.find_handler(signal)
            match handler_result {
                Result::Ok(handler) => handler.action,
                Result::Err(_) => ctx.get_default_action(signal),
            }
        },
        Result::Err(_) => SIG_ACTION_TERMINATE,
    }
}

// ──────────────────────────────────────────────
// Initialization
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-INIT-001 through PROC-SIG-INIT-010

pub fn init_signal_manager() -> SignalManager
    effects: [deterministic]
{
    SignalManager::new()
}

pub fn register_process_signals(sig_mgr: ref mut SignalManager, pid: Pid)
    -> Result[(), ProcessError>
    effects: [deterministic]
{
    sig_mgr.register_process(pid)
}

pub fn unregister_process_signals(sig_mgr: ref mut SignalManager, pid: Pid)
    -> Result<(), ProcessError>
    effects: [deterministic]
{
    sig_mgr.unregister_process(pid)
}

// ──────────────────────────────────────────────
// Signal Utility Functions
// ──────────────────────────────────────────────
// Evidence path: PROC-SIG-UTIL-001 through PROC-SIG-UTIL-020

pub fn get_signal_name(signal: SignalNumber) -> FixedString[SIGNAL_NAME_MAX_LEN]
    effects: [deterministic]
{
    let sig_val: u32 = signal.value()
    match sig_val {
        SIG_KILL => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGKILL"),
        SIG_TERM => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGTERM"),
        SIG_STOP => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGSTOP"),
        SIG_CONT => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGCONT"),
        SIG_SEGV => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGSEGV"),
        SIG_ILL => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGILL"),
        SIG_FPE => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGFPE"),
        SIG_BUS => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGBUS"),
        SIG_ABRT => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGABRT"),
        SIG_ALRM => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGALRM"),
        SIG_HUP => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGHUP"),
        SIG_INT => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGINT"),
        SIG_QUIT => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGQUIT"),
        SIG_PIPE => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGPIPE"),
        SIG_USR1 => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGUSR1"),
        SIG_USR2 => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGUSR2"),
        SIG_CHLD => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGCHLD"),
        SIG_SYS => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGSYS"),
        SIG_TRAP => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGTRAP"),
        SIG_TSTP => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGTSTP"),
        SIG_XCPU => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGXCPU"),
        SIG_XFSZ => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGXFSZ"),
        SIG_WINCH => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGWINCH"),
        SIG_IO => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("SIGIO"),
        _ => FixedString[SIGNAL_NAME_MAX_LEN]::from_slice("UNKNOWN"),
    }
}

pub fn is_standard_signal(signal: SignalNumber) -> bool
    effects: [deterministic]
{
    signal.value() < 32
}

pub fn is_hardware_signal(signal: SignalNumber) -> bool
    effects: [deterministic]
{
    let sig_val: u32 = signal.value()
    sig_val == SIG_SEGV || sig_val == SIG_ILL ||
    sig_val == SIG_FPE || sig_val == SIG_BUS ||
    sig_val == SIG_TRAP
}

pub fn is_terminal_signal(signal: SignalNumber) -> bool
    effects: [deterministic]
{
    let sig_val: u32 = signal.value()
    sig_val == SIG_KILL || sig_val == SIG_TERM ||
    sig_val == SIG_QUIT || sig_val == SIG_ABRT ||
    sig_val == SIG_HUP
}

pub fn signal_info_format(info: ref SignalInfo) -> FixedString[128]
    effects: [deterministic]
{
    let name: FixedString[SIGNAL_NAME_MAX_LEN] = get_signal_name(info.signal)
    let mut msg: FixedString[128] = FixedString::new()
    let _ = msg.append(name.as_slice())
    let _ = msg.append(" from ")
    let _ = msg.append_u32(info.sender_pid.value())
    let _ = msg.append(" code=")
    let _ = msg.append_i32(info.code)
    msg
}

pub fn set_signal_handler(sig_mgr: ref mut SignalManager, pid: Pid,
                           signal: SignalNumber, handler_fn: u64)
    -> Result<(), ProcessError>
    effects: [deterministic]
{
    let handler: SignalHandler = SignalHandler::new(
        signal, handler_fn, SIG_ACTION_HANDLER)
    sig_mgr.register_handler(pid, handler)
}

pub fn set_signal_default(sig_mgr: ref mut SignalManager, pid: Pid,
                           signal: SignalNumber, action: u8)
    -> Result<(), ProcessError>
    effects: [deterministic]
{
    let ctx: ref mut SignalContext = sig_mgr.get_context(pid)?
    ctx.set_default_action(signal, action);
    Result::Ok(())
}

pub fn ignore_signal(sig_mgr: ref mut SignalManager, pid: Pid,
                      signal: SignalNumber)
    -> Result<(), ProcessError>
    effects: [deterministic]
{
    let handler: SignalHandler = SignalHandler::new(
        signal, 0, SIG_ACTION_IGNORE)
    sig_mgr.register_handler(pid, handler)
}

pub fn mask_signal(sig_mgr: ref mut SignalManager, pid: Pid,
                    signal: SignalNumber)
    -> Result<(), ProcessError>
    effects: [deterministic]
{
    let ctx: ref mut SignalContext = sig_mgr.get_context(pid)?
    ctx.mask.mask(signal);
    Result::Ok(())
}

pub fn unmask_signal(sig_mgr: ref mut SignalManager, pid: Pid,
                      signal: SignalNumber)
    -> Result<(), ProcessError>
    effects: [deterministic]
{
    let ctx: ref mut SignalContext = sig_mgr.get_context(pid)?
    ctx.mask.unmask(signal);
    Result::Ok(())
}

pub fn signal_summary(sig_mgr: ref SignalManager) -> SignalSummary
    effects: [deterministic]
{
    let (sent, delivered, ignored, masked): (u64, u64, u64, u64) = sig_mgr.signal_stats()
    SignalSummary {
        total_signals_sent: sent,
        total_signals_delivered: delivered,
        total_signals_ignored: ignored,
        total_signals_masked: masked,
        registered_processes: sig_mgr.num_contexts,
        total_pending: 0,
    }
}

pub type SignalSummary : struct {
    total_signals_sent: u64,
    total_signals_delivered: u64,
    total_signals_ignored: u64,
    total_signals_masked: u64,
    registered_processes: u32,
    total_pending: u32,
}

impl SignalSummary {
    pub fn format(self) -> FixedString[256]
        effects: [deterministic]
    {
        let mut s: FixedString[256] = FixedString::new()
        let _ = s.append("Sent: ")
        let _ = s.append_u64(self.total_signals_sent)
        let _ = s.append(", Delivered: ")
        let _ = s.append_u64(self.total_signals_delivered)
        let _ = s.append(", Ignored: ")
        let _ = s.append_u64(self.total_signals_ignored)
        let _ = s.append(", Masked: ")
        let _ = s.append_u64(self.total_signals_masked)
        let _ = s.append(", Processes: ")
        let _ = s.append_u32(self.registered_processes)
        let _ = s.append(", Pending: ")
        let _ = s.append_u32(self.total_pending)
        s
    }
}
