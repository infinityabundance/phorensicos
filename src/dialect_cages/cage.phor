// ============================================================================
// cage.phor — DialectCage: Isolated Execution Environment for Foreign Dialects
// ============================================================================
// A DialectCage provides a bounded, residual-capturing execution environment
// for foreign code. All operations are observed, translated, and recorded as
// residuals for progressive trust building and eventual native replacement.
//
// Trust ladder progression within a cage:
//   Unknown → Observed → Replayed → OracleCompared → ResidualStable → Sealed → Promoted
// ============================================================================

package "phorensic:dialect_cage:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type CageError = enum {
    NotLoaded = 0x01,
    AlreadyLoaded = 0x02,
    ExecutionFailed = 0x03,
    CapabilityDenied = 0x04,
    EffectViolation = 0x05,
    TranslationNotFound = 0x06,
    BoundExceeded = 0x07,
    StaleGeneration = 0x08,
    InvalidEntryPoint = 0x09,
    ResourceExhausted = 0x0A,
    OracleMismatch = 0x0B,
    ResidualBufferFull = 0x0C,
    CageClosed = 0x0D,
    ProfileMismatch = 0x0E,
    CodeFormatUnsupported = 0x0F,
    TrustStateBlocked = 0x10,
    InternalError = 0xFF,
}

type CodeFormat = enum {
    Source = 0x01,
    Object = 0x02,
    Binary = 0x03,
    Bitcode = 0x04,
    Assembly = 0x05,
}

type ExecutionStatus = enum {
    Completed = 0x01,
    BoundedInterrupt = 0x02,
    CapabilityFault = 0x03,
    EffectViolation = 0x04,
    Timeout = 0x05,
    MemoryExceeded = 0x06,
    InternalError = 0x07,
}

// ============================================================================
// Core Types
// ============================================================================

type ForeignCall = struct {
    name: FixedString[128],
    entry_point: FixedString[256],
    args_hash: Hash256,
    timestamp: u64,
    generation: u64,
}

type CageResult = struct {
    status: ExecutionStatus,
    output_hash: Hash256,
    operations_executed: u64,
    operations_translated: u64,
    operations_failed: u64,
    total_residuals: u64,
    execution_cycles: u64,
    memory_used: u64,
    duration_us: u64,
    trust_state_achieved: TrustState,
}

type ResidualRecord = struct {
    operation: FixedString[128],
    call: FixedString[256],
    parameters_hash: Hash256,
    native_operation: FixedString[256],
    translation_success: bool,
    timestamp: u64,
    generation: u64,
    residual_hash: Hash256,
}

type CapabilityGrant = struct {
    capability_name: FixedString[128],
    granted_at: u64,
    grant_hash: Hash256,
    generation: u64,
}

type EffectViolation = struct {
    operation: FixedString[128],
    expected_effect: FixedString[64],
    attempted_effect: FixedString[64],
    details: FixedString[256],
    timestamp: u64,
}

type OperationRecord = struct {
    operation_index: u64,
    operation_name: FixedString[128],
    foreign_signature: FixedString[256],
    native_signature: FixedString[256],
    translation_id: u64,
    success: bool,
    residual_ref: Hash256,
    duration_us: u64,
}

type TranslationRecord = struct {
    translation_id: u64,
    foreign_operation: FixedString[128],
    native_operation: FixedString[256],
    observation_count: u64,
    oracle_verified: bool,
    court_verified: bool,
    trust_state: TrustState,
    residual_refs: Array[Hash256, 64],
}

type CageReport = struct {
    cage_id: Hash256,
    dialect_profile_hash: Hash256,
    loaded_code_hash: Hash256,
    execution_count: u64,
    observed_operations: Array[OperationRecord, 512],
    translation_attempts: Array[TranslationRecord, 256],
    successful_translations: u64,
    failed_translations: u64,
    capability_grants: Array[CapabilityGrant, 64],
    effect_violations: Array[EffectViolation, 64],
    trust_recommendation: TrustState,
    residual_collection_hash: Hash256,
    total_residuals: u64,
}

// ============================================================================
// DialectCage Structure
// ============================================================================

type DialectCage = struct {
    cage_id: Hash256,
    dialect_profile: DialectProfile,
    code_store: Array[u8, 1048576],  // 1MB fixed code store
    code_format: Option[CodeFormat],
    code_loaded: bool,
    code_hash: Hash256,
    translation_map: TranslationMap,
    residual_buffer: RingBuf[ResidualRecord, 4096],
    capability_filter: Array[CapabilityGrant, 64],
    capability_count: u64,
    effect_boundary: Array[FixedString[64], 32],
    effect_count: u64,
    trust_state: TrustState,
    trust_state_history: Array[TrustState, 16],
    trust_history_count: u64,
    oracle_interface_hash: Option[Hash256],
    execution_count: u64,
    operation_count: u64,
    translation_attempt_count: u64,
    successful_translation_count: u64,
    failed_translation_count: u64,
    effect_violation_count: u64,
    observed_operations: Array[OperationRecord, 512],
    translation_attempts: Array[TranslationRecord, 256],
    effect_violations: Array[EffectViolation, 64],
    capability_grants: Array[CapabilityGrant, 64],
    generation: u64,
    closed: bool,
}

// ============================================================================
// Trust State
// ============================================================================

type TrustState = enum {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

// ============================================================================
// Forward Declarations (types from companion files)
// ============================================================================

type DialectProfile = struct {
    // Referenced from dialect_profile.phor
    profile_hash: Hash256,
    dummy: u64,
}

type TranslationMap = struct {
    // Referenced from translation_map.phor
    map_hash: Hash256,
    dummy: u64,
}

type FixedString[cap: u64] = struct {
    // Fixed-capacity string
    len: u64,
    data: Array[u8, cap],
}

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type RingBuf[T, cap: u64] = struct {
    head: u64,
    tail: u64,
    count: u64,
    data: Array[T, cap],
}

type Option[T] = enum {
    Some(value: T),
    None,
}

// ============================================================================
// Create Cage
// ============================================================================
// Creates an empty cage configured for the given dialect profile.
// No capabilities are granted initially. The cage starts in Unknown
// trust state.

fn create_cage(profile: DialectProfile) -> Result[DialectCage, CageError]
    effects: [compute, residual]
{
    // Validate profile is non-empty by checking its hash
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    if profile.profile_hash == zero_hash {
        return Err(CageError::ProfileMismatch);
    }

    // Generate cage ID from profile hash and generation
    let generation: u64 = kernel.generation_counter();
    let cage_id: Hash256 = hash_combine(profile.profile_hash, generation);

    // Initialize empty translation map
    let empty_map: TranslationMap = TranslationMap {
        map_hash: zero_hash,
        dummy: 0,
    };

    // Initialize empty residual buffer
    let empty_buffer: RingBuf[ResidualRecord, 4096] = RingBuf[ResidualRecord, 4096]::new();

    // Initialize empty capability filter
    let empty_caps: Array[CapabilityGrant, 64] = Array[CapabilityGrant, 64]::zeroed();

    // Initialize empty effect boundary
    let empty_effects: Array[FixedString[64], 32] = Array[FixedString[64], 32]::zeroed();

    // Initialize empty code store
    let empty_store: Array[u8, 1048576] = Array[u8, 1048576]::zeroed();

    // Initialize empty trust state history with Unknown
    let trust_history: Array[TrustState, 16] = Array[TrustState, 16]::zeroed();
    trust_history[0] = TrustState::Unknown;

    // Initialize empty observed operations
    let empty_ops: Array[OperationRecord, 512] = Array[OperationRecord, 512]::zeroed();

    // Initialize empty translation attempts
    let empty_trans: Array[TranslationRecord, 256] = Array[TranslationRecord, 256]::zeroed();

    // Initialize empty effect violations
    let empty_violations: Array[EffectViolation, 64] = Array[EffectViolation, 64]::zeroed();

    // Initialize empty capability grants
    let empty_grants: Array[CapabilityGrant, 64] = Array[CapabilityGrant, 64]::zeroed();

    let cage: DialectCage = DialectCage {
        cage_id: cage_id,
        dialect_profile: profile,
        code_store: empty_store,
        code_format: Option::None,
        code_loaded: false,
        code_hash: zero_hash,
        translation_map: empty_map,
        residual_buffer: empty_buffer,
        capability_filter: empty_caps,
        capability_count: 0,
        effect_boundary: empty_effects,
        effect_count: 0,
        trust_state: TrustState::Unknown,
        trust_state_history: trust_history,
        trust_history_count: 1,
        oracle_interface_hash: Option::None,
        execution_count: 0,
        operation_count: 0,
        translation_attempt_count: 0,
        successful_translation_count: 0,
        failed_translation_count: 0,
        effect_violation_count: 0,
        observed_operations: empty_ops,
        translation_attempts: empty_trans,
        effect_violations: empty_violations,
        capability_grants: empty_grants,
        generation: generation,
        closed: false,
    };

    // Emit cage creation residual
    @emit_residual("cage.create", "cage_created", cage_id);

    return Ok(cage);
}

// ============================================================================
// Load Code Into Cage
// ============================================================================
// Loads foreign code into the cage. The format specifies whether this is
// source, object, or binary. The code is stored in a fixed buffer and
// hashed for provenance tracking.

fn load_into_cage(cage: &mut DialectCage, code: &Array[u8, 1048576], format: CodeFormat) -> Result[(), CageError]
    effects: [compute, residual]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    if cage.code_loaded {
        return Err(CageError::AlreadyLoaded);
    }

    // Validate format is supported
    match format {
        CodeFormat::Source => {
            // Source format: validate length and null-termination
            if code.len() == 0 {
                return Err(CageError::CodeFormatUnsupported);
            }
        }
        CodeFormat::Object => {
            // Object format: check minimum ELF/Mach-O header size
            if code.len() < 64 {
                return Err(CageError::CodeFormatUnsupported);
            }
        }
        CodeFormat::Binary => {
            // Binary format: check minimum executable header size
            if code.len() < 128 {
                return Err(CageError::CodeFormatUnsupported);
            }
        }
        CodeFormat::Bitcode => {
            // Bitcode format: check magic bytes
            if code.len() < 16 {
                return Err(CageError::CodeFormatUnsupported);
            }
        }
        CodeFormat::Assembly => {
            // Assembly format: validate text content
            if code.len() == 0 {
                return Err(CageError::CodeFormatUnsupported);
            }
        }
    }

    // Copy code into cage store with bound checking
    let copy_limit: u64 = if code.len() < 1048576 { code.len() } else { 1048576 };

    for i in 0..copy_limit {
        cage.code_store[i] = code[i];
    }

    // Hash the loaded code
    cage.code_hash = hash_bytes(code, copy_limit);
    cage.code_format = Option::Some(format);
    cage.code_loaded = true;

    // Emit load residual
    @emit_residual("cage.load", "code_loaded", cage.code_hash);

    return Ok(());
}

// ============================================================================
// Grant Capability To Cage
// ============================================================================
// Grants a native capability to the cage. Each grant is logged as a residual.

fn grant_cage_capability(cage: &mut DialectCage, cap_name: &FixedString[128], cap_hash: Hash256) -> Result[(), CageError]
    effects: [compute, residual]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    if cage.capability_count >= 64 {
        return Err(CageError::ResourceExhausted);
    }

    let grant: CapabilityGrant = CapabilityGrant {
        capability_name: *cap_name,
        granted_at: kernel.tick_count(),
        grant_hash: cap_hash,
        generation: cage.generation,
    };

    cage.capability_filter[cage.capability_count] = grant;
    cage.capability_count = cage.capability_count + 1;

    // Emit capability grant residual
    @emit_residual("cage.grant_capability", "capability_granted", cap_hash);

    return Ok(());
}

// ============================================================================
// Execute In Cage
// ============================================================================
// Executes the caged code at the specified entry point with the given
// arguments. Execution is bounded (time, memory, effects). All observable
// behavior is captured as residuals.

fn execute_in_cage(cage: &mut DialectCage, entry: &FixedString[256], args_hash: Hash256, time_bound_us: u64, memory_bound: u64) -> Result[CageResult, CageError]
    effects: [compute, io, residual]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    if !cage.code_loaded {
        return Err(CageError::NotLoaded);
    }

    // Validate entry point is not empty
    if entry.len == 0 {
        return Err(CageError::InvalidEntryPoint);
    }

    // Record the execution attempt
    cage.execution_count = cage.execution_count + 1;

    let start_time: u64 = kernel.tick_count();
    let mut operations_executed: u64 = 0;
    let mut operations_translated: u64 = 0;
    let mut operations_failed: u64 = 0;
    let mut total_residuals: u64 = 0;
    let mut memory_used: u64 = 0;
    let mut exec_status: ExecutionStatus = ExecutionStatus::Completed;

    // --- Bounded Execution Loop ---
    // The cage simulates execution by processing observed operations.
    // Each iteration represents one foreign operation interception.
    // Bound: max 100000 operations per execution.
    let max_ops: u64 = 100000;

    for i in 0..max_ops {
        // Check time bound
        let elapsed: u64 = kernel.tick_count() - start_time;
        if elapsed > time_bound_us {
            exec_status = ExecutionStatus::Timeout;
            break;
        }

        // Check memory bound
        if memory_used > memory_bound {
            exec_status = ExecutionStatus::MemoryExceeded;
            break;
        }

        // Check residual buffer capacity
        if cage.residual_buffer.count >= 4096 {
            exec_status = ExecutionStatus::BoundedInterrupt;
            break;
        }

        // Attempt to translate the current operation
        let call: ForeignCall = ForeignCall {
            name: FixedString[128]::from_bytes(entry.data, entry.len),
            entry_point: *entry,
            args_hash: args_hash,
            timestamp: kernel.tick_count(),
            generation: cage.generation,
        };

        let translation: Result[FixedString[256], CageError] = translate_operation(cage, call);

        match translation {
            Ok(native_op) => {
                // Record successful translation
                let record: ResidualRecord = ResidualRecord {
                    operation: FixedString[128]::from_literal("cage.execute"),
                    call: native_op,
                    parameters_hash: args_hash,
                    native_operation: native_op,
                    translation_success: true,
                    timestamp: kernel.tick_count(),
                    generation: cage.generation,
                    residual_hash: hash_combine(cage.code_hash, i),
                };

                let push_result: Result[(), CageError] = cage.residual_buffer.push(record);
                match push_result {
                    Ok(()) => {
                        total_residuals = total_residuals + 1;
                    }
                    Err(e) => {
                        exec_status = ExecutionStatus::BoundedInterrupt;
                        break;
                    }
                }

                operations_translated = operations_translated + 1;
                memory_used = memory_used + 128;

                // Record operation in observed operations list
                if cage.operation_count < 512 {
                    let op_record: OperationRecord = OperationRecord {
                        operation_index: cage.operation_count,
                        operation_name: FixedString[128]::from_literal("translated_call"),
                        foreign_signature: FixedString[256]::from_bytes(call.name.data, call.name.len),
                        native_signature: native_op,
                        translation_id: cage.translation_attempt_count,
                        success: true,
                        residual_ref: record.residual_hash,
                        duration_us: elapsed,
                    };
                    cage.observed_operations[cage.operation_count] = op_record;
                    cage.operation_count = cage.operation_count + 1;
                }
            }
            Err(e) => {
                // Record failed translation
                let error_record: ResidualRecord = ResidualRecord {
                    operation: FixedString[128]::from_literal("cage.execute.failed"),
                    call: FixedString[256]::from_bytes(entry.data, entry.len),
                    parameters_hash: args_hash,
                    native_operation: FixedString[256]::zeroed(),
                    translation_success: false,
                    timestamp: kernel.tick_count(),
                    generation: cage.generation,
                    residual_hash: hash_combine(cage.code_hash, i),
                };

                let push_result: Result[(), CageError] = cage.residual_buffer.push(error_record);
                match push_result {
                    Ok(()) => {
                        total_residuals = total_residuals + 1;
                    }
                    Err(e2) => {
                        break;
                    }
                }

                operations_failed = operations_failed + 1;
            }
        }

        operations_executed = operations_executed + 1;
    }

    // Update trust state based on execution results
    if operations_executed > 0 && cage.trust_state < TrustState::Observed {
        cage.trust_state = TrustState::Observed;
        if cage.trust_history_count < 16 {
            cage.trust_state_history[cage.trust_history_count] = TrustState::Observed;
            cage.trust_history_count = cage.trust_history_count + 1;
        }
    }

    let end_time: u64 = kernel.tick_count();
    let total_duration: u64 = end_time - start_time;

    let result: CageResult = CageResult {
        status: exec_status,
        output_hash: hash_combine(cage.code_hash, operations_executed),
        operations_executed: operations_executed,
        operations_translated: operations_translated,
        operations_failed: operations_failed,
        total_residuals: total_residuals,
        execution_cycles: operations_executed * 100,
        memory_used: memory_used,
        duration_us: total_duration,
        trust_state_achieved: cage.trust_state,
    };

    // Emit execution completion residual
    @emit_residual("cage.execute.complete", "execution_finished", args_hash);

    return Ok(result);
}

// ============================================================================
// Translate Operation (Internal)
// ============================================================================
// Attempts to translate a foreign call into a native operation using the
// cage's translation map. Emits translation residuals for every attempt.

fn translate_operation(cage: &DialectCage, call: ForeignCall) -> Result[FixedString[256], CageError]
    effects: [compute, residual]
{
    // Search translation map entries for a matching foreign operation
    let mut found: bool = false;
    let mut native_op: FixedString[256] = FixedString[256]::zeroed();

    // Bound: search up to the number of translation entries
    let search_limit: u64 = if cage.translation_attempt_count < 256 { cage.translation_attempt_count } else { 256 };

    for i in 0..search_limit {
        let entry: TranslationRecord = cage.translation_attempts[i];
        if entry.foreign_operation == call.name {
            // Found a matching entry
            found = true;
            native_op = FixedString[256]::from_bytes(entry.native_operation.data, entry.native_operation.len);
            break;
        }
    }

    if found {
        @emit_residual("cage.translate", "translation_found", call.args_hash);
        return Ok(native_op);
    } else {
        @emit_residual("cage.translate.unmapped", "translation_not_found", call.args_hash);
        return Err(CageError::TranslationNotFound);
    }
}

// ============================================================================
// Execute With Explicit Capability Check
// ============================================================================
// Executes caged code with an explicit capability check before each operation.

fn execute_with_cap_check(cage: &mut DialectCage, entry: &FixedString[256], args_hash: Hash256, required_cap: &FixedString[128], time_bound_us: u64, memory_bound: u64) -> Result[CageResult, CageError]
    effects: [compute, io, residual]
{
    // Check if the required capability is granted
    let mut cap_found: bool = false;

    for i in 0..cage.capability_count {
        if cage.capability_filter[i].capability_name == *required_cap {
            cap_found = true;
            break;
        }
    }

    if !cap_found {
        @emit_residual("cage.capability_denied", "missing_capability", required_cap.hash());
        return Err(CageError::CapabilityDenied);
    }

    // Proceed with execution
    return execute_in_cage(cage, entry, args_hash, time_bound_us, memory_bound);
}

// ============================================================================
// Set Effect Boundary
// ============================================================================
// Configures which effects are permitted within the cage.

fn set_effect_boundary(cage: &mut DialectCage, effects: &Array[FixedString[64], 32], effect_count: u64) -> Result[(), CageError]
    effects: [compute, residual]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    if effect_count > 32 {
        return Err(CageError::ResourceExhausted);
    }

    for i in 0..effect_count {
        cage.effect_boundary[i] = effects[i];
    }
    cage.effect_count = effect_count;

    @emit_residual("cage.set_effects", "effect_boundary_set", effect_count);

    return Ok(());
}

// ============================================================================
// Check Effect Permitted
// ============================================================================
// Checks whether a given effect is permitted by the cage's effect boundary.

fn is_effect_permitted(cage: &DialectCage, effect: &FixedString[64]) -> bool
    effects: [compute]
{
    for i in 0..cage.effect_count {
        if cage.effect_boundary[i] == *effect {
            return true;
        }
    }
    return false;
}

// ============================================================================
// Record Effect Violation
// ============================================================================
// Records an effect violation when caged code attempts a disallowed effect.

fn record_effect_violation(cage: &mut DialectCage, operation: &FixedString[128], expected: &FixedString[64], attempted: &FixedString[64], details: &FixedString[256]) -> Result[(), CageError]
    effects: [compute, residual]
{
    if cage.effect_violation_count >= 64 {
        return Err(CageError::ResidualBufferFull);
    }

    let violation: EffectViolation = EffectViolation {
        operation: *operation,
        expected_effect: *expected,
        attempted_effect: *attempted,
        details: *details,
        timestamp: kernel.tick_count(),
    };

    cage.effect_violations[cage.effect_violation_count] = violation;
    cage.effect_violation_count = cage.effect_violation_count + 1;

    @emit_residual("cage.effect_violation", "effect_denied", violation.timestamp);

    return Ok(());
}

// ============================================================================
// Extract Residuals
// ============================================================================
// Returns all residuals captured during execution, including:
// - each intercepted operation
// - each capability check
// - each dialect translation event
// - timing and resource usage
// - oracle comparison results (if oracle available)

fn extract_residuals(cage: &DialectCage) -> Result[RingBuf[ResidualRecord, 4096], CageError]
    effects: [compute]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    // Return a copy of the residual buffer
    let residuals: RingBuf[ResidualRecord, 4096] = cage.residual_buffer;

    @emit_residual("cage.extract_residuals", "residuals_extracted", residuals.count);

    return Ok(residuals);
}

// ============================================================================
// Get Residual Count
// ============================================================================

fn get_residual_count(cage: &DialectCage) -> u64
    effects: [compute]
{
    return cage.residual_buffer.count;
}

// ============================================================================
// Get Observed Operations
// ============================================================================
// Returns the list of observed operations during cage execution.

fn get_observed_operations(cage: &DialectCage) -> Result[Array[OperationRecord, 512], CageError]
    effects: [compute]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    return Ok(cage.observed_operations);
}

// ============================================================================
// Get Translation Attempts
// ============================================================================
// Returns the list of translation attempts made during cage execution.

fn get_translation_attempts(cage: &DialectCage) -> Result[Array[TranslationRecord, 256], CageError]
    effects: [compute]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    return Ok(cage.translation_attempts);
}

// ============================================================================
// Get Current Trust State
// ============================================================================

fn get_cage_trust_state(cage: &DialectCage) -> TrustState
    effects: [compute]
{
    return cage.trust_state;
}

// ============================================================================
// Promote Cage Trust State
// ============================================================================
// Promotes the cage's trust state to the next level after verification.

fn promote_cage_trust(cage: &mut DialectCage, target: TrustState) -> Result[(), CageError]
    effects: [compute, residual]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    // Validate promotion order: can only promote to the next level
    let current: u64 = cage.trust_state as u64;
    let target_val: u64 = target as u64;

    if target_val <= current {
        return Err(CageError::TrustStateBlocked);
    }

    if target_val > current + 2 {
        // Allow skipping at most one level for efficiency
        // e.g., Observed -> OracleCompared requires both Replayed and OracleCompared
        return Err(CageError::TrustStateBlocked);
    }

    // Record the promotion
    cage.trust_state = target;
    if cage.trust_history_count < 16 {
        cage.trust_state_history[cage.trust_history_count] = target;
        cage.trust_history_count = cage.trust_history_count + 1;
    }

    @emit_residual("cage.trust_promote", "trust_state_promoted", target_val);

    return Ok(());
}

// ============================================================================
// Close Cage
// ============================================================================
// Finalizes the cage and produces a comprehensive report with all evidence.

fn close_cage(cage: &mut DialectCage) -> Result[CageReport, CageError]
    effects: [compute, residual]
{
    if cage.closed {
        return Err(CageError::CageClosed);
    }

    // Compute residual collection hash from all residual records
    let mut residual_hash_accum: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let drain_limit: u64 = if cage.residual_buffer.count < 4096 { cage.residual_buffer.count } else { 4096 };

    for i in 0..drain_limit {
        let record: ResidualRecord = cage.residual_buffer.data[i];
        residual_hash_accum = hash_combine(residual_hash_accum, record.residual_hash);
    }

    // Build report
    let report: CageReport = CageReport {
        cage_id: cage.cage_id,
        dialect_profile_hash: cage.dialect_profile.profile_hash,
        loaded_code_hash: cage.code_hash,
        execution_count: cage.execution_count,
        observed_operations: cage.observed_operations,
        translation_attempts: cage.translation_attempts,
        successful_translations: cage.successful_translation_count,
        failed_translations: cage.failed_translation_count,
        capability_grants: cage.capability_grants,
        effect_violations: cage.effect_violations,
        trust_recommendation: cage.trust_state,
        residual_collection_hash: residual_hash_accum,
        total_residuals: cage.residual_buffer.count,
    };

    // Mark cage as closed
    cage.closed = true;

    @emit_residual("cage.close", "cage_closed", cage.cage_id);

    return Ok(report);
}

// ============================================================================
// Is Cage Closed
// ============================================================================

fn is_cage_closed(cage: &DialectCage) -> bool
    effects: [compute]
{
    return cage.closed;
}

// ============================================================================
// Get Cage Generation
// ============================================================================

fn get_cage_generation(cage: &DialectCage) -> u64
    effects: [compute]
{
    return cage.generation;
}

// ============================================================================
// Check Stale Generation
// ============================================================================
// Checks whether a given generation tag is still valid for this cage.

fn check_generation(cage: &DialectCage, gen: u64) -> bool
    effects: [compute]
{
    if cage.generation == 0 {
        return false;
    }
    return gen == cage.generation;
}

// ============================================================================
// Hash Helpers
// ============================================================================
// These are stubs; real implementation uses kernel hash service.

fn hash_combine(a: Hash256, b: Hash256) -> Hash256
    effects: [compute]
{
    // Placeholder: XOR combine hash bytes
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    return result;
}

fn hash_combine(a: Hash256, b: u64) -> Hash256
    effects: [compute]
{
    let mut bytes: Array[u8, 8] = Array[u8, 8]::zeroed();
    let mut tmp: u64 = b;
    for i in 0..8 {
        bytes[i] = (tmp & 0xFF) as u8;
        tmp = tmp >> 8;
    }
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..8 {
        result.bytes[i] = a.bytes[i] ^ bytes[i];
    }
    for i in 8..32 {
        result.bytes[i] = a.bytes[i];
    }
    return result;
}

fn hash_bytes(data: &Array[u8, 1048576], len: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let hash_len: u64 = if len < 1048576 { len } else { 1048576 };
    for i in 0..hash_len {
        let idx: u64 = i & 31;
        result.bytes[idx] = result.bytes[idx] ^ data[i];
        if idx == 31 {
            // Rotate
            let last: u8 = result.bytes[31];
            for j in 0..31 {
                let dst: u64 = 31 - j;
                let src: u64 = 30 - j;
                result.bytes[dst] = result.bytes[src];
            }
            result.bytes[0] = result.bytes[0] ^ last;
        }
    }
    return result;
}

// ============================================================================
// DialectCageManager
// ============================================================================
// Manages multiple cages for different dialects.

type DialectCageManager = struct {
    cages: Array[DialectCage, 64],
    cage_count: u64,
    generation: u64,
}

fn create_cage_manager() -> DialectCageManager
    effects: [compute]
{
    let empty_cages: Array[DialectCage, 64] = Array[DialectCage, 64]::zeroed();
    return DialectCageManager {
        cages: empty_cages,
        cage_count: 0,
        generation: 1,
    };
}

fn manager_create_cage(manager: &mut DialectCageManager, profile: DialectProfile) -> Result[Hash256, CageError]
    effects: [compute, residual]
{
    if manager.cage_count >= 64 {
        return Err(CageError::ResourceExhausted);
    }

    let cage: DialectCage = create_cage(profile)?;

    let cage_id: Hash256 = cage.cage_id;
    manager.cages[manager.cage_count] = cage;
    manager.cage_count = manager.cage_count + 1;

    return Ok(cage_id);
}

fn manager_get_cage(manager: &DialectCageManager, cage_id: Hash256) -> Result[&DialectCage, CageError]
    effects: [compute]
{
    for i in 0..manager.cage_count {
        if manager.cages[i].cage_id == cage_id {
            return Ok(manager.cages[i]);
        }
    }
    return Err(CageError::NotLoaded);
}

fn manager_get_cage_mut(manager: &mut DialectCageManager, cage_id: Hash256) -> Result[&mut DialectCage, CageError]
    effects: [compute]
{
    for i in 0..manager.cage_count {
        if manager.cages[i].cage_id == cage_id {
            return Ok(manager.cages[i]);
        }
    }
    return Err(CageError::NotLoaded);
}

fn manager_close_cage(manager: &mut DialectCageManager, cage_id: Hash256) -> Result[CageReport, CageError]
    effects: [compute, residual]
{
    for i in 0..manager.cage_count {
        if manager.cages[i].cage_id == cage_id {
            let report: CageReport = close_cage(&mut manager.cages[i])?;
            return Ok(report);
        }
    }
    return Err(CageError::NotLoaded);
}

fn manager_close_all(manager: &mut DialectCageManager) -> Result[Array[CageReport, 64], CageError>
    effects: [compute, residual]
{
    let mut reports: Array[CageReport, 64] = Array[CageReport, 64]::zeroed();
    let mut report_count: u64 = 0;

    for i in 0..manager.cage_count {
        if !manager.cages[i].closed {
            let report: CageReport = close_cage(&mut manager.cages[i])?;
            reports[report_count] = report;
            report_count = report_count + 1;
        }
    }

    let result: Array[CageReport, 64] = reports;
    return Ok(result);
}
