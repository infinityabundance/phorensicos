// jit_port_strrchr.phor — fifth JIT-Porting Court target (native candidate)
//
// Clean-room native port of libc `strrchr` at the *last-match* boundary. The
// observable is the **index of the last occurrence** of the needle in the C
// string, or `-1` when absent. `strrchr` returns a pointer, and a pointer value
// is not portable behavior, so the court normalizes the observable to the index
// (`result - s`) — the actual C contract, and what a native caller needs.
//
// This file is the *candidate source* bound into the sealed package
// (phost/evidence/porting/strrchr/sealed_package.json: candidate_source_hash).
//
// The mirror image of `memchr`: `memchr` finds the *first* match in a *bounded
// window*, while `strrchr` finds the *last* match in the *string*. The search
// domain ends at (and includes) the first NUL, so bytes after the terminator are
// never matched and a needle of `0` yields the terminator index (the length).
//
// The buffer is modelled as up to 8 bytes packed LITTLE-ENDIAN into a u64 (byte
// i occupies bits 8*i, i.e. the machine word you get by loading the buffer on
// x86-64) and zero-extended past the bound. `n` is a precondition bound: the
// terminator lies within the first `n` bytes, which the execution harness
// enforces, so the word always encodes the whole string.
//
// ABI — the executed entry point (see phost::porting::exec):
//   symbol `_phor_phor_strrchr_index`; SysV AMD64 (RDI, RSI) -> RAX, i.e.
//   `phor_strrchr_index(w: u64, needle: u64) -> u64`.
//   The result is an i64 index (`-1` when absent).
//   The function is a leaf: no calls, no relocations, no heap, no syscalls.
//
// The lowerer emits a single basic block (no branches), so the scan is written
// branchlessly. Two running values walk the lanes from 0 up:
//   `pre` is 1 while no NUL has been seen before index i, i.e. index i is still
//   inside the string; `idx` is the last matching index. Scanning i = 0 → 7 and
//   overwriting on a hit leaves the *largest* matching index, i.e. the last
//   occurrence in the string.
//
// Scope: API-surface JIT-porting. NOT arbitrary binary translation. The cage
// observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_strrchr:v1.0";

// ── Domain constants ─────────────────────────────────────

const WIDTH: u64 = 8;       // bytes packed per buffer word
const BYTE_MASK: u64 = 255; // one byte per lane
const NUL: u64 = 0;         // the C string terminator byte
const NOT_FOUND: u64 = 0 - 1; // -1, all bits set

// ── Target and evidence records ──────────────────────────
// These mirror the residuals the court seals for this target.

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    input_schema: Str(64),
    output_schema: Str(64),
}

struct ReplayVerdict {
    target: Str(32),
    cases_run: u64,
    cases_passed: u64,
    cases_failed: u64,
    verdict: u8,
}

struct SealedPackage {
    target: Str(32),
    dialect_name: Str(16),
    trust_level: u8,
    case_count: u64,
    oracle_hash: Str(64),
    candidate_hash: Str(64),
}

// ── Native clean-room candidate ──────────────────────────
//
// Branchless and leaf. Byte i of the little-endian word is `(w >> (8*i)) & 255`.
// `hit = (byte == needle) * pre` is 1 only for an in-string match; the select
// `idx - hit * (idx - i)` is unchanged when hit is 0 and exactly `i` when hit is
// 1. Ascending order makes the largest (last) matching index win. `pre` is
// cleared by the first NUL and stays 0, so nothing after the terminator can
// match; a needle of 0 matches exactly at the terminator.

fn phor_strrchr_index(w: u64, needle: u64) -> u64
    effect [compute]
{
    let c: u64 = needle & BYTE_MASK;
    let mut idx: u64 = NOT_FOUND;
    let mut pre: u64 = 1;

    let b0: u64 = w & BYTE_MASK;
    let h0: u64 = ((b0 == c) as u64) * pre;
    idx = idx - h0 * (idx - 0);
    pre = pre * (1 - ((b0 == NUL) as u64));

    let b1: u64 = (w >> 8) & BYTE_MASK;
    let h1: u64 = ((b1 == c) as u64) * pre;
    idx = idx - h1 * (idx - 1);
    pre = pre * (1 - ((b1 == NUL) as u64));

    let b2: u64 = (w >> 16) & BYTE_MASK;
    let h2: u64 = ((b2 == c) as u64) * pre;
    idx = idx - h2 * (idx - 2);
    pre = pre * (1 - ((b2 == NUL) as u64));

    let b3: u64 = (w >> 24) & BYTE_MASK;
    let h3: u64 = ((b3 == c) as u64) * pre;
    idx = idx - h3 * (idx - 3);
    pre = pre * (1 - ((b3 == NUL) as u64));

    let b4: u64 = (w >> 32) & BYTE_MASK;
    let h4: u64 = ((b4 == c) as u64) * pre;
    idx = idx - h4 * (idx - 4);
    pre = pre * (1 - ((b4 == NUL) as u64));

    let b5: u64 = (w >> 40) & BYTE_MASK;
    let h5: u64 = ((b5 == c) as u64) * pre;
    idx = idx - h5 * (idx - 5);
    pre = pre * (1 - ((b5 == NUL) as u64));

    let b6: u64 = (w >> 48) & BYTE_MASK;
    let h6: u64 = ((b6 == c) as u64) * pre;
    idx = idx - h6 * (idx - 6);
    pre = pre * (1 - ((b6 == NUL) as u64));

    let b7: u64 = (w >> 56) & BYTE_MASK;
    let h7: u64 = ((b7 == c) as u64) * pre;
    idx = idx - h7 * (idx - 7);

    return idx;
}
