// i2c_driver.phor — I2C driver
// Master/slave mode, SMBus protocol subset, I2C adapter framework,
// device address detection, clock stretching, combined transactions,
// 7-bit/10-bit addressing, GPIO bit-banging fallback.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/i2c_driver.phor
// Court: i2c_driver:v2

package drivers.i2c_driver;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type I2cError = enum {
    I2cNotInitialized          = 0xF00,
    I2cControllerNotFound      = 0xF01,
    I2cDeviceNoAck             = 0xF02,
    I2cArbitrationLost         = 0xF03,
    I2cBusError                = 0xF04,
    I2cTimeout                 = 0xF05,
    I2cClockStretchTimeout     = 0xF06,
    I2cNackOnAddress           = 0xF07,
    I2cNackOnData              = 0xF08,
    I2cInvalidAddress          = 0xF09,
    I2cCapabilityError         = 0xF0A,
    I2cSmbusProtocolError      = 0xF0B,
    I2cInvalidTransferSize     = 0xF0C,
    I2cGpioBitbangError        = 0xF0D,
    I2cCombinedXactError       = 0xF0E,
    I2cSlaveModeNotAvailable   = 0xF0F,
    I2cMasterBusy              = 0xF10,
    I2cAddressDetectionFailed  = 0xF11,
    I2cMaxDevicesExceeded      = 0xF12,
    I2cResidualStoreFull       = 0xF13,
    I2cSmbusAlertNotSupported  = 0xF14,
    I2cHostNotifyNotSupported  = 0xF15,
    I2c10BitAddrNotSupported   = 0xF16,
}

// ─────────────────────────────────────────────────────────────
// I2C Full Capability
// ─────────────────────────────────────────────────────────────

struct I2cCapability {
    object_id: Identity,
    generation: u64,
    can_master: bool,
    can_slave: bool,
    can_smbus: bool,
    can_gpio_bitbang: bool,
    can_combined_xact: bool,
    can_10bit_addr: bool,
    can_clock_stretch: bool,
    max_buses: u64,
}

// ─────────────────────────────────────────────────────────────
// I2C Bus Speeds
// ─────────────────────────────────────────────────────────────

type I2cBusSpeed = enum {
    StandardMode   = 0,
    FastMode       = 1,
    FastModePlus   = 2,
    HighSpeedMode  = 3,
    UltraFastMode  = 4,
}

// ─────────────────────────────────────────────────────────────
// I2C Transfer Flags
// ─────────────────────────────────────────────────────────────

struct I2cTransferFlags {
    is_read: bool,
    no_start: bool,
    no_stop: bool,
    is_10bit: bool,
    repeated_start: bool,
    use_dma: bool,
}

// ─────────────────────────────────────────────────────────────
// I2C Message (Transfer Segment)
// ─────────────────────────────────────────────────────────────

struct I2cMessage {
    addr: u16,
    flags: I2cTransferFlags,
    buffer: Array(u8, 256),
    buffer_len: u16,
    transferred_len: u16,
    error: I2cError,
}

// ─────────────────────────────────────────────────────────────
// I2C Adapter State
// ─────────────────────────────────────────────────────────────

struct I2cAdapter {
    bus_id: u8,
    speed: I2cBusSpeed,
    freq_hz: u32,
    scl_pin: u16,
    sda_pin: u16,
    regs_base: u64,
    regs_size: u64,
    use_gpio_bitbang: bool,
    supports_slave: bool,
    supports_10bit: bool,
    supports_smbus: bool,
    supports_clock_stretch: bool,
    initialized: bool,
    master_busy: bool,
    slave_enabled: bool,
    slave_addr: u16,
    residual_log: RingBuf(ResidualRecord, 32),
}

// ─────────────────────────────────────────────────────────────
// SMBus Transaction Types
// ─────────────────────────────────────────────────────────────

type SmbusXactType = enum {
    QuickCommand     = 0,
    ReceiveByte      = 1,
    SendByte         = 2,
    ReadByte         = 3,
    WriteByte        = 4,
    ReadWord         = 5,
    WriteWord        = 6,
    BlockRead        = 7,
    BlockWrite       = 8,
    I2cReadBlock     = 9,
    I2cWriteBlock    = 10,
    ProcCall         = 11,
    BlockProcCall    = 12,
}

// ─────────────────────────────────────────────────────────────
// SMBus Transaction
// ─────────────────────────────────────────────────────────────

struct SmbusTransaction {
    xact_type: SmbusXactType,
    addr: u8,
    command: u8,
    data: Array(u8, 256),
    data_len: u16,
    pec: u8,
    use_pec: bool,
}

// ─────────────────────────────────────────────────────────────
// Controller State
// ─────────────────────────────────────────────────────────────

struct I2cController {
    controller_identity: Identity,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    adapters: Array(I2cAdapter, 8),
    adapter_count: u8,
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct I2cDriverState {
    driver_identity: Identity,
    controllers: Array(I2cController, 4),
    controller_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_transfers: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// I2C MMIO Register Read/Write (DesignWare-style)
// ─────────────────────────────────────────────────────────────

fn i2c_mmio_read32(base: u64, offset: u64) -> u32
    effect [memory:mmio]
{
    return trusted reason "I2C MMIO register read, DesignWare I2C Databook §3.2" {
        let ptr: *(u32) = (base + offset) as *(u32);
        return *ptr;
    };
}

fn i2c_mmio_write32(base: u64, offset: u64, value: u32) -> void
    effect [memory:mmio]
{
    trusted reason "I2C MMIO register write" {
        let ptr: *(u32) = (base + offset) as *(u32);
        *ptr = value;
    };
}

// ─────────────────────────────────────────────────────────────
// Wait for I2C Bus Idle
// ─────────────────────────────────────────────────────────────

fn i2c_wait_idle(
    adapter: Handle(I2cAdapter),
    timeout_us: u64,
) -> Result(void, I2cError)
    effect [memory:mmio, deterministic]
    court "i2c_wait_idle:v1"
{
    if adapter.use_gpio_bitbang {
        return Result::Ok(void);
    };

    let status_off: u64 = 0x04;
    loop bound 10000 {
        let status: u32 = i2c_mmio_read32(adapter.regs_base, status_off);
        if (status & 0x02) == 0 {
            return Result::Ok(void);
        };
    };

    return Result::Err(I2cError::I2cTimeout);
}

// ─────────────────────────────────────────────────────────────
// I2C Master Transmit (Legacy MMIO, e.g., DesignWare)
// ─────────────────────────────────────────────────────────────

fn i2c_master_xmit(
    adapter: Handle(I2cAdapter),
    addr: u16,
    buf: Array(u8, 256),
    len: u16,
    is_read: bool,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u16, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_master_xmit:v1"
{
    if !cap.can_master {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    if addr >= 0x80 && !cap.can_10bit_addr {
        return Result::Err(I2cError::I2cInvalidAddress);
    };

    if adapter.master_busy {
        return Result::Err(I2cError::I2cMasterBusy);
    };

    let idle_result: Result(void, I2cError) = i2c_wait_idle(adapter, 1000);
    match idle_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    adapter.master_busy = true;

    let cmd_off: u64 = 0x00;
    let targ_addr: u32;
    if cap.can_10bit_addr && addr >= 0x80 {
        targ_addr = 0x80000000 | (addr as u32);
    } else {
        targ_addr = (addr as u32) & 0x7F;
    };
    if is_read {
        targ_addr = targ_addr | 0x01;
    };

    i2c_mmio_write32(adapter.regs_base, cmd_off, targ_addr);

    if !is_read {
        loop bound 256 {
            let mut i: u64 = 0;
            if i >= (len as u64) {
                break;
            };
            let data_off: u64 = 0x08;
            i2c_mmio_write32(adapter.regs_base, data_off, buf[i] as u32);
            i = i + 1;
        };
    };

    adapter.master_busy = false;

    residual emit {
        op: "i2c.master_xmit",
        addr: addr as u64,
        len: len as u64,
        is_read: is_read,
        timestamp: timestamp,
    };

    return Result::Ok(len);
}

// ─────────────────────────────────────────────────────────────
// I2C Master Receive
// ─────────────────────────────────────────────────────────────

fn i2c_master_recv(
    adapter: Handle(I2cAdapter),
    addr: u16,
    buf: Handle(Array(u8, 256)),
    len: u16,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u16, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_master_recv:v1"
{
    let xmit_result: Result(u16, I2cError) = i2c_master_xmit(adapter, addr, Array::zeroed(), len, true, cap, timestamp);
    match xmit_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(rx_len) => {
            loop bound 256 {
                let mut i: u64 = 0;
                if i >= (rx_len as u64) {
                    break;
                };
                let data_off: u64 = 0x10;
                let val: u32 = i2c_mmio_read32(adapter.regs_base, data_off);
                buf.val[i] = (val & 0xFF) as u8;
                i = i + 1;
            };
            residual emit {
                op: "i2c.master_recv",
                addr: addr as u64,
                len: rx_len as u64,
                timestamp: timestamp,
            };
            return Result::Ok(rx_len);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// I2C Combined Transaction (write then read with repeated start)
// ─────────────────────────────────────────────────────────────

fn i2c_combined_transaction(
    adapter: Handle(I2cAdapter),
    addr: u16,
    write_buf: Array(u8, 256),
    write_len: u16,
    read_buf: Handle(Array(u8, 256)),
    read_len: u16,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u16, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_combined_transaction:v1"
{
    if !cap.can_combined_xact {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    let write_result: Result(u16, I2cError) = i2c_master_xmit(adapter, addr, write_buf, write_len, false, cap, timestamp);
    match write_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let read_result: Result(u16, I2cError) = i2c_master_recv(adapter, addr, read_buf, read_len, cap, timestamp);
    match read_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(rx) => {
            residual emit {
                op: "i2c.combined_transaction",
                addr: addr as u64,
                write_len: write_len as u64,
                read_len: rx as u64,
                timestamp: timestamp,
            };
            return Result::Ok(rx);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// SMBus Send Byte
// ─────────────────────────────────────────────────────────────

fn i2c_smbus_send_byte(
    adapter: Handle(I2cAdapter),
    addr: u8,
    byte: u8,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(void, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_smbus_send_byte:v1"
{
    if !cap.can_smbus {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    let buf: Array(u8, 256) = [byte; 256];
    let result: Result(u16, I2cError) = i2c_master_xmit(adapter, addr as u16, buf, 1, false, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "i2c.smbus_send_byte",
                addr: addr as u64,
                byte: byte as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// SMBus Read Byte (command + receive byte)
// ─────────────────────────────────────────────────────────────

fn i2c_smbus_read_byte(
    adapter: Handle(I2cAdapter),
    addr: u8,
    command: u8,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u8, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_smbus_read_byte:v1"
{
    if !cap.can_smbus {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    let wbuf: Array(u8, 256) = [command; 256];
    let rbuf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());
    let result: Result(u16, I2cError) = i2c_combined_transaction(adapter, addr as u16, wbuf, 1, rbuf, 1, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "i2c.smbus_read_byte",
                addr: addr as u64,
                command: command as u64,
                timestamp: timestamp,
            };
            return Result::Ok(rbuf.val[0]);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// SMBus Read Word
// ─────────────────────────────────────────────────────────────

fn i2c_smbus_read_word(
    adapter: Handle(I2cAdapter),
    addr: u8,
    command: u8,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u16, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_smbus_read_word:v1"
{
    if !cap.can_smbus {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    let wbuf: Array(u8, 256) = [command; 256];
    let rbuf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());
    let result: Result(u16, I2cError) = i2c_combined_transaction(adapter, addr as u16, wbuf, 1, rbuf, 2, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            let word: u16 = (rbuf.val[0] as u16) | ((rbuf.val[1] as u16) << 8);
            residual emit {
                op: "i2c.smbus_read_word",
                addr: addr as u64,
                command: command as u64,
                timestamp: timestamp,
            };
            return Result::Ok(word);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// SMBus Write Word
// ─────────────────────────────────────────────────────────────

fn i2c_smbus_write_word(
    adapter: Handle(I2cAdapter),
    addr: u8,
    command: u8,
    word: u16,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(void, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_smbus_write_word:v1"
{
    if !cap.can_smbus {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    let wbuf: Array(u8, 256) = Array::zeroed();
    wbuf[0] = command;
    wbuf[1] = (word & 0xFF) as u8;
    wbuf[2] = ((word >> 8) & 0xFF) as u8;

    let result: Result(u16, I2cError) = i2c_master_xmit(adapter, addr as u16, wbuf, 3, false, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "i2c.smbus_write_word",
                addr: addr as u64,
                command: command as u64,
                word: word as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// SMBus Block Read
// ─────────────────────────────────────────────────────────────

fn i2c_smbus_block_read(
    adapter: Handle(I2cAdapter),
    addr: u8,
    command: u8,
    buf: Handle(Array(u8, 256)),
    max_len: u8,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u8, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_smbus_block_read:v1"
{
    if !cap.can_smbus {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    let wbuf: Array(u8, 256) = [command; 256];
    let rbuf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());
    let result: Result(u16, I2cError) = i2c_combined_transaction(adapter, addr as u16, wbuf, 1, rbuf, (max_len as u16) + 1, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(len) => {
            let block_len: u8 = rbuf.val[0];
            loop bound 256 {
                let mut i: u64 = 0;
                if i >= (block_len as u64) || i >= (max_len as u64) {
                    break;
                };
                buf.val[i] = rbuf.val[i + 1];
                i = i + 1;
            };
            residual emit {
                op: "i2c.smbus_block_read",
                addr: addr as u64,
                command: command as u64,
                block_len: block_len as u64,
                timestamp: timestamp,
            };
            return Result::Ok(block_len);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// Device Address Detection (Scan)
// ─────────────────────────────────────────────────────────────

fn i2c_probe_address(
    adapter: Handle(I2cAdapter),
    addr: u8,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(bool, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_probe_address:v1"
{
    let buf: Array(u8, 256) = Array::zeroed();
    let result: Result(u16, I2cError) = i2c_master_xmit(adapter, addr as u16, buf, 0, false, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "i2c.probe_address",
                addr: addr as u64,
                found: true,
                timestamp: timestamp,
            };
            return Result::Ok(true);
        },
        Result::Err(I2cError::I2cDeviceNoAck) => {
            return Result::Ok(false);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// GPIO Bitbang I2C Fallback: SDA/SCL control
// ─────────────────────────────────────────────────────────────

fn i2c_gpio_bitbang_start(
    adapter: Handle(I2cAdapter),
    cap: I2cCapability,
    timestamp: u64,
) -> Result(void, I2cError)
    effect [deterministic, residual]
    court "i2c_gpio_bitbang_start:v1"
{
    if !cap.can_gpio_bitbang {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    residual emit {
        op: "i2c.gpio_bitbang_start",
        bus_id: adapter.bus_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

fn i2c_gpio_bitbang_stop(
    adapter: Handle(I2cAdapter),
    cap: I2cCapability,
    timestamp: u64,
) -> Result(void, I2cError)
    effect [deterministic, residual]
    court "i2c_gpio_bitbang_stop:v1"
{
    if !cap.can_gpio_bitbang {
        return Result::Err(I2cError::I2cCapabilityError);
    };

    residual emit {
        op: "i2c.gpio_bitbang_stop",
        bus_id: adapter.bus_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Bus Speed
// ─────────────────────────────────────────────────────────────

fn i2c_set_speed(
    adapter: Handle(I2cAdapter),
    speed: I2cBusSpeed,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(void, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_set_speed:v1"
{
    let freq: u32;
    if speed == I2cBusSpeed::StandardMode {
        freq = 100000;
    } else if speed == I2cBusSpeed::FastMode {
        freq = 400000;
    } else if speed == I2cBusSpeed::FastModePlus {
        freq = 1000000;
    } else if speed == I2cBusSpeed::HighSpeedMode {
        freq = 3400000;
    } else {
        freq = 5000000;
    };

    let speed_off: u64 = 0x0C;
    i2c_mmio_write32(adapter.regs_base, speed_off, freq);

    adapter.speed = speed;
    adapter.freq_hz = freq;

    residual emit {
        op: "i2c.set_speed",
        bus_id: adapter.bus_id as u64,
        speed_hz: freq,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Adapter Init
// ─────────────────────────────────────────────────────────────

fn i2c_adapter_init(
    adapter: Handle(I2cAdapter),
    bus_id: u8,
    regs_base: u64,
    speed: I2cBusSpeed,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(void, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_adapter_init:v1"
{
    adapter.bus_id = bus_id;
    adapter.regs_base = regs_base;
    adapter.speed = speed;
    adapter.supports_slave = cap.can_slave;
    adapter.supports_10bit = cap.can_10bit_addr;
    adapter.supports_smbus = cap.can_smbus;
    adapter.supports_clock_stretch = cap.can_clock_stretch;

    let speed_result: Result(void, I2cError) = i2c_set_speed(adapter, speed, cap, timestamp);
    match speed_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    if !adapter.use_gpio_bitbang {
        let cmd_off: u64 = 0x00;
        i2c_mmio_write32(adapter.regs_base, cmd_off, 0x00);
    };

    adapter.initialized = true;

    residual emit {
        op: "i2c.adapter_init",
        bus_id: bus_id as u64,
        regs_base: regs_base,
        speed_hz: adapter.freq_hz,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn i2c_driver_init(
    driver_identity: Identity,
    cap: I2cCapability,
    timestamp: u64,
) -> I2cDriverState
    effect [deterministic, residual]
    court "i2c_driver_init:v1"
{
    let state: I2cDriverState = I2cDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_transfers: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "i2c.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add I2C Adapter to Controller
// ─────────────────────────────────────────────────────────────

fn i2c_add_adapter(
    controller: Handle(I2cController),
    bus_id: u8,
    regs_base: u64,
    speed: I2cBusSpeed,
    use_gpio_bitbang: bool,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u8, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_add_adapter:v1"
{
    if (controller.adapter_count as u64) >= 8 {
        return Result::Err(I2cError::I2cMaxDevicesExceeded);
    };

    let idx: u64 = controller.adapter_count as u64;
    let adapter: Handle(I2cAdapter) = Handle(I2cAdapter)::from_ptr(&controller.adapters[idx]);
    adapter.use_gpio_bitbang = use_gpio_bitbang;

    let init_result: Result(void, I2cError) = i2c_adapter_init(adapter, bus_id, regs_base, speed, cap, timestamp);
    match init_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    controller.adapter_count = controller.adapter_count + 1;

    residual emit {
        op: "i2c.add_adapter",
        bus_id: bus_id as u64,
        regs_base: regs_base,
        speed: speed as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx as u8);
}

// ─────────────────────────────────────────────────────────────
// I2C Add Controller from PCI Discovery
// ─────────────────────────────────────────────────────────────

fn i2c_add_controller(
    state: Handle(I2cDriverState),
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    cap: I2cCapability,
    timestamp: u64,
) -> Result(u64, I2cError)
    effect [memory:mmio, deterministic, residual]
    court "i2c_add_controller:v1"
{
    if state.controller_count >= 4 {
        return Result::Err(I2cError::I2cMaxDevicesExceeded);
    };

    let idx: u64 = state.controller_count;
    let ctrl_identity: Identity = identity_new(0x493243, timestamp, idx, pci_bus as u64);

    let ctrl: I2cController = I2cController {
        controller_identity: ctrl_identity,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        adapters: Array::zeroed(),
        adapter_count: 0,
        initialized: true,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.controllers[idx] = ctrl;
    state.controller_count = state.controller_count + 1;

    residual emit {
        op: "i2c.add_controller",
        controller_idx: idx,
        mmio_base: mmio_base,
        pci_bus: pci_bus as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}
