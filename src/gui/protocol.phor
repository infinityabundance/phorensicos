// ──────────────────────────────────────────────
// Protocol Error Codes
// ──────────────────────────────────────────────

enum ProtocolErrorCode {
    Success,
    InvalidCapability,
    CapabilityRevoked,
    SurfaceNotFound(u64),
    SurfaceDestroyed(u64),
    InvalidSurfaceState(u64),
    BufferNotFound(u64),
    BufferInUse(u64),
    InvalidBufferFormat,
    OutOfMemory,
    MaxSurfacesExceeded(u64),
    MaxClientsExceeded,
    PermissionDenied(u64),
    ProtocolVersionMismatch(u64, u64),
    InvalidMessage(u64),
    SessionNotFound(u64),
    SessionSuspended(u64),
    OperationNotSupported(u64),
    ResourceBusy(u64),
    GenerationStale(u64, u64),
    InternalError(u64),
    CourtRejected(Str(64)),
}

// ──────────────────────────────────────────────
// Serialization Helpers
// ──────────────────────────────────────────────

// Compute the wire size of a protocol header
fn header_wire_size() -> u32
    effect [compute]
{
    // 8 fields × 8 bytes = 64 bytes fixed
    return 64;
}

// Check if a protocol message fits in maximum allowed size
fn message_fits(payload_len: u32) -> bool
    effect [compute]
{
    let total: u32 = header_wire_size() + payload_len;
    return total <= MAX_PROTOCOL_MSG_SIZE;
}

// Serialize a u32 into a byte buffer at an offset
fn serialize_u32(buf: Slice(u8), offset: u32, value: u32) -> Result(u32, ProtocolErrorCode)
    effect [io:write, compute]
    bound iterations 4
{
    if offset + 4 > buf.len() {
        return Result::Err(ProtocolErrorCode::InvalidMessage(0));
    }
    buf[offset] = (value & 0xFF) as u8;
    buf[offset + 1] = ((value >> 8) & 0xFF) as u8;
    buf[offset + 2] = ((value >> 16) & 0xFF) as u8;
    buf[offset + 3] = ((value >> 24) & 0xFF) as u8;
    return Result::Ok(offset + 4);
}

// Serialize a u64 into a byte buffer at an offset
fn serialize_u64(buf: Slice(u8), offset: u32, value: u64) -> Result(u32, ProtocolErrorCode)
    effect [io:write, compute]
    bound iterations 8
{
    if offset + 8 > buf.len() {
        return Result::Err(ProtocolErrorCode::InvalidMessage(0));
    }
    let mut i: u32 = 0;
    loop bound 8 {
        if i >= 8 { break; }
        buf[offset + i] = ((value >> (i * 8)) & 0xFF) as u8;
        i = i + 1;
    }
    return Result::Ok(offset + 8);
}

// Deserialize a u32 from a byte buffer at an offset
fn deserialize_u32(buf: Slice(u8), offset: u32) -> Result((u32, u32), ProtocolErrorCode)
    effect [io:read, compute]
{
    if offset + 4 > buf.len() {
        return Result::Err(ProtocolErrorCode::InvalidMessage(0));
    }
    let value: u32 = (buf[offset] as u32)
        | ((buf[offset + 1] as u32) << 8)
        | ((buf[offset + 2] as u32) << 16)
        | ((buf[offset + 3] as u32) << 24);
    return Result::Ok((value, offset + 4));
}

// Deserialize a u64 from a byte buffer at an offset
fn deserialize_u64(buf: Slice(u8), offset: u32) -> Result((u64, u32), ProtocolErrorCode)
    effect [io:read, compute]
{
    if offset + 8 > buf.len() {
        return Result::Err(ProtocolErrorCode::InvalidMessage(0));
    }
    let mut value: u64 = 0;
    let mut i: u32 = 0;
    loop bound 8 {
        if i >= 8 { break; }
        value = value | ((buf[offset + i] as u64) << (i * 8));
        i = i + 1;
    }
    return Result::Ok((value, offset + 8));
}

// Serialize a protocol header
fn serialize_header(header: ProtocolHeader, buf: Slice(u8)) -> Result(u32, ProtocolErrorCode)
    effect [io:write, compute]
{
    let mut off: u32 = 0;
    // opcode as u64 tag
    // For the protocol, we use a simplified encoding:
    // each enum is encoded as its discriminant u64
    let op_tag: u64 = 0; // placeholder — real encoding would convert opcode
    let res1: Result(u32, ProtocolErrorCode) = serialize_u64(buf, off, op_tag);
    off = match res1 {
        Result::Ok(n) => { n }
        Result::Err(e) => { return Result::Err(e); }
    };
    let res2: Result(u32, ProtocolErrorCode) = serialize_u64(buf, off, header.serial);
    off = match res2 {
        Result::Ok(n) => { n }
        Result::Err(e) => { return Result::Err(e); }
    };
    let res3: Result(u32, ProtocolErrorCode) = serialize_u64(buf, off, header.sender_id);
    off = match res3 {
        Result::Ok(n) => { n }
        Result::Err(e) => { return Result::Err(e); }
    };
    let res4: Result(u32, ProtocolErrorCode) = serialize_u64(buf, off, header.capability_id);
    off = match res4 {
        Result::Ok(n) => { n }
        Result::Err(e) => { return Result::Err(e); }
    };
    let res5: Result(u32, ProtocolErrorCode) = serialize_u64(buf, off, header.generation);
    off = match res5 {
        Result::Ok(n) => { n }
        Result::Err(e) => { return Result::Err(e); }
    };
    let res6: Result(u32, ProtocolErrorCode) = serialize_u32(buf, off, header.payload_len);
    off = match res6 {
        Result::Ok(n) => { n }
        Result::Err(e) => { return Result::Err(e); }
    };
    return Result::Ok(off);
}

// Deserialize a protocol header
fn deserialize_header(buf: Slice(u8), offset: u32) -> Result((ProtocolHeader, u32), ProtocolErrorCode)
    effect [io:read, compute]
{
    let r_op: Result((u64, u32), ProtocolErrorCode) = deserialize_u64(buf, offset);
    let (op_val, off): (u64, u32) = match r_op {
        Result::Ok(v) => { v }
        Result::Err(e) => { return Result::Err(e); }
    };
    let r_ser: Result((u64, u32), ProtocolErrorCode) = deserialize_u64(buf, off);
    let (serial, off): (u64, u32) = match r_ser {
        Result::Ok(v) => { v }
        Result::Err(e) => { return Result::Err(e); }
    };
    let r_sid: Result((u64, u32), ProtocolErrorCode) = deserialize_u64(buf, off);
    let (sender_id, off): (u64, u32) = match r_sid {
        Result::Ok(v) => { v }
        Result::Err(e) => { return Result::Err(e); }
    };
    let r_cap: Result((u64, u32), ProtocolErrorCode) = deserialize_u64(buf, off);
    let (capability_id, off): (u64, u32) = match r_cap {
        Result::Ok(v) => { v }
        Result::Err(e) => { return Result::Err(e); }
    };
    let r_gen: Result((u64, u32), ProtocolErrorCode) = deserialize_u64(buf, off);
    let (generation, off): (u64, u32) = match r_gen {
        Result::Ok(v) => { v }
        Result::Err(e) => { return Result::Err(e); }
    };
    let r_len: Result((u32, u32), ProtocolErrorCode) = deserialize_u32(buf, off);
    let (payload_len, off): (u32, u32) = match r_len {
        Result::Ok(v) => { v }
        Result::Err(e) => { return Result::Err(e); }
    };
    let header: ProtocolHeader = ProtocolHeader {
        opcode: ProtocolOpcode::Connect, // placeholder
        serial: serial,
        sender_id: sender_id,
        capability_id: capability_id,
        generation: generation,
        payload_len: payload_len,
    };
    return Result::Ok((header, off));
}

// ──────────────────────────────────────────────
// Protocol Validation
// ──────────────────────────────────────────────

// Validate a protocol version against supported versions
fn validate_protocol_version(major: u64, minor: u64) -> bool
    effect [compute]
{
    if major != PROTOCOL_MAJOR {
        return false;
    }
    if minor > PROTOCOL_MINOR {
        return false;
    }
    return true;
}

// Check a capability grant for validity
fn validate_capability(session: SessionInfo, cap_id: u64) -> bool
    effect [compute]
{
    if session.state != SessionState::Active {
        return false;
    }
    let found: bool = false;
    for i in 0..MAX_CAP_GRANTS {
        let cap: Option(SessionCapability) = session.capabilities[i];
        match cap {
            Option::Some(c) => {
                if c.cap_id as u64 == cap_id {
                    if !c.revoked {
                        return true;
                    }
                    return false;
                }
            }
            Option::None => {
                // continue
            }
        }
    }
    return false;
}

// Generate a unique serial for a message
fn next_serial(counter: u64) -> u64
    effect [compute]
{
    return counter + 1;
}

// ──────────────────────────────────────────────
// Convenience Constructors
// ──────────────────────────────────────────────

fn make_point(x: i32, y: i32) -> Point
    effect [compute]
{
    return Point { x: x, y: y };
}

fn make_size(w: u32, h: u32) -> Size
    effect [compute]
{
    return Size { width: w, height: h };
}

fn make_rect(x: i32, y: i32, w: u32, h: u32) -> Rectangle
    effect [compute]
{
    return Rectangle { x: x, y: y, width: w, height: h };
}

fn rect_contains(r: Rectangle, px: i32, py: i32) -> bool
    effect [compute]
{
    if px < r.x { return false; }
    if py < r.y { return false; }
    if px >= r.x + (r.width as i32) { return false; }
    if py >= r.y + (r.height as i32) { return false; }
    return true;
}

fn rect_intersects(a: Rectangle, b: Rectangle) -> bool
    effect [compute]
{
    if a.x >= b.x + (b.width as i32) { return false; }
    if b.x >= a.x + (a.width as i32) { return false; }
    if a.y >= b.y + (b.height as i32) { return false; }
    if b.y >= a.y + (a.height as i32) { return false; }
    return true;
}

fn color_rgba(r: u8, g: u8, b: u8, a: u8) -> ColorRGBA
    effect [compute]
{
    return ColorRGBA { r: r, g: g, b: b, a: a };
}

fn color_black() -> ColorRGBA
    effect [compute]
{
    return ColorRGBA { r: 0, g: 0, b: 0, a: 255 };
}

fn color_white() -> ColorRGBA
    effect [compute]
{
    return ColorRGBA { r: 255, g: 255, b: 255, a: 255 };
}

fn color_transparent() -> ColorRGBA
    effect [compute]
{
    return ColorRGBA { r: 0, g: 0, b: 0, a: 0 };
}

// ──────────────────────────────────────────────
// Capability Grant Helpers
// ──────────────────────────────────────────────

fn make_cap_grant(cap: CapabilityId, from: u64, to: u64, now: u64) -> CapGrantRecord
    effect [compute, residual]
{
    let rec: CapGrantRecord = CapGrantRecord {
        cap_id: cap,
        derived_from: CapabilityDerivation::Direct(from),
        granted_to: to,
        granted_by: from,
        timestamp_ns: now,
        court: "gui:protocol:v1",
        expires_at: now + 3600000000000, // 1 hour default
        revoked: false,
    };
    residual emit {
        op: "cap:grant",
        cap: cap as u64,
        from: from,
        to: to,
        timestamp: now,
    };
    return rec;
}

fn revoke_capability(rec: CapGrantRecord, now: u64) -> CapGrantRecord
    effect [compute, residual]
{
    let updated: CapGrantRecord = CapGrantRecord {
        cap_id: rec.cap_id,
        derived_from: rec.derived_from,
        granted_to: rec.granted_to,
        granted_by: rec.granted_by,
        timestamp_ns: rec.timestamp_ns,
        court: rec.court,
        expires_at: rec.expires_at,
        revoked: true,
    };
    residual emit {
        op: "cap:revoke",
        cap: updated.cap_id as u64,
        target: updated.granted_to,
        timestamp: now,
    };
    return updated;
}

// ──────────────────────────────────────────────
// Damage Region Tracking
// ──────────────────────────────────────────────

fn make_damage(rect: Rectangle, serial: u64) -> DamageRegion
    effect [compute]
{
    return DamageRegion { rect: rect, serial: serial };
}

fn mark_damage(regions: Slice(DamageRegion), rect: Rectangle, serial: u64, max_regions: u64) -> bool
    effect [compute]
{
    for i in 0..max_regions {
        if i >= regions.len() { break; }
        // Use a simplified damage region — just check if there's space
        // In a real implementation, merge overlapping regions
    }
    return false; // real impl would report if space was available
}

// ──────────────────────────────────────────────
// Present Receipt Factory
// ──────────────────────────────────────────────

fn make_present_receipt(sid: u64, bid: u64, mode: PresentMode, ts: u64, seq: u64, vsync: u64) -> PresentReceipt
    effect [compute, residual]
{
    let receipt: PresentReceipt = PresentReceipt {
        surface_id: sid,
        buffer_id: bid,
        present_mode: mode,
        timestamp_ns: ts,
        seq: seq,
        vsync_count: vsync,
        consumed: false,
    };
    residual emit {
        op: "present:receipt",
        surface: sid,
        buffer: bid,
        seq: seq,
        timestamp: ts,
    };
    return receipt;
}

fn consume_receipt(receipt: PresentReceipt) -> PresentReceipt
    effect [compute]
{
    return PresentReceipt {
        surface_id: receipt.surface_id,
        buffer_id: receipt.buffer_id,
        present_mode: receipt.present_mode,
        timestamp_ns: receipt.timestamp_ns,
        seq: receipt.seq,
        vsync_count: receipt.vsync_count,
        consumed: true,
    };
}

// ──────────────────────────────────────────────
// Type Conversion Helpers
// ──────────────────────────────────────────────

fn rectangle_area(r: Rectangle) -> u64
    effect [compute]
{
    return (r.width as u64) * (r.height as u64);
}

fn size_equal(a: Size, b: Size) -> bool
    effect [compute]
{
    return a.width == b.width && a.height == b.height;
}

fn point_equal(a: Point, b: Point) -> bool
    effect [compute]
{
    return a.x == b.x && a.y == b.y;
}
