fn test_http_forwarded_header() -> void
    effect [compute, residual]
{
    let forwarded: Str(64) = Str::from("X-Forwarded-For: 10.0.0.1, 10.0.0.2");
    let xff: Str(64) = Str::from("X-Forwarded-For: 10.0.0.1");
    assert(forwarded.len() > xff.len(), "http: proxy chain detected");
    residual emit { op: "http.test.forwarded", proxies: 2, };
}

fn test_http_rate_limiting_headers() -> void
    effect [compute, residual]
{
    let rate_limit: Str(64) = Str::from("X-RateLimit-Limit: 100");
    let rate_remaining: Str(64) = Str::from("X-RateLimit-Remaining: 99");
    let rate_reset: Str(64) = Str::from("X-RateLimit-Reset: 3600");
    assert(rate_limit.len() > 0, "http: rate limit header");
    assert(rate_remaining.len() > 0, "http: rate remaining");
    assert(rate_reset.len() > 0, "http: rate reset");
    residual emit { op: "http.test.ratelimit", limit: 100, };
}

