    creation_timestamp: u64,
    creation_epoch: u64,
    nonce: u64,
    creator: u64,
}

struct ProvenanceRecord {
    creator_identity: Identity,
    creation_receipt_hash: u64,
    parent_identities: Array(Identity, 8),
    compilation_receipt: Option(u64),
    porting_receipt: Option(u64),
    court_verdicts: RingBuf(CourtVerdictRef, 16),
}

struct CourtVerdictRef {
    court_id: u64,
    verdict_timestamp: u64,
    verdict_hash: u64,
    trust_state_before: TrustState,
    trust_state_after: TrustState,
}

// ─────────────────────────────────────────────────────────────
// Trust State
// ─────────────────────────────────────────────────────────────

type TrustState = enum {
    Unknown          = 0,
    Observed         = 1,
    Replayed         = 2,
    OracleCompared   = 3,
    ResidualStable   = 4,
    Sealed           = 5,
    Promoted         = 6,
}

// ─────────────────────────────────────────────────────────────
