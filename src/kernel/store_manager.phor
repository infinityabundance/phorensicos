// store_manager.phor — Forensic store kernel interface
// Store, resolve, verify, provenance, and residual management for the immutable store
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/kernel/store_manager.phor
// Court: store_manager:v2

package kernel.store_manager;

import kernel.nucleus_interface.*;
import kernel.capability_manager.*;
import kernel.session_manager.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type StoreError = enum {
    StoreObjectNotFound    = 0x50,  // E0050: object not found in store
    StoreHashMismatch      = 0x51,  // E0051: stored hash does not match content
    StoreIntegrityFailure  = 0x52,  // E0052: integrity check failed
    StoreProofViolation    = 0x53,  // E0053: proof chain is invalid
    StoreCapabilityError   = 0x54,  // E0054: insufficient capability for store operation
    StoreFull              = 0x55,  // E0055: store has reached maximum capacity
    StoreMetadataMissing   = 0x56,  // E0056: required metadata is missing
    StoreReceiptMissing    = 0x57,  // E0057: required receipt is missing
    StoreSignatureInvalid  = 0x58,  // E0058: signature verification failed
    StoreProvenanceMissing = 0x59,  // E0059: provenance record is missing
    StoreTrustInsufficient = 0x5A,  // E005A: trust state below required threshold
    StoreGenerationMismatch = 0x5B, // E005B: generation tag does not match store state
    StoreResidualCorrupted = 0x5C,  // E005C: residual record integrity check failed
    StoreDialectMismatch   = 0x5D,  // E005D: dialect profile mismatch
    StoreObjectSealed      = 0x5E,  // E005E: object is sealed and cannot be modified
    StoreKeyConflict       = 0x5F,  // E005F: content hash conflicts with existing object
    StoreBackendIOError    = 0x60,  // E0060: underlying storage backend I/O error
}

// ─────────────────────────────────────────────────────────────
// Store Key Types
// ─────────────────────────────────────────────────────────────

struct StoreKey {
    hash: u64,
    hash_high: u64,       // 128-bit hash total
    algorithm: HashAlgorithm,
    size_hint: u64,
}

type HashAlgorithm = enum {
    PhorHash128  = 0,  // Native Phorensic 128-bit residual hash
    Sha256       = 1,  // SHA-256 (for dialect compatibility)
    Blake3       = 2,  // BLAKE3 (fast hashing)
    ResidualHash = 3,  // Content-defined residual hash
    CourtHash    = 4,  // Court-verified hash algorithm
}

// ─────────────────────────────────────────────────────────────
// Store Object
// ─────────────────────────────────────────────────────────────

struct StoreObject {
    store_key: StoreKey,
    content: Array(u8, 65536),
    content_length: u64,
    metadata: StoreMetadata,
    provenance: StoreProvenance,
    residual_history: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    verification_status: VerificationStatus,
    object_type: StoreObjectType,
    seal_state: SealState,
    creation_timestamp: u64,
    last_verified_timestamp: u64,
    refcount: u64,
}

struct StoreMetadata {
    source_hash: u64,
    dialect_profile: String(64),
    build_recipe_hash: u64,
    compiler_version: String(32),
    target_arch: String(16),
    effect_profile_hash: u64,
    oracle_identities: Array(Identity, 8),
    court_versions: Array(u64, 8),
    build_environment_hash: u64,
    expansion_receipts: Array(u64, 16),
    compiler_pass_receipts: Array(u64, 16),
    replay_checkpoints: Array(u64, 16),
    label: String(256),
    description: String(512),
}

type StoreObjectType = enum {
    KernelImage       = 0,
    NucleusImage      = 1,
    DriverBinary      = 2,
    ServiceContainer  = 3,
    PackageContainer  = 4,
    SourceSnapshot    = 5,
    CompilerReceipt   = 6,
    CourtVerdict      = 7,
    ResidualLog       = 8,
    DialectProfile    = 9,
    GenerationSnapshot = 10,
    ProfileConfig     = 11,
    BuildRecipe       = 12,
    OracleReference   = 13,
    EvidenceLog       = 14,
    TrustRoot         = 15,
}

type VerificationStatus = enum {
    Unverified        = 0,
    HashMatch         = 1,
    IntegrityPassed   = 2,
    SignatureVerified = 3,
    ReceiptChainValid = 4,
    FullVerification  = 5,
    VerificationFailed = 6,
}

type SealState = enum {
    Unsealed     = 0,
    Sealing      = 1,
    Sealed       = 2,
    TamperDetected = 3,
}

// ─────────────────────────────────────────────────────────────
// Store Provenance
// ─────────────────────────────────────────────────────────────

struct StoreProvenance {
    creator_identity: Identity,
    creation_receipt_hash: u64,
    source_snapshot_key: Option(StoreKey),
    parent_object_keys: Array(StoreKey, 16),
    parent_count: u64,
    build_recipe_key: Option(StoreKey),
    compiler_receipt_key: Option(StoreKey),
    porting_receipt_key: Option(StoreKey),
    court_verdict_keys: Array(StoreKey, 8),
    court_count: u64,
    provenance_chain: RingBuf(ProvenanceLink, 32),
}

struct ProvenanceLink {
    link_type: ProvenanceLinkType,
    linked_key: StoreKey,
    timestamp: u64,
    justification: String(128),
    verifier_identity: Identity,
}

type ProvenanceLinkType = enum {
    SourceDerivation   = 0,
    Compilation        = 1,
    Porting            = 2,
    CourtVerdict       = 3,
    TrustPromotion     = 4,
    DialectTranslation = 5,
    ManualAttestation  = 6,
    AutomaticVerification = 7,
}

// ─────────────────────────────────────────────────────────────
// Store Manager State
// ─────────────────────────────────────────────────────────────

struct StoreManagerState {
    objects: Array(StoreObject, 512),
    object_count: u64,
    key_index: Array(StoreKey, 512),
    max_objects: u64,
    manager_identity: Identity,
    capability_manager: Handle(CapabilityManagerState),
    initialization_timestamp: u64,
    audit_trail: RingBuf(AuditRecord, 256),
    default_trust_threshold: TrustState,
    integrity_check_enabled: bool,
    store_path_base: String(128),
}

// ─────────────────────────────────────────────────────────────
// Verification Report
// ─────────────────────────────────────────────────────────────

struct VerificationReport {
    object_key: StoreKey,
    content_integrity: bool,
    signature_valid: bool,
    receipt_chain_integrity: bool,
    trust_state_consistency: bool,
    source_binary_correspondence: bool,
    all_checks_passed: bool,
    failed_checks: u64,
    total_checks: u64,
    verification_timestamp: u64,
    verifier_identity: Identity,
    residual_hash: u64,
}

// ─────────────────────────────────────────────────────────────
// Store Manager Initialization
// ─────────────────────────────────────────────────────────────

fn store_manager_init(
    manager_identity: Identity,
    cap_manager: Handle(CapabilityManagerState),
    timestamp: u64,
) -> StoreManagerState
    effect [deterministic]
    court "store_manager_init:v1"
{
    let state: StoreManagerState = StoreManagerState {
        objects: Array::zeroed(),
        object_count: 0,
        key_index: Array::zeroed(),
        max_objects: 512,
        manager_identity: manager_identity,
        capability_manager: cap_manager,
        initialization_timestamp: timestamp,
        audit_trail: RingBuf::new(),
        default_trust_threshold: TrustState::Observed,
        integrity_check_enabled: true,
        store_path_base: String::from_bytes(Slice(u8)::from_str("/store/objects/")),
    };

    residual emit {
        op: "store_manager.init",
        manager_identity: manager_identity.id_hash,
        timestamp: timestamp,
        max_objects: 512,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Hash Content (Deterministic)
// ─────────────────────────────────────────────────────────────

fn store_hash_content(data: Slice(u8), algorithm: HashAlgorithm) -> StoreKey
    effect [deterministic]
    court "store_hash:v1"
{
    let mut hash_low: u64 = 0;
    let mut hash_high: u64 = 0;
    let len: u64 = data.len();

    // PhorHash128: simple deterministic content hash
    for i in 0..len {
        let byte: u8 = data[i];
        let word: u64 = byte as u64;
        hash_low = hash_low ^ (word + 0x9e3779b97f4a7c15 + (hash_low << 6) + (hash_low >> 2));
        hash_high = hash_high ^ (word + 0x6b8b4567 + (hash_high << 7) + (hash_high >> 1));
    };

    // Fold in length
    hash_low = hash_low ^ (len + 0x517cc1b727220a95 + (hash_low << 5) + (hash_low >> 3));
    hash_high = hash_high ^ (len + 0xb3e90531 + (hash_high << 4) + (hash_high >> 2));

    let key: StoreKey = StoreKey {
        hash: hash_low,
        hash_high: hash_high,
        algorithm: algorithm,
        size_hint: len,
    };

    return key;
}

// ─────────────────────────────────────────────────────────────
// Store Object
// ─────────────────────────────────────────────────────────────

fn store_object(
    state: Handle(StoreManagerState),
    content: Slice(u8),
    metadata: StoreMetadata,
    provenance: StoreProvenance,
    object_type: StoreObjectType,
    store_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> Result(StoreObject, StoreError)
    effect [deterministic, residual]
    court "store_object:v2"
{
    // Check capacity
    if state.object_count >= state.max_objects {
        return Result::Err(StoreError::StoreFull);
    };

    // Hash content
    let key: StoreKey = store_hash_content(content, HashAlgorithm::PhorHash128);

    // Check for hash conflict
    for i in 0..state.object_count {
        if state.key_index[i].hash == key.hash
            && state.key_index[i].hash_high == key.hash_high
        {
            // Content collision — return existing object
            for j in 0..state.max_objects {
                if state.objects[j].store_key.hash == key.hash
                    && state.objects[j].store_key.hash_high == key.hash_high
                {
                    return Result::Ok(state.objects[j]);
                };
            };
        };
    };

    // Verify content hash matches
    let verify_key: StoreKey = store_hash_content(content, key.algorithm);
    if verify_key.hash != key.hash || verify_key.hash_high != key.hash_high {
        return Result::Err(StoreError::StoreHashMismatch);
    };

    // Find empty slot
    let mut slot_idx: u64 = 0;
    let mut found_slot: bool = false;
    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.content_length == 0 && obj.store_key.hash == 0 {
            slot_idx = i;
            found_slot = true;
            break;
        };
    };

    if !found_slot {
        return Result::Err(StoreError::StoreFull);
    };

    // Copy content into store
    let mut stored_content: Array(u8, 65536) = Array::zeroed();
    let copy_len: u64 = if content.len() < 65536 { content.len() } else { 65536 };
    for i in 0..copy_len {
        stored_content[i] = content[i];
    };

    let store_obj: StoreObject = StoreObject {
        store_key: key,
        content: stored_content,
        content_length: copy_len,
        metadata: metadata,
        provenance: provenance,
        residual_history: RingBuf::new(),
        trust_state: TrustState::Unknown,
        verification_status: VerificationStatus::Unverified,
        object_type: object_type,
        seal_state: SealState::Unsealed,
        creation_timestamp: timestamp,
        last_verified_timestamp: 0,
        refcount: 1,
    };

    state.objects[slot_idx] = store_obj;
    state.key_index[state.object_count] = key;
    state.object_count = state.object_count + 1;

    // Record creation residual
    let residual: ResidualRecord = ResidualRecord {
        timestamp: timestamp,
        event_type: 0x40,
        event_data_hash: key.hash,
        cause_identity: store_cap.object_id,
        prior_state_hash: 0,
        new_state_hash: key.hash_high,
        delta_description: String::from_bytes(Slice(u8)::from_str("object stored in forensic store")),
        generation_at_event: 0,
        verified: false,
    };

    residual emit {
        op: "store_manager.store",
        key_low: key.hash,
        key_high: key.hash_high,
        object_type: object_type as u64,
        content_length: copy_len,
        slot: slot_idx,
    };

    return Result::Ok(state.objects[slot_idx]);
}

// ─────────────────────────────────────────────────────────────
// Resolve Object by Key
// ─────────────────────────────────────────────────────────────

fn store_resolve(
    state: Handle(StoreManagerState),
    key: StoreKey,
    resolve_cap: Cap(CapabilityToken),
) -> Result(StoreObject, StoreError)
    effect [deterministic, residual]
    court "store_resolve:v1"
{
    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            // Record access residual
            let residual: ResidualRecord = ResidualRecord {
                timestamp: 0,
                event_type: 0x41,
                event_data_hash: key.hash,
                cause_identity: resolve_cap.object_id,
                prior_state_hash: 0,
                new_state_hash: key.hash_high,
                delta_description: String::from_bytes(Slice(u8)::from_str("object resolved from store")),
                generation_at_event: 0,
                verified: false,
            };

            residual emit {
                op: "store_manager.resolve",
                key_low: key.hash,
                key_high: key.hash_high,
            };

            return Result::Ok(obj);
        };
    };

    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Verify Object Integrity
// ─────────────────────────────────────────────────────────────

fn store_verify(
    state: Handle(StoreManagerState),
    key: StoreKey,
    verify_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> Result(VerificationReport, StoreError)
    effect [deterministic, residual]
    court "store_verify:v1"
{
    let mut obj_found: bool = false;
    let mut obj_idx: u64 = 0;

    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            obj_idx = i;
            obj_found = true;
            break;
        };
    };

    if !obj_found {
        return Result::Err(StoreError::StoreObjectNotFound);
    };

    let obj: Handle(StoreObject) = Handle(StoreObject)::from_ptr(&state.objects[obj_idx]);

    // Check 1: Content integrity
    let content_slice: Slice(u8) = Slice(u8)::from_array_ptr(obj.content, obj.content_length);
    let computed_key: StoreKey = store_hash_content(content_slice, obj.store_key.algorithm);
    let content_ok: bool = computed_key.hash == key.hash && computed_key.hash_high == key.hash_high;

    // Check 2: Signature (stub — in real system would verify cryptographic signatures)
    let signature_ok: bool = true;

    // Check 3: Receipt chain integrity
    let receipt_ok: bool = true;

    // Check 4: Trust state consistency
    let trust_ok: bool = obj.trust_state >= state.default_trust_threshold || obj.trust_state == TrustState::Unknown;

    // Check 5: Source-binary correspondence
    let source_ok: bool = obj.metadata.source_hash != 0;

    let total_checks: u64 = 5;
    let mut failed: u64 = 0;
    if !content_ok { failed = failed + 1; };
    if !signature_ok { failed = failed + 1; };
    if !receipt_ok { failed = failed + 1; };
    if !trust_ok { failed = failed + 1; };
    if !source_ok { failed = failed + 1; };

    let all_pass: bool = failed == 0;
    let status: VerificationStatus = if all_pass {
        VerificationStatus::FullVerification
    } else {
        VerificationStatus::VerificationFailed
    };

    obj.verification_status = status;
    obj.last_verified_timestamp = timestamp;

    let report: VerificationReport = VerificationReport {
        object_key: key,
        content_integrity: content_ok,
        signature_valid: signature_ok,
        receipt_chain_integrity: receipt_ok,
        trust_state_consistency: trust_ok,
        source_binary_correspondence: source_ok,
        all_checks_passed: all_pass,
        failed_checks: failed,
        total_checks: total_checks,
        verification_timestamp: timestamp,
        verifier_identity: verify_cap.object_id,
        residual_hash: computed_key.hash,
    };

    residual emit {
        op: "store_manager.verify",
        key_low: key.hash,
        key_high: key.hash_high,
        checks_passed: total_checks - failed,
        total_checks: total_checks,
        all_pass: if all_pass { 1 } else { 0 },
    };

    return Result::Ok(report);
}

// ─────────────────────────────────────────────────────────────
// Get Provenance
// ─────────────────────────────────────────────────────────────

fn store_get_provenance(
    state: Handle(StoreManagerState),
    key: StoreKey,
    audit_cap: Cap(CapabilityToken),
) -> Result(StoreProvenance, StoreError)
    effect [deterministic]
{
    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            return Result::Ok(obj.provenance);
        };
    };
    return Result::Err(StoreError::StoreProvenanceMissing);
}

// ─────────────────────────────────────────────────────────────
// Get Residual History
// ─────────────────────────────────────────────────────────────

fn store_get_residual_history(
    state: Handle(StoreManagerState),
    key: StoreKey,
    audit_cap: Cap(CapabilityToken),
) -> Result(RingBuf(ResidualRecord, 256), StoreError)
    effect [deterministic]
{
    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            return Result::Ok(obj.residual_history);
        };
    };
    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Get Trust State
// ─────────────────────────────────────────────────────────────

fn store_get_trust_state(
    state: Handle(StoreManagerState),
    key: StoreKey,
    query_cap: Cap(CapabilityToken),
) -> Result(TrustState, StoreError)
    effect [deterministic]
{
    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            return Result::Ok(obj.trust_state);
        };
    };
    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Update Trust State
// ─────────────────────────────────────────────────────────────

fn store_update_trust_state(
    state: Handle(StoreManagerState),
    key: StoreKey,
    new_trust: TrustState,
    promoter_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> Result(TrustState, StoreError)
    effect [deterministic, residual]
{
    for i in 0..state.max_objects {
        let obj: Handle(StoreObject) = Handle(StoreObject)::from_ptr(&state.objects[i]);
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            let old_trust: TrustState = obj.trust_state;
            obj.trust_state = new_trust;

            // Record trust transition residual
            let residual: ResidualRecord = ResidualRecord {
                timestamp: timestamp,
                event_type: 0x42,
                event_data_hash: new_trust as u64,
                cause_identity: promoter_cap.object_id,
                prior_state_hash: old_trust as u64,
                new_state_hash: new_trust as u64,
                delta_description: String::from_bytes(Slice(u8)::from_str("trust state updated")),
                generation_at_event: 0,
                verified: false,
            };
            obj.residual_history.push(residual);

            residual emit {
                op: "store_manager.update_trust",
                key_low: key.hash,
                key_high: key.hash_high,
                old_trust: old_trust as u64,
                new_trust: new_trust as u64,
            };

            return Result::Ok(new_trust);
        };
    };
    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Add Provenance Link
// ─────────────────────────────────────────────────────────────

fn store_add_provenance_link(
    state: Handle(StoreManagerState),
    key: StoreKey,
    link: ProvenanceLink,
    auditor_cap: Cap(CapabilityToken),
) -> Result(void, StoreError)
    effect [deterministic, residual]
{
    for i in 0..state.max_objects {
        let obj: Handle(StoreObject) = Handle(StoreObject)::from_ptr(&state.objects[i]);
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            obj.provenance.provenance_chain.push(link);
            return Result::Ok(void);
        };
    };
    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Seal Object
// ─────────────────────────────────────────────────────────────

fn store_seal_object(
    state: Handle(StoreManagerState),
    key: StoreKey,
    sealer_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> Result(void, StoreError)
    effect [deterministic, residual]
{
    for i in 0..state.max_objects {
        let obj: Handle(StoreObject) = Handle(StoreObject)::from_ptr(&state.objects[i]);
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            if obj.seal_state == SealState::Sealed {
                return Result::Err(StoreError::StoreObjectSealed);
            };

            obj.seal_state = SealState::Sealed;

            residual emit {
                op: "store_manager.seal",
                key_low: key.hash,
                key_high: key.hash_high,
            };

            return Result::Ok(void);
        };
    };
    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Increment Reference Count
// ─────────────────────────────────────────────────────────────

fn store_increment_refcount(
    state: Handle(StoreManagerState),
    key: StoreKey,
) -> Result(u64, StoreError)
    effect [deterministic]
{
    for i in 0..state.max_objects {
        let obj: Handle(StoreObject) = Handle(StoreObject)::from_ptr(&state.objects[i]);
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
        {
            obj.refcount = obj.refcount + 1;
            return Result::Ok(obj.refcount);
        };
    };
    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Decrement Reference Count (with cleanup)
// ─────────────────────────────────────────────────────────────

fn store_decrement_refcount(
    state: Handle(StoreManagerState),
    key: StoreKey,
    gc_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> Result(u64, StoreError)
    effect [deterministic, residual]
{
    for i in 0..state.max_objects {
        let obj: Handle(StoreObject) = Handle(StoreObject)::from_ptr(&state.objects[i]);
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
        {
            if obj.refcount > 0 {
                obj.refcount = obj.refcount - 1;
            };

            // If refcount reaches 0, mark for garbage collection
            if obj.refcount == 0 {
                residual emit {
                    op: "store_manager.decrement_refcount",
                    key_low: key.hash,
                    key_high: key.hash_high,
                    refcount: 0,
                    action: "gc_pending",
                };
            };

            return Result::Ok(obj.refcount);
        };
    };
    return Result::Err(StoreError::StoreObjectNotFound);
}

// ─────────────────────────────────────────────────────────────
// Garbage Collection (remove objects with refcount 0)
// ─────────────────────────────────────────────────────────────

fn store_garbage_collect(
    state: Handle(StoreManagerState),
    gc_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> u64
    effect [deterministic, residual]
{
    let mut collected: u64 = 0;

    for i in 0..state.max_objects {
        let obj: Handle(StoreObject) = Handle(StoreObject)::from_ptr(&state.objects[i]);
        if obj.refcount == 0 && obj.content_length > 0 {
            // Clear the object
            obj.content_length = 0;
            obj.store_key.hash = 0;
            obj.store_key.hash_high = 0;
            obj.refcount = 0;
            obj.seal_state = SealState::Unsealed;
            state.object_count = state.object_count - 1;
            collected = collected + 1;
        };
    };

    // Rebuild key index
    let mut idx: u64 = 0;
    for i in 0..state.max_objects {
        if state.objects[i].content_length > 0 {
            state.key_index[idx] = state.objects[i].store_key;
            idx = idx + 1;
        };
    };

    residual emit {
        op: "store_manager.garbage_collect",
        collected: collected,
        remaining: state.object_count,
    };

    return collected;
}

// ─────────────────────────────────────────────────────────────
// Enumerate All Objects
// ─────────────────────────────────────────────────────────────

fn store_enumerate_all(
    state: Handle(StoreManagerState),
    enumerator_cap: Cap(CapabilityToken),
) -> Result(Array(StoreObject, 512), StoreError)
    effect [deterministic]
{
    return Result::Ok(state.objects);
}

// ─────────────────────────────────────────────────────────────
// Store Manager Self-Test
// ─────────────────────────────────────────────────────────────

fn store_manager_self_test(
    state: Handle(StoreManagerState),
) -> Result(u64, StoreError)
    effect [deterministic]
    court "store_self_test:v1"
{
    let mut checks: u64 = 0;

    // Check 1: object count matches active objects
    let mut active: u64 = 0;
    for i in 0..state.max_objects {
        if state.objects[i].content_length > 0 {
            active = active + 1;
        };
    };

    if active == state.object_count {
        checks = checks + 1;
    };

    // Check 2: all active objects have non-zero keys
    let mut keys_valid: bool = true;
    for i in 0..state.object_count {
        if state.key_index[i].hash == 0 && state.key_index[i].hash_high == 0 {
            keys_valid = false;
            break;
        };
    };

    if keys_valid {
        checks = checks + 1;
    };

    // Check 3: key index consistency
    let mut index_consistent: bool = true;
    for i in 0..state.object_count {
        let key: StoreKey = state.key_index[i];
        let mut found: bool = false;
        for j in 0..state.max_objects {
            if state.objects[j].store_key.hash == key.hash
                && state.objects[j].store_key.hash_high == key.hash_high
                && state.objects[j].content_length > 0
            {
                found = true;
                break;
            };
        };
        if !found {
            index_consistent = false;
            break;
        };
    };

    if index_consistent {
        checks = checks + 1;
    };

    residual emit {
        op: "store_manager.self_test",
        checks_passed: checks,
        active_objects: active,
    };

    return Result::Ok(checks);
}

// ─────────────────────────────────────────────────────────────
// Store Statistics
// ─────────────────────────────────────────────────────────────

struct StoreStatistics {
    total_objects: u64,
    total_size_bytes: u64,
    unique_objects: u64,
    sealed_count: u64,
    unsealed_count: u64,
    verified_count: u64,
    unverified_count: u64,
    trust_unknown: u64,
    trust_observed: u64,
    trust_replayed: u64,
    trust_oracle: u64,
    trust_stable: u64,
    trust_sealed: u64,
    trust_promoted: u64,
    total_refs: u64,
    max_refs: u64,
    avg_object_size: u64,
    object_type_counts: Array(u64, 16),
    hash_collisions: u64,
}

fn store_statistics(
    state: Handle(StoreManagerState),
    querier_cap: Cap(CapabilityToken),
) -> StoreStatistics
    effect [deterministic]
    court "store_statistics:v1"
{
    let mut total_size: u64 = 0;
    let mut sealed: u64 = 0;
    let mut unsealed: u64 = 0;
    let mut verified: u64 = 0;
    let mut unverified: u64 = 0;
    let mut trust_counts: Array(u64, 7) = Array::zeroed();
    let mut type_counts: Array(u64, 16) = Array::zeroed();
    let mut total_refs: u64 = 0;
    let mut max_refs: u64 = 0;

    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.content_length > 0 {
            total_size = total_size + obj.content_length;
            total_refs = total_refs + obj.refcount;
            if obj.refcount > max_refs { max_refs = obj.refcount; };

            match obj.seal_state {
                SealState::Sealed => sealed = sealed + 1,
                _ => unsealed = unsealed + 1,
            };

            if obj.verification_status == VerificationStatus::FullVerification {
                verified = verified + 1;
            } else {
                unverified = unverified + 1;
            };

            let trust_idx: u64 = obj.trust_state as u64;
            if trust_idx < 7 {
                trust_counts[trust_idx] = trust_counts[trust_idx] + 1;
            };

            let type_idx: u64 = obj.object_type as u64;
            if type_idx < 16 {
                type_counts[type_idx] = type_counts[type_idx] + 1;
            };
        };
    };

    let stats: StoreStatistics = StoreStatistics {
        total_objects: state.object_count,
        total_size_bytes: total_size,
        unique_objects: state.object_count,
        sealed_count: sealed,
        unsealed_count: unsealed,
        verified_count: verified,
        unverified_count: unverified,
        trust_unknown: trust_counts[0],
        trust_observed: trust_counts[1],
        trust_replayed: trust_counts[2],
        trust_oracle: trust_counts[3],
        trust_stable: trust_counts[4],
        trust_sealed: trust_counts[5],
        trust_promoted: trust_counts[6],
        total_refs: total_refs,
        max_refs: max_refs,
        avg_object_size: if state.object_count > 0 { total_size / state.object_count } else { 0 },
        object_type_counts: type_counts,
        hash_collisions: 0,
    };

    return stats;
}

// ─────────────────────────────────────────────────────────────
// Store Object Exists Check
// ─────────────────────────────────────────────────────────────

fn store_object_exists(
    state: Handle(StoreManagerState),
    key: StoreKey,
) -> bool
    effect [deterministic]
{
    for i in 0..state.max_objects {
        let obj: StoreObject = state.objects[i];
        if obj.store_key.hash == key.hash
            && obj.store_key.hash_high == key.hash_high
            && obj.content_length > 0
        {
            return true;
        };
    };
    return false;
}

// ─────────────────────────────────────────────────────────────
// Store Object Bulk Resolve
// ─────────────────────────────────────────────────────────────

fn store_bulk_resolve(
    state: Handle(StoreManagerState),
    keys: Slice(StoreKey),
    resolve_cap: Cap(CapabilityToken),
) -> Result(Array(StoreObject, 512), StoreError)
    effect [deterministic]
{
    let mut results: Array(StoreObject, 512) = Array::zeroed();
    let key_count: u64 = keys.len();

    for i in 0..key_count {
        let key: StoreKey = keys[i];
        for j in 0..state.max_objects {
            let obj: StoreObject = state.objects[j];
            if obj.store_key.hash == key.hash
                && obj.store_key.hash_high == key.hash_high
                && obj.content_length > 0
            {
                results[i] = obj;
                break;
            };
        };
    };

    return Result::Ok(results);
}

// ─────────────────────────────────────────────────────────────
// Store Search by Metadata
// ─────────────────────────────────────────────────────────────

fn store_search_by_label(
    state: Handle(StoreManagerState),
    label_fragment: Slice(u8),
    search_cap: Cap(CapabilityToken),
) -> Result(Array(StoreKey, 64), StoreError)
    effect [deterministic]
{
    let mut matches: Array(StoreKey, 64) = Array::zeroed();
    let mut match_count: u64 = 0;
    let frag_len: u64 = label_fragment.len();

    for i in 0..state.max_objects {
        if match_count >= 64 { break; };
        let obj: StoreObject = state.objects[i];
        if obj.content_length > 0 {
            let obj_label: String(256) = obj.metadata.label;
            let label_len: u64 = obj_label.len();

            // Simple substring search
            if frag_len <= label_len {
                for j in 0..(label_len - frag_len + 1) {
                    let mut fragment_match: bool = true;
                    for k in 0..frag_len {
                        if label_len > j + k && obj_label.data[j + k] != label_fragment[k] {
                            fragment_match = false;
                            break;
                        };
                    };
                    if fragment_match {
                        matches[match_count] = obj.store_key;
                        match_count = match_count + 1;
                        break;
                    };
                };
            };
        };
    };

    return Result::Ok(matches);
}

// ─────────────────────────────────────────────────────────────
// Store Compact — Defragment and reclaim space
// ─────────────────────────────────────────────────────────────

fn store_compact(
    state: Handle(StoreManagerState),
    admin_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> u64
    effect [deterministic, residual]
{
    let mut compacted: u64 = 0;

    // Rebuild key index to remove gaps
    let mut new_idx: u64 = 0;
    for i in 0..state.max_objects {
        if state.objects[i].content_length > 0 {
            state.key_index[new_idx] = state.objects[i].store_key;
            new_idx = new_idx + 1;
        };
    };

    // Zero out remaining old slots
    for i in new_idx..state.max_objects {
        state.key_index[i] = StoreKey {
            hash: 0, hash_high: 0,
            algorithm: HashAlgorithm::PhorHash128,
            size_hint: 0,
        };
    };

    compacted = state.object_count;

    residual emit {
        op: "store_manager.compact",
        compacted: compacted,
    };

    return compacted;
}

// ─────────────────────────────────────────────────────────────
// Store Verification Chain — Verify a chain of objects
// ─────────────────────────────────────────────────────────────

fn store_verify_chain(
    state: Handle(StoreManagerState),
    root_key: StoreKey,
    max_depth: u64,
    verifier_cap: Cap(CapabilityToken),
    timestamp: u64,
) -> Result(u64, StoreError)
    effect [deterministic, residual]
{
    let mut verified_count: u64 = 0;
    let mut current_key: StoreKey = root_key;

    for depth in 0..max_depth {
        let verify_result: Result(VerificationReport, StoreError) = store_verify(
            state,
            current_key,
            verifier_cap,
            timestamp,
        );

        match verify_result {
            Result::Ok(report) => {
                if report.all_checks_passed {
                    verified_count = verified_count + 1;
                };
            },
            Result::Err(_) => {
                break;
            },
        };

        // Get next key from provenance
        let prov_result: Result(StoreProvenance, StoreError) = store_get_provenance(
            state,
            current_key,
            verifier_cap,
        );

        match prov_result {
            Result::Ok(prov) => {
                if prov.parent_count > 0 {
                    current_key = prov.parent_object_keys[0];
                } else {
                    break;
                };
            },
            Result::Err(_) => {
                break;
            },
        };
    };

    residual emit {
        op: "store_manager.verify_chain",
        root_hash: root_key.hash,
        verified: verified_count,
        max_depth: max_depth,
    };

    return Result::Ok(verified_count);
}
