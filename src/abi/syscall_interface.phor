fn handle_close_channel[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, unsafe) { default_return() }
fn handle_open[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, alloc, unsafe) { default_return() }
fn handle_close[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, unsafe) { default_return() }
fn handle_read[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, io, unsafe) { default_return() }
fn handle_write[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, io, unsafe) { default_return() }
fn handle_seek[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall) { default_return() }
