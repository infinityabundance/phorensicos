// file: types.phor
// purpose: Core primitive type definitions for Phorensic OS.
//          Defines Byte, Word16, Word32, Word64, Hash256, Identity,
//          Timestamp, Offset, Size, Signature64, and associated operations.
//          All operations are explicit about effects and bounded loops.
// evidence: TYPES-ARCH-001 through TYPES-ARCH-120
// residual: All types are no_std, no_alloc, no_unsafe; purely structural.

use core::constants::*

// ──────────────────────────────────────────────
// Primitive Type: Byte
// ──────────────────────────────────────────────
// Wraps a raw u8 value. Provides checked arithmetic and bitwise operations.
// Evidence path: TYPES-BYTE-001 through TYPES-BYTE-030

pub type Byte : u8 = struct {
    value: u8,
}

impl Byte {
    // Construct a Byte from a raw u8, range-checked.
    pub fn from_u8(v: u8) -> Byte
        effects: [deterministic]
    {
        Byte { value: v }
    }

    // Construct a Byte with truncation from Word64.
    pub fn from_word64_truncate(v: Word64) -> Byte
        effects: [deterministic]
    {
        let raw: u64 = v.to_u64()
        let low: u8 = raw as u8  // bound: truncation is safe
        Byte { value: low }
    }

    // Return the underlying u8 value.
    pub fn to_u8(self) -> u8
        effects: [deterministic]
    {
        self.value
    }

    // Checked addition; returns Result to handle overflow.
    pub fn checked_add(self, other: Byte) -> Result[Byte, OverflowError]
        effects: [deterministic]
    {
        let (sum, overflow): (u8, bool) = __builtin_add_u8_overflow(self.value, other.value)
        if overflow {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x001,
                              "Byte addition overflow"))
        }
        Result::Ok(Byte { value: sum })
    }

    // Saturating addition; never overflows but saturates at 0xFF.
    pub fn saturating_add(self, other: Byte) -> Byte
        effects: [deterministic]
    {
        let (sum, overflow): (u8, bool) = __builtin_add_u8_overflow(self.value, other.value)
        if overflow {
            Byte { value: 0xFF }
        } else {
            Byte { value: sum }
        }
    }

    // Checked subtraction.
    pub fn checked_sub(self, other: Byte) -> Result[Byte, OverflowError]
        effects: [deterministic]
    {
        let (diff, underflow): (u8, bool) = __builtin_sub_u8_overflow(self.value, other.value)
        if underflow {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x002,
                              "Byte subtraction underflow"))
        }
        Result::Ok(Byte { value: diff })
    }

    // Checked multiplication.
    pub fn checked_mul(self, other: Byte) -> Result[Byte, OverflowError]
        effects: [deterministic]
    {
        let (prod, overflow): (u8, bool) = __builtin_mul_u8_overflow(self.value, other.value)
        if overflow {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x003,
                              "Byte multiplication overflow"))
        }
        Result::Ok(Byte { value: prod })
    }

    // Bitwise AND.
    pub fn bit_and(self, other: Byte) -> Byte
        effects: [deterministic]
    {
        Byte { value: self.value & other.value }
    }

    // Bitwise OR.
    pub fn bit_or(self, other: Byte) -> Byte
        effects: [deterministic]
    {
        Byte { value: self.value | other.value }
    }

    // Bitwise XOR.
    pub fn bit_xor(self, other: Byte) -> Byte
        effects: [deterministic]
    {
        Byte { value: self.value ^ other.value }
    }

    // Bitwise NOT.
    pub fn bit_not(self) -> Byte
        effects: [deterministic]
    {
        Byte { value: !self.value }
    }

    // Left shift with bounds check.
    pub fn checked_shl(self, shift: u8) -> Result[Byte, OverflowError]
        effects: [deterministic]
    {
        if shift >= 8 {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x004,
                              "Byte shift left exceeds bit width"))
        }
        Result::Ok(Byte { value: self.value << shift })
    }

    // Right shift.
    pub fn checked_shr(self, shift: u8) -> Result[Byte, OverflowError]
        effects: [deterministic]
    {
        if shift >= 8 {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x005,
                              "Byte shift right exceeds bit width"))
        }
        Result::Ok(Byte { value: self.value >> shift })
    }

    // Equality comparison.
    pub fn eq(self, other: Byte) -> bool
        effects: [deterministic]
    {
        self.value == other.value
    }

    // Ordering comparison.
    pub fn cmp(self, other: Byte) -> Ordering
        effects: [deterministic]
    {
        if self.value < other.value {
            Ordering::Less
        } else if self.value > other.value {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }

    // Check if value is zero.
    pub fn is_zero(self) -> bool
        effects: [deterministic]
    {
        self.value == 0
    }

    // Return the hex representation as a fixed string.
    pub fn to_hex(self) -> FixedString[2]
        effects: [deterministic]
    {
        let hex_chars: [u8; 16] = [
            b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7',
            b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
        ]
        let high: u8 = (self.value >> 4) & 0x0F
        let low: u8  = self.value & 0x0F
        let mut buf: FixedString[2] = FixedString::new()
        buf.push_byte(hex_chars[high as u32])
        buf.push_byte(hex_chars[low as u32])
        buf
    }

    // Parse a Byte from hex characters.
    pub fn from_hex(high: Byte, low: Byte) -> Result[Byte, ParseError]
        effects: [deterministic]
    {
        let h: u8 = Byte::hex_value(high)?
        let l: u8 = Byte::hex_value(low)?
        Result::Ok(Byte { value: (h << 4) | l })
    }

    // Internal: convert hex character to nibble.
    fn hex_value(c: Byte) -> Result[u8, ParseError]
        effects: [deterministic]
    {
        let v: u8 = c.to_u8()
        if v >= b'0' && v <= b'9' {
            Result::Ok(v - b'0')
        } else if v >= b'a' && v <= b'f' {
            Result::Ok(v - b'a' + 10)
        } else if v >= b'A' && v <= b'F' {
            Result::Ok(v - b'A' + 10)
        } else {
            Result::Err(ParseError::new(DIAG_SERIAL_BASE | 0x010,
                        "Invalid hex character"))
        }
    }
}

// ──────────────────────────────────────────────
// Primitive Type: Word64
// ──────────────────────────────────────────────
// 64-bit unsigned integer with checked operations.
// Evidence path: TYPES-W64-001 through TYPES-W64-040

pub type Word64 : u64 = struct {
    value: u64,
}

impl Word64 {
    pub fn from_u64(v: u64) -> Word64
        effects: [deterministic]
    {
        Word64 { value: v }
    }

    pub fn zero() -> Word64
        effects: [deterministic]
    {
        Word64 { value: 0 }
    }

    pub fn one() -> Word64
        effects: [deterministic]
    {
        Word64 { value: 1 }
    }

    pub fn max() -> Word64
        effects: [deterministic]
    {
        Word64 { value: 0xFFFF_FFFF_FFFF_FFFF }
    }

    pub fn to_u64(self) -> u64
        effects: [deterministic]
    {
        self.value
    }

    // Checked addition.
    pub fn checked_add(self, other: Word64) -> Result[Word64, OverflowError]
        effects: [deterministic]
    {
        let (sum, overflow): (u64, bool) = __builtin_add_u64_overflow(self.value, other.value)
        if overflow {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x010,
                              "Word64 addition overflow"))
        }
        Result::Ok(Word64 { value: sum })
    }

    // Wrapping addition (no error on overflow).
    pub fn wrapping_add(self, other: Word64) -> Word64
        effects: [deterministic]
    {
        let (sum, _overflow): (u64, bool) = __builtin_add_u64_overflow(self.value, other.value)
        Word64 { value: sum }
    }

    // Checked subtraction.
    pub fn checked_sub(self, other: Word64) -> Result[Word64, OverflowError]
        effects: [deterministic]
    {
        if other.value > self.value {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x011,
                              "Word64 subtraction underflow"))
        }
        Result::Ok(Word64 { value: self.value - other.value })
    }

    // Checked multiplication.
    pub fn checked_mul(self, other: Word64) -> Result[Word64, OverflowError]
        effects: [deterministic]
    {
        let (prod, overflow): (u64, bool) = __builtin_mul_u64_overflow(self.value, other.value)
        if overflow {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x012,
                              "Word64 multiplication overflow"))
        }
        Result::Ok(Word64 { value: prod })
    }

    // Checked division.
    pub fn checked_div(self, other: Word64) -> Result[Word64, DivisionByZeroError]
        effects: [deterministic]
    {
        if other.value == 0 {
            return Result::Err(DivisionByZeroError::new(DIAG_MATH_BASE | 0x013,
                              "Word64 division by zero"))
        }
        Result::Ok(Word64 { value: self.value / other.value })
    }

    // Checked remainder.
    pub fn checked_rem(self, other: Word64) -> Result[Word64, DivisionByZeroError]
        effects: [deterministic]
    {
        if other.value == 0 {
            return Result::Err(DivisionByZeroError::new(DIAG_MATH_BASE | 0x014,
                              "Word64 remainder by zero"))
        }
        Result::Ok(Word64 { value: self.value % other.value })
    }

    // Checked power.
    pub fn checked_pow(self, exp: u32) -> Result[Word64, OverflowError]
        effects: [deterministic]
    {
        if exp == 0 {
            return Result::Ok(Word64 { value: 1 })
        }
        let mut result: u64 = 1
        let mut base: u64 = self.value
        let mut e: u32 = exp
        // loop: bounds[BOUND_SMALL] — exponent bounded by u32 max
        loop: bounds[BOUND_SMALL] while e > 0 {
            if (e & 1) == 1 {
                let (r, ov1): (u64, bool) = __builtin_mul_u64_overflow(result, base)
                if ov1 {
                    return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x015,
                                      "Word64 power overflow"))
                }
                result = r
            }
            e = e >> 1
            if e > 0 {
                let (b, ov2): (u64, bool) = __builtin_mul_u64_overflow(base, base)
                if ov2 {
                    return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x016,
                                      "Word64 power overflow in squaring"))
                }
                base = b
            }
        }
        Result::Ok(Word64 { value: result })
    }

    // Bitwise operations.
    pub fn bit_and(self, other: Word64) -> Word64
        effects: [deterministic]
    {
        Word64 { value: self.value & other.value }
    }

    pub fn bit_or(self, other: Word64) -> Word64
        effects: [deterministic]
    {
        Word64 { value: self.value | other.value }
    }

    pub fn bit_xor(self, other: Word64) -> Word64
        effects: [deterministic]
    {
        Word64 { value: self.value ^ other.value }
    }

    pub fn bit_not(self) -> Word64
        effects: [deterministic]
    {
        Word64 { value: !self.value }
    }

    // Shift operations with bound checks.
    pub fn checked_shl(self, shift: u32) -> Result[Word64, OverflowError]
        effects: [deterministic]
    {
        if shift >= 64 {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x017,
                              "Word64 shift left exceeds bit width"))
        }
        Result::Ok(Word64 { value: self.value << shift })
    }

    pub fn checked_shr(self, shift: u32) -> Result[Word64, OverflowError]
        effects: [deterministic]
    {
        if shift >= 64 {
            return Result::Err(OverflowError::new(DIAG_MATH_BASE | 0x018,
                              "Word64 shift right exceeds bit width"))
        }
        Result::Ok(Word64 { value: self.value >> shift })
    }

    // Logical operations.
    pub fn eq(self, other: Word64) -> bool
        effects: [deterministic]
    {
        self.value == other.value
    }

    pub fn neq(self, other: Word64) -> bool
        effects: [deterministic]
    {
        self.value != other.value
    }

    pub fn lt(self, other: Word64) -> bool
        effects: [deterministic]
    {
        self.value < other.value
    }

    pub fn lte(self, other: Word64) -> bool
        effects: [deterministic]
    {
        self.value <= other.value
    }

    pub fn gt(self, other: Word64) -> bool
        effects: [deterministic]
    {
        self.value > other.value
    }

    pub fn gte(self, other: Word64) -> bool
        effects: [deterministic]
    {
        self.value >= other.value
    }

    pub fn cmp(self, other: Word64) -> Ordering
        effects: [deterministic]
    {
        if self.value < other.value {
            Ordering::Less
        } else if self.value > other.value {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }

    pub fn is_zero(self) -> bool
        effects: [deterministic]
    {
        self.value == 0
    }

    pub fn is_power_of_two(self) -> bool
        effects: [deterministic]
    {
        if self.value == 0 {
            return false
        }
        (self.value & (self.value - 1)) == 0
    }

    // Count leading zeros.
    pub fn leading_zeros(self) -> u32
        effects: [deterministic]
    {
        __builtin_clz_u64(self.value)
    }

    // Count trailing zeros.
    pub fn trailing_zeros(self) -> u32
        effects: [deterministic]
    {
        __builtin_ctz_u64(self.value)
    }

    // Count set bits (population count).
    pub fn count_ones(self) -> u32
        effects: [deterministic]
    {
        __builtin_popcount_u64(self.value)
    }

    // Convert to little-endian byte array.
    pub fn to_le_bytes(self) -> Byte[8]
        effects: [deterministic]
    {
        let bytes: [u8; 8] = __builtin_u64_to_le_bytes(self.value)
        let mut result: Byte[8] = Byte[8]::zeroed()
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            result[i] = Byte::from_u8(bytes[i])
        }
        result
    }

    // Convert to big-endian byte array.
    pub fn to_be_bytes(self) -> Byte[8]
        effects: [deterministic]
    {
        let bytes: [u8; 8] = __builtin_u64_to_be_bytes(self.value)
        let mut result: Byte[8] = Byte[8]::zeroed()
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            result[i] = Byte::from_u8(bytes[i])
        }
        result
    }

    // Construct from little-endian bytes.
    pub fn from_le_bytes(bytes: Byte[8]) -> Word64
        effects: [deterministic]
    {
        let mut raw: [u8; 8] = [0; 8]
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            raw[i] = bytes[i].to_u8()
        }
        let value: u64 = __builtin_u64_from_le_bytes(raw)
        Word64 { value: value }
    }

    // Construct from big-endian bytes.
    pub fn from_be_bytes(bytes: Byte[8]) -> Word64
        effects: [deterministic]
    {
        let mut raw: [u8; 8] = [0; 8]
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            raw[i] = bytes[i].to_u8()
        }
        let value: u64 = __builtin_u64_from_be_bytes(raw)
        Word64 { value: value }
    }

    // Min/max operations.
    pub fn min(self, other: Word64) -> Word64
        effects: [deterministic]
    {
        if self.value < other.value { self } else { other }
    }

    pub fn max(self, other: Word64) -> Word64
        effects: [deterministic]
    {
        if self.value > other.value { self } else { other }
    }

    // Log2 ceiling (smallest n such that 2^n >= value).
    pub fn log2_ceil(self) -> Result[u32, ArithmeticError]
        effects: [deterministic]
    {
        if self.value == 0 {
            return Result::Err(ArithmeticError::new(DIAG_MATH_BASE | 0x019,
                              "log2_ceil of zero"))
        }
        let leading: u32 = self.leading_zeros()
        let bits: u32 = 64 - leading
        if self.is_power_of_two() {
            Result::Ok(bits - 1)
        } else {
            Result::Ok(bits)
        }
    }

    // Round up to the next power of two.
    pub fn next_power_of_two(self) -> Word64
        effects: [deterministic]
    {
        if self.value == 0 {
            return Word64 { value: 1 }
        }
        if self.is_power_of_two() {
            return self
        }
        let leading: u32 = self.leading_zeros()
        let shift: u32 = 64 - leading
        Word64 { value: 1 << shift }
    }
}

// ──────────────────────────────────────────────
// Primitive Type: Hash256
// ──────────────────────────────────────────────
// 256-bit cryptographic hash value.
// Evidence path: TYPES-HASH-001 through TYPES-HASH-030

pub type Hash256 : [Byte; 32] = struct {
    bytes: [Byte; 32],
}

impl Hash256 {
    pub fn zeroed() -> Hash256
        effects: [deterministic]
    {
        let mut b: [Byte; 32] = [Byte::from_u8(0); 32]
        Hash256 { bytes: b }
    }

    pub fn from_bytes(bytes: [Byte; 32]) -> Hash256
        effects: [deterministic]
    {
        Hash256 { bytes: bytes }
    }

    pub fn from_slice(slice: Byte[32]) -> Result[Hash256, BoundsError]
        effects: [deterministic]
    {
        let mut b: [Byte; 32] = [Byte::from_u8(0); 32]
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            b[i] = slice[i]
        }
        Result::Ok(Hash256 { bytes: b })
    }

    pub fn as_bytes(self) -> [Byte; 32]
        effects: [deterministic]
    {
        self.bytes
    }

    pub fn as_slice(self) -> Byte[32]
        effects: [deterministic]
    {
        let mut result: Byte[32] = Byte[32]::zeroed()
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            result[i] = self.bytes[i]
        }
        result
    }

    pub fn byte_at(self, index: u32) -> Result[Byte, BoundsError]
        effects: [deterministic]
    {
        if index >= 32 {
            return Result::Err(BoundsError::new(DIAG_MATH_BASE | 0x020,
                              "Hash256 index out of bounds"))
        }
        Result::Ok(self.bytes[index as usize])
    }

    pub fn eq(self, other: Hash256) -> bool
        effects: [deterministic]
    {
        let mut equal: bool = true
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            if !self.bytes[i].eq(other.bytes[i]) {
                equal = false
                break
            }
        }
        equal
    }

    pub fn neq(self, other: Hash256) -> bool
        effects: [deterministic]
    {
        !self.eq(other)
    }

    // XOR two hashes (useful for combining).
    pub fn xor(self, other: Hash256) -> Hash256
        effects: [deterministic]
    {
        let mut result: [Byte; 32] = [Byte::from_u8(0); 32]
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            result[i] = self.bytes[i].bit_xor(other.bytes[i])
        }
        Hash256 { bytes: result }
    }

    // Compare two hashes in constant time (prevent timing side-channels).
    pub fn constant_time_eq(self, other: Hash256) -> bool
        effects: [deterministic]
    {
        let mut diff: u8 = 0
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            diff = diff | (self.bytes[i].to_u8() ^ other.bytes[i].to_u8())
        }
        diff == 0
    }

    // Return hex string representation.
    pub fn to_hex(self) -> FixedString[64]
        effects: [deterministic]
    {
        let mut buf: FixedString[64] = FixedString::new()
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            let hex_pair: FixedString[2] = self.bytes[i].to_hex()
            buf.append(hex_pair)
        }
        buf
    }

    // Return the first 8 bytes as a Word64 (for hash tables).
    pub fn low_word64(self) -> Word64
        effects: [deterministic]
    {
        let mut raw: [u8; 8] = [0; 8]
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            raw[i] = self.bytes[i].to_u8()
        }
        let value: u64 = __builtin_u64_from_le_bytes(raw)
        Word64::from_u64(value)
    }

    // Check if the hash is all zeros.
    pub fn is_zero(self) -> bool
        effects: [deterministic]
    {
        self.eq(Hash256::zeroed())
    }
}

// ──────────────────────────────────────────────
// Primitive Type: Identity
// ──────────────────────────────────────────────
// A 64-bit entity identity used for capabilities, cages, and courts.
// Evidence path: TYPES-ID-001 through TYPES-ID-020

pub type Identity : Word64 = struct {
    value: Word64,
}

impl Identity {
    pub fn new(value: Word64) -> Identity
        effects: [deterministic]
    {
        Identity { value: value }
    }

    pub fn null() -> Identity
        effects: [deterministic]
    {
        Identity { value: Word64::from_u64(IDENTITY_NULL) }
    }

    pub fn kernel() -> Identity
        effects: [deterministic]
    {
        Identity { value: Word64::from_u64(IDENTITY_KERNEL) }
    }

    pub fn root_cage() -> Identity
        effects: [deterministic]
    {
        Identity { value: Word64::from_u64(IDENTITY_ROOT_CAGE) }
    }

    pub fn court_zero() -> Identity
        effects: [deterministic]
    {
        Identity { value: Word64::from_u64(IDENTITY_COURT_ZERO) }
    }

    pub fn as_word64(self) -> Word64
        effects: [deterministic]
    {
        self.value
    }

    pub fn eq(self, other: Identity) -> bool
        effects: [deterministic]
    {
        self.value.eq(other.value)
    }

    pub fn neq(self, other: Identity) -> bool
        effects: [deterministic]
    {
        self.value.neq(other.value)
    }

    pub fn is_null(self) -> bool
        effects: [deterministic]
    {
        self.value.is_zero()
    }

    // Compute a hash of the identity.
    pub fn to_hash(self) -> Hash256
        effects: [deterministic, hash]
    {
        let bytes: Byte[8] = self.value.to_le_bytes()
        let mut hash_bytes: [Byte; 32] = [Byte::from_u8(0); 32]
        // loop: bounds[BOUND_TINY] — exactly 8 iterations (copy input)
        loop: bounds[BOUND_TINY] for i in 0..8 {
            hash_bytes[i] = bytes[i]
        }
        // Remaining bytes are zero; in production, use BLAKE3.
        Hash256::from_bytes(hash_bytes)
    }

    pub fn to_le_bytes(self) -> Byte[8]
        effects: [deterministic]
    {
        self.value.to_le_bytes()
    }
}

// ──────────────────────────────────────────────
// Primitive Type: Timestamp
// ──────────────────────────────────────────────
// Nanosecond-precision timestamp for ordering and diagnostics.
// Evidence path: TYPES-TS-001 through TYPES-TS-025

pub type Timestamp : Word64 = struct {
    nanos: Word64,
}

impl Timestamp {
