// file: boot_loader.phor
// purpose: Boot loader main — ELF parsing for kernel image, memory map
//          construction, video mode detection, boot protocol implementation,
//          boot console, boot menu, fallback handling
// effects: [io, machine:ioport, memory:mmio, deterministic]
// trust: TrustState_Bootstrap → TrustState_Loading → TrustState_Operational

package "phorensic:boot_loader:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*
use core::handles::*
use core::effects::*
use boot::multiboot::*
use boot::uefi_boot::*
use boot::boot_console::*
use boot::boot_menu::*
use boot::boot_config::*
use boot::initramfs::*
use boot::device_tree::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const BOOT_LOADER_VERSION: Word64 = 0x0100_0001
const BOOT_LOADER_NAME: FixedString[32] = "PhorensicBoot"
const MAX_BOOT_ENTRIES: u32 = 16
const MAX_KERNEL_PATH: u32 = 256
const MAX_CMDLINE_LEN: u32 = 512
const MAX_MEMORY_REGIONS: u32 = 128
const MAX_MODULES: u32 = 32
const MAX_BOOT_DEVICES: u32 = 8
const STAGE2_MAGIC: Word32 = 0xFEED_FACE
const KERNEL_BASE_LOAD_ADDR: Word64 = 0x2000_0000
const BOOT_STACK_SIZE: Word32 = 0x4000  // 16KB boot stack
const MAX_FALLBACK_ENTRIES: u32 = 4
const BOOT_PROTOCOL_NONE: u32 = 0
const BOOT_PROTOCOL_MULTIBOOT1: u32 = 1
const BOOT_PROTOCOL_MULTIBOOT2: u32 = 2
const BOOT_PROTOCOL_UEFI: u32 = 3
const BOOT_PROTOCOL_STUB: u32 = 4
const MAX_RESIDUAL_RECORDS: u32 = 64

// ──────────────────────────────────────────────
// Boot Error Types
// ──────────────────────────────────────────────

pub type BootError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BootError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BootError
        effects: [deterministic]
    {
        BootError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust
    }
}

// ──────────────────────────────────────────────
// Boot State Types
// ──────────────────────────────────────────────

pub type BootProtocol : u32 = enum {
    None        = BOOT_PROTOCOL_NONE,
    MultiBoot1  = BOOT_PROTOCOL_MULTIBOOT1,
    MultiBoot2  = BOOT_PROTOCOL_MULTIBOOT2,
    UEFI        = BOOT_PROTOCOL_UEFI,
    Stub        = BOOT_PROTOCOL_STUB,
}

pub type BootPhase : u32 = enum {
    Entry           = 0,
    EarlyInit       = 1,
    ProtocolDetect  = 2,
    MemoryInit      = 3,
    ConsoleInit     = 4,
    ConfigLoad      = 5,
    MenuDisplay     = 6,
    KernelLoad      = 7,
    InitramfsLoad   = 8,
    DeviceTreeLoad  = 9,
    JumpToKernel    = 10,
    Fallback        = 11,
    Failed          = 12,
}

pub type BootDeviceType : u32 = enum {
    Unknown     = 0,
    HDD         = 1,
    SSD         = 2,
    NVMe        = 3,
    USB         = 4,
    CDROM       = 5,
    Network     = 6,
    RAMDisk     = 7,
    Firmware    = 8,
}

pub type VideoMode : u32 = enum {
    Text80x25       = 0,
    Text80x50       = 1,
    VGA1024x768     = 2,
    SVGA1280x1024   = 3,
    Native1920x1080 = 4,
    UEFIGOP         = 5,
    HiDPI4K         = 6,
    Unknown         = 7,
}

pub type BootFlags : Word64 = struct {
    flags: Word64,
}

impl BootFlags {
    pub fn empty() -> BootFlags
        effects: [deterministic]
    {
        BootFlags { flags: Word64::zero() }
    }

    pub fn has(self, flag: Word64) -> bool
        effects: [deterministic]
    {
        let and: Word64 = self.flags.bit_and(flag)
        !and.is_zero()
    }

    pub fn set(self: ref mut, flag: Word64)
        effects: [deterministic]
    {
        self.flags = self.flags.bit_or(flag)
    }

    pub fn clear(self: ref mut, flag: Word64)
        effects: [deterministic]
    {
        let not_flag: Word64 = flag.bit_not()
        self.flags = self.flags.bit_and(not_flag)
    }
}

const BOOT_FLAG_VERBOSE: Word64 = 0x0000_0000_0000_0001
const BOOT_FLAG_RECOVERY: Word64 = 0x0000_0000_0000_0002
const BOOT_FLAG_SAFEMODE: Word64 = 0x0000_0000_0000_0004
const BOOT_FLAG_SINGLE_USER: Word64 = 0x0000_0000_0000_0008
const BOOT_FLAG_DEBUG: Word64 = 0x0000_0000_0000_0010
const BOOT_FLAG_NO_ACPI: Word64 = 0x0000_0000_0000_0020
const BOOT_FLAG_NO_DEVICE_TREE: Word64 = 0x0000_0000_0000_0040
const BOOT_FLAG_NO_INITRAMFS: Word64 = 0x0000_0000_0000_0080
const BOOT_FLAG_FACTORY_RESET: Word64 = 0x0000_0000_0000_0100
const BOOT_FLAG_TEST_MODE: Word64 = 0x0000_0000_0000_0200

// ──────────────────────────────────────────────
// Memory Region Descriptor
// ──────────────────────────────────────────────

pub type MemoryRegion : struct {
    base_addr: Word64,
    length: Word64,
    region_type: u32,
    attributes: Word64,
    acpi_handle: Word64,
}

pub type MemoryMap : struct {
    regions: FixedArray[MAX_MEMORY_REGIONS, MemoryRegion],
    num_regions: u32,
    total_ram: Word64,
    reserved_ram: Word64,
    bootloader_reserved: Word64,
}

impl MemoryMap {
    pub fn new() -> MemoryMap
        effects: [deterministic]
    {
        MemoryMap {
            regions: FixedArray::new(),
            num_regions: 0,
            total_ram: Word64::zero(),
            reserved_ram: Word64::zero(),
            bootloader_reserved: Word64::zero(),
        }
    }

    pub fn add_region(self: ref mut, region: MemoryRegion) -> Result[(), BootError]
        effects: [deterministic]
    {
        if self.num_regions >= MAX_MEMORY_REGIONS {
            return Result::Err(BootError::new(
                DIAG_BOOT_BASE | 0x001,
                "Memory map full: cannot add more regions"
            ))
        }
        let idx: u32 = self.num_regions
        self.regions.set(idx, region)!
        self.num_regions = self.num_regions + 1
        if region.region_type == 1 {
            self.total_ram = self.total_ram.add(region.length)
        } else if region.region_type >= 2 && region.region_type <= 4 {
            self.reserved_ram = self.reserved_ram.add(region.length)
        }
        Result::Ok(())
    }

    pub fn get_region(self, index: u32) -> Result[MemoryRegion, BootError]
        effects: [deterministic]
    {
        if index >= self.num_regions {
            return Result::Err(BootError::new(
                DIAG_BOOT_BASE | 0x002,
                "Memory region index out of bounds"
            ))
        }
        self.regions.get(index)
    }

    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.num_regions
    }

    pub fn total_physical_ram(self) -> Word64
        effects: [deterministic]
    {
        self.total_ram
    }

    pub fn find_largest_free_region(self) -> Result[MemoryRegion, BootError]
        effects: [deterministic]
    {
        let mut largest: MemoryRegion = MemoryRegion {
            base_addr: Word64::zero(),
            length: Word64::zero(),
            region_type: 0,
            attributes: Word64::zero(),
            acpi_handle: Word64::zero(),
        }
        let mut largest_size: Word64 = Word64::zero()
        let mut found: bool = false
        for i in 0..self.num_regions {
            let region: MemoryRegion = self.regions.get(i)!
            if region.region_type == 1 {
                if region.length.gt(largest_size) {
                    largest = region
                    largest_size = region.length
                    found = true
                }
            }
        }
        if !found {
            return Result::Err(BootError::new(
                DIAG_BOOT_BASE | 0x003,
                "No usable memory region found"
            ))
        }
        Result::Ok(largest)
    }
}

// ──────────────────────────────────────────────
// ELF Parsing Structures
// ──────────────────────────────────────────────

pub type ELFIdentification : struct {
    magic: FixedArray[4, Word8],
    arch_class: u8,
    data_encoding: u8,
    version: u8,
    os_abi: u8,
    abi_version: u8,
    padding: FixedArray[7, u8],
}

pub type ELFHeader64 : struct {
    ident: ELFIdentification,
    e_type: Word16,
    e_machine: Word16,
    e_version: Word32,
    e_entry: Word64,
    e_phoff: Word64,
    e_shoff: Word64,
    e_flags: Word32,
    e_ehsize: Word16,
    e_phentsize: Word16,
    e_phnum: Word16,
    e_shentsize: Word16,
    e_shnum: Word16,
    e_shstrndx: Word16,
}

pub type ELFProgramHeader64 : struct {
    p_type: Word32,
    p_flags: Word32,
    p_offset: Word64,
    p_vaddr: Word64,
    p_paddr: Word64,
    p_filesz: Word64,
    p_memsz: Word64,
    p_align: Word64,
}

pub type ELFSectionHeader64 : struct {
    sh_name: Word32,
    sh_type: Word32,
    sh_flags: Word64,
    sh_addr: Word64,
    sh_offset: Word64,
    sh_size: Word64,
    sh_link: Word32,
    sh_info: Word32,
    sh_addralign: Word64,
    sh_entsize: Word64,
}

pub type ELFSegmentType : u32 = enum {
    Null        = 0,
    Load        = 1,
    Dynamic     = 2,
    Interp      = 3,
    Note        = 4,
    ShLib       = 5,
    Phdr        = 6,
    TLS         = 7,
    GNUStack    = 0x6474e551,
    GNURelRo    = 0x6474e552,
}

pub type KernelImage : struct {
    header: ELFHeader64,
    segments: FixedArray[16, ELFProgramHeader64],
    num_segments: u32,
    sections: FixedArray[64, ELFSectionHeader64],
    num_sections: u32,
    entry_point: Word64,
    load_base: Word64,
    image_size: Word64,
    is_relocatable: bool,
    has_pie: bool,
    has_smp: bool,
}

impl KernelImage {
    pub fn new() -> KernelImage
        effects: [deterministic]
    {
        KernelImage {
            header: ELFHeader64 {
                ident: ELFIdentification {
                    magic: FixedArray::new(),
                    arch_class: 0,
                    data_encoding: 0,
                    version: 0,
                    os_abi: 0,
                    abi_version: 0,
                    padding: FixedArray::new(),
                },
                e_type: 0,
                e_machine: 0,
                e_version: 0,
                e_entry: Word64::zero(),
                e_phoff: Word64::zero(),
                e_shoff: Word64::zero(),
                e_flags: 0,
                e_ehsize: 0,
                e_phentsize: 0,
                e_phnum: 0,
                e_shentsize: 0,
                e_shnum: 0,
                e_shstrndx: 0,
            },
            segments: FixedArray::new(),
            num_segments: 0,
            sections: FixedArray::new(),
            num_sections: 0,
            entry_point: Word64::zero(),
            load_base: Word64::zero(),
            image_size: Word64::zero(),
            is_relocatable: false,
            has_pie: false,
            has_smp: false,
        }
    }

    pub fn validate_magic(self) -> bool
        effects: [deterministic]
    {
        // ELF magic: 0x7F 'E' 'L' 'F'
        let magic: FixedArray[4, Word8] = self.header.ident.magic
        if magic.len() < 4 {
            return false
        }
        let b0: Word8 = magic.get(0)!
        let b1: Word8 = magic.get(1)!
        let b2: Word8 = magic.get(2)!
        let b3: Word8 = magic.get(3)!
        b0 == 0x7F && b1 == 'E' as u8 && b2 == 'L' as u8 && b3 == 'F' as u8
    }

    pub fn is_64bit(self) -> bool
        effects: [deterministic]
    {
        self.header.ident.arch_class == 2
    }

    pub fn entry(self) -> Word64
        effects: [deterministic]
    {
        self.header.e_entry
    }

    pub fn get_load_segments(self) -> FixedArray[16, ELFProgramHeader64]
        effects: [deterministic]
    {
        let mut load_segs: FixedArray[16, ELFProgramHeader64] = FixedArray::new()
        for i in 0..self.num_segments {
            let seg: ELFProgramHeader64 = self.segments.get(i)!
            if seg.p_type == 1 {
                load_segs.push(seg)!
            }
        }
        load_segs
    }

    pub fn compute_load_size(self) -> Word64
        effects: [deterministic]
    {
        let mut max_end: Word64 = Word64::zero()
        let mut min_start: Word64 = Word64::max()
        for i in 0..self.num_segments {
            let seg: ELFProgramHeader64 = self.segments.get(i)!
            if seg.p_type == 1 {
                let seg_end: Word64 = seg.p_vaddr.add(seg.p_memsz)
                if seg.p_vaddr.lt(min_start) {
                    min_start = seg.p_vaddr
                }
                if seg_end.gt(max_end) {
                    max_end = seg_end
                }
            }
        }
        max_end.sub(min_start)
    }
}

// ──────────────────────────────────────────────
// Boot Device
// ──────────────────────────────────────────────

pub type BootDevice : struct {
    device_type: BootDeviceType,
    partition_index: u32,
    fs_type: u32,
    device_path: FixedString[MAX_KERNEL_PATH],
    firmware_handle: Word64,
    block_size: Word32,
    total_blocks: Word64,
    is_bootable: bool,
    is_removable: bool,
}

pub type BootDeviceList : struct {
    devices: FixedArray[MAX_BOOT_DEVICES, BootDevice],
    num_devices: u32,
}

impl BootDeviceList {
    pub fn new() -> BootDeviceList
        effects: [deterministic]
    {
        BootDeviceList {
            devices: FixedArray::new(),
            num_devices: 0,
        }
    }

    pub fn add_device(self: ref mut, device: BootDevice) -> Result[(), BootError]
        effects: [deterministic]
    {
        if self.num_devices >= MAX_BOOT_DEVICES {
            return Result::Err(BootError::new(
                DIAG_BOOT_BASE | 0x010,
                "Boot device list full"
            ))
        }
        self.devices.set(self.num_devices, device)!
        self.num_devices = self.num_devices + 1
        Result::Ok(())
    }

    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.num_devices
    }
}

// ──────────────────────────────────────────────
// Boot Environment — Main State Bag
// ──────────────────────────────────────────────

pub type BootEnvironment : struct {
    protocol: BootProtocol,
    phase: BootPhase,
    flags: BootFlags,
    memory_map: MemoryMap,
    kernel: KernelImage,
    boot_device: BootDevice,
    boot_devices: BootDeviceList,
    selected_entry: u32,
    cmdline: FixedString[MAX_CMDLINE_LEN],
    kernel_path: FixedString[MAX_KERNEL_PATH],
    initramfs_path: FixedString[MAX_KERNEL_PATH],
    dtb_path: FixedString[MAX_KERNEL_PATH],
    video_mode: VideoMode,
    framebuffer_addr: Word64,
    framebuffer_width: Word32,
    framebuffer_height: Word32,
    framebuffer_pitch: Word32,
    framebuffer_bpp: u8,
    serial_port: Word16,
    acpi_rsdp: Word64,
    smbios_entry: Word64,
    uefi_system_table: Word64,
    uefi_boot_services: Word64,
    uefi_runtime_services: Word64,
    modules: FixedArray[MAX_MODULES, FixedString[128]],
    num_modules: u32,
    residual_records: FixedArray[MAX_RESIDUAL_RECORDS, FixedString[128]],
    num_residuals: u32,
    boot_ticks: Word64,
    error_count: u32,
    warning_count: u32,
    trust_state: TrustState,
}

impl BootEnvironment {
    pub fn new() -> BootEnvironment
        effects: [deterministic]
    {
        BootEnvironment {
            protocol: BootProtocol::None,
            phase: BootPhase::Entry,
            flags: BootFlags::empty(),
            memory_map: MemoryMap::new(),
            kernel: KernelImage::new(),
            boot_device: BootDevice {
                device_type: BootDeviceType::Unknown,
                partition_index: 0,
                fs_type: 0,
                device_path: FixedString::new(),
                firmware_handle: Word64::zero(),
                block_size: 512,
                total_blocks: Word64::zero(),
                is_bootable: false,
                is_removable: false,
            },
            boot_devices: BootDeviceList::new(),
            selected_entry: 0,
            cmdline: FixedString::new(),
            kernel_path: FixedString::new(),
            initramfs_path: FixedString::new(),
            dtb_path: FixedString::new(),
            video_mode: VideoMode::Unknown,
            framebuffer_addr: Word64::zero(),
            framebuffer_width: 0,
            framebuffer_height: 0,
            framebuffer_pitch: 0,
            framebuffer_bpp: 0,
            serial_port: 0x3F8,
            acpi_rsdp: Word64::zero(),
            smbios_entry: Word64::zero(),
            uefi_system_table: Word64::zero(),
            uefi_boot_services: Word64::zero(),
            uefi_runtime_services: Word64::zero(),
            modules: FixedArray::new(),
            num_modules: 0,
            residual_records: FixedArray::new(),
            num_residuals: 0,
            boot_ticks: Word64::zero(),
            error_count: 0,
            warning_count: 0,
            trust_state: TrustState::TrustState_Bootstrap,
        }
    }

    pub fn record_residual(self: ref mut, entry: FixedString[128])
        effects: [io:write, residual]
    {
        if self.num_residuals >= MAX_RESIDUAL_RECORDS {
            return
        }
        let idx: u32 = self.num_residuals
        self.residual_records.set(idx, entry)!
        self.num_residuals = self.num_residuals + 1
        residual emit {
            event: "boot_environment.residual_recorded",
            record_index: idx,
            trust_state: self.trust_state,
        }
    }

    pub fn set_phase(self: ref mut, phase: BootPhase)
        effects: [residual]
    {
        let old_phase: BootPhase = self.phase
        self.phase = phase
        residual emit {
            event: "boot_environment.phase_transition",
            from: old_phase,
            to: phase,
            boot_ticks: self.boot_ticks,
        }
    }

    pub fn set_trust_state(self: ref mut, state: TrustState)
        effects: [residual]
    {
        let old_state: TrustState = self.trust_state
        self.trust_state = state
        residual emit {
            event: "boot_environment.trust_transition",
            from: old_state,
            to: state,
        }
    }
}

// ──────────────────────────────────────────────
// ELF Parser
// ──────────────────────────────────────────────

pub fn parse_elf_header(data: &[u8], size: u32) -> Result[ELFHeader64, BootError]
    effects: [deterministic]
{
    let header: ELFHeader64 = ELFHeader64 {
        ident: ELFIdentification {
            magic: FixedArray::new(),
            arch_class: 0,
            data_encoding: 0,
            version: 0,
            os_abi: 0,
            abi_version: 0,
            padding: FixedArray::new(),
        },
        e_type: 0,
        e_machine: 0,
        e_version: 0,
        e_entry: Word64::zero(),
        e_phoff: Word64::zero(),
        e_shoff: Word64::zero(),
        e_flags: 0,
        e_ehsize: 0,
        e_phentsize: 0,
        e_phnum: 0,
        e_shentsize: 0,
        e_shnum: 0,
        e_shstrndx: 0,
    }

    if size < 64 {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x020,
            "ELF header too small: minimum 64 bytes required"
        ))
    }

    // Parse ELF identification bytes
    let mut magic: FixedArray[4, Word8] = FixedArray::new()
    for i in 0..4 {
        magic.push(data[i as usize])!
    }
    header.ident.magic = magic
    header.ident.arch_class = data[4]
    header.ident.data_encoding = data[5]
    header.ident.version = data[6]
    header.ident.os_abi = data[7]
    header.ident.abi_version = data[8]

    // Validate magic
    if data[0] != 0x7F || data[1] != 'E' as u8 || data[2] != 'L' as u8 || data[3] != 'F' as u8 {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x021,
            "Invalid ELF magic: expected 0x7F 'E' 'L' 'F'"
        ))
    }

    // Validate 64-bit
    if data[4] != 2 {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x022,
            "Only 64-bit ELF (class 2) is supported"
        ))
    }

    header.e_type = read_word16(data, 16)
    header.e_machine = read_word16(data, 18)
    header.e_version = read_word32(data, 20)
    header.e_entry = read_word64(data, 24)
    header.e_phoff = read_word64(data, 32)
    header.e_shoff = read_word64(data, 40)
    header.e_flags = read_word32(data, 48)
    header.e_ehsize = read_word16(data, 52)
    header.e_phentsize = read_word16(data, 54)
    header.e_phnum = read_word16(data, 56)
    header.e_shentsize = read_word16(data, 58)
    header.e_shnum = read_word16(data, 60)
    header.e_shstrndx = read_word16(data, 62)

    Result::Ok(header)
}

fn read_word16(data: &[u8], offset: u32) -> Word16
    effects: [deterministic]
{
    if offset + 1 >= data.len() as u32 {
        return 0
    }
    let low: u16 = data[offset as usize] as u16
    let high: u16 = (data[(offset + 1) as usize] as u16) << 8
    low | high
}

fn read_word32(data: &[u8], offset: u32) -> Word32
    effects: [deterministic]
{
    if offset + 3 >= data.len() as u32 {
        return 0
    }
    let b0: u32 = data[offset as usize] as u32
    let b1: u32 = (data[(offset + 1) as usize] as u32) << 8
    let b2: u32 = (data[(offset + 2) as usize] as u32) << 16
    let b3: u32 = (data[(offset + 3) as usize] as u32) << 24
    b0 | b1 | b2 | b3
}

fn read_word64(data: &[u8], offset: u32) -> Word64
    effects: [deterministic]
{
    if offset + 7 >= data.len() as u32 {
        return Word64::zero()
    }
    let low: Word64 = Word64::from_u64(read_word32(data, offset) as u64)
    let high: Word64 = Word64::from_u64((read_word32(data, offset + 4) as u64) << 32)
    low.bit_or(high)
}

pub fn parse_elf_program_headers(data: &[u8], header: ELFHeader64) -> Result[FixedArray[16, ELFProgramHeader64], BootError]
    effects: [deterministic]
{
    let mut segments: FixedArray[16, ELFProgramHeader64] = FixedArray::new()
    let phoff: Word64 = header.e_phoff
    let phentsize: Word16 = header.e_phentsize
    let phnum: Word16 = header.e_phnum

    if phnum == 0 {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x030,
            "ELF has no program headers"
        ))
    }

    if phentsize < 56 {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x031,
            "Program header entry too small: minimum 56 bytes"
        ))
    }

    let count: u32 = phnum as u32
    if count > 16 {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x032,
            "Too many program headers: maximum 16 supported"
        ))
    }

    for i in 0..count {
        let offset: u32 = phoff.to_u64() as u32 + (i * phentsize as u32)
        if offset + 56 > data.len() as u32 {
            return Result::Err(BootError::new(
                DIAG_BOOT_BASE | 0x033,
                "Program header extends beyond data buffer"
            ))
        }
        let ph: ELFProgramHeader64 = ELFProgramHeader64 {
            p_type: read_word32(data, offset),
            p_flags: read_word32(data, offset + 4),
            p_offset: read_word64(data, offset + 8),
            p_vaddr: read_word64(data, offset + 16),
            p_paddr: read_word64(data, offset + 24),
            p_filesz: read_word64(data, offset + 32),
            p_memsz: read_word64(data, offset + 40),
            p_align: read_word64(data, offset + 48),
        }
        segments.push(ph)!
    }

    Result::Ok(segments)
}

pub fn parse_elf_section_headers(data: &[u8], header: ELFHeader64) -> Result[FixedArray[64, ELFSectionHeader64], BootError]
    effects: [deterministic]
{
    let mut sections: FixedArray[64, ELFSectionHeader64] = FixedArray::new()
    let shoff: Word64 = header.e_shoff
    let shentsize: Word16 = header.e_shentsize
    let shnum: Word16 = header.e_shnum

    if shnum == 0 {
        return Result::Ok(sections)
    }

    let count: u32 = shnum as u32
    if count > 64 {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x040,
            "Too many section headers: maximum 64 supported"
        ))
    }

    for i in 0..count {
        let offset: u32 = shoff.to_u64() as u32 + (i * shentsize as u32)
        if offset + 64 > data.len() as u32 {
            return Result::Err(BootError::new(
                DIAG_BOOT_BASE | 0x041,
                "Section header extends beyond data buffer"
            ))
        }
        let sh: ELFSectionHeader64 = ELFSectionHeader64 {
            sh_name: read_word32(data, offset),
            sh_type: read_word32(data, offset + 4),
            sh_flags: read_word64(data, offset + 8),
            sh_addr: read_word64(data, offset + 16),
            sh_offset: read_word64(data, offset + 24),
            sh_size: read_word64(data, offset + 32),
            sh_link: read_word32(data, offset + 40),
            sh_info: read_word32(data, offset + 44),
            sh_addralign: read_word64(data, offset + 48),
            sh_entsize: read_word64(data, offset + 56),
        }
        sections.push(sh)!
    }

    Result::Ok(sections)
}

// ──────────────────────────────────────────────
// Video Mode Detection
// ──────────────────────────────────────────────

pub fn detect_video_mode(env: ref mut BootEnvironment, console: Cap(Console)) -> Result[VideoMode, BootError]
    effects: [io:write, machine:ioport, memory:mmio, residual]
{
    console.write_line("BootLoader: Detecting video mode...")!

    // Try UEFI GOP first
    if env.protocol == BootProtocol::UEFI {
        let gop_result: Result[VideoMode, BootError] = try_uefi_gop(env)
        if gop_result.is_ok() {
            let mode: VideoMode = gop_result.unwrap()
            console.write_line("BootLoader: UEFI GOP video mode detected")!
            residual emit {
                event: "boot.video_mode.detected",
                mode: mode,
                protocol: "UEFI_GOP",
            }
            return Result::Ok(mode)
        }
    }

    // Try VBE via multiboot
    if env.protocol == BootProtocol::MultiBoot2 {
        if env.framebuffer_addr.gt(Word64::zero()) {
            console.write_line("BootLoader: Multiboot framebuffer detected")!
            residual emit {
                event: "boot.video_mode.detected",
                mode: VideoMode::VGA1024x768,
                protocol: "MULTIBOOT_FRAMEBUFFER",
            }
            return Result::Ok(VideoMode::VGA1024x768)
        }
    }

    // Fall back to legacy VGA text mode
    let vga_result: Result[bool, BootError] = probe_vga_text_mode()
    if vga_result.is_ok() && vga_result.unwrap() {
        console.write_line("BootLoader: Legacy VGA text mode detected (80x25)")!
        residual emit {
            event: "boot.video_mode.detected",
            mode: VideoMode::Text80x25,
            protocol: "LEGACY_VGA",
        }
        return Result::Ok(VideoMode::Text80x25)
    }

    console.write_line("BootLoader: No video hardware detected, using serial only")!
    residual emit {
        event: "boot.video_mode.detected",
        mode: VideoMode::Unknown,
        protocol: "NONE_SERIAL_ONLY",
    }
    Result::Ok(VideoMode::Unknown)
}

fn try_uefi_gop(env: ref BootEnvironment) -> Result[VideoMode, BootError]
    effects: [memory:mmio, io:read]
{
    if env.uefi_boot_services.is_zero() {
        return Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x050,
            "UEFI boot services not available"
        ))
    }

    trusted "UEFI GOP: QueryGraphicsOutputMode via UEFI protocol, documented in UEFI Spec §12.9"
    {
        // Query GOP mode information from UEFI firmware
        // This would call UEFI LocateProtocol for GOP and QueryMode
        // On real hardware, returns pixel dimensions and format
        Result::Ok(VideoMode::UEFIGOP)
    }
}

fn probe_vga_text_mode() -> Result[bool, BootError]
    effects: [machine:ioport]
{
    trusted "VGA text mode probe: Read VGA status register at I/O port 0x3DA, documented in VGA HW Ref §3.5"
    {
        // In real hardware: inb(0x3DA) to check VGA status
        Result::Ok(true)
    }
}

// ──────────────────────────────────────────────
// Boot Protocol Detection
// ──────────────────────────────────────────────

pub fn detect_boot_protocol(magic: Word32, info_ptr: Word64) -> Result[BootProtocol, BootError]
    effects: [deterministic]
{
    // Multiboot v1 magic
    if magic == 0x2BADB002 {
        return Result::Ok(BootProtocol::MultiBoot1)
    }

    // Multiboot v2 magic
    if magic == 0x36D76289 {
        return Result::Ok(BootProtocol::MultiBoot2)
    }

    // Check for UEFI system table pointer
    if !info_ptr.is_zero() {
        // The presence of a valid system table indicates UEFI boot
        return Result::Ok(BootProtocol::UEFI)
    }

    Result::Err(BootError::new(
        DIAG_BOOT_BASE | 0x060,
        "No recognized boot protocol detected"
    ))
}

// ──────────────────────────────────────────────
// Memory Map Construction
// ──────────────────────────────────────────────

pub fn build_memory_map(env: ref mut BootEnvironment) -> Result[(), BootError]
    effects: [io:write, machine:ioport, memory:mmio, residual]
{
    let console: Cap(Console) = env.get_console_cap()!

    match env.protocol {
        BootProtocol::UEFI => {
            console.write_line("BootLoader: Building memory map from UEFI...")!
            let mmap_result: Result[MemoryMap, BootError] = uefi_get_memory_map(env)
            if mmap_result.is_ok() {
                env.memory_map = mmap_result.unwrap()
                console.write_line("BootLoader: UEFI memory map constructed")!
            } else {
                console.write_line("BootLoader: UEFI memory map failed, using fallback")!
                build_fallback_memory_map(env)!
            }
        },
        BootProtocol::MultiBoot1 | BootProtocol::MultiBoot2 => {
            console.write_line("BootLoader: Building memory map from Multiboot...")!
            let mb_result: Result[MemoryMap, BootError] = multiboot_get_memory_map(env)
            if mb_result.is_ok() {
                env.memory_map = mb_result.unwrap()
                console.write_line("BootLoader: Multiboot memory map constructed")!
            } else {
                console.write_line("BootLoader: Multiboot memory map failed, using fallback")!
                build_fallback_memory_map(env)!
            }
        },
        _ => {
            console.write_line("BootLoader: No boot protocol, using fallback memory map")!
            build_fallback_memory_map(env)!
        },
    }

    residual emit {
        event: "boot.memory_map.built",
        num_regions: env.memory_map.num_regions,
        total_ram: env.memory_map.total_ram,
        protocol: env.protocol,
    }

    Result::Ok(())
}

fn uefi_get_memory_map(env: ref BootEnvironment) -> Result[MemoryMap, BootError]
    effects: [io:read, deterministic]
{
    // Delegate to UEFI boot module
    get_uefi_memory_map(env.uefi_boot_services)
}

fn multiboot_get_memory_map(env: ref BootEnvironment) -> Result[MemoryMap, BootError]
    effects: [deterministic]
{
    // Delegate to multiboot module
    parse_multiboot_memory_map(env)
}

fn build_fallback_memory_map(env: ref mut BootEnvironment) -> Result[(), BootError]
    effects: [machine:ioport, deterministic]
{
    trusted "Fallback memory map: Use INT 0x15 E820 if available, documented in ACPI/BIOS spec §15"
    {
        let mut region: MemoryRegion = MemoryRegion {
            base_addr: Word64::zero(),
            length: Word64::from_u64(0x1000_0000),  // 256MB fallback
            region_type: 1,
            attributes: 0x000F,
            acpi_handle: Word64::zero(),
        }
        env.memory_map.add_region(region)!

        let region2: MemoryRegion = MemoryRegion {
            base_addr: Word64::from_u64(0x1000_0000),
            length: Word64::from_u64(0x7000_0000),  // 1.75GB
            region_type: 1,
            attributes: 0x000F,
            acpi_handle: Word64::zero(),
        }
        env.memory_map.add_region(region2)!
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Device Enumeration
// ──────────────────────────────────────────────

pub fn enumerate_boot_devices(env: ref mut BootEnvironment) -> Result[(), BootError]
    effects: [io:write, io:read, memory:mmio, deterministic]
{
    let console: Cap(Console) = env.get_console_cap()!
    console.write_line("BootLoader: Enumerating boot devices...")!

    match env.protocol {
        BootProtocol::UEFI => {
            enumerate_uefi_devices(env)!
        },
        _ => {
            console.write_line("BootLoader: Legacy device enumeration...")!
            enumerate_legacy_devices(env)!
        },
    }

    residual emit {
        event: "boot.devices.enumerated",
        count: env.boot_devices.num_devices,
    }

    Result::Ok(())
}

fn enumerate_uefi_devices(env: ref mut BootEnvironment) -> Result[(), BootError]
    effects: [io:read, memory:mmio, deterministic]
{
    trusted "UEFI device enumeration: LocateHandles for BlockIO and SimpleFileSystem, UEFI Spec §13.5"
    {
        let device: BootDevice = BootDevice {
            device_type: BootDeviceType::SSD,
            partition_index: 0,
            fs_type: 1,
            device_path: FixedString::from("\\EFI\\BOOT\\BOOTX64.EFI"),
            firmware_handle: Word64::from_u64(0x1000),
            block_size: 512,
            total_blocks: Word64::from_u64(0x100000),
            is_bootable: true,
            is_removable: false,
        }
        env.boot_devices.add_device(device)!

        let device2: BootDevice = BootDevice {
            device_type: BootDeviceType::USB,
            partition_index: 0,
            fs_type: 1,
            device_path: FixedString::from("\\EFI\\BOOT\\BOOTX64.EFI"),
            firmware_handle: Word64::from_u64(0x1001),
            block_size: 512,
            total_blocks: Word64::from_u64(0x80000),
            is_bootable: true,
            is_removable: true,
        }
        env.boot_devices.add_device(device2)!
        Result::Ok(())
    }
}

fn enumerate_legacy_devices(env: ref mut BootEnvironment) -> Result[(), BootError]
    effects: [machine:ioport, deterministic]
{
    trusted "Legacy device enumeration: INT 0x13 disk detect, documented in BIOS INT 0x13 AH=0x48"
    {
        let device: BootDevice = BootDevice {
            device_type: BootDeviceType::HDD,
            partition_index: 0,
            fs_type: 0,
            device_path: FixedString::from("hd0"),
            firmware_handle: Word64::from_u64(0x80),
            block_size: 512,
            total_blocks: Word64::from_u64(0x200000),
            is_bootable: true,
            is_removable: false,
        }
        env.boot_devices.add_device(device)!

        let device2: BootDevice = BootDevice {
            device_type: BootDeviceType::CDROM,
            partition_index: 0,
            fs_type: 0,
            device_path: FixedString::from("cd0"),
            firmware_handle: Word64::from_u64(0xE0),
            block_size: 2048,
            total_blocks: Word64::from_u64(0x100000),
            is_bootable: true,
            is_removable: true,
        }
        env.boot_devices.add_device(device2)!
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Kernel Loading
// ──────────────────────────────────────────────

pub fn load_kernel(env: ref mut BootEnvironment, console: Cap(Console)) -> Result[(), BootError]
    effects: [io:write, io:read, memory:mmio, residual]
{
    console.write_line("BootLoader: Loading kernel image...")!
    env.set_phase(BootPhase::KernelLoad)

    let kernel_data: FixedArray[65536, u8] = read_kernel_from_device(env)!

    let header: ELFHeader64 = parse_elf_header(kernel_data, kernel_data.len() as u32)!

    env.kernel.header = header
    env.kernel.entry_point = header.e_entry
    env.kernel.is_relocatable = header.e_type == 2 || header.e_type == 3

    let segments: FixedArray[16, ELFProgramHeader64] = parse_elf_program_headers(kernel_data, header)!
    env.kernel.num_segments = segments.len()
    for i in 0..segments.len() {
        env.kernel.segments.set(i, segments.get(i)!)!
    }

    let sections: FixedArray[64, ELFSectionHeader64] = parse_elf_section_headers(kernel_data, header)!
    env.kernel.num_sections = sections.len()
    for i in 0..sections.len() {
        env.kernel.sections.set(i, sections.get(i)!)!
    }

    env.kernel.image_size = env.kernel.compute_load_size()

    console.write_line("BootLoader: Kernel parsed successfully")!
    console.write_line(concat("BootLoader: Entry point: 0x", hex(env.kernel.entry_point)))!
    console.write_line(concat("BootLoader: Image size: ", env.kernel.image_size.to_string()))!
    console.write_line(concat("BootLoader: Segments: ", env.kernel.num_segments.to_string()))!

    residual emit {
        event: "boot.kernel.loaded",
        entry_point: env.kernel.entry_point,
        image_size: env.kernel.image_size,
        num_segments: env.kernel.num_segments,
        num_sections: env.kernel.num_sections,
        is_relocatable: env.kernel.is_relocatable,
    }

    Result::Ok(())
}

fn read_kernel_from_device(env: ref BootEnvironment) -> Result[FixedArray[65536, u8], BootError>
    effects: [io:read, deterministic]
{
    trusted "Kernel read: reading from boot device firmware interface, UEFI Spec §13.4"
    {
        let buffer: FixedArray[65536, u8] = FixedArray::new()
        Result::Ok(buffer)
    }
}

// ──────────────────────────────────────────────
// Fallback Handling
// ──────────────────────────────────────────────

pub type FallbackEntry : struct {
    name: FixedString[64],
    description: FixedString[256],
    kernel_path: FixedString[MAX_KERNEL_PATH],
    cmdline: FixedString[MAX_CMDLINE_LEN],
    flags: BootFlags,
}

pub type FallbackConfig : struct {
    entries: FixedArray[MAX_FALLBACK_ENTRIES, FallbackEntry],
    num_entries: u32,
}

impl FallbackConfig {
    pub fn new() -> FallbackConfig
        effects: [deterministic]
    {
        FallbackConfig {
            entries: FixedArray::new(),
            num_entries: 0,
        }
    }

    pub fn add_entry(self: ref mut, entry: FallbackEntry) -> Result[(), BootError]
        effects: [deterministic]
    {
        if self.num_entries >= MAX_FALLBACK_ENTRIES {
            return Result::Err(BootError::new(
                DIAG_BOOT_BASE | 0x070,
                "Fallback entry list full"
            ))
        }
        self.entries.set(self.num_entries, entry)!
        self.num_entries = self.num_entries + 1
        Result::Ok(())
    }
}

pub fn handle_boot_failure(env: ref mut BootEnvironment, error: BootError, console: Cap(Console)) -> FallbackEntry
    effects: [io:write, residual]
{
    console.write_line("BootLoader: BOOT FAILURE - initiating fallback")!
    console.write_line(error.message())!

    env.set_phase(BootPhase::Fallback)
    env.error_count = env.error_count + 1

    residual emit {
        event: "boot.fallback.initiated",
        error_code: error.code,
        error_message: error.message(),
        phase: env.phase,
    }

    // Build fallback entries
    let mut fallback: FallbackConfig = FallbackConfig::new()
    fallback.add_entry(FallbackEntry {
        name: FixedString::from("Safe Mode"),
        description: FixedString::from("Boot with minimal drivers and services"),
        kernel_path: FixedString::from("\\kernel\\kernel.safe"),
        cmdline: FixedString::from("safe_mode=1 loglevel=3"),
        flags: BootFlags::empty(),
    })!
    fallback.add_entry(FallbackEntry {
        name: FixedString::from("Recovery Console"),
        description: FixedString::from("Boot into recovery shell"),
        kernel_path: FixedString::from("\\kernel\\kernel.recovery"),
        cmdline: FixedString::from("recovery=1 single_user=1"),
        flags: BootFlags::empty(),
    })!
    fallback.add_entry(FallbackEntry {
        name: FixedString::from("Factory Reset"),
        description: FixedString::from("Restore factory settings"),
        kernel_path: FixedString::from("\\kernel\\kernel.reset"),
        cmdline: FixedString::from("factory_reset=1"),
        flags: BootFlags::empty(),
    })!

    // Select first fallback entry
    fallback.entries.get(0)!
}

// ──────────────────────────────────────────────
// Jump to Kernel
// ──────────────────────────────────────────────

pub fn jump_to_kernel(env: ref BootEnvironment) -> Result[(), BootError]
    effects: [io:write, machine:ioport, deterministic]
{
    let console: Cap(Console) = env.get_console_cap()!
    console.write_line("BootLoader: Jumping to kernel entry point...")!

    residual emit {
        event: "boot.kernel.jump",
        entry_point: env.kernel.entry_point,
        memory_map_regions: env.memory_map.num_regions,
        total_ram: env.memory_map.total_ram,
        cmdline: env.cmdline,
        num_modules: env.num_modules,
    }

    trusted "Jump to kernel: Switch to kernel page tables and jump to entry point, documented in CPU SDM Vol 3 §4.5"
    {
        // In real hardware: disable interrupts, set up kernel stack,
        // switch page tables, jump to entry point with boot info structure
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Boot Console Helper (temporary for env)
// ──────────────────────────────────────────────

impl BootEnvironment {
    pub fn get_console_cap(self) -> Result[Cap(Console), BootError>
        effects: [deterministic]
    {
        // The console capability is obtained at boot entry
        // and threaded through the boot process
        Result::Err(BootError::new(
            DIAG_BOOT_BASE | 0x0FF,
            "Console capability not available through env - pass explicitly"
        ))
    }
}

// ──────────────────────────────────────────────
// Main Boot Entry Point
// ──────────────────────────────────────────────

pub fn boot_main(magic: Word32, info_ptr: Word64, console: Cap(Console)) -> Result[(), BootError>
    effects: [io:write, io:read, machine:ioport, memory:mmio, residual]
{
    console.write_line("Phorensic Boot Loader v1.0")!
    console.write_line("==============================")!

    let mut env: BootEnvironment = BootEnvironment::new()
    env.boot_ticks = read_timestamp()

    // Detect boot protocol
    let protocol: BootProtocol = detect_boot_protocol(magic, info_ptr)!
    env.protocol = protocol
    console.write_line(concat("BootLoader: Detected protocol: ", protocol.to_string()))!

    residual emit {
        event: "boot.main.started",
        protocol: protocol,
        magic: magic,
        boot_ticks: env.boot_ticks,
    }

    // Phase 1: Early initialization
    env.set_phase(BootPhase::EarlyInit)
    perform_early_init(env)!

    // Phase 2: Console initialization
    env.set_phase(BootPhase::ConsoleInit)
    init_boot_console(env, console)!

    // Phase 3: Memory detection
    env.set_phase(BootPhase::MemoryInit)
    build_memory_map(env)!
    console.write_line(concat("BootLoader: Total RAM: ", env.memory_map.total_ram.to_string()))!

    // Phase 4: Load configuration
    env.set_phase(BootPhase::ConfigLoad)
    load_boot_configuration(env, console)!

    // Phase 5: Enumerate devices
    enumerate_boot_devices(env)!

    // Phase 6: Detect video mode
    let video: VideoMode = detect_video_mode(env, console)!
    env.video_mode = video

    // Phase 7: Show boot menu (if not configured for auto-boot)
    env.set_phase(BootPhase::MenuDisplay)
    let menu_selection: u32 = handle_boot_menu(env, console)
    env.selected_entry = menu_selection

    // Phase 8: Load kernel
    load_kernel(env, console)!

    // Phase 9: Load initramfs if configured
    if !env.flags.has(BOOT_FLAG_NO_INITRAMFS) {
        env.set_phase(BootPhase::InitramfsLoad)
        load_initramfs(env, console)!
    }

    // Phase 10: Load device tree if configured
    if !env.flags.has(BOOT_FLAG_NO_DEVICE_TREE) {
        env.set_phase(BootPhase::DeviceTreeLoad)
        load_device_tree(env, console)!
    }

    // Final trust transition
    env.set_trust_state(TrustState::TrustState_Operational)

    // Record final residuals
    env.record_residual(FixedString::from("boot_main: boot sequence complete"))!

    residual emit {
        event: "boot.main.complete",
        protocol: env.protocol,
        selected_entry: env.selected_entry,
        kernel_entry: env.kernel.entry_point,
        memory_regions: env.memory_map.num_regions,
        total_ram: env.memory_map.total_ram,
        modules_loaded: env.num_modules,
        video_mode: env.video_mode,
        errors: env.error_count,
        warnings: env.warning_count,
        boot_ticks: env.boot_ticks,
    }

    // Jump to kernel
    env.set_phase(BootPhase::JumpToKernel)
    jump_to_kernel(env)
}

pub fn perform_early_init(env: ref mut BootEnvironment) -> Result[(), BootError>
    effects: [machine:ioport, deterministic]
{
    trusted "Early init: Basic CPU and chipset initialization, documented in CPU SDM Vol 3 §8.4"
    {
        // Set up boot stack
        // Disable interrupts
        // Clear BSS
        // Initialize GDT with flat memory model
        env.set_trust_state(TrustState::TrustState_Loading)
        Result::Ok(())
    }
}

pub fn init_boot_console(env: ref BootEnvironment, console: Cap(Console)) -> Result[(), BootError>
    effects: [io:write, machine:ioport, deterministic]
{
    trusted "Serial console init: 16550 UART initialization at I/O port 0x3F8, documented in NS16550D datasheet §3"
    {
        // Set baud rate, data bits, parity, stop bits
        // Enable FIFO
        // Clear buffers
        console.write_line("BootLoader: Console initialized")!
        Result::Ok(())
    }
}

pub fn load_boot_configuration(env: ref mut BootEnvironment, console: Cap(Console)) -> Result[(), BootError>
    effects: [io:write, io:read, deterministic]
{
    console.write_line("BootLoader: Loading boot configuration...")!
    let config: BootConfiguration = parse_boot_config(env)!
    env.cmdline = config.get_kernel_cmdline(env.selected_entry)
    env.kernel_path = config.get_kernel_path(env.selected_entry)
    env.initramfs_path = config.get_initramfs_path(env.selected_entry)
    env.dtb_path = config.get_dtb_path(env.selected_entry)
    console.write_line("BootLoader: Boot configuration loaded")!
    Result::Ok(())
}

pub fn handle_boot_menu(env: ref BootEnvironment, console: Cap(Console)) -> u32
    effects: [io:write, io:read, deterministic]
{
    let menu: BootMenu = BootMenu::new()
    menu.display_menu(console)
}

pub fn load_initramfs(env: ref BootEnvironment, console: Cap(Console)) -> Result[(), BootError>
    effects: [io:write, io:read, deterministic]
{
    console.write_line("BootLoader: Loading initramfs...")!
    // Delegated to initramfs module
