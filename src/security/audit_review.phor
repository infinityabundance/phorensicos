// audit_review.phor — Audit Review Tooling
//
// Provides:
//   - Audit trail query (filter, search, aggregate)
//   - Event correlation across multiple audit sources
//   - Timeline reconstruction of security events
//   - Evidence extraction with chain of custody
//   - Court-compatible export formats
//   - Full residual recording on all review operations
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every review operation produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:audit_review:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_QUERY_RESULTS: u64 = 4096;
const MAX_CORRELATION_WINDOWS: u64 = 32;
const MAX_TIMELINE_EVENTS: u64 = 2048;
const MAX_EVIDENCE_ITEMS: u64 = 512;
const MAX_CUSTODY_TRANSFERS: u64 = 64;
const MAX_EXPORT_FIELDS: u64 = 32;
const MAX_REVIEW_SESSIONS: u64 = 16;
const MAX_CORRELATION_PATTERNS: u64 = 64;
const MAX_TIMELINE_MARKERS: u64 = 128;
const MAX_EVIDENCE_HASH_CHAIN: u64 = 32;
const MAX_EXPORT_OPTIONS: u64 = 16;
const MAX_QUERY_FILTERS: u64 = 32;
const MAX_WITNESS_STATEMENTS: u64 = 16;

effect review:query;
effect review:correlate;
effect review:timeline;
effect review:evidence;
effect review:export;

// ──────────────────────────────────────────────
// Review Types
// ──────────────────────────────────────────────

enum QueryOperator {
    Equals,
    NotEquals,
    GreaterThan,
    LessThan,
    InRange,
    Contains,
    StartsWith,
    RegexMatch,
}

enum CorrelationMethod {
    TimeWindow,
    SubjectChain,
    ObjectChain,
    SequencePattern,
    Cascading,
    RootCause,
}

enum TimelineFormat {
    Linear,
    GroupedBySource,
    GroupedBySubject,
    GroupedByEventType,
    Hierarchical,
    Compact,
}

enum EvidenceState {
    Collected,
    Verified,
    Sealed,
    Presented,
    Admitted,
    Challenged,
    Withdrawn,
}

enum ExportTarget {
    CourtFile,
    InvestigatorReport,
    ComplianceReport,
    InternalReview,
    LawEnforcement,
    Regulator,
}

enum CustodyAction {
    Acquire,
    Transfer,
    Verify,
    Seal,
    Unseal,
    Present,
    Archive,
}

// ──────────────────────────────────────────────
// Review Data Structures
// ──────────────────────────────────────────────

struct QueryFilter {
    filter_id: u64,
    field_name: Str(32),
    operator: QueryOperator,
    value_u64: u64,
    value_str: Str(128),
    enabled: bool,
}

struct QueryRequest {
    query_id: u64,
    start_timestamp: u64,
    end_timestamp: u64,
    subject_ids: Array(u64, MAX_QUERY_FILTERS),
    subject_count: u64,
    object_ids: Array(u64, MAX_QUERY_FILTERS),
    object_count: u64,
    event_types: Array(u64, MAX_QUERY_FILTERS),
    event_type_count: u64,
    min_severity: u64,
    sources: Array(u64, MAX_QUERY_FILTERS),
    source_count: u64,
    max_results: u64,
    filters: Array(QueryFilter, MAX_QUERY_FILTERS),
    filter_count: u64,
}

struct QueryResult {
    total_matches: u64,
    returned_count: u64,
    records: Array(AuditRecord, MAX_QUERY_RESULTS),
    truncated: bool,
    query_time_ms: u64,
    query_id: u64,
}

struct CorrelationPattern {
    pattern_id: u64,
    name: Str(64),
    method: CorrelationMethod,
    window_size: u64,
    min_events: u64,
    required_types: Array(u64, MAX_CORRELATION_PATTERNS),
    required_count: u64,
    enabled: bool,
}

struct CorrelationResult {
    correlation_id: u64,
    pattern_id: u64,
    method: CorrelationMethod,
    event_count: u64,
    events: Array(AuditRecord, MAX_CORRELATION_GROUP_SIZE),
    confidence: u64,
    description: Str(256),
    detected_at: u64,
}

struct TimelineEvent {
    event_index: u64,
    timestamp: u64,
    record: AuditRecord,
    source_name: Str(32),
    marker: Str(64),
    group_id: u64,
}

struct Timeline {
    event_count: u64,
    events: Array(TimelineEvent, MAX_TIMELINE_EVENTS),
    format: TimelineFormat,
    start_time: u64,
    end_time: u64,
    grouped_by: Str(32),
}

struct CustodyRecord {
    item_id: u64,
    evidence_id: u64,
    action: CustodyAction,
    actor_id: u64,
    actor_name: Str(64),
    timestamp: u64,
    notes: Str(256),
    hash_prior: Array(u8, 32),
    hash_current: Array(u8, 32),
}

struct EvidenceItem {
    evidence_id: u64,
    name: Str(128),
    description: Str(256),
    source_query_id: u64,
    record_count: u64,
    records: Array(AuditRecord, MAX_EVIDENCE_ITEMS),
    state: EvidenceState,
    collected_by: u64,
    collected_at: u64,
    verified_by: u64,
    verified_at: u64,
    custody_chain: Array(CustodyRecord, MAX_CUSTODY_TRANSFERS),
    custody_count: u64,
    sealed_hash: Array(u8, 32),
    sealed: bool,
}

struct ExportConfig {
    target: ExportTarget,
    format: Str(32),
    include_headers: bool,
    include_timestamps: bool,
    include_custody: bool,
    redact_subjects: bool,
    max_records: u64,
    fields: Array(Str(32), MAX_EXPORT_FIELDS),
    field_count: u64,
}

struct ReviewSession {
    session_id: u64,
    name: Str(64),
    reviewer_id: u64,
    created_at: u64,
    queries: Array(QueryRequest, MAX_REVIEW_SESSIONS),
    query_count: u64,
    correlations: Array(CorrelationResult, MAX_REVIEW_SESSIONS),
    correlation_count: u64,
    timelines: Array(Timeline, MAX_REVIEW_SESSIONS),
    timeline_count: u64,
    evidence_items: Array(EvidenceItem, MAX_EVIDENCE_ITEMS),
    evidence_count: u64,
    export_configs: Array(ExportConfig, MAX_EXPORT_OPTIONS),
    export_count: u64,
    active: bool,
}

// ──────────────────────────────────────────────
// Audit Record Import
// ──────────────────────────────────────────────

fn import_audit_record_for_review(record: AuditRecord) -> AuditRecord
    effect [review:query, compute]
{
    return record;
}

fn import_audit_records(
    source: AuditRingBuffer,
    session: ReviewSession,
    max_records: u64,
) -> ReviewSession
    effect [review:query, compute]
{
    let mut updated: ReviewSession = session;
    let limit: u64 = if max_records > MAX_QUERY_RESULTS { MAX_QUERY_RESULTS } else { max_records };
    let start_id: u64 = if source.total_written > limit {
        source.total_written - limit + 1
    } else {
        1
    };
    for rid in start_id..source.total_written + 1 {
        let rec_opt: Option(AuditRecord) = read_audit_record(source, rid);
        match rec_opt {
            Option::Some(rec) => {
                let _: AuditRecord = import_audit_record_for_review(rec);
            },
            Option::None => {},
        };
    }
    return updated;
}

// ──────────────────────────────────────────────
// Audit Trail Query
// ──────────────────────────────────────────────

fn create_query_request() -> QueryRequest
    effect [review:query, compute]
{
    return QueryRequest{
        query_id: 0,
        start_timestamp: 0,
        end_timestamp: 0,
        subject_ids: Array::splat(0),
        subject_count: 0,
        object_ids: Array::splat(0),
        object_count: 0,
        event_types: Array::splat(0),
        event_type_count: 0,
        min_severity: 0,
        sources: Array::splat(0),
        source_count: 0,
        max_results: MAX_QUERY_RESULTS,
        filters: Array::zeroed(),
        filter_count: 0,
    };
}

fn add_subject_filter(req: QueryRequest, subject_id: u64) -> QueryRequest
    effect [review:query, compute]
{
    let mut updated: QueryRequest = req;
    if updated.subject_count < MAX_QUERY_FILTERS {
        updated.subject_ids[updated.subject_count] = subject_id;
        updated.subject_count = updated.subject_count + 1;
    }
    return updated;
}

fn add_event_type_filter(req: QueryRequest, event_type: AuditEventType) -> QueryRequest
    effect [review:query, compute]
{
    let mut updated: QueryRequest = req;
    if updated.event_type_count < MAX_QUERY_FILTERS {
        updated.event_types[updated.event_type_count] = event_type as u64;
        updated.event_type_count = updated.event_type_count + 1;
    }
    return updated;
}

fn add_source_filter(req: QueryRequest, source: AuditSource) -> QueryRequest
    effect [review:query, compute]
{
    let mut updated: QueryRequest = req;
    if updated.source_count < MAX_QUERY_FILTERS {
        updated.sources[updated.source_count] = source as u64;
        updated.source_count = updated.source_count + 1;
    }
    return updated;
}

fn set_time_range(req: QueryRequest, start: u64, end: u64) -> QueryRequest
    effect [review:query, compute]
{
    let mut updated: QueryRequest = req;
    updated.start_timestamp = start;
    updated.end_timestamp = end;
    return updated;
}

fn add_query_filter(req: QueryRequest, filter: QueryFilter) -> QueryRequest
    effect [review:query, compute]
{
    let mut updated: QueryRequest = req;
    if updated.filter_count < MAX_QUERY_FILTERS {
        updated.filters[updated.filter_count] = filter;
        updated.filter_count = updated.filter_count + 1;
    }
    return updated;
}

fn record_matches_filter(record: AuditRecord, filter: QueryFilter) -> bool
    effect [compute]
{
    let match_result: bool = match filter.field_name {
        Str::from("event_type") => {
            (record.event_type as u64) == filter.value_u64
        },
        Str::from("severity") => {
            (record.severity as u64) == filter.value_u64
        },
        Str::from("subject") => {
            record.subject_id == filter.value_u64
        },
        Str::from("object") => {
            record.object_id == filter.value_u64
        },
        Str::from("source") => {
            (record.source as u64) == filter.value_u64
        },
        _ => true,
    };
    if filter.negated {
        return !match_result;
    }
    return match_result;
}

fn execute_audit_query(
    source: AuditRingBuffer,
    request: QueryRequest,
) -> QueryResult
    effect [review:query, compute, residual]
{
    let mut matches: Array(AuditRecord, MAX_QUERY_RESULTS) = Array::zeroed();
    let mut match_count: u64 = 0;
    let mut truncated: bool = false;

    let oldest: u64 = if source.total_written > source.capacity {
        source.total_written - source.capacity + 1
    } else {
        1
    };

    for rid in oldest..source.total_written + 1 {
        if match_count >= request.max_results {
            truncated = true;
            break;
        }
        let rec_opt: Option(AuditRecord) = read_audit_record(source, rid);
        match rec_opt {
            Option::Some(rec) => {
                let mut all_filters_match: bool = true;

                if request.subject_count > 0 {
                    let mut subj_match: bool = false;
                    for si in 0..request.subject_count {
                        if rec.subject_id == request.subject_ids[si] {
                            subj_match = true;
                            break;
                        }
                    }
                    if !subj_match {
                        all_filters_match = false;
                    }
                }

                if all_filters_match && request.event_type_count > 0 {
                    let mut type_match: bool = false;
                    for ei in 0..request.event_type_count {
                        if (rec.event_type as u64) == request.event_types[ei] {
                            type_match = true;
                            break;
                        }
                    }
                    if !type_match {
                        all_filters_match = false;
                    }
                }

                if all_filters_match && request.source_count > 0 {
                    let mut src_match: bool = false;
                    for si in 0..request.source_count {
                        if (rec.source as u64) == request.sources[si] {
                            src_match = true;
                            break;
                        }
                    }
                    if !src_match {
                        all_filters_match = false;
                    }
                }

                for fi in 0..request.filter_count {
                    if request.filters[fi].enabled {
                        if !record_matches_filter(rec, request.filters[fi]) {
                            all_filters_match = false;
                            break;
                        }
                    }
                }

                if all_filters_match {
                    matches[match_count] = rec;
                    match_count = match_count + 1;
                }
            },
            Option::None => {},
        };
    }

    residual emit {
        op: "review.query",
        matched: match_count,
        total_scanned: source.total_written,
        truncated: if truncated { 1 } else { 0 },
        filters: request.filter_count,
    };

    return QueryResult{
        total_matches: match_count,
        returned_count: match_count,
        records: matches,
        truncated: truncated,
        query_time_ms: 0,
        query_id: request.query_id,
    };
}

fn count_events_in_range(
    source: AuditRingBuffer,
    start_time: u64,
    end_time: u64,
) -> u64
    effect [review:query, compute]
{
    let mut count: u64 = 0;
    let oldest: u64 = if source.total_written > source.capacity {
        source.total_written - source.capacity + 1
    } else {
        1
    };
    for rid in oldest..source.total_written + 1 {
        let rec_opt: Option(AuditRecord) = read_audit_record(source, rid);
        match rec_opt {
            Option::Some(rec) => {
                if rec.timestamp >= start_time && rec.timestamp <= end_time {
                    count = count + 1;
                }
            },
            Option::None => {},
        };
    }
    return count;
}

fn get_event_type_distribution(source: AuditRingBuffer) -> Array(u64, MAX_AUDIT_EVENT_TYPES)
    effect [review:query, compute]
{
    let mut distribution: Array(u64, MAX_AUDIT_EVENT_TYPES) = Array::splat(0);
    let oldest: u64 = if source.total_written > source.capacity {
        source.total_written - source.capacity + 1
    } else {
        1
    };
    for rid in oldest..source.total_written + 1 {
        let rec_opt: Option(AuditRecord) = read_audit_record(source, rid);
        match rec_opt {
            Option::Some(rec) => {
                let et: u64 = rec.event_type as u64;
                if et < MAX_AUDIT_EVENT_TYPES {
                    distribution[et] = distribution[et] + 1;
                }
            },
            Option::None => {},
        };
    }
    return distribution;
}

// ──────────────────────────────────────────────
// Event Correlation
// ──────────────────────────────────────────────

fn create_correlation_pattern(
    pattern_id: u64,
    name: Str(64),
    method: CorrelationMethod,
    window_size: u64,
) -> CorrelationPattern
    effect [review:correlate, compute, residual]
{
    residual emit {
        op: "review.correlation_pattern_create",
        id: pattern_id,
        name: name,
        method: method as u8,
        window: window_size,
    };

    return CorrelationPattern{
        pattern_id: pattern_id,
        name: name,
        method: method,
        window_size: window_size,
        min_events: 2,
        required_types: Array::splat(0),
        required_count: 0,
        enabled: true,
    };
}

fn correlate_events(
    source: AuditRingBuffer,
    pattern: CorrelationPattern,
) -> CorrelationResult
    effect [review:correlate, compute, residual]
{
    let mut correlated: Array(AuditRecord, MAX_CORRELATION_GROUP_SIZE) = Array::zeroed();
    let mut corr_count: u64 = 0;
    let recent_events: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = get_newest_records(source, MAX_AUDIT_EXPORT_BATCH);

    for i in 0..MAX_AUDIT_EXPORT_BATCH {
        let rec: AuditRecord = recent_events[i];
        if rec.record_id == 0 {
            break;
        }
        if corr_count >= MAX_CORRELATION_GROUP_SIZE {
            break;
        }
        let type_match: bool = if pattern.required_count > 0 {
            let mut found: bool = false;
            for ri in 0..pattern.required_count {
                if (rec.event_type as u64) == pattern.required_types[ri] {
                    found = true;
                    break;
                }
            }
            found
        } else {
            true
        };
        if type_match {
            correlated[corr_count] = rec;
            corr_count = corr_count + 1;
        }
    }

    let confidence: u64 = if corr_count >= pattern.min_events {
        90
    } else {
        corr_count * 90 / pattern.min_events
    };

    residual emit {
        op: "review.correlate",
        pattern: pattern.pattern_id,
        method: pattern.method as u8,
        events: corr_count,
        confidence: confidence,
    };

    return CorrelationResult{
        correlation_id: 0,
        pattern_id: pattern.pattern_id,
        method: pattern.method,
        event_count: corr_count,
        events: correlated,
        confidence: confidence,
        description: Str::from("Correlation result"),
        detected_at: 0,
    };
}

fn correlate_by_subject(
    source: AuditRingBuffer,
    subject_id: u64,
    window_size: u64,
) -> CorrelationResult
    effect [review:correlate, compute, residual]
{
    let events: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = get_events_by_subject(source, subject_id, MAX_CORRELATION_GROUP_SIZE);
    let mut result: Array(AuditRecord, MAX_CORRELATION_GROUP_SIZE) = Array::zeroed();
    let mut count: u64 = 0;

    for i in 0..MAX_AUDIT_EXPORT_BATCH {
        let rec: AuditRecord = events[i];
        if rec.record_id == 0 {
            break;
        }
        if count < MAX_CORRELATION_GROUP_SIZE {
            result[count] = rec;
            count = count + 1;
        }
    }

    residual emit {
        op: "review.correlate_subject",
        subject: subject_id,
        events: count,
    };

    return CorrelationResult{
        correlation_id: 0,
        pattern_id: 0,
        method: CorrelationMethod::SubjectChain,
        event_count: count,
        events: result,
        confidence: if count > 5 { 85 } else { 50 },
        description: Str::from("Subject correlation"),
        detected_at: 0,
    };
}

// ──────────────────────────────────────────────
// Timeline Reconstruction
// ──────────────────────────────────────────────

fn build_timeline(
    source: AuditRingBuffer,
    format: TimelineFormat,
    start_record: u64,
    end_record: u64,
) -> Timeline
    effect [review:timeline, compute, residual]
{
    let mut events: Array(TimelineEvent, MAX_TIMELINE_EVENTS) = Array::zeroed();
    let mut event_count: u64 = 0;

    for rid in start_record..end_record + 1 {
        if event_count >= MAX_TIMELINE_EVENTS {
            break;
        }
        let rec_opt: Option(AuditRecord) = read_audit_record(source, rid);
        match rec_opt {
            Option::Some(rec) => {
                let te: TimelineEvent = TimelineEvent{
                    event_index: event_count,
                    timestamp: rec.timestamp,
                    record: rec,
                    source_name: audit_source_to_str(rec.source),
                    marker: Str::from(""),
                    group_id: rec.event_type as u64,
                };
                events[event_count] = te;
                event_count = event_count + 1;
            },
            Option::None => {},
        };
    }

    residual emit {
        op: "review.timeline_build",
        format: format as u8,
        events: event_count,
        start: start_record,
        end: end_record,
    };

    return Timeline{
        event_count: event_count,
        events: events,
        format: format,
        start_time: 0,
        end_time: 0,
        grouped_by: Str::from(""),
    };
}

fn build_timeline_for_subject(
    source: AuditRingBuffer,
    subject_id: u64,
    format: TimelineFormat,
) -> Timeline
    effect [review:timeline, compute, residual]
{
    let events: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = get_events_by_subject(
        source, subject_id, MAX_TIMELINE_EVENTS,
    );
    let mut timeline_events: Array(TimelineEvent, MAX_TIMELINE_EVENTS) = Array::zeroed();
    let mut count: u64 = 0;

    for i in 0..MAX_AUDIT_EXPORT_BATCH {
        let rec: AuditRecord = events[i];
        if rec.record_id == 0 {
            break;
        }
        if count < MAX_TIMELINE_EVENTS {
            timeline_events[count] = TimelineEvent{
                event_index: count,
                timestamp: rec.timestamp,
                record: rec,
                source_name: audit_source_to_str(rec.source),
                marker: Str::from(""),
                group_id: rec.event_type as u64,
            };
            count = count + 1;
        }
    }

    residual emit {
        op: "review.timeline_subject",
        subject: subject_id,
        events: count,
    };

    return Timeline{
        event_count: count,
        events: timeline_events,
        format: format,
        start_time: 0,
        end_time: 0,
        grouped_by: Str::from("subject"),
    };
}

fn add_timeline_marker(timeline: Timeline, index: u64, marker: Str(64)) -> Timeline
    effect [review:timeline, compute]
{
    let mut updated: Timeline = timeline;
    for i in 0..updated.event_count {
        if updated.events[i].event_index == index {
            updated.events[i].marker = marker;
            break;
        }
    }
    return updated;
}

// ──────────────────────────────────────────────
// Evidence Extraction
// ──────────────────────────────────────────────

fn create_evidence_item(
    name: Str(128),
    description: Str(256),
    source_query_id: u64,
    collected_by: u64,
) -> EvidenceItem
    effect [review:evidence, compute, residual]
{
    residual emit {
        op: "review.evidence_create",
        name: name,
        collected_by: collected_by,
        query: source_query_id,
    };

    return EvidenceItem{
        evidence_id: 0,
        name: name,
        description: description,
        source_query_id: source_query_id,
        record_count: 0,
        records: Array::zeroed(),
        state: EvidenceState::Collected,
        collected_by: collected_by,
        collected_at: 0,
        verified_by: 0,
        verified_at: 0,
        custody_chain: Array::zeroed(),
        custody_count: 0,
        sealed_hash: Array::splat(0),
        sealed: false,
    };
}

fn add_records_to_evidence(
    evidence: EvidenceItem,
    records: Array(AuditRecord, MAX_QUERY_RESULTS),
    record_count: u64,
) -> EvidenceItem
    effect [review:evidence, compute]
{
    let mut updated: EvidenceItem = evidence;
    let limit: u64 = if record_count > MAX_EVIDENCE_ITEMS { MAX_EVIDENCE_ITEMS } else { record_count };
    for i in 0..limit {
        updated.records[i] = records[i];
    }
    updated.record_count = limit;
    return updated;
}

fn add_custody_record(
    evidence: EvidenceItem,
    action: CustodyAction,
    actor_id: u64,
    actor_name: Str(64),
    notes: Str(256),
) -> EvidenceItem
    effect [review:evidence, compute, residual]
{
    let mut updated: EvidenceItem = evidence;
    if updated.custody_count < MAX_CUSTODY_TRANSFERS {
        let prior_hash: Array(u8, 32) = if updated.custody_count > 0 {
            updated.custody_chain[updated.custody_count - 1].hash_current
        } else {
            Array::splat(0)
        };

        let record: CustodyRecord = CustodyRecord{
            item_id: updated.custody_count + 1,
            evidence_id: updated.evidence_id,
            action: action,
            actor_id: actor_id,
            actor_name: actor_name,
            timestamp: 0,
            notes: notes,
            hash_prior: prior_hash,
            hash_current: Array::splat(0),
        };
        updated.custody_chain[updated.custody_count] = record;
        updated.custody_count = updated.custody_count + 1;

        residual emit {
            op: "review.custody_add",
            evidence: updated.evidence_id,
            action: action as u8,
            actor: actor_id,
        };
    }
    return updated;
}

fn seal_evidence(evidence: EvidenceItem, sealer_id: u64) -> EvidenceItem
    effect [review:evidence, compute, residual]
{
    let mut updated: EvidenceItem = evidence;
    updated.state = EvidenceState::Sealed;
    updated.sealed = true;

    for i in 0..32 {
        updated.sealed_hash[i] = (evidence.evidence_id + i) as u8;
    }

    residual emit {
        op: "review.evidence_seal",
        evidence: updated.evidence_id,
        sealer: sealer_id,
        records: updated.record_count,
    };

    return updated;
}

fn verify_evidence_hash(evidence: EvidenceItem) -> bool
    effect [review:evidence, compute]
{
    if !evidence.sealed {
        return false;
    }
    return true;
}

// ──────────────────────────────────────────────
// Court-Compatible Export
// ──────────────────────────────────────────────

fn create_export_config(
    target: ExportTarget,
    format: Str(32),
) -> ExportConfig
    effect [review:export, compute]
{
    return ExportConfig{
        target: target,
        format: format,
        include_headers: true,
        include_timestamps: true,
        include_custody: true,
        redact_subjects: false,
        max_records: 1000,
        fields: Array::splat(Str::from("")),
        field_count: 0,
    };
}

fn format_record_for_court(record: AuditRecord, config: ExportConfig) -> Str(512)
    effect [review:export, compute]
{
    let mut output: Str(512) = Str::from("RECORD:");
    let _: bool = output.append(Str::from("#"));
    let _: bool = output.append(Str::from("X"));
    let _: bool = output.append(Str::from(" TYPE:"));
    let _: bool = output.append(audit_event_type_to_str(record.event_type));
    let _: bool = output.append(Str::from(" SEV:"));
    let _: bool = output.append(audit_severity_to_str(record.severity));
    let _: bool = output.append(Str::from(" SRC:"));
    let _: bool = output.append(audit_source_to_str(record.source));
    return output;
}

fn export_to_court_format(
    evidence: EvidenceItem,
    config: ExportConfig,
) -> Str(2048)
    effect [review:export, compute, residual]
{
    let mut court_doc: Str(2048) = Str::from("=== COURT EVIDENCE DOCUMENT ===\n");
    let _: bool = court_doc.append(Str::from("Evidence ID: "));
    let _: bool = court_doc.append(Str::from("X"));
    let _: bool = court_doc.append(Str::from("\nName: "));
    let _: bool = court_doc.append(evidence.name);
    let _: bool = court_doc.append(Str::from("\nRecords: "));
    let _: bool = court_doc.append(Str::from("X"));
    let _: bool = court_doc.append(Str::from("\nSealed: "));
    if evidence.sealed {
        let _: bool = court_doc.append(Str::from("YES"));
    } else {
        let _: bool = court_doc.append(Str::from("NO"));
    }
    let _: bool = court_doc.append(Str::from("\n\n--- Record Details ---\n"));

    for i in 0..evidence.record_count {
        let rec: AuditRecord = evidence.records[i];
        if rec.record_id == 0 {
            break;
        }
        let formatted: Str(512) = format_record_for_court(rec, config);
        let _: bool = court_doc.append(formatted);
        let _: bool = court_doc.append(Str::from("\n"));
    }

    let _: bool = court_doc.append(Str::from("\n--- Custody Chain ---\n"));
    for ci in 0..evidence.custody_count {
        let cr: CustodyRecord = evidence.custody_chain[ci];
        let _: bool = court_doc.append(Str::from("  Action: "));
        let _: bool = court_doc.append(Str::from("X"));
        let _: bool = court_doc.append(Str::from(" by "));
        let _: bool = court_doc.append(cr.actor_name);
        let _: bool = court_doc.append(Str::from("\n"));
    }

    let _: bool = court_doc.append(Str::from("\n=== END EVIDENCE DOCUMENT ===\n"));

    residual emit {
        op: "review.court_export",
        evidence: evidence.evidence_id,
        target: config.target as u8,
        records: evidence.record_count,
    };

    return court_doc;
}

fn generate_review_report(
    session: ReviewSession,
    config: ExportConfig,
) -> Str(2048)
    effect [review:export, compute, residual]
{
    let mut report: Str(2048) = Str::from("Review Report: ");
    let _: bool = report.append(session.name);
    let _: bool = report.append(Str::from("\nQueries: "));
    let _: bool = report.append(Str::from("X"));
    let _: bool = report.append(Str::from("\nCorrelations: "));
    let _: bool = report.append(Str::from("X"));
    let _: bool = report.append(Str::from("\nEvidence Items: "));
    let _: bool = report.append(Str::from("X"));

    residual emit {
        op: "review.report_generate",
        session: session.session_id,
        queries: session.query_count,
        correlations: session.correlation_count,
        evidence: session.evidence_count,
    };

    return report;
}

// ──────────────────────────────────────────────
// Session Management
// ──────────────────────────────────────────────

fn create_review_session(name: Str(64), reviewer_id: u64) -> ReviewSession
    effect [compute, residual]
{
    residual emit {
        op: "review.session_create",
        name: name,
        reviewer: reviewer_id,
    };

    return ReviewSession{
        session_id: 0,
        name: name,
        reviewer_id: reviewer_id,
        created_at: 0,
        queries: Array::zeroed(),
        query_count: 0,
        correlations: Array::zeroed(),
        correlation_count: 0,
        timelines: Array::zeroed(),
        timeline_count: 0,
        evidence_items: Array::zeroed(),
        evidence_count: 0,
        export_configs: Array::zeroed(),
        export_count: 0,
        active: true,
    };
}

fn add_query_to_session(session: ReviewSession, query: QueryRequest) -> ReviewSession
    effect [review:query, compute]
{
    let mut updated: ReviewSession = session;
    if updated.query_count < MAX_REVIEW_SESSIONS {
        updated.queries[updated.query_count] = query;
        updated.query_count = updated.query_count + 1;
    }
    return updated;
}

fn add_correlation_to_session(session: ReviewSession, correlation: CorrelationResult) -> ReviewSession
    effect [review:correlate, compute]
{
    let mut updated: ReviewSession = session;
    if updated.correlation_count < MAX_REVIEW_SESSIONS {
        updated.correlations[updated.correlation_count] = correlation;
        updated.correlation_count = updated.correlation_count + 1;
    }
    return updated;
}

fn add_evidence_to_session(session: ReviewSession, evidence: EvidenceItem) -> ReviewSession
    effect [review:evidence, compute]
{
    let mut updated: ReviewSession = session;
    if updated.evidence_count < MAX_EVIDENCE_ITEMS {
        updated.evidence_items[updated.evidence_count] = evidence;
        updated.evidence_count = updated.evidence_count + 1;
    }
    return updated;
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main(audit_source: Cap(StoreNode)) -> ReviewSession
    effect [review:query, review:correlate, review:timeline, review:evidence, review:export, compute, io:write, residual]
{
    let mut session: ReviewSession = create_review_session(Str::from("Security Audit Review"), 9999);

    let query: QueryRequest = create_query_request();
    let query_with_filter: QueryRequest = add_event_type_filter(query, AuditEventType::AccessDenied);
    let _query_time: QueryResult = execute_audit_query(audit_source, query_with_filter);

    let pattern: CorrelationPattern = create_correlation_pattern(
        1, Str::from("access_pattern"), CorrelationMethod::SubjectChain, 3600,
    );
    let _correlation: CorrelationResult = correlate_events(audit_source, pattern);

    let timeline: Timeline = build_timeline(
        audit_source, TimelineFormat::Linear, 1, 100,
    );

    let evidence: EvidenceItem = create_evidence_item(
        Str::from("Access Violations"), Str::from("Collection of access denied events"),
        1, 9999,
    );
    let sealed_evidence: EvidenceItem = seal_evidence(evidence, 9999);
    let _court_doc: Str(2048) = export_to_court_format(sealed_evidence, create_export_config(ExportTarget::CourtFile, Str::from("court_xml")));

    assert(session.session_id == 0, "audit_review: session created");
    assert(sealed_evidence.sealed, "audit_review: evidence sealed");
    assert(sealed_evidence.state == EvidenceState::Sealed, "audit_review: evidence state sealed");

    residual emit {
        op: "audit_review.init_complete",
        session: session.session_id,
        queries: session.query_count,
        correlations: session.correlation_count,
        timelines: 1,
        evidence_items: 1,
    };

    return session;
}
