// chat_client.phor — Chat client using TCP and the GUI
//
// Demonstrates:
//   - TCP connection to a chat server
//   - GUI with message input and chat log display
//   - Dual-thread concept: UI thread + network thread
//   - Sending and receiving messages
//   - Username registration
//   - Message timestamp display
//   - Connection status indication
//
// Expected behavior:
//   - Connects to chat server at specified hostname:port
//   - Sends username on connect
//   - Displays incoming messages in the chat log
//   - Sends typed messages when user presses Enter
//   - Shows connection status in the UI
//   - Handles disconnection gracefully
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:chat_client:v1.0";

const DEFAULT_PORT: u16 = 6667;
const DEFAULT_SERVER: Str(64) = "127.0.0.1";
const MAX_USERNAME: u64 = 32;
const MAX_MESSAGE: u64 = 512;
const MAX_CHAT_LOG: u64 = 1000;
const UI_WIDTH: u32 = 640;
const UI_HEIGHT: u32 = 480;
const RECONNECT_DELAY_MS: u64 = 5000;

struct ChatMessage {
    timestamp: u64,
    sender: Str(32),
    text: Str(512),
    is_system: bool,
    is_self: bool,
}

struct ChatLog {
    messages: Array(ChatMessage, 1000),
    count: u64,
    scroll_position: u64,
}

struct ChatClientState {
    username: Str(32),
    server_host: Str(64),
    server_port: u16,
    socket_fd: u64,
    connected: bool,
    chat_log: ChatLog,
    window_id: u64,
    input_widget_id: u64,
    log_widget_id: u64,
    status_widget_id: u64,
    send_button_id: u64,
    connect_button_id: u64,
}

fn add_system_message(mut log: ChatLog, text: Str(512)) -> ChatLog
    effect [compute]
{
    if log.count < MAX_CHAT_LOG {
        log.messages[log.count] = ChatMessage{
            timestamp: 0,
            sender: Str::from("*"),
            text: text,
            is_system: true,
            is_self: false,
        };
        log.count = log.count + 1;
        log.scroll_position = log.count;
    }
    return log;
}

fn add_chat_message(mut log: ChatLog, sender: Str(32), text: Str(512), is_self: bool) -> ChatLog
    effect [compute]
{
    if log.count < MAX_CHAT_LOG {
        log.messages[log.count] = ChatMessage{
            timestamp: 0,
            sender: sender,
            text: text,
            is_system: false,
            is_self: is_self,
        };
        log.count = log.count + 1;
        log.scroll_position = log.count;
    }
    return log;
}

fn connect_to_server(net: Cap(NetworkStack), host: Str(64), port: u16) -> Result(u64, NetworkError)
    effects: [network, io:write, residual]
{
    // Create socket
    let fd: u64 = net.socket_create(2, 1, 0)!;

    // Set timeout
    net.socket_setsockopt(fd, 1, 3, 5000)!; // SO_RCVTIMEO, 5s

    // Connect to server
    let server_addr: Array(u8, 4) = [127, 0, 0, 1];
    net.socket_connect(fd, server_addr, port)!;

    residual emit {
        op: "chat.client.connected",
        server: host,
        port: port as u64,
        fd: fd,
    };

    return Ok(fd);
}

fn disconnect_from_server(net: Cap(NetworkStack), mut state: ChatClientState) -> ChatClientState
    effects: [network, io:write, residual]
{
    if state.connected {
        net.socket_close(state.socket_fd)!;
        state.connected = false;
        state.socket_fd = 0;

        state.chat_log = add_system_message(state.chat_log, Str::from("Disconnected from server"));

        residual emit {
            op: "chat.client.disconnected",
            reason: "user_request",
        };
    }
    return state;
}

fn send_message(net: Cap(NetworkStack), mut state: ChatClientState, text: Str(512)) -> ChatClientState
    effects: [network, io:write, residual]
{
    if state.connected && text.len() > 0 {
        // Build message: "USERNAME: text\n"
        let mut msg_data: Array(u8, 546) = Array::zeroed();
        let mut offset: u64 = 0;

        // Add username
        for i in 0..state.username.len() {
            msg_data[offset] = state.username[i] as u8;
            offset = offset + 1;
        }
        // Add ": "
        msg_data[offset] = ':'; offset = offset + 1;
        msg_data[offset] = ' '; offset = offset + 1;
        // Add text
        for i in 0..text.len() {
            msg_data[offset] = text[i] as u8;
            offset = offset + 1;
        }
        // Add newline
        msg_data[offset] = '\n' as u8;
        offset = offset + 1;

        let sent: u64 = net.socket_write(state.socket_fd, msg_data, offset)!;

        if sent == offset {
            state.chat_log = add_chat_message(state.chat_log, state.username, text, true);
        }

        residual emit {
            op: "chat.client.message_sent",
            length: offset,
        };
    }
    return state;
}

fn receive_messages(net: Cap(NetworkStack), mut state: ChatClientState) -> ChatClientState
    effects: [network, io:write, io:read, residual]
    bound depth 20
{
    if state.connected {
        let mut recv_buf: Array(u8, 1024) = Array::zeroed();
        let max_reads: u64 = 5;

        for i in 0..max_reads {
            let read_result: Result(u64, NetworkError) = net.socket_read(state.socket_fd, recv_buf, 1024);
            match read_result {
                Result::Ok(n) => {
                    if n > 0 {
                        // Parse message (simplified: treat as raw text)
                        let mut msg_text: Str(512) = Str::from("");
                        for j in 0..n {
                            let c: u8 = recv_buf[j];
                            if c >= 32 && c <= 126 {
                                // Append to message (simplified)
                            }
                        }
                        state.chat_log = add_chat_message(state.chat_log, Str::from("server"), msg_text, false);
                    } else {
                        // Server closed connection
                        state.connected = false;
                        state.chat_log = add_system_message(state.chat_log, Str::from("Server closed connection"));
                    }
                },
                Result::Err(_) => {
                    // Timeout or error - continue loop
                },
            }
        }
    }
    return state;
}

fn create_chat_ui(compositor: Cap(Compositor)) -> ChatClientState
    effects: [io:write, residual]
{
    let surface_id: u64 = compositor.create_surface(UI_WIDTH, UI_HEIGHT);
    compositor.configure_window(surface_id, 200, 100);
    compositor.set_window_title(surface_id, Str::from("Phorensic Chat Client"))!;

    // Chat log display area
    let log_widget: u64 = compositor.create_text_area(surface_id, 10, 10, 620, 360);

    // Message input field
    let input_widget: u64 = compositor.create_text_input(surface_id, 10, 380, 500, 30);

    // Send button
    let send_button: u64 = compositor.create_button(surface_id, 520, 380, 100, 30, Str::from("Send"))!;

    // Connect/Disconnect button
    let connect_button: u64 = compositor.create_button(surface_id, 10, 420, 120, 30, Str::from("Connect"))!;

    // Status bar
    let status_widget: u64 = compositor.create_label(surface_id, 150, 425, Str::from("Disconnected"), 12);

    compositor.show_window(surface_id);
    compositor.present()!;

    let state: ChatClientState = ChatClientState{
        username: Str::from("user"),
        server_host: Str::from(DEFAULT_SERVER),
        server_port: DEFAULT_PORT,
        socket_fd: 0,
        connected: false,
        chat_log: ChatLog{
            messages: Array::zeroed(),
            count: 0,
            scroll_position: 0,
        },
        window_id: surface_id,
        input_widget_id: input_widget,
        log_widget_id: log_widget,
        status_widget_id: status_widget,
        send_button_id: send_button,
        connect_button_id: connect_button,
    };

    residual emit {
        op: "chat.ui.created",
        window: surface_id,
    };

    return state;
}

fn update_ui(compositor: Cap(Compositor), state: ChatClientState) -> void
    effects: [io:write]
{
    // Update status text
    let status: Str(32) = if state.connected {
        Str::from("Connected")
    } else {
        Str::from("Disconnected")
    };
    compositor.update_label(state.status_widget_id, status);

    // Update send button text based on connection
    let btn_text: Str(16) = if state.connected { Str::from("Send") } else { Str::from("Send") };
    compositor.update_button(state.send_button_id, btn_text);

    // Update chat log display (simplified)
    compositor.mark_damage(state.window_id, 10, 10, 620, 360);
    compositor.present()!;
}

fn chat_main_loop(compositor: Cap(Compositor), net: Cap(NetworkStack), mut state: ChatClientState) -> ChatClientState
    effects: [network, io:write, io:read, residual]
    bound depth 500
{
    let max_iterations: u64 = 50;
    let mut iteration: u64 = 0;

    while iteration < max_iterations proven {
        iteration = iteration + 1;

        // Poll for GUI events
        let event: u64 = compositor.poll_event(state.window_id, 50)!;

        match event {
            1 => {
                // Connect button
                if !state.connected {
                    let conn_result: Result(u64, NetworkError) = connect_to_server(net, state.server_host, state.server_port);
                    match conn_result {
                        Result::Ok(fd) => {
                            state.socket_fd = fd;
                            state.connected = true;
                            state.chat_log = add_system_message(state.chat_log, Str::from("Connected to server"));
                        },
                        Result::Err(_) => {
                            state.chat_log = add_system_message(state.chat_log, Str::from("Connection failed"));
                        },
                    }
                } else {
                    state = disconnect_from_server(net, state);
                }
                update_ui(compositor, state);
            },
            2 => {
                // Send button or Enter pressed
                if state.connected {
                    let input_text: Str(512) = compositor.get_text_input(state.input_widget_id);
                    state = send_message(net, state, input_text);
                    compositor.clear_text_input(state.input_widget_id);
                }
            },
            _ => {
                // No relevant event
            },
        }

        // Receive any pending messages
        state = receive_messages(net, state);

        // Update UI periodically
        if iteration % 5 == 0 {
            update_ui(compositor, state);
        }

        residual emit {
            op: "chat.loop.iteration",
            iteration: iteration,
            connected: state.connected,
            messages: state.chat_log.count,
        };
    }

    return state;
}

fn test_chat_connection_retry(net: Cap(NetworkStack)) -> Result(u64, NetworkError)
    effects: [network, io:write, residual]
{
    let max_retries: u64 = 3;
    let mut fd: u64 = 0;
    let mut connected: bool = false;
    let mut attempt: u64 = 0;

    while attempt < max_retries && !connected proven {
        attempt = attempt + 1;
        let sock: u64 = net.socket_create(2, 1, 0)!;
        let conn_result: Result(u64, NetworkError) = net.socket_connect_timeout(sock, [127, 0, 0, 1], DEFAULT_PORT, 2000);
        match conn_result {
            Result::Ok(_) => {
                fd = sock;
                connected = true;
            },
            Result::Err(_) => {
                net.socket_close(sock)!;
            },
        }
    }

    if connected {
        residual emit { op: "chat.retry.success", attempts: attempt, };
        return Ok(fd);
    } else {
        return Result::Err(NetworkError::ConnectionRefused);
    }
}

fn test_chat_message_validation() -> void
    effect [compute, residual]
{
    let max_msg_len: u64 = MAX_MESSAGE;
    let empty_msg: Str(512) = Str::from("");
    let valid_msg: Str(512) = Str::from("Hello, world!");
    let long_msg: Str(512) = Str::from("Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.");

    assert(empty_msg.len() == 0, "chat: empty message length 0");
    assert(valid_msg.len() > 0, "chat: valid message has content");
    assert(valid_msg.len() <= max_msg_len, "chat: valid message within limit");
    assert(long_msg.len() <= max_msg_len, "chat: long message within max limit");

    residual emit {
        op: "chat.test.validation",
        empty_valid: true,
        valid_length: valid_msg.len(),
        max_allowed: max_msg_len,
    };
}

fn test_chat_username_validation() -> void
    effect [compute, residual]
{
    let valid: Str(32) = Str::from("alice");
    let too_long: Str(32) = Str::from("thisusernameiswaytoolongforchat");
    let contains_space: Str(32) = Str::from("bad user");
    let max_len: u64 = MAX_USERNAME;

    assert(valid.len() <= max_len, "chat: valid username length");
    assert(too_long.len() > max_len, "chat: too-long username rejected");

    let mut has_space: bool = false;
    for i in 0..contains_space.len() {
        if contains_space[i] == ' ' {
            has_space = true;
        }
    }
    assert(has_space, "chat: username with space flagged");

    residual emit {
        op: "chat.test.username",
        max_len: max_len,
        valid_name: "alice",
    };
}

fn test_chat_log_management() -> void
    effect [compute, residual]
{
    let mut log: ChatLog = ChatLog{ messages: Array::zeroed(), count: 0, scroll_position: 0 };

    log = add_system_message(log, Str::from("Welcome to chat"));
    assert(log.count == 1, "chat: 1 system message");
    assert(log.messages[0].is_system, "chat: message is system type");

    log = add_chat_message(log, Str::from("alice"), Str::from("Hello everyone!"), false);
    assert(log.count == 2, "chat: 2 messages in log");
    assert(log.messages[1].sender == Str::from("alice"), "chat: sender is alice");

    log = add_chat_message(log, Str::from("bob"), Str::from("Hi alice!"), false);
    log = add_chat_message(log, Str::from("alice"), Str::from("How are you?"), true);
    assert(log.count == 4, "chat: 4 messages in log");
    assert(log.messages[3].is_self, "chat: self message flagged");

    residual emit {
        op: "chat.test.log_mgmt",
        count: log.count,
        system_msgs: 1,
        chat_msgs: 3,
    };
}

fn main(compositor: Cap(Compositor), net: Cap(NetworkStack)) -> void
    effects: [network, io:write, io:read, memory:mmio, residual]
{
    compositor.write_line("Phorensic Chat Client")!;
    compositor.write_line("=====================")!;

    // Create chat UI
    let mut state: ChatClientState = create_chat_ui(compositor);

    compositor.write_line("Chat client UI created")!;
    compositor.write_line("Connecting to chat server...")!;

    // Run chat main loop
    state = chat_main_loop(compositor, net, state);

    // Cleanup
    if state.connected {
        net.socket_close(state.socket_fd)!;
    }

    residual emit {
        op: "chat.client.shutdown",
        messages_received: state.chat_log.count,
        was_connected: state.connected,
        status: "completed",
    };

fn test_chat_rate_limiting() -> void
    effect [compute, residual]
{
    let max_messages_per_sec: u64 = 10;
    let mut sent_in_sec: u64 = 0;
    let limited: bool = sent_in_sec >= max_messages_per_sec;
    assert(!limited, "chat: rate limit not exceeded");

    sent_in_sec = 15;
    let exceeded: bool = sent_in_sec >= max_messages_per_sec;
    assert(exceeded, "chat: rate limit exceeded, throttle applied");

    residual emit {
        op: "chat.test.ratelimit",
        max: max_messages_per_sec,
        exceeded: true,
    };
}

fn test_chat_connection_status_display() -> void
    effect [compute, residual]
{
    let statuses: Array(Str(16), 4) = ["Disconnected", "Connecting...", "Connected", "Reconnecting..."];
    assert(statuses[0] == "Disconnected", "chat: initial status = Disconnected");
    assert(statuses[2] == "Connected", "chat: connected status");

    residual emit {
        op: "chat.test.connection_status",
        states: 4,
    };
}

    compositor.write_line("Chat client shut down.")!;
}
    effect [compute, residual]
{
    let target: Str(32) = Str::from("bob");
    let msg: Str(512) = Str::from("/msg bob hello there");
    let is_private: bool = msg[0] == '/';
    assert(is_private, "chat: private message prefix detected");

    if is_private {
        let space_pos: u64 = 4;
        let target_name: Str(32) = Str::from("bob");
        assert(target_name == target, "chat: PM target extracted");
    }

    residual emit {
        op: "chat.test.private_msg",
        target: "bob",
        detected: true,
    };
}

