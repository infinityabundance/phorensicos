// Sample court session definition for verifying a package
// This file defines a court session that evaluates a compiled package
// against a reference compiler oracle.
//
// Format: .court.phor — Court session definition language
//
// Court session: evaluate hello.phor-spec against reference compiler
// Case ID: HELLO_COURT_001
// Oracle: reference-phc-v2.0.0
// Object: hello.phor-spec (StoreKey: 0xA1B2C3D4E5F67890)
// Verdict: Accept
// Trust promotion: Promoted

court session "hello_court_001" {
    session_id: 0x1001
    session_version: 1
    object: "hello.phor-spec"
    object_key: 0xA1B2C3D4E5F67890
    oracle: "reference-phc-v2.0.0"
    oracle_type: "compiler"
    oracle_version: "2.0.0"

    evidence {
        source_receipt: "parse-receipt.phor-receipt"
        source_receipt_hash: 0x11111111
        expansion_receipt: "expansion-receipt.phor-receipt"
        expansion_receipt_hash: 0x22222222
        lowering_receipt: "lowering-receipt.phor-receipt"
        lowering_receipt_hash: 0x33333333
        optimization_receipts: [
            { name: "optimize-pass1.phor-receipt", hash: 0x44444444 },
            { name: "optimize-pass2.phor-receipt", hash: 0x55555555 }
        ]
        codegen_receipt: "codegen-receipt.phor-receipt"
        codegen_receipt_hash: 0x66666666
        link_receipt: "link-receipt.phor-receipt"
        link_receipt_hash: 0x77777777
        seal_receipt: "seal-receipt.phor-receipt"
        seal_receipt_hash: 0x88888888
        evidence_count: 7
        evidence_chain_hash: 0x99999999
    }

    replay {
        status: "full"
        hash_chain_match: true
        residual_graph_match: true
        replay_duration_ms: 120
        attempt_count: 1
        replay_log_hash: 0xAAAAAAAA
    }

    oracle_comparison {
        comparison_type: "byte_identical"
        native_hash: 0x1122334455667788
        oracle_hash: 0x1122334455667788
        divergences: []
        comparison_duration_ms: 50
        comparison_timestamp: 10000
        verified_by: "oracle-verification-service-v1"
    }

    divergence_analysis {
        total_divergences: 0
        semantic_divergences: 0
        optimization_divergences: 0
        dialect_divergences: 0
        nondeterministic_divergences: 0
        acceptable_divergences: 0
    }

    trust_ladder_progression {
        initial_state: "Unknown"
        observation: { timestamp: 9990, success: true, residual_hash: 0xBBBBBBBB }
        replay: { timestamp: 9995, success: true, replay_hash: 0xCCCCCCCC }
        oracle_compare: { timestamp: 10000, success: true, comparison_hash: 0xDDDDDDDD }
        residual_stable: { timestamp: 10005, success: true, stable_hash: 0xEEEEEEEE }
        seal: { timestamp: 10006, success: true, seal_hash: 0xFFFFFFFF }
        final_state: "Promoted"
    }

    verdict {
        type: "Accept"
        promoted_to: "Promoted"
        trust_level: 6
        evidence_refs: [
            0xAAAA,
            0xBBBB,
            0xCCCC,
            0xDDDD
        ]
        judge: "automated-court-v1"
        judge_identity: 0xCAFEBABE
        verdict_timestamp: 10007
        verdict_signed: true
        verdict_signature: 0xDEADBEEF
    }

    session_summary {
        total_evidence_submitted: 7
        total_residuals_recorded: 6
        comparison_passed: true
        verdict_issued: true
        trust_promoted: true
        session_duration_ms: 200
        session_completed: true
    }
}
