// file: uefi_boot.phor
// purpose: UEFI boot services — GOP (graphics output protocol), simple text
//          output, memory allocation, file system protocol, loaded image
//          protocol, configuration table, runtime services, variable services
// effects: [io:read, io:write, memory:mmio, deterministic, residual]
// trust: TrustState_Bootstrap

package "phorensic:uefi_boot:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*

// ──────────────────────────────────────────────
// UEFI Constants
// ──────────────────────────────────────────────

const UEFI_SYSTEM_TABLE_SIGNATURE: Word64 = 0x5453_5953_2049_4249
const UEFI_BOOT_SERVICES_SIGNATURE: Word64 = 0x5653_5442_4F4F_5420
const UEFI_RUNTIME_SERVICES_SIGNATURE: Word64 = 0x5452_5554_4F4F_5420
const MAX_UEFI_PROTOCOLS: u32 = 64
const MAX_UEFI_CONFIG_TABLES: u32 = 32
const MAX_FILE_PATH: u32 = 512
const MAX_HANDLE_COUNT: u32 = 128
const MAX_MEMORY_DESCRIPTORS: u32 = 256
const UEFI_PAGE_SIZE: u64 = 4096
const UEFI_PAGE_MASK: u64 = 0xFFF
const MAX_VARIABLE_NAME: u32 = 256
const MAX_VARIABLE_DATA: u32 = 4096

// EFI Memory Types
const EFI_RESERVED_MEMORY_TYPE: u32 = 0
const EFI_LOADER_CODE: u32 = 1
const EFI_LOADER_DATA: u32 = 2
const EFI_BOOT_SERVICES_CODE: u32 = 3
const EFI_BOOT_SERVICES_DATA: u32 = 4
const EFI_RUNTIME_SERVICES_CODE: u32 = 5
const EFI_RUNTIME_SERVICES_DATA: u32 = 6
const EFI_CONVENTIONAL_MEMORY: u32 = 7
const EFI_UNUSABLE_MEMORY: u32 = 8
const EFI_ACPI_RECLAIM_MEMORY: u32 = 9
const EFI_ACPIMEMORY_NVS: u32 = 10
const EFI_MEMORY_MAPPED_IO: u32 = 11
const EFI_MEMORY_MAPPED_IOPORT_SPACE: u32 = 12
const EFI_PAL_CODE: u32 = 13
const EFI_PERSISTENT_MEMORY: u32 = 14
const EFI_MAX_MEMORY_TYPE: u32 = 15

// EFI Memory Attributes
const EFI_MEMORY_UC: u64 = 0x01
const EFI_MEMORY_WC: u64 = 0x02
const EFI_MEMORY_WT: u64 = 0x04
const EFI_MEMORY_WB: u64 = 0x08
const EFI_MEMORY_UCE: u64 = 0x10
const EFI_MEMORY_WP: u64 = 0x1000
const EFI_MEMORY_RP: u64 = 0x2000
const EFI_MEMORY_XP: u64 = 0x4000
const EFI_MEMORY_NV: u64 = 0x8000
const EFI_MEMORY_MORE_RELIABLE: u64 = 0x10000
const EFI_MEMORY_RO: u64 = 0x20000
const EFI_MEMORY_SP: u64 = 0x40000
const EFI_MEMORY_CPU_CRYPTO: u64 = 0x80000
const EFI_MEMORY_RUNTIME: u64 = 0x8000000000000000

// EFI Allocate Type
const EFI_ALLOCATE_ANY_PAGES: u32 = 0
const EFI_ALLOCATE_MAX_ADDRESS: u32 = 1
const EFI_ALLOCATE_ADDRESS: u32 = 2

// EFI Variable Attributes
const EFI_VARIABLE_NON_VOLATILE: u32 = 0x01
const EFI_VARIABLE_BOOTSERVICE_ACCESS: u32 = 0x02
const EFI_VARIABLE_RUNTIME_ACCESS: u32 = 0x04
const EFI_VARIABLE_HARDWARE_ERROR_RECORD: u32 = 0x08
const EFI_VARIABLE_AUTHENTICATED_WRITE_ACCESS: u32 = 0x10
const EFI_VARIABLE_TIME_BASED_AUTHENTICATED_WRITE_ACCESS: u32 = 0x20
const EFI_VARIABLE_APPEND_WRITE: u32 = 0x40

// EFI Reset Types
const EFI_RESET_COLD: u32 = 0
const EFI_RESET_WARM: u32 = 1
const EFI_RESET_SHUTDOWN: u32 = 2
const EFI_RESET_PLATFORM_SPECIFIC: u32 = 3

// GUID constants (simplified for .phor)
const EFI_GOP_GUID_0: u32 = 0x9042A9DE
const EFI_GOP_GUID_1: u16 = 0x23DC
const EFI_GOP_GUID_2: u16 = 0x4A38
const EFI_SIMPLE_FILE_SYSTEM_GUID_0: u32 = 0x0964E5B2
const EFI_LOADED_IMAGE_GUID_0: u32 = 0x5B1B31A1

// ──────────────────────────────────────────────
// UEFI GUID
// ──────────────────────────────────────────────

pub type EFI_GUID : struct {
    data1: Word32,
    data2: Word16,
    data3: Word16,
    data4: FixedArray[8, u8],
}

impl EFI_GUID {
    pub fn new() -> EFI_GUID
        effects: [deterministic]
    {
        EFI_GUID {
            data1: 0,
            data2: 0,
            data3: 0,
            data4: FixedArray::new(),
        }
    }

    pub fn gop_guid() -> EFI_GUID
        effects: [deterministic]
    {
        let mut data4: FixedArray[8, u8] = FixedArray::new()
        data4.push(0x23)!
        data4.push(0xDC)!
        data4.push(0x4A)!
        data4.push(0x38)!
        data4.push(0x96)!
        data4.push(0x42)!
        data4.push(0xA9)!
        data4.push(0xDE)!
        EFI_GUID {
            data1: EFI_GOP_GUID_0,
            data2: EFI_GOP_GUID_1,
            data3: EFI_GOP_GUID_2,
            data4: data4,
        }
    }

    pub fn equals(self, other: EFI_GUID) -> bool
        effects: [deterministic]
    {
        if self.data1 != other.data1 { return false }
        if self.data2 != other.data2 { return false }
        if self.data3 != other.data3 { return false }
        for i in 0..8 {
            if self.data4.get(i)! != other.data4.get(i)! {
                return false
            }
        }
        true
    }
}

// ──────────────────────────────────────────────
// UEFI System Table
// ──────────────────────────────────────────────

pub type EFI_TABLE_HEADER : struct {
    signature: Word64,
    revision: Word32,
    header_size: Word32,
    crc32: Word32,
    reserved: Word32,
}

impl EFI_TABLE_HEADER {
    pub fn new() -> EFI_TABLE_HEADER
        effects: [deterministic]
    {
        EFI_TABLE_HEADER {
            signature: 0,
            revision: 0,
            header_size: 0,
            crc32: 0,
            reserved: 0,
        }
    }

    pub fn validate(self, expected_sig: Word64) -> bool
        effects: [deterministic]
    {
        self.signature == expected_sig
    }
}

pub type EFI_SYSTEM_TABLE : struct {
    header: EFI_TABLE_HEADER,
    firmware_vendor: Word64,
    firmware_revision: Word32,
    console_in_handle: Word64,
    con_in: Word64,
    console_out_handle: Word64,
    con_out: Word64,
    standard_error_handle: Word64,
    std_err: Word64,
    runtime_services: Word64,
    boot_services: Word64,
    number_of_table_entries: u32,
    configuration_table: Word64,
}

impl EFI_SYSTEM_TABLE {
    pub fn new() -> EFI_SYSTEM_TABLE
        effects: [deterministic]
    {
        EFI_SYSTEM_TABLE {
            header: EFI_TABLE_HEADER::new(),
            firmware_vendor: 0,
            firmware_revision: 0,
            console_in_handle: 0,
            con_in: 0,
            console_out_handle: 0,
            con_out: 0,
            standard_error_handle: 0,
            std_err: 0,
            runtime_services: 0,
            boot_services: 0,
            number_of_table_entries: 0,
            configuration_table: 0,
        }
    }

    pub fn validate_system_table(self) -> bool
        effects: [deterministic]
    {
        self.header.validate(UEFI_SYSTEM_TABLE_SIGNATURE)
    }

    pub fn get_boot_services_ptr(self) -> Word64
        effects: [deterministic]
    {
        self.boot_services
    }

    pub fn get_runtime_services_ptr(self) -> Word64
        effects: [deterministic]
    {
        self.runtime_services
    }

    pub fn get_config_table_count(self) -> u32
        effects: [deterministic]
    {
        self.number_of_table_entries
    }
}

