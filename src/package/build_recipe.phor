// build_recipe.phor — BuildRecipe type, environment capsule, dependency graph
// Phorensic Package: build recipe specification
// Spec: SEALED_PACKAGE_FORMAT.md — Build Evidence, SEALED_PACKAGE_FORMAT.md §38
// Grammar: PHORENSIC_GRAMMAR.md §38 Build Recipe Grammar

package package.build_recipe;

use forensic_store.store_object::{
    Hash256, hash256_zero, hash256_equal,
    Identity, identity_equal, identity_is_valid,
    BuildRecipe, DependencySpec, BuildStep,
    EnvironmentCapsule,
};
use forensic_store.store_key::{
    StoreKey, store_key_equal, store_key_zero,
};

// ============================================================================
// Build Recipe Extended Types
// ============================================================================

/// The strategy used for a build step.
type BuildStrategy = enum {
    /// Standard phorensic compilation
    PhorensicCompile = 0,
    /// Dialect cage translation
    DialectCage = 1,
    /// Oracle observation
    OracleObserve = 2,
    /// Clean-room reimplementation
    CleanRoom = 3,
    /// Porting from foreign dialect
    Porting = 4,
    /// Native compilation with foreign toolchain
    ForeignToolchain = 5,
    /// Assembly with machine blocks
    MachineAssembly = 6,
    /// Link step combining multiple objects
    Link = 7,
    /// Resource bundling
    ResourceBundle = 8,
    /// Test execution
    TestExecution = 9,
    /// Documentation generation
    DocGeneration = 10,
    /// Packaging step
    Packaging = 11,
}

/// The toolchain used for a build step.
type ToolchainType = enum {
    /// The Phorensic bootstrap compiler (phorc)
    Phorc = 0,
    /// C dialect cage compiler
    DialectCageC = 1,
    /// C++ dialect cage compiler
    DialectCageCpp = 2,
    /// Rust dialect cage compiler
    DialectCageRust = 3,
    /// Assembly (machine blocks)
    MachineAssemblyTool = 4,
    /// Linker
    Linker = 5,
    /// Archive tool
    Archiver = 6,
    /// Custom porting tool
    PortingTool = 7,
    /// Clean-room reimplementation tool
    CleanRoomTool = 8,
    /// Test runner
    TestRunner = 9,
    /// Documentation tool
    DocTool = 10,
}

// ============================================================================
// BuildRecipe Extended — Full Specification
// ============================================================================

/// Extended build recipe with all metadata.
struct BuildRecipeExtended
    layout packed
{
    /// Recipe name (package name)
    name: Array[u8, 128],
    name_len: u32,
    /// Recipe version
    version: Array[u8, 64],
    version_len: u32,
    /// Dependencies (bounded to 128)
    dependencies: Array[DependencySpec, 128],
    dependency_count: u32,
    /// Build steps (bounded to 64)
    build_steps: Array[BuildStepExtended, 64],
    step_count: u32,
    /// Output artifacts (bounded to 32)
    output_artifacts: Array[ArtifactSpec, 32],
    output_count: u32,
    /// Environment capsule
    environment_capsule: EnvironmentCapsule,
    /// Source manifest hash
    source_manifest_hash: Hash256,
    /// Build strategy
    strategy: BuildStrategy,
    /// Target architecture
    target_arch: Array[u8, 32],
    target_arch_len: u32,
    /// Target profile
    target_profile: Array[u8, 32],
    target_profile_len: u32,
    /// Compiler flags
    compiler_flags: Array[Array[u8, 128], 32],
    compiler_flag_lens: Array[u32, 32],
    compiler_flag_count: u32,
    /// Linker flags
    linker_flags: Array[Array[u8, 128], 16],
    linker_flag_lens: Array[u32, 16],
    linker_flag_count: u32,
    /// Whether this recipe has been verified
    verified: bool,
    /// Verification hash
    verification_hash: Hash256,
    /// Reserved
    reserved: Array[u64, 16],
}

/// Extended build step with strategy and toolchain.
struct BuildStepExtended
    layout packed
{
    /// Step name
    step_name: Array[u8, 128],
    step_name_len: u32,
    /// Command string
    command: Array[u8, 512],
    command_len: u32,
    /// Build strategy
    strategy: BuildStrategy,
    /// Toolchain type
    toolchain: ToolchainType,
    /// Input hashes (bounded to 64)
    input_hashes: Array[Hash256, 64],
    input_count: u32,
    /// Output hashes (bounded to 64)
    output_hashes: Array[Hash256, 64],
    output_count: u32,
    /// Source files used in this step (bounded to 64)
    source_files: Array[Array[u8, 256], 64],
    source_file_lens: Array[u32, 64],
    source_file_count: u32,
    /// Expected duration (seconds)
    expected_duration_seconds: u64,
    /// Whether this step is optional
    optional: bool,
    /// Whether this step is cacheable
    cacheable: bool,
    /// Step timeout (seconds, 0 = no timeout)
    timeout_seconds: u64,
}

/// Specification for a build artifact.
struct ArtifactSpec
    layout packed
{
    /// Artifact path
    path: Array[u8, 256],
    path_len: u32,
    /// Artifact type
    artifact_type: ArtifactType,
    /// Hash of the artifact
    artifact_hash: Hash256,
    /// Expected size in bytes
    expected_size: u64,
    /// Whether this artifact is required
    required: bool,
}

type ArtifactType = enum {
    /// Executable binary
    Executable = 0,
    /// Shared library
    SharedLibrary = 1,
    /// Static library
    StaticLibrary = 2,
    /// Object file
    ObjectFile = 3,
    /// Source archive
    SourceArchive = 4,
    /// Documentation
    DocumentationArtifact = 5,
    /// Test results
    TestResults = 6,
    /// Receipt file
    Receipt = 7,
    /// Seal file
    Seal = 8,
    /// Debug symbols
    DebugSymbols = 9,
    /// Residual graph
    ResidualGraph = 10,
}

// ============================================================================
// Build Recipe Construction
// ============================================================================

/// Create a new build recipe.
fn build_recipe_new(
    name: Array[u8, 128],
    name_len: u32,
    version: Array[u8, 64],
    version_len: u32,
    strategy: BuildStrategy,
) -> BuildRecipeExtended
    effect [compute, residual]
{
    residual emit {
        op: "build_recipe.create",
        name_prefix: name[0] as u64,
        strategy: strategy as u64,
    };

    return BuildRecipeExtended {
        name: name,
        name_len: name_len,
        version: version,
        version_len: version_len,
        dependencies: Array[DependencySpec, 128]::zeroed(),
        dependency_count: 0,
        build_steps: Array[BuildStepExtended, 64]::zeroed(),
        step_count: 0,
        output_artifacts: Array[ArtifactSpec, 32]::zeroed(),
        output_count: 0,
        environment_capsule: EnvironmentCapsule {
            cpu_features: Array[Array[u8, 64], 32]::zeroed(),
            cpu_feature_lens: Array[u32, 32]::zeroed(),
            cpu_feature_count: 0,
            memory_config_name: Array[u8, 64]::zeroed(),
            memory_config_name_len: 0,
            memory_size_mb: 0,
            device_map: Array[DeviceMapEntry, 16]::zeroed(),
            device_count: 0,
            oracle_identities: Array[Identity, 16]::zeroed(),
            oracle_count: 0,
            court_versions: Array[CourtVersionEntry, 16]::zeroed(),
            court_version_count: 0,
        },
        source_manifest_hash: hash256_zero(),
        strategy: strategy,
        target_arch: Array[u8, 32]::zeroed(),
        target_arch_len: 0,
        target_profile: Array[u8, 32]::zeroed(),
        target_profile_len: 0,
        compiler_flags: Array[Array[u8, 128], 32]::zeroed(),
        compiler_flag_lens: Array[u32, 32]::zeroed(),
        compiler_flag_count: 0,
        linker_flags: Array[Array[u8, 128], 16]::zeroed(),
        linker_flag_lens: Array[u32, 16]::zeroed(),
        linker_flag_count: 0,
        verified: false,
        verification_hash: hash256_zero(),
        reserved: Array[u64, 16]::zeroed(),
    };
}

// ============================================================================
// Dependency Management
// ============================================================================

/// Add a dependency to the build recipe.
fn build_recipe_add_dependency(
    recipe: BuildRecipeExtended,
    dep: DependencySpec,
) -> BuildRecipeExtended
    effect [compute, residual]
{
    if recipe.dependency_count >= 128 {
        residual emit {
            op: "build_recipe.add_dep.full",
            count: recipe.dependency_count,
        };
        return recipe;
    }

    let mut new_recipe: BuildRecipeExtended = recipe;
    new_recipe.dependencies[recipe.dependency_count] = dep;
    new_recipe.dependency_count = recipe.dependency_count + 1;

    residual emit {
        op: "build_recipe.add_dep",
        dep_name_prefix: dep.dep_name[0] as u64,
    };

    return new_recipe;
}

/// Find a dependency by name.
fn build_recipe_find_dependency(
    recipe: BuildRecipeExtended,
    dep_name: Array[u8, 128],
    dep_name_len: u32,
) -> Result[DependencySpec, u32]
    effect [compute]
{
    for i in 0..recipe.dependency_count as u64 {
        let dep: DependencySpec = recipe.dependencies[i];
        if dep.dep_name_len == dep_name_len {
            let mut match_name: bool = true;
            for j in 0..dep_name_len as u64 {
                if dep.dep_name[j] != dep_name[j] {
                    match_name = false;
                }
            }
            if match_name {
                return Result[DependencySpec, u32]::Ok(dep);
            }
        }
    }
    return Result[DependencySpec, u32]::Err(0);
}

/// Remove a dependency by name.
fn build_recipe_remove_dependency(
    recipe: BuildRecipeExtended,
    dep_name: Array[u8, 128],
    dep_name_len: u32,
) -> BuildRecipeExtended
    effect [compute, residual]
{
    let mut new_recipe: BuildRecipeExtended = recipe;
    let mut found: bool = false;

    for i in 0..new_recipe.dependency_count as u64 {
        let dep: DependencySpec = new_recipe.dependencies[i];
        if dep.dep_name_len == dep_name_len {
            let mut match_name: bool = true;
            for j in 0..dep_name_len as u64 {
                if dep.dep_name[j] != dep_name[j] {
                    match_name = false;
                }
            }
            if match_name {
                // Shift remaining deps
                for k in i..(new_recipe.dependency_count - 1) as u64 {
                    new_recipe.dependencies[k] = new_recipe.dependencies[k + 1];
                }
                new_recipe.dependency_count = new_recipe.dependency_count - 1;
                found = true;
            }
        }
    }

    if found {
        residual emit {
            op: "build_recipe.remove_dep",
            dep_name_prefix: dep_name[0] as u64,
        };
    }

    return new_recipe;
}

// ============================================================================
// Build Step Management
// ============================================================================

/// Add a build step to the recipe.
fn build_recipe_add_step(
    recipe: BuildRecipeExtended,
    step: BuildStepExtended,
) -> BuildRecipeExtended
    effect [compute, residual]
{
    if recipe.step_count >= 64 {
        residual emit {
            op: "build_recipe.add_step.full",
            count: recipe.step_count,
        };
        return recipe;
    }

    let mut new_recipe: BuildRecipeExtended = recipe;
    new_recipe.build_steps[recipe.step_count] = step;
    new_recipe.step_count = recipe.step_count + 1;

    residual emit {
        op: "build_recipe.add_step",
        step_name_prefix: step.step_name[0] as u64,
        strategy: step.strategy as u64,
    };

    return new_recipe;
}

/// Set the target architecture and profile.
fn build_recipe_set_target(
    recipe: BuildRecipeExtended,
    arch: Array[u8, 32],
    arch_len: u32,
    profile: Array[u8, 32],
    profile_len: u32,
) -> BuildRecipeExtended
    effect [compute, residual]
{
    residual emit {
        op: "build_recipe.set_target",
        arch_prefix: arch[0] as u64,
    };

    return BuildRecipeExtended {
        name: recipe.name,
        name_len: recipe.name_len,
        version: recipe.version,
        version_len: recipe.version_len,
        dependencies: recipe.dependencies,
        dependency_count: recipe.dependency_count,
        build_steps: recipe.build_steps,
        step_count: recipe.step_count,
        output_artifacts: recipe.output_artifacts,
        output_count: recipe.output_count,
        environment_capsule: recipe.environment_capsule,
        source_manifest_hash: recipe.source_manifest_hash,
        strategy: recipe.strategy,
        target_arch: arch,
        target_arch_len: arch_len,
        target_profile: profile,
        target_profile_len: profile_len,
        compiler_flags: recipe.compiler_flags,
        compiler_flag_lens: recipe.compiler_flag_lens,
        compiler_flag_count: recipe.compiler_flag_count,
        linker_flags: recipe.linker_flags,
        linker_flag_lens: recipe.linker_flag_lens,
        linker_flag_count: recipe.linker_flag_count,
        verified: recipe.verified,
        verification_hash: recipe.verification_hash,
        reserved: recipe.reserved,
    };
}

// ============================================================================
// Environment Capsule Construction
// ============================================================================

/// Device map entry for the environment capsule.
struct DeviceMapEntry
    layout packed
{
    device_name: Array[u8, 64],
    device_name_len: u32,
    device_type: Array[u8, 32],
    device_type_len: u32,
    device_identity: Identity,
}

/// Court version entry for the environment capsule.
struct CourtVersionEntry
    layout packed
{
    court_name: Array[u8, 64],
    court_name_len: u32,
    court_version: Array[u8, 32],
    court_version_len: u32,
    court_store_key: StoreKey,
}

/// Create a new environment capsule.
fn environment_capsule_new() -> EnvironmentCapsule
    effect [compute]
{
    return EnvironmentCapsule {
        cpu_features: Array[Array[u8, 64], 32]::zeroed(),
        cpu_feature_lens: Array[u32, 32]::zeroed(),
        cpu_feature_count: 0,
        memory_config_name: Array[u8, 64]::zeroed(),
        memory_config_name_len: 0,
        memory_size_mb: 0,
        device_map: Array[DeviceMapEntry, 16]::zeroed(),
        device_count: 0,
        oracle_identities: Array[Identity, 16]::zeroed(),
        oracle_count: 0,
        court_versions: Array[CourtVersionEntry, 16]::zeroed(),
        court_version_count: 0,
    };
}

/// Add a CPU feature to the environment capsule.
fn capsule_add_cpu_feature(
    capsule: EnvironmentCapsule,
    feature: Array[u8, 64],
    feature_len: u32,
) -> EnvironmentCapsule
    effect [compute, residual]
{
    if capsule.cpu_feature_count >= 32 {
        return capsule;
    }

    let mut new_capsule: EnvironmentCapsule = capsule;
    new_capsule.cpu_features[capsule.cpu_feature_count] = feature;
    new_capsule.cpu_feature_lens[capsule.cpu_feature_count] = feature_len;
    new_capsule.cpu_feature_count = capsule.cpu_feature_count + 1;

    residual emit {
        op: "capsule.add_cpu_feature",
        feature_prefix: feature[0] as u64,
    };

    return new_capsule;
}

/// Set the memory configuration in the environment capsule.
fn capsule_set_memory(
    capsule: EnvironmentCapsule,
    config_name: Array[u8, 64],
    config_name_len: u32,
    size_mb: u64,
) -> EnvironmentCapsule
    effect [compute, residual]
{
    residual emit {
        op: "capsule.set_memory",
        size_mb: size_mb,
    };

    return EnvironmentCapsule {
        cpu_features: capsule.cpu_features,
        cpu_feature_lens: capsule.cpu_feature_lens,
        cpu_feature_count: capsule.cpu_feature_count,
        memory_config_name: config_name,
        memory_config_name_len: config_name_len,
        memory_size_mb: size_mb,
        device_map: capsule.device_map,
        device_count: capsule.device_count,
        oracle_identities: capsule.oracle_identities,
        oracle_count: capsule.oracle_count,
        court_versions: capsule.court_versions,
        court_version_count: capsule.court_version_count,
    };
}

/// Add a device to the environment capsule.
fn capsule_add_device(
    capsule: EnvironmentCapsule,
    device: DeviceMapEntry,
) -> EnvironmentCapsule
    effect [compute, residual]
{
    if capsule.device_count >= 16 {
        return capsule;
    }

    let mut new_capsule: EnvironmentCapsule = capsule;
    new_capsule.device_map[capsule.device_count] = device;
    new_capsule.device_count = capsule.device_count + 1;

    residual emit {
        op: "capsule.add_device",
        device_name_prefix: device.device_name[0] as u64,
    };

    return new_capsule;
}

/// Add an oracle identity to the environment capsule.
fn capsule_add_oracle(
    capsule: EnvironmentCapsule,
    oracle: Identity,
) -> EnvironmentCapsule
    effect [compute, residual]
{
    if capsule.oracle_count >= 16 {
        return capsule;
    }

    let mut new_capsule: EnvironmentCapsule = capsule;
    new_capsule.oracle_identities[capsule.oracle_count] = oracle;
    new_capsule.oracle_count = capsule.oracle_count + 1;

    residual emit {
        op: "capsule.add_oracle",
        oracle_fp: oracle.key_fingerprint.bytes[0] as u64,
    };

    return new_capsule;
}

/// Add a court version to the environment capsule.
fn capsule_add_court(
    capsule: EnvironmentCapsule,
    court: CourtVersionEntry,
) -> EnvironmentCapsule
    effect [compute, residual]
{
    if capsule.court_version_count >= 16 {
        return capsule;
    }

    let mut new_capsule: EnvironmentCapsule = capsule;
    new_capsule.court_versions[capsule.court_version_count] = court;
    new_capsule.court_version_count = capsule.court_version_count + 1;

    residual emit {
        op: "capsule.add_court",
        court_name_prefix: court.court_name[0] as u64,
    };

    return new_capsule;
}

// ============================================================================
// Build Recipe Verification
// ============================================================================

/// Verify a build recipe for consistency.
fn build_recipe_verify(recipe: BuildRecipeExtended) -> bool
    effect [compute, residual]
{
    let mut ok: bool = true;

    // Name must be non-empty
    if recipe.name_len == 0 {
        ok = false;
    }

    // Must have at least one step
    if recipe.step_count == 0 {
        ok = false;
    }

    // Each step must have a non-empty name
    for i in 0..recipe.step_count as u64 {
        if recipe.build_steps[i].step_name_len == 0 {
            ok = false;
        }
        // Each step must have at least one output
        if recipe.build_steps[i].output_count == 0 {
            ok = false;
        }
    }

    // Target arch must be set
    if recipe.target_arch_len == 0 {
        ok = false;
    }

    // Source manifest hash must be non-zero
    if hash256_is_zero(recipe.source_manifest_hash) {
        ok = false;
    }

    residual emit {
        op: "build_recipe.verify",
        valid: ok as u64,
        name_prefix: recipe.name[0] as u64,
        step_count: recipe.step_count,
        dep_count: recipe.dependency_count,
    };

    return ok;
}

// ============================================================================
// Build Recipe to Basic BuildRecipe Conversion
// ============================================================================

/// Convert an extended build recipe to the basic BuildRecipe type (for StoreObject).
fn build_recipe_to_basic(
    extended: BuildRecipeExtended,
) -> BuildRecipe
    effect [compute]
{
    let deps: Array[DependencySpec, 64] = Array[DependencySpec, 64]::zeroed();
    let mut dep_count: u32 = 0;
    for i in 0..extended.dependency_count as u64 {
        if dep_count < 64 && i < 64 {
            deps[dep_count] = extended.dependencies[i];
            dep_count = dep_count + 1;
        }
    }

    let steps: Array[BuildStep, 64] = Array[BuildStep, 64]::zeroed();
    let mut step_count: u32 = 0;
    for i in 0..extended.step_count as u64 {
        if step_count < 64 && i < 64 {
            let ext_step: BuildStepExtended = extended.build_steps[i];
            let in_hashes: Array[Hash256, 32] = Array[Hash256, 32]::zeroed();
            let mut in_count: u32 = 0;
            for j in 0..ext_step.input_count as u64 {
                if in_count < 32 { in_hashes[in_count] = ext_step.input_hashes[j]; in_count = in_count + 1; }
            }
            let out_hashes: Array[Hash256, 32] = Array[Hash256, 32]::zeroed();
            let mut out_count: u32 = 0;
            for j in 0..ext_step.output_count as u64 {
                if out_count < 32 { out_hashes[out_count] = ext_step.output_hashes[j]; out_count = out_count + 1; }
            }
            steps[step_count] = BuildStep {
                step_name: ext_step.step_name,
                step_name_len: ext_step.step_name_len,
                command: ext_step.command,
                command_len: ext_step.command_len,
                input_hashes: in_hashes,
                input_count: in_count,
                output_hashes: out_hashes,
                output_count: out_count,
            };
            step_count = step_count + 1;
        }
    }

    let artifacts: Array[Array[u8, 128], 16] = Array[Array[u8, 128], 16]::zeroed();
    let art_lens: Array[u32, 16] = Array[u32, 16]::zeroed();
    let mut art_count: u32 = 0;
    for i in 0..extended.output_count as u64 {
        if art_count < 16 {
            artifacts[art_count] = extended.output_artifacts[i].path;
            art_lens[art_count] = extended.output_artifacts[i].path_len;
            art_count = art_count + 1;
        }
    }

    return BuildRecipe {
        name: extended.name,
        name_len: extended.name_len,
        version: extended.version,
        version_len: extended.version_len,
        dependencies: deps,
        dependency_count: dep_count,
        build_steps: steps,
        step_count: step_count,
        output_artifacts: artifacts,
        output_artifact_lens: art_lens,
        output_count: art_count,
        environment_capsule: extended.environment_capsule,
    };
}

// ============================================================================
// Dependency Graph Operations
// ============================================================================

/// A full dependency graph with nodes and edges.
struct DependencyGraph
    layout packed
{
    /// Nodes (packages) in the graph (bounded to 256)
    nodes: Array[DependencyGraphNode, 256],
    node_count: u32,
    /// Edges between nodes (bounded to 1024)
    edges: Array[DependencyGraphEdge, 1024],
    edge_count: u32,
}

/// A node in the dependency graph.
struct DependencyGraphNode
    layout packed
{
    /// Node index
    index: u32,
    /// Package name
    package_name: Array[u8, 128],
    package_name_len: u32,
    /// Package version
    package_version: Array[u8, 32],
    package_version_len: u32,
    /// Store key
    store_key: StoreKey,
    /// Whether this is a direct dependency
    direct: bool,
}

/// An edge in the dependency graph.
struct DependencyGraphEdge
    layout packed
{
    /// Source node index (depends on)
    from_index: u32,
    /// Target node index (depended by)
    to_index: u32,
    /// Edge type
    edge_type: DepEdgeType,
}

type DepEdgeType = enum {
    /// Compile-time dependency
    Compile = 0,
    /// Link-time dependency
    Link = 1,
    /// Runtime dependency
    Runtime = 2,
    /// Build-time tool dependency
    BuildTool = 3,
    /// Optional dependency
    Optional = 4,
    /// Recommended dependency
    Recommended = 5,
}

/// Create an empty dependency graph.
fn dependency_graph_new() -> DependencyGraph
    effect [compute]
{
    return DependencyGraph {
        nodes: Array[DependencyGraphNode, 256]::zeroed(),
        node_count: 0,
        edges: Array[DependencyGraphEdge, 1024]::zeroed(),
        edge_count: 0,
    };
}

/// Add a node to the dependency graph.
fn dep_graph_add_node(
    graph: DependencyGraph,
    node: DependencyGraphNode,
) -> DependencyGraph
    effect [compute, residual]
{
    if graph.node_count >= 256 {
        return graph;
    }

    let mut new_graph: DependencyGraph = graph;
    new_graph.nodes[graph.node_count] = node;
    new_graph.node_count = graph.node_count + 1;

    residual emit {
        op: "dep_graph.add_node",
        name_prefix: node.package_name[0] as u64,
    };

    return new_graph;
}

/// Add an edge to the dependency graph.
fn dep_graph_add_edge(
    graph: DependencyGraph,
    edge: DependencyGraphEdge,
) -> DependencyGraph
    effect [compute, residual]
{
    if graph.edge_count >= 1024 {
        return graph;
    }

    let mut new_graph: DependencyGraph = graph;
    new_graph.edges[graph.edge_count] = edge;
    new_graph.edge_count = graph.edge_count + 1;

    residual emit {
        op: "dep_graph.add_edge",
        from: edge.from_index,
        to: edge.to_index,
    };

    return new_graph;
}

/// Find a node by package name.
fn dep_graph_find_node(
    graph: DependencyGraph,
    name: Array[u8, 128],
    name_len: u32,
) -> Result[DependencyGraphNode, u32]
    effect [compute]
{
    for i in 0..graph.node_count as u64 {
        let node: DependencyGraphNode = graph.nodes[i];
        if node.package_name_len == name_len {
            let mut match_name: bool = true;
            for j in 0..name_len as u64 {
                if node.package_name[j] != name[j] {
                    match_name = false;
                }
            }
            if match_name {
                return Result[DependencyGraphNode, u32]::Ok(node);
            }
        }
    }
    return Result[DependencyGraphNode, u32]::Err(0);
}

/// Perform a topological sort of the dependency graph (simple algorithm).
fn dep_graph_topological_sort(
    graph: DependencyGraph,
    sorted: Array[u32, 256],
) -> Array[u32, 256]
    effect [compute, residual]
{
    // In-degree array
    let mut in_degree: Array[u32, 256] = Array[u32, 256]::zeroed();
    let mut result: Array[u32, 256] = sorted;
    let mut result_count: u32 = 0;

    // Compute in-degrees
    for i in 0..graph.edge_count as u64 {
        let edge: DependencyGraphEdge = graph.edges[i];
        in_degree[edge.to_index as u64] = in_degree[edge.to_index as u64] + 1;
    }

    // Simple Kahn's algorithm (bounded iterations)
    let mut remaining: u32 = graph.node_count;
    while remaining > 0 {
        let mut found: bool = false;
        for i in 0..graph.node_count as u64 {
            if in_degree[i] == 0 {
                // Check if already in result
                let mut already_added: bool = false;
                for j in 0..result_count as u64 {
                    if result[j] == i as u32 {
                        already_added = true;
                    }
                }
                if !already_added {
                    result[result_count] = i as u32;
                    result_count = result_count + 1;
                    in_degree[i] = 0xFFFFFFFF; // Mark as processed
                    found = true;

                    // Decrease in-degree of neighbors
                    for j in 0..graph.edge_count as u64 {
                        let edge: DependencyGraphEdge = graph.edges[j];
                        if edge.from_index == i as u32 {
                            in_degree[edge.to_index as u64] = in_degree[edge.to_index as u64] - 1;
                        }
                    }
                }
            }
        }
        if !found {
            break;
        }
        remaining = 0;
        for i in 0..graph.node_count as u64 {
            if in_degree[i] != 0xFFFFFFFF {
                remaining = remaining + 1;
            }
        }
    }

    residual emit {
        op: "dep_graph.topological_sort",
        nodes_sorted: result_count,
        total_nodes: graph.node_count,
        has_cycle: (remaining > 0) as u64,
    };

    return result;
}

// ============================================================================
// Compiler Flag Management
// ============================================================================

/// Add a compiler flag to the build recipe.
fn build_recipe_add_compiler_flag(
    recipe: BuildRecipeExtended,
    flag: Array[u8, 128],
    flag_len: u32,
) -> BuildRecipeExtended
    effect [compute, residual]
{
    if recipe.compiler_flag_count >= 32 {
        return recipe;
    }

    let mut new_recipe: BuildRecipeExtended = recipe;
    new_recipe.compiler_flags[recipe.compiler_flag_count] = flag;
    new_recipe.compiler_flag_lens[recipe.compiler_flag_count] = flag_len;
    new_recipe.compiler_flag_count = recipe.compiler_flag_count + 1;

    residual emit {
        op: "build_recipe.add_compiler_flag",
        flag_prefix: flag[0] as u64,
    };

    return new_recipe;
}

/// Add a linker flag to the build recipe.
fn build_recipe_add_linker_flag(
    recipe: BuildRecipeExtended,
    flag: Array[u8, 128],
    flag_len: u32,
) -> BuildRecipeExtended
    effect [compute, residual]
{
    if recipe.linker_flag_count >= 16 {
        return recipe;
    }

    let mut new_recipe: BuildRecipeExtended = recipe;
    new_recipe.linker_flags[recipe.linker_flag_count] = flag;
    new_recipe.linker_flag_lens[recipe.linker_flag_count] = flag_len;
    new_recipe.linker_flag_count = recipe.linker_flag_count + 1;

    residual emit {
        op: "build_recipe.add_linker_flag",
        flag_prefix: flag[0] as u64,
    };

    return new_recipe;
}

// ============================================================================
// Helper: Hash256 zero check
// ============================================================================

fn hash256_is_zero(h: Hash256) -> bool
    effect [compute]
{
    for i in 0..32 {
        if h.bytes[i] != 0 {
            return false;
        }
    }
    return true;
}
