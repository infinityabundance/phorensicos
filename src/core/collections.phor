// file: collections.phor
// purpose: Fixed-capacity Array, Map, Set, RingBuffer, Stack, Sequence
//          with complete implementations. All operations use bounded loops
//          and checked indexing. No heap allocation — all storage is inline.
// evidence: COLL-ARCH-001 through COLL-ARCH-180
// residual: No dynamic allocation; panics on capacity exceeded.

use core::constants::*
use core::types::*
use core::errors::*
use core::math::*

// ──────────────────────────────────────────────
// FixedArray[N, T]: Fixed-capacity array
// ──────────────────────────────────────────────
// An array with compile-time fixed capacity.
// Evidence path: COLL-ARR-001 through COLL-ARR-060

pub type FixedArray[N: static, T] : struct {
    data: [T; N],
    length: u32,
}

impl[N, T] FixedArray[N, T] {
    // Create a new empty fixed array.
    // T must have a default/zero value; this is enforced at compile time.
    pub fn new() -> FixedArray[N, T]
        effects: [deterministic]
    {
        FixedArray {
            data: [T::default(); N],
            length: 0,
        }
    }

    // Create a fixed array from a raw array and length.
    pub fn from_raw(data: [T; N], length: u32) -> Result[FixedArray[N, T], BoundsError>
        effects: [deterministic]
    {
        if length > N {
            return Result::Err(bounds_capacity_exceeded(length))
        }
        Result::Ok(FixedArray { data: data, length: length })
    }

    // Get the element at index.
    pub fn get(self, index: u32) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        Result::Ok(self.data[index as usize])
    }

    // Set the element at index.
    pub fn set(self: ref mut, index: u32, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        self.data[index as usize] = value
        Result::Ok(())
    }

    // Push an element to the end.
    pub fn push(self: ref mut, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if self.length >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        self.data[self.length as usize] = value
        self.length = self.length + 1
        Result::Ok(())
    }

    // Pop an element from the end.
    pub fn pop(self: ref mut) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.length == 0 {
            return Result::Err(bounds_empty_collection())
        }
        self.length = self.length - 1
        let value: T = self.data[self.length as usize]
        Result::Ok(value)
    }

    // Get a reference to the element at index (read-only borrow).
    pub fn ref_at(self, index: u32) -> Result<ref T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        Result::Ok(&self.data[index as usize])
    }

    // Get a mutable reference to the element at index.
    pub fn ref_mut_at(self: ref mut, index: u32) -> Result<ref mut T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        Result::Ok(&mut self.data[index as usize])
    }

    // Get the current length.
    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    // Get the fixed capacity.
    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        N
    }

    // Check if empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }

    // Check if full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.length >= N
    }

    // Remove the element at index, shifting elements left.
    pub fn remove(self: ref mut, index: u32) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        let value: T = self.data[index as usize]
        // Shift elements left.
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in (index + 1)..self.length {
            self.data[(i - 1) as usize] = self.data[i as usize]
        }
        self.length = self.length - 1
        Result::Ok(value)
    }

    // Insert at index, shifting elements right.
    pub fn insert(self: ref mut, index: u32, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if index > self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        if self.length >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        // Shift elements right.
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in (index..self.length).rev() {
            self.data[(i + 1) as usize] = self.data[i as usize]
        }
        self.data[index as usize] = value
        self.length = self.length + 1
        Result::Ok(())
    }

    // Clear all elements.
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.length = 0
    }

    // Check if the array contains a value (linear search).
    // loop: bounds[BOUND_MEDIUM] — bounded by length.
    pub fn contains(self, value: T) -> bool
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] while i < self.length {
            if self.data[i as usize] == value {
                return true
            }
            i = i + 1
        }
        false
    }

    // Find the index of a value (linear search).
    // loop: bounds[BOUND_SEARCH] — bounded by length.
    pub fn find(self, value: T) -> Option[u32]
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_SEARCH] — bounded by length
        loop: bounds[BOUND_SEARCH] while i < self.length {
            if self.data[i as usize] == value {
                return Option::Some(i)
            }
            i = i + 1
        }
        Option::None
    }

    // Apply a function to each element.
    // loop: bounds[BOUND_MEDIUM] — bounded by length.
    pub fn for_each(self, f: fn(T))
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] while i < self.length {
            f(self.data[i as usize])
            i = i + 1
        }
    }

    // Apply a function to each element with index.
    // loop: bounds[BOUND_MEDIUM] — bounded by length.
    pub fn for_each_indexed(self, f: fn(u32, T))
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] while i < self.length {
            f(i, self.data[i as usize])
            i = i + 1
        }
    }

    // Map elements to a new array (same capacity).
    pub fn map[U](self, f: fn(T) -> U) -> FixedArray[N, U]
        effects: [deterministic]
    {
        let mut result: FixedArray[N, U] = FixedArray::new()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..self.length {
            result.data[i as usize] = f(self.data[i as usize])
        }
        result.length = self.length
        result
    }

    // Filter elements into a new array (same capacity).
    pub fn filter(self, predicate: fn(T) -> bool) -> FixedArray[N, T]
        effects: [deterministic]
    {
        let mut result: FixedArray[N, T] = FixedArray::new()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..self.length {
            if predicate(self.data[i as usize]) {
                result.data[result.length as usize] = self.data[i as usize]
                result.length = result.length + 1
            }
        }
        result
    }

    // Sort elements using insertion sort (stable, in-place).
    // loop: bounds[BOUND_SORT] — bounded by length.
    pub fn sort(self: ref mut)
        effects: [deterministic]
    {
        let mut i: u32 = 1
        // loop: bounds[BOUND_SORT] — bounded by length
        loop: bounds[BOUND_SORT] while i < self.length {
            let key: T = self.data[i as usize]
            let mut j: u32 = i
            // loop: bounds[BOUND_SORT] — bounded by length
            loop: bounds[BOUND_SORT] while j > 0 {
                if self.data[(j - 1) as usize] > key {
                    self.data[j as usize] = self.data[(j - 1) as usize]
                    j = j - 1
                } else {
                    break
                }
            }
            self.data[j as usize] = key
            i = i + 1
        }
    }

    // Reverse the array in-place.
    // loop: bounds[BOUND_MEDIUM] — bounded by length.
    pub fn reverse(self: ref mut)
        effects: [deterministic]
    {
        let mut i: u32 = 0
        let mut j: u32 = self.length - 1
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] while i < j {
            let temp: T = self.data[i as usize]
            self.data[i as usize] = self.data[j as usize]
            self.data[j as usize] = temp
            i = i + 1
            j = j - 1
        }
    }

    // Convert to a slice (returns a view).
    pub fn as_slice(self) -> FixedSlice[T]
        effects: [deterministic]
    {
        FixedSlice {
            data: &self.data[0..self.length],
            length: self.length,
        }
    }

    // Get the first element.
    pub fn first(self) -> Option[T]
        effects: [deterministic]
    {
        if self.length > 0 {
            Option::Some(self.data[0])
        } else {
            Option::None
        }
    }

    // Get the last element.
    pub fn last(self) -> Option[T]
        effects: [deterministic]
    {
        if self.length > 0 {
            Option::Some(self.data[(self.length - 1) as usize])
        } else {
            Option::None
        }
    }

    // Truncate to a new length.
    pub fn truncate(self: ref mut, new_len: u32)
        effects: [deterministic]
    {
        if new_len < self.length {
            self.length = new_len
        }
    }

    // Swap two elements.
    pub fn swap(self: ref mut, i: u32, j: u32) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if i >= self.length || j >= self.length {
            return Result::Err(bounds_index_out_of_range(
                if i >= self.length { i } else { j }, self.length))
        }
        let temp: T = self.data[i as usize]
        self.data[i as usize] = self.data[j as usize]
        self.data[j as usize] = temp
        Result::Ok(())
    }

    // Copy elements from another array.
    pub fn copy_from(self: ref mut, other: ref FixedArray[N, T])
        effects: [deterministic]
    {
        let copy_len: u32 = if self.length < other.length { self.length } else { other.length }
        // loop: bounds[BOUND_COPY] — bounded by capacity
        loop: bounds[BOUND_COPY] for i in 0..copy_len {
            self.data[i as usize] = other.data[i as usize]
        }
        self.length = copy_len
    }
}

// ──────────────────────────────────────────────
// FixedSlice[T]: A view into contiguous elements
// ──────────────────────────────────────────────
// Evidence path: COLL-SLICE-001 through COLL-SLICE-025

pub type FixedSlice[T] : struct {
    data: ref [T],
    length: u32,
}

impl[T] FixedSlice[T] {
    pub fn new(data: ref [T], length: u32) -> FixedSlice[T]
        effects: [deterministic]
    {
        FixedSlice { data: data, length: length }
    }

    pub fn get(self, index: u32) -> Result[ref T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        Result::Ok(&self.data[index as usize])
    }

    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }

    // Iterate over elements.
    // loop: bounds[BOUND_MEDIUM] — bounded by length.
    pub fn for_each(self, f: fn(ref T))
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] while i < self.length {
            f(&self.data[i as usize])
            i = i + 1
        }
    }

    // Split slice at an index.
    pub fn split_at(self, index: u32) -> (FixedSlice[T], FixedSlice[T])
        effects: [deterministic]
    {
        let left: FixedSlice[T] = FixedSlice {
            data: &self.data[0..index],
            length: index,
        }
        let right: FixedSlice[T] = FixedSlice {
            data: &self.data[index..self.length],
            length: self.length - index,
        }
        (left, right)
    }
}

// ──────────────────────────────────────────────
// Entry[K, V]: Key-value pair for Map
// ──────────────────────────────────────────────
// Evidence path: COLL-ENTRY-001 through COLL-ENTRY-010

pub type Entry[K, V] : struct {
    key: K,
    value: V,
    occupied: bool,
}

impl[K, V] Entry[K, V] {
    pub fn empty() -> Entry[K, V]
        effects: [deterministic]
    {
        Entry {
            key: K::default(),
            value: V::default(),
            occupied: false,
        }
    }

    pub fn new(key: K, value: V) -> Entry[K, V]
        effects: [deterministic]
    {
        Entry { key: key, value: value, occupied: true }
    }

    pub fn is_occupied(self) -> bool
        effects: [deterministic]
    {
        self.occupied
    }
}

// ──────────────────────────────────────────────
// FixedMap[N, K, V]: Fixed-capacity hash map
// ──────────────────────────────────────────────
// Uses open addressing with linear probing.
// Evidence path: COLL-MAP-001 through COLL-MAP-065

pub type FixedMap[N: static, K, V] : struct {
    entries: [Entry[K, V]; N],
    count: u32,
}

impl[N, K, V] FixedMap[N, K, V] {
    pub fn new() -> FixedMap[N, K, V]
        effects: [deterministic]
    {
        let mut entries: [Entry[K, V]; N] = [Entry::empty(); N]
        FixedMap { entries: entries, count: 0 }
    }

    // Hash function for the key. Uses the key's hash method.
    fn hash_key(key: K) -> u32
        effects: [deterministic]
    {
        // In production, K must implement Hashable.
        // For now, use a simple identity hash based on Word64 conversion.
        let raw: Word64 = __builtin_hash_value(key)
        let hash_val: u32 = (raw.to_u64() % N as u64) as u32
        hash_val
    }

    // Insert a key-value pair. Returns old value if key existed.
    pub fn insert(self: ref mut, key: K, value: V) -> Result[Option[V], BoundsError>
        effects: [deterministic]
    {
        if self.count >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }

        let hash: u32 = FixedMap::hash_key(key)
        let mut idx: u32 = hash

        // Linear probing.
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for _ in 0..N {
            if !self.entries[idx as usize].is_occupied() {
                self.entries[idx as usize] = Entry::new(key, value)
                self.count = self.count + 1
                return Result::Ok(Option::None)
            }
            if self.entries[idx as usize].key == key {
                let old: V = self.entries[idx as usize].value
                self.entries[idx as usize].value = value
                return Result::Ok(Option::Some(old))
            }
            idx = (idx + 1) % N
        }

        Result::Err(bounds_capacity_exceeded(N))
    }

    // Get a value by key.
    pub fn get(self, key: K) -> Option[V]
        effects: [deterministic]
    {
        let hash: u32 = FixedMap::hash_key(key)
        let mut idx: u32 = hash

        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for _ in 0..N {
            if !self.entries[idx as usize].is_occupied() {
                return Option::None
            }
            if self.entries[idx as usize].key == key {
                return Option::Some(self.entries[idx as usize].value)
            }
            idx = (idx + 1) % N
        }

        Option::None
    }

    // Remove a key-value pair.
    pub fn remove(self: ref mut, key: K) -> Option[V]
        effects: [deterministic]
    {
        let hash: u32 = FixedMap::hash_key(key)
        let mut idx: u32 = hash

        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for _ in 0..N {
            if !self.entries[idx as usize].is_occupied() {
                return Option::None
            }
            if self.entries[idx as usize].key == key {
                let value: V = self.entries[idx as usize].value
                self.entries[idx as usize].occupied = false
                self.count = self.count - 1
                // Rehash subsequent entries in cluster.
                let mut next: u32 = (idx + 1) % N
                // loop: bounds[BOUND_MEDIUM] — bounded by capacity
                loop: bounds[BOUND_MEDIUM] while next != idx {
                    if !self.entries[next as usize].is_occupied() {
                        break
                    }
                    let rehash_key: K = self.entries[next as usize].key
                    let rehash_val: V = self.entries[next as usize].value
                    self.entries[next as usize].occupied = false
                    self.count = self.count - 1
                    let _: Result[Option[V], BoundsError> = self.insert(rehash_key, rehash_val)
                    next = (next + 1) % N
                }
                return Option::Some(value)
            }
            idx = (idx + 1) % N
        }

        Option::None
    }

    // Check if a key exists.
    pub fn contains_key(self, key: K) -> bool
        effects: [deterministic]
    {
        let hash: u32 = FixedMap::hash_key(key)
        let mut idx: u32 = hash

        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for _ in 0..N {
            if !self.entries[idx as usize].is_occupied() {
                return false
            }
            if self.entries[idx as usize].key == key {
                return true
            }
            idx = (idx + 1) % N
        }

        false
    }

    // Get the number of entries.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.count
    }

    // Get the capacity.
    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        N
    }

    // Check if empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.count == 0
    }

    // Check if full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.count >= N
    }

    // Clear all entries.
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in 0..N {
            self.entries[i as usize].occupied = false
        }
        self.count = 0
    }

    // Iterate over all key-value pairs.
    // loop: bounds[BOUND_MEDIUM] — bounded by capacity.
    pub fn for_each(self, f: fn(K, V))
        effects: [deterministic]
    {
        let mut seen: u32 = 0
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] while seen < self.count && i < N {
            if self.entries[i as usize].is_occupied() {
                f(self.entries[i as usize].key, self.entries[i as usize].value)
                seen = seen + 1
            }
            i = i + 1
        }
    }

    // Get keys as an array.
    pub fn keys(self) -> FixedArray[N, K]
        effects: [deterministic]
    {
        let mut result: FixedArray[N, K] = FixedArray::new()
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in 0..N {
            if self.entries[i as usize].is_occupied() {
                let _: Result[(), BoundsError> = result.push(self.entries[i as usize].key)
            }
        }
        result
    }

    // Get values as an array.
    pub fn values(self) -> FixedArray[N, V]
        effects: [deterministic]
    {
        let mut result: FixedArray[N, V] = FixedArray::new()
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in 0..N {
            if self.entries[i as usize].is_occupied() {
                let _: Result[(), BoundsError> = result.push(self.entries[i as usize].value)
            }
        }
        result
    }

    // Get or insert a value (insert default if missing).
    pub fn get_or_insert(self: ref mut, key: K, default: V) -> Result[V, BoundsError>
        effects: [deterministic]
    {
        let existing: Option[V] = self.get(key)
        match existing {
            Option::Some(value) => Result::Ok(value),
            Option::None => {
                self.insert(key, default)?;
                Result::Ok(default)
            }
        }
    }

    // Merge another map into this one.
    pub fn merge(self: ref mut, other: FixedMap[N, K, V]) -> Result<u32, BoundsError>
        effects: [deterministic]
    {
        let mut merged_count: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in 0..N {
            if other.entries[i as usize].is_occupied() {
                let key: K = other.entries[i as usize].key
                let value: V = other.entries[i as usize].value
                if !self.contains_key(key) {
                    self.insert(key, value)?;
                    merged_count = merged_count + 1
                }
            }
        }
        Result::Ok(merged_count)
    }
}

// ──────────────────────────────────────────────
// FixedSet[N, T]: Fixed-capacity hash set
// ──────────────────────────────────────────────
// Evidence path: COLL-SET-001 through COLL-SET-050

pub type FixedSet[N: static, T] : struct {
    map: FixedMap[N, T, bool],
}

impl[N, T] FixedSet[N, T] {
    pub fn new() -> FixedSet[N, T]
        effects: [deterministic]
    {
        FixedSet { map: FixedMap::new() }
    }

    // Insert a value into the set.
    pub fn insert(self: ref mut, value: T) -> Result[bool, BoundsError>
        effects: [deterministic]
    {
        let existing: Option[bool] = self.map.insert(value, true)?
        Result::Ok(existing.is_none())
    }

    // Check if the set contains a value.
    pub fn contains(self, value: T) -> bool
        effects: [deterministic]
    {
        self.map.contains_key(value)
    }

    // Remove a value from the set.
    pub fn remove(self: ref mut, value: T) -> bool
        effects: [deterministic]
    {
        let removed: Option[bool] = self.map.remove(value)
        removed.is_some()
    }

    // Get the number of elements.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.map.count()
    }

    // Get the capacity.
    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        self.map.capacity()
    }

    // Check if empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.map.is_empty()
    }

    // Check if full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.map.is_full()
    }

    // Clear the set.
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.map.clear()
    }

    // Iterate over all elements.
    // loop: bounds[BOUND_MEDIUM] — bounded by capacity.
    pub fn for_each(self, f: fn(T))
        effects: [deterministic]
    {
        self.map.for_each(|key: T, _value: bool| {
            f(key)
        })
    }

    // Union with another set.
    pub fn union(self: ref mut, other: FixedSet[N, T]) -> Result<u32, BoundsError>
        effects: [deterministic]
    {
        let mut added: u32 = 0
        let other_values: FixedArray[N, T] = other.to_array()
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in 0..other_values.len() {
            if self.insert(other_values.get(i).unwrap())? {
                added = added + 1
            }
        }
        Result::Ok(added)
    }

    // Intersection with another set (modifies self).
    pub fn intersect(self: ref mut, other: FixedSet[N, T])
        effects: [deterministic]
    {
        let self_values: FixedArray[N, T] = self.to_array()
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in 0..self_values.len() {
            let val: T = self_values.get(i).unwrap()
            if !other.contains(val) {
                self.remove(val)
            }
        }
    }

    // Convert set to array.
    pub fn to_array(self) -> FixedArray[N, T]
        effects: [deterministic]
    {
        self.map.keys()
    }

    // Check if this set is a subset of another.
    pub fn is_subset_of(self, other: FixedSet[N, T]) -> bool
        effects: [deterministic]
    {
        let self_values: FixedArray[N, T] = self.to_array()
        // loop: bounds[BOUND_MEDIUM] — bounded by capacity
        loop: bounds[BOUND_MEDIUM] for i in 0..self_values.len() {
            if !other.contains(self_values.get(i).unwrap()) {
                return false
            }
        }
        true
    }

    // Check if sets are equal.
    pub fn eq(self, other: FixedSet[N, T]) -> bool
        effects: [deterministic]
    {
        if self.count() != other.count() {
            return false
        }
        self.is_subset_of(other)
    }
}

// ──────────────────────────────────────────────
// RingBuffer[N, T]: Fixed-capacity ring buffer
// ──────────────────────────────────────────────
// Evidence path: COLL-RING-001 through COLL-RING-050

pub type RingBuffer[N: static, T] : struct {
    data: [T; N],
    head: u32,  // Read position
    tail: u32,  // Write position
    count: u32,
}

impl[N, T] RingBuffer[N, T] {
    pub fn new() -> RingBuffer[N, T]
        effects: [deterministic]
    {
        RingBuffer {
            data: [T::default(); N],
            head: 0,
            tail: 0,
            count: 0,
        }
    }

    // Push a value to the back.
    pub fn push_back(self: ref mut, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if self.count >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        self.data[self.tail as usize] = value
        self.tail = (self.tail + 1) % N
        self.count = self.count + 1
        Result::Ok(())
    }

    // Push a value to the front.
    pub fn push_front(self: ref mut, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if self.count >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        // Decrement head with wrap.
        if self.head == 0 {
            self.head = N - 1
        } else {
            self.head = self.head - 1
        }
        self.data[self.head as usize] = value
        self.count = self.count + 1
        Result::Ok(())
    }

    // Pop a value from the front.
    pub fn pop_front(self: ref mut) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.count == 0 {
            return Result::Err(bounds_empty_collection())
        }
        let value: T = self.data[self.head as usize]
        self.head = (self.head + 1) % N
        self.count = self.count - 1
        Result::Ok(value)
    }

    // Pop a value from the back.
    pub fn pop_back(self: ref mut) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.count == 0 {
            return Result::Err(bounds_empty_collection())
        }
        if self.tail == 0 {
            self.tail = N - 1
        } else {
            self.tail = self.tail - 1
        }
        let value: T = self.data[self.tail as usize]
        self.count = self.count - 1
        Result::Ok(value)
    }

    // Peek at the front without removing.
    pub fn front(self) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.count == 0 {
            return Result::Err(bounds_empty_collection())
        }
        Result::Ok(self.data[self.head as usize])
    }

    // Peek at the back without removing.
    pub fn back(self) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.count == 0 {
            return Result::Err(bounds_empty_collection())
        }
        let back_idx: u32 = if self.tail == 0 { N - 1 } else { self.tail - 1 }
        Result::Ok(self.data[back_idx as usize])
    }

    // Get element at index (relative to head).
    pub fn get(self, index: u32) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.count {
            return Result::Err(bounds_index_out_of_range(index, self.count))
        }
        let idx: u32 = (self.head + index) % N
        Result::Ok(self.data[idx as usize])
    }

    // Get the number of elements.
    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.count
    }

    // Get the capacity.
    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        N
    }

    // Check if empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.count == 0
    }

    // Check if full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.count >= N
    }

    // Clear the buffer.
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.head = 0
        self.tail = 0
        self.count = 0
    }

    // Iterate over elements.
    // loop: bounds[BOUND_MEDIUM] — bounded by count.
    pub fn for_each(self, f: fn(T))
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by count
        loop: bounds[BOUND_MEDIUM] while i < self.count {
            let idx: u32 = (self.head + i) % N
            f(self.data[idx as usize])
            i = i + 1
        }
    }

    // Drain all elements, calling f for each.
    pub fn drain(self: ref mut, f: fn(T))
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by count
        loop: bounds[BOUND_MEDIUM] while self.count > 0 {
            let value: T = self.pop_front().unwrap()
            f(value)
        }
    }

    // Resize to a new capacity (creates a new buffer).
    // Note: truncates if new capacity is smaller.
    pub fn resize[M: static](self, new_buf: ref mut RingBuffer[M, T])
        effects: [deterministic]
    {
        new_buf.clear()
        // loop: bounds[BOUND_MEDIUM] — bounded by count
        loop: bounds[BOUND_MEDIUM] for i in 0..self.count {
            let idx: u32 = (self.head + i) % N
            let _: Result[(), BoundsError> = new_buf.push_back(self.data[idx as usize])
        }
    }
}

// ──────────────────────────────────────────────
// Stack[N, T]: Fixed-capacity stack (LIFO)
// ──────────────────────────────────────────────
// Evidence path: COLL-STACK-001 through COLL-STACK-035

pub type Stack[N: static, T] : struct {
    data: [T; N],
    top: u32,  // Index of next free slot
}

impl[N, T] Stack[N, T] {
    pub fn new() -> Stack[N, T]
        effects: [deterministic]
    {
        Stack {
            data: [T::default(); N],
            top: 0,
        }
    }

    // Push a value onto the stack.
    pub fn push(self: ref mut, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if self.top >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        self.data[self.top as usize] = value
        self.top = self.top + 1
        Result::Ok(())
    }

    // Pop a value from the stack.
    pub fn pop(self: ref mut) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.top == 0 {
            return Result::Err(bounds_empty_collection())
        }
        self.top = self.top - 1
        Result::Ok(self.data[self.top as usize])
    }

    // Peek at the top without removing.
    pub fn peek(self) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.top == 0 {
            return Result::Err(bounds_empty_collection())
        }
        Result::Ok(self.data[(self.top - 1) as usize])
    }

    // Get the number of elements.
    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.top
    }

    // Get the capacity.
    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        N
    }

    // Check if empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.top == 0
    }

    // Check if full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.top >= N
    }

    // Clear the stack.
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.top = 0
    }

    // Iterate from bottom to top.
    // loop: bounds[BOUND_MEDIUM] — bounded by top.
    pub fn for_each(self, f: fn(T))
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by top
        loop: bounds[BOUND_MEDIUM] while i < self.top {
            f(self.data[i as usize])
            i = i + 1
        }
    }

    // Iterate from top to bottom.
    // loop: bounds[BOUND_MEDIUM] — bounded by top.
    pub fn for_each_rev(self, f: fn(T))
        effects: [deterministic]
    {
        let mut i: u32 = self.top
        // loop: bounds[BOUND_MEDIUM] — bounded by top
        loop: bounds[BOUND_MEDIUM] while i > 0 {
            i = i - 1
            f(self.data[i as usize])
        }
    }

    // Drain all elements (pop each and call f).
    pub fn drain(self: ref mut, f: fn(T))
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by top
        loop: bounds[BOUND_MEDIUM] while self.top > 0 {
            let value: T = self.pop().unwrap()
            f(value)
        }
    }

    // Convert to a FixedArray (bottom-to-top).
    pub fn to_array(self) -> FixedArray[N, T]
        effects: [deterministic]
    {
        let mut result: FixedArray[N, T] = FixedArray::new()
        result.length = self.top
        // loop: bounds[BOUND_MEDIUM] — bounded by top
        loop: bounds[BOUND_MEDIUM] for i in 0..self.top {
            result.data[i as usize] = self.data[i as usize]
        }
        result
    }

    // Duplicate the top element.
    pub fn dup(self: ref mut) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        let top_val: T = self.peek()?
        self.push(top_val)
    }

    // Swap the top two elements.
    pub fn swap_top(self: ref mut) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if self.top < 2 {
            return Result::Err(bounds_empty_collection())
        }
        let temp: T = self.data[(self.top - 1) as usize]
        self.data[(self.top - 1) as usize] = self.data[(self.top - 2) as usize]
        self.data[(self.top - 2) as usize] = temp
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Sequence[N, T]: Fixed-capacity double-ended sequence
// ──────────────────────────────────────────────
// Combines features of array and ring buffer with direct indexing.
// Evidence path: COLL-SEQ-001 through COLL-SEQ-055

pub type Sequence[N: static, T] : struct {
    // Contiguous block of elements.
    data: [T; N],
    // Start offset in the virtual ring.
    start: u32,
    // Number of elements.
    length: u32,
}

impl[N, T] Sequence[N, T] {
    pub fn new() -> Sequence[N, T]
        effects: [deterministic]
    {
        Sequence {
            data: [T::default(); N],
            start: 0,
            length: 0,
        }
    }

    // Map virtual index to physical index.
    fn phys_index(self, virt: u32) -> u32
        effects: [deterministic]
    {
        (self.start + virt) % N
    }

    // Get element at virtual index.
    pub fn get(self, index: u32) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        Result::Ok(self.data[self.phys_index(index) as usize])
    }

    // Set element at virtual index.
    pub fn set(self: ref mut, index: u32, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        self.data[self.phys_index(index) as usize] = value
        Result::Ok(())
    }

    // Push to the front.
    pub fn push_front(self: ref mut, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if self.length >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        if self.start == 0 {
            self.start = N - 1
        } else {
            self.start = self.start - 1
        }
        self.data[self.start as usize] = value
        self.length = self.length + 1
        Result::Ok(())
    }

    // Push to the back.
    pub fn push_back(self: ref mut, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if self.length >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        let end: u32 = (self.start + self.length) % N
        self.data[end as usize] = value
        self.length = self.length + 1
        Result::Ok(())
    }

    // Pop from the front.
    pub fn pop_front(self: ref mut) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.length == 0 {
            return Result::Err(bounds_empty_collection())
        }
        let value: T = self.data[self.start as usize]
        self.start = (self.start + 1) % N
        self.length = self.length - 1
        Result::Ok(value)
    }

    // Pop from the back.
    pub fn pop_back(self: ref mut) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.length == 0 {
            return Result::Err(bounds_empty_collection())
        }
        self.length = self.length - 1
        let end: u32 = (self.start + self.length) % N
        Result::Ok(self.data[end as usize])
    }

    // Peek at front.
    pub fn front(self) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.length == 0 {
            return Result::Err(bounds_empty_collection())
        }
        Result::Ok(self.data[self.start as usize])
    }

    // Peek at back.
    pub fn back(self) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if self.length == 0 {
            return Result::Err(bounds_empty_collection())
        }
        let end: u32 = (self.start + self.length - 1) % N
        Result::Ok(self.data[end as usize])
    }

    // Get length.
    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    // Get capacity.
    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        N
    }

    // Check if empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }

    // Check if full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.length >= N
    }

    // Clear the sequence.
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.start = 0
        self.length = 0
    }

    // Remove element at virtual index, shifting others.
    pub fn remove(self: ref mut, index: u32) -> Result[T, BoundsError>
        effects: [deterministic]
    {
        if index >= self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        let phys: u32 = self.phys_index(index)
        let value: T = self.data[phys as usize]

        // Decide whether to shift left or right (minimize moves).
        if index < self.length / 2 {
            // Shift elements before index right by 1.
            // loop: bounds[BOUND_MEDIUM] — bounded by length
            loop: bounds[BOUND_MEDIUM] for i in (0..index).rev() {
                let src: u32 = self.phys_index(i)
                let dst: u32 = self.phys_index(i + 1)
                self.data[dst as usize] = self.data[src as usize]
            }
            self.start = (self.start + 1) % N
        } else {
            // Shift elements after index left by 1.
            // loop: bounds[BOUND_MEDIUM] — bounded by length
            loop: bounds[BOUND_MEDIUM] for i in (index + 1)..self.length {
                let src: u32 = self.phys_index(i)
                let dst: u32 = self.phys_index(i - 1)
                self.data[dst as usize] = self.data[src as usize]
            }
        }
        self.length = self.length - 1
        Result::Ok(value)
    }

    // Insert at virtual index, shifting others.
    pub fn insert(self: ref mut, index: u32, value: T) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        if index > self.length {
            return Result::Err(bounds_index_out_of_range(index, self.length))
        }
        if self.length >= N {
            return Result::Err(bounds_capacity_exceeded(N))
        }
        if index < self.length / 2 {
            // Shift elements before index left by 1.
            if self.start == 0 {
                self.start = N - 1
            } else {
                self.start = self.start - 1
            }
            // loop: bounds[BOUND_MEDIUM] — bounded by length
            loop: bounds[BOUND_MEDIUM] for i in 0..index {
                let src: u32 = self.phys_index(i + 1)
                let dst: u32 = self.phys_index(i)
                self.data[dst as usize] = self.data[src as usize]
            }
        } else {
            // Shift elements after index right by 1.
            // loop: bounds[BOUND_MEDIUM] — bounded by length
            loop: bounds[BOUND_MEDIUM] for i in (index..self.length).rev() {
                let src: u32 = self.phys_index(i)
                let dst: u32 = self.phys_index(i + 1)
                self.data[dst as usize] = self.data[src as usize]
            }
        }
        let phys: u32 = self.phys_index(index)
        self.data[phys as usize] = value
        self.length = self.length + 1
        Result::Ok(())
    }

    // Iterate over elements.
    // loop: bounds[BOUND_MEDIUM] — bounded by length.
    pub fn for_each(self, f: fn(T))
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] while i < self.length {
            f(self.data[self.phys_index(i) as usize])
            i = i + 1
        }
    }

    // Convert to a contiguous FixedArray.
    pub fn to_array(self) -> FixedArray[N, T]
        effects: [deterministic]
    {
        let mut result: FixedArray[N, T] = FixedArray::new()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..self.length {
            let _: Result[(), BoundsError> = result.push(self.data[self.phys_index(i) as usize])
        }
        result
    }

    // Reverse the sequence in-place.
    pub fn reverse(self: ref mut)
        effects: [deterministic]
    {
        let mut i: u32 = 0
        let mut j: u32 = self.length - 1
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] while i < j {
            let pi: u32 = self.phys_index(i)
            let pj: u32 = self.phys_index(j)
            let temp: T = self.data[pi as usize]
            self.data[pi as usize] = self.data[pj as usize]
            self.data[pj as usize] = temp
            i = i + 1
            j = j - 1
        }
    }
}
