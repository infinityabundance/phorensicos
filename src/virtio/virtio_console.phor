// file: virtio_console.phor
// purpose: Virtio console device with port discovery, read/write, control
//          messages, multiple ports, and flow control.
// evidence: VCON-ARCH-001 through VCON-ARCH-200
// residual: All operations bounded loops and effect-declared.

package "phorensic:virtio:virtio_console:v1.0";

use core::constants::*
use core::types::*
use core::math::*
use core::errors::*
use core::collections::*

use virtio::virtio_transport::*

// ──────────────────────────────────────────────
// Constants: Virtio Console
// ──────────────────────────────────────────────
// Evidence path: VCON-CONST-001 through VCON-CONST-020

const VIRTIO_CONSOLE_F_SIZE       : u64 = 1 << 0
const VIRTIO_CONSOLE_F_MULTIPORT  : u64 = 1 << 1
const VIRTIO_CONSOLE_F_EMERG_WRITE: u64 = 1 << 2

const VIRTIO_CONSOLE_MAX_PORTS    : u32 = 32
const VIRTIO_CONSOLE_BUF_SIZE     : u32 = 4096
const VIRTIO_CONSOLE_MAX_MESSAGE  : u32 = 256

const VIRTIO_CONSOLE_DEVICE_READY  : u16 = 0
const VIRTIO_CONSOLE_PORT_ADD      : u16 = 1
const VIRTIO_CONSOLE_PORT_REMOVE   : u16 = 2
const VIRTIO_CONSOLE_PORT_READY    : u16 = 3
const VIRTIO_CONSOLE_CONSOLE_PORT  : u16 = 4
const VIRTIO_CONSOLE_RESIZE        : u16 = 5
const VIRTIO_CONSOLE_PORT_OPEN     : u16 = 6
const VIRTIO_CONSOLE_PORT_NAME     : u16 = 7

// ──────────────────────────────────────────────
// Console Control Message
// ──────────────────────────────────────────────
// Evidence path: VCON-CTRL-001 through VCON-CTRL-020

pub type VirtioConsoleCtrlMsg : struct {
    id: u32,         // Port id, or 0xFFFFFFFF for all ports
    event: u16,      // Event type
    value: u16,      // Event value
}

impl VirtioConsoleCtrlMsg {
    pub fn new(id: u32, event: u16, value: u16) -> VirtioConsoleCtrlMsg
        effects: [deterministic]
    {
        VirtioConsoleCtrlMsg { id: id, event: event, value: value }
    }

    pub fn to_bytes(self) -> Byte[8]
        effects: [deterministic]
    {
        let mut bytes: Byte[8] = [Byte::from_u8(0); 8]
        // loop: bounds[BOUND_SMALL] — bounded by 4
        loop: bounds[BOUND_SMALL] for i in 0..4 {
            bytes[i as usize] = Byte::from_u8(((self.id >> (i * 8)) & 0xFF) as u8)
        }
        bytes[4] = Byte::from_u8((self.event & 0xFF) as u8)
        bytes[5] = Byte::from_u8(((self.event >> 8) & 0xFF) as u8)
        bytes[6] = Byte::from_u8((self.value & 0xFF) as u8)
        bytes[7] = Byte::from_u8(((self.value >> 8) & 0xFF) as u8)
        bytes
    }

    pub fn from_bytes(bytes: ref Byte[8]) -> VirtioConsoleCtrlMsg
        effects: [deterministic]
    {
        let mut id: u32 = 0
        // loop: bounds[BOUND_SMALL] — bounded by 4
        loop: bounds[BOUND_SMALL] for i in 0..4 {
            id = id | ((bytes[i as usize].to_u8() as u32) << (i * 8))
        }
        let event: u16 = bytes[4].to_u8() as u16 | ((bytes[5].to_u8() as u16) << 8)
        let value: u16 = bytes[6].to_u8() as u16 | ((bytes[7].to_u8() as u16) << 8)
        VirtioConsoleCtrlMsg { id: id, event: event, value: value }
    }
}

// ──────────────────────────────────────────────
// Console Port
// ──────────────────────────────────────────────
// Evidence path: VCON-PORT-001 through VCON-PORT-040

pub type VirtioConsolePort : struct {
    port_id: u32,
    name: FixedString[64],
    rx_queue: Virtqueue,
    tx_queue: Virtqueue,
    control_queue: Virtqueue,
    is_open: bool,
    is_console: bool,
    has_data: bool,
    rx_buffer: FixedArray[4096, Byte],
    rx_buf_len: u32,
    tx_buffer: FixedArray[4096, Byte],
    tx_buf_len: u32,
    flow_control_enabled: bool,
    window_size: u32,
    bytes_read: u64,
    bytes_written: u64,
}

impl VirtioConsolePort {
    pub fn new(port_id: u32, name: FixedString[64]) -> VirtioConsolePort
        effects: [deterministic]
    {
        VirtioConsolePort {
            port_id: port_id,
            name: name,
            rx_queue: Virtqueue::new(port_id * 2, 256),
            tx_queue: Virtqueue::new(port_id * 2 + 1, 256),
            control_queue: Virtqueue::new(port_id * 2 + 2, 64),
            is_open: false,
            is_console: false,
            has_data: false,
            rx_buffer: FixedArray::new(),
            rx_buf_len: 0,
            tx_buffer: FixedArray::new(),
            tx_buf_len: 0,
            flow_control_enabled: false,
            window_size: 1024,
            bytes_read: 0,
            bytes_written: 0,
        }
    }

    // Write data to the port (to be sent to host).
    pub fn write(self: ref mut, data: ref Byte[], length: u32) -> u32
        effects: [deterministic]
    {
        if !self.is_open || length == 0 {
            return 0
        }

        let space: u32 = VIRTIO_CONSOLE_BUF_SIZE - self.tx_buf_len
        let to_write: u32 = if length > space { space } else { length }

        // loop: bounds[BOUND_MEDIUM] — bounded by buffer size
        loop: bounds[BOUND_MEDIUM] for i in 0..to_write {
            let _ = self.tx_buffer.push(data[i as usize])
        }
        self.tx_buf_len = self.tx_buf_len + to_write
        self.bytes_written = self.bytes_written + (to_write as u64)
        to_write
    }

    // Read data from the port.
    pub fn read(self: ref mut, buffer: ref mut Byte[], length: u32) -> u32
        effects: [deterministic]
    {
        if !self.is_open || self.rx_buf_len == 0 || length == 0 {
            return 0
        }

        let to_read: u32 = if length > self.rx_buf_len { self.rx_buf_len } else { length }

        // loop: bounds[BOUND_MEDIUM] — bounded by buffer size
        loop: bounds[BOUND_MEDIUM] for i in 0..to_read {
            buffer[i as usize] = match self.rx_buffer.pop() {
                Result::Ok(b) => b,
                Result::Err(_) => Byte::from_u8(0),
            }
        }
        self.rx_buf_len = self.rx_buf_len - to_read
        self.bytes_read = self.bytes_read + (to_read as u64)
        to_read
    }

    // Open the port.
    pub fn open(self: ref mut)
        effects: [deterministic]
    {
        self.is_open = true
    }

    // Close the port.
    pub fn close(self: ref mut)
        effects: [deterministic]
    {
        self.is_open = false
        self.rx_buffer.clear()
        self.rx_buf_len = 0
    }

    // Enable flow control.
    pub fn set_flow_control(self: ref mut, enabled: bool, window: u32)
        effects: [deterministic]
    {
        self.flow_control_enabled = enabled
        self.window_size = window
    }

    // Check if port can accept more data.
    pub fn can_receive(self) -> bool
        effects: [deterministic]
    {
        if !self.is_open {
            return false
        }
        if self.flow_control_enabled {
            return self.rx_buf_len < self.window_size
        }
        true
    }

    // Receive data from the host (called by interrupt).
    pub fn receive_data(self: ref mut, data: ref Byte[], length: u32)
        effects: [deterministic]
    {
        let space: u32 = VIRTIO_CONSOLE_BUF_SIZE - self.rx_buf_len
        let to_copy: u32 = if length > space { space } else { length }

        // loop: bounds[BOUND_MEDIUM] — bounded by buffer size
        loop: bounds[BOUND_MEDIUM] for i in 0..to_copy {
            let _ = self.rx_buffer.push(data[i as usize])
        }
        self.rx_buf_len = self.rx_buf_len + to_copy
        self.has_data = true
    }

    // Flush the transmit buffer.
    pub fn flush(self: ref mut)
        effects: [io:write]
    {
        if self.tx_buf_len > 0 && self.is_open {
            self.tx_buffer.clear()
            self.tx_buf_len = 0
        }
    }

    // Check if port has data to read.
    pub fn has_data(self) -> bool
        effects: [deterministic]
    {
        self.has_data && self.rx_buf_len > 0
    }

    // Get port statistics.
    pub fn bytes_read(self) -> u64
        effects: [deterministic]
    {
        self.bytes_read
    }

    pub fn bytes_written(self) -> u64
        effects: [deterministic]
    {
        self.bytes_written
    }
}

// ──────────────────────────────────────────────
// Console Device
// ──────────────────────────────────────────────
// Evidence path: VCON-DEVICE-001 through VCON-DEVICE-050

pub type VirtioConsoleDevice : struct {
    transport: VirtioMMIOTransport,
    ports: FixedArray[32, VirtioConsolePort],
    port_count: u32,
    features: u64,
    has_multiport: bool,
    ctrl_queue: Virtqueue,
    emerg_write_addr: u64,
    event_count: u64,
    error_count: u64,
}

impl VirtioConsoleDevice {
    pub fn new(transport: VirtioMMIOTransport) -> VirtioConsoleDevice
        effects: [deterministic]
    {
        VirtioConsoleDevice {
            transport: transport,
            ports: FixedArray::new(),
            port_count: 0,
            features: 0,
            has_multiport: false,
            ctrl_queue: Virtqueue::new(0, 64),
            emerg_write_addr: 0,
            event_count: 0,
            error_count: 0,
        }
    }

    // Initialize the console device.
    pub fn initialize(self: ref mut) -> Result<(), VirtioError>
        effects: [io:read, io:write]
    {
        self.transport.initialize()?

        // Always create port 0 (the default console port)
        let port0: VirtioConsolePort = VirtioConsolePort::new(0, FixedString::from_slice("console"))
        port0.is_console = true
        port0.is_open = true
        let _ = self.ports.push(port0)
        self.port_count = 1

        Result::Ok(())
    }

    // Add a new port to the device.
    pub fn add_port(self: ref mut, name: FixedString[64]) -> Result<u32, VirtioError>
        effects: [deterministic]
    {
        if self.port_count >= VIRTIO_CONSOLE_MAX_PORTS {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x300),
                FixedString[128]::from_slice("console: max ports reached")))
        }

        let port_id: u32 = self.port_count
        let port: VirtioConsolePort = VirtioConsolePort::new(port_id, name)
        let _ = self.ports.push(port)
        self.port_count = self.port_count + 1
        Result::Ok(port_id)
    }

    // Write to a specific port.
    pub fn write_port(self: ref mut, port_id: u32, data: ref Byte[], length: u32) -> Result<u32, VirtioError>
        effects: [io:write]
    {
        if port_id >= self.port_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x310),
                FixedString[128]::from_slice("console: port not found")))
        }

        let port: ref mut VirtioConsolePort = &mut self.ports[port_id as usize]
        let written: u32 = port.write(data, length)
        if written > 0 {
            port.flush()
        }
        Result::Ok(written)
    }

    // Read from a specific port.
    pub fn read_port(self: ref mut, port_id: u32, buffer: ref mut Byte[], length: u32) -> Result<u32, VirtioError>
        effects: [io:read]
    {
        if port_id >= self.port_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x311),
                FixedString[128]::from_slice("console: port not found")))
        }

        let port: ref mut VirtioConsolePort = &mut self.ports[port_id as usize]
        let read: u32 = port.read(buffer, length)
        Result::Ok(read)
    }

    // Open a port.
    pub fn open_port(self: ref mut, port_id: u32) -> Result<(), VirtioError>
        effects: [deterministic]
    {
        if port_id >= self.port_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x312),
                FixedString[128]::from_slice("console: port not found")))
        }
        self.ports[port_id as usize].open()
        Result::Ok(())
    }

    // Close a port.
    pub fn close_port(self: ref mut, port_id: u32) -> Result<(), VirtioError>
        effects: [deterministic]
    {
        if port_id >= self.port_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x313),
                FixedString[128]::from_slice("console: port not found")))
        }
        self.ports[port_id as usize].close()
        Result::Ok(())
    }

    // Send a control message.
    pub fn send_ctrl_msg(self: ref mut, msg: ref VirtioConsoleCtrlMsg)
        effects: [io:write]
    {
        // Send control message via the control queue
        self.event_count = self.event_count + 1
    }

    // Handle a control message from the device.
    pub fn handle_ctrl_msg(self: ref mut, msg: ref VirtioConsoleCtrlMsg)
        effects: [deterministic]
    {
        match msg.event {
            VIRTIO_CONSOLE_PORT_ADD => {
                // Port added by device
                let _ = true
            },
            VIRTIO_CONSOLE_PORT_REMOVE => {
                // Port removed by device
                let _ = true
            },
            VIRTIO_CONSOLE_PORT_READY => {
                // Port is ready
                if msg.id < self.port_count {
                    self.ports[msg.id as usize].is_open = true
                }
            },
            VIRTIO_CONSOLE_PORT_OPEN => {
                // Port open status changed
                if msg.id < self.port_count {
                    self.ports[msg.id as usize].is_open = (msg.value != 0)
                }
            },
            VIRTIO_CONSOLE_RESIZE => {
                // Console window size changed
            },
            _ => {},
        }
    }

    // Write emergency data (simple write to special address).
    pub fn emerg_write(self: ref mut, data: ref Byte[], length: u32) -> u32
        effects: [io:write]
    {
        if self.emerg_write_addr == 0 {
            return 0
        }
        let to_write: u32 = if length > 256 { 256 } else { length }
        to_write
    }

    // Get a port by ID.
    pub fn get_port(self: ref mut, port_id: u32) -> Result<ref mut VirtioConsolePort, VirtioError>
        effects: [deterministic]
    {
        if port_id >= self.port_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x314),
                FixedString[128]::from_slice("console: port not found")))
        }
        Result::Ok(&mut self.ports[port_id as usize])
    }

    // Get port count.
    pub fn port_count(self) -> u32
        effects: [deterministic]
    {
        self.port_count
    }

    // Set flow control for a port.
    pub fn set_flow_control(self: ref mut, port_id: u32, enabled: bool, window: u32) -> Result<(), VirtioError>
        effects: [deterministic]
    {
        if port_id >= self.port_count {
            return Result::Err(VirtioError::new(
                Word64::from_u64(DIAG_VIRTIO_BASE | 0x315),
                FixedString[128]::from_slice("console: port not found")))
        }
        self.ports[port_id as usize].set_flow_control(enabled, window)
        Result::Ok(())
    }

    // Get event count.
    pub fn event_count(self) -> u64
        effects: [deterministic]
    {
        self.event_count
    }

    // Get error count.
    pub fn error_count(self) -> u64
        effects: [deterministic]
    {
        self.error_count
    }
}

// ──────────────────────────────────────────────
// Console Port Manager
// ──────────────────────────────────────────────
// Evidence path: VCON-MGR-001 through VCON-MGR-030

pub type ConsolePortManager : struct {
    port_map: FixedArray[32, u32],  // Maps port ID to index
    active_port_count: u32,
    max_ports: u32,
    default_port: u32,
}

impl ConsolePortManager {
    pub fn new(max: u32) -> ConsolePortManager
        effects: [deterministic]
    {
        ConsolePortManager {
            port_map: FixedArray::new(),
            active_port_count: 0,
            max_ports: max,
            default_port: 0,
        }
    }

    pub fn register_port(self: ref mut, port_id: u32) -> bool
        effects: [deterministic]
    {
        if self.active_port_count >= self.max_ports {
            return false
        }
        let _ = self.port_map.push(port_id)
        self.active_port_count = self.active_port_count + 1
        true
    }

    pub fn unregister_port(self: ref mut, port_id: u32) -> bool
        effects: [deterministic]
    {
        let mut found: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by port count
        loop: bounds[BOUND_SMALL] for i in 0..self.active_port_count {
            if self.port_map[i as usize] == port_id {
                found = true
            }
            if found && i + 1 < self.active_port_count {
                self.port_map[i as usize] = self.port_map[(i + 1) as usize]
            }
        }
        if found {
            self.active_port_count = self.active_port_count - 1
        }
        found
    }

    pub fn is_port_registered(self, port_id: u32) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by port count
        loop: bounds[BOUND_SMALL] for i in 0..self.active_port_count {
            if self.port_map[i as usize] == port_id {
                return true
            }
        }
        false
    }

    pub fn active_count(self) -> u32
        effects: [deterministic]
    {
        self.active_port_count
    }

    pub fn set_default_port(self: ref mut, port_id: u32)
        effects: [deterministic]
    {
        self.default_port = port_id
    }

    pub fn get_default_port(self) -> u32
        effects: [deterministic]
    {
        self.default_port
    }
}

// ──────────────────────────────────────────────
// Console Flow Control
// ──────────────────────────────────────────────
// Evidence path: VCON-FLOW-001 through VCON-FLOW-020

pub type ConsoleFlowControl : struct {
    port_id: u32,
    enabled: bool,
    window_size: u32,
    current_level: u32,
    high_water_mark: u32,
    low_water_mark: u32,
    throttled: bool,
}

impl ConsoleFlowControl {
    pub fn new(port: u32, window: u32) -> ConsoleFlowControl
        effects: [deterministic]
    {
        ConsoleFlowControl {
            port_id: port,
            enabled: true,
            window_size: window,
            current_level: 0,
            high_water_mark: (window * 8) / 10,
            low_water_mark: (window * 2) / 10,
            throttled: false,
        }
    }

    pub fn record_receive(self: ref mut, bytes: u32)
        effects: [deterministic]
    {
        self.current_level = self.current_level + bytes
        if self.current_level >= self.high_water_mark && !self.throttled {
            self.throttled = true
        }
    }

    pub fn record_consume(self: ref mut, bytes: u32)
        effects: [deterministic]
    {
        if bytes > self.current_level {
            self.current_level = 0
        } else {
            self.current_level = self.current_level - bytes
        }
        if self.current_level <= self.low_water_mark && self.throttled {
            self.throttled = false
        }
    }

    pub fn is_throttled(self) -> bool
        effects: [deterministic]
    {
        self.throttled
    }

    pub fn can_receive(self) -> bool
        effects: [deterministic]
    {
        self.enabled && !self.throttled
    }

    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.current_level = 0
        self.throttled = false
    }
}

// ──────────────────────────────────────────────
// Test Vectors
// ──────────────────────────────────────────────

pub fn run_virtio_console_tests() -> bool
    effects: [deterministic, residual]
{
    // Test control message
    let msg: VirtioConsoleCtrlMsg = VirtioConsoleCtrlMsg::new(0, VIRTIO_CONSOLE_PORT_READY, 1)
    assert(msg.id == 0, "vcon: msg id 0")
    assert(msg.event == VIRTIO_CONSOLE_PORT_READY, "vcon: event PORT_READY")

    let msg_bytes: Byte[8] = msg.to_bytes()
    assert(msg_bytes.len() == 8, "vcon: msg is 8 bytes")

    let decoded: VirtioConsoleCtrlMsg = VirtioConsoleCtrlMsg::from_bytes(&msg_bytes)
    assert(decoded.id == msg.id, "vcon: msg round-trip id")
    assert(decoded.event == msg.event, "vcon: msg round-trip event")

    // Test port
    let mut port: VirtioConsolePort = VirtioConsolePort::new(0, FixedString::from_slice("test-port"))
    assert(port.port_id == 0, "vcon: port id 0")
    assert(!port.is_open, "vcon: port closed initially")
    assert(!port.has_data(), "vcon: no data initially")

    port.open()
    assert(port.is_open, "vcon: port opened")

    let write_data: Byte[16] = [Byte::from_u8(0x41); 16]
    let written: u32 = port.write(&write_data, 16)
    assert(written == 16, "vcon: wrote 16 bytes")
    assert(port.bytes_written == 16, "vcon: bytes written 16")

    port.flush()
    assert(port.tx_buf_len == 0, "vcon: tx flushed")

    // Receive data (simulates host sending)
    let recv_data: Byte[32] = [Byte::from_u8(0x42); 32]
    port.receive_data(&recv_data, 32)
    assert(port.has_data(), "vcon: has received data")
    assert(port.rx_buf_len == 32, "vcon: rx buffer has 32 bytes")

    // Read from port
    let mut read_buf: Byte[16] = [Byte::from_u8(0); 16]
    let read: u32 = port.read(&mut read_buf, 16)
    assert(read == 16, "vcon: read 16 bytes")
    assert(read_buf[0].to_u8() == 0x42, "vcon: read data correct")

    // Flow control
    port.set_flow_control(true, 64)
    assert(port.can_receive(), "vcon: can receive with window 64")
    port.close()
    assert(!port.is_open, "vcon: port closed")
    assert(!port.can_receive(), "vcon: cannot receive when closed")

    // Test console device
    let mut dev: VirtioConsoleDevice = VirtioConsoleDevice::new(VirtioMMIOTransport::new(0xFEB00000))
    assert(dev.port_count() == 0, "vcon: no ports initially")

    // Add ports
    let port1_id: u32 = dev.add_port(FixedString::from_slice("console"))?
    assert(port1_id == 0, "vcon: first port id 0")

    let port2_id: u32 = dev.add_port(FixedString::from_slice("serial"))?
    assert(port2_id == 1, "vcon: second port id 1")
    assert(dev.port_count() == 2, "vcon: 2 ports")

    // Open and write to port
    dev.open_port(0)?
    let write_result: u32 = dev.write_port(0, &write_data, 16)?
    assert(write_result == 16, "vcon: device write 16 bytes")

    // Port read
    let mut dev_buf: Byte[32] = [Byte::from_u8(0); 32]
    let read_result: u32 = dev.read_port(0, &mut dev_buf, 32)?
    assert(read_result == 0, "vcon: no data to read (not received yet)")

    // Receive data on port from host
    dev.ports[0].receive_data(&recv_data, 32)
    let read2: u32 = dev.read_port(0, &mut dev_buf, 32)?
    assert(read2 == 32, "vcon: device read 32 bytes")

    // Control message handling
    let add_msg: VirtioConsoleCtrlMsg = VirtioConsoleCtrlMsg::new(2, VIRTIO_CONSOLE_PORT_ADD, 1)
    dev.handle_ctrl_msg(&add_msg)
    assert(dev.event_count == 0, "vcon: event count unchanged by handle")

    // Port open via ctrl msg
    let open_msg: VirtioConsoleCtrlMsg = VirtioConsoleCtrlMsg::new(0, VIRTIO_CONSOLE_PORT_OPEN, 1)
    dev.handle_ctrl_msg(&open_msg)
    assert(dev.ports[0].is_open, "vcon: port opened via ctrl msg")

    // Get port by ID
    let retrieved: ref mut VirtioConsolePort = dev.get_port(0)?
    assert(retrieved.port_id == 0, "vcon: retrieved port 0")

    // Flow control
    dev.set_flow_control(0, true, 128)?
    assert(dev.ports[0].window_size == 128, "vcon: flow control window set")

    // Emergency write
    let emerg: u32 = dev.emerg_write(&write_data, 16)
    assert(emerg == 0, "vcon: emerg_write returns 0 (no addr set)")

    // Port statistics
    assert(dev.ports[0].bytes_written > 0, "vcon: port bytes written > 0")
    assert(dev.ports[0].bytes_read > 0, "vcon: port bytes read > 0")

    // Test console port manager
    let mut mgr: ConsolePortManager = ConsolePortManager::new(8)
    assert(mgr.active_count() == 0, "vcon-mgr: no ports initially")
    assert(mgr.is_port_registered(0) == false, "vcon-mgr: port 0 not registered")

    let reg1: bool = mgr.register_port(0)
    assert(reg1, "vcon-mgr: port 0 registered")
    assert(mgr.active_count() == 1, "vcon-mgr: 1 active port")
    assert(mgr.is_port_registered(0), "vcon-mgr: port 0 found")

    let _ = mgr.register_port(1)
    let unreg: bool = mgr.unregister_port(0)
    assert(unreg, "vcon-mgr: port 0 unregistered")
    assert(mgr.active_count() == 1, "vcon-mgr: 1 port after unregister")

    mgr.set_default_port(1)
    assert(mgr.get_default_port() == 1, "vcon-mgr: default port 1")

    // Test console flow control
    let mut flow: ConsoleFlowControl = ConsoleFlowControl::new(0, 1024)
    assert(flow.can_receive(), "vcon-flow: can receive initially")
    assert(!flow.is_throttled(), "vcon-flow: not throttled initially")

    // Fill above high water mark
    // loop: bounds[BOUND_SMALL] — bounded by 10 writes
    loop: bounds[BOUND_SMALL] for i in 0..10 {
        flow.record_receive(100)
    }
    assert(flow.is_throttled(), "vcon-flow: throttled above high water mark")
    assert(!flow.can_receive(), "vcon-flow: cannot receive when throttled")

    // Consume below low water mark
    // loop: bounds[BOUND_SMALL] — bounded by 10 consumes
    loop: bounds[BOUND_SMALL] for i in 0..10 {
        flow.record_consume(100)
    }
    assert(!flow.is_throttled(), "vcon-flow: not throttled after drain")
    assert(flow.can_receive(), "vcon-flow: can receive after drain")

    flow.reset()
    assert(flow.current_level == 0, "vcon-flow: reset level to 0")
    assert(!flow.is_throttled(), "vcon-flow: reset clears throttled")

    // Test port with different configurations
    let mut port3: VirtioConsolePort = VirtioConsolePort::new(3, FixedString::from_slice("service"))
    assert(!port3.is_open, "vcon: port 3 closed")
    port3.open()
    assert(port3.is_open, "vcon: port 3 opened")

    // Write large amount of data
    let big_data: Byte[512] = [Byte::from_u8(0xAA); 512]
    let big_written: u32 = port3.write(&big_data, 512)
    assert(big_written == 512, "vcon: big write 512 bytes")
    assert(port3.bytes_written == 512, "vcon: total bytes written 512")
    port3.flush()
    assert(port3.tx_buf_len == 0, "vcon: tx buf empty after flush")

    // Receive large amount and read
    let big_recv: Byte[256] = [Byte::from_u8(0xBB); 256]
    port3.receive_data(&big_recv, 256)
    assert(port3.has_data(), "vcon: port 3 has data")
    let mut big_read_buf: Byte[128] = [Byte::from_u8(0); 128]
    let big_read: u32 = port3.read(&mut big_read_buf, 128)
    assert(big_read == 128, "vcon: read 128 bytes from big recv")
    assert(port3.bytes_read == 128, "vcon: bytes read 128")

    residual emit {
        op: "virtio_console.tests",
        ctrl_msg: true,
        port_open: true,
        port_write: true,
        port_read: true,
        flow_ctrl: true,
        device: true,
        multi_port: true,
        ctrl_handle: true,
        emerg_write: true,
        stats: true,
        port_mgr: true,
        flow_ctrl_test: true,
        big_data: true,
    }

    true
}
