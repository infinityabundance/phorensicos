// process_tests.phor — Comprehensive process management tests
// Tests: process lifecycle, thread creation, ELF loading, signal delivery,
//        process tree management, service startup, init phases
//
// Expected outcomes:
//   - Process states transition correctly: created -> ready -> running -> exited
//   - Thread creation produces valid thread control blocks with shared address space
//   - ELF loading correctly parses headers and maps program segments
//   - Signal delivery queues signals and invokes handlers or default actions
//   - Process tree tracks parent/child relationships correctly
//   - Service startup follows dependency ordering
//   - Init phases transition through boot stages correctly
//   - All operations bounded, effect-declared, and residual-recorded

package "phorensic:process_tests:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*

// ============================================================================
// Constants
// ============================================================================

const MAX_PROCESSES: u64 = 1024;
const MAX_THREADS: u64 = 4096;
const MAX_CHILDREN: u64 = 64;
const MAX_SIGNAL_HANDLERS: u64 = 32;
const MAX_ELF_SEGMENTS: u64 = 8;
const MAX_SERVICES: u64 = 128;
const MAX_DEPENDENCIES: u64 = 16;
const STACK_SIZE: u64 = 65536;
const MAX_SIGNAL_PENDING: u64 = 64;

// ============================================================================
// Data Structures
// ============================================================================

enum ProcessState : u8 {
    Created  = 0,
    Ready    = 1,
    Running  = 2,
    Blocked  = 3,
    Sleeping = 4,
    Stopped  = 5,
    Zombie   = 6,
    Exited   = 7,
}

enum ProcessType : u8 {
    System    = 0,
    Service   = 1,
    User      = 2,
    Kernel    = 3,
    Init      = 4,
    Idle      = 5,
}

struct Process {
    pid: u64,
    ppid: u64,
    state: ProcessState,
    proc_type: ProcessType,
    uid: u32,
    gid: u32,
    priority: u8,
    thread_count: u64,
    children: Array(u64, 64),
    child_count: u64,
    start_time: u64,
    cpu_time: u64,
    memory_size: u64,
    exit_code: i32,
    name: Str(64),
}

enum ThreadState : u8 {
    Initialized = 0,
    Ready       = 1,
    Running     = 2,
    Blocked     = 3,
    Terminated  = 4,
}

struct Thread {
    tid: u64,
    pid: u64,
    state: ThreadState,
    priority: u8,
    stack_base: u64,
    stack_size: u64,
    instruction_pointer: u64,
    stack_pointer: u64,
    kernel_stack: u64,
    entry_point: u64,
    cpu_affinity: u64,
    time_slice: u64,
    total_cpu: u64,
}

enum ElfIdentClass : u8 {
    ELFCLASS32 = 1,
    ELFCLASS64 = 2,
}

enum ElfIdentData : u8 {
    ELFDATA2LSB = 1,
    ELFDATA2MSB = 2,
}

struct ElfHeader {
    ident_class: ElfIdentClass,
    ident_data: ElfIdentData,
    e_type: u16,
    e_machine: u16,
    e_version: u32,
    e_entry: u64,
    e_phoff: u64,
    e_shoff: u64,
    e_flags: u32,
    e_ehsize: u16,
    e_phentsize: u16,
    e_phnum: u16,
    e_shentsize: u16,
    e_shnum: u16,
    e_shstrndx: u16,
}

enum ElfSegmentType : u32 {
    Null    = 0,
    Load    = 1,
    Dynamic = 2,
    Interp  = 3,
    Note    = 4,
}

struct ElfProgramHeader {
    p_type: ElfSegmentType,
    p_flags: u32,
    p_offset: u64,
    p_vaddr: u64,
    p_paddr: u64,
    p_filesz: u64,
    p_memsz: u64,
    p_align: u64,
}

struct SignalAction {
    signum: u8,
    handler_addr: u64,
    flags: u32,
    mask: u64,
    sa_restorer: u64,
}

struct SignalDelivery {
    signum: u8,
    sender_pid: u64,
    timestamp: u64,
    code: i32,
    pending: bool,
    delivered: bool,
}

struct SignalState {
    pending: Array(u64, 2), // bitmask per signal
    blocked: u64,
    handlers: Array(SignalAction, 32),
    handler_count: u64,
    delivery_queue: Array(SignalDelivery, 64),
    queue_count: u64,
}

struct ServiceRecord {
    service_id: u64,
    name: Str(64),
    pid: u64,
    state: u8,
    dependencies: Array(Str(64), 16),
    dep_count: u64,
    start_order: u32,
    restart_count: u32,
    critical: bool,
}

struct InitPhase {
    phase_id: u8,
    name: Str(32),
    completed: bool,
    services_started: u64,
    total_services: u64,
}

// ============================================================================
// Process Error Types
// ============================================================================

type ProcessError : u32 = enum {
    ProcessLimitReached   = 0x5001,
    ThreadLimitReached    = 0x5002,
    InvalidPid            = 0x5003,
    InvalidTid            = 0x5004,
    ElfInvalidMagic       = 0x5005,
    ElfInvalidClass       = 0x5006,
    ElfInvalidMachine     = 0x5007,
    ElfNoLoadableSegments = 0x5008,
    SignalNotSupported    = 0x5009,
    SignalPending         = 0x500A,
    ServiceNotFound       = 0x500B,
    DependencyCycle       = 0x500C,
    InitPhaseFailed       = 0x500D,
    ExitCodeInvalid       = 0x500E,
    PermissionDenied      = 0x500F,
    ResourceNotAvailable  = 0x5010,
}

// ============================================================================
// Test: Process Lifecycle
// ============================================================================

fn test_process_create() -> void
    effect [compute, residual]
{
    let mut proc: Process = Process{
        pid: 1,
        ppid: 0,
        state: ProcessState::Created,
        proc_type: ProcessType::Init,
        uid: 0,
        gid: 0,
        priority: 10,
        thread_count: 1,
        children: Array::zeroed(),
        child_count: 0,
        start_time: 1000,
        cpu_time: 0,
        memory_size: 4096,
        exit_code: 0,
        name: Str::from("init"),
    };

    assert(proc.pid == 1, "proc: PID 1 assigned");
    assert(proc.state == ProcessState::Created, "proc: initial state Created");
    assert(proc.ppid == 0, "proc: parent PID is 0 (kernel)");
    assert(proc.proc_type == ProcessType::Init, "proc: type is Init");
    assert(proc.thread_count == 1, "proc: 1 initial thread");
    assert(proc.name == Str::from("init"), "proc: name is 'init'");

    residual emit {
        op: "process.test.create",
        pid: proc.pid,
        name: "init",
        state: ProcessState::Created as u64,
    };
}

fn test_process_state_transitions() -> void
    effect [compute, residual]
{
    let mut proc: Process = Process{
        pid: 42,
        ppid: 1,
        state: ProcessState::Created,
        proc_type: ProcessType::User,
        uid: 1000,
        gid: 1000,
        priority: 30,
        thread_count: 1,
        children: Array::zeroed(),
        child_count: 0,
        start_time: 2000,
        cpu_time: 0,
        memory_size: 16384,
        exit_code: 0,
        name: Str::from("test_app"),
    };

    // Created -> Ready (scheduler admits)
    proc.state = ProcessState::Ready;
    assert(proc.state == ProcessState::Ready, "proc: Created -> Ready");

    // Ready -> Running (scheduler dispatch)
    proc.state = ProcessState::Running;
    assert(proc.state == ProcessState::Running, "proc: Ready -> Running");

    // Running -> Blocked (I/O wait)
    proc.state = ProcessState::Blocked;
    assert(proc.state == ProcessState::Blocked, "proc: Running -> Blocked");

    // Blocked -> Ready (I/O complete)
    proc.state = ProcessState::Ready;
    assert(proc.state == ProcessState::Ready, "proc: Blocked -> Ready");

    // Ready -> Running (rescheduled)
    proc.state = ProcessState::Running;
    assert(proc.state == ProcessState::Running, "proc: Ready -> Running");

    // Running -> Zombie (exit, parent not yet waited)
    proc.state = ProcessState::Zombie;
    proc.exit_code = 0;
    assert(proc.state == ProcessState::Zombie, "proc: Running -> Zombie");
    assert(proc.exit_code == 0, "proc: exit code 0");

    // Zombie -> Exited (parent wait)
    proc.state = ProcessState::Exited;
    assert(proc.state == ProcessState::Exited, "proc: Zombie -> Exited");

    residual emit {
        op: "process.test.state_transitions",
        pid: proc.pid,
        transitions: 7,
        final_exit_code: proc.exit_code as u64,
    };
}

// ============================================================================
// Test: Thread Creation
// ============================================================================

fn test_thread_create() -> void
    effect [compute, residual]
{
    let mut thread: Thread = Thread{
        tid: 100,
        pid: 42,
        state: ThreadState::Initialized,
        priority: 30,
        stack_base: 0x7F00000000,
        stack_size: STACK_SIZE,
        instruction_pointer: 0x401000,
        stack_pointer: 0x7F0000FF00,
        kernel_stack: 0xFFFF800000000000,
        entry_point: 0x401000,
        cpu_affinity: 0x01,
        time_slice: 100,
        total_cpu: 0,
    };

    assert(thread.tid == 100, "proc: TID 100");
    assert(thread.pid == 42, "proc: thread belongs to PID 42");
    assert(thread.stack_size == STACK_SIZE, "proc: stack size 64KB");
    assert(thread.entry_point == 0x401000, "proc: entry point 0x401000");
    assert(thread.state == ThreadState::Initialized, "proc: thread initialized");

    // Thread becomes ready
    thread.state = ThreadState::Ready;
    assert(thread.state == ThreadState::Ready, "proc: thread ready");

    // Thread becomes running
    thread.state = ThreadState::Running;
    assert(thread.state == ThreadState::Running, "proc: thread running");

    // Thread terminates
    thread.state = ThreadState::Terminated;
    thread.total_cpu = 50;
    assert(thread.state == ThreadState::Terminated, "proc: thread terminated");
    assert(thread.total_cpu == 50, "proc: thread used 50ms CPU");

    residual emit {
        op: "process.test.thread_create",
        tid: thread.tid,
        pid: thread.pid,
        stack_size: thread.stack_size,
        final_cpu: thread.total_cpu,
    };
}

fn test_thread_multi() -> void
    effect [compute, residual]
{
    let mut threads: Array(Thread, 8) = Array::zeroed();
    let mut count: u64 = 0;

    // Create 4 threads in same process
    for i in 0..4 {
        threads[i] = Thread{
            tid: 200 + (i as u64),
            pid: 42,
            state: ThreadState::Initialized,
            priority: 30,
            stack_base: 0x7F01000000 + (i as u64 * STACK_SIZE),
            stack_size: STACK_SIZE,
            instruction_pointer: 0x402000,
            stack_pointer: 0x7F0100FF00 + (i as u64 * STACK_SIZE),
            kernel_stack: 0xFFFF800010000000 + (i as u64 * 4096),
            entry_point: 0x402000,
            cpu_affinity: 0x01,
            time_slice: 100,
            total_cpu: 0,
        };
        count = count + 1;
    }

    assert(count == 4, "proc: 4 threads created");
    for i in 0..4 {
        assert(threads[i].pid == 42, "proc: thread belongs to process 42");
        assert(threads[i].stack_base >= 0x7F01000000, "proc: thread stack in region");
    }

    residual emit {
        op: "process.test.thread_multi",
        thread_count: count,
        process_pid: 42,
    };
}

// ============================================================================
// Test: ELF Loading
// ============================================================================

fn test_elf_header_parse() -> void
    effect [compute, residual]
{
    // Valid ELF64 header bytes
    let mut elf_bytes: Array(u8, 64) = Array::zeroed();
    elf_bytes[0] = 0x7F; elf_bytes[1] = 'E'; elf_bytes[2] = 'L'; elf_bytes[3] = 'F'; // magic
    elf_bytes[4] = 2; // ELFCLASS64
    elf_bytes[5] = 1; // ELFDATA2LSB
    elf_bytes[6] = 1; // EV_CURRENT
    elf_bytes[7] = 0; // OS/ABI
    elf_bytes[16] = 2; // e_type = ET_EXEC
    elf_bytes[17] = 0;
    elf_bytes[18] = 0x3E; // e_machine = x86_64
    elf_bytes[19] = 0;

    // Verify magic
    let magic_ok: bool = elf_bytes[0] == 0x7F && elf_bytes[1] == 'E' &&
                         elf_bytes[2] == 'L' && elf_bytes[3] == 'F';
    assert(magic_ok, "proc: ELF magic valid");

    // Verify class
    let elf_class: u8 = elf_bytes[4];
    assert(elf_class == 2, "proc: ELF64 class");

    // Verify encoding
    let elf_data: u8 = elf_bytes[5];
    assert(elf_data == 1, "proc: little-endian");

    // Verify type
    let e_type: u16 = (elf_bytes[16] as u16) | ((elf_bytes[17] as u16) << 8);
    assert(e_type == 2, "proc: ET_EXEC");

    // Verify machine
    let e_machine: u16 = (elf_bytes[18] as u16) | ((elf_bytes[19] as u16) << 8);
    assert(e_machine == 0x3E, "proc: x86_64 machine");

    residual emit {
        op: "process.test.elf_header",
        class: elf_class as u64,
        machine: e_machine as u64,
        type_valid: true,
    };
}

fn test_elf_program_headers() -> void
    effect [compute, residual]
{
    let mut segments: Array(ElfProgramHeader, 4) = Array::zeroed();

    // Text segment: load at 0x400000, 8KB file, 8KB memory, RX
    segments[0] = ElfProgramHeader{
        p_type: ElfSegmentType::Load,
        p_flags: 5, // R+X
        p_offset: 0,
        p_vaddr: 0x400000,
        p_paddr: 0x400000,
        p_filesz: 8192,
        p_memsz: 8192,
        p_align: 4096,
    };

    // Data segment: load at 0x600000, 4KB file, 12KB memory (BSS), RW
    segments[1] = ElfProgramHeader{
        p_type: ElfSegmentType::Load,
        p_flags: 6, // R+W
        p_offset: 8192,
        p_vaddr: 0x600000,
        p_paddr: 0x600000,
        p_filesz: 4096,
        p_memsz: 12288, // includes 8KB BSS
        p_align: 4096,
    };

    // Dynamic segment
    segments[2] = ElfProgramHeader{
        p_type: ElfSegmentType::Dynamic,
        p_flags: 6,
        p_offset: 16384,
        p_vaddr: 0x700000,
        p_paddr: 0x700000,
        p_filesz: 256,
        p_memsz: 256,
        p_align: 8,
    };

    // Interpreter segment
    segments[3] = ElfProgramHeader{
        p_type: ElfSegmentType::Interp,
        p_flags: 4, // R
        p_offset: 16640,
        p_vaddr: 0x800000,
        p_paddr: 0x800000,
        p_filesz: 16,
        p_memsz: 16,
        p_align: 1,
    };

    // Verify loadable segments
    let mut loadable_count: u64 = 0;
    let mut total_load_size: u64 = 0;
    for i in 0..4 {
        if segments[i].p_type == ElfSegmentType::Load {
            loadable_count = loadable_count + 1;
            total_load_size = total_load_size + segments[i].p_memsz;
        }
    }
    assert(loadable_count == 2, "proc: 2 loadable segments");
    assert(total_load_size == 20480, "proc: total load size = 8192 + 12288 = 20480");
    assert(segments[0].p_flags == 5, "proc: text segment RX");
    assert(segments[1].p_flags == 6, "proc: data segment RW");

    // BSS check
    let bss_size: u64 = segments[1].p_memsz - segments[1].p_filesz;
    assert(bss_size == 8192, "proc: BSS section is 8192 bytes (8KB)");

    residual emit {
        op: "process.test.elf_segments",
        loadable_segments: loadable_count,
        total_memory: total_load_size,
        bss_size: bss_size,
    };
}

// ============================================================================
// Test: Signal Delivery
// ============================================================================

fn test_signal_send_receive() -> void
    effect [compute, residual]
{
    let mut sig_state: SignalState = SignalState{
        pending: Array::zeroed(),
        blocked: 0,
        handlers: Array::zeroed(),
        handler_count: 0,
        delivery_queue: Array::zeroed(),
        queue_count: 0,
    };

    // Register handler for SIGUSR1
    sig_state.handlers[0] = SignalAction{
        signum: 10, // SIGUSR1
        handler_addr: 0x401234,
        flags: 0,
        mask: 0,
        sa_restorer: 0,
    };
    sig_state.handler_count = 1;

    // Send SIGUSR1 to process
    let signum: u8 = 10;
    sig_state.delivery_queue[0] = SignalDelivery{
        signum: signum,
        sender_pid: 100,
        timestamp: 5000,
        code: 0,
        pending: true,
        delivered: false,
    };
    sig_state.queue_count = 1;
    sig_state.pending[signum / 64] = sig_state.pending[signum / 64] | (1 << (signum % 64));

    // Check signal is pending
    let is_pending: bool = (sig_state.pending[10 / 64] & (1 << (10 % 64))) != 0;
    assert(is_pending, "proc: SIGUSR1 is pending");

    // Deliver: find and invoke handler
    let mut handler_found: bool = false;
    for i in 0..sig_state.handler_count {
        if sig_state.handlers[i].signum == signum {
            handler_found = true;
        }
    }
    assert(handler_found, "proc: SIGUSR1 handler found");

    // Clear pending
    sig_state.pending[10 / 64] = sig_state.pending[10 / 64] & !(1 << (10 % 64));
    sig_state.delivery_queue[0].pending = false;
    sig_state.delivery_queue[0].delivered = true;

    is_pending = (sig_state.pending[10 / 64] & (1 << (10 % 64))) != 0;
    assert(!is_pending, "proc: signal delivered and cleared");

    residual emit {
        op: "process.test.signal_send_recv",
        signal: signum as u64,
        handler_registered: true,
        delivered: true,
    };
}

fn test_signal_default_actions() -> void
    effect [compute, residual]
{
    // SIGKILL (9) and SIGSTOP (19) cannot be caught/blocked
    let sigkill: u8 = 9;
    let sigstop: u8 = 19;
    let sigusr1: u8 = 10;

    let cannot_catch: bool = sigkill == 9 || sigstop == 19;
    assert(cannot_catch, "proc: SIGKILL and SIGSTOP uncatchable");

    // Default actions
    let mut action_str: Str(32) = Str::from("");
    match sigusr1 {
        9 => { action_str = Str::from("terminate"); },
        10 => { action_str = Str::from("terminate"); },
        19 => { action_str = Str::from("stop"); },
        _ => { action_str = Str::from("ignore"); },
    };
    assert(action_str == Str::from("terminate"), "proc: SIGUSR1 default = terminate");

    residual emit {
        op: "process.test.signal_defaults",
        sigkill_uncatchable: true,
        sigusr1_default: "terminate",
    };
}

// ============================================================================
// Test: Process Tree Management
// ============================================================================

fn test_process_tree() -> void
    effect [compute, residual]
{
    // Root: PID 1 (init)
    let mut init: Process = Process{
        pid: 1, ppid: 0, state: ProcessState::Running,
        proc_type: ProcessType::Init, uid: 0, gid: 0, priority: 5,
        thread_count: 2, children: Array::zeroed(), child_count: 0,
        start_time: 0, cpu_time: 0, memory_size: 32768, exit_code: 0,
        name: Str::from("init"),
    };

    // Fork PID 100 (child of init)
    init.children[0] = 100;
    init.child_count = 1;

    let mut proc_a: Process = Process{
        pid: 100, ppid: 1, state: ProcessState::Running,
        proc_type: ProcessType::Service, uid: 0, gid: 0, priority: 10,
        thread_count: 1, children: Array::zeroed(), child_count: 0,
        start_time: 100, cpu_time: 10, memory_size: 8192, exit_code: 0,
        name: Str::from("service_a"),
    };

    // Fork PID 101 (also child of init)
    init.children[1] = 101;
    init.child_count = 2;

    let proc_b: Process = Process{
        pid: 101, ppid: 1, state: ProcessState::Running,
        proc_type: ProcessType::Service, uid: 0, gid: 0, priority: 10,
        thread_count: 1, children: Array::zeroed(), child_count: 0,
        start_time: 101, cpu_time: 5, memory_size: 4096, exit_code: 0,
        name: Str::from("service_b"),
    };

    // proc_a forks PID 200 (grandchild)
    proc_a.children[0] = 200;
    proc_a.child_count = 1;

    assert(init.pid == 1, "proc: init PID 1");
    assert(init.child_count == 2, "proc: init has 2 children");
    assert(proc_a.ppid == 1, "proc: proc_a parent is init");
    assert(proc_b.ppid == 1, "proc: proc_b parent is init");
    assert(proc_a.child_count == 1, "proc: proc_a has 1 child");

    // Process tree depth
    let init_depth: u64 = 0;
    let proc_a_depth: u64 = 1;
    let grandchild_depth: u64 = 2;
    assert(proc_a_depth == 1, "proc: proc_a at depth 1");
    assert(grandchild_depth == 2, "proc: grandchild at depth 2");

    residual emit {
        op: "process.test.tree",
        root_pid: init.pid,
        total_processes: 4,
        tree_depth: 2,
        init_children: init.child_count,
    };
}

fn test_process_orphan_reparent() -> void
    effect [compute, residual]
{
    let mut init: Process = Process{
        pid: 1, ppid: 0, state: ProcessState::Running,
        proc_type: ProcessType::Init, uid: 0, gid: 0, priority: 5,
        thread_count: 1, children: Array::zeroed(), child_count: 0,
        start_time: 0, cpu_time: 0, memory_size: 16384, exit_code: 0,
        name: Str::from("init"),
    };

    let mut parent: Process = Process{
        pid: 50, ppid: 1, state: ProcessState::Zombie,
        proc_type: ProcessType::User, uid: 1000, gid: 1000, priority: 20,
        thread_count: 1, children: Array::zeroed(), child_count: 0,
        start_time: 500, cpu_time: 100, memory_size: 8192, exit_code: 0,
        name: Str::from("parent"),
    };

    let mut child: Process = Process{
        pid: 51, ppid: 50, state: ProcessState::Running,
        proc_type: ProcessType::User, uid: 1000, gid: 1000, priority: 20,
        thread_count: 1, children: Array::zeroed(), child_count: 0,
        start_time: 600, cpu_time: 50, memory_size: 4096, exit_code: 0,
        name: Str::from("child"),
    };

    // Parent exits, child should be reparented to init
    parent.state = ProcessState::Exited;
    assert(parent.state == ProcessState::Exited, "proc: parent exited");

    // Reparent to init
    child.ppid = 1;
    init.children[init.child_count] = child.pid;
    init.child_count = init.child_count + 1;

    assert(child.ppid == 1, "proc: orphan reparented to init");
    assert(init.child_count == 1, "proc: init adopted orphan");

    residual emit {
        op: "process.test.orphan_reparent",
        orphan_pid: child.pid,
        new_parent_pid: init.pid,
        reparented: true,
    };
}

// ============================================================================
// Test: Service Startup
// ============================================================================

fn test_service_startup_order() -> void
    effect [compute, residual]
{
    let mut services: Array(ServiceRecord, 4) = Array::zeroed();

    // Service 1: root dependency
    services[0] = ServiceRecord{
        service_id: 1, name: Str::from("driver.core"), pid: 0,
        state: 0, dependencies: Array::zeroed(), dep_count: 0,
        start_order: 1, restart_count: 0, critical: true,
    };

    // Service 2: depends on service 1
    let mut deps2: Array(Str(64), 1) = Array::zeroed();
    deps2[0] = Str::from("driver.core");
    services[1] = ServiceRecord{
        service_id: 2, name: Str::from("filesystem"), pid: 0,
        state: 0, dependencies: deps2, dep_count: 1,
        start_order: 2, restart_count: 0, critical: true,
    };

    // Service 3: depends on service 1,2
    let mut deps3: Array(Str(64), 2) = Array::zeroed();
    deps3[0] = Str::from("driver.core");
    deps3[1] = Str::from("filesystem");
    services[2] = ServiceRecord{
        service_id: 3, name: Str::from("network"), pid: 0,
        state: 0, dependencies: deps3, dep_count: 2,
        start_order: 3, restart_count: 0, critical: false,
    };

    // Service 4: depends on service 1,3
    let mut deps4: Array(Str(64), 2) = Array::zeroed();
    deps4[0] = Str::from("driver.core");
    deps4[1] = Str::from("network");
    services[3] = ServiceRecord{
        service_id: 4, name: Str::from("http_server"), pid: 0,
        state: 0, dependencies: deps4, dep_count: 2,
        start_order: 4, restart_count: 0, critical: false,
    };

    // Verify dependency ordering
    assert(services[0].start_order < services[1].start_order, "proc: core before filesystem");
    assert(services[1].start_order < services[2].start_order, "proc: filesystem before network");
    assert(services[2].start_order < services[3].start_order, "proc: network before http");

    // Verify dependencies resolved
    let mut deps_ok: bool = true;
    for i in 0..4 {
        if services[i].dep_count > 0 {
            // Check each dependency has lower start_order
            for j in 0..services[i].dep_count {
                let dep_name: Str(64) = services[i].dependencies[j];
                // Simple check: find the dependency
            }
        }
    }
    assert(deps_ok, "proc: service dependency order valid");

    residual emit {
        op: "process.test.service_startup",
        services_defined: 4,
        critical_count: 2,
        dependency_ordering: true,
    };
}

// ============================================================================
// Test: Init Phases
// ============================================================================

fn test_init_phases() -> void
    effect [compute, residual]
{
    let mut phases: Array(InitPhase, 6) = Array::zeroed();

    phases[0] = InitPhase{ phase_id: 0, name: Str::from("bootloader"), completed: false, services_started: 1, total_services: 1 };
    phases[1] = InitPhase{ phase_id: 1, name: Str::from("early_init"), completed: false, services_started: 2, total_services: 2 };
    phases[2] = InitPhase{ phase_id: 2, name: Str::from("core_services"), completed: false, services_started: 3, total_services: 5 };
    phases[3] = InitPhase{ phase_id: 3, name: Str::from("device_discovery"), completed: false, services_started: 2, total_services: 8 };
    phases[4] = InitPhase{ phase_id: 4, name: Str::from("system_services"), completed: false, services_started: 4, total_services: 12 };
    phases[5] = InitPhase{ phase_id: 5, name: Str::from("userland"), completed: false, services_started: 0, total_services: 0 };

    // Execute bootloader phase
    phases[0].completed = true;
    assert(phases[0].completed, "proc: bootloader phase complete");

    // Execute early_init phase
    phases[1].completed = true;
    assert(phases[1].completed, "proc: early_init phase complete");

    // Execute core_services phase
    phases[2].completed = true;
    assert(phases[2].completed, "proc: core_services phase complete");
    assert(phases[2].services_started == 3, "proc: 3 services started in core phase");

    // Verify phase ordering
    let mut ordered: bool = true;
    for i in 1..6 {
        if phases[i].phase_id < phases[i - 1].phase_id {
            ordered = false;
        }
    }
    assert(ordered, "proc: init phases in order");

    // Overall progress
    let mut total_completed: u64 = 0;
    for i in 0..6 {
        if phases[i].completed {
            total_completed = total_completed + 1;
        }
    }
    assert(total_completed == 3, "proc: 3 of 6 init phases completed");

    residual emit {
        op: "process.test.init_phases",
        total_phases: 6,
        completed_phases: total_completed,
        last_phase: "core_services",
    };
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, ProcessError)
    effects: [compute, io:write, residual]
{
    console.write_line("Process Management Tests")!;
    console.write_line("========================")!;

    // Process lifecycle tests
    test_process_create();
    console.write_line("  [PASS] Process create")!;
    test_process_state_transitions();
    console.write_line("  [PASS] Process state transitions")!;

    // Thread tests
    test_thread_create();
    console.write_line("  [PASS] Thread create")!;
    test_thread_multi();
    console.write_line("  [PASS] Thread multi")!;

    // ELF loading tests
    test_elf_header_parse();
    console.write_line("  [PASS] ELF header parse")!;
    test_elf_program_headers();
    console.write_line("  [PASS] ELF program headers")!;

    // Signal tests
    test_signal_send_receive();
    console.write_line("  [PASS] Signal send/receive")!;
    test_signal_default_actions();
    console.write_line("  [PASS] Signal default actions")!;

    // Process tree tests
    test_process_tree();
    console.write_line("  [PASS] Process tree")!;
    test_process_orphan_reparent();
    console.write_line("  [PASS] Process orphan reparent")!;

    // Service startup tests
    test_service_startup_order();
    console.write_line("  [PASS] Service startup order")!;

    // Init phase tests
    test_init_phases();
    console.write_line("  [PASS] Init phases")!;

    residual emit {
        op: "process_tests.complete",
        lifecycle_tests: 2,
        thread_tests: 2,
        elf_tests: 2,
        signal_tests: 2,
        tree_tests: 2,
        service_tests: 1,
        init_tests: 1,
        total_tests: 12,
        result: "all_passed",
    };

    console.write_line("")!;
    console.write_line("All 12 process tests passed!")!;
    return Ok(void);
}
