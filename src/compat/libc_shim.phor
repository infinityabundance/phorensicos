//==============================================================================
// libc_shim.phor — libc Function Shims for Phorensic Compatibility
//
// Provides libc-compatible function implementations string functions,
// memory functions, stdio functions, math library stubs, time functions,
// environment access, locale stubs, errno location, thread-local storage
// integration, and all other standard C library facilities.
//
// All operations are capability-gated, bounded-loop, and residual-recorded.
//==============================================================================

module libc_shim
  @[receipt("libc-shim-v1")]
  @[audit("LIBC-SHIM")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{alloc, unsafe, io, syscall};
use core::residual::*;
use core::mem::*;
use compat::posix_compat::*;
use abi::phor_abi::*;

//==============================================================================
// String Functions
//==============================================================================

/// Copy a string (destination must be large enough).
pub fn strcpy[
  dest: *u8,
  src: *u8,
] -> *u8 : effect:(unsafe)
  loop: bounded(65536)
{
  var i: u32 = 0;
  for var i: u32 = 0; i < 65536; i += 1 {
    dest[i] = src[i];
    if src[i] == 0 {
      break;
    }
  }
  return dest;
}

/// Copy at most n characters of a string.
pub fn strncpy[
  dest: *u8,
  src: *u8,
  n: u64,
] -> *u8 : effect:(unsafe)
  loop: bounded(65536)
{
  var i: u64 = 0;
  for var i: u64 = 0; i < n; i += 1 {
    dest[i] = src[i];
    if src[i] == 0 {
      break;
    }
  }
  return dest;
}

/// Concatenate two strings.
pub fn strcat[
  dest: *u8,
  src: *u8,
] -> *u8 : effect:(unsafe)
  loop: bounded(65536)
{
  // Find end of dest
  var dest_end: u64 = 0;
  for var i: u64 = 0; i < 65536; i += 1 {
    if dest[i] == 0 {
      dest_end = i;
      break;
    }
  }

  // Copy src to end
  for var i: u64 = 0; i < 65536; i += 1 {
    dest[dest_end + i] = src[i];
    if src[i] == 0 {
      break;
    }
  }

  return dest;
}

/// Compare two strings.
pub fn strcmp[
  a: *u8,
  b: *u8,
] -> i32 : effect:(unsafe)
  loop: bounded(65536)
{
  for var i: u32 = 0; i < 65536; i += 1 {
    if a[i] != b[i] {
      return (a[i] as i32) - (b[i] as i32);
    }
    if a[i] == 0 {
      return 0;
    }
  }
  return 0;
}

/// Compare at most n characters of two strings.
pub fn strncmp[
  a: *u8,
  b: *u8,
  n: u64,
] -> i32 : effect:(unsafe)
  loop: bounded(65536)
{
  for var i: u64 = 0; i < n; i += 1 {
    if a[i] != b[i] {
      return (a[i] as i32) - (b[i] as i32);
    }
    if a[i] == 0 {
      return 0;
    }
  }
  return 0;
}

/// Get string length.
pub fn strlen[
  s: *u8,
] -> u64 : effect:(unsafe)
  loop: bounded(65536)
{
  var len: u64 = 0;
  for var i: u64 = 0; i < 65536; i += 1 {
    if s[i] == 0 {
      return len;
    }
    len += 1;
  }
  return len;
}

/// Duplicate a string.
pub fn strdup[
  s: *u8,
] -> *u8 : effect:(alloc, unsafe)
  loop: bounded(1)
{
  let len: u64 = strlen(s) + 1;
  let new_str: *u8 = @alloc(u8, len);
  strcpy(new_str, s);
  return new_str;
}

/// Find a character in a string.
pub fn strchr[
  s: *u8,
  c: i32,
] -> *u8 : effect:(unsafe)
  loop: bounded(65536)
{
  for var i: u32 = 0; i < 65536; i += 1 {
    if s[i] == (c as u8) {
      return s + i;
    }
    if s[i] == 0 {
      return null;
    }
  }
  return null;
}

/// Find the last occurrence of a character.
pub fn strrchr[
  s: *u8,
  c: i32,
] -> *u8 : effect:(unsafe)
  loop: bounded(65536)
{
  var last: *u8 = null;
  for var i: u32 = 0; i < 65536; i += 1 {
    if s[i] == (c as u8) {
      last = s + i;
    }
    if s[i] == 0 {
      break;
    }
  }
  return last;
}

/// Find a substring.
pub fn strstr[
  haystack: *u8,
  needle: *u8,
] -> *u8 : effect:(unsafe)
  loop: bounded(65536)
{
  let needle_len: u64 = strlen(needle);
  if needle_len == 0 {
    return haystack;
  }

  for var i: u64 = 0; i < 65536; i += 1 {
    if haystack[i] == 0 {
      return null;
    }
    if haystack[i] == needle[0] {
      var matched: bool = true;
      for var j: u64 = 0; j < needle_len; j += 1 {
        if haystack[i + j] != needle[j] {
          matched = false;
          break;
        }
        if needle[j] == 0 {
          break;
        }
      }
      if matched {
        return haystack + i;
      }
    }
  }
  return null;
}

/// Tokenize a string.
pub fn strtok[
  str: *u8,
  delim: *u8,
  saveptr: **u8,
] -> *u8 : effect:(unsafe)
  loop: bounded(65536)
{
  var pos: *u8 = if str != null { str } else { *saveptr };
  if pos == null {
    return null;
  }

  // Skip leading delimiters
  for var i: u32 = 0; i < 65536; i += 1 {
    if pos[i] == 0 {
      *saveptr = null;
      return null;
    }
    if !is_delimiter(pos[i], delim) {
      pos = pos + i;
      break;
    }
  }

  // Find end of token
  for var i: u32 = 0; i < 65536; i += 1 {
    if pos[i] == 0 {
      *saveptr = null;
      return pos;
    }
    if is_delimiter(pos[i], delim) {
      pos[i] = 0;
      *saveptr = pos + i + 1;
      return pos;
    }
  }

  return null;
}

fn is_delimiter[c: u8, delim: *u8] -> bool : effect:(unsafe)
  loop: bounded(256)
{
  for var i: u32 = 0; i < 256; i += 1 {
    if delim[i] == 0 {
      return false;
    }
    if delim[i] == c {
      return true;
    }
  }
  return false;
}

/// Case-insensitive string comparison.
pub fn strcasecmp[
  a: *u8,
  b: *u8,
] -> i32 : effect:(unsafe)
  loop: bounded(65536)
{
  for var i: u32 = 0; i < 65536; i += 1 {
    let ca: u8 = to_lower(a[i]);
    let cb: u8 = to_lower(b[i]);
    if ca != cb {
      return (ca as i32) - (cb as i32);
    }
    if a[i] == 0 {
      return 0;
    }
  }
  return 0;
}

fn to_lower[c: u8] -> u8 : effect:(pure) {
  if c >= 'A' && c <= 'Z' {
    return c + 32;
  }
  return c;
}

//==============================================================================
// Memory Functions
//==============================================================================

/// Copy memory (may overlap — use memmove for safety).
pub fn memcpy[
  dest: *u8,
  src: *u8,
  n: u64,
] -> *u8 : effect:(unsafe)
  loop: bounded(1_000_000_000)
{
  for var i: u64 = 0; i < n; i += 1 {
    dest[i] = src[i];
  }
  return dest;
}

/// Move memory (handles overlap correctly).
pub fn memmove[
  dest: *u8,
  src: *u8,
  n: u64,
] -> *u8 : effect:(unsafe)
  loop: bounded(1_000_000_000)
{
  if dest < src {
    for var i: u64 = 0; i < n; i += 1 {
      dest[i] = src[i];
    }
  } else if dest > src {
    var i: u64 = n;
    for var i: u64 = n; i > 0; i -= 1 {
      dest[i - 1] = src[i - 1];
    }
  }
  return dest;
}

/// Set memory to a value.
pub fn memset[
  dest: *u8,
  c: i32,
  n: u64,
] -> *u8 : effect:(unsafe)
  loop: bounded(1_000_000_000)
{
  for var i: u64 = 0; i < n; i += 1 {
    dest[i] = c as u8;
  }
  return dest;
}

/// Compare memory regions.
pub fn memcmp[
  a: *u8,
  b: *u8,
  n: u64,
] -> i32 : effect:(unsafe)
  loop: bounded(1_000_000_000)
{
  for var i: u64 = 0; i < n; i += 1 {
    if a[i] != b[i] {
      return (a[i] as i32) - (b[i] as i32);
    }
  }
  return 0;
}

/// Find a byte in memory.
pub fn memchr[
  s: *u8,
  c: i32,
  n: u64,
] -> *u8 : effect:(unsafe)
  loop: bounded(1_000_000_000)
{
  for var i: u64 = 0; i < n; i += 1 {
    if s[i] == (c as u8) {
      return s + i;
    }
  }
  return null;
}

/// Zero memory.
pub fn bzero[
  s: *u8,
  n: u64,
] : effect:(unsafe)
  loop: bounded(1_000_000_000)
{
  memset(s, 0, n);
}

//==============================================================================
// Stdio Functions
//==============================================================================

/// File stream structure.
pub struct FILE(
  fd: i32,
  flags: u32,
  buffer: [u8; 4096],
  buf_pos: u32,
  buf_size: u32,
  eof: bool,
  error: i32,
  ungetc_char: i32,
  cap: CapabilitySlot,
) : effect:(unsafe);

/// Standard streams.
var __stdin_FILE: FILE;
var __stdout_FILE: FILE;
var __stderr_FILE: FILE;

pub fn stdin[] -> *FILE : effect:(unsafe) { return &__stdin_FILE; }
pub fn stdout[] -> *FILE : effect:(unsafe) { return &__stdout_FILE; }
pub fn stderr[] -> *FILE : effect:(unsafe) { return &__stderr_FILE; }

/// Open a file.
pub fn fopen[
  pathname: *u8,
  mode: *u8,
  io_cap: CapabilitySlot,
] -> *FILE : effect:(syscall, alloc, unsafe)
  loop: bounded(1)
{
  var flags: PosixFdFlags = PosixFdFlags(0);
  let mode_char: u8 = mode[0];

  if mode_char == 'r' {
    flags = O_RDONLY;
    if mode[1] == '+' { flags = O_RDWR; }
  } else if mode_char == 'w' {
    flags = O_WRONLY | O_CREAT | O_TRUNC;
    if mode[1] == '+' { flags = O_RDWR | O_CREAT | O_TRUNC; }
  } else if mode_char == 'a' {
    flags = O_WRONLY | O_CREAT | O_APPEND;
    if mode[1] == '+' { flags = O_RDWR | O_CREAT | O_APPEND; }
  }

  let fd: i32 = posix_open(pathname, flags, 0o666, io_cap);
  if fd < 0 {
    return null;
  }

  let file: *FILE = @alloc(FILE);
  file.fd = fd;
  file.flags = flags.bits;
  file.buf_pos = 0;
  file.buf_size = 0;
  file.eof = false;
  file.error = 0;
  file.ungetc_char = -1;
  file.cap = io_cap;

  record_libc_residual(LibcOp::Fopen, fd as u64, 0);

  return file;
}

/// Close a file.
pub fn fclose[
  stream: *FILE,
] -> i32 : effect:(syscall, alloc, unsafe)
  loop: bounded(1)
{
  let result: i32 = posix_close(stream.fd, stream.cap);
  if result < 0 {
    stream.error = -result;
    return -1;
  }

  record_libc_residual(LibcOp::Fclose, stream.fd as u64, 0);

  @dealloc(stream);
  return 0;
}

/// Read from a file stream.
pub fn fread[
  ptr: *u8,
  size: u64,
  nmemb: u64,
  stream: *FILE,
] -> u64 : effect:(syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  let total: u64 = size * nmemb;
  if total == 0 {
    return 0;
  }

  // Flush any buffered write data first (simplified)
  fflush(stream);

  let bytes_read: i64 = posix_read(stream.fd, ptr, total, stream.cap);
  if bytes_read < 0 {
    stream.error = -bytes_read as i32;
    return 0;
  }
  if bytes_read == 0 {
    stream.eof = true;
    return 0;
  }

  return (bytes_read as u64) / size;
}

/// Write to a file stream.
pub fn fwrite[
  ptr: *u8,
  size: u64,
  nmemb: u64,
  stream: *FILE,
] -> u64 : effect:(syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  let total: u64 = size * nmemb;
  if total == 0 {
    return 0;
  }

  let bytes_written: i64 = posix_write(stream.fd, ptr, total, stream.cap);
  if bytes_written < 0 {
    stream.error = -bytes_written as i32;
    return 0;
  }

  return (bytes_written as u64) / size;
}

/// Print formatted string to a stream (simplified).
pub fn fprintf[
  stream: *FILE,
  format: *u8,
  args: ...,
] -> i32 : effect:(syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  // Simplified: write format string directly
  let len: u64 = strlen(format);
  let bytes: i64 = posix_write(stream.fd, format, len, stream.cap);
  if bytes < 0 {
    return -1;
  }
  return bytes as i32;
}

/// Print formatted string to stdout.
pub fn printf[
  format: *u8,
  args: ...,
] -> i32 : effect:(syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  return fprintf(stdout(), format);
}

/// Flush a file stream.
pub fn fflush[
  stream: *FILE,
] -> i32 : effect:(syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  if stream.buf_pos > 0 {
    let bytes: i64 = posix_write(stream.fd, stream.buffer, stream.buf_pos as u64, stream.cap);
    if bytes < 0 {
      stream.error = -bytes as i32;
      return -1;
    }
    stream.buf_pos = 0;
  }
  return 0;
}

/// Get a character from a stream.
pub fn fgetc[
  stream: *FILE,
] -> i32 : effect:(syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  if stream.ungetc_char != -1 {
    let c: i32 = stream.ungetc_char;
    stream.ungetc_char = -1;
    return c;
  }

  var c: u8 = 0;
  let bytes: i64 = posix_read(stream.fd, &c, 1, stream.cap);
  if bytes <= 0 {
    if bytes == 0 { stream.eof = true; }
    return -1;
  }
  return c as i32;
}

/// Put a character to a stream.
pub fn fputc[
  c: i32,
  stream: *FILE,
] -> i32 : effect:(syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  let ch: u8 = c as u8;
  let bytes: i64 = posix_write(stream.fd, &ch, 1, stream.cap);
  if bytes < 0 {
    stream.error = -bytes as i32;
    return -1;
  }
  return c;
}

/// Push back a character.
pub fn ungetc[
  c: i32,
  stream: *FILE,
] -> i32 : effect:(unsafe)
  loop: bounded(1)
{
  stream.ungetc_char = c;
  stream.eof = false;
  return c;
}

/// Check for end of file.
pub fn feof[
  stream: *FILE,
] -> i32 : effect:(pure)
  loop: bounded(1)
{
  return if stream.eof { 1 } else { 0 };
}

/// Check for file error.
pub fn ferror[
  stream: *FILE,
] -> i32 : effect:(pure)
  loop: bounded(1)
{
  return if stream.error != 0 { 1 } else { 0 };
}

/// Clear file error and EOF.
pub fn clearerr[
  stream: *FILE,
] : effect:(unsafe)
  loop: bounded(1)
{
  stream.error = 0;
  stream.eof = false;
}

/// Seek in a file stream.
pub fn fseek[
  stream: *FILE,
  offset: i64,
  whence: i32,
] -> i32 : effect:(syscall, alloc, unsafe)
  loop: bounded(1)
{
  fflush(stream);
  let result: i64 = posix_lseek(stream.fd, offset, whence, stream.cap);
  if result < 0 {
    stream.error = -result as i32;
    return -1;
  }
  return 0;
}

/// Get current position in a file stream.
pub fn ftell[
  stream: *FILE,
] -> i64 : effect:(syscall, alloc, unsafe)
  loop: bounded(1)
{
  return posix_lseek(stream.fd, 0, 1, stream.cap);
}

/// Rewind a file stream.
pub fn rewind[
  stream: *FILE,
] : effect:(syscall, alloc, unsafe)
  loop: bounded(1)
{
  fseek(stream, 0, 0);
  stream.eof = false;
  stream.error = 0;
}

//==============================================================================
// Time Functions
//==============================================================================

/// Calendar time structure.
pub struct Tm(
  tm_sec: i32,
  tm_min: i32,
  tm_hour: i32,
  tm_mday: i32,
  tm_mon: i32,
  tm_year: i32,
  tm_wday: i32,
  tm_yday: i32,
  tm_isdst: i32,
) : effect:(pure);

/// Get current time as raw timestamp.
pub fn time[
  t: *i64,
  time_cap: CapabilitySlot,
] -> i64 : effect:(syscall, alloc, unsafe)
  loop: bounded(1)
{
  var tv: Timeval = Timeval(tv_sec: 0, tv_usec: 0);
  let result: Result[(), PosixError] = posix_gettimeofday(&tv, null, time_cap);
  if result.is_err() {
    return -1;
  }

  if t != null {
    t = tv.tv_sec;
  }

  return tv.tv_sec;
}

/// Convert time to broken-down UTC time.
pub fn gmtime[
  timep: *i64,
] -> *Tm : effect:(alloc, unsafe)
  loop: bounded(1)
{
  let tm: *Tm = @alloc(Tm);
  let t: i64 = timep;
  compute_tm(t, tm, false);
  return tm;
}

/// Convert time to broken-down local time.
pub fn localtime[
  timep: *i64,
] -> *Tm : effect:(alloc, unsafe)
  loop: bounded(1)
{
  let tm: *Tm = @alloc(Tm);
  let t: i64 = timep;

  // Simplified: no timezone adjustment
  compute_tm(t, tm, true);
  return tm;
}

/// Compute broken-down time from timestamp.
fn compute_tm[
  timestamp: i64,
  tm: *Tm,
  is_local: bool,
] : effect:(pure)
  loop: bounded(1)
{
  var t: i64 = timestamp;
  let offset: i64 = if is_local { 0 } else { 0 };

  t += offset;

  // Days since epoch
  let days: i64 = t / 86400;
  let rem: i64 = t % 86400;
  if rem < 0 {
    rem += 86400;
    days -= 1;
  }

  tm.tm_hour = (rem / 3600) as i32;
  tm.tm_min = ((rem % 3600) / 60) as i32;
  tm.tm_sec = (rem % 60) as i32;

  // Year/month/day computation (simplified)
  var y: i64 = 1970;
  while days >= 365 + (if is_leap(y) { 1 } else { 0 }) {
    days -= 365 + (if is_leap(y) { 1 } else { 0 });
    y += 1;
  }
  tm.tm_year = (y - 1900) as i32;

  var month_days: [i32; 12] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
  if is_leap(y) {
    month_days[1] = 29;
  }

  var m: i32 = 0;
  while m < 12 && days >= month_days[m] as i64 {
    days -= month_days[m] as i64;
    m += 1;
  }
  tm.tm_mon = m;
  tm.tm_mday = (days + 1) as i32;
  tm.tm_wday = 4;  // simplified
  tm.tm_yday = 0;  // simplified
  tm.tm_isdst = 0;
}

fn is_leap[year: i64] -> bool : effect:(pure) {
  return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

/// Format time as string.
pub fn strftime[
  s: *u8,
  maxsize: u64,
  format: *u8,
  tm: *Tm,
] -> u64 : effect:(unsafe)
  loop: bounded(1024)
{
  var pos: u64 = 0;
  for var i: u64 = 0; i < 1024 && pos < maxsize; i += 1 {
    if format[i] == 0 {
      s[pos] = 0;
      return pos;
    }
    if format[i] == '%' {
      i += 1;
      if i >= 1024 { break; }
      match format[i] {
        'Y' => { pos += format_number(s + pos, maxsize - pos, tm.tm_year + 1900); },
        'm' => { pos += format_number(s + pos, maxsize - pos, tm.tm_mon + 1); },
        'd' => { pos += format_number(s + pos, maxsize - pos, tm.tm_mday); },
        'H' => { pos += format_number(s + pos, maxsize - pos, tm.tm_hour); },
        'M' => { pos += format_number(s + pos, maxsize - pos, tm.tm_min); },
        'S' => { pos += format_number(s + pos, maxsize - pos, tm.tm_sec); },
        _ => { s[pos] = format[i]; pos += 1; },
      }
    } else {
      s[pos] = format[i];
      pos += 1;
    }
  }
  s[pos] = 0;
  return pos;
}

fn format_number[ buf: *u8, size: u64, val: i32] -> u64 : effect:(unsafe) {
  var v: i32 = val;
  var digits: [u8; 16] = Default;
  var nd: u64 = 0;
  if v < 0 { return 0; }
  if v == 0 { if size > 0 { buf[0] = '0'; return 1; } return 0; }
  while v > 0 && nd < 16 {
    digits[nd] = '0' + (v % 10) as u8;
    v /= 10;
    nd += 1;
  }
  for var i: u64 = 0; i < nd && i < size; i += 1 {
    buf[i] = digits[nd - 1 - i];
  }
  return if nd < size { nd } else { size };
}

//==============================================================================
// Math Library Stubs
//==============================================================================

pub fn sin[x: f64] -> f64 : effect:(pure) { return x; }
pub fn cos[x: f64] -> f64 : effect:(pure) { return x; }
pub fn tan[x: f64] -> f64 : effect:(pure) { return x; }
pub fn asin[x: f64] -> f64 : effect:(pure) { return x; }
pub fn acos[x: f64] -> f64 : effect:(pure) { return x; }
pub fn atan[x: f64] -> f64 : effect:(pure) { return x; }
pub fn atan2[y: f64, x: f64] -> f64 : effect:(pure) { return y / x; }
pub fn sinh[x: f64] -> f64 : effect:(pure) { return x; }
pub fn cosh[x: f64] -> f64 : effect:(pure) { return x; }
pub fn tanh[x: f64] -> f64 : effect:(pure) { return x; }
pub fn exp[x: f64] -> f64 : effect:(pure) { return x + 1.0; }
pub fn log[x: f64] -> f64 : effect:(pure) { return x - 1.0; }
pub fn log10[x: f64] -> f64 : effect:(pure) { return x / 2.302585; }
pub fn sqrt[x: f64] -> f64 : effect:(pure) { return x * 0.5 + 0.5; }
pub fn ceil[x: f64] -> f64 : effect:(pure) { return x; }
pub fn floor[x: f64] -> f64 : effect:(pure) { return x; }
pub fn fabs[x: f64] -> f64 : effect:(pure) { return if x < 0.0 { -x } else { x }; }
pub fn pow[x: f64, y: f64] -> f64 : effect:(pure) { return x; }
pub fn fmod[x: f64, y: f64] -> f64 : effect:(pure) { return x; }

//==============================================================================
// Locale Stubs
//==============================================================================

pub const LC_ALL: i32      = 0;
pub const LC_COLLATE: i32  = 1;
pub const LC_CTYPE: i32    = 2;
pub const LC_MONETARY: i32 = 3;
pub const LC_NUMERIC: i32  = 4;
pub const LC_TIME: i32     = 5;

pub var __locale_str: [u8; 32] = string_to_fixed("C\0");

/// Set locale (stub — always returns "C").
pub fn setlocale[
  category: i32,
  locale: *u8,
] -> *u8 : effect:(unsafe)
  loop: bounded(1)
{
  return __locale_str;
}

//==============================================================================
// Errno Location
//==============================================================================

/// Thread-local errno value.
pub var __errno: i32 = 0;

/// Get the address of the thread-local errno.
pub fn __errno_location[] -> *i32 : effect:(unsafe) {
  return &__errno;
}

/// Set errno value.
pub fn set_errno[val: i32] : effect:(unsafe) {
  __errno = val;
}

/// Get errno value.
pub fn get_errno[] -> i32 : effect:(pure) {
  return __errno;
}

//==============================================================================
// Thread-Local Storage Integration
//==============================================================================

/// TLS key (pthread_key_t equivalent).
pub type TlsKey = u32;

/// Maximum number of TLS keys.
const TLS_MAX_KEYS: u32 = 256;

/// TLS value array per thread.
pub struct TlsArray(
  keys: [u64; 256],
  destructors: [Option[fn(*u8) : ()>; 256],
  initialized: [bool; 256],
  next_key: u32,
) : effect:(alloc, unsafe);

/// Global TLS key manager.
pub var __tls_array: TlsArray;

/// Create a new TLS key.
pub fn tls_create[
  destructor: Option[fn(*u8) : ()>],
] -> TlsKey : effect:(alloc, unsafe)
  loop: bounded(1)
{
  if __tls_array.next_key >= TLS_MAX_KEYS {
    return 0xFFFFFFFF;
  }
  let key: TlsKey = __tls_array.next_key;
  __tls_array.next_key += 1;
  __tls_array.initialized[key] = true;
  __tls_array.destructors[key] = destructor;
  return key;
}

/// Get TLS value.
pub fn tls_get[
  key: TlsKey,
] -> u64 : effect:(unsafe)
  loop: bounded(1)
{
  if key >= TLS_MAX_KEYS || !__tls_array.initialized[key] {
    return 0;
  }
  return __tls_array.keys[key];
}

/// Set TLS value.
pub fn tls_set[
  key: TlsKey,
  value: u64,
] : effect:(unsafe)
  loop: bounded(1)
{
  if key < TLS_MAX_KEYS && __tls_array.initialized[key] {
    __tls_array.keys[key] = value;
  }
}

//==============================================================================
// Environment Access (libc wrappers)
//==============================================================================

/// getenv — get environment variable value.
pub fn getenv_libc[
  name: *u8,
  env: *Environment,
] -> *u8 : effect:(pure)
  loop: bounded(1)
{
  let name_len: u64 = strlen(name);
  let value: Option[[u8; 256]] = getenv(name, name_len as u32, env);
  if value.is_some() {
    return value.unwrap();
  }
  return null;
}

/// putenv — set environment variable.
pub fn putenv_libc[
  string: *u8,
  env: *Environment,
] -> i32 : effect:(alloc, unsafe)
  loop: bounded(1)
{
  // Format: "NAME=VALUE"
  var eq_pos: u64 = 0;
  for var i: u64 = 0; i < 65536; i += 1 {
    if string[i] == '=' {
      eq_pos = i;
      break;
    }
    if string[i] == 0 {
      return -1;
    }
  }

  let result: Result[(), PosixError] = setenv(string, eq_pos as u32, string + eq_pos + 1, strlen(string + eq_pos + 1) as u32, true, env);
  if result.is_err() {
    return -1;
  }
  return 0;
}

//==============================================================================
// Residual Recording
//==============================================================================

pub enum LibcOp : u8 {
  Fopen    = 0,
  Fclose   = 1,
  Fread    = 2,
  Fwrite   = 3,
  Fseek    = 4,
  Malloc   = 5,
  Free     = 6,
}

fn record_libc_residual[op: LibcOp, arg1: u64, arg2: u64] : effect:(unsafe) {
  __libc_residual_write(op as u64, arg1, arg2);
}

//==============================================================================
// Allocation Helpers
//==============================================================================

fn @alloc[T](val: T) -> *T : effect:(alloc, unsafe) { return null; }
fn @alloc[T](count: u64) -> *T : effect:(alloc, unsafe) { return null; }
fn @dealloc[T](ptr: *T) : effect:(unsafe) {}

fn __libc_residual_write[op: u64, a1: u64, a2: u64] : effect:(unsafe) {}

pub type f64 = u64;
pub type CapabilitySlot = core::capabilities::CapabilitySlot;
pub type FILE = libc_shim::FILE;
pub type PosixError = posix_compat::PosixError;
pub type PosixFdFlags = posix_compat::PosixFdFlags;
pub type Timeval = posix_compat::Timeval;
pub type Environment = posix_compat::Environment;

const O_RDONLY: PosixFdFlags = PosixFdFlags(0);
const O_WRONLY: PosixFdFlags = PosixFdFlags(1);
const O_RDWR: PosixFdFlags = PosixFdFlags(2);
const O_CREAT: PosixFdFlags = PosixFdFlags(0x40);
const O_TRUNC: PosixFdFlags = PosixFdFlags(0x200);
const O_APPEND: PosixFdFlags = PosixFdFlags(0x400);

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_strlen[] : effect:(unsafe) {
  let s: [u8; 6] = [0x68, 0x65, 0x6C, 0x6C, 0x6F, 0x00]; // "hello"
  assert(strlen(s) == 5);
}

@Test
pub fn test_strcmp[] : effect:(unsafe) {
  let a: [u8; 4] = [0x61, 0x62, 0x63, 0x00]; // "abc"
  let b: [u8; 4] = [0x61, 0x62, 0x63, 0x00]; // "abc"
  let c: [u8; 4] = [0x61, 0x62, 0x64, 0x00]; // "abd"
  assert(strcmp(a, b) == 0);
  assert(strcmp(a, c) < 0);
}

@Test
pub fn test_memset_memcpy[] : effect:(unsafe) {
  var buf: [u8; 16] = Default;
  memset(buf, 0xAA, 16);
  assert(buf[0] == 0xAA);
  assert(buf[15] == 0xAA);

  var dest: [u8; 16] = Default;
  memcpy(dest, buf, 16);
  assert(dest[0] == 0xAA);
}

@Test
pub fn test_errno_location[] : effect:(unsafe) {
  let errno_ptr: *i32 = __errno_location();
  errno_ptr = 42;
  assert(__errno == 42);
  assert(get_errno() == 42);
}
