    line3.append(ts.promoted_count as Str(16));
    line3.append(Str::from("\n"));
    console.write(line3);
}

fn compute_generation_diff(prev: StoreSnapshot, curr: StoreSnapshot) -> Str(128)
    effect [compute]
{
    let diff_objects: u64 = if curr.total_objects > prev.total_objects
        { curr.total_objects - prev.total_objects } else { 0 };
    let diff_size: u64 = if curr.total_size_kb > prev.total_size_kb
        { curr.total_size_kb - prev.total_size_kb } else { 0 };

    let mut result: Str(128) = Str::from("Generation diff: +");
    result.append(diff_objects as Str(16));
    result.append(Str::from(" objects, +"));
    result.append(diff_size as Str(16));
    result.append(Str::from(" KB\n"));
    return result;
}

fn check_capacity_warnings(cpu: CpuSnapshot, mem: MemorySnapshot, bl: CourtBacklogSnapshot,
                             rv: ResidualVolumeSnapshot) -> Array(Str(64), 4)
    effect [compute]
{
    let warnings: Array(Str(64), 4) = Array::splat(Str::from(""));
    let mut wc: u64 = 0;

    if cpu.total_system > WARN_LEVEL as u8 {
        warnings[wc] = Str::from("High system CPU usage");
        wc = wc + 1;
    }
    if mem.usage_pct >= CRIT_LEVEL as u8 {
        warnings[wc] = Str::from("Critical memory usage");
        wc = wc + 1;
    }
    if bl.backlogged {
        warnings[wc] = Str::from("Court session backlog");
        wc = wc + 1;
    }
    if rv.rate_per_sec > 20 {
        warnings[wc] = Str::from("High residual rate");
        wc = wc + 1;
    }
    return warnings;
}

fn track_resource_trends(previous: Array(u64, 8), current: Array(u64, 8)) -> Array(i64, 8)
    effect [compute]
{
    let deltas: Array(i64, 8) = Array::splat(0);
    for i in 0..8 {
        let prev_val: u64 = previous[i];
        let curr_val: u64 = current[i];
        let diff: i64 = if curr_val >= prev_val {
            (curr_val - prev_val) as i64
        } else {
            -((prev_val - curr_val) as i64)
        };
        deltas[i] = diff;
    }
    return deltas;
}

fn compute_utilization_percentage(used: u64, total: u64) -> u8
    effect [compute]
{
    if total == 0 { return 0; }
    return ((used * 100) / total) as u8;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, io:read, court:request, residual]
{
    console.write(Str::from("System Resource Monitor v1.0\n"));
    console.write(Str::from("=============================\n"));

    // Collect all system metrics
    let cpu: CpuSnapshot = collect_cpu_snapshot();
    let mem: MemorySnapshot = collect_memory_snapshot();
    let store: StoreSnapshot = collect_store_snapshot();
    let cap_usage: CapabilityUsageSnapshot = collect_capability_usage();
    let backlog: CourtBacklogSnapshot = collect_court_backlog();
    let residual_vol: ResidualVolumeSnapshot = collect_residual_volume();
    let trust_summary: TrustSummarySnapshot = collect_trust_summary();

    // Display all metrics
    console.write(Str::from("\n"));
    display_cpu_info(cpu, console);
    console.write(Str::from("\n"));
    display_memory_info(mem, console);
    console.write(Str::from("\n"));
    display_store_info(store, console);
    console.write(Str::from("\n"));
    display_cap_usage(cap_usage, console);
    console.write(Str::from("\n"));
    display_court_backlog(backlog, console);
    console.write(Str::from("\n"));
    display_residual_volume(residual_vol, console);
    console.write(Str::from("\n"));
    display_trust_summary_resource(trust_summary, console);

    // Build and render trend graphs
    console.write(Str::from("\n=== Trend Graphs ===\n"));
    let trend_values: Array(u8, 60) = Array::splat(0);
    trend_values[0] = 12;
    trend_values[1] = 15;
    trend_values[2] = 18;
    trend_values[3] = 14;
    trend_values[4] = 20;
    trend_values[5] = 22;
    trend_values[6] = 19;
    trend_values[7] = 25;
    let graph: AsciiGraph = build_trend_graph(trend_values, 8, Str::from("CPU Trend"), 30);
    render_ascii_graph(graph, console);

    // Compute generation diff
    let store2: StoreSnapshot = collect_store_snapshot();
    let diff: Str(128) = compute_generation_diff(store, store2);
    console.write(diff);

    // Check capacity warnings
    let warnings: Array(Str(64), 4) = check_capacity_warnings(cpu, mem, backlog, residual_vol);
    let mut warn_count: u64 = 0;
    for i in 0..4 {
        if warnings[i].len() > 0 {
            warn_count = warn_count + 1;
            let mut wline: Str(128) = Str::from("WARNING: ");
            wline.append(warnings[i]);
            wline.append(Str::from("\n"));
            console.write(wline);
        }
    }

    // Assertions
    assert(cpu.core_count > 0, "rm: CPU cores detected");
    assert(mem.total_kb > 0, "rm: memory total positive");
    assert(store.total_objects > 0, "rm: store has objects");
    assert(cap_usage.total_caps > 0, "rm: capabilities exist");
    assert(trust_summary.total_objects > 0, "rm: trust summary has objects");
    assert(graph.point_count > 0, "rm: trend graph rendered");

    // Verify trust state counts
    let trust_total: u64 = trust_summary.unknown_count + trust_summary.observed_count
        + trust_summary.replayed_count + trust_summary.oracle_compared_count
        + trust_summary.residual_stable_count + trust_summary.sealed_count
        + trust_summary.promoted_count;
    assert(trust_total == trust_summary.total_objects, "rm: trust counts sum to total");

    // Verify no runaway values
    let mem_ok: bool = mem.usage_pct <= 100;
    assert(mem_ok, "rm: memory percentage valid");

    // Track resource deltas over time
    let prev_vals: Array(u64, 8) = Array::splat(0);
    prev_vals[0] = 10; prev_vals[1] = 50; prev_vals[2] = 20;
    let curr_vals: Array(u64, 8) = Array::splat(0);
    curr_vals[0] = 15; curr_vals[1] = 55; curr_vals[2] = 25;
    let deltas: Array(i64, 8) = track_resource_trends(prev_vals, curr_vals);

    // Compute utilization
    let cpu_util: u8 = compute_utilization_percentage(
        (cpu.total_user + cpu.total_system) as u64, 100);
    assert(cpu_util > 0, "rm: CPU utilization computed");

    console.write(Str::from("\n=== Resource monitoring complete ===\n"));

    residual emit {
        op: "resource_monitor.complete",
        cores: cpu.core_count,
        memory_pct: mem.usage_pct,
        store_objects: store.total_objects,
        caps: cap_usage.total_caps,
        court_pending: backlog.pending_sessions,
        residuals: residual_vol.total_residuals,
        warnings: warn_count,
        trust_avg: trust_summary.avg_trust_level,
    };
}
