    erst_size: u32,
    erst_base: u64,
    erst_dequeue: u64,
    tr_dequeue: u64,
    tr_ring_seg_count: u16,
    tr_ring_entries: Array(XhciTrb, 256),
    enabled: bool,
    pending: bool,
    event_trb_idx: u64,
    ist_index: u8,
}

// ─────────────────────────────────────────────────────────────
// Slot Context
// ─────────────────────────────────────────────────────────────

struct XhciSlotContext {
    route_string: u64,
    speed: u8,
    mtt: bool,
    hub: bool,
    context_entries: u8,
    max_exit_latency: u16,
    root_hub_port_num: u8,
    num_ports: u8,
    parent_hub_slot_id: u8,
    parent_port_num: u8,
    tt_think_time: u8,
    interrupter_target: u8,
    slot_state: u8,
    dev_context_entries: u8,
}

// ─────────────────────────────────────────────────────────────
// Endpoint Context
// ─────────────────────────────────────────────────────────────

struct XhciEndpointContext {
    ep_state: u8,
    mult: u8,
    max_primary_streams: u8,
    lsa: bool,
    interval: u8,
    max_esit_payload_hi: u8,
    ep_type: u8,
    cerr: u8,
    max_packet_size: u16,
    max_burst_size: u8,
    tr_dequeue_pointer: u64,
    avg_trb_len: u16,
    max_esit_payload_lo: u16,
    ep_info: u32,
    ep_info2: u32,
    deq_cycle: bool,
}

// ─────────────────────────────────────────────────────────────
// Input Control Context
// ─────────────────────────────────────────────────────────────

struct XhciInputControlContext {
    drop_context_flags: u32,
    add_context_flags: u32,
    reserved: Array(u32, 6),
}

// ─────────────────────────────────────────────────────────────
// TRB Types
// ─────────────────────────────────────────────────────────────

type XhciTrbType = enum {
    Reserved                  = 0,
    Normal                    = 1,
    Setup                     = 2,
    Data                      = 3,
    Status                    = 4,
    Isoch                     = 5,
    Link                      = 6,
    EventData                 = 7,
    Noop                      = 8,
    EnableSlotCommand         = 9,
    DisableSlotCommand        = 10,
    AddressDeviceCommand      = 11,
    ConfigureEndpointCommand  = 12,
    EvaluateContextCommand    = 13,
    ResetEndpointCommand      = 14,
    StopEndpointCommand       = 15,
    SetTrDequeuePointerCommand = 16,
    ResetDeviceCommand        = 17,
    ForceEventCommand         = 18,
    NegotiateBandwidthCommand = 19,
    SetLatencyToleranceValue  = 20,
    SetIsochDelay             = 21,
    ClearFeatureRequest       = 22,
    TransferEvent             = 32,
    CommandCompletionEvent    = 33,
    PortStatusChangeEvent     = 34,
    BandwidthRequestEvent     = 35,
    DoorbellEvent             = 36,
    HostControllerEvent       = 37,
    DeviceNotificationEvent   = 38,
}

// ─────────────────────────────────────────────────────────────
// Transfer Request Block (TRB)
// ─────────────────────────────────────────────────────────────

struct XhciTrb {
    parameter: u64,
    status: u32,
    control: u32,
    trb_type: XhciTrbType,
    cycle_bit: bool,
    chain_bit: bool,
    ioc: bool,
    isp: bool,
    ent: bool,
}

fn xhci_parse_trb_control(control: u32) -> (XhciTrbType, bool, bool, bool, bool, bool)
    effect [deterministic]
{
    let trb_type: XhciTrbType = (control & 0x3F) as XhciTrbType;
    let cycle_bit: bool = (control & 0x01) != 0;
    let chain_bit: bool = (control & (1 << 4)) != 0;
    let ioc: bool = (control & (1 << 5)) != 0;
    let isp: bool = (control & (1 << 2)) != 0;
    let ent: bool = (control & (1 << 1)) != 0;
    return (trb_type, cycle_bit, chain_bit, ioc, isp, ent);
}

// ─────────────────────────────────────────────────────────────
// Setup Stage TRB Fields
// ─────────────────────────────────────────────────────────────

struct XhciSetupStageTrb {
    request_type: u8,
    request: u8,
    value: u16,
    index: u16,
    length: u16,
    trb_type: XhciTrbType,
    ioc: bool,
    cycle_bit: bool,
}

// ─────────────────────────────────────────────────────────────
// Isochronous TRB Fields
// ─────────────────────────────────────────────────────────────

struct XhciIsochTrbFields {
    buffer_ptr: u64,
    trb_transfer_length: u32,
    tlbpc: u16,
    frame_id: u16,
    sia: bool,
    ioc: bool,
    chain_bit: bool,
    cycle_bit: bool,
    trb_type: XhciTrbType,
    interrupter_target: u8,
}

// ─────────────────────────────────────────────────────────────
// Port Status and Control
// ─────────────────────────────────────────────────────────────

struct XhciPortState {
    port_number: u8,
    portsc: u32,
    portpmsc: u32,
    portli: u32,
    port_hplpmc: u32,
    connected: bool,
    enabled: bool,
    resetting: bool,
    speed: XhciPortSpeed,
    link_state: XhciLinkState,
    power_ok: bool,
    device_slot: u8,
}

type XhciPortSpeed = enum {
    Undefined = 0,
    FullSpeed = 1,
    LowSpeed  = 2,
    HighSpeed = 3,
    SuperSpeed = 4,
    SuperSpeed20G = 5,
}

type XhciLinkState = enum {
    U0      = 0,
    U1      = 1,
    U2      = 2,
    U3      = 3,
    Disabled = 4,
    RxDetect = 5,
    Inactive = 6,
    Polling  = 7,
    Recovery = 8,
    HotReset = 9,
    Compliance = 10,
}

// ─────────────────────────────────────────────────────────────
// Device State
// ─────────────────────────────────────────────────────────────

struct XhciDevice {
    slot_id: u8,
    slot_context: XhciSlotContext,
    endpoint_contexts: Array(XhciEndpointContext, 31),
    input_ctx: XhciInputControlContext,
    device_address: u8,
    speed: XhciPortSpeed,
    root_port: u8,
    configured: bool,
    lpm_enabled: bool,
    usb3_capable: bool,
    isoch_enabled: bool,
}

// ─────────────────────────────────────────────────────────────
// Transfer Ring
// ─────────────────────────────────────────────────────────────

struct XhciTransferRing {
    entries: Array(XhciTrb, 256),
    enqueue_idx: u64,
    dequeue_idx: u64,
    cycle_state: bool,
    pcs: bool,
    dcs: bool,
    trb_phys: u64,
    segment_size: u64,
    ep_type: u8,
}

// ─────────────────────────────────────────────────────────────
// Command Ring
// ─────────────────────────────────────────────────────────────

struct XhciCommandRing {
    entries: Array(XhciTrb, 64),
    enqueue_idx: u64,
    dequeue_idx: u64,
    cycle_state: bool,
    crcr: u64,
    cmd_pending: bool,
}

// ─────────────────────────────────────────────────────────────
// Event Ring Segment
// ─────────────────────────────────────────────────────────────

struct XhciEventRingSegment {
    entries: Array(XhciTrb, 256),
    seg_base: u64,
    seg_size: u64,
    dequeue_idx: u64,
    cycle_state: bool,
}

// ─────────────────────────────────────────────────────────────
// xHCI Controller State
// ─────────────────────────────────────────────────────────────

struct XhciController {
    controller_identity: Identity,
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    caplength: u8,
    hciversion: u16,
    hcsparams1: XhciHcsParams1,
    hccparams1: XhciHccParams1,
    max_slots: u8,
    max_intrs: u16,
    max_ports: u8,
    db_offset: u64,
    rt_offset: u64,
    dcbaap: u64,
    config: u32,
    interrupter: XhciInterrupter,
    intr_count: u16,
    devices: Array(XhciDevice, 128),
    device_count: u8,
    ports: Array(XhciPortState, 32),
    port_count: u8,
    cmd_ring: XhciCommandRing,
    event_ring: XhciEventRingSegment,
    ext_caps: Array(XhciExtCapEntry, 16),
    ext_cap_count: u8,
    operational: bool,
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct XhciDriverState {
    driver_identity: Identity,
    controllers: Array(XhciController, 4),
    controller_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_transfers: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Build TRB Control Word
// ─────────────────────────────────────────────────────────────

fn xhci_build_trb_control(
    trb_type: XhciTrbType,
    cycle: bool,
    chain: bool,
    ioc: bool,
    isp: bool,
    ent: bool,
    interrupter: u8,
) -> u32
    effect [deterministic]
{
    let mut ctrl: u32 = 0;
    if cycle { ctrl = ctrl | 0x01; };
    if ent { ctrl = ctrl | 0x02; };
    if isp { ctrl = ctrl | 0x04; };
    if chain { ctrl = ctrl | 0x10; };
    if ioc { ctrl = ctrl | 0x20; };
    ctrl = ctrl | ((trb_type as u32) & 0x3F);
    ctrl = ctrl | ((interrupter as u32) << 22);
    return ctrl;
}

// ─────────────────────────────────────────────────────────────
// Enqueue Normal TRB
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_normal_trb(
    ring: Handle(XhciTransferRing),
    data_phys: u64,
    length: u32,
    td_size: u8,
    ioc: bool,
    chain: bool,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_normal_trb:v1"
{
    let idx: u64 = ring.enqueue_idx;
    if idx >= 256 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let ctrl: u32 = xhci_build_trb_control(
        XhciTrbType::Normal, ring.cycle_state, chain, ioc, false, false, 0,
    );

    ring.entries[idx] = XhciTrb {
        parameter: data_phys,
        status: length | ((td_size as u32) << 17),
        control: ctrl,
        trb_type: XhciTrbType::Normal,
        cycle_bit: ring.cycle_state,
        chain_bit: chain,
        ioc: ioc,
        isp: false,
        ent: false,
    };

    ring.enqueue_idx = idx + 1;
    if ring.enqueue_idx >= 256 {
        ring.cycle_state = !ring.cycle_state;
    };

    residual emit {
        op: "xhci.enqueue_normal_trb",
        data_phys: data_phys,
        length: length as u64,
        ioc: ioc,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enqueue Setup Stage TRB
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_setup_trb(
    ring: Handle(XhciTransferRing),
    request_type: u8,
    request: u8,
    value: u16,
    index: u16,
    length: u16,
    ioc: bool,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_setup_trb:v1"
{
    let idx: u64 = ring.enqueue_idx;
    if idx >= 256 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let param: u64 = (request_type as u64) |
                     ((request as u64) << 8) |
                     ((value as u64) << 16) |
                     ((index as u64) << 32) |
                     ((length as u64) << 48);

    let ctrl: u32 = xhci_build_trb_control(
        XhciTrbType::Setup, ring.cycle_state, false, ioc, false, true, 0,
    );
    ctrl = ctrl | ((length as u32) << 16);

    ring.entries[idx] = XhciTrb {
        parameter: param,
        status: 0x08,
        control: ctrl,
        trb_type: XhciTrbType::Setup,
        cycle_bit: ring.cycle_state,
        chain_bit: false,
        ioc: ioc,
        isp: false,
        ent: true,
    };

    ring.enqueue_idx = idx + 1;

    residual emit {
        op: "xhci.enqueue_setup_trb",
        request_type: request_type as u64,
        request: request as u64,
        length: length as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enqueue Data Stage TRB
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_data_trb(
    ring: Handle(XhciTransferRing),
    data_phys: u64,
    length: u32,
    dir_in: bool,
    ioc: bool,
    chain: bool,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_data_trb:v1"
{
    let idx: u64 = ring.enqueue_idx;
    if idx >= 256 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let mut ctrl: u32 = xhci_build_trb_control(
        XhciTrbType::Data, ring.cycle_state, chain, ioc, false, false, 0,
    );
    if dir_in {
        ctrl = ctrl | (1 << 16);
    };

    ring.entries[idx] = XhciTrb {
        parameter: data_phys,
        status: length,
        control: ctrl,
        trb_type: XhciTrbType::Data,
        cycle_bit: ring.cycle_state,
        chain_bit: chain,
        ioc: ioc,
        isp: false,
        ent: false,
    };

    ring.enqueue_idx = idx + 1;

    residual emit {
        op: "xhci.enqueue_data_trb",
        data_phys: data_phys,
        length: length as u64,
        dir_in: dir_in,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enqueue Status Stage TRB
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_status_trb(
    ring: Handle(XhciTransferRing),
    dir_in: bool,
    ioc: bool,
    ent: bool,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_status_trb:v1"
{
    let idx: u64 = ring.enqueue_idx;
    if idx >= 256 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let mut ctrl: u32 = xhci_build_trb_control(
        XhciTrbType::Status, ring.cycle_state, false, ioc, false, ent, 0,
    );
    if dir_in {
        ctrl = ctrl | (1 << 16);
    };

    ring.entries[idx] = XhciTrb {
        parameter: 0,
        status: 0,
        control: ctrl,
        trb_type: XhciTrbType::Status,
        cycle_bit: ring.cycle_state,
        chain_bit: false,
        ioc: ioc,
        isp: false,
        ent: ent,
    };

    ring.enqueue_idx = idx + 1;

    residual emit {
        op: "xhci.enqueue_status_trb",
        dir_in: dir_in,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enqueue Isochronous TRB
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_isoch_trb(
    ring: Handle(XhciTransferRing),
    buffer_ptr: u64,
    trb_transfer_length: u32,
    tlbpc: u16,
    frame_id: u16,
    sia: bool,
    ioc: bool,
    chain: bool,
    interrupter_target: u8,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_isoch_trb:v1"
{
    if !cap.can_isochronous {
        return Result::Err(XhciError::XhciCapabilityError);
    };

    let idx: u64 = ring.enqueue_idx;
    if idx >= 256 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let mut ctrl: u32 = xhci_build_trb_control(
        XhciTrbType::Isoch, ring.cycle_state, chain, ioc, false, false, interrupter_target,
    );
    if sia {
        ctrl = ctrl | (1 << 16);
    };
    ctrl = ctrl | ((tlbpc as u32) << 16);

    let status: u32 = trb_transfer_length | ((frame_id as u32) << 16);

    ring.entries[idx] = XhciTrb {
        parameter: buffer_ptr,
        status: status,
        control: ctrl,
        trb_type: XhciTrbType::Isoch,
        cycle_bit: ring.cycle_state,
        chain_bit: chain,
        ioc: ioc,
        isp: false,
        ent: false,
    };

    ring.enqueue_idx = idx + 1;

    residual emit {
        op: "xhci.enqueue_isoch_trb",
        frame_id: frame_id as u64,
        transfer_length: trb_transfer_length as u64,
        sia: sia,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enqueue Link TRB
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_link_trb(
    ring: Handle(XhciTransferRing),
    seg_ptr: u64,
    toggle_cycle: bool,
    ioc: bool,
    chain: bool,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_link_trb:v1"
{
    let idx: u64 = ring.enqueue_idx;
    if idx >= 256 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let mut ctrl: u32 = xhci_build_trb_control(
        XhciTrbType::Link, ring.cycle_state, chain, ioc, false, false, 0,
    );
    if toggle_cycle {
        ctrl = ctrl | (1 << 17);
    };

    ring.entries[idx] = XhciTrb {
        parameter: seg_ptr,
        status: 0,
        control: ctrl,
        trb_type: XhciTrbType::Link,
        cycle_bit: ring.cycle_state,
        chain_bit: chain,
        ioc: ioc,
        isp: false,
        ent: false,
    };

    ring.enqueue_idx = idx + 1;

    residual emit {
        op: "xhci.enqueue_link_trb",
        seg_ptr: seg_ptr,
        toggle_cycle: toggle_cycle,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enqueue No-Op TRB
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_noop_trb(
    ring: Handle(XhciTransferRing),
    ioc: bool,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_noop_trb:v1"
{
    let idx: u64 = ring.enqueue_idx;
    if idx >= 256 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let ctrl: u32 = xhci_build_trb_control(
        XhciTrbType::Noop, ring.cycle_state, false, ioc, false, false, 0,
    );

    ring.entries[idx] = XhciTrb {
        parameter: 0,
        status: 0,
        control: ctrl,
        trb_type: XhciTrbType::Noop,
        cycle_bit: ring.cycle_state,
        chain_bit: false,
        ioc: ioc,
        isp: false,
        ent: false,
    };

    ring.enqueue_idx = idx + 1;

    residual emit {
        op: "xhci.enqueue_noop_trb",
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enqueue Command TRB (Generic)
// ─────────────────────────────────────────────────────────────

fn xhci_enqueue_command_trb(
    cmd_ring: Handle(XhciCommandRing),
    param: u64,
    status: u32,
    trb_type: XhciTrbType,
    cycle: bool,
    ioc: bool,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [deterministic, residual]
    court "xhci_enqueue_cmd_trb:v1"
{
    let idx: u64 = cmd_ring.enqueue_idx;
    if idx >= 64 {
        return Result::Err(XhciError::XhciTrbFull);
    };

    let ctrl: u32 = xhci_build_trb_control(trb_type, cycle, false, ioc, false, false, 0);

    cmd_ring.entries[idx] = XhciTrb {
        parameter: param,
        status: status,
        control: ctrl,
        trb_type: trb_type,
        cycle_bit: cycle,
        chain_bit: false,
        ioc: ioc,
        isp: false,
        ent: false,
    };

    cmd_ring.enqueue_idx = idx + 1;
    if cmd_ring.enqueue_idx >= 64 {
        cmd_ring.cycle_state = !cmd_ring.cycle_state;
    };
    cmd_ring.cmd_pending = true;

    residual emit {
        op: "xhci.enqueue_command_trb",
        trb_type: trb_type as u64,
        param: param,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Ring Doorbell
// ─────────────────────────────────────────────────────────────

fn xhci_ring_doorbell(
    controller: Handle(XhciController),
    slot_id: u8,
    dbit: u8,
    target: u8,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_ring_doorbell:v1"
{
    let db_reg: u64 = controller.db_offset + ((slot_id as u64) * 4);
    let db_val: u32 = (dbit as u32) | ((target as u32) << 8);

    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };
    trusted reason "xHCI doorbell register write, xHCI Spec §4.17" {
        let ptr: *(u32) = (regs.mmio_base + db_reg) as *(u32);
        *ptr = db_val;
    };

    residual emit {
        op: "xhci.ring_doorbell",
        slot_id: slot_id as u64,
        dbit: dbit as u64,
        target: target as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enable Slot Command
// ─────────────────────────────────────────────────────────────

fn xhci_enable_slot(
    controller: Handle(XhciController),
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(u8, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_enable_slot:v1"
{
    let param: u64 = 0;
    let cmd_result: Result(void, XhciError) = xhci_enqueue_command_trb(
        Handle(XhciCommandRing)::from_ptr(&controller.cmd_ring),
        param, 0, XhciTrbType::EnableSlotCommand, controller.cmd_ring.cycle_state, true, timestamp,
    );
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let db_result: Result(void, XhciError) = xhci_ring_doorbell(controller, 0, 0, 0, timestamp);
    match db_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    return Result::Ok(1);
}

// ─────────────────────────────────────────────────────────────
// Address Device Command
// ─────────────────────────────────────────────────────────────

fn xhci_address_device(
    controller: Handle(XhciController),
    slot_id: u8,
    input_ctx_phys: u64,
    bsr: bool,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_address_device:v1"
{
    let param: u64 = input_ctx_phys;
    let status: u32;
    if bsr {
        status = 0x01;
    } else {
        status = 0x00;
    };

    let cmd_result: Result(void, XhciError) = xhci_enqueue_command_trb(
        Handle(XhciCommandRing)::from_ptr(&controller.cmd_ring),
        param, status, XhciTrbType::AddressDeviceCommand, controller.cmd_ring.cycle_state, true, timestamp,
    );
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let db_result: Result(void, XhciError) = xhci_ring_doorbell(controller, 0, 0, 0, timestamp);
    match db_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "xhci.address_device",
        slot_id: slot_id as u64,
        bsr: bsr,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Configure Endpoint Command
// ─────────────────────────────────────────────────────────────

fn xhci_configure_endpoint(
    controller: Handle(XhciController),
    slot_id: u8,
    input_ctx_phys: u64,
    deconfigure: bool,
    cap: XhciFullCapability,
    timestamp: u64,
