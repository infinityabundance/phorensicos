// ──────────────────────────────────────────────
// Saturating Arithmetic
// ──────────────────────────────────────────────
// Saturating operations clamp to MIN/MAX instead of overflowing.
// Evidence path: MATH-SAT-001 through MATH-SAT-030

// Saturating addition for u64.
pub fn saturating_add_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    let (sum, overflow): (u64, bool) = __builtin_add_u64_overflow(a, b)
    if overflow { 0xFFFF_FFFF_FFFF_FFFF } else { sum }
}

// Saturating subtraction for u64.
pub fn saturating_sub_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    if b > a { 0 } else { a - b }
}

// Saturating multiplication for u64.
pub fn saturating_mul_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    let (prod, overflow): (u64, bool) = __builtin_mul_u64_overflow(a, b)
    if overflow { 0xFFFF_FFFF_FFFF_FFFF } else { prod }
}

// Saturating addition for u32.
pub fn saturating_add_u32(a: u32, b: u32) -> u32
    effects: [deterministic]
{
    let (sum, overflow): (u32, bool) = __builtin_add_u32_overflow(a, b)
    if overflow { 0xFFFF_FFFF } else { sum }
}

// Saturating subtraction for u32.
pub fn saturating_sub_u32(a: u32, b: u32) -> u32
    effects: [deterministic]
{
    if b > a { 0 } else { a - b }
}

// Saturating multiplication for u32.
pub fn saturating_mul_u32(a: u32, b: u32) -> u32
    effects: [deterministic]
{
    let (prod, overflow): (u32, bool) = __builtin_mul_u32_overflow(a, b)
    if overflow { 0xFFFF_FFFF } else { prod }
}

// Saturating addition for u16.
pub fn saturating_add_u16(a: u16, b: u16) -> u16
    effects: [deterministic]
{
    let (sum, overflow): (u16, bool) = __builtin_add_u16_overflow(a, b)
    if overflow { 0xFFFF } else { sum }
}

// Saturating addition for u8.
pub fn saturating_add_u8(a: u8, b: u8) -> u8
    effects: [deterministic]
{
    let (sum, overflow): (u8, bool) = __builtin_add_u8_overflow(a, b)
    if overflow { 0xFF } else { sum }
}

// ──────────────────────────────────────────────
// Wrapping Arithmetic
// ──────────────────────────────────────────────
// Wrapping operations silently wrap on overflow.
// Evidence path: MATH-WRAP-001 through MATH-WRAP-025

// Wrapping addition for u64.
pub fn wrapping_add_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    let (sum, _overflow): (u64, bool) = __builtin_add_u64_overflow(a, b)
    sum
}

// Wrapping subtraction for u64.
pub fn wrapping_sub_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    let (diff, _underflow): (u64, bool) = __builtin_sub_u64_overflow(a, b)
    diff
}

// Wrapping multiplication for u64.
pub fn wrapping_mul_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    let (prod, _overflow): (u64, bool) = __builtin_mul_u64_overflow(a, b)
    prod
}

// Wrapping addition for u32.
pub fn wrapping_add_u32(a: u32, b: u32) -> u32
    effects: [deterministic]
{
    let (sum, _overflow): (u32, bool) = __builtin_add_u32_overflow(a, b)
    sum
}

// Wrapping subtraction for u32.
pub fn wrapping_sub_u32(a: u32, b: u32) -> u32
    effects: [deterministic]
{
    let (diff, _underflow): (u32, bool) = __builtin_sub_u32_overflow(a, b)
    diff
}

// ──────────────────────────────────────────────
// Bounded Iteration Helpers
// ──────────────────────────────────────────────
// Helpers for writing bounded loops over ranges.
// Evidence path: MATH-ITER-001 through MATH-ITER-030

// Iterate over range [start, end) with a step, calling f for each value.
// loop: bounds[BOUND_MEDIUM] — bounded by range size.
pub fn range_for_each(start: u32, end: u32, step: u32, f: fn(u32))
    effects: [deterministic]
{
    let mut i: u32 = start
    // loop: bounds[BOUND_MEDIUM] — end-start is bounded
    loop: bounds[BOUND_MEDIUM] while i < end {
        f(i)
        i = i + step
    }
}

// Iterate over range [0, count) calling f for each value.
// loop: bounds[BOUND_MEDIUM] — count is bounded.
pub fn for_each_index(count: u32, f: fn(u32))
    effects: [deterministic]
{
    let mut i: u32 = 0
    // loop: bounds[BOUND_MEDIUM] — count is bounded
    loop: bounds[BOUND_MEDIUM] while i < count {
        f(i)
        i = i + 1
    }
}

// Find the first index where predicate is true, within bounds.
// loop: bounds[BOUND_SEARCH] — search space bounded.
pub fn find_index(count: u32, predicate: fn(u32) -> bool) -> Option[u32]
    effects: [deterministic]
{
    let mut i: u32 = 0
    // loop: bounds[BOUND_SEARCH] — search bounded
    loop: bounds[BOUND_SEARCH] while i < count {
        if predicate(i) {
            return Option::Some(i)
        }
        i = i + 1
    }
    Option::None
}

// Count elements where predicate is true.
// loop: bounds[BOUND_MEDIUM] — bounded by count.
pub fn count_if(count: u32, predicate: fn(u32) -> bool) -> u32
    effects: [deterministic]
{
    let mut total: u32 = 0
    let mut i: u32 = 0
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] while i < count {
        if predicate(i) {
            total = total + 1
        }
        i = i + 1
    }
    total
}

// ──────────────────────────────────────────────
// Bit Manipulation Operations
// ──────────────────────────────────────────────
// Evidence path: MATH-BITS-001 through MATH-BITS-030

// Set a bit at position in a Word64.
pub fn set_bit(value: Word64, position: u32) -> Word64
    effects: [deterministic]
{
    if position >= 64 {
        value
    } else {
        let mask: Word64 = Word64::from_u64(1 << position as u64)
        value.bit_or(mask)
    }
}

// Clear a bit at position in a Word64.
pub fn clear_bit(value: Word64, position: u32) -> Word64
    effects: [deterministic]
{
    if position >= 64 {
        value
    } else {
        let mask: Word64 = Word64::from_u64(1 << position as u64)
        let not_mask: Word64 = mask.bit_not()
        value.bit_and(not_mask)
    }
}

// Toggle a bit at position in a Word64.
pub fn toggle_bit(value: Word64, position: u32) -> Word64
    effects: [deterministic]
{
    if position >= 64 {
        value
    } else {
        let mask: Word64 = Word64::from_u64(1 << position as u64)
        value.bit_xor(mask)
    }
}

// Check if a bit is set.
pub fn test_bit(value: Word64, position: u32) -> bool
    effects: [deterministic]
{
    if position >= 64 {
        return false
    }
    let mask: Word64 = Word64::from_u64(1 << position as u64)
    let masked: Word64 = value.bit_and(mask)
    !masked.is_zero()
}

// Extract a range of bits [high:low] from a Word64.
pub fn extract_bits(value: Word64, high: u32, low: u32) -> Word64
    effects: [deterministic]
{
    if low > high || high >= 64 {
        return Word64::zero()
    }
    let width: u32 = high - low + 1
    let mask_val: u64 = if width >= 64 {
        0xFFFF_FFFF_FFFF_FFFF
    } else {
        (1 << width) - 1
    }
    let mask: Word64 = Word64::from_u64(mask_val << low)
    let extracted: Word64 = value.bit_and(mask)
    extracted.checked_shr(low).unwrap_or(Word64::zero())
}

// Rotate left by n bits.
pub fn rotate_left(value: Word64, n: u32) -> Word64
    effects: [deterministic]
{
    let shift: u32 = n % 64
    if shift == 0 {
        return value
    }
    let left: Word64 = value.checked_shl(shift).unwrap_or(Word64::zero())
    let right: Word64 = value.checked_shr(64 - shift).unwrap_or(Word64::zero())
    left.bit_or(right)
}

// Rotate right by n bits.
pub fn rotate_right(value: Word64, n: u32) -> Word64
    effects: [deterministic]
{
    let shift: u32 = n % 64
    if shift == 0 {
        return value
    }
    let right: Word64 = value.checked_shr(shift).unwrap_or(Word64::zero())
    let left: Word64 = value.checked_shl(64 - shift).unwrap_or(Word64::zero())
    left.bit_or(right)
}

// Reverse the bits in a Byte.
pub fn reverse_bits_byte(value: Byte) -> Byte
    effects: [deterministic]
{
    let mut v: u8 = value.to_u8()
    v = ((v & 0xF0) >> 4) | ((v & 0x0F) << 4)
    v = ((v & 0xCC) >> 2) | ((v & 0x33) << 2)
    v = ((v & 0xAA) >> 1) | ((v & 0x55) << 1)
    Byte::from_u8(v)
}

// Reverse the bytes in a Word64 (endianness swap).
pub fn reverse_bytes_word64(value: Word64) -> Word64
    effects: [deterministic]
{
    let bytes: Byte[8] = value.to_le_bytes()
    let mut reversed: [u8; 8] = [0; 8]
    // loop: bounds[BOUND_TINY] — exactly 8 iterations
    loop: bounds[BOUND_TINY] for i in 0..8 {
        reversed[i] = bytes[7 - i].to_u8()
    }
    let raw: u64 = __builtin_u64_from_le_bytes(reversed)
    Word64::from_u64(raw)
}

// ──────────────────────────────────────────────
// GCD and Modular Operations
// ──────────────────────────────────────────────
// Evidence path: MATH-GCD-001 through MATH-GCD-015

// Euclidean GCD algorithm (bounded: number of iterations <= log2(min(a,b)) + 1).
// loop: bounds[BOUND_SMALL] — at most 64 iterations for u64.
pub fn gcd(a: Word64, b: Word64) -> Word64
    effects: [deterministic]
{
    let mut x: u64 = a.to_u64()
    let mut y: u64 = b.to_u64()
    // loop: bounds[BOUND_SMALL] — Euclidean algorithm converges quickly
    loop: bounds[BOUND_SMALL] while y != 0 {
        let temp: u64 = y
        y = x % y
        x = temp
    }
    Word64::from_u64(x)
}

// Least common multiple.
pub fn lcm(a: Word64, b: Word64) -> Result[Word64, OverflowError>
    effects: [deterministic]
{
    if a.is_zero() || b.is_zero() {
        return Result::Ok(Word64::zero())
    }
    let g: Word64 = gcd(a, b)
    let quotient: Word64 = a.checked_div(g)?
    quotient.checked_mul(b)
}

// Check if a number is even.
pub fn is_even(value: Word64) -> bool
    effects: [deterministic]
{
    let one: Word64 = Word64::one()
    let masked: Word64 = value.bit_and(one)
    masked.is_zero()
}

// Check if a number is odd.
pub fn is_odd(value: Word64) -> bool
    effects: [deterministic]
{
    !is_even(value)
}

// ──────────────────────────────────────────────
// Min/Max Operations
// ──────────────────────────────────────────────
// Evidence path: MATH-MM-001 through MATH-MM-020

// Generic min for u64.
pub fn min_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    if a < b { a } else { b }
}

// Generic max for u64.
pub fn max_u64(a: u64, b: u64) -> u64
    effects: [deterministic]
{
    if a > b { a } else { b }
}

// Clamp a value to a range [min, max].
pub fn clamp_word64(value: Word64, min_val: Word64, max_val: Word64) -> Word64
    effects: [deterministic]
{
    if value.lt(min_val) {
        min_val
    } else if value.gt(max_val) {
        max_val
    } else {
        value
    }
}

// Clamp u64.
pub fn clamp_u64(value: u64, min_val: u64, max_val: u64) -> u64
    effects: [deterministic]
{
    if value < min_val { min_val }
    else if value > max_val { max_val }
    else { value }
}

// Clamp u32.
pub fn clamp_u32(value: u32, min_val: u32, max_val: u32) -> u32
    effects: [deterministic]
{
    if value < min_val { min_val }
    else if value > max_val { max_val }
    else { value }
}

