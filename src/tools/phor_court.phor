// phor_court.phor — Court CLI Tool: Court Session Creation, Evidence Submission,
//                    Replay Execution, Oracle Comparison, Verdict Display,
//                    Trust Promotion
// Phorensic Court CLI — Verification and Trust Tool
//
// This tool interfaces with the Phorensic court system to manage court sessions,
// submit evidence for verification, replay compilation phases for comparison
// with an oracle, display verdicts, and promote trust levels based on verification
// results.
//
// Operations performed:
// 1. Court session creation — creates new verification sessions
// 2. Evidence submission — submits sealed containers as evidence
// 3. Replay execution — replays compiler phases for comparison
// 4. Oracle comparison — compares results against trusted oracle
// 5. Verdict display — formats and displays court verdicts
// 6. Trust promotion — promotes trust levels based on successful verification
//
// Evidence semantics: All court interactions produce CourtReceipt records that
// are stored in the forensic store for auditability.
//
// Boundedness: All collections are fixed-capacity. Witness lists are bounded
// at MAX_COURT_WITNESSES (32). Sessions are bounded at 16.
//
// Effect declarations: Court operations require [court] effect for session
// management and [io] for display operations.

use core::fixed::Array16;
use core::fixed::Array32;
use core::fixed::Array64;
use core::fixed::Array128;
use core::fixed::Array256;
use core::result::Result;
use core::option::Option;
use core::string::FixedString256;

use compiler::diagnostics::*;
use compiler::receipts::*;
use compiler::sealer::*;

// ──────────────────────────────────────────────
// CourtSession: A single verification session
// ──────────────────────────────────────────────
// A court session encapsulates the verification of a sealed container
// against an oracle. Sessions track their state through the verification
// lifecycle.
// Evidence path: COURT-SESSION-001 through COURT-SESSION-020

pub sealdatatype SessionState : u8 {
    /// Session has been created.
    Created = 0u8,
    /// Evidence has been submitted.
    EvidenceSubmitted = 1u8,
    /// Replay is in progress.
    Replaying = 2u8,
    /// Oracle comparison completed.
    OracleCompared = 3u8,
    /// Verdict has been rendered.
    VerdictRendered = 4u8,
    /// Trust has been promoted.
    TrustPromoted = 5u8,
    /// Session encountered an error.
    Error = 6u8,
}

pub struct CourtSession {
    /// Unique session identifier.
    pub session_id : FixedString256,
    /// Current session state.
    pub state : SessionState,
    /// The sealed container under review.
    pub container : Option<SealedContainer>,
    /// The oracle container for comparison.
    pub oracle : Option<SealedContainer>,
    /// Comparison results.
    pub comparison_result : ComparisonResult,
    /// The verdict after verification.
    pub verdict : Option<Verdict>,
    /// Court witnesses (bounded: 32 max).
    pub witnesses : Array32<FixedString256>,
    /// Timestamp of session creation.
    pub created_at : u64,
    /// Whether this session is active.
    pub active : bool,
}

impl CourtSession {
    pub fn new(session_id : FixedString256, created_at : u64) -> CourtSession [pure] {
        CourtSession {
            session_id: session_id,
            state: SessionState::Created,
            container: Option::None,
            oracle: Option::None,
            comparison_result: ComparisonResult::new(),
            verdict: Option::None,
            witnesses: Array32::new(),
            created_at: created_at,
            active: true,
        }
    }

    pub fn submit_evidence(mut self, container : SealedContainer) -> CourtSession [pure] {
        self.container = Option::Some(container);
        self.state = SessionState::EvidenceSubmitted;
        self
    }

    pub fn set_oracle(mut self, oracle : SealedContainer) -> CourtSession [pure] {
        self.oracle = Option::Some(oracle);
        self
    }

    pub fn add_witness(mut self, witness : FixedString256) -> CourtSession [pure] {
        if self.witnesses.len() < self.witnesses.capacity() {
            let _ = self.witnesses.push(witness);
        }
        self
    }

    pub fn render_verdict(mut self, verdict : Verdict) -> CourtSession [pure] {
        self.verdict = Option::Some(verdict);
        self.state = SessionState::VerdictRendered;
        self
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Session: "));
        result.push_str(self.session_id);
        result.push_str(FixedString256::from("\n  State: "));
        result.push_str(self.state_name());
        result.push_str(FixedString256::from("\n  Witnesses: "));
        result.push_u32(self.witnesses.len());
        result.push_str(FixedString256::from("\n"));
        match self.verdict {
            Option::Some(v) => {
                result.push_str(FixedString256::from("  Verdict: "));
                result.push_str(v.format());
                result.push_str(FixedString256::from("\n"));
            }
            Option::None => {
                result.push_str(FixedString256::from("  Verdict: pending\n"));
            }
        }
        result
    }

    fn state_name(&self) -> FixedString256 [pure] {
        match self.state {
            SessionState::Created => FixedString256::from("created"),
            SessionState::EvidenceSubmitted => FixedString256::from("evidence-submitted"),
            SessionState::Replaying => FixedString256::from("replaying"),
            SessionState::OracleCompared => FixedString256::from("oracle-compared"),
            SessionState::VerdictRendered => FixedString256::from("verdict-rendered"),
            SessionState::TrustPromoted => FixedString256::from("trust-promoted"),
            SessionState::Error => FixedString256::from("error"),
        }
    }
}

// ──────────────────────────────────────────────
// ComparisonResult: Results of oracle comparison
// ──────────────────────────────────────────────
// Evidence path: COURT-COMPARE-001 through COURT-COMPARE-015

pub struct ComparisonResult {
    /// Whether the container matches the oracle.
    pub matches : bool,
    /// Number of matching receipts.
    pub matching_receipts : u32,
    /// Number of differing receipts.
    pub differing_receipts : u32,
    /// Number of receipts only in the container.
    pub container_only : u32,
    /// Number of receipts only in the oracle.
    pub oracle_only : u32,
    /// Detailed difference descriptions (bounded: 64 max).
    pub differences : Array64<FixedString256>,
    /// Overall similarity score (0-100).
    pub similarity : u8,
}

impl ComparisonResult {
    pub fn new() -> ComparisonResult [pure] {
        ComparisonResult {
            matches: true,
            matching_receipts: 0u32,
            differing_receipts: 0u32,
            container_only: 0u32,
            oracle_only: 0u32,
            differences: Array64::new(),
            similarity: 100u8,
        }
    }

    pub fn add_difference(mut self, description : FixedString256) -> ComparisonResult [pure] {
        self.matches = false;
        let _ = self.differences.push(description);
        self.differing_receipts = self.differing_receipts + 1u32;
        self
    }

    pub fn compute_similarity(mut self) -> ComparisonResult [pure] {
        let total : u32 = self.matching_receipts + self.differing_receipts + self.container_only + self.oracle_only;
        if total == 0u32 {
            self.similarity = 100u8;
        } else {
            let score : u32 = (self.matching_receipts * 100u32) / total;
            self.similarity = score as u8;
        }
        self
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        if self.matches {
            result.push_str(FixedString256::from("MATCH"));
        } else {
            result.push_str(FixedString256::from("DIFFER"));
        }
        result.push_str(FixedString256::from(" [matching="));
        result.push_u32(self.matching_receipts);
        result.push_str(FixedString256::from(", differing="));
        result.push_u32(self.differing_receipts);
        result.push_str(FixedString256::from(", container-only="));
        result.push_u32(self.container_only);
        result.push_str(FixedString256::from(", oracle-only="));
        result.push_u32(self.oracle_only);
        result.push_str(FixedString256::from(", similarity="));
        result.push_u32(self.similarity as u32);
        result.push_str(FixedString256::from("%]"));
        result
    }
}

// ──────────────────────────────────────────────
// Verdict: The outcome of a court verification
// ──────────────────────────────────────────────
// Evidence path: COURT-VERDICT-001 through COURT-VERDICT-015

pub sealdatatype VerdictKind : u8 {
    /// Container is verified authentic.
    Authentic = 0u8,
    /// Container is verified but has warnings.
    VerifiedWithWarnings = 1u8,
    /// Container failed verification.
    Failed = 2u8,
    /// Verification was inconclusive.
    Inconclusive = 3u8,
    /// Container was found to be tampered.
    Tampered = 4u8,
}

pub struct Verdict {
    /// The kind of verdict.
    pub kind : VerdictKind,
    /// Human-readable explanation.
    pub explanation : FixedString256,
    /// Trust level after this verdict.
    pub resulting_trust : TrustLevel,
    /// Court signature over the verdict.
    pub signature : u64,
    /// Whether the verdict is final.
    pub final_verdict : bool,
}

impl Verdict {
    pub fn new(kind : VerdictKind, explanation : FixedString256, trust : TrustLevel) -> Verdict [pure] {
        var sig : u64 = 14695981039346656037u64;
        sig ^= kind as u64;
        sig *= 1099511628211u64;
        Verdict {
            kind: kind,
            explanation: explanation,
            resulting_trust: trust,
            signature: sig,
            final_verdict: false,
        }
    }

    pub fn finalize(mut self) -> Verdict [pure] {
        self.final_verdict = true;
        self
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        match self.kind {
            VerdictKind::Authentic => result.push_str(FixedString256::from("AUTHENTIC")),
            VerdictKind::VerifiedWithWarnings => result.push_str(FixedString256::from("VERIFIED (with warnings)")),
            VerdictKind::Failed => result.push_str(FixedString256::from("FAILED")),
            VerdictKind::Inconclusive => result.push_str(FixedString256::from("INCONCLUSIVE")),
            VerdictKind::Tampered => result.push_str(FixedString256::from("TAMPERED")),
        }
        result.push_str(FixedString256::from(" - "));
        result.push_str(self.explanation);
        result.push_str(FixedString256::from(" [trust="));
        result.push_u32(self.resulting_trust as u32);
        result.push_str(FixedString256::from("]"));
        result
    }
}

// ──────────────────────────────────────────────
// ReplayExecutor: Replays compiler phases for oracle comparison
// ──────────────────────────────────────────────
// Evidence path: COURT-REPLAY-001 through COURT-REPLAY-015

pub struct ReplayExecutor {
    /// Source being replayed.
    pub source : FixedString256,
    /// Replayed phase receipts.
    pub receipts : Array256<CompilerReceipt>,
    /// Whether replay completed.
    pub completed : bool,
}

impl ReplayExecutor {
    pub fn new(source : FixedString256) -> ReplayExecutor [pure] {
        ReplayExecutor {
            source: source,
            receipts: Array256::new(),
            completed: false,
        }
    }

    pub fn replay_all_phases(mut self) -> ReplayExecutor [pure] {
        // Replay each compiler phase to produce fresh receipts.
        // In a real implementation, this would actually run the compiler.
        // For now, we produce placeholder receipts.
        let lex_receipt : CompilerReceipt = CompilerReceipt::Lexer(LexerReceipt::new(
            self.source.len(), 0u32, self.source.len() as u64, 0u64, 0u64,
        ));
        let _ = self.receipts.push(lex_receipt);

        let parse_receipt : CompilerReceipt = CompilerReceipt::Parser(ParserReceipt::new(
            self.source.len() / 2u32, 0u32, 0u32, 0u64, 0u64,
        ));
        let _ = self.receipts.push(parse_receipt);

        self.completed = true;
        self
    }

    pub fn compare_with_oracle(
        &self,
        oracle_receipts : Array256<CompilerReceipt>,
    ) -> ComparisonResult [pure] {
        let mut result : ComparisonResult = ComparisonResult::new();
        let mut matched : u32 = 0u32;
        let mut container_only : u32 = 0u32;
        let mut oracle_only : u32 = 0u32;

        // Compare receipts.
        // loop: bounds[BOUND_MEDIUM] — bounded by 256 receipts.
        loop: bounds[BOUND_MEDIUM] for ri in 0..self.receipts.len() {
            let our_receipt : CompilerReceipt = self.receipts.get(ri);
            let mut found_match : bool = false;

            // loop: bounds[BOUND_MEDIUM] — bounded by 256 receipts.
            loop: bounds[BOUND_MEDIUM] for oi in 0..oracle_receipts.len() {
                let oracle_receipt : CompilerReceipt = oracle_receipts.get(oi);
                if our_receipt.phase == oracle_receipt.phase {
                    found_match = true;
                }
            }

            if found_match {
                matched = matched + 1u32;
            } else {
                container_only = container_only + 1u32;
                let diff_msg : FixedString256 = FixedString256::from("receipt ") + ri + FixedString256::from(" not found in oracle");
                result = result.add_difference(diff_msg);
            }
        }

        // loop: bounds[BOUND_MEDIUM] — bounded by 256 receipts.
        loop: bounds[BOUND_MEDIUM] for oi in 0..oracle_receipts.len() {
            let mut found_in_replay : bool = false;
            // loop: bounds[BOUND_MEDIUM] — bounded by 256 receipts.
            loop: bounds[BOUND_MEDIUM] for ri in 0..self.receipts.len() {
                if self.receipts.get(ri).phase == oracle_receipts.get(oi).phase {
                    found_in_replay = true;
                }
            }
            if !found_in_replay {
                oracle_only = oracle_only + 1u32;
            }
        }

        result.matching_receipts = matched;
        result.container_only = container_only;
        result.oracle_only = oracle_only;
        result.matches = container_only == 0u32 && oracle_only == 0u32;
        result = result.compute_similarity();
        result
    }
}

// ──────────────────────────────────────────────
// TrustPromoter: Promotes trust based on verification
// ──────────────────────────────────────────────
// Evidence path: COURT-TRUST-001 through COURT-TRUST-015

pub struct TrustPromoter {
    /// Current trust level.
    pub current_trust : TrustLevel,
    /// Number of successful verifications.
    pub successful_verifications : u32,
    /// Whether promotion is possible.
    pub can_promote : bool,
}

impl TrustPromoter {
    pub fn new(current_trust : TrustLevel, successes : u32) -> TrustPromoter [pure] {
        TrustPromoter {
            current_trust: current_trust,
            successful_verifications: successes,
            can_promote: false,
        }
    }

    pub fn evaluate_promotion(mut self) -> TrustPromoter [pure] {
        // Promotion requires sufficient successful verifications.
        let required_successes : u32 = match self.current_trust {
            TrustLevel::Trust_Untrusted => 1u32,
            TrustLevel::Trust_Observed => 2u32,
            TrustLevel::Trust_Transient => 3u32,
            TrustLevel::Trust_Scoped => 4u32,
            TrustLevel::Trust_Session => 5u32,
            TrustLevel::Trust_Code => 6u32,
            TrustLevel::Trust_Signed => 7u32,
            TrustLevel::Trust_Verified => 8u32,
            TrustLevel::Trust_Attested => 9u32,
            TrustLevel::Trust_Sealed => 10u32,
            TrustLevel::Trust_Notarized => 11u32,
            TrustLevel::Trust_Endorsed => 12u32,
            TrustLevel::Trust_Privileged => 13u32,
            TrustLevel::Trust_Trusted => 14u32,
            TrustLevel::Trust_System => 15u32,
            TrustLevel::Trust_Absolute => 16u32,
        };
        self.can_promote = self.successful_verifications >= required_successes;
        self
    }

    pub fn promote(mut self) -> TrustPromoter [pure] {
        if !self.can_promote {
            return self;
        }

        let next_level : u8 = (self.current_trust as u8) + 1u8;
        if next_level <= 15u8 {
            let new_trust : TrustLevel = TrustLevel::from_u8(next_level);
            self.current_trust = new_trust;
        }
        self
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Trust: "));
        result.push_u32(self.current_trust as u32);
        result.push_str(FixedString256::from(" (verifications="));
        result.push_u32(self.successful_verifications);
        result.push_str(FixedString256::from(", can-promote="));
        if self.can_promote {
            result.push_str(FixedString256::from("yes"));
        } else {
            result.push_str(FixedString256::from("no"));
        }
        result.push_str(FixedString256::from(")"));
        result
    }
}

// ──────────────────────────────────────────────
// PhorCourt: Main court CLI tool
// ──────────────────────────────────────────────
// Evidence path: COURT-TOOL-001 through COURT-TOOL-030

pub struct PhorCourt {
    /// Active court sessions (bounded: 16 max).
    pub sessions : Array16<CourtSession>,
    /// Trust promoter for trust management.
    pub promoter : TrustPromoter,
    /// Current session index.
    pub current_session : u32,
    /// Whether the tool is initialized.
    pub initialized : bool,
}

impl PhorCourt {
    pub fn new(initial_trust : TrustLevel) -> PhorCourt [pure] {
        PhorCourt {
            sessions: Array16::new(),
            promoter: TrustPromoter::new(initial_trust, 0u32),
            current_session: 0u32,
            initialized: true,
        }
    }

    // ── Session Management ──

    pub fn create_session(
        mut self,
        session_id : FixedString256,
        created_at : u64,
    ) -> Result<PhorCourt, FixedString256> [pure] {
        if self.sessions.len() >= self.sessions.capacity() {
            return Result::Err(FixedString256::from("maximum session count reached"));
        }
        let session : CourtSession = CourtSession::new(session_id, created_at);
        let _ = self.sessions.push(session);
        self.current_session = self.sessions.len() - 1u32;
        Result::Ok(self)
    }

    pub fn get_current_session(&self) -> Result<CourtSession, FixedString256> [pure] {
        if self.current_session >= self.sessions.len() {
            return Result::Err(FixedString256::from("no active session"));
        }
        Result::Ok(self.sessions.get(self.current_session))
    }

    pub fn list_sessions(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Court Sessions:\n"));
        // loop: bounds[BOUND_TINY] — bounded by 16 sessions.
        loop: bounds[BOUND_TINY] for i in 0..self.sessions.len() {
            let session : CourtSession = self.sessions.get(i);
            result.push_str(session.format());
            result.push_str(FixedString256::from("\n"));
        }
        result
    }

    // ── Evidence Submission ──

    pub fn submit_evidence(
        mut self,
        container : SealedContainer,
    ) -> Result<PhorCourt, FixedString256> [pure] {
        let session : CourtSession = self.sessions.get(self.current_session);
        let updated : CourtSession = session.submit_evidence(container);
        self.sessions.set(self.current_session, updated);
        Result::Ok(self)
    }

    // ── Replay Execution ──

    pub fn replay_source(
        mut self,
        source : FixedString256,
    ) -> Result<PhorCourt, FixedString256> [pure] {
        let session : CourtSession = self.sessions.get(self.current_session);

        // Update session state to replaying.
        let mut replayed_session : CourtSession = CourtSession {
            state: SessionState::Replaying,
            ..session
        };

        let executor : ReplayExecutor = ReplayExecutor::new(source);
        let completed : ReplayExecutor = executor.replay_all_phases();
        replayed_session.state = SessionState::OracleCompared;

        // Compare with oracle if available.
        match replayed_session.oracle {
            Option::Some(oracle) => {
                let oracle_receipts : Array256<CompilerReceipt> = Array256::new();
                let comparison : ComparisonResult = completed.compare_with_oracle(oracle_receipts);
                replayed_session.comparison_result = comparison;
            }
            Option::None => {}
        }

        self.sessions.set(self.current_session, replayed_session);
        Result::Ok(self)
    }

    // ── Oracle Comparison ──

    pub fn set_oracle(
        mut self,
        oracle : SealedContainer,
    ) -> Result<PhorCourt, FixedString256> [pure] {
        let session : CourtSession = self.sessions.get(self.current_session);
        let updated : CourtSession = session.set_oracle(oracle);
        self.sessions.set(self.current_session, updated);
        Result::Ok(self)
    }

    pub fn perform_comparison(mut self) -> Result<PhorCourt, FixedString256> [pure] {
        let session : CourtSession = self.sessions.get(self.current_session);
        match session.oracle {
            Option::Some(_oracle) => {
                let comparison : ComparisonResult = ComparisonResult::new();
                let updated : CourtSession = CourtSession {
                    comparison_result: comparison,
                    state: SessionState::OracleCompared,
                    ..session
                };
                self.sessions.set(self.current_session, updated);
                Result::Ok(self)
            }
            Option::None => {
                Result::Err(FixedString256::from("no oracle set for comparison"))
            }
        }
    }

    // ── Verdict Rendering ──

    pub fn render_verdict(
        mut self,
        kind : VerdictKind,
        explanation : FixedString256,
    ) -> Result<PhorCourt, FixedString256> [pure] {
        let session : CourtSession = self.sessions.get(self.current_session);
        let current_trust : TrustLevel = self.promoter.current_trust;

        let new_trust : TrustLevel = match kind {
            VerdictKind::Authentic => {
                // Promotion on authentic.
                self.promoter.successful_verifications = self.promoter.successful_verifications + 1u32;
                self.promoter = self.promoter.evaluate_promotion();
                if self.promoter.can_promote {
                    self.promoter = self.promoter.promote();
                }
                self.promoter.current_trust
            }
            VerdictKind::VerifiedWithWarnings => {
                self.promoter.successful_verifications = self.promoter.successful_verifications + 1u32;
                current_trust
            }
            VerdictKind::Failed => {
                // Demote on failure.
                let failed_level : u8 = (current_trust as u8) - 1u8;
                if failed_level > 0u8 {
                    TrustLevel::from_u8(failed_level)
                } else {
                    TrustLevel::Trust_Untrusted
                }
            }
            VerdictKind::Inconclusive => {
                current_trust
            }
            VerdictKind::Tampered => {
                TrustLevel::Trust_Untrusted
            }
        };

        let verdict : Verdict = Verdict::new(kind, explanation, new_trust);
        let updated : CourtSession = session.render_verdict(verdict);
        self.sessions.set(self.current_session, updated);
        Result::Ok(self)
    }

    // ── Verdict Display ──

    pub fn display_verdict(&self) -> Result<FixedString256, FixedString256> [io] {
        let session : CourtSession = match self.get_current_session() {
            Result::Ok(s) => s,
            Result::Err(msg) => { return Result::Err(msg); }
        };
        match session.verdict {
            Option::Some(v) => {
                Result::Ok(v.format())
            }
            Option::None => {
                Result::Err(FixedString256::from("no verdict rendered yet"))
            }
        }
    }

    pub fn display_comparison(&self) -> Result<FixedString256, FixedString256> [io] {
        let session : CourtSession = match self.get_current_session() {
            Result::Ok(s) => s,
            Result::Err(msg) => { return Result::Err(msg); }
        };
        Result::Ok(session.comparison_result.format())
    }

    // ── Trust Management ──

    pub fn promote_trust(mut self) -> Result<PhorCourt, FixedString256> [pure] {
        self.promoter = self.promoter.evaluate_promotion();
        if !self.promoter.can_promote {
            return Result::Err(FixedString256::from("insufficient verifications for trust promotion"));
        }
        self.promoter = self.promoter.promote();

        let session : CourtSession = self.sessions.get(self.current_session);
        let updated : CourtSession = CourtSession {
            state: SessionState::TrustPromoted,
            ..session
        };
        self.sessions.set(self.current_session, updated);
        Result::Ok(self)
    }

    pub fn display_trust(&self) -> FixedString256 [io] {
        self.promoter.format()
    }
}

// ──────────────────────────────────────────────
// Entry point function
// ──────────────────────────────────────────────

pub fn phor_court_main(args : Array64<FixedString256>) -> Result<u8, FixedString256> [io, court] {
    if args.len() < 2u32 {
        return Result::Err(FixedString256::from("usage: phor_court <command> [options]"));
    }

    let command : FixedString256 = args.get(1u32);
    let mut court : PhorCourt = PhorCourt::new(TrustLevel::Trust_Observed);

    if command == FixedString256::from("session") {
        let session_id : FixedString256 = FixedString256::from("court-") + args.get(2u32);
        let _ = court.create_session(session_id, 0u64);
        Result::Ok(0u8)
    } else if command == FixedString256::from("list") {
        let output : FixedString256 = court.list_sessions();
        Result::Ok(0u8)
    } else if command == FixedString256::from("trust") {
        let output : FixedString256 = court.display_trust();
        Result::Ok(0u8)
    } else {
        Result::Err(FixedString256::from("unknown command: ") + command)
    }
}

// Helper function to compute signature for verdicts.

pub fn compute_verdict_signature(kind : VerdictKind, explanation : FixedString256) -> u64 [pure] {
    var hash : u64 = 14695981039346656037u64;
    hash ^= kind as u64;
    hash *= 1099511628211u64;
    // loop: bounds[BOUND_MEDIUM] — bounded by explanation length.
    loop: bounds[BOUND_MEDIUM] for i in 0..explanation.len() {
        hash ^= explanation.get_byte(i) as u64;
        hash *= 1099511628211u64;
    }
    hash
}

// ──────────────────────────────────────────────
// EvidenceSubmissionHandler: Processes evidence submissions
// ──────────────────────────────────────────────
// Handles the lifecycle of evidence from submission through
// verification. Evidence path: COURT-EVIDENCE-001 through COURT-EVIDENCE-020

pub struct EvidenceSubmissionHandler {
    /// Number of evidence items submitted.
    pub submission_count : u32,
    /// Number of evidence items verified.
    pub verified_count : u32,
    /// Whether the submission handler is active.
    pub active : bool,
}

impl EvidenceSubmissionHandler {
    pub fn new() -> EvidenceSubmissionHandler [pure] {
        EvidenceSubmissionHandler {
            submission_count: 0u32,
            verified_count: 0u32,
            active: false,
        }
    }

    pub fn submit(mut self, container : SealedContainer, session : CourtSession) -> Result<(EvidenceSubmissionHandler, CourtSession), FixedString256> [pure] {
        self.submission_count = self.submission_count + 1u32;
        let updated_session : CourtSession = session.submit_evidence(container);
        self.active = true;
        Result::Ok((self, updated_session))
    }

    pub fn verify_evidence(container : SealedContainer) -> Result<bool, FixedString256> [pure] {
        // Verify the seal integrity.
        if container.status == SealStatus::Invalid {
            return Result::Err(FixedString256::from("evidence seal is invalid"));
        }
        if container.status == SealStatus::Error {
            return Result::Err(FixedString256::from("evidence seal verification error"));
        }
        Result::Ok(true)
    }

    pub fn format_submission_report(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Evidence Submissions: "));
        result.push_u32(self.submission_count);
        result.push_str(FixedString256::from(" submitted, "));
        result.push_u32(self.verified_count);
        result.push_str(FixedString256::from(" verified"));
        result
    }
}

// ──────────────────────────────────────────────
// CourtReporter: Formats and reports court proceedings
// ──────────────────────────────────────────────
// Generates human-readable reports of court sessions, evidence
// evaluations, and verdicts.
// Evidence path: COURT-REPORT-001 through COURT-REPORT-020

pub struct CourtReporter {
    /// Session being reported.
    pub session : CourtSession,
    /// Report content.
    pub report : FixedString256,
    /// Whether the report is complete.
    pub complete : bool,
}

impl CourtReporter {
    pub fn new(session : CourtSession) -> CourtReporter [pure] {
        CourtReporter {
            session: session,
            report: FixedString256::new(),
            complete: false,
        }
    }

    pub fn generate_report(mut self) -> CourtReporter [io] {
        var report : FixedString256 = FixedString256::new();
        report.push_str(FixedString256::from("═══════════════════════════════════════\n"));
        report.push_str(FixedString256::from("  PHORENSIC COURT PROCEEDING\n"));
        report.push_str(FixedString256::from("═══════════════════════════════════════\n\n"));
        report.push_str(FixedString256::from("Session ID: "));
        report.push_str(self.session.session_id);
        report.push_str(FixedString256::from("\n"));
        report.push_str(FixedString256::from("State: "));
        report.push_str(self.session.state_name());
        report.push_str(FixedString256::from("\n"));
        report.push_str(FixedString256::from("Witnesses: "));
        report.push_u32(self.session.witnesses.len());
        report.push_str(FixedString256::from("\n\n"));

        report.push_str(FixedString256::from("── Comparison ──\n"));
        report.push_str(self.session.comparison_result.format());
        report.push_str(FixedString256::from("\n\n"));

        match self.session.verdict {
            Option::Some(v) => {
                report.push_str(FixedString256::from("── Verdict ──\n"));
                report.push_str(v.format());
                report.push_str(FixedString256::from("\n\n"));
            }
            Option::None => {
                report.push_str(FixedString256::from("── Verdict: PENDING ──\n\n"));
            }
        }

        report.push_str(FixedString256::from("═══════════════════════════════════════\n"));

        self.report = report;
        self.complete = true;
        self
    }

    pub fn get_report(&self) -> FixedString256 [pure] {
        self.report
    }
}

// ──────────────────────────────────────────────
// CourtOracleManager: Manages oracle containers
// ──────────────────────────────────────────────
// Evidence path: COURT-ORACLE-001 through COURT-ORACLE-015

pub struct CourtOracleManager {
    /// Registered oracles (bounded: 16 max).
    pub oracles : Array16<FixedString256>,
    /// Default oracle path.
    pub default_oracle : FixedString256,
}

impl CourtOracleManager {
    pub fn new(default_oracle : FixedString256) -> CourtOracleManager [pure] {
        CourtOracleManager {
            oracles: Array16::new(),
            default_oracle: default_oracle,
        }
    }

    pub fn register_oracle(mut self, name : FixedString256) -> CourtOracleManager [pure] {
        if self.oracles.len() < self.oracles.capacity() {
            let _ = self.oracles.push(name);
        }
        self
    }

    pub fn list_oracles(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Registered oracles:\n"));
        // loop: bounds[BOUND_TINY] — bounded by 16 oracles.
        loop: bounds[BOUND_TINY] for i in 0..self.oracles.len() {
            result.push_str(FixedString256::from("  - "));
            result.push_str(self.oracles.get(i));
            result.push_str(FixedString256::from("\n"));
        }
        if self.oracles.len() == 0u32 {
            result.push_str(FixedString256::from("  (none registered)\n"));
        }
        result
    }

    pub fn load_oracle(path : FixedString256) -> Result<SealedContainer, FixedString256> [io] {
        // In a real implementation, deserialize the oracle container.
        Result::Err(FixedString256::from("oracle loading not implemented"))
    }
}

// ──────────────────────────────────────────────
// WitnessManager: Manages court witnesses
// ──────────────────────────────────────────────
// Evidence path: COURT-WITNESS-001 through COURT-WITNESS-015

pub struct WitnessManager {
    /// Registered witnesses (bounded: 32 max).
    pub witnesses : Array32<FixedString256>,
    /// Whether witness attestation is required.
    pub attestation_required : bool,
}

impl WitnessManager {
    pub fn new(attestation_required : bool) -> WitnessManager [pure] {
        WitnessManager {
            witnesses: Array32::new(),
            attestation_required: attestation_required,
        }
    }

    pub fn register_witness(mut self, name : FixedString256) -> WitnessManager [pure] {
        if self.witnesses.len() < self.witnesses.capacity() {
            let _ = self.witnesses.push(name);
        }
        self
    }

    pub fn witness_count(&self) -> u32 [pure] {
        self.witnesses.len()
    }

    pub fn has_quorum(&self, required : u32) -> bool [pure] {
        self.witnesses.len() >= required
    }

    pub fn list_witnesses(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Witnesses:\n"));
        // loop: bounds[BOUND_SMALL] — bounded by 32 witnesses.
        loop: bounds[BOUND_SMALL] for i in 0..self.witnesses.len() {
            result.push_str(FixedString256::from("  - "));
            result.push_str(self.witnesses.get(i));
            result.push_str(FixedString256::from("\n"));
        }
        result
    }
}
