    major_version: u8,
    minor_version: u8,
    docrev: u8,
    entry_point_revision: u8,
    reserved: u8,
    table_max_size: Word32,
    table_address: Word64,
}

impl SMBIOSEntryPoint64 {
    pub fn new() -> SMBIOSEntryPoint64
        effects: [deterministic]
    {
        SMBIOSEntryPoint64 {
            anchor: FixedString::new(),
            checksum: 0,
            length: 0,
            major_version: 0,
            minor_version: 0,
            docrev: 0,
            entry_point_revision: 0,
            reserved: 0,
            table_max_size: 0,
            table_address: Word64::zero(),
        }
    }

    pub fn validate(self) -> bool
        effects: [deterministic]
    {
        self.anchor == SMBIOS_ANCHOR_64
    }

    pub fn version_string(self) -> FixedString[16]
        effects: [deterministic]
    {
        let mut s: FixedString[16] = FixedString::new()
        s.append_int(self.major_version)
        s.append_byte('.')!
        s.append_int(self.minor_version)
        s
    }

    pub fn table_address(self) -> Word64
        effects: [deterministic]
    {
        self.table_address
    }
}

// ──────────────────────────────────────────────
// SMBIOS Structure Header
// ──────────────────────────────────────────────

pub type SMBIOSHeader : struct {
    struct_type: u8,
    length: u8,
    handle: Word16,
}

impl SMBIOSHeader {
    pub fn new() -> SMBIOSHeader
        effects: [deterministic]
    {
        SMBIOSHeader {
            struct_type: 0,
            length: 0,
            handle: 0,
        }
    }

    pub fn type_name(self) -> FixedString[32]
        effects: [deterministic]
    {
        match self.struct_type {
            SMBIOS_TYPE_BIOS_INFO => FixedString::from("BIOS Information"),
            SMBIOS_TYPE_SYSTEM_INFO => FixedString::from("System Information"),
            SMBIOS_TYPE_BASEBOARD => FixedString::from("Baseboard Information"),
            SMBIOS_TYPE_CHASSIS => FixedString::from("Chassis Information"),
            SMBIOS_TYPE_PROCESSOR => FixedString::from("Processor Information"),
            SMBIOS_TYPE_MEMORY_CONTROLLER => FixedString::from("Memory Controller"),
            SMBIOS_TYPE_MEMORY_MODULE => FixedString::from("Memory Module"),
            SMBIOS_TYPE_CACHE => FixedString::from("Cache Information"),
            SMBIOS_TYPE_PORT_CONNECTOR => FixedString::from("Port Connector"),
            SMBIOS_TYPE_SLOT => FixedString::from("System Slots"),
            SMBIOS_TYPE_OEM_STRINGS => FixedString::from("OEM Strings"),
            SMBIOS_TYPE_PHYSICAL_MEMORY_ARRAY => FixedString::from("Physical Memory Array"),
            SMBIOS_TYPE_MEMORY_DEVICE => FixedString::from("Memory Device"),
            SMBIOS_TYPE_TPM => FixedString::from("TPM Device"),
            SMBIOS_TYPE_FIRMWARE_INVENTORY => FixedString::from("Firmware Inventory"),
            SMBIOS_TYPE_END_OF_TABLE => FixedString::from("End of Table"),
            _ => {
                let mut s: FixedString[32] = FixedString::new()
                s.append_str(FixedString::from("Type "))
                s.append_int(self.struct_type)
                s
            },
        }
    }
}

// ──────────────────────────────────────────────
// String Table Parsing
// ──────────────────────────────────────────────

pub fn get_smbios_string(data: &[u8], struct_offset: u32, header_length: u8, string_index: u8) -> FixedString[MAX_STRING_LEN]
    effects: [deterministic]
{
    if string_index == 0 {
        return FixedString::new()  // 0 means null
    }

    let mut current_index: u8 = 1
    let mut offset: u32 = struct_offset + header_length as u32

    loop: bounds[BOUND_LARGE] while offset < data.len() as u32 {
        let mut string: FixedString[MAX_STRING_LEN] = FixedString::new()

        loop: bounds[BOUND_MEDIUM] while offset < data.len() as u32 {
            let ch: u8 = data[offset as usize]
            if ch == 0 {
                offset = offset + 1
                break
            }
            string.append_byte(ch)!
            offset = offset + 1
        }

        if current_index == string_index {
            return string
        }

        current_index = current_index + 1

        // Check for double-null (end of strings)
        if offset < data.len() as u32 && data[offset as usize] == 0 {
            break
        }
    }

    FixedString::new()
}

pub fn extract_all_strings(data: &[u8], struct_offset: u32, header_length: u8) -> FixedArray[MAX_DMI_STRINGS, FixedString[MAX_STRING_LEN]]
    effects: [deterministic]
{
    let mut strings: FixedArray[MAX_DMI_STRINGS, FixedString[MAX_STRING_LEN]] = FixedArray::new()
    let mut offset: u32 = struct_offset + header_length as u32

    loop: bounds[BOUND_LARGE] while offset < data.len() as u32 {
        let mut string: FixedString[MAX_STRING_LEN] = FixedString::new()

        loop: bounds[BOUND_MEDIUM] while offset < data.len() as u32 {
            let ch: u8 = data[offset as usize]
            if ch == 0 {
                offset = offset + 1
                break
            }
            string.append_byte(ch)!
            offset = offset + 1
        }

        if string.len() == 0 {
            // Double null = end of strings
            break
        }

        strings.push(string)!
    }

    strings
}

// ──────────────────────────────────────────────
// BIOS Information (Type 0)
// ──────────────────────────────────────────────

pub type BIOSInfo : struct {
    header: SMBIOSHeader,
    vendor: FixedString[MAX_STRING_LEN],
    bios_version: FixedString[MAX_STRING_LEN],
    bios_starting_segment: Word16,
    bios_release_date: FixedString[MAX_STRING_LEN],
    bios_rom_size: u8,
    bios_characteristics: FixedArray[8, u64],
    bios_characteristic_bytes: FixedArray[2, u8],
    system_bios_major: u8,
    system_bios_minor: u8,
    embedded_firmware_major: u8,
    embedded_firmware_minor: u8,
}

impl BIOSInfo {
    pub fn new() -> BIOSInfo
        effects: [deterministic]
    {
        BIOSInfo {
            header: SMBIOSHeader::new(),
            vendor: FixedString::new(),
            bios_version: FixedString::new(),
            bios_starting_segment: 0,
            bios_release_date: FixedString::new(),
            bios_rom_size: 0,
            bios_characteristics: FixedArray::new(),
            bios_characteristic_bytes: FixedArray::new(),
            system_bios_major: 0,
            system_bios_minor: 0,
            embedded_firmware_major: 0,
            embedded_firmware_minor: 0,
        }
    }

    pub fn bios_size_kb(self) -> u32
        effects: [deterministic]
    {
        // Size = (bios_rom_size + 1) * 64KB
        (self.bios_rom_size as u32 + 1) * 64
    }

    pub fn has_floppy_support(self) -> bool
        effects: [deterministic]
    {
        (self.bios_characteristic_bytes.get(0)! & 0x01) != 0
    }
}

