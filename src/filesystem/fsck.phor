    // ──────────────────────────────────────────────
    // Fsck Progress Tracking
    // ──────────────────────────────────────────────
    // Evidence path: FSCK-PROGRESS-001 through FSCK-PROGRESS-015

    pub type FsckProgress : struct {
        current_pass: Word32,
        total_passes: Word32,
        items_scanned: Word64,
        items_total: Word64,
        errors_found: Word32,
        errors_repaired: Word32,
        started_at: Word64,
    }

    impl FsckProgress {
        pub fn new(total: Word32) -> FsckProgress
            effects: [deterministic]
        {
            FsckProgress {
                current_pass: Word32::from_u32(1),
                total_passes: total,
                items_scanned: Word64::zero(),
                items_total: Word64::zero(),
                errors_found: Word32::from_u32(0),
                errors_repaired: Word32::from_u32(0),
                started_at: __builtin_timestamp(),
            }
        }

        pub fn percentage(self) -> Word32
            effects: [deterministic]
        {
            if self.items_total.is_zero() { return Word32::from_u32(0) }
            let pct: Word64 = self.items_scanned.checked_mul(Word64::from_u64(100)).unwrap_or(Word64::zero())
                .checked_div(self.items_total).unwrap_or(Word64::zero())
            Word32::from_u32(pct.to_u32())
        }

        pub fn advance_pass(self: ref mut)
            effects: [deterministic]
        {
            self.current_pass = self.current_pass.checked_add(Word32::from_u32(1)).unwrap_or(self.current_pass)
        }

        pub fn record_error(self: ref mut)
            effects: [deterministic]
        {
            self.errors_found = self.errors_found.checked_add(Word32::from_u32(1)).unwrap_or(self.errors_found)
        }

        pub fn record_repair(self: ref mut)
            effects: [deterministic]
        {
            self.errors_repaired = self.errors_repaired.checked_add(Word32::from_u32(1)).unwrap_or(self.errors_repaired)
        }

        pub fn residual_progress(self)
            effects: [io, deterministic]
        {
            residual emit {
                subsystem: "fsck",
                operation: "progress",
                pass: self.current_pass,
                scanned: self.items_scanned,
                total: self.items_total,
                pct: self.percentage(),
                errors: self.errors_found,
                repaired: self.errors_repaired,
                timestamp: __builtin_timestamp(),
            }
        }
    }

