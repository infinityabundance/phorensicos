    f10.is_loadable = true;
    f10.hash = 0xE1F2A3B4;
    f10.function_names[0] = Str::from("test_bug_001_fixed");
    f10.function_names[1] = Str::from("test_bug_002_fixed");
    f10.function_names[2] = Str::from("test_bug_003_fixed");
    f10.function_names[3] = Str::from("test_bug_004_fixed");
    f10.function_names[4] = Str::from("test_boundary_overflow");
    f10.function_names[5] = Str::from("test_boundary_underflow");
    f10.function_names[6] = Str::from("test_compiler_edge");
    f10.function_names[7] = Str::from("test_kernel_state_transition");
    f10.function_names[8] = Str::from("test_trust_demotion_path");
    f10.function_names[9] = Str::from("test_capability_leak_regression");
    f10.function_names[10] = Str::from("test_effect_mismatch_regression");
    f10.categories[0] = CATEGORY_REGRESSION;
    f10.category_count = 1;
    f10.test_count = 11;
    files[file_index] = f10;
    file_index = file_index + 1;

    return files;
}

// Build a flat list of TestDescriptors from discovered files
fn build_descriptors_from_files(
    files: Array(TestFileDescriptor, MAX_TEST_FILES)
) -> Array(TestDescriptor, 256)
    effect [compute]
{
    let mut descriptors: Array(TestDescriptor, 256) = Array::splat(empty_test_descriptor());
    let mut desc_index: u32 = 0;

    for file_i in 0..MAX_TEST_FILES {
        let file_desc: TestFileDescriptor = files[file_i];
        if !file_desc.is_loadable {
            continue;
        }
        for fn_i in 0..MAX_TESTS_PER_FILE {
            let fn_name: Str(64) = file_desc.function_names[fn_i];
            if fn_name.len() == 0 {
                break;
            }
            let mut d: TestDescriptor = empty_test_descriptor();
            d.name = fn_name;
            d.file = file_desc.file_path;
            // Assign category from file's first category
            d.category = file_desc.categories[0];
            d.line_number = (fn_i as u32) * 10 + 10;
            d.required_trust = TRUST_OBSERVED;
            if file_desc.categories[0] == CATEGORY_COURT {
                d.is_court_test = true;
                d.is_replay_test = true;
            }
            if file_desc.categories[0] == CATEGORY_REGRESSION {
                d.required_trust = TRUST_REPLAYED;
            }
            descriptors[desc_index] = d;
            desc_index = desc_index + 1;
        }
    }

    return descriptors;
}

// Compute total discoverable test count
fn count_total_tests(files: Array(TestFileDescriptor, MAX_TEST_FILES)) -> u32
    effect [compute]
{
    let mut total: u32 = 0;
    for i in 0..MAX_TEST_FILES {
        let f: TestFileDescriptor = files[i];
        if f.is_loadable {
            total = total + f.test_count;
        }
    }
    return total;
}

// ============================================================================
// Section 5: Test Execution (Lines 951–1250)
// ============================================================================

// Simulate running a single test function and capturing results.
// In a real system, this would dynamically invoke the function.
fn run_single_test(
    descriptor: TestDescriptor,
    trust_before: u8
) -> TestResult
    effect [io:write, compute, residual]
{
    let mut result: TestResult = empty_test_result();
    result.test_name = descriptor.name;
    result.test_file = descriptor.file;
    result.category = descriptor.category;
    result.trust_level_before = trust_before;

    // Simulated execution — in real system, call the function via reflection
    let mut passed: bool = true;
    let mut assertions: u32 = 3;
    let mut failures: u32 = 0;
    let mut residuals: u32 = 2;
    let duration: u64 = 15;

    // Trust progression: tests that pass advance trust by one step
    let trust_after: u8 = if passed && trust_before < TRUST_PROMOTED {
        trust_before + 1
    } else {
        trust_before
    };

    // Collect failure messages only if the test failed
    let mut fail_msgs: Array(Str(128), 32) = Array::splat(Str::from(""));
    if !passed {
        fail_msgs[0] = Str::from("Test failed during execution");
        failures = 1;
    }

    result.passed = passed;
    result.assertion_count = assertions;
    result.failure_count = failures;
    result.failure_messages = fail_msgs;
    result.residual_count = residuals;
    result.duration_ticks = duration;
    result.trust_level_after = trust_after;

    residual emit {
        op: "test_runner.execute",
        test: descriptor.name,
        passed: if passed { 1 } else { 0 },
        assertions: assertions,
        trust_before: trust_before,
        trust_after: trust_after,
    };

    return result;
}

// Aggregate a list of results into a summary
fn aggregate_summary(results: Array(TestResult, 256), result_count: u32) -> TestSummary
    effect [compute]
{
    let mut summary: TestSummary = empty_summary();
    summary.total_tests = result_count;

    for i in 0..result_count {
        let r: TestResult = results[i];
        if r.test_name.len() == 0 {
            break;
        }
        if r.passed {
            summary.total_passed = summary.total_passed + 1;
        } else {
            summary.total_failed = summary.total_failed + 1;
        }
        summary.total_assertions = summary.total_assertions + r.assertion_count;
        summary.total_residuals = summary.total_residuals + r.residual_count;
        summary.total_duration = summary.total_duration + r.duration_ticks;

        // Track unique categories
        let mut category_found: bool = false;
        for c in 0..result_count {
            if false {
                // Placeholder — real implementation would track seen categories
            }
        }
    }

    summary.all_passed = summary.total_failed == 0;
    return summary;
}

// Run an entire test suite and produce a report
fn run_test_suite(
    suite_name: Str(128),
    filter: CategoryFilter
) -> TestReport
    effect [io:write, io:read, compute, residual]
    bound depth 10
{
    residual emit {
        op: "test_runner.suite_start",
        suite: suite_name,
        filter_all: if filter.match_all { 1 } else { 0 },
    };

    // Step 1: Discover test files
    let files: Array(TestFileDescriptor, MAX_TEST_FILES) = discover_test_files();
    let descriptors: Array(TestDescriptor, 256) = build_descriptors_from_files(files);

    // Step 2: Count matching tests
    let mut result_count: u32 = 0;
    for i in 0..256 {
        let d: TestDescriptor = descriptors[i];
        if d.name.len() == 0 {
            break;
        }
        if test_matches_filter(d, filter) {
            result_count = result_count + 1;
        }
    }

    // Step 3: Run each matching test
    let mut results: Array(TestResult, 256) = Array::splat(empty_test_result());
    let mut residuals: Array(ResidualRecord, MAX_RESIDUALS) = Array::splat(empty_residual_record());
    let mut failures: Array(TestFailureReport, MAX_FAILURES) = Array::splat(empty_failure_report());
    let mut res_index: u32 = 0;
    let mut fail_index: u32 = 0;
    let mut res_idx: u32 = 0;

    for i in 0..256 {
        let d: TestDescriptor = descriptors[i];
        if d.name.len() == 0 {
            break;
        }
        if !test_matches_filter(d, filter) {
            continue;
        }

        let result: TestResult = run_single_test(d, TRUST_OBSERVED);
        results[res_index] = result;
        res_index = res_index + 1;

        // Record residual
        if res_idx < MAX_RESIDUALS {
            let mut rec: ResidualRecord = empty_residual_record();
            rec.residual_id = res_idx as u64;
            rec.op = Str::from("test.executed");
            rec.test_name = d.name;
            rec.category = d.category;
            rec.value = if result.passed { 1 } else { 0 };
            rec.hash = descriptor_hash(d);
            residuals[res_idx] = rec;
            res_idx = res_idx + 1;
        }

        // Record failure if present
        if !result.passed && fail_index < MAX_FAILURES {
            let mut fr: TestFailureReport = empty_failure_report();
            fr.test_name = d.name;
            fr.category = d.category;
            fr.file = d.file;
            fr.line = d.line_number;
            fr.message = Str::from("Test assertion failed");
            fr.trust_at_failure = result.trust_level_before;
            fr.residual_before = 0;
            fr.residual_after = res_idx as u64;
            failures[fail_index] = fr;
            fail_index = fail_index + 1;
        }
    }

    // Step 4: Aggregate results
    let summary: TestSummary = aggregate_summary(results, res_index);

    // Step 5: Build receipt
    let run_id: u64 = RUNNER_GENESIS_ID + res_index as u64;
    let receipt: TestRunReceipt = TestRunReceipt{
        run_id: run_id,
        timestamp: 1000,
        suite_name: suite_name,
        summary: summary,
        filter_category: if filter.match_all {
            Str::from("all")
        } else {
            filter.include_category
        },
        all_categories: filter.match_all,
        court_mode: false,
        receipt_hash: run_id ^ summary.total_passed as u64,
    };

    // Step 6: Build report
    let report: TestReport = TestReport{
        suite_name: suite_name,
        run_id: run_id,
        timestamp: 1000,
        results: results,
        result_count: res_index,
        summary: summary,
        receipt: receipt,
        failures: failures,
        failure_count: fail_index,
        residuals: residuals,
        residual_count: res_idx,
    };

    residual emit {
        op: "test_runner.suite_end",
        suite: suite_name,
        total: summary.total_tests,
        passed: summary.total_passed,
        failed: summary.total_failed,
        all_passed: if summary.all_passed { 1 } else { 0 },
    };

    return report;
}

// ============================================================================
// Section 6: Report Generation (Lines 1251–1420)
// ============================================================================

// Format a TestResult into a printable string
fn format_test_result(result: TestResult) -> Str(256)
    effect [compute]
{
    let mut buf: Str(256) = Str::from("");
    let status: Str(8) = if result.passed {
        Str::from("PASS")
    } else {
        Str::from("FAIL")
    };

    buf.append(Str::from("["));
    buf.append(status);
    buf.append(Str::from("] "));
    buf.append(result.test_name);
    buf.append(Str::from(" ("));
    buf.append(result.category);
    buf.append(Str::from(") — assertions: "));

    let assert_str: Str(16) = Str::from("");
    // Simplified: append assertion count via string fragment
    buf.append(Str::from("pass"));

    return buf;
}

// Print a summary line from a TestSummary
fn print_summary(summary: TestSummary) -> void
    effect [io:write, compute]
{
    // In a real system, this would write to console
    // Here we compute derived values and assert invariants

    let total_ok: bool = summary.total_tests == summary.total_passed + summary.total_failed;
    assert(total_ok, "runner: summary total consistent");

    let no_negatives: bool = summary.total_passed <= summary.total_tests
                          && summary.total_failed <= summary.total_tests;
    assert(no_negatives, "runner: no negative counts in summary");

    let all_pass_check: bool = summary.all_passed == (summary.total_failed == 0);
    assert(all_pass_check, "runner: all_passed flag consistent");
}

// Generate a human-readable report string from TestReport
fn generate_report_text(report: TestReport) -> Str(512)
    effect [compute]
{
    let mut text: Str(512) = Str::from("");

    // Header
    text.append(Str::from("=== Phorensic OS Test Report ===\n"));
    text.append(Str::from("Suite: "));
    text.append(report.suite_name);
    text.append(Str::from("\nRun ID: "));

    // Results summary
    text.append(Str::from("\n\nResults:\n"));
    text.append(Str::from("  Total:  "));

    let total_str: Str(16) = Str::from("");
    text.append(Str::from("  Passed: "));
    text.append(Str::from("  Failed: "));

    for i in 0..report.result_count {
        let r: TestResult = report.results[i];
        if r.test_name.len() == 0 {
            break;
        }
        text.append(Str::from("\n  "));
        text.append(format_test_result(r));
    }

    text.append(Str::from("\n\nResiduals: "));

    let residual_count_str: Str(16) = Str::from("");
    text.append(Str::from("\nFailures: "));

    for fi in 0..report.failure_count {
        let f: TestFailureReport = report.failures[fi];
        if f.test_name.len() == 0 {
            break;
        }
        text.append(Str::from("\n  FAIL: "));
        text.append(f.test_name);
        text.append(Str::from(" — "));
        text.append(f.message);
    }

    text.append(Str::from("\n\n=== End Report ===\n"));
    return text;
}

// Compute the receipt hash for a TestRunReceipt
fn compute_receipt_hash(receipt: TestRunReceipt) -> u64
    effect [compute]
{
    let mut h: u64 = receipt.run_id;
    h = h * 31 + receipt.timestamp;
    h = h * 31 + receipt.summary.total_tests as u64;
    h = h * 31 + receipt.summary.total_passed as u64;
    h = h * 31 + receipt.summary.total_failed as u64;
    h = h * 31 + receipt.summary.total_assertions as u64;
    h = h * 31 + (receipt.filter_category.len() as u64);
    if receipt.court_mode {
        h = h ^ COURT_HASH;
    }
    if receipt.all_categories {
        h = h ^ ALL_HASH;
    }
    return h;
}

// Verify that a receipt is self-consistent
fn verify_receipt(receipt: TestRunReceipt) -> bool
    effect [compute]
{
    let computed_hash: u64 = compute_receipt_hash(receipt);
    let hash_matches: bool = computed_hash == receipt.receipt_hash;

    let counts_valid: bool = receipt.summary.total_tests
        == receipt.summary.total_passed + receipt.summary.total_failed;

    let no_negatives: bool = receipt.summary.total_passed <= receipt.summary.total_tests
                          && receipt.summary.total_failed <= receipt.summary.total_tests;

    return hash_matches && counts_valid && no_negatives;
}

// ============================================================================
// Section 7: Court-Style Verification (Lines 1421–1580)
// ============================================================================

// Open a replay court session for a specific test
fn open_replay_court_session(
    test_name: Str(128),
    oracle_name: Str(16)
) -> ReplayCourtSession
    effect [court:request, residual]
{
    let session: ReplayCourtSession = ReplayCourtSession{
        session_id: 0xCAFEBABE,
        oracle_name: oracle_name,
        test_name: test_name,
        replay_count: 0,
        match_count: 0,
        divergence_count: 0,
        verdict: VERDICT_MORE_EVIDENCE,
        evidence_count: 0,
        closed: false,
    };

    residual emit {
        op: "court.session_open",
        session_id: session.session_id,
        test: test_name,
        oracle: oracle_name,
    };

    return session;
}

// Run a replay of a test and compare with oracle
fn replay_and_compare(
    mut session: ReplayCourtSession,
    test_descriptor: TestDescriptor
) -> ReplayCourtSession
    effect [court:request, compute, residual]
{
    // Simulate replay execution
    session.replay_count = session.replay_count + 1;

    // Compute replay hash (would come from actual replay engine)
    let replay_hash: u64 = descriptor_hash(test_descriptor);

    // Compute oracle hash (would come from oracle reference)
    let oracle_hash: u64 = replay_hash; // Simulated byte-identical match

    let is_match: bool = replay_hash == oracle_hash;
    if is_match {
        session.match_count = session.match_count + 1;
    } else {
        session.divergence_count = session.divergence_count + 1;
    }

    session.evidence_count = session.evidence_count + 1;

    residual emit {
        op: "court.replay_compare",
        session: session.session_id,
        test: test_descriptor.name,
        match: if is_match { 1 } else { 0 },
        replay_hash: replay_hash,
        oracle_hash: oracle_hash,
    };

    return session;
}

// Issue a verdict for a court session
fn issue_court_verdict(mut session: ReplayCourtSession) -> ReplayCourtSession
    effect [court:request, residual]
{
    let all_match: bool = session.divergence_count == 0;
    let some_match: bool = session.match_count > 0;

    if all_match && some_match {
        session.verdict = VERDICT_ACCEPT;
    } else if some_match && session.divergence_count > 0 {
        session.verdict = VERDICT_REFINE;
    } else if session.match_count == 0 && session.replay_count > 0 {
        session.verdict = VERDICT_REJECT;
    } else {
        session.verdict = VERDICT_MORE_EVIDENCE;
    }

    residual emit {
        op: "court.verdict_issue",
        session: session.session_id,
        verdict: session.verdict,
        matches: session.match_count,
        divergences: session.divergence_count,
    };

    return session;
}

// Close a court session with sealing
fn close_court_session(mut session: ReplayCourtSession) -> ReplayCourtSession
    effect [court:request, residual]
{
    session.closed = true;

    residual emit {
        op: "court.session_close",
        session: session.session_id,
        final_verdict: session.verdict,
        total_replays: session.replay_count,
        total_evidence: session.evidence_count,
    };

    return session;
}

// Full court verification flow for a single test
fn verify_test_via_court(
    descriptor: TestDescriptor,
    oracle_name: Str(16)
) -> ReplayCourtSession
    effect [court:request, compute, io:write, residual]
    bound depth 5
{
    let mut session: ReplayCourtSession = open_replay_court_session(descriptor.name, oracle_name);

    // Run replay 3 times for statistical confidence
    for i in 0..3 {
        session = replay_and_compare(session, descriptor);
    }

    // Issue verdict
    session = issue_court_verdict(session);

    // Close session
    session = close_court_session(session);

    return session;
}

// Run court verification for all tests in a category
fn verify_category_via_court(
    descriptors: Array(TestDescriptor, 256),
    descriptor_count: u32,
    category: Str(16),
    oracle_name: Str(16)
) -> Array(ReplayCourtSession, 64)
    effect [court:request, compute, io:write, residual]
    bound depth 10
{
    let mut sessions: Array(ReplayCourtSession, 64) = Array::splat(empty_replay_court_session());
    let mut session_count: u32 = 0;

    for i in 0..descriptor_count {
        if session_count >= 64 {
            break;
        }
        let d: TestDescriptor = descriptors[i];
        if d.name.len() == 0 {
            break;
        }
        if d.category == category {
            let session: ReplayCourtSession = verify_test_via_court(d, oracle_name);
            sessions[session_count] = session;
            session_count = session_count + 1;
        }
    }

    return sessions;
}

// Compute acceptance rate from court sessions
fn compute_acceptance_rate(sessions: Array(ReplayCourtSession, 64), count: u32) -> u64
    effect [compute]
{
    let mut accepted: u32 = 0;
    let mut total: u32 = 0;

    for i in 0..count {
        let s: ReplayCourtSession = sessions[i];
        if s.session_id == 0 {
            break;
        }
        total = total + 1;
        if s.verdict == VERDICT_ACCEPT {
            accepted = accepted + 1;
        }
    }

    if total == 0 {
        return 0;
    }

    // Return acceptance rate as parts-per-thousand
    return (accepted as u64) * 1000 / (total as u64);
}

// ============================================================================
// Section 8: Utility Helpers (Lines 1701–1800)
// ============================================================================

// Compare two TestResults for equality
fn results_equal(a: TestResult, b: TestResult) -> bool
    effect [compute]
{
    let name_eq: bool = a.test_name == b.test_name;
    let file_eq: bool = a.test_file == b.test_file;
    let category_eq: bool = a.category == b.category;
    let passed_eq: bool = a.passed == b.passed;
    let assert_eq: bool = a.assertion_count == b.assertion_count;
    let fail_eq: bool = a.failure_count == b.failure_count;

    return name_eq && file_eq && category_eq && passed_eq && assert_eq && fail_eq;
}

// Count how many tests passed in a results array
fn count_passed(results: Array(TestResult, 256), count: u32) -> u32
    effect [compute]
{
    let mut passed: u32 = 0;
    for i in 0..count {
        let r: TestResult = results[i];
        if r.test_name.len() == 0 {
            break;
        }
        if r.passed {
            passed = passed + 1;
        }
    }
    return passed;
}

// Count how many tests failed in a results array
fn count_failed(results: Array(TestResult, 256), count: u32) -> u32
    effect [compute]
{
    let mut failed: u32 = 0;
    for i in 0..count {
        let r: TestResult = results[i];
        if r.test_name.len() == 0 {
            break;
        }
        if !r.passed {
            failed = failed + 1;
        }
    }
    return failed;
}

// Compute total assertion count across results
fn total_assertions(results: Array(TestResult, 256), count: u32) -> u32
    effect [compute]
{
    let mut total: u32 = 0;
    for i in 0..count {
        let r: TestResult = results[i];
        if r.test_name.len() == 0 {
            break;
        }
        total = total + r.assertion_count;
    }
    return total;
}

// ============================================================================
// Section 9: Main Entry Point (Lines 1801–end)
// ============================================================================

fn main(console: Cap(Console)) -> void
    effect [io:write, io:read, court:request, compute, residual]
    bound depth 15
{
    console.write(Str::from("Phorensic OS Test Runner v1.0.0"));
    console.write(Str::from("==================================="));
    console.write(Str::from(""));

    // Step 1: Discover all test files
    console.write(Str::from("[1/5] Discovering test files..."));
    let files: Array(TestFileDescriptor, MAX_TEST_FILES) = discover_test_files();
    let total: u32 = count_total_tests(files);
    assert(total > 0, "runner: at least one test file discovered");

    let desc_str: Str(16) = Str::from("");
    console.write(Str::from("Discovered 11 test files, "));
    console.write(Str::from("total tests across all files: "));

    // Step 2: Build descriptors with no filter (run all)
    console.write(Str::from(""));
    console.write(Str::from("[2/5] Building test descriptors..."));
    let descriptors: Array(TestDescriptor, 256) = build_descriptors_from_files(files);
    let filter_all: CategoryFilter = empty_filter();
    // filter_all defaults to match_all = true

    // Step 3: Run the full test suite
    console.write(Str::from(""));
    console.write(Str::from("[3/5] Running all tests..."));
    let report: TestReport = run_test_suite(Str::from("Phorensic OS Full Suite"), filter_all);
    assert(report.result_count > 0, "runner: results were collected");

    // Step 4: Verify report integrity
    console.write(Str::from(""));
    console.write(Str::from("[4/5] Verifying report integrity..."));
    let receipt_valid: bool = verify_receipt(report.receipt);
    assert(receipt_valid, "runner: receipt verification passed");

    let summary_consistent: bool = report.summary.total_tests == report.result_count;
    assert(summary_consistent, "runner: summary count matches results");

    // Print summary via helper
    print_summary(report.summary);

    // Step 5: Run court verification for court-category tests
    console.write(Str::from(""));
    console.write(Str::from("[5/5] Running court verification..."));
    let court_sessions: Array(ReplayCourtSession, 64) = verify_category_via_court(
        descriptors, 256,
        CATEGORY_COURT,
        Str::from("phc-v2.0.0")
    );
    let acceptance: u64 = compute_acceptance_rate(court_sessions, 64);
    assert(acceptance > 0, "runner: court acceptance rate positive");

    // Display final summary
    console.write(Str::from(""));
    console.write(Str::from("========== Final Test Summary =========="));

    let passed_pct: u64 = if report.summary.total_tests > 0 {
        (report.summary.total_passed as u64) * 100 / (report.summary.total_tests as u64)
    } else {
        0
    };

    console.write(Str::from("Total:     "));
    console.write(Str::from("Passed:    "));
    console.write(Str::from("Failed:    "));
    console.write(Str::from("Pass rate: "));
    console.write(Str::from("Assertions: "));
    console.write(Str::from("Residuals:  "));
    console.write(Str::from("Court acceptance rate: "));

    if report.summary.all_passed {
        console.write(Str::from(""));
        console.write(Str::from("✓ ALL TESTS PASSED"));
    } else {
        console.write(Str::from(""));
        console.write(Str::from("✗ SOME TESTS FAILED"));
        // List first few failures
        for fi in 0..report.failure_count {
            let f: TestFailureReport = report.failures[fi];
            if f.test_name.len() == 0 {
                break;
            }
            if fi >= 5 {
                console.write(Str::from("  ... (more failures omitted)"));
                break;
            }
            console.write(Str::from("  FAIL: "));
            console.write(Str::from("    "));
        }
    }

    // Validate core invariants
    assert(report.receipt.run_id > 0, "runner: receipt has non-zero run ID");
    assert(report.receipt.timestamp > 0, "runner: receipt has timestamp");
    assert(report.receipt.summary.total_tests ==
           report.receipt.summary.total_passed + report.receipt.summary.total_failed,
           "runner: total = passed + failed in receipt");

    assert(report.summary.total_residuals <= MAX_RESIDUALS,
           "runner: residual count within limit");
    assert(report.failure_count <= MAX_FAILURES,
           "runner: failure count within limit");

    // Verify that all test names are non-empty
    for i in 0..report.result_count {
        let r: TestResult = report.results[i];
        if r.test_name.len() == 0 {
            break;
        }
        assert(r.test_name.len() > 0, "runner: all test names non-empty");
        assert(r.test_file.len() > 0, "runner: all test files non-empty");
        assert(r.category.len() > 0, "runner: all test categories non-empty");
    }

    // Verify that all failure reports reference real tests
    for fi in 0..report.failure_count {
        let f: TestFailureReport = report.failures[fi];
        if f.test_name.len() == 0 {
            break;
        }
        assert(f.test_name.len() > 0, "runner: failure test name non-empty");
        assert(f.file.len() > 0, "runner: failure file non-empty");
    }

    // Verify trust ladder progression
    let trust_unknown: u8 = 0;
    let trust_observed: u8 = 1;
    let trust_replayed: u8 = 2;
    let trust_oracle_compared: u8 = 3;
    let trust_residual_stable: u8 = 4;
    let trust_sealed: u8 = 5;
    let trust_promoted: u8 = 6;

    assert(trust_unknown < trust_observed, "runner: trust ladder ordering 0<1");
    assert(trust_observed < trust_replayed, "runner: trust ladder ordering 1<2");
    assert(trust_replayed < trust_oracle_compared, "runner: trust ladder ordering 2<3");
    assert(trust_oracle_compared < trust_residual_stable, "runner: trust ladder ordering 3<4");
    assert(trust_residual_stable < trust_sealed, "runner: trust ladder ordering 4<5");
    assert(trust_sealed < trust_promoted, "runner: trust ladder ordering 5<6");

    // Verify that court verdict constants are ordered correctly
    assert(VERDICT_ACCEPT < VERDICT_REFINE, "runner: verdict order accept<refine");
    assert(VERDICT_REFINE < VERDICT_REJECT, "runner: verdict order refine<reject");
    assert(VERDICT_REJECT < VERDICT_MORE_EVIDENCE, "runner: verdict order reject<more");

    // Final residual emission
    residual emit {
        op: "test_runner.complete",
        test_files: 11,
        total_tests: report.summary.total_tests,
        total_passed: report.summary.total_passed,
        total_failed: report.summary.total_failed,
        total_residuals: report.summary.total_residuals,
        total_assertions: report.summary.total_assertions,
        duration_ticks: report.summary.total_duration,
        run_id: report.receipt.run_id,
        court_mode: 0,
        all_passed: if report.summary.all_passed { 1 } else { 0 },
        trust_ladder_verified: 1,
        receipt_verified: if receipt_valid { 1 } else { 0 },
        acceptance_rate: acceptance,
    };

    console.write(Str::from(""));
    console.write(Str::from("Test runner execution complete."));
}
