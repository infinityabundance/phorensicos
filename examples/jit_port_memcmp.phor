// jit_port_memcmp.phor — second JIT-Porting Court target (native candidate)
//
// Clean-room native port of libc `memcmp` at the ordering boundary. The
// observable is the SIGN of the return value (less | equal | greater), compared
// byte-wise and UNSIGNED over n bytes. This mirrors
// phost::porting::candidate::phor_memcmp and is referenced by the candidate
// residual (phost/evidence/porting/memcmp/candidate_signature.json).
//
// Buffers are modelled as up to 8 bytes packed little-endian into a u64, so the
// example uses only scalar values (the bootstrap checker does not yet support
// indexed assignment).
//
// Court: phost port promote memcmp
//   target id: libc:memcmp:c-locale:sign:v1
//   corpus:    312 bounded deterministic cases
//              (lengths 0..=8, 5 patterns, every first-mismatch position,
//               the n-boundary around a mismatch, unsigned edge bytes)
//
// Scope: API-surface JIT-porting. NOT arbitrary binary translation. The cage
// observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_memcmp:v1.0";

// ── Domain and result constants ──────────────────────────

const COURT_CASES: u64 = 7;

const CMP_LESS: u8 = 0;
const CMP_EQUAL: u8 = 1;
const CMP_GREATER: u8 = 2;

const TRUST_UNKNOWN: u8 = 0;
const TRUST_ORACLE_COMPARED: u8 = 3;
const TRUST_SEALED: u8 = 5;

// ── Target and evidence records ──────────────────────────

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    contract: Str(64),
}

// ── Byte extraction ──────────────────────────────────────
// Little-endian byte i of a packed buffer word (division-based, so the example
// only uses operators the bootstrap checker handles).

fn byte_at(word: u64, i: u64) -> u8
    effect [compute]
{
    let mut pow: u64 = 1;
    let mut k: u64 = 0;
    while k < i proven {
        pow = pow * 256;
        k = k + 1;
    }
    let b: u8 = ((word / pow) % 256) as u8;
    return b;
}

// ── Native clean-room candidate ──────────────────────────
// Unsigned byte comparison over at most n bytes; the first mismatch decides.

fn phor_memcmp(wa: u64, wb: u64, n: u64) -> u8
    effect [compute]
{
    let mut i: u64 = 0;
    while i < n proven {
        let x: u8 = byte_at(wa, i);
        let y: u8 = byte_at(wb, i);
        if x < y {
            return CMP_LESS;
        }
        if x > y {
            return CMP_GREATER;
        }
        i = i + 1;
    }
    return CMP_EQUAL;
}

// ── Dialect cage ─────────────────────────────────────────
// The host court observes the foreign libc `memcmp` through
// phost::porting::dialect_cage and normalizes the return to its sign. This local
// model stands in for that black-box observation inside the .phor expression.

fn cage_observed_memcmp(wa: u64, wb: u64, n: u64) -> u8
    effect [compute]
{
    let mut i: u64 = 0;
    while i < n proven {
        let x: u8 = byte_at(wa, i);
        let y: u8 = byte_at(wb, i);
        if x < y {
            return CMP_LESS;
        }
        if x > y {
            return CMP_GREATER;
        }
        i = i + 1;
    }
    return CMP_EQUAL;
}

// ── Replay court case ────────────────────────────────────
// Replays one case: candidate vs observed, with a residual for each comparison.

fn replay_case(wa: u64, wb: u64, n: u64, expected: u8) -> bool
    effect [compute, residual]
{
    let got: u8 = phor_memcmp(wa, wb, n);
    residual emit {
        op: "porting.replay_case",
        n: n,
        expected: expected,
        got: got,
    };
    return got == expected;
}

// ── Trust promotion ──────────────────────────────────────
// Promotion to sealed requires a full non-empty replay, zero failures, and a
// consistent verdict. Fail closed.

fn promote(cases_run: u64, cases_passed: u64, cases_failed: u64) -> u8
    effect [compute, residual]
{
    if cases_run == 0 {
        return TRUST_UNKNOWN;
    }
    if cases_failed != 0 || cases_passed != cases_run {
        return TRUST_ORACLE_COMPARED;
    }
    residual emit {
        op: "porting.promote",
        target: "memcmp",
        level: TRUST_SEALED,
    };
    return TRUST_SEALED;
}

// ── Court entry ──────────────────────────────────────────
// A representative slice of the bounded corpus. The authoritative 312-case
// corpus is generated and replayed by the host court.

fn main() -> void
    effect [compute, residual]
{
    let target: PortTarget = PortTarget {
        dialect_name: Str::from("libc"),
        symbol: Str::from("memcmp"),
        version: Str::from("host-observed-v1"),
        contract: Str::from("sign(-1|0|1), unsigned, n-bounded"),
    };
    assert(target.symbol == Str::from("memcmp"), "memcmp: target symbol");
    assert(target.dialect_name == Str::from("libc"), "memcmp: dialect is libc");

    // Equal buffers (byte 0x61 on both sides).
    let wa1: u64 = 0x61;
    let wb1: u64 = 0x61;
    assert(replay_case(wa1, wb1, 1, CMP_EQUAL), "memcmp: equal");

    // First mismatch decides the ordering.
    let wa2: u64 = 0x61;
    let wb2: u64 = 0x62;
    assert(replay_case(wa2, wb2, 1, CMP_LESS), "memcmp: a < b");

    let wa3: u64 = 0x62;
    let wb3: u64 = 0x61;
    assert(replay_case(wa3, wb3, 1, CMP_GREATER), "memcmp: a > b");

    // n = 0 is Equal even when the buffers differ.
    let wa4: u64 = 0x00;
    let wb4: u64 = 0xff;
    assert(replay_case(wa4, wb4, 0, CMP_EQUAL), "memcmp: n=0 equal");

    // The n boundary: bytes are 01 02 vs 01 03, so a mismatch at index 1 is
    // excluded when n = 1 and included when n = 2.
    let wa5: u64 = 0x0201;
    let wb5: u64 = 0x0301;
    assert(replay_case(wa5, wb5, 1, CMP_EQUAL), "memcmp: n excludes mismatch");
    assert(replay_case(wa5, wb5, 2, CMP_LESS), "memcmp: n includes mismatch");

    // Unsigned edge: 0x80 > 0x7f (a signed comparison would disagree).
    let wa6: u64 = 0x80;
    let wb6: u64 = 0x7f;
    assert(replay_case(wa6, wb6, 1, CMP_GREATER), "memcmp: unsigned 0x80 > 0x7f");

    // The cage model and the candidate agree over the replayed slice.
    let observed: u8 = cage_observed_memcmp(wa5, wb5, 2);
    let native: u8 = phor_memcmp(wa5, wb5, 2);
    assert(observed == native, "memcmp: cage and candidate agree");

    // Promote only on a consistent, full replay.
    let trust_level: u8 = promote(COURT_CASES, COURT_CASES, 0);
    assert(trust_level == TRUST_SEALED, "memcmp: promoted to sealed");
}
