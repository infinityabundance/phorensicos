// jit_port_strspn.phor — sixth JIT-Porting Court target (native candidate)
//
// Clean-room native port of the **POSIX** function `strspn` at the set-membership
// boundary. `strspn(s, accept)` returns the length of the initial segment of `s`
// consisting only of bytes in the NUL-terminated set `accept`.
//
// Why this target is `posix:` and not `libc:`: ISO C does not specify `strspn`,
// `strcspn`, `strpbrk`, `strtok` or `strcasecmp` — they are POSIX functions. The
// target's `dialect` names the *specification the contract is drawn from*, so a
// contract that only exists in POSIX cannot be recorded as a C-library contract
// without silently conflating two standards. See docs/DIALECT_QUALIFICATION.md.
//
// This file is the *candidate source* bound into the sealed package
// (phost/evidence/porting/strspn/sealed_package.json: candidate_source_hash).
//
// Both buffers are modelled as up to 8 bytes packed LITTLE-ENDIAN into a u64 (byte
// i occupies bits 8*i, i.e. the machine word you get by loading the buffer on
// x86-64). `n` is a *precondition bound*: the string's NUL terminator lies within
// the first `n` bytes, which is what keeps the foreign observation inside the
// caller's window and the scan inside one word. Because a C string's accept set
// cannot itself contain NUL, the terminator is always a byte *not* in the set, so
// the span always ends at or before the terminator and therefore inside `n`.
//
// ABI — the executed entry point (see phost::porting::exec):
//   symbol `_phor_phor_strspn_len`; SysV AMD64 (RDI, RSI, RDX) -> RAX, i.e.
//   `phor_strspn_len(ws: u64, wa: u64, n: u64) -> u64`.
//   The result is the u64 span length. The function is a leaf: no calls, no
//   relocations, no heap, no syscalls.
//
// The lowerer emits a single basic block (no branches), so the scan is written
// branchlessly: iterate the indices from the highest down and let the last
// assignment win — that yields the *smallest* stopping index, i.e. the span.
// A byte is in the set when it is non-NUL and equals one of the accept lanes;
// the non-NUL guard is what makes unused (zero) accept lanes harmless. `idx`
// starts at `n`, so an all-in-set window fails closed at `n` rather than reading
// on (in contract this cannot happen: the terminator is never in the set).
//
// Scope: API-surface JIT-porting. NOT arbitrary binary translation. The cage
// observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_strspn:v1.0";

// ── Domain constants ─────────────────────────────────────

const WIDTH: u64 = 8;       // bytes packed per buffer word
const BYTE_MASK: u64 = 255; // one byte per lane
const NUL: u64 = 0;         // the C string terminator byte

// ── Target and evidence records ──────────────────────────
// These mirror the residuals the court seals for this target.

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    input_schema: Str(64),
    output_schema: Str(64),
}

struct ReplayVerdict {
    target: Str(32),
    cases_run: u64,
    cases_passed: u64,
    cases_failed: u64,
    verdict: u8,
}

struct SealedPackage {
    target: Str(32),
    dialect_name: Str(16),
    trust_level: u8,
    case_count: u64,
    oracle_hash: Str(64),
    candidate_hash: Str(64),
}

// ── Native clean-room candidate ──────────────────────────
//
// Branchless and leaf. Byte i of a little-endian word is `(w >> (8*i)) & 255`.
// For each lane of `s` we compute set membership as an 8-term OR (written as
// `m + t - m*t`, which is OR for 0/1 values and needs no branching), require the
// byte to be non-NUL, and then select the smallest stopping index by scanning
// downward.

fn phor_strspn_len(ws: u64, wa: u64, n: u64) -> u64
    effect [compute]
{
    let mut idx: u64 = n;
    let s7: u64 = (ws >> 56) & BYTE_MASK;
    let mut m7: u64 = 0;
    m7 = m7 + ((((wa >> 0) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 0) & BYTE_MASK) == s7) as u64);
    m7 = m7 + ((((wa >> 8) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 8) & BYTE_MASK) == s7) as u64);
    m7 = m7 + ((((wa >> 16) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 16) & BYTE_MASK) == s7) as u64);
    m7 = m7 + ((((wa >> 24) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 24) & BYTE_MASK) == s7) as u64);
    m7 = m7 + ((((wa >> 32) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 32) & BYTE_MASK) == s7) as u64);
    m7 = m7 + ((((wa >> 40) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 40) & BYTE_MASK) == s7) as u64);
    m7 = m7 + ((((wa >> 48) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 48) & BYTE_MASK) == s7) as u64);
    m7 = m7 + ((((wa >> 56) & BYTE_MASK) == s7) as u64) - m7 * ((((wa >> 56) & BYTE_MASK) == s7) as u64);
    let nz7: u64 = 1 - ((s7 == NUL) as u64);
    let in7: u64 = nz7 * m7;
    let stop7: u64 = (1 - in7) * ((n > 7) as u64);
    idx = idx - stop7 * (idx - 7);

    let s6: u64 = (ws >> 48) & BYTE_MASK;
    let mut m6: u64 = 0;
    m6 = m6 + ((((wa >> 0) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 0) & BYTE_MASK) == s6) as u64);
    m6 = m6 + ((((wa >> 8) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 8) & BYTE_MASK) == s6) as u64);
    m6 = m6 + ((((wa >> 16) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 16) & BYTE_MASK) == s6) as u64);
    m6 = m6 + ((((wa >> 24) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 24) & BYTE_MASK) == s6) as u64);
    m6 = m6 + ((((wa >> 32) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 32) & BYTE_MASK) == s6) as u64);
    m6 = m6 + ((((wa >> 40) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 40) & BYTE_MASK) == s6) as u64);
    m6 = m6 + ((((wa >> 48) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 48) & BYTE_MASK) == s6) as u64);
    m6 = m6 + ((((wa >> 56) & BYTE_MASK) == s6) as u64) - m6 * ((((wa >> 56) & BYTE_MASK) == s6) as u64);
    let nz6: u64 = 1 - ((s6 == NUL) as u64);
    let in6: u64 = nz6 * m6;
    let stop6: u64 = (1 - in6) * ((n > 6) as u64);
    idx = idx - stop6 * (idx - 6);

    let s5: u64 = (ws >> 40) & BYTE_MASK;
    let mut m5: u64 = 0;
    m5 = m5 + ((((wa >> 0) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 0) & BYTE_MASK) == s5) as u64);
    m5 = m5 + ((((wa >> 8) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 8) & BYTE_MASK) == s5) as u64);
    m5 = m5 + ((((wa >> 16) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 16) & BYTE_MASK) == s5) as u64);
    m5 = m5 + ((((wa >> 24) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 24) & BYTE_MASK) == s5) as u64);
    m5 = m5 + ((((wa >> 32) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 32) & BYTE_MASK) == s5) as u64);
    m5 = m5 + ((((wa >> 40) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 40) & BYTE_MASK) == s5) as u64);
    m5 = m5 + ((((wa >> 48) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 48) & BYTE_MASK) == s5) as u64);
    m5 = m5 + ((((wa >> 56) & BYTE_MASK) == s5) as u64) - m5 * ((((wa >> 56) & BYTE_MASK) == s5) as u64);
    let nz5: u64 = 1 - ((s5 == NUL) as u64);
    let in5: u64 = nz5 * m5;
    let stop5: u64 = (1 - in5) * ((n > 5) as u64);
    idx = idx - stop5 * (idx - 5);

    let s4: u64 = (ws >> 32) & BYTE_MASK;
    let mut m4: u64 = 0;
    m4 = m4 + ((((wa >> 0) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 0) & BYTE_MASK) == s4) as u64);
    m4 = m4 + ((((wa >> 8) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 8) & BYTE_MASK) == s4) as u64);
    m4 = m4 + ((((wa >> 16) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 16) & BYTE_MASK) == s4) as u64);
    m4 = m4 + ((((wa >> 24) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 24) & BYTE_MASK) == s4) as u64);
    m4 = m4 + ((((wa >> 32) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 32) & BYTE_MASK) == s4) as u64);
    m4 = m4 + ((((wa >> 40) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 40) & BYTE_MASK) == s4) as u64);
    m4 = m4 + ((((wa >> 48) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 48) & BYTE_MASK) == s4) as u64);
    m4 = m4 + ((((wa >> 56) & BYTE_MASK) == s4) as u64) - m4 * ((((wa >> 56) & BYTE_MASK) == s4) as u64);
    let nz4: u64 = 1 - ((s4 == NUL) as u64);
    let in4: u64 = nz4 * m4;
    let stop4: u64 = (1 - in4) * ((n > 4) as u64);
    idx = idx - stop4 * (idx - 4);

    let s3: u64 = (ws >> 24) & BYTE_MASK;
    let mut m3: u64 = 0;
    m3 = m3 + ((((wa >> 0) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 0) & BYTE_MASK) == s3) as u64);
    m3 = m3 + ((((wa >> 8) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 8) & BYTE_MASK) == s3) as u64);
    m3 = m3 + ((((wa >> 16) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 16) & BYTE_MASK) == s3) as u64);
    m3 = m3 + ((((wa >> 24) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 24) & BYTE_MASK) == s3) as u64);
    m3 = m3 + ((((wa >> 32) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 32) & BYTE_MASK) == s3) as u64);
    m3 = m3 + ((((wa >> 40) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 40) & BYTE_MASK) == s3) as u64);
    m3 = m3 + ((((wa >> 48) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 48) & BYTE_MASK) == s3) as u64);
    m3 = m3 + ((((wa >> 56) & BYTE_MASK) == s3) as u64) - m3 * ((((wa >> 56) & BYTE_MASK) == s3) as u64);
    let nz3: u64 = 1 - ((s3 == NUL) as u64);
    let in3: u64 = nz3 * m3;
    let stop3: u64 = (1 - in3) * ((n > 3) as u64);
    idx = idx - stop3 * (idx - 3);

    let s2: u64 = (ws >> 16) & BYTE_MASK;
    let mut m2: u64 = 0;
    m2 = m2 + ((((wa >> 0) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 0) & BYTE_MASK) == s2) as u64);
    m2 = m2 + ((((wa >> 8) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 8) & BYTE_MASK) == s2) as u64);
    m2 = m2 + ((((wa >> 16) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 16) & BYTE_MASK) == s2) as u64);
    m2 = m2 + ((((wa >> 24) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 24) & BYTE_MASK) == s2) as u64);
    m2 = m2 + ((((wa >> 32) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 32) & BYTE_MASK) == s2) as u64);
    m2 = m2 + ((((wa >> 40) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 40) & BYTE_MASK) == s2) as u64);
    m2 = m2 + ((((wa >> 48) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 48) & BYTE_MASK) == s2) as u64);
    m2 = m2 + ((((wa >> 56) & BYTE_MASK) == s2) as u64) - m2 * ((((wa >> 56) & BYTE_MASK) == s2) as u64);
    let nz2: u64 = 1 - ((s2 == NUL) as u64);
    let in2: u64 = nz2 * m2;
    let stop2: u64 = (1 - in2) * ((n > 2) as u64);
    idx = idx - stop2 * (idx - 2);

    let s1: u64 = (ws >> 8) & BYTE_MASK;
    let mut m1: u64 = 0;
    m1 = m1 + ((((wa >> 0) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 0) & BYTE_MASK) == s1) as u64);
    m1 = m1 + ((((wa >> 8) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 8) & BYTE_MASK) == s1) as u64);
    m1 = m1 + ((((wa >> 16) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 16) & BYTE_MASK) == s1) as u64);
    m1 = m1 + ((((wa >> 24) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 24) & BYTE_MASK) == s1) as u64);
    m1 = m1 + ((((wa >> 32) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 32) & BYTE_MASK) == s1) as u64);
    m1 = m1 + ((((wa >> 40) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 40) & BYTE_MASK) == s1) as u64);
    m1 = m1 + ((((wa >> 48) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 48) & BYTE_MASK) == s1) as u64);
    m1 = m1 + ((((wa >> 56) & BYTE_MASK) == s1) as u64) - m1 * ((((wa >> 56) & BYTE_MASK) == s1) as u64);
    let nz1: u64 = 1 - ((s1 == NUL) as u64);
    let in1: u64 = nz1 * m1;
    let stop1: u64 = (1 - in1) * ((n > 1) as u64);
    idx = idx - stop1 * (idx - 1);

    let s0: u64 = (ws >> 0) & BYTE_MASK;
    let mut m0: u64 = 0;
    m0 = m0 + ((((wa >> 0) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 0) & BYTE_MASK) == s0) as u64);
    m0 = m0 + ((((wa >> 8) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 8) & BYTE_MASK) == s0) as u64);
    m0 = m0 + ((((wa >> 16) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 16) & BYTE_MASK) == s0) as u64);
    m0 = m0 + ((((wa >> 24) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 24) & BYTE_MASK) == s0) as u64);
    m0 = m0 + ((((wa >> 32) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 32) & BYTE_MASK) == s0) as u64);
    m0 = m0 + ((((wa >> 40) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 40) & BYTE_MASK) == s0) as u64);
    m0 = m0 + ((((wa >> 48) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 48) & BYTE_MASK) == s0) as u64);
    m0 = m0 + ((((wa >> 56) & BYTE_MASK) == s0) as u64) - m0 * ((((wa >> 56) & BYTE_MASK) == s0) as u64);
    let nz0: u64 = 1 - ((s0 == NUL) as u64);
    let in0: u64 = nz0 * m0;
    let stop0: u64 = (1 - in0) * ((n > 0) as u64);
    idx = idx - stop0 * (idx - 0);

    return idx;
}
