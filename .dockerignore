# Docker build context excludes.
#
# Keep the image small and the build deterministic: never send Rust build
# output or generated QEMU evidence dumps into the build context.

# Rust build output
target/
**/target/

# VCS
.git/
.gitignore

# Local foundry state: the FRF store, per-revision work objects and generated
# fuzz projects. These are host-local build artifacts (gitignored); baking them
# into the image would ship absolute host paths and a stale FRF authority
# admission, and would send hundreds of megabytes as build context.
.phorport/
.frf-fuzz/
.fuzzspike/

# Read-only reconnaissance of the sibling repositories (gitignored).
.recon/

# Generated compiler artifacts
*.o
*.a
*.rlib
*.exe
*.d
kernel_obj-*
*.receipts.json
*.sealed_package.json

# The committed leaf objects ARE the seal: the persistent sealed-port store
# (phost/evidence/store/index.json) loads them without invoking the compiler, so
# they must reach the build context.
!phost/evidence/porting/*/candidate.o
!phost/evidence/autonomous/*/candidate.o

# Generated kernel link output
*.elf
*.elf.elf
*.img

# QEMU boot evidence dumps (regenerated in-container by boot_qemu.sh).
# Listed explicitly so the committed phost_kernel/evidence_manifest.json is kept.
phost_kernel/evidence
phost_kernel/evidence2
phost_kernel/evidence3
phost_kernel/evidence4
phost_kernel/evidence6
phost_kernel/evidence-t2
phost_kernel/evidence-trace
phost_kernel/evidence-final2
phost_kernel/evidence-dbg

# Screendumps and logs
*.ppm
*.log
phorc/evidence_pack/readelf-*.txt
phorc/evidence_pack/objdump-*.txt
