// test_runner.phor — Comprehensive Test Runner and Verification Framework
//
// This file implements a complete test runner and verification framework for
// Phorensic OS. It discovers test files, runs individual test functions,
// captures failures with full residual context, aggregates results into a
// TestReport, supports filtering by category, records residuals per run,
// produces TestRunReceipts, and supports court-style verification (replay
// tests and compare against oracle references).
//
// Key design properties:
//   - All loops bounded; all effects declared
//   - Fixed-capacity collections throughout
//   - Deterministic residual recording for audit
//   - Every test run produces a verifiable receipt
//   - Court replay mode enables formal verification
//   - Category filtering for targeted test execution
//
// Trust state: Observed (requires court verification for Sealed)
// Compilation: accepted

package "phorensic:test_runner:v1.0";

// ============================================================================
// Section 1: Core Data Structures (Lines 1–250)
// ============================================================================

// Result of a single test function execution
struct TestResult {
    test_name: Str(128),
    test_file: Str(128),
    category: Str(64),
    passed: bool,
    assertion_count: u32,
    failure_count: u32,
    failure_messages: Array(Str(128), 32),
    residual_count: u32,
    duration_ticks: u64,
    trust_level_before: u8,
    trust_level_after: u8,
}

// Summary of all test results in a run
struct TestSummary {
    total_tests: u32,
    total_passed: u32,
    total_failed: u32,
    total_assertions: u32,
    total_residuals: u32,
    total_duration: u64,
    categories_tested: u32,
    all_passed: bool,
}

// A named test function with metadata
struct TestDescriptor {
    name: Str(128),
    file: Str(128),
    category: Str(64),
    line_number: u32,
    expected_effects: Array(u8, 16),
    required_trust: u8,
    is_replay_test: bool,
    is_court_test: bool,
    tags: Array(Str(32), 8),
}

// Receipt produced after a complete test run
struct TestRunReceipt {
    run_id: u64,
    timestamp: u64,
    suite_name: Str(128),
    summary: TestSummary,
    filter_category: Str(64),
    all_categories: bool,
    court_mode: bool,
    receipt_hash: u64,
}

// A failure report with residual context for forensic analysis
struct TestFailureReport {
    test_name: Str(128),
    category: Str(64),
    file: Str(128),
    line: u32,
    message: Str(256),
    residual_before: u64,
    residual_after: u64,
    expected_value: u64,
    actual_value: u64,
    trust_at_failure: u8,
    stack_depth: u8,
}

// Complete aggregated report for a test suite
struct TestReport {
    suite_name: Str(128),
    run_id: u64,
    timestamp: u64,
    results: Array(TestResult, 256),
    result_count: u32,
    summary: TestSummary,
    receipt: TestRunReceipt,
    failures: Array(TestFailureReport, MAX_FAILURES),
    failure_count: u32,
    residuals: Array(ResidualRecord, MAX_RESIDUALS),
    residual_count: u32,
}

// Court session for replay-based verification
struct ReplayCourtSession {
    session_id: u64,
    oracle_name: Str(16),
    test_name: Str(128),
    replay_count: u32,
    match_count: u32,
    divergence_count: u32,
    verdict: u8,
    evidence_count: u32,
    closed: bool,
}

// A single comparison record between replay and oracle
struct ComparisonRecord {
    comparison_id: u64,
    test_name: Str(128),
    replay_hash: u64,
    oracle_hash: u64,
    match_type: u8,
    divergence_class: u8,
    details: Str(256),
}

// A residual record captured during test execution
struct ResidualRecord {
    residual_id: u64,
    op: Str(128),
    test_name: Str(128),
    category: Str(64),
    value: u64,
    hash: u64,
    timestamp: u64,
}

// A test file descriptor discovered by the runner
struct TestFileDescriptor {
    file_path: Str(128),
    test_count: u32,
    function_names: Array(Str(64), 64),
    categories: Array(Str(32), 16),
    category_count: u32,
    is_loadable: bool,
    hash: u64,
}

// Category filter expression for selective test execution
struct CategoryFilter {
    include_category: Str(64),
    exclude_category: Str(64),
    match_all: bool,
    match_none: bool,
    tag_required: Str(32),
}

