// ============================================================================
// expansion_receipts.phor — ExpansionReceipt, Expansion Metadata, Diff Class
// ============================================================================
// Expansion receipts are records of expansion operations performed on foreign
// code within a dialect cage. They capture macro expansion, template expansion,
// include resolution, preprocessor operations, and build system expansion.
//
// Each receipt records the input, context, rule selected, and output
// with a diff classification for court comparison.
// ============================================================================

package "phorensic:expansion_receipts:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type ExpansionError = enum {
    ReceiptFull = 0x01,
    InvalidInput = 0x02,
    InvalidContext = 0x03,
    RuleApplicationFailed = 0x04,
    SymbolTableOverflow = 0x05,
    EmittedBytesOverflow = 0x06,
    OracleMismatch = 0x07,
    ProvenanceMissing = 0x08,
    ReplaySeedMissing = 0x09,
    ReceiptNotFound = 0x0A,
    ReceiptAlreadyExists = 0x0B,
    InternalError = 0xFF,
}

// ============================================================================
// Diff Classification Types
// ============================================================================

type DiffClass = enum {
    Identical = 0x01,
    Equivalent = 0x02,
    Divergent = 0x03,
    New = 0x04,
    Unknown = 0xFF,
}

type DivergenceSeverity = enum {
    Acceptable = 0x01,
    Minor = 0x02,
    Significant = 0x03,
    Critical = 0x04,
}

type ExpansionType = enum {
    Macro = 0x01,
    Template = 0x02,
    Include = 0x03,
    Preprocessor = 0x04,
    M4 = 0x05,
    Autoconf = 0x06,
    Automake = 0x07,
    MakeVariable = 0x08,
    CMakeCommand = 0x09,
    LLVMTableGen = 0x0A,
    MLIRDialect = 0x0B,
    BuildRecipe = 0x0C,
    PackageDerivation = 0x0D,
    Custom = 0xFF,
}

// ============================================================================
// Hash256
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

// ============================================================================
// FixedString
// ============================================================================

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Symbol Table Entry
// ============================================================================

type SymbolEntry = struct {
    symbol_name: FixedString[128],
    symbol_value_hash: Hash256,
    symbol_type: FixedString[64],
    is_macro: bool,
    is_function_like: bool,
    parameter_count: u64,
}

type SymbolTable = struct {
    symbols: Array[SymbolEntry, 512],
    symbol_count: u64,
}

// ============================================================================
// Expansion Receipt
// ============================================================================

type ExpansionReceipt = struct {
    receipt_id: u64,
    expansion_type: ExpansionType,
    input_fragment: FixedString[4096],
    input_hash: Hash256,
    context_description: FixedString[2048],
    rule_selected: FixedString[256],
    rule_version: FixedString[32],
    dialect_profile_flags: FixedString[512],
    symbol_table_before: SymbolTable,
    symbol_table_after: SymbolTable,
    emitted_bytes: Array[u8, 65536],
    emitted_byte_count: u64,
    emitted_hash: Hash256,
    oracle_bytes: Array[u8, 65536],
    oracle_byte_count: u64,
    oracle_hash: Hash256,
    oracle_available: bool,
    diff_class: DiffClass,
    divergence_severity: DivergenceSeverity,
    divergence_description: FixedString[1024],
    provenance: FixedString[512],
    casefile_id: FixedString[128],
    replay_seed: Hash256,
    deterministic_hash: Hash256,
    timestamp: u64,
    generation: u64,
    is_sealed: bool,
}

// ============================================================================
// Expansion Receipt Store
// ============================================================================

type ExpansionReceiptStore = struct {
    receipts: Array[ExpansionReceipt, 4096],
    receipt_count: u64,
    generation: u64,
}

// ============================================================================
// Create Expansion Receipt
// ============================================================================

fn create_expansion_receipt(expansion_type: ExpansionType, input_fragment: &FixedString[4096], context: &FixedString[2048], provenance: &FixedString[512], replay_seed: Hash256) -> Result[ExpansionReceipt, ExpansionError]
    effects: [compute, residual]
{
    if input_fragment.len == 0 {
        return Err(ExpansionError::InvalidInput);
    }

    if context.len == 0 {
        return Err(ExpansionError::InvalidContext);
    }

    let receipt_id: u64 = kernel.tick_count();
    let input_hash: Hash256 = hash_receipt_data(input_fragment.data, input_fragment.len);

    let empty_symbols: Array[SymbolEntry, 512] = Array[SymbolEntry, 512]::zeroed();
    let empty_emitted: Array[u8, 65536] = Array[u8, 65536]::zeroed();
    let empty_oracle: Array[u8, 65536] = Array[u8, 65536]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    let receipt: ExpansionReceipt = ExpansionReceipt {
        receipt_id: receipt_id,
        expansion_type: expansion_type,
        input_fragment: *input_fragment,
        input_hash: input_hash,
        context_description: *context,
        rule_selected: FixedString[256]::zeroed(),
        rule_version: FixedString[32]::zeroed(),
        dialect_profile_flags: FixedString[512]::zeroed(),
        symbol_table_before: SymbolTable {
            symbols: empty_symbols,
            symbol_count: 0,
        },
        symbol_table_after: SymbolTable {
            symbols: empty_symbols,
            symbol_count: 0,
        },
        emitted_bytes: empty_emitted,
        emitted_byte_count: 0,
        emitted_hash: zero_hash,
        oracle_bytes: empty_oracle,
        oracle_byte_count: 0,
        oracle_hash: zero_hash,
        oracle_available: false,
        diff_class: DiffClass::Unknown,
        divergence_severity: DivergenceSeverity::Acceptable,
        divergence_description: FixedString[1024]::zeroed(),
        provenance: *provenance,
        casefile_id: FixedString[128]::zeroed(),
        replay_seed: replay_seed,
        deterministic_hash: zero_hash,
        timestamp: kernel.tick_count(),
        generation: 1,
        is_sealed: false,
    };

    @emit_residual("expansion_receipt.create", "receipt_created", receipt_id);

    return Ok(receipt);
}

// ============================================================================
// Record Rule Application
// ============================================================================

fn record_expansion_rule(receipt: &mut ExpansionReceipt, rule: &FixedString[256], version: &FixedString[32]) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    receipt.rule_selected = *rule;
    receipt.rule_version = *version;

    @emit_residual("expansion_receipt.rule", "rule_recorded", receipt.receipt_id);

    return Ok(());
}

// ============================================================================
// Set Dialect Profile Flags
// ============================================================================

fn set_expansion_dialect_flags(receipt: &mut ExpansionReceipt, flags: &FixedString[512]) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    receipt.dialect_profile_flags = *flags;

    return Ok(());
}

// ============================================================================
// Capture Symbol Table Before Expansion
// ============================================================================

fn capture_symbols_before(receipt: &mut ExpansionReceipt, table: &SymbolTable) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    if table.symbol_count > 512 {
        return Err(ExpansionError::SymbolTableOverflow);
    }

    receipt.symbol_table_before = *table;

    @emit_residual("expansion_receipt.symbols_before", "pre_expansion_symbols_captured", table.symbol_count);

    return Ok(());
}

// ============================================================================
// Capture Symbol Table After Expansion
// ============================================================================

fn capture_symbols_after(receipt: &mut ExpansionReceipt, table: &SymbolTable) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    if table.symbol_count > 512 {
        return Err(ExpansionError::SymbolTableOverflow);
    }

    receipt.symbol_table_after = *table;

    @emit_residual("expansion_receipt.symbols_after", "post_expansion_symbols_captured", table.symbol_count);

    return Ok(());
}

// ============================================================================
// Record Emitted Bytes
// ============================================================================

fn record_emitted_bytes(receipt: &mut ExpansionReceipt, bytes: &Array[u8, 65536], byte_count: u64) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    if byte_count > 65536 {
        return Err(ExpansionError::EmittedBytesOverflow);
    }

    for i in 0..byte_count {
        receipt.emitted_bytes[i] = bytes[i];
    }
    receipt.emitted_byte_count = byte_count;
    receipt.emitted_hash = hash_receipt_data(bytes, byte_count);

    @emit_residual("expansion_receipt.emitted", "emitted_bytes_recorded", byte_count);

    return Ok(());
}

// ============================================================================
// Record Oracle Bytes
// ============================================================================

fn record_oracle_bytes(receipt: &mut ExpansionReceipt, bytes: &Array[u8, 65536], byte_count: u64) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if byte_count > 65536 {
        return Err(ExpansionError::EmittedBytesOverflow);
    }

    for i in 0..byte_count {
        receipt.oracle_bytes[i] = bytes[i];
    }
    receipt.oracle_byte_count = byte_count;
    receipt.oracle_hash = hash_receipt_data(bytes, byte_count);
    receipt.oracle_available = true;

    @emit_residual("expansion_receipt.oracle", "oracle_bytes_recorded", byte_count);

    return Ok(());
}

// ============================================================================
// Compute Diff Classification
// ============================================================================
// Compares the emitted bytes against the oracle bytes (if available) and
// produces a diff classification.

fn compute_expansion_diff(receipt: &mut ExpansionReceipt) -> Result[DiffClass, ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    if !receipt.oracle_available {
        // No oracle available — mark as New
        receipt.diff_class = DiffClass::New;
        receipt.divergence_severity = DivergenceSeverity::Acceptable;

        @emit_residual("expansion_receipt.diff", "no_oracle_classified_new", receipt.receipt_id);

        return Ok(DiffClass::New);
    }

    // Compare byte count first
    if receipt.emitted_byte_count != receipt.oracle_byte_count {
        // Byte count differs — check if structurally equivalent
        let min_len: u64 = if receipt.emitted_byte_count < receipt.oracle_byte_count {
            receipt.emitted_byte_count
        } else {
            receipt.oracle_byte_count
        };

        let mut divergences: u64 = 0;
        for i in 0..min_len {
            if receipt.emitted_bytes[i] != receipt.oracle_bytes[i] {
                divergences = divergences + 1;
            }
        }

        if divergences == 0 {
            // Identical prefix, different length — structurally equivalent
            receipt.diff_class = DiffClass::Equivalent;
            receipt.divergence_severity = DivergenceSeverity::Minor;
            receipt.divergence_description = FixedString[1024]::from_literal("Byte count differs but common prefix is identical");

            @emit_residual("expansion_receipt.diff", "classified_equivalent", receipt.receipt_id);
            return Ok(DiffClass::Equivalent);
        }

        let divergence_ratio: u64 = (divergences * 100) / min_len;
        if divergence_ratio < 5 {
            // Less than 5% divergence — structurally equivalent
            receipt.diff_class = DiffClass::Equivalent;
            receipt.divergence_severity = DivergenceSeverity::Minor;
            receipt.divergence_description = FixedString[1024]::from_literal("Minor byte divergences in common prefix");

            @emit_residual("expansion_receipt.diff", "classified_equivalent_minor", receipt.receipt_id);
            return Ok(DiffClass::Equivalent);
        }

        // Significant divergence
        receipt.diff_class = DiffClass::Divergent;
        if divergence_ratio < 20 {
            receipt.divergence_severity = DivergenceSeverity::Significant;
        } else {
            receipt.divergence_severity = DivergenceSeverity::Critical;
        }
        receipt.divergence_description = FixedString[1024]::from_literal("Byte count and content divergence detected");

        @emit_residual("expansion_receipt.diff", "classified_divergent", receipt.receipt_id);
        return Ok(DiffClass::Divergent);
    }

    // Same byte count — check byte-by-byte
    let mut divergences: u64 = 0;
    let comp_len: u64 = receipt.emitted_byte_count;

    for i in 0..comp_len {
        if receipt.emitted_bytes[i] != receipt.oracle_bytes[i] {
            divergences = divergences + 1;
        }
    }

    if divergences == 0 {
        // Byte-identical
        receipt.diff_class = DiffClass::Identical;
        receipt.divergence_severity = DivergenceSeverity::Acceptable;

        @emit_residual("expansion_receipt.diff", "classified_identical", receipt.receipt_id);
        return Ok(DiffClass::Identical);
    }

    // Count divergence positions for structural analysis
    let mut consecutive_divergences: u64 = 0;
    let mut max_consecutive: u64 = 0;
    for i in 0..comp_len {
        if receipt.emitted_bytes[i] != receipt.oracle_bytes[i] {
            consecutive_divergences = consecutive_divergences + 1;
            if consecutive_divergences > max_consecutive {
                max_consecutive = consecutive_divergences;
            }
        } else {
            consecutive_divergences = 0;
        }
    }

    let divergence_ratio: u64 = (divergences * 100) / comp_len;

    if divergence_ratio < 5 && max_consecutive < 16 {
        // Small, scattered divergences — structurally equivalent
        receipt.diff_class = DiffClass::Equivalent;
        receipt.divergence_severity = DivergenceSeverity::Minor;
        receipt.divergence_description = FixedString[1024]::from_literal("Structurally equivalent with minor byte divergences");

        @emit_residual("expansion_receipt.diff", "classified_equivalent_structural", receipt.receipt_id);
        return Ok(DiffClass::Equivalent);
    }

    // Significant divergence
    receipt.diff_class = DiffClass::Divergent;
    if divergence_ratio < 20 {
        receipt.divergence_severity = DivergenceSeverity::Significant;
    } else {
        receipt.divergence_severity = DivergenceSeverity::Critical;
    }

    let mut desc: FixedString[1024] = FixedString[1024]::zeroed();
    let desc_text: FixedString[40] = FixedString[40]::from_literal("Divergence detected at byte level");
    receipt.divergence_description = desc_text;

    @emit_residual("expansion_receipt.diff", "classified_divergent_detailed", receipt.receipt_id);
    return Ok(DiffClass::Divergent);
}

// ============================================================================
// Set Casefile ID
// ============================================================================

fn set_expansion_casefile(receipt: &mut ExpansionReceipt, casefile_id: &FixedString[128]) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    receipt.casefile_id = *casefile_id;

    @emit_residual("expansion_receipt.casefile", "casefile_assigned", receipt.receipt_id);

    return Ok(());
}

// ============================================================================
// Compute Deterministic Hash
// ============================================================================

fn compute_deterministic_hash(receipt: &mut ExpansionReceipt) -> Hash256
    effects: [compute]
{
    let mut hash: Hash256 = receipt.input_hash;

    // Mix in the rule selected
    for i in 0..receipt.rule_selected.len {
        let idx: u64 = i & 31;
        hash.bytes[idx] = hash.bytes[idx] ^ receipt.rule_selected.data[i];
    }

    // Mix in emitted bytes hash
    hash = hash_combine_hash(hash, receipt.emitted_hash);

    // Mix in symbol table metrics
    let before_count: u8 = receipt.symbol_table_before.symbol_count as u8;
    let after_count: u8 = receipt.symbol_table_after.symbol_count as u8;
    hash.bytes[0] = hash.bytes[0] ^ before_count;
    hash.bytes[1] = hash.bytes[1] ^ after_count;

    receipt.deterministic_hash = hash;

    return hash;
}

// ============================================================================
// Seal Receipt
// ============================================================================
// Once sealed, the receipt cannot be modified.

fn seal_expansion_receipt(receipt: &mut ExpansionReceipt) -> Result[(), ExpansionError]
    effects: [compute, residual]
{
    if receipt.is_sealed {
        return Err(ExpansionError::ReceiptAlreadyExists);
    }

    // Compute final deterministic hash before sealing
    let _ = compute_deterministic_hash(receipt);

    receipt.is_sealed = true;

    @emit_residual("expansion_receipt.seal", "receipt_sealed", receipt.receipt_id);

    return Ok(());
}

// ============================================================================
// Get Receipt Summary
// ============================================================================

type ExpansionReceiptSummary = struct {
    receipt_id: u64,
    expansion_type: ExpansionType,
    input_hash: Hash256,
    emitted_byte_count: u64,
    oracle_available: bool,
    diff_class: DiffClass,
    divergence_severity: DivergenceSeverity,
    deterministic_hash: Hash256,
    is_sealed: bool,
    timestamp: u64,
}

fn get_receipt_summary(receipt: &ExpansionReceipt) -> ExpansionReceiptSummary
    effects: [compute]
{
    return ExpansionReceiptSummary {
        receipt_id: receipt.receipt_id,
        expansion_type: receipt.expansion_type,
        input_hash: receipt.input_hash,
        emitted_byte_count: receipt.emitted_byte_count,
        oracle_available: receipt.oracle_available,
        diff_class: receipt.diff_class,
        divergence_severity: receipt.divergence_severity,
        deterministic_hash: receipt.deterministic_hash,
        is_sealed: receipt.is_sealed,
        timestamp: receipt.timestamp,
    };
}

// ============================================================================
// Expansion Receipt Store Operations
// ============================================================================

fn create_receipt_store() -> ExpansionReceiptStore
    effects: [compute]
{
    let empty: Array[ExpansionReceipt, 4096] = Array[ExpansionReceipt, 4096]::zeroed();
    return ExpansionReceiptStore {
        receipts: empty,
        receipt_count: 0,
        generation: 1,
    };
}

fn store_receipt(store: &mut ExpansionReceiptStore, receipt: ExpansionReceipt) -> Result[u64, ExpansionError]
    effects: [compute, residual]
{
    if store.receipt_count >= 4096 {
        return Err(ExpansionError::ReceiptFull);
    }

    // Check for duplicate receipt ID
    for i in 0..store.receipt_count {
        if store.receipts[i].receipt_id == receipt.receipt_id {
            return Err(ExpansionError::ReceiptAlreadyExists);
        }
    }

    let idx: u64 = store.receipt_count;
    store.receipts[idx] = receipt;
    store.receipt_count = store.receipt_count + 1;

    @emit_residual("expansion_receipt_store.store", "receipt_stored", receipt.receipt_id);

    return Ok(receipt.receipt_id);
}

fn get_receipt(store: &ExpansionReceiptStore, receipt_id: u64) -> Result[&ExpansionReceipt, ExpansionError]
    effects: [compute]
{
    for i in 0..store.receipt_count {
        if store.receipts[i].receipt_id == receipt_id {
            return Ok(store.receipts[i]);
        }
    }
    return Err(ExpansionError::ReceiptNotFound);
}

fn get_receipts_by_diff_class(store: &ExpansionReceiptStore, diff_class: DiffClass) -> Result[Array[ExpansionReceipt, 4096], ExpansionError]
    effects: [compute]
{
    let mut results: Array[ExpansionReceipt, 4096] = Array[ExpansionReceipt, 4096]::zeroed();
    let mut count: u64 = 0;

    for i in 0..store.receipt_count {
        if store.receipts[i].diff_class == diff_class {
            if count < 4096 {
                results[count] = store.receipts[i];
                count = count + 1;
            }
        }
    }

    return Ok(results);
}

fn get_receipts_by_type(store: &ExpansionReceiptStore, exp_type: ExpansionType) -> Result[Array[ExpansionReceipt, 4096], ExpansionError]
    effects: [compute]
{
    let mut results: Array[ExpansionReceipt, 4096] = Array[ExpansionReceipt, 4096]::zeroed();
    let mut count: u64 = 0;

    for i in 0..store.receipt_count {
        if store.receipts[i].expansion_type == exp_type {
            if count < 4096 {
                results[count] = store.receipts[i];
                count = count + 1;
            }
        }
    }

    return Ok(results);
}

fn get_receipt_count(store: &ExpansionReceiptStore) -> u64
    effects: [compute]
{
    return store.receipt_count;
}

// ============================================================================
// Compare Two Receipts
// ============================================================================
// Compares two expansion receipts and produces a comparison report.

type ReceiptComparison = struct {
    receipt_a_id: u64,
    receipt_b_id: u64,
    input_match: bool,
    rule_match: bool,
    symbol_count_delta: i64,
    emitted_byte_count_delta: i64,
    diff_class_match: bool,
    deterministic_hash_match: bool,
    overall_match: bool,
}

fn compare_receipts(a: &ExpansionReceipt, b: &ExpansionReceipt) -> ReceiptComparison
    effects: [compute]
{
    let input_match: bool = a.input_hash == b.input_hash;
    let rule_match: bool = a.rule_selected.len == b.rule_selected.len;
    let mut rule_match_detailed: bool = rule_match;
    if rule_match {
        for i in 0..a.rule_selected.len {
            if a.rule_selected.data[i] != b.rule_selected.data[i] {
                rule_match_detailed = false;
                break;
            }
        }
    }

    let symbol_delta: i64 = (a.symbol_table_after.symbol_count as i64) - (b.symbol_table_after.symbol_count as i64);
    let byte_delta: i64 = (a.emitted_byte_count as i64) - (b.emitted_byte_count as i64);

    let diff_class_match: bool = a.diff_class == b.diff_class;
    let det_hash_match: bool = a.deterministic_hash == b.deterministic_hash;

    let overall: bool = input_match && rule_match_detailed && diff_class_match && det_hash_match;

    return ReceiptComparison {
        receipt_a_id: a.receipt_id,
        receipt_b_id: b.receipt_id,
        input_match: input_match,
        rule_match: rule_match_detailed,
        symbol_count_delta: symbol_delta,
        emitted_byte_count_delta: byte_delta,
        diff_class_match: diff_class_match,
        deterministic_hash_match: det_hash_match,
        overall_match: overall,
    };
}

// ============================================================================
// Generate Diff Report
// ============================================================================
// Produces a detailed diff report between emitted and oracle bytes.

type ByteDiffEntry = struct {
    offset: u64,
    emitted_byte: u8,
    oracle_byte: u8,
}

type DiffReport = struct {
    total_divergences: u64,
    max_consecutive_divergence: u64,
    divergence_ratio: u64,
    severity: DivergenceSeverity,
    diff_entries: Array[ByteDiffEntry, 1024],
    entry_count: u64,
}

fn generate_diff_report(receipt: &ExpansionReceipt) -> Result[DiffReport, ExpansionError]
    effects: [compute]
{
    if !receipt.oracle_available {
        return Err(ExpansionError::OracleMismatch);
    }

    let min_len: u64 = if receipt.emitted_byte_count < receipt.oracle_byte_count {
        receipt.emitted_byte_count
    } else {
        receipt.oracle_byte_count
    };

    let empty_entries: Array[ByteDiffEntry, 1024] = Array[ByteDiffEntry, 1024]::zeroed();
    let mut report: DiffReport = DiffReport {
        total_divergences: 0,
        max_consecutive_divergence: 0,
        divergence_ratio: 0,
        severity: DivergenceSeverity::Acceptable,
        diff_entries: empty_entries,
        entry_count: 0,
    };

    let mut consecutive: u64 = 0;
    let mut max_consecutive: u64 = 0;

    for i in 0..min_len {
        if receipt.emitted_bytes[i] != receipt.oracle_bytes[i] {
            report.total_divergences = report.total_divergences + 1;
            consecutive = consecutive + 1;

            if report.entry_count < 1024 {
                report.diff_entries[report.entry_count] = ByteDiffEntry {
                    offset: i,
                    emitted_byte: receipt.emitted_bytes[i],
                    oracle_byte: receipt.oracle_bytes[i],
                };
                report.entry_count = report.entry_count + 1;
            }
        } else {
            if consecutive > max_consecutive {
                max_consecutive = consecutive;
            }
            consecutive = 0;
        }
    }

    if consecutive > max_consecutive {
        max_consecutive = consecutive;
    }

    report.max_consecutive_divergence = max_consecutive;
    if min_len > 0 {
        report.divergence_ratio = (report.total_divergences * 100) / min_len;
    }

    // Determine severity
    if report.divergence_ratio == 0 {
        report.severity = DivergenceSeverity::Acceptable;
    } else if report.divergence_ratio < 5 && max_consecutive < 16 {
        report.severity = DivergenceSeverity::Minor;
    } else if report.divergence_ratio < 20 {
        report.severity = DivergenceSeverity::Significant;
    } else {
        report.severity = DivergenceSeverity::Critical;
    }

    return Ok(report);
}

// ============================================================================
// Hash Helper
// ============================================================================

fn hash_receipt_data(data: &Array[u8, 65536], len: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let hash_len: u64 = if len < 65536 { len } else { 65536 };

    for i in 0..hash_len {
        let idx: u64 = i & 31;
        result.bytes[idx] = result.bytes[idx] ^ data[i];
    }

    return result;
}

fn hash_combine_hash(a: Hash256, b: Hash256) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    return result;
}
