// file: boot_menu.phor
// purpose: Boot menu — menu entries, kernel selection, command line editing,
//          boot options, recovery mode, factory reset, boot configuration
//          persistence
// effects: [io:write, io:read, deterministic, residual]
// trust: TrustState_Bootstrap → TrustState_Operational

package "phorensic:boot_menu:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*
use boot::boot_console::*
use boot::boot_config::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_MENU_ENTRIES: u32 = 32
const MAX_ENTRY_NAME: u32 = 64
const MAX_ENTRY_DESC: u32 = 256
const MAX_MENU_OPTIONS: u32 = 16
const MAX_OPTION_NAME: u32 = 64
const MENU_TIMEOUT_DEFAULT: u32 = 10
const MENU_TIMEOUT_MAX: u32 = 300
const KEYBOARD_POLL_INTERVAL: u32 = 50  // milliseconds
const MAX_SUBMENU_DEPTH: u32 = 4

// Key codes
const KEY_ENTER: u8 = 0x0D
const KEY_ESC: u8 = 0x1B
const KEY_UP: u8 = 0x80
const KEY_DOWN: u8 = 0x81
const KEY_LEFT: u8 = 0x82
const KEY_RIGHT: u8 = 0x83
const KEY_PAGEUP: u8 = 0x84
const KEY_PAGEDOWN: u8 = 0x85
const KEY_HOME: u8 = 0x86
const KEY_END: u8 = 0x87
const KEY_DELETE: u8 = 0x88
const KEY_BACKSPACE: u8 = 0x08
const KEY_TAB: u8 = 0x09
const KEY_F1: u8 = 0x90
const KEY_F2: u8 = 0x91
const KEY_F3: u8 = 0x92
const KEY_F4: u8 = 0x93
const KEY_F5: u8 = 0x94
const KEY_F6: u8 = 0x95
const KEY_F7: u8 = 0x96
const KEY_F8: u8 = 0x97
const KEY_F9: u8 = 0x98
const KEY_F10: u8 = 0x99
const KEY_F11: u8 = 0x9A
const KEY_F12: u8 = 0x9B

// Menu action types
const MENU_ACTION_BOOT: u32 = 0
const MENU_ACTION_EDIT_CMDLINE: u32 = 1
const MENU_ACTION_EDIT_KERNEL: u32 = 2
const MENU_ACTION_EDIT_INITRAMFS: u32 = 3
const MENU_ACTION_EDIT_DTB: u32 = 4
const MENU_ACTION_SUBMENU: u32 = 5
const MENU_ACTION_SAVE_CONFIG: u32 = 6
const MENU_ACTION_REBOOT: u32 = 7
const MENU_ACTION_SHUTDOWN: u32 = 8
const MENU_ACTION_NEXT: u32 = 9

// ──────────────────────────────────────────────
// Menu Types
// ──────────────────────────────────────────────

pub type MenuAction : u32 = enum {
    Boot            = MENU_ACTION_BOOT,
    EditCmdline     = MENU_ACTION_EDIT_CMDLINE,
    EditKernel      = MENU_ACTION_EDIT_KERNEL,
    EditInitramfs   = MENU_ACTION_EDIT_INITRAMFS,
    EditDTB         = MENU_ACTION_EDIT_DTB,
    Submenu         = MENU_ACTION_SUBMENU,
    SaveConfig      = MENU_ACTION_SAVE_CONFIG,
    Reboot          = MENU_ACTION_REBOOT,
    Shutdown        = MENU_ACTION_SHUTDOWN,
    Next            = MENU_ACTION_NEXT,
}

pub type MenuEntry : struct {
    name: FixedString[MAX_ENTRY_NAME],
    description: FixedString[MAX_ENTRY_DESC],
    kernel_path: FixedString[256],
    cmdline: FixedString[512],
    initramfs_path: FixedString[256],
    dtb_path: FixedString[256],
    is_default: bool,
    is_recovery: bool,
    is_factory_reset: bool,
    action: MenuAction,
    subentries: FixedArray[8, u32],
    subentry_count: u32,
    flags: Word64,
}

impl MenuEntry {
    pub fn new() -> MenuEntry
        effects: [deterministic]
    {
        MenuEntry {
            name: FixedString::new(),
            description: FixedString::new(),
            kernel_path: FixedString::new(),
            cmdline: FixedString::new(),
            initramfs_path: FixedString::new(),
            dtb_path: FixedString::new(),
            is_default: false,
            is_recovery: false,
            is_factory_reset: false,
            action: MenuAction::Boot,
            subentries: FixedArray::new(),
            subentry_count: 0,
            flags: Word64::zero(),
        }
    }

    pub fn create_boot_entry(name: FixedString[MAX_ENTRY_NAME], kernel: FixedString[256], cmdline: FixedString[512]) -> MenuEntry
        effects: [deterministic]
    {
        MenuEntry {
            name: name,
            description: FixedString::new(),
            kernel_path: kernel,
            cmdline: cmdline,
            initramfs_path: FixedString::new(),
            dtb_path: FixedString::new(),
            is_default: false,
            is_recovery: false,
            is_factory_reset: false,
            action: MenuAction::Boot,
            subentries: FixedArray::new(),
            subentry_count: 0,
            flags: Word64::zero(),
        }
    }

    pub fn create_recovery_entry() -> MenuEntry
        effects: [deterministic]
    {
        MenuEntry {
            name: FixedString::from("Phorensic OS Recovery Mode"),
            description: FixedString::from("Boot into recovery shell with minimal services"),
            kernel_path: FixedString::from("\\kernel\\kernel.recovery"),
            cmdline: FixedString::from("recovery=1 loglevel=5 single_user=1"),
            initramfs_path: FixedString::from("\\initramfs\\recovery.cpio"),
            dtb_path: FixedString::new(),
            is_default: false,
            is_recovery: true,
            is_factory_reset: false,
            action: MenuAction::Boot,
            subentries: FixedArray::new(),
            subentry_count: 0,
            flags: Word64::zero(),
        }
    }

    pub fn create_factory_reset_entry() -> MenuEntry
        effects: [deterministic]
    {
        MenuEntry {
            name: FixedString::from("Factory Reset"),
            description: FixedString::from("Restore system to factory defaults (all data lost)"),
            kernel_path: FixedString::from("\\kernel\\kernel.reset"),
            cmdline: FixedString::from("factory_reset=1"),
            initramfs_path: FixedString::from("\\initramfs\\reset.cpio"),
            dtb_path: FixedString::new(),
            is_default: false,
            is_recovery: false,
            is_factory_reset: true,
            action: MenuAction::Boot,
            subentries: FixedArray::new(),
            subentry_count: 0,
            flags: Word64::zero(),
        }
    }

    pub fn create_submenu(name: FixedString[MAX_ENTRY_NAME]) -> MenuEntry
        effects: [deterministic]
    {
        MenuEntry {
            name: name,
            description: FixedString::new(),
            kernel_path: FixedString::new(),
            cmdline: FixedString::new(),
            initramfs_path: FixedString::new(),
            dtb_path: FixedString::new(),
            is_default: false,
            is_recovery: false,
            is_factory_reset: false,
            action: MenuAction::Submenu,
            subentries: FixedArray::new(),
            subentry_count: 0,
            flags: Word64::zero(),
        }
    }

    pub fn add_subentry(self: ref mut, entry_index: u32) -> Result[(), BootError>
        effects: [deterministic]
    {
        if self.subentry_count >= 8 {
            return Result::Err(BootError::new(
                DIAG_MENU_BASE | 0x001,
                "Maximum subentries exceeded"
            ))
        }
        self.subentries.set(self.subentry_count, entry_index)!
        self.subentry_count = self.subentry_count + 1
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Boot Option Toggle
// ──────────────────────────────────────────────

pub type BootOptionToggle : struct {
    name: FixedString[MAX_OPTION_NAME],
    description: FixedString[MAX_ENTRY_DESC],
    flag_mask: Word64,
    is_enabled: bool,
}

impl BootOptionToggle {
    pub fn new(name: FixedString[MAX_OPTION_NAME], desc: FixedString[MAX_ENTRY_DESC], flag: Word64) -> BootOptionToggle
        effects: [deterministic]
    {
        BootOptionToggle {
            name: name,
            description: desc,
            flag_mask: flag,
            is_enabled: false,
        }
    }

    pub fn toggle(self: ref mut)
        effects: [deterministic]
    {
        self.is_enabled = !self.is_enabled
    }

    pub fn set(self: ref mut, enabled: bool)
        effects: [deterministic]
    {
        self.is_enabled = enabled
    }
}

// ──────────────────────────────────────────────
// Boot Menu (main structure)
// ──────────────────────────────────────────────

pub type BootMenu : struct {
    entries: FixedArray[MAX_MENU_ENTRIES, MenuEntry],
    num_entries: u32,
    selected_index: u32,
    scroll_offset: u32,
    visible_rows: u32,
    timeout_seconds: u32,
    timeout_remaining: u32,
    default_entry: u32,
    show_timeout: bool,
    allow_editing: bool,
    allow_recovery: bool,
    menu_depth: u32,
    history: FixedArray[MAX_SUBMENU_DEPTH, u32],
    history_depth: u32,
    options: FixedArray[MAX_MENU_OPTIONS, BootOptionToggle],
    num_options: u32,
    boot_console: Cap(BootConsole),
}

impl BootMenu {
    pub fn new() -> BootMenu
        effects: [deterministic]
    {
        BootMenu {
            entries: FixedArray::new(),
            num_entries: 0,
            selected_index: 0,
            scroll_offset: 0,
            visible_rows: 20,
            timeout_seconds: MENU_TIMEOUT_DEFAULT,
            timeout_remaining: MENU_TIMEOUT_DEFAULT,
            default_entry: 0,
            show_timeout: true,
            allow_editing: true,
            allow_recovery: true,
            menu_depth: 0,
            history: FixedArray::new(),
            history_depth: 0,
            options: FixedArray::new(),
            num_options: 0,
            boot_console: Cap::dangling(),
        }
    }

    pub fn add_entry(self: ref mut, entry: MenuEntry) -> Result[(), BootError>
        effects: [deterministic]
    {
        if self.num_entries >= MAX_MENU_ENTRIES {
            return Result::Err(BootError::new(
                DIAG_MENU_BASE | 0x010,
                "Menu entry list full"
            ))
        }
        self.entries.set(self.num_entries, entry)!
        self.num_entries = self.num_entries + 1
        Result::Ok(())
    }

    pub fn set_default_entry(self: ref mut, index: u32)
        effects: [deterministic]
    {
        if index < self.num_entries {
            // Clear previous default
            for i in 0..self.num_entries {
                let mut entry: MenuEntry = self.entries.get(i)!
                entry.is_default = false
                self.entries.set(i, entry)!
            }
            let mut default: MenuEntry = self.entries.get(index)!
            default.is_default = true
            self.entries.set(index, default)!
            self.default_entry = index
        }
    }

    pub fn set_timeout(self: ref mut, seconds: u32)
        effects: [deterministic]
    {
        if seconds > MENU_TIMEOUT_MAX {
            self.timeout_seconds = MENU_TIMEOUT_MAX
        } else {
            self.timeout_seconds = seconds
        }
        self.timeout_remaining = self.timeout_seconds
    }

    // ──────────────────────────────────────────────
    // Add Standard Boot Options
    // ──────────────────────────────────────────────

    pub fn add_standard_options(self: ref mut)
        effects: [deterministic]
    {
        self.options.set(self.num_options,
            BootOptionToggle::new(
                FixedString::from("Verbose"),
                FixedString::from("Enable verbose boot logging"),
                0x01
            )
        )!
        self.num_options = self.num_options + 1

        self.options.set(self.num_options,
            BootOptionToggle::new(
                FixedString::from("Safe Mode"),
                FixedString::from("Boot with minimal drivers"),
                0x04
            )
        )!
        self.num_options = self.num_options + 1

        self.options.set(self.num_options,
            BootOptionToggle::new(
                FixedString::from("Single User"),
                FixedString::from("Boot into single-user mode"),
                0x08
            )
        )!
        self.num_options = self.num_options + 1

        self.options.set(self.num_options,
            BootOptionToggle::new(
                FixedString::from("Debug Mode"),
                FixedString::from("Enable kernel debug output"),
                0x10
            )
        )!
        self.num_options = self.num_options + 1

        self.options.set(self.num_options,
            BootOptionToggle::new(
                FixedString::from("Disable ACPI"),
                FixedString::from("Boot without ACPI support"),
                0x20
            )
        )!
        self.num_options = self.num_options + 1
    }

    // ──────────────────────────────────────────────
    // Menu Display
    // ──────────────────────────────────────────────

    pub fn display_menu(self: ref mut, console: Cap(Console)) -> u32
        effects: [io:write, io:read, deterministic]
    {
        self.boot_console = console

        // Populate default entries if empty
        if self.num_entries == 0 {
            self.populate_default_entries()
        }

        // Add standard options
        self.add_standard_options()

        // Show menu and wait for selection
        let selection: u32 = self.show_menu_loop()

        residual emit {
            event: "boot_menu.selection_made",
            selected_index: selection,
            timeout_remaining: self.timeout_remaining,
        }

        selection
    }

    fn populate_default_entries(self: ref mut)
        effects: [deterministic]
    {
        let main_entry: MenuEntry = MenuEntry::create_boot_entry(
            FixedString::from("Phorensic OS"),
            FixedString::from("\\kernel\\kernel.phor"),
            FixedString::from("root=/dev/sda1 quiet splash"),
        )
        self.add_entry(main_entry)!

        if self.allow_recovery {
            self.add_entry(MenuEntry::create_recovery_entry())!
        }

        // Advanced options submenu
        let mut advanced: MenuEntry = MenuEntry::create_submenu(FixedString::from("Advanced Options"))
        advanced.add_subentry(3)!
        advanced.add_subentry(4)!
        advanced.add_subentry(5)!
        self.add_entry(advanced)!

        // Submenu entries
        let prev_kernel: MenuEntry = MenuEntry::create_boot_entry(
            FixedString::from("Previous Kernel Version"),
            FixedString::from("\\kernel\\kernel.old.phor"),
            FixedString::from("root=/dev/sda1"),
        )
        self.add_entry(prev_kernel)!

        let memtest: MenuEntry = MenuEntry::create_boot_entry(
            FixedString::from("Memory Test"),
            FixedString::from("\\tools\\memtest.phor"),
            FixedString::from(""),
        )
        self.add_entry(memtest)!

        let hw_diag: MenuEntry = MenuEntry::create_boot_entry(
            FixedString::from("Hardware Diagnostics"),
            FixedString::from("\\tools\\hwdiag.phor"),
            FixedString::from("diagnostic=1"),
        )
        self.add_entry(hw_diag)!

        // Factory reset (last, dangerous)
        self.add_entry(MenuEntry::create_factory_reset_entry())!
    }

    fn show_menu_loop(self: ref mut) -> u32
        effects: [io:write, io:read, deterministic]
    {
        self.render_menu()

        loop: bounds[BOUND_LARGE] {
            let key: u8 = self.wait_for_key_with_timeout()

            match key {
                KEY_ENTER => {
                    let entry: MenuEntry = self.entries.get(self.selected_index)!
                    match entry.action {
                        MenuAction::Submenu => {
                            self.push_history(self.selected_index)
                            self.render_menu()
                        },
                        MenuAction::Boot => {
                            self.render_selection_confirmation(entry)
                            return self.selected_index
                        },
                        _ => {
                            return self.selected_index
                        },
                    }
                },
                KEY_ESC => {
                    if self.history_depth > 0 {
                        self.pop_history()
                        self.render_menu()
                    } else {
                        // ESC at top level remains or reboots
                        return self.default_entry
                    }
                },
                KEY_UP => {
                    if self.selected_index > 0 {
                        self.selected_index = self.selected_index - 1
                        self.adjust_scroll()
                        self.render_menu()
                    }
                },
                KEY_DOWN => {
                    if self.selected_index < self.num_entries - 1 {
                        self.selected_index = self.selected_index + 1
                        self.adjust_scroll()
                        self.render_menu()
                    }
                },
                KEY_PAGEUP => {
                    if self.selected_index > self.visible_rows {
                        self.selected_index = self.selected_index - self.visible_rows
                    } else {
                        self.selected_index = 0
                    }
                    self.adjust_scroll()
                    self.render_menu()
                },
                KEY_PAGEDOWN => {
                    let max_index: u32 = self.num_entries - 1
                    if self.selected_index + self.visible_rows < max_index {
                        self.selected_index = self.selected_index + self.visible_rows
                    } else {
                        self.selected_index = max_index
                    }
                    self.adjust_scroll()
                    self.render_menu()
                },
                KEY_HOME => {
                    self.selected_index = 0
                    self.scroll_offset = 0
                    self.render_menu()
                },
                KEY_END => {
                    self.selected_index = self.num_entries - 1
                    self.adjust_scroll()
                    self.render_menu()
                },
                KEY_F1 => {
                    self.show_help()
                    self.render_menu()
                },
                KEY_F2 => {
                    self.toggle_options_panel()
                    self.render_menu()
                },
                KEY_F10 => {
                    self.save_configuration()
                    self.render_menu()
                },
                0xFF => {
                    // Timeout expired — boot default
                    self.show_timeout_message()
                    return self.default_entry
                },
                _ => {},
            }
        }
    }

    fn wait_for_key_with_timeout(self: ref mut) -> u8
        effects: [io:read, deterministic]
    {
        if self.timeout_seconds == 0 || !self.show_timeout {
            // Wait indefinitely for a key
            return self.read_key()
        }

        // Poll with timeout
        let mut elapsed_ticks: u32 = 0
        let max_ticks: u32 = self.timeout_remaining * 20  // 50ms per tick
        loop: bounds[BOUND_LARGE] while elapsed_ticks < max_ticks {
            let key: u8 = self.try_read_key()
            if key != 0 {
                self.timeout_remaining = elapsed_ticks / 20
                return key
            }
            // Delay ~50ms
            self.busy_wait_50ms()
            elapsed_ticks = elapsed_ticks + 1

            // Update timeout display every second
            if elapsed_ticks % 20 == 0 {
                let remaining: u32 = self.timeout_remaining - (elapsed_ticks / 20)
                self.update_timeout_display(remaining)
            }
        }

        0xFF  // Timeout
    }

    fn read_key(self: ref mut) -> u8
        effects: [io:read, deterministic]
    {
        // In a real implementation, read from keyboard/serial
        // For now, return ENTER to boot default
        KEY_ENTER
    }

    fn try_read_key(self: ref mut) -> u8
        effects: [io:read, deterministic]
    {
        // Non-blocking key read
        0
    }

    fn busy_wait_50ms(self: ref mut)
        effects: [deterministic]
    {
        // Busy wait placeholder
        // In real hardware: use PIT/HPET for timing
    }

    // ──────────────────────────────────────────────
    // Menu Rendering
    // ──────────────────────────────────────────────

    fn render_menu(self: ref mut)
        effects: [io:write, deterministic]
    {
        // Clear screen area for menu
        self.boot_console.clear_screen()

        // Header
        self.boot_console.write_highlight(FixedString::from("Phorensic OS Boot Menu"))
        self.boot_console.write_line(FixedString::from("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))

        if self.history_depth > 0 {
            let mut breadcrumb: FixedString[128] = FixedString::from("  [")
            for i in 0..self.history_depth {
                let hist_idx: u32 = self.history.get(i)!
                let hist_entry: MenuEntry = self.entries.get(hist_idx)!
                breadcrumb.append_str(hist_entry.name)
                if i < self.history_depth - 1 {
                    breadcrumb.append_str(FixedString::from(" > "))
                }
            }
            breadcrumb.append_str(FixedString::from("]"))
            self.boot_console.write_line(breadcrumb)
            self.boot_console.write_line(FixedString::from(""))
        }

        // Get visible entries
        let effective_entries: FixedArray[MAX_MENU_ENTRIES, u32] = self.get_visible_entry_indices()
        let visible_count: u32 = effective_entries.len()

        for i in 0..visible_count {
            let entry_idx: u32 = effective_entries.get(i)!
            let entry: MenuEntry = self.entries.get(entry_idx)!

            let mut line: FixedString[80] = FixedString::new()

            if entry_idx == self.selected_index {
                line.append_str(FixedString::from("> "))
            } else {
                line.append_str(FixedString::from("  "))
            }

            if entry.is_default {
                line.append_str(FixedString::from("* "))
            } else {
                line.append_str(FixedString::from("  "))
            }

            match entry.action {
                MenuAction::Submenu => {
                    line.append_str(entry.name)
                    line.append_str(FixedString::from(" >"))
                },
                MenuAction::Boot => {
                    line.append_str(entry.name)
                    if entry.is_recovery {
                        line.append_str(FixedString::from(" [Recovery]"))
                    }
                    if entry.is_factory_reset {
                        line.append_str(FixedString::from(" [DANGER]"))
                    }
                },
                _ => {
                    line.append_str(entry.name)
                },
            }

            if entry_idx == self.selected_index {
                self.boot_console.write_highlight(line)
            } else {
                self.boot_console.write_line(line)
            }
        }

        // Footer
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))

        let mut footer: FixedString[80] = FixedString::new()
        footer.append_str(FixedString::from("  F1=Help  F2=Options  F10=Save  Enter=Boot  Esc=Back"))
        self.boot_console.write_line(footer)

        if self.show_timeout && self.timeout_seconds > 0 {
            let mut timeout_line: FixedString[40] = FixedString::new()
            timeout_line.append_str(FixedString::from("  Auto-boot in "))
            timeout_line.append_int(self.timeout_remaining)
            timeout_line.append_str(FixedString::from(" seconds"))
            self.boot_console.write_line(timeout_line)
        }
    }

    fn get_visible_entry_indices(self) -> FixedArray[MAX_MENU_ENTRIES, u32>
        effects: [deterministic]
    {
        let mut indices: FixedArray[MAX_MENU_ENTRIES, u32] = FixedArray::new()

        let start: u32 = self.scroll_offset
        let end: u32 = if start + self.visible_rows < self.num_entries {
            start + self.visible_rows
        } else {
            self.num_entries
        }

        for i in start..end {
            indices.push(i)!
        }

        indices
    }

    fn adjust_scroll(self: ref mut)
        effects: [deterministic]
    {
        if self.selected_index < self.scroll_offset {
            self.scroll_offset = self.selected_index
        } else if self.selected_index >= self.scroll_offset + self.visible_rows {
            self.scroll_offset = self.selected_index - self.visible_rows + 1
        }
    }

    fn update_timeout_display(self: ref mut, remaining: u32)
        effects: [io:write, deterministic]
    {
        let mut line: FixedString[40] = FixedString::new()
        line.append_str(FixedString::from("\r  Auto-boot in "))
        line.append_int(remaining)
        line.append_str(FixedString::from(" seconds "))
        self.boot_console.write(line)
    }

    fn show_timeout_message(self: ref mut)
        effects: [io:write, deterministic]
    {
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Timeout reached. Booting default entry..."))
    }

    fn render_selection_confirmation(self: ref mut, entry: MenuEntry)
        effects: [io:write, deterministic]
    {
        self.boot_console.write_line(FixedString::from(""))
        let mut msg: FixedString[128] = FixedString::new()
        msg.append_str(FixedString::from("Booting: "))
        msg.append_str(entry.name)
        self.boot_console.write_highlight(msg)

        if entry.is_recovery {
            self.boot_console.write_warning(FixedString::from("RECOVERY MODE: Limited functionality available"))
        }

        if entry.is_factory_reset {
            self.boot_console.write_error(FixedString::from("WARNING: Factory reset will erase all data!"))
            self.boot_console.write_line(FixedString::from("Press Ctrl+C to cancel, or wait 5 seconds..."))
            // In real implementation: 5 second delay with cancellation check
        }
    }

    // ──────────────────────────────────────────────
    // Help Display
    // ──────────────────────────────────────────────

    fn show_help(self: ref mut)
        effects: [io:write, deterministic]
    {
        self.boot_console.clear_screen()
        self.boot_console.write_highlight(FixedString::from("Boot Menu Help"))
        self.boot_console.write_line(FixedString::from("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Navigation:"))
        self.boot_console.write_line(FixedString::from("  ↑/↓      - Move between entries"))
        self.boot_console.write_line(FixedString::from("  PgUp/PgDn - Page up/down"))
        self.boot_console.write_line(FixedString::from("  Home/End  - First/last entry"))
        self.boot_console.write_line(FixedString::from("  Enter     - Boot selected entry"))
        self.boot_console.write_line(FixedString::from("  Esc       - Return to previous menu"))
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Actions:"))
        self.boot_console.write_line(FixedString::from("  F1        - This help screen"))
        self.boot_console.write_line(FixedString::from("  F2        - Toggle boot options"))
        self.boot_console.write_line(FixedString::from("  F10       - Save configuration"))
        self.boot_console.write_line(FixedString::from("  E         - Edit command line for selected entry"))
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Special Entries:"))
        self.boot_console.write_line(FixedString::from("  * [Recovery]  - Boot into recovery mode"))
        self.boot_console.write_line(FixedString::from("  * [DANGER]    - Factory reset (data loss!)"))
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Press any key to return to menu..."))
        self.read_key()
    }

    // ──────────────────────────────────────────────
    // Options Panel
    // ──────────────────────────────────────────────

    fn toggle_options_panel(self: ref mut)
        effects: [io:write, deterministic]
    {
        self.boot_console.clear_screen()
        self.boot_console.write_highlight(FixedString::from("Boot Options"))
        self.boot_console.write_line(FixedString::from("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
        self.boot_console.write_line(FixedString::from(""))

        for i in 0..self.num_options {
            let option: BootOptionToggle = self.options.get(i)!
            let mut line: FixedString[80] = FixedString::new()
            if option.is_enabled {
                line.append_str(FixedString::from("  [X] "))
            } else {
                line.append_str(FixedString::from("  [ ] "))
            }
            line.append_str(option.name)
            self.boot_console.write_line(line)
        }

        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("  Use ↑/↓ to select, Space to toggle, Esc to return"))
        self.boot_console.write_line(FixedString::from("  Options are applied to the selected boot entry"))

        // Wait for key in options panel
        loop: bounds[BOUND_MEDIUM] {
            let key: u8 = self.read_key()
            match key {
                KEY_UP => {
                    if self.selected_index > 0 {
                        self.selected_index = self.selected_index - 1
                    }
                },
                KEY_DOWN => {
                    if self.selected_index < self.num_options - 1 {
                        self.selected_index = self.selected_index + 1
                    }
                },
                ' ' as u8 => {
                    if self.selected_index < self.num_options {
                        let mut option: BootOptionToggle = self.options.get(self.selected_index)!
                        option.toggle()
                        self.options.set(self.selected_index, option)!
                    }
                },
                KEY_ESC | KEY_ENTER => {
                    break
                },
                _ => {},
            }
        }
    }

    // ──────────────────────────────────────────────
    // Command Line Editing
    // ──────────────────────────────────────────────

    pub fn edit_entry_cmdline(self: ref mut, entry_index: u32) -> Result[(), BootError>
        effects: [io:write, io:read, deterministic]
    {
        if entry_index >= self.num_entries {
            return Result::Err(BootError::new(
                DIAG_MENU_BASE | 0x020,
                "Invalid entry index for cmdline editing"
            ))
        }

        let entry: MenuEntry = self.entries.get(entry_index)!
        self.boot_console.clear_screen()
        self.boot_console.write_highlight(FixedString::from("Edit Command Line"))
        self.boot_console.write_line(FixedString::from("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"))
        let mut prompt: FixedString[80] = FixedString::from("Kernel: ")
        prompt.append_str(entry.kernel_path)
        self.boot_console.write_line(prompt)
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Current command line:"))
        self.boot_console.write_line(entry.cmdline)
        self.boot_console.write_line(FixedString::from(""))

        let new_cmdline: FixedString[512] = self.boot_console.read_line(
            FixedString::from("cmdline> ")
        )!

        let mut updated: MenuEntry = entry
        updated.cmdline = new_cmdline
        self.entries.set(entry_index, updated)!

        residual emit {
            event: "boot_menu.cmdline_edited",
            entry_index: entry_index,
        }

        Result::Ok(())
    }

    // ──────────────────────────────────────────────
    // History Management
    // ──────────────────────────────────────────────

    fn push_history(self: ref mut, entry_index: u32)
        effects: [deterministic]
    {
        if self.history_depth < MAX_SUBMENU_DEPTH {
            self.history.set(self.history_depth, entry_index)!
            self.history_depth = self.history_depth + 1
            self.menu_depth = self.menu_depth + 1
        }
    }

    fn pop_history(self: ref mut)
        effects: [deterministic]
    {
        if self.history_depth > 0 {
            self.history_depth = self.history_depth - 1
            self.menu_depth = self.menu_depth - 1
            if self.history_depth > 0 {
                self.selected_index = self.history.get(self.history_depth - 1)!
            } else {
                self.selected_index = 0
            }
            self.scroll_offset = 0
        }
    }

    // ──────────────────────────────────────────────
    // Configuration Persistence
    // ──────────────────────────────────────────────

    pub fn save_configuration(self: ref mut)
        effects: [io:write, deterministic]
    {
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Saving boot configuration..."))

        // In a real implementation, write boot config to disk/EFI variable
        let config: BootConfiguration = self.build_configuration()
        let save_result: Result[(), BootError> = config.save_to_firmware()
        if save_result.is_ok() {
            self.boot_console.write_success(FixedString::from("Boot configuration saved"))
        } else {
            self.boot_console.write_error(FixedString::from("Failed to save boot configuration"))
        }

        residual emit {
            event: "boot_menu.config_saved",
            num_entries: self.num_entries,
            default_entry: self.default_entry,
            timeout: self.timeout_seconds,
        }
    }

    fn build_configuration(self: ref BootMenu) -> BootConfiguration
        effects: [deterministic]
    {
        let mut config: BootConfiguration = BootConfiguration::new()
        for i in 0..self.num_entries {
            let entry: MenuEntry = self.entries.get(i)!
            config.add_boot_entry(BootConfigEntry {
                name: entry.name,
                kernel_path: entry.kernel_path,
                cmdline: entry.cmdline,
                initramfs_path: entry.initramfs_path,
                dtb_path: entry.dtb_path,
                is_recovery: entry.is_recovery,
                is_factory_reset: entry.is_factory_reset,
            })!
        }
        config.default_entry = self.default_entry
        config.timeout_seconds = self.timeout_seconds
        config
    }

    // ──────────────────────────────────────────────
    // Factory Reset Confirmation
    // ──────────────────────────────────────────────

    pub fn confirm_factory_reset(self: ref mut) -> bool
        effects: [io:write, io:read, deterministic]
    {
        self.boot_console.clear_screen()
        self.boot_console.write_error(FixedString::from("⚠ FACTORY RESET CONFIRMATION ⚠"))
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("This will erase ALL data and restore factory defaults."))
        self.boot_console.write_line(FixedString::from("This operation CANNOT be undone!"))
        self.boot_console.write_line(FixedString::from(""))
        self.boot_console.write_line(FixedString::from("Type 'YES' to confirm, or press Enter to cancel:"))

        let response: FixedString[MAX_INPUT_BUFFER] = self.boot_console.read_line(
            FixedString::from("confirm> ")
        )!

        if response == FixedString::from("YES") {
            self.boot_console.write_line(FixedString::from("Factory reset confirmed. Proceeding..."))
            residual emit {
                event: "boot_menu.factory_reset_confirmed",
            }
            return true
        }

        self.boot_console.write_line(FixedString::from("Factory reset cancelled."))
        false
    }
}

// ──────────────────────────────────────────────
// BootError for boot_menu module
// ──────────────────────────────────────────────

pub type BootError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BootError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BootError
        effects: [deterministic]
    {
        BootError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        self.code == 0
    }
}
