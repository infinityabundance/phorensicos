fn handle_cap_reduce[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, unsafe) { default_return() }
fn handle_cap_copy[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, unsafe) { default_return() }
fn handle_cap_move[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, unsafe) { default_return() }
