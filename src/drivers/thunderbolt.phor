// thunderbolt.phor — Thunderbolt/USB4 driver
// CM (connection manager) protocol, DP IN/OUT adapters,
// PCIe tunneling, USB3 tunneling, power delivery,
// NVM firmware update, retimer handling, capability-based connection management.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/thunderbolt.phor
// Court: thunderbolt_driver:v2

package drivers.thunderbolt;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type ThunderboltError = enum {
    TbtNotInitialized           = 0xB00,
    TbtControllerNotFound       = 0xB01,
    TbtRouterNotFound           = 0xB02,
    TbtCmProtocolError          = 0xB03,
    TbtDpAdapterError           = 0xB04,
    TbtPcieTunnelError          = 0xB05,
    TbtUsb3TunnelError          = 0xB06,
    TbtPowerDeliveryError       = 0xB07,
    TbtNvmFwError               = 0xB08,
    TbtRetimerError             = 0xB09,
    TbtCapabilityError          = 0xB0A,
    TbtLinkError                = 0xB0B,
    TbtHrmError                 = 0xB0C,
    TbtPathError                = 0xB0D,
    TbtMaxDevicesExceeded       = 0xB0E,
    TbtResidualStoreFull        = 0xB0F,
    TbtDpInNotAvailable         = 0xB10,
    TbtDpOutNotAvailable        = 0xB11,
    TbtNvmAuthFailed            = 0xB12,
    TbtPcieTunnelLimitReached   = 0xB13,
    TbtUsb3TunnelLimitReached   = 0xB14,
    TbtCmTimeout                = 0xB15,
    TbtRetimerDiscoveryFailed   = 0xB16,
    TbtCapabilityMismatch       = 0xB17,
    TbtPowerDeliveryNegFailed   = 0xB18,
    TbtRouterNotReady           = 0xB19,
}

// ─────────────────────────────────────────────────────────────
// Thunderbolt Full Capability
// ─────────────────────────────────────────────────────────────

struct ThunderboltCapability {
    object_id: Identity,
    generation: u64,
    can_manage_router: bool,
    can_tunnel_pcie: bool,
    can_tunnel_usb3: bool,
    can_tunnel_dp: bool,
    can_power_delivery: bool,
    can_nvm_update: bool,
    can_retimer: bool,
    can_cm_protocol: bool,
    max_paths: u64,
}

// ─────────────────────────────────────────────────────────────
// Thunderbolt / USB4 Generations
// ─────────────────────────────────────────────────────────────

type TbtGeneration = enum {
    Thunderbolt1     = 0,
    Thunderbolt2     = 1,
    Thunderbolt3     = 2,
    Thunderbolt4     = 3,
    Thunderbolt5     = 4,
    Usb4Gen2        = 5,
    Usb4Gen3        = 6,
    Usb4Gen4        = 7,
    UnknownTbtGen   = 8,
}

// ─────────────────────────────────────────────────────────────
// Router / Device Role
// ─────────────────────────────────────────────────────────────

type TbtRouterRole = enum {
    HostRouter   = 0,
    Endpoint     = 1,
    BranchRouter = 2,
    Retimer      = 3,
    UnknownRole  = 4,
}

// ─────────────────────────────────────────────────────────────
// Adapter Types
// ─────────────────────────────────────────────────────────────

type TbtAdapterType = enum {
    PcieDownstream  = 0x01,
    PcieUpstream    = 0x02,
    DpIn            = 0x03,
    DpOut           = 0x04,
    Usb3Downstream  = 0x05,
    Usb3Upstream    = 0x06,
    Custom          = 0x07,
}

// ─────────────────────────────────────────────────────────────
// Path Configuration
// ─────────────────────────────────────────────────────────────

struct TbtPath {
    path_id: u16,
    ingress_port: u8,
    ingress_counter: u8,
    egress_port: u8,
    egress_counter: u8,
    tc: u8,
    hop_id: u16,
    weight: u8,
    path_enabled: bool,
}

// ─────────────────────────────────────────────────────────────
// Connection Manager (CM) State
// ─────────────────────────────────────────────────────────────

struct TbtConnectionManager {
    protocol_version: u16,
    max_hop_id: u16,
    max_paths: u16,
    max_adapters: u16,
    ctrl_version: u8,
    cm_state: TbtCmState,
    residual_log: RingBuf(ResidualRecord, 32),
}

type TbtCmState = enum {
    Disconnected = 0,
    Connecting   = 1,
    Connected    = 2,
    Error        = 3,
}

// ─────────────────────────────────────────────────────────────
// DP Adapter (IN/OUT)
// ─────────────────────────────────────────────────────────────

struct TbtDpAdapter {
    adapter_no: u16,
    dp_type: TbtAdapterType,
    dp_in_bandwidth: u32,
    dp_out_bandwidth: u32,
    nho: u16,
    max_lane_count: u8,
    max_link_rate: u8,
    dp_in_available: bool,
    dp_out_available: bool,
    tunnel_established: bool,
    cable_id: u8,
    display_port_ver: u8,
    hdcp_supported: bool,
}

// ─────────────────────────────────────────────────────────────
// PCIe Tunnel State
// ─────────────────────────────────────────────────────────────

struct TbtPcieTunnel {
    tunnel_id: u16,
    route_string: u64,
    upstream_port: u16,
    downstream_port: u16,
    allocated_bandwidth: u32,
    max_bandwidth: u32,
    tunnel_active: bool,
    pcie_generation: u8,
    lane_count: u8,
}

// ─────────────────────────────────────────────────────────────
// USB3 Tunnel State
// ─────────────────────────────────────────────────────────────

struct TbtUsb3Tunnel {
    tunnel_id: u16,
    route_string: u64,
    upstream_port: u16,
    downstream_port: u16,
    allocated_bandwidth: u32,
    max_bandwidth: u32,
    tunnel_active: bool,
    usb3_generation: u8,
    usb3_speed: u8,
}

// ─────────────────────────────────────────────────────────────
// Power Delivery State
// ─────────────────────────────────────────────────────────────

struct TbtPowerDeliveryState {
    pd_protocol_version: u8,
    source_capabilities: u32,
    sink_capabilities: u32,
    negotiated_power_mw: u32,
    max_power_mw: u32,
    pd_contract_active: bool,
    usb_typec_current: u8,
    vbus_voltage_mv: u16,
    cable_current_cap: u16,
}

// ─────────────────────────────────────────────────────────────
// NVM Firmware Update State
// ─────────────────────────────────────────────────────────────

struct TbtNvmUpdateState {
    nvm_version: u32,
    nvm_sector_size: u32,
    nvm_total_size: u32,
    update_progress: u8,
    auth_status: u8,
    update_in_progress: bool,
    pending_reset: bool,
    nvm_write_pointer: u32,
}

// ─────────────────────────────────────────────────────────────
// Retimer State
// ─────────────────────────────────────────────────────────────

struct TbtRetimerState {
    retimer_id: u8,
    present: bool,
    retimer_type: u8,
    link_training_done: bool,
    lane_reversal: bool,
    signal_degradation: u8,
    temperature: u16,
    nvm_version: u32,
}

// ─────────────────────────────────────────────────────────────
// Router (Device) State
// ─────────────────────────────────────────────────────────────

struct TbtRouter {
    router_identity: Identity,
    depth: u8,
    route_string: u64,
    role: TbtRouterRole,
    generation: TbtGeneration,
    vendor_id: u16,
    device_id: u16,
    nvm_version: u32,
    max_tunnel_depth: u8,
    adapter_count: u16,
    dp_adapters: Array(TbtDpAdapter, 8),
    dp_adapter_count: u8,
    pcie_tunnels: Array(TbtPcieTunnel, 8),
    pcie_tunnel_count: u8,
    usb3_tunnels: Array(TbtUsb3Tunnel, 8),
    usb3_tunnel_count: u8,
    paths: Array(TbtPath, 32),
    path_count: u16,
    cm: TbtConnectionManager,
    pd: TbtPowerDeliveryState,
    nvm: TbtNvmUpdateState,
    retimers: Array(TbtRetimerState, 4),
    retimer_count: u8,
    connected: bool,
    initialized: bool,
}

// ─────────────────────────────────────────────────────────────
// Controller State
// ─────────────────────────────────────────────────────────────

struct TbtController {
    controller_identity: Identity,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    irq_vector: u8,
    generation: TbtGeneration,
    host_router: TbtRouter,
    downstream_routers: Array(TbtRouter, 8),
    downstream_count: u8,
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    cap: ThunderboltCapability,
    version: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct ThunderboltDriverState {
    driver_identity: Identity,
    controllers: Array(TbtController, 4),
    controller_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_tunnels: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// CM Protocol: Get Route String
// ─────────────────────────────────────────────────────────────

fn tbt_cm_get_route_string(
    router: Handle(TbtRouter),
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(u64, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_cm_get_route_string:v1"
{
    if !cap.can_cm_protocol {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    let route: u64 = router.route_string;

    residual emit {
        op: "tbt.cm_get_route_string",
        route: route,
        timestamp: timestamp,
    };

    return Result::Ok(route);
}

// ─────────────────────────────────────────────────────────────
// CM Protocol: Set Route String
// ─────────────────────────────────────────────────────────────

fn tbt_cm_set_route_string(
    router: Handle(TbtRouter),
    route: u64,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_cm_set_route_string:v1"
{
    if !cap.can_cm_protocol {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    router.route_string = route;

    residual emit {
        op: "tbt.cm_set_route_string",
        route: route,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// CM Protocol: Add Path
// ─────────────────────────────────────────────────────────────

fn tbt_cm_add_path(
    router: Handle(TbtRouter),
    path: TbtPath,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(u16, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_cm_add_path:v1"
{
    if !cap.can_cm_protocol {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    if (router.path_count as u64) >= 32 {
        return Result::Err(ThunderboltError::TbtMaxDevicesExceeded);
    };

    let idx: u64 = router.path_count as u64;
    router.paths[idx] = path;
    router.paths[idx].path_id = router.path_count;
    router.paths[idx].path_enabled = false;
    router.path_count = router.path_count + 1;

    residual emit {
        op: "tbt.cm_add_path",
        ingress_port: path.ingress_port as u64,
        egress_port: path.egress_port as u64,
        hop_id: path.hop_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(router.paths[idx].path_id);
}

// ─────────────────────────────────────────────────────────────
// CM Protocol: Enable Path
// ─────────────────────────────────────────────────────────────

fn tbt_cm_enable_path(
    router: Handle(TbtRouter),
    path_id: u16,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_cm_enable_path:v1"
{
    if !cap.can_cm_protocol {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    loop bound 32 {
        let mut i: u64 = 0;
        if i >= (router.path_count as u64) {
            break;
        };
        if router.paths[i].path_id == path_id {
            router.paths[i].path_enabled = true;
            residual emit {
                op: "tbt.cm_enable_path",
                path_id: path_id as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
        i = i + 1;
    };

    return Result::Err(ThunderboltError::TbtPathError);
}

// ─────────────────────────────────────────────────────────────
// CM Protocol: Disable Path
// ─────────────────────────────────────────────────────────────

fn tbt_cm_disable_path(
    router: Handle(TbtRouter),
    path_id: u16,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_cm_disable_path:v1"
{
    if !cap.can_cm_protocol {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    loop bound 32 {
        let mut i: u64 = 0;
        if i >= (router.path_count as u64) {
            break;
        };
        if router.paths[i].path_id == path_id {
            router.paths[i].path_enabled = false;
            residual emit {
                op: "tbt.cm_disable_path",
                path_id: path_id as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
        i = i + 1;
    };

    return Result::Err(ThunderboltError::TbtPathError);
}

// ─────────────────────────────────────────────────────────────
// DP IN Adapter Setup
// ─────────────────────────────────────────────────────────────

fn tbt_dp_in_setup(
    router: Handle(TbtRouter),
    adapter_no: u16,
    max_lanes: u8,
    max_link_rate: u8,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_dp_in_setup:v1"
{
    if !cap.can_tunnel_dp {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    if (router.dp_adapter_count as u64) >= 8 {
        return Result::Err(ThunderboltError::TbtDpInNotAvailable);
    };

    let idx: u64 = router.dp_adapter_count as u64;
    router.dp_adapters[idx] = TbtDpAdapter {
        adapter_no: adapter_no,
        dp_type: TbtAdapterType::DpIn,
        dp_in_bandwidth: 0,
        dp_out_bandwidth: 0,
        nho: 0,
        max_lane_count: max_lanes,
        max_link_rate: max_link_rate,
        dp_in_available: true,
        dp_out_available: false,
        tunnel_established: false,
        cable_id: 0,
        display_port_ver: 2,
        hdcp_supported: false,
    };
    router.dp_adapter_count = router.dp_adapter_count + 1;

    residual emit {
        op: "tbt.dp_in_setup",
        adapter_no: adapter_no as u64,
        max_lanes: max_lanes as u64,
        max_link_rate: max_link_rate as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// DP OUT Adapter Setup
// ─────────────────────────────────────────────────────────────

fn tbt_dp_out_setup(
    router: Handle(TbtRouter),
    adapter_no: u16,
    max_lanes: u8,
    max_link_rate: u8,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_dp_out_setup:v1"
{
    if !cap.can_tunnel_dp {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    if (router.dp_adapter_count as u64) >= 8 {
        return Result::Err(ThunderboltError::TbtDpOutNotAvailable);
    };

    let idx: u64 = router.dp_adapter_count as u64;
    router.dp_adapters[idx] = TbtDpAdapter {
        adapter_no: adapter_no,
        dp_type: TbtAdapterType::DpOut,
        dp_in_bandwidth: 0,
        dp_out_bandwidth: 0,
        nho: 0,
        max_lane_count: max_lanes,
        max_link_rate: max_link_rate,
        dp_in_available: false,
        dp_out_available: true,
        tunnel_established: false,
        cable_id: 0,
        display_port_ver: 2,
        hdcp_supported: false,
    };
    router.dp_adapter_count = router.dp_adapter_count + 1;

    residual emit {
        op: "tbt.dp_out_setup",
        adapter_no: adapter_no as u64,
        max_lanes: max_lanes as u64,
        max_link_rate: max_link_rate as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// DP Adapter: Establish Tunnel
// ─────────────────────────────────────────────────────────────

fn tbt_dp_establish_tunnel(
    router: Handle(TbtRouter),
    adapter_no: u16,
    bandwidth: u32,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_dp_establish_tunnel:v1"
{
    if !cap.can_tunnel_dp {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    loop bound 8 {
        let mut i: u64 = 0;
        if i >= (router.dp_adapter_count as u64) {
            break;
        };
        if router.dp_adapters[i].adapter_no == adapter_no {
            router.dp_adapters[i].tunnel_established = true;
            if router.dp_adapters[i].dp_type == TbtAdapterType::DpIn {
                router.dp_adapters[i].dp_in_bandwidth = bandwidth;
            } else {
                router.dp_adapters[i].dp_out_bandwidth = bandwidth;
            };
            residual emit {
                op: "tbt.dp_establish_tunnel",
                adapter_no: adapter_no as u64,
                bandwidth: bandwidth,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
        i = i + 1;
    };

    return Result::Err(ThunderboltError::TbtDpAdapterError);
}

// ─────────────────────────────────────────────────────────────
// PCIe Tunneling: Add Tunnel
// ─────────────────────────────────────────────────────────────

fn tbt_pcie_add_tunnel(
    router: Handle(TbtRouter),
    route_string: u64,
    upstream_port: u16,
    downstream_port: u16,
    bandwidth: u32,
    max_bandwidth: u32,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(u16, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_pcie_add_tunnel:v1"
{
    if !cap.can_tunnel_pcie {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    if (router.pcie_tunnel_count as u64) >= 8 {
        return Result::Err(ThunderboltError::TbtPcieTunnelLimitReached);
    };

    let idx: u64 = router.pcie_tunnel_count as u64;
    router.pcie_tunnels[idx] = TbtPcieTunnel {
        tunnel_id: router.pcie_tunnel_count,
        route_string: route_string,
        upstream_port: upstream_port,
        downstream_port: downstream_port,
        allocated_bandwidth: bandwidth,
        max_bandwidth: max_bandwidth,
        tunnel_active: true,
        pcie_generation: 4,
        lane_count: 4,
    };
    router.pcie_tunnel_count = router.pcie_tunnel_count + 1;

    residual emit {
        op: "tbt.pcie_add_tunnel",
        tunnel_id: router.pcie_tunnels[idx].tunnel_id as u64,
        route: route_string,
        bandwidth: bandwidth,
        timestamp: timestamp,
    };

    return Result::Ok(router.pcie_tunnels[idx].tunnel_id);
}

// ─────────────────────────────────────────────────────────────
// PCIe Tunneling: Remove Tunnel
// ─────────────────────────────────────────────────────────────

fn tbt_pcie_remove_tunnel(
    router: Handle(TbtRouter),
    tunnel_id: u16,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_pcie_remove_tunnel:v1"
{
    if !cap.can_tunnel_pcie {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    loop bound 8 {
        let mut i: u64 = 0;
        if i >= (router.pcie_tunnel_count as u64) {
            break;
        };
        if router.pcie_tunnels[i].tunnel_id == tunnel_id {
            router.pcie_tunnels[i].tunnel_active = false;
            residual emit {
                op: "tbt.pcie_remove_tunnel",
                tunnel_id: tunnel_id as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
        i = i + 1;
    };

    return Result::Err(ThunderboltError::TbtPcieTunnelError);
}

// ─────────────────────────────────────────────────────────────
// USB3 Tunneling: Add Tunnel
// ─────────────────────────────────────────────────────────────

fn tbt_usb3_add_tunnel(
    router: Handle(TbtRouter),
    route_string: u64,
    upstream_port: u16,
    downstream_port: u16,
    bandwidth: u32,
    max_bandwidth: u32,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(u16, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_usb3_add_tunnel:v1"
{
    if !cap.can_tunnel_usb3 {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    if (router.usb3_tunnel_count as u64) >= 8 {
        return Result::Err(ThunderboltError::TbtUsb3TunnelLimitReached);
    };

    let idx: u64 = router.usb3_tunnel_count as u64;
    router.usb3_tunnels[idx] = TbtUsb3Tunnel {
        tunnel_id: router.usb3_tunnel_count,
        route_string: route_string,
        upstream_port: upstream_port,
        downstream_port: downstream_port,
        allocated_bandwidth: bandwidth,
        max_bandwidth: max_bandwidth,
        tunnel_active: true,
        usb3_generation: 3,
        usb3_speed: 2,
    };
    router.usb3_tunnel_count = router.usb3_tunnel_count + 1;

    residual emit {
        op: "tbt.usb3_add_tunnel",
        tunnel_id: router.usb3_tunnels[idx].tunnel_id as u64,
        route: route_string,
        bandwidth: bandwidth,
        timestamp: timestamp,
    };

    return Result::Ok(router.usb3_tunnels[idx].tunnel_id);
}

// ─────────────────────────────────────────────────────────────
// USB3 Tunneling: Remove Tunnel
// ─────────────────────────────────────────────────────────────

fn tbt_usb3_remove_tunnel(
    router: Handle(TbtRouter),
    tunnel_id: u16,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_usb3_remove_tunnel:v1"
{
    if !cap.can_tunnel_usb3 {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    loop bound 8 {
        let mut i: u64 = 0;
        if i >= (router.usb3_tunnel_count as u64) {
            break;
        };
        if router.usb3_tunnels[i].tunnel_id == tunnel_id {
            router.usb3_tunnels[i].tunnel_active = false;
            residual emit {
                op: "tbt.usb3_remove_tunnel",
                tunnel_id: tunnel_id as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
        i = i + 1;
    };

    return Result::Err(ThunderboltError::TbtUsb3TunnelError);
}

// ─────────────────────────────────────────────────────────────
// Power Delivery: Negotiate Contract
// ─────────────────────────────────────────────────────────────

fn tbt_pd_negotiate(
    router: Handle(TbtRouter),
    requested_power_mw: u32,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(u32, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_pd_negotiate:v1"
{
    if !cap.can_power_delivery {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    let pd: Handle(TbtPowerDeliveryState) = Handle(TbtPowerDeliveryState)::from_ptr(&router.pd);

    let negotiated: u32;
    if requested_power_mw <= pd.max_power_mw {
        negotiated = requested_power_mw;
    } else {
        negotiated = pd.max_power_mw;
    };

    pd.negotiated_power_mw = negotiated;
    pd.pd_contract_active = true;

    residual emit {
        op: "tbt.pd_negotiate",
        requested_mw: requested_power_mw,
        negotiated_mw: negotiated,
        timestamp: timestamp,
    };

    return Result::Ok(negotiated);
}

// ─────────────────────────────────────────────────────────────
// Power Delivery: Get Status
// ─────────────────────────────────────────────────────────────

fn tbt_pd_get_status(
    router: Handle(TbtRouter),
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(TbtPowerDeliveryState, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_pd_get_status:v1"
{
    if !cap.can_power_delivery {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    return Result::Ok(router.pd);
}

// ─────────────────────────────────────────────────────────────
// NVM Firmware Update: Start
// ─────────────────────────────────────────────────────────────

fn tbt_nvm_update_start(
    router: Handle(TbtRouter),
    nvm_version: u32,
    sector_size: u32,
    total_size: u32,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_nvm_update_start:v1"
{
    if !cap.can_nvm_update {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    let nvm: Handle(TbtNvmUpdateState) = Handle(TbtNvmUpdateState)::from_ptr(&router.nvm);

    if nvm.update_in_progress {
        return Result::Err(ThunderboltError::TbtNvmFwError);
    };

    nvm.nvm_version = nvm_version;
    nvm.nvm_sector_size = sector_size;
    nvm.nvm_total_size = total_size;
    nvm.update_progress = 0;
    nvm.auth_status = 0;
    nvm.update_in_progress = true;
    nvm.pending_reset = false;
    nvm.nvm_write_pointer = 0;

    residual emit {
        op: "tbt.nvm_update_start",
        nvm_version: nvm_version,
        sector_size: sector_size,
        total_size: total_size,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// NVM Firmware Update: Write Data
// ─────────────────────────────────────────────────────────────

fn tbt_nvm_write(
    router: Handle(TbtRouter),
    data: Array(u8, 4096),
    offset: u32,
    length: u32,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_nvm_write:v1"
{
    if !cap.can_nvm_update {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    let nvm: Handle(TbtNvmUpdateState) = Handle(TbtNvmUpdateState)::from_ptr(&router.nvm);

    if !nvm.update_in_progress {
        return Result::Err(ThunderboltError::TbtNvmFwError);
    };

    if offset + length > nvm.nvm_total_size {
        return Result::Err(ThunderboltError::TbtNvmFwError);
    };

    nvm.nvm_write_pointer = offset + length;
    nvm.update_progress = ((nvm.nvm_write_pointer * 100) / nvm.nvm_total_size) as u8;

    residual emit {
        op: "tbt.nvm_write",
        offset: offset,
        length: length,
        progress: nvm.update_progress as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// NVM Firmware Update: Authenticate
// ─────────────────────────────────────────────────────────────

fn tbt_nvm_authenticate(
    router: Handle(TbtRouter),
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_nvm_authenticate:v1"
{
    if !cap.can_nvm_update {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    let nvm: Handle(TbtNvmUpdateState) = Handle(TbtNvmUpdateState)::from_ptr(&router.nvm);

    if !nvm.update_in_progress {
        return Result::Err(ThunderboltError::TbtNvmFwError);
    };

    nvm.auth_status = 1;
    nvm.pending_reset = true;

    residual emit {
        op: "tbt.nvm_authenticate",
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Retimer: Discover and Add
// ─────────────────────────────────────────────────────────────

fn tbt_retimer_discover(
    router: Handle(TbtRouter),
    retimer_id: u8,
    present: bool,
    retimer_type: u8,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_retimer_discover:v1"
{
    if !cap.can_retimer {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    if (router.retimer_count as u64) >= 4 {
        return Result::Err(ThunderboltError::TbtMaxDevicesExceeded);
    };

    let idx: u64 = router.retimer_count as u64;
    router.retimers[idx] = TbtRetimerState {
        retimer_id: retimer_id,
        present: present,
        retimer_type: retimer_type,
        link_training_done: false,
        lane_reversal: false,
        signal_degradation: 0,
        temperature: 0,
        nvm_version: 0,
    };
    router.retimer_count = router.retimer_count + 1;

    residual emit {
        op: "tbt.retimer_discover",
        retimer_id: retimer_id as u64,
        retimer_type: retimer_type as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Retimer: Link Training Status
// ─────────────────────────────────────────────────────────────

fn tbt_retimer_link_training(
    router: Handle(TbtRouter),
    retimer_id: u8,
    done: bool,
    lane_reversal: bool,
    degradation: u8,
    temperature: u16,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_retimer_link_training:v1"
{
    if !cap.can_retimer {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    loop bound 4 {
        let mut i: u64 = 0;
        if i >= (router.retimer_count as u64) {
            break;
        };
        if router.retimers[i].retimer_id == retimer_id {
            router.retimers[i].link_training_done = done;
            router.retimers[i].lane_reversal = lane_reversal;
            router.retimers[i].signal_degradation = degradation;
            router.retimers[i].temperature = temperature;
            residual emit {
                op: "tbt.retimer_link_training",
                retimer_id: retimer_id as u64,
                done: done,
                degradation: degradation as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
        i = i + 1;
    };

    return Result::Err(ThunderboltError::TbtRetimerError);
}

// ─────────────────────────────────────────────────────────────
// Capability-Based Connection Management: Evaluate Connection
// ─────────────────────────────────────────────────────────────

fn tbt_cap_connection_evaluate(
    router: Handle(TbtRouter),
    requested_adapters: u16,
    requested_bandwidth: u32,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(bool, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_cap_connection_evaluate:v1"
{
    if !cap.can_cm_protocol {
        return Result::Err(ThunderboltError::TbtCapabilityError);
    };

    let mut available_adapters: u16 = 0;
    loop bound 8 {
        let mut i: u64 = 0;
        if i >= (router.dp_adapter_count as u64) {
            break;
        };
        if router.dp_adapters[i].dp_in_available || router.dp_adapters[i].dp_out_available {
            available_adapters = available_adapters + 1;
        };
        i = i + 1;
    };

    let feasible: bool = (available_adapters >= requested_adapters) && (requested_bandwidth <= 40000);

    residual emit {
        op: "tbt.cap_connection_evaluate",
        requested_adapters: requested_adapters as u64,
        requested_bandwidth: requested_bandwidth,
        feasible: feasible,
        timestamp: timestamp,
    };

    return Result::Ok(feasible);
}

// ─────────────────────────────────────────────────────────────
// Router Initialization
// ─────────────────────────────────────────────────────────────

fn tbt_router_init(
    router: Handle(TbtRouter),
    route_string: u64,
    role: TbtRouterRole,
    generation: TbtGeneration,
    depth: u8,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_router_init:v1"
{
    router.route_string = route_string;
    router.role = role;
    router.generation = generation;
    router.depth = depth;
    router.connected = true;
    router.initialized = true;

    router.cm = TbtConnectionManager {
        protocol_version: 1,
        max_hop_id: 63,
        max_paths: 32,
        max_adapters: 8,
        ctrl_version: 2,
        cm_state: TbtCmState::Connected,
        residual_log: RingBuf::new(),
    };

    router.pd = TbtPowerDeliveryState {
        pd_protocol_version: 3,
        source_capabilities: 0,
        sink_capabilities: 0,
        negotiated_power_mw: 0,
        max_power_mw: 100000,
        pd_contract_active: false,
        usb_typec_current: 0,
        vbus_voltage_mv: 5000,
        cable_current_cap: 5000,
    };

    residual emit {
        op: "tbt.router_init",
        route: route_string,
        role: role as u64,
        generation: generation as u64,
        depth: depth as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Controller Initialization
// ─────────────────────────────────────────────────────────────

fn tbt_controller_init(
    controller: Handle(TbtController),
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    irq_vector: u8,
    generation: TbtGeneration,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(void, ThunderboltError)
    effect [memory:mmio, deterministic, residual]
    court "tbt_controller_init:v1"
{
    controller.pci_bus = pci_bus;
    controller.pci_device = pci_device;
    controller.pci_func = pci_func;
    controller.mmio_base = mmio_base;
    controller.mmio_size = mmio_size;
    controller.irq_vector = irq_vector;
    controller.generation = generation;

    let host_router: Handle(TbtRouter) = Handle(TbtRouter)::from_ptr(&controller.host_router);
    let router_result: Result(void, ThunderboltError) = tbt_router_init(
        host_router, 0, TbtRouterRole::HostRouter, generation, 0, cap, timestamp,
    );
    match router_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    controller.initialized = true;

    residual emit {
        op: "tbt.controller_init",
        generation: generation as u64,
        mmio_base: mmio_base,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn tbt_driver_init(
    driver_identity: Identity,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> ThunderboltDriverState
    effect [deterministic, residual]
    court "tbt_driver_init:v1"
{
    let state: ThunderboltDriverState = ThunderboltDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_tunnels: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "tbt.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add Controller from PCI Discovery
// ─────────────────────────────────────────────────────────────

fn tbt_add_controller(
    state: Handle(ThunderboltDriverState),
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    irq_vector: u8,
    generation: TbtGeneration,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(u64, ThunderboltError)
    effect [memory:mmio, deterministic, residual]
    court "tbt_add_controller:v1"
{
    if state.controller_count >= 4 {
        return Result::Err(ThunderboltError::TbtMaxDevicesExceeded);
    };

    let idx: u64 = state.controller_count;
    let ctrl_identity: Identity = identity_new(0x544248, timestamp, idx, pci_bus as u64);

    let ctrl: TbtController = TbtController {
        controller_identity: ctrl_identity,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        irq_vector: irq_vector,
        generation: generation,
        host_router: TbtRouter {
            router_identity: identity_new(0x524F55, timestamp, idx, 0),
            depth: 0, route_string: 0, role: TbtRouterRole::HostRouter, generation: generation,
            vendor_id: 0, device_id: 0, nvm_version: 0, max_tunnel_depth: 7,
            adapter_count: 0, dp_adapters: Array::zeroed(), dp_adapter_count: 0,
            pcie_tunnels: Array::zeroed(), pcie_tunnel_count: 0,
            usb3_tunnels: Array::zeroed(), usb3_tunnel_count: 0,
            paths: Array::zeroed(), path_count: 0,
            cm: TbtConnectionManager { protocol_version: 0, max_hop_id: 0, max_paths: 0, max_adapters: 0, ctrl_version: 0, cm_state: TbtCmState::Disconnected, residual_log: RingBuf::new() },
            pd: TbtPowerDeliveryState { pd_protocol_version: 0, source_capabilities: 0, sink_capabilities: 0, negotiated_power_mw: 0, max_power_mw: 0, pd_contract_active: false, usb_typec_current: 0, vbus_voltage_mv: 0, cable_current_cap: 0 },
            nvm: TbtNvmUpdateState { nvm_version: 0, nvm_sector_size: 0, nvm_total_size: 0, update_progress: 0, auth_status: 0, update_in_progress: false, pending_reset: false, nvm_write_pointer: 0 },
            retimers: Array::zeroed(), retimer_count: 0,
            connected: false, initialized: false,
        },
        downstream_routers: Array::zeroed(),
        downstream_count: 0,
        initialized: false,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        cap: cap,
        version: 0,
    };

    state.controllers[idx] = ctrl;
    let ctrl_handle: Handle(TbtController) = Handle(TbtController)::from_ptr(&state.controllers[idx]);

    let init_result: Result(void, ThunderboltError) = tbt_controller_init(
        ctrl_handle, pci_bus, pci_device, pci_func, mmio_base, mmio_size, irq_vector, generation, cap, timestamp,
    );
    match init_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    state.controller_count = state.controller_count + 1;

    residual emit {
        op: "tbt.add_controller",
        controller_idx: idx,
        pci_bus: pci_bus as u64,
        generation: generation as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// Add Downstream Router
// ─────────────────────────────────────────────────────────────

fn tbt_add_downstream_router(
    controller: Handle(TbtController),
    route_string: u64,
    depth: u8,
    generation: TbtGeneration,
    vendor_id: u16,
    device_id: u16,
    cap: ThunderboltCapability,
    timestamp: u64,
) -> Result(u8, ThunderboltError)
    effect [deterministic, residual]
    court "tbt_add_downstream:v1"
{
    if (controller.downstream_count as u64) >= 8 {
        return Result::Err(ThunderboltError::TbtMaxDevicesExceeded);
    };

    let idx: u64 = controller.downstream_count as u64;
    let router: Handle(TbtRouter) = Handle(TbtRouter)::from_ptr(&controller.downstream_routers[idx]);

    let router_result: Result(void, ThunderboltError) = tbt_router_init(
        router, route_string, TbtRouterRole::Endpoint, generation, depth, cap, timestamp,
    );
    match router_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    router.vendor_id = vendor_id;
    router.device_id = device_id;
    controller.downstream_count = controller.downstream_count + 1;

    residual emit {
        op: "tbt.add_downstream_router",
        route: route_string,
        depth: depth as u64,
        vendor: vendor_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx as u8);
}
