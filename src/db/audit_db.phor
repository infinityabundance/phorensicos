pub fn log_critical(adb: ref mut AuditDatabase, cat: FixedString[AUDIT_NAME_CAP], msg: FixedString[512], src: FixedString[AUDIT_NAME_CAP], ts: Word64) -> Result[Word32, BoundsError>
    effects: [deterministic, residual]
{
