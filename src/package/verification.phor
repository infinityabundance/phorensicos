// ============================================================================
// Check 5: Source Signature Valid
// ============================================================================

fn check_source_signature(
    pkg: PackageContainer,
    trusted_keys: Array[Hash256, 64],
    trusted_key_count: u32,
) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("source_signature_valid");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Source hash is signed by a trusted key");
    let mut ok: bool = false;

    if pkg.source_evidence.source_sig_present {
        let sig: Signature = pkg.source_evidence.source_signature;
        for i in 0..trusted_key_count as u64 {
            if hash256_equal(sig.signer_key, trusted_keys[i]) {
                // Signature key is trusted
                if sig.verified {
                    ok = true;
                } else {
                    // Check sig is non-zero
                    let mut non_zero: bool = false;
                    for j in 0..sig.sig_bytes_len as u64 {
                        if sig.sig_bytes[j] != 0 { non_zero = true; }
                    }
                    if non_zero { ok = true; }
                }
            }
        }
    }

    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let fail_len: u32 = 0;
    if ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Source signature is missing, invalid, or signer key is not trusted");
        for i in 0..70 { fail_detail[i] = msg[i]; }
        fail_len = 70;
    }

    residual emit { op: "pkg_check.5.source_sig", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 5, check_name: name, check_name_len: 23,
        description: desc, description_len: 58,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

