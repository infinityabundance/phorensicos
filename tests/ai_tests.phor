// ai_tests.phor — Comprehensive AI/analysis tests
// Tests: residual pattern matching, behavioral baseline comparison,
//        anomaly detection threshold, forensic inference chain, trust scoring
//
// Expected outcomes:
//   - Residual pattern matching identifies known sequences in event streams
//   - Behavioral baseline comparison detects deviations from normal profiles
//   - Anomaly detection with configurable thresholds flags outliers correctly
//   - Forensic inference chains construct causal relationships between events
//   - Trust scoring produces consistent scores based on evidence weight
//   - All operations bounded, effect-declared, and residual-recorded

package "phorensic:ai_tests:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*

// ============================================================================
// Constants
// ============================================================================

const MAX_PATTERNS: u64 = 128;
const MAX_PATTERN_LEN: u64 = 32;
const MAX_BASELINE_SAMPLES: u64 = 1000;
const MAX_EVENT_STREAM: u64 = 512;
const MAX_INFERENCE_CHAIN: u64 = 32;
const MAX_EVIDENCE: u64 = 64;
const MAX_BEHAVIORAL_FEATURES: u64 = 16;
const TRUST_SCORE_MAX: u64 = 100;

// ============================================================================
// Data Structures
// ============================================================================

struct ResidualPattern {
    pattern_id: u64,
    name: Str(64),
    sequence: Array(u8, 32),
    sequence_len: u64,
    mask: Array(u8, 32),
    threshold: f32,
    match_count: u64,
    match_recent: u64,
}

struct PatternMatch {
    pattern_id: u64,
    confidence: f32,
    offset: u64,
    timestamp: u64,
    matched: bool,
}

struct PatternEngine {
    patterns: Array(ResidualPattern, 128),
    pattern_count: u64,
    event_stream: Array(ResidualRecord, 512),
    event_count: u64,
    matches: Array(PatternMatch, 64),
    match_count: u64,
}

struct BehavioralBaseline {
    feature_means: Array(f64, 16),
    feature_stds: Array(f64, 16),
    feature_names: Array(Str(32), 16),
    feature_count: u64,
    sample_count: u64,
}

struct BehavioralSample {
    features: Array(f64, 16),
    label: Str(32),
    timestamp: u64,
}

struct AnomalyDetector {
    baseline: BehavioralBaseline,
    anomaly_threshold: f64,
    z_score_threshold: f64,
    detected_anomalies: u64,
    false_positives: u64,
    false_negatives: u64,
}

struct AnomalyResult {
    score: f64,
    is_anomaly: bool,
    feature_index: u64,
    deviation: f64,
    timestamp: u64,
}

struct InferenceNode {
    node_id: u64,
    event_type: Str(32),
    evidence: Str(128),
    confidence: f64,
    parent_id: u64,
    depth: u64,
}

struct InferenceEdge {
    from_id: u64,
    to_id: u64,
    relation: Str(32),
    weight: f64,
}

struct InferenceChain {
    nodes: Array(InferenceNode, 32),
    node_count: u64,
    edges: Array(InferenceEdge, 48),
    edge_count: u64,
    root_id: u64,
    conclusion: Str(256),
    overall_confidence: f64,
}

struct EvidenceItem {
    item_id: u64,
    description: Str(128),
    weight: f64,
    credibility: f64,
    relevance: f64,
    source: Str(64),
    timestamp: u64,
    verified: bool,
}

struct TrustScore {
    score: u64,
    max_score: u64,
    evidence_count: u64,
    positive_evidence: u64,
    negative_evidence: u64,
    confidence_interval: f64,
    score_label: Str(32),
}

// ============================================================================
// AI Error Types
// ============================================================================

type AiError : u32 = enum {
    PatternNotFound        = 0xB001,
    PatternTooLong         = 0xB002,
    NoBaselineAvailable    = 0xB003,
    InsufficientSamples    = 0xB004,
    ThresholdExceeded      = 0xB005,
    InferenceChainBroken   = 0xB006,
    EvidenceConflict       = 0xB007,
    TrustInsufficient      = 0xB008,
    FeatureMismatch        = 0xB009,
    AnomalyThresholdInvalid = 0xB00A,
    CircularInference      = 0xB00B,
    InvalidConfidence      = 0xB00C,
}

// ============================================================================
// Test: Residual Pattern Matching
// ============================================================================

fn test_pattern_register() -> void
    effect [compute, residual]
{
    let mut engine: PatternEngine = PatternEngine{
        patterns: Array::zeroed(),
        pattern_count: 0,
        event_stream: Array::zeroed(),
        event_count: 0,
        matches: Array::zeroed(),
        match_count: 0,
    };

    // Register a known malicious pattern
    engine.patterns[0] = ResidualPattern{
        pattern_id: 1,
        name: Str::from("overflow_attempt"),
        sequence: Array::zeroed(),
        sequence_len: 4,
        mask: Array::zeroed(),
        threshold: 0.8,
        match_count: 0,
        match_recent: 0,
    };
    engine.patterns[0].sequence[0] = 0x41; engine.patterns[0].sequence[1] = 0x41;
    engine.patterns[0].sequence[2] = 0x41; engine.patterns[0].sequence[3] = 0x41;
    engine.pattern_count = 1;

    // Register another pattern
    engine.patterns[1] = ResidualPattern{
        pattern_id: 2,
        name: Str::from("nop_sled"),
        sequence: Array::zeroed(),
        sequence_len: 8,
        mask: Array::zeroed(),
        threshold: 0.7,
        match_count: 0,
        match_recent: 0,
    };
    for i in 0..8 {
        engine.patterns[1].sequence[i] = 0x90;
    }
    engine.pattern_count = 2;

    assert(engine.pattern_count == 2, "ai: 2 patterns registered");
    assert(engine.patterns[0].name == Str::from("overflow_attempt"), "ai: pattern 1 name");
    assert(engine.patterns[1].name == Str::from("nop_sled"), "ai: pattern 2 name");
    assert(engine.patterns[0].sequence_len == 4, "ai: pattern 1 length 4");
    assert(engine.patterns[1].sequence_len == 8, "ai: pattern 2 length 8");

    residual emit {
        op: "ai.test.pattern_register",
        patterns: engine.pattern_count,
        pattern_names: "overflow_attempt,nop_sled",
    };
}

fn test_pattern_match() -> void
    effect [compute, residual]
{
    let mut engine: PatternEngine = PatternEngine{
        patterns: Array::zeroed(),
        pattern_count: 1,
        event_stream: Array::zeroed(),
        event_count: 0,
        matches: Array::zeroed(),
        match_count: 0,
    };

    // Pattern: {0x41, 0x41, 0x41, 0x41}
    engine.patterns[0] = ResidualPattern{
        pattern_id: 1,
        name: Str::from("overflow"),
        sequence: Array::zeroed(),
        sequence_len: 4,
        mask: Array::zeroed(),
        threshold: 0.8,
        match_count: 0,
        match_recent: 0,
    };
    engine.patterns[0].sequence[0] = 0x41; engine.patterns[0].sequence[1] = 0x41;
    engine.patterns[0].sequence[2] = 0x41; engine.patterns[0].sequence[3] = 0x41;

    // Event stream with matching data
    for i in 0..10 {
        if i >= 3 && i <= 6 {
            engine.event_stream[i].data_hash[0] = 0x41;
        } else {
            engine.event_stream[i].data_hash[0] = (i as u8);
        }
    }

    // Match against pattern at offset 3
    let offset: u64 = 3;
    let mut match_found: bool = true;
    for j in 0..engine.patterns[0].sequence_len {
        if engine.event_stream[offset + j].data_hash[0] != engine.patterns[0].sequence[j] {
            match_found = false;
        }
    }
    assert(match_found, "ai: pattern matched at offset 3");

    // Verify no match at offset 0
    let no_match_offset: u64 = 0;
    match_found = true;
    for j in 0..engine.patterns[0].sequence_len {
        if engine.event_stream[no_match_offset + j].data_hash[0] != engine.patterns[0].sequence[j] {
            match_found = false;
        }
    }
    assert(!match_found, "ai: no match at offset 0");

    residual emit {
        op: "ai.test.pattern_match",
        pattern_matched: true,
        offset: offset,
    };
}

// ============================================================================
// Test: Behavioral Baseline Comparison
// ============================================================================

fn test_baseline_build() -> void
    effect [compute, residual]
{
    let mut baseline: BehavioralBaseline = BehavioralBaseline{
        feature_means: Array::zeroed(),
        feature_stds: Array::zeroed(),
        feature_names: Array::zeroed(),
        feature_count: 3,
        sample_count: 10,
    };
    baseline.feature_names[0] = Str::from("cpu_usage");
    baseline.feature_names[1] = Str::from("mem_usage");
    baseline.feature_names[2] = Str::from("net_io");

    // Set means from 10 samples
    baseline.feature_means[0] = 45.0; // CPU mean
    baseline.feature_means[1] = 60.0; // MEM mean
    baseline.feature_means[2] = 100.0; // NET mean
    baseline.feature_stds[0] = 5.0;
    baseline.feature_stds[1] = 8.0;
    baseline.feature_stds[2] = 20.0;

    assert(baseline.feature_count == 3, "ai: 3 features in baseline");
    assert(baseline.sample_count == 10, "ai: 10 samples for baseline");
    assert(baseline.feature_means[0] == 45.0, "ai: CPU mean = 45.0");
    assert(baseline.feature_names[0] == Str::from("cpu_usage"), "ai: feature name cpu_usage");

    residual emit {
        op: "ai.test.baseline_build",
        features: baseline.feature_count,
        samples: baseline.sample_count,
        cpu_mean: baseline.feature_means[0] as u64,
    };
}

fn test_baseline_comparison() -> void
    effect [compute, residual]
{
    let mut baseline: BehavioralBaseline = BehavioralBaseline{
        feature_means: Array::zeroed(),
        feature_stds: Array::zeroed(),
        feature_names: Array::zeroed(),
        feature_count: 2,
        sample_count: 50,
    };
    baseline.feature_means[0] = 50.0;
    baseline.feature_means[1] = 200.0;
    baseline.feature_stds[0] = 10.0;
    baseline.feature_stds[1] = 30.0;

    // Normal sample: close to mean
    let normal_sample: BehavioralSample = BehavioralSample{
        features: Array::zeroed(),
        label: Str::from("normal"),
        timestamp: 1000,
    };
    normal_sample.features[0] = 52.0;
    normal_sample.features[1] = 210.0;

    // Compute z-scores
    let mut z0: f64 = (normal_sample.features[0] - baseline.feature_means[0]) / baseline.feature_stds[0];
    let mut z1: f64 = (normal_sample.features[1] - baseline.feature_means[1]) / baseline.feature_stds[1];
    if z0 < 0.0 { z0 = -z0; }
    if z1 < 0.0 { z1 = -z1; }
    assert(z0 < 3.0, "ai: normal CPU z-score < 3");
    assert(z1 < 3.0, "ai: normal MEM z-score < 3");

    // Anomaly sample: far from mean
    let anomaly_sample: BehavioralSample = BehavioralSample{
        features: Array::zeroed(),
        label: Str::from("anomaly"),
        timestamp: 1001,
    };
    anomaly_sample.features[0] = 95.0;
    anomaly_sample.features[1] = 50.0;

    z0 = (anomaly_sample.features[0] - baseline.feature_means[0]) / baseline.feature_stds[0];
    z1 = (anomaly_sample.features[1] - baseline.feature_means[1]) / baseline.feature_stds[1];
    if z0 < 0.0 { z0 = -z0; }
    if z1 < 0.0 { z1 = -z1; }
    assert(z0 >= 3.0, "ai: anomaly CPU z-score >= 3");
    assert(z1 >= 3.0, "ai: anomaly MEM z-score >= 3");

    residual emit {
        op: "ai.test.baseline_compare",
        normal_detected: true,
        anomaly_detected: true,
        normal_z0: z0 as u64,
        anomaly_z0: z0 as u64,
    };
}

// ============================================================================
// Test: Anomaly Detection Threshold
// ============================================================================

fn test_anomaly_threshold() -> void
    effect [compute, residual]
{
    let mut detector: AnomalyDetector = AnomalyDetector{
        baseline: BehavioralBaseline{
            feature_means: Array::zeroed(), feature_stds: Array::zeroed(),
            feature_names: Array::zeroed(), feature_count: 1, sample_count: 100,
        },
        anomaly_threshold: 3.0,
        z_score_threshold: 3.0,
        detected_anomalies: 0,
        false_positives: 0,
        false_negatives: 0,
    };
    detector.baseline.feature_means[0] = 100.0;
    detector.baseline.feature_stds[0] = 15.0;

    // Test values at various distances
    let test_values: Array(f64, 5) = [100.0, 115.0, 145.0, 50.0, 200.0];
    let mut results: Array(AnomalyResult, 5) = Array::zeroed();

    for i in 0..5 {
        let deviation: f64 = (test_values[i] - detector.baseline.feature_means[0]) / detector.baseline.feature_stds[0];
        let abs_dev: f64 = if deviation < 0.0 { -deviation } else { deviation };
        results[i] = AnomalyResult{
            score: abs_dev,
            is_anomaly: abs_dev >= detector.anomaly_threshold,
            feature_index: 0,
            deviation: abs_dev,
            timestamp: 2000 + (i as u64),
        };
        if results[i].is_anomaly {
            detector.detected_anomalies = detector.detected_anomalies + 1;
        }
    }

    assert(!results[0].is_anomaly, "ai: mean (100) not anomalous");
    assert(!results[1].is_anomaly, "ai: +1 std (115) not anomalous");
    assert(results[2].is_anomaly, "ai: +3 std (145) is anomalous");
    assert(results[3].is_anomaly, "ai: -3.33 std (50) is anomalous");
    assert(results[4].is_anomaly, "ai: +6.67 std (200) is anomalous");
    assert(detector.detected_anomalies == 3, "ai: 3 anomalies detected");

    residual emit {
        op: "ai.test.anomaly_threshold",
        threshold: detector.anomaly_threshold as u64,
        anomalies: detector.detected_anomalies,
        total_tested: 5,
    };
}

// ============================================================================
// Test: Forensic Inference Chain
// ============================================================================

fn test_inference_chain_build() -> void
    effect [compute, residual]
{
    let mut chain: InferenceChain = InferenceChain{
        nodes: Array::zeroed(),
        node_count: 4,
        edges: Array::zeroed(),
        edge_count: 3,
        root_id: 1,
        conclusion: Str::from(""),
        overall_confidence: 0.0,
    };

    // Node 1: User logged in (root)
    chain.nodes[0] = InferenceNode{
        node_id: 1, event_type: Str::from("login"),
        evidence: Str::from("SSH auth success from 10.0.0.99"),
        confidence: 0.9, parent_id: 0, depth: 0,
    };

    // Node 2: File accessed
    chain.nodes[1] = InferenceNode{
        node_id: 2, event_type: Str::from("file_access"),
        evidence: Str::from("/etc/shadow opened"),
        confidence: 0.85, parent_id: 1, depth: 1,
    };

    // Node 3: Data exfiltrated
    chain.nodes[2] = InferenceNode{
        node_id: 3, event_type: Str::from("data_exfil"),
        evidence: Str::from("Large outbound transfer to 10.0.0.99:443"),
        confidence: 0.95, parent_id: 2, depth: 2,
    };

    // Node 4: Session ended
    chain.nodes[3] = InferenceNode{
        node_id: 4, event_type: Str::from("logout"),
        evidence: Str::from("Session terminated"),
        confidence: 0.7, parent_id: 1, depth: 1,
    };

    // Build edges
    chain.edges[0] = InferenceEdge{ from_id: 1, to_id: 2, relation: Str::from("led_to"), weight: 0.8 };
    chain.edges[1] = InferenceEdge{ from_id: 2, to_id: 3, relation: Str::from("led_to"), weight: 0.9 };
    chain.edges[2] = InferenceEdge{ from_id: 1, to_id: 4, relation: Str::from("led_to"), weight: 0.6 };

    assert(chain.node_count == 4, "ai: 4 inference nodes");
    assert(chain.edge_count == 3, "ai: 3 inference edges");
    assert(chain.nodes[0].depth == 0, "ai: root node depth 0");
    assert(chain.nodes[2].depth == 2, "ai: data exfil node depth 2");

    // Calculate overall confidence along main path 1->2->3
    let path_confidence: f64 = chain.nodes[0].confidence * chain.edges[0].weight *
                               chain.nodes[1].confidence * chain.edges[1].weight *
                               chain.nodes[2].confidence;
    assert(path_confidence > 0.5, "ai: inference path confidence > 0.5");
    chain.overall_confidence = path_confidence;

    assert(chain.overall_confidence > 0.0, "ai: overall confidence computed");

    residual emit {
        op: "ai.test.inference_build",
        nodes: chain.node_count,
        edges: chain.edge_count,
        confidence: chain.overall_confidence as u64,
    };
}

fn test_inference_conclusion() -> void
    effect [compute, residual]
{
    let mut chain: InferenceChain = InferenceChain{
        nodes: Array::zeroed(),
        node_count: 3,
        edges: Array::zeroed(),
        edge_count: 2,
        root_id: 1,
        conclusion: Str::from(""),
        overall_confidence: 0.0,
    };

    chain.nodes[0] = InferenceNode{
        node_id: 1, event_type: Str::from("anomaly_detected"),
        evidence: Str::from("CPU spike at 3am"), confidence: 0.8,
        parent_id: 0, depth: 0,
    };
    chain.nodes[1] = InferenceNode{
        node_id: 2, event_type: Str::from("process_match"),
        evidence: Str::from("Unknown binary /tmp/.x launched"),
        confidence: 0.9, parent_id: 1, depth: 1,
    };
    chain.nodes[2] = InferenceNode{
        node_id: 3, event_type: Str::from("network_conn"),
        evidence: Str::from("Connection to C2 server 5.6.7.8"),
        confidence: 0.95, parent_id: 2, depth: 2,
    };
    chain.edges[0] = InferenceEdge{ from_id: 1, to_id: 2, relation: Str::from("correlated_with"), weight: 0.85 };
    chain.edges[1] = InferenceEdge{ from_id: 2, to_id: 3, relation: Str::from("indicates"), weight: 0.9 };

    chain.overall_confidence = chain.nodes[0].confidence * chain.edges[0].weight *
                               chain.nodes[1].confidence * chain.edges[1].weight *
                               chain.nodes[2].confidence;
    chain.conclusion = Str::from("System compromised: unauthorized access confirmed");

    assert(chain.conclusion == Str::from("System compromised: unauthorized access confirmed"), "ai: conclusion drawn");
    assert(chain.overall_confidence > 0.5, "ai: high confidence conclusion");

    residual emit {
        op: "ai.test.inference_conclusion",
        conclusion: "compromise_confirmed",
        confidence: chain.overall_confidence as u64,
    };
}

// ============================================================================
// Test: Trust Scoring
// ============================================================================

fn test_trust_score_computation() -> void
    effect [compute, residual]
    {
    let mut evidence_items: Array(EvidenceItem, 4) = Array::zeroed();

    evidence_items[0] = EvidenceItem{
        item_id: 1, description: Str::from("Signed binary hash matches publisher"),
        weight: 20.0, credibility: 0.95, relevance: 1.0,
        source: Str::from("code_signing"), timestamp: 1000, verified: true,
    };
    evidence_items[1] = EvidenceItem{
        item_id: 2, description: Str::from("Static analysis: no known vulnerabilities"),
        weight: 15.0, credibility: 0.85, relevance: 0.9,
        source: Str::from("static_analysis"), timestamp: 1001, verified: true,
    };
    evidence_items[2] = EvidenceItem{
        item_id: 3, description: Str::from("Reproducible build from source"),
        weight: 25.0, credibility: 0.90, relevance: 1.0,
        source: Str::from("build_verification"), timestamp: 1002, verified: true,
    };
    evidence_items[3] = EvidenceItem{
        item_id: 4, description: Str::from("Runtime behavioral anomaly detected"),
        weight: -30.0, credibility: 0.70, relevance: 0.8,
        source: Str::from("runtime_monitor"), timestamp: 1003, verified: false,
    };

    let max_score: u64 = 100;
    let mut score: f64 = 50.0; // Start at neutral
    let mut positive_weight: f64 = 0.0;
    let mut negative_weight: f64 = 0.0;

    for i in 0..4 {
        let contrib: f64 = evidence_items[i].weight * evidence_items[i].credibility * evidence_items[i].relevance;
        score = score + contrib;
        if evidence_items[i].weight > 0.0 {
            positive_weight = positive_weight + contrib;
        } else {
            negative_weight = negative_weight + contrib;
        }
    }

    if score > (max_score as f64) { score = max_score as f64; }
    if score < 0.0 { score = 0.0; }

    let trust: TrustScore = TrustScore{
        score: score as u64,
        max_score: max_score,
        evidence_count: 4,
        positive_evidence: 3,
        negative_evidence: 1,
        confidence_interval: 0.85,
        score_label: Str::from("trusted"),
    };

    assert(trust.score > 50, "ai: trust score above neutral");
    assert(trust.evidence_count == 4, "ai: 4 evidence items evaluated");
    assert(trust.positive_evidence == 3, "ai: 3 positive evidence items");

    residual emit {
        op: "ai.test.trust_score",
        score: trust.score,
        positive: trust.positive_evidence,
        negative: trust.negative_evidence,
        label: "trusted",
    };
}

fn test_trust_score_thresholds() -> void
    effect [compute, residual]
{
    // Define trust thresholds
    let untrusted: u64 = 20;
    let low: u64 = 40;
    let medium: u64 = 60;
    let trusted: u64 = 80;
    let absolute: u64 = 100;

    let test_score_1: u64 = 15;
    let test_score_2: u64 = 55;
    let test_score_3: u64 = 85;

    let label1: Str(32) = if test_score_1 <= untrusted { Str::from("untrusted") }
                          else if test_score_1 <= low { Str::from("low") }
                          else if test_score_1 <= medium { Str::from("medium") }
                          else if test_score_1 <= trusted { Str::from("trusted") }
                          else { Str::from("absolute") };

    let label2: Str(32) = if test_score_2 <= untrusted { Str::from("untrusted") }
                          else if test_score_2 <= low { Str::from("low") }
                          else if test_score_2 <= medium { Str::from("medium") }
                          else if test_score_2 <= trusted { Str::from("trusted") }
                          else { Str::from("absolute") };

    let label3: Str(32) = if test_score_3 <= untrusted { Str::from("untrusted") }
                          else if test_score_3 <= low { Str::from("low") }
                          else if test_score_3 <= medium { Str::from("medium") }
                          else if test_score_3 <= trusted { Str::from("trusted") }
                          else { Str::from("absolute") };

    assert(label1 == Str::from("untrusted"), "ai: score 15 = untrusted");
    assert(label2 == Str::from("medium"), "ai: score 55 = medium");
    assert(label3 == Str::from("trusted"), "ai: score 85 = trusted");

    residual emit {
        op: "ai.test.trust_thresholds",
        untrusted_label: label1,
        medium_label: label2,
        trusted_label: label3,
    };
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, AiError)
    effects: [compute, io:write, residual]
{
    console.write_line("AI / Analysis Tests")!;
    console.write_line("====================")!;

    // Pattern matching tests
    test_pattern_register();
    console.write_line("  [PASS] Pattern register")!;
    test_pattern_match();
    console.write_line("  [PASS] Pattern match")!;

    // Behavioral baseline tests
    test_baseline_build();
    console.write_line("  [PASS] Baseline build")!;
    test_baseline_comparison();
    console.write_line("  [PASS] Baseline comparison")!;

    // Anomaly detection tests
    test_anomaly_threshold();
    console.write_line("  [PASS] Anomaly threshold")!;

    // Inference chain tests
    test_inference_chain_build();
    console.write_line("  [PASS] Inference chain build")!;
    test_inference_conclusion();
    console.write_line("  [PASS] Inference conclusion")!;

    // Trust scoring tests
    test_trust_score_computation();
    console.write_line("  [PASS] Trust score computation")!;
    test_trust_score_thresholds();
    console.write_line("  [PASS] Trust score thresholds")!;

    residual emit {
        op: "ai_tests.complete",
        pattern_tests: 2,
        baseline_tests: 2,
        anomaly_tests: 1,
        inference_tests: 2,
        trust_tests: 2,
        total_tests: 9,
        result: "all_passed",
    };

    console.write_line("")!;
fn test_pattern_lifecycle() -> void
    effect [compute, residual]
{
    let mut pattern: ResidualPattern = ResidualPattern{
        pattern_id: 10, name: Str::from("test_pattern"),
        sequence: Array::zeroed(), sequence_len: 8,
        mask: Array::zeroed(), threshold: 0.9,
        match_count: 0, match_recent: 0,
    };
    for i in 0..8 { pattern.sequence[i] = (i + 0x10) as u8; }
    pattern.match_count = 5;

    assert(pattern.pattern_id == 10, "ai: pattern ID assigned");
    assert(pattern.name == Str::from("test_pattern"), "ai: pattern named");
    assert(pattern.match_count == 5, "ai: pattern matched 5 times");
    assert(pattern.threshold > 0.0, "ai: pattern threshold positive");

    residual emit {
        op: "ai.test.pattern_lifecycle",
        id: pattern.pattern_id,
        matches: pattern.match_count,
    };
}

fn test_inference_depth_limits() -> void
    effect [compute, residual]
{
    let max_depth: u64 = 32;
    let mut chain: InferenceChain = InferenceChain{
        nodes: Array::zeroed(), node_count: 0,
        edges: Array::zeroed(), edge_count: 0,
        root_id: 1, conclusion: Str::from(""), overall_confidence: 0.0,
    };

    for i in 0..10 {
        chain.nodes[i] = InferenceNode{
            node_id: (i + 1) as u64, event_type: Str::from("event"),
            evidence: Str::from("evidence"), confidence: 0.9,
            parent_id: i as u64, depth: (i + 1) as u64,
        };
        chain.node_count = chain.node_count + 1;
    }

    assert(chain.node_count == 10, "ai: inference chain has 10 nodes");
    assert(chain.nodes[9].depth == 10, "ai: max depth reached");
    assert(chain.node_count <= max_depth, "ai: within max depth limit");

    residual emit {
        op: "ai.test.inference_depth",
        nodes: chain.node_count,
        max_allowed: max_depth,
    };
}

    console.write_line("All 9 AI/analysis tests passed!")!;
    return Ok(void);
}

fn test_anomaly_false_positive_rate() -> void
    effect [compute, residual]
{
    let mut false_positives: u64 = 0;
    let mut true_negatives: u64 = 0;
    let total_normal: u64 = 100;

    for i in 0..total_normal {
        let score: f64 = ((i * 7) % 30) as f64; // All under threshold
        if score >= ANOMALY_THRESHOLD {
            false_positives = false_positives + 1;
        } else {
            true_negatives = true_negatives + 1;
        }
    }

    let fpr: u64 = (false_positives * 100) / total_normal;
    assert(fpr == 0, "ai: zero false positives for normal data");

    residual emit {
        op: "ai.test.false_positive",
        fp: false_positives,
        tn: true_negatives,
        fpr_pct: fpr,
    };
}

fn test_anomaly_detection_rate() -> void
    effect [compute, residual]
{
    let mut true_positives: u64 = 0;
    let mut false_negatives: u64 = 0;
    let total_anomalies: u64 = 50;

    for i in 0..total_anomalies {
        let score: f64 = ANOMALY_THRESHOLD + ((i % 5) as f64);
        if score >= ANOMALY_THRESHOLD {
            true_positives = true_positives + 1;
        } else {
            false_negatives = false_negatives + 1;
        }
    }

    let tpr: u64 = (true_positives * 100) / total_anomalies;
    assert(tpr == 100, "ai: 100% detection rate for anomalies above threshold");

    residual emit {
        op: "ai.test.detection_rate",
        tp: true_positives,
        fn: false_negatives,
        tpr_pct: tpr,
    };
}

fn test_evidence_weighting() -> void
    effect [compute, residual]
{
    let direct_evidence_weight: f64 = 1.0;
    let circumstantial_weight: f64 = 0.5;
    let hearsay_weight: f64 = 0.1;

    let combined: f64 = direct_evidence_weight + circumstantial_weight + hearsay_weight;
    assert(combined == 1.6, "ai: evidence weights sum correctly");

    residual emit {
        op: "ai.test.evidence_weight",
        direct: direct_evidence_weight as u64,
        circumstantial: circumstantial_weight as u64,
        hearsay: hearsay_weight as u64,
    };
}
