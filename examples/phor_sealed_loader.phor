// phor_sealed_loader.phor — Sealed Package Driver Loader
//
// Demonstrates:
//   - Sealed package format parsing in .phor
//   - Trust state verification before loading
//   - Capability-gated driver registration
//   - Hash verification of source/object integrity
//   - Court verdict checking before activation
//   - Bounded package metadata fields
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:phor_sealed_loader:v1.0";

// ── Constants ───────────────────────────────────────────

const MAX_PACKAGE_NAME: u64 = 64;
const HASH_BYTES: u64 = 64;  // hex string length for sha-256
const MAX_COURT_FIELDS: u64 = 8;

// ── Trust States ───────────────────────────────────────

type TrustLevel = u8;

const TRUST_UNKNOWN: TrustLevel = 0;
const TRUST_OBSERVED: TrustLevel = 1;
const TRUST_SEALED: TrustLevel = 5;

// ── Sealed Package Header ──────────────────────────────

struct PackageHeader {
    package_name: Array(u8, 64),
    name_len: u64,
    source_hash: Array(u8, 64),
    object_hash: Array(u8, 64),
    function_count: u64,
    total_bytes: u64,
    trust_level: TrustLevel,
    court_verified: bool,
    court_tests_passed: u64,
    court_tests_failed: u64,
    court_verdict: Array(u8, 32),
    verdict_len: u64,
}

impl PackageHeader {
    fn new(name: Array(u8, 64), nlen: u64) -> PackageHeader
        effect [compute]
    {
        return PackageHeader {
            package_name: name,
            name_len: nlen,
            source_hash: Array::splat(0),
            object_hash: Array::splat(0),
            function_count: 0,
            total_bytes: 0,
            trust_level: TRUST_UNKNOWN,
            court_verified: false,
            court_tests_passed: 0,
            court_tests_failed: 0,
            court_verdict: Array::splat(0),
            verdict_len: 0,
        };
    }

    fn set_hashes(mut self, src: Array(u8, 64), obj: Array(u8, 64)) -> PackageHeader
        effect [compute]
    {
        self.source_hash = src;
        self.object_hash = obj;
        return self;
    }

    fn set_counts(mut self, funcs: u64, bytes: u64) -> PackageHeader
        effect [compute]
    {
        self.function_count = funcs;
        self.total_bytes = bytes;
        return self;
    }

    fn set_court_result(mut self, verified: bool, passed: u64, failed: u64, verdict: Array(u8, 32), vlen: u64) -> PackageHeader
        effect [compute]
    {
        self.court_verified = verified;
        self.court_tests_passed = passed;
        self.court_tests_failed = failed;
        self.court_verdict = verdict;
        self.verdict_len = vlen;
        return self;
    }

    fn promote_to(mut self, level: TrustLevel) -> PackageHeader
        effect [compute]
    {
        self.trust_level = level;
        return self;
    }

    fn verify_integrity(self, expected_src: Array(u8, 64), expected_obj: Array(u8, 64)) -> bool
        effect [compute]
    {
        // Compare source hashes
        let mut src_ok: bool = true;
        for i in 0..64 {
            if self.source_hash[i] != expected_src[i] {
                src_ok = false;
            }
        }
        // Compare object hashes
        let mut obj_ok: bool = true;
        for i in 0..64 {
            if self.object_hash[i] != expected_obj[i] {
                obj_ok = false;
            }
        }
        return src_ok && obj_ok;
    }

    fn is_ready_for_activation(self) -> bool
        effect [compute]
    {
        return self.trust_level >= TRUST_SEALED
            && self.court_verified
            && self.court_tests_failed == 0;
    }

    fn trust_level(self) -> TrustLevel
        effect [compute]
    {
        return self.trust_level;
    }
}

// ── Sealed Package Loader ──────────────────────────────

struct SealedLoader {
    packages: Array(PackageHeader, 16),
    package_count: u64,
    loaded_count: u64,
}

impl SealedLoader {
    fn new() -> SealedLoader
        effect [compute]
    {
        return SealedLoader {
            packages: Array::splat_zeroed(),
            package_count: 0,
            loaded_count: 0,
        };
    }

    fn register_package(mut self, pkg: PackageHeader) -> SealedLoader
        effect [compute]
    {
        if self.package_count < 16 {
            self.packages[self.package_count] = pkg;
            self.package_count = self.package_count + 1;
        }
        return self;
    }

    fn load_sealed(mut self, idx: u64, src_hash: Array(u8, 64), obj_hash: Array(u8, 64)) -> SealedLoader
        effect [compute]
    {
        if idx >= self.package_count { return self; }

        // Verify integrity
        let ok: bool = self.packages[idx].verify_integrity(src_hash, obj_hash);
        if !ok { return self; }

        // Promote to Sealed if court verified
        if self.packages[idx].court_verified && self.packages[idx].court_tests_failed == 0 {
            self.packages[idx] = self.packages[idx].promote_to(TRUST_SEALED);
            self.loaded_count = self.loaded_count + 1;
        }

        return self;
    }

    fn is_loaded(self, idx: u64) -> bool
        effect [compute]
    {
        if idx >= self.package_count { return false; }
        return self.packages[idx].is_ready_for_activation();
    }

    fn load_count(self) -> u64
        effect [compute]
    {
        return self.loaded_count;
    }

    fn package_count(self) -> u64
        effect [compute]
    {
        return self.package_count;
    }
}

// ── Simple Hash (simulated) ────────────────────────────

fn compute_simple_hash(data: Array(u8, 256), len: u64) -> Array(u8, 64)
    effect [compute]
{
    let mut hash: Array(u8, 64) = Array::splat(0);
    let mut accum: u64 = 5381;
    let limit: u64 = len.min(256);
    for i in 0..limit {
        accum = accum.wrapping_mul(33).wrapping_add(data[i] as u64);
    }
    for i in 0..8 {
        hash[i] = (accum >> (i * 8)) as u8;
    }
    return hash;
}

// ── Test ───────────────────────────────────────────────

fn test_sealed_loader() -> bool
    effect [compute]
{
    // Create a sealed package header
    let mut pkg_name: Array(u8, 64) = Array::splat(0);
    pkg_name[0] = 0x68; pkg_name[1] = 0x65; pkg_name[2] = 0x6C; // "hel"
    pkg_name[3] = 0x6C; pkg_name[4] = 0x6F;                   // "lo"
    let mut pkg: PackageHeader = PackageHeader::new(pkg_name, 5);

    // Set hashes
    let mut src_hash: Array(u8, 64) = Array::splat(0xAB);
    let mut obj_hash: Array(u8, 64) = Array::splat(0xCD);
    pkg = pkg.set_hashes(src_hash, obj_hash);
    pkg = pkg.set_counts(23, 6912);

    // Set court result
    let mut verdict: Array(u8, 32) = Array::splat(0);
    verdict[0] = 0x63; verdict[1] = 0x6F; // "co"
    verdict[2] = 0x6E; verdict[3] = 0x73; // "ns"
    verdict[4] = 0x69; verdict[5] = 0x73; // "is"
    verdict[6] = 0x74; verdict[7] = 0x65; // "te"
    verdict[8] = 0x6E; verdict[9] = 0x74; // "nt"
    pkg = pkg.set_court_result(true, 23, 0, verdict, 10);

    // Verify integrity check
    let integrity: bool = pkg.verify_integrity(src_hash, obj_hash);
    assert(integrity, "sealed: integrity check passes");

    // Wrong hash should fail
    let mut bad_hash: Array(u8, 64) = Array::splat(0xFF);
    let bad_integrity: bool = pkg.verify_integrity(src_hash, bad_hash);
    assert(!bad_integrity, "sealed: wrong object hash detected");

    // Check readiness (not yet sealed)
    assert(!pkg.is_ready_for_activation(), "sealed: not ready before sealing");

    // Promote to Sealed
    pkg = pkg.promote_to(TRUST_SEALED);
    assert(pkg.trust_level() == TRUST_SEALED, "sealed: promoted to Sealed");

    // Now should be ready
    assert(pkg.is_ready_for_activation(), "sealed: ready for activation after sealing");

    // Test the loader
    let mut loader: SealedLoader = SealedLoader::new();
    assert(loader.package_count() == 0, "sealed: loader starts empty");

    loader = loader.register_package(pkg);
    assert(loader.package_count() == 1, "sealed: 1 package registered");
    assert(!loader.is_loaded(0), "sealed: not loaded before load_sealed");

    // Load with correct hashes
    loader = loader.load_sealed(0, src_hash, obj_hash);
    assert(loader.is_loaded(0), "sealed: package loaded and activated");
    assert(loader.load_count() == 1, "sealed: 1 package loaded");

    // Reject wrong hashes
    let mut pkg2: PackageHeader = PackageHeader::new(pkg_name, 5);
    pkg2 = pkg2.set_hashes(src_hash, bad_hash);
    pkg2 = pkg2.set_court_result(true, 23, 0, verdict, 10);
    pkg2 = pkg2.promote_to(TRUST_SEALED);
    loader = loader.register_package(pkg2);
    loader = loader.load_sealed(1, src_hash, bad_hash);
    assert(loader.load_count() == 1, "sealed: bad hash rejected (count unchanged)");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute]
{
    let passed: bool = test_sealed_loader();
    assert(passed, "sealed loader: all tests pass");

    console.write(Str::from("Sealed Package Loader:"));
    console.write(Str::from("  Package header creation and parsing: PASS"));
    console.write(Str::from("  Hash integrity verification: PASS"));
    console.write(Str::from("  Court result integration: PASS"));
    console.write(Str::from("  Trust promotion to Sealed: PASS"));
    console.write(Str::from("  Loader registration and activation: PASS"));
    console.write(Str::from("Sealed loader demo passed!"));
}
