// file: anomaly_detector.phor
// purpose: Anomaly detection using statistical methods, threshold-based
//          detection, behavioral comparison, time-series analysis, and
//          alert prioritization. Fully deterministic for court admissibility.
// evidence: ANOMALY-DETECTOR-ARCH-001 through ANOMALY-DETECTOR-ARCH-240
// residual: All detection events, thresholds, and alerts are recorded.

use core::constants::*
use core::types::*
use core::errors::*
use core::effects::*
use core::collections::*
use core::math::*
use core::traits::*
use core::serialization::*

// ──────────────────────────────────────────────
// Anomaly Detector Diagnostic Ranges
// ──────────────────────────────────────────────
const DIAG_ANOMALY_DETECTOR : Word64 = DIAG_AI_BASE | 0x0300

const ANOMALY_MAX_SAMPLES       : u32 = 4096
const ANOMALY_MAX_METHODS       : u32 = 8
const ANOMALY_ALERT_CAP         : u32 = 256
const ANOMALY_THRESHOLD_CAP     : u32 = 16
const ANOMALY_TIMESERIES_WINDOW : u32 = 256
const ANOMALY_NAME_CAP          : u32 = 32
const ANOMALY_RESIDUAL_LOG      : u32 = 64
const ANOMALY_PRIORITY_LEVELS   : u32 = 4
const ANOMALY_HISTORY_DEPTH     : u32 = 1024

// ──────────────────────────────────────────────
// Detection Method Enum
// ──────────────────────────────────────────────
pub type DetectionMethod : u8 = enum {
    Method_Threshold        = 0x00,
    Method_ZScore           = 0x01,
    Method_MovingAverage    = 0x02,
    Method_MedianAbsolute   = 0x03,
    Method_SeasonalDecomp   = 0x04,
    Method_PatternMatch     = 0x05,
    Method_Ensemble         = 0x06,
}

// ──────────────────────────────────────────────
// Alert Priority Enum
// ──────────────────────────────────────────────
pub type AlertPriority : u8 = enum {
    Priority_Low        = 0x00,
    Priority_Medium     = 0x01,
    Priority_High       = 0x02,
    Priority_Critical   = 0x03,
}

// ──────────────────────────────────────────────
// Anomaly Alert
// ──────────────────────────────────────────────
pub type AnomalyAlert : struct {
    id: Word32,
    timestamp: Word64,
    value: Word64,
    expected: Word64,
    deviation: Word64,
    method: DetectionMethod,
    priority: AlertPriority,
    z_score: Word64,
    confidence: u8,
    source: FixedString[ANOMALY_NAME_CAP],
    description: FixedString[256],
    acknowledged: bool,
}

impl AnomalyAlert {
    pub fn new(aid: Word32, ts: Word64, val: Word64, exp: Word64, method: DetectionMethod, prio: AlertPriority, src: FixedString[ANOMALY_NAME_CAP]) -> AnomalyAlert
        effects: [deterministic]
    {
        let dev: Word64 = if val.gt(exp) { val.sub(exp) } else { exp.sub(val) }
        AnomalyAlert {
            id: aid,
            timestamp: ts,
            value: val,
            expected: exp,
            deviation: dev,
            method: method,
            priority: prio,
            z_score: Word64::zero(),
            confidence: 100,
            source: src,
            description: FixedString::new(),
            acknowledged: false,
        }
    }

    pub fn set_z_score(self: ref mut, z: Word64)
        effects: [deterministic]
    {
        self.z_score = z
    }

    pub fn set_description(self: ref mut, desc: FixedString[256])
        effects: [deterministic]
    {
        self.description = desc
    }

    pub fn acknowledge(self: ref mut)
        effects: [deterministic]
    {
        self.acknowledged = true
    }

    pub fn record(self: ref mut)
        effects: [residual]
    {
        residual emit {
            ai_op: "anomaly.alert",
            alert_id: self.id.to_u32() as u64,
            priority: self.priority as u64,
            method: self.method as u64,
            value: self.value.to_u64(),
            expected: self.expected.to_u64(),
            deviation: self.deviation.to_u64(),
            confidence: self.confidence as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Threshold Configuration
// ──────────────────────────────────────────────
pub type ThresholdConfig : struct {
    name: FixedString[ANOMALY_NAME_CAP],
    upper_bound: Word64,
    lower_bound: Word64,
    upper_soft: Word64,
    lower_soft: Word64,
    z_score_threshold: Word64,
    min_samples: u32,
    method: DetectionMethod,
    enabled: bool,
}

impl ThresholdConfig {
    pub fn new(tname: FixedString[ANOMALY_NAME_CAP], upper: Word64, lower: Word64, method: DetectionMethod) -> ThresholdConfig
        effects: [deterministic]
    {
        ThresholdConfig {
            name: tname,
            upper_bound: upper,
            lower_bound: lower,
            upper_soft: upper,
            lower_soft: lower,
            z_score_threshold: Word64::from_u64(3),
            min_samples: 10,
            method: method,
            enabled: true,
        }
    }

    pub fn set_soft_bounds(self: ref mut, upper: Word64, lower: Word64)
        effects: [deterministic]
    {
        self.upper_soft = upper
        self.lower_soft = lower
    }

    pub fn is_violation(self, value: Word64) -> u8
        effects: [deterministic]
    {
        if !self.enabled {
            return 0
        }
        if value.gt(self.upper_bound) || value.lt(self.lower_bound) {
            return 3 // Critical
        }
        if value.gt(self.upper_soft) || value.lt(self.lower_soft) {
            return 2 // Warning
        }
        0 // Normal
    }
}

// ──────────────────────────────────────────────
// Moving Average Calculator
// ──────────────────────────────────────────────
pub type MovingAverage : struct {
    window: FixedArray[Word64, ANOMALY_TIMESERIES_WINDOW],
    window_size: u32,
    count: u32,
    head: u32,
    sum: Word64,
    current_avg: Word64,
}

impl MovingAverage {
    pub fn new(window_sz: u32) -> MovingAverage
        effects: [deterministic]
    {
        let wsize: u32 = if window_sz > ANOMALY_TIMESERIES_WINDOW { ANOMALY_TIMESERIES_WINDOW } else { window_sz }
        MovingAverage {
            window: FixedArray::new(),
            window_size: wsize,
            count: 0,
            head: 0,
            sum: Word64::zero(),
            current_avg: Word64::zero(),
        }
    }

    pub fn add_sample(self: ref mut, value: Word64)
        effects: [deterministic]
    {
        if self.count < self.window_size {
            let _ = self.window.set(self.count, value)
            self.sum = self.sum.add(value)
            self.count = self.count + 1
        } else {
            let old: Word64 = match self.window.get(self.head) {
                Result::Ok(v) => v,
                Result::Err(_) => Word64::zero(),
            }
            let _ = self.window.set(self.head, value)
            self.sum = self.sum.sub(old).add(value)
            self.head = (self.head + 1) % self.window_size
        }
        self.current_avg = self.sum.div(Word64::from_u64(self.count as u64))
    }

    pub fn average(self) -> Word64
        effects: [deterministic]
    {
        self.current_avg
    }

    pub fn deviation_from_avg(self, value: Word64) -> Word64
        effects: [deterministic]
    {
        if value.gt(self.current_avg) {
            value.sub(self.current_avg)
        } else {
            self.current_avg.sub(value)
        }
    }

    pub fn is_ready(self) -> bool
        effects: [deterministic]
    {
        self.count >= self.window_size
    }
}

// ──────────────────────────────────────────────
// Median Absolute Deviation Calculator
// ──────────────────────────────────────────────
pub type MedianAbsoluteDev : struct {
    samples: FixedArray[Word64, ANOMALY_HISTORY_DEPTH],
    count: u32,
    median: Word64,
    mad: Word64,
}

impl MedianAbsoluteDev {
    pub fn new() -> MedianAbsoluteDev
        effects: [deterministic]
    {
        MedianAbsoluteDev {
            samples: FixedArray::new(),
            count: 0,
            median: Word64::zero(),
            mad: Word64::zero(),
        }
    }

    pub fn add_sample(self: ref mut, value: Word64)
        effects: [deterministic]
    {
        if self.count < ANOMALY_HISTORY_DEPTH {
            let _ = self.samples.set(self.count, value)
            self.count = self.count + 1
        }
    }

    pub fn compute(self: ref mut)
        effects: [deterministic]
    {
        if self.count == 0 {
            return
        }
        // Compute median (simple selection)
        let mut sorted: FixedArray[Word64, ANOMALY_HISTORY_DEPTH] = FixedArray::new()
        for i in 0..self.count {
            let v: Word64 = match self.samples.get(i) {
                Result::Ok(val) => val,
                Result::Err(_) => continue,
            }
            let _ = sorted.set(i, v)
        }
        // Bubble sort (bounded: count <= ANOMALY_HISTORY_DEPTH)
        for i in 0..self.count {
            for j in 0..(self.count - 1 - i) {
                let a: Word64 = match sorted.get(j) {
                    Result::Ok(v) => v,
                    Result::Err(_) => Word64::zero(),
                }
                let b: Word64 = match sorted.get(j + 1) {
                    Result::Ok(v) => v,
                    Result::Err(_) => Word64::zero(),
                }
                if a.gt(b) {
                    let _ = sorted.set(j, b)
                    let _ = sorted.set(j + 1, a)
                }
            }
        }
        self.median = match sorted.get(self.count / 2) {
            Result::Ok(v) => v,
            Result::Err(_) => Word64::zero(),
        }

        // Compute MAD: median of absolute deviations from median
        let mut deviations: FixedArray[Word64, ANOMALY_HISTORY_DEPTH] = FixedArray::new()
        for i in 0..self.count {
            let v: Word64 = match self.samples.get(i) {
                Result::Ok(val) => val,
                Result::Err(_) => continue,
            }
            let dev: Word64 = if v.gt(self.median) { v.sub(self.median) } else { self.median.sub(v) }
            let _ = deviations.set(i, dev)
        }
        // Sort deviations
        for i in 0..self.count {
            for j in 0..(self.count - 1 - i) {
                let a: Word64 = match deviations.get(j) {
                    Result::Ok(v) => v,
                    Result::Err(_) => Word64::zero(),
                }
                let b: Word64 = match deviations.get(j + 1) {
                    Result::Ok(v) => v,
                    Result::Err(_) => Word64::zero(),
                }
                if a.gt(b) {
                    let _ = deviations.set(j, b)
                    let _ = deviations.set(j + 1, a)
                }
            }
        }
        self.mad = match deviations.get(self.count / 2) {
            Result::Ok(v) => v,
            Result::Err(_) => Word64::zero(),
        }
    }

    pub fn is_anomaly(self, value: Word64, threshold: Word64) -> bool
        effects: [deterministic]
    {
        if self.mad.is_zero() {
            return false
        }
        let dev: Word64 = if value.gt(self.median) { value.sub(self.median) } else { self.median.sub(value) }
        dev.div(self.mad).gt(threshold)
    }
}

// ──────────────────────────────────────────────
// Time-Series Analyzer
// ──────────────────────────────────────────────
pub type TimeSeriesAnalyzer : struct {
    values: FixedArray[Word64, ANOMALY_TIMESERIES_WINDOW],
    count: u32,
    ma_short: MovingAverage,
    ma_long: MovingAverage,
    variance: Word64,
    trend: i8,
}

impl TimeSeriesAnalyzer {
    pub fn new(short_window: u32, long_window: u32) -> TimeSeriesAnalyzer
        effects: [deterministic]
    {
        TimeSeriesAnalyzer {
            values: FixedArray::new(),
            count: 0,
            ma_short: MovingAverage::new(short_window),
            ma_long: MovingAverage::new(long_window),
            variance: Word64::zero(),
            trend: 0,
        }
    }

    pub fn add_value(self: ref mut, value: Word64)
        effects: [deterministic]
    {
        if self.count < ANOMALY_TIMESERIES_WINDOW {
            let _ = self.values.set(self.count, value)
            self.count = self.count + 1
        }
        self.ma_short.add_sample(value)
        self.ma_long.add_sample(value)

        // Update variance
        if self.count > 1 {
            let mean: Word64 = self.ma_long.average()
            let diff: Word64 = if value.gt(mean) { value.sub(mean) } else { mean.sub(value) }
            self.variance = self.variance.add(diff.mul(diff))
        }

        // Detect trend
        if self.ma_short.is_ready() && self.ma_long.is_ready() {
            if self.ma_short.average().gt(self.ma_long.average()) {
                self.trend = 1
            } else if self.ma_short.average().lt(self.ma_long.average()) {
                self.trend = -1
            } else {
                self.trend = 0
            }
        }
    }

    pub fn detect_spike(self, value: Word64, multiplier: Word64) -> bool
        effects: [deterministic]
    {
        if !self.ma_long.is_ready() {
            return false
        }
        let avg: Word64 = self.ma_long.average()
        let dev: Word64 = if value.gt(avg) { value.sub(avg) } else { avg.sub(value) }
        let threshold: Word64 = if self.count > 1 {
            let stddev: Word64 = self.variance.div(Word64::from_u64((self.count - 1) as u64)).sqrt()
            stddev.mul(multiplier)
        } else {
            Word64::from_u64(0)
        }
        dev.gt(threshold)
    }

    pub fn short_avg(self) -> Word64
        effects: [deterministic]
    {
        self.ma_short.average()
    }

    pub fn long_avg(self) -> Word64
        effects: [deterministic]
    {
        self.ma_long.average()
    }
}

// ──────────────────────────────────────────────
// Anomaly Detector (Main)
// ──────────────────────────────────────────────
pub type AnomalyDetector : struct {
    alerts: FixedArray[AnomalyAlert, ANOMALY_ALERT_CAP],
    alert_count: u32,
    next_alert_id: Word32,
    thresholds: FixedArray[ThresholdConfig, ANOMALY_THRESHOLD_CAP],
    threshold_count: u32,
    methods: FixedArray[DetectionMethod, ANOMALY_MAX_METHODS],
    method_count: u32,
    ma: MovingAverage,
    mad: MedianAbsoluteDev,
    ts_analyzer: TimeSeriesAnalyzer,
    name: FixedString[ANOMALY_NAME_CAP],
    total_detections: Word64,
    residuals: FixedArray[AnomalyAlert, ANOMALY_RESIDUAL_LOG],
}

impl AnomalyDetector {
    pub fn new(detector_name: FixedString[ANOMALY_NAME_CAP]) -> AnomalyDetector
        effects: [deterministic, residual]
    {
        let detector: AnomalyDetector = AnomalyDetector {
            alerts: FixedArray::new(),
            alert_count: 0,
            next_alert_id: Word32::from_u32(1),
            thresholds: FixedArray::new(),
            threshold_count: 0,
            methods: FixedArray::new(),
            method_count: 0,
            ma: MovingAverage::new(50),
            mad: MedianAbsoluteDev::new(),
            ts_analyzer: TimeSeriesAnalyzer::new(10, 50),
            name: detector_name,
            total_detections: Word64::zero(),
            residuals: FixedArray::new(),
        }
        residual emit {
            ai_op: "anomaly.detector.init",
            name: detector_name,
            max_alerts: ANOMALY_ALERT_CAP as u64,
            max_methods: ANOMALY_MAX_METHODS as u64,
        }
        detector
    }

    pub fn add_threshold(det: ref mut AnomalyDetector, config: ThresholdConfig) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        if det.threshold_count >= ANOMALY_THRESHOLD_CAP {
            return Result::Err(bounds_capacity_exceeded(ANOMALY_THRESHOLD_CAP))
        }
        let r: Result<(), BoundsError> = det.thresholds.set(det.threshold_count, config)
        if r.is_ok() {
            det.threshold_count = det.threshold_count + 1
        }
        r
    }

    pub fn add_method(det: ref mut AnomalyDetector, method: DetectionMethod) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        if det.method_count >= ANOMALY_MAX_METHODS {
            return Result::Err(bounds_capacity_exceeded(ANOMALY_MAX_METHODS))
        }
        let r: Result<(), BoundsError> = det.methods.set(det.method_count, method)
        if r.is_ok() {
            det.method_count = det.method_count + 1
        }
        r
    }

    pub fn evaluate(det: ref mut AnomalyDetector, value: Word64, source: FixedString[ANOMALY_NAME_CAP], ts: Word64) -> Result[bool, BoundsError>
        effects: [deterministic, residual]
    {
        det.ma.add_sample(value)
        det.mad.add_sample(value)
        det.ts_analyzer.add_value(value)

        let mut detected: bool = false

        // Threshold-based detection
        for i in 0..det.threshold_count {
            let config: ThresholdConfig = match det.thresholds.get(i) {
                Result::Ok(c) => c,
                Result::Err(_) => continue,
            }
            let violation: u8 = config.is_violation(value)
            if violation > 0 {
                detected = true
                let priority: AlertPriority = if violation == 3 {
                    AlertPriority::Priority_Critical
                } else if violation == 2 {
                    AlertPriority::Priority_High
                } else {
                    AlertPriority::Priority_Medium
                }
                let mut alert: AnomalyAlert = AnomalyAlert::new(
                    det.next_alert_id, ts, value, config.upper_bound,
                    DetectionMethod::Method_Threshold, priority, source)
                det.next_alert_id = Word32::from_u32(det.next_alert_id.to_u32() + 1)

                let desc: FixedString[256] = FixedString[256]::from_slice("Threshold violation on ")
                alert.set_description(desc)
                if det.alert_count < ANOMALY_ALERT_CAP {
                    let _ = det.alerts.set(det.alert_count, alert)
                    det.alert_count = det.alert_count + 1
                    det.total_detections = det.total_detections.increment_or_max()
                    alert.record()
                }
            }
        }

        // Moving average detection
        if det.ma.is_ready() {
            let deviation: Word64 = det.ma.deviation_from_avg(value)
            let avg: Word64 = det.ma.average()
            let threshold: Word64 = avg.div(Word64::from_u64(2))
            if deviation.gt(threshold) {
                let alert: AnomalyAlert = AnomalyAlert::new(
                    det.next_alert_id, ts, value, avg,
                    DetectionMethod::Method_MovingAverage,
                    AlertPriority::Priority_Medium, source)
                det.next_alert_id = Word32::from_u32(det.next_alert_id.to_u32() + 1)
                if det.alert_count < ANOMALY_ALERT_CAP {
                    let _ = det.alerts.set(det.alert_count, alert)
                    det.alert_count = det.alert_count + 1
                    det.total_detections = det.total_detections.increment_or_max()
                    alert.record()
                }
                detected = true
            }
        }

        // Time-series spike detection
        if det.ts_analyzer.detect_spike(value, Word64::from_u64(3)) {
            let spike_alert: AnomalyAlert = AnomalyAlert::new(
                det.next_alert_id, ts, value, det.ts_analyzer.long_avg(),
                DetectionMethod::Method_SeasonalDecomp,
                AlertPriority::Priority_High, source)
            det.next_alert_id = Word32::from_u32(det.next_alert_id.to_u32() + 1)
            if det.alert_count < ANOMALY_ALERT_CAP {
                let _ = det.alerts.set(det.alert_count, spike_alert)
                det.alert_count = det.alert_count + 1
                det.total_detections = det.total_detections.increment_or_max()
                spike_alert.record()
            }
            detected = true
        }

        residual emit {
            ai_op: "anomaly.evaluation",
            value: value.to_u64(),
            source: source,
            detected: if detected { 1 } else { 0 },
            total_detections: det.total_detections.to_u64(),
        }
        Result::Ok(detected)
    }

    pub fn get_alerts(det: ref AnomalyDetector, priority_min: AlertPriority) -> FixedArray[AnomalyAlert, ANOMALY_ALERT_CAP]
        effects: [deterministic]
    {
        let mut results: FixedArray[AnomalyAlert, ANOMALY_ALERT_CAP] = FixedArray::new()
        let mut count: u32 = 0
        for i in 0..det.alert_count {
            let alert: AnomalyAlert = match det.alerts.get(i) {
                Result::Ok(a) => a,
                Result::Err(_) => continue,
            }
            if (alert.priority as u8) >= (priority_min as u8) {
                if count < ANOMALY_ALERT_CAP {
                    let _ = results.set(count, alert)
                    count = count + 1
                }
            }
        }
        results
    }

    pub fn acknowledge_alert(det: ref mut AnomalyDetector, alert_id: Word32)
        effects: [deterministic]
    {
        for i in 0..det.alert_count {
            let alert: ref mut AnomalyAlert = match det.alerts.ref_at_mut(i) {
                Result::Ok(a) => a,
                Result::Err(_) => continue,
            }
            if alert.id.eq(alert_id) {
                alert.acknowledge()
            }
        }
    }

    pub fn clear_alerts(det: ref mut AnomalyDetector)
        effects: [deterministic, residual]
    {
        det.alert_count = 0
        residual emit {
            ai_op: "anomaly.alerts.cleared",
        }
    }

    pub fn generate_report(det: ref AnomalyDetector) -> FixedString[2048]
        effects: [deterministic]
    {
        let mut report: FixedString[2048] = FixedString::new()
        report.append(FixedString[32]::from_slice("Anomaly Detection Report\n"))
        report.append(FixedString[32]::from_slice("=========================\n"))
        report.append(FixedString[16]::from_slice("Detector: "))
        report.append(det.name)
        report.append(FixedString[16]::from_slice("\nTotal alerts: "))
        report.append_u64(det.alert_count as u64)
        report.append(FixedString[16]::from_slice("\nTotal detections: "))
        report.append_u64(det.total_detections.to_u64())
        report.append(FixedString[16]::from_slice("\nMethods: "))
        report.append_u64(det.method_count as u64)
        report.append(FixedString[16]::from_slice("\nThresholds: "))
        report.append_u64(det.threshold_count as u64)

        let mut critical_count: u32 = 0
        let mut high_count: u32 = 0
        let mut med_count: u32 = 0
        for i in 0..det.alert_count {
            let a: AnomalyAlert = match det.alerts.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if a.priority == AlertPriority::Priority_Critical { critical_count = critical_count + 1 }
            if a.priority == AlertPriority::Priority_High { high_count = high_count + 1 }
            if a.priority == AlertPriority::Priority_Medium { med_count = med_count + 1 }
        }
        report.append(FixedString[16]::from_slice("\n\nPriority Distribution:\n"))
        report.append(FixedString[16]::from_slice("  Critical: "))
        report.append_u64(critical_count as u64)
        report.append(FixedString[16]::from_slice("\n  High: "))
        report.append_u64(high_count as u64)
        report.append(FixedString[16]::from_slice("\n  Medium: "))
        report.append_u64(med_count as u64)

        report.append(FixedString[16]::from_slice("\n\nRecent Alerts:\n"))
        let start: u32 = if det.alert_count > 10 { det.alert_count - 10 } else { 0 }
        for i in start..det.alert_count {
            let a: AnomalyAlert = match det.alerts.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            report.append(FixedString[8]::from_slice("  ["))
            report.append_u64(a.priority as u64)
            report.append(FixedString[8]::from_slice("] "))
            report.append(a.source)
            report.append(FixedString[4]::from_slice(": "))
            report.append_u64(a.value.to_u64())
            report.append(FixedString[4]::from_slice(" vs "))
            report.append_u64(a.expected.to_u64())
            report.append(FixedString[2]::from_slice("\n"))
        }
        report
    }

    pub fn flush_residuals(det: ref mut AnomalyDetector)
        effects: [residual]
    {
        residual emit {
            ai_op: "anomaly.residuals.flushed",
            name: det.name,
            total_alerts: det.alert_count as u64,
            total_detections: det.total_detections.to_u64(),
        }
    }
}

// ──────────────────────────────────────────────
// Utility Functions
// ──────────────────────────────────────────────
pub fn create_threshold_detector(det: ref mut AnomalyDetector, name: FixedString[ANOMALY_NAME_CAP], upper: Word64, lower: Word64)
    effects: [deterministic]
{
    let config: ThresholdConfig = ThresholdConfig::new(name, upper, lower, DetectionMethod::Method_Threshold)
    let _ = det.add_threshold(config)
}

pub fn evaluate_ensemble(det: ref mut AnomalyDetector, value: Word64, source: FixedString[ANOMALY_NAME_CAP], ts: Word64) -> u8
    effects: [deterministic, residual]
{
    let mut anomaly_score: u8 = 0
    let result: Result[bool, BoundsError> = det.evaluate(value, source, ts)
    match result {
        Result::Ok(true) => {
            // Count how many methods flagged it
            for i in 0..det.alert_count {
                let a: AnomalyAlert = match det.alerts.get(i) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                if a.timestamp.eq(ts) && a.source.eq(source) {
                    anomaly_score = anomaly_score + 1
                }
            }
        }
        Result::Ok(false) => anomaly_score = 0,
        Result::Err(_) => anomaly_score = 0,
    }
    anomaly_score
}

pub fn prioritize_alert(alert: ref mut AnomalyAlert)
    effects: [deterministic]
{
    let dev: Word64 = alert.deviation
    let expected: Word64 = alert.expected
    if expected.is_zero() {
        alert.priority = AlertPriority::Priority_Medium
        return
    }
    let ratio: Word64 = dev.mul(Word64::from_u64(100)).div(expected)
    let r: u64 = ratio.to_u64()
    if r > 200 {
        alert.priority = AlertPriority::Priority_Critical
    } else if r > 100 {
        alert.priority = AlertPriority::Priority_High
    } else if r > 50 {
        alert.priority = AlertPriority::Priority_Medium
    } else {
        alert.priority = AlertPriority::Priority_Low
    }
}

// ──────────────────────────────────────────────
// Detection Configuration Utilities
// ──────────────────────────────────────────────
pub fn configure_zscore_detection(det: ref mut AnomalyDetector, threshold: Word64)
    effects: [deterministic]
{
    let mut config: ThresholdConfig = ThresholdConfig::new(
        FixedString[ANOMALY_NAME_CAP]::from_slice("zscore_auto"),
        Word64::max_value(), Word64::zero(),
        DetectionMethod::Method_ZScore)
    config.z_score_threshold = threshold
    let _ = det.add_threshold(config)
}

pub fn configure_ensemble(det: ref mut AnomalyDetector)
    effects: [deterministic]
{
    // Add all detection methods for ensemble evaluation
    let _ = det.add_method(DetectionMethod::Method_Threshold)
    let _ = det.add_method(DetectionMethod::Method_ZScore)
    let _ = det.add_method(DetectionMethod::Method_MovingAverage)
    let _ = det.add_method(DetectionMethod::Method_SeasonalDecomp)
    let _ = det.add_method(DetectionMethod::Method_Ensemble)
}

pub fn get_alert_summary(det: ref AnomalyDetector) -> FixedString[1024]
    effects: [deterministic]
{
    let mut summary: FixedString[1024] = FixedString::new()
    summary.append(FixedString[32]::from_slice("Alert Summary\n"))
    summary.append(FixedString[32]::from_slice("===============\n"))
    summary.append(FixedString[16]::from_slice("Total alerts: "))
    summary.append_u64(det.alert_count as u64)
    let mut crit: u32 = 0
    let mut high: u32 = 0
    let mut med: u32 = 0
    let mut low: u32 = 0
    for i in 0..det.alert_count {
        let a: AnomalyAlert = match det.alerts.get(i) {
            Result::Ok(v) => v,
            Result::Err(_) => continue,
        }
        if a.priority == AlertPriority::Priority_Critical { crit = crit + 1 }
        else if a.priority == AlertPriority::Priority_High { high = high + 1 }
        else if a.priority == AlertPriority::Priority_Medium { med = med + 1 }
        else { low = low + 1 }
    }
    summary.append(FixedString[16]::from_slice("\nCritical: "))
    summary.append_u64(crit as u64)
    summary.append(FixedString[16]::from_slice("\nHigh: "))
    summary.append_u64(high as u64)
    summary.append(FixedString[16]::from_slice("\nMedium: "))
    summary.append_u64(med as u64)
    summary.append(FixedString[16]::from_slice("\nLow: "))
    summary.append_u64(low as u64)
    summary.append(FixedString[16]::from_slice("\nUnacknowledged: "))
    let mut unacked: u32 = 0
    for i in 0..det.alert_count {
        let a: AnomalyAlert = match det.alerts.get(i) {
            Result::Ok(v) => v,
            Result::Err(_) => continue,
        }
        if !a.acknowledged { unacked = unacked + 1 }
    }
    summary.append_u64(unacked as u64)
    summary
}

pub fn verify_detector_config(det: ref AnomalyDetector) -> bool
    effects: [deterministic]
{
    if det.threshold_count == 0 && det.method_count == 0 {
        return false
    }
    if det.alert_count > ANOMALY_ALERT_CAP {
        return false
    }
    for i in 0..det.threshold_count {
        let t: ThresholdConfig = match det.thresholds.get(i) {
            Result::Ok(v) => v,
            Result::Err(_) => return false,
        }
        if t.upper_bound.lt(t.lower_bound) {
            return false
        }
    }
    true
}

// ──────────────────────────────────────────────
// Module Initialization
// ──────────────────────────────────────────────
pub fn init_anomaly_detector(name: FixedString[ANOMALY_NAME_CAP]) -> AnomalyDetector
    effects: [deterministic, residual]
{
    let detector: AnomalyDetector = AnomalyDetector::new(name)
    residual emit {
        ai_op: "anomaly.subsystem.init",
        name: name,
        alert_capacity: ANOMALY_ALERT_CAP as u64,
        max_methods: ANOMALY_MAX_METHODS as u64,
        ts_window: ANOMALY_TIMESERIES_WINDOW as u64,
    }
    detector
}
