    residual emit { op: "forensic.test.search", keywords: 4, };
}

fn test_forensic_filter() -> void
    effect [compute, residual]
{
    let severity: u8 = 8;
    let min_severity: u8 = 5;
    assert(severity >= min_severity, "forensic: filtered by severity");
    residual emit { op: "forensic.test.filter", min: min_severity as u64, actual: severity as u64, };
}

fn test_forensic_sorting() -> void
    effect [compute, residual]
{
    let severities: Array(u8, 3) = [3, 8, 5];
    assert(severities[1] > severities[0], "forensic: severity 8 > 3");
    assert(severities[1] > severities[2], "forensic: severity 8 > 5");
    residual emit { op: "forensic.test.sort", highest: severities[1] as u64, };
}

fn test_forensic_pagination() -> void
    effect [compute, residual]
{
    let total_results: u64 = 250;
    let page_size: u64 = 50;
    let pages: u64 = (total_results + page_size - 1) / page_size;
    assert(pages == 5, "forensic: 250 results = 5 pages");
    residual emit { op: "forensic.test.pages", count: pages, };
}

