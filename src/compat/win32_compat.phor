/// Win32 event object emulation.
pub struct Win32Event(
  handle: u32,
  name: [u8; 256],
  manual_reset: bool,
  initial_state: bool,
  is_signaled: bool,
  waiting_threads: u32,
) : effect:(alloc, unsafe);

/// Create a Win32 event.
pub fn win32_create_event[
  event_attrs: *u8,
  manual_reset: bool,
  initial_state: bool,
  name: *u8,
  table: *Win32HandleTable,
] -> u32 : effect:(alloc, unsafe)
  loop: bounded(1)
{
  let handle: u32 = win32_open_handle(0, Win32HandleType::Event, table);
  record_win32_residual(Win32Op::EventCreate, handle as u64, 0);
  return handle;
}

/// Set a Win32 event to signaled state.
pub fn win32_set_event[
  event_handle: u32,
  table: *Win32HandleTable,
] -> bool : effect:(unsafe)
  loop: bounded(1)
{
  record_win32_residual(Win32Op::EventSet, event_handle as u64, 0);
  return true;
}

