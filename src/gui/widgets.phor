// widgets.phor — Phorensic Widget Toolkit
// Window, Label, Button, Container, TextInput, layout management
// All operations bounded. Every function declares effects. Explicit effects on every function.

package gui.widgets;

import gui.protocol;
import gui.canvas;
import gui.surface;

// ──────────────────────────────────────────────
// Widget Constants
// ──────────────────────────────────────────────

const MAX_WIDGETS: u64 = 2048;
const MAX_CHILDREN: u64 = 256;
const MAX_WINDOW_WIDGETS: u64 = 64;
const MAX_TEXT_LENGTH: u64 = 1024;
const MAX_INPUT_BUFFER: u64 = 512;
const MAX_WIDGET_EVENTS: u64 = 128;
const DEFAULT_PADDING: u32 = 8;
const DEFAULT_MARGIN: u32 = 4;
const MIN_WIDGET_WIDTH: u32 = 16;
const MIN_WIDGET_HEIGHT: u32 = 16;
const MAX_ANIMATION_FRAMES: u64 = 60;
const LABEL_MAX: u64 = 512;
const BUTTON_MAX: u64 = 512;
const TEXTINPUT_MAX: u64 = 512;

// ──────────────────────────────────────────────
// Widget Type Enum
// ──────────────────────────────────────────────

enum WidgetType {
    Root,
    Window,
    Label,
    Button,
    Container,
    TextInput,
    Image,
    Canvas,
    ScrollBar,
    Slider,
    CheckBox,
    RadioButton,
    ComboBox,
    ListBox,
    ProgressBar,
    Separator,
    Spacer,
    Custom(u64),
}

// ──────────────────────────────────────────────
// Layout Direction
// ──────────────────────────────────────────────

enum LayoutDirection {
    Horizontal,
    Vertical,
}

enum Alignment {
    Start,
    Center,
    End,
    Fill,
}

// ──────────────────────────────────────────────
// Widget State Flags
// ──────────────────────────────────────────────

struct WidgetFlags {
    visible: bool,
    enabled: bool,
    focused: bool,
    hovered: bool,
    pressed: bool,
    dirty: bool,
    layout_dirty: bool,
    clipped: bool,
    transparent: bool,
    opaque: bool,
}

// ──────────────────────────────────────────────
// Widget Geometry
// ──────────────────────────────────────────────

struct WidgetGeometry {
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    min_width: u32,
    min_height: u32,
    max_width: u32,
    max_height: u32,
    margin: protocol.Margins,
    padding: protocol.Margins,
}

// ──────────────────────────────────────────────
// Widget Base
// ──────────────────────────────────────────────

struct Widget {
    id: u64,
    type_: WidgetType,
    parent_id: u64,
    geometry: WidgetGeometry,
    flags: WidgetFlags,
    bg_color: protocol.ColorRGBA,
    fg_color: protocol.ColorRGBA,
    border_color: protocol.ColorRGBA,
    border_width: u32,
    corner_radius: u32,
    opacity: f64,
    tooltip: Array(u8, 256),
    layout_direction: LayoutDirection,
    alignment: Alignment,
    children: Array(u64, MAX_CHILDREN),
    child_count: u64,
    z_order: u64,
}

// ──────────────────────────────────────────────
// Label Widget
// ──────────────────────────────────────────────

struct LabelWidget {
    base: Widget,
    text: Array(u8, LABEL_MAX),
    text_len: u64,
    font_size: u32,
    bold: bool,
    italic: bool,
    underline: bool,
    wrap: bool,
    align_h: u64,
    align_v: u64,
    text_color: protocol.ColorRGBA,
    auto_size: bool,
    measured_width: u32,
    measured_height: u32,
}

// ──────────────────────────────────────────────
// Button Widget
// ──────────────────────────────────────────────

struct ButtonWidget {
    base: Widget,
    text: Array(u8, BUTTON_MAX),
    text_len: u64,
    font_size: u32,
    default_bg: protocol.ColorRGBA,
    hover_bg: protocol.ColorRGBA,
    pressed_bg: protocol.ColorRGBA,
    disabled_bg: protocol.ColorRGBA,
    text_color: protocol.ColorRGBA,
    icon_id: u64,
    icon_size: u32,
    auto_repeat: bool,
    repeat_delay_ms: u64,
    repeat_interval_ms: u64,
    clicked: bool,
    click_count: u64,
    border_radius: u32,
}

// ──────────────────────────────────────────────
// TextInput Widget
// ──────────────────────────────────────────────

struct TextInputWidget {
    base: Widget,
    text: Array(u8, TEXTINPUT_MAX),
    text_len: u64,
    cursor_pos: u64,
    selection_start: u64,
    selection_end: u64,
    placeholder: Array(u8, 128),
    placeholder_len: u64,
    font_size: u32,
    text_color: protocol.ColorRGBA,
    placeholder_color: protocol.ColorRGBA,
    cursor_color: protocol.ColorRGBA,
    selection_color: protocol.ColorRGBA,
    max_length: u64,
    password_mode: bool,
    password_char: u8,
    readonly: bool,
    multiline: bool,
    scroll_offset: u64,
    cursor_visible: bool,
    cursor_blink_ms: u64,
    last_blink_ms: u64,
}

// ──────────────────────────────────────────────
// Container Widget
// ──────────────────────────────────────────────

struct ContainerWidget {
    base: Widget,
    spacing: u32,
    padding_outer: u32,
    scrollable: bool,
    scroll_x: i32,
    scroll_y: i32,
    content_width: u32,
    content_height: u32,
    clip_children: bool,
    layout_direction: LayoutDirection,
    wrap_children: bool,
    align_h: Alignment,
    align_v: Alignment,
    gap: u32,
}

// ──────────────────────────────────────────────
// Widget Event
// ──────────────────────────────────────────────

enum WidgetEventType {
    Click,
    DoubleClick,
    Press,
    Release,
    Enter,
    Leave,
    FocusIn,
    FocusOut,
    KeyPress(u64),
    KeyRelease(u64),
    TextInput(u64),
    ValueChanged(u64),
    Scroll(u64, u64),
    Resize(u64, u64),
    Move(u64, u64),
    Close,
    Destroy,
    Custom(u64),
}

struct WidgetEvent {
    widget_id: u64,
    type_: WidgetEventType,
    timestamp_ms: u64,
    x: i32,
    y: i32,
    handled: bool,
}

// ──────────────────────────────────────────────
// Widget Tree (flat array storage)
// ──────────────────────────────────────────────

struct WidgetTree {
    widgets: Array(Widget, MAX_WIDGETS),
    labels: Array(LabelWidget, MAX_WIDGETS),
    buttons: Array(ButtonWidget, MAX_WIDGETS),
    text_inputs: Array(TextInputWidget, MAX_WIDGETS),
    containers: Array(ContainerWidget, MAX_WIDGETS),
    widget_count: u64,
    next_id: u64,
    root_id: u64,
    focus_id: u64,
    hover_id: u64,
    event_queue: RingBuf(WidgetEvent, MAX_WIDGET_EVENTS),
    event_count: u64,
}

// ──────────────────────────────────────────────
// Widget Tree Initialization
// ──────────────────────────────────────────────

fn widget_tree_init() -> WidgetTree
    effect [compute, residual]
{
    let tree: WidgetTree = WidgetTree {
        widgets: Array::zeroed(),
        labels: Array::zeroed(),
        buttons: Array::zeroed(),
        text_inputs: Array::zeroed(),
        containers: Array::zeroed(),
        widget_count: 0,
        next_id: 1,
        root_id: 0,
        focus_id: 0,
        hover_id: 0,
        event_queue: RingBuf::new(),
        event_count: 0,
    };
    residual emit {
        op: "widget_tree:init",
    };
    return tree;
}

fn wt_alloc_id(tree: WidgetTree) -> (WidgetTree, u64)
    effect [compute]
{
    let mut updated: WidgetTree = tree;
    let id: u64 = updated.next_id;
    updated.next_id = updated.next_id + 1;
    return (updated, id);
}

// ──────────────────────────────────────────────
// Base Widget Factory
// ──────────────────────────────────────────────

fn wt_create_widget(tree: WidgetTree, type_: WidgetType, parent: u64) -> (WidgetTree, u64)
    effect [compute, residual]
{
    let mut updated: WidgetTree = tree;
    let (new_tree, id) = wt_alloc_id(updated);
    updated = new_tree;

    let w: Widget = Widget {
        id: id,
        type_: type_,
        parent_id: parent,
        geometry: WidgetGeometry {
            x: 0, y: 0,
            width: 100, height: 50,
            min_width: MIN_WIDGET_WIDTH,
            min_height: MIN_WIDGET_HEIGHT,
            max_width: 4096,
            max_height: 4096,
            margin: protocol.Margins { left: 0, right: 0, top: 0, bottom: 0 },
            padding: protocol.Margins { left: DEFAULT_PADDING, right: DEFAULT_PADDING, top: DEFAULT_PADDING, bottom: DEFAULT_PADDING },
        },
        flags: WidgetFlags {
            visible: true,
            enabled: true,
            focused: false,
            hovered: false,
            pressed: false,
            dirty: true,
            layout_dirty: true,
            clipped: false,
            transparent: false,
            opaque: true,
        },
        bg_color: protocol.ColorRGBA { r: 240, g: 240, b: 240, a: 255 },
        fg_color: protocol.ColorRGBA { r: 0, g: 0, b: 0, a: 255 },
        border_color: protocol.ColorRGBA { r: 180, g: 180, b: 180, a: 255 },
        border_width: 1,
        corner_radius: 4,
        opacity: 1.0,
        tooltip: Array::zeroed(),
        layout_direction: LayoutDirection::Vertical,
        alignment: Alignment::Fill,
        children: Array::zeroed(),
        child_count: 0,
        z_order: 0,
    };

    updated.widgets[id] = w;
    updated.widget_count = updated.widget_count + 1;

    // Add to parent
    if parent > 0 && parent < MAX_WIDGETS {
        let parent_w: Widget = updated.widgets[parent];
        for i in 0..MAX_CHILDREN {
            let c_opt: Option(u64) = parent_w.children[i];
            match c_opt {
                Option::None => {
                    let mut updated_parent = parent_w;
                    updated_parent.children[i] = Option::Some(id);
                    updated_parent.child_count = updated_parent.child_count + 1;
                    updated.widgets[parent] = updated_parent;
                    break;
                }
                Option::Some(_) => {}
            }
        }
    }

    residual emit {
        op: "widget:create",
        id: id,
        type_: type_ as u64,
        parent: parent,
    };
    return (updated, id);
}

// ──────────────────────────────────────────────
// Label Factory
// ──────────────────────────────────────────────

fn wt_create_label(tree: WidgetTree, parent: u64, text: Slice(u8), text_len: u64) -> (WidgetTree, u64)
    effect [compute, residual]
{
    let mut updated: WidgetTree = tree;
    let (new_tree, id) = wt_create_widget(updated, WidgetType::Label, parent);
    updated = new_tree;

    let mut label_buf: Array(u8, LABEL_MAX) = Array::zeroed();
    let copy_len: u64 = if text_len < LABEL_MAX { text_len } else { LABEL_MAX };
    for i in 0..copy_len {
        label_buf[i] = text[i];
    }

    let label: LabelWidget = LabelWidget {
        base: updated.widgets[id],
        text: label_buf,
        text_len: copy_len,
        font_size: 14,
        bold: false,
        italic: false,
        underline: false,
        wrap: false,
        align_h: 0,
        align_v: 0,
        text_color: updated.widgets[id].fg_color,
        auto_size: true,
        measured_width: 100,
        measured_height: 20,
    };

    updated.labels[id] = label;
    updated.widgets[id].flags.dirty = true;

    residual emit {
        op: "widget:create_label",
        id: id,
    };
    return (updated, id);
}

fn wt_set_label_text(tree: WidgetTree, id: u64, text: Slice(u8), text_len: u64) -> WidgetTree
    effect [compute]
    bound iterations LABEL_MAX
{
    let mut updated: WidgetTree = tree;
    let label_opt: Option(LabelWidget) = updated.labels[id];
    match label_opt {
        Option::Some(l) => {
            let mut label_buf: Array(u8, LABEL_MAX) = Array::zeroed();
            let copy_len: u64 = if text_len < LABEL_MAX { text_len } else { LABEL_MAX };
            for i in 0..copy_len {
                label_buf[i] = text[i];
            }
            let updated_label: LabelWidget = LabelWidget {
                base: l.base,
                text: label_buf,
                text_len: copy_len,
                font_size: l.font_size,
                bold: l.bold,
                italic: l.italic,
                underline: l.underline,
                wrap: l.wrap,
                align_h: l.align_h,
                align_v: l.align_v,
                text_color: l.text_color,
                auto_size: l.auto_size,
                measured_width: l.measured_width,
                measured_height: l.measured_height,
            };
            updated.labels[id] = updated_label;
            updated.widgets[id].flags.dirty = true;
            let mut w: Widget = updated.widgets[id];
            w.flags.dirty = true;
            updated.widgets[id] = w;
        }
        Option::None => {}
    }
    return updated;
}

// ──────────────────────────────────────────────
// Button Factory
// ──────────────────────────────────────────────

fn wt_create_button(tree: WidgetTree, parent: u64, text: Slice(u8), text_len: u64) -> (WidgetTree, u64)
    effect [compute, residual]
{
    let mut updated: WidgetTree = tree;
    let (new_tree, id) = wt_create_widget(updated, WidgetType::Button, parent);
    updated = new_tree;

    let mut btn_buf: Array(u8, BUTTON_MAX) = Array::zeroed();
    let copy_len: u64 = if text_len < BUTTON_MAX { text_len } else { BUTTON_MAX };
    for i in 0..copy_len {
        btn_buf[i] = text[i];
    }

    let btn: ButtonWidget = ButtonWidget {
        base: updated.widgets[id],
        text: btn_buf,
        text_len: copy_len,
        font_size: 14,
        default_bg: protocol.ColorRGBA { r: 220, g: 220, b: 220, a: 255 },
        hover_bg: protocol.ColorRGBA { r: 200, g: 200, b: 200, a: 255 },
        pressed_bg: protocol.ColorRGBA { r: 160, g: 160, b: 160, a: 255 },
        disabled_bg: protocol.ColorRGBA { r: 240, g: 240, b: 240, a: 255 },
        text_color: protocol.ColorRGBA { r: 0, g: 0, b: 0, a: 255 },
        icon_id: 0,
        icon_size: 16,
        auto_repeat: false,
        repeat_delay_ms: 400,
        repeat_interval_ms: 50,
        clicked: false,
        click_count: 0,
        border_radius: 4,
    };

    // Update widget colors
    let mut w: Widget = updated.widgets[id];
    w.bg_color = btn.default_bg;
    w.fg_color = btn.text_color;
    w.corner_radius = btn.border_radius;
    w.flags.dirty = true;
    updated.widgets[id] = w;
    updated.buttons[id] = btn;

    residual emit {
        op: "widget:create_button",
        id: id,
    };
    return (updated, id);
}

fn wt_set_button_text(tree: WidgetTree, id: u64, text: Slice(u8), text_len: u64) -> WidgetTree
    effect [compute]
    bound iterations BUTTON_MAX
{
    let mut updated: WidgetTree = tree;
    let btn_opt: Option(ButtonWidget) = updated.buttons[id];
    match btn_opt {
        Option::Some(b) => {
            let mut btn_buf: Array(u8, BUTTON_MAX) = Array::zeroed();
            let copy_len: u64 = if text_len < BUTTON_MAX { text_len } else { BUTTON_MAX };
            for i in 0..copy_len {
                btn_buf[i] = text[i];
            }
            let updated_btn: ButtonWidget = ButtonWidget {
                base: b.base,
                text: btn_buf,
                text_len: copy_len,
                font_size: b.font_size,
                default_bg: b.default_bg,
                hover_bg: b.hover_bg,
                pressed_bg: b.pressed_bg,
                disabled_bg: b.disabled_bg,
                text_color: b.text_color,
                icon_id: b.icon_id,
                icon_size: b.icon_size,
                auto_repeat: b.auto_repeat,
                repeat_delay_ms: b.repeat_delay_ms,
                repeat_interval_ms: b.repeat_interval_ms,
                clicked: b.clicked,
                click_count: b.click_count,
                border_radius: b.border_radius,
            };
            updated.buttons[id] = updated_btn;
            updated.widgets[id].flags.dirty = true;
        }
        Option::None => {}
    }
    return updated;
}

// ──────────────────────────────────────────────
// TextInput Factory
// ──────────────────────────────────────────────

fn wt_create_textinput(tree: WidgetTree, parent: u64) -> (WidgetTree, u64)
    effect [compute, residual]
{
    let mut updated: WidgetTree = tree;
    let (new_tree, id) = wt_create_widget(updated, WidgetType::TextInput, parent);
    updated = new_tree;

    let mut w: Widget = updated.widgets[id];
    w.geometry.width = 200;
    w.geometry.height = 32;
    w.bg_color = protocol.ColorRGBA { r: 255, g: 255, b: 255, a: 255 };
    w.border_color = protocol.ColorRGBA { r: 180, g: 180, b: 180, a: 255 };
    w.flags.dirty = true;
    updated.widgets[id] = w;

    let ti: TextInputWidget = TextInputWidget {
        base: w,
        text: Array::zeroed(),
        text_len: 0,
        cursor_pos: 0,
        selection_start: 0,
        selection_end: 0,
        placeholder: Array::zeroed(),
        placeholder_len: 0,
        font_size: 14,
        text_color: protocol.ColorRGBA { r: 0, g: 0, b: 0, a: 255 },
        placeholder_color: protocol.ColorRGBA { r: 180, g: 180, b: 180, a: 255 },
        cursor_color: protocol.ColorRGBA { r: 0, g: 0, b: 0, a: 255 },
        selection_color: protocol.ColorRGBA { r: 180, g: 200, b: 255, a: 255 },
        max_length: MAX_INPUT_BUFFER,
        password_mode: false,
        password_char: 42,
        readonly: false,
        multiline: false,
        scroll_offset: 0,
        cursor_visible: true,
        cursor_blink_ms: 500,
        last_blink_ms: 0,
    };
    updated.text_inputs[id] = ti;

    residual emit {
        op: "widget:create_textinput",
        id: id,
    };
    return (updated, id);
}

fn wt_textinput_set_text(tree: WidgetTree, id: u64, text: Slice(u8), text_len: u64) -> WidgetTree
    effect [compute]
    bound iterations TEXTINPUT_MAX
{
    let mut updated: WidgetTree = tree;
    let ti_opt: Option(TextInputWidget) = updated.text_inputs[id];
    match ti_opt {
        Option::Some(ti) => {
            let mut buf: Array(u8, TEXTINPUT_MAX) = Array::zeroed();
            let copy_len: u64 = if text_len < TEXTINPUT_MAX { text_len } else { TEXTINPUT_MAX };
            for i in 0..copy_len {
                buf[i] = text[i];
            }
            let updated_ti: TextInputWidget = TextInputWidget {
                base: ti.base,
                text: buf,
                text_len: copy_len,
                cursor_pos: copy_len,
                selection_start: 0,
                selection_end: 0,
                placeholder: ti.placeholder,
                placeholder_len: ti.placeholder_len,
                font_size: ti.font_size,
                text_color: ti.text_color,
                placeholder_color: ti.placeholder_color,
                cursor_color: ti.cursor_color,
                selection_color: ti.selection_color,
                max_length: ti.max_length,
                password_mode: ti.password_mode,
                password_char: ti.password_char,
                readonly: ti.readonly,
                multiline: ti.multiline,
                scroll_offset: ti.scroll_offset,
                cursor_visible: ti.cursor_visible,
                cursor_blink_ms: ti.cursor_blink_ms,
                last_blink_ms: ti.last_blink_ms,
            };
            updated.text_inputs[id] = updated_ti;
            updated.widgets[id].flags.dirty = true;
        }
        Option::None => {}
    }
    return updated;
}

// ──────────────────────────────────────────────
// Container Factory
// ──────────────────────────────────────────────

fn wt_create_container(tree: WidgetTree, parent: u64) -> (WidgetTree, u64)
    effect [compute, residual]
{
    let mut updated: WidgetTree = tree;
    let (new_tree, id) = wt_create_widget(updated, WidgetType::Container, parent);
    updated = new_tree;

    let mut w: Widget = updated.widgets[id];
    w.bg_color = protocol.ColorRGBA { r: 245, g: 245, b: 245, a: 255 };
    w.flags.transparent = true;
    w.flags.dirty = true;
    updated.widgets[id] = w;

    let container: ContainerWidget = ContainerWidget {
        base: w,
        spacing: DEFAULT_PADDING,
        padding_outer: DEFAULT_MARGIN,
        scrollable: false,
        scroll_x: 0,
        scroll_y: 0,
        content_width: 0,
        content_height: 0,
        clip_children: true,
        layout_direction: LayoutDirection::Vertical,
        wrap_children: false,
        align_h: Alignment::Fill,
        align_v: Alignment::Start,
        gap: DEFAULT_PADDING,
    };
    updated.containers[id] = container;

    residual emit {
        op: "widget:create_container",
        id: id,
    };
    return (updated, id);
}

// ──────────────────────────────────────────────
// Widget Removal
// ──────────────────────────────────────────────

fn wt_remove_widget(tree: WidgetTree, id: u64) -> WidgetTree
    effect [compute, residual]
    bound iterations MAX_CHILDREN
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS || id == 0 { return updated; }

    // Remove from parent
    let w: Widget = updated.widgets[id];
    let parent_id: u64 = w.parent_id;
    if parent_id > 0 && parent_id < MAX_WIDGETS {
        let mut parent_w: Widget = updated.widgets[parent_id];
        for i in 0..MAX_CHILDREN {
            let c_opt: Option(u64) = parent_w.children[i];
            match c_opt {
                Option::Some(cid) => {
                    if cid == id {
                        parent_w.children[i] = Option::None;
                        parent_w.child_count = parent_w.child_count - 1;
                        break;
                    }
                }
                Option::None => {}
            }
        }
        updated.widgets[parent_id] = parent_w;
    }

    // Recursively remove children
    for i in 0..MAX_CHILDREN {
        let c_opt: Option(u64) = w.children[i];
        match c_opt {
            Option::Some(cid) => {
                updated = wt_remove_widget(updated, cid);
            }
            Option::None => {}
        }
    }

    // Clear all widget type data
    updated.widgets[id] = updated.widgets[0]; // zero
    updated.widget_count = updated.widget_count - 1;

    residual emit {
        op: "widget:remove",
        id: id,
    };
    return updated;
}

// ──────────────────────────────────────────────
// Layout Management
// ──────────────────────────────────────────────

fn wt_layout_widget(tree: WidgetTree, id: u64) -> WidgetTree
    effect [compute]
    bound iterations MAX_CHILDREN
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS { return updated; }

    let w: Widget = updated.widgets[id];
    if !w.flags.layout_dirty && !w.flags.dirty {
        return updated;
    }

    // Layout depends on container info
    let container_opt: Option(ContainerWidget) = updated.containers[id];
    match container_opt {
        Option::Some(cont) => {
            let mut cx: i32 = cont.base.geometry.x + cont.padding_outer as i32;
            let mut cy: i32 = cont.base.geometry.y + cont.padding_outer as i32;
            let avail_w: u32 = if cont.base.geometry.width > cont.padding_outer * 2 {
                cont.base.geometry.width - cont.padding_outer * 2
            } else { 0 };

            match cont.layout_direction {
                LayoutDirection::Vertical => {
                    for i in 0..MAX_CHILDREN {
                        let child_opt: Option(u64) = cont.base.children[i];
                        match child_opt {
                            Option::Some(cid) => {
                                let child: Widget = updated.widgets[cid];
                                if !child.flags.visible { continue; }
                                let child_h: u32 = if avail_w > 0 {
                                    child.geometry.height
                                } else {
                                    child.geometry.height
                                };
                                let mut updated_child: Widget = child;
                                updated_child.geometry.x = cx;
                                updated_child.geometry.y = cy;
                                if cont.align_h == Alignment::Fill && avail_w > 0 {
                                    updated_child.geometry.width = avail_w;
                                }
                                updated.widgets[cid] = updated_child;
                                cy = cy + child_h as i32 + cont.gap as i32;
                            }
                            Option::None => {}
                        }
                    }
                }
                LayoutDirection::Horizontal => {
                    for i in 0..MAX_CHILDREN {
                        let child_opt: Option(u64) = cont.base.children[i];
                        match child_opt {
                            Option::Some(cid) => {
                                let child: Widget = updated.widgets[cid];
                                if !child.flags.visible { continue; }
                                let child_w: u32 = if avail_w > 0 {
                                    child.geometry.width
                                } else {
                                    child.geometry.width
                                };
                                let mut updated_child: Widget = child;
                                updated_child.geometry.x = cx;
                                updated_child.geometry.y = cy;
                                if cont.align_v == Alignment::Fill {
                                    updated_child.geometry.height = cont.base.geometry.height - cont.padding_outer * 2;
                                }
                                updated.widgets[cid] = updated_child;
                                cx = cx + child_w as i32 + cont.gap as i32;
                            }
                            Option::None => {}
                        }
                    }
                }
            }

            let mut updated_cont: ContainerWidget = cont;
            updated_cont.base.flags.layout_dirty = false;
            updated.containers[id] = updated_cont;
        }
        Option::None => {
            // Non-container widget: just mark clean
            let mut updated_w: Widget = w;
            updated_w.flags.layout_dirty = false;
            updated.widgets[id] = updated_w;
        }
    }

    return updated;
}

fn wt_relayout(tree: WidgetTree) -> WidgetTree
    effect [compute]
    bound iterations MAX_WIDGETS
{
    let mut updated: WidgetTree = tree;
    // Walk tree from root, laying out all dirty widgets
    for i in 0..MAX_WIDGETS {
        let w: Widget = updated.widgets[i];
        if w.id > 0 && (w.flags.layout_dirty || w.flags.dirty) {
            updated = wt_layout_widget(updated, w.id);
        }
    }
    return updated;
}

// ──────────────────────────────────────────────
// Widget Event Queue
// ──────────────────────────────────────────────

fn wt_post_event(tree: WidgetTree, ev: WidgetEvent) -> WidgetTree
    effect [compute]
    bound iterations MAX_WIDGET_EVENTS
{
    let mut updated: WidgetTree = tree;
    for i in 0..MAX_WIDGET_EVENTS {
        let e_opt: Option(WidgetEvent) = updated.event_queue[i];
        match e_opt {
            Option::None => {
                updated.event_queue[i] = Option::Some(ev);
                updated.event_count = updated.event_count + 1;
                break;
            }
            Option::Some(_) => {}
        }
    }
    return updated;
}

fn wt_poll_event(tree: WidgetTree) -> (WidgetTree, Option(WidgetEvent))
    effect [compute]
    bound iterations MAX_WIDGET_EVENTS
{
    let mut updated: WidgetTree = tree;
    for i in 0..MAX_WIDGET_EVENTS {
        let e_opt: Option(WidgetEvent) = updated.event_queue[i];
        match e_opt {
            Option::Some(ev) => {
                updated.event_queue[i] = Option::None;
                updated.event_count = updated.event_count - 1;
                return (updated, Option::Some(ev));
            }
            Option::None => {}
        }
    }
    return (updated, Option::None);
}

// ──────────────────────────────────────────────
// Widget State Transitions
// ──────────────────────────────────────────────

fn wt_set_widget_position(tree: WidgetTree, id: u64, x: i32, y: i32) -> WidgetTree
    effect [compute]
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS { return updated; }
    let mut w: Widget = updated.widgets[id];
    w.geometry.x = x;
    w.geometry.y = y;
    w.flags.dirty = true;
    w.flags.layout_dirty = true;
    updated.widgets[id] = w;
    return updated;
}

fn wt_set_widget_size(tree: WidgetTree, id: u64, w: u32, h: u32) -> WidgetTree
    effect [compute]
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS { return updated; }
    let mut widget: Widget = updated.widgets[id];
    widget.geometry.width = w;
    widget.geometry.height = h;
    widget.flags.dirty = true;
    widget.flags.layout_dirty = true;
    updated.widgets[id] = widget;
    return updated;
}

fn wt_set_widget_visible(tree: WidgetTree, id: u64, visible: bool) -> WidgetTree
    effect [compute]
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS { return updated; }
    let mut w: Widget = updated.widgets[id];
    w.flags.visible = visible;
    w.flags.dirty = true;
    w.flags.layout_dirty = true;
    updated.widgets[id] = w;
    return updated;
}

fn wt_set_widget_enabled(tree: WidgetTree, id: u64, enabled: bool) -> WidgetTree
    effect [compute]
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS { return updated; }
    let mut w: Widget = updated.widgets[id];
    w.flags.enabled = enabled;
    w.flags.dirty = true;
    updated.widgets[id] = w;
    return updated;
}

fn wt_set_widget_bg(tree: WidgetTree, id: u64, color: protocol.ColorRGBA) -> WidgetTree
    effect [compute]
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS { return updated; }
    let mut w: Widget = updated.widgets[id];
    w.bg_color = color;
    w.flags.dirty = true;
    updated.widgets[id] = w;
    return updated;
}

fn wt_set_widget_fg(tree: WidgetTree, id: u64, color: protocol.ColorRGBA) -> WidgetTree
    effect [compute]
{
    let mut updated: WidgetTree = tree;
    if id >= MAX_WIDGETS { return updated; }
    let mut w: Widget = updated.widgets[id];
    w.fg_color = color;
    w.flags.dirty = true;
    updated.widgets[id] = w;
    return updated;
}

// ──────────────────────────────────────────────
// Hit Testing
// ──────────────────────────────────────────────

fn wt_widget_at(tree: WidgetTree, x: i32, y: i32) -> u64
    effect [compute]
    bound iterations MAX_WIDGETS
{
    // Iterate in reverse z-order (topmost first)
    for i in 0..MAX_WIDGETS {
        let w: Widget = tree.widgets[MAX_WIDGETS - 1 - i];
        if w.id == 0 || !w.flags.visible { continue; }
        let g: WidgetGeometry = w.geometry;
        let rect: protocol.Rectangle = protocol.make_rect(g.x, g.y, g.width, g.height);
        if protocol.rect_contains(rect, x, y) {
            return w.id;
        }
    }
    return 0;
}

fn wt_widget_contains(tree: WidgetTree, id: u64, x: i32, y: i32) -> bool
    effect [compute]
{
    if id >= MAX_WIDGETS { return false; }
    let w: Widget = tree.widgets[id];
    let g: WidgetGeometry = w.geometry;
    let rect: protocol.Rectangle = protocol.make_rect(g.x, g.y, g.width, g.height);
    return protocol.rect_contains(rect, x, y);
}

// ──────────────────────────────────────────────
// Widget Rendering (Canvas-based)
// ──────────────────────────────────────────────

fn wt_render_widget(tree: WidgetTree, cs: canvas.CanvasState, id: u64) -> (WidgetTree, canvas.CanvasState)
    effect [io:read, io:write, compute]
    bound iterations MAX_CHILDREN
{
    let mut updated_tree: WidgetTree = tree;
    let mut updated_cs: canvas.CanvasState = cs;

    if id >= MAX_WIDGETS { return (updated_tree, updated_cs); }
    let w: Widget = updated_tree.widgets[id];
    if !w.flags.visible { return (updated_tree, updated_cs); }

    // Render background
    let rect: protocol.Rectangle = protocol.make_rect(w.geometry.x, w.geometry.y, w.geometry.width, w.geometry.height);
    if !w.flags.transparent {
        updated_cs = canvas.canvas_set_fill_color(updated_cs, w.bg_color);
        if w.corner_radius > 0 {
            updated_cs = canvas.canvas_fill_rounded_rect(updated_cs, rect, w.corner_radius);
        } else {
            updated_cs = canvas.canvas_fill_rect(updated_cs, rect);
        }
    }

    // Render border
    if w.border_width > 0 {
        updated_cs = canvas.canvas_set_stroke_color(updated_cs, w.border_color);
        updated_cs = canvas.canvas_set_stroke_width(updated_cs, w.border_width as f64);
        updated_cs = canvas.canvas_stroke_rect(updated_cs, rect);
    }

    // Render type-specific content
    let type_: WidgetType = w.type_;
    match type_ {
        WidgetType::Label => {
            let label_opt: Option(LabelWidget) = updated_tree.labels[id];
            match label_opt {
                Option::Some(l) => {
                    let text_slice: Slice(u8) = Slice::from_array(l.text);
                    updated_cs = canvas.canvas_set_fill_color(updated_cs, l.text_color);
                    let tx: i32 = l.base.geometry.x + l.base.geometry.padding.left as i32;
                    let ty: i32 = l.base.geometry.y + l.base.geometry.padding.top as i32 + l.font_size as i32;
                    updated_cs = canvas.canvas_draw_text(updated_cs, canvas.FontAtlas { glyphs: Array::zeroed(), glyph_count: 0, font_size: l.font_size, line_height: l.font_size + l.font_size / 2, space_width: l.font_size / 3, tab_width: l.font_size * 2 }, text_slice, tx, ty);
                }
                Option::None => {}
            }
        }
        WidgetType::Button => {
            let btn_opt: Option(ButtonWidget) = updated_tree.buttons[id];
            match btn_opt {
                Option::Some(b) => {
                    // Draw button with state-dependent color
                    let bg: protocol.ColorRGBA = if !b.base.flags.enabled {
                        b.disabled_bg
                    } else if b.base.flags.pressed {
                        b.pressed_bg
                    } else if b.base.flags.hovered {
                        b.hover_bg
                    } else {
                        b.default_bg
                    };
                    updated_cs = canvas.canvas_set_fill_color(updated_cs, bg);
                    updated_cs = canvas.canvas_fill_rounded_rect(updated_cs, rect, b.border_radius);

                    // Draw text
                    let text_slice: Slice(u8) = Slice::from_array(b.text);
                    updated_cs = canvas.canvas_set_fill_color(updated_cs, b.text_color);
                    let tx: i32 = b.base.geometry.x + (b.base.geometry.width as i32 - (b.text_len as u32 * 7) as i32) / 2;
                    let ty: i32 = b.base.geometry.y + (b.base.geometry.height as i32 + b.font_size as i32) / 2;
                    updated_cs = canvas.canvas_draw_text(updated_cs, canvas.FontAtlas { glyphs: Array::zeroed(), glyph_count: 0, font_size: b.font_size, line_height: b.font_size + b.font_size / 2, space_width: b.font_size / 3, tab_width: b.font_size * 2 }, text_slice, tx, ty);
                }
                Option::None => {}
            }
        }
        WidgetType::TextInput => {
            let ti_opt: Option(TextInputWidget) = updated_tree.text_inputs[id];
            match ti_opt {
                Option::Some(ti) => {
                    // Draw input background (already done above)
                    // Draw text
                    let text_slice: Slice(u8) = Slice::from_array(ti.text);
                    updated_cs = canvas.canvas_set_fill_color(updated_cs, ti.text_color);
                    let tx: i32 = ti.base.geometry.x + 4;
                    let ty: i32 = ti.base.geometry.y + (ti.base.geometry.height as i32 + ti.font_size as i32) / 2;
                    updated_cs = canvas.canvas_draw_text(updated_cs, canvas.FontAtlas { glyphs: Array::zeroed(), glyph_count: 0, font_size: ti.font_size, line_height: ti.font_size + ti.font_size / 2, space_width: ti.font_size / 3, tab_width: ti.font_size * 2 }, text_slice, tx, ty);

                    // Draw cursor
                    if ti.cursor_visible && ti.base.flags.focused {
                        let cursor_x: i32 = tx + (ti.cursor_pos as u32 * 7) as i32;
                        let cursor_rect: protocol.Rectangle = protocol.make_rect(cursor_x, ti.base.geometry.y + 2, 2, ti.base.geometry.height - 4);
                        updated_cs = canvas.canvas_set_fill_color(updated_cs, ti.cursor_color);
                        updated_cs = canvas.canvas_fill_rect(updated_cs, cursor_rect);
                    }
                }
                Option::None => {}
            }
        }
        _ => {}
    }

    // Render children
    for i in 0..MAX_CHILDREN {
        let child_opt: Option(u64) = w.children[i];
        match child_opt {
            Option::Some(cid) => {
                let (t, c) = wt_render_widget(updated_tree, updated_cs, cid);
                updated_tree = t;
                updated_cs = c;
            }
            Option::None => {}
        }
    }

    // Mark clean
    let mut clean_w: Widget = updated_tree.widgets[id];
    clean_w.flags.dirty = false;
    updated_tree.widgets[id] = clean_w;

    return (updated_tree, updated_cs);
}

// ──────────────────────────────────────────────
// Widget Statistics
// ──────────────────────────────────────────────

struct WidgetTreeInfo {
    widget_count: u64,
    next_id: u64,
    focus_id: u64,
    hover_id: u64,
    event_queue_usage: u64,
    label_count: u64,
    button_count: u64,
    textinput_count: u64,
    container_count: u64,
}

fn wt_get_info(tree: WidgetTree) -> WidgetTreeInfo
    effect [compute]
{
    let mut label_count: u64 = 0;
    let mut button_count: u64 = 0;
    let mut ti_count: u64 = 0;
    let mut container_count: u64 = 0;
    for i in 0..MAX_WIDGETS {
        let w: Widget = tree.widgets[i];
        if w.id > 0 {
            match w.type_ {
                WidgetType::Label => { label_count = label_count + 1; }
                WidgetType::Button => { button_count = button_count + 1; }
                WidgetType::TextInput => { ti_count = ti_count + 1; }
                WidgetType::Container => { container_count = container_count + 1; }
                _ => {}
            }
        }
    }
    return WidgetTreeInfo {
        widget_count: tree.widget_count,
        next_id: tree.next_id,
        focus_id: tree.focus_id,
        hover_id: tree.hover_id,
        event_queue_usage: tree.event_count,
        label_count: label_count,
        button_count: button_count,
        textinput_count: ti_count,
        container_count: container_count,
    };
}
