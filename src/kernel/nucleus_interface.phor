// Trusted: Line-audited by Nucleus Audit Team

package kernel.nucleus_interface;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type NucleusError = enum {
    InvalidTransition     = 0x01,  // E0001: illegal mode transition requested
    TrapNotRegistered     = 0x02,  // E0002: trap vector has no registered handler
    CapabilityViolation   = 0x03,  // E0003: insufficient capability for nucleus operation
    StaleGeneration       = 0x04,  // E0004: handle generation tag is stale
    InterruptSpurious     = 0x05,  // E0005: interrupt fired with no pending source
    IntegrityFailure      = 0x06,  // E0006: nucleus self-test integrity mismatch
    WatchdogExpired       = 0x07,  // E0007: watchdog timer fired, system state recorded
    InvalidTrapVector     = 0x08,  // E0008: trap vector number out of range
    ModeSwitchFailed      = 0x09,  // E0009: hardware refused mode transition
    HaltOnFailure         = 0x0A,  // E000A: unrecoverable nucleus error, halting
    ContextCorruption     = 0x0B,  // E000B: saved context integrity check failed
    RegisterInvalid       = 0x0C,  // E000C: machine register not valid for current mode
    ReservedInstruction   = 0x0D,  // E000D: instruction not available at current privilege
    DoubleFault           = 0x0E,  // E000E: double fault condition detected
    PageFaultNucleus      = 0x0F,  // E000F: page fault in nucleus address space
}

// ─────────────────────────────────────────────────────────────
// CPU Execution Modes
// ─────────────────────────────────────────────────────────────

type CpuMode = enum {
    UserMode            = 0,   // Ring 3 — least privileged
    KernelMode          = 1,   // Ring 0 — kernel operations
    NucleusMode         = 2,   // Beyond Ring 0 — trusted hardware operations
    SystemManagementMode = 3,  // SMM — platform management
    HypervisorMode      = 4,   // VMX root / SVM host
    IdleMode            = 5,   // HLT state
    HaltMode            = 6,   // Triple-fault or catastrophic halt
}

// ─────────────────────────────────────────────────────────────
// CPU Register Context
// ─────────────────────────────────────────────────────────────

struct CpuRegisterState {
    rax: u64,
    rbx: u64,
    rcx: u64,
    rdx: u64,
    rsi: u64,
    rdi: u64,
    rbp: u64,
    rsp: u64,
    r8: u64,
    r9: u64,
    r10: u64,
    r11: u64,
    r12: u64,
    r13: u64,
    r14: u64,
    r15: u64,
    rip: u64,
    rflags: u64,
    cs: u64,
    ds: u64,
    es: u64,
    fs: u64,
    gs: u64,
    ss: u64,
    cr0: u64,
    cr2: u64,
    cr3: u64,
    cr4: u64,
    efer: u64,
    gdtr_base: u64,
    gdtr_limit: u32,
    idtr_base: u64,
    idtr_limit: u32,
    tr_segment: u64,
    fs_base: u64,
    gs_base: u64,
    kernel_stack: u64,
}

struct MinimalCpuContext {
    rax: u64,
    rbx: u64,
    rcx: u64,
    rdx: u64,
    rsi: u64,
    rdi: u64,
    rbp: u64,
    rsp: u64,
    rip: u64,
    rflags: u64,
    cs: u64,
    ss: u64,
    error_code: u64,
    trap_number: u64,
}

// ─────────────────────────────────────────────────────────────
// Machine Configuration
// ─────────────────────────────────────────────────────────────

struct MachineConfig {
    cpu_vendor: Array(u8, 16),
    cpu_family: u32,
    cpu_model: u32,
    cpu_stepping: u32,
    cpu_features: Bitmap(u64),
    memory_map_entries: u32,
    memory_map: Array(MemoryRegionDescriptor, 32),
    timer_frequency_hz: u64,
    cpu_frequency_hz: u64,
    acpi_revision: u32,
    boot_protocol: u32,
}

struct MemoryRegionDescriptor {
    base_address: u64,
    length: u64,
    region_type: u32,     // 1=usable, 2=reserved, 3=ACPI, 4=NVS, 5=bad
    region_attributes: u32,
}

// ─────────────────────────────────────────────────────────────
// Trap Descriptors
// ─────────────────────────────────────────────────────────────

type TrapVector = u16;  // 0-255 valid, 0-31 reserved for CPU exceptions

struct TrapDescriptor {
    vector: TrapVector,
    handler_type: TrapHandlerType,
    handler_address: u64,
    handler_capability: Cap(TrapHandlerCapability),
    stack_switch: bool,
    ist_index: u8,
    present: bool,
    dpl: u8,
    residual_after_trap: bool,
}

type TrapHandlerType = enum {
    InterruptGate   = 0,   // Hardware interrupt (IF cleared)
    TrapGate        = 1,   // CPU exception (IF unchanged)
    TaskGate        = 2,   // Task switch (not used in x86_64)
    NucleusGate     = 3,   // Phorensic nucleus call gate
    CapabilityGate  = 4,   // Capability-gated entry point
    SpuriousHandler = 5,   // Spurious interrupt handler
    ErrorCodeGate   = 6,   // Exception with error code
}

// ─────────────────────────────────────────────────────────────
// Mode Transition Types
// ─────────────────────────────────────────────────────────────

type ModeTransitionType = enum {
    UserToKernel         = 0,  // syscall / capability gate
    KernelToNucleus      = 1,  // trusted operation request
    NucleusToKernel      = 2,  // return from trusted operation
    KernelToUser         = 3,  // return from syscall / context switch
    InterruptEntry       = 4,  // hardware interrupt
    InterruptReturn      = 5,  // return from interrupt
    TrapEntry            = 6,  // CPU exception
    TrapResume           = 7,  // return from exception (may not be possible)
    HaltEntry            = 8,  // system halt
    WakeFromIdle         = 9,  // interrupt wakes idle CPU
    ContextSwitch        = 10, // thread/process context switch
    CapabilityGateCall   = 11, // explicit capability gate call
    FastIpcEntry         = 12, // fast IPC path entry
    FastIpcReturn        = 13, // return from fast IPC
}

// ─────────────────────────────────────────────────────────────
// Mode Transition Record
// ─────────────────────────────────────────────────────────────

struct ModeTransitionRecord {
    transition_type: ModeTransitionType,
    from_mode: CpuMode,
    to_mode: CpuMode,
    caller_identity: Identity,
    caller_capability: Cap(CapabilityToken),
    transition_timestamp: u64,
    transition_reason: TransitionReason,
    residual_record: ResidualRecord,
    verification_token: u64,
    transition_success: bool,
    failure_reason: Option(NucleusError),
    generation_at_transition: u64,
    integrity_measurement: u64,
}

type TransitionReason = enum {
    SystemCall         = 0,
    Interrupt          = 1,
    Exception          = 2,
    VoluntaryYield     = 3,
    CapabilityRequest  = 4,
    CapabilityRevoke   = 5,
    IpcSend            = 6,
    IpcReceive         = 7,
    TimerExpiry        = 8,
    DeviceOperation    = 9,
    PowerManagement    = 10,
    DebugRequest       = 11,
    AuditTrail         = 12,
    IntegrityCheck     = 13,
    WatchdogPet        = 14,
    Unknown            = 15,
}

// ─────────────────────────────────────────────────────────────
// Interrupt Descriptors
// ─────────────────────────────────────────────────────────────

struct InterruptDescriptor {
    irq_number: u8,
    vector: TrapVector,
    registered_handler: Option(Handle(InterruptHandler)),
    handler_capability: Cap(InterruptCapability),
    is_masked: bool,
    is_pending: bool,
    trigger_mode: TriggerMode,
    polarity: Polarity,
    shared: bool,
    residual_capture: bool,
    timestamp_last_fired: u64,
    fire_count: u64,
    handler_residuals: RingBuf(ResidualRecord, 64),
}

type TriggerMode = enum {
    EdgeTriggered  = 0,
    LevelTriggered = 1,
}

type Polarity = enum {
    ActiveHigh = 0,
    ActiveLow  = 1,
}

// ─────────────────────────────────────────────────────────────
// Interrupt Dispatch
// ─────────────────────────────────────────────────────────────

struct InterruptDispatchContext {
    irq: u8,
    vector: u8,
    saved_context: MinimalCpuContext,
    timestamp_enter: u64,
    dispatch_decision: DispatchDecision,
    handler_result: InterruptResult,
    timestamp_exit: u64,
    residual_record: ResidualRecord,
}

type DispatchDecision = enum {
    DispatchToHandler  = 0,  // handler registered and capability valid
    MaskAndContinue    = 1,  // mask interrupt and return
    SpuriousIgnore     = 2,  // no pending source, ignore
    HaltSystem         = 3,  // critical unhandled interrupt
    QueueForDeferral   = 4,  // defer to kernel's softirq processing
    FastPathComplete   = 5,  // handled in nucleus, no kernel dispatch needed
    ErrorCondition     = 6,  // malformed interrupt state
}

type InterruptResult = enum {
    Handled             = 0,
    NeedsKernelDispatch = 1,
    Unhandled           = 2,
    RescheduleNeeded    = 3,
    ErrorRecovery       = 4,
    Ignored             = 5,
}

