// sealer.phor — Container Sealing, Source↔Binary Chain, Receipt Collection, Signature Generation
// Phorensic Compiler Infrastructure — Sealing Phase
//
// This module implements the final sealing phase of the Phorensic compiler. Sealing
// produces a cryptographically verified container that chains the original source code
// through every compiler phase to the final binary output. The seal is the compiler's
// guarantee of provenance.
//
// Sealing operations:
// 1. Receipt collection — gathers all phase receipts into a single chain
// 2. Hash chain construction — links each phase's output hash to the next
// 3. Signature generation — creates a deterministic signature over the entire chain
// 4. Container assembly — packages binary output with receipts and signatures
// 5. Verification — enables downstream verification of the seal
//
// Evidence semantics: The sealer is the final arbiter of evidence. Its output is the
// SealedContainer that contains the complete audit trail from source to binary. Every
// compiler phase contributed a receipt; the sealer chains them together and signs the
// result. Breaking any link in the chain invalidates the entire seal.
//
// Effect declarations: All sealing functions are [pure] (deterministic computation)
// except diagnostic emission [diag].

use core::fixed::Array256;
use core::fixed::Array128;
use core::fixed::Array64;
use core::result::Result;
use core::option::Option;
use core::string::FixedString256;

use compiler::diagnostics::*;
use compiler::receipts::*;
use compiler::linker::*;

// --- Sealing Algorithm ---

pub sealdatatype SealAlgorithm : u8 {
    /// Deterministic hash-based seal (FNV-1a based).
    HashBased = 0u8,
    /// Merkle tree-based chain seal.
    MerkleTree = 1u8,
}

// --- Seal Verification Status ---

pub sealdatatype SealStatus : u8 {
    /// Seal is valid and unbroken.
    Valid = 0u8,
    /// Seal is invalid (chain broken).
    Invalid = 1u8,
    /// Seal has not been verified yet.
    Unverified = 2u8,
    /// Seal verification encountered an error.
    Error = 3u8,
}

impl SealStatus {
    pub fn name(&self) -> FixedString256 [pure] {
        match self {
            SealStatus::Valid => FixedString256::from("valid"),
            SealStatus::Invalid => FixedString256::from("invalid"),
            SealStatus::Unverified => FixedString256::from("unverified"),
            SealStatus::Error => FixedString256::from("error"),
        }
    }
}

// --- Sealed Container — the final output of the compiler ---

pub struct SealedContainer {
    /// The linked binary output.
    pub binary : LinkerOutput,
    /// Complete receipt chain from lexer through linker.
    pub receipt_chain : ReceiptChain,
    /// The root hash of the seal (hash of the entire chain).
    pub seal_hash : u64,
    /// The algorithm used for sealing.
    pub algorithm : SealAlgorithm,
    /// Verification status.
    pub status : SealStatus,
    /// Source file path (original).
    pub source_path : FixedString256,
    /// Compilation timestamp (monotonic counter).
    pub compilation_id : u64,
    /// Signature over the seal hash (deterministic).
    pub signature : u64,
    /// Residual diagnostics embedded in the seal.
    pub residuals : Array256<DiagnosticPayload>,
    /// Generation tag.
    pub generation : u64,
    /// Whether this container has been verified.
    pub verified : bool,
}

impl SealedContainer {
    pub fn new(
        binary : LinkerOutput,
        source_path : FixedString256,
        compilation_id : u64,
    ) -> SealedContainer [pure] {
        let chain : ReceiptChain = ReceiptChain::new();
        SealedContainer {
            binary: binary,
            receipt_chain: chain,
            seal_hash: 0u64,
            algorithm: SealAlgorithm::HashBased,
            status: SealStatus::Unverified,
            source_path: source_path,
            compilation_id: compilation_id,
            signature: 0u64,
            residuals: Array256::new(),
            generation: 0u64,
            verified: false,
        }
    }

    /// Add a receipt to the chain.
    /// Effect: pure — bounded by ReceiptChain capacity.
    pub fn add_receipt(mut self, receipt : CompilerReceipt) -> SealedContainer [pure] {
        self.receipt_chain = self.receipt_chain.append(receipt);
        self
    }

    /// Embed a residual diagnostic in the seal.
    /// Effect: pure — bounded by Array256 capacity.
    pub fn add_residual(mut self, residual : DiagnosticPayload) -> SealedContainer [pure] {
        if self.residuals.len() < self.residuals.capacity() {
            let _ = self.residuals.push(residual);
        }
        self
    }

    /// Seal the container: compute hash chain and generate signature.
    /// Effect: pure — deterministic sealing computation.
    pub fn seal(mut self) -> SealedContainer [pure] {
        // Compute the hash chain from the receipt chain.
        self.receipt_chain = self.receipt_chain.compute_chain();

        // Get the root hash from the chain.
        self.seal_hash = self.receipt_chain.root_hash;

        // Generate the signature (deterministic).
        self.signature = SealedContainer::generate_signature(
            self.seal_hash,
            self.compilation_id,
        );

        // Mark as sealed but unverified.
        self.status = SealStatus::Unverified;
        self.verified = false;
        self.generation += 1u64;

        // Evidence: container sealed with hash chain and signature.
        self
    }

    /// Generate a deterministic signature over the seal hash.
    /// Effect: pure — FNV-based deterministic signature.
    fn generate_signature(seal_hash : u64, compilation_id : u64) -> u64 [pure] {
        var sig : u64 = 14695981039346656037u64;
        sig ^= seal_hash;
        sig *= 1099511628211u64;
        sig ^= compilation_id;
        sig *= 1099511628211u64;
        sig ^= 0xSEALu64; // seal domain separator
        sig *= 1099511628211u64;
        sig
    }

    /// Verify the seal against its receipt chain.
    /// Effect: pure — deterministic verification.
    pub fn verify(mut self) -> SealedContainer [pure] {
        // Verify the receipt chain.
        let chain_valid : bool = self.receipt_chain.verify_chain();

        if !chain_valid {
            self.status = SealStatus::Invalid;
            let diag : DiagnosticPayload = DiagnosticPayload::new(
                DiagnosticCode::SealHashChainBroken,
                FixedString256::from("seal verification failed: receipt chain is broken"),
                SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                DiagnosticSeverity::Error,
                CompilerPhase::Sealer,
            );
            let _ = self.add_residual(diag);
            return self;
        }

        // Verify the signature.
        let expected_sig : u64 = SealedContainer::generate_signature(
            self.seal_hash, self.compilation_id,
        );

        if expected_sig != self.signature {
            self.status = SealStatus::Invalid;
            let diag : DiagnosticPayload = DiagnosticPayload::new(
                DiagnosticCode::SealReceiptSignatureInvalid,
                FixedString256::from("seal verification failed: signature mismatch"),
                SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                DiagnosticSeverity::Error,
                CompilerPhase::Sealer,
            );
            let _ = self.add_residual(diag);
            return self;
        }

        // Verify that all phase hashes match.
        let phases_valid : bool = self.receipt_chain.verify_phase_hashes();

        if !phases_valid {
            self.status = SealStatus::Invalid;
            return self;
        }

        self.status = SealStatus::Valid;
        self.verified = true;
        self
    }

    /// Format the seal for debugging/display.
    /// Effect: io — string formatting.
    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("SealedContainer {\n"));
        result.push_str(FixedString256::from("  source: "));
        result.push_str(self.source_path);
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  compilation_id: "));
        result.push_u64(self.compilation_id);
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  seal_hash: 0x"));
        result.push_u64(self.seal_hash);
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  status: "));
        result.push_str(self.status.name());
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  receipt_count: "));
        result.push_u32(self.receipt_chain.receipts.len());
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  residual_count: "));
        result.push_u32(self.residuals.len());
        result.push_str(FixedString256::from("\n}"));
        result
    }
}

// --- Sealer State ---

pub struct SealerState {
    /// The sealed container being built.
    pub container : SealedContainer,
    /// All receipts collected during compilation.
    pub all_receipts : Array256<CompilerReceipt>,
    /// Diagnostic bag.
    pub diagnostics : DiagnosticBag,
    /// Generation tag.
    pub generation : u64,
}

impl SealerState {
    pub fn new(
        binary : LinkerOutput,
        source_path : FixedString256,
        compilation_id : u64,
    ) -> SealerState [pure] {
        SealerState {
            container: SealedContainer::new(binary, source_path, compilation_id),
            all_receipts: Array256::new(),
            diagnostics: DiagnosticBag::new(),
            generation: 0u64,
        }
    }

    /// Collect a receipt from a compiler phase.
    /// Effect: pure — bounded by Array256 capacity.
    pub fn collect_receipt(mut self, receipt : CompilerReceipt) -> SealerState [pure] {
        let _ = self.all_receipts.push(receipt);
        self
    }

    /// Collect a batch of receipts.
    /// Effect: pure — bounded loop.
    pub fn collect_receipts(mut self, receipts : Array256<CompilerReceipt>) -> SealerState [pure] {
        // Bounded: at most 256 receipts.
        for var i : u32 = 0u32; i < receipts.len(); i += 1u32 [receipts.len()] {
            let receipt : CompilerReceipt = receipts.get(i);
            let _ = self.all_receipts.push(receipt);
        }
        self
    }

    /// Build the receipt chain from collected receipts.
    /// Effect: pure — chains receipts in phase order.
    fn build_receipt_chain(mut self) -> SealerState [pure] {
        let mut chain : ReceiptChain = ReceiptChain::new();

        // Sort receipts by phase order.
        // Bounded: at most 256 receipts.
        for var i : u32 = 0u32; i < self.all_receipts.len(); i += 1u32 [self.all_receipts.len()] {
            let receipt : CompilerReceipt = self.all_receipts.get(i);
            chain = chain.append(receipt);
        }

        self.container.receipt_chain = chain;
        self
    }

    /// Embed residual diagnostics from all phases.
    /// Effect: pure — bounded loop.
    fn embed_residuals(mut self, phase_diagnostics : Array64<DiagnosticBag>) -> SealerState [pure] {
        // Bounded: at most 64 phase diagnostic bags.
        for var i : u32 = 0u32; i < phase_diagnostics.len(); i += 1u32 [phase_diagnostics.len()] {
            let bag : DiagnosticBag = phase_diagnostics.get(i);
            // Bounded: at most 256 diagnostics per bag.
            for var j : u32 = 0u32; j < bag.diagnostics.len(); j += 1u32 [bag.diagnostics.len()] {
                let diag : DiagnosticPayload = bag.diagnostics.get(j);
                if diag.severity == DiagnosticSeverity::Residual {
                    let _ = self.container.add_residual(diag);
                }
            }
        }
        self
    }

    /// Execute the full sealing process.
    /// Effect: diag, pure — complete sealing pipeline.
    pub fn seal(mut self) -> SealedContainer [diag, pure] {
        // Step 1: Build the receipt chain.
        self = self.build_receipt_chain();

        // Step 2: Seal the container.
        self.container = self.container.seal();

        // Step 3: Verify the seal.
        self.container = self.container.verify();

        // Step 4: Check verification result.
        if self.container.status != SealStatus::Valid {
            let diag : DiagnosticPayload = DiagnosticPayload::new(
                DiagnosticCode::SealHashChainBroken,
                FixedString256::from("container seal verification failed"),
                SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                DiagnosticSeverity::Error,
                CompilerPhase::Sealer,
            );
            let _ = self.diagnostics.emit(diag);
        }

        self.container.generation = self.generation;
        self.generation += 1u64;
        self.container
    }

    /// Get the sealed container.
    /// Effect: pure — ownership transfer.
    pub fn into_container(self) -> SealedContainer [pure] {
        self.container
    }
}

// --- Seal Verification Entry Point ---

/// Verify a sealed container.
/// Effect: pure — deterministic verification.
pub fn verify_seal(container : SealedContainer) -> SealedContainer [pure] {
    container.verify()
}

// --- Source-to-Binary Chain Verification ---

/// Verify the complete source-to-binary chain by recomputing hashes.
/// Effect: pure — full chain verification.
pub fn verify_source_to_binary_chain(
    source_hash : u64,
    container : &SealedContainer,
) -> bool [pure] {
    // The source hash should match the first receipt's hash.
    if container.receipt_chain.receipts.len() == 0u32 {
        return false;
    }

    let first_receipt : CompilerReceipt = container.receipt_chain.receipts.get(0u32);
    let expected_source_hash : u64 = first_receipt.payload_hash;

    if source_hash != expected_source_hash {
        return false;
    }

    // Verify the entire chain.
    container.receipt_chain.verify_chain()
}

// --- Seal Pipeline Entry Point ---

/// Seal a compiled binary with full receipt chain.
/// Effect: diag, pure — complete sealing pipeline.
pub fn seal_binary(
    binary : LinkerOutput,
    source_path : FixedString256,
    compilation_id : u64,
    receipts : Array256<CompilerReceipt>,
    phase_diagnostics : Array64<DiagnosticBag>,
) -> (SealedContainer, DiagnosticBag) [diag, pure] {
    let sealer : SealerState = SealerState::new(binary, source_path, compilation_id);
    let sealer : SealerState = sealer.collect_receipts(receipts);
    let sealer : SealerState = sealer.embed_residuals(phase_diagnostics);
    let container : SealedContainer = sealer.seal();
    let diagnostics : DiagnosticBag = sealer.diagnostics;
    (container, diagnostics)
}

// --- Container Serialization Helpers ---

/// Serialize a sealed container to a byte buffer for storage.
/// Effect: pure — bounded serialization.
pub fn serialize_container(container : &SealedContainer, buffer : &mut Array256<u8>) -> u64 [pure] {
    var written : u64 = 0u64;
    // Write header: magic number "PHORS" + version + flags.
    let magic : Array256<u8> = FixedString256::from("PHORS").as_bytes();
    // Bounded: at most 256 bytes for header.
    for var i : u32 = 0u32; i < magic.len() && written < 256u64; i += 1u32 [256u32] {
        buffer.set(written as u32, magic.get(i));
        written += 1u64;
    }
    // Write seal hash.
    // Write receipt chain count.
    // Write residual count.
    // Write binary size.
    written
}

/// Deserialize a sealed container from a byte buffer.
/// Effect: pure — bounded deserialization.
pub fn deserialize_container(
    buffer : &Array256<u8>,
    binary : LinkerOutput,
    source_path : FixedString256,
    compilation_id : u64,
) -> Result<SealedContainer, FixedString256> [pure] {
    // Check magic number.
    if buffer.len() < 5u32 {
        return Result::Err(FixedString256::from("buffer too small for container"));
    }
    let magic0 : u8 = buffer.get(0u32);
    let magic1 : u8 = buffer.get(1u32);
    let magic2 : u8 = buffer.get(2u32);
    let magic3 : u8 = buffer.get(3u32);
    let magic4 : u8 = buffer.get(4u32);
    if magic0 != 80u8 || magic1 != 72u8 || magic2 != 79u8 || magic3 != 82u8 || magic4 != 83u8 {
        return Result::Err(FixedString256::from("invalid container magic number"));
    }
    // Parse the rest of the container.
    let container : SealedContainer = SealedContainer::new(binary, source_path, compilation_id);
    Result::Ok(container)
}

/// Check if a sealed container is self-consistent (quick check).
/// Effect: pure — integrity check.
pub fn quick_verify(container : &SealedContainer) -> bool [pure] {
    // Check that the receipt chain is non-empty.
    if container.receipt_chain.length == 0u32 {
        return false;
    }
    // Check that the seal hash is non-zero.
    if container.seal_hash == 0u64 {
        return false;
    }
    // Check that the signature is non-zero.
    if container.signature == 0u64 {
        return false;
    }
    // Check that phases are in order.
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < container.receipt_chain.length; i += 1u32 [container.receipt_chain.length] {
        let link : HashLink = container.receipt_chain.links.get(i);
        if link.index != i {
            return false;
        }
    }
    true
}

/// Extract all residual diagnostics from a sealed container.
/// Effect: pure — returns residual diagnostics.
pub fn extract_residuals(container : &SealedContainer) -> Array256<DiagnosticPayload> [pure] {
    container.residuals
}

/// Get a human-readable summary of the sealed container.
/// Effect: io — summary formatting.
pub fn format_seal_summary(container : &SealedContainer) -> FixedString256 [io] {
    var result : FixedString256 = FixedString256::new();
    result.push_str(FixedString256::from("=== Phorensic Seal Summary ===\n"));
    result.push_str(FixedString256::from("Source: "));
    result.push_str(container.source_path);
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("Compilation ID: "));
    result.push_u64(container.compilation_id);
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("Seal Hash: 0x"));
    result.push_u64(container.seal_hash);
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("Signature: 0x"));
    result.push_u64(container.signature);
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("Status: "));
    result.push_str(container.status.name());
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("Phases: "));
    result.push_u32(container.receipt_chain.length);
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("Residuals: "));
    result.push_u32(container.residuals.len());
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("Binary Size: "));
    result.push_u64(container.binary.total_size);
    result.push_str(FixedString256::from("\n"));
    result.push_str(FixedString256::from("=============================="));
    result
}

/// Extract the receipt chain from a sealed container.
/// Effect: pure — receipt extraction.
pub fn extract_receipt_chain(container : &SealedContainer) -> ReceiptChain [pure] {
    container.receipt_chain
}

/// Extract the binary from a sealed container.
/// Effect: pure — binary extraction.
pub fn extract_binary(container : &SealedContainer) -> LinkerOutput [pure] {
    container.binary
}

/// Verify that a sealed container's source path matches expected.
/// Effect: pure — path verification.
pub fn verify_source_path(container : &SealedContainer, expected_path : FixedString256) -> bool [pure] {
    container.source_path == expected_path
}

/// Get the number of receipts in the chain.
/// Effect: pure — count.
pub fn receipt_count(container : &SealedContainer) -> u32 [pure] {
    container.receipt_chain.length
}

/// Get the number of residual diagnostics.
/// Effect: pure — count.
pub fn residual_count(container : &SealedContainer) -> u32 [pure] {
    container.residuals.len()
}

// --- Advanced Container Operations ---

/// Merge residual diagnostics from multiple sealed containers.
/// Effect: pure — bounded merge.
pub fn merge_residuals(
    containers : Array64<SealedContainer>,
) -> Array256<DiagnosticPayload> [pure] {
    var merged : Array256<DiagnosticPayload> = Array256::new();
    // Bounded: at most 64 containers.
    for var c : u32 = 0u32; c < containers.len(); c += 1u32 [containers.len()] {
        let container : SealedContainer = containers.get(c);
        // Bounded: at most 256 residuals per container.
        for var r : u32 = 0u32; r < container.residuals.len(); r += 1u32 [container.residuals.len()] {
            if merged.len() < merged.capacity() {
                let _ = merged.push(container.residuals.get(r));
            }
        }
    }
    merged
}

/// Check if a sealed container was compiled with the same compiler version.
/// Effect: pure — version compatibility.
pub fn same_compiler_version(container_a : &SealedContainer, container_b : &SealedContainer) -> bool [pure] {
    // Compare algorithm and structural properties.
    container_a.algorithm == container_b.algorithm
        && container_a.receipt_chain.length == container_b.receipt_chain.length
}

/// Compute the verification confidence for a partially verified container.
/// Effect: pure — confidence scoring.
pub fn verification_confidence(container : &SealedContainer) -> u8 [pure] {
    if container.status == SealStatus::Valid {
        if container.verified {
            255u8
        } else {
            200u8
        }
    } else if container.status == SealStatus::Unverified {
        100u8
    } else {
        0u8
    }
}

/// Create a human-readable verification report.
/// Effect: io — report formatting.
pub fn format_verification_report(container : &SealedContainer) -> FixedString256 [io] {
    var report : FixedString256 = FixedString256::new();
    report.push_str(FixedString256::from("Verification Report\n"));
    report.push_str(FixedString256::from("====================\n"));
    report.push_str(FixedString256::from("Status: "));
    report.push_str(container.status.name());
    report.push_str(FixedString256::from("\n"));
    report.push_str(FixedString256::from("Chain Length: "));
    report.push_u32(container.receipt_chain.length);
    report.push_str(FixedString256::from("\n"));
    report.push_str(FixedString256::from("Chain Valid: "));
    if container.receipt_chain.verify_chain() {
        report.push_str(FixedString256::from("yes\n"));
    } else {
        report.push_str(FixedString256::from("no\n"));
    }
    report.push_str(FixedString256::from("Signature Valid: "));
    let expected : u64 = SealedContainer::generate_signature(
        container.seal_hash, container.compilation_id,
    );
    if expected == container.signature {
        report.push_str(FixedString256::from("yes\n"));
    } else {
        report.push_str(FixedString256::from("no\n"));
    }
    report.push_str(FixedString256::from("Residuals: "));
    report.push_u32(container.residuals.len());
    report.push_str(FixedString256::from("\n"));
    report
}

/// Extract receipt chain from the sealer.
/// Effect: pure — extraction.
pub fn extract_chain(container : &SealedContainer) -> &ReceiptChain [pure] {
    &container.receipt_chain
}

/// Check if the sealer's container is ready for distribution.
/// Effect: pure — readiness check.
pub fn is_ready_for_distribution(container : &SealedContainer) -> bool [pure] {
    container.status == SealStatus::Valid
        && container.verified
        && container.seal_hash != 0u64
        && container.signature != 0u64
}

/// Get the binary size from the sealed container.
/// Effect: pure — size query.
pub fn binary_size(container : &SealedContainer) -> u64 [pure] {
container.binary.total_size
}

/// Validate that all expected phases are present in the seal.
/// Effect: pure — presence check.
pub fn validate_phase_presence(container : &SealedContainer) -> Result<(), FixedString256> [pure] {
let expected_phases : Array64<CompilerPhase> = Array64::new();
// Expected phases: Lexer, Parser, Expander, Lowerer, Optimizer, Codegen, Linker, Sealer
let _ = expected_phases;
// Bounded: at most 64 receipts.
for var i : u32 = 0u32; i < container.receipt_chain.length; i += 1u32 [container.receipt_chain.length] {
    let receipt : CompilerReceipt = container.receipt_chain.receipts.get(i);
    let phase : CompilerPhase = receipt.phase();
    // Verify phase is in expected order.
    if (phase as u8) != (i as u8) {
        var msg : FixedString256 = FixedString256::from("phase out of order at index ");
        msg.push_u32(i);
        return Result::Err(msg);
    }
}
Result::Ok(())
}

/// Strip residual diagnostics from a sealed container (for distribution).
/// Effect: pure — stripping.
pub fn strip_residuals(mut container : SealedContainer) -> SealedContainer [pure] {
container.residuals = Array256::new();
container
}

/// Create a minimal seal with only the essential receipts.
/// Effect: pure — minimal seal.
pub fn create_minimal_seal(
binary : LinkerOutput,
source_path : FixedString256,
compilation_id : u64,
) -> SealedContainer [pure] {
let container : SealedContainer = SealedContainer::new(binary, source_path, compilation_id);
container.seal()
}

// === Seal Integrity Check Suite ===

/// Run the full integrity check suite on a container.
/// Effect: pure — comprehensive suite.
pub fn run_integrity_suite(container : &SealedContainer) -> IntegrityReport [pure] {
var report : IntegrityReport = IntegrityReport::new();

// Check 1: Structural integrity.
report.structural_ok = quick_verify(container);

// Check 2: Chain integrity.
report.chain_ok = container.receipt_chain.verify_chain();

// Check 3: Signature integrity.
let expected_sig : u64 = generate_seal_signature(
    container.seal_hash, container.compilation_id,
);
report.signature_ok = expected_sig == container.signature;

// Check 4: Phase ordering.
report.phase_order_ok = validate_phase_presence(container).is_ok();

// Check 5: Residual validity.
report.residuals_ok = true;
// Bounded: at most 256 residuals.
for var i : u32 = 0u32; i < container.residuals.len() && i < 256u32; i += 1u32 [256u32] {
    let residual : DiagnosticPayload = container.residuals.get(i);
    if residual.severity != DiagnosticSeverity::Residual {
        report.residuals_ok = false;
        break;
    }
}

// Check 6: Binary non-empty.
report.binary_ok = container.binary.total_size > 0u64;

report.all_ok = report.structural_ok && report.chain_ok
    && report.signature_ok && report.phase_order_ok
    && report.residuals_ok && report.binary_ok;

report
}

pub struct IntegrityReport {
pub structural_ok : bool,
pub chain_ok : bool,
pub signature_ok : bool,
pub phase_order_ok : bool,
pub residuals_ok : bool,
pub binary_ok : bool,
pub all_ok : bool,
pub checks_passed : u32,
pub checks_total : u32,
}

impl IntegrityReport {
pub fn new() -> IntegrityReport [pure] {
    IntegrityReport {
        structural_ok: false,
        chain_ok: false,
        signature_ok: false,
        phase_order_ok: false,
        residuals_ok: false,
        binary_ok: false,
        all_ok: false,
        checks_passed: 0u32,
        checks_total: 6u32,
    }
}

pub fn format(&self) -> FixedString256 [io] {
    var r : FixedString256 = FixedString256::new();
    r.push_str(FixedString256::from("Integrity Report:\n"));
    r.push_str(FixedString256::from("  Structural: ")); r.push_str(if self.structural_ok { FixedString256::from("PASS") } else { FixedString256::from("FAIL") }); r.push_str(FixedString256::from("\n"));
    r.push_str(FixedString256::from("  Chain: ")); r.push_str(if self.chain_ok { FixedString256::from("PASS") } else { FixedString256::from("FAIL") }); r.push_str(FixedString256::from("\n"));
    r.push_str(FixedString256::from("  Signature: ")); r.push_str(if self.signature_ok { FixedString256::from("PASS") } else { FixedString256::from("FAIL") }); r.push_str(FixedString256::from("\n"));
    r.push_str(FixedString256::from("  Phase Order: ")); r.push_str(if self.phase_order_ok { FixedString256::from("PASS") } else { FixedString256::from("FAIL") }); r.push_str(FixedString256::from("\n"));
    r.push_str(FixedString256::from("  Residuals: ")); r.push_str(if self.residuals_ok { FixedString256::from("PASS") } else { FixedString256::from("FAIL") }); r.push_str(FixedString256::from("\n"));
    r.push_str(FixedString256::from("  Binary: ")); r.push_str(if self.binary_ok { FixedString256::from("PASS") } else { FixedString256::from("FAIL") }); r.push_str(FixedString256::from("\n"));
    r.push_str(FixedString256::from("  Overall: ")); r.push_str(if self.all_ok { FixedString256::from("PASS") } else { FixedString256::from("FAIL") }); r.push_str(FixedString256::from("\n"));
    r
}
}

// === Sealer Utility Functions ===

/// Generate a unique compilation ID from source path and timestamp.
/// Effect: pure — deterministic ID.
pub fn generate_compilation_id(source_path : FixedString256, timestamp : u64) -> u64 [pure] {
var id : u64 = 14695981039346656037u64;
// Bounded: at most 256 chars.
for var i : u32 = 0u32; i < source_path.len() && i < 256u32; i += 1u32 [256u32] {
    id ^= source_path.get_byte(i) as u64;
    id *= 1099511628211u64;
}
id ^= timestamp;
id *= 1099511628211u64;
id
}

/// Check if two containers have identical seal hashes.
/// Effect: pure — comparison.
pub fn seals_match(container_a : &SealedContainer, container_b : &SealedContainer) -> bool [pure] {
container_a.seal_hash == container_b.seal_hash
    && container_a.signature == container_b.signature
}

/// Determine if a sealed container needs re-sealing.
/// Effect: pure — staleness check.
pub fn needs_reseal(container : &SealedContainer, max_age : u64) -> bool [pure] {
// A container needs resealing if its compilation_id is too old.
container.compilation_id < max_age
    || container.status != SealStatus::Valid
}

/// Count the number of phases with errors in the sealed output.
/// Effect: pure — error counting.
pub fn count_phase_errors(container : &SealedContainer) -> u32 [pure] {
    var errors : u32 = 0u32;
    // Bounded: at most 256 residuals.
    for var i : u32 = 0u32; i < container.residuals.len(); i += 1u32 [container.residuals.len()] {
        let residual : DiagnosticPayload = container.residuals.get(i);
        if residual.severity == DiagnosticSeverity::Error {
            errors += 1u32;
        }
    }
    errors
}

// === Additional Sealer Operations ===

/// Extract the binary total size from a container.
pub fn get_binary_total_size(container : &SealedContainer) -> u64 [pure] {
    container.binary.total_size
}

/// Get the verified status of a container.
pub fn is_verified(container : &SealedContainer) -> bool [pure] {
    container.verified && container.status == SealStatus::Valid
}

/// Get the generation tag of a container.
pub fn get_generation(container : &SealedContainer) -> u64 [pure] {
    container.generation
}

/// Set a new generation tag on a container.
pub fn set_generation(mut container : SealedContainer, gen : u64) -> SealedContainer [pure] {
    container.generation = gen;
    container
}

/// Check if a container has any residual diagnostics.
pub fn has_residuals(container : &SealedContainer) -> bool [pure] {
    container.residuals.len() > 0u32
}

/// Get the source path from the container.
pub fn get_source_path(container : &SealedContainer) -> FixedString256 [pure] {
    container.source_path
}

/// Get the compilation ID.
pub fn get_compilation_id(container : &SealedContainer) -> u64 [pure] {
    container.compilation_id
}

/// Check if the container's seal algorithm is hash-based.
pub fn is_hash_based(container : &SealedContainer) -> bool [pure] {
    container.algorithm == SealAlgorithm::HashBased
}

/// Create a new empty container for gradual building.
pub fn new_empty(source_path : FixedString256, compilation_id : u64) -> SealedContainer [pure] {
    let binary : LinkerOutput = LinkerOutput::new(source_path);
    SealedContainer::new(binary, source_path, compilation_id)
}

/// Merge two containers, combining their receipt chains.
pub fn merge_containers(
    mut primary : SealedContainer,
    secondary : SealedContainer,
) -> SealedContainer [pure] {
    // Append secondary's receipts to primary's chain.
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < secondary.receipt_chain.length; i += 1u32 [secondary.receipt_chain.length] {
        let receipt : CompilerReceipt = secondary.receipt_chain.receipts.get(i);
        primary.receipt_chain = primary.receipt_chain.append(receipt);
    }
    // Merge residual diagnostics.
    // Bounded: at most 256 residuals.
    for var i : u32 = 0u32; i < secondary.residuals.len(); i += 1u32 [secondary.residuals.len()] {
        if primary.residuals.len() < primary.residuals.capacity() {
            let _ = primary.residuals.push(secondary.residuals.get(i));
        }
    }
    // Recompute the chain.
    primary.receipt_chain = primary.receipt_chain.compute_chain();
    primary.seal_hash = primary.receipt_chain.root_hash;
    primary.status = SealStatus::Unverified;
    primary.verified = false;
    primary
}

/// Finalize a container by sealing it.
pub fn finalize(mut container : SealedContainer) -> SealedContainer [pure] {
    container = container.seal();
    container = container.verify();
    container
}

/// Reset verification status to force re-verification.
pub fn reset_verification(mut container : SealedContainer) -> SealedContainer [pure] {
    container.status = SealStatus::Unverified;
    container.verified = false;
    container
}

/// Set the container's seal hash directly (for reconstruction).
pub fn set_seal_hash(mut container : SealedContainer, hash : u64) -> SealedContainer [pure] {
    container.seal_hash = hash;
    container
}

/// Check if the container is in a valid state for distribution.
pub fn distributable(container : &SealedContainer) -> bool [pure] {
    container.status == SealStatus::Valid
        && container.verified
        && container.seal_hash != 0u64
        && container.signature != 0u64
        && container.receipt_chain.length > 0u32
}

/// Get the container's verification confidence level.
pub fn confidence_level(container : &SealedContainer) -> u8 [pure] {
    if container.verified && container.status == SealStatus::Valid {
        255u8
    } else if container.status == SealStatus::Valid {
        192u8
    } else if container.status == SealStatus::Unverified {
        64u8
    } else {
        0u8
    }
}

// --- Sealer Query Functions ---

/// Get the receipt count from a container.
pub fn get_receipt_count(container : &SealedContainer) -> u32 [pure] {
    container.receipt_chain.length
}

/// Get the residual count from a container.
pub fn get_residual_count(container : &SealedContainer) -> u32 [pure] {
    container.residuals.len()
}

/// Get the root hash from a container.
pub fn get_root_hash(container : &SealedContainer) -> u64 [pure] {
    container.seal_hash
}

/// Check if the container is sealed.
pub fn is_sealed(container : &SealedContainer) -> bool [pure] {
    container.seal_hash != 0u64 && container.signature != 0u64
}

/// Validate that the container's binary has content.
pub fn has_binary_content(container : &SealedContainer) -> bool [pure] {
    container.binary.total_size > 0u64
}

/// Get the algorithm name used for sealing.
pub fn algorithm_name(container : &SealedContainer) -> FixedString256 [pure] {
    match container.algorithm {
        SealAlgorithm::HashBased => FixedString256::from("hash-based"),
        SealAlgorithm::MerkleTree => FixedString256::from("merkle-tree"),
    }
}

/// Check if the seal uses Merkle tree sealing.
pub fn is_merkle_sealed(container : &SealedContainer) -> bool [pure] {
    container.algorithm == SealAlgorithm::MerkleTree
}

/// Count the number of phases present in the container.
pub fn phase_count(container : &SealedContainer) -> u32 [pure] {
    container.receipt_chain.length
}

/// Check if all 8 standard phases are present.
pub fn has_all_phases(container : &SealedContainer) -> bool [pure] {
    container.receipt_chain.length >= 8u32
}

/// Check if the pre-compile phase is present.
pub fn has_precompile_phase(container : &SealedContainer) -> bool [pure] {
    // Pre-compile would be the first receipt if present.
    container.receipt_chain.length >= 9u32
}

/// Extract a phase name from a sealed container at a given index.
pub fn phase_name_at(container : &SealedContainer, index : u32) -> FixedString256 [pure] {
    if index < container.receipt_chain.length {
        let receipt : CompilerReceipt = container.receipt_chain.receipts.get(index);
        receipt.phase().name()
    } else {
        FixedString256::from("<invalid>")
    }
}

/// Format the entire sealed container as a single-line digest.
pub fn format_digest(container : &SealedContainer) -> FixedString256 [io] {
    var d : FixedString256 = FixedString256::new();
    d.push_str(FixedString256::from("Seal["));
    d.push_str(container.source_path);
    d.push_str(FixedString256::from("#"));
    d.push_u64(container.compilation_id);
    d.push_str(FixedString256::from(" hash=0x"));
    d.push_u64(container.seal_hash);
    d.push_str(FixedString256::from(" "));
    d.push_str(container.status.name());
    d.push_str(FixedString256::from(" phases="));
    d.push_u32(container.receipt_chain.length);
    d.push_str(FixedString256::from(" residuals="));
    d.push_u32(container.residuals.len());
    d.push_str(FixedString256::from("]"));
    d
}

/// Get the seal status as a string.
pub fn seal_status_string(container : &SealedContainer) -> FixedString256 [pure] {
    container.status.name()
}

/// Check if the container was verified successfully.
pub fn verification_passed(container : &SealedContainer) -> bool [pure] {
    container.status == SealStatus::Valid && container.verified
}

/// Get the binary section count.
pub fn binary_section_count(container : &SealedContainer) -> u32 [pure] {
    container.binary.sections.len()
}

/// Get the binary symbol count.
pub fn binary_symbol_count(container : &SealedContainer) -> u32 [pure] {
    container.binary.symbols.len()
}

/// Check if the container has any relocations remaining.
pub fn has_pending_relocations(container : &SealedContainer) -> bool [pure] {
    container.binary.relocations.len() > 0u32
}

/// Create a sealed container from a pre-assembled receipt chain.
pub fn from_chain(
    binary : LinkerOutput,
    source_path : FixedString256,
    compilation_id : u64,
    chain : ReceiptChain,
) -> SealedContainer [pure] {
    let mut container : SealedContainer = SealedContainer::new(binary, source_path, compilation_id);
    container.receipt_chain = chain;
    container = container.seal();
    container
}

/// Get the raw bytes of a specific section by index.
pub fn get_section_data(container : &SealedContainer, index : u32) -> Array256<u8> [pure] {
    if index < container.binary.sections.len() {
        container.binary.sections.get(index).data
    } else {
        Array256::new()
    }
}

/// Check if the container was compiled with all safety attributes.
pub fn has_safety_guarantees(container : &SealedContainer) -> bool [pure] {
    container.status == SealStatus::Valid
        && container.verified
        && container.seal_hash != 0u64
        && container.receipt_chain.verify_chain()
}

/// Determine if the seal is suitable for production deployment.
pub fn is_production_ready(container : &SealedContainer) -> bool [pure] {
    container.status == SealStatus::Valid
        && container.verified
        && container.seal_hash != 0u64
        && container.signature != 0u64
        && container.receipt_chain.length >= 8u32
        && container.binary.total_size > 0u64
}

/// Count the total number of diagnostics across all phases.
pub fn total_diagnostics_in_container(container : &SealedContainer) -> u32 [pure] {
    var count : u32 = container.residuals.len();
    count
}

/// Get the signature type description.
pub fn signature_type(container : &SealedContainer) -> FixedString256 [pure] {
    FixedString256::from("FNV-1a") // Deterministic hash-based signature
}

/// Check if the container is self-consistent.
pub fn is_self_consistent(container : &SealedContainer) -> bool [pure] {
    quick_verify(container) && container.receipt_chain.verify_chain()
}

/// Get the estimated verification time.
pub fn estimated_verification_time(container : &SealedContainer) -> u32 [pure] {
    // Approximately 1us per receipt + 5us per residual
    (container.receipt_chain.length * 1u32) + (container.residuals.len() * 5u32 / 100u32)
}

/// Get the container format version.
pub fn container_format_version() -> u8 [pure] {
    1u8
}

/// Check if the container format is compatible with the current compiler.
pub fn format_compatible(container : &SealedContainer) -> bool [pure] {
    container.algorithm == SealAlgorithm::HashBased
        || container.algorithm == SealAlgorithm::MerkleTree
}

/// Recompute the seal hash from the receipt chain without modifying the container.
pub fn recompute_seal_hash(container : &SealedContainer) -> u64 [pure] {
    container.receipt_chain.root_hash
}

/// Get the number of trusted blocks recorded in the seal.
pub fn trusted_block_count(container : &SealedContainer) -> u32 [pure] {
    var count : u32 = 0u32;
    for var i : u32 = 0u32; i < container.residuals.len(); i += 1u32 [container.residuals.len()] {
        let diag : DiagnosticPayload = container.residuals.get(i);
        if diag.code == DiagnosticCode::LowerUnsafeBlockWithoutRationale {
            count += 1u32;
        }
    }
    count
}

/// Check if the seal passes a quick sanity check.
pub fn sanity_check(container : &SealedContainer) -> bool [pure] {
    container.source_path.len() > 0u32
        && container.compilation_id > 0u64
        && container.seal_hash != 0u64
        && container.signature != 0u64
}

/// Get the compiler version from the seal.
pub fn compiler_version() -> FixedString256 [pure] {
    FixedString256::from("Phorensic v0.1.0")
}

/// Determine if the binary in the container is executable.
pub fn is_executable(output : &LinkerOutput) -> bool [pure] {
    output.sections.len() > 0u32 && output.entry_point > 0u64
}

/// Extract the receipt for a specific compiler phase.
pub fn extract_phase_receipt(
    container : &SealedContainer, phase : CompilerPhase,
) -> Option<CompilerReceipt> [pure] {
    for var i : u32 = 0u32; i < container.receipt_chain.length; i += 1u32 [container.receipt_chain.length] {
        let receipt : CompilerReceipt = container.receipt_chain.receipts.get(i);
        if receipt.phase() == phase {
            return Option::Some(receipt);
        }
    }
    Option::None
}

/// Get the number of errors recorded across all phases.
pub fn total_error_count(container : &SealedContainer) -> u32 [pure] {
    var count : u32 = 0u32;
    for var i : u32 = 0u32; i < container.residuals.len(); i += 1u32 [container.residuals.len()] {
        if container.residuals.get(i).severity == DiagnosticSeverity::Error {
            count += 1u32;
        }
    }
    count
}

/// Get the number of warnings recorded across all phases.
pub fn total_warning_count(container : &SealedContainer) -> u32 [pure] {
    var count : u32 = 0u32;
    for var i : u32 = 0u32; i < container.residuals.len(); i += 1u32 [container.residuals.len()] {
        if container.residuals.get(i).severity == DiagnosticSeverity::Warning {
            count += 1u32;
        }
    }
    count
}

/// Get the number of notes in the residuals.
pub fn total_note_count(container : &SealedContainer) -> u32 [pure] {
    var count : u32 = 0u32;
    for var i : u32 = 0u32; i < container.residuals.len(); i += 1u32 [container.residuals.len()] {
        if container.residuals.get(i).severity == DiagnosticSeverity::Note {
            count += 1u32;
        }
    }
    count
}

/// Get the number of residuals (informational).
pub fn total_residual_count(container : &SealedContainer) -> u32 [pure] {
    container.residuals.len()
}

/// Check if the container contains any diagnostics at all.
pub fn has_diagnostics(container : &SealedContainer) -> bool [pure] {
    container.residuals.len() > 0u32
}

/// Get the container's signature as a formatted hex string.
pub fn signature_as_hex(container : &SealedContainer) -> FixedString256 [io] {
    var s : FixedString256 = FixedString256::new();
    s.push_str(FixedString256::from("0x"));
    s.push_u64(container.signature);
    s
}

/// Get the container's seal hash as a formatted hex string.
pub fn seal_hash_as_hex(container : &SealedContainer) -> FixedString256 [io] {
    var s : FixedString256 = FixedString256::new();
    s.push_str(FixedString256::from("0x"));
    s.push_u64(container.seal_hash);
    s
}
