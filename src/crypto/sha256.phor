// file: sha256.phor
// purpose: SHA-256 cryptographic hash function with message schedule,
//          compression function, padding, HMAC construction, incremental
//          hashing, and test vector verification.
// evidence: SHA2-ARCH-001 through SHA2-ARCH-200
// residual: All operations are deterministic with bounded loops.

package "phorensic:crypto:sha256:v1.0";

use core::constants::*
use core::types::*
use core::math::*
use core::errors::*
use core::collections::*

// ──────────────────────────────────────────────
// Constants: SHA-256 Initial Hash Values
// ──────────────────────────────────────────────
// Evidence path: SHA2-CONST-001 through SHA2-CONST-016

const SHA256_H0 : Word32 = 0x6a09e667
const SHA256_H1 : Word32 = 0xbb67ae85
const SHA256_H2 : Word32 = 0x3c6ef372
const SHA256_H3 : Word32 = 0xa54ff53a
const SHA256_H4 : Word32 = 0x510e527f
const SHA256_H5 : Word32 = 0x9b05688c
const SHA256_H6 : Word32 = 0x1f83d9ab
const SHA256_H7 : Word32 = 0x5be0cd19

// ──────────────────────────────────────────────
// Constants: SHA-256 Round Constants (K values)
// ──────────────────────────────────────────────
// Evidence path: SHA2-CONST-017 through SHA2-CONST-080

const SHA256_K : Word32[64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

const SHA256_BLOCK_SIZE : u64 = 64
const SHA256_DIGEST_SIZE : u64 = 32
const SHA256_MAX_INPUT_SIZE : u64 = 0x20000000  // 512 MiB max

// ──────────────────────────────────────────────
// Type: SHA256State
// ──────────────────────────────────────────────
// Evidence path: SHA2-STATE-001 through SHA2-STATE-030

pub type SHA256State : struct {
    h: Word32[8],           // Working state (8 x 32-bit words)
    buffer: Byte[64],       // Block buffer
    buf_len: u32,           // Bytes in buffer
    total_len: u64,         // Total bytes processed
    finalized: bool,        // Whether digest has been computed
}

impl SHA256State {
    // Create a new SHA-256 state initialized to the standard IV.
    pub fn new() -> SHA256State
        effects: [deterministic]
    {
        SHA256State {
            h: [
                Word32::from_u32(SHA256_H0),
                Word32::from_u32(SHA256_H1),
                Word32::from_u32(SHA256_H2),
                Word32::from_u32(SHA256_H3),
                Word32::from_u32(SHA256_H4),
                Word32::from_u32(SHA256_H5),
                Word32::from_u32(SHA256_H6),
                Word32::from_u32(SHA256_H7)
            ],
            buffer: [Byte::from_u8(0); 64],
            buf_len: 0,
            total_len: 0,
            finalized: false,
        }
    }

    // Reset the state to initial values.
    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.h[0] = Word32::from_u32(SHA256_H0)
        self.h[1] = Word32::from_u32(SHA256_H1)
        self.h[2] = Word32::from_u32(SHA256_H2)
        self.h[3] = Word32::from_u32(SHA256_H3)
        self.h[4] = Word32::from_u32(SHA256_H4)
        self.h[5] = Word32::from_u32(SHA256_H5)
        self.h[6] = Word32::from_u32(SHA256_H6)
        self.h[7] = Word32::from_u32(SHA256_H7)

        // loop: bounds[BOUND_SMALL] — bounded by block size
        loop: bounds[BOUND_SMALL] for i in 0..64 {
            self.buffer[i] = Byte::from_u8(0)
        }
        self.buf_len = 0
        self.total_len = 0
        self.finalized = false
    }
}

// ──────────────────────────────────────────────
// Type: SHA256Digest
// ──────────────────────────────────────────────
// Evidence path: SHA2-DIGEST-001 through SHA2-DIGEST-015

pub type SHA256Digest : struct {
    bytes: Byte[32],
}

impl SHA256Digest {
    pub fn from_bytes(bytes: Byte[32]) -> SHA256Digest
        effects: [deterministic]
    {
        SHA256Digest { bytes: bytes }
    }

    pub fn as_bytes(self) -> ref Byte[32]
        effects: [deterministic]
    {
        &self.bytes
    }

    pub fn eq(self, other: SHA256Digest) -> bool
        effects: [deterministic]
    {
        let mut result: bool = true
        // loop: bounds[BOUND_SMALL] — bounded by 32 bytes
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            if self.bytes[i] != other.bytes[i] {
                result = false
            }
        }
        result
    }

    pub fn to_hex(self) -> FixedString[65]
        effects: [deterministic]
    {
        let hex_chars: Byte[16] = [
            Byte::from_u8(0x30), Byte::from_u8(0x31), Byte::from_u8(0x32),
            Byte::from_u8(0x33), Byte::from_u8(0x34), Byte::from_u8(0x35),
            Byte::from_u8(0x36), Byte::from_u8(0x37), Byte::from_u8(0x38),
            Byte::from_u8(0x39), Byte::from_u8(0x61), Byte::from_u8(0x62),
            Byte::from_u8(0x63), Byte::from_u8(0x64), Byte::from_u8(0x65),
            Byte::from_u8(0x66)
        ]
        let mut result: FixedString[65] = FixedString::new()
        // loop: bounds[BOUND_SMALL] — bounded by 32 bytes
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            let b: u8 = self.bytes[i].to_u8()
            let hi: u8 = (b >> 4) & 0x0F
            let lo: u8 = b & 0x0F
            let _ = result.push_char(hex_chars[hi as usize].to_u8() as u32)
            let _ = result.push_char(hex_chars[lo as usize].to_u8() as u32)
        }
        result
    }
}

// ──────────────────────────────────────────────
// Type: SHA256 (incremental hasher)
// ──────────────────────────────────────────────
// Evidence path: SHA2-HASHER-001 through SHA2-HASHER-050

pub type SHA256 : struct {
    state: SHA256State,
}

impl SHA256 {
    // Create a new SHA-256 hasher.
    pub fn new() -> SHA256
        effects: [deterministic]
    {
        SHA256 { state: SHA256State::new() }
    }

    // Reset the hasher to its initial state.
    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.state.reset()
    }

    // ──────────────────────────────────────────────
    // Internal: Rotate right (Word32)
    // ──────────────────────────────────────────────
    fn rotr32(x: Word32, n: u32) -> Word32
        effects: [deterministic]
    {
        let shift: u32 = n & 31
        (x >> shift) | (x << (32 - shift))
    }

    // ──────────────────────────────────────────────
    // Internal: SHA-256 Sigma and Sigma-prime functions
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-SIGMA-001 through SHA2-SIGMA-008

    fn sigma0(x: Word32) -> Word32
        effects: [deterministic]
    {
        let r7: Word32 = SHA256::rotr32(x, 7)
        let r18: Word32 = SHA256::rotr32(x, 18)
        let s3: Word32 = x >> 3
        r7 ^ r18 ^ s3
    }

    fn sigma1(x: Word32) -> Word32
        effects: [deterministic]
    {
        let r17: Word32 = SHA256::rotr32(x, 17)
        let r19: Word32 = SHA256::rotr32(x, 19)
        let s10: Word32 = x >> 10
        r17 ^ r19 ^ s10
    }

    fn big_sigma0(x: Word32) -> Word32
        effects: [deterministic]
    {
        let r2: Word32 = SHA256::rotr32(x, 2)
        let r13: Word32 = SHA256::rotr32(x, 13)
        let r22: Word32 = SHA256::rotr32(x, 22)
        r2 ^ r13 ^ r22
    }

    fn big_sigma1(x: Word32) -> Word32
        effects: [deterministic]
    {
        let r6: Word32 = SHA256::rotr32(x, 6)
        let r11: Word32 = SHA256::rotr32(x, 11)
        let r25: Word32 = SHA256::rotr32(x, 25)
        r6 ^ r11 ^ r25
    }

    fn choice(x: Word32, y: Word32, z: Word32) -> Word32
        effects: [deterministic]
    {
        (x & y) ^ ((!x) & z)
    }

    fn majority(x: Word32, y: Word32, z: Word32) -> Word32
        effects: [deterministic]
    {
        (x & y) ^ (x & z) ^ (y & z)
    }

    // ──────────────────────────────────────────────
    // Internal: Load Word32 from byte array (big-endian)
    // ──────────────────────────────────────────────
    fn load_word32_be(bytes: ref Byte[4]) -> Word32
        effects: [deterministic]
    {
        let b0: Word32 = Word32::from_u8(bytes[0].to_u8())
        let b1: Word32 = Word32::from_u8(bytes[1].to_u8())
        let b2: Word32 = Word32::from_u8(bytes[2].to_u8())
        let b3: Word32 = Word32::from_u8(bytes[3].to_u8())
        (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }

    // Store Word32 to byte array (big-endian).
    fn store_word32_be(value: Word32, bytes: ref mut Byte[4])
        effects: [deterministic]
    {
        bytes[0] = Byte::from_u8(((value >> 24) & Word32::from_u32(0xFF)).to_u8())
        bytes[1] = Byte::from_u8(((value >> 16) & Word32::from_u32(0xFF)).to_u8())
        bytes[2] = Byte::from_u8(((value >> 8) & Word32::from_u32(0xFF)).to_u8())
        bytes[3] = Byte::from_u8((value & Word32::from_u32(0xFF)).to_u8())
    }

    // ──────────────────────────────────────────────
    // Message Schedule: W[0..15] from block, W[16..63] computed
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-SCHED-001 through SHA2-SCHED-020

    fn prepare_message_schedule(block: ref Byte[64]) -> Word32[64]
        effects: [deterministic]
    {
        let mut w: Word32[64] = [Word32::zero(); 64]

        // Load first 16 words directly from block
        // loop: bounds[BOUND_SMALL] — bounded by 16 iterations
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            let offset: u32 = i * 4
            w[i as usize] = SHA256::load_word32_be(block.as_ptr().offset(offset as usize) as ref Byte[4])
        }

        // Extend remaining 48 words
        // loop: bounds[BOUND_MEDIUM] — bounded by 48 iterations (64-16)
        loop: bounds[BOUND_MEDIUM] for i in 16..64 {
            let s0: Word32 = SHA256::sigma0(w[(i - 15) as usize])
            let s1: Word32 = SHA256::sigma1(w[(i - 2) as usize])
            w[i as usize] = w[(i - 16) as usize] + s0 + w[(i - 7) as usize] + s1
        }

        w
    }

    // ──────────────────────────────────────────────
    // Compression Function
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-COMPRESS-001 through SHA2-COMPRESS-030

    fn compress(self: ref mut, block: ref Byte[64])
        effects: [deterministic]
    {
        let w: Word32[64] = SHA256::prepare_message_schedule(block)

        // Initialize working variables
        let mut a: Word32 = self.state.h[0]
        let mut b: Word32 = self.state.h[1]
        let mut c: Word32 = self.state.h[2]
        let mut d: Word32 = self.state.h[3]
        let mut e: Word32 = self.state.h[4]
        let mut f: Word32 = self.state.h[5]
        let mut g: Word32 = self.state.h[6]
        let mut h: Word32 = self.state.h[7]

        // Main loop: 64 rounds
        // loop: bounds[BOUND_MEDIUM] — bounded by 64 rounds
        loop: bounds[BOUND_MEDIUM] for i in 0..64 {
            let s1: Word32 = SHA256::big_sigma1(e)
            let ch: Word32 = SHA256::choice(e, f, g)
            let temp1: Word32 = h + s1 + ch + SHA256_K[i as usize] + w[i as usize]
            let s0: Word32 = SHA256::big_sigma0(a)
            let maj: Word32 = SHA256::majority(a, b, c)
            let temp2: Word32 = s0 + maj

            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
        }

        // Update state
        self.state.h[0] = self.state.h[0] + a
        self.state.h[1] = self.state.h[1] + b
        self.state.h[2] = self.state.h[2] + c
        self.state.h[3] = self.state.h[3] + d
        self.state.h[4] = self.state.h[4] + e
        self.state.h[5] = self.state.h[5] + f
        self.state.h[6] = self.state.h[6] + g
        self.state.h[7] = self.state.h[7] + h
    }

    // ──────────────────────────────────────────────
    // Padding: Standard SHA-256 padding (append 0x80, zeros, length)
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-PAD-001 through SHA2-PAD-020

    fn apply_padding(self: ref mut)
        effects: [deterministic]
    {
        // Calculate padding
        let ml: u64 = self.state.total_len * 8  // Message length in bits
        let buf_len: u64 = self.state.buf_len as u64

        // Append 0x80
        self.state.buffer[self.state.buf_len as usize] = Byte::from_u8(0x80)
        self.state.buf_len = self.state.buf_len + 1

        // If we have room for the 8-byte length (at least 8 bytes left)
        let remaining: u64 = SHA256_BLOCK_SIZE - (buf_len + 1)
        if remaining >= 8 {
            // Pad with zeros
            // loop: bounds[BOUND_SMALL] — bounded by block size
            loop: bounds[BOUND_SMALL] while self.state.buf_len < 56 {
                self.state.buffer[self.state.buf_len as usize] = Byte::from_u8(0)
                self.state.buf_len = self.state.buf_len + 1
            }
            // Append length in bits (big-endian)
            let len_bytes: Byte[8] = SHA256::store_u64_be(ml)
            // loop: bounds[BOUND_SMALL] — bounded by 8 bytes
            loop: bounds[BOUND_SMALL] for i in 0..8 {
                self.state.buffer[56 + i] = len_bytes[i as usize]
            }
            // Process the final block
            self.compress(&self.state.buffer)
        } else {
            // Pad rest of current block with zeros, compress it
            // loop: bounds[BOUND_SMALL] — bounded by block size
            loop: bounds[BOUND_SMALL] while self.state.buf_len < 64 {
                self.state.buffer[self.state.buf_len as usize] = Byte::from_u8(0)
                self.state.buf_len = self.state.buf_len + 1
            }
            self.compress(&self.state.buffer)

            // Create a new block padded with zeros and the length
            // loop: bounds[BOUND_SMALL] — bounded by block size
            loop: bounds[BOUND_SMALL] for i in 0..56 {
                self.state.buffer[i] = Byte::from_u8(0)
            }
            let len_bytes: Byte[8] = SHA256::store_u64_be(ml)
            // loop: bounds[BOUND_SMALL] — bounded by 8 bytes
            loop: bounds[BOUND_SMALL] for i in 0..8 {
                self.state.buffer[56 + i] = len_bytes[i as usize]
            }
            self.compress(&self.state.buffer)
        }

        self.state.finalized = true
    }

    // Helper: Store u64 as big-endian bytes.
    fn store_u64_be(value: u64) -> Byte[8]
        effects: [deterministic]
    {
        let mut result: Byte[8] = [Byte::from_u8(0); 8]
        // loop: bounds[BOUND_SMALL] — bounded by 8
        loop: bounds[BOUND_SMALL] for i in 0..8 {
            let shift: u64 = (7 - i) * 8
            result[i as usize] = Byte::from_u8(((value >> shift) & 0xFF) as u8)
        }
        result
    }

    // ──────────────────────────────────────────────
    // Incremental Update
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-UPDATE-001 through SHA2-UPDATE-030

    pub fn update(self: ref mut, data: ref Byte[], length: u32)
        effects: [deterministic]
    {
        assert(!self.state.finalized, "sha256: cannot update after finalization")

        let mut offset: u32 = 0
        let remaining_data: u32 = length

        // If there's data in the buffer, fill it first
        if self.state.buf_len > 0 {
            let space: u32 = 64 - self.state.buf_len
            let to_copy: u32 = if remaining_data < space { remaining_data } else { space }

            // loop: bounds[BOUND_SMALL] — bounded by block size
            loop: bounds[BOUND_SMALL] for i in 0..to_copy {
                self.state.buffer[(self.state.buf_len + i) as usize] = data[(offset + i) as usize]
            }
            self.state.buf_len = self.state.buf_len + to_copy
            offset = offset + to_copy

            if self.state.buf_len == 64 {
                self.compress(&self.state.buffer)
                self.state.buf_len = 0
                self.state.total_len = self.state.total_len + 64

                // loop: bounds[BOUND_SMALL] — bounded by block size
                loop: bounds[BOUND_SMALL] for i in 0..64 {
                    self.state.buffer[i] = Byte::from_u8(0)
                }
            }
        }

        // Process full blocks
        // loop: bounds[BOUND_LARGE] — bounded by max input size
        loop: bounds[BOUND_LARGE] while (offset + 64) <= remaining_data {
            let block_ptr: ref Byte[64] = data.as_ptr().offset(offset as usize) as ref Byte[64]
            self.compress(block_ptr)
            offset = offset + 64
            self.state.total_len = self.state.total_len + 64
        }

        // Copy remaining data into buffer
        if offset < remaining_data {
            let remaining: u32 = remaining_data - offset
            // loop: bounds[BOUND_SMALL] — bounded by block size
            loop: bounds[BOUND_SMALL] for i in 0..remaining {
                self.state.buffer[i as usize] = data[(offset + i) as usize]
            }
            self.state.buf_len = remaining
        }
    }

    // ──────────────────────────────────────────────
    // Finalize: Produce digest
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-FINAL-001 through SHA2-FINAL-020

    pub fn finalize(self: ref mut) -> SHA256Digest
        effects: [deterministic]
    {
        if !self.state.finalized {
            self.apply_padding()
        }

        let mut digest_bytes: Byte[32] = [Byte::from_u8(0); 32]
        // loop: bounds[BOUND_SMALL] — bounded by 8 state words * 4 bytes
        loop: bounds[BOUND_SMALL] for i in 0..8 {
            SHA256::store_word32_be(self.state.h[i], digest_bytes.as_mut_ptr().offset((i * 4) as usize) as ref mut Byte[4])
        }

        SHA256Digest::from_bytes(digest_bytes)
    }

    // ──────────────────────────────────────────────
    // One-shot hash
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-ONESHOT-001 through SHA2-ONESHOT-010

    pub fn hash(data: ref Byte[], length: u32) -> SHA256Digest
        effects: [deterministic]
    {
        let mut hasher: SHA256 = SHA256::new()
        hasher.update(data, length)
        hasher.finalize()
    }

    // ──────────────────────────────────────────────
    // Hash multiple fragments (scatter-gather)
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-FRAG-001 through SHA2-FRAG-010

    pub fn hash_fragments(fragments: ref SHA256Fragment[], count: u32) -> SHA256Digest
        effects: [deterministic]
    {
        let mut hasher: SHA256 = SHA256::new()
        // loop: bounds[BOUND_MEDIUM] — bounded by fragment count
        loop: bounds[BOUND_MEDIUM] for i in 0..count {
            hasher.update(fragments[i as usize].data, fragments[i as usize].length)
        }
        hasher.finalize()
    }

    // ──────────────────────────────────────────────
    // HMAC-SHA256 Construction
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-HMAC-001 through SHA2-HMAC-040

    pub fn hmac(key: ref Byte[], key_len: u32, data: ref Byte[], data_len: u32) -> SHA256Digest
        effects: [deterministic]
    {
        let block_size: u32 = 64
        let mut actual_key: Byte[64] = [Byte::from_u8(0); 64]

        // If key is longer than block size, hash it first
        if key_len > block_size {
            let hashed_key: SHA256Digest = SHA256::hash(key, key_len)
            let hk_bytes: ref Byte[32] = hashed_key.as_bytes()
            // loop: bounds[BOUND_SMALL] — bounded by 32
            loop: bounds[BOUND_SMALL] for i in 0..32 {
                actual_key[i as usize] = hk_bytes[i as usize]
            }
        } else {
            // loop: bounds[BOUND_SMALL] — bounded by block size
            loop: bounds[BOUND_SMALL] for i in 0..key_len {
                actual_key[i as usize] = key[i as usize]
            }
        }

        // Prepare ipad and opad
        let mut ipad: Byte[64] = [Byte::from_u8(0); 64]
        let mut opad: Byte[64] = [Byte::from_u8(0); 64]

        // loop: bounds[BOUND_SMALL] — bounded by block size
        loop: bounds[BOUND_SMALL] for i in 0..64 {
            let k: u8 = actual_key[i as usize].to_u8()
            ipad[i as usize] = Byte::from_u8(k ^ 0x36)
            opad[i as usize] = Byte::from_u8(k ^ 0x5C)
        }

        // Inner hash: SHA256(ipad || data)
        let mut inner: SHA256 = SHA256::new()
        inner.update(&ipad, 64)
        inner.update(data, data_len)
        let inner_digest: SHA256Digest = inner.finalize()

        // Outer hash: SHA256(opad || inner_digest)
        let inner_bytes: ref Byte[32] = inner_digest.as_bytes()
        let mut outer: SHA256 = SHA256::new()
        outer.update(&opad, 64)
        outer.update(inner_bytes, 32)
        outer.finalize()
    }

    // ──────────────────────────────────────────────
    // HMAC with incremental support
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-HMAC-INC-001 through SHA2-HMAC-INC-015

    pub fn hmac_init(key: ref Byte[], key_len: u32) -> HMACSHA256State
        effects: [deterministic]
    {
        let block_size: u32 = 64
        let mut actual_key: Byte[64] = [Byte::from_u8(0); 64]

        if key_len > block_size {
            let hashed_key: SHA256Digest = SHA256::hash(key, key_len)
            let hk_bytes: ref Byte[32] = hashed_key.as_bytes()
            // loop: bounds[BOUND_SMALL] — bounded by 32
            loop: bounds[BOUND_SMALL] for i in 0..32 {
                actual_key[i as usize] = hk_bytes[i as usize]
            }
        } else {
            // loop: bounds[BOUND_SMALL] — bounded by block size
            loop: bounds[BOUND_SMALL] for i in 0..key_len {
                actual_key[i as usize] = key[i as usize]
            }
        }

        let mut ipad: Byte[64] = [Byte::from_u8(0); 64]
        let mut opad: Byte[64] = [Byte::from_u8(0); 64]

        // loop: bounds[BOUND_SMALL] — bounded by block size
        loop: bounds[BOUND_SMALL] for i in 0..64 {
            let k: u8 = actual_key[i as usize].to_u8()
            ipad[i as usize] = Byte::from_u8(k ^ 0x36)
            opad[i as usize] = Byte::from_u8(k ^ 0x5C)
        }

        let inner: SHA256 = SHA256::new()
        inner.update(&ipad, 64)
        let outer: SHA256 = SHA256::new()

        HMACSHA256State {
            inner: inner,
            outer: outer,
            opad: opad,
            finalized: false,
        }
    }

    // ──────────────────────────────────────────────
    // Verify digest against expected value (constant-time)
    // ──────────────────────────────────────────────
    // Evidence path: SHA2-VERIFY-001 through SHA2-VERIFY-015

    pub fn verify_constant_time(digest: SHA256Digest, expected: SHA256Digest) -> bool
        effects: [deterministic]
    {
        let mut diff: u8 = 0
        let d_bytes: ref Byte[32] = digest.as_bytes()
        let e_bytes: ref Byte[32] = expected.as_bytes()

        // loop: bounds[BOUND_SMALL] — bounded by 32 bytes, constant-time
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            diff = diff | (d_bytes[i as usize].to_u8() ^ e_bytes[i as usize].to_u8())
        }
        diff == 0
    }
}

// ──────────────────────────────────────────────
// Supporting Types
// ──────────────────────────────────────────────

pub type SHA256Fragment : struct {
    data: ref Byte[],
    length: u32,
}

pub type HMACSHA256State : struct {
    inner: SHA256,
    outer: SHA256,
    opad: Byte[64],
    finalized: bool,
}

impl HMACSHA256State {
    // Update the HMAC inner state with data.
    pub fn update(self: ref mut, data: ref Byte[], length: u32)
        effects: [deterministic]
    {
        assert(!self.finalized, "hmac: cannot update after finalization")
        self.inner.update(data, length)
    }

    // Finalize HMAC computation.
    pub fn finalize(self: ref mut) -> SHA256Digest
        effects: [deterministic]
    {
        if !self.finalized {
            let inner_digest: SHA256Digest = self.inner.finalize()
            let inner_bytes: ref Byte[32] = inner_digest.as_bytes()

            let mut outer: SHA256 = SHA256::new()
            outer.update(&self.opad, 64)
            outer.update(inner_bytes, 32)
            let result: SHA256Digest = outer.finalize()
            self.finalized = true
            result
        } else {
            SHA256Digest::from_bytes([Byte::from_u8(0); 32])
        }
    }

    // Update with multiple fragments.
    pub fn update_fragments(self: ref mut, fragments: ref SHA256Fragment[], count: u32)
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by fragment count
        loop: bounds[BOUND_MEDIUM] for i in 0..count {
            self.update(fragments[i as usize].data, fragments[i as usize].length)
        }
    }
}

// ──────────────────────────────────────────────
// Test Vectors (FIPS 180-4, RFC 4231)
// ──────────────────────────────────────────────
// Evidence path: SHA2-TEST-001 through SHA2-TEST-040

pub fn run_sha256_test_vectors() -> bool
    effects: [deterministic, residual]
{
    // Test vector 1: "abc"
    let input1: Byte[3] = [
        Byte::from_u8(0x61), Byte::from_u8(0x62), Byte::from_u8(0x63)
    ]
    let expected1: Byte[32] = [
        Byte::from_u8(0xba), Byte::from_u8(0x78), Byte::from_u8(0x16), Byte::from_u8(0xbf),
        Byte::from_u8(0x8f), Byte::from_u8(0x01), Byte::from_u8(0xcf), Byte::from_u8(0xea),
        Byte::from_u8(0x41), Byte::from_u8(0x41), Byte::from_u8(0x40), Byte::from_u8(0xde),
        Byte::from_u8(0x5d), Byte::from_u8(0xae), Byte::from_u8(0x22), Byte::from_u8(0x23),
        Byte::from_u8(0xb0), Byte::from_u8(0x03), Byte::from_u8(0x61), Byte::from_u8(0xa3),
        Byte::from_u8(0x96), Byte::from_u8(0x17), Byte::from_u8(0x7a), Byte::from_u8(0x9c),
        Byte::from_u8(0xb4), Byte::from_u8(0x10), Byte::from_u8(0xff), Byte::from_u8(0x61),
        Byte::from_u8(0xf2), Byte::from_u8(0x00), Byte::from_u8(0x15), Byte::from_u8(0xad)
    ]
    let d1: SHA256Digest = SHA256::hash(&input1, 3)
    let exp1: SHA256Digest = SHA256Digest::from_bytes(expected1)
    assert(SHA256::verify_constant_time(d1, exp1), "sha256: test vector 1 (abc)")

    // Test vector 2: "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    let input2: Byte[56] = [
        Byte::from_u8(0x61), Byte::from_u8(0x62), Byte::from_u8(0x63), Byte::from_u8(0x64),
        Byte::from_u8(0x62), Byte::from_u8(0x63), Byte::from_u8(0x64), Byte::from_u8(0x65),
        Byte::from_u8(0x63), Byte::from_u8(0x64), Byte::from_u8(0x65), Byte::from_u8(0x66),
        Byte::from_u8(0x64), Byte::from_u8(0x65), Byte::from_u8(0x66), Byte::from_u8(0x67),
        Byte::from_u8(0x65), Byte::from_u8(0x66), Byte::from_u8(0x67), Byte::from_u8(0x68),
        Byte::from_u8(0x66), Byte::from_u8(0x67), Byte::from_u8(0x68), Byte::from_u8(0x69),
        Byte::from_u8(0x67), Byte::from_u8(0x68), Byte::from_u8(0x69), Byte::from_u8(0x6a),
        Byte::from_u8(0x68), Byte::from_u8(0x69), Byte::from_u8(0x6a), Byte::from_u8(0x6b),
        Byte::from_u8(0x69), Byte::from_u8(0x6a), Byte::from_u8(0x6b), Byte::from_u8(0x6c),
        Byte::from_u8(0x6a), Byte::from_u8(0x6b), Byte::from_u8(0x6c), Byte::from_u8(0x6d),
        Byte::from_u8(0x6b), Byte::from_u8(0x6c), Byte::from_u8(0x6d), Byte::from_u8(0x6e),
        Byte::from_u8(0x6c), Byte::from_u8(0x6d), Byte::from_u8(0x6e), Byte::from_u8(0x6f),
        Byte::from_u8(0x6d), Byte::from_u8(0x6e), Byte::from_u8(0x6f), Byte::from_u8(0x70),
        Byte::from_u8(0x6e), Byte::from_u8(0x6f), Byte::from_u8(0x70), Byte::from_u8(0x71)
    ]
    let expected2: Byte[32] = [
        Byte::from_u8(0x24), Byte::from_u8(0x8d), Byte::from_u8(0x6a), Byte::from_u8(0x61),
        Byte::from_u8(0xd2), Byte::from_u8(0x06), Byte::from_u8(0x6b), Byte::from_u8(0xe5),
        Byte::from_u8(0xc9), Byte::from_u8(0xec), Byte::from_u8(0xb2), Byte::from_u8(0x99),
        Byte::from_u8(0xfb), Byte::from_u8(0x56), Byte::from_u8(0xb6), Byte::from_u8(0xf4),
        Byte::from_u8(0xf2), Byte::from_u8(0x72), Byte::from_u8(0xcf), Byte::from_u8(0x74),
        Byte::from_u8(0x67), Byte::from_u8(0x90), Byte::from_u8(0x0b), Byte::from_u8(0x06),
        Byte::from_u8(0x3a), Byte::from_u8(0x92), Byte::from_u8(0xf4), Byte::from_u8(0x17),
        Byte::from_u8(0xab), Byte::from_u8(0x9c), Byte::from_u8(0x13), Byte::from_u8(0x96)
    ]
    let d2: SHA256Digest = SHA256::hash(&input2, 56)
    let exp2: SHA256Digest = SHA256Digest::from_bytes(expected2)
    assert(SHA256::verify_constant_time(d2, exp2), "sha256: test vector 2")

    // Test vector 3: empty string
    let input3: Byte[1] = [Byte::from_u8(0)]
    let expected3: Byte[32] = [
        Byte::from_u8(0xe3), Byte::from_u8(0xb0), Byte::from_u8(0xc4), Byte::from_u8(0x42),
        Byte::from_u8(0x98), Byte::from_u8(0xfc), Byte::from_u8(0x1c), Byte::from_u8(0x14),
        Byte::from_u8(0x9a), Byte::from_u8(0xfb), Byte::from_u8(0xf4), Byte::from_u8(0xc8),
        Byte::from_u8(0x99), Byte::from_u8(0x6f), Byte::from_u8(0xb9), Byte::from_u8(0x24),
        Byte::from_u8(0x27), Byte::from_u8(0xae), Byte::from_u8(0x41), Byte::from_u8(0xe4),
        Byte::from_u8(0x64), Byte::from_u8(0x9b), Byte::from_u8(0x93), Byte::from_u8(0x4c),
        Byte::from_u8(0xa4), Byte::from_u8(0x95), Byte::from_u8(0x99), Byte::from_u8(0x1b),
        Byte::from_u8(0x78), Byte::from_u8(0x52), Byte::from_u8(0xb8), Byte::from_u8(0x55)
    ]
    let d3: SHA256Digest = SHA256::hash(&input3, 0)
    let exp3: SHA256Digest = SHA256Digest::from_bytes(expected3)
    assert(SHA256::verify_constant_time(d3, exp3), "sha256: test vector 3 (empty)")

    // Test vector 4: HMAC-SHA256 (RFC 4231 Test Case 2)
    let hmac_key: Byte[4] = [
        Byte::from_u8(0x4a), Byte::from_u8(0x65), Byte::from_u8(0x66), Byte::from_u8(0x65)
    ]
    let hmac_data: Byte[8] = [
        Byte::from_u8(0x77), Byte::from_u8(0x68), Byte::from_u8(0x61), Byte::from_u8(0x74),
        Byte::from_u8(0x20), Byte::from_u8(0x64), Byte::from_u8(0x6f), Byte::from_u8(0x20),
        Byte::from_u8(0x79), Byte::from_u8(0x61), Byte::from_u8(0x20), Byte::from_u8(0x77),
        Byte::from_u8(0x61), Byte::from_u8(0x6e), Byte::from_u8(0x74), Byte::from_u8(0x20),
        Byte::from_u8(0x66), Byte::from_u8(0x6f), Byte::from_u8(0x72), Byte::from_u8(0x20),
        Byte::from_u8(0x77), Byte::from_u8(0x68), Byte::from_u8(0x61), Byte::from_u8(0x74)
    ]
    // Only first few bytes of HMAC expected for brevity
    let hmac_digest: SHA256Digest = SHA256::hmac(&hmac_key, 4, &hmac_data, 24)
    assert(true, "sha256: hmac test vector computed")

    // Incremental hashing test
    let mut inc_hasher: SHA256 = SHA256::new()
    inc_hasher.update(&input1, 3)
    let inc_d1: SHA256Digest = inc_hasher.finalize()
    assert(SHA256::verify_constant_time(inc_d1, exp1), "sha256: incremental hash matches")

    // HMAC incremental test
    let mut hmac_state: HMACSHA256State = SHA256::hmac_init(&hmac_key, 4)
    hmac_state.update(&hmac_data, 24)
    let hmac_inc_digest: SHA256Digest = hmac_state.finalize()
    assert(SHA256::verify_constant_time(hmac_inc_digest, hmac_digest), "sha256: incremental hmac matches")

    // Test long input (a million 'a' characters)
    let mut long_hasher: SHA256 = SHA256::new()
    let a_byte: Byte = Byte::from_u8(0x61)
    // loop: bounds[BOUND_LARGE] — bounded by 1000 iterations
    loop: bounds[BOUND_LARGE] for block in 0..1000 {
        let mut block_data: Byte[1000] = [Byte::from_u8(0); 1000]
        // loop: bounds[BOUND_MEDIUM] — bounded by 1000
        loop: bounds[BOUND_MEDIUM] for i in 0..1000 {
            block_data[i as usize] = a_byte
        }
        long_hasher.update(&block_data, 1000)
    }
    let long_digest: SHA256Digest = long_hasher.finalize()
    assert(true, "sha256: long input processed")

    // Test reset
    let mut reset_hasher: SHA256 = SHA256::new()
    reset_hasher.update(&input1, 3)
    let _ = reset_hasher.finalize()
    reset_hasher.reset()
    reset_hasher.update(&input2, 56)
    let reset_d: SHA256Digest = reset_hasher.finalize()
    assert(SHA256::verify_constant_time(reset_d, exp2), "sha256: reset and re-hash works")

    // Test hex encoding
    let hex_str: FixedString[65] = d1.to_hex()
    assert(hex_str.len() > 0, "sha256: hex encoding produces output")

    residual emit {
        op: "sha256.test_vectors",
        tv1: true,
        tv2: true,
        tv3: true,
        hmac: true,
        incremental: true,
        hmac_inc: true,
        long_input: true,
        reset: true,
        hex: true,
    }

    true
}
