// ──────────────────────────────────────────────
// Processor Information (Type 4)
// ──────────────────────────────────────────────

pub type ProcessorInfo : struct {
    header: SMBIOSHeader,
    socket_designation: FixedString[MAX_STRING_LEN],
    processor_type: u8,
    processor_family: u8,
    processor_manufacturer: FixedString[MAX_STRING_LEN],
    processor_id: FixedArray[8, u8],
    processor_version: FixedString[MAX_STRING_LEN],
    voltage: u8,
    external_clock: Word16,
    max_speed: Word16,
    current_speed: Word16,
    status: u8,
    processor_upgrade: u8,
    l1_cache_handle: Word16,
    l2_cache_handle: Word16,
    l3_cache_handle: Word16,
    serial_number: FixedString[MAX_STRING_LEN],
    asset_tag: FixedString[MAX_STRING_LEN],
    part_number: FixedString[MAX_STRING_LEN],
    core_count: u8,
    core_enabled: u8,
    thread_count: u8,
    processor_family_2: Word16,
}

impl ProcessorInfo {
    pub fn new() -> ProcessorInfo
        effects: [deterministic]
    {
        ProcessorInfo {
            header: SMBIOSHeader::new(),
            socket_designation: FixedString::new(),
            processor_type: 0,
            processor_family: 0,
            processor_manufacturer: FixedString::new(),
            processor_id: FixedArray::new(),
            processor_version: FixedString::new(),
            voltage: 0,
            external_clock: 0,
            max_speed: 0,
            current_speed: 0,
            status: 0,
            processor_upgrade: 0,
            l1_cache_handle: 0,
            l2_cache_handle: 0,
            l3_cache_handle: 0,
            serial_number: FixedString::new(),
            asset_tag: FixedString::new(),
            part_number: FixedString::new(),
            core_count: 0,
            core_enabled: 0,
            thread_count: 0,
            processor_family_2: 0,
        }
    }

    pub fn is_cpu_populated(self) -> bool
        effects: [deterministic]
    {
        (self.status & 0x40) != 0  // Bit 6 = CPU socket populated
    }

    pub fn is_cpu_enabled(self) -> bool
        effects: [deterministic]
    {
        (self.status & 0x80) != 0  // Bit 7 = CPU enabled
    }

    pub fn speed_mhz(self) -> Word16
        effects: [deterministic]
    {
        self.current_speed
    }

    pub fn max_speed_mhz(self) -> Word16
        effects: [deterministic]
    {
        self.max_speed
    }

    pub fn cpu_type_name(self) -> FixedString[32]
        effects: [deterministic]
    {
        match self.processor_type {
            0x01 => FixedString::from("Other"),
            0x02 => FixedString::from("Unknown"),
            0x03 => FixedString::from("Central Processor"),
            0x04 => FixedString::from("Math Processor"),
            0x05 => FixedString::from("DSP Processor"),
            0x06 => FixedString::from("Video Processor"),
            _ => FixedString::from("Unknown"),
        }
    }
}

