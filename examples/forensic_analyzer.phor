fn test_forensic_timeline_order() -> void
    effect [compute, residual]
{
    let ts: Array(u64, 5) = [100, 200, 300, 400, 500];
    let mut ordered: bool = true;
    for i in 1..5 { if ts[i] <= ts[i-1] { ordered = false; } }
    assert(ordered, "forensic: timeline sorted");
    residual emit { op: "forensic.test.timeline", count: 5, ordered: 1, };
}

fn test_forensic_evidence_chain_corruption() -> void
    effect [compute, residual]
{
    let mut hashes: Array(u64, 4) = [0xAAA, 0xBBB, 0xCCC, 0xDDD];
    let mut chain_ok: bool = true;
    for i in 1..4 {
        if hashes[i] == hashes[i-1] { chain_ok = false; }
    }
    assert(chain_ok, "forensic: evidence chain unbroken");
    hashes[2] = 0;
    assert(hashes[2] != hashes[1], "forensic: corrupted link detected");
    residual emit { op: "forensic.test.chain_corrupt", detected: 1, };
}

