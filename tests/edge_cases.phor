    pkg.seal_valid = has_required;

    assert(pkg.seal_valid, "edge: seal valid with multiple optional fields missing");

    residual emit {
        op: "edge.pkg_missing_multi_optional",
        seal_valid: if pkg.seal_valid { 1 } else { 0 },
        optional_missing: 3,
    };
