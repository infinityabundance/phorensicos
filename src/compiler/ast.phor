// ast.phor — AST Node Types: Expressions, Statements, Declarations, Type Annotations, Effects, Capabilities, Trusted Blocks
// Phorensic Compiler Infrastructure — Abstract Syntax Tree
//
// This module defines every AST node type used throughout the Phorensic compiler pipeline.
// The AST is the intermediate representation produced by the parser and consumed by the
// expander, lowerer, and subsequent phases. Each node carries source location spans for
// precise diagnostic reporting.
//
// Evidence semantics: Every AST node includes a generation tag that tracks the compiler
// phase responsible for its creation. This enables chain-of-custody verification for
// compiler transformations.
//
// Effect declarations:
//   [pure] — AST node construction and query functions
//   [io]   — AST formatting and debug output

use core::fixed::Array128;
use core::fixed::Array64;
use core::fixed::Array32;
use core::result::Result;
use core::option::Option;
use core::string::FixedString256;

use compiler::diagnostics::*;

// === Type Annotations ===

/// A type expression in the Phorensic type system.
pub sealdatatype TypeAnnotation {
    /// Named type reference (e.g., `u32`, `bool`, `MyStruct`).
    Named(Spanned<FixedString256>),
    /// Function type: `(param_types) -> return_type [effects]`.
    Function(
        Array64<TypeAnnotation>,   // parameter types
        Box<TypeAnnotation>,         // return type
        Array64<EffectAnnotation>,   // declared effects
    ),
    /// Generic type application: `Type<Args>`.
    Generic(
        Box<TypeAnnotation>,         // base type
        Array64<TypeAnnotation>,     // type arguments
    ),
    /// Tuple type: `(A, B, C)`.
    Tuple(Array64<TypeAnnotation>),
    /// Array type: `[T; N]`.
    Array(
        Box<TypeAnnotation>,         // element type
        u64,                         // fixed capacity
    ),
    /// Reference type: `&T` or `&mut T`.
    Reference(
        Box<TypeAnnotation>,          // referent type
        Mutability,                   // mutability
    ),
    /// Capability type: `capability T`.
    Capability(Box<TypeAnnotation>),
    /// Effect type: `effect T`.
    EffectDeclaration(Box<TypeAnnotation>),
    /// Inferred type: `_` (type inference placeholder).
    Inferred,
    /// Never type: `!`.
    Never,
    /// Type variable (for generics): `'a`.
    TypeVar(Spanned<FixedString256>),
    /// Self type: `Self`.
    SelfType,
    /// Unit type: `()`.
    Unit,
}

impl TypeAnnotation {
    /// Format this type annotation as a string.
    /// Effect: io — string formatting.
    pub fn format(&self) -> FixedString256 [io] {
        match self {
            TypeAnnotation::Named(name) => name.value,
            TypeAnnotation::Function(params, ret, effects) => {
                var result : FixedString256 = FixedString256::from("(");
                for var i : u32 = 0u32; i < params.len(); i += 1u32 [params.len()] {
                    if i > 0u32 {
                        result.push_str(FixedString256::from(", "));
                    }
                    result.push_str(params.get(i).format());
                }
                result.push_str(FixedString256::from(") -> "));
                result.push_str(ret.format());
                if effects.len() > 0u32 {
                    result.push_str(FixedString256::from(" ["));
                    for var i : u32 = 0u32; i < effects.len(); i += 1u32 [effects.len()] {
                        if i > 0u32 {
                            result.push_str(FixedString256::from(", "));
                        }
                        result.push_str(effects.get(i).format());
                    }
                    result.push_str(FixedString256::from("]"));
                }
                result
            }
            TypeAnnotation::Generic(base, args) => {
                var result : FixedString256 = base.format();
                result.push_str(FixedString256::from("<"));
                for var i : u32 = 0u32; i < args.len(); i += 1u32 [args.len()] {
                    if i > 0u32 {
                        result.push_str(FixedString256::from(", "));
                    }
                    result.push_str(args.get(i).format());
                }
                result.push_str(FixedString256::from(">"));
                result
            }
            TypeAnnotation::Tuple(elements) => {
                var result : FixedString256 = FixedString256::from("(");
                for var i : u32 = 0u32; i < elements.len(); i += 1u32 [elements.len()] {
                    if i > 0u32 {
                        result.push_str(FixedString256::from(", "));
                    }
                    result.push_str(elements.get(i).format());
                }
                result.push_str(FixedString256::from(")"));
                result
            }
            TypeAnnotation::Array(elem, size) => {
                var result : FixedString256 = FixedString256::from("[");
                result.push_str(elem.format());
                result.push_str(FixedString256::from("; "));
                result.push_u64(*size);
                result.push_str(FixedString256::from("]"));
                result
            }
            TypeAnnotation::Reference(inner, mutability) => {
                var result : FixedString256 = if mutability == Mutability::Mutable {
                    FixedString256::from("&mut ")
                } else {
                    FixedString256::from("&")
                };
                result.push_str(inner.format());
                result
            }
            TypeAnnotation::Capability(inner) => {
                var result : FixedString256 = FixedString256::from("capability ");
                result.push_str(inner.format());
                result
            }
            TypeAnnotation::EffectDeclaration(inner) => {
                var result : FixedString256 = FixedString256::from("effect ");
                result.push_str(inner.format());
                result
            }
            TypeAnnotation::Inferred => FixedString256::from("_"),
            TypeAnnotation::Never => FixedString256::from("!"),
            TypeAnnotation::TypeVar(name) => name.value,
            TypeAnnotation::SelfType => FixedString256::from("Self"),
            TypeAnnotation::Unit => FixedString256::from("()"),
        }
    }
}

// === Mutability ===

pub sealdatatype Mutability : u8 {
    Immutable = 0u8,
    Mutable = 1u8,
}

// === Effect Annotations ===

/// An effect annotation in the Phorensic effect system.
pub sealdatatype EffectAnnotation {
    /// Named effect: `effect_name`.
    Named(Spanned<FixedString256>),
    /// Pure effect: `pure`.
    Pure,
    /// I/O effect: `io`.
    IO,
    /// Diagnostic effect: `diag`.
    Diag,
    /// Lexer effect: `lex`.
    Lex,
    /// Residual effect: `residual`.
    Residual,
    /// Trusted effect: `trusted`.
    Trusted,
    /// Custom effect declaration.
    Custom(Spanned<FixedString256>),
}

impl EffectAnnotation {
    /// Format this effect annotation.
    /// Effect: io — string formatting.
    pub fn format(&self) -> FixedString256 [io] {
        match self {
            EffectAnnotation::Named(name) => name.value,
            EffectAnnotation::Pure => FixedString256::from("pure"),
            EffectAnnotation::IO => FixedString256::from("io"),
            EffectAnnotation::Diag => FixedString256::from("diag"),
            EffectAnnotation::Lex => FixedString256::from("lex"),
            EffectAnnotation::Residual => FixedString256::from("residual"),
            EffectAnnotation::Trusted => FixedString256::from("trusted"),
            EffectAnnotation::Custom(name) => name.value,
        }
    }
}

// === Capability Annotations ===

/// An affine capability annotation.
pub sealdatatype CapabilityAnnotation {
    /// Linear capability (consumed exactly once).
    Linear(Spanned<FixedString256>),
    /// Affine capability (consumed at most once).
    Affine(Spanned<FixedString256>),
    /// Observable capability (can be observed without consuming).
    Observable(Spanned<FixedString256>),
}

impl CapabilityAnnotation {
    pub fn name(&self) -> FixedString256 [pure] {
        match self {
            CapabilityAnnotation::Linear(name) => name.value,
            CapabilityAnnotation::Affine(name) => name.value,
            CapabilityAnnotation::Observable(name) => name.value,
        }
    }
}

// === Boundedness Evidence ===

/// Evidence that a loop or recursion is bounded.
pub struct BoundednessEvidence {
    /// The bound expression (e.g., `[n]` or `[256]`).
    pub bound_expression : Expression,
    /// The rationale string explaining why the bound is correct.
    pub rationale : FixedString256,
    /// Source location of the bound annotation.
    pub location : SourceLocation,
    /// Whether this bound has been verified by the lowerer.
    pub verified : bool,
}

impl BoundednessEvidence {
    pub fn new(
        bound_expression : Expression,
        rationale : FixedString256,
        location : SourceLocation,
    ) -> BoundednessEvidence [pure] {
        BoundednessEvidence {
            bound_expression: bound_expression,
            rationale: rationale,
            location: location,
            verified: false,
        }
    }
}

// === Trusted Block ===

/// A trusted block with mandatory rationale string.
pub struct TrustedBlock {
    /// The body of the trusted block.
    pub body : BlockExpression,
    /// Required rationale string explaining why this block is safe.
    pub rationale : FixedString256,
    /// Source location.
    pub location : SourceLocation,
    /// Generation tag.
    pub generation : u64,
    /// Whether this block has been audit-trailed.
    pub audit_trailed : bool,
}

impl TrustedBlock {
    pub fn new(
        body : BlockExpression,
        rationale : FixedString256,
        location : SourceLocation,
        generation : u64,
    ) -> TrustedBlock [pure] {
        TrustedBlock {
            body: body,
            rationale: rationale,
            location: location,
            generation: generation,
            audit_trailed: false,
        }
    }
}

// === Expressions ===

/// All expression types in the Phorensic language.
pub sealdatatype Expression {
    /// Literal integer: `42`.
    IntegerLiteral(Spanned<i64>),
    /// Literal float: `3.14`.
    FloatLiteral(Spanned<f64>),
    /// Literal string: `"hello"`.
    StringLiteral(Spanned<FixedString256>),
    /// Literal char: `'x'`.
    CharLiteral(Spanned<u8>),
    /// Literal boolean: `true` / `false`.
    BooleanLiteral(Spanned<bool>),
    /// Identifier reference: `foo`.
    Identifier(Spanned<FixedString256>),
    /// Block expression: `{ stmts; expr }`.
    Block(Spanned<BlockExpression>),
    /// Parenthesized expression: `(expr)`.
    Paren(Box<Expression>),
    /// Binary operation: `a + b`.
    Binary(Spanned<BinaryOp>, Box<Expression>, Box<Expression>),
    /// Unary operation: `-a`, `!b`.
    Unary(Spanned<UnaryOp>, Box<Expression>),
    /// Assignment: `a = b` or `a += b`.
    Assignment(Box<Expression>, Spanned<AssignOp>, Box<Expression>),
    /// Function call: `foo(args)`.
    Call(Box<Expression>, Array64<Expression>),
    /// Method call: `obj.method(args)`.
    MethodCall(Box<Expression>, Spanned<FixedString256>, Array64<Expression>),
    /// Index expression: `arr[i]`.
    Index(Box<Expression>, Box<Expression>),
    /// Field access: `obj.field`.
    FieldAccess(Box<Expression>, Spanned<FixedString256>),
    /// If expression: `if cond { then_expr } else { else_expr }`.
    If(Box<Expression>, Box<Expression>, Box<Expression>),
    /// Match expression: `match val { patterns }`.
    Match(Box<Expression>, Array64<MatchArm>),
    /// Loop expression: `loop { body } [bounded: N]`.
    Loop(Box<Expression>, Option<BoundednessEvidence>),
    /// While expression: `while cond { body } [bounded: N]`.
    While(Box<Expression>, Box<Expression>, Option<BoundednessEvidence>),
    /// For expression: `for var in iter { body } [bounded: N]`.
    For(Spanned<FixedString256>, Box<Expression>, Box<Expression>, Option<BoundednessEvidence>),
    /// Return expression: `return expr`.
    Return(Box<Expression>),
    /// Break expression: `break` (with optional value).
    Break(Box<Expression>),
    /// Continue expression: `continue`.
    Continue,
    /// Struct literal: `Foo { field: value }`.
    StructLiteral(Spanned<FixedString256>, Array64<StructFieldInit>),
    /// Tuple literal: `(a, b, c)`.
    TupleLiteral(Array64<Expression>),
    /// Array literal: `[a, b, c]`.
    ArrayLiteral(Array64<Expression>),
    /// Lambda/closure expression: `\|params\| expr`.
    Lambda(Array64<Parameter>, Box<Expression>, Array64<EffectAnnotation>),
    /// Trusted block: `trusted("rationale") { body }`.
    Trusted(Spanned<TrustedBlock>),
    /// Effect block: `[effect_name] { body }`.
    EffectBlock(Spanned<EffectAnnotation>, Box<Expression>),
    /// Cast expression: `expr as Type`.
    Cast(Box<Expression>, TypeAnnotation),
    /// Type ascription: `expr : Type`.
    Ascribe(Box<Expression>, TypeAnnotation),
    /// Residual emission: `[residual] { expr }`.
    Residual(Box<Expression>),
    /// Unsafe block: `unsafe("rationale") { body }`.
    UnsafeBlock(Spanned<TrustedBlock>),
}

impl Expression {
    /// Get the start location of this expression.
    /// Effect: pure — extracts location from spanned nodes.
    pub fn start_location(&self) -> SourceLocation [pure] {
        match self {
            Expression::IntegerLiteral(s) => s.start,
            Expression::FloatLiteral(s) => s.start,
            Expression::StringLiteral(s) => s.start,
            Expression::CharLiteral(s) => s.start,
            Expression::BooleanLiteral(s) => s.start,
            Expression::Identifier(s) => s.start,
            Expression::Block(s) => s.start,
            Expression::Paren(e) => e.start_location(),
            Expression::Binary(s, _, _) => s.start,
            Expression::Unary(s, _) => s.start,
            Expression::Assignment(_, s, _) => s.start,
            Expression::Call(f, _) => f.start_location(),
            Expression::MethodCall(r, s, _) => s.start,
            Expression::Index(a, _) => a.start_location(),
            Expression::FieldAccess(o, s) => s.start,
            Expression::If(c, _, _) => c.start_location(),
            Expression::Match(e, _) => e.start_location(),
            Expression::Loop(b, _) => b.start_location(),
            Expression::While(_, c, _) => c.start_location(),
            Expression::For(v, _, _, _) => v.start,
            Expression::Return(e) => e.start_location(),
            Expression::Break(e) => e.start_location(),
            Expression::Continue => SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
            Expression::StructLiteral(s, _) => s.start,
            Expression::TupleLiteral(_) => SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
            Expression::ArrayLiteral(_) => SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
            Expression::Lambda(_, _, _) => SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
            Expression::Trusted(s) => s.start,
            Expression::EffectBlock(s, _) => s.start,
            Expression::Cast(e, _) => e.start_location(),
            Expression::Ascribe(e, _) => e.start_location(),
            Expression::Residual(e) => e.start_location(),
            Expression::UnsafeBlock(s) => s.start,
        }
    }

    /// Format this expression as a string for debugging.
    /// Effect: io — recursive formatting.
    pub fn format(&self) -> FixedString256 [io] {
        match self {
            Expression::IntegerLiteral(s) => {
                var r : FixedString256 = FixedString256::new();
                r.push_i64(s.value);
                r
            }
            Expression::FloatLiteral(s) => {
                var r : FixedString256 = FixedString256::new();
                r.push_f64(s.value);
                r
            }
            Expression::StringLiteral(s) => {
                var r : FixedString256 = FixedString256::from("\"");
                r.push_str(s.value);
                r.push_str(FixedString256::from("\""));
                r
            }
            Expression::CharLiteral(s) => {
                var r : FixedString256 = FixedString256::from("'");
                r.push_byte(s.value);
                r.push_str(FixedString256::from("'"));
                r
            }
            Expression::BooleanLiteral(s) => {
                if s.value {
                    FixedString256::from("true")
                } else {
                    FixedString256::from("false")
                }
            }
            Expression::Identifier(s) => s.value,
            Expression::Block(s) => {
                var r : FixedString256 = FixedString256::from("{...}");
                r
            }
            Expression::Paren(e) => {
                var r : FixedString256 = FixedString256::from("(");
                r.push_str(e.format());
                r.push_str(FixedString256::from(")"));
                r
            }
            Expression::Binary(op, l, r_expr) => {
                var r : FixedString256 = FixedString256::new();
                r.push_str(l.format());
                r.push_str(FixedString256::from(" "));
                r.push_str(op.value.format());
                r.push_str(FixedString256::from(" "));
                r.push_str(r_expr.format());
                r
            }
            Expression::Unary(op, e) => {
                var r : FixedString256 = FixedString256::new();
                r.push_str(op.value.format());
                r.push_str(e.format());
                r
            }
            Expression::Call(f, args) => {
                var r : FixedString256 = f.format();
                r.push_str(FixedString256::from("("));
                for var i : u32 = 0u32; i < args.len(); i += 1u32 [args.len()] {
                    if i > 0u32 { r.push_str(FixedString256::from(", ")); }
                    r.push_str(args.get(i).format());
                }
                r.push_str(FixedString256::from(")"));
                r
            }
            Expression::If(cond, then_expr, else_expr) => {
                var r : FixedString256 = FixedString256::from("if ");
                r.push_str(cond.format());
                r.push_str(FixedString256::from(" { ... } else { ... }"));
                r
            }
            Expression::Match(val, arms) => {
                var r : FixedString256 = FixedString256::from("match ");
                r.push_str(val.format());
                r.push_str(FixedString256::from(" { ... }"));
                r
            }
            Expression::Return(val) => {
                var r : FixedString256 = FixedString256::from("return ");
                r.push_str(val.format());
                r
            }
            Expression::Lambda(params, body, effects) => {
                var r : FixedString256 = FixedString256::from("|");
                for var i : u32 = 0u32; i < params.len(); i += 1u32 [params.len()] {
                    if i > 0u32 { r.push_str(FixedString256::from(", ")); }
                    r.push_str(params.get(i).name.value);
                }
                r.push_str(FixedString256::from("| "));
                r.push_str(body.format());
                r
            }
            _ => FixedString256::from("<expr>"),
        }
    }
}

// === Match Arms ===

pub struct MatchArm {
    pub pattern : Pattern,
    pub guard : Option<Box<Expression>>,
    pub body : Box<Expression>,
    pub location : SourceLocation,
}

impl MatchArm {
    pub fn new(
        pattern : Pattern,
        guard : Option<Box<Expression>>,
        body : Box<Expression>,
        location : SourceLocation,
    ) -> MatchArm [pure] {
        MatchArm {
            pattern: pattern,
            guard: guard,
            body: body,
            location: location,
        }
    }
}

// === Patterns ===

pub sealdatatype Pattern {
    /// Wildcard pattern: `_`.
    Wildcard(Spanned<()>),
    /// Bind pattern: `name` or `mut name`.
    Bind(Spanned<FixedString256>, Mutability),
    /// Literal pattern: matches literal value.
    Literal(Box<Expression>),
    /// Struct pattern: `Foo { field }`.
    Struct(Spanned<FixedString256>, Array64<StructPatternField>),
    /// Tuple pattern: `(a, b, c)`.
    Tuple(Array64<Pattern>),
    /// Enum pattern: `Variant(value)`.
    EnumVariant(Spanned<FixedString256>, Box<Pattern>),
    /// Range pattern: `a..b`.
    Range(Box<Expression>, Box<Expression>),
    /// Or pattern: `a | b`.
    Or(Box<Pattern>, Box<Pattern>),
    /// Guard pattern: pattern `if` condition (handled in MatchArm instead).
    Ref(Box<Pattern>),
}

impl Pattern {
    pub fn format(&self) -> FixedString256 [io] {
        match self {
            Pattern::Wildcard(_) => FixedString256::from("_"),
            Pattern::Bind(name, mutability) => {
                if mutability == Mutability::Mutable {
                    var r : FixedString256 = FixedString256::from("mut ");
                    r.push_str(name.value);
                    r
                } else {
                    name.value
                }
            }
            Pattern::Literal(e) => e.format(),
            Pattern::Struct(name, _) => {
                var r : FixedString256 = name.value;
                r.push_str(FixedString256::from(" { ... }"));
                r
            }
            Pattern::Tuple(pats) => {
                var r : FixedString256 = FixedString256::from("(");
                for var i : u32 = 0u32; i < pats.len(); i += 1u32 [pats.len()] {
                    if i > 0u32 { r.push_str(FixedString256::from(", ")); }
                    r.push_str(pats.get(i).format());
                }
                r.push_str(FixedString256::from(")"));
                r
            }
            Pattern::EnumVariant(name, pat) => {
                var r : FixedString256 = name.value;
                r.push_str(FixedString256::from("("));
                r.push_str(pat.format());
                r.push_str(FixedString256::from(")"));
                r
            }
            Pattern::Range(low, high) => {
                var r : FixedString256 = low.format();
                r.push_str(FixedString256::from(".."));
                r.push_str(high.format());
                r
            }
            Pattern::Or(left, right) => {
                var r : FixedString256 = left.format();
                r.push_str(FixedString256::from(" | "));
                r.push_str(right.format());
                r
            }
            Pattern::Ref(inner) => {
                var r : FixedString256 = FixedString256::from("ref ");
                r.push_str(inner.format());
                r
            }
        }
    }
}

pub struct StructPatternField {
    pub name : Spanned<FixedString256>,
    pub pattern : Pattern,
    pub shorthand : bool,
}

impl StructPatternField {
    pub fn new(name : Spanned<FixedString256>, pattern : Pattern, shorthand : bool) -> StructPatternField [pure] {
        StructPatternField { name: name, pattern: pattern, shorthand: shorthand }
    }
}

pub struct StructFieldInit {
    pub name : Spanned<FixedString256>,
    pub value : Expression,
    pub shorthand : bool,
}

impl StructFieldInit {
    pub fn new(name : Spanned<FixedString256>, value : Expression, shorthand : bool) -> StructFieldInit [pure] {
        StructFieldInit { name: name, value: value, shorthand: shorthand }
    }
}

// === Operators ===

pub sealdatatype BinaryOp {
    Add,
    Subtract,
    Multiply,
    Divide,
    Modulo,
    Equal,
    NotEqual,
    LessThan,
    LessEqual,
    GreaterThan,
    GreaterEqual,
    And,
    Or,
    BitAnd,
    BitOr,
    BitXor,
    LeftShift,
    RightShift,
    Range,
    RangeInclusive,
}

impl BinaryOp {
    pub fn format(&self) -> FixedString256 [pure] {
        match self {
            BinaryOp::Add => FixedString256::from("+"),
            BinaryOp::Subtract => FixedString256::from("-"),
            BinaryOp::Multiply => FixedString256::from("*"),
            BinaryOp::Divide => FixedString256::from("/"),
            BinaryOp::Modulo => FixedString256::from("%"),
            BinaryOp::Equal => FixedString256::from("=="),
            BinaryOp::NotEqual => FixedString256::from("!="),
            BinaryOp::LessThan => FixedString256::from("<"),
            BinaryOp::LessEqual => FixedString256::from("<="),
            BinaryOp::GreaterThan => FixedString256::from(">"),
            BinaryOp::GreaterEqual => FixedString256::from(">="),
            BinaryOp::And => FixedString256::from("&&"),
            BinaryOp::Or => FixedString256::from("||"),
            BinaryOp::BitAnd => FixedString256::from("&"),
            BinaryOp::BitOr => FixedString256::from("|"),
            BinaryOp::BitXor => FixedString256::from("^"),
            BinaryOp::LeftShift => FixedString256::from("<<"),
            BinaryOp::RightShift => FixedString256::from(">>"),
            BinaryOp::Range => FixedString256::from(".."),
            BinaryOp::RangeInclusive => FixedString256::from("..="),
        }
    }
}

pub sealdatatype UnaryOp {
    Negate,
    Not,
    BitNot,
    AddressOf,
    Dereference,
}

impl UnaryOp {
    pub fn format(&self) -> FixedString256 [pure] {
        match self {
            UnaryOp::Negate => FixedString256::from("-"),
            UnaryOp::Not => FixedString256::from("!"),
            UnaryOp::BitNot => FixedString256::from("~"),
            UnaryOp::AddressOf => FixedString256::from("&"),
            UnaryOp::Dereference => FixedString256::from("*"),
        }
    }
}

pub sealdatatype AssignOp {
    Assign,
    AddAssign,
    SubAssign,
    MulAssign,
    DivAssign,
}

impl AssignOp {
    pub fn format(&self) -> FixedString256 [pure] {
        match self {
            AssignOp::Assign => FixedString256::from("="),
            AssignOp::AddAssign => FixedString256::from("+="),
            AssignOp::SubAssign => FixedString256::from("-="),
            AssignOp::MulAssign => FixedString256::from("*="),
            AssignOp::DivAssign => FixedString256::from("/="),
        }
    }
}

// === Block Expressions ===

pub struct BlockExpression {
    pub statements : Array64<Statement>,
    pub final_expression : Option<Box<Expression>>,
    pub location : SourceLocation,
    pub effect_declarations : Array64<EffectAnnotation>,
}

impl BlockExpression {
    pub fn new(
        statements : Array64<Statement>,
        final_expression : Option<Box<Expression>>,
        location : SourceLocation,
    ) -> BlockExpression [pure] {
        BlockExpression {
            statements: statements,
            final_expression: final_expression,
            location: location,
            effect_declarations: Array64::new(),
        }
    }

    pub fn with_effects(mut self, effects : Array64<EffectAnnotation>) -> BlockExpression [pure] {
        self.effect_declarations = effects;
        self
    }
}

// === Statements ===

pub sealdatatype Statement {
    /// Let binding: `let [mut] name [: type] = expr;`
    Let(Spanned<FixedString256>, Option<TypeAnnotation>, Expression, Mutability),
    /// Expression statement: `expr;`
    ExpressionStatement(Expression),
    /// Item declaration (nested): `fn`, `struct`, etc.
    Item(ItemDeclaration),
    /// Empty statement: `;`
    Empty,
}

impl Statement {
    pub fn format(&self) -> FixedString256 [io] {
        match self {
            Statement::Let(name, typ, value, mutability) => {
                var r : FixedString256 = FixedString256::from("let ");
                if mutability == Mutability::Mutable {
                    r.push_str(FixedString256::from("mut "));
                }
                r.push_str(name.value);
                match typ {
                    Option::Some(t) => {
                        r.push_str(FixedString256::from(" : "));
                        r.push_str(t.format());
                    }
                    Option::None => {}
                }
                r.push_str(FixedString256::from(" = "));
                r.push_str(value.format());
                r.push_str(FixedString256::from(";"));
                r
            }
            Statement::ExpressionStatement(e) => {
                var r : FixedString256 = e.format();
                r.push_str(FixedString256::from(";"));
                r
            }
            Statement::Item(item) => item.format(),
            Statement::Empty => FixedString256::from(";"),
        }
    }
}

// === Parameters ===

pub struct Parameter {
    pub name : Spanned<FixedString256>,
    pub type_annotation : Option<TypeAnnotation>,
    pub mutability : Mutability,
    pub effects : Array64<EffectAnnotation>,
    pub capabilities : Array64<CapabilityAnnotation>,
}

impl Parameter {
    pub fn new(
        name : Spanned<FixedString256>,
        type_annotation : Option<TypeAnnotation>,
        mutability : Mutability,
    ) -> Parameter [pure] {
        Parameter {
            name: name,
            type_annotation: type_annotation,
            mutability: mutability,
            effects: Array64::new(),
            capabilities: Array64::new(),
        }
    }

    pub fn with_effects(mut self, effects : Array64<EffectAnnotation>) -> Parameter [pure] {
        self.effects = effects;
        self
    }

    pub fn with_capabilities(mut self, caps : Array64<CapabilityAnnotation>) -> Parameter [pure] {
        self.capabilities = caps;
        self
    }
}

// === Item Declarations ===

pub sealdatatype ItemDeclaration {
    /// Function declaration: `[pub] fn name(params) -> ret_type [effects] { body }`.
    Function(Spanned<FunctionDeclaration>),
    /// Struct declaration: `[pub] struct Name { fields }`.
    Struct(Spanned<StructDeclaration>),
    /// Enum declaration: `[pub] enum Name { variants }`.
    Enum(Spanned<EnumDeclaration>),
    /// Data type: `[pub] datatype Name = { constructors }`.
    DataType(Spanned<DataTypeDeclaration>),
    /// Sealed data type: `[pub] sealdatatype Name : repr = { constructors }`.
    SealDataType(Spanned<SealDataTypeDeclaration>),
    /// Impl block: `impl Name { methods }`.
    Impl(Spanned<ImplBlock>),
    /// Type alias: `type Name = Type`.
    TypeAlias(Spanned<TypeAliasDeclaration>),
    /// Effect declaration: `effect Name { ... }`.
    EffectDeclaration(Spanned<EffectDeclaration>),
    /// Capability declaration: `capability Name { ... }`.
    CapabilityDeclaration(Spanned<CapabilityDeclaration>),
    /// Namespace declaration: `namespace Name { items }`.
    Namespace(Spanned<NamespaceDeclaration>),
    /// Use declaration: `use path;`.
    Use(Spanned<UseDeclaration>),
    /// Constant declaration: `const NAME : Type = value;`.
    Const(Spanned<ConstDeclaration>),
    /// Module-level attribute: `no_std`, `no_alloc`, `no_unsafe`.
    ModuleAttribute(Spanned<ModuleAttribute>),
}

impl ItemDeclaration {
    pub fn format(&self) -> FixedString256 [io] {
        match self {
            ItemDeclaration::Function(f) => f.value.format(),
            ItemDeclaration::Struct(s) => s.value.format(),
            ItemDeclaration::Enum(e) => e.value.format(),
            ItemDeclaration::Impl(i) => i.value.format(),
            ItemDeclaration::TypeAlias(t) => t.value.format(),
            ItemDeclaration::Namespace(n) => n.value.format(),
            ItemDeclaration::Use(u) => u.value.format(),
            _ => FixedString256::from("<item>"),
        }
    }
}

// === Function Declaration ===

pub struct FunctionDeclaration {
    pub name : Spanned<FixedString256>,
    pub is_pub : bool,
    pub is_unsafe : bool,
    pub type_params : Array64<Spanned<FixedString256>>,
    pub params : Array64<Parameter>,
    pub return_type : Option<TypeAnnotation>,
    pub effects : Array64<EffectAnnotation>,
    pub capabilities : Array64<CapabilityAnnotation>,
    pub body : Option<BlockExpression>,
    pub boundedness : Option<BoundednessEvidence>,
    pub generation : u64,
}

impl FunctionDeclaration {
    pub fn new(
        name : Spanned<FixedString256>,
        is_pub : bool,
    ) -> FunctionDeclaration [pure] {
        FunctionDeclaration {
            name: name,
            is_pub: is_pub,
            is_unsafe: false,
            type_params: Array64::new(),
            params: Array64::new(),
            return_type: Option::None,
            effects: Array64::new(),
            capabilities: Array64::new(),
            body: Option::None,
            boundedness: Option::None,
            generation: 0u64,
        }
    }

    pub fn format(&self) -> FixedString256 [io] {
        var r : FixedString256 = FixedString256::new();
        if self.is_pub {
            r.push_str(FixedString256::from("pub "));
        }
        r.push_str(FixedString256::from("fn "));
        r.push_str(self.name.value);
        r.push_str(FixedString256::from("("));
        for var i : u32 = 0u32; i < self.params.len(); i += 1u32 [self.params.len()] {
            if i > 0u32 { r.push_str(FixedString256::from(", ")); }
            r.push_str(self.params.get(i).name.value);
        }
        r.push_str(FixedString256::from(")"));
        match self.return_type {
            Option::Some(t) => {
                r.push_str(FixedString256::from(" -> "));
                r.push_str(t.format());
            }
            Option::None => {}
        }
        if self.effects.len() > 0u32 {
            r.push_str(FixedString256::from(" ["));
            for var i : u32 = 0u32; i < self.effects.len(); i += 1u32 [self.effects.len()] {
                if i > 0u32 { r.push_str(FixedString256::from(", ")); }
                r.push_str(self.effects.get(i).format());
            }
            r.push_str(FixedString256::from("]"));
        }
        r
    }
}

// === Struct Declaration ===

pub struct StructDeclaration {
    pub name : Spanned<FixedString256>,
    pub is_pub : bool,
    pub fields : Array64<StructField>,
    pub type_params : Array64<Spanned<FixedString256>>,
    pub capabilities : Array64<CapabilityAnnotation>,
    pub generation : u64,
}

impl StructDeclaration {
    pub fn new(name : Spanned<FixedString256>, is_pub : bool) -> StructDeclaration [pure] {
        StructDeclaration {
            name: name,
            is_pub: is_pub,
            fields: Array64::new(),
            type_params: Array64::new(),
            capabilities: Array64::new(),
            generation: 0u64,
        }
    }

    pub fn format(&self) -> FixedString256 [io] {
        var r : FixedString256 = FixedString256::new();
        if self.is_pub { r.push_str(FixedString256::from("pub ")); }
        r.push_str(FixedString256::from("struct "));
        r.push_str(self.name.value);
        r.push_str(FixedString256::from(" { ... }"));
        r
    }
}

pub struct StructField {
    pub name : Spanned<FixedString256>,
    pub type_annotation : TypeAnnotation,
    pub is_pub : bool,
}

impl StructField {
    pub fn new(name : Spanned<FixedString256>, type_annotation : TypeAnnotation, is_pub : bool) -> StructField [pure] {
        StructField { name: name, type_annotation: type_annotation, is_pub: is_pub }
    }
}

// === Enum Declaration ===

pub struct EnumDeclaration {
    pub name : Spanned<FixedString256>,
    pub is_pub : bool,
    pub variants : Array64<EnumVariant>,
    pub generation : u64,
}

impl EnumDeclaration {
    pub fn new(name : Spanned<FixedString256>, is_pub : bool) -> EnumDeclaration [pure] {
        EnumDeclaration {
            name: name, is_pub: is_pub,
            variants: Array64::new(),
            generation: 0u64,
        }
    }
}

pub struct EnumVariant {
    pub name : Spanned<FixedString256>,
    pub fields : Array64<EnumVariantField>,
}

pub union EnumVariantField {
    pub named : StructField,
    pub unnamed : TypeAnnotation,
}

// === Data Type / Seal Data Type ===

pub struct DataTypeDeclaration {
    pub name : Spanned<FixedString256>,
    pub is_pub : bool,
    pub type_params : Array64<Spanned<FixedString256>>,
    pub constructors : Array64<DataTypeConstructor>,
    pub generation : u64,
}

pub struct DataTypeConstructor {
    pub name : Spanned<FixedString256>,
    pub types : Array64<TypeAnnotation>,
}

pub struct SealDataTypeDeclaration {
    pub name : Spanned<FixedString256>,
    pub is_pub : bool,
    pub repr_type : TypeAnnotation,
    pub constructors : Array64<SealDataTypeConstructor>,
    pub generation : u64,
}

pub struct SealDataTypeConstructor {
    pub name : Spanned<FixedString256>,
    pub value : u64,
    pub types : Array64<TypeAnnotation>,
}

// === Impl Block ===

pub struct ImplBlock {
    pub type_name : TypeAnnotation,
    pub methods : Array64<FunctionDeclaration>,
    pub generation : u64,
}

impl ImplBlock {
    pub fn new(type_name : TypeAnnotation) -> ImplBlock [pure] {
        ImplBlock {
            type_name: type_name,
            methods: Array64::new(),
            generation: 0u64,
        }
    }

    pub fn format(&self) -> FixedString256 [io] {
        var r : FixedString256 = FixedString256::from("impl ");
        r.push_str(self.type_name.format());
        r.push_str(FixedString256::from(" { ... }"));
        r
    }
}

// === Type Alias Declaration ===

pub struct TypeAliasDeclaration {
    pub name : Spanned<FixedString256>,
    pub type_params : Array64<Spanned<FixedString256>>,
    pub aliased_type : TypeAnnotation,
}

impl TypeAliasDeclaration {
    pub fn format(&self) -> FixedString256 [io] {
        var r : FixedString256 = FixedString256::from("type ");
        r.push_str(self.name.value);
        r.push_str(FixedString256::from(" = "));
        r.push_str(self.aliased_type.format());
        r
    }
}

// === Effect Declaration ===

pub struct EffectDeclaration {
    pub name : Spanned<FixedString256>,
    pub is_builtin : bool,
    pub description : FixedString256,
}

// === Capability Declaration ===

pub struct CapabilityDeclaration {
    pub name : Spanned<FixedString256>,
    pub kind : CapabilityKind,
}

pub sealdatatype CapabilityKind : u8 {
    Linear = 0u8,
    Affine = 1u8,
    Observable = 2u8,
}

// === Namespace Declaration ===

pub struct NamespaceDeclaration {
    pub name : Spanned<FixedString256>,
    pub items : Array64<ItemDeclaration>,
    pub generation : u64,
}

impl NamespaceDeclaration {
    pub fn format(&self) -> FixedString256 [io] {
        var r : FixedString256 = FixedString256::from("namespace ");
        r.push_str(self.name.value);
        r.push_str(FixedString256::from(" { ... }"));
        r
    }
}

// === Use Declaration ===

pub struct UseDeclaration {
    pub path : UsePath,
    pub alias : Option<Spanned<FixedString256>>,
}

pub sealdatatype UsePath {
    /// Simple name: `foo`.
    Simple(Spanned<FixedString256>),
    /// Nested path: `foo::bar`.
    Nested(Spanned<FixedString256>, Box<UsePath>),
    /// Glob: `foo::*`.
    Glob(Spanned<FixedString256>),
    /// Self: `foo::{self, bar}`.
    Group(Spanned<FixedString256>, Array64<UsePath>),
}

impl UseDeclaration {
    pub fn format(&self) -> FixedString256 [io] {
        FixedString256::from("use ...;")
    }
}

// === Const Declaration ===

pub struct ConstDeclaration {
    pub name : Spanned<FixedString256>,
    pub type_annotation : TypeAnnotation,
    pub value : Expression,
    pub is_pub : bool,
}

// === Module Attributes ===

pub sealdatatype ModuleAttribute {
    NoStd,
    NoAlloc,
    NoUnsafe,
}

impl ModuleAttribute {
    pub fn format(&self) -> FixedString256 [pure] {
        match self {
            ModuleAttribute::NoStd => FixedString256::from("no_std"),
            ModuleAttribute::NoAlloc => FixedString256::from("no_alloc"),
            ModuleAttribute::NoUnsafe => FixedString256::from("no_unsafe"),
        }
    }
}

// === Source File (Top-Level AST) ===

pub struct SourceFile {
    /// All top-level item declarations.
    pub items : Array64<ItemDeclaration>,
    /// Module attributes (no_std, no_alloc, no_unsafe).
    pub attributes : Array64<ModuleAttribute>,
    /// File path of the source.
    pub file_path : FixedString256,
    /// Generation tag for handle tracking.
    pub generation : u64,
    /// Whether this AST has been expanded.
    pub expanded : bool,
    /// Whether this AST has been lowered.
    pub lowered : bool,
}

impl SourceFile {
    pub fn new(file_path : FixedString256) -> SourceFile [pure] {
        SourceFile {
            items: Array64::new(),
            attributes: Array64::new(),
            file_path: file_path,
            generation: 0u64,
            expanded: false,
            lowered: false,
        }
    }

    pub fn add_item(mut self, item : ItemDeclaration) -> SourceFile [pure] {
        let _ = self.items.push(item);
        self
    }

    pub fn add_attribute(mut self, attr : ModuleAttribute) -> SourceFile [pure] {
        let _ = self.attributes.push(attr);
        self
    }

    /// Format the entire source file for debugging.
    /// Effect: io — recursive formatting.
    pub fn format(&self) -> FixedString256 [io] {
        var r : FixedString256 = FixedString256::new();
        for var i : u32 = 0u32; i < self.attributes.len(); i += 1u32 [self.attributes.len()] {
            r.push_str(self.attributes.get(i).format());
            r.push_str(FixedString256::from("\n"));
        }
        for var i : u32 = 0u32; i < self.items.len(); i += 1u32 [self.items.len()] {
            r.push_str(self.items.get(i).format());
            r.push_str(FixedString256::from("\n"));
        }
        r
    }
}

// === AST Receipt — evidence of AST construction ===

pub struct ASTReceipt {
    /// Number of top-level items.
    pub item_count : u32,
    /// Number of function declarations found.
    pub function_count : u32,
    /// Number of struct declarations found.
    pub struct_count : u32,
    /// Number of trusted blocks found.
    pub trusted_block_count : u32,
    /// Hash of the AST structure.
    pub ast_hash : u64,
    /// Generation tag.
    pub generation : u64,
    /// File path.
    pub file_path : FixedString256,
}

impl ASTReceipt {
    pub fn new(
        item_count : u32,
        function_count : u32,
        struct_count : u32,
        trusted_block_count : u32,
        generation : u64,
        file_path : FixedString256,
    ) -> ASTReceipt [pure] {
        let hash : u64 = ASTReceipt::compute_hash(item_count, function_count, struct_count, generation);
        ASTReceipt {
            item_count: item_count,
            function_count: function_count,
            struct_count: struct_count,
            trusted_block_count: trusted_block_count,
            ast_hash: hash,
            generation: generation,
            file_path: file_path,
        }
    }

    fn compute_hash(items : u32, funcs : u32, structs : u32, gen : u64) -> u64 [pure] {
        var h : u64 = 14695981039346656037u64;
        h ^= items as u64; h *= 1099511628211u64;
        h ^= funcs as u64; h *= 1099511628211u64;
        h ^= structs as u64; h *= 1099511628211u64;
        h ^= gen; h *= 1099511628211u64;
        h
    }

    pub fn from_source_file(file : &SourceFile) -> ASTReceipt [pure] {
        var func_count : u32 = 0u32;
        var struct_count : u32 = 0u32;
        var trusted_count : u32 = 0u32;

        for var i : u32 = 0u32; i < file.items.len(); i += 1u32 [file.items.len()] {
            let item : ItemDeclaration = file.items.get(i);
            match item {
                ItemDeclaration::Function(_) => func_count += 1u32,
                ItemDeclaration::Struct(_) => struct_count += 1u32,
                _ => {}
            }
        }

        ASTReceipt::new(
            file.items.len(),
            func_count,
            struct_count,
            trusted_count,
            file.generation,
            file.file_path,
        )
    }
}
