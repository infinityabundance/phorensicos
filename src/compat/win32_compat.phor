//==============================================================================
// Registry Emulation
//==============================================================================

/// Registry key emulation.
pub struct Win32Registry(
  keys: [RegKey; 256],
  count: u32,
  cap: CapabilitySlot,
) : effect:(alloc, unsafe);

pub struct RegKey(
  name: [u8; 256],
  values: [RegValue; 64],
  num_values: u32,
  subkeys: [u32; 64],
  num_subkeys: u32,
  parent: u32,
  is_open: bool,
) : effect:(pure);

pub struct RegValue(
  name: [u8; 256],
  data_type: u32,
  data: [u8; 4096],
  data_size: u32,
) : effect:(pure);

/// Initialize the registry with standard keys.
pub fn win32_init_registry[] -> Win32Registry : effect:(alloc) {
  var reg: Win32Registry = Win32Registry(keys: Default, count: 0, cap: CapabilitySlot(0, 0, 0, 0, false));

  // HKEY_CLASSES_ROOT
  reg.keys[0] = RegKey(name: string_to_fixed("HKEY_CLASSES_ROOT\0"), values: Default, num_values: 0, subkeys: Default, num_subkeys: 0, parent: 0, is_open: true);
  reg.count = 1;

  // HKEY_CURRENT_USER
  reg.keys[1] = RegKey(name: string_to_fixed("HKEY_CURRENT_USER\0"), values: Default, num_values: 0, subkeys: Default, num_subkeys: 0, parent: 0, is_open: true);
  reg.count = 2;

  // HKEY_LOCAL_MACHINE
  reg.keys[2] = RegKey(name: string_to_fixed("HKEY_LOCAL_MACHINE\0"), values: Default, num_values: 0, subkeys: Default, num_subkeys: 0, parent: 0, is_open: true);
  reg.keys[2].subkeys[0] = 3;
  reg.keys[2].num_subkeys = 1;

  // HKEY_LOCAL_MACHINE\Software
  reg.keys[3] = RegKey(name: string_to_fixed("Software\0"), values: Default, num_values: 0, subkeys: Default, num_subkeys: 0, parent: 2, is_open: true);
  reg.count = 4;

  // HKEY_LOCAL_MACHINE\Software\Phorensic
  reg.keys[4] = RegKey(name: string_to_fixed("Phorensic\0"), values: Default, num_values: 0, subkeys: Default, num_subkeys: 0, parent: 3, is_open: true);
  reg.keys[4].values[0] = RegValue(name: string_to_fixed("Version\0"), data_type: 1, data: string_to_fixed("1.0.0\0"), data_size: 6);
  reg.keys[4].num_values = 1;
  reg.count = 5;

  return reg;
}

/// Open a registry key.
pub fn win32_reg_open_key[
  reg: *Win32Registry,
  parent_handle: u32,
  subkey: *u8,
] -> Result<u32, Win32Error> : (pure)
  loop: bounded(256)
{
  for var i: u32 = 0; i < reg.count; i += 1 {
    if reg.keys[i].parent == parent_handle && string_matches(reg.keys[i].name, subkey) {
      return Ok(i);
    }
  }
  return Err(Win32Error::FileNotFound);
}

/// Query a registry value.
pub fn win32_reg_query_value[
  reg: *Win32Registry,
  key_handle: u32,
  value_name: *u8,
  data: *u8,
  data_size: *u32,
] -> Result<(), Win32Error> : (unsafe)
  loop: bounded(64)
{
  if key_handle >= reg.count {
    return Err(Win32Error::InvalidHandle);
  }

  let key: RegKey = reg.keys[key_handle];
  for var i: u32 = 0; i < key.num_values; i += 1 {
    if string_matches(key.values[i].name, value_name) {
      @memcpy(data, key.values[i].data, key.values[i].data_size as u64);
      data_size = key.values[i].data_size;
      return Ok(());
    }
  }

  return Err(Win32Error::FileNotFound);
}

