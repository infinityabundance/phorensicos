//==============================================================================
// debug_info.phor — Phorensic Debug Information Format
//
// Defines the debug information format: line number tables, source location
// encoding, variable location, type information encoding, residual provenance
// mapping, source↔binary offset mapping, and a DWARF-compatible subset.
//
// All operations are bounded-loop and residual-recorded.
//==============================================================================

module debug_info
  @[receipt("dbginfo-v1")]
  @[audit("DBG-INFO")]
;

use core::types::*;
use core::effects::{alloc, unsafe, io};
use core::residual::*;

//==============================================================================
// Debug Information Header
//==============================================================================

/// Debug info section header.
pub struct DebugHeader(
  /// Version of debug info format.
  version: u16,
  /// Debug info flags.
  flags: DebugFlags,
  /// Offset to .debug_info (DIEs).
  info_offset: u64,
  /// Size of .debug_info.
  info_size: u64,
  /// Offset to .debug_abbrev (abbreviation tables).
  abbrev_offset: u64,
  /// Size of .debug_abbrev.
  abbrev_size: u64,
  /// Offset to .debug_line (line number tables).
  line_offset: u64,
  /// Size of .debug_line.
  line_size: u64,
  /// Offset to .debug_loc (location lists).
  loc_offset: u64,
  /// Size of .debug_loc.
  loc_size: u64,
  /// Offset to .debug_str (string table).
  str_offset: u64,
  /// Size of .debug_str.
  str_size: u64,
  /// Offset to .debug_ranges (range lists).
  ranges_offset: u64,
  /// Size of .debug_ranges.
  ranges_size: u64,
  /// Offset to .debug_pubnames (public names).
  pubnames_offset: u64,
  /// Size of .debug_pubnames.
  pubnames_size: u64,
  /// Offset to residual provenance map.
  provenance_offset: u64,
  /// Size of provenance map.
  provenance_size: u64,
  /// Number of compilation units.
  num_units: u32,
  /// Reserved.
  reserved: [u64; 4],
) : effect:(pure);

pub struct DebugFlags(
  bits: u16,
) : effect:(pure);

const DBG_FLAG_DWARF_COMPAT: DebugFlags     = DebugFlags(1 << 0);
const DBG_FLAG_RESIDUAL_MAP: DebugFlags     = DebugFlags(1 << 1);
const DBG_FLAG_CAP_TRACKING: DebugFlags     = DebugFlags(1 << 2);
const DBG_FLAG_AFFINE_TRACKING: DebugFlags  = DebugFlags(1 << 3);
const DBG_FLAG_STRIPPED: DebugFlags         = DebugFlags(1 << 4);
const DBG_FLAG_COMPRESSED: DebugFlags       = DebugFlags(1 << 5);

//==============================================================================
// Compilation Unit Header
//==============================================================================

/// Compilation unit descriptor.
pub struct CompileUnit(
  /// Offset in .debug_info.
  unit_offset: u64,
  /// Unit length (excluding this field).
  unit_length: u64,
  /// DWARF version (4 or 5).
  version: u16,
  /// Debug abbreviation offset.
  debug_abbrev_offset: u64,
  /// Address size (8 for 64-bit).
  address_size: u8,
  /// Unit type (DW_UT_compile, DW_UT_type, etc.)
  unit_type: u8,
  /// Language (DW_LANG).
  language: u16,
  /// Name (offset into .debug_str).
  name: u32,
  /// Compilation directory (offset into .debug_str).
  comp_dir: u32,
  /// Producer string (offset into .debug_str).
  producer: u32,
  /// Low PC address.
  low_pc: u64,
  /// High PC address.
  high_pc: u64,
  /// Capability token for this unit's debug info.
  cap_token: u64,
  /// Residual anchor for this unit.
  residual_anchor: u64,
) : effect:(pure);

//==============================================================================
// DIE (Debugging Information Entry)
//==============================================================================

/// DIE tag types (DWARF-compatible subset with Phorensic extensions).
pub enum DwarfTag : u16 {
  // Standard DWARF tags
  ArrayType              = 0x01,
  ClassType              = 0x02,
  EntryPoint             = 0x03,
  EnumerationType        = 0x04,
  FormalParameter        = 0x05,
  ImportedDeclaration    = 0x08,
  Label                  = 0x0A,
  LexicalBlock           = 0x0B,
  Member                 = 0x0D,
  PointerType            = 0x0F,
  ReferenceType          = 0x10,
  CompileUnit            = 0x11,
  StringType             = 0x12,
  StructureType          = 0x13,
  SubroutineType         = 0x15,
  Subprogram             = 0x2E,
  InlinedSubroutine      = 0x1D,
  SubrangeType           = 0x21,
  BaseType               = 0x24,
  CatchBlock             = 0x25,
  ConstType              = 0x26,
  Constant               = 0x27,
  Enumerator             = 0x28,
  FileType               = 0x29,
  Friend                 = 0x2A,
  InheritedClause        = 0x2C,
  InterfaceType          = 0x30,
  Namespace              = 0x39,
  TemplateTypeParameter  = 0x3B,
  TemplateValueParameter = 0x3C,
  ThrownType             = 0x3E,
  TryBlock               = 0x3F,
  VariantPart            = 0x40,
  Variable               = 0x34,
  UnionType              = 0x35,
  UnsignedPointerType    = 0x36,
  ImportedModule         = 0x3A,

  // Phorensic extensions (0x8000+)
  CapabilityType         = 0x8000,  // Capability type
  AffineType             = 0x8001,  // Affine type
  ResidualType           = 0x8002,  // Residual type
  EffectSet              = 0x8003,  // Effect set declaration
  CapabilitySlotType     = 0x8004,  // Capability slot
  SealedType             = 0x8005,  // Sealed type
  CapabilityContract     = 0x8006,  // Capability contract
  ThreadLocalType        = 0x8007,  // Thread-local storage type

  // Capability tracking
  CapBoundary           = 0x8100,  // Capability boundary
  CapTransfer           = 0x8101,  // Capability transfer point
  CapDerivation         = 0x8102,  // Capability derivation
  CapRevocation         = 0x8103,  // Capability revocation

  // Affine tracking
  AffineInit            = 0x8200,  // Affine initialization
  AffineMove            = 0x8201,  // Affine move
  AffineDrop            = 0x8202,  // Affine drop
  AffineBorrow          = 0x8203,  // Affine borrow

  // Residual tracking
  ResidualAnchor        = 0x8300,  // Residual anchor point
  ResidualGen           = 0x8301,  // Residual generation
  ResidualPropagate     = 0x8302,  // Residual propagation

  // Effect tracking
  EffectCall            = 0x8400,  // Effectful call
  EffectHandler         = 0x8401,  // Effect handler
  EffectBoundary        = 0x8402,  // Effect boundary
}

/// DIE attribute names (subset).
pub enum DwarfAttr : u16 {
  Sibling            = 0x01,
  Location           = 0x02,
  Name               = 0x03,
  Ordering           = 0x09,
  ByteSize           = 0x0B,
  BitOffset          = 0x0C,
  BitSize            = 0x0D,
  StructInfo         = 0x0E,
  UpperBound         = 0x0F,
  LowerBound         = 0x10,
  Stride             = 0x11,
  Language           = 0x13,
  Discr              = 0x15,
  DiscrValue         = 0x16,
  Visibility         = 0x17,
  Import             = 0x18,
  StringLength       = 0x19,
  CommonReference    = 0x1A,
  CompDir            = 0x1B,
  ConstValue         = 0x1C,
  ContainingType     = 0x1D,
  DefaultValue       = 0x1E,
  Inline             = 0x20,
  IsOptional         = 0x21,
  LowerBoundDefault  = 0x22,
  Producer           = 0x25,
  Prototyped         = 0x27,
  ReturnAddr         = 0x2A,
  StartScope         = 0x2C,
  StrideSize         = 0x2E,
  UpperBoundDefault  = 0x2F,
  AbstractOrigin     = 0x31,
  Accessibility      = 0x32,
  AddressClass       = 0x33,
  Artificial         = 0x34,
  BaseTypes          = 0x35,
  CallingConvention  = 0x36,
  Count              = 0x37,
  DataMemberLocation = 0x38,
  DeclColumn         = 0x39,
  DeclFile           = 0x3A,
  DeclLine           = 0x3B,
  Declaration        = 0x3C,
  DiscrList          = 0x3D,
  Encoding           = 0x3E,
  External           = 0x3F,
  FrameBase          = 0x40,
  Friend             = 0x41,
  IdentifierCase     = 0x42,
  MacroInfo          = 0x43,
  NamespaceList      = 0x44,
  Priority           = 0x45,
  Segment            = 0x46,
  Specification      = 0x47,
  StartLine          = 0x48,
  StaticLink         = 0x49,
  Type_              = 0x4A,
  UseLocation        = 0x4B,
  VariableParameter  = 0x4C,
  Virtuality         = 0x4D,
  VtableElecLocation = 0x4E,

  // Phorensic attributes (0x8000+)
  CapTypeTag         = 0x8000,  // Capability type tag
  CapRights          = 0x8001,  // Capability rights mask
  CapGeneration      = 0x8002,  // Capability generation
  EffectMask         = 0x8003,  // Effect mask
  ResidualEffect     = 0x8004,  // Residual effect type
  AffineState        = 0x8005,  // Affine state at this point
  CapToken           = 0x8006,  // Capability token
  IsSealed           = 0x8007,  // Whether sealed
  IsRevocable        = 0x8008,  // Whether revocable
  ResidualAnchorId   = 0x8009,  // Residual anchor ID
  ProvenanceHash     = 0x800A,  // Provenance hash
  SourceHash         = 0x800B,  // Source hash for residual mapping
}

/// Attribute value forms.
pub enum DwarfForm : u8 {
  Addr     = 0x01,
  Block2   = 0x03,
  Block4   = 0x04,
  Data2    = 0x05,
  Data4    = 0x06,
  Data8    = 0x07,
  String   = 0x08,
  Block    = 0x09,
  Block1   = 0x0A,
  Data1    = 0x0B,
  Flag     = 0x0C,
  SData    = 0x0D,
  Strp     = 0x0E,
  UData    = 0x0F,
  RefAddr  = 0x10,
  Ref1     = 0x11,
  Ref2     = 0x12,
  Ref4     = 0x13,
  Ref8     = 0x14,
  RefUData = 0x15,
  Indirect = 0x16,
  SecOffset = 0x17,
  ExprLoc  = 0x18,
  FlagPresent = 0x19,
  Strx     = 0x1A,
  Addrx    = 0x1B,
  RefSup4  = 0x1C,
  StrpSup  = 0x1D,
  Data16   = 0x1E,
  LineStrp = 0x1F,
  Strx1    = 0x20,
  Strx2    = 0x21,
  Strx3    = 0x22,
  Strx4    = 0x23,
  Addrx1   = 0x24,
  Addrx2   = 0x25,
  Addrx3   = 0x26,
  Addrx4   = 0x27,

  // Phorensic forms
  CapSlot   = 0x80,  // Capability slot reference
  Residual  = 0x81,  // Residual value
  Effect    = 0x82,  // Effect set encoding
  AffineId  = 0x83,  // Affine type ID
}

/// A single DIE (Debugging Information Entry).
pub struct DebugInfoEntry(
  /// Tag type.
  tag: DwarfTag,
  /// Whether this DIE has children.
  has_children: bool,
  /// Attributes of this DIE (fixed-capacity array).
  attrs: [Attribute; 32],
  /// Number of attributes.
  attr_count: u32,
  /// Offset in the debug info section.
  offset: u64,
  /// Size of this DIE.
  size: u32,
) : effect:(pure);

pub struct Attribute(
  name: DwarfAttr,
  form: DwarfForm,
  value: AttributeValue,
) : effect:(pure);

pub union AttributeValue {
  addr: u64,
  data1: u8,
  data2: u16,
  data4: u32,
  data8: u64,
  sdata: i64,
  uda: u64,
  string: u32,       // offset into .debug_str
  block: BlockValue,
  flag: bool,
  ref_addr: u64,
  ref: u32,
  sec_offset: u64,
  exprloc: u32,      // offset into .debug_loc
  cap_slot: CapSlotValue,
  residual: u64,
  effect: u64,
  affine_id: u32,
}

pub struct BlockValue(
  data: *u8,
  length: u32,
) : effect:(unsafe);

pub struct CapSlotValue(
  type_tag: u64,
  rights: u64,
  generation: u64,
) : effect:(pure);

//==============================================================================
// Line Number Table
//==============================================================================

/// Line number program state machine.
pub struct LineStateMachine(
  address: u64,
  op_index: u32,
  file: u32,
  line: u32,
  column: u32,
  is_stmt: bool,
  basic_block: bool,
  end_sequence: bool,
  prologue_end: bool,
  epilogue_begin: bool,
  isa: u32,
  discriminator: u32,
  op_advance: u8,
  default_is_stmt: bool,
  line_base: i8,
  line_range: u8,
  op_base: u8,
) : effect:(pure);

/// Line number program header.
pub struct LineProgramHeader(
  /// Unit length.
  unit_length: u64,
  /// Version.
  version: u16,
  /// Address size.
  address_size: u8,
  /// Segment selector size.
  segment_selector_size: u8,
  /// Minimum instruction length.
  min_inst_length: u8,
  /// Maximum operations per instruction.
  max_ops_per_inst: u8,
  /// Default is_stmt value.
  default_is_stmt: bool,
  /// Line base.
  line_base: i8,
  /// Line range.
  line_range: u8,
  /// Opcode base.
  opcode_base: u8,
  /// Standard opcode lengths.
  standard_opcode_lengths: [u8; 12],
  /// Directories (offsets into .debug_line_str).
  include_directories: [u32; 64],
  /// Number of directories.
  num_directories: u32,
  /// File name entries.
  file_names: [LineFileEntry; 128],
  /// Number of file names.
  num_files: u32,
) : effect:(pure);

/// File name entry in line number table.
pub struct LineFileEntry(
  /// Name (offset into .debug_line_str).
  name: u32,
  /// Directory index.
  dir_index: u32,
  /// Last modification time (0 = unknown).
  mod_time: u64,
  /// File size (0 = unknown).
  file_size: u64,
  /// Source hash (for residual provenance).
  source_hash: [u8; 32],
  /// Capability token for this source file.
  cap_token: u64,
) : effect:(pure);

/// A single line number entry (post-decoding).
pub struct LineEntry(
  /// Address in the binary.
  address: u64,
  /// File index.
  file: u32,
  /// Line number.
  line: u32,
  /// Column number.
  column: u32,
  /// Whether this is a statement start.
  is_stmt: bool,
  /// Whether this is a basic block start.
  basic_block: bool,
  /// Whether this is a prologue end.
  prologue_end: bool,
  /// Whether this is an epilogue start.
  epilogue_begin: bool,
  /// Whether this ends a sequence.
  end_sequence: bool,
  /// Discriminator.
  discriminator: u32,
  /// Residual anchor ID for this line.
  residual_anchor: u64,
) : effect:(pure);

/// Decode line number program into an array of line entries.
pub fn decode_line_program[
  program_data: *u8,
  program_size: u32,
  max_entries: u32,
] -> [LineEntry; 65536] : effect:(alloc, unsafe)
  loop: bounded(65536)
{
  var entries: [LineEntry; 65536] = Default;
  var entry_count: u32 = 0;
  var offset: u32 = 0;

  // Read header
  let header: *LineProgramHeader = @int_to_ptr(program_data);
  offset = 64;  // approximate header size

  // Initialize state machine
  var sm: LineStateMachine = LineStateMachine(
    address: 0,
    op_index: 0,
    file: 1,
    line: 1,
    column: 0,
    is_stmt: header.default_is_stmt,
    basic_block: false,
    end_sequence: false,
    prologue_end: false,
    epilogue_begin: false,
    isa: 0,
    discriminator: 0,
    op_advance: 0,
    default_is_stmt: header.default_is_stmt,
    line_base: header.line_base,
    line_range: header.line_range,
    op_base: header.opcode_base,
  );

  while offset < program_size && entry_count < max_entries {
    let opcode: u8 = program_data[offset];
    offset += 1;

    if opcode == 0 {
      // Extended opcode
      let len: u8 = program_data[offset];
      offset += 1;
      let ext_op: u8 = program_data[offset];
      offset += 1;

      match ext_op {
        0x01 => { // DW_LNE_end_sequence
          sm.end_sequence = true;
          append_line_entry(&entries, &entry_count, &sm);
          sm = reset_state_machine(header);
        },
        0x02 => { // DW_LNE_set_address
          sm.address = @read_u64(program_data + offset);
          offset += 8;
        },
        0x03 => { // DW_LNE_define_file
          // Skip file definition
          let name_len: u32 = string_length(program_data + offset);
          offset += name_len + 1;
          offset += 12;  // dir_index (4) + mod_time (4) + file_size (4)
        },
        0x04 => { // DW_LNE_set_discriminator
          sm.discriminator = @read_u32(program_data + offset);
          offset += 4;
        },
        _ => {
          // Skip unknown extended opcode
          offset += len - 2;
        },
      }
    } else if opcode >= header.op_base {
      // Special opcode
      let adjusted_opcode: u8 = opcode - header.op_base;
      let op_advance: u8 = adjusted_opcode / header.line_range;
      let line_advance: i8 = (adjusted_opcode % header.line_range) as i8 + header.line_base;

      sm.address += op_advance as u64 * header.min_inst_length as u64;
      sm.line = (sm.line as i32 + line_advance as i32) as u32;
      sm.basic_block = false;
      sm.prologue_end = false;
      sm.epilogue_begin = false;
      sm.discriminator = 0;

      append_line_entry(&entries, &entry_count, &sm);
    } else {
      // Standard opcode
      match opcode {
        0x01 => { // DW_LNS_copy
          append_line_entry(&entries, &entry_count, &sm);
          sm.basic_block = false;
          sm.prologue_end = false;
          sm.epilogue_begin = false;
        },
        0x02 => { // DW_LNS_advance_pc
          let adv: u32 = decode_uleb128(program_data, &offset);
          sm.address += adv as u64 * header.min_inst_length as u64;
        },
        0x03 => { // DW_LNS_advance_line
          let adv: i32 = decode_sleb128(program_data, &offset);
          sm.line = (sm.line as i32 + adv) as u32;
        },
        0x04 => { // DW_LNS_set_file
          sm.file = decode_uleb128(program_data, &offset);
        },
        0x05 => { // DW_LNS_set_column
          sm.column = decode_uleb128(program_data, &offset);
        },
        0x06 => { // DW_LNS_negate_stmt
          sm.is_stmt = !sm.is_stmt;
        },
        0x07 => { // DW_LNS_set_basic_block
          sm.basic_block = true;
        },
        0x08 => { // DW_LNS_const_add_pc
          let adj: u8 = 255 - header.op_base;
          let op_adv: u8 = adj / header.line_range;
          sm.address += op_adv as u64 * header.min_inst_length as u64;
        },
        0x09 => { // DW_LNS_fixed_advance_pc
          let adv: u16 = @read_u16(program_data + offset);
          offset += 2;
          sm.address += adv as u64;
        },
        0x0A => { // DW_LNS_set_prologue_end
          sm.prologue_end = true;
        },
        0x0B => { // DW_LNS_set_epilogue_begin
          sm.epilogue_begin = true;
        },
        0x0C => { // DW_LNS_set_isa
          sm.isa = decode_uleb128(program_data, &offset);
        },
        _ => {},
      }
    }
  }

  return entries;
}

/// Append a line entry to the array.
fn append_line_entry[
  entries: *[LineEntry; 65536],
  count: *u32,
  sm: *LineStateMachine,
] : effect:(unsafe)
  loop: bounded(1)
{
  if count >= 65536 {
    return;
  }
  entries[count] = LineEntry(
    address: sm.address,
    file: sm.file,
    line: sm.line,
    column: sm.column,
    is_stmt: sm.is_stmt,
    basic_block: sm.basic_block,
    prologue_end: sm.prologue_end,
    epilogue_begin: sm.epilogue_begin,
    end_sequence: sm.end_sequence,
    discriminator: sm.discriminator,
    residual_anchor: 0,
  );
  count += 1;
}

/// Reset the line state machine for a new sequence.
fn reset_state_machine[
  header: *LineProgramHeader,
] -> LineStateMachine : effect:(pure) {
  return LineStateMachine(
    address: 0,
    op_index: 0,
    file: 1,
    line: 1,
    column: 0,
    is_stmt: header.default_is_stmt,
    basic_block: false,
    end_sequence: false,
    prologue_end: false,
    epilogue_begin: false,
    isa: 0,
    discriminator: 0,
    op_advance: 0,
    default_is_stmt: header.default_is_stmt,
    line_base: header.line_base,
    line_range: header.line_range,
    op_base: header.opcode_base,
  );
}

//==============================================================================
// Variable Location Encoding
//==============================================================================

/// Variable location description.
pub struct VarLocation(
  /// Location kind.
  kind: LocationKind,
  /// Register number (for register locations).
  reg_num: u8,
  /// Offset (for memory locations).
  offset: i64,
  /// Base register for offset.
  base_reg: u8,
  /// DWARF expression (for complex locations).
  expression: *u8,
  /// Expression length.
  expr_length: u32,
  /// Capability slot info (for capability-typed variables).
  cap_info: Option[CapSlotValue],
  /// Range of PC values where this location is valid.
  range_start: u64,
  /// Range end.
  range_end: u64,
  /// Whether this location is in a capability register.
  is_cap_reg: bool,
  /// Whether this is an affine variable that was moved.
  is_moved: bool,
) : effect:(unsafe);

pub enum LocationKind : u8 {
  NotFound     = 0,
  Memory       = 1,
  Register     = 2,
  Implicit     = 3,
  CapRegister  = 4,
  AffineSlot   = 5,
  ResidualSlot = 6,
  Composite    = 7,
}

/// Decode a DWARF location expression.
pub fn decode_location[
  expr: *u8,
  expr_len: u32,
  address_size: u8,
] -> VarLocation : effect:(unsafe)
  loop: bounded(256)
{
  var loc: VarLocation = VarLocation(
    kind: LocationKind::NotFound,
    reg_num: 0,
    offset: 0,
    base_reg: 0,
    expression: expr,
    expr_length: expr_len,
    cap_info: None,
    range_start: 0,
    range_end: 0,
    is_cap_reg: false,
    is_moved: false,
  );

  var pos: u32 = 0;
  while pos < expr_len {
    let op: u8 = expr[pos];
    pos += 1;

    match op {
      0x03 => { // DW_OP_addr
        loc.kind = LocationKind::Memory;
        loc.offset = @read_u64(expr + pos) as i64;
        pos += 8;
      },
      0x50..0x6F => { // DW_OP_reg0..DW_OP_reg31
        loc.kind = LocationKind::Register;
        loc.reg_num = op - 0x50;
      },
      0x70..0x8F => { // DW_OP_breg0..DW_OP_breg31
        loc.kind = LocationKind::Memory;
        loc.base_reg = op - 0x70;
        loc.offset = decode_sleb128(expr, &pos) as i64;
      },
      0x91 => { // DW_OP_fbreg
        loc.kind = LocationKind::Memory;
        loc.base_reg = 24;  // fp
        loc.offset = decode_sleb128(expr, &pos) as i64;
      },
      0x9C => { // DW_OP_call_frame_cfa
        loc.kind = LocationKind::Memory;
        loc.base_reg = 23;  // sp
        loc.offset = 0;
      },
      0x9D => { // DW_OP_stack_value
        loc.kind = LocationKind::Implicit;
      },
      0xA0 => { // DW_OP_implicit_value
        let len: u32 = decode_uleb128(expr, &pos);
        loc.kind = LocationKind::Implicit;
        pos += len;
      },
      0xE0 => { // DW_OP_Phorensic_cap_reg (extension)
        loc.kind = LocationKind::CapRegister;
        loc.reg_num = decode_uleb128(expr, &pos) as u8;
        loc.is_cap_reg = true;
      },
      0xE1 => { // DW_OP_Phorensic_affine_slot (extension)
        loc.kind = LocationKind::AffineSlot;
        loc.offset = decode_sleb128(expr, &pos) as i64;
        loc.is_moved = false;
      },
      0xE2 => { // DW_OP_Phorensic_residual_slot (extension)
        loc.kind = LocationKind::ResidualSlot;
        loc.offset = decode_sleb128(expr, &pos) as i64;
      },
      _ => {
        // Skip unknown opcode
        if op >= 0x01 && op <= 0x0A {
          // Skip single-byte operand
        } else {
          // Cannot determine length, abort
          break;
        }
      },
    }
  }

  return loc;
}

//==============================================================================
// Type Information Encoding
//==============================================================================

/// Base type encodings (DWARF-compatible).
pub enum TypeEncoding : u8 {
  None          = 0x00,
  Address       = 0x01,
  Boolean       = 0x02,
  ComplexFloat  = 0x03,
  Float         = 0x04,
  Signed        = 0x05,
  SignedChar    = 0x06,
  Unsigned      = 0x07,
  UnsignedChar  = 0x08,
  ImaginaryFloat = 0x09,
  PackedDecimal = 0x0A,
  NumericString = 0x0B,
  Edited        = 0x0C,
  SignedFixed   = 0x0D,
  UnsignedFixed = 0x0E,
  DecimalFloat  = 0x0F,
  UTF           = 0x10,
  // Phorensic extensions
  Capability    = 0x80,
  Affine        = 0x81,
  Residual      = 0x82,
  Effect        = 0x83,
  Sealed        = 0x84,
  ThreadLocal   = 0x85,
}

/// Type descriptor for debug info.
pub struct TypeDescriptor(
  /// Type name (offset into .debug_str).
  name: u32,
  /// Byte size.
  byte_size: u32,
  /// Type encoding.
  encoding: TypeEncoding,
  /// DWARF tag.
  tag: DwarfTag,
  /// Offset of the DIE for this type.
  die_offset: u64,
  /// Number of type parameters.
  num_params: u32,
  /// Type parameter offsets.
  param_offsets: [u64; 16],
  /// Capability-specific info.
  cap_info: Option[CapTypeInfo],
  /// Affine-specific info.
  affine_info: Option[AffineTypeInfo],
) : effect:(pure);

pub struct CapTypeInfo(
  default_rights: u64,
  is_sealed: bool,
  is_revocable: bool,
  base_type: u64,
) : effect:(pure);

pub struct AffineTypeInfo(
  drop_fn: u64,
  move_fn: u64,
  clone_fn: u64,
  is_copy: bool,
) : effect:(pure);

//==============================================================================
// Residual Provenance Mapping
//==============================================================================

/// Maps source locations to binary offsets for residual provenance.
pub struct ProvenanceMapEntry(
  /// Source file hash.
  source_hash: [u8; 32],
  /// Source line number.
  source_line: u32,
  /// Source column number.
  source_column: u32,
  /// Binary offset start.
  binary_offset_start: u64,
  /// Binary offset end.
  binary_offset_end: u64,
  /// Function containing this range.
  function_name: u32,
  /// Capability state at this point (hash).
  cap_state_hash: u64,
  /// Effect mask active at this point.
  effect_mask: u64,
  /// Residual anchor ID.
  residual_anchor: u64,
  /// Whether this is a capability boundary.
  is_cap_boundary: bool,
  /// Whether this is an effect boundary.
  is_effect_boundary: bool,
) : effect:(pure);

/// Provenance map section header.
pub struct ProvenanceMapHeader(
  /// Number of entries.
  num_entries: u32,
  /// Offset to entries array.
  entries_offset: u64,
  /// Maximum binary offset mapped.
  max_offset: u64,
  /// Source tree root hash.
  source_tree_hash: [u8; 32],
  /// Build ID for provenance chain.
  build_id: [u8; 32],
) : effect:(pure);

/// Lookup provenance for a binary offset.
pub fn lookup_provenance[
  map: *[ProvenanceMapEntry],
  num_entries: u32,
  binary_offset: u64,
] -> Option[ProvenanceMapEntry] : effect:(pure)
  loop: bounded(65536)
{
  // Binary search through sorted entries
  var low: u32 = 0;
  var high: u32 = num_entries;

  while low < high {
    let mid: u32 = low + (high - low) / 2;
    let entry: ProvenanceMapEntry = map[mid];

    if binary_offset < entry.binary_offset_start {
      high = mid;
    } else if binary_offset >= entry.binary_offset_end {
      low = mid + 1;
    } else {
      return Some(entry);
    }
  }

  return None;
}

/// Build a provenance map from debug line info and symbol table.
pub fn build_provenance_map[
  line_entries: *[LineEntry],
  num_lines: u32,
  function_ranges: *[FunctionRange],
  num_functions: u32,
  max_entries: u32,
] -> [ProvenanceMapEntry; 65536] : effect:(alloc, unsafe)
  loop: bounded(65536)
{
  var map: [ProvenanceMapEntry; 65536] = Default;
  var count: u32 = 0;

  for var i: u32 = 0; i < num_lines && count < max_entries; i += 1 {
    let line: LineEntry = line_entries[i];
    if line.end_sequence {
      continue;
    }

    // Find the next line entry for end offset
    var end_addr: u64 = line.address + 8;  // default: 1 instruction
    if i + 1 < num_lines {
      let next_line: LineEntry = line_entries[i + 1];
      end_addr = next_line.address;
    }

    // Find containing function
    var func_name: u32 = 0;
    for var j: u32 = 0; j < num_functions; j += 1 {
      let fr: FunctionRange = function_ranges[j];
      if line.address >= fr.start && line.address < fr.end {
        func_name = fr.name;
        break;
      }
    }

    map[count] = ProvenanceMapEntry(
      source_hash: [0; 32],
      source_line: line.line,
      source_column: line.column,
      binary_offset_start: line.address,
      binary_offset_end: end_addr,
      function_name: func_name,
      cap_state_hash: 0,
      effect_mask: 0,
      residual_anchor: line.residual_anchor,
      is_cap_boundary: false,
      is_effect_boundary: false,
    );
    count += 1;
  }

  return map;
}

//==============================================================================
// Source ↔ Binary Offset Mapping
//==============================================================================

/// Source location to binary offset mapping (reverse lookup).
pub struct SourceLocationMap(
  /// Source file hash.
  source_hash: u64,
  /// Source line.
  line: u32,
  /// Source column.
  column: u32,
  /// Binary offset.
  binary_offset: u64,
  /// Confidence level.
  confidence: u8,
) : effect:(pure);

/// Search for a binary offset by source location.
pub fn find_binary_offset[
  map: *[SourceLocationMap],
  num_entries: u32,
  source_hash: u64,
  line: u32,
  column: u32,
] -> Option[SourceLocationMap] : effect:(pure)
  loop: bounded(65536)
{
  for var i: u32 = 0; i < num_entries; i += 1 {
    let entry: SourceLocationMap = map[i];
    if entry.source_hash == source_hash
        && entry.line == line
        && entry.column == column {
      return Some(entry);
    }
  }
  return None;
}

/// Search for source location by binary offset.
pub fn find_source_location[
  map: *[SourceLocationMap],
  num_entries: u32,
  binary_offset: u64,
] -> Option[SourceLocationMap] : effect:(pure)
  loop: bounded(65536)
{
  var best: Option[SourceLocationMap] = None;
  var best_distance: u64 = 0xFFFF_FFFF_FFFF_FFFF;

  for var i: u32 = 0; i < num_entries; i += 1 {
    let entry: SourceLocationMap = map[i];
    let distance: u64 = if binary_offset >= entry.binary_offset {
      binary_offset - entry.binary_offset
    } else {
      entry.binary_offset - binary_offset
    };

    if distance < best_distance {
      best_distance = distance;
      best = Some(entry);
    }
  }

  return best;
}

//==============================================================================
// DWARF-Compatible Subset
//==============================================================================

/// Write a DWARF-compatible .debug_info section.
pub fn write_dwarf_compat_debug_info[
  unit: *CompileUnit,
  dies: *[DebugInfoEntry],
  num_dies: u32,
  buffer: *u8,
  buffer_size: u32,
] -> Result[u32, DwarfWriteError] : effect:(alloc, unsafe)
  loop: bounded(65536)
{
  var offset: u32 = 0;

  // Write unit header
  if offset + 12 > buffer_size {
    return Err(DwarfWriteError::BufferTooSmall);
  }

  // Unit length (placeholder)
  let length_offset: u32 = offset;
  @write_u32(buffer + offset, 0);
  offset += 4;

  // Version
  @write_u16(buffer + offset, unit.version);
  offset += 2;

  // Debug abbrev offset
  @write_u32(buffer + offset, unit.debug_abbrev_offset as u32);
  offset += 4;

  // Address size
  buffer[offset] = unit.address_size;
  offset += 1;

  // Write DIE tree
  for var i: u32 = 0; i < num_dies; i += 1 {
    let die: DebugInfoEntry = dies[i];

    // Write tag + has_children
    @write_u16(buffer + offset, die.tag as u16);
    offset += 2;
    buffer[offset] = if die.has_children { 1 } else { 0 };
    offset += 1;

    // Write attributes
    for var j: u32 = 0; j < die.attr_count; j += 1 {
      let attr: Attribute = die.attrs[j];
      @write_u16(buffer + offset, attr.name as u16);
      offset += 2;
      offset += write_attribute_value(buffer + offset, buffer_size - offset, attr.form, attr.value)?;
    }

    // Null terminator for attributes
    @write_u16(buffer + offset, 0);
    offset += 2;
    @write_u16(buffer + offset, 0);
    offset += 2;
  }

  // Write null DIE (end of children chain)
  @write_u16(buffer + offset, 0);
  offset += 2;

  // Update unit length
  let unit_length: u32 = offset - length_offset - 4;
  @write_u32(buffer + length_offset, unit_length);

  return Ok(offset);
}

pub enum DwarfWriteError : u64 {
  BufferTooSmall = 1,
  InvalidDIE     = 2,
  UnsupportedForm = 3,
}

/// Write an attribute value.
fn write_attribute_value[
  buffer: *u8,
  buffer_size: u32,
  form: DwarfForm,
  value: AttributeValue,
] -> Result[u32, DwarfWriteError] : effect:(unsafe)
  loop: bounded(1)
{
  match form {
    DwarfForm::Addr => {
      @write_u64(buffer, value.addr);
      return Ok(8);
    },
    DwarfForm::Data1 => {
      buffer[0] = value.data1;
      return Ok(1);
    },
    DwarfForm::Data2 => {
      @write_u16(buffer, value.data2);
      return Ok(2);
    },
    DwarfForm::Data4 => {
      @write_u32(buffer, value.data4);
      return Ok(4);
    },
    DwarfForm::Data8 => {
      @write_u64(buffer, value.data8);
      return Ok(8);
    },
    DwarfForm::Flag => {
      buffer[0] = if value.flag { 1 } else { 0 };
      return Ok(1);
    },
    DwarfForm::String => {
      // String stored inline
      let str_offset: u32 = value.string;
      // In practice, copy from string table
      return Ok(4);
    },
    DwarfForm::Strp => {
      @write_u32(buffer, value.string);
      return Ok(4);
    },
    DwarfForm::UData => {
      let written: u32 = encode_uleb128(buffer, buffer_size, value.uda);
      return Ok(written);
    },
    DwarfForm::SData => {
      let written: u32 = encode_sleb128(buffer, buffer_size, value.sdata);
      return Ok(written);
    },
    DwarfForm::Ref4 => {
      @write_u32(buffer, value.ref);
      return Ok(4);
    },
    DwarfForm::Ref8 => {
      @write_u64(buffer, value.ref_addr);
      return Ok(8);
    },
    _ => {
      return Err(DwarfWriteError::UnsupportedForm);
    },
  }
}

//==============================================================================
// LEB128 Encoding Utilities
//==============================================================================

/// Decode an unsigned LEB128 value.
pub fn decode_uleb128[
  data: *u8,
  pos: *u32,
] -> u32 : effect:(unsafe)
  loop: bounded(5)
{
  var result: u32 = 0;
  var shift: u32 = 0;

  for var i: u32 = 0; i < 5; i += 1 {
    let byte: u8 = data[pos];
    pos += 1;
    result |= (byte as u32 & 0x7F) << shift;
    if (byte & 0x80) == 0 {
      break;
    }
    shift += 7;
  }

  return result;
}

/// Decode a signed LEB128 value.
pub fn decode_sleb128[
  data: *u8,
  pos: *u32,
] -> i32 : effect:(unsafe)
  loop: bounded(5)
{
  var result: i32 = 0;
  var shift: u32 = 0;

  for var i: u32 = 0; i < 5; i += 1 {
    let byte: u8 = data[pos];
    pos += 1;
    result |= (byte as i32 & 0x7F) << shift;
    shift += 7;
    if (byte & 0x80) == 0 {
      if shift < 32 && (byte & 0x40) != 0 {
        result |= !0 << shift;
      }
      break;
    }
  }

  return result;
}

/// Encode an unsigned LEB128 value.
pub fn encode_uleb128[
  buffer: *u8,
  buffer_size: u32,
  value: u64,
] -> u32 : effect:(unsafe)
  loop: bounded(10)
{
  var val: u64 = value;
  var written: u32 = 0;

  for var i: u32 = 0; i < 10; i += 1 {
    if written >= buffer_size {
      return written;
    }
    let byte: u8 = (val & 0x7F) as u8;
    val >>= 7;
    if val != 0 {
      byte |= 0x80;
    }
    buffer[written] = byte;
    written += 1;
    if val == 0 {
      break;
    }
  }

  return written;
}

/// Encode a signed LEB128 value.
pub fn encode_sleb128[
  buffer: *u8,
  buffer_size: u32,
  value: i64,
] -> u32 : effect:(unsafe)
  loop: bounded(10)
{
  var val: i64 = value;
  var written: u32 = 0;
  var more: bool = true;

  for var i: u32 = 0; i < 10; i += 1 {
    if written >= buffer_size {
      return written;
    }
    let byte: u8 = (val & 0x7F) as u8;
    val >>= 7;
    more = !((val == 0 && (byte & 0x40) == 0) || (val == -1 && (byte & 0x40) != 0));
    if more {
      byte |= 0x80;
    }
    buffer[written] = byte;
    written += 1;
    if !more {
      break;
    }
  }

  return written;
}

//==============================================================================
// Utility Functions and External Declarations
//==============================================================================

pub struct FunctionRange(
  name: u32,
  start: u64,
  end: u64,
) : effect:(pure);

fn string_length[s: *u8] -> u32 : effect:(pure) {
  var len: u32 = 0;
  for var i: u32 = 0; i < 65536; i += 1 {
    if s[i] == 0 { return len; }
    len += 1;
  }
  return len;
}

fn @read_u16[ptr: *u8] -> u16 : effect:(unsafe) { return *(@int_to_ptr(ptr) as *u16); }
fn @read_u32[ptr: *u8] -> u32 : effect:(unsafe) { return *(@int_to_ptr(ptr) as *u32); }
fn @read_u64[ptr: *u8] -> u64 : effect:(unsafe) { return *(@int_to_ptr(ptr) as *u64); }
fn @write_u16[ptr: *u8, val: u16] : effect:(unsafe) { *(@int_to_ptr(ptr) as *u16) = val; }
fn @write_u32[ptr: *u8, val: u32] : effect:(unsafe) { *(@int_to_ptr(ptr) as *u32) = val; }
fn @write_u64[ptr: *u8, val: u64] : effect:(unsafe) { *(@int_to_ptr(ptr) as *u64) = val; }

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_leb128_roundtrip[] : effect:(unsafe) {
  var buffer: [u8; 16] = Default;
  let written: u32 = encode_uleb128(buffer, 16, 300);
  var pos: u32 = 0;
  let decoded: u32 = decode_uleb128(buffer, &pos);
  assert(decoded == 300);
}

@Test
pub fn test_leb128_signed_roundtrip[] : effect:(unsafe) {
  var buffer: [u8; 16] = Default;
  let written: u32 = encode_sleb128(buffer, 16, -42);
  var pos: u32 = 0;
  let decoded: i32 = decode_sleb128(buffer, &pos);
  assert(decoded == -42);
}

@Test
pub fn test_line_state_machine_reset[] : effect:(pure) {
  let header: LineProgramHeader = LineProgramHeader(
    unit_length: 0, version: 5, address_size: 8, segment_selector_size: 0,
    min_inst_length: 1, max_ops_per_inst: 1, default_is_stmt: true,
    line_base: -5, line_range: 14, opcode_base: 13,
    standard_opcode_lengths: Default, include_directories: Default,
    num_directories: 0, file_names: Default, num_files: 0,
  );
  let sm: LineStateMachine = reset_state_machine(&header);
  assert(sm.file == 1);
  assert(sm.line == 1);
  assert(sm.is_stmt == true);
}
