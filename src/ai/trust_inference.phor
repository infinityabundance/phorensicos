// file: trust_inference.phor
// purpose: Trust inference engine for evidence-based trust scoring,
//          trust propagation through graphs, recommendation aggregation,
//          trust decay modeling, and trust policy recommendation.
//          Fully deterministic for court-verifiable trust assessments.
// evidence: TRUST-INFERENCE-ARCH-001 through TRUST-INFERENCE-ARCH-240
// residual: Every trust score, propagation, and recommendation is recorded.

use core::constants::*
use core::types::*
use core::errors::*
use core::effects::*
use core::collections::*
use core::math::*
use core::traits::*
use core::serialization::*

// ──────────────────────────────────────────────
// Trust Inference Diagnostic Ranges
// ──────────────────────────────────────────────
const DIAG_TRUST_INFERENCE : Word64 = DIAG_AI_BASE | 0x0600

const TRUST_MAX_ENTITIES        : u32 = 256
const TRUST_MAX_RECOMMENDATIONS : u32 = 512
const TRUST_PROPAGATION_DEPTH   : u32 = 32
const TRUST_NAME_CAP            : u32 = 32
const TRUST_RESIDUAL_LOG        : u32 = 64
const TRUST_DECAY_HISTORY       : u32 = 64
const TRUST_POLICY_CAP          : u32 = 16
const TRUST_ATTRIBUTE_CAP       : u32 = 8
const TRUST_WEIGHT_BUCKETS      : u32 = 8

// ──────────────────────────────────────────────
// Trust Level Enum (extends core TrustLevel)
// ──────────────────────────────────────────────
pub type TrustLevel : u8 = enum {
    TrustLevel_None         = 0x00,
    TrustLevel_Minimal      = 0x01,
    TrustLevel_Low          = 0x02,
    TrustLevel_Basic        = 0x03,
    TrustLevel_Moderate     = 0x04,
    TrustLevel_Substantial  = 0x05,
    TrustLevel_High         = 0x06,
    TrustLevel_VeryHigh     = 0x07,
    TrustLevel_Maximum      = 0x08,
}

// ──────────────────────────────────────────────
// Entity (agent, process, or component being trusted)
// ──────────────────────────────────────────────
pub type TrustEntity : struct {
    id: Word32,
    name: FixedString[TRUST_NAME_CAP],
    entity_type: u8,
    trust_score: u16,
    trust_level: TrustLevel,
    confidence: u8,
    last_updated: Word64,
    direct_observations: u32,
    indirect_endorsements: u32,
    attributes: FixedArray[FixedString[TRUST_NAME_CAP], TRUST_ATTRIBUTE_CAP],
    attribute_values: FixedArray[u16, TRUST_ATTRIBUTE_CAP],
    attribute_count: u32,
}

impl TrustEntity {
    pub fn new(eid: Word32, ename: FixedString[TRUST_NAME_CAP], etype: u8) -> TrustEntity
        effects: [deterministic]
    {
        TrustEntity {
            id: eid,
            name: ename,
            entity_type: etype,
            trust_score: 0,
            trust_level: TrustLevel::TrustLevel_None,
            confidence: 0,
            last_updated: Word64::zero(),
            direct_observations: 0,
            indirect_endorsements: 0,
            attributes: FixedArray::new(),
            attribute_values: FixedArray::new(),
            attribute_count: 0,
        }
    }

    pub fn add_attribute(self: ref mut, name: FixedString[TRUST_NAME_CAP], value: u16) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        if self.attribute_count >= TRUST_ATTRIBUTE_CAP {
            return Result::Err(bounds_capacity_exceeded(TRUST_ATTRIBUTE_CAP))
        }
        let r1: Result<(), BoundsError> = self.attributes.set(self.attribute_count, name)
        let r2: Result<(), BoundsError> = self.attribute_values.set(self.attribute_count, value)
        if r1.is_ok() && r2.is_ok() {
            self.attribute_count = self.attribute_count + 1
        }
        r2
    }

    pub fn update_trust(self: ref mut, new_score: u16, ts: Word64)
        effects: [deterministic]
    {
        self.trust_score = new_score
        self.last_updated = ts
        self.direct_observations = self.direct_observations + 1

        if new_score > 9000 {
            self.trust_level = TrustLevel::TrustLevel_Maximum
        } else if new_score > 7000 {
            self.trust_level = TrustLevel::TrustLevel_VeryHigh
        } else if new_score > 5000 {
            self.trust_level = TrustLevel::TrustLevel_High
        } else if new_score > 3500 {
            self.trust_level = TrustLevel::TrustLevel_Substantial
        } else if new_score > 2000 {
            self.trust_level = TrustLevel::TrustLevel_Moderate
        } else if new_score > 1000 {
            self.trust_level = TrustLevel::TrustLevel_Basic
        } else if new_score > 500 {
            self.trust_level = TrustLevel::TrustLevel_Low
        } else if new_score > 100 {
            self.trust_level = TrustLevel::TrustLevel_Minimal
        } else {
            self.trust_level = TrustLevel::TrustLevel_None
        }
    }

    pub def compute_confidence(self) -> u8
        effects: [deterministic]
    {
        let total: u32 = self.direct_observations + self.indirect_endorsements
        if total > 100 { 95 }
        else if total > 50 { 85 }
        else if total > 20 { 70 }
        else if total > 10 { 55 }
        else if total > 3 { 35 }
        else { 15 }
    }
}

// ──────────────────────────────────────────────
// Recommendation (endorsement from one entity to another)
// ──────────────────────────────────────────────
pub type TrustRecommendation : struct {
    id: Word32,
    from_entity: Word32,
    to_entity: Word32,
    score: u16,
    confidence: u8,
    timestamp: Word64,
    context: FixedString[TRUST_NAME_CAP],
    is_direct: bool,
}

impl TrustRecommendation {
    pub fn new(rid: Word32, from: Word32, to: Word32, score: u16, ts: Word64) -> TrustRecommendation
        effects: [deterministic]
    {
        TrustRecommendation {
            id: rid,
            from_entity: from,
            to_entity: to,
            score: score,
            confidence: 100,
            timestamp: ts,
            context: FixedString::new(),
            is_direct: true,
        }
    }

    pub fn set_context(self: ref mut, ctx: FixedString[TRUST_NAME_CAP])
        effects: [deterministic]
    {
        self.context = ctx
    }

    pub fn record(self: ref mut)
        effects: [residual]
    {
        residual emit {
            ai_op: "trust.recommendation",
            recommendation_id: self.id as u64,
            from: self.from_entity as u64,
            to: self.to_entity as u64,
            score: self.score as u64,
            confidence: self.confidence as u64,
            is_direct: if self.is_direct { 1 } else { 0 },
        }
    }
}

// ──────────────────────────────────────────────
// Trust Decay Function
// ──────────────────────────────────────────────
pub type TrustDecay : struct {
    decay_rate: Word64,
    half_life_ns: Word64,
    min_score: u16,
    decay_function: u8,
}

impl TrustDecay {
    pub fn new(rate: Word64, half_life: Word64, min_val: u16, func: u8) -> TrustDecay
        effects: [deterministic]
    {
        TrustDecay {
            decay_rate: rate,
            half_life_ns: half_life,
            min_score: min_val,
            decay_function: func,
        }
    }

    pub fn apply(self, score: u16, elapsed: Word64) -> u16
        effects: [deterministic]
    {
        if elapsed.is_zero() {
            return score
        }
        if self.half_life_ns.is_zero() {
            return score
        }
        let halves: Word64 = elapsed.div(self.half_life_ns)
        if halves.is_zero() {
            return score
        }
        let multiplier: Word64 = Word64::from_u64(1000).div(
            Word64::from_u64(2).pow(halves))
        let decayed: Word64 = Word64::from_u64(score as u64).mul(multiplier).div(Word64::from_u64(1000))
        let result: u16 = decayed.to_u64() as u16
        if result < self.min_score {
            self.min_score
        } else {
            result
        }
    }
}

// ──────────────────────────────────────────────
// Trust Policy Recommendation
// ──────────────────────────────────────────────
pub type TrustPolicy : struct {
    name: FixedString[TRUST_NAME_CAP],
    min_trust_level: TrustLevel,
    require_direct_observation: bool,
    min_recommendations: u32,
    max_propagation_depth: u32,
    require_context_match: bool,
    confidence_threshold: u8,
}

impl TrustPolicy {
    pub fn new(pname: FixedString[TRUST_NAME_CAP]) -> TrustPolicy
        effects: [deterministic]
    {
        TrustPolicy {
            name: pname,
            min_trust_level: TrustLevel::TrustLevel_Moderate,
            require_direct_observation: false,
            min_recommendations: 1,
            max_propagation_depth: 3,
            require_context_match: false,
            confidence_threshold: 50,
        }
    }

    pub fn set_min_trust(self: ref mut, level: TrustLevel)
        effects: [deterministic]
    {
        self.min_trust_level = level
    }

    pub fn evaluate(self, entity: ref TrustEntity) -> bool
        effects: [deterministic]
    {
        if (entity.trust_level as u8) < (self.min_trust_level as u8) {
            return false
        }
        if self.require_direct_observation && entity.direct_observations == 0 {
            return false
        }
        if entity.indirect_endorsements < self.min_recommendations {
            return false
        }
        if entity.compute_confidence() < self.confidence_threshold {
            return false
        }
        true
    }

    pub fn record(self: ref mut)
        effects: [residual]
    {
        residual emit {
            ai_op: "trust.policy.evaluated",
            policy: self.name,
            min_level: self.min_trust_level as u64,
            min_recommendations: self.min_recommendations as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Trust Propagation Calculator
// ──────────────────────────────────────────────
pub type TrustPropagator : struct {
    propagation_count: Word64,
    max_depth: u32,
}

impl TrustPropagator {
    pub fn new(max_d: u32) -> TrustPropagator
        effects: [deterministic]
    {
        TrustPropagator {
            propagation_count: Word64::zero(),
            max_depth: if max_d > TRUST_PROPAGATION_DEPTH { TRUST_PROPAGATION_DEPTH } else { max_d },
        }
    }

    pub fn propagate(self: ref mut, entities: ref FixedArray[TrustEntity, TRUST_MAX_ENTITIES], entity_count: u32, recommendations: ref FixedArray[TrustRecommendation, TRUST_MAX_RECOMMENDATIONS], rec_count: u32, decay: ref TrustDecay, ts: Word64) -> FixedArray[TrustEntity, TRUST_MAX_ENTITIES]
        effects: [deterministic, residual]
    {
        let mut updated: FixedArray[TrustEntity, TRUST_MAX_ENTITIES] = FixedArray::new()
        let mut updated_count: u32 = 0

        // Initialize from current entities
        for i in 0..entity_count {
            let e: TrustEntity = match entities.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if updated_count < TRUST_MAX_ENTITIES {
                let _ = updated.set(updated_count, e)
                updated_count = updated_count + 1
            }
        }

        // Propagate trust along recommendation graph
        for depth in 0..self.max_depth {
            let mut changes: u32 = 0
            for i in 0..updated_count {
                let entity: ref mut TrustEntity = match updated.ref_at_mut(i) {
                    Result::Ok(e) => e,
                    Result::Err(_) => continue,
                }
                // Find recommendations pointing TO this entity
                let mut incoming_score: u32 = 0
                let mut incoming_count: u32 = 0
                for j in 0..rec_count {
                    let rec: TrustRecommendation = match recommendations.get(j) {
                        Result::Ok(r) => r,
                        Result::Err(_) => continue,
                    }
                    if rec.to_entity == entity.id {
                        // Find the recommender's trust score
                        for k in 0..updated_count {
                            let recommender: TrustEntity = match updated.get(k) {
                                Result::Ok(e) => e,
                                Result::Err(_) => continue,
                            }
                            if recommender.id == rec.from_entity {
                                // Weight by recommender's trust
                                let weighted: u32 = (rec.score as u32) * (recommender.trust_score as u32) / 10000
                                incoming_score = incoming_score + weighted
                                incoming_count = incoming_count + 1
                            }
                        }
                    }
                }
                if incoming_count > 0 {
                    let avg_incoming: u16 = (incoming_score / incoming_count) as u16
                    // Blend with existing score (weighted by time)
                    let elapsed: Word64 = ts.sub(entity.last_updated)
                    let decayed_current: u16 = decay.apply(entity.trust_score, elapsed)
                    let blended: u16 = ((decayed_current as u32) * 60 + (avg_incoming as u32) * 40) / 100
                    entity.update_trust(blended, ts)
                    changes = changes + 1
                }
            }
            self.propagation_count = self.propagation_count.increment_or_max()
            if changes == 0 {
                break
            }
        }

        residual emit {
            ai_op: "trust.propagation.complete",
            entities_updated: updated_count as u64,
            depth_reached: self.max_depth as u64,
            total_propagations: self.propagation_count.to_u64(),
        }
        updated
    }
}

// ──────────────────────────────────────────────
// Trust Inference Engine (Main)
// ──────────────────────────────────────────────
pub type TrustInferenceEngine : struct {
    entities: FixedArray[TrustEntity, TRUST_MAX_ENTITIES],
    entity_count: u32,
    next_entity_id: Word32,
    recommendations: FixedArray[TrustRecommendation, TRUST_MAX_RECOMMENDATIONS],
    rec_count: u32,
    next_rec_id: Word32,
    decay: TrustDecay,
    propagator: TrustPropagator,
    policies: FixedArray[TrustPolicy, TRUST_POLICY_CAP],
    policy_count: u32,
    name: FixedString[TRUST_NAME_CAP],
    residuals: FixedArray[TrustRecommendation, TRUST_RESIDUAL_LOG],
}

impl TrustInferenceEngine {
    pub fn new(engine_name: FixedString[TRUST_NAME_CAP]) -> TrustInferenceEngine
        effects: [deterministic, residual]
    {
        let engine: TrustInferenceEngine = TrustInferenceEngine {
            entities: FixedArray::new(),
            entity_count: 0,
            next_entity_id: Word32::from_u32(1),
            recommendations: FixedArray::new(),
            rec_count: 0,
            next_rec_id: Word32::from_u32(1),
            decay: TrustDecay::new(Word64::from_u64(50), Word64::from_u64(86400_000_000_000), 100, 0),
            propagator: TrustPropagator::new(TRUST_PROPAGATION_DEPTH),
            policies: FixedArray::new(),
            policy_count: 0,
            name: engine_name,
            residuals: FixedArray::new(),
        }
        residual emit {
            ai_op: "trust.engine.init",
            name: engine_name,
            max_entities: TRUST_MAX_ENTITIES as u64,
            max_recommendations: TRUST_MAX_RECOMMENDATIONS as u64,
            propagation_depth: TRUST_PROPAGATION_DEPTH as u64,
        }
        engine
    }

    pub fn register_entity(en: ref mut TrustInferenceEngine, ename: FixedString[TRUST_NAME_CAP], etype: u8) -> Result[Word32, BoundsError>
        effects: [deterministic, residual]
    {
        if en.entity_count >= TRUST_MAX_ENTITIES {
            return Result::Err(bounds_capacity_exceeded(TRUST_MAX_ENTITIES))
        }
        let eid: Word32 = en.next_entity_id
        en.next_entity_id = Word32::from_u32(en.next_entity_id.to_u32() + 1)
        let entity: TrustEntity = TrustEntity::new(eid, ename, etype)
        let r: Result<(), BoundsError> = en.entities.set(en.entity_count, entity)
        if r.is_ok() {
            en.entity_count = en.entity_count + 1
        }
        residual emit {
            ai_op: "trust.entity.registered",
            entity_id: eid as u64,
            name: ename,
            entity_type: etype as u64,
        }
        Result::Ok(eid)
    }

    pub fn add_recommendation(en: ref mut TrustInferenceEngine, from: Word32, to: Word32, score: u16, ts: Word64) -> Result[Word32, BoundsError>
        effects: [deterministic, residual]
    {
        if en.rec_count >= TRUST_MAX_RECOMMENDATIONS {
            return Result::Err(bounds_capacity_exceeded(TRUST_MAX_RECOMMENDATIONS))
        }
        // Validate entities exist
        if !en.entity_exists(from) || !en.entity_exists(to) {
            return Result::Err(bounds_index_out_of_range(0, en.entity_count))
        }
        let rid: Word32 = en.next_rec_id
        en.next_rec_id = Word32::from_u32(en.next_rec_id.to_u32() + 1)
        let mut rec: TrustRecommendation = TrustRecommendation::new(rid, from, to, score, ts)
        let r: Result<(), BoundsError> = en.recommendations.set(en.rec_count, rec)
        if r.is_ok() {
            en.rec_count = en.rec_count + 1
            rec.record()

            // Update target entity's indirect endorsement count
            for i in 0..en.entity_count {
                let e: ref mut TrustEntity = match en.entities.ref_at_mut(i) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                if e.id.eq(to) {
                    e.indirect_endorsements = e.indirect_endorsements + 1
                }
            }
        }
        Result::Ok(rid)
    }

    pub fn update_direct_trust(en: ref mut TrustInferenceEngine, entity_id: Word32, score: u16, ts: Word64) -> Result<(), BoundsError>
        effects: [deterministic, residual]
    {
        for i in 0..en.entity_count {
            let e: ref mut TrustEntity = match en.entities.ref_at_mut(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if e.id.eq(entity_id) {
                e.update_trust(score, ts)
                e.confidence = e.compute_confidence()
                residual emit {
                    ai_op: "trust.direct_update",
                    entity_id: entity_id as u64,
                    new_score: score as u64,
                    level: e.trust_level as u64,
                    confidence: e.confidence as u64,
                }
                return Result::Ok(())
            }
        }
        Result::Err(bounds_index_out_of_range(0, en.entity_count))
    }

    pub fn propagate_trust(en: ref mut TrustInferenceEngine, ts: Word64)
        effects: [deterministic, residual]
    {
        let updated: FixedArray[TrustEntity, TRUST_MAX_ENTITIES> = en.propagator.propagate(
            &en.entities, en.entity_count,
            &en.recommendations, en.rec_count,
            &en.decay, ts)
        // Merge back
        for i in 0..TRUST_MAX_ENTITIES {
            let ue: TrustEntity = match updated.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if ue.id.to_u32() == 0 { continue }
            for j in 0..en.entity_count {
                let e: ref mut TrustEntity = match en.entities.ref_at_mut(j) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                if e.id.eq(ue.id) {
                    *e = ue
                }
            }
        }
    }

    pub fn add_policy(en: ref mut TrustInferenceEngine, policy: TrustPolicy) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        if en.policy_count >= TRUST_POLICY_CAP {
            return Result::Err(bounds_capacity_exceeded(TRUST_POLICY_CAP))
        }
        let r: Result<(), BoundsError> = en.policies.set(en.policy_count, policy)
        if r.is_ok() {
            en.policy_count = en.policy_count + 1
        }
        r
    }

    pub fn evaluate_policies(en: ref TrustInferenceEngine, entity_id: Word32) -> FixedArray[bool, TRUST_POLICY_CAP]
        effects: [deterministic]
    {
        let mut results: FixedArray[bool, TRUST_POLICY_CAP] = FixedArray::new()
        let entity: ref TrustEntity = match en.find_entity(entity_id) {
            Result::Ok(e) => e,
            Result::Err(_) => return results,
        }
        for i in 0..en.policy_count {
            let policy: TrustPolicy = match en.policies.get(i) {
                Result::Ok(p) => p,
                Result::Err(_) => continue,
            }
            let _ = results.set(i, policy.evaluate(entity))
        }
        results
    }

    pub fn get_trust_score(en: ref TrustInferenceEngine, entity_id: Word32) -> Result[TrustEntity, BoundsError>
        effects: [deterministic]
    {
        en.find_entity(entity_id)
    }

    pub fn set_decay(en: ref mut TrustInferenceEngine, half_life: Word64, min_score: u16)
        effects: [deterministic]
    {
        en.decay = TrustDecay::new(Word64::from_u64(50), half_life, min_score, 0)
    }

    pub fn generate_report(en: ref TrustInferenceEngine) -> FixedString[4096]
        effects: [deterministic]
    {
        let mut report: FixedString[4096] = FixedString::new()
        report.append(FixedString[32]::from_slice("Trust Inference Report\n"))
        report.append(FixedString[32]::from_slice("=======================\n"))
        report.append(FixedString[16]::from_slice("Engine: "))
        report.append(en.name)
        report.append(FixedString[16]::from_slice("\nEntities: "))
        report.append_u64(en.entity_count as u64)
        report.append(FixedString[16]::from_slice("\nRecommendations: "))
        report.append_u64(en.rec_count as u64)
        report.append(FixedString[16]::from_slice("\nPolicies: "))
        report.append_u64(en.policy_count as u64)

        report.append(FixedString[16]::from_slice("\n\nEntity Trust Scores:\n"))
        for i in 0..en.entity_count {
            let e: TrustEntity = match en.entities.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            report.append(FixedString[8]::from_slice("  "))
            report.append(e.name)
            report.append(FixedString[4]::from_slice(": "))
            report.append_u64(e.trust_score as u64)
            report.append(FixedString[4]::from_slice(" (L"))
            report.append_u64(e.trust_level as u64)
            report.append(FixedString[4]::from_slice(" C"))
            report.append_u64(e.confidence as u64)
            report.append(FixedString[4]::from_slice(" DO:"))
            report.append_u64(e.direct_observations as u64)
            report.append(FixedString[4]::from_slice(" IE:"))
            report.append_u64(e.indirect_endorsements as u64)
            report.append(FixedString[2]::from_slice(")\n"))
        }

        report.append(FixedString[16]::from_slice("\nPolicy Evaluations:\n"))
        for i in 0..en.policy_count {
            let p: TrustPolicy = match en.policies.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            report.append(FixedString[8]::from_slice("  "))
            report.append(p.name)
            report.append(FixedString[8]::from_slice(": min_level="))
            report.append_u64(p.min_trust_level as u64)
            report.append(FixedString[8]::from_slice(" conf_thresh="))
            report.append_u64(p.confidence_threshold as u64)
            report.append(FixedString[2]::from_slice("\n"))
        }

        report.append(FixedString[16]::from_slice("\nPropagation: "))
        report.append_u64(en.propagator.propagation_count.to_u64())

        report
    }

    fn entity_exists(en: ref TrustInferenceEngine, eid: Word32) -> bool
        effects: [deterministic]
    {
        for i in 0..en.entity_count {
            let e: TrustEntity = match en.entities.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if e.id.eq(eid) {
                return true
            }
        }
        false
    }

    fn find_entity(en: ref TrustInferenceEngine, eid: Word32) -> Result<TrustEntity, BoundsError>
        effects: [deterministic]
    {
        for i in 0..en.entity_count {
            let e: TrustEntity = match en.entities.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if e.id.eq(eid) {
                return Result::Ok(e)
            }
        }
        Result::Err(bounds_index_out_of_range(0, en.entity_count))
    }

    pub fn flush_residuals(en: ref mut TrustInferenceEngine)
        effects: [residual]
    {
        residual emit {
            ai_op: "trust.residuals.flushed",
            name: en.name,
            entities: en.entity_count as u64,
            recommendations: en.rec_count as u64,
            propagations: en.propagator.propagation_count.to_u64(),
        }
    }
}

// ──────────────────────────────────────────────
// Utility Functions
// ──────────────────────────────────────────────
pub fn aggregate_recommendations(engine: ref TrustInferenceEngine, target_id: Word32) -> u16
    effects: [deterministic]
{
    let mut total_weighted: u32 = 0
    let mut total_weight: u32 = 0
    for i in 0..engine.rec_count {
        let rec: TrustRecommendation = match engine.recommendations.get(i) {
            Result::Ok(r) => r,
            Result::Err(_) => continue,
        }
        if rec.to_entity.eq(target_id) {
            // Find recommender's trust score
            for j in 0..engine.entity_count {
                let e: TrustEntity = match engine.entities.get(j) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                if e.id.eq(rec.from_entity) {
                    let weight: u32 = (e.trust_score as u32) + 1
                    total_weighted = total_weighted + (rec.score as u32) * weight
                    total_weight = total_weight + weight
                }
            }
        }
    }
    if total_weight == 0 {
        return 0
    }
    (total_weighted / total_weight) as u16
}

pub fn trust_distance(engine: ref TrustInferenceEngine, from_id: Word32, to_id: Word32) -> u32
    effects: [deterministic]
{
    let mut distance: u32 = 0
    let mut current: Word32 = to_id
    for _ in 0..TRUST_PROPAGATION_DEPTH {
        if current.eq(from_id) {
            return distance
        }
        // Find recommendation pointing TO current
        let mut found: bool = false
        for i in 0..engine.rec_count {
            let rec: TrustRecommendation = match engine.recommendations.get(i) {
                Result::Ok(r) => r,
                Result::Err(_) => continue,
            }
            if rec.to_entity.eq(current) {
                current = rec.from_entity
                distance = distance + 1
                found = true
            }
        }
        if !found {
            break
        }
    }
    u32::max_value()
}

pub fn recommend_policy(engine: ref TrustInferenceEngine, entity_id: Word32) -> TrustPolicy
    effects: [deterministic, residual]
{
    let mut best_policy: TrustPolicy = TrustPolicy::new(FixedString[TRUST_NAME_CAP]::from_slice("default"))
    let entity: ref TrustEntity = match engine.find_entity(entity_id) {
        Result::Ok(e) => e,
        Result::Err(_) => return best_policy,
    }

    // Recommend based on entity characteristics
    if entity.direct_observations < 5 {
        best_policy.set_min_trust(TrustLevel::TrustLevel_Substantial)
        best_policy.require_direct_observation = true
        best_policy.min_recommendations = 3
    } else if entity.trust_score < 3000 {
        best_policy.set_min_trust(TrustLevel::TrustLevel_High)
        best_policy.min_recommendations = 2
    } else {
        best_policy.set_min_trust(TrustLevel::TrustLevel_Moderate)
        best_policy.confidence_threshold = 40
    }

    residual emit {
        ai_op: "trust.policy_recommendation",
        entity_id: entity_id as u64,
        recommended_policy: best_policy.name,
        min_trust_level: best_policy.min_trust_level as u64,
    }
    best_policy
}

// ──────────────────────────────────────────────
// Module Initialization
// ──────────────────────────────────────────────
pub fn init_trust_inference(name: FixedString[TRUST_NAME_CAP]) -> TrustInferenceEngine
    effects: [deterministic, residual]
{
    let engine: TrustInferenceEngine = TrustInferenceEngine::new(name)
    residual emit {
        ai_op: "trust.subsystem.init",
        name: name,
        max_entities: TRUST_MAX_ENTITIES as u64,
        max_recommendations: TRUST_MAX_RECOMMENDATIONS as u64,
        propagation_depth: TRUST_PROPAGATION_DEPTH as u64,
        decay_half_life: engine.decay.half_life_ns.to_u64(),
    }
    engine
}
