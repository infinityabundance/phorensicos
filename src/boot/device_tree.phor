// file: device_tree.phor
// purpose: Device tree — FDT (flattened device tree) parsing, node traversal,
//          property reading, interrupt map, register address extraction,
//          compatible string matching, dtb overlay
// effects: [deterministic, io:read, io:write, residual]
// trust: TrustState_Bootstrap

package "phorensic:device_tree:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const FDT_MAGIC: Word32 = 0xD00DFEED
const FDT_MAX_DEPTH: u32 = 32
const MAX_DT_NODES: u32 = 512
const MAX_DT_PROPS: u32 = 1024
const MAX_PROP_NAME: u32 = 64
const MAX_PROP_DATA: u32 = 4096
const MAX_COMPATIBLE: u32 = 16
const MAX_REG_ADDRS: u32 = 8
const MAX_INTERRUPTS: u32 = 16
const MAX_INTERRUPT_MAP: u32 = 32
const MAX_OVERLAY_SYMBOLS: u32 = 64
const MAX_PATH_LEN: u32 = 256
const MAX_STRING_LEN: u32 = 128

// FDT token types
const FDT_BEGIN_NODE: u32 = 0x00000001
const FDT_END_NODE: u32 = 0x00000002
const FDT_PROP: u32 = 0x00000003
const FDT_NOP: u32 = 0x00000004
const FDT_END: u32 = 0x00000009

// Standard property names
const PROP_COMPATIBLE: FixedString[16] = "compatible"
const PROP_STATUS: FixedString[16] = "status"
const PROP_REG: FixedString[16] = "reg"
const PROP_INTERRUPTS: FixedString[16] = "interrupts"
const PROP_INTERRUPT_PARENT: FixedString[16] = "interrupt-parent"
const PROP_INTERRUPT_MAP: FixedString[16] = "interrupt-map"
const PROP_INTERRUPT_MAP_MASK: FixedString[16] = "interrupt-map-mask"
const PROP_ADDRESS_CELLS: FixedString[16] = "#address-cells"
const PROP_SIZE_CELLS: FixedString[16] = "#size-cells"
const PROP_INTERRUPT_CELLS: FixedString[16] = "#interrupt-cells"
const PROP_PHANDLE: FixedString[16] = "phandle"
const PROP_LINUX_PHANDLE: FixedString[16] = "linux,phandle"
const PROP_LABEL: FixedString[16] = "label"
const PROP_MODEL: FixedString[16] = "model"
const PROP_CHOSEN: FixedString[16] = "chosen"
const PROP_MEMORY: FixedString[16] = "memory"
const PROP_DEVICE_TYPE: FixedString[16] = "device_type"
const PROP_RANGES: FixedString[16] = "ranges"
const PROP_DMA_RANGES: FixedString[16] = "dma-ranges"
const PROP_CLOCK_FREQUENCY: FixedString[16] = "clock-frequency"
const PROP_CURRENT_SPEED: FixedString[16] = "current-speed"

// Status values
const STATUS_OKAY: FixedString[8] = "okay"
const STATUS_DISABLED: FixedString[8] = "disabled"
const STATUS_FAIL: FixedString[8] = "fail"
const STATUS_FAIL_SSS: FixedString[8] = "fail-sss"

// ──────────────────────────────────────────────
// FDT Header
// ──────────────────────────────────────────────

pub type FDTHeader : struct {
    magic: Word32,
    totalsize: Word32,
    off_dt_struct: Word32,
    off_dt_strings: Word32,
    off_mem_rsvmap: Word32,
    version: Word32,
    last_comp_version: Word32,
    boot_cpuid_phys: Word32,
    size_dt_strings: Word32,
    size_dt_struct: Word32,
}

impl FDTHeader {
    pub fn new() -> FDTHeader
        effects: [deterministic]
    {
        FDTHeader {
            magic: 0,
            totalsize: 0,
            off_dt_struct: 0,
            off_dt_strings: 0,
            off_mem_rsvmap: 0,
            version: 0,
            last_comp_version: 0,
            boot_cpuid_phys: 0,
            size_dt_strings: 0,
            size_dt_struct: 0,
        }
    }

    pub fn validate(self) -> bool
        effects: [deterministic]
    {
        self.magic == FDT_MAGIC
    }

    pub fn is_supported_version(self) -> bool
        effects: [deterministic]
    {
        self.version >= 16 && self.last_comp_version <= 16
    }
}

// ──────────────────────────────────────────────
// Device Tree Property
// ──────────────────────────────────────────────

pub type DTProperty : struct {
    name: FixedString[MAX_PROP_NAME],
    value: FixedArray[MAX_PROP_DATA, u8],
    value_length: u32,
    name_offset: u32,
}

impl DTProperty {
    pub fn new() -> DTProperty
        effects: [deterministic]
    {
        DTProperty {
            name: FixedString::new(),
            value: FixedArray::new(),
            value_length: 0,
            name_offset: 0,
        }
    }

    pub fn as_word32(self, index: u32) -> Word32
        effects: [deterministic]
    {
        let byte_offset: u32 = index * 4
        if byte_offset + 3 >= self.value_length {
            return 0
        }
        let b0: u32 = self.value.get(byte_offset)! as u32
        let b1: u32 = self.value.get(byte_offset + 1)! as u32
        let b2: u32 = self.value.get(byte_offset + 2)! as u32
        let b3: u32 = self.value.get(byte_offset + 3)! as u32
        (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }

    pub fn as_word64(self, index: u32) -> Word64
        effects: [deterministic]
    {
        let high: Word64 = Word64::from_u64(self.as_word32(index) as u64)
        let low: Word64 = Word64::from_u64(self.as_word32(index + 1) as u64)
        (high << 32) | low
    }

    pub fn as_string(self) -> FixedString[MAX_STRING_LEN]
        effects: [deterministic]
    {
        let mut s: FixedString[MAX_STRING_LEN] = FixedString::new()
        for i in 0..self.value_length {
            let ch: u8 = self.value.get(i)!
            if ch == 0 { break }
            s.append_byte(ch)!
        }
        s
    }

    pub fn as_bool(self) -> bool
        effects: [deterministic]
    {
        // Boolean property: present = true, absent = false
        true
    }

    pub fn as_u32_array(self) -> FixedArray[32, Word32]
        effects: [deterministic]
    {
        let mut arr: FixedArray[32, Word32] = FixedArray::new()
        let count: u32 = self.value_length / 4
        for i in 0..count {
            if i >= 32 { break }
            arr.push(self.as_word32(i))!
        }
        arr
    }

    pub fn string_list_contains(self, target: FixedString[MAX_STRING_LEN]) -> bool
        effects: [deterministic]
    {
        let mut current: FixedString[MAX_STRING_LEN] = FixedString::new()
        for i in 0..self.value_length {
            let ch: u8 = self.value.get(i)!
            if ch == 0 {
                if current == target {
                    return true
                }
                current = FixedString::new()
            } else {
                current.append_byte(ch)!
            }
        }
        // Check last string (may not be null-terminated)
        current == target
    }
}

// ──────────────────────────────────────────────
// Device Tree Node
// ──────────────────────────────────────────────

pub type DTNode : struct {
    name: FixedString[MAX_PATH_LEN],
    full_path: FixedString[MAX_PATH_LEN],
    properties: FixedArray[MAX_DT_PROPS, DTProperty],
    num_properties: u32,
    children: FixedArray[MAX_DT_NODES, u32],
    num_children: u32,
    parent_index: u32,
    depth: u32,
    phandle: Word32,
    address_cells: u32,
    size_cells: u32,
    interrupt_cells: u32,
}

impl DTNode {
    pub fn new() -> DTNode
        effects: [deterministic]
    {
        DTNode {
            name: FixedString::new(),
            full_path: FixedString::new(),
            properties: FixedArray::new(),
            num_properties: 0,
            children: FixedArray::new(),
            num_children: 0,
            parent_index: 0,
            depth: 0,
            phandle: 0,
            address_cells: 2,
            size_cells: 1,
            interrupt_cells: 1,
        }
    }

    pub fn add_property(self: ref mut, prop: DTProperty) -> Result<(), BootError>
        effects: [deterministic]
    {
        if self.num_properties >= MAX_DT_PROPS {
            return Result::Err(BootError::new(
                DIAG_DT_BASE | 0x001,
                "Maximum properties per node exceeded"
            ))
        }
        self.properties.set(self.num_properties, prop)!
        self.num_properties = self.num_properties + 1
        Result::Ok(())
    }

    pub fn add_child(self: ref mut, child_index: u32) -> Result<(), BootError>
        effects: [deterministic]
    {
        if self.num_children >= 32 {
            return Result::Err(BootError::new(
                DIAG_DT_BASE | 0x002,
                "Maximum children per node exceeded"
            ))
        }
        self.children.set(self.num_children, child_index)!
        self.num_children = self.num_children + 1
        Result::Ok(())
    }

    pub fn find_property(self, name: FixedString[MAX_PROP_NAME]) -> Result[DTProperty, BootError>
        effects: [deterministic]
    {
        for i in 0..self.num_properties {
            let prop: DTProperty = self.properties.get(i)!
            if prop.name == name {
                return Result::Ok(prop)
            }
        }
        Result::Err(BootError::new(
            DIAG_DT_BASE | 0x003,
            "Property not found on node"
        ))
    }

    pub fn has_property(self, name: FixedString[MAX_PROP_NAME]) -> bool
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(name)
        result.is_ok()
    }

    pub fn is_compatible(self, target: FixedString[MAX_STRING_LEN]) -> bool
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(PROP_COMPATIBLE)
        if result.is_err() { return false }
        let prop: DTProperty = result.unwrap()
        prop.string_list_contains(target)
    }

    pub fn is_any_compatible(self, targets: FixedArray[MAX_COMPATIBLE, FixedString[MAX_STRING_LEN]], count: u32) -> bool
        effects: [deterministic]
    {
        for i in 0..count {
            if self.is_compatible(targets.get(i)!) {
                return true
            }
        }
        false
    }

    pub fn is_enabled(self) -> bool
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(PROP_STATUS)
        if result.is_err() { return true }  // absent = okay
        let prop: DTProperty = result.unwrap()
        let status_str: FixedString[MAX_STRING_LEN] = prop.as_string()
        status_str == STATUS_OKAY || status_str.len() == 0
    }

    pub fn reg_address(self, index: u32) -> Word64
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(PROP_REG)
        if result.is_err() { return Word64::zero() }
        let prop: DTProperty = result.unwrap()

        let cell_size: u32 = self.address_cells + self.size_cells
        let base_offset: u32 = index * cell_size

        if self.address_cells == 1 {
            Word64::from_u64(prop.as_word32(base_offset) as u64)
        } else {
            prop.as_word64(base_offset)
        }
    }

    pub fn reg_size(self, index: u32) -> Word64
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(PROP_REG)
        if result.is_err() { return Word64::zero() }
        let prop: DTProperty = result.unwrap()

        let addr_cells: u32 = self.address_cells
        let cell_size: u32 = addr_cells + self.size_cells
        let size_offset: u32 = index * cell_size + addr_cells

        if self.size_cells == 1 {
            Word64::from_u64(prop.as_word32(size_offset) as u64)
        } else {
            prop.as_word64(size_offset)
        }
    }

    pub fn interrupt_count(self) -> u32
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(PROP_INTERRUPTS)
        if result.is_err() { return 0 }
        let prop: DTProperty = result.unwrap()
        let int_cells: u32 = if self.interrupt_cells > 0 { self.interrupt_cells } else { 1 }
        prop.value_length / (int_cells * 4)
    }

    pub fn interrupt(self, index: u32) -> Word32
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(PROP_INTERRUPTS)
        if result.is_err() { return 0 }
        let prop: DTProperty = result.unwrap()
        let int_cells: u32 = if self.interrupt_cells > 0 { self.interrupt_cells } else { 1 }
        prop.as_word32(index * int_cells)
    }

    pub fn read_u32_property(self, name: FixedString[MAX_PROP_NAME], default_val: Word32) -> Word32
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(name)
        if result.is_err() { return default_val }
        let prop: DTProperty = result.unwrap()
        if prop.value_length >= 4 {
            prop.as_word32(0)
        } else {
            default_val
        }
    }

    pub fn read_string_property(self, name: FixedString[MAX_PROP_NAME]) -> FixedString[MAX_STRING_LEN]
        effects: [deterministic]
    {
        let result: Result[DTProperty, BootError> = self.find_property(name)
        if result.is_err() { return FixedString::new() }
        let prop: DTProperty = result.unwrap()
        prop.as_string()
    }
}

// ──────────────────────────────────────────────
// Device Tree (FDT)
// ──────────────────────────────────────────────

pub type DeviceTree : struct {
    header: FDTHeader,
    nodes: FixedArray[MAX_DT_NODES, DTNode],
    num_nodes: u32,
    root_index: u32,
    memory_node: u32,
    chosen_node: u32,
    boot_cpu_node: u32,
    data: FixedArray[MAX_FILE_DATA_LEN, u8],
    data_size: u32,
    valid: bool,
    model: FixedString[MAX_STRING_LEN],
    compatible: FixedString[MAX_STRING_LEN],
}

impl DeviceTree {
    pub fn new() -> DeviceTree
        effects: [deterministic]
    {
        DeviceTree {
            header: FDTHeader::new(),
            nodes: FixedArray::new(),
            num_nodes: 0,
            root_index: 0,
            memory_node: 0,
            chosen_node: 0,
            boot_cpu_node: 0,
            data: FixedArray::new(),
            data_size: 0,
            valid: false,
            model: FixedString::new(),
            compatible: FixedString::new(),
        }
    }

    pub fn add_node(self: ref mut, node: DTNode) -> Result<u32, BootError>
        effects: [deterministic]
    {
        if self.num_nodes >= MAX_DT_NODES {
            return Result::Err(BootError::new(
                DIAG_DT_BASE | 0x010,
                "Maximum device tree nodes exceeded"
            ))
        }
        let index: u32 = self.num_nodes
        self.nodes.set(index, node)!
        self.num_nodes = self.num_nodes + 1
        Result::Ok(index)
    }

    pub fn get_node(self, index: u32) -> Result[DTNode, BootError>
        effects: [deterministic]
    {
        if index >= self.num_nodes {
            return Result::Err(BootError::new(
                DIAG_DT_BASE | 0x011,
                "Node index out of range"
            ))
        }
        Result::Ok(self.nodes.get(index)!)
    }

    pub fn get_node_mut(self: ref mut, index: u32) -> Result[ref mut DTNode, BootError>
        effects: [deterministic]
    {
        if index >= self.num_nodes {
            return Result::Err(BootError::new(
                DIAG_DT_BASE | 0x012,
                "Node index out of range (mutable)"
            ))
        }
        Result::Ok(self.nodes.ref_mut(index))
    }

    pub fn find_node_by_path(self, path: FixedString[MAX_PATH_LEN]) -> Result<DTNode, BootError>
        effects: [deterministic]
    {
        for i in 0..self.num_nodes {
            let node: DTNode = self.nodes.get(i)!
            if node.full_path == path {
                return Result::Ok(node)
            }
        }
        Result::Err(BootError::new(
            DIAG_DT_BASE | 0x013,
            "Node not found by path"
        ))
    }

    pub fn find_node_by_compatible(self, compatible: FixedString[MAX_STRING_LEN]) -> Result[DTNode, BootError>
        effects: [deterministic]
    {
        for i in 0..self.num_nodes {
            let node: DTNode = self.nodes.get(i)!
            if node.is_compatible(compatible) && node.is_enabled() {
                return Result::Ok(node)
            }
        }
        Result::Err(BootError::new(
            DIAG_DT_BASE | 0x014,
            "No compatible node found"
        ))
    }

    pub fn find_node_by_phandle(self, phandle: Word32) -> Result[DTNode, BootError>
        effects: [deterministic]
    {
        for i in 0..self.num_nodes {
            let node: DTNode = self.nodes.get(i)!
            if node.phandle == phandle {
                return Result::Ok(node)
            }
        }
        Result::Err(BootError::new(
            DIAG_DT_BASE | 0x015,
            "No node with given phandle found"
        ))
    }

    pub fn find_all_compatible(self, compatible: FixedString[MAX_STRING_LEN]) -> FixedArray[MAX_DT_NODES, u32>
        effects: [deterministic]
    {
        let mut indices: FixedArray[MAX_DT_NODES, u32] = FixedArray::new()
        for i in 0..self.num_nodes {
            let node: DTNode = self.nodes.get(i)!
            if node.is_compatible(compatible) {
                indices.push(i)!
            }
        }
        indices
    }

    pub fn get_memory_info(self) -> Result<(Word64, Word64), BootError>
        effects: [deterministic]
    {
        let mem_node: DTNode = self.nodes.get(self.memory_node)!
        let base: Word64 = mem_node.reg_address(0)
        let size: Word64 = mem_node.reg_size(0)
        Result::Ok((base, size))
    }

    pub fn get_chosen_stdout_path(self) -> FixedString[MAX_PATH_LEN]
        effects: [deterministic]
    {
        let node: DTNode = self.nodes.get(self.chosen_node)!
        node.read_string_property(FixedString::from("stdout-path"))
    }

    pub fn get_chosen_bootargs(self) -> FixedString[MAX_STRING_LEN]
        effects: [deterministic]
    {
        let node: DTNode = self.nodes.get(self.chosen_node)!
        node.read_string_property(FixedString::from("bootargs"))
    }

    pub fn get_chosen_initrd(self) -> (Word64, Word64)
        effects: [deterministic]
    {
        let node: DTNode = self.nodes.get(self.chosen_node)!
        let start: Word64 = Word64::from_u64(node.read_u32_property(FixedString::from("linux,initrd-start"), 0) as u64)
        let end: Word64 = Word64::from_u64(node.read_u32_property(FixedString::from("linux,initrd-end"), 0) as u64)
        (start, end)
    }

    pub fn enumerate_pci_host_bridges(self) -> FixedArray[MAX_DT_NODES, u32>
        effects: [deterministic]
    {
        self.find_all_compatible(FixedString::from("pci-host-ecam-generic"))
    }

    pub fn enumerate_arm_gic(self) -> FixedArray[MAX_DT_NODES, u32>
        effects: [deterministic]
    {
        let mut result: FixedArray[MAX_DT_NODES, u32] = FixedArray::new()
        let gic_types: FixedArray[3, FixedString[MAX_STRING_LEN]] = {
            let mut arr: FixedArray[3, FixedString[MAX_STRING_LEN]] = FixedArray::new()
            arr.push(FixedString::from("arm,cortex-a15-gic"))!
            arr.push(FixedString::from("arm,gic-400"))!
            arr.push(FixedString::from("arm,gic-v3"))!
            arr
        }
        for i in 0..self.num_nodes {
            let node: DTNode = self.nodes.get(i)!
            if node.is_any_compatible(gic_types, 3) {
                result.push(i)!
            }
        }
        result
    }
}

// ──────────────────────────────────────────────
// FDT Parser
// ──────────────────────────────────────────────

pub fn parse_fdt(data: &[u8], size: u32) -> Result[DeviceTree, BootError>
    effects: [deterministic]
{
    if data.len() < 40 {
        return Result::Err(BootError::new(
            DIAG_DT_BASE | 0x020,
            "FDT data too small for header"
        ))
    }

    let mut dt: DeviceTree = DeviceTree::new()

    // Parse header (big-endian)
    dt.header = FDTHeader {
        magic: read_be32(data, 0),
        totalsize: read_be32(data, 4),
        off_dt_struct: read_be32(data, 8),
        off_dt_strings: read_be32(data, 12),
        off_mem_rsvmap: read_be32(data, 16),
        version: read_be32(data, 20),
        last_comp_version: read_be32(data, 24),
        boot_cpuid_phys: read_be32(data, 28),
        size_dt_strings: read_be32(data, 32),
        size_dt_struct: read_be32(data, 36),
    }

    if !dt.header.validate() {
        return Result::Err(BootError::new(
            DIAG_DT_BASE | 0x021,
            "Invalid FDT magic: expected 0xD00DFEED"
        ))
    }

    if !dt.header.is_supported_version() {
        return Result::Err(BootError::new(
            DIAG_DT_BASE | 0x022,
            "Unsupported FDT version"
        ))
    }

    if dt.header.totalsize > size {
        return Result::Err(BootError::new(
            DIAG_DT_BASE | 0x023,
            "FDT total size exceeds available data"
        ))
    }

    // Copy data
    for i in 0..dt.header.totalsize {
        if i < MAX_FILE_DATA_LEN {
            dt.data.push(data[i as usize])!
        }
    }
    dt.data_size = dt.header.totalsize

    // Parse structure block
    let parent_stack: FixedArray[FDT_MAX_DEPTH, u32] = FixedArray::new()
    let mut stack_depth: u32 = 0
    let mut current_parent: u32 = 0
    let mut current_depth: u32 = 0
    let mut current_path: FixedString[MAX_PATH_LEN] = FixedString::new()

    let mut offset: u32 = dt.header.off_dt_struct
    let struct_end: u32 = dt.header.off_dt_struct + dt.header.size_dt_struct

    loop: bounds[BOUND_LARGE] while offset < struct_end && offset + 4 <= size {
        let token: Word32 = read_be32(data, offset)
        offset = offset + 4

        match token {
            FDT_BEGIN_NODE => {
                let mut node_name: FixedString[MAX_PATH_LEN] = FixedString::new()
                loop: bounds[BOUND_MEDIUM] while offset < size {
                    let ch: u8 = data[offset as usize]
                    offset = offset + 1
                    if ch == 0 {
                        // Skip padding to align to 4 bytes
                        offset = (offset + 3) & 0xFFFF_FFFC
                        break
                    }
                    node_name.append_byte(ch)!
                }

                let mut node: DTNode = DTNode::new()
                node.name = node_name
                node.parent_index = current_parent
                node.depth = current_depth

                // Build full path
                let mut full_path: FixedString[MAX_PATH_LEN] = FixedString::new()
                if current_path.len() > 0 {
                    full_path.append_str(current_path)
                    if full_path.byte_at(full_path.len() - 1) != '/' as u8 {
                        full_path.append_byte('/' as u8)!
                    }
                } else {
                    full_path.append_byte('/' as u8)!
                }
                full_path.append_str(node_name)
                node.full_path = full_path

                // Push to parent stack
                if stack_depth < FDT_MAX_DEPTH {
                    parent_stack.set(stack_depth, current_parent)!
                }
                stack_depth = stack_depth + 1
                current_parent = dt.num_nodes
                current_depth = current_depth + 1
                current_path = full_path

                let node_index: u32 = dt.add_node(node)!
                if node_index == 0 {
                    dt.root_index = 0
                }

                // Update parent's children
                if current_parent > 0 {
                    let parent_idx: u32 = parent_stack.get(stack_depth - 2)!
                    if parent_idx < dt.num_nodes {
                        let mut parent: DTNode = dt.nodes.get(parent_idx)!
                        parent.add_child(node_index)!
                        dt.nodes.set(parent_idx, parent)!
                    }
                }
            },

            FDT_END_NODE => {
                // Pop parent stack
                if stack_depth > 0 {
                    stack_depth = stack_depth - 1
                    current_parent = parent_stack.get(stack_depth)!
                } else {
                    current_parent = 0
                }
                if current_depth > 0 {
                    current_depth = current_depth - 1
                }
                // Rebuild current path
                if current_parent > 0 && current_parent < dt.num_nodes {
                    let parent_node: DTNode = dt.nodes.get(current_parent)!
                    current_path = parent_node.full_path
                } else {
                    current_path = FixedString::new()
                }
            },

            FDT_PROP => {
                let prop_len: Word32 = read_be32(data, offset)
                let name_off: Word32 = read_be32(data, offset + 4)
                offset = offset + 8

                let mut prop_value: FixedArray[MAX_PROP_DATA, u8] = FixedArray::new()
                for i in 0..prop_len {
                    if offset + i < size as u32 && i < MAX_PROP_DATA {
                        prop_value.push(data[(offset + i) as usize])!
                    }
                }

                // Read property name from strings block
                let strings_base: u32 = dt.header.off_dt_strings
                let mut prop_name: FixedString[MAX_PROP_NAME] = FixedString::new()
                let mut str_off: u32 = strings_base + name_off
                loop: bounds[BOUND_MEDIUM] while str_off < size {
                    let ch: u8 = data[str_off as usize]
                    if ch == 0 { break }
                    prop_name.append_byte(ch)!
                    str_off = str_off + 1
                }

                let prop: DTProperty = DTProperty {
                    name: prop_name,
                    value: prop_value,
                    value_length: prop_len,
                    name_offset: name_off,
                }

                // Add property to current node
                if current_parent < dt.num_nodes {
                    let mut node: DTNode = dt.nodes.get(current_parent)!
                    node.add_property(prop)!

                    // Detect address/size cells
                    if prop_name == PROP_ADDRESS_CELLS {
                        node.address_cells = prop.as_word32(0)
                    } else if prop_name == PROP_SIZE_CELLS {
                        node.size_cells = prop.as_word32(0)
                    } else if prop_name == PROP_INTERRUPT_CELLS {
                        node.interrupt_cells = prop.as_word32(0)
                    } else if prop_name == PROP_PHANDLE || prop_name == PROP_LINUX_PHANDLE {
                        node.phandle = prop.as_word32(0)
                    } else if prop_name == PROP_MODEL && node.depth == 0 {
                        dt.model = prop.as_string()
                    }

                    // Detect special nodes
                    if node.depth == 1 {
                        if node_name == PROP_MEMORY || prop_name == PROP_DEVICE_TYPE && prop.as_string() == FixedString::from("memory") {
                            dt.memory_node = current_parent
                        }
                        if node_name == PROP_CHOSEN {
                            dt.chosen_node = current_parent
                        }
                        if node_name == FixedString::from("cpu") || node_name.starts_with(FixedString::from("cpu@")) {
                            if dt.boot_cpu_node == 0 {
                                dt.boot_cpu_node = current_parent
                            }
                        }
                    }

                    dt.nodes.set(current_parent, node)!
                }

                // Align to next 4-byte boundary
                let aligned_len: u32 = (prop_len + 3) & 0xFFFF_FFFC
                offset = offset + aligned_len
            },

            FDT_NOP => {
                // No operation, skip
            },

            FDT_END => {
                break
            },

            _ => {
                // Unknown token, skip - try to realign
                break
            },
        }
    }

    dt.valid = true

    residual emit {
        event: "device_tree.parsed",
        nodes: dt.num_nodes,
        version: dt.header.version,
        memory_node: dt.memory_node,
        chosen_node: dt.chosen_node,
        model: dt.model,
    }

    Result::Ok(dt)
}

// ──────────────────────────────────────────────
// Interrupt Map Parsing
// ──────────────────────────────────────────────

pub type InterruptMapEntry : struct {
    child_phandle: Word32,
    child_interrupt: FixedArray[4, Word32],
    child_interrupt_count: u32,
    interrupt_parent_phandle: Word32,
    parent_interrupt: FixedArray[4, Word32],
    parent_interrupt_count: u32,
}

impl InterruptMapEntry {
    pub fn new() -> InterruptMapEntry
        effects: [deterministic]
    {
        InterruptMapEntry {
            child_phandle: 0,
            child_interrupt: FixedArray::new(),
            child_interrupt_count: 0,
            interrupt_parent_phandle: 0,
            parent_interrupt: FixedArray::new(),
            parent_interrupt_count: 0,
        }
    }
}

pub fn parse_interrupt_map(dt: ref DeviceTree, node_index: u32) -> Result<FixedArray[MAX_INTERRUPT_MAP, InterruptMapEntry], BootError>
    effects: [deterministic]
{
    let node: DTNode = dt.nodes.get(node_index)!
    let prop_result: Result[DTProperty, BootError> = node.find_property(PROP_INTERRUPT_MAP)
    if prop_result.is_err() {
        return Result::Err(BootError::new(
            DIAG_DT_BASE | 0x030,
            "No interrupt-map property found"
        ))
    }
    let prop: DTProperty = prop_result.unwrap()

    let mask_result: Result[DTProperty, BootError> = node.find_property(PROP_INTERRUPT_MAP_MASK)
    let _mask_prop: DTProperty = if mask_result.is_ok() { mask_result.unwrap() } else { DTProperty::new() }

    let child_addr_cells: u32 = node.read_u32_property(PROP_ADDRESS_CELLS, 2)
    let child_int_cells: u32 = node.read_u32_property(PROP_INTERRUPT_CELLS, 1)

    let mut entries: FixedArray[MAX_INTERRUPT_MAP, InterruptMapEntry] = FixedArray::new()
    let mut offset: u32 = 0
    let entry_size: u32 = child_addr_cells + child_int_cells + 1 + 1 + 3  // child_addr + child_int + parent_phandle(1) + parent_addr + parent_int

    loop: bounds[BOUND_MEDIUM] while offset + entry_size * 4 <= prop.value_length {
        // Parse child interrupt specifier
        let child_phandle: Word32 = prop.as_word32(offset / 4)
        offset = offset + 4 * child_addr_cells

        let mut child_int: FixedArray[4, Word32] = FixedArray::new()
        let child_int_offset: u32 = offset
        for i in 0..child_int_cells {
            child_int.push(prop.as_word32(offset / 4))!
            offset = offset + 4
        }

        let parent_phandle: Word32 = prop.as_word32(offset / 4)
        offset = offset + 4

        let mut parent_int: FixedArray[4, Word32] = FixedArray::new()
        for i in 0..3 {  // Typically 3 cells for parent interrupt
            parent_int.push(prop.as_word32(offset / 4))!
            offset = offset + 4
        }

        let entry: InterruptMapEntry = InterruptMapEntry {
            child_phandle: child_phandle,
            child_interrupt: child_int,
            child_interrupt_count: child_int_cells,
            interrupt_parent_phandle: parent_phandle,
            parent_interrupt: parent_int,
            parent_interrupt_count: 3,
        }
        entries.push(entry)!
    }

    Result::Ok(entries)
}

// ──────────────────────────────────────────────
// DTB Overlay Application
// ──────────────────────────────────────────────

pub fn apply_dtb_overlay(dt: ref mut DeviceTree, overlay_data: &[u8], overlay_size: u32) -> Result<u32, BootError>
    effects: [deterministic]
{
    let overlay_result: Result[DeviceTree, BootError> = parse_fdt(overlay_data, overlay_size)
    if overlay_result.is_err() {
        return Result::Err(BootError::new(
            DIAG_DT_BASE | 0x040,
            "Failed to parse DTB overlay"
        ))
    }
    let overlay: DeviceTree = overlay_result.unwrap()

    // Find __symbols__ node in base DT
    let symbols_node_result: Result<DTNode, BootError> = dt.find_node_by_path(FixedString::from("/__symbols__"))

    // Apply overlay fragments
    let mut applied_count: u32 = 0
    if overlay.num_nodes > 1 {
        for i in 1..overlay.num_nodes {
            let overlay_node: DTNode = overlay.nodes.get(i)!

            // Find target node
            let target_result: Result<DTNode, BootError> = overlay_node.find_property(PROP_COMPATIBLE)
            if target_result.is_err() { continue }

            let target_path: FixedString[MAX_PATH_LEN] = overlay_node.full_path
            let base_node_result: Result<DTNode, BootError> = dt.find_node_by_path(target_path)
            if base_node_result.is_err() { continue }

            let base_index: u32 = find_node_index(dt, target_path)
            if base_index >= dt.num_nodes { continue }

            // Merge properties from overlay node into base node
            let mut base_node: DTNode = dt.nodes.get(base_index)!
            for j in 0..overlay_node.num_properties {
                let prop: DTProperty = overlay_node.properties.get(j)!
                // Skip certain properties
                if prop.name == PROP_COMPATIBLE || prop.name == PROP_PHANDLE || prop.name == PROP_LABEL {
                    continue
                }
                base_node.add_property(prop)!
            }
            dt.nodes.set(base_index, base_node)!
            applied_count = applied_count + 1
        }
    }

    residual emit {
        event: "device_tree.overlay_applied",
        overlay_nodes: overlay.num_nodes,
        applied_fragments: applied_count,
    }

    Result::Ok(applied_count)
}

fn find_node_index(dt: ref DeviceTree, path: FixedString[MAX_PATH_LEN]) -> u32
    effects: [deterministic]
{
    for i in 0..dt.num_nodes {
        let node: DTNode = dt.nodes.get(i)!
        if node.full_path == path {
            return i
        }
    }
    MAX_DT_NODES
}

// ──────────────────────────────────────────────
// Big-Endian Read Helpers
// ──────────────────────────────────────────────

fn read_be32(data: &[u8], offset: u32) -> Word32
    effects: [deterministic]
{
    if offset + 3 >= data.len() as u32 {
        return 0
    }
    let b0: u32 = data[offset as usize] as u32
    let b1: u32 = data[(offset + 1) as usize] as u32
    let b2: u32 = data[(offset + 2) as usize] as u32
    let b3: u32 = data[(offset + 3) as usize] as u32
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn read_be64(data: &[u8], offset: u32) -> Word64
    effects: [deterministic]
{
    let high: Word64 = Word64::from_u64(read_be32(data, offset) as u64)
    let low: Word64 = Word64::from_u64(read_be32(data, offset + 4) as u64)
    (high << 32) | low
}

// ──────────────────────────────────────────────
// Boot-time function
// ──────────────────────────────────────────────

pub fn load_and_parse_device_tree(dt_data: &[u8], dt_size: u32) -> Result[DeviceTree, BootError>
    effects: [deterministic]
{
    parse_fdt(dt_data, dt_size)
}

// ──────────────────────────────────────────────
// Diagnostic base and error type
// ──────────────────────────────────────────────

const DIAG_DT_BASE: Word64 = 0x0900_0000_0000_0000

pub type BootError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BootError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BootError
        effects: [deterministic]
    {
        BootError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        self.code == 0
    }
}
