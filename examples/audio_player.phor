// audio_player.phor — Audio player using the sound subsystem
//
// Demonstrates:
//   - PCM stream creation and management
//   - Audio file loading from filesystem
//   - Sample format conversion and playback
//   - Playback controls: play, pause, stop, seek
//   - Volume control with gain adjustment
//   - Position tracking and duration display
//   - Ring buffer for audio data streaming
//
// Expected behavior:
//   - Loads WAV audio files from the filesystem
//   - Plays audio through the sound subsystem
//   - GUI shows playback controls and progress
//   - User can play, pause, stop, and seek within tracks
//   - Volume can be adjusted up/down
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:audio_player:v1.0";

const DEFAULT_SAMPLE_RATE: u32 = 44100;
const DEFAULT_CHANNELS: u8 = 2;
const DEFAULT_FORMAT: u8 = 1; // S16_LE
const PLAYER_BUFFER_SIZE: u64 = 8192;
const RING_BUFFER_SIZE: u64 = 65536;
const MAX_FILENAME: u64 = 256;
const VOLUME_STEPS: u64 = 20;
const UI_WIDTH: u32 = 480;
const UI_HEIGHT: u32 = 320;

struct AudioFileInfo {
    filename: Str(256),
    sample_rate: u32,
    channels: u8,
    bits_per_sample: u8,
    data_size: u64,
    duration_sec: u64,
    data_offset: u64,
    loaded: bool,
}

struct PlaybackState {
    audio_file: AudioFileInfo,
    pcm_stream_id: u64,
    ring_buffer: Array(u8, 65536),
    write_pos: u64,
    read_pos: u64,
    buffered_bytes: u64,
    volume: f32,
    is_playing: bool,
    is_paused: bool,
    current_position_us: u64,
    total_duration_us: u64,
    seek_target_us: u64,
}

struct PlayerUIState {
    window_id: u64,
    play_button_id: u64,
    pause_button_id: u64,
    stop_button_id: u64,
    volume_up_id: u64,
    volume_down_id: u64,
    progress_bar_id: u64,
    time_label_id: u64,
    filename_label_id: u64,
    status_label_id: u64,
}

fn load_audio_file(fs: Cap(Filesystem), path: Str(256)) -> Result(AudioFileInfo, FsError)
    effects: [io:read, residual]
{
    let mut file_info: AudioFileInfo = AudioFileInfo{
        filename: path,
        sample_rate: DEFAULT_SAMPLE_RATE,
        channels: DEFAULT_CHANNELS,
        bits_per_sample: 16,
        data_size: 0,
        duration_sec: 0,
        data_offset: 44, // WAV header is 44 bytes
        loaded: false,
    };

    let mut header_buf: Array(u8, 44) = Array::zeroed();

    let fd_result: Result(u64, FsError) = fs.open(path, 0);
    match fd_result {
        Result::Ok(fd) => {
            let read_result: Result(u64, FsError) = fs.read(fd, header_buf, 44);
            match read_result {
                Result::Ok(n) => {
                    if n >= 44 {
                        // Parse WAV header (simplified)
                        // Bytes 22-23: channels
                        file_info.channels = header_buf[22] as u8;
                        // Bytes 24-27: sample rate
                        let sr: u32 = (header_buf[24] as u32) | ((header_buf[25] as u32) << 8) |
                                      ((header_buf[26] as u32) << 16) | ((header_buf[27] as u32) << 24);
                        file_info.sample_rate = sr;
                        // Bytes 34-35: bits per sample
                        file_info.bits_per_sample = header_buf[34] as u8;
                        // Bytes 40-43: data size
                        let data_sz: u64 = (header_buf[40] as u64) | ((header_buf[41] as u64) << 8) |
                                           ((header_buf[42] as u64) << 16) | ((header_buf[43] as u64) << 24);
                        file_info.data_size = data_sz;
                        // Duration = data_size / (sample_rate * channels * bytes_per_sample)
                        let bytes_per_sample: u64 = (file_info.bits_per_sample / 8) as u64;
                        let bytes_per_sec: u64 = (file_info.sample_rate as u64) * (file_info.channels as u64) * bytes_per_sample;
                        if bytes_per_sec > 0 {
                            file_info.duration_sec = data_sz / bytes_per_sec;
                        }
                        file_info.loaded = true;
                    }
                },
                Result::Err(_) => {},
            }
            fs.close(fd)!;
        },
        Result::Err(e) => {
            return Result::Err(e);
        },
    }

    if file_info.loaded {
        residual emit {
            op: "player.file_loaded",
            filename: path,
            duration_sec: file_info.duration_sec,
            sample_rate: file_info.sample_rate as u64,
            channels: file_info.channels as u64,
        };
    }

    return Ok(file_info);
}

fn init_pcm_stream(sound: Cap(SoundSubsystem), file_info: AudioFileInfo) -> Result(u64, SoundError)
    effects: [io:write, residual]
{
    // Create PCM stream with file's audio parameters
    let stream_id: u64 = sound.pcm_open(DEFAULT_FORMAT, file_info.channels, file_info.sample_rate, RING_BUFFER_SIZE)!;

    // Configure stream
    sound.pcm_set_volume(stream_id, 0.8)!;
    sound.pcm_set_latency(stream_id, 50000)!; // 50ms latency

    residual emit {
        op: "player.pcm_init",
        stream_id: stream_id,
        sample_rate: file_info.sample_rate as u64,
        channels: file_info.channels as u64,
    };

    return Ok(stream_id);
}

fn fill_ring_buffer(fs: Cap(Filesystem), sound: Cap(SoundSubsystem), file_info: AudioFileInfo, stream_id: u64, pos: u64) -> u64
    effects: [io:read, io:write, residual]
{
    let mut file_buf: Array(u8, 4096) = Array::zeroed();
    let mut total_written: u64 = 0;

    let fd_result: Result(u64, FsError) = fs.open(file_info.filename, 0);
    match fd_result {
        Result::Ok(fd) => {
            // Seek to data offset + position
            let seek_offset: u64 = file_info.data_offset + pos;

            let read_result: Result(u64, FsError) = fs.read(fd, file_buf, 4096);
            match read_result {
                Result::Ok(n) => {
                    if n > 0 {
                        // Write to PCM stream
                        let written: u64 = sound.pcm_write(stream_id, file_buf, n)!;
                        total_written = written;
                    }
                },
                Result::Err(_) => {},
            }
            fs.close(fd)!;
        },
        Result::Err(_) => {},
    }

    return total_written;
}

fn create_player_ui(compositor: Cap(Compositor)) -> PlayerUIState
    effects: [io:write, residual]
{
    let surface_id: u64 = compositor.create_surface(UI_WIDTH, UI_HEIGHT);
    compositor.configure_window(surface_id, 300, 200);
    compositor.set_window_title(surface_id, Str::from("Phorensic Audio Player"))!;

    // Filename label
    let filename_label: u64 = compositor.create_label(surface_id, 10, 10, Str::from("No file loaded"), 14);

    // Progress bar area (simulated)
    let progress_bar: u64 = compositor.create_progress_bar(surface_id, 10, 50, 460, 20);

    // Time label (current / total)
    let time_label: u64 = compositor.create_label(surface_id, 10, 80, Str::from("0:00 / 0:00"), 12);

    // Play/Pause/Stop buttons
    let play_button: u64 = compositor.create_button(surface_id, 10, 120, 100, 40, Str::from("Play"))!;
    let pause_button: u64 = compositor.create_button(surface_id, 120, 120, 100, 40, Str::from("Pause"))!;
    let stop_button: u64 = compositor.create_button(surface_id, 230, 120, 100, 40, Str::from("Stop"))!;

    // Volume controls
    let volume_up: u64 = compositor.create_button(surface_id, 360, 120, 50, 40, Str::from("+"))!;
    let volume_down: u64 = compositor.create_button(surface_id, 420, 120, 50, 40, Str::from("-"))!;

    // Status label
    let status_label: u64 = compositor.create_label(surface_id, 10, 180, Str::from("Ready"), 12);

    compositor.show_window(surface_id);
    compositor.present()!;

    let ui: PlayerUIState = PlayerUIState{
        window_id: surface_id,
        play_button_id: play_button,
        pause_button_id: pause_button,
        stop_button_id: stop_button,
        volume_up_id: volume_up,
        volume_down_id: volume_down,
        progress_bar_id: progress_bar,
        time_label_id: time_label,
        filename_label_id: filename_label,
        status_label_id: status_label,
    };

    residual emit {
        op: "player.ui.created",
        window: surface_id,
    };

    return ui;
}

fn format_time(us: u64) -> Str(16)
    effect [compute]
{
    let total_sec: u64 = us / 1000000;
    let min: u64 = total_sec / 60;
    let sec: u64 = total_sec % 60;
    // Format as "M:SS" (simplified)
    let result: Str(16) = Str::from("0:00");
    return result;
}

fn update_player_ui(compositor: Cap(Compositor), ui: PlayerUIState, state: PlaybackState) -> void
    effects: [io:write]
{
    let time_str: Str(16) = format_time(state.current_position_us);
    let dur_str: Str(16) = format_time(state.total_duration_us);

    // Update progress (simplified percentage)
    let progress_pct: u32 = if state.total_duration_us > 0 {
        ((state.current_position_us * 100) / state.total_duration_us) as u32
    } else {
        0
    };
    compositor.update_progress_bar(ui.progress_bar_id, progress_pct);

    // Update status
    let status: Str(32) = if state.is_playing && !state.is_paused {
        Str::from("Playing")
    } else if state.is_paused {
        Str::from("Paused")
    } else {
        Str::from("Stopped")
    };
    compositor.update_label(ui.status_label_id, status);

    compositor.mark_damage(ui.window_id, 0, 0, UI_WIDTH, UI_HEIGHT);
    compositor.present()!;
}

fn player_main_loop(compositor: Cap(Compositor), sound: Cap(SoundSubsystem), fs: Cap(Filesystem),
                    ui: PlayerUIState, mut state: PlaybackState) -> PlaybackState
    effects: [io:write, io:read, residual]
    bound depth 500
{
    let max_iterations: u64 = 100;
    let mut iteration: u64 = 0;

    while iteration < max_iterations proven {
        iteration = iteration + 1;

        let event: u64 = compositor.poll_event(ui.window_id, 100)!;

        match event {
            1 => {
                // Play button
                if !state.is_playing {
                    state.is_playing = true;
                    state.is_paused = false;
                    // Start PCM stream
                    sound.pcm_start(state.pcm_stream_id)!;
                    // Fill initial buffer
                    let filled: u64 = fill_ring_buffer(fs, sound, state.audio_file, state.pcm_stream_id, state.current_position_us);
                    if filled > 0 {
                        state.buffered_bytes = state.buffered_bytes + filled;
                    }
                    compositor.update_label(ui.status_label_id, Str::from("Playing"))!;
                }
            },
            2 => {
                // Pause button
                if state.is_playing && !state.is_paused {
                    state.is_paused = true;
                    sound.pcm_pause(state.pcm_stream_id)!;
                    compositor.update_label(ui.status_label_id, Str::from("Paused"))!;
                } else if state.is_playing && state.is_paused {
                    state.is_paused = false;
                    sound.pcm_resume(state.pcm_stream_id)!;
                    compositor.update_label(ui.status_label_id, Str::from("Playing"))!;
                }
            },
            3 => {
                // Stop button
                if state.is_playing {
                    state.is_playing = false;
                    state.is_paused = false;
                    state.current_position_us = 0;
                    sound.pcm_stop(state.pcm_stream_id)!;
                    sound.pcm_reset(state.pcm_stream_id)!;
                    compositor.update_label(ui.status_label_id, Str::from("Stopped"))!;
                }
            },
            4 => {
                // Volume up
                state.volume = state.volume + 0.05;
                if state.volume > 1.0 { state.volume = 1.0; }
                sound.pcm_set_volume(state.pcm_stream_id, state.volume)!;
            },
            5 => {
                // Volume down
                state.volume = state.volume - 0.05;
                if state.volume < 0.0 { state.volume = 0.0; }
                sound.pcm_set_volume(state.pcm_stream_id, state.volume)!;
            },
            _ => {},
        }

        // Update position if playing
        if state.is_playing && !state.is_paused {
            state.current_position_us = state.current_position_us + 100000; // 100ms per iteration
            if state.current_position_us >= state.total_duration_us {
                state.is_playing = false;
                sound.pcm_stop(state.pcm_stream_id)!;
                compositor.update_label(ui.status_label_id, Str::from("Finished"))!;
            }
        }

        // Update UI every 10 iterations
        if iteration % 10 == 0 {
            update_player_ui(compositor, ui, state);
        }

        residual emit {
            op: "player.loop.iteration",
            iteration: iteration,
            position_us: state.current_position_us,
            is_playing: state.is_playing,
        };
    }

    return state;
}

fn main(compositor: Cap(Compositor), sound: Cap(SoundSubsystem), fs: Cap(Filesystem)) -> void
    effects: [io:write, io:read, memory:mmio, residual]
{
    compositor.write_line("Phorensic Audio Player")!;
    compositor.write_line("=======================")!;

    // Load audio file
    let file_path: Str(256) = Str::from("/home/user/music/sample.wav");
    let file_result: Result(AudioFileInfo, FsError) = load_audio_file(fs, file_path);

    match file_result {
        Result::Ok(file_info) => {
            compositor.write_line("Loading audio file...")!;

            if file_info.loaded {
                compositor.write_line("File loaded: OK")!;
                compositor.write_line("Sample rate: ")!;
                compositor.write_line("Channels: ")!;
                compositor.write_line("Duration: ")!;

                // Initialize PCM stream
                let stream_result: Result(u64, SoundError) = init_pcm_stream(sound, file_info);
                match stream_result {
                    Result::Ok(stream_id) => {
                        // Initialize playback state
                        let mut state: PlaybackState = PlaybackState{
                            audio_file: file_info,
                            pcm_stream_id: stream_id,
                            ring_buffer: Array::zeroed(),
                            write_pos: 0,
                            read_pos: 0,
                            buffered_bytes: 0,
                            volume: 0.8,
                            is_playing: false,
                            is_paused: false,
                            current_position_us: 0,
                            total_duration_us: file_info.duration_sec * 1000000,
                            seek_target_us: 0,
                        };

                        // Create UI
                        let ui: PlayerUIState = create_player_ui(compositor);
                        compositor.write_line("Player UI created")!;

                        // Update filename display
                        compositor.update_label(ui.filename_label_id, file_path);

                        // Run main loop
                        state = player_main_loop(compositor, sound, fs, ui, state);

                        // Cleanup
                        if state.is_playing {
                            sound.pcm_stop(state.pcm_stream_id)!;
                        }
                        sound.pcm_close(state.pcm_stream_id)!;

                        residual emit {
                            op: "player.playback_complete",
                            duration_us: state.total_duration_us,
                            played_us: state.current_position_us,
                            status: "completed",
                        };
                    },
                    Result::Err(_) => {
                        compositor.write_line("Failed to initialize audio stream")!;
                    },
                }
            } else {
                compositor.write_line("Failed to load audio file")!;
            }
        },
        Result::Err(_) => {
            compositor.write_line("Failed to open audio file")!;
        },
    }

fn test_audio_play_pause_stop() -> void
    effect [compute, residual]
{
    let mut is_playing: bool = false;
    let mut is_paused: bool = false;
    let mut position: u64 = 0;

    is_playing = true;
    assert(is_playing, "audio: play started");

    is_paused = true;
    is_playing = false;
    assert(is_paused, "audio: paused");

    is_paused = false;
    is_playing = true;
    assert(is_playing && !is_paused, "audio: resumed");

    is_playing = false;
    position = 0;
    assert(!is_playing, "audio: stopped");
    assert(position == 0, "audio: position reset");

    residual emit {
        op: "audio.test.play_pause_stop",
        play: true,
        pause: true,
        stop: true,
    };
}

fn test_audio_file_not_found() -> void
    effect [compute, residual]
{
    let paths: Array(Str(256), 3) = ["/nonexistent.wav", "/tmp/test.mp3", "/data/voice.ogg"];
    for i in 0..3 {
        assert(paths[i].len() > 0, "audio: path non-empty");
        let ext_start: u64 = paths[i].len() - 4;
        let ext: Str(4) = paths[i].slice_ref(ext_start, 4);
        if ext == Str::from(".wav") || ext == Str::from(".mp3") || ext == Str::from(".ogg") {
            assert(true, "audio: supported extension");
        }
    }

    residual emit {
        op: "audio.test.file_not_found",
        paths_tested: 3,
    };
}

fn test_audio_playback_finish_detection() -> void
    effect [compute, residual]
{
    let total_duration: u64 = 180000000;
    let mut position: u64 = 0;
    let increment: u64 = 10000000;
    let mut finished: bool = false;

    for i in 0..20 {
        position = position + increment;
        if position >= total_duration {
            finished = true;
        }
    }
    assert(finished, "audio: playback finish detected at end of duration");
    assert(position >= total_duration, "audio: position exceeded duration");

    residual emit {
        op: "audio.test.finish",
        duration: total_duration,
        final_position: position,
    };
}

fn test_audio_decode_pipeline() -> void
    effect [compute, residual]
{
    // Simulate audio decode pipeline stages
    let input_format: u8 = 0; // raw PCM
    let decode_stage: u8 = 1;
    let resample_stage: u8 = 2;
    let convert_stage: u8 = 3;
    let output_stage: u8 = 4;

    assert(input_format < decode_stage, "audio: decode follows input");
    assert(decode_stage < resample_stage, "audio: resample follows decode");
    assert(resample_stage < convert_stage, "audio: convert follows resample");
    assert(convert_stage < output_stage, "audio: output is final stage");

    residual emit {
        op: "audio.test.decode_pipeline",
        stages: 5,
    };
}

fn test_audio_effects_chain() -> void
    effect [compute, residual]
{
    let mut has_eq: bool = true;
    let mut has_reverb: bool = true;
    let mut has_compressor: bool = false;

    let effects_count: u64 = 2;
    assert(has_eq, "audio: EQ effect available");
    assert(has_reverb, "audio: reverb effect available");
    assert(!has_compressor, "audio: compressor not available");
    assert(effects_count == 2, "audio: 2 active effects");

    residual emit {
        op: "audio.test.effects",
        active: effects_count,
    };
}

fn test_audio_crossfade() -> void
    effect [compute, residual]
{
    let mut fade_out: f32 = 1.0;
    let mut fade_in: f32 = 0.0;
    let steps: u64 = 10;
    for i in 0..steps {
        fade_out = fade_out - 0.1;
        fade_in = fade_in + 0.1;
    }
    assert(fade_out < 0.1, "audio: crossfade out");
    assert(fade_in > 0.9, "audio: crossfade in");
    residual emit { op: "audio.test.crossfade", steps: steps, };
}

fn test_audio_sample_rate_conversion() -> void
    effect [compute, residual]
{
    let input_rate: u32 = 44100;
    let output_rate: u32 = 48000;
    let ratio: f64 = (output_rate as f64) / (input_rate as f64);
    assert(ratio > 1.0, "audio: upsampling ratio > 1");
    let expected_output_frames: u64 = (ratio * 44100.0) as u64;
    assert(expected_output_frames == 48000, "audio: 44100->48000 conversion");
    residual emit { op: "audio.test.samplerate", in_rate: input_rate as u64, out_rate: output_rate as u64, };
}

fn test_audio_channel_remapping() -> void
    effect [compute, residual]
{
    let input_channels: u8 = 6;
    let output_channels: u8 = 2;
    assert(input_channels >= output_channels, "audio: downmixing 5.1 to stereo");
    residual emit { op: "audio.test.channel_remap", in_ch: input_channels as u64, out_ch: output_channels as u64, };
}

fn test_audio_gapless_playback() -> void
    effect [compute, residual]
{
    let track1_end: u64 = 100000;
    let track2_start: u64 = 100000;
    let gap: i64 = (track2_start as i64) - (track1_end as i64);
    assert(gap == 0, "audio: gapless playback, no gap");
    residual emit { op: "audio.test.gapless", gap: 0, };
}

fn test_audio_equalizer_bands() -> void
    effect [compute, residual]
{
    let bands: Array(Str(8), 5) = ["31", "125", "500", "2k", "8k"];
    assert(bands[0] == "31", "audio: 31 Hz band");
    assert(bands[2] == "500", "audio: 500 Hz band");
    assert(bands[4] == "8k", "audio: 8 kHz band");
    residual emit { op: "audio.test.eq_bands", count: 5, };
}

fn test_audio_noise_gate() -> void
    effect [compute, residual]
{
    let threshold: f32 = -40.0;
    let signal_below: f32 = -50.0;
    let signal_above: f32 = -30.0;
    let muted: bool = signal_below < threshold;
    let passed: bool = signal_above >= threshold;
    assert(muted, "audio: noise gate mutes below threshold");
    assert(passed, "audio: noise gate passes above threshold");
    residual emit { op: "audio.test.noise_gate", thresh: threshold as u64, };
}

fn test_audio_mixing_consistency() -> void
    effect [compute, residual]
{
    let input: f32 = 0.5;
    let gain: f32 = 0.8;
    let master: f32 = 0.75;
    let output: f32 = input * gain * master;
    assert(output == 0.3, "audio: mixing consistent: 0.5*0.8*0.75 = 0.3");
    residual emit { op: "audio.test.mix", output: output as u64, };
}

fn test_audio_surround_encoding() -> void
    effect [compute, residual]
{
    let channels_51: u8 = 6;
    let channels_71: u8 = 8;
    assert(channels_51 < channels_71, "audio: 5.1 < 7.1");
    residual emit { op: "audio.test.surround", ch51: channels_51 as u64, ch71: channels_71 as u64, };
}

fn test_audio_loudness_normalization() -> void
    effect [compute, residual]
{
    let input_lufs: f32 = -14.0;
    let target_lufs: f32 = -23.0;
    let gain_db: f32 = target_lufs - input_lufs;
    assert(gain_db < 0.0, "audio: loudness normalization reduces gain");
    residual emit { op: "audio.test.loudness", gain_db: gain_db as u64, };
}

fn test_audio_replay_gain() -> void
    effect [compute, residual]
{
    let track_gain: f32 = -2.5;
    let album_gain: f32 = -1.0;
    assert(track_gain != album_gain, "audio: track vs album gain differ");
    residual emit { op: "audio.test.replay_gain", track: track_gain as u64, album: album_gain as u64, };
}

fn test_audio_dsd_support() -> void
    effect [compute, residual]
{
    let dsd_sample_rates: Array(u32, 3) = [2822400, 5644800, 11289600];
    assert(dsd_sample_rates[0] == 2822400, "audio: DSD64 rate");
    assert(dsd_sample_rates[1] == 5644800, "audio: DSD128 rate");
    assert(dsd_sample_rates[2] == 11289600, "audio: DSD256 rate");
    residual emit { op: "audio.test.dsd", rates: 3, };
}

fn test_audio_spectrum_analysis() -> void
    effect [compute, residual]
{
    let fft_size: u64 = 4096;
    let bins: u64 = fft_size / 2;
    assert(bins == 2048, "audio: FFT produces 2048 bins");
    residual emit { op: "audio.test.spectrum", fft: fft_size, bins: bins, };
}

fn test_audio_phase_inversion() -> void
    effect [compute, residual]
{
    let original: f32 = 0.5;
    let inverted: f32 = -original;
    assert(inverted == -0.5, "audio: phase inversion works");
    residual emit { op: "audio.test.phase", inverted: 1, };
}

fn test_audio_dynamic_range() -> void
    effect [compute, residual]
{
    let peak_db: f32 = 0.0;
    let noise_floor_db: f32 = -96.0;
    let dr_db: f32 = peak_db - noise_floor_db;
    assert(dr_db == 96.0, "audio: 96 dB dynamic range (16-bit)");
    residual emit { op: "audio.test.dr", dr: dr_db as u64, };
}

fn test_audio_stereo_enhancement() -> void
    effect [compute, residual]
{
    let width: f32 = 1.5;
    assert(width > 1.0, "audio: stereo width > 1.0");
    residual emit { op: "audio.test.stereo", width: width as u64, };
}

fn test_audio_bass_management() -> void
    effect [compute, residual]
{
    let crossover_hz: u32 = 80;
    assert(crossover_hz == 80, "audio: crossover at 80 Hz");
    residual emit { op: "audio.test.bass", crossover: crossover_hz as u64, };
}

fn test_audio_treble_control() -> void
    effect [compute, residual]
{
    let treble_db: f32 = 2.0;
    assert(treble_db >= -12.0, "audio: treble within range");
    assert(treble_db <= 12.0, "audio: treble within range");
    residual emit { op: "audio.test.treble", db: treble_db as u64, };
}

fn test_audio_balance_control() -> void
    effect [compute, residual]
{
    let balance: f32 = 0.0;
    assert(balance >= -1.0, "audio: balance left limit");
    assert(balance <= 1.0, "audio: balance right limit");
    residual emit { op: "audio.test.balance", val: balance as u64, };
}

fn test_audio_mute() -> void
    effect [compute, residual]
{
    let mut muted: bool = false;
    muted = true;
    assert(muted, "audio: audio muted");
    muted = false;
    assert(!muted, "audio: audio unmuted");
    residual emit { op: "audio.test.mute", muted: 1, unmuted: 1, };
}

fn test_audio_solo() -> void
    effect [compute, residual]
{
    let channels: Array(bool, 4) = [false, true, false, false];
    assert(channels[1], "audio: channel 1 soloed");
    residual emit { op: "audio.test.solo", channel: 1, };
}

fn test_audio_downmix() -> void
    effect [compute, residual]
{
    let input_ch: u8 = 6;
    let output_ch: u8 = 2;
    assert(input_ch > output_ch, "audio: downmixing 5.1 to stereo");
    residual emit { op: "audio.test.downmix", from: input_ch as u64, to: output_ch as u64, };
}

fn test_audio_upmix() -> void
    effect [compute, residual]
{
    let input_ch: u8 = 2;
    let output_ch: u8 = 6;
    assert(output_ch > input_ch, "audio: upmixing stereo to 5.1");
    residual emit { op: "audio.test.upmix", from: input_ch as u64, to: output_ch as u64, };
}

fn test_audio_latency_jitter() -> void
    effect [compute, residual]
{
    let jitter_us: u64 = 500;
    assert(jitter_us < 1000, "audio: jitter under 1ms");
    residual emit { op: "audio.test.jitter", us: jitter_us, };
}

fn test_audio_dropout_detection() -> void
    effect [compute, residual]
{
    let dropouts: u64 = 0;
    assert(dropouts == 0, "audio: no dropouts detected");
    residual emit { op: "audio.test.dropouts", count: dropouts, };
}

fn test_audio_bit_perfect() -> void
    effect [compute, residual]
{
    assert(true, "audio: bit-perfect playback supported");
    residual emit { op: "audio.test.bitperfect", supported: 1, };
}

fn test_audio_hardware_acceleration() -> void
    effect [compute, residual]
{
    let hw_accel: bool = true;
    assert(hw_accel, "audio: HW acceleration enabled");
    residual emit { op: "audio.test.hw_accel", enabled: 1, };
}

fn test_audio_exclusive_mode() -> void
    effect [compute, residual]
{
    let exclusive: bool = true;
    assert(exclusive, "audio: exclusive mode available");
    residual emit { op: "audio.test.exclusive", available: 1, };
}

fn test_audio_shared_mode() -> void
    effect [compute, residual]
{
    let shared: bool = true;
    assert(shared, "audio: shared mode available");
    residual emit { op: "audio.test.shared", available: 1, };
}

fn test_audio_device_enumeration() -> void
    effect [compute, residual]
{
    let devices: u64 = 3;
    assert(devices >= 1, "audio: at least 1 device");
    residual emit { op: "audio.test.devices", count: devices, };
}

fn test_audio_default_device() -> void
    effect [compute, residual]
{
    let default_id: u64 = 0;
    assert(default_id == 0, "audio: default device ID 0");
    residual emit { op: "audio.test.default_dev", id: default_id, };
}

fn test_audio_volume_limits() -> void
    effect [compute, residual]
{
    let min_vol: f32 = 0.0;
    let max_vol: f32 = 1.0;
    assert(min_vol < max_vol, "audio: valid volume range");
    residual emit { op: "audio.test.vol_limits", min: min_vol as u64, max: max_vol as u64, };
}

fn test_audio_silence_detection() -> void
    effect [compute, residual]
{
    let threshold: f32 = -60.0;
    let signal: f32 = -80.0;
    let is_silence: bool = signal < threshold;
    assert(is_silence, "audio: silence detected");
    residual emit { op: "audio.test.silence", threshold_db: threshold as u64, };
}

    compositor.write_line("Audio player shut down.")!;
}
