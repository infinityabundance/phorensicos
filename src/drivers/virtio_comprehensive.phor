// virtio_comprehensive.phor — Comprehensive virtio driver
// Virtio 1.x/1.2 support, packed virtqueues, split virtqueues,
// event suppression, in-order completion, shared memory regions,
// device reset, AER (advanced error reporting), config space v2.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/virtio_comprehensive.phor
// Court: virtio_comprehensive_driver:v2

package drivers.virtio_comprehensive;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type VirtioComprehensiveError = enum {
    VirtioNotInitialized          = 0x900,
    VirtioDeviceNotFound          = 0x901,
    VirtioInvalidDevice           = 0x902,
    VirtioQueueError              = 0x903,
    VirtioQueueFull               = 0x904,
    VirtioDescriptorError         = 0x905,
    VirtioCapabilityError         = 0x906,
    VirtioConfigError             = 0x907,
    VirtioMmioError               = 0x908,
    VirtioPciError                = 0x909,
    VirtioResetFailed             = 0x90A,
    VirtioNegotiateFailed         = 0x90B,
    VirtioFeatureNotSupported     = 0x90C,
    VirtioInterruptError          = 0x90D,
    VirtioDmaError                = 0x90E,
    VirtioShmError                = 0x90F,
    VirtioAerError                = 0x910,
    VirtioEventSuppressionError   = 0x911,
    VirtioPackedQueueError        = 0x912,
    VirtioSplitQueueError         = 0x913,
    VirtioInOrderCompletionError  = 0x914,
    VirtioConfigGenConflict       = 0x915,
    VirtioMaxDevicesExceeded      = 0x916,
    VirtioResidualStoreFull       = 0x917,
    VirtioVirtqueueNotFound       = 0x918,
    VirtioTransportError          = 0x919,
    VirtioShmRegionNotAvailable   = 0x91A,
    VirtioAerRecoveryFailed       = 0x91B,
}

// ─────────────────────────────────────────────────────────────
// Virtio Comprehensive Capability
// ─────────────────────────────────────────────────────────────

struct VirtioComprehensiveCapability {
    object_id: Identity,
    generation: u64,
    can_init: bool,
    can_reset: bool,
    can_negotiate: bool,
    can_operate_vq: bool,
    can_access_config: bool,
    can_shm: bool,
    can_aer: bool,
    can_event_suppression: bool,
    max_virtqueues: u64,
}

// ─────────────────────────────────────────────────────────────
// Virtio Transport Types
// ─────────────────────────────────────────────────────────────

type VirtioTransportType = enum {
    PciLegacy       = 0,
    PciModern       = 1,
    MmioLegacy      = 2,
    MmioModern      = 3,
    Ccw             = 4,
    ChannelIo       = 5,
    UnknownTransport = 6,
}

// ─────────────────────────────────────────────────────────────
// Virtio Device ID
// ─────────────────────────────────────────────────────────────

type VirtioDeviceId = enum {
    Reserved             = 0,
    NetworkCard          = 1,
    BlockDevice          = 2,
    Console              = 3,
    EntropySource        = 4,
    MemoryBalloon        = 5,
    IoMemory             = 6,
    Rpmsg                = 7,
    ScsiHost             = 8,
    NinePTransport       = 9,
    Mac80211Wlan         = 10,
    RprocSerial          = 11,
    Caif                 = 12,
    MemoryBalloonV2      = 13,
    Gpu                  = 16,
    InputDevice          = 18,
    Vsock                = 19,
    CryptoServices       = 20,
    IovaTranslation      = 21,
    FileSystem           = 26,
    Pmem                 = 27,
    Mac80211Hwsim        = 29,
    SoundDevice          = 30,
    FsProvider           = 31,
    I2cAdapter           = 34,
    Watchdog             = 35,
    Scmi                 = 36,
    Iommu                = 37,
    Wifi                 = 38,
    Battery              = 39,
    Msgbox               = 41,
    TcpTun               = 42,
    Suspend              = 43,
    Report               = 44,
}

// ─────────────────────────────────────────────────────────────
// Virtio 1.x / 1.2 Feature Bits
// ─────────────────────────────────────────────────────────────

type VirtioFeatureBits = enum {
    NotifyOnEmpty          = 24,
    AnyLayout              = 27,
    RingIndex              = 28,
    BadFeature             = 30,
    Version1               = 32,
    AccessPciConfig        = 33,
    RingEventIdx           = 33,
    Version1_1             = 34,
    RingPacked             = 34,
    OrderPacked            = 35,
    OrderSplit             = 35,
    SrIoV                  = 37,
    InOrder                = 38,
    NotificationData       = 39,
    NotifConfigData        = 40,
    SharedMemoryRegion     = 41,
    DeviceReset            = 42,
    AdminCommandQueue      = 46,
    Fips140                = 47,
    Tunneling              = 48,
    GenTunnel              = 49,
    Suspend                = 50,
}

// ─────────────────────────────────────────────────────────────
// Virtio PCI Common Config Offsets (Modern)
// ─────────────────────────────────────────────────────────────

struct VirtioCommonCfg {
    device_feature_select: u32,
    device_feature: u32,
    driver_feature_select: u32,
    driver_feature: u32,
    msix_config: u16,
    num_queues: u16,
    device_status: u8,
    config_generation: u8,
    queue_select: u16,
    queue_size: u16,
    queue_msix_vector: u16,
    queue_enable: u16,
    queue_notify_off: u16,
    queue_desc: u64,
    queue_driver: u64,
    queue_device: u64,
    queue_notif_data: u16,
    queue_reset: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio PCI Capabilities
// ─────────────────────────────────────────────────────────────

struct VirtioPciCap {
    cap_vndr: u8,
    cap_next: u8,
    cap_len: u8,
    cfg_type: u8,
    bar: u8,
    padding: [u8; 3],
    offset: u32,
    length: u32,
}

struct VirtioPciCapExtended {
    cap: VirtioPciCap,
    pci_cfg_offset: u32,
}

// ─────────────────────────────────────────────────────────────
// Virtio Split Virtqueue Descriptor
// ─────────────────────────────────────────────────────────────

struct VirtioSplitDesc {
    addr: u64,
    len: u32,
    flags: u16,
    next: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio Split Virtqueue Available Ring
// ─────────────────────────────────────────────────────────────

struct VirtioSplitAvail {
    flags: u16,
    idx: u16,
    ring: Array(u16, 256),
    used_event: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio Split Virtqueue Used Ring
// ─────────────────────────────────────────────────────────────

struct VirtioSplitUsedElem {
    id: u32,
    len: u32,
}

struct VirtioSplitUsed {
    flags: u16,
    idx: u16,
    ring: Array(VirtioSplitUsedElem, 256),
    avail_event: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio Split Virtqueue
// ─────────────────────────────────────────────────────────────

struct VirtioSplitVirtqueue {
    queue_index: u16,
    queue_size: u16,
    desc: Array(VirtioSplitDesc, 256),
    avail: VirtioSplitAvail,
    used: VirtioSplitUsed,
    desc_phys: u64,
    avail_phys: u64,
    used_phys: u64,
    last_avail_idx: u16,
    last_used_idx: u16,
    enabled: bool,
    in_order: bool,
    event_suppression: bool,
    irq_vector: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio Packed Virtqueue Descriptor
// ─────────────────────────────────────────────────────────────

struct VirtioPackedDesc {
    addr: u64,
    len: u32,
    id: u16,
    flags: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio Packed Virtqueue Event
// ─────────────────────────────────────────────────────────────

struct VirtioPackedEvent {
    desc: u16,
    flags: u16,
    off_wrap: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio Packed Virtqueue
// ─────────────────────────────────────────────────────────────

struct VirtioPackedVirtqueue {
    queue_index: u16,
    queue_size: u16,
    descs: Array(VirtioPackedDesc, 256),
    desc_phys: u64,
    driver_event_phys: u64,
    device_event_phys: u64,
    avail_idx: u16,
    used_idx: u16,
    avail_wrap: bool,
    used_wrap: bool,
    enabled: bool,
    in_order: bool,
    event_suppression: bool,
    irq_vector: u16,
}

// ─────────────────────────────────────────────────────────────
// Virtio Queue Type
// ─────────────────────────────────────────────────────────────

type VirtioQueueMode = enum {
    Split  = 0,
    Packed = 1,
}

// ─────────────────────────────────────────────────────────────
// Virtio Queue (Union)
// ─────────────────────────────────────────────────────────────

struct VirtioQueue {
    mode: VirtioQueueMode,
    split: VirtioSplitVirtqueue,
    packed: VirtioPackedVirtqueue,
    notify_offset: u16,
    notify_data: u16,
    initialized: bool,
}

// ─────────────────────────────────────────────────────────────
// Shared Memory Region
// ─────────────────────────────────────────────────────────────

struct VirtioSharedMemoryRegion {
    shm_id: u8,
    bar: u8,
    offset: u64,
    length: u64,
    mapped_base: u64,
    mapped: bool,
}

// ─────────────────────────────────────────────────────────────
// Advanced Error Reporting State
// ─────────────────────────────────────────────────────────────

struct VirtioAerState {
    uncorrectable_status: u32,
    uncorrectable_mask: u32,
    uncorrectable_severity: u32,
    correctable_status: u32,
    correctable_mask: u32,
    aer_cap_off: u16,
    aer_enabled: bool,
}

// ─────────────────────────────────────────────────────────────
// Device Status
// ─────────────────────────────────────────────────────────────

type VirtioDeviceStatus = enum {
    Acknowledge      = 0x01,
    Driver           = 0x02,
    DriverOk         = 0x04,
    FeaturesOk       = 0x08,
    DeviceNeedsReset = 0x40,
    Failed           = 0x80,
}

// ─────────────────────────────────────────────────────────────
// Virtio Device State
// ─────────────────────────────────────────────────────────────

struct VirtioDevice {
    device_identity: Identity,
    device_id: VirtioDeviceId,
    transport: VirtioTransportType,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    io_base: u64,
    bars: Array(u64, 6),
    common_cfg: Handle(VirtioCommonCfg),
    device_features: Array(u64, 2),
    driver_features: Array(u64, 2),
    negotiated_features: u64,
    status: u8,
    config_generation: u8,
    virtqueues: Array(VirtioQueue, 32),
    queue_count: u16,
    shm_regions: Array(VirtioSharedMemoryRegion, 8),
    shm_region_count: u8,
    aer: VirtioAerState,
    msix_vectors: Array(u16, 32),
    notif_base: u64,
    notif_size: u64,
    isr_status: u32,
    initialized: bool,
    failed: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct VirtioComprehensiveDriverState {
    driver_identity: Identity,
    devices: Array(VirtioDevice, 8),
    device_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_operations: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// MMIO Register Access Helpers
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_mmio_read32(base: u64, offset: u64) -> u32
    effect [memory:mmio]
{
    return trusted reason "Virtio MMIO register read, Virtio 1.2 Spec §4.2" {
        let ptr: *(u32) = (base + offset) as *(u32);
        return *ptr;
    };
}

fn virtio_comprehensive_mmio_write32(base: u64, offset: u64, value: u32) -> void
    effect [memory:mmio]
{
    trusted reason "Virtio MMIO register write, Virtio 1.2 Spec §4.2" {
        let ptr: *(u32) = (base + offset) as *(u32);
        *ptr = value;
    };
}

fn virtio_comprehensive_mmio_read64(base: u64, offset: u64) -> u64
    effect [memory:mmio]
{
    return trusted reason "Virtio MMIO 64-bit register read" {
        let ptr: *(u64) = (base + offset) as *(u64);
        return *ptr;
    };
}

fn virtio_comprehensive_mmio_write64(base: u64, offset: u64, value: u64) -> void
    effect [memory:mmio]
{
    trusted reason "Virtio MMIO 64-bit register write" {
        let ptr: *(u64) = (base + offset) as *(u64);
        *ptr = value;
    };
}

// ─────────────────────────────────────────────────────────────
// Reset Device
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_reset(
    device: Handle(VirtioDevice),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_reset:v1"
{
    if !cap.can_reset {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;
    cfg.device_status = 0x00;

    loop bound 1000 {
        let status: u8 = cfg.device_status;
        if status == 0 {
            break;
        };
    };

    device.status = 0;
    device.initialized = false;

    residual emit {
        op: "virtio_comprehensive.reset",
        device_id: device.device_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Device Query: Read Device Features
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_get_device_features(
    device: Handle(VirtioDevice),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(u64, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_get_features:v1"
{
    if !cap.can_negotiate {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;

    cfg.device_feature_select = 0;
    let features_low: u32 = cfg.device_feature;
    device.device_features[0] = features_low as u64;

    cfg.device_feature_select = 1;
    let features_high: u32 = cfg.device_feature;
    device.device_features[1] = features_high as u64;

    let combined: u64 = (features_low as u64) | ((features_high as u64) << 32);

    residual emit {
        op: "virtio_comprehensive.get_device_features",
        features_low: features_low as u64,
        features_high: features_high as u64,
        timestamp: timestamp,
    };

    return Result::Ok(combined);
}

// ─────────────────────────────────────────────────────────────
// Feature Negotiation
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_negotiate_features(
    device: Handle(VirtioDevice),
    requested_features: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(u64, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_negotiate:v1"
{
    if !cap.can_negotiate {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;

    cfg.driver_feature_select = 0;
    cfg.driver_feature = (requested_features & 0xFFFFFFFF) as u32;

    cfg.driver_feature_select = 1;
    cfg.driver_feature = ((requested_features >> 32) & 0xFFFFFFFF) as u32;

    device.driver_features[0] = requested_features & 0xFFFFFFFF;
    device.driver_features[1] = (requested_features >> 32) & 0xFFFFFFFF;

    cfg.device_feature_select = 0;
    let ack_low: u32 = cfg.device_feature;
    cfg.device_feature_select = 1;
    let ack_high: u32 = cfg.device_feature;

    let negotiated: u64 = (ack_low as u64) | ((ack_high as u64) << 32);
    device.negotiated_features = negotiated;

    residual emit {
        op: "virtio_comprehensive.negotiate_features",
        requested: requested_features,
        negotiated: negotiated,
        timestamp: timestamp,
    };

    return Result::Ok(negotiated);
}

// ─────────────────────────────────────────────────────────────
// Set Device Status
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_set_status(
    device: Handle(VirtioDevice),
    status: u8,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_set_status:v1"
{
    if !cap.can_init {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;
    cfg.device_status = status;
    device.status = status;

    residual emit {
        op: "virtio_comprehensive.set_status",
        status: status as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Check Device Status Bit
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_check_status(
    device: Handle(VirtioDevice),
    status_mask: u8,
) -> bool
    effect [memory:mmio]
    court "virtio_comprehensive_check_status:v1"
{
    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;
    let status: u8 = cfg.device_status;
    device.status = status;
    return (status & status_mask) != 0;
}

// ─────────────────────────────────────────────────────────────
// Initialize Split Virtqueue
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_init_split_vq(
    device: Handle(VirtioDevice),
    queue_idx: u16,
    queue_size: u16,
    desc_phys: u64,
    avail_phys: u64,
    used_phys: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_init_split_vq:v1"
{
    if !cap.can_operate_vq {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;

    cfg.queue_select = queue_idx;
    cfg.queue_size = queue_size;
    cfg.queue_desc = desc_phys;
    cfg.queue_driver = avail_phys;
    cfg.queue_device = used_phys;

    cfg.queue_enable = 1;

    let notify_off: u16 = cfg.queue_notify_off;
    let notif_data: u16 = cfg.queue_notif_data;

    let vq: Handle(VirtioQueue) = Handle(VirtioQueue)::from_ptr(&device.virtqueues[queue_idx as u64]);
    vq.mode = VirtioQueueMode::Split;
    vq.split.queue_index = queue_idx;
    vq.split.queue_size = queue_size;
    vq.split.desc_phys = desc_phys;
    vq.split.avail_phys = avail_phys;
    vq.split.used_phys = used_phys;
    vq.split.last_avail_idx = 0;
    vq.split.last_used_idx = 0;
    vq.split.enabled = true;
    vq.split.in_order = (device.negotiated_features & (1 << 38)) != 0;
    vq.notify_offset = notify_off;
    vq.notify_data = notif_data;
    vq.initialized = true;

    if queue_idx >= device.queue_count {
        device.queue_count = queue_idx + 1;
    };

    residual emit {
        op: "virtio_comprehensive.init_split_vq",
        queue_idx: queue_idx as u64,
        queue_size: queue_size as u64,
        desc_phys: desc_phys,
        avail_phys: avail_phys,
        used_phys: used_phys,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Initialize Packed Virtqueue
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_init_packed_vq(
    device: Handle(VirtioDevice),
    queue_idx: u16,
    queue_size: u16,
    desc_phys: u64,
    driver_event_phys: u64,
    device_event_phys: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_init_packed_vq:v1"
{
    if !cap.can_operate_vq {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;

    cfg.queue_select = queue_idx;
    cfg.queue_size = queue_size;
    cfg.queue_desc = desc_phys;
    cfg.queue_driver = driver_event_phys;
    cfg.queue_device = device_event_phys;

    cfg.queue_enable = 1;

    let notify_off: u16 = cfg.queue_notify_off;
    let notif_data: u16 = cfg.queue_notif_data;

    let vq: Handle(VirtioQueue) = Handle(VirtioQueue)::from_ptr(&device.virtqueues[queue_idx as u64]);
    vq.mode = VirtioQueueMode::Packed;
    vq.packed.queue_index = queue_idx;
    vq.packed.queue_size = queue_size;
    vq.packed.descs_phys = desc_phys;
    vq.packed.driver_event_phys = driver_event_phys;
    vq.packed.device_event_phys = device_event_phys;
    vq.packed.avail_idx = 0;
    vq.packed.used_idx = 0;
    vq.packed.avail_wrap = true;
    vq.packed.used_wrap = true;
    vq.packed.enabled = true;
    vq.packed.in_order = (device.negotiated_features & (1 << 38)) != 0;
    vq.notify_offset = notify_off;
    vq.notify_data = notif_data;
    vq.initialized = true;

    if queue_idx >= device.queue_count {
        device.queue_count = queue_idx + 1;
    };

    residual emit {
        op: "virtio_comprehensive.init_packed_vq",
        queue_idx: queue_idx as u64,
        queue_size: queue_size as u64,
        desc_phys: desc_phys,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Submit Descriptors to Split Virtqueue
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_submit_split(
    vq: Handle(VirtioQueue),
    head_idx: u16,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_submit_split:v1"
{
    if !vq.initialized {
        return Result::Err(VirtioComprehensiveError::VirtioQueueError);
    };

    let split: Handle(VirtioSplitVirtqueue) = Handle(VirtioSplitVirtqueue)::from_ptr(&vq.split);

    let avail_idx: u16 = split.avail.idx;
    split.avail.ring[avail_idx as u64] = head_idx;
    split.avail.idx = avail_idx + 1;

    split.last_avail_idx = split.avail.idx;

    residual emit {
        op: "virtio_comprehensive.submit_split",
        queue_idx: split.queue_index as u64,
        head_idx: head_idx as u64,
        avail_idx: split.avail.idx as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Submit Descriptors to Packed Virtqueue
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_submit_packed(
    vq: Handle(VirtioQueue),
    head_idx: u16,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_submit_packed:v1"
{
    if !vq.initialized {
        return Result::Err(VirtioComprehensiveError::VirtioQueueError);
    };

    let packed: Handle(VirtioPackedVirtqueue) = Handle(VirtioPackedVirtqueue)::from_ptr(&vq.packed);

    let desc: Handle(VirtioPackedDesc) = Handle(VirtioPackedDesc)::from_ptr(&packed.descs[head_idx as u64]);
    let avail: u16 = packed.avail_idx;
    let wrap: u16;
    if packed.avail_wrap {
        wrap = 0x8000;
    } else {
        wrap = 0x0000;
    };

    desc.flags = desc.flags | 0x4000 | wrap;
    packed.avail_idx = avail + 1;
    if packed.avail_idx == 0 {
        packed.avail_wrap = !packed.avail_wrap;
    };

    residual emit {
        op: "virtio_comprehensive.submit_packed",
        queue_idx: packed.queue_index as u64,
        head_idx: head_idx as u64,
        avail_idx: packed.avail_idx as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Notify Device (Kick)
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_notify(
    device: Handle(VirtioDevice),
    vq: Handle(VirtioQueue),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_notify:v1"
{
    let notif_addr: u64 = device.notif_base + ((vq.notify_offset as u64) * 2);
    let notif_val: u16;

    if (device.negotiated_features & (1 << 39)) != 0 {
        notif_val = vq.notify_data;
    } else {
        notif_val = vq.split.queue_index;
    };

    trusted reason "Virtio device notification (kick), Virtio 1.2 Spec §2.6" {
        let ptr: *(u16) = notif_addr as *(u16);
        *ptr = notif_val;
    };

    residual emit {
        op: "virtio_comprehensive.notify",
        queue_idx: vq.split.queue_index as u64,
        notify_val: notif_val as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Poll Split Completion
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_poll_split(
    vq: Handle(VirtioQueue),
    timeout_ms: u64,
) -> Result(VirtioSplitUsedElem, VirtioComprehensiveError)
    effect [deterministic]
    court "virtio_comprehensive_poll_split:v1"
{
    let split: Handle(VirtioSplitVirtqueue) = Handle(VirtioSplitVirtqueue)::from_ptr(&vq.split);

    loop bound 10000 {
        let used_idx: u16 = split.used.idx;
        if used_idx != split.last_used_idx {
            let elem: VirtioSplitUsedElem = split.used.ring[split.last_used_idx as u64];
            split.last_used_idx = split.last_used_idx + 1;
            return Result::Ok(elem);
        };
    };

    return Result::Err(VirtioComprehensiveError::VirtioQueueError);
}

// ─────────────────────────────────────────────────────────────
// Poll Packed Completion
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_poll_packed(
    vq: Handle(VirtioQueue),
    timeout_ms: u64,
) -> Result(VirtioPackedDesc, VirtioComprehensiveError)
    effect [deterministic]
    court "virtio_comprehensive_poll_packed:v1"
{
    let packed: Handle(VirtioPackedVirtqueue) = Handle(VirtioPackedVirtqueue)::from_ptr(&vq.packed);

    loop bound 10000 {
        let desc: VirtioPackedDesc = packed.descs[packed.used_idx as u64];
        let used_wrap_flag: u16;
        if packed.used_wrap {
            used_wrap_flag = 0x8000;
        } else {
            used_wrap_flag = 0x0000;
        };

        if (desc.flags & 0x8000) == used_wrap_flag {
            let result_desc: VirtioPackedDesc = desc;
            packed.used_idx = packed.used_idx + 1;
            if packed.used_idx == 0 {
                packed.used_wrap = !packed.used_wrap;
            };
            return Result::Ok(result_desc);
        };
    };

    return Result::Err(VirtioComprehensiveError::VirtioPackedQueueError);
}

// ─────────────────────────────────────────────────────────────
// Enable Event Suppression (Split)
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_enable_event_suppression_split(
    vq: Handle(VirtioQueue),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [deterministic, residual]
    court "virtio_comprehensive_enable_event_suppression_split:v1"
{
    if !cap.can_event_suppression {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let split: Handle(VirtioSplitVirtqueue) = Handle(VirtioSplitVirtqueue)::from_ptr(&vq.split);

    split.avail.flags = split.avail.flags | 0x02;
    split.used.flags = split.used.flags | 0x01;

    split.event_suppression = true;

    residual emit {
        op: "virtio_comprehensive.enable_event_suppression_split",
        queue_idx: split.queue_index as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enable Event Suppression (Packed)
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_enable_event_suppression_packed(
    vq: Handle(VirtioQueue),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [deterministic, residual]
    court "virtio_comprehensive_enable_event_suppression_packed:v1"
{
    if !cap.can_event_suppression {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let packed: Handle(VirtioPackedVirtqueue) = Handle(VirtioPackedVirtqueue)::from_ptr(&vq.packed);

    packed.descs[0].flags = packed.descs[0].flags | 0x4000;

    packed.event_suppression = true;

    residual emit {
        op: "virtio_comprehensive.enable_event_suppression_packed",
        queue_idx: packed.queue_index as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Setup Shared Memory Region
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_setup_shm(
    device: Handle(VirtioDevice),
    shm_id: u8,
    bar: u8,
    offset: u64,
    length: u64,
    mapped_base: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_setup_shm:v1"
{
    if !cap.can_shm {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    if (shm_id as u64) >= 8 {
        return Result::Err(VirtioComprehensiveError::VirtioShmError);
    };

    let region: Handle(VirtioSharedMemoryRegion) = Handle(VirtioSharedMemoryRegion)::from_ptr(&device.shm_regions[shm_id as u64]);
    region.shm_id = shm_id;
    region.bar = bar;
    region.offset = offset;
    region.length = length;
    region.mapped_base = mapped_base;
    region.mapped = true;

    if shm_id >= device.shm_region_count {
        device.shm_region_count = shm_id + 1;
    };

    residual emit {
        op: "virtio_comprehensive.setup_shm",
        shm_id: shm_id as u64,
        bar: bar as u64,
        offset: offset,
        length: length,
        mapped_base: mapped_base,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Read Shared Memory Region
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_read_shm(
    device: Handle(VirtioDevice),
    shm_id: u8,
    shm_offset: u64,
    buffer: Handle(Array(u8, 64)),
    length: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_read_shm:v1"
{
    if !cap.can_shm {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let region: Handle(VirtioSharedMemoryRegion) = Handle(VirtioSharedMemoryRegion)::from_ptr(&device.shm_regions[shm_id as u64]);
    if !region.mapped {
        return Result::Err(VirtioComprehensiveError::VirtioShmRegionNotAvailable);
    };

    let read_base: u64 = region.mapped_base + shm_offset;

    loop bound 64 {
        let mut i: u64 = 0;
        if i >= length || i >= 64 {
            break;
        };
        trusted reason "Virtio SHM read access, Virtio 1.2 Spec §6.1.2.3" {
            let ptr: *(u8) = (read_base + i) as *(u8);
            buffer.val[i] = *ptr;
        };
        i = i + 1;
    };

    residual emit {
        op: "virtio_comprehensive.read_shm",
        shm_id: shm_id as u64,
        offset: shm_offset,
        length: length,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enable In-Order Completion (per queue)
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_enable_in_order(
    vq: Handle(VirtioQueue),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [deterministic, residual]
    court "virtio_comprehensive_enable_in_order:v1"
{
    if !vq.initialized {
        return Result::Err(VirtioComprehensiveError::VirtioQueueError);
    };

    if vq.mode == VirtioQueueMode::Split {
        vq.split.in_order = true;
    } else {
        vq.packed.in_order = true;
    };

    residual emit {
        op: "virtio_comprehensive.enable_in_order",
        queue_idx: vq.split.queue_index as u64,
        mode: vq.mode as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Handle AER (Advanced Error Reporting)
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_handle_aer(
    device: Handle(VirtioDevice),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_handle_aer:v1"
{
    if !cap.can_aer {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    if !device.aer.aer_enabled {
        return Result::Ok(void);
    };

    let aer_cap_off: u16 = device.aer.aer_cap_off;
    if aer_cap_off == 0 {
        return Result::Ok(void);
    };

    let mmio: u64 = device.mmio_base;

    let uncorr_status: u32 = virtio_comprehensive_mmio_read32(mmio, aer_cap_off as u64 + 0x04);
    let corr_status: u32 = virtio_comprehensive_mmio_read32(mmio, aer_cap_off as u64 + 0x10);

    if uncorr_status != 0 {
        device.aer.uncorrectable_status = uncorr_status;
        virtio_comprehensive_mmio_write32(mmio, (aer_cap_off as u64) + 0x08, uncorr_status);

        residual emit {
            op: "virtio_comprehensive.aer_uncorrectable",
            status: uncorr_status as u64,
            timestamp: timestamp,
        };

        if (uncorr_status & 0x00001000) != 0 {
            return Result::Err(VirtioComprehensiveError::VirtioAerError);
        };
        if (uncorr_status & 0x00000020) != 0 {
            return Result::Err(VirtioComprehensiveError::VirtioAerRecoveryFailed);
        };
    };

    if corr_status != 0 {
        device.aer.correctable_status = corr_status;
        virtio_comprehensive_mmio_write32(mmio, (aer_cap_off as u64) + 0x14, corr_status);

        residual emit {
            op: "virtio_comprehensive.aer_correctable",
            status: corr_status as u64,
            timestamp: timestamp,
        };
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enable AER
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_enable_aer(
    device: Handle(VirtioDevice),
    aer_cap_off: u16,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_enable_aer:v1"
{
    if !cap.can_aer {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    device.aer.aer_cap_off = aer_cap_off;
    device.aer.aer_enabled = true;

    let mmio: u64 = device.mmio_base;

    virtio_comprehensive_mmio_write32(mmio, (aer_cap_off as u64) + 0x08, 0xFFFFFFFF);
    virtio_comprehensive_mmio_write32(mmio, (aer_cap_off as u64) + 0x14, 0xFFFFFFFF);

    residual emit {
        op: "virtio_comprehensive.enable_aer",
        aer_cap_offset: aer_cap_off as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Read Config Space (Version 2, Generation-based)
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_read_config_v2(
    device: Handle(VirtioDevice),
    offset: u64,
    buffer: Handle(Array(u8, 64)),
    length: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_read_config:v1"
{
    if !cap.can_access_config {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;
    let gen_before: u8 = cfg.config_generation;

    loop bound 64 {
        let mut i: u64 = 0;
        if i >= length || i >= 64 {
            break;
        };
        let cfg_ptr: u64 = device.mmio_base + offset + i;
        let val: u8;
        trusted reason "Virtio config space read with generation check, Virtio 1.2 Spec §4.1.4.3" {
            let ptr: *(u8) = cfg_ptr as *(u8);
            val = *ptr;
        };
        buffer.val[i] = val;
        i = i + 1;
    };

    let gen_after: u8 = cfg.config_generation;
    if gen_before != gen_after {
        return Result::Err(VirtioComprehensiveError::VirtioConfigGenConflict);
    };

    device.config_generation = gen_after;

    residual emit {
        op: "virtio_comprehensive.read_config_v2",
        offset: offset,
        length: length,
        generation: gen_after as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Write Config Space
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_write_config(
    device: Handle(VirtioDevice),
    offset: u64,
    data: Array(u8, 64),
    length: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_write_config:v1"
{
    if !cap.can_access_config {
        return Result::Err(VirtioComprehensiveError::VirtioCapabilityError);
    };

    loop bound 64 {
        let mut i: u64 = 0;
        if i >= length || i >= 64 {
            break;
        };
        let cfg_ptr: u64 = device.mmio_base + offset + i;
        trusted reason "Virtio config space write" {
            let ptr: *(u8) = cfg_ptr as *(u8);
            *ptr = data[i];
        };
        i = i + 1;
    };

    residual emit {
        op: "virtio_comprehensive.write_config",
        offset: offset,
        length: length,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────
// Device Initialization Sequence (Full)
// ─────────────────────────────────────────────

fn virtio_comprehensive_device_init(
    device: Handle(VirtioDevice),
    features: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_device_init:v1"
{
    let reset_result: Result(void, VirtioComprehensiveError) = virtio_comprehensive_reset(device, cap, timestamp);
    match reset_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let ack_result: Result(void, VirtioComprehensiveError) = virtio_comprehensive_set_status(
        device, VirtioDeviceStatus::Acknowledge as u8, cap, timestamp,
    );
    match ack_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let drv_result: Result(void, VirtioComprehensiveError) = virtio_comprehensive_set_status(
        device, (VirtioDeviceStatus::Acknowledge as u8) | (VirtioDeviceStatus::Driver as u8), cap, timestamp,
    );
    match drv_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let dev_features: u64;
    let feat_result: Result(u64, VirtioComprehensiveError) = virtio_comprehensive_get_device_features(device, cap, timestamp);
    match feat_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(f) => { dev_features = f; },
    };

    let negotiated: u64;
    let neg_result: Result(u64, VirtioComprehensiveError) = virtio_comprehensive_negotiate_features(device, features, cap, timestamp);
    match neg_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(n) => { negotiated = n; },
    };

    let featok_result: Result(void, VirtioComprehensiveError) = virtio_comprehensive_set_status(
        device,
        (VirtioDeviceStatus::Acknowledge as u8) | (VirtioDeviceStatus::Driver as u8) | (VirtioDeviceStatus::FeaturesOk as u8),
        cap,
        timestamp,
    );
    match featok_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let features_ok: bool = virtio_comprehensive_check_status(device, VirtioDeviceStatus::FeaturesOk as u8);
    if !features_ok {
        return Result::Err(VirtioComprehensiveError::VirtioNegotiateFailed);
    };

    let ok_result: Result(void, VirtioComprehensiveError) = virtio_comprehensive_set_status(
        device, VirtioDeviceStatus::DriverOk as u8, cap, timestamp,
    );
    match ok_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    device.initialized = true;

    residual emit {
        op: "virtio_comprehensive.device_init",
        device_id: device.device_id as u64,
        features: features,
        negotiated: negotiated,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_driver_init(
    driver_identity: Identity,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> VirtioComprehensiveDriverState
    effect [deterministic, residual]
    court "virtio_comprehensive_driver_init:v1"
{
    let state: VirtioComprehensiveDriverState = VirtioComprehensiveDriverState {
        driver_identity: driver_identity,
        devices: Array::zeroed(),
        device_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_operations: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "virtio_comprehensive.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add Device from PCI Discovery
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_add_device(
    state: Handle(VirtioComprehensiveDriverState),
    device_id: VirtioDeviceId,
    transport: VirtioTransportType,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    common_cfg: Handle(VirtioCommonCfg),
    notif_base: u64,
    notif_size: u64,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(u64, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_add_device:v1"
{
    if state.device_count >= 8 {
        return Result::Err(VirtioComprehensiveError::VirtioMaxDevicesExceeded);
    };

    let idx: u64 = state.device_count;
    let dev_identity: Identity = identity_new(0x56495254, timestamp, idx, pci_bus as u64);

    let device: VirtioDevice = VirtioDevice {
        device_identity: dev_identity,
        device_id: device_id,
        transport: transport,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        io_base: 0,
        bars: Array::zeroed(),
        common_cfg: common_cfg,
        device_features: Array::zeroed(),
        driver_features: Array::zeroed(),
        negotiated_features: 0,
        status: 0,
        config_generation: 0,
        virtqueues: Array::zeroed(),
        queue_count: 0,
        shm_regions: Array::zeroed(),
        shm_region_count: 0,
        aer: VirtioAerState {
            uncorrectable_status: 0, uncorrectable_mask: 0, uncorrectable_severity: 0,
            correctable_status: 0, correctable_mask: 0, aer_cap_off: 0, aer_enabled: false,
        },
        msix_vectors: Array::zeroed(),
        notif_base: notif_base,
        notif_size: notif_size,
        isr_status: 0,
        initialized: false,
        failed: false,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.devices[idx] = device;
    state.device_count = state.device_count + 1;

    residual emit {
        op: "virtio_comprehensive.add_device",
        device_idx: idx,
        device_id: device_id as u64,
        pci_bus: pci_bus as u64,
        mmio_base: mmio_base,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// Device Shutdown / teardown
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_device_shutdown(
    device: Handle(VirtioDevice),
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_shutdown:v1"
{
    if device.initialized {
        let queue_reset_result: Result(void, VirtioComprehensiveError) = virtio_comprehensive_reset(device, cap, timestamp);
        match queue_reset_result {
            Result::Err(e) => { return Result::Err(e); },
            Result::Ok(_) => {},
        };
    };

    device.initialized = false;

    residual emit {
        op: "virtio_comprehensive.device_shutdown",
        device_id: device.device_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Queue Reset (Virtio 1.2 Feature)
// ─────────────────────────────────────────────────────────────

fn virtio_comprehensive_queue_reset(
    device: Handle(VirtioDevice),
    queue_idx: u16,
    cap: VirtioComprehensiveCapability,
    timestamp: u64,
) -> Result(void, VirtioComprehensiveError)
    effect [memory:mmio, deterministic, residual]
    court "virtio_comprehensive_queue_reset:v1"
{
    let cfg: Handle(VirtioCommonCfg) = device.common_cfg;

    cfg.queue_select = queue_idx;

    if (device.negotiated_features & (1 << 42)) == 0 {
        return Result::Err(VirtioComprehensiveError::VirtioFeatureNotSupported);
    };

    cfg.queue_reset = 1;

    loop bound 1000 {
        if cfg.queue_reset == 0 {
            break;
        };
    };

    let vq: Handle(VirtioQueue) = Handle(VirtioQueue)::from_ptr(&device.virtqueues[queue_idx as u64]);
    vq.initialized = false;
    vq.split.enabled = false;
    vq.packed.enabled = false;

    residual emit {
        op: "virtio_comprehensive.queue_reset",
        queue_idx: queue_idx as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}
