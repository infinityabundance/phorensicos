// ──────────────────────────────────────────────
// Baseboard (Type 2)
// ──────────────────────────────────────────────

pub type BaseboardInfo : struct {
    header: SMBIOSHeader,
    manufacturer: FixedString[MAX_STRING_LEN],
    product: FixedString[MAX_STRING_LEN],
    version: FixedString[MAX_STRING_LEN],
    serial_number: FixedString[MAX_STRING_LEN],
    asset_tag: FixedString[MAX_STRING_LEN],
    feature_flags: u8,
    location_in_chassis: FixedString[MAX_STRING_LEN],
    chassis_handle: Word16,
    board_type: u8,
    contained_object_handles: FixedArray[4, Word16],
}

impl BaseboardInfo {
    pub fn new() -> BaseboardInfo
        effects: [deterministic]
    {
        BaseboardInfo {
            header: SMBIOSHeader::new(),
            manufacturer: FixedString::new(),
            product: FixedString::new(),
            version: FixedString::new(),
            serial_number: FixedString::new(),
            asset_tag: FixedString::new(),
            feature_flags: 0,
            location_in_chassis: FixedString::new(),
            chassis_handle: 0,
            board_type: 0,
            contained_object_handles: FixedArray::new(),
        }
    }

    pub fn is_hosting_board(self) -> bool
        effects: [deterministic]
    {
        self.board_type == 0x0A  // 0x0A = Processor/Memory module
    }

    pub fn board_type_name(self) -> FixedString[32]
        effects: [deterministic]
    {
        match self.board_type {
            0x01 => FixedString::from("Unknown"),
            0x02 => FixedString::from("Server Blade"),
            0x03 => FixedString::from("Connectivity Switch"),
            0x04 => FixedString::from("System Management Module"),
            0x05 => FixedString::from("Processor Module"),
            0x06 => FixedString::from("I/O Module"),
            0x07 => FixedString::from("Memory Module"),
            0x08 => FixedString::from("Daughter Board"),
            0x09 => FixedString::from("Motherboard"),
            0x0A => FixedString::from("Processor+Memory Module"),
            0x0B => FixedString::from("Processor+I/O Module"),
            _ => FixedString::from("Other"),
        }
    }
}

