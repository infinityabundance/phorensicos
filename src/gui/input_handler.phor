// input_handler.phor — Phorensic InputHandler
// Device capability grants, event capture/routing, focus management
// Capability-gated event channels. All operations bounded. Every function declares effects.

package gui.input_handler;

import gui.protocol;
import gui.surface;
import gui.window_manager;

// ──────────────────────────────────────────────
// Input Handler Constants
// ──────────────────────────────────────────────

const MAX_INPUT_DEVICES: u64 = 32;
const MAX_EVENT_QUEUE: u64 = 1024;
const MAX_EVENT_SUBSCRIBERS: u64 = 256;
const MAX_CAPTURED_DEVICES: u64 = 16;
const MAX_GESTURE_TRACKERS: u64 = 32;
const MAX_KEY_REPEAT_SLOTS: u64 = 16;
const MAX_INPUT_SURFACES: u64 = 128;
const KEY_REPEAT_INITIAL_MS: u64 = 400;
const KEY_REPEAT_INTERVAL_MS: u64 = 50;
const MAX_TOUCH_POINTS: u64 = 10;
const MAX_GESTURE_SEQUENCE: u64 = 64;
const INPUT_EVENT_TIMEOUT_NS: u64 = 500000000;

// ──────────────────────────────────────────────
// Device State
// ──────────────────────────────────────────────

struct InputDeviceState {
    device_id: u64,
    class: protocol.InputDeviceClass,
    name: Array(u8, 128),
    connected: bool,
    enabled: bool,
    capabilities: u64,
    event_count: u64,
    last_event_ns: u64,
    grabber_surface_id: u64,
    grabbed: bool,
    pointer_x: f64,
    pointer_y: f64,
    button_mask: u32,
    modifier_mask: u32,
    focus_surface_id: u64,
    relative_mode: bool,
    calibration: (f64, f64, f64, f64),
}

// ──────────────────────────────────────────────
// Key Repeat State
// ──────────────────────────────────────────────

struct KeyRepeatState {
    active: bool,
    key_code: u32,
    surface_id: u64,
    started_at_ms: u64,
    last_repeat_ms: u64,
    initial_delay_ms: u64,
    repeat_interval_ms: u64,
    serial: u64,
}

// ──────────────────────────────────────────────
// Gesture Tracker
// ──────────────────────────────────────────────

struct GestureTracker {
    gesture_id: u64,
    type_: u64,
    surface_id: u64,
    active: bool,
    touch_ids: Array(u64, MAX_TOUCH_POINTS),
    touch_count: u64,
    start_positions: Array((f64, f64), MAX_TOUCH_POINTS),
    current_positions: Array((f64, f64), MAX_TOUCH_POINTS),
    start_time_ns: u64,
    last_time_ns: u64,
    delta_x: f64,
    delta_y: f64,
    pinch_scale: f64,
    rotation: f64,
    velocity_x: f64,
    velocity_y: f64,
    completed: bool,
    cancelled: bool,
}

// ──────────────────────────────────────────────
// Event Subscription
// ──────────────────────────────────────────────

struct EventSubscription {
    subscriber_id: u64,
    surface_id: u64,
    session_id: u64,
    device_class_mask: u64,
    key_events: bool,
    pointer_events: bool,
    touch_events: bool,
    axis_events: bool,
    active: bool,
    created_at_ns: u64,
}

// ──────────────────────────────────────────────
// InputHandler Main State
// ──────────────────────────────────────────────

struct InputHandler {
    initialized: bool,

    // Device management
    devices: RingBuf(InputDeviceState, MAX_INPUT_DEVICES),
    device_count: u64,
    next_device_id: u64,

    // Event queue
    event_queue: RingBuf(protocol.InputEvent, MAX_EVENT_QUEUE),
    event_count: u64,
    total_events_processed: u64,

    // Subscriptions
    subscribers: RingBuf(EventSubscription, MAX_EVENT_SUBSCRIBERS),
    subscriber_count: u64,
    next_subscriber_id: u64,

    // Touch tracking
    active_touches: RingBuf(protocol.TouchEvent, MAX_TOUCH_POINTS),
    touch_count: u64,

    // Gesture tracking
    gestures: RingBuf(GestureTracker, MAX_GESTURE_TRACKERS),
    gesture_count: u64,
    next_gesture_id: u64,

    // Key repeat
    key_repeats: RingBuf(KeyRepeatState, MAX_KEY_REPEAT_SLOTS),
    repeat_count: u64,

    // Focus tracking (for input delivery)
    keyboard_focus: u64,
    pointer_focus: u64,
    pointer_position: (f64, f64),

    // Pointer constraint
    constrained_surface: u64,
    constraint_region: protocol.Rectangle,

    // Device capture
    captured_devices: RingBuf(u64, MAX_CAPTURED_DEVICES),
    capture_count: u64,

    // Statistics
    event_count_total: u64,
    dropped_count: u64,
    routed_count: u64,
    subscribe_count: u64,
    unsubscribe_count: u64,
}

// ──────────────────────────────────────────────
// Initialization
// ──────────────────────────────────────────────

fn input_handler_init() -> InputHandler
    effect [compute, residual]
{
    let ih: InputHandler = InputHandler {
        initialized: true,
        devices: RingBuf::new(),
        device_count: 0,
        next_device_id: 1,
        event_queue: RingBuf::new(),
        event_count: 0,
        total_events_processed: 0,
        subscribers: RingBuf::new(),
        subscriber_count: 0,
        next_subscriber_id: 1,
        active_touches: RingBuf::new(),
        touch_count: 0,
        gestures: RingBuf::new(),
        gesture_count: 0,
        next_gesture_id: 1,
        key_repeats: RingBuf::new(),
        repeat_count: 0,
        keyboard_focus: 0,
        pointer_focus: 0,
        pointer_position: (0.0, 0.0),
        constrained_surface: 0,
        constraint_region: protocol.make_rect(0, 0, 0, 0),
        captured_devices: RingBuf::new(),
        capture_count: 0,
        event_count_total: 0,
        dropped_count: 0,
        routed_count: 0,
        subscribe_count: 0,
        unsubscribe_count: 0,
    };
    residual emit {
        op: "input_handler:init",
    };
    return ih;
}

// ──────────────────────────────────────────────
// Device Management
// ──────────────────────────────────────────────

fn ih_register_device(ih: InputHandler, class: protocol.InputDeviceClass, name: Slice(u8)) -> Result((InputHandler, u64), u64)
    effect [compute, io:write, residual]
    bound iterations MAX_INPUT_DEVICES
{
    let mut updated: InputHandler = ih;
    if updated.device_count >= MAX_INPUT_DEVICES {
        return Result::Err(1);
    }
    let dev_id: u64 = updated.next_device_id;
    updated.next_device_id = updated.next_device_id + 1;

    let mut name_buf: Array(u8, 128) = Array::zeroed();
    for i in 0..128 {
        if i >= name.len() { break; }
        name_buf[i] = name[i];
    }

    let dev: InputDeviceState = InputDeviceState {
        device_id: dev_id,
        class: class,
        name: name_buf,
        connected: true,
        enabled: true,
        capabilities: 0,
        event_count: 0,
        last_event_ns: 0,
        grabber_surface_id: 0,
        grabbed: false,
        pointer_x: 0.0,
        pointer_y: 0.0,
        button_mask: 0,
        modifier_mask: 0,
        focus_surface_id: 0,
        relative_mode: false,
        calibration: (1.0, 0.0, 1.0, 0.0),
    };

    for i in 0..MAX_INPUT_DEVICES {
        let d_opt: Option(InputDeviceState) = updated.devices[i];
        match d_opt {
            Option::None => {
                updated.devices[i] = Option::Some(dev);
                updated.device_count = updated.device_count + 1;
                residual emit {
                    op: "input:register_device",
                    device_id: dev_id,
                    class: class as u64,
                };
                return Result::Ok((updated, dev_id));
            }
            Option::Some(_) => {}
        }
    }
    return Result::Err(2);
}

fn ih_unregister_device(ih: InputHandler, device_id: u64) -> Result(InputHandler, u64)
    effect [compute, io:write, residual]
    bound iterations MAX_INPUT_DEVICES
{
    let mut updated: InputHandler = ih;
    for i in 0..MAX_INPUT_DEVICES {
        let d_opt: Option(InputDeviceState) = updated.devices[i];
        match d_opt {
            Option::Some(d) => {
                if d.device_id == device_id {
                    let disconnected: InputDeviceState = InputDeviceState {
                        device_id: d.device_id,
                        class: d.class,
                        name: d.name,
                        connected: false,
                        enabled: false,
                        capabilities: d.capabilities,
                        event_count: d.event_count,
                        last_event_ns: d.last_event_ns,
                        grabber_surface_id: d.grabber_surface_id,
                        grabbed: d.grabbed,
                        pointer_x: d.pointer_x,
                        pointer_y: d.pointer_y,
                        button_mask: d.button_mask,
                        modifier_mask: d.modifier_mask,
                        focus_surface_id: d.focus_surface_id,
                        relative_mode: d.relative_mode,
                        calibration: d.calibration,
                    };
                    updated.devices[i] = Option::Some(disconnected);
                    updated.device_count = updated.device_count - 1;
                    residual emit {
                        op: "input:unregister_device",
                        device_id: device_id,
                    };
                    return Result::Ok(updated);
                }
            }
            Option::None => {}
        }
    }
    return Result::Err(3);
}

fn ih_find_device(ih: InputHandler, device_id: u64) -> Option(InputDeviceState)
    effect [compute]
    bound iterations MAX_INPUT_DEVICES
{
    for i in 0..MAX_INPUT_DEVICES {
        let d_opt: Option(InputDeviceState) = ih.devices[i];
        match d_opt {
            Option::Some(d) => {
                if d.device_id == device_id && d.connected {
                    return Option::Some(d);
                }
            }
            Option::None => {}
        }
    }
    return Option::None;
}

fn ih_update_device(ih: InputHandler, dev: InputDeviceState) -> Result(InputHandler, u64)
    effect [compute]
    bound iterations MAX_INPUT_DEVICES
{
    let mut updated: InputHandler = ih;
    for i in 0..MAX_INPUT_DEVICES {
        let d_opt: Option(InputDeviceState) = updated.devices[i];
        match d_opt {
            Option::Some(d) => {
                if d.device_id == dev.device_id {
                    updated.devices[i] = Option::Some(dev);
                    return Result::Ok(updated);
                }
            }
            Option::None => {}
        }
    }
    return Result::Err(3);
}

// ──────────────────────────────────────────────
// Event Queue Management
// ──────────────────────────────────────────────

fn ih_enqueue_event(ih: InputHandler, ev: protocol.InputEvent) -> Result(InputHandler, u64)
    effect [compute, io:write]
    bound iterations MAX_EVENT_QUEUE
{
    let mut updated: InputHandler = ih;
    if updated.event_count >= MAX_EVENT_QUEUE {
        updated.dropped_count = updated.dropped_count + 1;
        return Result::Err(4); // queue full
    }
    for i in 0..MAX_EVENT_QUEUE {
        let e_opt: Option(protocol.InputEvent) = updated.event_queue[i];
        match e_opt {
            Option::None => {
                updated.event_queue[i] = Option::Some(ev);
                updated.event_count = updated.event_count + 1;
                updated.event_count_total = updated.event_count_total + 1;
                return Result::Ok(updated);
            }
            Option::Some(_) => {}
        }
    }
    return Result::Err(5);
}

fn ih_dequeue_event(ih: InputHandler) -> (InputHandler, Option(protocol.InputEvent))
    effect [compute]
    bound iterations MAX_EVENT_QUEUE
{
    let mut updated: InputHandler = ih;
    // Simple FIFO: find the oldest event by scanning for first non-None
    for i in 0..MAX_EVENT_QUEUE {
        let e_opt: Option(protocol.InputEvent) = updated.event_queue[i];
        match e_opt {
            Option::Some(ev) => {
                updated.event_queue[i] = Option::None;
                updated.event_count = updated.event_count - 1;
                updated.total_events_processed = updated.total_events_processed + 1;
                return (updated, Option::Some(ev));
            }
            Option::None => {}
        }
    }
    return (updated, Option::None);
}

fn ih_clear_events(ih: InputHandler) -> InputHandler
    effect [compute]
{
    let mut updated: InputHandler = ih;
    for i in 0..MAX_EVENT_QUEUE {
        updated.event_queue[i] = Option::None;
    }
    updated.event_count = 0;
    return updated;
}

// ──────────────────────────────────────────────
// Event Routing
// ──────────────────────────────────────────────

fn ih_route_event(ih: InputHandler, ev: protocol.InputEvent, wm: window_manager.WindowManager) -> (InputHandler, u64)
    effect [compute, io:read, io:write, residual]
{
    let mut updated: InputHandler = ih;
    let mut target_surface: u64 = 0;

    // Determine target based on device class and focus
    match ev.device_class {
        protocol.InputDeviceClass::Keyboard => {
            target_surface = updated.keyboard_focus;
            // If no keyboard focus, check if a grab exists
            if target_surface == 0 {
                for i in 0..MAX_INPUT_DEVICES {
                    let d_opt: Option(InputDeviceState) = updated.devices[i];
                    match d_opt {
                        Option::Some(d) => {
                            if d.device_id == ev.device_id && d.grabbed {
                                target_surface = d.grabber_surface_id;
                                break;
                            }
                        }
                        Option::None => {}
                    }
                }
            }
        }
        protocol.InputDeviceClass::Pointer => {
            // Pointer events go to surface under cursor or grabber
            for i in 0..MAX_INPUT_DEVICES {
                let d_opt: Option(InputDeviceState) = updated.devices[i];
                match d_opt {
                    Option::Some(d) => {
                        if d.device_id == ev.device_id {
                            if d.grabbed {
                                target_surface = d.grabber_surface_id;
                            } else {
                                target_surface = window_manager.wm_surface_at_point(wm, ev.pointer.x as i32, ev.pointer.y as i32);
                                updated.pointer_focus = target_surface;
                            }
                            break;
                        }
                    }
                    Option::None => {}
                }
            }
        }
        protocol.InputDeviceClass::Touch => {
            // Touch events go to surface under initial touch point
            match ev.touch {
                Option::Some(t) => {
                    if t.state == protocol.TouchState::Down {
                        target_surface = window_manager.wm_surface_at_point(wm, t.x as i32, t.y as i32);
                    } else {
                        // Follow existing touch
                        for j in 0..MAX_TOUCH_POINTS {
                            let touch_opt: Option(protocol.TouchEvent) = updated.active_touches[j];
                            match touch_opt {
                                Option::Some(at) => {
                                    if at.touch_id == t.touch_id {
                                        target_surface = at.device_id; // reuse the stored target
                                        break;
                                    }
                                }
                                Option::None => {}
                            }
                        }
                    }
                }
                Option::None => {}
            }
        }
        _ => {}
    }

    // Try to find a subscriber for the target surface
    if target_surface > 0 {
        updated.routed_count = updated.routed_count + 1;
        residual emit {
            op: "input:route",
            event_serial: ev.serial,
            device: ev.device_id,
            target: target_surface,
            class: ev.device_class as u64,
        };
    }

    return (updated, target_surface);
}

// ──────────────────────────────────────────────
// Event Processing Pipeline
// ──────────────────────────────────────────────

fn ih_process_key_event(ih: InputHandler, ev: protocol.KeyEvent, device_id: u64, now_ms: u64) -> (InputHandler, protocol.InputEvent)
    effect [compute, io:write, residual]
{
    let mut updated: InputHandler = ih;
    let input_ev: protocol.InputEvent = protocol.InputEvent {
        device_class: protocol.InputDeviceClass::Keyboard,
        key: Option::Some(ev),
        pointer: Option::None,
        touch: Option::None,
        axis: Option::None,
        timestamp_ms: ev.timestamp_ms,
        device_id: device_id,
        serial: updated.event_count_total + 1,
    };

    // Handle key repeat
    if ev.state == protocol.KeyState::Pressed {
        // Start or update repeat tracking
        let mut found: bool = false;
        for i in 0..MAX_KEY_REPEAT_SLOTS {
            let kr_opt: Option(KeyRepeatState) = updated.key_repeats[i];
            match kr_opt {
                Option::Some(kr) => {
                    if kr.key_code == ev.key_code && kr.active {
                        found = true;
                        break;
                    }
                }
                Option::None => {}
            }
        }
        if !found {
            for i in 0..MAX_KEY_REPEAT_SLOTS {
                let kr_opt: Option(KeyRepeatState) = updated.key_repeats[i];
                match kr_opt {
                    Option::None => {
                        let kr: KeyRepeatState = KeyRepeatState {
                            active: true,
                            key_code: ev.key_code,
                            surface_id: updated.keyboard_focus,
                            started_at_ms: now_ms,
                            last_repeat_ms: now_ms,
                            initial_delay_ms: KEY_REPEAT_INITIAL_MS,
                            repeat_interval_ms: KEY_REPEAT_INTERVAL_MS,
                            serial: updated.event_count_total,
                        };
                        updated.key_repeats[i] = Option::Some(kr);
                        updated.repeat_count = updated.repeat_count + 1;
                        break;
                    }
                    Option::Some(_) => {}
                }
            }
        }
    } else if ev.state == protocol.KeyState::Released {
        // Stop repeat tracking
        for i in 0..MAX_KEY_REPEAT_SLOTS {
            let kr_opt: Option(KeyRepeatState) = updated.key_repeats[i];
            match kr_opt {
                Option::Some(kr) => {
                    if kr.key_code == ev.key_code && kr.active {
                        let stopped: KeyRepeatState = KeyRepeatState {
                            active: false,
                            key_code: kr.key_code,
                            surface_id: kr.surface_id,
                            started_at_ms: kr.started_at_ms,
                            last_repeat_ms: kr.last_repeat_ms,
                            initial_delay_ms: kr.initial_delay_ms,
                            repeat_interval_ms: kr.repeat_interval_ms,
                            serial: kr.serial,
                        };
                        updated.key_repeats[i] = Option::Some(stopped);
                        updated.repeat_count = updated.repeat_count - 1;
                        break;
                    }
                }
                Option::None => {}
            }
        }
    }

    residual emit {
        op: "input:key",
        key: ev.key_code,
        state: ev.state as u64,
        device: device_id,
    };

    return (updated, input_ev);
}

fn ih_process_pointer_event(ih: InputHandler, ev: protocol.PointerEvent, device_id: u64) -> (InputHandler, protocol.InputEvent)
    effect [compute, io:write, residual]
{
    let mut updated: InputHandler = ih;

    // Update pointer position on the device
    for i in 0..MAX_INPUT_DEVICES {
        let d_opt: Option(InputDeviceState) = updated.devices[i];
        match d_opt {
            Option::Some(d) => {
                if d.device_id == device_id {
                    let mut new_x: f64 = ev.x;
                    let mut new_y: f64 = ev.y;
                    // Apply constraint
                    if updated.constrained_surface > 0 {
                        let cr: protocol.Rectangle = updated.constraint_region;
                        if new_x < cr.x as f64 { new_x = cr.x as f64; }
                        if new_y < cr.y as f64 { new_y = cr.y as f64; }
                        if new_x > (cr.x + cr.width as i32) as f64 { new_x = (cr.x + cr.width as i32) as f64; }
                        if new_y > (cr.y + cr.height as i32) as f64 { new_y = (cr.y + cr.height as i32) as f64; }
                    }
                    let updated_dev: InputDeviceState = InputDeviceState {
                        device_id: d.device_id,
                        class: d.class,
                        name: d.name,
                        connected: d.connected,
                        enabled: d.enabled,
                        capabilities: d.capabilities,
                        event_count: d.event_count + 1,
                        last_event_ns: ev.timestamp_ms * 1000000,
                        grabber_surface_id: d.grabber_surface_id,
                        grabbed: d.grabbed,
                        pointer_x: new_x,
                        pointer_y: new_y,
                        button_mask: if ev.button_state == protocol.ButtonState::Pressed {
                            d.button_mask | (1 << ev.button)
                        } else {
                            d.button_mask & !(1 << ev.button)
                        },
                        modifier_mask: ev.modifiers,
                        focus_surface_id: d.focus_surface_id,
                        relative_mode: d.relative_mode,
                        calibration: d.calibration,
                    };
                    updated.devices[i] = Option::Some(updated_dev);
                    updated.pointer_position = (new_x, new_y);
                    break;
                }
            }
            Option::None => {}
        }
    }

    let input_ev: protocol.InputEvent = protocol.InputEvent {
        device_class: protocol.InputDeviceClass::Pointer,
        key: Option::None,
        pointer: Option::Some(ev),
        touch: Option::None,
        axis: Option::None,
        timestamp_ms: ev.timestamp_ms,
        device_id: device_id,
        serial: updated.event_count_total + 1,
    };

    residual emit {
        op: "input:pointer",
        x: ev.x,
        y: ev.y,
        button: ev.button,
        state: ev.button_state as u64,
        device: device_id,
    };

    return (updated, input_ev);
}

fn ih_process_touch_event(ih: InputHandler, ev: protocol.TouchEvent, device_id: u64) -> (InputHandler, protocol.InputEvent)
    effect [compute, io:write, residual]
{
    let mut updated: InputHandler = ih;

    // Track active touches
    match ev.state {
        protocol.TouchState::Down => {
            for i in 0..MAX_TOUCH_POINTS {
                let t_opt: Option(protocol.TouchEvent) = updated.active_touches[i];
                match t_opt {
                    Option::None => {
                        updated.active_touches[i] = Option::Some(ev);
                        updated.touch_count = updated.touch_count + 1;
                        break;
                    }
                    Option::Some(_) => {}
                }
            }
        }
        protocol.TouchState::Up | protocol.TouchState::Cancel => {
            for i in 0..MAX_TOUCH_POINTS {
                let t_opt: Option(protocol.TouchEvent) = updated.active_touches[i];
                match t_opt {
                    Option::Some(t) => {
                        if t.touch_id == ev.touch_id {
                            updated.active_touches[i] = Option::None;
                            updated.touch_count = updated.touch_count - 1;
                            break;
                        }
                    }
                    Option::None => {}
                }
            }
        }
        protocol.TouchState::Motion => {
            for i in 0..MAX_TOUCH_POINTS {
                let t_opt: Option(protocol.TouchEvent) = updated.active_touches[i];
                match t_opt {
                    Option::Some(t) => {
                        if t.touch_id == ev.touch_id {
                            updated.active_touches[i] = Option::Some(ev);
                            break;
                        }
                    }
                    Option::None => {}
                }
            }
        }
    }

    let input_ev: protocol.InputEvent = protocol.InputEvent {
        device_class: protocol.InputDeviceClass::Touch,
        key: Option::None,
        pointer: Option::None,
        touch: Option::Some(ev),
        axis: Option::None,
        timestamp_ms: ev.timestamp_ms,
        device_id: device_id,
        serial: updated.event_count_total + 1,
    };

    residual emit {
        op: "input:touch",
        touch_id: ev.touch_id,
        state: ev.state as u64,
        x: ev.x,
        y: ev.y,
        device: device_id,
    };

    return (updated, input_ev);
}

// ──────────────────────────────────────────────
// Event Input (from device drivers)
// ──────────────────────────────────────────────

fn ih_inject_key_event(ih: InputHandler, key: u32, state: protocol.KeyState, mods: u32, dev_id: u64, ts_ms: u64) -> Result(InputHandler, u64)
    effect [compute, io:write, residual]
{
    let mut updated: InputHandler = ih;
    let dev_opt: Option(InputDeviceState) = ih_find_device(updated, dev_id);
    match dev_opt {
        Option::Some(dev) => {
            if !dev.enabled {
                return Result::Err(6); // device disabled
            }
            let kev: protocol.KeyEvent = protocol.KeyEvent {
                key_code: key,
                state: state,
                modifiers: mods,
                timestamp_ms: ts_ms,
                device_id: dev_id,
                serial: updated.event_count_total + 1,
            };
            let (new_ih, ev) = ih_process_key_event(updated, kev, dev_id, ts_ms);
            updated = new_ih;
            let res = ih_enqueue_event(updated, ev);
            match res {
                Result::Ok(ih) => { updated = ih; }
                Result::Err(_) => {}
            }
            return Result::Ok(updated);
        }
        Option::None => {
            return Result::Err(7); // device not found
        }
    }
}

fn ih_inject_pointer_event(ih: InputHandler, x: f64, y: f64, dx: f64, dy: f64, btn: u32, state: protocol.ButtonState, mods: u32, dev_id: u64, ts_ms: u64) -> Result(InputHandler, u64)
    effect [compute, io:write, residual]
{
    let mut updated: InputHandler = ih;
    let dev_opt: Option(InputDeviceState) = ih_find_device(updated, dev_id);
    match dev_opt {
        Option::Some(dev) => {
            if !dev.enabled {
                return Result::Err(6);
            }
            let pev: protocol.PointerEvent = protocol.PointerEvent {
                x: x, y: y, dx: dx, dy: dy,
                button: btn,
                button_state: state,
                modifiers: mods,
                timestamp_ms: ts_ms,
                device_id: dev_id,
                serial: updated.event_count_total + 1,
            };
            let (new_ih, ev) = ih_process_pointer_event(updated, pev, dev_id);
            updated = new_ih;
            let res = ih_enqueue_event(updated, ev);
            match res {
                Result::Ok(ih) => { updated = ih; }
                Result::Err(_) => {}
            }
            return Result::Ok(updated);
        }
        Option::None => {
            return Result::Err(7);
        }
    }
}

fn ih_inject_touch_event(ih: InputHandler, touch_id: u64, state: protocol.TouchState, x: f64, y: f64, major: f64, minor: f64, dev_id: u64, ts_ms: u64) -> Result(InputHandler, u64)
    effect [compute, io:write, residual]
{
    let mut updated: InputHandler = ih;
    let dev_opt: Option(InputDeviceState) = ih_find_device(updated, dev_id);
    match dev_opt {
        Option::Some(dev) => {
            if !dev.enabled {
                return Result::Err(6);
            }
            let tev: protocol.TouchEvent = protocol.TouchEvent {
                touch_id: touch_id,
                state: state,
                x: x, y: y,
                major: major,
                minor: minor,
                timestamp_ms: ts_ms,
                device_id: dev_id,
                serial: updated.event_count_total + 1,
            };
            let (new_ih, ev) = ih_process_touch_event(updated, tev, dev_id);
            updated = new_ih;
            let res = ih_enqueue_event(updated, ev);
            match res {
                Result::Ok(ih) => { updated = ih; }
                Result::Err(_) => {}
            }
            return Result::Ok(updated);
        }
        Option::None => {
            return Result::Err(7);
        }
    }
}

// ──────────────────────────────────────────────
// Focus Management
// ──────────────────────────────────────────────

fn ih_set_keyboard_focus(ih: InputHandler, surface_id: u64) -> InputHandler
    effect [compute, residual]
{
    residual emit {
        op: "input:focus_keyboard",
        surface_id: surface_id,
    };
    return InputHandler {
        initialized: ih.initialized,
        devices: ih.devices,
        device_count: ih.device_count,
        next_device_id: ih.next_device_id,
        event_queue: ih.event_queue,
        event_count: ih.event_count,
        total_events_processed: ih.total_events_processed,
        subscribers: ih.subscribers,
        subscriber_count: ih.subscriber_count,
        next_subscriber_id: ih.next_subscriber_id,
        active_touches: ih.active_touches,
        touch_count: ih.touch_count,
        gestures: ih.gestures,
        gesture_count: ih.gesture_count,
        next_gesture_id: ih.next_gesture_id,
        key_repeats: ih.key_repeats,
        repeat_count: ih.repeat_count,
        keyboard_focus: surface_id,
        pointer_focus: ih.pointer_focus,
        pointer_position: ih.pointer_position,
        constrained_surface: ih.constrained_surface,
        constraint_region: ih.constraint_region,
        captured_devices: ih.captured_devices,
        capture_count: ih.capture_count,
        event_count_total: ih.event_count_total,
        dropped_count: ih.dropped_count,
        routed_count: ih.routed_count,
        subscribe_count: ih.subscribe_count,
        unsubscribe_count: ih.unsubscribe_count,
    };
}

fn ih_get_keyboard_focus(ih: InputHandler) -> u64
    effect [compute]
{
    return ih.keyboard_focus;
}

// ──────────────────────────────────────────────
// Subscriptions
// ──────────────────────────────────────────────

fn ih_subscribe(ih: InputHandler, surface_id: u64, session_id: u64, device_mask: u64) -> Result((InputHandler, u64), u64)
    effect [compute, io:write, residual]
    bound iterations MAX_EVENT_SUBSCRIBERS
{
    let mut updated: InputHandler = ih;
    let sub_id: u64 = updated.next_subscriber_id;
    updated.next_subscriber_id = updated.next_subscriber_id + 1;

    let sub: EventSubscription = EventSubscription {
        subscriber_id: sub_id,
        surface_id: surface_id,
        session_id: session_id,
        device_class_mask: device_mask,
        key_events: (device_mask & 1) != 0,
        pointer_events: (device_mask & 2) != 0,
        touch_events: (device_mask & 4) != 0,
        axis_events: (device_mask & 8) != 0,
        active: true,
        created_at_ns: 0,
    };

    for i in 0..MAX_EVENT_SUBSCRIBERS {
        let s_opt: Option(EventSubscription) = updated.subscribers[i];
        match s_opt {
            Option::None => {
                updated.subscribers[i] = Option::Some(sub);
                updated.subscriber_count = updated.subscriber_count + 1;
                updated.subscribe_count = updated.subscribe_count + 1;
                residual emit {
                    op: "input:subscribe",
                    subscriber_id: sub_id,
                    surface_id: surface_id,
                    mask: device_mask,
                };
                return Result::Ok((updated, sub_id));
            }
            Option::Some(_) => {}
        }
    }
    return Result::Err(8); // max subscribers
}

fn ih_unsubscribe(ih: InputHandler, subscriber_id: u64) -> Result(InputHandler, u64)
    effect [compute, io:write, residual]
    bound iterations MAX_EVENT_SUBSCRIBERS
{
    let mut updated: InputHandler = ih;
    for i in 0..MAX_EVENT_SUBSCRIBERS {
        let s_opt: Option(EventSubscription) = updated.subscribers[i];
        match s_opt {
            Option::Some(s) => {
                if s.subscriber_id == subscriber_id {
                    updated.subscribers[i] = Option::None;
                    updated.subscriber_count = updated.subscriber_count - 1;
                    updated.unsubscribe_count = updated.unsubscribe_count + 1;
                    residual emit {
                        op: "input:unsubscribe",
                        subscriber_id: subscriber_id,
                    };
                    return Result::Ok(updated);
                }
            }
            Option::None => {}
        }
    }
    return Result::Err(9);
}

fn ih_find_subscribers_for_surface(ih: InputHandler, surface_id: u64) -> RingBuf(EventSubscription, MAX_EVENT_SUBSCRIBERS)
    effect [compute]
    bound iterations MAX_EVENT_SUBSCRIBERS
{
    let mut results: RingBuf(EventSubscription, MAX_EVENT_SUBSCRIBERS) = RingBuf::new();
    let mut count: u64 = 0;
    for i in 0..MAX_EVENT_SUBSCRIBERS {
        let s_opt: Option(EventSubscription) = ih.subscribers[i];
        match s_opt {
            Option::Some(s) => {
                if s.surface_id == surface_id && s.active {
                    results[count] = Option::Some(s);
                    count = count + 1;
                }
            }
            Option::None => {}
        }
    }
    return results;
}

// ──────────────────────────────────────────────
// Pointer Constraints
// ──────────────────────────────────────────────

fn ih_constrain_pointer(ih: InputHandler, surface_id: u64, region: protocol.Rectangle) -> InputHandler
    effect [compute, residual]
{
    residual emit {
        op: "input:constrain_pointer",
        surface_id: surface_id,
        x: region.x,
        y: region.y,
        w: region.width,
        h: region.height,
    };
    return InputHandler {
        initialized: ih.initialized,
        devices: ih.devices,
        device_count: ih.device_count,
        next_device_id: ih.next_device_id,
        event_queue: ih.event_queue,
        event_count: ih.event_count,
        total_events_processed: ih.total_events_processed,
        subscribers: ih.subscribers,
        subscriber_count: ih.subscriber_count,
        next_subscriber_id: ih.next_subscriber_id,
        active_touches: ih.active_touches,
        touch_count: ih.touch_count,
        gestures: ih.gestures,
        gesture_count: ih.gesture_count,
        next_gesture_id: ih.next_gesture_id,
        key_repeats: ih.key_repeats,
        repeat_count: ih.repeat_count,
        keyboard_focus: ih.keyboard_focus,
        pointer_focus: ih.pointer_focus,
        pointer_position: ih.pointer_position,
        constrained_surface: surface_id,
        constraint_region: region,
        captured_devices: ih.captured_devices,
        capture_count: ih.capture_count,
        event_count_total: ih.event_count_total,
        dropped_count: ih.dropped_count,
        routed_count: ih.routed_count,
        subscribe_count: ih.subscribe_count,
        unsubscribe_count: ih.unsubscribe_count,
    };
}

fn ih_unconstrain_pointer(ih: InputHandler) -> InputHandler
    effect [compute, residual]
{
    residual emit {
        op: "input:unconstrain_pointer",
    };
    return InputHandler {
        initialized: ih.initialized,
        devices: ih.devices,
        device_count: ih.device_count,
        next_device_id: ih.next_device_id,
        event_queue: ih.event_queue,
        event_count: ih.event_count,
        total_events_processed: ih.total_events_processed,
        subscribers: ih.subscribers,
        subscriber_count: ih.subscriber_count,
        next_subscriber_id: ih.next_subscriber_id,
        active_touches: ih.active_touches,
        touch_count: ih.touch_count,
        gestures: ih.gestures,
        gesture_count: ih.gesture_count,
        next_gesture_id: ih.next_gesture_id,
        key_repeats: ih.key_repeats,
        repeat_count: ih.repeat_count,
        keyboard_focus: ih.keyboard_focus,
        pointer_focus: ih.pointer_focus,
        pointer_position: ih.pointer_position,
        constrained_surface: 0,
        constraint_region: protocol.make_rect(0, 0, 0, 0),
        captured_devices: ih.captured_devices,
        capture_count: ih.capture_count,
        event_count_total: ih.event_count_total,
        dropped_count: ih.dropped_count,
        routed_count: ih.routed_count,
        subscribe_count: ih.subscribe_count,
        unsubscribe_count: ih.unsubscribe_count,
    };
}

// ──────────────────────────────────────────────
// Device Grabbing
// ──────────────────────────────────────────────

fn ih_grab_device(ih: InputHandler, device_id: u64, surface_id: u64) -> Result(InputHandler, u64)
    effect [compute, io:write, residual]
    bound iterations MAX_INPUT_DEVICES
{
    let mut updated: InputHandler = ih;
    for i in 0..MAX_INPUT_DEVICES {
        let d_opt: Option(InputDeviceState) = updated.devices[i];
        match d_opt {
            Option::Some(d) => {
                if d.device_id == device_id {
                    let grabbed: InputDeviceState = InputDeviceState {
                        device_id: d.device_id,
                        class: d.class,
                        name: d.name,
                        connected: d.connected,
                        enabled: d.enabled,
                        capabilities: d.capabilities,
                        event_count: d.event_count,
                        last_event_ns: d.last_event_ns,
                        grabber_surface_id: surface_id,
                        grabbed: true,
                        pointer_x: d.pointer_x,
                        pointer_y: d.pointer_y,
                        button_mask: d.button_mask,
                        modifier_mask: d.modifier_mask,
                        focus_surface_id: d.focus_surface_id,
                        relative_mode: d.relative_mode,
                        calibration: d.calibration,
                    };
                    updated.devices[i] = Option::Some(grabbed);
                    // Track in captured devices
                    for j in 0..MAX_CAPTURED_DEVICES {
                        let c_opt: Option(u64) = updated.captured_devices[j];
                        match c_opt {
                            Option::None => {
                                updated.captured_devices[j] = Option::Some(device_id);
                                updated.capture_count = updated.capture_count + 1;
                                break;
                            }
                            Option::Some(_) => {}
                        }
                    }
                    residual emit {
                        op: "input:grab",
                        device_id: device_id,
                        surface_id: surface_id,
                    };
                    return Result::Ok(updated);
                }
            }
            Option::None => {}
        }
    }
    return Result::Err(3);
}

fn ih_ungrab_device(ih: InputHandler, device_id: u64) -> Result(InputHandler, u64)
    effect [compute, io:write, residual]
    bound iterations MAX_INPUT_DEVICES
{
    let mut updated: InputHandler = ih;
    for i in 0..MAX_INPUT_DEVICES {
        let d_opt: Option(InputDeviceState) = updated.devices[i];
        match d_opt {
            Option::Some(d) => {
                if d.device_id == device_id {
                    let ung: InputDeviceState = InputDeviceState {
                        device_id: d.device_id,
                        class: d.class,
                        name: d.name,
                        connected: d.connected,
                        enabled: d.enabled,
                        capabilities: d.capabilities,
                        event_count: d.event_count,
                        last_event_ns: d.last_event_ns,
                        grabber_surface_id: 0,
                        grabbed: false,
                        pointer_x: d.pointer_x,
                        pointer_y: d.pointer_y,
                        button_mask: d.button_mask,
                        modifier_mask: d.modifier_mask,
                        focus_surface_id: d.focus_surface_id,
                        relative_mode: d.relative_mode,
                        calibration: d.calibration,
                    };
                    updated.devices[i] = Option::Some(ung);
                    // Remove from captured devices
                    for j in 0..MAX_CAPTURED_DEVICES {
                        let c_opt: Option(u64) = updated.captured_devices[j];
                        match c_opt {
                            Option::Some(cid) => {
                                if cid == device_id {
                                    updated.captured_devices[j] = Option::None;
                                    updated.capture_count = updated.capture_count - 1;
                                    break;
                                }
                            }
                            Option::None => {}
                        }
                    }
                    residual emit {
                        op: "input:ungrab",
                        device_id: device_id,
                    };
                    return Result::Ok(updated);
                }
            }
            Option::None => {}
        }
    }
    return Result::Err(3);
}

// ──────────────────────────────────────────────
// Key Repeat Update (called per tick)
// ──────────────────────────────────────────────

fn ih_update_repeats(ih: InputHandler, now_ms: u64) -> (InputHandler, u64)
    effect [compute]
    bound iterations MAX_KEY_REPEAT_SLOTS
{
    let mut updated: InputHandler = ih;
    let mut repeat_count: u64 = 0;
    for i in 0..MAX_KEY_REPEAT_SLOTS {
        let kr_opt: Option(KeyRepeatState) = updated.key_repeats[i];
        match kr_opt {
            Option::Some(kr) => {
                if kr.active {
                    let elapsed: u64 = now_ms - kr.started_at_ms;
                    if elapsed >= kr.initial_delay_ms {
                        let since_last: u64 = now_ms - kr.last_repeat_ms;
                        if since_last >= kr.repeat_interval_ms {
                            let updated_kr: KeyRepeatState = KeyRepeatState {
                                active: kr.active,
                                key_code: kr.key_code,
                                surface_id: kr.surface_id,
                                started_at_ms: kr.started_at_ms,
                                last_repeat_ms: now_ms,
                                initial_delay_ms: kr.initial_delay_ms,
                                repeat_interval_ms: kr.repeat_interval_ms,
                                serial: kr.serial,
                            };
                            updated.key_repeats[i] = Option::Some(updated_kr);
                            repeat_count = repeat_count + 1;
                        }
                    }
                }
            }
            Option::None => {}
        }
    }
    return (updated, repeat_count);
}

// ──────────────────────────────────────────────
// Statistics
// ──────────────────────────────────────────────

struct InputHandlerInfo {
    initialized: bool,
    device_count: u64,
    event_queue_usage: u64,
    subscriber_count: u64,
    keyboard_focus: u64,
    pointer_focus: u64,
    total_events: u64,
    dropped_events: u64,
    routed_events: u64,
    touch_count: u64,
    capture_count: u64,
    repeat_count: u64,
}

fn ih_get_info(ih: InputHandler) -> InputHandlerInfo
    effect [compute]
{
    return InputHandlerInfo {
        initialized: ih.initialized,
        device_count: ih.device_count,
        event_queue_usage: ih.event_count,
        subscriber_count: ih.subscriber_count,
        keyboard_focus: ih.keyboard_focus,
        pointer_focus: ih.pointer_focus,
        total_events: ih.event_count_total,
        dropped_events: ih.dropped_count,
        routed_events: ih.routed_count,
        touch_count: ih.touch_count,
        capture_count: ih.capture_count,
        repeat_count: ih.repeat_count,
    };
}
