fn test_http_connect_tunnel() -> void
    effect [compute, residual]
{
    let connect: Str(32) = Str::from("CONNECT example.com:443");
    let parts: u64 = 2;
    assert(parts == 2, "http: CONNECT has host:port");
    residual emit { op: "http.test.connect", tunnel: 1, };
}

