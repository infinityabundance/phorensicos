// file: constants.phor
// purpose: System-wide constants, trust state enum, trust ladder levels,
//          capability right bitmask constants, diagnostic code ranges,
//          fixed-capacity bounds, and well-known identity constants.
// evidence: CONST-ARCH-001 through CONST-ARCH-089
// residual: All constants are compile-time evaluable; no runtime allocation.

// ──────────────────────────────────────────────
// Trust Ladder: 16 levels from Untrusted to Absolute
// ──────────────────────────────────────────────
// Each level carries an ordinal ranking for comparison.
// Evidence path: CONST-TRUST-001

type TrustLevel : u8 = enum {
    Trust_Untrusted    = 0x00,  // No trust; sandbox only
    Trust_Observed     = 0x01,  // Passive observation permitted
    Trust_Transient    = 0x02,  // Single-operation trust
    Trust_Scoped       = 0x03,  // Scoped operations within a cage
    Trust_Session      = 0x04,  // Session-scoped trust
    Trust_Code         = 0x05,  // Trusts the code artifact hash
    Trust_Signed       = 0x06,  // Trusts signed origin
    Trust_Verified     = 0x07,  // Verified against a known authority
    Trust_Attested     = 0x08,  // Hardware-attested trust
    Trust_Sealed       = 0x09,  // Sealed by a court
    Trust_Notarized    = 0x0A,  // Notarized by multiple courts
    Trust_Endorsed     = 0x0B,  // Endorsed by a parent cage
    Trust_Privileged   = 0x0C,  // Kernel-privileged operations
    Trust_Trusted      = 0x0D,  // Fully trusted within domain
    Trust_System       = 0x0E,  // System-level trust
    Trust_Absolute     = 0x0F,  // Maximum trust (kernel/core only)
}

// ──────────────────────────────────────────────
// System Trust State (concrete runtime state)
// ──────────────────────────────────────────────
// Evidence path: CONST-TRUST-002

type TrustState : u8 = enum {
    TrustState_Bootstrap    = 0x00,  // Early boot; no trust established
    TrustState_Loading      = 0x01,  // Loading phase
    TrustState_Measuring    = 0x02,  // Measurement phase
    TrustState_Verifying    = 0x03,  // Verification phase
    TrustState_Operational  = 0x04,  // Normal operation
    TrustState_Degraded     = 0x05,  // Reduced trust due to anomaly
    TrustState_Quarantine   = 0x06,  // Isolation mode
    TrustState_Recovery     = 0x07,  // Trust recovery in progress
    TrustState_Panic        = 0x08,  // Irrecoverable trust failure
}

// ──────────────────────────────────────────────
