// file: traits.phor
// purpose: Core traits for the Phorensic OS: Storage, Readable, Writeable,
//          Verifiable, Sealable, Replayable, CourtVerifiable, Hashable,
//          Measurable, and related trait definitions.
// evidence: TRAIT-ARCH-001 through TRAIT-ARCH-120
// residual: Traits use explicit effect declarations; no hidden dispatch.

use core::constants::*
use core::types::*
use core::errors::*
use core::capabilities::*
use core::effects::*
use core::handles::*
use core::collections::*

// ──────────────────────────────────────────────
// Trait: Hashable
// ──────────────────────────────────────────────
// Types that can be hashed to a Hash256 value.
// Evidence path: TRAIT-HASH-001 through TRAIT-HASH-020

pub trait Hashable : {
    // Compute a cryptographic hash of this value.
    fn hash(self) -> Hash256
        effects: [deterministic, hash]

    // Compute a non-cryptographic hash for use in hash tables.
    fn hash_fast(self) -> Word64
        effects: [deterministic]

    // Check if this value hashes to the given hash.
    fn hash_equals(self, expected: Hash256) -> bool
        effects: [deterministic, hash]
    {
        let h: Hash256 = self.hash()
        h.eq(expected)
    }
}

// ──────────────────────────────────────────────
// Trait: Measurable
// ──────────────────────────────────────────────
// Types that have a deterministic byte representation size.
// Evidence path: TRAIT-MEAS-001 through TRAIT-MEAS-015

pub trait Measurable : {
    // Return the exact byte size when serialized.
    fn byte_size(self) -> Size
        effects: [deterministic]

    // Return the fixed alignment requirement.
    fn alignment(self) -> Size
        effects: [deterministic]

    // Check if the size is fixed (known at compile time).
    fn is_fixed_size(self) -> bool
        effects: [deterministic]
    {
        true  // By default, types have fixed size in Phorensic.
    }
}

// ──────────────────────────────────────────────
// Trait: Readable
// ──────────────────────────────────────────────
// Allows reading bytes from a source at an offset.
// Evidence path: TRAIT-READ-001 through TRAIT-READ-025

pub trait Readable : {
    // Read bytes into a buffer starting at offset.
    // Returns the number of bytes actually read.
    fn read(self: ref mut, offset: Offset, buffer: ref mut Byte[], length: Size) -> Result[Size, StoreError>
        effects: [deterministic, io, storage]

    // Read a single byte at offset.
    fn read_byte(self: ref mut, offset: Offset) -> Result[Byte, StoreError>
        effects: [deterministic, io, storage]

    // Read a Word64 at offset (little-endian).
    fn read_word64(self: ref mut, offset: Offset) -> Result[Word64, StoreError>
        effects: [deterministic, io, storage]
    {
        let mut buf: Byte[8] = [Byte::from_u8(0); 8]
        let read: Size = self.read(offset, &mut buf, Size::from_u64(8))?
        if read.lt(Size::from_u64(8)) {
            return Result::Err(store_io_error(
                FixedString[128]::from_slice("Failed to read Word64")))
        }
        Result::Ok(Word64::from_le_bytes(buf))
    }

    // Check if data is available at offset.
    fn is_available(self, offset: Offset) -> bool
        effects: [deterministic, io, storage]

    // Get the total size of the readable source.
    fn total_size(self) -> Result[Size, StoreError>
        effects: [deterministic, io, storage]

    // Verify data integrity (checksum/hash).
    fn verify_integrity(self, offset: Offset, length: Size, expected: Hash256) -> Result[bool, StoreError>
        effects: [deterministic, io, storage, hash]
}

// ──────────────────────────────────────────────
// Trait: Writeable
// ──────────────────────────────────────────────
// Allows writing bytes to a destination at an offset.
// Evidence path: TRAIT-WRITE-001 through TRAIT-WRITE-025

pub trait Writeable : {
    // Write bytes from a buffer starting at offset.
    // Returns the number of bytes actually written.
    fn write(self: ref mut, offset: Offset, buffer: ref Byte[], length: Size) -> Result[Size, StoreError>
        effects: [deterministic, io, storage]

    // Write a single byte at offset.
    fn write_byte(self: ref mut, offset: Offset, value: Byte) -> Result[(), StoreError>
        effects: [deterministic, io, storage]

    // Write a Word64 at offset (little-endian).
    fn write_word64(self: ref mut, offset: Offset, value: Word64) -> Result[(), StoreError>
        effects: [deterministic, io, storage]
    {
        let buf: Byte[8] = value.to_le_bytes()
        let written: Size = self.write(offset, &buf, Size::from_u64(8))?
        if written.lt(Size::from_u64(8)) {
            return Result::Err(store_io_error(
                FixedString[128]::from_slice("Failed to write Word64")))
        }
        Result::Ok(())
    }

    // Flush any pending writes.
    fn flush(self: ref mut) -> Result[(), StoreError>
        effects: [deterministic, io, storage]

    // Truncate the writeable to a given size.
    fn truncate(self: ref mut, size: Size) -> Result<(), StoreError>
        effects: [deterministic, io, storage]

    // Set the seal on written data.
    fn seal_write(self: ref mut, seal: Hash256) -> Result<(), StoreError>
        effects: [deterministic, io, storage, seal]
}

// ──────────────────────────────────────────────
// Trait: Storage
// ──────────────────────────────────────────────
// Combines Readable and Writeable for persistent storage.
// Evidence path: TRAIT-STOR-001 through TRAIT-STOR-030

pub trait Storage : Readable, Writeable {
    // Get the storage identity.
    fn identity(self) -> Identity
        effects: [deterministic]

    // Open the storage resource (requires capability).
    fn open(handle: Handle, cap: Capability) -> Result[Self, StoreError>
        effects: [deterministic, io, storage, capability]

    // Close the storage resource.
    fn close(self: ref mut) -> Result<(), StoreError>
        effects: [deterministic, io, storage]

    // Format/initialize the storage.
    fn format(self: ref mut, parameters: StorageParameters) -> Result<(), StoreError>
        effects: [deterministic, io, storage]

    // Get storage metadata.
    fn metadata(self) -> Result[StorageMetadata, StoreError>
        effects: [deterministic, io, storage]

    // Create a snapshot of the current state.
    fn snapshot(self: ref mut) -> Result<Handle, StoreError>
        effects: [deterministic, io, storage, hash]

    // Restore from a snapshot.
    fn restore(self: ref mut, snapshot_handle: Handle) -> Result<(), StoreError>
        effects: [deterministic, io, storage, hash]
}

// ──────────────────────────────────────────────
// Storage Metadata
// ──────────────────────────────────────────────
// Evidence path: TRAIT-META-001 through TRAIT-META-015

pub type StorageMetadata : struct {
    total_capacity: Size,
    used_capacity: Size,
    format_version: Word64,
    creation_time: Timestamp,
    modification_time: Timestamp,
    seal_hash: Option[Hash256],
    integrity_hash: Hash256,
    trust_level: TrustLevel,
}

impl StorageMetadata {
    pub fn new(
        total_capacity: Size,
        used_capacity: Size,
        format_version: Word64,
        creation_time: Timestamp,
        modification_time: Timestamp,
    ) -> StorageMetadata
        effects: [deterministic]
    {
        StorageMetadata {
            total_capacity: total_capacity,
            used_capacity: used_capacity,
            format_version: format_version,
            creation_time: creation_time,
            modification_time: modification_time,
            seal_hash: Option::None,
            integrity_hash: Hash256::zeroed(),
            trust_level: TrustLevel::Trust_Attested,
        }
    }
}

// ──────────────────────────────────────────────
// Storage Parameters
// ──────────────────────────────────────────────
// Evidence path: TRAIT-PARAM-001 through TRAIT-PARAM-010

pub type StorageParameters : struct {
    capacity: Size,
    encryption: bool,
    integrity_checking: bool,
    version: Word64,
    label: FixedString[64],
}

impl StorageParameters {
    pub fn new(capacity: Size, label: FixedString[64]) -> StorageParameters
        effects: [deterministic]
    {
        StorageParameters {
            capacity: capacity,
            encryption: false,
            integrity_checking: true,
            version: Word64::from_u64(STORE_FORMAT_VER as u64),
            label: label,
        }
    }
}

// ──────────────────────────────────────────────
// Trait: Verifiable
// ──────────────────────────────────────────────
// Types that can be cryptographically verified.
// Evidence path: TRAIT-VERIFY-001 through TRAIT-VERIFY-025

pub trait Verifiable : {
    // Get the hash of this item's content.
    fn content_hash(self) -> Hash256
        effects: [deterministic, hash]

    // Get the signature over the content hash.
    fn signature(self) -> Option[Signature64]
        effects: [deterministic]

    // Verify against a known public key/hash.
    fn verify(self, expected_hash: Hash256) -> Result[bool, CourtError>
        effects: [deterministic, hash, verify]
    {
        let actual: Hash256 = self.content_hash()
        Result::Ok(actual.constant_time_eq(expected_hash))
    }

    // Verify a signature.
    fn verify_signature(self, public_key: Hash256, signature: Signature64) -> Result[bool, CourtError>
        effects: [deterministic, hash, verify]

    // Get the verification trust level.
    fn verification_trust(self) -> TrustLevel
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Trait: Sealable
// ──────────────────────────────────────────────
// Types that can be sealed (cryptographically locked).
// Evidence path: TRAIT-SEAL-001 through TRAIT-SEAL-025

pub trait Sealable : {
    // Seal the data with a sealing key.
    fn seal(self: ref mut, key: Hash256) -> Result<(), CourtError>
        effects: [deterministic, seal, hash]

    // Unseal the data with a sealing key.
    fn unseal(self: ref mut, key: Hash256) -> Result<(), CourtError>
        effects: [deterministic, unseal, hash]

    // Check if the data is sealed.
    fn is_sealed(self) -> bool
        effects: [deterministic]

    // Get the seal hash (the hash of the sealing key).
    fn seal_hash(self) -> Option[Hash256>
        effects: [deterministic, hash]

    // Get the seal depth (number of nested seals).
    fn seal_depth(self) -> u32
        effects: [deterministic]

    // Add a witness to the seal chain.
    fn add_witness(self: ref mut, witness: Identity, signature: Signature64) -> Result<(), CourtError>
        effects: [deterministic, seal, hash, verify]

    // Verify the witness chain.
    fn verify_witnesses(self) -> Result<bool, CourtError>
        effects: [deterministic, seal, hash, verify]
}

// ──────────────────────────────────────────────
// Trait: Replayable
// ──────────────────────────────────────────────
// Types that support deterministic replay of operations.
// Evidence path: TRAIT-REPLAY-001 through TRAIT-REPLAY-025

pub trait Replayable : {
    // The type of operation log entries.
    type LogEntry

    // Record an operation in the replay log.
    fn record(self: ref mut, entry: LogEntry) -> Result<(), StoreError>
        effects: [deterministic, io, storage, serialize]

    // Get the log entry at a given index.
    fn get_log_entry(self, index: Size) -> Result[LogEntry, StoreError>
        effects: [deterministic, io, storage, deserialize]

    // Get the current log length.
    fn log_length(self) -> Result[Size, StoreError>
        effects: [deterministic, io, storage]

    // Replay all operations from the log up to a given index.
    fn replay(self: ref mut, up_to_index: Size) -> Result<(), StoreError>
        effects: [deterministic, io, storage, deserialize]

    // Replay operations in reverse (for undo).
    fn replay_reverse(self: ref mut, from_index: Size, count: Size) -> Result<(), StoreError>
        effects: [deterministic, io, storage, deserialize]

    // Truncate the log to a given index.
    fn truncate_log(self: ref mut, to_index: Size) -> Result<(), StoreError>
        effects: [deterministic, io, storage]

    // Get the integrity hash of the log so far.
    fn log_integrity_hash(self) -> Result[Hash256, StoreError>
        effects: [deterministic, io, storage, hash]

    // Verify the log integrity.
    fn verify_log(self, expected_hash: Hash256) -> Result<bool, StoreError>
        effects: [deterministic, io, storage, hash, verify]
}

// ──────────────────────────────────────────────
// Trait: CourtVerifiable
// ──────────────────────────────────────────────
// Types that can be verified by a court (the verification authority).
// Evidence path: TRAIT-COURT-001 through TRAIT-COURT-030

pub trait CourtVerifiable : {
    // Get the evidence data for court verification.
    fn evidence(self) -> EvidencePackage
        effects: [deterministic, hash]

    // Submit to a court for verification.
    fn submit_to_court(self, court_handle: Handle, cap: Capability) -> Result[VerificationResult, CourtError>
        effects: [deterministic, hash, verify, court, capability]

    // Get the verification result from a court.
    fn verification_result(self, court_handle: Handle) -> Result[VerificationResult, CourtError>
        effects: [deterministic, court]

    // Get the court-issued certificate.
    fn court_certificate(self) -> Option[CourtCertificate]
        effects: [deterministic]

    // Check if this item has been court-verified.
    fn is_court_verified(self) -> bool
        effects: [deterministic]

    // Get the trust level after court verification.
    fn court_trust_level(self) -> TrustLevel
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Evidence Package
// ──────────────────────────────────────────────
// Evidence path: TRAIT-EVID-001 through TRAIT-EVID-020

pub type EvidencePackage : struct {
    // The content hash being verified.
    content_hash: Hash256,
    // The chain of hashes leading to a trust anchor.
    hash_chain: FixedArray[MAX_HASH_CHAIN_LENGTH, Hash256],
    // The signature over the content (if signed).
    signatures: FixedArray[MAX_COURT_WITNESSES, Signature64],
    // The identities of the signers.
    signers: FixedArray[MAX_COURT_WITNESSES, Identity],
    // The trust level being claimed.
    claimed_trust: TrustLevel,
    // The timestamp of evidence creation.
    timestamp: Timestamp,
    // The measurement data (for measured boot).
    measurements: FixedArray[MAX_TRUST_ANCHORS, Hash256],
}

impl EvidencePackage {
    pub fn new(content_hash: Hash256, claimed_trust: TrustLevel, timestamp: Timestamp) -> EvidencePackage
        effects: [deterministic]
    {
        EvidencePackage {
            content_hash: content_hash,
            hash_chain: FixedArray::new(),
            signatures: FixedArray::new(),
            signers: FixedArray::new(),
            claimed_trust: claimed_trust,
            timestamp: timestamp,
            measurements: FixedArray::new(),
        }
    }

    // Add a hash chain link.
    pub fn add_hash_link(self: ref mut, hash: Hash256) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.hash_chain.push(hash)
    }

    // Add a signature.
    pub fn add_signature(self: ref mut, signer: Identity, signature: Signature64) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.signers.push(signer)?;
        self.signatures.push(signature)
    }

    // Add a measurement.
    pub fn add_measurement(self: ref mut, measurement: Hash256) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.measurements.push(measurement)
    }

    // Verify the hash chain integrity.
    pub fn verify_hash_chain(self) -> bool
        effects: [deterministic, hash]
    {
        if self.hash_chain.is_empty() {
            return true
        }
        let mut current: Hash256 = self.hash_chain.get(0).unwrap()
        let mut i: u32 = 1
        // loop: bounds[BOUND_MEDIUM] — bounded by chain length
        loop: bounds[BOUND_MEDIUM] while i < self.hash_chain.len() {
            let next: Hash256 = self.hash_chain.get(i).unwrap()
            // In production, this would chain the hashes cryptographically.
            if next.is_zero() {
                return false
            }
            current = next
            i = i + 1
        }
        current.eq(self.content_hash)
    }
}

// ──────────────────────────────────────────────
// Verification Result
// ──────────────────────────────────────────────
// Evidence path: TRAIT-VR-001 through TRAIT-VR-015

pub type VerificationResult : struct {
    verified: bool,
    trust_level: TrustLevel,
    court_id: Identity,
    timestamp: Timestamp,
    certificate_hash: Hash256,
    error: Option[CourtError],
}

impl VerificationResult {
    pub fn passed(trust_level: TrustLevel, court_id: Identity, timestamp: Timestamp) -> VerificationResult
        effects: [deterministic]
    {
        VerificationResult {
            verified: true,
            trust_level: trust_level,
            court_id: court_id,
            timestamp: timestamp,
            certificate_hash: Hash256::zeroed(),
            error: Option::None,
        }
    }

    pub fn failed(error: CourtError, court_id: Identity, timestamp: Timestamp) -> VerificationResult
        effects: [deterministic]
    {
        VerificationResult {
            verified: false,
            trust_level: TrustLevel::Trust_Untrusted,
            court_id: court_id,
            timestamp: timestamp,
            certificate_hash: Hash256::zeroed(),
            error: Option::Some(error),
        }
    }

    pub fn is_verified(self) -> bool
        effects: [deterministic]
    {
        self.verified
    }

    pub fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust_level
    }

    pub fn court_id(self) -> Identity
        effects: [deterministic]
    {
        self.court_id
    }

    pub fn error(self) -> Option[CourtError]
        effects: [deterministic]
    {
        self.error
    }
}

// ──────────────────────────────────────────────
// Court Certificate
// ──────────────────────────────────────────────
// Evidence path: TRAIT-CERT-001 through TRAIT-CERT-015

pub type CourtCertificate : struct {
    certificate_id: Hash256,
    subject_hash: Hash256,
    issuer: Identity,
    valid_from: Timestamp,
    valid_until: Timestamp,
    trust_level: TrustLevel,
    signature: Signature64,
    witness_signatures: FixedArray[MAX_COURT_WITNESSES, (Identity, Signature64)],
}

impl CourtCertificate {
    pub fn new(
        subject_hash: Hash256,
        issuer: Identity,
        valid_from: Timestamp,
        valid_until: Timestamp,
        trust_level: TrustLevel,
        signature: Signature64,
    ) -> CourtCertificate
        effects: [deterministic]
    {
        // Compute certificate ID from content.
        let cert_id: Hash256 = subject_hash  // In production: hash of all fields
        CourtCertificate {
            certificate_id: cert_id,
            subject_hash: subject_hash,
            issuer: issuer,
            valid_from: valid_from,
            valid_until: valid_until,
            trust_level: trust_level,
            signature: signature,
            witness_signatures: FixedArray::new(),
        }
    }

    // Check if the certificate is currently valid.
    pub fn is_valid_at(self, time: Timestamp) -> bool
        effects: [deterministic]
    {
        time.gte(self.valid_from) && time.lte(self.valid_until)
    }

    // Add a witness signature.
    pub fn add_witness(self: ref mut, witness: Identity, signature: Signature64) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.witness_signatures.push((witness, signature))
    }

    // Get the certificate validity period.
    pub fn validity_period(self) -> (Timestamp, Timestamp)
        effects: [deterministic]
    {
        (self.valid_from, self.valid_until)
    }

    // Get the certificate ID.
    pub fn id(self) -> Hash256
        effects: [deterministic]
    {
        self.certificate_id
    }
}

// ──────────────────────────────────────────────
// Trait: Transformable
// ──────────────────────────────────────────────
// Types that can be deterministically transformed.
// Evidence path: TRAIT-TRANS-001 through TRAIT-TRANS-020

pub trait Transformable[T] : {
    // Transform from one representation to another.
    fn transform(self) -> T
        effects: [deterministic]

    // Transform with a key/nonce.
    fn transform_with_key(self, key: Hash256) -> T
        effects: [deterministic, hash]

    // Check if transformation is invertible.
    fn is_invertible(self) -> bool
        effects: [deterministic]

    // Inverse transformation.
    fn inverse(self, transformed: T) -> Result[Self, TransformError>
        effects: [deterministic]
}

pub type TransformError : struct { msg: FixedString[128] }

// ──────────────────────────────────────────────
// Trait: TrustAnchored
// ──────────────────────────────────────────────
// Types that derive authority from a trust anchor.
// Evidence path: TRAIT-TRUST-001 through TRAIT-TRUST-020

pub trait TrustAnchored : {
    // Get the trust anchor hash.
    fn anchor(self) -> Hash256
        effects: [deterministic]

    // Measure the current state and return the measurement hash.
    fn measure(self) -> Hash256
        effects: [deterministic, hash]

    // Extend a measurement with new data (for PCR-style measurements).
    fn extend_measurement(self: ref mut, data: Hash256)
        effects: [deterministic, hash]

    // Verify against a known good value.
    fn verify_against(self, known_good: Hash256) -> bool
        effects: [deterministic, hash, verify]
    {
        let measured: Hash256 = self.measure()
        measured.constant_time_eq(known_good)
    }

    // Get the current trust state.
    fn trust_state(self) -> TrustState
        effects: [deterministic]

    // Get the current trust level.
    fn trust_level(self) -> TrustLevel
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Trait: Clock
// ──────────────────────────────────────────────
// Provides time measurement.
// Evidence path: TRAIT-CLOCK-001 through TRAIT-CLOCK-015

pub trait Clock : {
    // Get the current timestamp.
    fn now(self) -> Timestamp
        effects: [deterministic, clock]

    // Get the timestamp with minimum granularity guarantee.
    fn now_precise(self) -> Timestamp
        effects: [deterministic, clock]

    // Get the resolution of this clock.
    fn resolution(self) -> Duration
        effects: [deterministic]

    // Check if the clock is monotonic.
    fn is_monotonic(self) -> bool
        effects: [deterministic]

    // Sleep for a given duration.
    fn sleep(self: ref mut, duration: Duration)
        effects: [deterministic, clock, timer]

    // Set an alarm for a future time.
    fn set_alarm(self, time: Timestamp, callback: EffectClosure[(), ()]) -> Result<Handle, HandleError>
        effects: [deterministic, clock, timer, capability]
}

// ──────────────────────────────────────────────
// Trait: RandomSource
// ──────────────────────────────────────────────
// Provides random bytes.
// Evidence path: TRAIT-RNG-001 through TRAIT-RNG-015

pub trait RandomSource : {
    // Fill a buffer with random bytes.
    fn fill_bytes(self: ref mut, buffer: ref mut Byte[], count: Size) -> Result<(), DriverError>
        effects: [deterministic, random, io]

    // Generate a random Word64.
    fn next_word64(self: ref mut) -> Result[Word64, DriverError>
        effects: [deterministic, random, io]

    // Generate a random Word32.
    fn next_word32(self: ref mut) -> Result[Word32, DriverError>
        effects: [deterministic, random, io]

    // Generate a random Hash256.
    fn next_hash256(self: ref mut) -> Result[Hash256, DriverError>
        effects: [deterministic, random, io]

    // Reseed the random source with additional entropy.
    fn reseed(self: ref mut, entropy: Byte[], count: Size)
        effects: [deterministic, random, io]

    // Check if the random source is cryptographically secure.
    fn is_cryptographically_secure(self) -> bool
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Trait: Finalizable
// ──────────────────────────────────────────────
// Types with explicit finalization/cleanup lifecycle.
// Evidence path: TRAIT-FINAL-001 through TRAIT-FINAL-010

pub trait Finalizable : {
    // Finalize and release resources. Must be called exactly once.
    fn finalize(self: ref mut)
        effects: [deterministic]

    // Check if already finalized.
    fn is_finalized(self) -> bool
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Trait: Encodeable
// ──────────────────────────────────────────────
// Types that can be encoded to/decoded from bytes.
// Evidence path: TRAIT-ENCODE-001 through TRAIT-ENCODE-015

pub trait Encodeable : Measurable {
    // Encode to a fixed-size byte buffer.
    fn encode(self) -> FixedArray[Self::byte_size(), Byte]
        effects: [deterministic, serialize]

    // Decode from a byte buffer.
    fn decode(buffer: Byte[], length: Size) -> Result[Self, SerializationError>
        effects: [deterministic, deserialize]
}

// ──────────────────────────────────────────────
// Default trait implementations for core types
// ──────────────────────────────────────────────
// Evidence path: TRAIT-IMPL-001 through TRAIT-IMPL-030

impl Hashable for Byte {
    fn hash(self) -> Hash256
        effects: [deterministic, hash]
    {
        let mut bytes: [Byte; 32] = [Byte::from_u8(0); 32]
        bytes[0] = self
        Hash256::from_bytes(bytes)
    }

    fn hash_fast(self) -> Word64
        effects: [deterministic]
    {
        Word64::from_u64(self.to_u8() as u64)
    }
}

impl Measurable for Byte {
    fn byte_size(self) -> Size
        effects: [deterministic]
    {
        Size::from_u64(1)
    }

    fn alignment(self) -> Size
        effects: [deterministic]
    {
        Size::from_u64(1)
    }
}

impl Hashable for Word64 {
    fn hash(self) -> Hash256
        effects: [deterministic, hash]
    {
        let bytes: Byte[8] = self.to_le_bytes()
        let mut hash_bytes: [Byte; 32] = [Byte::from_u8(0); 32]
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            hash_bytes[i] = bytes[i]
        }
        Hash256::from_bytes(hash_bytes)
    }

    fn hash_fast(self) -> Word64
        effects: [deterministic]
    {
        self
    }
}

impl Measurable for Word64 {
    fn byte_size(self) -> Size
        effects: [deterministic]
    {
        Size::from_u64(WORD64_BYTES as u64)
    }

    fn alignment(self) -> Size
        effects: [deterministic]
    {
        Size::from_u64(WORD64_BYTES as u64)
    }
}

impl Hashable for Hash256 {
    fn hash(self) -> Hash256
        effects: [deterministic, hash]
    {
        self
    }

    fn hash_fast(self) -> Word64
        effects: [deterministic]
    {
        self.low_word64()
    }
}

impl Measurable for Hash256 {
    fn byte_size(self) -> Size
        effects: [deterministic]
    {
        Size::from_u64(HASH256_BYTES as u64)
    }

    fn alignment(self) -> Size
        effects: [deterministic]
    {
        Size::from_u64(4)  // 4-byte alignment for Hash256
    }
}

impl Hashable for Identity {
    fn hash(self) -> Hash256
        effects: [deterministic, hash]
    {
        self.to_hash()
    }

    fn hash_fast(self) -> Word64
        effects: [deterministic]
    {
        self.as_word64()
    }
}

impl Measurable for Identity {
    fn byte_size(self) -> Size
        effects: [deterministic]
    {
