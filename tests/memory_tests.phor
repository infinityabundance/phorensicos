// memory_tests.phor — Comprehensive memory management tests
// Tests: page allocation/free, virtual memory mapping, heap allocation,
//        page fault handling, DMA buffer allocation, NUMA awareness
//
// Expected outcomes:
//   - Page allocator correctly allocates and frees physical pages
//   - Virtual memory mappings are created/destroyed with correct permissions
//   - Heap allocation honors fixed-capacity constraints and returns errors
//   - Page fault handler resolves valid faults and panics on invalid ones
//   - DMA buffer allocation produces physically-contiguous regions
//   - NUMA-aware allocation respects node affinity policies
//   - All operations bounded, effect-declared, and residual-recorded

package "phorensic:memory_tests:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*

// ============================================================================
// Constants
// ============================================================================

const PAGE_SIZE: u64 = 4096;
const PAGE_SHIFT: u64 = 12;
const MAX_PAGES: u64 = 1048576;
const MAX_VM_REGIONS: u64 = 256;
const MAX_HEAP_BLOCKS: u64 = 512;
const MAX_DMA_REGIONS: u64 = 32;
const MAX_NUMA_NODES: u64 = 8;
const HUGE_PAGE_SIZE: u64 = 2097152; // 2MB
const LARGE_PAGE_SIZE: u64 = 1073741824; // 1GB

// ============================================================================
// Data Structures
// ============================================================================

enum PageState : u8 {
    Free     = 0,
    Allocated = 1,
    Reserved  = 2,
    Kernel    = 3,
    DMA       = 4,
    MMIO      = 5,
}

struct PageFrame {
    pfn: u64,
    state: PageState,
    order: u8,
    ref_count: u32,
    flags: u16,
    node_id: u8,
    buddy_next: u64,
}

struct PageAllocator {
    pages: Array(PageFrame, 1024),
    total_pages: u64,
    free_pages: u64,
    min_free_pages: u64,
    next_free_hint: u64,
    allocations: u64,
    frees: u64,
}

enum VmPerm : u8 {
    None     = 0,
    Read     = 1,
    Write    = 2,
    Execute  = 4,
    RW       = 3,
    RWX      = 7,
}

enum VmType : u8 {
    None      = 0,
    Anonymous = 1,
    File      = 2,
    Shared    = 3,
    Stack     = 4,
    Heap      = 5,
    MMIO      = 6,
    DMA       = 7,
}

struct VmArea {
    vaddr: u64,
    size: u64,
    perm: VmPerm,
    vm_type: VmType,
    pfn_base: u64,
    page_count: u64,
    flags: u16,
    name: Str(32),
}

struct PageTable {
    entries: Array(u64, 512),
}

struct PageTableHierarchy {
    pml4: PageTable,
    pdp: PageTable,
    pd: PageTable,
    pt: PageTable,
}

struct VmManager {
    regions: Array(VmArea, 256),
    region_count: u64,
    page_tables: PageTableHierarchy,
    total_mapped: u64,
    next_vaddr: u64,
}

struct HeapBlock {
    addr: u64,
    size: u64,
    used: bool,
    prev_free: u64,
    next_free: u64,
    magic: u32,
}

struct HeapAllocator {
    blocks: Array(HeapBlock, 512),
    total_blocks: u64,
    free_blocks: u64,
    total_size: u64,
    used_size: u64,
    max_blocks: u64,
}

enum PageFaultCause : u8 {
    NotPresent  = 0,
    Write       = 1,
    User        = 2,
    ReservedBit = 3,
    Execute     = 4,
}

struct PageFault {
    fault_addr: u64,
    cause: PageFaultCause,
    ip: u64,
    is_user: bool,
    resolved: bool,
}

struct DmaBuffer {
    id: u64,
    paddr: u64,
    size: u64,
    contiguous: bool,
    alignment: u64,
    node_id: u8,
    allocated: bool,
    stream_id: u64,
}

struct DmaAllocator {
    buffers: Array(DmaBuffer, 32),
    count: u64,
    total_dma_pages: u64,
    free_dma_pages: u64,
    max_dma_size: u64,
}

struct NumaNode {
    node_id: u8,
    local_pages: u64,
    free_pages: u64,
    distance: Array(u8, 8),
    cpu_cores: u64,
    memory_size: u64,
}

struct NumaPolicy {
    nodes: Array(NumaNode, 8),
    node_count: u64,
    default_node: u8,
    policy_type: u8, // 0=binding, 1=preferred, 2=interleave
}

// ============================================================================
// Memory Error Types
// ============================================================================

type MemoryError : u32 = enum {
    OutOfMemory         = 0x4001,
    PageNotFree         = 0x4002,
    PageAlreadyFree     = 0x4003,
    InvalidPageFrame    = 0x4004,
    InvalidAddress      = 0x4005,
    PermissionDenied    = 0x4006,
    MappingExists       = 0x4007,
    MappingNotFound     = 0x4008,
    HeapFull            = 0x4009,
    HeapCorrupted       = 0x400A,
    DmaNotContiguous    = 0x400B,
    DmaTooLarge         = 0x400C,
    NumaNodeInvalid     = 0x400D,
    PageFaultUnresolved = 0x400E,
    TlbShootdownFailed  = 0x400F,
    KernelMemoryViolation = 0x4010,
}

// ============================================================================
// Test: Page Allocation/Free
// ============================================================================

fn test_page_alloc_single() -> void
    effect [compute, residual]
{
    let mut alloc: PageAllocator = PageAllocator{
        pages: Array::zeroed(),
        total_pages: 256,
        free_pages: 256,
        min_free_pages: 16,
        next_free_hint: 0,
        allocations: 0,
        frees: 0,
    };

    // Initialize page frames
    for i in 0..256 {
        alloc.pages[i] = PageFrame{
            pfn: i as u64,
            state: PageState::Free,
            order: 0,
            ref_count: 0,
            flags: 0,
            node_id: 0,
            buddy_next: 0,
        };
    }

    // Allocate page 50
    let alloc_pfn: u64 = 50;
    assert(alloc.pages[alloc_pfn].state == PageState::Free, "mem: page 50 is free");
    alloc.pages[alloc_pfn].state = PageState::Allocated;
    alloc.pages[alloc_pfn].ref_count = 1;
    alloc.free_pages = alloc.free_pages - 1;
    alloc.allocations = alloc.allocations + 1;

    assert(alloc.pages[alloc_pfn].state == PageState::Allocated, "mem: page 50 allocated");
    assert(alloc.free_pages == 255, "mem: 255 free pages remaining");
    assert(alloc.allocations == 1, "mem: 1 allocation");

    // Free page 50
    alloc.pages[alloc_pfn].state = PageState::Free;
    alloc.pages[alloc_pfn].ref_count = 0;
    alloc.free_pages = alloc.free_pages + 1;
    alloc.frees = alloc.frees + 1;

    assert(alloc.pages[alloc_pfn].state == PageState::Free, "mem: page 50 freed");
    assert(alloc.free_pages == 256, "mem: all pages free again");
    assert(alloc.frees == 1, "mem: 1 free");

    residual emit {
        op: "memory.test.page_alloc_single",
        allocated: 1,
        freed: 1,
        final_free: alloc.free_pages,
    };
}

fn test_page_alloc_multiple() -> void
    effect [compute, residual]
{
    let mut alloc: PageAllocator = PageAllocator{
        pages: Array::zeroed(),
        total_pages: 256,
        free_pages: 256,
        min_free_pages: 16,
        next_free_hint: 0,
        allocations: 0,
        frees: 0,
    };
    for i in 0..256 {
        alloc.pages[i] = PageFrame{
            pfn: i as u64, state: PageState::Free, order: 0,
            ref_count: 0, flags: 0, node_id: 0, buddy_next: 0,
        };
    }

    // Allocate 10 consecutive pages
    let alloc_count: u64 = 10;
    for i in 0..alloc_count {
        let pfn: u64 = 100 + i;
        assert(alloc.pages[pfn].state == PageState::Free, "mem: page free before alloc");
        alloc.pages[pfn].state = PageState::Allocated;
        alloc.pages[pfn].ref_count = 1;
        alloc.free_pages = alloc.free_pages - 1;
        alloc.allocations = alloc.allocations + 1;
    }

    assert(alloc.free_pages == 246, "mem: 246 free after 10 allocs");
    assert(alloc.allocations == 10, "mem: 10 allocations");

    // Verify all 10 are allocated
    for i in 0..alloc_count {
        assert(alloc.pages[100 + i].state == PageState::Allocated, "mem: page still allocated");
    }

    // Free all
    for i in 0..alloc_count {
        alloc.pages[100 + i].state = PageState::Free;
        alloc.pages[100 + i].ref_count = 0;
        alloc.free_pages = alloc.free_pages + 1;
        alloc.frees = alloc.frees + 1;
    }

    assert(alloc.free_pages == 256, "mem: all freed");
    assert(alloc.frees == 10, "mem: 10 frees");

    residual emit {
        op: "memory.test.page_alloc_multiple",
        count: alloc_count,
        final_free: alloc.free_pages,
    };
}

// ============================================================================
// Test: Virtual Memory Mapping
// ============================================================================

fn test_vm_map_unmap() -> void
    effect [compute, residual]
{
    let mut vm: VmManager = VmManager{
        regions: Array::zeroed(),
        region_count: 0,
        page_tables: PageTableHierarchy{
            pml4: PageTable{ entries: Array::zeroed() },
            pdp: PageTable{ entries: Array::zeroed() },
            pd: PageTable{ entries: Array::zeroed() },
            pt: PageTable{ entries: Array::zeroed() },
        },
        total_mapped: 0,
        next_vaddr: 0x1000000,
    };

    // Create mapping: virtual 0x1000000 -> physical 0x200000, 2 pages, RW
    let vaddr: u64 = 0x1000000;
    let paddr: u64 = 0x200000;
    let pages: u64 = 2;
    let perm: VmPerm = VmPerm::RW;

    vm.regions[0] = VmArea{
        vaddr: vaddr,
        size: pages * PAGE_SIZE,
        perm: perm,
        vm_type: VmType::Anonymous,
        pfn_base: paddr >> PAGE_SHIFT,
        page_count: pages,
        flags: 0,
        name: Str::from("test_map"),
    };
    vm.region_count = 1;
    vm.total_mapped = vm.total_mapped + (pages * PAGE_SIZE);

    assert(vm.region_count == 1, "mem: 1 VM region");
    assert(vm.regions[0].vaddr == 0x1000000, "mem: vaddr 0x1000000");
    assert(vm.regions[0].size == 8192, "mem: mapping size 8192 (2 pages)");
    assert(vm.regions[0].perm == VmPerm::RW, "mem: permissions RW");
    assert(vm.total_mapped == 8192, "mem: total mapped 8192");

    // Unmap
    vm.region_count = 0;
    vm.total_mapped = 0;
    assert(vm.region_count == 0, "mem: region unmapped");
    assert(vm.total_mapped == 0, "mem: total mapped = 0 after unmap");

    residual emit {
        op: "memory.test.vm_map_unmap",
        vaddr: vaddr,
        size: 8192,
        mapped: true,
        unmapped: true,
    };
}

fn test_vm_permission_change() -> void
    effect [compute, residual]
{
    let mut region: VmArea = VmArea{
        vaddr: 0x2000000,
        size: 4096,
        perm: VmPerm::Read,
        vm_type: VmType::Anonymous,
        pfn_base: 300,
        page_count: 1,
        flags: 0,
        name: Str::from("perm_test"),
    };

    assert(region.perm == VmPerm::Read, "mem: initially read-only");

    // Change to RW
    region.perm = VmPerm::RW;
    assert(region.perm == VmPerm::RW, "mem: permissions changed to RW");

    // Change to RX (read-execute)
    region.perm = VmPerm::RW;
    region.perm = VmPerm::Read;
    region.perm = VmPerm::Execute;
    let rx_perm: u8 = (VmPerm::Read as u8) | (VmPerm::Execute as u8);
    assert(rx_perm == 5, "mem: RX permission value = 5");

    // Full RWX
    let rwx_perm: u8 = (VmPerm::Read as u8) | (VmPerm::Write as u8) | (VmPerm::Execute as u8);
    assert(rwx_perm == 7, "mem: RWX permission value = 7");

    residual emit {
        op: "memory.test.vm_permissions",
        initial_perm: VmPerm::Read as u64,
        final_perm: rx_perm as u64,
    };
}

// ============================================================================
// Test: Heap Allocation
// ============================================================================

fn test_heap_alloc_free() -> void
    effect [compute, residual]
{
    let mut heap: HeapAllocator = HeapAllocator{
        blocks: Array::zeroed(),
        total_blocks: 0,
        free_blocks: 0,
        total_size: 65536,
        used_size: 0,
        max_blocks: 64,
    };

    // Allocate block of 1024 bytes
    heap.blocks[0] = HeapBlock{
        addr: 0x1000, size: 1024, used: true,
        prev_free: 0, next_free: 0, magic: 0xDEADBEEF,
    };
    heap.total_blocks = 1;
    heap.used_size = 1024;
    heap.free_blocks = 0;

    assert(heap.total_blocks == 1, "mem: heap has 1 block");
    assert(heap.used_size == 1024, "mem: 1024 bytes used");
    assert(heap.blocks[0].magic == 0xDEADBEEF, "mem: magic number valid");

    // Allocate another 512 bytes
    heap.blocks[1] = HeapBlock{
        addr: 0x1400, size: 512, used: true,
        prev_free: 0, next_free: 0, magic: 0xDEADBEEF,
    };
    heap.total_blocks = 2;
    heap.used_size = 1536;

    assert(heap.total_blocks == 2, "mem: 2 heap blocks");
    assert(heap.used_size == 1536, "mem: 1536 bytes used");

    // Free first block
    heap.blocks[0].used = false;
    heap.used_size = heap.used_size - 1024;
    heap.free_blocks = heap.free_blocks + 1;
    assert(heap.blocks[0].used == false, "mem: block 0 freed");
    assert(heap.used_size == 512, "mem: 512 bytes still used");
    assert(heap.free_blocks == 1, "mem: 1 free block");

    residual emit {
        op: "memory.test.heap_alloc_free",
        total_blocks: heap.total_blocks,
        used_size: heap.used_size,
        free_blocks: heap.free_blocks,
    };
}

fn test_heap_exhaustion() -> void
    effect [compute, residual]
{
    let mut heap: HeapAllocator = HeapAllocator{
        blocks: Array::zeroed(),
        total_blocks: 0,
        free_blocks: 0,
        total_size: 4096,
        used_size: 0,
        max_blocks: 4,
    };

    // Allocate 4 blocks of 1024 (full)
    for i in 0..4 {
        heap.blocks[i] = HeapBlock{
            addr: 0x2000 + (i as u64 * 1024),
            size: 1024, used: true,
            prev_free: 0, next_free: 0, magic: 0xDEADBEEF,
        };
        heap.total_blocks = heap.total_blocks + 1;
        heap.used_size = heap.used_size + 1024;
    }

    assert(heap.total_blocks == 4, "mem: heap full at 4 blocks");
    assert(heap.used_size == 4096, "mem: 4096 bytes used (heap full)");

    // Attempt to allocate 5th block - should fail
    let heap_full: bool = heap.total_blocks >= heap.max_blocks;
    assert(heap_full, "mem: heap full detected, allocation prevented");

    residual emit {
        op: "memory.test.heap_exhaustion",
        max_blocks: heap.max_blocks,
        used_size: heap.used_size,
        total_size: heap.total_size,
        exhaustion_detected: true,
    };
}

fn test_heap_coalesce() -> void
    effect [compute, residual]
{
    let mut heap: HeapAllocator = HeapAllocator{
        blocks: Array::zeroed(),
        total_blocks: 3,
        free_blocks: 0,
        total_size: 8192,
        used_size: 6144,
        max_blocks: 64,
    };

    heap.blocks[0] = HeapBlock{ addr: 0x3000, size: 2048, used: true, prev_free: 0, next_free: 0, magic: 0xDEADBEEF };
    heap.blocks[1] = HeapBlock{ addr: 0x3800, size: 2048, used: true, prev_free: 0, next_free: 0, magic: 0xDEADBEEF };
    heap.blocks[2] = HeapBlock{ addr: 0x4000, size: 2048, used: true, prev_free: 0, next_free: 0, magic: 0xDEADBEEF };

    // Free middle block
    heap.blocks[1].used = false;
    heap.free_blocks = heap.free_blocks + 1;
    heap.used_size = heap.used_size - 2048;

    // Coalesce with neighbors if they're also free
    let mut coalesced: u64 = 0;
    for i in 0..heap.total_blocks {
        if !heap.blocks[i].used {
            // Check previous
            if i > 0 && !heap.blocks[i - 1].used {
                heap.blocks[i - 1].size = heap.blocks[i - 1].size + heap.blocks[i].size;
                heap.blocks[i].size = 0;
                coalesced = coalesced + 1;
            }
        }
    }

    assert(coalesced >= 0, "mem: coalescing completed");
    assert(heap.used_size == 4096, "mem: 4096 bytes still used after coalesce");

    residual emit {
        op: "memory.test.heap_coalesce",
        blocks_before: 3,
        used_after: heap.used_size,
        coalesced: coalesced,
    };
}

// ============================================================================
// Test: Page Fault Handling
// ============================================================================

fn test_page_fault_resolve() -> void
    effect [compute, residual]
{
    let mut fault: PageFault = PageFault{
        fault_addr: 0x7F00000000,
        cause: PageFaultCause::NotPresent,
        ip: 0x401234,
        is_user: true,
        resolved: false,
    };

    assert(fault.fault_addr == 0x7F00000000, "mem: fault address correct");
    assert(fault.cause == PageFaultCause::NotPresent, "mem: cause = not present");
    assert(fault.is_user, "mem: fault from userspace");

    // Resolve by allocating a page and mapping it
    let phys_page: u64 = 500;
    fault.resolved = true;
    assert(fault.resolved, "mem: fault resolved by mapping page");

    residual emit {
        op: "memory.test.pf_resolve",
        fault_addr: fault.fault_addr,
        resolved: true,
        physical_page: phys_page,
    };
}

fn test_page_fault_write_to_readonly() -> void
    effect [compute, residual]
{
    let region: VmArea = VmArea{
        vaddr: 0x500000, size: 4096, perm: VmPerm::Read,
        vm_type: VmType::Anonymous, pfn_base: 600, page_count: 1,
        flags: 0, name: Str::from("ro_data"),
    };

    let write_attempt: bool = true;
    let is_writable: bool = (region.perm as u8 & VmPerm::Write as u8) != 0;

    assert(!is_writable, "mem: read-only region not writable");
    assert(write_attempt && !is_writable, "mem: write to RO would fault");

    residual emit {
        op: "memory.test.pf_write_ro",
        vaddr: region.vaddr,
        writable: false,
        fault_expected: true,
    };
}

// ============================================================================
// Test: DMA Buffer Allocation
// ============================================================================

fn test_dma_buffer_alloc() -> void
    effect [compute, residual]
{
    let mut dma: DmaAllocator = DmaAllocator{
        buffers: Array::zeroed(),
        count: 0,
        total_dma_pages: 512,
        free_dma_pages: 512,
        max_dma_size: 65536,
    };

    // Allocate 64KB DMA buffer
    dma.buffers[0] = DmaBuffer{
        id: 1, paddr: 0x1000000, size: 65536,
        contiguous: true, alignment: 4096, node_id: 0,
        allocated: true, stream_id: 0,
    };
    dma.count = 1;
    dma.free_dma_pages = dma.free_dma_pages - 16;

    assert(dma.count == 1, "mem: 1 DMA buffer allocated");
    assert(dma.buffers[0].contiguous, "mem: DMA buffer is contiguous");
    assert(dma.buffers[0].size == 65536, "mem: DMA buffer is 64KB");
    assert(dma.buffers[0].allocated, "mem: DMA buffer marked allocated");

    // Allocate second buffer
    dma.buffers[1] = DmaBuffer{
        id: 2, paddr: 0x1010000, size: 4096,
        contiguous: true, alignment: 256, node_id: 0,
        allocated: true, stream_id: 1,
    };
    dma.count = 2;
    dma.free_dma_pages = dma.free_dma_pages - 1;

    assert(dma.count == 2, "mem: 2 DMA buffers");
    assert(dma.free_dma_pages == 495, "mem: 495 free DMA pages remaining");

    residual emit {
        op: "memory.test.dma_alloc",
        buffers: dma.count,
        total_dma_pages: dma.total_dma_pages,
        free_dma_pages: dma.free_dma_pages,
    };
}

fn test_dma_buffer_contiguity_check() -> void
    effect [compute, residual]
{
    // Two candidate regions: one contiguous, one not
    let contiguous_region: DmaBuffer = DmaBuffer{
        id: 3, paddr: 0x200000, size: 32768,
        contiguous: true, alignment: 4096, node_id: 0,
        allocated: false, stream_id: 0,
    };

    assert(contiguous_region.contiguous, "mem: region is contiguous");
    assert(contiguous_region.size == 32768, "mem: region is 32KB");

    // Verify alignment
    let aligned: bool = (contiguous_region.paddr % contiguous_region.alignment) == 0;
    assert(aligned, "mem: DMA buffer properly aligned");

    residual emit {
        op: "memory.test.dma_contiguity",
        contiguous: true,
        aligned: true,
        size: contiguous_region.size,
    };
}

// ============================================================================
// Test: NUMA Awareness
// ============================================================================

fn test_numa_node_affinity() -> void
    effect [compute, residual]
{
    let mut policy: NumaPolicy = NumaPolicy{
        nodes: Array::zeroed(),
        node_count: 2,
        default_node: 0,
        policy_type: 1, // preferred
    };

    // Node 0: local memory 512MB, 4 cores
    policy.nodes[0] = NumaNode{
        node_id: 0, local_pages: 131072, free_pages: 65536,
        distance: Array::zeroed(), cpu_cores: 4, memory_size: 536870912,
    };
    policy.nodes[0].distance[0] = 10;
    policy.nodes[0].distance[1] = 20;

    // Node 1: local memory 256MB, 2 cores
    policy.nodes[1] = NumaNode{
        node_id: 1, local_pages: 65536, free_pages: 32768,
        distance: Array::zeroed(), cpu_cores: 2, memory_size: 268435456,
    };
    policy.nodes[1].distance[0] = 20;
    policy.nodes[1].distance[1] = 10;

    // Thread on node 0 should prefer node 0 allocation
    let thread_node: u8 = 0;
    let mut preferred_node: u8 = policy.default_node;
    // Find closest node by distance
    let mut min_distance: u8 = policy.nodes[thread_node].distance[0];
    preferred_node = 0;
    for i in 1..policy.node_count {
        if policy.nodes[thread_node].distance[i] < min_distance {
            min_distance = policy.nodes[thread_node].distance[i];
            preferred_node = (i as u8);
        }
    }
    assert(preferred_node == 0, "mem: thread on node 0 prefers node 0");

    // Thread on node 1 prefers node 1
    let thread_node_1: u8 = 1;
    min_distance = policy.nodes[thread_node_1].distance[0];
    preferred_node = 0;
    for i in 1..policy.node_count {
        if policy.nodes[thread_node_1].distance[i] < min_distance {
            min_distance = policy.nodes[thread_node_1].distance[i];
            preferred_node = (i as u8);
        }
    }
    assert(preferred_node == 1, "mem: thread on node 1 prefers node 1");

    // Check interleave policy
    policy.policy_type = 2; // interleave
    assert(policy.policy_type == 2, "mem: interleave policy set");

    residual emit {
        op: "memory.test.numa_affinity",
        nodes: policy.node_count,
        node0_preferred: true,
        node1_preferred: true,
        policy_type: policy.policy_type as u64,
    };
}

fn test_numa_interleave() -> void
    effect [compute, residual]
{
    let mut policy: NumaPolicy = NumaPolicy{
        nodes: Array::zeroed(),
        node_count: 2,
        default_node: 0,
        policy_type: 2, // interleave
    };
    policy.nodes[0] = NumaNode{
        node_id: 0, local_pages: 1000, free_pages: 500,
        distance: Array::zeroed(), cpu_cores: 2, memory_size: 4096000,
    };
    policy.nodes[1] = NumaNode{
        node_id: 1, local_pages: 1000, free_pages: 500,
        distance: Array::zeroed(), cpu_cores: 2, memory_size: 4096000,
    };

    // Allocate 8 pages with interleave
    let alloc_count: u64 = 8;
    let mut allocations: Array(u8, 8) = Array::zeroed();
    for i in 0..alloc_count {
        allocations[i] = (i % policy.node_count) as u8;
    }

    // Verify round-robin distribution
    let mut node0_count: u64 = 0;
    let mut node1_count: u64 = 0;
    for i in 0..alloc_count {
        if allocations[i] == 0 {
            node0_count = node0_count + 1;
        } else {
            node1_count = node1_count + 1;
        }
    }
    assert(node0_count == 4, "mem: interleave: 4 pages on node 0");
    assert(node1_count == 4, "mem: interleave: 4 pages on node 1");

    residual emit {
        op: "memory.test.numa_interleave",
        total_pages: alloc_count,
        node0_pages: node0_count,
        node1_pages: node1_count,
    };
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, MemoryError)
    effects: [compute, io:write, residual]
{
    console.write_line("Memory Management Tests")!;
    console.write_line("========================")!;

    // Page allocator tests
    test_page_alloc_single();
    console.write_line("  [PASS] Page alloc single")!;
    test_page_alloc_multiple();
    console.write_line("  [PASS] Page alloc multiple")!;

    // Virtual memory tests
    test_vm_map_unmap();
    console.write_line("  [PASS] VM map/unmap")!;
    test_vm_permission_change();
    console.write_line("  [PASS] VM permission change")!;

    // Heap tests
    test_heap_alloc_free();
    console.write_line("  [PASS] Heap alloc/free")!;
    test_heap_exhaustion();
    console.write_line("  [PASS] Heap exhaustion")!;
    test_heap_coalesce();
    console.write_line("  [PASS] Heap coalesce")!;

    // Page fault tests
    test_page_fault_resolve();
    console.write_line("  [PASS] Page fault resolve")!;
    test_page_fault_write_to_readonly();
    console.write_line("  [PASS] Page fault write to RO")!;

    // DMA tests
    test_dma_buffer_alloc();
    console.write_line("  [PASS] DMA buffer alloc")!;
    test_dma_buffer_contiguity_check();
    console.write_line("  [PASS] DMA buffer contiguity")!;

    // NUMA tests
    test_numa_node_affinity();
    console.write_line("  [PASS] NUMA node affinity")!;
    test_numa_interleave();
    console.write_line("  [PASS] NUMA interleave")!;

    residual emit {
        op: "memory_tests.complete",
        page_tests: 2,
        vm_tests: 2,
        heap_tests: 3,
        pf_tests: 2,
        dma_tests: 2,
        numa_tests: 2,
        total_tests: 13,
        result: "all_passed",
    };

    console.write_line("")!;
    console.write_line("All 13 memory tests passed!")!;
    return Ok(void);
}
