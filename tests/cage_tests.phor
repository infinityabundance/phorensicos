// cage_tests.phor — Tests for dialect cages, translation maps, expansion receipts
// Tests: dialect cages, translation maps, expansion receipts, C import, POSIX cage
//
// Expected outcomes:
//   - Dialect cages correctly classify and isolate foreign code
//   - Translation maps record observed → native operation mappings
//   - Expansion receipts capture macro/template/include resolution steps
//   - C import cage scans for build context, macros, headers, ABI assumptions
//   - POSIX cage translates POSIX calls to native store/IPC operations
//   - All translations produce residuals for audit
//   - Cage trust state progresses from Unknown through observation

package "phorensic:cage_tests:v1.0";

// ============================================================================
// Section 1: Dialect Cage Creation Tests
// ============================================================================

struct DialectProfile {
    name: Str(64),
    version: Str(16),
    family: Str(16),
    entry_count: u32,
}

struct DialectCage {
    profile: DialectProfile,
    loaded_code_hash: u64,
    capability_count: u32,
    residual_count: u32,
    trust_level: u8,
}

fn test_cage_create_basic() -> void
    effect [io:write, cage:translate, residual]
{
    // Create a dialect cage with a POSIX C profile
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 3,
    };

    let cage: DialectCage = cage.create_cage(profile);

    assert(cage.profile.family == Str::from("posix"), "cage: POSIX family");
    assert(cage.trust_level == 0, "cage: initial trust is Unknown");
    assert(cage.capability_count == 0, "cage: no capabilities initially");

    residual emit {
        op: "cage.create",
        profile: "posix-c-v1",
        trust_level: cage.trust_level,
    };
}

fn test_cage_create_with_profile() -> void
    effect [io:write, cage:translate, residual]
{
    // Different dialect profiles produce different cages
    let posix_profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 5,
    };

    let win32_profile: DialectProfile = DialectProfile{
        name: Str::from("win32-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("win32"),
        entry_count: 8,
    };

    let posix_cage: DialectCage = cage.create_cage(posix_profile);
    let win32_cage: DialectCage = cage.create_cage(win32_profile);

    assert(posix_cage.profile.name != win32_cage.profile.name, "cage: different profiles produce different cages");

    residual emit {
        op: "cage.create_multi",
        posix: posix_cage.profile.name,
        win32: win32_cage.profile.name,
    };
}

// ============================================================================
// Section 2: Code Loading and Execution Tests
// ============================================================================

fn test_cage_load_code() -> void
    effect [io:write, cage:translate, residual]
{
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 2,
    };

    let cage: DialectCage = cage.create_cage(profile);
    let code: Array(u8, 256) = Array::splat(0x90); // NOP sled placeholder

    // Load code into cage
    cage.load_into_cage(code);

    assert(cage.loaded_code_hash != 0, "cage: code loaded with valid hash");

    residual emit {
        op: "cage.load_code",
        code_hash: cage.loaded_code_hash,
        code_size: 256,
    };
}

fn test_cage_grant_capability() -> void
    effect [io:write, cage:translate, residual]
{
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 2,
    };

    let cage: DialectCage = cage.create_cage(profile);

    // Grant capabilities to the cage
    let fs_read: Cap(StoreNode) = kernel.get_capability(Str::from("filesystem_read"));
    cage.grant_capability(fs_read);

    // Each grant is logged as a residual
    assert(cage.capability_count >= 1, "cage: capability granted");

    residual emit {
        op: "cage.grant_capability",
        capability: "filesystem_read",
        count: cage.capability_count,
    };
}

fn test_cage_execute() -> void
    effect [io:write, io:read, cage:translate, residual]
{
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 2,
    };

    let cage: DialectCage = cage.create_cage(profile);

    // Grant capabilities
    let stdout: Cap(ConsoleCap) = kernel.get_capability(Str::from("stdout"));
    cage.grant_capability(stdout);

    // Execute caged code at entry point
    let args: Array(u8, 64) = Array::splat(0);
    let result: u64 = cage.execute(Str::from("main"), args);

    // Execution produces residuals
    assert(cage.residual_count > 0, "cage: execution produced residuals");

    residual emit {
        op: "cage.execute",
        entry: "main",
        residual_count: cage.residual_count,
        result: result,
    };
}

// ============================================================================
// Section 3: Translation Map Tests
// ============================================================================

struct TranslationEntry {
    foreign_op: Str(64),
    native_op: Str(64),
    observation_count: u32,
    oracle_verified: bool,
    court_verified: bool,
}

struct TranslationMap {
    entries: Array(TranslationEntry, 16),
    entry_count: u32,
}

fn test_translation_map_add() -> void
    effect [io:write, cage:translate, residual]
{
    let mut map: TranslationMap = TranslationMap{
        entries: Array::splat(TranslationEntry{
            foreign_op: Str::from(""),
            native_op: Str::from(""),
            observation_count: 0,
            oracle_verified: false,
            court_verified: false,
        }),
        entry_count: 0,
    };

    // Add a translation candidate
    let entry: TranslationEntry = TranslationEntry{
        foreign_op: Str::from("posix.open"),
        native_op: Str::from("store.resolve_node"),
        observation_count: 1,
        oracle_verified: false,
        court_verified: false,
    };

    map.entries[0] = entry;
    map.entry_count = 1;

    assert(map.entry_count == 1, "cage: translation entry added");
    assert(!map.entries[0].court_verified, "cage: new entry not yet court-verified");

    residual emit {
        op: "cage.translation_add",
        foreign: "posix.open",
        native: "store.resolve_node",
    };
}

fn test_translation_progression() -> void
    effect [io:write, cage:translate, residual]
{
    // Translations progress through stages:
    //   Candidate (observed once)
    //   → Verified (replay confirmed)
    //   → CourtVerified (court session accepted)
    //   → Promoted (stable, trusted native replacement)

    let mut entry: TranslationEntry = TranslationEntry{
        foreign_op: Str::from("posix.read"),
        native_op: Str::from("store.read"),
        observation_count: 0,
        oracle_verified: false,
        court_verified: false,
    };

    // After first observation
    entry.observation_count = 1;
    assert(!entry.oracle_verified, "cage: candidate not oracle-verified");

    // After oracle comparison
    entry.observation_count = 10;
    entry.oracle_verified = true;
    assert(entry.oracle_verified, "cage: oracle-verified translation");

    // After court verification
    entry.court_verified = true;
    assert(entry.court_verified, "cage: court-verified translation");

    residual emit {
        op: "cage.translation_progress",
        foreign: entry.foreign_op,
        count: entry.observation_count,
        court: if entry.court_verified { 1 } else { 0 },
    };
}

// ============================================================================
// Section 4: Expansion Receipt Tests
// ============================================================================

struct ExpansionReceipt {
    input_fragment: Str(64),
    rule_selected: Str(64),
    dialect_profile: Str(32),
    emitted_bytes_hash: u64,
    oracle_bytes_hash: u64,
    diff_class: u8, // 0=identical, 1=equivalent, 2=divergent, 3=new
    deterministic_hash: u64,
}

fn test_expansion_receipt_identical() -> void
    effect [io:write, cage:translate, residual]
{
    // When native output matches oracle output byte-for-byte
    let receipt: ExpansionReceipt = ExpansionReceipt{
        input_fragment: Str::from("#define MAX 100"),
        rule_selected: Str::from("macro.expand.MAX"),
        dialect_profile: Str::from("posix-c-v1"),
        emitted_bytes_hash: 0xAABBCCDD,
        oracle_bytes_hash: 0xAABBCCDD,
        diff_class: 0, // identical
        deterministic_hash: 0x12345678,
    };

    assert(receipt.diff_class == 0, "cage: identical expansion receipt");
    assert(receipt.emitted_bytes_hash == receipt.oracle_bytes_hash, "cage: byte-identical");

    residual emit {
        op: "cage.expansion_identical",
        input: receipt.input_fragment,
        rule: receipt.rule_selected,
    };
}

fn test_expansion_receipt_divergent() -> void
    effect [io:write, cage:translate, residual]
{
    // When native output differs from oracle output semantically
    let receipt: ExpansionReceipt = ExpansionReceipt{
        input_fragment: Str::from("#ifdef LINUX"),
        rule_selected: Str::from("cond.compile.LINUX"),
        dialect_profile: Str::from("posix-c-v1"),
        emitted_bytes_hash: 0x11111111,
        oracle_bytes_hash: 0x22222222,
        diff_class: 2, // divergent
        deterministic_hash: 0x33333333,
    };

    assert(receipt.diff_class == 2, "cage: divergent expansion");
    assert(receipt.emitted_bytes_hash != receipt.oracle_bytes_hash, "cage: different hashes");

    residual emit {
        op: "cage.expansion_divergent",
        input: receipt.input_fragment,
        native_hash: receipt.emitted_bytes_hash,
        oracle_hash: receipt.oracle_bytes_hash,
    };
}

// ============================================================================
// Section 5: C Import Cage Tests
// ============================================================================

struct CProjectScan {
    build_system: Str(32),
    macro_count: u32,
    header_count: u32,
    abi_assumptions: Array(Str(64), 8),
    syscall_count: u32,
    has_undefined_behavior: bool,
}

fn test_c_import_scan() -> void
    effect [io:write, cage:translate, residual]
{
    // Scan a C project for dialect characteristics
    let scan: CProjectScan = CProjectScan{
        build_system: Str::from("make"),
        macro_count: 42,
        header_count: 15,
        abi_assumptions: Array::splat(Str::from("")),
        syscall_count: 8,
        has_undefined_behavior: false,
    };

    assert(scan.build_system == Str::from("make"), "cage: C build system detected");
    assert(scan.has_undefined_behavior == false, "cage: no UB in scanned code");

    // C import scans for:
    //   - build context (compiler flags, environment)
    //   - macros and preprocessor definitions
    //   - headers and include paths
    //   - ABI assumptions (struct layout, calling convention)
    //   - syscall usage
    //   - undefined-but-relied-on behavior

    residual emit {
        op: "cage.c_import_scan",
        macros: scan.macro_count,
        headers: scan.header_count,
        syscalls: scan.syscall_count,
    };
}

fn test_c_import_header_resolution() -> void
    effect [io:write, cage:translate, residual]
{
    // Header resolution produces expansion receipts
    let header_name: Str(32) = Str::from("stdio.h");
    let resolved_path: Str(64) = Str::from("/usr/include/stdio.h");
    let header_hash: u64 = 0xDEADBEEF;

    // Each include is resolved and recorded
    assert(header_hash != 0, "cage: header resolution hash valid");

    residual emit {
        op: "cage.c_header_resolve",
        header: header_name,
        resolved: resolved_path,
        hash: header_hash,
    };
}

// ============================================================================
// Section 6: POSIX Cage Tests
// ============================================================================

struct PosixObservation {
    operation: Str(32),
    path: Str(128),
    flags: u32,
    return_value: i64,
}

fn test_posix_file_open_translation() -> void
    effect [io:write, io:read, cage:translate, residual]
{
    // POSIX fopen → native store.resolve_node
    let obs: PosixObservation = PosixObservation{
        operation: Str::from("open"),
        path: Str::from("/config/settings.cfg"),
        flags: 0, // O_RDONLY
        return_value: 3, // fd
    };

    // Translation: fopen(path, "r") → store.resolve_node(hash_of(path)) with read capability
    assert(obs.operation == Str::from("open"), "cage: POSIX open observed");

    residual emit {
        op: "cage.posix_open_translate",
        path: obs.path,
        fd: obs.return_value,
    };
}

fn test_posix_file_read_translation() -> void
    effect [io:write, io:read, cage:translate, residual]
{
    // POSIX read → native store.read with offset
    let fd: i64 = 3;
    let offset: u64 = 0;
    let count: u64 = 256;
    let buf: Array(u8, 256) = Array::splat(0);

    // Translation: read(fd, buf, 256) → store.read(handle, offset, count)
    assert(count == 256, "cage: POSIX read count");

    residual emit {
        op: "cage.posix_read_translate",
        fd: fd,
        offset: offset,
        count: count,
    };
}

fn test_posix_close_translation() -> void
    effect [io:write, cage:translate, residual]
{
    // POSIX close → native capability drop
    let fd: i64 = 3;

    // Translation: close(fd) → session.drop(capability)
    assert(fd > 0, "cage: POSIX close with valid fd");

    residual emit {
        op: "cage.posix_close_translate",
        fd: fd,
    };
}

// ============================================================================
// Section 7: Cage Trust Progression Tests
// ============================================================================

fn test_cage_trust_progression() -> void
    effect [io:write, cage:translate, residual]
{
    // A cage's trust state evolves as understanding grows:
    //   Unknown (0) → Observed (1) → Replayed (2) → OracleCompared (3)
    //   → ResidualStable (4) → Sealed (5) → Promoted (6)

    let mut trust: u8 = 0; // Unknown

    // After first execution captured
    trust = 1; // Observed
    assert(trust == 1, "cage: progressed to Observed");

    // After replay verified
    trust = 2; // Replayed
    assert(trust == 2, "cage: progressed to Replayed");

    // After oracle comparison
    trust = 3; // OracleCompared
    assert(trust == 3, "cage: progressed to OracleCompared");

    // After residual pattern stabilizes
    trust = 4; // ResidualStable
    assert(trust == 4, "cage: progressed to ResidualStable");

    // After translation map sealed
    trust = 5; // Sealed
    assert(trust == 5, "cage: progressed to Sealed");

    // After native replacement available
    trust = 6; // Promoted
    assert(trust == 6, "cage: progressed to Promoted");

    residual emit {
        op: "cage.trust_progression",
        final_trust: trust,
    };
}

// ============================================================================
// Section 8: Cage Report Tests
// ============================================================================

struct CageReport {
    cage_id: u64,
    execution_count: u32,
    successful_translations: u32,
    failed_translations: u32,
    effect_violations: u32,
    trust_recommendation: u8,
}

fn test_cage_close_report() -> void
    effect [io:write, cage:translate, residual]
{
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 2,
    };

    let cage: DialectCage = cage.create_cage(profile);

    // Execute some operations
    // ...

    // Close cage and get report
    let report: CageReport = cage.close_cage();

    assert(report.execution_count >= 0, "cage: report has execution count");
    assert(report.trust_recommendation >= 0, "cage: report has trust recommendation");

    residual emit {
        op: "cage.close_report",
        exec_count: report.execution_count,
        successful: report.successful_translations,
        failed: report.failed_translations,
    };
}

fn test_cage_effect_violations() -> void
    effect [io:write, cage:translate, residual]
{
    // Cage must detect and report effect violations
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 2,
    };

    let cage: DialectCage = cage.create_cage(profile);

    // Cage has no DMA capability granted
    // If foreign code attempts DMA access, it's a violation
    let has_dma: bool = false;
    let attempted_dma: bool = true;
    let violation: bool = attempted_dma && !has_dma;
    assert(violation, "cage: DMA access violation detected");

    residual emit {
        op: "cage.effect_violation",
        violation_type: "dma_without_capability",
        blocked: 1,
    };
}

fn test_cage_oracle_interface() -> void
    effect [io:write, cage:translate, residual]
{
    // Cage can connect to a dialect oracle for reference behavior
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 2,
    };

    let cage: DialectCage = cage.create_cage(profile);
    cage.connect_oracle(Str::from("reference-posix-oracle-v1"));

    // Oracle provides reference output for comparison
    let oracle_available: bool = true;
    assert(oracle_available, "cage: oracle interface connected");

    residual emit {
        op: "cage.oracle_connect",
        oracle: "reference-posix-oracle-v1",
        connected: 1,
    };
}

fn test_cage_residual_buffer_bounded() -> void
    effect [io:write, cage:translate, residual]
{
    // Residual buffer has fixed capacity
    let max_residuals: u64 = 1024;
    let produced: u64 = 512;

    assert(produced <= max_residuals, "cage: residual buffer not exceeded");

    // When buffer is full, oldest residuals are preserved
    // (configurable policy: drop oldest, stop execution, etc.)
    residual emit {
        op: "cage.residual_buffer",
        capacity: max_residuals,
        used: produced,
        policy: "preserve_oldest",
    };
}

// ============================================================================
// Main: Run all cage tests
// ============================================================================

fn main() -> void
    effect [compute, io:write, io:read, cage:translate, residual]
{
    // Section 1: Creation
    test_cage_create_basic();
    test_cage_create_with_profile();

    // Section 2: Code Loading
    test_cage_load_code();
    test_cage_grant_capability();
    test_cage_execute();

    // Section 3: Translation Maps
    test_translation_map_add();
    test_translation_progression();

    // Section 4: Expansion Receipts
    test_expansion_receipt_identical();
    test_expansion_receipt_divergent();

    // Section 5: C Import
    test_c_import_scan();
    test_c_import_header_resolution();

    // Section 6: POSIX Cage
    test_posix_file_open_translation();
    test_posix_file_read_translation();
    test_posix_close_translation();

    // Section 7: Trust Progression
    test_cage_trust_progression();

    // Section 8: Reports
    test_cage_close_report();

    // Section 9: Violations
    test_cage_effect_violations();

    // Section 10: Oracle
    test_cage_oracle_interface();

    // Section 11: Residual Buffer
    test_cage_residual_buffer_bounded();

    residual emit {
        op: "cage_tests.complete",
        total_sections: 11,
        status: "pass",
    };
}
