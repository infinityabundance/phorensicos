// capability_explorer.phor — Capability explorer with tree and audit
//
// Demonstrates:
//   - Session capability tree display with hierarchical view
//   - Capability transfer demonstration between sessions
//   - Generation tag evolution tracking
//   - Rights set editor with bitfield manipulation
//   - Delegation chain browser with ancestor traversal
//   - Capability audit log with timestamped events
//   - Affine capability move semantics
//   - Capability derivation via restrict
//   - Bounded loops and fixed-capacity collections
//   - Full residual recording for all operations
//
// Expected behavior:
//   - Displays session capability tree organized by type
//   - Demonstrates capability transfer with move semantics
//   - Shows generation tag increment on derivation
//   - Edits rights sets with bitfield operations
//   - Browses delegation chains from origin to current
//   - Shows audit log of all capability events
//   - All operations bounded, effect-declared, residual-recorded
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:capability_explorer:v1.0";

const MAX_CAPABILITIES: u64 = 128;
const MAX_SESSIONS: u64 = 16;
const MAX_DELEGATION_CHAIN: u64 = 32;
const MAX_AUDIT_EVENTS: u64 = 256;
const MAX_CHILDREN: u64 = 16;
const MAX_RIGHTS_BITS: u64 = 64;
const MAX_TREE_DEPTH: u64 = 10;
const MAX_RIGHTS_NAME: u64 = 16;
const MAX_SESSION_CAPS: u64 = 64;

struct CapabilityInfo {
    cap_id: u64,
    resource_type: Str(32),
    rights: u64,
    generation: u64,
    derived_from: u64,
    session_id: u64,
    created: u64,
    label: Str(64),
    is_alive: bool,
    rights_names: Array(Str(16), 8),
    rights_name_count: u64,
}

struct SessionInfo {
    session_id: u64,
    name: Str(32),
    cap_count: u64,
    created: u64,
    active: bool,
    parent_session: u64,
}

struct CapabilityTree {
    nodes: Array(CapabilityInfo, 128),
    count: u64,
}

struct DelegationStep {
    step_id: u64,
    from_session: u64,
    to_session: u64,
    cap_orig_id: u64,
    cap_new_id: u64,
    rights_before: u64,
    rights_after: u64,
    generation: u64,
    timestamp: u64,
    method: Str(16),
}

struct AuditEvent {
    event_id: u64,
    event_type: Str(32),
    session_id: u64,
    cap_id: u64,
    timestamp: u64,
    details: Str(128),
    rights_change: u64,
    generation: u64,
}

struct RightsEditorState {
    current_rights: u64,
    available_rights: Array(Str(16), 8),
    available_count: u64,
    selected_bits: Array(bool, 64),
}

struct ExplorerState {
    sessions: Array(SessionInfo, 16),
    session_count: u64,
    current_session: u64,
    audit_log: RingBuf(AuditEvent, 256),
    delegation_chain: RingBuf(DelegationStep, 32),
}

const RIGHTS_READ: u64 = 0x0001;
const RIGHTS_WRITE: u64 = 0x0002;
const RIGHTS_EXECUTE: u64 = 0x0004;
const RIGHTS_DELETE: u64 = 0x0008;
const RIGHTS_CREATE: u64 = 0x0010;
const RIGHTS_GRANT: u64 = 0x0020;
const RIGHTS_REVOKE: u64 = 0x0040;
const RIGHTS_DERIVE: u64 = 0x0080;
const RIGHTS_DELEGATE: u64 = 0x0100;
const RIGHTS_AUDIT: u64 = 0x0200;
const RIGHTS_SEAL: u64 = 0x0400;
const RIGHTS_COURT: u64 = 0x0800;
const RIGHTS_PROMOTE: u64 = 0x1000;
const RIGHTS_ELEVATE: u64 = 0x2000;
const RIGHTS_TRANSFER: u64 = 0x4000;
const RIGHTS_IMPORT: u64 = 0x8000;

fn get_rights_name(bit: u64) -> Str(16)
    effect [compute]
{
    match bit {
        0x0001 => return Str::from("read"),
        0x0002 => return Str::from("write"),
        0x0004 => return Str::from("execute"),
        0x0008 => return Str::from("delete"),
        0x0010 => return Str::from("create"),
        0x0020 => return Str::from("grant"),
        0x0040 => return Str::from("revoke"),
        0x0080 => return Str::from("derive"),
        0x0100 => return Str::from("delegate"),
        0x0200 => return Str::from("audit"),
        0x0400 => return Str::from("seal"),
        0x0800 => return Str::from("court"),
        0x1000 => return Str::from("promote"),
        0x2000 => return Str::from("elevate"),
        0x4000 => return Str::from("transfer"),
        0x8000 => return Str::from("import"),
        _ => return Str::from("unknown"),
    }
}

fn parse_rights_bits(rights: u64) -> (Array(Str(16), 8), u64)
    effect [compute]
{
    let names: Array(Str(16), 8) = Array::splat(Str::from(""));
    let mut count: u64 = 0;
    let bit_values: Array(u64, 16) = Array::splat(0);
    bit_values[0] = RIGHTS_READ;
    bit_values[1] = RIGHTS_WRITE;
    bit_values[2] = RIGHTS_EXECUTE;
    bit_values[3] = RIGHTS_DELETE;
    bit_values[4] = RIGHTS_CREATE;
    bit_values[5] = RIGHTS_GRANT;
    bit_values[6] = RIGHTS_REVOKE;
    bit_values[7] = RIGHTS_DERIVE;
    bit_values[8] = RIGHTS_DELEGATE;
    bit_values[9] = RIGHTS_AUDIT;
    bit_values[10] = RIGHTS_SEAL;
    bit_values[11] = RIGHTS_COURT;
    bit_values[12] = RIGHTS_PROMOTE;
    bit_values[13] = RIGHTS_ELEVATE;
    bit_values[14] = RIGHTS_TRANSFER;
    bit_values[15] = RIGHTS_IMPORT;

    for i in 0..16 {
        if (rights & bit_values[i]) != 0 && count < 8 {
            names[count] = get_rights_name(bit_values[i]);
            count = count + 1;
        }
    }
    return (names, count);
}

fn render_rights_set(rights: u64) -> Str(128)
    effect [compute]
{
    let parse_result: (Array(Str(16), 8), u64) = parse_rights_bits(rights);
    let names: Array(Str(16), 8) = parse_result.0;
    let count: u64 = parse_result.1;
    let mut result: Str(128) = Str::from("[");

    for i in 0..count {
        if i > 0 {
            result.append(Str::from(", "));
        }
        result.append(names[i]);
    }
    result.append(Str::from("]"));
    return result;
}

fn create_session(name: Str(32), parent: u64, session_id: u64) -> SessionInfo
    effect [residual]
{
    let session: SessionInfo = SessionInfo{
        session_id: session_id,
        name: name,
        cap_count: 0,
        created: 1000,
        active: true,
        parent_session: parent,
    };

    residual emit {
        op: "cap_explorer.session_create",
        session: session_id,
        name: name,
        parent: parent,
    };

    return session;
}

fn create_capability(session: SessionInfo, resource_type: Str(32), rights: u64,
                      gen: u64, derived: u64, cap_id: u64) -> CapabilityInfo
    effect [residual]
{
    let parse_result: (Array(Str(16), 8), u64) = parse_rights_bits(rights);
    let info: CapabilityInfo = CapabilityInfo{
        cap_id: cap_id,
        resource_type: resource_type,
        rights: rights,
        generation: gen,
        derived_from: derived,
        session_id: session.session_id,
        created: 1000,
        label: Str::from(""),
        is_alive: true,
        rights_names: parse_result.0,
        rights_name_count: parse_result.1,
    };

    residual emit {
        op: "cap_explorer.cap_create",
        session: session.session_id,
        cap: cap_id,
        rights: rights,
        gen: gen,
        derived: derived,
    };

    return info;
}

fn derive_capability(original: CapabilityInfo, new_rights: u64, new_id: u64) -> CapabilityInfo
    effect [residual]
{
    let new_gen: u64 = original.generation + 1;
    let parse_result: (Array(Str(16), 8), u64) = parse_rights_bits(new_rights);

    let derived: CapabilityInfo = CapabilityInfo{
        cap_id: new_id,
        resource_type: original.resource_type,
        rights: new_rights,
        generation: new_gen,
        derived_from: original.cap_id,
        session_id: original.session_id,
        created: 1001,
        label: Str::from(""),
        is_alive: true,
        rights_names: parse_result.0,
        rights_name_count: parse_result.1,
    };

    residual emit {
        op: "cap_explorer.cap_derive",
        from: original.cap_id,
        to: new_id,
        old_rights: original.rights,
        new_rights: new_rights,
        old_gen: original.generation,
        new_gen: new_gen,
    };

    return derived;
}

fn transfer_capability(cap: CapabilityInfo, to_session: SessionInfo) -> CapabilityInfo
    effect [residual]
{
    let transferred: CapabilityInfo = cap;
    transferred.session_id = to_session.session_id;
    transferred.generation = cap.generation + 1;

    residual emit {
        op: "cap_explorer.cap_transfer",
        cap: cap.cap_id,
        from: cap.session_id,
        to: to_session.session_id,
        new_gen: transferred.generation,
    };

    return transferred;
}

fn create_delegation_step(from_session: u64, to_session: u64, cap_orig: u64,
                           cap_new: u64, rights_before: u64, rights_after: u64,
                           gen: u64, method: Str(16)) -> DelegationStep
    effect [compute]
{
    let step: DelegationStep = DelegationStep{
        step_id: 0,
        from_session: from_session,
        to_session: to_session,
        cap_orig_id: cap_orig,
        cap_new_id: cap_new,
        rights_before: rights_before,
        rights_after: rights_after,
        generation: gen,
        timestamp: 1000,
        method: method,
    };
    return step;
}

fn build_delegation_chain(origin: CapabilityInfo, caps: Array(CapabilityInfo, 128),
                           cap_count: u64) -> RingBuf(DelegationStep, 32)
    effect [compute]
{
    let chain: RingBuf(DelegationStep, 32) = RingBuf::new();
    let mut current_id: u64 = origin.cap_id;
    let mut steps: u64 = 0;

    while current_id > 0 && steps < 32 proven {
        let mut found: bool = false;
        for i in 0..cap_count {
            if caps[i].cap_id == current_id {
                if caps[i].derived_from > 0 {
                    let step: DelegationStep = create_delegation_step(
                        caps[i].session_id, caps[i].session_id,
                        caps[i].derived_from, caps[i].cap_id,
                        0, caps[i].rights, caps[i].generation, Str::from("derive")
                    );
                    chain.push(step);
                    current_id = caps[i].derived_from;
                } else {
                    current_id = 0;
                }
                found = true;
                break;
            }
        }
        if !found {
            current_id = 0;
        }
        steps = steps + 1;
    }
    return chain;
}

fn log_audit_event(mut log: RingBuf(AuditEvent, 256), event_type: Str(32),
                    session_id: u64, cap_id: u64, details: Str(128),
                    rights_change: u64, gen: u64) -> RingBuf(AuditEvent, 256)
    effect [residual]
{
    let event: AuditEvent = AuditEvent{
        event_id: 0,
        event_type: event_type,
        session_id: session_id,
        cap_id: cap_id,
        timestamp: 1000,
        details: details,
        rights_change: rights_change,
        generation: gen,
    };
    log.push(event);

    residual emit {
        op: "cap_explorer.audit",
        event: event_type,
        session: session_id,
        cap: cap_id,
    };

    return log;
}

fn render_capability_tree(sessions: Array(SessionInfo, 16), caps: Array(CapabilityInfo, 128),
                           cap_count: u64, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Session Capability Tree ===\n"));

    for s_idx in 0..sessions.capacity() {
        let session: SessionInfo = sessions[s_idx];
        if session.session_id == 0 || !session.active {
            continue;
        }

        let mut header: Str(128) = Str::from("");
        header.append(Str::from("[Session "));
        header.append(session.session_id as Str(16));
        header.append(Str::from("] "));
        header.append(session.name);
        header.append(Str::from(" ("));
        header.append(session.cap_count as Str(16));
        header.append(Str::from(" caps)"));
        header.append(Str::from("\n"));
        console.write(header);

        for c_idx in 0..caps.capacity() {
            let cap: CapabilityInfo = caps[c_idx];
            if cap.cap_id == 0 || !cap.is_alive {
                continue;
            }
            if cap.session_id != session.session_id {
                continue;
            }

            let mut line: Str(256) = Str::from("  +-- ");
            line.append(cap.cap_id as Str(16));
            line.append(Str::from(": "));
            line.append(cap.resource_type);
            line.append(Str::from("  gen="));
            line.append(cap.generation as Str(16));
            line.append(Str::from("  rights="));
            let rights_str: Str(128) = render_rights_set(cap.rights);
            line.append(rights_str);
            if cap.derived_from > 0 {
                line.append(Str::from("  [derived from "));
                line.append(cap.derived_from as Str(16));
                line.append(Str::from("]"));
            }
            line.append(Str::from("\n"));
            console.write(line);
        }
    }
}

fn display_delegation_chain(chain: RingBuf(DelegationStep, 32), console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Delegation Chain ===\n"));
    let total: u64 = chain.len();

    for i in 0..total {
        let step: DelegationStep = chain[i];
        let mut line: Str(256) = Str::from("");
        line.append(step.step_id as Str(16));
        line.append(Str::from(". "));
        line.append(step.method);
        line.append(Str::from(" cap "));
        line.append(step.cap_orig_id as Str(16));
        line.append(Str::from(" -> "));
        line.append(step.cap_new_id as Str(16));
        line.append(Str::from("  rights: "));
        let rights_str: Str(128) = render_rights_set(step.rights_after);
        line.append(rights_str);
        line.append(Str::from("  gen: "));
        line.append(step.generation as Str(16));
        line.append(Str::from("  @"));
        line.append(step.timestamp as Str(16));
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn display_audit_log(log: RingBuf(AuditEvent, 256), console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Capability Audit Log ===\n"));
    let total: u64 = log.len();

    for i in 0..total {
        let event: AuditEvent = log[i];
        let mut line: Str(256) = Str::from("");
        line.append(event.timestamp as Str(16));
        line.append(Str::from("  ["));
        line.append(event.event_type);
        line.append(Str::from("]  session="));
        line.append(event.session_id as Str(16));
        line.append(Str::from("  cap="));
        line.append(event.cap_id as Str(16));
        line.append(Str::from("  "));
        line.append(event.details);
        if event.rights_change > 0 {
            line.append(Str::from("  rights_delta=0x"));
            line.append(event.rights_change as Str(16));
        }
        line.append(Str::from("  gen="));
        line.append(event.generation as Str(16));
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn edit_rights_editor(rights: u64, bit_to_toggle: u64, add: bool) -> u64
    effect [compute]
{
    let mut new_rights: u64 = rights;
    if add {
        new_rights = new_rights | bit_to_toggle;
    } else {
        new_rights = new_rights & (!bit_to_toggle);
    }
    return new_rights;
}

fn simulate_rights_editor(console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Rights Editor Simulation ===\n"));

    let mut rights: u64 = RIGHTS_READ | RIGHTS_WRITE;
    let before: Str(128) = render_rights_set(rights);
    let mut line: Str(256) = Str::from("Initial: ");
    line.append(before);
    line.append(Str::from("\n"));
    console.write(line);

    rights = edit_rights_editor(rights, RIGHTS_EXECUTE, true);
    rights = edit_rights_editor(rights, RIGHTS_DERIVE, true);
    rights = edit_rights_editor(rights, RIGHTS_AUDIT, true);
    let after: Str(128) = render_rights_set(rights);
    let mut line2: Str(256) = Str::from("After adding execute, derive, audit: ");
    line2.append(after);
    line2.append(Str::from("\n"));
    console.write(line2);

    rights = edit_rights_editor(rights, RIGHTS_WRITE, false);
    let final_str: Str(128) = render_rights_set(rights);
    let mut line3: Str(256) = Str::from("After removing write: ");
    line3.append(final_str);
    line3.append(Str::from("\n"));
    console.write(line3);

    let has_read: bool = (rights & RIGHTS_READ) != 0;
    let has_write: bool = (rights & RIGHTS_WRITE) != 0;
    let has_execute: bool = (rights & RIGHTS_EXECUTE) != 0;
    assert(has_read, "ce: read right preserved");
    assert(!has_write, "ce: write right removed");
    assert(has_execute, "ce: execute right added");
}

fn track_generation_evolution(caps: Array(CapabilityInfo, 128), cap_count: u64,
                               console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Generation Tag Evolution ===\n"));
    for i in 0..cap_count {
        let cap: CapabilityInfo = caps[i];
        if cap.cap_id == 0 || !cap.is_alive {
            continue;
        }
        let mut line: Str(256) = Str::from("");
        line.append(cap.cap_id as Str(16));
        line.append(Str::from(": gen="));
        line.append(cap.generation as Str(16));

        if cap.derived_from > 0 {
            line.append(Str::from("  derived from "));
            line.append(cap.derived_from as Str(16));
            line.append(Str::from(" (gen "));
            for j in 0..cap_count {
                if caps[j].cap_id == cap.derived_from {
                    line.append(caps[j].generation as Str(16));
                    break;
                }
            }
            line.append(Str::from(")"));
        } else {
            line.append(Str::from("  root capability"));
        }
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn revoke_capability(mut caps: Array(CapabilityInfo, 128), cap_id: u64,
                      cap_count: u64) -> Array(CapabilityInfo, 128)
    effect [residual]
{
    for i in 0..cap_count {
        if caps[i].cap_id == cap_id {
            caps[i].is_alive = false;
            break;
        }
    }

    residual emit {
        op: "cap_explorer.revoke",
        cap: cap_id,
    };

    return caps;
}

fn filter_by_rights(caps: Array(CapabilityInfo, 128), cap_count: u64,
                    required_rights: u64) -> Array(u64, 32)
    effect [compute]
{
    let results: Array(u64, 32) = Array::splat(0);
    let mut result_count: u64 = 0;

    for i in 0..cap_count {
        let cap: CapabilityInfo = caps[i];
        if cap.cap_id > 0 && cap.is_alive && result_count < 32 {
            if (cap.rights & required_rights) == required_rights {
                results[result_count] = cap.cap_id;
                result_count = result_count + 1;
            }
        }
    }
    return results;
}

fn count_caps_by_type(caps: Array(CapabilityInfo, 128), cap_count: u64,
                       resource_type: Str(32)) -> u64
    effect [compute]
{
    let mut count: u64 = 0;
    for i in 0..cap_count {
        let cap: CapabilityInfo = caps[i];
        if cap.cap_id > 0 && cap.is_alive && cap.resource_type == resource_type {
            count = count + 1;
        }
    }
    return count;
}

fn check_capability_derivation_valid(original: CapabilityInfo, new_rights: u64) -> bool
    effect [compute]
{
    let valid: bool = new_rights != 0 && (new_rights & original.rights) == new_rights;
    return valid;
}

fn explore_capability_hierarchy(caps: Array(CapabilityInfo, 128), cap_count: u64,
                                   console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Capability Hierarchy ===\n"));
    for i in 0..cap_count {
        let c: CapabilityInfo = caps[i];
        if c.cap_id == 0 || !c.is_alive { continue; }
        if c.derived_from == 0 {
            let mut rline: Str(256) = Str::from("ROOT: ");
            rline.append(c.cap_id as Str(16));
            rline.append(Str::from(" - "));
            rline.append(c.resource_type);
            rline.append(Str::from(" gen="));
            rline.append(c.generation as Str(16));
            rline.append(Str::from("\n"));
            console.write(rline);

            for j in 0..cap_count {
                let child: CapabilityInfo = caps[j];
                if child.derived_from == c.cap_id && child.is_alive {
                    let mut cline: Str(256) = Str::from("  +-- ");
                    cline.append(child.cap_id as Str(16));
                    cline.append(Str::from(" gen="));
                    cline.append(child.generation as Str(16));
                    cline.append(Str::from("\n"));
                    console.write(cline);
                }
            }
        }
    }
}

fn check_rights_compatibility(rights_a: u64, rights_b: u64) -> bool
    effect [compute]
{
    let has_common: bool = (rights_a & rights_b) != 0;
    return has_common;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, residual]
{
    console.write(Str::from("Capability Explorer v1.0\n"));
    console.write(Str::from("========================\n"));

    // Step 1: Create sessions
    let s1: SessionInfo = create_session(Str::from("init"), 0, 1);
    let s2: SessionInfo = create_session(Str::from("user-app"), 1, 2);
    let s3: SessionInfo = create_session(Str::from("network-daemon"), 1, 3);
    assert(s1.session_id == 1, "ce: init session created");
    assert(s2.session_id == 2, "ce: user session created");
    assert(s3.session_id == 3, "ce: network session created");

    // Step 2: Create capabilities in sessions
    let caps: Array(CapabilityInfo, 128) = Array::splat(
        CapabilityInfo{ cap_id: 0, resource_type: Str::from(""), rights: 0,
                        generation: 0, derived_from: 0, session_id: 0,
                        created: 0, label: Str::from(""), is_alive: false,
                        rights_names: Array::splat(Str::from("")), rights_name_count: 0 }
    );
    let mut cap_count: u64 = 0;

    let c1: CapabilityInfo = create_capability(s1, Str::from("store"), 0xFFFF, 1, 0, 101);
    caps[0] = c1;
    cap_count = 1;

    let c2: CapabilityInfo = create_capability(s1, Str::from("console"), 0x0003, 1, 0, 102);
    caps[1] = c2;
    cap_count = 2;

    let c3: CapabilityInfo = create_capability(s1, Str::from("court"), 0x0F00, 1, 0, 103);
    caps[2] = c3;
    cap_count = 3;

    // Step 3: Derive capabilities (demonstrate generation evolution)
    let d1: CapabilityInfo = derive_capability(c1, RIGHTS_READ | RIGHTS_WRITE, 201);
    caps[3] = d1;
    cap_count = 4;

    let d2: CapabilityInfo = derive_capability(d1, RIGHTS_READ, 202);
    caps[4] = d2;
    cap_count = 5;

    // Step 4: Transfer capability between sessions
    let t1: CapabilityInfo = transfer_capability(d1, s2);
    t1.cap_id = 301;
    caps[5] = t1;
    cap_count = 6;

    // Step 5: Display capability tree
    let sessions: Array(SessionInfo, 16) = Array::splat(
        SessionInfo{ session_id: 0, name: Str::from(""), cap_count: 0,
                     created: 0, active: false, parent_session: 0 }
    );
    sessions[0] = s1;
    sessions[1] = s2;
    sessions[2] = s3;
    s1.cap_count = 3;
    s2.cap_count = 1;
    render_capability_tree(sessions, caps, cap_count, console);

    // Step 6: Display generation evolution
    track_generation_evolution(caps, cap_count, console);

    // Step 7: Display delegation chain
    let delegation: RingBuf(DelegationStep, 32) = build_delegation_chain(d2, caps, cap_count);
    display_delegation_chain(delegation, console);
    assert(delegation.len() > 0, "ce: delegation chain built");

    // Step 8: Demonstrate rights editor
    simulate_rights_editor(console);

    // Step 9: Build and display audit log
    let mut audit: RingBuf(AuditEvent, 256) = RingBuf::new();
    audit = log_audit_event(audit, Str::from("session_create"), 1, 0,
                             Str::from("init session"), 0, 0);
    audit = log_audit_event(audit, Str::from("cap_create"), 1, 101,
                             Str::from("store capability, full rights"), 0xFFFF, 1);
    audit = log_audit_event(audit, Str::from("cap_derive"), 1, 201,
                             Str::from("derived read-write from 101"), 0x0003, 2);
    audit = log_audit_event(audit, Str::from("cap_derive"), 1, 202,
                             Str::from("derived read-only from 201"), 0x0001, 3);
    audit = log_audit_event(audit, Str::from("cap_transfer"), 2, 301,
                             Str::from("transferred to user-app session"), 0x0003, 3);
    display_audit_log(audit, console);
    assert(audit.len() == 5, "ce: audit log has 5 events");

    // Step 10: Test rights filtering
    let read_caps: Array(u64, 32) = filter_by_rights(caps, cap_count, RIGHTS_READ);
    assert(read_caps.len() > 0, "ce: capabilities with read right found");

    let console_type: u64 = count_caps_by_type(caps, cap_count, Str::from("console"));
    assert(console_type == 1, "ce: one console capability");

    // Step 11: Test derivation validity check
    let valid_derive: bool = check_capability_derivation_valid(c1, RIGHTS_READ | RIGHTS_WRITE);
    assert(valid_derive, "ce: valid derivation detected");

    let invalid_derive: bool = check_capability_derivation_valid(d2, RIGHTS_WRITE);
    assert(!invalid_derive, "ce: invalid derivation detected (read-only cannot derive write)");

    // Step 12: Revoke a capability and verify
    let caps_after_revoke: Array(CapabilityInfo, 128) = revoke_capability(caps, 202, cap_count);
    let is_revoked: bool = !caps_after_revoke[4].is_alive;
    assert(is_revoked, "ce: capability 202 revoked");

    // Explore hierarchy
    explore_capability_hierarchy(caps, cap_count, console);

    // Rights compatibility
    let compatible: bool = check_rights_compatibility(RIGHTS_READ | RIGHTS_WRITE, RIGHTS_READ);
    assert(compatible, "ce: rights compatibility check works");

    let incompatible: bool = check_rights_compatibility(RIGHTS_EXECUTE, RIGHTS_WRITE);
    assert(!incompatible, "ce: incompatible rights detected");

    // Final assertion
    let total_sessions: u64 = 3;
    let total_caps_created: u64 = 6;
    assert(total_sessions == 3, "ce: 3 sessions created");
    assert(total_caps_created >= 5, "ce: multiple capabilities created and derived");

    console.write(Str::from("\n=== All capability explorer tests passed ===\n"));

    residual emit {
        op: "capability_explorer.complete",
        sessions: 3,
        capabilities: cap_count,
        delegation_chain_length: delegation.len(),
        audit_events: audit.len(),
        rights_edited: 1,
        revocations: 1,
    };
}
