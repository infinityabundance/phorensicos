// ──────────────────────────────────────────────
// UEFI Memory Descriptor
// ──────────────────────────────────────────────

pub type EFI_MEMORY_DESCRIPTOR : struct {
    memory_type: Word32,
    physical_start: Word64,
    virtual_start: Word64,
    number_of_pages: u64,
    attribute: Word64,
}

impl EFI_MEMORY_DESCRIPTOR {
    pub fn new() -> EFI_MEMORY_DESCRIPTOR
        effects: [deterministic]
    {
        EFI_MEMORY_DESCRIPTOR {
            memory_type: 0,
            physical_start: Word64::zero(),
            virtual_start: Word64::zero(),
            number_of_pages: 0,
            attribute: Word64::zero(),
        }
    }

    pub fn physical_address(self) -> Word64
        effects: [deterministic]
    {
        self.physical_start
    }

    pub fn page_count(self) -> u64
        effects: [deterministic]
    {
        self.number_of_pages
    }

    pub fn byte_length(self) -> u64
        effects: [deterministic]
    {
        self.number_of_pages * UEFI_PAGE_SIZE
    }

    pub fn is_available(self) -> bool
        effects: [deterministic]
    {
        self.memory_type == EFI_CONVENTIONAL_MEMORY
    }

    pub fn is_loader_data(self) -> bool
        effects: [deterministic]
    {
        self.memory_type == EFI_LOADER_DATA
    }

    pub fn is_boot_services(self) -> bool
        effects: [deterministic]
    {
        self.memory_type == EFI_BOOT_SERVICES_CODE ||
        self.memory_type == EFI_BOOT_SERVICES_DATA
    }

    pub fn is_runtime(self) -> bool
        effects: [deterministic]
    {
        self.memory_type == EFI_RUNTIME_SERVICES_CODE ||
        self.memory_type == EFI_RUNTIME_SERVICES_DATA
    }

    pub fn is_uefi_runtime(self) -> bool
        effects: [deterministic]
    {
        (self.attribute.to_u64() & EFI_MEMORY_RUNTIME) != 0
    }

    pub fn memory_type_str(self) -> FixedString[32]
        effects: [deterministic]
    {
        match self.memory_type {
            EFI_RESERVED_MEMORY_TYPE => FixedString::from("Reserved"),
            EFI_LOADER_CODE => FixedString::from("LoaderCode"),
            EFI_LOADER_DATA => FixedString::from("LoaderData"),
            EFI_BOOT_SERVICES_CODE => FixedString::from("BS_Code"),
            EFI_BOOT_SERVICES_DATA => FixedString::from("BS_Data"),
            EFI_RUNTIME_SERVICES_CODE => FixedString::from("RT_Code"),
            EFI_RUNTIME_SERVICES_DATA => FixedString::from("RT_Data"),
            EFI_CONVENTIONAL_MEMORY => FixedString::from("Conventional"),
            EFI_UNUSABLE_MEMORY => FixedString::from("Unusable"),
            EFI_ACPI_RECLAIM_MEMORY => FixedString::from("ACPIRecclaim"),
            EFI_ACPIMEMORY_NVS => FixedString::from("ACPINVS"),
            EFI_MEMORY_MAPPED_IO => FixedString::from("MMIO"),
            EFI_PERSISTENT_MEMORY => FixedString::from("Persistent"),
            _ => FixedString::from("Unknown"),
        }
    }
}

// ──────────────────────────────────────────────
// UEFI Configuration Table Entry
// ──────────────────────────────────────────────

pub type EFI_CONFIGURATION_TABLE : struct {
    vendor_guid: EFI_GUID,
    vendor_table: Word64,
}

impl EFI_CONFIGURATION_TABLE {
    pub fn new() -> EFI_CONFIGURATION_TABLE
        effects: [deterministic]
    {
        EFI_CONFIGURATION_TABLE {
            vendor_guid: EFI_GUID::new(),
            vendor_table: Word64::zero(),
        }
    }

    pub fn is_acpi_table(self) -> bool
        effects: [deterministic]
    {
        // Check if GUID matches ACPI table GUIDs
        let acpi_guid: EFI_GUID = EFI_GUID {
            data1: 0x8868E871,
            data2: 0xE4F1,
            data3: 0x11D3,
            data4: FixedArray::from_raw([0xBC, 0x22, 0x00, 0x80, 0xC7, 0x3C, 0x88, 0x81], 8),
        }
        self.vendor_guid.equals(acpi_guid)
    }

    pub fn is_smbios_table(self) -> bool
        effects: [deterministic]
    {
        let smbios_guid: EFI_GUID = EFI_GUID {
            data1: 0xEB9D2D31,
            data2: 0x2D88,
            data3: 0x11D3,
            data4: FixedArray::from_raw([0x9A, 0x16, 0x00, 0x90, 0x27, 0x3F, 0xC1, 0x4D], 8),
        }
        self.vendor_guid.equals(smbios_guid)
    }

    pub fn table_address(self) -> Word64
        effects: [deterministic]
    {
        self.vendor_table
    }
}

// ──────────────────────────────────────────────
// UEFI Protocol Functions
// ──────────────────────────────────────────────

pub fn uefi_locate_gop_protocol(bs_ptr: Word64) -> Result[GOP_PROTOCOL, BootError>
    effects: [io:read, memory:mmio, deterministic]
{
    trusted "UEFI LocateProtocol for GOP: UEFI Spec §12.9, LocateProtocol function at index 24 in boot services table"
    {
        let gop: GOP_PROTOCOL = GOP_PROTOCOL::new()
        Result::Ok(gop)
    }
}

