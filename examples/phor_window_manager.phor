// phor_window_manager.phor — Native .phor Window Manager
//
// Demonstrates:
//   - Surface stack management with z-order
//   - Focus tracking and Tab cycling
//   - Widget hit testing
//   - Input routing from keyboard driver to focused surface
//   - Bounded surface and widget counts
//   - Presentation loop with frame counting
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:phor_window_manager:v1.0";

// ── Constants ───────────────────────────────────────────

const MAX_SURFACES: u64 = 16;
const MAX_WIDGETS: u64 = 32;
const MAX_STACK_DEPTH: u64 = 16;

// ── Widget Types ────────────────────────────────────────

type WidgetType = u8;

const WIDGET_BUTTON: WidgetType = 0;
const WIDGET_LABEL: WidgetType = 1;
const WIDGET_PANEL: WidgetType = 2;
const WIDGET_PROGRESS: WidgetType = 3;

// ── Widget ──────────────────────────────────────────────

struct Widget {
    widget_id: u64,
    type_: WidgetType,
    x: u32,
    y: u32,
    width: u32,
    height: u32,
    label: Array(u8, 64),
    label_len: u64,
    visible: bool,
    clicked: bool,
    value: u64,
    bg_r: u8,
    bg_g: u8,
    bg_b: u8,
}

impl Widget {
    fn new(id: u64, type_: WidgetType, x: u32, y: u32, w: u32, h: u32) -> Widget
        effect [compute]
    {
        return Widget {
            widget_id: id,
            type_: type_,
            x: x, y: y, width: w, height: h,
            label: Array::splat(0), label_len: 0,
            visible: true, clicked: false,
            value: 0,
            bg_r: 0x44, bg_g: 0x88, bg_b: 0xCC,
        };
    }

    fn set_label(mut self, lbl: Array(u8, 64), len: u64) -> Widget
        effect [compute]
    {
        self.label = lbl;
        self.label_len = len.min(64);
        return self;
    }

    fn set_bg(mut self, r: u8, g: u8, b: u8) -> Widget
        effect [compute]
    {
        self.bg_r = r; self.bg_g = g; self.bg_b = b;
        return self;
    }

    fn hit_test(self, px: u32, py: u32) -> bool
        effect [compute]
    {
        return self.visible && px >= self.x && px < self.x + self.width
            && py >= self.y && py < self.y + self.height;
    }
}

// ── Surface ─────────────────────────────────────────────

struct Surface {
    surface_id: u64,
    title: Array(u8, 64),
    title_len: u64,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    z_order: u64,
    focused: bool,
    visible: bool,
    widgets: Array(Widget, 32),
    widget_count: u64,
}

impl Surface {
    fn new(id: u64, w: u32, h: u32, title: Array(u8, 64), tlen: u64) -> Surface
        effect [compute]
    {
        return Surface {
            surface_id: id,
            title: title, title_len: tlen,
            x: 50, y: 50,
            width: w, height: h,
            z_order: 0, focused: false, visible: true,
            widgets: Array::splat_zeroed(),
            widget_count: 0,
        };
    }

    fn add_widget(mut self, widget: Widget) -> Surface
        effect [compute]
    {
        if self.widget_count < MAX_WIDGETS {
            self.widgets[self.widget_count] = widget;
            self.widget_count = self.widget_count + 1;
        }
        return self;
    }

    fn set_position(mut self, x: i32, y: i32) -> Surface
        effect [compute]
    {
        self.x = x; self.y = y;
        return self;
    }

    fn set_z(mut self, z: u64) -> Surface
        effect [compute]
    {
        self.z_order = z;
        return self;
    }

    fn focus(mut self) -> Surface
        effect [compute]
    {
        self.focused = true;
        return self;
    }

    fn unfocus(mut self) -> Surface
        effect [compute]
    {
        self.focused = false;
        return self;
    }
}

// ── Window Manager ──────────────────────────────────────

struct WindowManager {
    surfaces: Array(Surface, 16),
    surface_count: u64,
    next_id: u64,
    focused_id: u64,
    focus_history: Array(u64, 16),
    history_depth: u64,
    frame_count: u64,
}

impl WindowManager {
    fn new() -> WindowManager
        effect [compute]
    {
        return WindowManager {
            surfaces: Array::splat_zeroed(),
            surface_count: 0,
            next_id: 1,
            focused_id: 0,
            focus_history: Array::splat(0),
            history_depth: 0,
            frame_count: 0,
        };
    }

    fn create_surface(mut self, w: u32, h: u32, title: Array(u8, 64), tlen: u64) -> (WindowManager, u64)
        effect [compute]
    {
        let id: u64 = self.next_id;
        self.next_id = self.next_id + 1;
        let mut surf: Surface = Surface::new(id, w, h, title, tlen);
        surf = surf.set_z(self.surface_count);

        if self.surface_count < MAX_SURFACES {
            self.surfaces[self.surface_count] = surf;
            self.surface_count = self.surface_count + 1;
        }

        // Focus the new surface
        self = self.set_focus(id);
        return (self, id);
    }

    fn set_focus(mut self, id: u64) -> WindowManager
        effect [compute]
    {
        // Unfocus all
        for i in 0..self.surface_count {
            self.surfaces[i] = self.surfaces[i].unfocus();
        }
        // Focus target
        for i in 0..self.surface_count {
            if self.surfaces[i].surface_id == id {
                self.surfaces[i] = self.surfaces[i].focus();
                self.focused_id = id;
                self.focus_history[self.history_depth % 16] = id;
                self.history_depth = self.history_depth + 1;
            }
        }
        return self;
    }

    fn cycle_focus(mut self) -> WindowManager
        effect [compute]
    {
        if self.surface_count == 0 { return self; }
        let mut next_idx: u64 = 0;
        // Find current focus index, then pick next
        let mut found: bool = false;
        for i in 0..self.surface_count {
            if self.surfaces[i].surface_id == self.focused_id {
                next_idx = (i + 1) % self.surface_count;
                found = true;
            }
        }
        if !found { next_idx = 0; }
        let new_id: u64 = self.surfaces[next_idx].surface_id;
        return self.set_focus(new_id);
    }

    fn route_input(mut self, key: u8) -> WindowManager
        effect [compute]
    {
        // Route key to focused surface's widgets
        if key == 0x09 {  // Tab
            self = self.cycle_focus();
        }
        return self;
    }

    fn increment_frame(mut self) -> WindowManager
        effect [compute]
    {
        self.frame_count = self.frame_count + 1;
        return self;
    }

    fn focused_surface_id(self) -> u64
        effect [compute]
    {
        return self.focused_id;
    }

    fn surface_count(self) -> u64
        effect [compute]
    {
        return self.surface_count;
    }

    fn frame_count(self) -> u64
        effect [compute]
    {
        return self.frame_count;
    }
}

// ── Test ───────────────────────────────────────────────

fn test_window_manager() -> bool
    effect [compute]
{
    // Create window manager
    let mut wm: WindowManager = WindowManager::new();
    assert(wm.surface_count() == 0, "wm: starts empty");
    assert(wm.frame_count() == 0, "wm: frame count starts at 0");

    // Create surfaces
    let mut title1: Array(u8, 64) = Array::splat(0);
    title1[0] = 0x54; title1[1] = 0x65; title1[2] = 0x72; // "Ter"
    title1[3] = 0x6D;                                      // "m"
    let (wm, id1): (WindowManager, u64) = wm.create_surface(320, 200, title1, 4);
    assert(id1 > 0, "wm: first surface created");
    assert(wm.surface_count() == 1, "wm: 1 surface");

    let mut title2: Array(u8, 64) = Array::splat(0);
    title2[0] = 0x4D; title2[1] = 0x6F; title2[2] = 0x6E; // "Mon"
    title2[3] = 0x69; title2[4] = 0x74; title2[5] = 0x6F; // "itor"
    title2[6] = 0x72;
    let (wm, id2): (WindowManager, u64) = wm.create_surface(400, 300, title2, 7);
    assert(wm.surface_count() == 2, "wm: 2 surfaces");
    assert(wm.focused_surface_id() == id2, "wm: newest surface focused");

    // Test focus cycling
    wm = wm.cycle_focus();
    assert(wm.focused_surface_id() == id1, "wm: focus cycled to first surface");

    wm = wm.cycle_focus();
    assert(wm.focused_surface_id() == id2, "wm: focus cycled back");

    // Test input routing
    wm = wm.route_input(0x09);  // Tab
    assert(wm.focused_surface_id() == id1, "wm: tab cycles focus");

    // Test frame counting
    wm = wm.increment_frame();
    wm = wm.increment_frame();
    wm = wm.increment_frame();
    assert(wm.frame_count() == 3, "wm: 3 frames rendered");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute]
{
    let passed: bool = test_window_manager();
    assert(passed, "wm: all tests pass");

    console.write(Str::from("Phor Window Manager:"));
    console.write(Str::from("  Surface creation and management: PASS"));
    console.write(Str::from("  Focus tracking and cycling: PASS"));
    console.write(Str::from("  Input routing (Tab focus cycle): PASS"));
    console.write(Str::from("  Frame counting: PASS"));
    console.write(Str::from("Window manager demo passed!"));
}
