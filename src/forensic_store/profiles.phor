// profiles.phor — User/service/device profiles: capabilities, trust thresholds, dialect allowances
// Phorensic Forensic Store: profile system
// Spec: FORENSIC_STORE.md — Profiles section
// Grammar: PHORENSIC_GRAMMAR.md §44 Dialect Profile Grammar, §70 Profile System Rules

package forensic_store.profiles;

use forensic_store.store_object::{
    Hash256, hash256_zero, hash256_equal,
    TrustState, TrustLevel,
    Identity, identity_equal, identity_is_valid,
    DialectProfile,
    ResidualRecord, ResidualHistory, ResidualOpType, ResidualSeverity, CausalCategory,
};
use forensic_store.store_key::{
    StoreKey, store_key_equal, store_key_zero,
};

// ============================================================================
// Profile Types
// ============================================================================

/// The kind of entity a profile belongs to.
type ProfileKind = enum {
    /// A human user
    User = 0,
    /// A system service
    Service = 1,
    /// A hardware device
    Device = 2,
    /// An automated process or daemon
    Automation = 3,
    /// A court or oracle identity
    Court = 4,
    /// An auditor identity
    Auditor = 5,
    /// A build system agent
    Builder = 6,
    /// A store replication peer
    Peer = 7,
}

// ============================================================================
// Profile — Full Specification
// ============================================================================

/// A profile defines the capabilities, trust thresholds, and allowances
/// for a user, service, or device interacting with the store.
///
/// Spec:
///   Profile =
///     capability_grants
///     package_generation
///     residual_trust_threshold: TrustState
///     allowed_dialects: List[DialectProfile]
///     allowed_effects: List[Effect]
///     replay_court_policy: CourtPolicy
struct Profile
    layout packed
{
    /// Profile name
    name: Array[u8, 128],
    name_len: u32,
    /// Profile version (for rotation)
    version: u32,
    /// Kind of entity this profile belongs to
    kind: ProfileKind,
    /// The identity this profile is bound to
    identity: Identity,
    /// Capability grants — store-level capabilities
    store_capabilities: ProfileStoreCapabilities,
    /// Package management capabilities
    package_capabilities: ProfilePackageCapabilities,
    /// Generation management capabilities
    generation_capabilities: ProfileGenerationCapabilities,
    /// Profile management capabilities
    profile_capabilities: ProfileProfileCapabilities,
    /// Court interaction capabilities
    court_capabilities: ProfileCourtCapabilities,
    /// Trust threshold — minimum trust level required for objects
    /// to be considered valid by this profile
    residual_trust_threshold: TrustLevel,
    /// Package generation level this profile operates at
    package_generation: u64,
    /// Allowed dialects (bounded to 32)
    allowed_dialects: Array[DialectProfile, 32],
    allowed_dialect_count: u32,
    /// Allowed effect names (bounded to 32)
    allowed_effects: Array[Array[u8, 64], 32],
    allowed_effect_lens: Array[u32, 32],
    allowed_effect_count: u32,
    /// Replay court policy
    replay_court_policy: CourtPolicy,
    /// Default court for verification
    default_court: Array[u8, 64],
    default_court_len: u32,
    /// Whether this profile can create new profiles
    can_create_profiles: bool,
    /// Whether this profile can modify existing profiles
    can_modify_profiles: bool,
    /// Whether this profile can delete profiles
    can_delete_profiles: bool,
    /// Whether this profile can bypass trust checks
    can_bypass_trust: bool,
    /// Whether this profile is currently active
    active: bool,
    /// Whether this profile is locked (cannot be modified)
    locked: bool,
    /// Timestamp of profile creation
    created_at: u64,
    /// Timestamp of last modification
    modified_at: u64,
    /// Identity that created this profile
    created_by: Identity,
    /// Identity that last modified this profile
    modified_by: Identity,
    /// Generation at which this profile was created
    creation_generation: u64,
    /// Time-to-live in seconds (0 = no TTL)
    ttl_seconds: u64,
    /// Expiration timestamp
    expires_at: u64,
    /// Hash of the profile descriptor
    descriptor_hash: Hash256,
    /// Signatures over the profile descriptor
    signatures: Array[Signature, 16],
    signature_count: u32,
    /// Residual history for profile operations
    profile_residuals: ResidualHistory,
    /// Reserved for future fields
    reserved: Array[u64, 16],
}

// ============================================================================
// Capability Sub-Structures
// ============================================================================

/// Store capabilities within a profile.
struct ProfileStoreCapabilities
    layout packed
{
    can_read_objects: bool,
    can_write_objects: bool,
    can_delete_objects: bool,
    can_audit: bool,
    can_verify: bool,
    can_configure: bool,
    can_enumerate: bool,
    can_promote: bool,
    can_pin: bool,
    can_unpin: bool,
}

/// Package management capabilities.
struct ProfilePackageCapabilities
    layout packed
{
    can_create_packages: bool,
    can_sign_packages: bool,
    can_verify_packages: bool,
    can_promote_packages: bool,
    can_audit_packages: bool,
    can_seal_packages: bool,
    can_add_auditor_stamps: bool,
    can_import_packages: bool,
    can_export_packages: bool,
}

/// Generation management capabilities.
struct ProfileGenerationCapabilities
    layout packed
{
    can_create_generations: bool,
    can_activate_generations: bool,
    can_rollback_generations: bool,
    can_deactivate_generations: bool,
    can_describe_generations: bool,
    can_compare_generations: bool,
    can_verify_generations: bool,
    can_delete_generations: bool,
}

/// Profile management capabilities.
struct ProfileProfileCapabilities
    layout packed
{
    can_view_own_profile: bool,
    can_modify_own_profile: bool,
    can_view_any_profile: bool,
    can_create_profiles: bool,
    can_modify_any_profile: bool,
    can_delete_profiles: bool,
    can_lock_profiles: bool,
    can_unlock_profiles: bool,
}

/// Court interaction capabilities.
struct ProfileCourtCapabilities
    layout packed
{
    can_request_replay: bool,
    can_submit_evidence: bool,
    can_view_verdicts: bool,
    can_act_as_oracle: bool,
    can_act_as_judge: bool,
    can_audit_court: bool,
}

/// Court policy — how this profile interacts with replay courts.
struct CourtPolicy
    layout packed
{
    /// Required court for verification
    required_court_name: Array[u8, 64],
    required_court_name_len: u32,
    /// Minimum number of oracle comparisons required
    min_oracle_comparisons: u32,
    /// Whether replay is required before promotion
    replay_required: bool,
    /// Acceptable divergence level
    acceptable_divergence: DivergenceLevel,
    /// Whether court evidence must be retained
    retain_court_evidence: bool,
}

type DivergenceLevel = enum {
    /// No divergence tolerated
    None = 0,
    /// Minor divergence tolerated
    Minor = 1,
    /// Significant divergence tolerated
    Significant = 2,
    /// Any divergence tolerated (dangerous)
    Any = 3,
}

/// A cryptographic signature in the profile context.
struct Signature
    layout packed
{
    algorithm: Array[u8, 32],
    algorithm_len: u32,
    sig_bytes: Array[u8, 512],
    sig_bytes_len: u32,
    signer_key: Hash256,
    signer_identity: Identity,
    signed_at: u64,
    verified: bool,
}

// ============================================================================
// Profile Defaults
// ============================================================================

/// Create a default platform profile (administrator-level).
fn profile_default_admin() -> Profile
    effect [compute]
{
    let zero_hash: Hash256 = hash256_zero();
    let zero_id: Identity = Identity {
        name: Array[u8, 128]::zeroed(),
        name_len: 0,
        key_fingerprint: zero_hash,
        dialect_scope: Array[u8, 64]::zeroed(),
        dialect_scope_len: 0,
        version: 0,
        established_at_gen: 0,
    };
    let history: ResidualHistory = ResidualHistory {
        records: Array[ResidualRecord, 1024]::zeroed(),
        count: 0,
        head: 0,
        tail: 0,
        total_emitted: 0,
        owner_hash: zero_hash,
    };

    return Profile {
        name: Array[u8, 128]::from_literal("admin"),
        name_len: 5,
        version: 1,
        kind: ProfileKind::User,
        identity: zero_id,
        store_capabilities: ProfileStoreCapabilities {
            can_read_objects: true,
            can_write_objects: true,
            can_delete_objects: true,
            can_audit: true,
            can_verify: true,
            can_configure: true,
            can_enumerate: true,
            can_promote: true,
            can_pin: true,
            can_unpin: true,
        },
        package_capabilities: ProfilePackageCapabilities {
            can_create_packages: true,
            can_sign_packages: true,
            can_verify_packages: true,
            can_promote_packages: true,
            can_audit_packages: true,
            can_seal_packages: true,
            can_add_auditor_stamps: true,
            can_import_packages: true,
            can_export_packages: true,
        },
        generation_capabilities: ProfileGenerationCapabilities {
            can_create_generations: true,
            can_activate_generations: true,
            can_rollback_generations: true,
            can_deactivate_generations: true,
            can_describe_generations: true,
            can_compare_generations: true,
            can_verify_generations: true,
            can_delete_generations: true,
        },
        profile_capabilities: ProfileProfileCapabilities {
            can_view_own_profile: true,
            can_modify_own_profile: true,
            can_view_any_profile: true,
            can_create_profiles: true,
            can_modify_any_profile: true,
            can_delete_profiles: true,
            can_lock_profiles: true,
            can_unlock_profiles: true,
        },
        court_capabilities: ProfileCourtCapabilities {
            can_request_replay: true,
            can_submit_evidence: true,
            can_view_verdicts: true,
            can_act_as_oracle: true,
            can_act_as_judge: true,
            can_audit_court: true,
        },
        residual_trust_threshold: TrustLevel::IntegrityVerified,
        package_generation: 1,
        allowed_dialects: Array[DialectProfile, 32]::zeroed(),
        allowed_dialect_count: 0,
        allowed_effects: Array[Array[u8, 64], 32]::zeroed(),
        allowed_effect_lens: Array[u32, 32]::zeroed(),
        allowed_effect_count: 0,
        replay_court_policy: CourtPolicy {
            required_court_name: Array[u8, 64]::zeroed(),
            required_court_name_len: 0,
            min_oracle_comparisons: 1,
            replay_required: true,
            acceptable_divergence: DivergenceLevel::None,
            retain_court_evidence: true,
        },
        default_court: Array[u8, 64]::from_literal("replay_court_v1"),
        default_court_len: 16,
        can_create_profiles: true,
        can_modify_profiles: true,
        can_delete_profiles: true,
        can_bypass_trust: false,
        active: true,
        locked: false,
        created_at: 0,
        modified_at: 0,
        created_by: zero_id,
        modified_by: zero_id,
        creation_generation: 1,
        ttl_seconds: 0,
        expires_at: 0,
        descriptor_hash: zero_hash,
        signatures: Array[Signature, 16]::zeroed(),
        signature_count: 0,
        profile_residuals: history,
        reserved: Array[u64, 16]::zeroed(),
    };
}

