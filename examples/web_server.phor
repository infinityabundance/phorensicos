fn test_http_cookie_parsing() -> void
    effect [compute, residual]
{
    let cookie_header: Str(128) = Str::from("Cookie: session_id=abc123; theme=dark; lang=en");
    let mut cookie_count: u64 = 0;
    for i in 0..cookie_header.len() {
        if cookie_header[i] == ';' {
            cookie_count = cookie_count + 1;
        }
    }
    cookie_count = cookie_count + 1;
    assert(cookie_count == 3, "http: 3 cookies parsed");

    residual emit {
        op: "http.test.cookies",
        count: cookie_count,
    };
}

fn test_http_https_redirect() -> void
    effect [compute, residual]
{
    let is_https: bool = true;
    let redirect_code: u16 = 301;
    if is_https {
        assert(redirect_code == 301, "http: HTTPS redirect code 301");
    }

    residual emit {
        op: "http.test.https_redirect",
        https: true,
        code: redirect_code as u64,
    };
}

    net.write_line("HTTP server shut down.")!;
    return Ok(void);
}
fn test_http_server_all_routes() -> void,
    effect [compute, residual]
{
    let routes: Array(Str(32), 5) = ["/", "/index.html", "/style.css", "/app.js", "/favicon.ico"];
    for i in 0..5 {
        assert(routes[i].len() > 0, "http: route non-empty");
    }

    residual emit {
        op: "http.test.all_routes",
        routes: 5,
    };
}
    effect [compute, residual]
{
    let methods: Array(Str(8), 5) = ["GET", "POST", "PUT", "DELETE", "HEAD"];
    assert(methods[0] == "GET", "http: GET method");
    assert(methods[1] == "POST", "http: POST method");
    assert(methods[2] == "PUT", "http: PUT method");
    assert(methods[3] == "DELETE", "http: DELETE method");
    assert(methods[4] == "HEAD", "http: HEAD method");

    residual emit {
        op: "http.test.methods",
        count: 5,
    };
}

fn test_http_status_codes() -> void
    effect [compute, residual]
{
    let info: u16 = 100;
    let success: u16 = 200;
    let redirect: u16 = 301;
    let client_err: u16 = 404;
    let server_err: u16 = 500;

    assert(success >= 200 && success < 300, "http: 2xx = success");
    assert(redirect >= 300 && redirect < 400, "http: 3xx = redirect");
    assert(client_err >= 400 && client_err < 500, "http: 4xx = client error");
    assert(server_err >= 500 && server_err < 600, "http: 5xx = server error");

    residual emit {
        op: "http.test.status_codes",
        categories: 4,
    };
}

fn test_http_content_types() -> void
    effect [compute, residual]
{
    let html: Str(64) = get_mime_type(Str::from("html"));
    let css: Str(64) = get_mime_type(Str::from("css"));
    let js: Str(64) = get_mime_type(Str::from("js"));
    let png: Str(64) = get_mime_type(Str::from("png"));
    let unknown: Str(64) = get_mime_type(Str::from("xyz"));

    assert(html == Str::from("text/html"), "http: HTML MIME type");
    assert(css == Str::from("text/css"), "http: CSS MIME type");
    assert(js == Str::from("application/javascript"), "http: JS MIME type");
    assert(png == Str::from("image/png"), "http: PNG MIME type");
    assert(unknown == Str::from("application/octet-stream"), "http: unknown falls back to octet-stream");

    residual emit {
        op: "http.test.mime_types",
        types_tested: 5,
    };
}

fn test_http_header_parsing() -> void
    effect [compute, residual]
{
    let headers: Array(Str(128), 4) = ["Content-Type: text/html", "Content-Length: 1024", "Host: example.com", "Connection: keep-alive"];

    for i in 0..4 {
        let header: Str(128) = headers[i];
        assert(header.len() > 0, "http: header non-empty");
        // Check header has colon separator
        let mut has_colon: bool = false;
        for j in 0..header.len() {
            if header[j] == ':' { has_colon = true; }
        }
        assert(has_colon, "http: header has colon separator");
    }

    residual emit {
        op: "http.test.headers",
        parsed: 4,
    };
}

fn test_http_query_string_parse() -> void
    effect [compute, residual]
{
    let query: Str(64) = Str::from("name=alice&age=30&lang=en");
    let mut pairs: u64 = 1;
    for i in 0..query.len() {
        if query[i] == '&' { pairs = pairs + 1; }
    }
    assert(pairs == 3, "http: 3 query parameters");
    residual emit { op: "http.test.query", pairs: pairs, };
}

