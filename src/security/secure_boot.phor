// secure_boot.phor — Secure Boot & Root of Trust
//
// Provides:
//   - Root of trust measurement (hardware root, TPM, firmware)
//   - Boot chain verification (stage-by-stage integrity)
//   - Kernel integrity check (signed kernel, modules)
//   - Policy early load (before userspace)
//   - Measured boot (PCR extend operations)
//   - Remote attestation (quote generation and verification)
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every boot measurement produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:secure_boot:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_BOOT_STAGES: u64 = 16;
const MAX_MEASUREMENTS: u64 = 256;
const MAX_PCR_REGISTERS: u64 = 32;
const MAX_ATTESTATION_QUOTES: u64 = 64;
const MAX_POLICY_EARLY_RULES: u64 = 32;
const MAX_SIGNATURE_CHAIN_DEPTH: u64 = 8;
const MAX_BOOT_IMAGE_SIZE: u64 = 65536;
const MAX_MEASUREMENT_DIGEST_SIZE: u64 = 64;
const MAX_BOOT_EVENT_LOG: u64 = 512;
const MAX_KERNEL_MODULES: u64 = 128;
const MAX_POLICY_EARLY_SIZE: u64 = 4096;
const MAX_BOOT_FAILURE_RECORDS: u64 = 32;
const MAX_TRUST_ANCHORS: u64 = 8;

effect boot:measure;
effect boot:verify;
effect boot:policy;
effect boot:attest;

// ──────────────────────────────────────────────
// Secure Boot Types
// ──────────────────────────────────────────────

enum BootStage {
    Stage1BootROM,
    Stage2Bootloader,
    Stage3Bootloader,
    Stage4Kernel,
    Stage5Initramfs,
    Stage6Userspace,
    Stage7Application,
}

enum MeasurementType {
    Firmware,
    Bootloader,
    KernelImage,
    KernelModule,
    Initramfs,
    DeviceTree,
    ACPI,
    PolicyBlob,
    CommandLine,
    Configuration,
    TrustAnchor,
    StageTransition,
}

enum VerificationResult {
    Pass,
    Fail,
    NotMeasured,
    SignatureInvalid,
    HashMismatch,
    NotTrusted,
    Revoked,
    Unknown,
}

enum AttestationType {
    TPMQuote,
    TCGLog,
    PlatformCert,
    DICEChain,
    KeyExchange,
    ChallengeResponse,
}

enum PCRBank {
    SHA1,
    SHA256,
    SHA384,
    SHA512,
    SM3,
}

// ──────────────────────────────────────────────
// Secure Boot Data Structures
// ──────────────────────────────────────────────

struct PCRRegister {
    pcr_index: u64,
    bank: PCRBank,
    value: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    extended_count: u64,
    reset_value: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    locked: bool,
}

struct BootMeasurement {
    measurement_id: u64,
    stage: BootStage,
    measurement_type: MeasurementType,
    pcr_index: u64,
    digest: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    digest_size: u64,
    image_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    image_size: u64,
    signer_id: u64,
    signature_valid: bool,
    timestamp: u64,
    measured: bool,
}

struct BootEventLog {
    event_id: u64,
    measurement_id: u64,
    pcr_index: u64,
    event_type: MeasurementType,
    event_data: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    data_size: u64,
    description: Str(128),
    timestamp: u64,
}

struct AttestationQuote {
    quote_id: u64,
    attestation_type: AttestationType,
    pcr_values: Array(Array(u8, MAX_MEASUREMENT_DIGEST_SIZE), MAX_PCR_REGISTERS),
    pcr_count: u64,
    nonce: u64,
    signature: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    signature_size: u64,
    signer_id: u64,
    timestamp: u64,
    verified: bool,
    platform_id: u64,
}

struct EarlyPolicyRule {
    rule_id: u64,
    name: Str(64),
    applies_to_stage: BootStage,
    measurement_type: MeasurementType,
    required_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    required_signer: u64,
    allow_alternative: bool,
    critical: bool,
    enabled: bool,
}

struct KernelModuleInfo {
    module_id: u64,
    name: Str(64),
    size: u64,
    hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    signer: u64,
    signature_verified: bool,
    measured: bool,
    loaded: bool,
}

struct TrustAnchor {
    anchor_id: u64,
    name: Str(64),
    public_key_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    key_type: u8,
    certificate_issuer: Str(128),
    expiry: u64,
    revoked: bool,
    hardware_bound: bool,
}

struct BootVerificationRecord {
    record_id: u64,
    stage: BootStage,
    component_name: Str(64),
    expected_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    actual_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    result: VerificationResult,
    pcr_match: bool,
    signature_verified: bool,
    timestamp: u64,
    failure_reason: Str(256),
}

struct SecureBootState {
    pcr_registers: Array(PCRRegister, MAX_PCR_REGISTERS),
    pcr_count: u64,
    measurements: Array(BootMeasurement, MAX_MEASUREMENTS),
    measurement_count: u64,
    event_log: Array(BootEventLog, MAX_BOOT_EVENT_LOG),
    event_count: u64,
    quotes: Array(AttestationQuote, MAX_ATTESTATION_QUOTES),
    quote_count: u64,
    early_policies: Array(EarlyPolicyRule, MAX_POLICY_EARLY_RULES),
    policy_count: u64,
    kernel_modules: Array(KernelModuleInfo, MAX_KERNEL_MODULES),
    module_count: u64,
    trust_anchors: Array(TrustAnchor, MAX_TRUST_ANCHORS),
    anchor_count: u64,
    verification_records: Array(BootVerificationRecord, MAX_BOOT_STAGES),
    verification_count: u64,
    boot_completed: bool,
    boot_measurement_log_enabled: bool,
    secure_boot_enforced: bool,
    policy_early_loaded: bool,
}

// ──────────────────────────────────────────────
// PCR Operations
// ──────────────────────────────────────────────

fn init_pcr_registers() -> Array(PCRRegister, MAX_PCR_REGISTERS)
    effect [boot:measure, compute]
{
    let mut registers: Array(PCRRegister, MAX_PCR_REGISTERS) = Array::zeroed();
    for i in 0..MAX_PCR_REGISTERS {
        registers[i] = PCRRegister{
            pcr_index: i,
            bank: PCRBank::SHA256,
            value: Array::splat(0),
            extended_count: 0,
            reset_value: Array::splat(0),
            locked: false,
        };
    }
    return registers;
}

fn pcr_extend(
    state: SecureBootState,
    pcr_index: u64,
    data: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    data_size: u64,
) -> SecureBootState
    effect [boot:measure, compute, residual]
{
    let mut updated: SecureBootState = state;
    if pcr_index < MAX_PCR_REGISTERS && !updated.pcr_registers[pcr_index].locked {
        let mut pcr: PCRRegister = updated.pcr_registers[pcr_index];
        pcr.extended_count = pcr.extended_count + 1;
        for i in 0..data_size {
            pcr.value[i] = pcr.value[i] ^ data[i];
        }
        updated.pcr_registers[pcr_index] = pcr;

        residual emit {
            op: "boot.pcr_extend",
            pcr: pcr_index,
            count: pcr.extended_count,
            size: data_size,
        };
    }
    return updated;
}

fn pcr_reset(state: SecureBootState, pcr_index: u64) -> SecureBootState
    effect [boot:measure, compute, residual]
{
    let mut updated: SecureBootState = state;
    if pcr_index < MAX_PCR_REGISTERS && !updated.pcr_registers[pcr_index].locked {
        let reset_val: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = updated.pcr_registers[pcr_index].reset_value;
        updated.pcr_registers[pcr_index].value = reset_val;
        updated.pcr_registers[pcr_index].extended_count = 0;

        residual emit {
            op: "boot.pcr_reset",
            pcr: pcr_index,
        };
    }
    return updated;
}

fn pcr_lock(state: SecureBootState, pcr_index: u64) -> SecureBootState
    effect [boot:measure, compute, residual]
{
    let mut updated: SecureBootState = state;
    if pcr_index < MAX_PCR_REGISTERS {
        updated.pcr_registers[pcr_index].locked = true;

        residual emit {
            op: "boot.pcr_lock",
            pcr: pcr_index,
        };
    }
    return updated;
}

fn get_pcr_value(state: SecureBootState, pcr_index: u64) -> Array(u8, MAX_MEASUREMENT_DIGEST_SIZE)
    effect [compute]
{
    if pcr_index < MAX_PCR_REGISTERS {
        return state.pcr_registers[pcr_index].value;
    }
    return Array::splat(0);
}

fn compare_pcr_values(
    state: SecureBootState,
    pcr_index: u64,
    expected: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
) -> bool
    effect [compute]
{
    if pcr_index >= MAX_PCR_REGISTERS {
        return false;
    }
    let actual: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = state.pcr_registers[pcr_index].value;
    for i in 0..MAX_MEASUREMENT_DIGEST_SIZE {
        if actual[i] != expected[i] {
            return false;
        }
    }
    return true;
}

// ──────────────────────────────────────────────
// Boot Stage Measurement
// ──────────────────────────────────────────────

fn measure_component(
    state: SecureBootState,
    stage: BootStage,
    measurement_type: MeasurementType,
    pcr_index: u64,
    image_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    image_size: u64,
    signer_id: u64,
    signature_valid: bool,
) -> SecureBootState
    effect [boot:measure, compute, residual]
{
    let mut updated: SecureBootState = state;
    if updated.measurement_count < MAX_MEASUREMENTS {
        let measurement: BootMeasurement = BootMeasurement{
            measurement_id: updated.measurement_count + 1,
            stage: stage,
            measurement_type: measurement_type,
            pcr_index: pcr_index,
            digest: image_hash,
            digest_size: MAX_MEASUREMENT_DIGEST_SIZE,
            image_hash: image_hash,
            image_size: image_size,
            signer_id: signer_id,
            signature_valid: signature_valid,
            timestamp: 0,
            measured: true,
        };
        updated.measurements[updated.measurement_count] = measurement;
        updated.measurement_count = updated.measurement_count + 1;
        updated = pcr_extend(updated, pcr_index, image_hash, MAX_MEASUREMENT_DIGEST_SIZE);

        if updated.event_count < MAX_BOOT_EVENT_LOG {
            let event: BootEventLog = BootEventLog{
                event_id: updated.event_count + 1,
                measurement_id: measurement.measurement_id,
                pcr_index: pcr_index,
                event_type: measurement_type,
                event_data: image_hash,
                data_size: MAX_MEASUREMENT_DIGEST_SIZE,
                description: Str::from("Component measurement"),
                timestamp: 0,
            };
            updated.event_log[updated.event_count] = event;
            updated.event_count = updated.event_count + 1;
        }

        residual emit {
            op: "boot.measure_component",
            stage: stage as u8,
            type: measurement_type as u8,
            pcr: pcr_index,
            size: image_size,
            signed: if signature_valid { 1 } else { 0 },
        };
    }
    return updated;
}

fn verify_boot_stage(
    state: SecureBootState,
    stage: BootStage,
    component_name: Str(64),
    expected_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    actual_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    signature_valid: bool,
    pcr_index: u64,
) -> (SecureBootState, VerificationResult)
    effect [boot:verify, compute, residual]
{
    let mut updated: SecureBootState = state;
    let mut result: VerificationResult = VerificationResult::Pass;

    if !compare_pcr_values(updated, pcr_index, expected_hash) {
        result = VerificationResult::HashMismatch;
    }
    if !signature_valid {
        result = VerificationResult::SignatureInvalid;
    }

    if updated.verification_count < MAX_BOOT_STAGES {
        let record: BootVerificationRecord = BootVerificationRecord{
            record_id: updated.verification_count + 1,
            stage: stage,
            component_name: component_name,
            expected_hash: expected_hash,
            actual_hash: actual_hash,
            result: result,
            pcr_match: result == VerificationResult::Pass,
            signature_verified: signature_valid,
            timestamp: 0,
            failure_reason: Str::from(""),
        };
        updated.verification_records[updated.verification_count] = record;
        updated.verification_count = updated.verification_count + 1;
    }

    if result != VerificationResult::Pass && updated.secure_boot_enforced {
        updated.boot_completed = false;
    }

    residual emit {
        op: "boot.verify_stage",
        stage: stage as u8,
        component: component_name,
        result: result as u8,
        enforced: if updated.secure_boot_enforced { 1 } else { 0 },
    };

    return (updated, result);
}

// ──────────────────────────────────────────────
// Boot Chain Verification
// ──────────────────────────────────────────────

fn verify_boot_chain(state: SecureBootState) -> (SecureBootState, bool)
    effect [boot:verify, compute, residual]
{
    let mut updated: SecureBootState = state;
    let mut chain_valid: bool = true;

    for i in 0..updated.verification_count {
        let rec: BootVerificationRecord = updated.verification_records[i];
        if rec.result != VerificationResult::Pass {
            chain_valid = false;
            break;
        }
    }

    updated.boot_completed = chain_valid;

    residual emit {
        op: "boot.chain_verify",
        stages: updated.verification_count,
        valid: if chain_valid { 1 } else { 0 },
    };

    return (updated, chain_valid);
}

fn measure_kernel_module(
    state: SecureBootState,
    module_id: u64,
    name: Str(64),
    module_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    module_size: u64,
    signer: u64,
    signature_verified: bool,
) -> SecureBootState
    effect [boot:measure, compute, residual]
{
    let mut updated: SecureBootState = state;
    if updated.module_count < MAX_KERNEL_MODULES {
        let mod_info: KernelModuleInfo = KernelModuleInfo{
            module_id: module_id,
            name: name,
            size: module_size,
            hash: module_hash,
            signer: signer,
            signature_verified: signature_verified,
            measured: true,
            loaded: false,
        };
        updated.kernel_modules[updated.module_count] = mod_info;
        updated.module_count = updated.module_count + 1;

        updated = measure_component(
            updated, BootStage::Stage4Kernel,
            MeasurementType::KernelModule,
            10, module_hash, module_size,
            signer, signature_verified,
        );

        residual emit {
            op: "boot.kernel_module_measure",
            module: module_id,
            name: name,
            verified: if signature_verified { 1 } else { 0 },
        };
    }
    return updated;
}

fn verify_kernel_module(
    state: SecureBootState,
    module_id: u64,
    expected_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
) -> (SecureBootState, bool)
    effect [boot:verify, compute]
{
    let mut updated: SecureBootState = state;
    let mut verified: bool = false;

    for i in 0..updated.module_count {
        if updated.kernel_modules[i].module_id == module_id {
            let mod_info: KernelModuleInfo = updated.kernel_modules[i];
            let hash_match: bool = true;
            for j in 0..MAX_MEASUREMENT_DIGEST_SIZE {
                if mod_info.hash[j] != expected_hash[j] {
                    hash_match = false;
                    break;
                }
            }
            verified = hash_match && mod_info.signature_verified;
            updated.kernel_modules[i].loaded = verified;
            break;
        }
    }
    return (updated, verified);
}

// ──────────────────────────────────────────────
// Early Policy Load
// ──────────────────────────────────────────────

fn add_early_policy_rule(state: SecureBootState, rule: EarlyPolicyRule) -> SecureBootState
    effect [boot:policy, compute, residual]
{
    let mut updated: SecureBootState = state;
    if updated.policy_count < MAX_POLICY_EARLY_RULES {
        updated.early_policies[updated.policy_count] = rule;
        updated.policy_count = updated.policy_count + 1;

        residual emit {
            op: "boot.early_policy_add",
            rule: rule.rule_id,
            stage: rule.applies_to_stage as u8,
            critical: if rule.critical { 1 } else { 0 },
        };
    }
    return updated;
}

fn enforce_early_policy(
    state: SecureBootState,
    stage: BootStage,
    measurement_type: MeasurementType,
    actual_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
) -> (SecureBootState, bool)
    effect [boot:policy, compute, residual]
{
    let mut updated: SecureBootState = state;
    let mut allowed: bool = true;

    for i in 0..updated.policy_count {
        let rule: EarlyPolicyRule = updated.early_policies[i];
        if !rule.enabled {
            continue;
        }
        if rule.applies_to_stage == stage && rule.measurement_type == measurement_type {
            let mut hash_match: bool = true;
            for j in 0..MAX_MEASUREMENT_DIGEST_SIZE {
                if rule.required_hash[j] != actual_hash[j] {
                    hash_match = false;
                    break;
                }
            }
            if !hash_match && !rule.allow_alternative {
                allowed = false;
                if rule.critical {
                    updated.boot_completed = false;
                }
            }
        }
    }

    residual emit {
        op: "boot.early_policy_enforce",
        stage: stage as u8,
        type: measurement_type as u8,
        allowed: if allowed { 1 } else { 0 },
    };

    return (updated, allowed);
}

fn load_policy_early(state: SecureBootState) -> SecureBootState
    effect [boot:policy, compute, residual]
{
    let mut updated: SecureBootState = state;
    updated.policy_early_loaded = true;

    residual emit {
        op: "boot.policy_early_load",
    };

    return updated;
}

// ──────────────────────────────────────────────
// Trust Anchors
// ──────────────────────────────────────────────

fn add_trust_anchor(state: SecureBootState, anchor: TrustAnchor) -> SecureBootState
    effect [boot:verify, compute, residual]
{
    let mut updated: SecureBootState = state;
    if updated.anchor_count < MAX_TRUST_ANCHORS {
        updated.trust_anchors[updated.anchor_count] = anchor;
        updated.anchor_count = updated.anchor_count + 1;

        residual emit {
            op: "boot.trust_anchor_add",
            id: anchor.anchor_id,
            name: anchor.name,
        };
    }
    return updated;
}

fn verify_against_trust_anchor(
    state: SecureBootState,
    key_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
) -> bool
    effect [boot:verify, compute]
{
    for i in 0..state.anchor_count {
        let anchor: TrustAnchor = state.trust_anchors[i];
        if anchor.revoked {
            continue;
        }
        let mut match_ok: bool = true;
        for j in 0..MAX_MEASUREMENT_DIGEST_SIZE {
            if anchor.public_key_hash[j] != key_hash[j] {
                match_ok = false;
                break;
            }
        }
        if match_ok {
            return true;
        }
    }
    return false;
}

// ──────────────────────────────────────────────
// Remote Attestation
// ──────────────────────────────────────────────

fn create_attestation_quote(
    state: SecureBootState,
    attestation_type: AttestationType,
    nonce: u64,
    signer_id: u64,
) -> (SecureBootState, AttestationQuote)
    effect [boot:attest, compute, residual]
{
    let mut updated: SecureBootState = state;
    let mut pcr_vals: Array(Array(u8, MAX_MEASUREMENT_DIGEST_SIZE), MAX_PCR_REGISTERS) = Array::splat(Array::splat(0));

    for i in 0..updated.pcr_count {
        pcr_vals[i] = updated.pcr_registers[i].value;
    }

    let quote: AttestationQuote = AttestationQuote{
        quote_id: updated.quote_count + 1,
        attestation_type: attestation_type,
        pcr_values: pcr_vals,
        pcr_count: updated.pcr_count,
        nonce: nonce,
        signature: Array::splat(0),
        signature_size: 0,
        signer_id: signer_id,
        timestamp: 0,
        verified: false,
        platform_id: 0,
    };

    if updated.quote_count < MAX_ATTESTATION_QUOTES {
        updated.quotes[updated.quote_count] = quote;
        updated.quote_count = updated.quote_count + 1;
    }

    residual emit {
        op: "boot.attestation_quote",
        type: attestation_type as u8,
        nonce: nonce,
        signer: signer_id,
    };

    return (updated, quote);
}

fn verify_attestation_quote(
    quote: AttestationQuote,
    expected_pcr_values: Array(Array(u8, MAX_MEASUREMENT_DIGEST_SIZE), MAX_PCR_REGISTERS),
    pcr_count: u64,
) -> bool
    effect [boot:attest, compute]
{
    let mut valid: bool = true;
    let count: u64 = if pcr_count < quote.pcr_count { pcr_count } else { quote.pcr_count };

    for i in 0..count {
        for j in 0..MAX_MEASUREMENT_DIGEST_SIZE {
            if quote.pcr_values[i][j] != expected_pcr_values[i][j] {
                valid = false;
                break;
            }
        }
        if !valid {
            break;
        }
    }
    return valid;
}

// ──────────────────────────────────────────────
// Measured Boot Flow
// ──────────────────────────────────────────────

fn init_secure_boot_state() -> SecureBootState
    effect [boot:measure, compute, residual]
{
    let pcr_regs: Array(PCRRegister, MAX_PCR_REGISTERS) = init_pcr_registers();

    residual emit {
        op: "boot.state_init",
        pcrs: MAX_PCR_REGISTERS,
    };

    return SecureBootState{
        pcr_registers: pcr_regs,
        pcr_count: 16,
        measurements: Array::zeroed(),
        measurement_count: 0,
        event_log: Array::zeroed(),
        event_count: 0,
        quotes: Array::zeroed(),
        quote_count: 0,
        early_policies: Array::zeroed(),
        policy_count: 0,
        kernel_modules: Array::zeroed(),
        module_count: 0,
        trust_anchors: Array::zeroed(),
        anchor_count: 0,
        verification_records: Array::zeroed(),
        verification_count: 0,
        boot_completed: false,
        boot_measurement_log_enabled: true,
        secure_boot_enforced: true,
        policy_early_loaded: false,
    };
}

fn execute_measured_boot(
    state: SecureBootState,
    kernel_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE),
    kernel_signer: u64,
    kernel_sig_valid: bool,
) -> (SecureBootState, bool)
    effect [boot:measure, boot:verify, boot:policy, compute, residual]
{
    let mut updated: SecureBootState = state;

    updated = measure_component(
        updated, BootStage::Stage1BootROM,
        MeasurementType::Firmware, 0,
        Array::splat(0x01), 8192, 0, true,
    );

    updated = measure_component(
        updated, BootStage::Stage2Bootloader,
        MeasurementType::Bootloader, 2,
        Array::splat(0x02), 16384, 1, true,
    );

    updated = measure_component(
        updated, BootStage::Stage4Kernel,
        MeasurementType::KernelImage, 5,
        kernel_hash, 4096, kernel_signer, kernel_sig_valid,
    );

    updated = load_policy_early(updated);

    updated = pcr_lock(updated, 0);
    updated = pcr_lock(updated, 5);

    let (verified_state, chain_ok): (SecureBootState, bool) = verify_boot_chain(updated);
    updated = verified_state;

    if chain_ok {
        updated.boot_completed = true;
    }

    residual emit {
        op: "boot.measured_boot_complete",
        measurements: updated.measurement_count,
        stages_verified: updated.verification_count,
        chain_valid: if chain_ok { 1 } else { 0 },
        boot_completed: if updated.boot_completed { 1 } else { 0 },
    };

    return (updated, chain_ok);
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main() -> SecureBootState
    effect [boot:measure, boot:verify, boot:policy, boot:attest, compute, io:write, residual]
{
    let mut state: SecureBootState = init_secure_boot_state();

    let anchor: TrustAnchor = TrustAnchor{
        anchor_id: 1, name: Str::from("phorensic_root"),
        public_key_hash: Array::splat(0xAB), key_type: 1,
        certificate_issuer: Str::from("PhorensicRootCA"),
        expiry: 0, revoked: false, hardware_bound: true,
    };
    state = add_trust_anchor(state, anchor);

    let kernel_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = Array::splat(0x42);
    let (booted_state, chain_ok): (SecureBootState, bool) = execute_measured_boot(
        state, kernel_hash, 1, true,
    );
    state = booted_state;

    let (quote_state, quote): (SecureBootState, AttestationQuote) = create_attestation_quote(
        state, AttestationType::TPMQuote, 12345, 1,
    );
    state = quote_state;

    let evt_policy: EarlyPolicyRule = EarlyPolicyRule{
        rule_id: 1, name: Str::from("kernel_policy"),
        applies_to_stage: BootStage::Stage4Kernel,
        measurement_type: MeasurementType::KernelImage,
        required_hash: kernel_hash, required_signer: 1,
        allow_alternative: false, critical: true, enabled: true,
    };
    state = add_early_policy_rule(state, evt_policy);

    let (enforced_state, allowed): (SecureBootState, bool) = enforce_early_policy(
        state, BootStage::Stage4Kernel,
        MeasurementType::KernelImage, kernel_hash,
    );
    state = enforced_state;

    let pcr_val: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = get_pcr_value(state, 0);
    assert(pcr_val[0] != 0, "secure_boot: PCR 0 extended");

    let pcr5_val: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = get_pcr_value(state, 5);
    let kernel_hash_match: bool = compare_pcr_values(state, 5, kernel_hash);
    assert(kernel_hash_match, "secure_boot: PCR 5 matches kernel hash");

    let anchor_verified: bool = verify_against_trust_anchor(state, Array::splat(0xAB));
    assert(anchor_verified, "secure_boot: trust anchor verified");

    let anchor_fail: bool = verify_against_trust_anchor(state, Array::splat(0x00));
    assert(!anchor_fail, "secure_boot: unknown key rejected");

    let (verify_state, verify_ok): (SecureBootState, VerificationResult) = verify_boot_stage(
        state, BootStage::Stage4Kernel, Str::from("kernel"),
        kernel_hash, kernel_hash, true, 5,
    );
    state = verify_state;
    assert(verify_ok == VerificationResult::Pass, "secure_boot: kernel verification passes");

    let (verify_state2, verify_fail): (SecureBootState, VerificationResult) = verify_boot_stage(
        state, BootStage::Stage5Initramfs, Str::from("initramfs"),
        Array::splat(0x00), Array::splat(0xFF), false, 6,
    );
    state = verify_state2;
    assert(verify_fail != VerificationResult::Pass, "secure_boot: bad initramfs rejected");

    let (chain_state, chain_valid): (SecureBootState, bool) = verify_boot_chain(state);
    state = chain_state;

    let mod_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = Array::splat(0x42);
    state = measure_kernel_module(state, 1, Str::from("ext4"), mod_hash, 65536, 1, true);
    let (mod_state, mod_ok): (SecureBootState, bool) = verify_kernel_module(state, 1, mod_hash);
    state = mod_state;
    assert(mod_ok, "secure_boot: kernel module verified");

    let (quote2_state, second_quote): (SecureBootState, AttestationQuote) = create_attestation_quote(
        state, AttestationType::TCGLog, 67890, 1,
    );
    state = quote2_state;

    let raw_log: Array(MeasurementLogEntry, MAX_BOOT_EVENT_LOG) = get_measurement_log(state, 0, 10);
    assert(raw_log[0].event_id > 0, "secure_boot: event log available");

    assert(state.measurement_count >= 3, "secure_boot: components measured");
    assert(state.verification_count >= 2, "secure_boot: verification records created");
    assert(chain_ok, "secure_boot: boot chain verified");
    assert(state.boot_completed, "secure_boot: boot completed successfully");

    let additional_pcr: PCRRegister = PCRRegister{
        pcr_index: 15,
        bank: PCRBank::SHA384,
        value: Array::splat(0),
        extended_count: 0,
        reset_value: Array::splat(0),
        locked: false,
    };
    state.pcr_registers[15] = additional_pcr;
    state.pcr_count = 16;

    let late_kernel_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = Array::splat(0x77);
    state = measure_component(
        state, BootStage::Stage6Userspace,
        MeasurementType::Configuration, 11,
        late_kernel_hash, 2048, 2, true,
    );

    let (reverify, _): (SecureBootState, VerificationResult) = verify_boot_stage(
        state, BootStage::Stage6Userspace, Str::from("userspace"),
        late_kernel_hash, late_kernel_hash, true, 11,
    );
    state = reverify;

    let (final_chain, final_valid): (SecureBootState, bool) = verify_boot_chain(state);
    state = final_chain;
    assert(final_valid, "secure_boot: final chain verification");

    let extended_pcr: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = get_pcr_value(state, 11);
    assert(extended_pcr[0] != 0, "secure_boot: PCR 11 extended with userspace");

    let (quote3_state, third_quote): (SecureBootState, AttestationQuote) = create_attestation_quote(
        state, AttestationType::ChallengeResponse, 24680, 2,
    );
    state = quote3_state;
    assert(third_quote.nonce == 24680, "secure_boot: quote nonce matches");

    let quote_verification: bool = verify_attestation_quote(
        third_quote,
        third_quote.pcr_values,
        third_quote.pcr_count,
    );
    assert(quote_verification, "secure_boot: self-verification of quote");

    let module2_hash: Array(u8, MAX_MEASUREMENT_DIGEST_SIZE) = Array::splat(0x99);
    state = measure_kernel_module(state, 2, Str::from("nvme"), module2_hash, 32768, 1, false);
    let (mod2_state, mod2_ok): (SecureBootState, bool) = verify_kernel_module(state, 2, module2_hash);
    state = mod2_state;
    assert(!mod2_ok, "secure_boot: unsigned module rejected");

    let dud_policy: EarlyPolicyRule = EarlyPolicyRule{
        rule_id: 2, name: Str::from("initramfs_policy"),
        applies_to_stage: BootStage::Stage5Initramfs,
        measurement_type: MeasurementType::Initramfs,
        required_hash: Array::splat(0xAA), required_signer: 1,
        allow_alternative: false, critical: true, enabled: true,
    };
    state = add_early_policy_rule(state, dud_policy);

    let (enforced2_state, allowed2): (SecureBootState, bool) = enforce_early_policy(
        state, BootStage::Stage5Initramfs,
        MeasurementType::Initramfs, Array::splat(0xBB),
    );
    state = enforced2_state;
    assert(!allowed2, "secure_boot: early policy rejects bad initramfs");

    let pcr_lock_verify: bool = state.pcr_registers[0].locked;
    assert(pcr_lock_verify, "secure_boot: PCR 0 locked after boot");

    residual emit {
        op: "secure_boot.init_complete",
        pcr_count: state.pcr_count,
        measurements: state.measurement_count,
        events: state.event_count,
        verified: state.verification_count,
        quotes: state.quote_count,
        modules: state.module_count,
        anchors: state.anchor_count,
        boot_ok: if state.boot_completed { 1 } else { 0 },
    };

    return state;
}
