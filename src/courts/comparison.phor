// ============================================================================
// comparison.phor — Comparison Types: Byte-Identical, Structural, Behavioral,
//                   Divergent Classification
// ============================================================================
// Comparison is the core of the forensic court system. It determines the
// relationship between native output and oracle output across multiple
// dimensions: byte-level identity, structural equivalence, behavioral
// equivalence, and divergence classification.
//
// Each comparison produces a detailed diff record with residual evidence.
// ============================================================================

package "phorensic:comparison:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type ComparisonError = enum {
    InputsNotFound = 0x01,
    ComparisonLimitExceeded = 0x02,
    DiffBufferFull = 0x03,
    IncomparableOutputs = 0x04,
    HashMismatchOnInput = 0x05,
    OracleResultMissing = 0x06,
    NativeResultMissing = 0x07,
    ComparisonNotPerformed = 0x08,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Comparison Type Enum
// ============================================================================

type ComparisonType = enum {
    NotCompared = 0x00,
    ByteIdentical = 0x01,
    StructurallyEquivalent = 0x02,
    BehaviorallyEquivalent = 0x03,
    Divergent = 0x04,
}

// ============================================================================
// Divergence Classification
// ============================================================================

type DivergenceClass = enum {
    None = 0x00,
    SemanticDivergence = 0x01,
    OptimizationDivergence = 0x02,
    DialectDivergence = 0x03,
    NondeterministicDivergence = 0x04,
    AcceptableDivergence = 0x05,
    Unclassified = 0xFF,
}

type DivergenceSeverity = enum {
    Acceptable = 0x01,
    Minor = 0x02,
    Significant = 0x03,
    Critical = 0x04,
}

// ============================================================================
// Diff Entry (Byte-Level)
// ============================================================================

type ByteDiffEntry = struct {
    offset: u64,
    native_byte: u8,
    oracle_byte: u8,
}

// ============================================================================
// Structural Diff Entry
// ============================================================================

type StructuralDiffEntry = struct {
    section: FixedString[128],
    native_hash: Hash256,
    oracle_hash: Hash256,
    is_equivalent: bool,
    description: FixedString[256],
}

// ============================================================================
// Behavioral Diff Entry
// ============================================================================

type BehavioralDiffEntry = struct {
    test_case_id: u64,
    native_output_hash: Hash256,
    oracle_output_hash: Hash256,
    native_behavior_hash: Hash256,
    oracle_behavior_hash: Hash256,
    is_equivalent: bool,
    description: FixedString[256],
}

// ============================================================================
// Comparison Report
// ============================================================================

type ComparisonReport = struct {
    comparison_id: u64,
    native_hash: Hash256,
    oracle_hash: Hash256,
    comparison_type: ComparisonType,
    divergence_class: DivergenceClass,
    divergence_severity: DivergenceSeverity,
    total_bytes_compared: u64,
    matching_bytes: u64,
    diverging_bytes: u64,
    divergence_ratio: u64,
    byte_diffs: Array[ByteDiffEntry, 4096],
    byte_diff_count: u64,
    structural_diffs: Array[StructuralDiffEntry, 256],
    structural_diff_count: u64,
    behavioral_diffs: Array[BehavioralDiffEntry, 256],
    behavioral_diff_count: u64,
    max_consecutive_divergence: u64,
    has_nondeterministic_sections: bool,
    verdict: FixedString[32],
    timestamp: u64,
    is_finalized: bool,
}

// ============================================================================
// Create Empty Comparison Report
// ============================================================================

fn create_comparison_report(native_hash: Hash256, oracle_hash: Hash256, comparison_id: u64) -> ComparisonReport
    effects: [compute]
{
    let empty_byte_diffs: Array[ByteDiffEntry, 4096] = Array[ByteDiffEntry, 4096]::zeroed();
    let empty_struct_diffs: Array[StructuralDiffEntry, 256] = Array[StructuralDiffEntry, 256]::zeroed();
    let empty_behavior_diffs: Array[BehavioralDiffEntry, 256] = Array[BehavioralDiffEntry, 256]::zeroed();

    return ComparisonReport {
        comparison_id: comparison_id,
        native_hash: native_hash,
        oracle_hash: oracle_hash,
        comparison_type: ComparisonType::NotCompared,
        divergence_class: DivergenceClass::Unclassified,
        divergence_severity: DivergenceSeverity::Acceptable,
        total_bytes_compared: 0,
        matching_bytes: 0,
        diverging_bytes: 0,
        divergence_ratio: 0,
        byte_diffs: empty_byte_diffs,
        byte_diff_count: 0,
        structural_diffs: empty_struct_diffs,
        structural_diff_count: 0,
        behavioral_diffs: empty_behavior_diffs,
        behavioral_diff_count: 0,
        max_consecutive_divergence: 0,
        has_nondeterministic_sections: false,
        verdict: FixedString[32]::from_literal("pending"),
        timestamp: kernel.tick_count(),
        is_finalized: false,
    };
}

// ============================================================================
// Perform Byte-Identical Comparison
// ============================================================================
// Compares two byte sequences for exact identity.

fn compare_byte_identical(native_data: &Array[u8, 1048576], native_len: u64, oracle_data: &Array[u8, 1048576], oracle_len: u64, report: &mut ComparisonReport) -> Result[ComparisonType, ComparisonError]
    effects: [compute, residual]
{
    if native_len == 0 || oracle_len == 0 {
        return Err(ComparisonError::InputsNotFound);
    }

    report.total_bytes_compared = if native_len < oracle_len { native_len } else { oracle_len };
    let min_len: u64 = report.total_bytes_compared;

    let mut matching: u64 = 0;
    let mut diverging: u64 = 0;
    let mut consecutive: u64 = 0;
    let mut max_consecutive: u64 = 0;
    let mut diff_write_idx: u64 = 0;

    for i in 0..min_len {
        if native_data[i] == oracle_data[i] {
            matching = matching + 1;
            consecutive = 0;
        } else {
            diverging = diverging + 1;
            consecutive = consecutive + 1;
            if consecutive > max_consecutive {
                max_consecutive = consecutive;
            }

            if diff_write_idx < 4096 {
                report.byte_diffs[diff_write_idx] = ByteDiffEntry {
                    offset: i,
                    native_byte: native_data[i],
                    oracle_byte: oracle_data[i],
                };
                diff_write_idx = diff_write_idx + 1;
            }
        }
    }

    report.matching_bytes = matching;
    report.diverging_bytes = diverging;
    report.byte_diff_count = diff_write_idx;
    report.max_consecutive_divergence = max_consecutive;

    if report.total_bytes_compared > 0 {
        report.divergence_ratio = (diverging * 100) / report.total_bytes_compared;
    }

    // Determine comparison type
    if diverging == 0 && native_len == oracle_len {
        report.comparison_type = ComparisonType::ByteIdentical;
        report.divergence_class = DivergenceClass::None;
        report.divergence_severity = DivergenceSeverity::Acceptable;
        report.verdict = FixedString[32]::from_literal("identical");
    } elif report.divergence_ratio < 5 && max_consecutive < 16 {
        report.comparison_type = ComparisonType::StructurallyEquivalent;
        report.divergence_class = DivergenceClass::AcceptableDivergence;
        report.divergence_severity = DivergenceSeverity::Minor;
        report.verdict = FixedString[32]::from_literal("equivalent");
    } else {
        // Will be refined by structural/behavioral analysis
        report.comparison_type = ComparisonType::Divergent;
        report.divergence_class = DivergenceClass::Unclassified;
        report.divergence_severity = DivergenceSeverity::Significant;
        report.verdict = FixedString[32]::from_literal("divergent");
    }

    @emit_residual("comparison.byte_identical", "byte_comparison_complete", matching);

    return Ok(report.comparison_type);
}

// ============================================================================
// Perform Structural Comparison
// ============================================================================
// Divides both outputs into sections and compares section-by-section.

fn compare_structural(native_data: &Array[u8, 1048576], native_len: u64, oracle_data: &Array[u8, 1048576], oracle_len: u64, section_count: u64, report: &mut ComparisonReport) -> Result[u64, ComparisonError]
    effects: [compute, residual]
{
    let min_len: u64 = if native_len < oracle_len { native_len } else { oracle_len };
    let section_size: u64 = if section_count > 0 { min_len / section_count } else { min_len };
    let actual_sections: u64 = if section_size > 0 { section_count } else { 1 };

    let mut equivalent_count: u64 = 0;

    for s in 0..actual_sections {
        let start: u64 = s * section_size;
        let end: u64 = if s == actual_sections - 1 { min_len } else { (s + 1) * section_size };
        let sec_len: u64 = end - start;

        // Compute section hashes
        let mut native_sec_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
        let mut oracle_sec_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

        for i in start..end {
            let idx: u64 = (i - start) & 31;
            native_sec_hash.bytes[idx] = native_sec_hash.bytes[idx] ^ native_data[i];
            oracle_sec_hash.bytes[idx] = oracle_sec_hash.bytes[idx] ^ oracle_data[i];
        }

        let is_equiv: bool = native_sec_hash == oracle_sec_hash;

        if s < 256 {
            report.structural_diffs[report.structural_diff_count] = StructuralDiffEntry {
                section: FixedString[128]::from_literal("section"),
                native_hash: native_sec_hash,
                oracle_hash: oracle_sec_hash,
                is_equivalent: is_equiv,
                description: FixedString[256]::zeroed(),
            };
            report.structural_diff_count = report.structural_diff_count + 1;
        }

        if is_equiv {
            equivalent_count = equivalent_count + 1;
        }
    }

    // Check if structurally equivalent
    if equivalent_count == actual_sections {
        // All sections match — structurally equivalent
        if report.comparison_type == ComparisonType::Divergent {
            report.comparison_type = ComparisonType::StructurallyEquivalent;
            report.divergence_class = DivergenceClass::AcceptableDivergence;
            report.divergence_severity = DivergenceSeverity::Minor;
            report.verdict = FixedString[32]::from_literal("equivalent");
        }
    }

    @emit_residual("comparison.structural", "structural_comparison_complete", equivalent_count);

    return Ok(equivalent_count);
}

// ============================================================================
// Perform Behavioral Comparison
// ============================================================================
// Compares the observable behavior of two outputs for a set of test cases.

fn compare_behavioral(report: &mut ComparisonReport, test_cases: &Array[(Hash256, Hash256), 256], test_case_count: u64, native_behavior: &Array[Hash256, 256], oracle_behavior: &Array[Hash256, 256]) -> Result<u64, ComparisonError>
    effects: [compute, residual]
{
    let mut equivalent_count: u64 = 0;

    for i in 0..test_case_count {
        let (native_out, oracle_out): (Hash256, Hash256) = test_cases[i];
        let native_beh: Hash256 = native_behavior[i];
        let oracle_beh: Hash256 = oracle_behavior[i];

        let output_match: bool = native_out == oracle_out;
        let behavior_match: bool = native_beh == oracle_beh;
        let is_equivalent: bool = output_match && behavior_match;

        if i < 256 {
            report.behavioral_diffs[report.behavioral_diff_count] = BehavioralDiffEntry {
                test_case_id: i,
                native_output_hash: native_out,
                oracle_output_hash: oracle_out,
                native_behavior_hash: native_beh,
                oracle_behavior_hash: oracle_beh,
                is_equivalent: is_equivalent,
                description: FixedString[256]::zeroed(),
            };
            report.behavioral_diff_count = report.behavioral_diff_count + 1;
        }

        if is_equivalent {
            equivalent_count = equivalent_count + 1;
        }
    }

    // Determine if behaviorally equivalent
    if equivalent_count == test_case_count && test_case_count > 0 {
        if report.comparison_type <= ComparisonType::NotCompared ||
           report.comparison_type == ComparisonType::Divergent {
            report.comparison_type = ComparisonType::BehaviorallyEquivalent;
            report.divergence_class = DivergenceClass::AcceptableDivergence;
            report.divergence_severity = DivergenceSeverity::Acceptable;
            report.verdict = FixedString[32]::from_literal("behaviorally_equivalent");
        }
    }

    @emit_residual("comparison.behavioral", "behavioral_comparison_complete", equivalent_count);

    return Ok(equivalent_count);
}

// ============================================================================
// Classify Divergence
// ============================================================================
// Analyzes divergence patterns to determine the divergence class.

fn classify_divergence(report: &mut ComparisonReport, has_nondeterministic_patterns: bool, has_dialect_specific_patterns: bool, has_optimization_patterns: bool) -> DivergenceClass
    effects: [compute, residual]
{
    if report.diverging_bytes == 0 {
        report.divergence_class = DivergenceClass::None;
        return DivergenceClass::None;
    }

    // Check for nondeterministic divergence
    if has_nondeterministic_patterns {
        report.divergence_class = DivergenceClass::NondeterministicDivergence;
        report.divergence_severity = DivergenceSeverity::Significant;
        report.has_nondeterministic_sections = true;
        report.verdict = FixedString[32]::from_literal("nondeterministic");

        @emit_residual("comparison.classify", "classified_nondeterministic", report.diverging_bytes);
        return DivergenceClass::NondeterministicDivergence;
    }

    // Check for dialect-specific divergence
    if has_dialect_specific_patterns {
        report.divergence_class = DivergenceClass::DialectDivergence;
        report.divergence_severity = DivergenceSeverity::Minor;
        report.verdict = FixedString[32]::from_literal("dialect_divergent");

        @emit_residual("comparison.classify", "classified_dialect", report.diverging_bytes);
        return DivergenceClass::DialectDivergence;
    }

    // Check for optimization divergence
    if has_optimization_patterns {
        report.divergence_class = DivergenceClass::OptimizationDivergence;
        report.divergence_severity = DivergenceSeverity::Acceptable;
        report.verdict = FixedString[32]::from_literal("optimization_divergent");

        @emit_residual("comparison.classify", "classified_optimization", report.diverging_bytes);
        return DivergenceClass::OptimizationDivergence;
    }

    // Default to semantic divergence if ratio is high
    if report.divergence_ratio >= 20 {
        report.divergence_class = DivergenceClass::SemanticDivergence;
        report.divergence_severity = DivergenceSeverity::Critical;
        report.verdict = FixedString[32]::from_literal("semantic_divergent");

        @emit_residual("comparison.classify", "classified_semantic", report.diverging_bytes);
        return DivergenceClass::SemanticDivergence;
    }

    // Acceptable divergence (low ratio, scattered)
    report.divergence_class = DivergenceClass::AcceptableDivergence;
    report.divergence_severity = DivergenceSeverity::Acceptable;
    report.verdict = FixedString[32]::from_literal("acceptable_divergence");

    @emit_residual("comparison.classify", "classified_acceptable", report.diverging_bytes);

    return DivergenceClass::AcceptableDivergence;
}

// ============================================================================
// Finalize Comparison Report
// ============================================================================

fn finalize_comparison_report(report: &mut ComparisonReport) -> Result[ComparisonType, ComparisonError]
    effects: [compute, residual]
{
    if report.is_finalized {
        return Ok(report.comparison_type);
    }

    report.is_finalized = true;

    @emit_residual("comparison.finalize", "report_finalized", report.comparison_id);

    return Ok(report.comparison_type);
}

// ============================================================================
// Merge Comparison Reports
// ============================================================================
// Merges multiple comparison reports into an aggregate result.

type AggregateComparison = struct {
    total_comparisons: u64,
    byte_identical_count: u64,
    structurally_equivalent_count: u64,
    behaviorally_equivalent_count: u64,
    divergent_count: u64,
    worst_comparison_type: ComparisonType,
    divergence_breakdown: Array[(DivergenceClass, u64), 8],
    breakdown_count: u64,
    all_match: bool,
}

fn merge_comparisons(reports: &Array[ComparisonReport, 256], count: u64) -> AggregateComparison
    effects: [compute]
{
    let mut identical: u64 = 0;
    let mut structural: u64 = 0;
    let mut behavioral: u64 = 0;
    let mut divergent: u64 = 0;
    let mut worst: ComparisonType = ComparisonType::ByteIdentical;
    let mut all_match: bool = true;

    let mut div_breakdown: Array[(DivergenceClass, u64), 8] = Array[(DivergenceClass, u64), 8]::zeroed();
    let mut breakdown_count: u64 = 0;

    for i in 0..count {
        match reports[i].comparison_type {
            ComparisonType::ByteIdentical => identical = identical + 1,
            ComparisonType::StructurallyEquivalent => structural = structural + 1,
            ComparisonType::BehaviorallyEquivalent => behavioral = behavioral + 1,
            ComparisonType::Divergent => divergent = divergent + 1,
            ComparisonType::NotCompared => {}
        }

        if reports[i].comparison_type as u64 > worst as u64 {
            worst = reports[i].comparison_type;
        }

        if reports[i].comparison_type != ComparisonType::ByteIdentical {
            all_match = false;
        }

        // Track divergence classes
        if reports[i].divergence_class != DivergenceClass::None {
            let mut found: bool = false;
            for b in 0..breakdown_count {
                let (cls, count_val): (DivergenceClass, u64) = div_breakdown[b];
                if cls == reports[i].divergence_class {
                    div_breakdown[b] = (cls, count_val + 1);
                    found = true;
                    break;
                }
            }
            if !found && breakdown_count < 8 {
                div_breakdown[breakdown_count] = (reports[i].divergence_class, 1);
                breakdown_count = breakdown_count + 1;
            }
        }
    }

    return AggregateComparison {
        total_comparisons: count,
        byte_identical_count: identical,
        structurally_equivalent_count: structural,
        behaviorally_equivalent_count: behavioral,
        divergent_count: divergent,
        worst_comparison_type: worst,
        divergence_breakdown: div_breakdown,
        breakdown_count: breakdown_count,
        all_match: all_match,
    };
}

// ============================================================================
// Get Comparison Summary
// ============================================================================

type ComparisonSummary = struct {
    comparison_id: u64,
    comparison_type: ComparisonType,
    divergence_class: DivergenceClass,
    divergence_severity: DivergenceSeverity,
    total_bytes: u64,
    matching_bytes: u64,
    diverging_bytes: u64,
    divergence_ratio: u64,
    byte_diff_count: u64,
    structural_diff_count: u64,
    behavioral_diff_count: u64,
    verdict: FixedString[32],
    is_finalized: bool,
}

fn get_comparison_summary(report: &ComparisonReport) -> ComparisonSummary
    effects: [compute]
{
    return ComparisonSummary {
        comparison_id: report.comparison_id,
        comparison_type: report.comparison_type,
        divergence_class: report.divergence_class,
        divergence_severity: report.divergence_severity,
        total_bytes: report.total_bytes_compared,
        matching_bytes: report.matching_bytes,
        diverging_bytes: report.diverging_bytes,
        divergence_ratio: report.divergence_ratio,
        byte_diff_count: report.byte_diff_count,
        structural_diff_count: report.structural_diff_count,
        behavioral_diff_count: report.behavioral_diff_count,
        verdict: report.verdict,
        is_finalized: report.is_finalized,
    };
}

// ============================================================================
// Hash Chain Comparison
// ============================================================================
// Compares two hash chains to verify that a sequence of operations
// produced identical hashes at each step.

type HashChainComparison = struct {
    chain_a_length: u64,
    chain_b_length: u64,
    matching_prefix: u64,
    first_divergence_index: u64,
    first_divergence_a: Hash256,
    first_divergence_b: Hash256,
    chains_match: bool,
}

fn compare_hash_chains(chain_a: &Array[Hash256, 512], len_a: u64, chain_b: &Array[Hash256, 512], len_b: u64) -> HashChainComparison
    effects: [compute]
{
    let min_len: u64 = if len_a < len_b { len_a } else { len_b };
    let mut matching: u64 = 0;
    let mut first_div_idx: u64 = 0;
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut first_div_a: Hash256 = zero_hash;
    let mut first_div_b: Hash256 = zero_hash;
    let mut chains_match: bool = true;

    for i in 0..min_len {
        if chain_a[i] == chain_b[i] {
            matching = matching + 1;
        } else {
            if chains_match {
                first_div_idx = i;
                first_div_a = chain_a[i];
                first_div_b = chain_b[i];
                chains_match = false;
            }
        }
    }

    if len_a != len_b {
        chains_match = false;
    }

    return HashChainComparison {
        chain_a_length: len_a,
        chain_b_length: len_b,
        matching_prefix: matching,
        first_divergence_index: first_div_idx,
        first_divergence_a: first_div_a,
        first_divergence_b: first_div_b,
        chains_match: chains_match,
    };
}

// ============================================================================
// Semantic Difference Classifier
// ============================================================================
// Classifies the semantic meaning of byte-level differences.

type SemanticDiffCategory = enum {
    TimestampDifference = 0x01,
    AddressDifference = 0x02,
    MemoryLayoutDifference = 0x03,
    InstructionReorder = 0x04,
    RegisterAllocation = 0x05,
    PaddingDifference = 0x06,
    SectionOrderDifference = 0x07,
    SymbolNameDifference = 0x08,
    DebugInfoDifference = 0x09,
    ActualSemanticDifference = 0x0A,
    Unclassified = 0xFF,
}

type SemanticDiffEntry = struct {
    offset: u64,
    native_value: u8,
    oracle_value: u8,
    category: SemanticDiffCategory,
    confidence: u64,
    description: FixedString[256],
}

fn classify_semantic_diff(report: &ComparisonReport) -> Result[Array[SemanticDiffEntry, 256], ComparisonError]
    effects: [compute]
{
    let mut results: Array[SemanticDiffEntry, 256] = Array[SemanticDiffEntry, 256]::zeroed();
    let mut count: u64 = 0;

    for i in 0..report.byte_diff_count {
        if count >= 256 {
            break;
        }
        let diff: ByteDiffEntry = report.byte_diffs[i];
        let mut category: SemanticDiffCategory = SemanticDiffCategory::Unclassified;
        let mut confidence: u64 = 30;

        if diff.offset % 8 == 7 || diff.offset % 8 == 3 {
            category = SemanticDiffCategory::PaddingDifference;
            confidence = 60;
        } elif diff.offset < 64 {
            category = SemanticDiffCategory::MemoryLayoutDifference;
            confidence = 50;
        } elif diff.native_byte >= 0x20 && diff.native_byte <= 0x7E &&
                 diff.oracle_byte >= 0x20 && diff.oracle_byte <= 0x7E {
            category = SemanticDiffCategory::SymbolNameDifference;
            confidence = 40;
        } else {
            category = SemanticDiffCategory::ActualSemanticDifference;
            confidence = 80;
        }

        results[count] = SemanticDiffEntry {
            offset: diff.offset,
            native_value: diff.native_byte,
            oracle_value: diff.oracle_byte,
            category: category,
            confidence: confidence,
            description: FixedString[256]::from_literal("Classified diff entry"),
        };
        count = count + 1;
    }
    return Ok(results);
}

// ============================================================================
// Compute Comparison Confidence Score
// ============================================================================

fn compute_comparison_confidence(report: &ComparisonReport) -> u64
    effects: [compute]
{
    match report.comparison_type {
        ComparisonType::ByteIdentical => return 100,
        ComparisonType::StructurallyEquivalent => {
            if report.structural_diff_count == 0 { return 90; }
            return 85;
        }
        ComparisonType::BehaviorallyEquivalent => {
            if report.behavioral_diff_count == 0 { return 80; }
            return 70;
        }
        ComparisonType::Divergent => {
            if report.divergence_ratio < 5 { return 40; }
            if report.divergence_ratio < 20 { return 20; }
            return 5;
        }
        ComparisonType::NotCompared => return 0,
    }
}

// ============================================================================
// Suggest Remediation for Divergence
// ============================================================================

type RemediationSuggestion = struct {
    divergence_class: DivergenceClass,
    severity: DivergenceSeverity,
    suggestion: FixedString[512],
    estimated_effort: FixedString[64],
}

fn suggest_remediation(report: &ComparisonReport) -> RemediationSuggestion
    effects: [compute]
{
    let sug: FixedString[512];
    let effort: FixedString[64];

    match report.divergence_class {
        DivergenceClass::SemanticDivergence => {
            sug = FixedString[512]::from_literal("Investigate semantic differences: review algorithm implementation");
            effort = FixedString[64]::from_literal("high");
        }
        DivergenceClass::OptimizationDivergence => {
            sug = FixedString[512]::from_literal("Adjust optimization flags or verify semantics unaffected");
            effort = FixedString[64]::from_literal("medium");
        }
        DivergenceClass::DialectDivergence => {
            sug = FixedString[512]::from_literal("Update dialect profile to match oracle assumptions");
            effort = FixedString[64]::from_literal("medium");
        }
        DivergenceClass::NondeterministicDivergence => {
            sug = FixedString[512]::from_literal("Seed RNG and disable ASLR for deterministic comparison");
            effort = FixedString[64]::from_literal("low");
        }
        DivergenceClass::AcceptableDivergence => {
            sug = FixedString[512]::from_literal("Document acceptable divergence in court evidence");
            effort = FixedString[64]::from_literal("low");
        }
        DivergenceClass::None => {
            sug = FixedString[512]::from_literal("No remediation needed");
            effort = FixedString[64]::from_literal("none");
        }
        DivergenceClass::Unclassified => {
            sug = FixedString[512]::from_literal("Classify divergence before proceeding");
            effort = FixedString[64]::from_literal("unknown");
        }
    }

    return RemediationSuggestion {
        divergence_class: report.divergence_class,
        severity: report.divergence_severity,
        suggestion: sug,
        estimated_effort: effort,
    };
}

// ============================================================================
// Pattern-Based Diff Analysis
// ============================================================================
// Analyzes diff entries to detect patterns (e.g., all diffs are in
// certain byte ranges, suggesting root cause).

type DiffPattern = struct {
    pattern_name: FixedString[128],
    matched_entry_count: u64,
    byte_range_start: u64,
    byte_range_end: u64,
    confidence: u64,
    description: FixedString[256],
}

fn analyze_diff_patterns(report: &ComparisonReport) -> Array[DiffPattern, 16]
    effects: [compute]
{
    let mut patterns: Array[DiffPattern, 16] = Array[DiffPattern, 16]::zeroed();
    let mut pattern_count: u64 = 0;

    if report.byte_diff_count == 0 {
        return patterns;
    }

    // Pattern 1: Check if all diffs are at aligned offsets
    let mut aligned_count: u64 = 0;
    for i in 0..report.byte_diff_count {
        if report.byte_diffs[i].offset % 8 == 0 {
            aligned_count = aligned_count + 1;
        }
    }
    if aligned_count == report.byte_diff_count && pattern_count < 16 {
        patterns[pattern_count] = DiffPattern {
            pattern_name: FixedString[128]::from_literal("aligned_differences"),
            matched_entry_count: aligned_count,
            byte_range_start: 0,
            byte_range_end: 0,
            confidence: 70,
            description: FixedString[256]::from_literal("All differences are at 8-byte aligned offsets"),
        };
        pattern_count = pattern_count + 1;
    }

    // Pattern 2: Check if diffs cluster in a range
    if report.byte_diff_count > 1 {
        let first: u64 = report.byte_diffs[0].offset;
        let last: u64 = report.byte_diffs[report.byte_diff_count - 1].offset;
        let range: u64 = last - first;
        if range < 256 && pattern_count < 16 {
            patterns[pattern_count] = DiffPattern {
                pattern_name: FixedString[128]::from_literal("clustered_differences"),
                matched_entry_count: report.byte_diff_count,
                byte_range_start: first,
                byte_range_end: last,
                confidence: 60,
                description: FixedString[256]::from_literal("Differences cluster in a small byte range"),
            };
            pattern_count = pattern_count + 1;
        }
    }

    // Pattern 3: Check for alternating byte patterns
    let mut alternating: bool = true;
    for i in 2..report.byte_diff_count {
        let d0: u64 = report.byte_diffs[i].offset - report.byte_diffs[i - 1].offset;
        let d1: u64 = report.byte_diffs[i - 1].offset - report.byte_diffs[i - 2].offset;
        if d0 != d1 {
            alternating = false;
            break;
        }
    }
    if alternating && report.byte_diff_count >= 3 && pattern_count < 16 {
        patterns[pattern_count] = DiffPattern {
            pattern_name: FixedString[128]::from_literal("regular_pattern"),
            matched_entry_count: report.byte_diff_count,
            byte_range_start: report.byte_diffs[0].offset,
            byte_range_end: report.byte_diffs[report.byte_diff_count - 1].offset,
            confidence: 55,
            description: FixedString[256]::from_literal("Differences follow a regular offset pattern"),
        };
        pattern_count = pattern_count + 1;
    }

    return patterns;
}
