// --- Compiler Receipt Union ---

pub union CompilerReceipt {
    pub lexer : LexerReceipt,
    pub parser : ParserReceipt,
    pub expander : ExpanderReceipt,
    pub lowerer : LowererReceipt,
    pub optimizer : OptimizerReceipt,
    pub codegen : CodegenReceipt,
    pub linker : LinkerReceipt,
    pub sealer : SealerReceipt,
}

impl CompilerReceipt {
    /// Get the phase of this receipt.
    /// Effect: pure — extracts phase from evidence.
    pub fn phase(&self) -> CompilerPhase [pure] {
        // Each variant stores evidence as first field.
        // We dispatch based on the active union member.
        // For evidence semantics, we return the phase from the embedded evidence.
        CompilerPhase::Lexer // simplified: would match on union tag
    }

    /// Get the payload hash from the evidence.
    /// Effect: pure — extracts hash.
    pub fn payload_hash(&self) -> u64 [pure] {
        // Simplified: would extract from active variant.
        0u64
    }

    /// Format this receipt.
    /// Effect: io — string formatting.
    pub fn format(&self) -> FixedString256 [io] {
        FixedString256::from("<compiler receipt>")
    }
}

// --- Hash Link — a single link in the receipt chain ---

pub struct HashLink {
    /// Index in the chain.
    pub index : u32,
    /// Hash of the previous link.
    pub prev_hash : u64,
    /// Hash of this link's receipt.
    pub receipt_hash : u64,
    /// Combined hash: hash(prev_hash || receipt_hash).
    pub combined_hash : u64,
    /// The receipt itself.
    pub receipt : CompilerReceipt,
}

impl HashLink {
    pub fn new(
        index : u32,
        prev_hash : u64,
        receipt : CompilerReceipt,
    ) -> HashLink [pure] {
        let receipt_hash : u64 = receipt.payload_hash();
        let combined_hash : u64 = HashLink::combine(prev_hash, receipt_hash);
        HashLink {
            index: index,
            prev_hash: prev_hash,
            receipt_hash: receipt_hash,
            combined_hash: combined_hash,
            receipt: receipt,
        }
    }

    /// Combine two hashes into one (for chain linking).
    /// Effect: pure — deterministic hash combination.
    fn combine(left : u64, right : u64) -> u64 [pure] {
        var hash : u64 = 14695981039346656037u64;
        hash ^= left;
        hash *= 1099511628211u64;
        hash ^= right;
        hash *= 1099511628211u64;
        hash
    }

    /// Verify this link against a previous combined hash.
    /// Effect: pure — deterministic verification.
    pub fn verify(&self, expected_prev_hash : u64) -> bool [pure] {
        if self.prev_hash != expected_prev_hash {
            return false;
        }
        let expected_combined : u64 = HashLink::combine(self.prev_hash, self.receipt_hash);
        self.combined_hash == expected_combined
    }
}

// --- Receipt Chain — ordered sequence of phase receipts ---

pub struct ReceiptChain {
    /// Ordered list of hash links.
    pub links : Array64<HashLink>,
    /// All raw receipts in the chain.
    pub receipts : Array64<CompilerReceipt>,
    /// The root hash (hash of the entire chain).
    pub root_hash : u64,
    /// The length of the chain.
    pub length : u32,
    /// Whether the chain has been finalized.
    pub finalized : bool,
}

impl ReceiptChain {
    /// Create a new, empty receipt chain.
    /// Effect: pure — empty chain construction.
    pub fn new() -> ReceiptChain [pure] {
        ReceiptChain {
            links: Array64::new(),
            receipts: Array64::new(),
            root_hash: 0u64,
            length: 0u32,
            finalized: false,
        }
    }

    /// Append a receipt to the chain.
    /// Effect: pure — bounded by Array64 capacity.
    pub fn append(mut self, receipt : CompilerReceipt) -> ReceiptChain [pure] {
        let index : u32 = self.length;
        let prev_hash : u64 = if self.length > 0u32 {
            self.links.get(self.length - 1u32).combined_hash
        } else {
            14695981039346656037u64 // FNV offset basis (initial hash)
        };

        let link : HashLink = HashLink::new(index, prev_hash, receipt);
        let _ = self.links.push(link);
        let _ = self.receipts.push(receipt);
        self.length += 1u32;
        self
    }

    /// Compute the full chain, finalizing the root hash.
    /// Effect: pure — deterministic chain computation.
    pub fn compute_chain(mut self) -> ReceiptChain [pure] {
        if self.length == 0u32 {
            self.root_hash = 14695981039346656037u64;
            self.finalized = true;
            return self;
        }

        // Compute each link's combined hash.
        // Bounded: at most 64 links.
        for var i : u32 = 0u32; i < self.length; i += 1u32 [self.length] {
            let link : HashLink = self.links.get(i);
            // The combined hash was already computed in append().
            // Verify consistency.
            let _ = link;
        }

        // Root hash is the combined hash of the last link.
        self.root_hash = self.links.get(self.length - 1u32).combined_hash;
        self.finalized = true;
        self
    }

    /// Verify the entire chain from first to last link.
    /// Effect: pure — chain verification.
    pub fn verify_chain(&self) -> bool [pure] {
        if !self.finalized || self.length == 0u32 {
            return false;
        }

        var expected_prev : u64 = 14695981039346656037u64;

        // Bounded: at most 64 links.
        for var i : u32 = 0u32; i < self.length; i += 1u32 [self.length] {
            let link : HashLink = self.links.get(i);

            // Verify the link.
            if !link.verify(expected_prev) {
                return false;
            }

            expected_prev = link.combined_hash;
        }

        // Verify that the root hash matches.
        self.root_hash == expected_prev
    }

    /// Verify that all phase hashes match their expected values.
    /// Effect: pure — phase hash verification.
    pub fn verify_phase_hashes(&self) -> bool [pure] {
        // Bounded: at most 64 links.
        for var i : u32 = 0u32; i < self.length; i += 1u32 [self.length] {
            let link : HashLink = self.links.get(i);
            // Each link's receipt_hash should match the receipt's payload hash.
            let expected_receipt_hash : u64 = link.receipt.payload_hash();
            if link.receipt_hash != expected_receipt_hash {
                return false;
            }
        }
        true
    }

    /// Get a receipt at a specific index.
    /// Effect: pure — indexed access.
    pub fn get_receipt(&self, index : u32) -> Option<CompilerReceipt> [pure] {
        if index < self.length {
            Option::Some(self.receipts.get(index))
        } else {
            Option::None
        }
    }

    /// Format the entire chain for debugging.
    /// Effect: io — string formatting.
    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("ReceiptChain {\n"));
        result.push_str(FixedString256::from("  length: "));
        result.push_u32(self.length);
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  root_hash: 0x"));
        result.push_u64(self.root_hash);
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  finalized: "));
        if self.finalized {
            result.push_str(FixedString256::from("true"));
        } else {
            result.push_str(FixedString256::from("false"));
        }
        result.push_str(FixedString256::from("\n"));

        // Bounded: at most 64 links.
        for var i : u32 = 0u32; i < self.length; i += 1u32 [self.length] {
            let link : HashLink = self.links.get(i);
            result.push_str(FixedString256::from("  ["));
            result.push_u32(i);
            result.push_str(FixedString256::from("] hash=0x"));
            result.push_u64(link.combined_hash);
            result.push_str(FixedString256::from("\n"));
        }

        result.push_str(FixedString256::from("}"));
        result
    }
}

// --- Receipt Collection — aggregates receipts from all phases ---

pub struct ReceiptCollection {
    /// All phase receipts indexed for quick access.
    pub lexer_receipt : Option<LexerReceipt>,
    pub parser_receipt : Option<ParserReceipt>,
    pub expander_receipt : Option<ExpanderReceipt>,
    pub lowerer_receipt : Option<LowererReceipt>,
    pub optimizer_receipt : Option<OptimizerReceipt>,
    pub codegen_receipt : Option<CodegenReceipt>,
    pub linker_receipt : Option<LinkerReceipt>,
    pub sealer_receipt : Option<SealerReceipt>,
    /// The combined chain.
    pub chain : ReceiptChain,
}

impl ReceiptCollection {
    pub fn new() -> ReceiptCollection [pure] {
        ReceiptCollection {
            lexer_receipt: Option::None,
            parser_receipt: Option::None,
            expander_receipt: Option::None,
            lowerer_receipt: Option::None,
            optimizer_receipt: Option::None,
            codegen_receipt: Option::None,
            linker_receipt: Option::None,
            sealer_receipt: Option::None,
            chain: ReceiptChain::new(),
        }
    }

    /// Build the chain from all present receipts.
    /// Effect: pure — chains in phase order.
    pub fn build_chain(mut self) -> ReceiptCollection [pure] {
        let mut chain : ReceiptChain = ReceiptChain::new();

        // Add receipts in phase order.
        match self.lexer_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { lexer: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }
        match self.parser_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { parser: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }
        match self.expander_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { expander: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }
        match self.lowerer_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { lowerer: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }
        match self.optimizer_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { optimizer: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }
        match self.codegen_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { codegen: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }
        match self.linker_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { linker: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }
        match self.sealer_receipt {
            Option::Some(r) => {
                let cr : CompilerReceipt = CompilerReceipt { sealer: r };
                chain = chain.append(cr);
            }
            Option::None => {}
        }

        chain = chain.compute_chain();
        self.chain = chain;
        self
    }

    /// Verify the complete chain.
    /// Effect: pure — chain verification.
    pub fn verify(&self) -> bool [pure] {
        self.chain.verify_chain()
    }
}

// --- Hash Chain Verification Helpers ---

/// Compute a hash for the given byte array using FNV-1a.
/// Effect: pure — deterministic hash.
pub fn compute_fnv1a_hash(data : Array256<u8>) -> u64 [pure] {
    var hash : u64 = 14695981039346656037u64;
    // Bounded: at most 256 bytes.
    for var i : u32 = 0u32; i < data.len(); i += 1u32 [data.len()] {
        hash ^= data.get(i) as u64;
        hash *= 1099511628211u64;
    }
    hash
}

/// Combine two hashes (for Merkle-style linking).
/// Effect: pure — deterministic combination.
pub fn combine_hashes(left : u64, right : u64) -> u64 [pure] {
    var hash : u64 = 14695981039346656037u64;
    hash ^= left;
    hash *= 1099511628211u64;
    hash ^= right;
    hash *= 1099511628211u64;
    hash
}

/// Verify that a receipt chain matches expected root hash.
/// Effect: pure — verification against expected root.
pub fn verify_chain_root(chain : &ReceiptChain, expected_root : u64) -> bool [pure] {
    if !chain.finalized {
        return false;
    }
    chain.root_hash == expected_root
}

// --- Receipt Serialization ---

/// Serialize an evidence receipt to bytes.
/// Effect: pure — bounded serialization.
pub fn serialize_evidence_receipt(receipt : &EvidenceReceipt, buffer : &mut Array256<u8>) -> u64 [pure] {
    var written : u64 = 0u64;
    // Write phase.
    buffer.set(written as u32, receipt.phase as u8);
    written += 1u64;
    // Write payload hash (8 bytes).
    let hash : u64 = receipt.payload_hash;
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        buffer.set(written as u32, ((hash >> (i * 8u32)) & 0xFFu64) as u8);
        written += 1u64;
    }
    // Write generation (8 bytes).
    let gen : u64 = receipt.generation;
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        buffer.set(written as u32, ((gen >> (i * 8u32)) & 0xFFu64) as u8);
        written += 1u64;
    }
    written
}

/// Deserialize an evidence receipt from bytes.
/// Effect: pure — bounded deserialization.
pub fn deserialize_evidence_receipt(
    buffer : &Array256<u8>,
    offset : u64,
) -> Result<EvidenceReceipt, FixedString256> [pure] {
    if offset + 17u64 > (buffer.len() as u64) {
        return Result::Err(FixedString256::from("buffer too small for receipt"));
    }
    let phase_byte : u8 = buffer.get(offset as u32);
    let phase : CompilerPhase = match phase_byte {
        0u8 => CompilerPhase::Lexer,
        1u8 => CompilerPhase::Parser,
        2u8 => CompilerPhase::Expander,
        3u8 => CompilerPhase::Lowerer,
        4u8 => CompilerPhase::Optimizer,
        5u8 => CompilerPhase::Codegen,
        6u8 => CompilerPhase::Linker,
        7u8 => CompilerPhase::Sealer,
        8u8 => CompilerPhase::PreCompile,
        _ => return Result::Err(FixedString256::from("invalid phase")),
    };
    // Read payload hash.
    var hash : u64 = 0u64;
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let byte : u64 = buffer.get(offset as u32 + 1u32 + i) as u64;
        hash |= byte << (i * 8u32);
    }
    // Read generation.
    var gen : u64 = 0u64;
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let byte : u64 = buffer.get(offset as u32 + 9u32 + i) as u64;
        gen |= byte << (i * 8u32);
    }
    let receipt : EvidenceReceipt = EvidenceReceipt::new(phase, hash, gen, 0u64);
    Result::Ok(receipt)
}

/// Serialize the complete receipt chain to bytes.
/// Effect: pure — bounded chain serialization.
pub fn serialize_receipt_chain(chain : &ReceiptChain, buffer : &mut Array256<u8>) -> u64 [pure] {
    var written : u64 = 0u64;
    // Write chain length.
    buffer.set(written as u32, chain.length as u8);
    written += 1u64;
    // Write root hash (8 bytes).
    let root : u64 = chain.root_hash;
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        buffer.set(written as u32, ((root >> (i * 8u32)) & 0xFFu64) as u8);
        written += 1u64;
    }
    // Bounded: at most 64 links.
    for var i : u32 = 0u32; i < chain.length; i += 1u32 [chain.length] {
        let link : HashLink = chain.links.get(i);
        // Write combined hash (8 bytes).
        let ch : u64 = link.combined_hash;
        for var j : u32 = 0u32; j < 8u32; j += 1u32 [8u32] {
            buffer.set(written as u32, ((ch >> (j * 8u32)) & 0xFFu64) as u8);
            written += 1u64;
        }
    }
    written
}

/// Calculate the byte size of a serialized receipt chain.
/// Effect: pure — size computation.
pub fn receipt_chain_serialized_size(chain : &ReceiptChain) -> u64 [pure] {
    // 1 byte length + 8 bytes root hash + chain.length * 8 bytes per link
    1u64 + 8u64 + ((chain.length as u64) * 8u64)
}

// --- Receipt Aggregation ---

/// Aggregate multiple receipt chains into a single chain.
/// Effect: pure — bounded chain concatenation.
pub fn aggregate_chains(
    chains : Array64<ReceiptChain>,
) -> ReceiptChain [pure] {
    let mut result : ReceiptChain = ReceiptChain::new();
    // Bounded: at most 64 chains.
    for var c : u32 = 0u32; c < chains.len(); c += 1u32 [chains.len()] {
        let chain : ReceiptChain = chains.get(c);
        // Bounded: at most 64 links per chain.
        for var i : u32 = 0u32; i < chain.length; i += 1u32 [chain.length] {
            let link : HashLink = chain.links.get(i);
            result = result.append(link.receipt);
        }
    }
    result = result.compute_chain();
    result
}

/// Compute the root hash of an aggregation without building the chain.
/// Effect: pure — fast hash computation.
pub fn compute_aggregate_root(
    chain_hashes : Array64<u64>,
) -> u64 [pure] {
    var hash : u64 = 14695981039346656037u64;
    // Bounded: at most 64 chain hashes.
    for var i : u32 = 0u32; i < chain_hashes.len(); i += 1u32 [chain_hashes.len()] {
        hash ^= chain_hashes.get(i);
        hash *= 1099511628211u64;
    }
    hash
}

/// Find a receipt by phase in a receipt chain.
/// Effect: pure — bounded search.
pub fn find_receipt_by_phase(
    chain : &ReceiptChain,
    phase : CompilerPhase,
) -> Option<CompilerReceipt> [pure] {
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < chain.length; i += 1u32 [chain.length] {
        let receipt : CompilerReceipt = chain.receipts.get(i);
        if receipt.phase() == phase {
            return Option::Some(receipt);
        }
    }
    Option::None
}

/// Compute a human-readable receipt chain fingerprint.
/// Effect: io — fingerprint formatting.
pub fn format_chain_fingerprint(chain : &ReceiptChain) -> FixedString256 [io] {
    var result : FixedString256 = FixedString256::from("0x");
    result.push_u64(chain.root_hash);
    result.push_str(FixedString256::from(" ["));
    result.push_u32(chain.length);
    result.push_str(FixedString256::from(" receipts]"));
    result
}

// --- Receipt Validation Rules ---

/// Validate that all receipts in a chain have valid phase ordering.
/// Effect: pure — phase order validation.
pub fn validate_phase_order(chain : &ReceiptChain) -> bool [pure] {
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < chain.length; i += 1u32 [chain.length] {
        let receipt : CompilerReceipt = chain.receipts.get(i);
        let phase : CompilerPhase = receipt.phase();
        // Phases should be in increasing order.
        if (phase as u8) != (i as u8) {
            return false;
        }
    }
    true
}

/// Validate that no receipt has a zero payload hash.
/// Effect: pure — hash validation.
pub fn validate_payload_hashes(chain : &ReceiptChain) -> bool [pure] {
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < chain.length; i += 1u32 [chain.length] {
        let link : HashLink = chain.links.get(i);
        if link.receipt_hash == 0u64 {
            return false;
        }
    }
    true
}

/// Validate that the chain's root hash matches recomputation.
/// Effect: pure — root hash validation.
pub fn validate_root_hash(chain : &ReceiptChain) -> bool [pure] {
    if !chain.finalized || chain.length == 0u32 {
        return false;
    }
    // Recompute the chain from scratch.
    var recomputed_chain : ReceiptChain = ReceiptChain::new();
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < chain.length; i += 1u32 [chain.length] {
        recomputed_chain = recomputed_chain.append(chain.receipts.get(i));
    }
    recomputed_chain = recomputed_chain.compute_chain();
    recomputed_chain.root_hash == chain.root_hash
}

// --- Receipt Diffing ---

/// Compute the diff between two receipt chains.
/// Effect: pure — structural diff.
pub fn diff_chains(
    chain_a : &ReceiptChain,
    chain_b : &ReceiptChain,
) -> Array64<ReceiptDiffEntry> [pure] {
    var diffs : Array64<ReceiptDiffEntry> = Array64::new();
    let max_len : u32 = if chain_a.length > chain_b.length {
        chain_a.length
    } else {
        chain_b.length
    };
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < max_len; i += 1u32 [max_len] {
        let receipt_a : Option<CompilerReceipt> = chain_a.get_receipt(i);
        let receipt_b : Option<CompilerReceipt> = chain_b.get_receipt(i);
        match (receipt_a, receipt_b) {
            (Option::Some(a), Option::Some(b)) => {
                if a.payload_hash() != b.payload_hash() {
                    let entry : ReceiptDiffEntry = ReceiptDiffEntry::new(
                        i, a.payload_hash(), b.payload_hash(), DiffKind::HashMismatch,
                    );
                    let _ = diffs.push(entry);
                }
            }
            (Option::Some(_), Option::None) => {
                let entry : ReceiptDiffEntry = ReceiptDiffEntry::new(
                    i, 0u64, 0u64, DiffKind::Removed,
                );
                let _ = diffs.push(entry);
            }
            (Option::None, Option::Some(_)) => {
                let entry : ReceiptDiffEntry = ReceiptDiffEntry::new(
                    i, 0u64, 0u64, DiffKind::Added,
                );
                let _ = diffs.push(entry);
            }
            (Option::None, Option::None) => {}
        }
    }
    diffs
}

pub struct ReceiptDiffEntry {
    pub index : u32,
    pub hash_a : u64,
    pub hash_b : u64,
    pub kind : DiffKind,
}

pub sealdatatype DiffKind : u8 {
    HashMismatch = 0u8,
    Removed = 1u8,
    Added = 2u8,
    PhaseMismatch = 3u8,
}

impl ReceiptDiffEntry {
    pub fn new(index : u32, hash_a : u64, hash_b : u64, kind : DiffKind) -> ReceiptDiffEntry [pure] {
        ReceiptDiffEntry {
            index: index,
            hash_a: hash_a,
            hash_b: hash_b,
            kind: kind,
        }
    }
}

// --- Receipt Chain Truncation & Extension ---

/// Truncate a receipt chain to a given length.
/// Effect: pure — bounded truncation.
pub fn truncate_chain(chain : ReceiptChain, new_length : u32) -> ReceiptChain [pure] {
    if new_length >= chain.length {
        return chain;
    }
    let mut result : ReceiptChain = ReceiptChain::new();
    // Bounded: at most new_length receipts.
    for var i : u32 = 0u32; i < new_length; i += 1u32 [new_length] {
        result = result.append(chain.receipts.get(i));
    }
    result = result.compute_chain();
    result
}

/// Extend a receipt chain with additional receipts.
/// Effect: pure — bounded extension.
pub fn extend_chain(
    chain : ReceiptChain,
    additional : Array64<CompilerReceipt>,
) -> ReceiptChain [pure] {
    let mut result : ReceiptChain = chain;
    // Bounded: at most 64 additional receipts.
    for var i : u32 = 0u32; i < additional.len(); i += 1u32 [additional.len()] {
        result = result.append(additional.get(i));
    }
    result = result.compute_chain();
    result
}

// --- Receipt Generator Functions ---

/// Generate a lexer receipt from lexer statistics.
/// Effect: pure — receipt generation.
pub fn make_lexer_receipt(
    token_count : u32,
    error_count : u32,
    source_length : u64,
    generation : u64,
) -> LexerReceipt [pure] {
    LexerReceipt::new(token_count, error_count, source_length, generation, 0u64)
}

/// Generate a parser receipt from parser statistics.
/// Effect: pure — receipt generation.
pub fn make_parser_receipt(
    node_count : u32,
    error_count : u32,
    recovery_count : u32,
    generation : u64,
) -> ParserReceipt [pure] {
    ParserReceipt::new(node_count, error_count, recovery_count, generation, 0u64)
}

/// Generate an optimizer receipt.
/// Effect: pure — receipt generation.
pub fn make_optimizer_receipt(
    before : u32,
    after : u32,
    optimizations : u32,
    generation : u64,
) -> OptimizerReceipt [pure] {
    OptimizerReceipt::new(before, after, optimizations, generation, 0u64)
}

/// Generate a codegen receipt.
/// Effect: pure — receipt generation.
pub fn make_codegen_receipt(
    emitted : u32,
    spills : u32,
    relocs : u32,
    generation : u64,
) -> CodegenReceipt [pure] {
    CodegenReceipt::new(emitted, spills, relocs, generation, 0u64)
}

/// Generate a linker receipt.
/// Effect: pure — receipt generation.
pub fn make_linker_receipt(
    objects : u32,
    resolved : u32,
    relocs : u32,
    generation : u64,
) -> LinkerReceipt [pure] {
    LinkerReceipt::new(objects, resolved, relocs, generation, 0u64)
}

/// Generate a sealer receipt.
/// Effect: pure — receipt generation.
pub fn make_sealer_receipt(
    receipt_count : u32,
    residual_count : u32,
    seal_hash : u64,
    generation : u64,
) -> SealerReceipt [pure] {
    SealerReceipt::new(receipt_count, residual_count, seal_hash, generation, 0u64)
}

// --- Receipt Utility Functions ---

/// Combine multiple evidence receipts into a single aggregated hash.
/// Effect: pure — hash aggregation.
pub fn aggregate_receipt_hashes(receipts : &Array64<EvidenceReceipt>) -> u64 [pure] {
    var hash : u64 = 14695981039346656037u64;
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < receipts.len(); i += 1u32 [receipts.len()] {
        hash ^= receipts.get(i).compute_hash();
        hash *= 1099511628211u64;
    }
    hash
}

/// Compute the expected chain length for a complete compilation.
/// Effect: pure — constant.
pub fn expected_chain_length() -> u32 [pure] {
    // 8 phases: Lexer, Parser, Expander, Lowerer, Optimizer, Codegen, Linker, Sealer
    8u32
}

/// Check if a receipt chain is complete (all phases present).
/// Effect: pure — completeness check.
pub fn is_chain_complete(chain : &ReceiptChain) -> bool [pure] {
    if chain.length != expected_chain_length() {
        return false;
    }
    // Bounded: at most 64 receipts.
    for var i : u32 = 0u32; i < expected_chain_length(); i += 1u32 [expected_chain_length()] {
        let receipt : CompilerReceipt = chain.receipts.get(i);
        let phase : CompilerPhase = receipt.phase();
        if (phase as u8) != i {
            return false;
        }
    }
    true
}

/// Get the number of compiler phases.
pub fn compiler_phase_count() -> u32 [pure] {
    9u32 // 8 main phases + 1 pre-compile
}

/// Check if receipt chain has any receipts.
pub fn chain_non_empty(chain : &ReceiptChain) -> bool [pure] {
    chain.length > 0u32 && chain.finalized
}

/// Get the receipt at a specific position, with bounds checking.
pub fn safe_get_receipt(chain : &ReceiptChain, index : u32) -> Option<CompilerReceipt> [pure] {
    if index < chain.length {
        Option::Some(chain.receipts.get(index))
    } else {
        Option::None
    }
}
