    size: u32,
    ioc: bool,
}

// ─────────────────────────────────────────────────────────────
// HDMI Audio Specific
// ─────────────────────────────────────────────────────────────

struct HdaHdmiAudioState {
    eld_buffer: Array(u8, 256),
    eld_valid: bool,
    eld_size: u8,
    eld_monitor_name: String(16),
    eld_mn_audio_sync_delay: u8,
