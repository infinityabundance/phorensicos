// ──────────────────────────────────────────────
// Bitmap Verification
// ──────────────────────────────────────────────
// Evidence path: BA-BITVERIFY-001 through BA-BITVERIFY-015

pub fn verify_bitmap_consistency(bm: BlockBitmap) -> bool
    effects: [deterministic]
{
    let mut counted_free: u32 = 0
    let total: u32 = bm.total_bits.to_u32()
    // loop: bounds[BOUND_BA_LARGE] — bounded by total bits
    loop: bounds[BOUND_BA_LARGE] for i in 0..total {
        if !bm.is_allocated(Word32::from_u32(i)) {
            counted_free = counted_free + 1
        }
    }
    counted_free == bm.free_bits.to_u32()
}

pub fn verify_bitmap_range(bm: BlockBitmap, start: Word32, count: u32, expected_allocated: bool) -> bool
    effects: [deterministic]
{
    // loop: bounds[BOUND_BA_MEDIUM] — bounded by count
    loop: bounds[BOUND_BA_MEDIUM] for i in 0..count {
        let bit: Word32 = Word32::from_u32(start.to_u32() + i)
        let is_alloc: bool = bm.is_allocated(bit)
        if is_alloc != expected_allocated {
            return false
        }
    }
    true
}

// ──────────────────────────────────────────────
// Extent Merger
// ──────────────────────────────────────────────
// Evidence path: BA-MERGE-001 through BA-MERGE-015

pub fn try_merge_extents(a: Extent, b: Extent) -> Option[Extent>
    effects: [deterministic]
{
    // Check if 'a' is immediately before 'b'.
    let a_end: Word64 = a.physical_block.checked_add(a.block_count).unwrap_or(a.physical_block)
    if a_end.eq(b.physical_block) {
        let merged_count: Word64 = a.block_count.checked_add(b.block_count).unwrap_or(a.block_count)
        return Option::Some(Extent::new(a.logical_block, a.physical_block, merged_count))
    }
    // Check if 'b' is immediately before 'a'.
    let b_end: Word64 = b.physical_block.checked_add(b.block_count).unwrap_or(b.physical_block)
    if b_end.eq(a.physical_block) {
        let merged_count: Word64 = b.block_count.checked_add(a.block_count).unwrap_or(b.block_count)
        return Option::Some(Extent::new(b.logical_block, b.physical_block, merged_count))
    }
    Option::None
}

pub fn merge_extent_list(tree: ref mut ExtentTree) -> Word32
    effects: [deterministic]
{
    let mut merges: Word32 = Word32::from_u32(0)
    if tree.extent_count() < 2 {
        return merges
    }
    let mut i: u32 = 0
    // loop: bounds[BOUND_FS_EXTENTS] — bounded by 60
    loop: bounds[BOUND_FS_EXTENTS] while i < tree.extent_count() - 1 {
        let a: Extent = tree.extents.get(i).unwrap_or(Extent::new(Word64::zero(), Word64::zero(), Word64::zero()))
        let b: Extent = tree.extents.get(i + 1).unwrap_or(Extent::new(Word64::zero(), Word64::zero(), Word64::zero()))
        let merged: Option[Extent> = try_merge_extents(a, b)
        if merged.is_some() {
            tree.extents.set(i, merged.unwrap())
            tree.extents.remove(i + 1)
            merges = merges.checked_add(Word32::from_u32(1)).unwrap_or(merges)
        } else {
            i = i + 1
        }
    }
    merges
}

// ──────────────────────────────────────────────
// Block Group Descriptor Verification
// ──────────────────────────────────────────────
// Evidence path: BA-BGVER-001 through BA-BGVER-015

pub fn verify_block_group_descriptor(bg: BlockGroupDescriptor, total_blocks: Word64) -> FixedArray[8, BaError>
    effects: [deterministic]
{
    let mut errors: FixedArray[8, BaError> = FixedArray::new()
    if bg.free_blocks_count.gt(Word64::from_u64(BLOCKS_PER_GROUP as u64)) {
        errors.push(ba_corrupt("Block group free blocks count exceeds group size"))
    }
    if bg.free_inodes_count.gt(Word64::from_u64(INODES_PER_GROUP as u64)) {
        errors.push(ba_corrupt("Block group free inodes count exceeds group size"))
    }
    if bg.block_bitmap_block.gte(total_blocks) {
        errors.push(ba_corrupt("Block group bitmap block out of range"))
    }
    if bg.inode_bitmap_block.gte(total_blocks) {
        errors.push(ba_corrupt("Block group inode bitmap block out of range"))
    }
    if bg.inode_table_block.gte(total_blocks) {
        errors.push(ba_corrupt("Block group inode table block out of range"))
    }
    errors
}

// ──────────────────────────────────────────────
// Extent Allocator Statistics
// ──────────────────────────────────────────────
// Evidence path: BA-EASTATS-001 through BA-EASTATS-015

pub type ExtentAllocatorStats : struct {
    group_count: Word32,
    total_free_blocks: Word64,
    total_free_inodes: Word64,
    used_blocks: Word64,
    used_inodes: Word64,
    total_fragments: Word32,
    allocations: Word64,
    frees: Word64,
}

impl ExtentAllocatorStats {
    pub fn new() -> ExtentAllocatorStats
        effects: [deterministic]
    {
        ExtentAllocatorStats {
            group_count: Word32::from_u32(0),
            total_free_blocks: Word64::zero(),
            total_free_inodes: Word64::zero(),
            used_blocks: Word64::zero(),
            used_inodes: Word64::zero(),
            total_fragments: Word32::from_u32(0),
            allocations: Word64::zero(),
            frees: Word64::zero(),
        }
    }

    pub fn compute(ea: ref ExtentAllocator) -> ExtentAllocatorStats
        effects: [deterministic]
    {
        let mut stats: ExtentAllocatorStats = ExtentAllocatorStats::new()
        stats.group_count = ea.group_count
        // loop: bounds[BOUND_BA_MEDIUM] — bounded by group count
        loop: bounds[BOUND_BA_MEDIUM] for i in 0..ea.groups.len() {
            let g: BlockGroupAllocator = ea.groups.get(i).unwrap_or(
                BlockGroupAllocator::new(Word32::from_u32(0), BlockGroupDescriptor::new(Word64::zero(), Word64::zero(), Word64::zero())))
            stats.total_free_blocks = stats.total_free_blocks.checked_add(g.free_blocks_count()).unwrap_or(stats.total_free_blocks)
            stats.total_free_inodes = stats.total_free_inodes.checked_add(g.free_inodes_count()).unwrap_or(stats.total_free_inodes)
            stats.total_fragments = stats.total_fragments.checked_add(Word32::from_u32(g.fragment_count())).unwrap_or(stats.total_fragments)
        }
        stats
    }
}
