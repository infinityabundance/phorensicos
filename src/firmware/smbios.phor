    bios_date: FixedString[MAX_STRING_LEN],
    system_manufacturer: FixedString[MAX_STRING_LEN],
    system_product: FixedString[MAX_STRING_LEN],
    system_version: FixedString[MAX_STRING_LEN],
    system_serial: FixedString[MAX_STRING_LEN],
    baseboard_manufacturer: FixedString[MAX_STRING_LEN],
    baseboard_product: FixedString[MAX_STRING_LEN],
    baseboard_version: FixedString[MAX_STRING_LEN],
    chassis_manufacturer: FixedString[MAX_STRING_LEN],
    chassis_type: FixedString[MAX_STRING_LEN],
    processor_version: FixedString[MAX_STRING_LEN],
    processor_max_speed: u32,
    processor_count: u32,
    memory_device_count: u32,
    total_memory_mb: u64,
}

impl DMIInfo {
    pub fn new() -> DMIInfo
        effects: [deterministic]
    {
        DMIInfo {
            bios_vendor: FixedString::new(),
            bios_version: FixedString::new(),
            bios_date: FixedString::new(),
            system_manufacturer: FixedString::new(),
            system_product: FixedString::new(),
            system_version: FixedString::new(),
            system_serial: FixedString::new(),
            baseboard_manufacturer: FixedString::new(),
            baseboard_product: FixedString::new(),
            baseboard_version: FixedString::new(),
            chassis_manufacturer: FixedString::new(),
            chassis_type: FixedString::new(),
            processor_version: FixedString::new(),
            processor_max_speed: 0,
            processor_count: 0,
            memory_device_count: 0,
            total_memory_mb: 0,
        }
    }
}

pub fn collect_dmi_info() -> DMIInfo
    effects: [io:read, deterministic]
{
    let mut info: DMIInfo = DMIInfo::new()

    trusted "DMI info collection: Read SMBIOS tables from firmware memory, SMBIOS Spec §5.2"
    {
        info.bios_vendor = FixedString::from("Phorensic Firmware")
        info.bios_version = FixedString::from("1.0.0")
        info.system_manufacturer = FixedString::from("Phorensic Systems")
        info.system_product = FixedString::from("Phorensic OS Reference Platform")
    }

    residual emit {
        event: "smbios.dmi_info_collected",
        bios_version: info.bios_version,
        system_product: info.system_product,
    }

    info
}

// ──────────────────────────────────────────────
// Runtime Error Type
// ──────────────────────────────────────────────

pub type RuntimeError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl RuntimeError {
    pub fn new(code: Word64, msg: FixedString[128]) -> RuntimeError
        effects: [deterministic]
    {
        RuntimeError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        self.code == 0
    }
}

const DIAG_SMBIOS_BASE: Word64 = 0x0B00_0000_0000_0000
