// phor_keyboard_driver.phor — Native .phor PS/2 Keyboard Driver
//
// Demonstrates:
//   - Capability-gated input device access from .phor
//   - PS/2 scancode processing with residual emission
//   - Bounded event queues with ring buffer
//   - Modifier state tracking
//   - Driver lifecycle matching the capability framework
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:phor_keyboard_driver:v1.0";

// ── Constants ───────────────────────────────────────────

const MAX_EVENTS: u64 = 64;
const KEY_QUEUE_SIZE: u64 = 128;

// ── Key States ─────────────────────────────────────────

type KeyAction = u8;

const KEY_PRESS: KeyAction = 0;
const KEY_RELEASE: KeyAction = 1;

// ── Key Codes (PS/2 Set 1) ─────────────────────────────

const KC_A: u8 = 0x1E;
const KC_B: u8 = 0x30;
const KC_ENTER: u8 = 0x1C;
const KC_SPACE: u8 = 0x39;
const KC_LSHIFT: u8 = 0x2A;
const KC_RSHIFT: u8 = 0x36;
const KC_LCTRL: u8 = 0x1D;
const KC_LALT: u8 = 0x38;

// ── Key Event ──────────────────────────────────────────

struct KeyEvent {
    key_code: u8,
    action: KeyAction,
    ascii: u8,
    shift: bool,
    ctrl: bool,
    alt: bool,
}

impl KeyEvent {
    fn new(code: u8, action: KeyAction, ch: u8, s: bool, c: bool, a: bool) -> KeyEvent
        effect [compute]
    {
        return KeyEvent {
            key_code: code,
            action: action,
            ascii: ch,
            shift: s,
            ctrl: c,
            alt: a,
        };
    }
}

// ── Keyboard Driver ────────────────────────────────────

struct KeyboardDriver {
    initialized: bool,
    active: bool,
    shift_pressed: bool,
    ctrl_pressed: bool,
    alt_pressed: bool,
    event_queue: Array(KeyEvent, 128),
    queue_head: u64,
    queue_tail: u64,
    queue_count: u64,
    total_keys: u64,
}

impl KeyboardDriver {
    fn new() -> KeyboardDriver
        effect [compute]
    {
        return KeyboardDriver {
            initialized: false,
            active: false,
            shift_pressed: false,
            ctrl_pressed: false,
            alt_pressed: false,
            event_queue: Array::splat_zeroed(),
            queue_head: 0,
            queue_tail: 0,
            queue_count: 0,
            total_keys: 0,
        };
    }

    fn init(mut self) -> KeyboardDriver
        effect [compute, residual]
    {
        self.initialized = true;

        residual emit {
            op: "kbd.initialized",
        };

        return self;
    }

    fn activate(mut self) -> KeyboardDriver
        effect [compute, residual]
    {
        if !self.initialized { return self; }
        self.active = true;

        residual emit {
            op: "kbd.activated",
        };

        return self;
    }

    fn is_active(self) -> bool
        effect [compute]
    {
        return self.active;
    }

    fn process_scancode(mut self, scancode: u8) -> KeyboardDriver
        effect [compute, residual]
    {
        let released: bool = (scancode & 0x80) != 0;
        let key: u8 = scancode & 0x7F;
        let action: KeyAction = if released { KEY_RELEASE } else { KEY_PRESS };

        // Update modifier state
        if key == KC_LSHIFT || key == KC_RSHIFT {
            self.shift_pressed = !released;
        }
        if key == KC_LCTRL {
            self.ctrl_pressed = !released;
        }
        if key == KC_LALT {
            self.alt_pressed = !released;
        }

        // Convert to ASCII (simple mapping for demo)
        let ascii: u8 = self.scancode_to_ascii(key, released);

        // Queue event
        let event: KeyEvent = KeyEvent::new(
            key, action, ascii,
            self.shift_pressed, self.ctrl_pressed, self.alt_pressed,
        );
        if self.queue_count < MAX_EVENTS {
            self.event_queue[self.queue_head] = event;
            self.queue_head = (self.queue_head + 1) % KEY_QUEUE_SIZE;
            self.queue_count = self.queue_count + 1;
        }

        self.total_keys = self.total_keys + 1;

        residual emit {
            op: "kbd.scancode",
            key: key as u64,
            action: action as u64,
            ascii: ascii as u64,
        };

        return self;
    }

    fn read_event(mut self) -> (KeyboardDriver, Option<KeyEvent>)
        effect [compute]
    {
        if self.queue_count == 0 {
            return (self, Option::None);
        }
        let event: KeyEvent = self.event_queue[self.queue_tail];
        self.queue_tail = (self.queue_tail + 1) % KEY_QUEUE_SIZE;
        self.queue_count = self.queue_count - 1;
        return (self, Option::Some(event));
    }

    fn has_events(self) -> bool
        effect [compute]
    {
        return self.queue_count > 0;
    }

    fn event_count(self) -> u64
        effect [compute]
    {
        return self.queue_count;
    }

    fn total_keys_pressed(self) -> u64
        effect [compute]
    {
        return self.total_keys;
    }

    fn scancode_to_ascii(self, key: u8, _released: bool) -> u8
        effect [compute]
    {
        let shift: bool = self.shift_pressed;
        if key == 0x1E { return if shift { 0x41 } else { 0x61 }; } // A/a
        if key == 0x30 { return if shift { 0x42 } else { 0x62 }; } // B/b
        if key == 0x2E { return if shift { 0x43 } else { 0x63 }; } // C/c
        if key == 0x20 { return if shift { 0x44 } else { 0x64 }; } // D/d
        if key == 0x12 { return if shift { 0x45 } else { 0x65 }; } // E/e
        if key == 0x1C { return 0x0A; }  // Enter
        if key == 0x39 { return 0x20; }  // Space
        return 0;
    }
}

// ── Test ───────────────────────────────────────────────

fn test_keyboard_driver() -> bool
    effect [compute, residual]
{
    // Create and initialize
    let mut kbd: KeyboardDriver = KeyboardDriver::new();
    assert(!kbd.is_active(), "kbd: not active initially");

    kbd = kbd.init();
    kbd = kbd.activate();
    assert(kbd.is_active(), "kbd: activated");

    // Process scancodes: press 'A', release 'A', press 'B'
    kbd = kbd.process_scancode(0x1E); // A press
    kbd = kbd.process_scancode(0x9E); // A release
    kbd = kbd.process_scancode(0x30); // B press
    assert(kbd.event_count() == 3, "kbd: 3 events queued");
    assert(kbd.total_keys_pressed() == 3, "kbd: 3 total keys");

    // Read events
    let (kbd, event): (KeyboardDriver, Option<KeyEvent>) = kbd.read_event();
    assert(event != Option::None, "kbd: event exists");
    if event != Option::None {
        let ev: KeyEvent = Option::unwrap(event);
        assert(ev.key_code == 0x1E, "kbd: first event is A");
        assert(ev.action == KEY_PRESS, "kbd: first event is press");
        assert(ev.ascii == 0x61, "kbd: A -> ascii 'a'");
    }

    let (kbd, event2): (KeyboardDriver, Option<KeyEvent>) = kbd.read_event();
    assert(event2 != Option::None, "kbd: second event exists");
    if event2 != Option::None {
        let ev2: KeyEvent = Option::unwrap(event2);
        assert(ev2.key_code == 0x1E, "kbd: second event is A release");
        assert(ev2.action == KEY_RELEASE, "kbd: second event is release");
    }

    // Test shift modifier
    let mut kbd_shift: KeyboardDriver = KeyboardDriver::new();
    kbd_shift = kbd_shift.init();
    kbd_shift = kbd_shift.activate();
    kbd_shift = kbd_shift.process_scancode(0x2A); // Shift press
    kbd_shift = kbd_shift.process_scancode(0x1E); // A press (should be 'A', not 'a')
    let (_, shifted): (KeyboardDriver, Option<KeyEvent>) = kbd_shift.read_event();
    let (_, shifted_a): (KeyboardDriver, Option<KeyEvent>) = kbd_shift.read_event();
    if shifted_a != Option::None {
        let ev_a: KeyEvent = Option::unwrap(shifted_a);
        assert(ev_a.ascii == 0x41, "kbd: shift+A = 'A'");
    }

    assert(kbd.event_count() == 1, "kbd: 1 event remaining after reads");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute, residual]
{
    let passed: bool = test_keyboard_driver();
    assert(passed, "phor keyboard driver: all tests pass");

    console.write(Str::from("Phor Keyboard Driver:"));
    console.write(Str::from("  Driver lifecycle (init/activate): PASS"));
    console.write(Str::from("  Scancode processing with residuals: PASS"));
    console.write(Str::from("  Event queue (ring buffer): PASS"));
    console.write(Str::from("  Modifier state (shift): PASS"));
    console.write(Str::from("  ASCII conversion: PASS"));
    console.write(Str::from("Phor keyboard driver validated!"));
}
