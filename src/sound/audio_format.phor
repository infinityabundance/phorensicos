// file: audio_format.phor
// purpose: Audio format definitions with sample formats, channel layouts,
//          sample rates, format conversion, and format negotiation.
// evidence: AFMT-ARCH-001 through AFMT-ARCH-200
// residual: All operations are bounded loops and effect-declared.

package "phorensic:sound:audio_format:v1.0";

use core::constants::*
use core::types::*
use core::math::*
use core::errors::*
use core::collections::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────
// Evidence path: AFMT-CONST-001 through AFMT-CONST-020

const AFMT_MAX_RATES : u32 = 20
const AFMT_MAX_CHANNEL_LAYOUTS : u32 = 8
const AFMT_MAX_FORMATS : u32 = 8

// ──────────────────────────────────────────────
// Sample Format Definitions
// ──────────────────────────────────────────────
// Evidence path: AFMT-FMT-001 through AFMT-FMT-035

pub type SampleFormat2 : u8 = enum {
    U8        = 0,   // Unsigned 8-bit
    S16LE     = 1,   // Signed 16-bit little-endian
    S24LE     = 2,   // Signed 24-bit little-endian (packed)
    S24_32LE  = 3,   // Signed 24-bit in 32-bit little-endian
    S32LE     = 4,   // Signed 32-bit little-endian
    F32LE     = 5,   // IEEE 754 float 32-bit little-endian
    F64LE     = 6,   // IEEE 754 float 64-bit little-endian
    Custom    = 7,   // Custom/vendor format
}

pub type FormatProperties : struct {
    format: SampleFormat2,
    bits_per_sample: u8,
    bytes_per_sample: u8,
    is_float: bool,
    is_signed: bool,
    is_little_endian: bool,
    name: FixedString[16],
}

impl FormatProperties {
    pub fn from_format(fmt: SampleFormat2) -> FormatProperties
        effects: [deterministic]
    {
        match fmt {
            SampleFormat2::U8 => FormatProperties {
                format: fmt, bits_per_sample: 8, bytes_per_sample: 1,
                is_float: false, is_signed: false, is_little_endian: true,
                name: FixedString::from_slice("U8"),
            },
            SampleFormat2::S16LE => FormatProperties {
                format: fmt, bits_per_sample: 16, bytes_per_sample: 2,
                is_float: false, is_signed: true, is_little_endian: true,
                name: FixedString::from_slice("S16LE"),
            },
            SampleFormat2::S24LE => FormatProperties {
                format: fmt, bits_per_sample: 24, bytes_per_sample: 3,
                is_float: false, is_signed: true, is_little_endian: true,
                name: FixedString::from_slice("S24LE"),
            },
            SampleFormat2::S24_32LE => FormatProperties {
                format: fmt, bits_per_sample: 24, bytes_per_sample: 4,
                is_float: false, is_signed: true, is_little_endian: true,
                name: FixedString::from_slice("S24_32LE"),
            },
            SampleFormat2::S32LE => FormatProperties {
                format: fmt, bits_per_sample: 32, bytes_per_sample: 4,
                is_float: false, is_signed: true, is_little_endian: true,
                name: FixedString::from_slice("S32LE"),
            },
            SampleFormat2::F32LE => FormatProperties {
                format: fmt, bits_per_sample: 32, bytes_per_sample: 4,
                is_float: true, is_signed: true, is_little_endian: true,
                name: FixedString::from_slice("F32LE"),
            },
            SampleFormat2::F64LE => FormatProperties {
                format: fmt, bits_per_sample: 64, bytes_per_sample: 8,
                is_float: true, is_signed: true, is_little_endian: true,
                name: FixedString::from_slice("F64LE"),
            },
            SampleFormat2::Custom => FormatProperties {
                format: fmt, bits_per_sample: 0, bytes_per_sample: 0,
                is_float: false, is_signed: false, is_little_endian: true,
                name: FixedString::from_slice("Custom"),
            },
        }
    }

    pub fn frame_size(self, channels: u32) -> u32
        effects: [deterministic]
    {
        (self.bytes_per_sample as u32) * channels
    }

    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.bits_per_sample > 0 && self.bytes_per_sample > 0
            && self.bytes_per_sample <= 8
    }
}

// ──────────────────────────────────────────────
// Channel Layout Definitions
// ──────────────────────────────────────────────
// Evidence path: AFMT-CHAN-001 through AFMT-CHAN-030

pub type ChannelLayout2 : u8 = enum {
    Mono         = 0,
    Stereo       = 1,
    StereoLFE    = 2,
    Quad         = 3,
    Surround51   = 4,
    Surround71   = 5,
    Custom       = 6,
}

pub type ChannelPosition2 : u8 = enum {
    FL = 0,   // Front Left
    FR = 1,   // Front Right
    FC = 2,   // Front Center
    LFE = 3,  // Low Frequency Effects
    RL = 4,   // Rear Left
    RR = 5,   // Rear Right
    SL = 6,   // Side Left
    SR = 7,   // Side Right
    TFL = 8,  // Top Front Left
    TFR = 9,  // Top Front Right
    TFC = 10, // Top Front Center
    TBL = 11, // Top Back Left
    TBR = 12, // Top Back Right
    Unknown = 0xFF,
}

pub type ChannelLayoutDesc : struct {
    layout: ChannelLayout2,
    channel_count: u32,
    channels: FixedArray[8, ChannelPosition2],
    name: FixedString[16],
}

impl ChannelLayoutDesc {
    pub fn from_layout(layout: ChannelLayout2) -> ChannelLayoutDesc
        effects: [deterministic]
    {
        let (count, ch, name): (u32, FixedArray[8, ChannelPosition2], FixedString[16]) = match layout {
            ChannelLayout2::Mono => (1, FixedArray::from_raw(
                [ChannelPosition2::FC, ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown,
                 ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown], 1)?,
                FixedString::from_slice("Mono")),
            ChannelLayout2::Stereo => (2, FixedArray::from_raw(
                [ChannelPosition2::FL, ChannelPosition2::FR, ChannelPosition2::Unknown, ChannelPosition2::Unknown,
                 ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown], 2)?,
                FixedString::from_slice("Stereo")),
            ChannelLayout2::StereoLFE => (3, FixedArray::from_raw(
                [ChannelPosition2::FL, ChannelPosition2::FR, ChannelPosition2::LFE, ChannelPosition2::Unknown,
                 ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown], 3)?,
                FixedString::from_slice("2.1")),
            ChannelLayout2::Quad => (4, FixedArray::from_raw(
                [ChannelPosition2::FL, ChannelPosition2::FR, ChannelPosition2::RL, ChannelPosition2::RR,
                 ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown, ChannelPosition2::Unknown], 4)?,
                FixedString::from_slice("Quad")),
            ChannelLayout2::Surround51 => (6, FixedArray::from_raw(
                [ChannelPosition2::FL, ChannelPosition2::FR, ChannelPosition2::FC, ChannelPosition2::LFE,
                 ChannelPosition2::RL, ChannelPosition2::RR, ChannelPosition2::Unknown, ChannelPosition2::Unknown], 6)?,
                FixedString::from_slice("5.1")),
            ChannelLayout2::Surround71 => (8, FixedArray::from_raw(
                [ChannelPosition2::FL, ChannelPosition2::FR, ChannelPosition2::FC, ChannelPosition2::LFE,
                 ChannelPosition2::RL, ChannelPosition2::RR, ChannelPosition2::SL, ChannelPosition2::SR], 8)?,
                FixedString::from_slice("7.1")),
            ChannelLayout2::Custom => (0, FixedArray::new(), FixedString::from_slice("Custom")),
        }
        ChannelLayoutDesc {
            layout: layout,
            channel_count: count,
            channels: ch,
            name: name,
        }
    }

    pub fn get_channel_count(self) -> u32
        effects: [deterministic]
    {
        self.channel_count
    }

    pub fn get_channel_position(self, index: u32) -> ChannelPosition2
        effects: [deterministic]
    {
        if index < self.channel_count {
            self.channels[index as usize]
        } else {
            ChannelPosition2::Unknown
        }
    }
}

// ──────────────────────────────────────────────
// Sample Rate Definitions
// ──────────────────────────────────────────────
// Evidence path: AFMT-RATE-001 through AFMT-RATE-020

pub type SampleRate : u32 = enum {
    Rate8000    = 8000,
    Rate11025   = 11025,
    Rate16000   = 16000,
    Rate22050   = 22050,
    Rate32000   = 32000,
    Rate44100   = 44100,
    Rate48000   = 48000,
    Rate88200   = 88200,
    Rate96000   = 96000,
    Rate176400  = 176400,
    Rate192000  = 192000,
    Rate384000  = 384000,
    Rate768000  = 768000,
}

pub fn is_valid_sample_rate(rate: u32) -> bool
    effects: [deterministic]
{
    rate >= 8000 && rate <= 768000 &&
    (rate == 8000 || rate == 11025 || rate == 16000 || rate == 22050 ||
     rate == 32000 || rate == 44100 || rate == 48000 || rate == 88200 ||
     rate == 96000 || rate == 176400 || rate == 192000 || rate == 384000 ||
     rate == 768000)
}

// ──────────────────────────────────────────────
// Complete Audio Format
// ──────────────────────────────────────────────
// Evidence path: AFMT-FULL-001 through AFMT-FULL-030

pub type AudioFormat : struct {
    sample_format: SampleFormat2,
    channel_layout: ChannelLayout2,
    sample_rate: u32,
    channels: u32,
}

impl AudioFormat {
    pub fn new(fmt: SampleFormat2, layout: ChannelLayout2, rate: u32) -> AudioFormat
        effects: [deterministic]
    {
        let layout_desc: ChannelLayoutDesc = ChannelLayoutDesc::from_layout(layout)
        AudioFormat {
            sample_format: fmt,
            channel_layout: layout,
            sample_rate: rate,
            channels: layout_desc.get_channel_count(),
        }
    }

    pub fn frame_size(self) -> u32
        effects: [deterministic]
    {
        let props: FormatProperties = FormatProperties::from_format(self.sample_format)
        props.frame_size(self.channels)
    }

    pub fn byte_rate(self) -> u32
        effects: [deterministic]
    {
        self.frame_size() * self.sample_rate
    }

    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        let props: FormatProperties = FormatProperties::from_format(self.sample_format)
        props.is_valid() && is_valid_sample_rate(self.sample_rate) &&
        self.channels >= 1 && self.channels <= 8
    }

    pub fn duration_bytes(self, duration_secs: u32) -> u32
        effects: [deterministic]
    {
        self.byte_rate() * duration_secs
    }

    pub fn duration_frames(self, duration_msec: u32) -> u32
        effects: [deterministic]
    {
        (self.sample_rate * duration_msec) / 1000
    }

    pub fn to_string(self) -> FixedString[64]
        effects: [deterministic]
    {
        let fmt_props: FormatProperties = FormatProperties::from_format(self.sample_format)
        let layout_desc: ChannelLayoutDesc = ChannelLayoutDesc::from_layout(self.channel_layout)
        let mut s: FixedString[64] = FixedString::new()
        let _ = s.append(fmt_props.name)
        let _ = s.append(layout_desc.name)
        let _ = s.append(FixedString::from_slice(" @ "))
        let _ = s.append(FixedString::from_slice("Hz"))
        s
    }
}

// ──────────────────────────────────────────────
// Format Negotiation
// ──────────────────────────────────────────────
// Evidence path: AFMT-NEG-001 through AFMT-NEG-035

pub type FormatConstraint : struct {
    min_channels: u32,
    max_channels: u32,
    min_rate: u32,
    max_rate: u32,
    allowed_formats: FixedArray[8, SampleFormat2],
    allowed_layouts: FixedArray[8, ChannelLayout2],
}

impl FormatConstraint {
    pub fn new() -> FormatConstraint
        effects: [deterministic]
    {
        FormatConstraint {
            min_channels: 1, max_channels: 2,
            min_rate: 8000, max_rate: 192000,
            allowed_formats: FixedArray::new(),
            allowed_layouts: FixedArray::new(),
        }
    }

    pub fn add_format(self: ref mut, fmt: SampleFormat2)
        effects: [deterministic]
    {
        let _ = self.allowed_formats.push(fmt)
    }

    pub fn add_layout(self: ref mut, layout: ChannelLayout2)
        effects: [deterministic]
    {
        let _ = self.allowed_layouts.push(layout)
    }

    pub fn allows_format(self, fmt: SampleFormat2) -> bool
        effects: [deterministic]
    {
        if self.allowed_formats.len() == 0 {
            return true
        }
        let mut allowed: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by format count
        loop: bounds[BOUND_SMALL] for i in 0..self.allowed_formats.len() {
            if self.allowed_formats[i as usize] == fmt {
                allowed = true
            }
        }
        allowed
    }

    pub fn allows_layout(self, layout: ChannelLayout2) -> bool
        effects: [deterministic]
    {
        if self.allowed_layouts.len() == 0 {
            return true
        }
        let mut allowed: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by layout count
        loop: bounds[BOUND_SMALL] for i in 0..self.allowed_layouts.len() {
            if self.allowed_layouts[i as usize] == layout {
                allowed = true
            }
        }
        allowed
    }

    // Negotiate the best format between two constraints.
    pub fn negotiate(capabilities: ref FormatConstraint, requirements: ref FormatConstraint) -> Option[AudioFormat]
        effects: [deterministic]
    {
        // Find common sample format
        let mut best_fmt: SampleFormat2 = SampleFormat2::U8
        let mut fmt_found: bool = false

        // loop: bounds[BOUND_SMALL] — bounded by format count
        loop: bounds[BOUND_SMALL] for i in 0..capabilities.allowed_formats.len() {
            if requirements.allows_format(capabilities.allowed_formats[i as usize]) {
                best_fmt = capabilities.allowed_formats[i as usize]
                fmt_found = true
            }
        }
        if !fmt_found {
            return Option::None
        }

        // Find common channel layout
        let mut best_layout: ChannelLayout2 = ChannelLayout2::Mono
        let mut layout_found: bool = false

        // loop: bounds[BOUND_SMALL] — bounded by layout count
        loop: bounds[BOUND_SMALL] for i in 0..capabilities.allowed_layouts.len() {
            if requirements.allows_layout(capabilities.allowed_layouts[i as usize]) {
                best_layout = capabilities.allowed_layouts[i as usize]
                layout_found = true
            }
        }
        if !layout_found {
            return Option::None
        }

        // Use highest common sample rate
        let rate: u32 = if capabilities.max_rate < requirements.max_rate {
            capabilities.max_rate
        } else {
            requirements.max_rate
        }

        Option::Some(AudioFormat::new(best_fmt, best_layout, rate))
    }
}

// ──────────────────────────────────────────────
// Format Conversion
// ──────────────────────────────────────────────
// Evidence path: AFMT-CONV-001 through AFMT-CONV-030

pub fn convert_sample(src: u64, src_fmt: SampleFormat2, dst_fmt: SampleFormat2) -> u64
    effects: [deterministic]
{
    match (src_fmt, dst_fmt) {
        (SampleFormat2::S16LE, SampleFormat2::S32LE) => {
            // Sign-extend i16 to i32
            let s: i32 = (src as i32) << 16
            s as u64
        },
        (SampleFormat2::S32LE, SampleFormat2::S16LE) => {
            // Truncate i32 to i16
            ((src as i32) >> 16) as u64
        },
        (SampleFormat2::F32LE, SampleFormat2::S16LE) => {
            // F32 to S16 conversion
            let f: f32 = *(&src as *const u64 as *const f32)
            let s: i32 = (f * 32767.0) as i32
            if s > 32767 { 32767 } else if s < -32768 { -32768 } else { s as u64 }
        },
        (SampleFormat2::S16LE, SampleFormat2::F32LE) => {
            // S16 to F32 conversion
            let s: i32 = src as i32
            let f: f32 = (s as f32) / 32767.0
            *(&f as *const f32 as *const u64)
        },
        _ => src, // Passthrough for same format
    }
}

// ──────────────────────────────────────────────
// Format Query and Matching
// ──────────────────────────────────────────────
// Evidence path: AFMT-QUERY-001 through AFMT-QUERY-025

pub type AudioFormatQuery : struct {
    formats: FixedArray[8, AudioFormat],
    count: u32,
}

impl AudioFormatQuery {
    pub fn new() -> AudioFormatQuery
        effects: [deterministic]
    {
        AudioFormatQuery {
            formats: FixedArray::new(),
            count: 0,
        }
    }

    pub fn add_format(self: ref mut, fmt: AudioFormat)
        effects: [deterministic]
    {
        let _ = self.formats.push(fmt)
        self.count = self.count + 1
    }

    // Find a format matching criteria.
    pub fn find_best_match(self, min_channels: u32, min_rate: u32) -> Option[AudioFormat]
        effects: [deterministic]
    {
        let mut best: Option[AudioFormat] = Option::None
        // loop: bounds[BOUND_SMALL] — bounded by format count
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            let fmt: AudioFormat = self.formats[i as usize]
            if fmt.channels >= min_channels && fmt.sample_rate >= min_rate && fmt.is_valid() {
                match best {
                    Option::Some(current) => {
                        // Prefer higher channel count, then higher rate
                        if fmt.channels > current.channels ||
                           (fmt.channels == current.channels && fmt.sample_rate > current.sample_rate) {
                            best = Option::Some(fmt)
                        }
                    },
                    Option::None => {
                        best = Option::Some(fmt)
                    },
                }
            }
        }
        best
    }

    // Check if a specific format is supported.
    pub fn supports(self, fmt: ref AudioFormat) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by format count
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            let f: AudioFormat = self.formats[i as usize]
            if f.sample_format == fmt.sample_format &&
               f.channel_layout == fmt.channel_layout &&
               f.sample_rate == fmt.sample_rate {
                return true
            }
        }
        false
    }

    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.formats.clear()
        self.count = 0
    }
}

// ──────────────────────────────────────────────
// Format Capabilities Descriptor
// ──────────────────────────────────────────────
// Evidence path: AFMT-CAPS-001 through AFMT-CAPS-020

pub type AudioCapabilities : struct {
    supported_rates: FixedArray[20, u32],
    rate_count: u32,
    supported_formats: FixedArray[8, SampleFormat2],
    format_count: u32,
    supported_layouts: FixedArray[8, ChannelLayout2],
    layout_count: u32,
    max_channels: u32,
    min_rate: u32,
    max_rate: u32,
}

impl AudioCapabilities {
    pub fn new() -> AudioCapabilities
        effects: [deterministic]
    {
        AudioCapabilities {
            supported_rates: FixedArray::new(),
            rate_count: 0,
            supported_formats: FixedArray::new(),
            format_count: 0,
            supported_layouts: FixedArray::new(),
            layout_count: 0,
            max_channels: 2,
            min_rate: 8000,
            max_rate: 192000,
        }
    }

    pub fn add_rate(self: ref mut, rate: u32)
        effects: [deterministic]
    {
        let _ = self.supported_rates.push(rate)
        self.rate_count = self.rate_count + 1
        if rate < self.min_rate { self.min_rate = rate }
        if rate > self.max_rate { self.max_rate = rate }
    }

    pub fn add_format(self: ref mut, fmt: SampleFormat2)
        effects: [deterministic]
    {
        let _ = self.supported_formats.push(fmt)
        self.format_count = self.format_count + 1
    }

    pub fn add_layout(self: ref mut, layout: ChannelLayout2)
        effects: [deterministic]
    {
        let _ = self.supported_layouts.push(layout)
        self.layout_count = self.layout_count + 1
        let layout_desc: ChannelLayoutDesc = ChannelLayoutDesc::from_layout(layout)
        if layout_desc.get_channel_count() > self.max_channels {
            self.max_channels = layout_desc.get_channel_count()
        }
    }

    // Check if a format is supported.
    pub fn is_format_supported(self, fmt: ref AudioFormat) -> bool
        effects: [deterministic]
    {
        let mut fmt_ok: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by format count
        loop: bounds[BOUND_SMALL] for i in 0..self.format_count {
            if self.supported_formats[i as usize] == fmt.sample_format {
                fmt_ok = true
            }
        }
        let mut rate_ok: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by rate count
        loop: bounds[BOUND_SMALL] for i in 0..self.rate_count {
            if self.supported_rates[i as usize] == fmt.sample_rate {
                rate_ok = true
            }
        }
        let mut layout_ok: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by layout count
        loop: bounds[BOUND_SMALL] for i in 0..self.layout_count {
            if self.supported_layouts[i as usize] == fmt.channel_layout {
                layout_ok = true
            }
        }
        fmt_ok && rate_ok && layout_ok
    }
}

// ──────────────────────────────────────────────
// Test Vectors
// ──────────────────────────────────────────────

pub fn run_audio_format_tests() -> bool
    effects: [deterministic, residual]
{
    // Test format properties
    let s16: FormatProperties = FormatProperties::from_format(SampleFormat2::S16LE)
    assert(s16.bits_per_sample == 16, "afmt: S16LE bits")
    assert(s16.bytes_per_sample == 2, "afmt: S16LE bytes")
    assert(s16.is_signed, "afmt: S16LE signed")
    assert(!s16.is_float, "afmt: S16LE not float")
    assert(s16.frame_size(2) == 4, "afmt: S16LE stereo frame 4 bytes")

    let f32: FormatProperties = FormatProperties::from_format(SampleFormat2::F32LE)
    assert(f32.is_float, "afmt: F32LE is float")
    assert(f32.frame_size(8) == 32, "afmt: F32LE 8ch frame 32 bytes")

    let custom_props: FormatProperties = FormatProperties::from_format(SampleFormat2::Custom)
    assert(!custom_props.is_valid(), "afmt: custom format invalid")

    // Test channel layouts
    let mono: ChannelLayoutDesc = ChannelLayoutDesc::from_layout(ChannelLayout2::Mono)
    assert(mono.get_channel_count() == 1, "afmt: mono 1 channel")
    assert(mono.get_channel_position(0) == ChannelPosition2::FC, "afmt: mono FC")

    let stereo: ChannelLayoutDesc = ChannelLayoutDesc::from_layout(ChannelLayout2::Stereo)
    assert(stereo.get_channel_count() == 2, "afmt: stereo 2 channels")
    assert(stereo.get_channel_position(0) == ChannelPosition2::FL, "afmt: stereo FL")
    assert(stereo.get_channel_position(1) == ChannelPosition2::FR, "afmt: stereo FR")

    let surround71: ChannelLayoutDesc = ChannelLayoutDesc::from_layout(ChannelLayout2::Surround71)
    assert(surround71.get_channel_count() == 8, "afmt: 7.1 has 8 channels")

    // Test sample rates
    assert(is_valid_sample_rate(44100), "afmt: 44100 valid")
    assert(is_valid_sample_rate(48000), "afmt: 48000 valid")
    assert(is_valid_sample_rate(96000), "afmt: 96000 valid")
    assert(!is_valid_sample_rate(12345), "afmt: 12345 invalid")
    assert(!is_valid_sample_rate(0), "afmt: 0 invalid")
    assert(!is_valid_sample_rate(999999), "afmt: 999999 invalid")

    // Test complete audio format
    let cd: AudioFormat = AudioFormat::new(SampleFormat2::S16LE, ChannelLayout2::Stereo, 44100)
    assert(cd.is_valid(), "afmt: CD format valid")
    assert(cd.frame_size() == 4, "afmt: CD frame size 4")
    assert(cd.byte_rate() == 176400, "afmt: CD byte rate 176400")

    let dvd: AudioFormat = AudioFormat::new(SampleFormat2::S24LE, ChannelLayout2::Surround51, 96000)
    assert(dvd.is_valid(), "afmt: DVD format valid")
    assert(dvd.frame_size() == 18, "afmt: 5.1 S24LE frame size 18")
    assert(dvd.byte_rate() == 1728000, "afmt: 5.1 96kHz byte rate")

    // Duration calculations
    let dur_bytes: u32 = cd.duration_bytes(10)
    assert(dur_bytes == 1764000, "afmt: 10 seconds of CD audio")

    let dur_frames: u32 = cd.duration_frames(1000)
    assert(dur_frames == 44100, "afmt: 1 second = 44100 frames")

    // Format negotiation
    let mut caps: FormatConstraint = FormatConstraint::new()
    caps.add_format(SampleFormat2::S16LE)
    caps.add_format(SampleFormat2::S32LE)
    caps.add_layout(ChannelLayout2::Stereo)
    caps.add_layout(ChannelLayout2::Surround51)
    caps.max_rate = 48000

    let mut reqs: FormatConstraint = FormatConstraint::new()
    reqs.add_format(SampleFormat2::S16LE)
    reqs.add_format(SampleFormat2::F32LE)
    reqs.add_layout(ChannelLayout2::Stereo)
    reqs.max_rate = 44100

    let negotiated: Option[AudioFormat] = FormatConstraint::negotiate(&caps, &reqs)
    match negotiated {
        Option::Some(fmt) => {
            assert(fmt.sample_format == SampleFormat2::S16LE, "afmt: negotiated S16LE")
            assert(fmt.channel_layout == ChannelLayout2::Stereo, "afmt: negotiated stereo")
            assert(fmt.sample_rate == 44100, "afmt: negotiated 44100 Hz")
        },
        Option::None => assert(false, "afmt: negotiation should succeed"),
    }

    // Incompatible negotiation
    let mut reqs2: FormatConstraint = FormatConstraint::new()
    reqs2.add_format(SampleFormat2::F64LE)
    reqs2.add_layout(ChannelLayout2::Surround71)

    let failed: Option[AudioFormat] = FormatConstraint::negotiate(&caps, &reqs2)
    match failed {
        Option::Some(_) => assert(false, "afmt: negotiation should fail"),
        Option::None => assert(true, "afmt: incompatible negotiation fails"),
    }

    // Sample conversion
    let s16_val: u64 = 1000
    let s32_val: u64 = convert_sample(s16_val, SampleFormat2::S16LE, SampleFormat2::S32LE)
    assert(s32_val > s16_val, "afmt: S16 to S32 scales up")

    let back: u64 = convert_sample(s32_val, SampleFormat2::S32LE, SampleFormat2::S16LE)
    assert(back == s16_val, "afmt: S32 to S16 round-trips")

    // Invalid format
    let bad_fmt: AudioFormat = AudioFormat::new(SampleFormat2::Custom, ChannelLayout2::Custom, 12345)
    assert(!bad_fmt.is_valid(), "afmt: invalid format detected")

    // Test format query
    let mut query: AudioFormatQuery = AudioFormatQuery::new()
    query.add_format(cd)
    query.add_format(dvd)
    assert(query.supports(&cd), "afmt-query: CD format supported")
    assert(!query.supports(&bad_fmt), "afmt-query: bad format not supported")

    let best_match: Option[AudioFormat] = query.find_best_match(2, 44100)
    match best_match {
        Option::Some(f) => assert(f.sample_rate >= 44100, "afmt-query: best match rate >= 44100"),
        Option::None => assert(false, "afmt-query: should find match"),
    }

    query.clear()
    assert(query.count == 0, "afmt-query: cleared")

    // Test audio capabilities
    let mut caps: AudioCapabilities = AudioCapabilities::new()
    caps.add_rate(44100)
    caps.add_rate(48000)
    caps.add_rate(96000)
    caps.add_format(SampleFormat2::S16LE)
    caps.add_format(SampleFormat2::S32LE)
    caps.add_layout(ChannelLayout2::Stereo)
    caps.add_layout(ChannelLayout2::Surround51)

    assert(caps.rate_count == 3, "afmt-caps: 3 rates")
    assert(caps.format_count == 2, "afmt-caps: 2 formats")
    assert(caps.layout_count == 2, "afmt-caps: 2 layouts")
    assert(caps.max_channels >= 6, "afmt-caps: max channels >= 6")
    assert(caps.is_format_supported(&cd), "afmt-caps: CD format supported")
    assert(!caps.is_format_supported(&bad_fmt), "afmt-caps: bad format not supported")

    // Format to_string
    let cd_str: FixedString[64] = cd.to_string()
    assert(cd_str.len() > 0, "afmt: to_string produces output")

    // Test high-rate formats
    let high_rate: AudioFormat = AudioFormat::new(SampleFormat2::S32LE, ChannelLayout2::Surround71, 192000)
    assert(high_rate.is_valid(), "afmt: 192kHz 7.1 valid")
    assert(high_rate.byte_rate() == 12288000, "afmt: 192kHz 7.1 S32LE byte rate")
    assert(high_rate.duration_frames(1000) == 192000, "afmt: 192kHz duration frames")

    // Test mono format
    let mono_fmt: AudioFormat = AudioFormat::new(SampleFormat2::S16LE, ChannelLayout2::Mono, 8000)
    assert(mono_fmt.frame_size() == 2, "afmt: mono S16LE frame size 2")
    assert(mono_fmt.byte_rate() == 16000, "afmt: mono 8kHz byte rate")

    // Test format duration calculation consistency
    let dur_1sec: u32 = cd.duration_bytes(1)
    let dur_2sec: u32 = cd.duration_bytes(2)
    assert(dur_2sec == dur_1sec * 2, "afmt: duration scales linearly")

    // Query find_best_match edge cases
    let empty_query: AudioFormatQuery = AudioFormatQuery::new()
    let no_match: Option[AudioFormat] = empty_query.find_best_match(2, 96000)
    match no_match {
        Option::Some(_) => assert(false, "afmt: empty query should not match"),
        Option::None => assert(true, "afmt: empty query returns none"),
    }

    // Capabilities with no formats configured
    let empty_caps: AudioCapabilities = AudioCapabilities::new()
    assert(!empty_caps.is_format_supported(&cd), "afmt: empty caps rejects format")

    residual emit {
        op: "audio_format.tests",
        s16: true,
        f32: true,
        mono: true,
        stereo: true,
        surround: true,
        rates: true,
        cd_format: true,
        dvd_format: true,
        duration: true,
        negotiation: true,
        neg_fail: true,
        conversion: true,
        query: true,
        caps: true,
        to_string: true,
        best_match: true,
        high_rate: true,
        mono: true,
        duration_linear: true,
        empty_query: true,
        empty_caps: true,
    }

    true
}
