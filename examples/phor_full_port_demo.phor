// phor_full_port_demo.phor — End-to-End JIT Porting Pipeline
//
// Demonstrates the complete clean-room porting methodology:
//   1. Observe foreign function behavior (capture traces)
//   2. Analyze dialect surface classification
//   3. Specify native equivalent specification
//   4. Implement native Phorensic version
//   5. Verify against oracle traces
//   6. Promote through trust ladder
//   7. Register in sealed package store
//
// The demo ports a simple "string uppercase" utility (like C's toupper)
// through the complete pipeline.
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:phor_full_port_demo:v1.0";

// ── Constants ───────────────────────────────────────────

const MAX_TRACES: u64 = 16;
const MAX_SPEC_ITEMS: u64 = 8;
const MAX_STR_LEN: u64 = 64;
const MAX_HISTORY: u64 = 8;

// ── Trust Levels ───────────────────────────────────────

type TrustLevel = u8;

const TRUST_UNKNOWN: TrustLevel = 0;
const TRUST_OBSERVED: TrustLevel = 1;
const TRUST_REPLAYED: TrustLevel = 2;
const TRUST_ORACLE: TrustLevel = 3;
const TRUST_RESIDUAL: TrustLevel = 4;
const TRUST_SEALED: TrustLevel = 5;

fn trust_label(level: TrustLevel) -> Str(16)
    effect [compute]
{
    if level == TRUST_OBSERVED { return Str::from("Observed"); }
    if level == TRUST_REPLAYED { return Str::from("Replayed"); }
    if level == TRUST_ORACLE { return Str::from("Oracle"); }
    if level == TRUST_RESIDUAL { return Str::from("Residual"); }
    if level == TRUST_SEALED { return Str::from("Sealed"); }
    return Str::from("Unknown");
}

// ── Stage 1: Observe ───────────────────────────────────

struct OracleTrace {
    input_char: u8,
    output_char: u8,
    latency_ticks: u64,
}

impl OracleTrace {
    fn new(inp: u8, out: u8, lat: u64) -> OracleTrace
        effect [compute]
    {
        return OracleTrace { input_char: inp, output_char: out, latency_ticks: lat };
    }
}

// ── Stage 2: Analyze ───────────────────────────────────

struct DialectSurface {
    name: Array(u8, 32),
    name_len: u64,
    operations: u64,
    complexity: u8,
}

impl DialectSurface {
    fn new() -> DialectSurface
        effect [compute]
    {
        return DialectSurface {
            name: Array::splat(0),
            name_len: 0,
            operations: 0,
            complexity: 0,
        };
    }

    fn classify(mut self, n: Array(u8, 32), nlen: u64) -> DialectSurface
        effect [compute]
    {
        self.name = n;
        self.name_len = nlen;
        self.complexity = 2; // Simple string operation
        self.operations = 1;
        return self;
    }
}

// ── Stage 3: Specify ───────────────────────────────────

struct PortSpec {
    spec_name: Array(u8, 48),
    spec_len: u64,
    inputs: u64,
    outputs: u64,
    effects: u64,
}

impl PortSpec {
    fn new() -> PortSpec
        effect [compute]
    {
        return PortSpec {
            spec_name: Array::splat(0),
            spec_len: 0,
            inputs: 0,
            outputs: 0,
            effects: 0,
        };
    }

    fn define(mut self, name: Array(u8, 48), nlen: u64, inputs: u64, outputs: u64) -> PortSpec
        effect [compute]
    {
        self.spec_name = name;
        self.spec_len = nlen;
        self.inputs = inputs;
        self.outputs = outputs;
        return self;
    }
}

// ── Stage 4: Implement (Native Phorensic) ─────────────

fn phor_to_upper(c: u8) -> u8
    effect [compute]
{
    if c >= 0x61 && c <= 0x7A {
        return c - 0x20;
    }
    return c;
}

fn phor_to_upper_str(input: Array(u8, 64), len: u64) -> Array(u8, 64)
    effect [compute]
{
    let mut output: Array(u8, 64) = Array::splat(0);
    let limit: u64 = len.min(64);
    for i in 0..limit {
        output[i] = phor_to_upper(input[i]);
    }
    return output;
}

// ── Stage 5: Verify ────────────────────────────────────

struct VerificationResult {
    tests_run: u64,
    tests_passed: u64,
    oracle_matched: bool,
    trust_achieved: TrustLevel,
}

impl VerificationResult {
    fn new() -> VerificationResult
        effect [compute]
    {
        return VerificationResult {
            tests_run: 0,
            tests_passed: 0,
            oracle_matched: false,
            trust_achieved: TRUST_UNKNOWN,
        };
    }

    fn record_test(mut self, passed: bool) -> VerificationResult
        effect [compute]
    {
        self.tests_run = self.tests_run + 1;
        if passed { self.tests_passed = self.tests_passed + 1; }
        return self;
    }

    fn all_pass(self) -> bool
        effect [compute]
    {
        return self.tests_run > 0 && self.tests_run == self.tests_passed;
    }
}

// ── Stage 6: Promote ───────────────────────────────────

struct TrustManager {
    current: TrustLevel,
    history: Array(TrustLevel, 8),
    history_count: u64,
}

impl TrustManager {
    fn new() -> TrustManager
        effect [compute]
    {
        return TrustManager {
            current: TRUST_UNKNOWN,
            history: Array::splat(TRUST_UNKNOWN),
            history_count: 0,
        };
    }

    fn promote(mut self) -> TrustManager
        effect [compute, residual]
    {
        if self.current < TRUST_SEALED {
            self.current = self.current + 1;
            if self.history_count < MAX_HISTORY {
                self.history[self.history_count] = self.current;
                self.history_count = self.history_count + 1;
            }

            residual emit {
                op: "porting.promotion",
                from_level: (self.current - 1) as u64,
                to_level: self.current as u64,
            };
        }
        return self;
    }

    fn current_level(self) -> TrustLevel
        effect [compute]
    {
        return self.current;
    }
}

// ── Full Pipeline Test ─────────────────────────────────

fn test_full_port_pipeline() -> bool
    effect [compute, residual]
{
    // ── Stage 1: Observe foreign function ──
    // Observe C's toupper() on various inputs
    let mut traces: Array(OracleTrace, 16) = Array::splat_zeroed();
    traces[0] = OracleTrace::new(0x61, 0x41, 5);  // 'a' -> 'A'
    traces[1] = OracleTrace::new(0x62, 0x42, 5);  // 'b' -> 'B'
    traces[2] = OracleTrace::new(0x7A, 0x5A, 5);  // 'z' -> 'Z'
    traces[3] = OracleTrace::new(0x41, 0x41, 3);  // 'A' -> 'A' (no change)
    traces[4] = OracleTrace::new(0x30, 0x30, 2);  // '0' -> '0' (no change)
    assert(traces[0].output_char == 0x41, "port: oracle 'a' -> 'A'");

    // ── Stage 2: Classify dialect surface ──
    let mut surface: DialectSurface = DialectSurface::new();
    let mut name_buf: Array(u8, 32) = Array::splat(0);
    name_buf[0] = 0x63; name_buf[1] = 0x74; name_buf[2] = 0x79; // "ctyp"
    name_buf[3] = 0x70; name_buf[4] = 0x65;                      // "e"
    surface = surface.classify(name_buf, 5);
    // (surface analyzed — complexity and operations recorded)

    // ── Stage 3: Write specification ──
    let mut spec: PortSpec = PortSpec::new();
    let mut spec_name: Array(u8, 48) = Array::splat(0);
    spec_name[0] = 0x74; spec_name[1] = 0x6F; spec_name[2] = 0x5F; // "to_u"
    spec_name[3] = 0x70; spec_name[4] = 0x70; spec_name[5] = 0x65; // "ppper"
    spec_name[6] = 0x72;
    spec = spec.define(spec_name, 7, 1, 1);

    // ── Stage 4: Implement native version ──
    assert(phor_to_upper(0x61) == 0x41, "port: 'a' -> 'A'");
    assert(phor_to_upper(0x7A) == 0x5A, "port: 'z' -> 'Z'");
    assert(phor_to_upper(0x41) == 0x41, "port: 'A' unchanged");
    assert(phor_to_upper(0x30) == 0x30, "port: '0' unchanged");
    assert(phor_to_upper(0x00) == 0x00, "port: null unchanged");

    // Test string version
    let mut input: Array(u8, 64) = Array::splat(0);
    input[0] = 0x68; input[1] = 0x65; input[2] = 0x6C; // "hel"
    input[3] = 0x6C; input[4] = 0x6F;                   // "lo"
    let output: Array(u8, 64) = phor_to_upper_str(input, 5);
    assert(output[0] == 0x48, "port: 'h' -> 'H'"); // H
    assert(output[1] == 0x45, "port: 'e' -> 'E'"); // E
    assert(output[2] == 0x4C, "port: 'l' -> 'L'"); // L
    assert(output[3] == 0x4C, "port: 'l' -> 'L'"); // L
    assert(output[4] == 0x4F, "port: 'o' -> 'O'"); // O

    // ── Stage 5: Verify against oracle traces ──
    let mut verification: VerificationResult = VerificationResult::new();

    // Test each oracle trace
    verification = verification.record_test(
        phor_to_upper(traces[0].input_char) == traces[0].output_char
    );
    verification = verification.record_test(
        phor_to_upper(traces[1].input_char) == traces[1].output_char
    );
    verification = verification.record_test(
        phor_to_upper(traces[2].input_char) == traces[2].output_char
    );
    verification = verification.record_test(
        phor_to_upper(traces[3].input_char) == traces[3].output_char
    );
    verification = verification.record_test(
        phor_to_upper(traces[4].input_char) == traces[4].output_char
    );

    assert(verification.all_pass(), "port: all oracle tests pass");
    assert(verification.tests_run == 5, "port: 5 tests run");
    assert(verification.tests_passed == 5, "port: 5 tests passed");

    // ── Stage 6: Promote through trust ladder ──
    let mut trust: TrustManager = TrustManager::new();
    assert(trust.current_level() == TRUST_UNKNOWN, "port: starts at Unknown");

    trust = trust.promote(); // -> Observed
    assert(trust.current_level() == TRUST_OBSERVED, "port: -> Observed");

    trust = trust.promote(); // -> Replayed
    assert(trust.current_level() == TRUST_REPLAYED, "port: -> Replayed");

    trust = trust.promote(); // -> Oracle
    assert(trust.current_level() == TRUST_ORACLE, "port: -> Oracle");

    trust = trust.promote(); // -> Residual
    assert(trust.current_level() == TRUST_RESIDUAL, "port: -> Residual");

    trust = trust.promote(); // -> Sealed
    assert(trust.current_level() == TRUST_SEALED, "port: -> Sealed");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute, residual]
{
    let passed: bool = test_full_port_pipeline();
    assert(passed, "full port: all pipeline stages pass");

    console.write(Str::from("Full Porting Pipeline:"));
    console.write(Str::from("  Stage 1 [Observe]:     Oracle traces captured OK"));
    console.write(Str::from("  Stage 2 [Analyze]:     Dialect surface classified OK"));
    console.write(Str::from("  Stage 3 [Specify]:     Port specification written OK"));
    console.write(Str::from("  Stage 4 [Implement]:   Native phor_to_upper verified OK"));
    console.write(Str::from("  Stage 5 [Verify]:      5/5 oracle tests passed OK"));
    console.write(Str::from("  Stage 6 [Promote]:     Unknown -> Sealed (6 steps) OK"));
    console.write(Str::from(""));
    console.write(Str::from("Full JIT porting pipeline validated!"));
    console.write(Str::from("Foreign 'toupper' successfully ported to Phorensic."));
}
