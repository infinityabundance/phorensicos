//==============================================================================
// win32_compat.phor — Win32 Compatibility Layer
//
// Provides Win32 API compatibility: PE loader, Win32 API dispatch, registry
// emulation, COM stubs, GDI emulation, window message translation, file
// handle mapping, error code translation, and CreateProcess emulation.
//
// All operations are capability-gated, bounded-loop, and residual-recorded.
//==============================================================================

module win32_compat
  @[receipt("win32-compat-v1")]
  @[audit("WIN32-COMPAT")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{syscall, alloc, unsafe, io};
use core::residual::*;
use core::mem::*;
use abi::syscall_interface::*;

//==============================================================================
// Win32 Error Code Translation
//==============================================================================

/// Win32 error codes (subset).
pub enum Win32Error : u32 {
  Success              = 0,
  InvalidFunction      = 1,
  FileNotFound         = 2,
  PathNotFound         = 3,
  TooManyOpenFiles     = 4,
  AccessDenied         = 5,
  InvalidHandle        = 6,
  NotEnoughMemory      = 8,
  InvalidData          = 13,
  OutOfMemory          = 14,
  NotReady             = 21,
  InvalidParameter     = 87,
  InsufficientBuffer   = 122,
  InvalidName          = 123,
  ModNotFound          = 126,
  ProcNotFound         = 127,
  WaitTimeout          = 258,
  AlreadyExists        = 183,
  MoreData             = 234,
  OperationCanceled    = 995,
  PipeBusy             = 231,
  PipeClosed           = 232,
  PipeConnected        = 233,
  PipeListening        = 234,
  Unknown              = 0xFFFFFFFF,
}

/// Translate Phorensic SyscallError to Win32 error code.
pub fn syscall_to_win32_error[err: SyscallError] -> Win32Error : effect:(pure) {
  match err {
    SyscallError::Success => Win32Error::Success,
    SyscallError::InvalidArgument => Win32Error::InvalidParameter,
    SyscallError::InvalidCapability => Win32Error::InvalidHandle,
    SyscallError::InsufficientRights => Win32Error::AccessDenied,
    SyscallError::BadAddress => Win32Error::InvalidParameter,
    SyscallError::ResourceExhausted => Win32Error::NotEnoughMemory,
    SyscallError::NotFound => Win32Error::FileNotFound,
    SyscallError::AlreadyExists => Win32Error::AlreadyExists,
    SyscallError::PermissionDenied => Win32Error::AccessDenied,
    SyscallError::WouldBlock => Win32Error::WaitTimeout,
    SyscallError::Interrupted => Win32Error::OperationCanceled,
    SyscallError::NotSupported => Win32Error::InvalidFunction,
    _ => Win32Error::Unknown,
  }
}

/// Translate Win32 error code to Phorensic SyscallError.
pub fn win32_error_to_syscall[err: Win32Error] -> SyscallError : effect:(pure) {
  match err {
    Win32Error::Success => SyscallError::Success,
    Win32Error::FileNotFound | Win32Error::PathNotFound => SyscallError::NotFound,
    Win32Error::AccessDenied => SyscallError::PermissionDenied,
    Win32Error::InvalidHandle => SyscallError::InvalidCapability,
    Win32Error::NotEnoughMemory | Win32Error::OutOfMemory => SyscallError::ResourceExhausted,
    Win32Error::InvalidParameter => SyscallError::InvalidArgument,
    Win32Error::AlreadyExists => SyscallError::AlreadyExists,
    Win32Error::WaitTimeout => SyscallError::WouldBlock,
    Win32Error::InvalidFunction => SyscallError::NotSupported,
    _ => SyscallError::InvalidArgument,
  }
}

//==============================================================================
// Win32 Handle Mapping
//==============================================================================

/// Win32 handle table.
pub struct Win32HandleTable(
  mappings: [HandleEntry; 1024],
  count: u32,
  next_handle: u32,
  cap: CapabilitySlot,
) : effect:(alloc, unsafe);

pub struct HandleEntry(
  win32_handle: u32,
  phor_handle: u64,
  type: Win32HandleType,
  flags: u32,
  is_open: bool,
) : effect:(pure);

pub enum Win32HandleType : u8 {
  File         = 0,
  Pipe         = 1,
  Process      = 2,
  Thread       = 3,
  Event        = 4,
  Mutex        = 5,
  Semaphore    = 6,
  Timer        = 7,
  FileMapping  = 8,
  Window       = 9,
  Menu         = 10,
  Cursor       = 11,
  Icon         = 12,
  RegistryKey  = 13,
  Module       = 14,
  Heap         = 15,
  Socket       = 16,
  Console      = 17,
  Device       = 18,
}

const INVALID_HANDLE_VALUE: u32 = 0xFFFFFFFF;

/// Open a Win32 handle from a Phorensic capability.
pub fn win32_open_handle[
  phor_handle: u64,
  htype: Win32HandleType,
  table: *Win32HandleTable,
] -> u32 : effect:(alloc, unsafe)
  loop: bounded(1)
{
  if table.count >= 1024 {
    return INVALID_HANDLE_VALUE;
  }

  let handle: u32 = table.next_handle;
  table.next_handle += 1;

  table.mappings[table.count] = HandleEntry(
    win32_handle: handle,
    phor_handle: phor_handle,
    type: htype,
    flags: 0,
    is_open: true,
  );
  table.count += 1;

  return handle;
}

/// Translate a Win32 handle to a Phorensic handle.
pub fn win32_translate_handle[
  win32_handle: u32,
  table: *Win32HandleTable,
  expected_type: Option[Win32HandleType],
] -> Result[u64, Win32Error] : (unsafe)
  loop: bounded(1024)
{
  for var i: u32 = 0; i < table.count; i += 1 {
    let entry: HandleEntry = table.mappings[i];
    if entry.win32_handle == win32_handle && entry.is_open {
      if let Some(exp) = expected_type {
        if entry.type != exp {
          return Err(Win32Error::InvalidHandle);
        }
      }
      return Ok(entry.phor_handle);
    }
  }
  return Err(Win32Error::InvalidHandle);
}

/// Close a Win32 handle.
pub fn win32_close_handle[
  win32_handle: u32,
  table: *Win32HandleTable,
] -> Result[(), Win32Error] : (unsafe)
  loop: bounded(1024)
{
  for var i: u32 = 0; i < table.count; i += 1 {
    if table.mappings[i].win32_handle == win32_handle && table.mappings[i].is_open {
      table.mappings[i].is_open = false;
      return Ok(());
    }
  }
  return Err(Win32Error::InvalidHandle);
}

//==============================================================================
// PE Loader
//==============================================================================

/// PE header structures (subset).
pub struct PeDosHeader(
  e_magic: u16,
  e_cblp: u16,
  e_cp: u16,
  e_crlc: u16,
  e_cparhdr: u16,
  e_minalloc: u16,
  e_maxalloc: u16,
  e_ss: u16,
  e_sp: u16,
  e_csum: u16,
  e_ip: u16,
  e_cs: u16,
  e_lfarlc: u16,
  e_ovno: u16,
  e_res: [u16; 4],
  e_oemid: u16,
  e_oeminfo: u16,
  e_res2: [u16; 10],
  e_lfanew: i32,
) : effect:(pure);

pub struct PeNtHeaders(
  signature: u32,
  machine: u16,
  number_of_sections: u16,
  time_date_stamp: u32,
  pointer_to_symbol_table: u32,
  number_of_symbols: u32,
  size_of_optional_header: u16,
  characteristics: u16,
  magic: u16,
  major_linker_version: u8,
  minor_linker_version: u8,
  size_of_code: u32,
  size_of_initialized_data: u32,
  size_of_uninitialized_data: u32,
  address_of_entry_point: u32,
  base_of_code: u32,
  base_of_data: u32,
  image_base: u64,
  section_alignment: u32,
  file_alignment: u32,
  major_os_version: u16,
  minor_os_version: u16,
  major_image_version: u16,
  minor_image_version: u16,
  major_subsystem_version: u16,
  minor_subsystem_version: u16,
  win32_version_value: u32,
  size_of_image: u32,
  size_of_headers: u32,
  check_sum: u32,
  subsystem: u16,
  dll_characteristics: u16,
  size_of_stack_reserve: u64,
  size_of_stack_commit: u64,
  size_of_heap_reserve: u64,
  size_of_heap_commit: u64,
  loader_flags: u32,
  number_of_rva_and_sizes: u32,
) : effect:(pure);

pub struct PeSectionHeader(
  name: [u8; 8],
  virtual_size: u32,
  virtual_address: u32,
  size_of_raw_data: u32,
  pointer_to_raw_data: u32,
  pointer_to_relocations: u32,
  pointer_to_linenumbers: u32,
  number_of_relocations: u16,
  number_of_linenumbers: u16,
  characteristics: u32,
) : effect:(pure);

/// Load a PE image into process memory.
pub fn pe_load_image[
  image_data: *u8,
  image_size: u32,
  load_cap: CapabilitySlot,
] -> Result[u64, Win32Error] : (syscall, alloc, unsafe)
  loop: bounded(256)
{
  // Validate DOS header
  let dos: *PeDosHeader = @int_to_ptr(image_data);
  if dos.e_magic != 0x5A4D { // "MZ"
    return Err(Win32Error::InvalidData);
  }

  // Validate NT headers
  let nt: *PeNtHeaders = @int_to_ptr(image_data + dos.e_lfanew);
  if nt.signature != 0x00004550 { // "PE\0\0"
    return Err(Win32Error::InvalidData);
  }

  let image_base: u64 = nt.image_base;
  let size_of_image: u32 = nt.size_of_image;

  // Allocate memory for the image
  let base_addr: u64 = allocate_image_memory(image_base, size_of_image, load_cap)?;

  // Copy headers
  @memcpy(@int_to_ptr(base_addr), image_data, nt.size_of_headers);

  // Copy sections
  let section_hdr: *PeSectionHeader = @int_to_ptr(
    image_data + dos.e_lfanew + 24 + nt.size_of_optional_header
  );

  for var i: u16 = 0; i < nt.number_of_sections; i += 1 {
    let shdr: PeSectionHeader = section_hdr[i];
    if shdr.pointer_to_raw_data != 0 && shdr.size_of_raw_data != 0 {
      let dest: *u8 = @int_to_ptr(base_addr + shdr.virtual_address);
      let src: *u8 = @int_to_ptr(image_data + shdr.pointer_to_raw_data);
      @memcpy(dest, src, shdr.size_of_raw_data);
    }
  }

  // Resolve imports
  pe_resolve_imports(base_addr, nt, load_cap)?;

  // Apply relocations
  pe_apply_relocations(base_addr, nt, image_data)?;

  record_win32_residual(Win32Op::PeLoad, base_addr, 0);

  return Ok(base_addr + nt.address_of_entry_point);
}

/// Resolve PE import table.
fn pe_resolve_imports[
  image_base: u64,
  nt: *PeNtHeaders,
  cap: CapabilitySlot,
] -> Result[(), Win32Error] : (syscall, alloc, unsafe)
  loop: bounded(256)
{
  // Simplified import resolution stub
  return Ok(());
}

/// Apply PE base relocations.
fn pe_apply_relocations[
  image_base: u64,
  nt: *PeNtHeaders,
  original_image: *u8,
] -> Result[(), Win32Error] : (unsafe)
  loop: bounded(65536)
{
  // Simplified relocation stub
  return Ok(());
}

fn allocate_image_memory[base: u64, size: u32, cap: CapabilitySlot] -> Result[u64, Win32Error> : (syscall, unsafe) {
  return Ok(base);
}

//==============================================================================
// Win32 API Dispatch
//==============================================================================

/// Win32 API function dispatch table.
pub struct Win32ApiDispatch(
  entries: [ApiEntry; 512],
  count: u32,
) : effect:(alloc);

pub struct ApiEntry(
  dll_name_hash: u64,
  function_name_hash: u64,
  ordinal: u16,
  handler: fn(*u8) : (syscall, alloc, unsafe),
  requires_cap: bool,
  cap_token: u64,
) : effect:(pure);

/// Dispatch a Win32 API call.
pub fn win32_dispatch[
  dll_name: *u8,
  function_name: *u8,
  ordinal: u16,
  args: *u8,
  arg_count: u32,
  table: *Win32ApiDispatch,
  caller_cap: CapabilitySlot,
] -> Result<u64, Win32Error> : (syscall, alloc, unsafe)
  loop: bounded(512)
{
  let dll_hash: u64 = hash_name(dll_name);
  let fn_hash: u64 = hash_name(function_name);

  for var i: u32 = 0; i < table.count; i += 1 {
    let entry: ApiEntry = table.entries[i];
    if entry.dll_name_hash == dll_hash &&
       (entry.function_name_hash == fn_hash || (fn_hash == 0 && entry.ordinal == ordinal)) {
      if entry.requires_cap {
        let rights: CapRights = CapRights(caller_cap.rights);
        if (rights & 1) == 0 {
          return Err(Win32Error::AccessDenied);
        }
      }
      return Ok(entry.handler(args));
    }
  }

  return Err(Win32Error::InvalidFunction);
}

/// Register a Win32 API handler.
pub fn win32_register_api[
  dll_name: *u8,
  function_name: *u8,
  ordinal: u16,
  handler: fn(*u8) : (syscall, alloc, unsafe),
  requires_cap: bool,
  table: *Win32ApiDispatch,
] -> Result[(), Win32Error> : effect:(alloc, unsafe)
  loop: bounded(1)
{
  if table.count >= 512 {
    return Err(Win32Error::TooManyOpenFiles);
  }

  table.entries[table.count] = ApiEntry(
    dll_name_hash: hash_name(dll_name),
    function_name_hash: hash_name(function_name),
    ordinal: ordinal,
    handler: handler,
    requires_cap: requires_cap,
    cap_token: 0,
  );
  table.count += 1;

  return Ok(());
}

/// Initialize the Win32 API dispatch table with common handlers.
pub fn win32_init_dispatch[] -> Win32ApiDispatch : effect:(alloc) {
  var table: Win32ApiDispatch = Win32ApiDispatch(entries: Default, count: 0);

  // Kernel32
  win32_register_api("kernel32.dll", "CreateFileW", 0, &win32_create_file_handler, true, &table);
  win32_register_api("kernel32.dll", "CloseHandle", 0, &win32_close_handle_handler, false, &table);
  win32_register_api("kernel32.dll", "ReadFile", 0, &win32_read_file_handler, false, &table);
  win32_register_api("kernel32.dll", "WriteFile", 0, &win32_write_file_handler, false, &table);
  win32_register_api("kernel32.dll", "GetLastError", 0, &win32_get_last_error_handler, false, &table);
  win32_register_api("kernel32.dll", "SetLastError", 0, &win32_set_last_error_handler, false, &table);
  win32_register_api("kernel32.dll", "CreateProcessW", 0, &win32_create_process_handler, true, &table);
  win32_register_api("kernel32.dll", "GetModuleHandleW", 0, &win32_get_module_handle_handler, false, &table);
  win32_register_api("kernel32.dll", "GetProcAddress", 0, &win32_get_proc_address_handler, false, &table);
  win32_register_api("kernel32.dll", "VirtualAlloc", 0, &win32_virtual_alloc_handler, true, &table);
  win32_register_api("kernel32.dll", "VirtualFree", 0, &win32_virtual_free_handler, true, &table);
  win32_register_api("kernel32.dll", "HeapAlloc", 0, &win32_heap_alloc_handler, false, &table);
  win32_register_api("kernel32.dll", "HeapFree", 0, &win32_heap_free_handler, false, &table);
  win32_register_api("kernel32.dll", "GetSystemInfo", 0, &win32_get_system_info_handler, false, &table);
  win32_register_api("kernel32.dll", "GetTickCount", 0, &win32_get_tick_count_handler, false, &table);
  win32_register_api("kernel32.dll", "Sleep", 0, &win32_sleep_handler, false, &table);
  win32_register_api("kernel32.dll", "SetEvent", 0, &win32_set_event_handler, false, &table);
  win32_register_api("kernel32.dll", "WaitForSingleObject", 0, &win32_wait_for_single_object_handler, false, &table);
  win32_register_api("kernel32.dll", "CreateEventW", 0, &win32_create_event_handler, false, &table);
  win32_register_api("kernel32.dll", "CreateMutexW", 0, &win32_create_mutex_handler, false, &table);
  win32_register_api("kernel32.dll", "ReleaseMutex", 0, &win32_release_mutex_handler, false, &table);
  win32_register_api("kernel32.dll", "GetCurrentProcessId", 0, &win32_get_current_process_id_handler, false, &table);
  win32_register_api("kernel32.dll", "GetCurrentThreadId", 0, &win32_get_current_thread_id_handler, false, &table);

  // User32
  win32_register_api("user32.dll", "CreateWindowExW", 0, &win32_create_window_handler, false, &table);
  win32_register_api("user32.dll", "DestroyWindow", 0, &win32_destroy_window_handler, false, &table);
  win32_register_api("user32.dll", "DefWindowProcW", 0, &win32_def_window_proc_handler, false, &table);
  win32_register_api("user32.dll", "GetMessageW", 0, &win32_get_message_handler, false, &table);
  win32_register_api("user32.dll", "DispatchMessageW", 0, &win32_dispatch_message_handler, false, &table);
  win32_register_api("user32.dll", "RegisterClassExW", 0, &win32_register_class_handler, false, &table);
  win32_register_api("user32.dll", "MessageBoxW", 0, &win32_message_box_handler, false, &table);
  win32_register_api("user32.dll", "SendMessageW", 0, &win32_send_message_handler, false, &table);
  win32_register_api("user32.dll", "PostMessageW", 0, &win32_post_message_handler, false, &table);

  // GDI32
  win32_register_api("gdi32.dll", "GetDC", 0, &win32_get_dc_handler, false, &table);
  win32_register_api("gdi32.dll", "ReleaseDC", 0, &win32_release_dc_handler, false, &table);
  win32_register_api("gdi32.dll", "CreateCompatibleDC", 0, &win32_create_compatible_dc_handler, false, &table);
  win32_register_api("gdi32.dll", "DeleteDC", 0, &win32_delete_dc_handler, false, &table);
  win32_register_api("gdi32.dll", "BitBlt", 0, &win32_bit_blt_handler, false, &table);
  win32_register_api("gdi32.dll", "CreateFontW", 0, &win32_create_font_handler, false, &table);
  win32_register_api("gdi32.dll", "SelectObject", 0, &win32_select_object_handler, false, &table);
  win32_register_api("gdi32.dll", "DeleteObject", 0, &win32_delete_object_handler, false, &table);

  // NTDLL
  win32_register_api("ntdll.dll", "RtlAllocateHeap", 0, &win32_rtl_alloc_heap_handler, false, &table);
  win32_register_api("ntdll.dll", "RtlFreeHeap", 0, &win32_rtl_free_heap_handler, false, &table);

  return table;
}

