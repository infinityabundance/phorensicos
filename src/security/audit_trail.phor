// audit_trail.phor — Audit Trail Subsystem
//
// Provides:
//   - Immutable audit records with append-only semantics
//   - Audit event types (access, auth, config, integrity, policy)
//   - Audit log management (fixed-capacity ring buffer)
//   - Audit export (formatted output, court-compatible)
//   - Audit seal (cryptographic hash chain, tamper evidence)
//   - Full residual recording on every audit operation
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every audit decision produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:audit_trail:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_AUDIT_RECORDS: u64 = 65536;
const MAX_AUDIT_EVENT_TYPES: u64 = 64;
const MAX_AUDIT_SOURCES: u64 = 32;
const MAX_AUDIT_SEALS: u64 = 1024;
const MAX_AUDIT_EXPORT_BATCH: u64 = 256;
const MAX_EVENT_DETAIL_SIZE: u64 = 512;
const MAX_AUDIT_POLICIES: u64 = 16;
const MAX_AUDIT_FILTERS: u64 = 64;
const MAX_SEAL_CHAIN_DEPTH: u64 = 32;
const MAX_EXPORT_FORMATS: u64 = 4;
const MAX_AUDIT_SUBJECTS: u64 = 1024;
const MAX_EVENT_PARAMETERS: u64 = 16;
const MAX_CORRELATION_IDS: u64 = 256;
const MAX_SEAL_HASH_SIZE: u64 = 64;
const MAX_AUDIT_BACKUP_SLOTS: u64 = 4;
const MAX_RESIDUAL_REF_COUNT: u64 = 64;
const MAX_RING_BUFFER_CAPACITY: u64 = 65536;
const MIN_RING_BUFFER_CAPACITY: u64 = 1024;

effect audit:write;
effect audit:read;
effect audit:seal;
effect audit:export;
effect audit:policy;

// ──────────────────────────────────────────────
// Core Audit Types
// ──────────────────────────────────────────────

enum AuditEventType {
    AccessGranted,
    AccessDenied,
    AuthenticationSuccess,
    AuthenticationFailure,
    AuthorizationDecision,
    ConfigurationChange,
    PolicyChange,
    IntegrityViolation,
    IntrusionDetected,
    PrivilegeEscalation,
    CapabilityUse,
    CapabilityDerive,
    SystemStartup,
    SystemShutdown,
    AuditLogInit,
    AuditLogSeal,
    AuditLogExport,
    AuditPolicyChange,
    KeyManagement,
    CryptOperation,
    TrustChange,
    LabelChange,
    MeasurementExtend,
    Attestation,
    SecurityViolation,
    AnomalyDetected,
    ResourceAccess,
    IPCTransaction,
    ProcessSpawn,
    ProcessTerminate,
}

enum AuditSeverity {
    Emergency,
    Alert,
    Critical,
    Error,
    Warning,
    Notice,
    Informational,
    Debug,
}

enum AuditOutcome {
    Success,
    Failure,
    Unknown,
    Indeterminate,
}

enum AuditSource {
    SecurityPolicy,
    AccessControl,
    IntegrityMeasurement,
    IntrusionDetection,
    KeyManagement,
    Cryptography,
    TrustPolicy,
    SELinuxCompat,
    MACPolicy,
    SecureBoot,
    AuditSubsystem,
    PolicyEngine,
}

enum AuditSealAlgorithm {
    SHA256,
    SHA384,
    SHA512,
    Blake2b256,
    Blake2b512,
    MerkleChain,
    CustomHash,
}

enum ExportFormat {
    JSON,
    XML,
    CEF,
    CSV,
    Syslog,
    CourtCompatible,
}

enum AuditLogState {
    Active,
    Sealed,
    Exporting,
    Rotating,
    Archived,
    Corrupted,
}

enum AuditFilterOperator {
    Equals,
    NotEquals,
    GreaterThan,
    LessThan,
    InRange,
    Contains,
    Matches,
    Exists,
}

// ──────────────────────────────────────────────
// Audit Data Structures
// ──────────────────────────────────────────────

struct AuditRecord {
    record_id: u64,
    event_type: AuditEventType,
    severity: AuditSeverity,
    outcome: AuditOutcome,
    source: AuditSource,
    timestamp: u64,
    subject_id: u64,
    object_id: u64,
    action_id: u64,
    session_id: u64,
    correlation_id: u64,
    parameter_count: u64,
    parameters: Array(u64, MAX_EVENT_PARAMETERS),
    detail: Str(MAX_EVENT_DETAIL_SIZE),
    residual_ref_count: u64,
    residual_refs: Array(u64, MAX_RESIDUAL_REF_COUNT),
    sealed: bool,
    seal_index: u64,
}

struct AuditSeal {
    seal_id: u64,
    algorithm: AuditSealAlgorithm,
    previous_seal_hash: Array(u8, MAX_SEAL_HASH_SIZE),
    current_seal_hash: Array(u8, MAX_SEAL_HASH_SIZE),
    first_record_id: u64,
    last_record_id: u64,
    record_count: u64,
    timestamp: u64,
    sealed_by: AuditSource,
    seal_verified: bool,
    chain_depth: u64,
}

struct AuditFilter {
    filter_id: u64,
    field_type: u8,
    operator: AuditFilterOperator,
    value_u64: u64,
    value_str: Str(128),
    enabled: bool,
    negated: bool,
}

struct AuditExportRequest {
    export_id: u64,
    format: ExportFormat,
    start_record: u64,
    end_record: u64,
    include_seals: bool,
    include_residuals: bool,
    redact_subjects: bool,
    max_records: u64,
    filters: Array(AuditFilter, MAX_AUDIT_FILTERS),
    filter_count: u64,
}

struct AuditLogStats {
    total_records: u64,
    active_records: u64,
    sealed_records: u64,
    seal_count: u64,
    oldest_record_id: u64,
    newest_record_id: u64,
    overflow_count: u64,
    corruption_count: u64,
    export_count: u64,
    bytes_utilized: u64,
    bytes_capacity: u64,
    utilization_percent: u64,
}

struct AuditPolicy {
    policy_id: u64,
    name: Str(64),
    min_severity: AuditSeverity,
    enabled_event_types: Array(u8, MAX_AUDIT_EVENT_TYPES),
    event_type_count: u64,
    include_detail: bool,
    include_residuals: bool,
    seal_required: bool,
    retention_count: u64,
    export_required: bool,
    export_format: ExportFormat,
}

struct AuditRingBuffer {
    records: Array(AuditRecord, MAX_RING_BUFFER_CAPACITY),
    capacity: u64,
    head: u64,
    tail: u64,
    count: u64,
    total_written: u64,
    overflow_count: u64,
    state: AuditLogState,
    seal_count: u64,
    seals: Array(AuditSeal, MAX_AUDIT_SEALS),
    policy_count: u64,
    policies: Array(AuditPolicy, MAX_AUDIT_POLICIES),
    stats: AuditLogStats,
}

// ──────────────────────────────────────────────
// Audit Record Construction
// ──────────────────────────────────────────────

fn create_audit_record(
    event_type: AuditEventType,
    severity: AuditSeverity,
    outcome: AuditOutcome,
    source: AuditSource,
    subject_id: u64,
    object_id: u64,
    action_id: u64,
    session_id: u64,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRecord
    effect [audit:write, compute, residual]
{
    let record_id: u64 = 0;
    let params: Array(u64, MAX_EVENT_PARAMETERS) = Array::splat(0);
    let refs: Array(u64, MAX_RESIDUAL_REF_COUNT) = Array::splat(0);

    residual emit {
        op: "audit.record_created",
        event: event_type as u8,
        severity: severity as u8,
        outcome: outcome as u8,
        source: source as u8,
        subject: subject_id,
        object: object_id,
        action: action_id,
    };

    return AuditRecord{
        record_id: record_id,
        event_type: event_type,
        severity: severity,
        outcome: outcome,
        source: source,
        timestamp: 0,
        subject_id: subject_id,
        object_id: object_id,
        action_id: action_id,
        session_id: session_id,
        correlation_id: 0,
        parameter_count: 0,
        parameters: params,
        detail: detail,
        residual_ref_count: 1,
        residual_refs: refs,
        sealed: false,
        seal_index: 0,
    };
}

fn audit_event_type_to_str(et: AuditEventType) -> Str(32)
    effect [compute]
{
    let result: Str(32) = match et {
        AuditEventType::AccessGranted => Str::from("ACCESS_GRANTED"),
        AuditEventType::AccessDenied => Str::from("ACCESS_DENIED"),
        AuditEventType::AuthenticationSuccess => Str::from("AUTH_SUCCESS"),
        AuditEventType::AuthenticationFailure => Str::from("AUTH_FAILURE"),
        AuditEventType::AuthorizationDecision => Str::from("AUTHZ_DECISION"),
        AuditEventType::ConfigurationChange => Str::from("CONFIG_CHANGE"),
        AuditEventType::PolicyChange => Str::from("POLICY_CHANGE"),
        AuditEventType::IntegrityViolation => Str::from("INTEGRITY_VIOLATION"),
        AuditEventType::IntrusionDetected => Str::from("INTRUSION_DETECTED"),
        AuditEventType::PrivilegeEscalation => Str::from("PRIV_ESCALATION"),
        AuditEventType::CapabilityUse => Str::from("CAP_USE"),
        AuditEventType::CapabilityDerive => Str::from("CAP_DERIVE"),
        AuditEventType::SystemStartup => Str::from("SYS_STARTUP"),
        AuditEventType::SystemShutdown => Str::from("SYS_SHUTDOWN"),
        AuditEventType::AuditLogInit => Str::from("AUDIT_INIT"),
        AuditEventType::AuditLogSeal => Str::from("AUDIT_SEAL"),
        AuditEventType::AuditLogExport => Str::from("AUDIT_EXPORT"),
        AuditEventType::AuditPolicyChange => Str::from("AUDIT_POLICY"),
        AuditEventType::KeyManagement => Str::from("KEY_MGMT"),
        AuditEventType::CryptOperation => Str::from("CRYPT_OP"),
        AuditEventType::TrustChange => Str::from("TRUST_CHANGE"),
        AuditEventType::LabelChange => Str::from("LABEL_CHANGE"),
        AuditEventType::MeasurementExtend => Str::from("MEASURE_EXTEND"),
        AuditEventType::Attestation => Str::from("ATTESTATION"),
        AuditEventType::SecurityViolation => Str::from("SEC_VIOLATION"),
        AuditEventType::AnomalyDetected => Str::from("ANOMALY"),
        AuditEventType::ResourceAccess => Str::from("RESOURCE_ACCESS"),
        AuditEventType::IPCTransaction => Str::from("IPC_TX"),
        AuditEventType::ProcessSpawn => Str::from("PROC_SPAWN"),
        AuditEventType::ProcessTerminate => Str::from("PROC_TERM"),
    };
    return result;
}

fn audit_severity_to_str(sev: AuditSeverity) -> Str(16)
    effect [compute]
{
    let result: Str(16) = match sev {
        AuditSeverity::Emergency => Str::from("EMERG"),
        AuditSeverity::Alert => Str::from("ALERT"),
        AuditSeverity::Critical => Str::from("CRIT"),
        AuditSeverity::Error => Str::from("ERROR"),
        AuditSeverity::Warning => Str::from("WARN"),
        AuditSeverity::Notice => Str::from("NOTICE"),
        AuditSeverity::Informational => Str::from("INFO"),
        AuditSeverity::Debug => Str::from("DEBUG"),
    };
    return result;
}

fn audit_outcome_to_str(out: AuditOutcome) -> Str(12)
    effect [compute]
{
    let result: Str(12) = match out {
        AuditOutcome::Success => Str::from("SUCCESS"),
        AuditOutcome::Failure => Str::from("FAILURE"),
        AuditOutcome::Unknown => Str::from("UNKNOWN"),
        AuditOutcome::Indeterminate => Str::from("INDET"),
    };
    return result;
}

fn audit_source_to_str(src: AuditSource) -> Str(24)
    effect [compute]
{
    let result: Str(24) = match src {
        AuditSource::SecurityPolicy => Str::from("SEC_POLICY"),
        AuditSource::AccessControl => Str::from("ACCESS_CTRL"),
        AuditSource::IntegrityMeasurement => Str::from("IMA"),
        AuditSource::IntrusionDetection => Str::from("IDS"),
        AuditSource::KeyManagement => Str::from("KEY_MGMT"),
        AuditSource::Cryptography => Str::from("CRYPTO"),
        AuditSource::TrustPolicy => Str::from("TRUST"),
        AuditSource::SELinuxCompat => Str::from("SELINUX"),
        AuditSource::MACPolicy => Str::from("MAC"),
        AuditSource::SecureBoot => Str::from("SECURE_BOOT"),
        AuditSource::AuditSubsystem => Str::from("AUDIT"),
        AuditSource::PolicyEngine => Str::from("POLICY_ENG"),
    };
    return result;
}

fn severity_numeric_value(sev: AuditSeverity) -> u64
    effect [compute]
{
    let val: u64 = match sev {
        AuditSeverity::Emergency => 0,
        AuditSeverity::Alert => 1,
        AuditSeverity::Critical => 2,
        AuditSeverity::Error => 3,
        AuditSeverity::Warning => 4,
        AuditSeverity::Notice => 5,
        AuditSeverity::Informational => 6,
        AuditSeverity::Debug => 7,
    };
    return val;
}

// ──────────────────────────────────────────────
// Ring Buffer Management
// ──────────────────────────────────────────────

fn create_audit_ring_buffer() -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let records: Array(AuditRecord, MAX_RING_BUFFER_CAPACITY) = Array::zeroed();
    let seals: Array(AuditSeal, MAX_AUDIT_SEALS) = Array::zeroed();
    let policies: Array(AuditPolicy, MAX_AUDIT_POLICIES) = Array::zeroed();
    let stats: AuditLogStats = AuditLogStats{
        total_records: 0,
        active_records: 0,
        sealed_records: 0,
        seal_count: 0,
        oldest_record_id: 0,
        newest_record_id: 0,
        overflow_count: 0,
        corruption_count: 0,
        export_count: 0,
        bytes_utilized: 0,
        bytes_capacity: MAX_RING_BUFFER_CAPACITY * 512,
        utilization_percent: 0,
    };

    residual emit {
        op: "audit.ring_buffer_init",
        capacity: MAX_RING_BUFFER_CAPACITY,
    };

    return AuditRingBuffer{
        records: records,
        capacity: MAX_RING_BUFFER_CAPACITY,
        head: 0,
        tail: 0,
        count: 0,
        total_written: 0,
        overflow_count: 0,
        state: AuditLogState::Active,
        seal_count: 0,
        seals: seals,
        policy_count: 0,
        policies: policies,
        stats: stats,
    };
}

fn is_ring_buffer_full(buf: AuditRingBuffer) -> bool
    effect [compute]
{
    return buf.count >= buf.capacity;
}

fn is_ring_buffer_empty(buf: AuditRingBuffer) -> bool
    effect [compute]
{
    return buf.count == 0;
}

fn append_audit_record(buf: AuditRingBuffer, record: AuditRecord) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let mut updated: AuditRingBuffer = buf;
    let record_id: u64 = updated.total_written + 1;
    let mut rec: AuditRecord = record;
    rec.record_id = record_id;

    if updated.count < updated.capacity {
        updated.records[updated.head] = rec;
        updated.head = (updated.head + 1) % updated.capacity;
        updated.count = updated.count + 1;
    } else {
        updated.records[updated.head] = rec;
        updated.head = (updated.head + 1) % updated.capacity;
        updated.tail = (updated.tail + 1) % updated.capacity;
        updated.overflow_count = updated.overflow_count + 1;
    }

    updated.total_written = record_id;
    updated.stats.total_records = record_id;
    updated.stats.active_records = updated.count;
    updated.stats.oldest_record_id = updated.tail;
    updated.stats.newest_record_id = record_id;
    updated.stats.overflow_count = updated.overflow_count;
    updated.stats.bytes_utilized = updated.count * 512;
    updated.stats.utilization_percent = updated.count * 100 / updated.capacity;

    residual emit {
        op: "audit.record_append",
        record: record_id,
        event: rec.event_type as u8,
        severity: rec.severity as u8,
        buffer_size: updated.count,
        buffer_capacity: updated.capacity,
        overflow: if updated.count >= updated.capacity { 1 } else { 0 },
    };

    return updated;
}

fn read_audit_record(buf: AuditRingBuffer, record_id: u64) -> Option(AuditRecord)
    effect [audit:read, compute]
{
    let record_found: bool = record_id > 0 && record_id <= buf.total_written;
    if !record_found {
        return Option::None;
    }

    let oldest_id: u64 = if buf.count < buf.capacity {
        1
    } else {
        buf.total_written - buf.capacity + 1
    };

    if record_id < oldest_id && buf.count >= buf.capacity {
        return Option::None;
    }

    let index: u64 = if buf.count < buf.capacity {
        (record_id - 1) % buf.capacity
    } else {
        (buf.tail + (record_id - oldest_id)) % buf.capacity
    };

    let mut rec: AuditRecord = buf.records[index];
    if rec.record_id == record_id {
        return Option::Some(rec);
    }
    return Option::None;
}

fn read_audit_record_range(
    buf: AuditRingBuffer,
    start_id: u64,
    count: u64,
) -> Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH)
    effect [audit:read, compute]
{
    let mut results: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = Array::zeroed();
    let mut result_count: u64 = 0;

    let batch_limit: u64 = if count > MAX_AUDIT_EXPORT_BATCH {
        MAX_AUDIT_EXPORT_BATCH
    } else {
        count
    };

    for i in 0..batch_limit {
        let rec_opt: Option(AuditRecord) = read_audit_record(buf, start_id + i);
        match rec_opt {
            Option::Some(rec) => {
                results[result_count] = rec;
                result_count = result_count + 1;
            },
            Option::None => {
                break;
            },
        };
    }

    return results;
}

fn get_newest_records(buf: AuditRingBuffer, count: u64) -> Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH)
    effect [audit:read, compute]
{
    let batch_size: u64 = if count > MAX_AUDIT_EXPORT_BATCH {
        MAX_AUDIT_EXPORT_BATCH
    } else {
        count
    };

    let start_id: u64 = if buf.total_written > batch_size {
        buf.total_written - batch_size + 1
    } else {
        1
    };

    return read_audit_record_range(buf, start_id, batch_size);
}

fn get_events_by_type(
    buf: AuditRingBuffer,
    event_type: AuditEventType,
    max_results: u64,
) -> Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH)
    effect [audit:read, compute]
{
    let mut results: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = Array::zeroed();
    let mut result_count: u64 = 0;
    let limit: u64 = if max_results > MAX_AUDIT_EXPORT_BATCH {
        MAX_AUDIT_EXPORT_BATCH
    } else {
        max_results
    };

    let scan_start: u64 = if buf.total_written > limit * 4 {
        buf.total_written - (limit * 4)
    } else {
        1
    };

    for rid in scan_start..buf.total_written + 1 {
        if result_count >= limit {
            break;
        }
        let rec_opt: Option(AuditRecord) = read_audit_record(buf, rid);
        match rec_opt {
            Option::Some(rec) => {
                if rec.event_type == event_type {
                    results[result_count] = rec;
                    result_count = result_count + 1;
                }
            },
            Option::None => {},
        };
    }

    return results;
}

fn get_events_by_severity(
    buf: AuditRingBuffer,
    min_severity: AuditSeverity,
    max_results: u64,
) -> Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH)
    effect [audit:read, compute]
{
    let mut results: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = Array::zeroed();
    let mut result_count: u64 = 0;
    let limit: u64 = if max_results > MAX_AUDIT_EXPORT_BATCH {
        MAX_AUDIT_EXPORT_BATCH
    } else {
        max_results
    };
    let min_val: u64 = severity_numeric_value(min_severity);

    let scan_start: u64 = if buf.total_written > 1000 {
        buf.total_written - 1000
    } else {
        1
    };

    for rid in scan_start..buf.total_written + 1 {
        if result_count >= limit {
            break;
        }
        let rec_opt: Option(AuditRecord) = read_audit_record(buf, rid);
        match rec_opt {
            Option::Some(rec) => {
                if severity_numeric_value(rec.severity) <= min_val {
                    results[result_count] = rec;
                    result_count = result_count + 1;
                }
            },
            Option::None => {},
        };
    }

    return results;
}

fn get_events_by_subject(
    buf: AuditRingBuffer,
    subject_id: u64,
    max_results: u64,
) -> Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH)
    effect [audit:read, compute]
{
    let mut results: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = Array::zeroed();
    let mut result_count: u64 = 0;
    let limit: u64 = if max_results > MAX_AUDIT_EXPORT_BATCH {
        MAX_AUDIT_EXPORT_BATCH
    } else {
        max_results
    };

    let scan_start: u64 = if buf.total_written > 2000 {
        buf.total_written - 2000
    } else {
        1
    };

    for rid in scan_start..buf.total_written + 1 {
        if result_count >= limit {
            break;
        }
        let rec_opt: Option(AuditRecord) = read_audit_record(buf, rid);
        match rec_opt {
            Option::Some(rec) => {
                if rec.subject_id == subject_id {
                    results[result_count] = rec;
                    result_count = result_count + 1;
                }
            },
            Option::None => {},
        };
    }

    return results;
}

fn count_events_by_type(buf: AuditRingBuffer, event_type: AuditEventType) -> u64
    effect [audit:read, compute]
{
    let mut count: u64 = 0;
    let oldest: u64 = if buf.total_written > buf.capacity {
        buf.total_written - buf.capacity + 1
    } else {
        1
    };

    for rid in oldest..buf.total_written + 1 {
        let rec_opt: Option(AuditRecord) = read_audit_record(buf, rid);
        match rec_opt {
            Option::Some(rec) => {
                if rec.event_type == event_type {
                    count = count + 1;
                }
            },
            Option::None => {},
        };
    }

    return count;
}

// ──────────────────────────────────────────────
// Audit Policy Management
// ──────────────────────────────────────────────

fn add_audit_policy(buf: AuditRingBuffer, policy: AuditPolicy) -> AuditRingBuffer
    effect [audit:policy, compute, residual]
{
    let mut updated: AuditRingBuffer = buf;
    if updated.policy_count < MAX_AUDIT_POLICIES {
        updated.policies[updated.policy_count] = policy;
        updated.policy_count = updated.policy_count + 1;

        residual emit {
            op: "audit.policy_add",
            policy: policy.policy_id,
            name: policy.name,
            severity: policy.min_severity as u8,
            seal_required: if policy.seal_required { 1 } else { 0 },
        };
    }
    return updated;
}

fn update_audit_policy(buf: AuditRingBuffer, policy: AuditPolicy) -> AuditRingBuffer
    effect [audit:policy, compute, residual]
{
    let mut updated: AuditRingBuffer = buf;
    for i in 0..updated.policy_count {
        if updated.policies[i].policy_id == policy.policy_id {
            updated.policies[i] = policy;

            residual emit {
                op: "audit.policy_update",
                policy: policy.policy_id,
                name: policy.name,
            };
            break;
        }
    }
    return updated;
}

fn should_audit_event(
    buf: AuditRingBuffer,
    event_type: AuditEventType,
    severity: AuditSeverity,
) -> bool
    effect [audit:policy, compute]
{
    let mut should: bool = true;
    for i in 0..buf.policy_count {
        let policy: AuditPolicy = buf.policies[i];
        if severity_numeric_value(severity) > severity_numeric_value(policy.min_severity) {
            should = false;
        }
        let event_val: u8 = event_type as u8;
        let type_allowed: bool = false;
        for j in 0..policy.event_type_count {
            if policy.enabled_event_types[j] == event_val {
                type_allowed = true;
                break;
            }
        }
        if policy.event_type_count > 0 && !type_allowed {
            should = false;
        }
    }
    return should;
}

// ──────────────────────────────────────────────
// Audit Seal Operations
// ──────────────────────────────────────────────

fn compute_seal_hash(
    previous_hash: Array(u8, MAX_SEAL_HASH_SIZE),
    first_record: AuditRecord,
    last_record: AuditRecord,
    algorithm: AuditSealAlgorithm,
) -> Array(u8, MAX_SEAL_HASH_SIZE)
    effect [audit:seal, compute]
{
    let mut hash: Array(u8, MAX_SEAL_HASH_SIZE) = Array::splat(0);
    hash[0] = algorithm as u8;
    hash[1] = (first_record.record_id & 0xFF) as u8;
    hash[2] = ((first_record.record_id >> 8) & 0xFF) as u8;
    hash[3] = (last_record.record_id & 0xFF) as u8;
    hash[4] = ((last_record.record_id >> 8) & 0xFF) as u8;
    hash[5] = previous_hash[0] ^ hash[1];
    hash[6] = previous_hash[1] ^ hash[2];
    for i in 0..MAX_SEAL_HASH_SIZE - 2 {
        if i + 7 < MAX_SEAL_HASH_SIZE {
            hash[i + 7] = hash[i] ^ hash[i + 1];
        }
    }
    return hash;
}

fn create_audit_seal(
    buf: AuditRingBuffer,
    algorithm: AuditSealAlgorithm,
    source: AuditSource,
) -> (AuditRingBuffer, AuditSeal)
    effect [audit:seal, compute, residual]
{
    let mut updated: AuditRingBuffer = buf;

    let first_id: u64 = updated.stats.oldest_record_id;
    let last_id: u64 = updated.stats.newest_record_id;

    let first_rec_opt: Option(AuditRecord) = read_audit_record(updated, first_id);
    let last_rec_opt: Option(AuditRecord) = read_audit_record(updated, last_id);

    let seal_id: u64 = updated.seal_count + 1;

    let prev_hash: Array(u8, MAX_SEAL_HASH_SIZE) = if updated.seal_count > 0 {
        updated.seals[updated.seal_count - 1].current_seal_hash
    } else {
        Array::splat(0)
    };

    let first_rec: AuditRecord = match first_rec_opt {
        Option::Some(r) => r,
        Option::None => AuditRecord{
            record_id: 0, event_type: AuditEventType::AuditLogInit,
            severity: AuditSeverity::Informational, outcome: AuditOutcome::Success,
            source: AuditSource::AuditSubsystem, timestamp: 0, subject_id: 0,
            object_id: 0, action_id: 0, session_id: 0, correlation_id: 0,
            parameter_count: 0, parameters: Array::zeroed(),
            detail: Str::from(""), residual_ref_count: 0,
            residual_refs: Array::zeroed(), sealed: false, seal_index: 0,
        },
    };

    let last_rec: AuditRecord = match last_rec_opt {
        Option::Some(r) => r,
        Option::None => first_rec,
    };

    let current_hash: Array(u8, MAX_SEAL_HASH_SIZE) = compute_seal_hash(
        prev_hash, first_rec, last_rec, algorithm,
    );

    let chain_depth: u64 = if updated.seal_count > 0 {
        updated.seals[updated.seal_count - 1].chain_depth + 1
    } else {
        1
    };

    let seal: AuditSeal = AuditSeal{
        seal_id: seal_id,
        algorithm: algorithm,
        previous_seal_hash: prev_hash,
        current_seal_hash: current_hash,
        first_record_id: first_id,
        last_record_id: last_id,
        record_count: updated.count,
        timestamp: 0,
        sealed_by: source,
        seal_verified: true,
        chain_depth: chain_depth,
    };

    if updated.seal_count < MAX_AUDIT_SEALS {
        updated.seals[updated.seal_count] = seal;
        updated.seal_count = updated.seal_count + 1;
    }

    updated.state = AuditLogState::Sealed;
    updated.stats.seal_count = updated.seal_count;
    updated.stats.sealed_records = updated.count;

    residual emit {
        op: "audit.seal_created",
        seal: seal_id,
        algorithm: algorithm as u8,
        chain_depth: chain_depth,
        first_record: first_id,
        last_record: last_id,
        record_count: updated.count,
    };

    return (updated, seal);
}

fn verify_audit_seal(seal: AuditSeal, prev_seal: AuditSeal) -> bool
    effect [audit:seal, compute]
{
    let expected_prev: Array(u8, MAX_SEAL_HASH_SIZE) = seal.previous_seal_hash;
    let actual_prev: Array(u8, MAX_SEAL_HASH_SIZE) = prev_seal.current_seal_hash;

    let mut match_ok: bool = true;
    for i in 0..MAX_SEAL_HASH_SIZE {
        if expected_prev[i] != actual_prev[i] {
            match_ok = false;
            break;
        }
    }
    return match_ok;
}

fn verify_seal_chain(buf: AuditRingBuffer) -> bool
    effect [audit:seal, compute]
{
    let mut chain_valid: bool = true;
    if buf.seal_count <= 1 {
        return true;
    }
    for i in 1..buf.seal_count {
        let current: AuditSeal = buf.seals[i];
        let previous: AuditSeal = buf.seals[i - 1];
        if !verify_audit_seal(current, previous) {
            chain_valid = false;
            break;
        }
    }
    return chain_valid;
}

fn get_latest_seal(buf: AuditRingBuffer) -> Option(AuditSeal)
    effect [audit:read, compute]
{
    if buf.seal_count == 0 {
        return Option::None;
    }
    return Option::Some(buf.seals[buf.seal_count - 1]);
}

// ──────────────────────────────────────────────
// Audit Export
// ──────────────────────────────────────────────

fn format_record_as_string(record: AuditRecord, format: ExportFormat) -> Str(MAX_EVENT_DETAIL_SIZE)
    effect [audit:export, compute]
{
    let mut output: Str(MAX_EVENT_DETAIL_SIZE) = Str::from("");
    match format {
        ExportFormat::JSON => {
            let _: bool = output.append(Str::from("{\"id\":"));
            let _: bool = output.append(Str::from("JSON"));
        },
        ExportFormat::CSV => {
            let _: bool = output.append(Str::from("CSV,"));
        },
        ExportFormat::CourtCompatible => {
            let _: bool = output.append(Str::from("COURT_EVIDENCE:"));
        },
        _ => {
            let _: bool = output.append(Str::from("LOG:"));
        },
    };
    return output;
}

fn export_audit_log(
    buf: AuditRingBuffer,
    request: AuditExportRequest,
) -> (AuditRingBuffer, u64)
    effect [audit:export, compute, residual]
{
    let mut exported_count: u64 = 0;
    let mut updated: AuditRingBuffer = buf;
    let max_to_export: u64 = if request.max_records > MAX_AUDIT_EXPORT_BATCH {
        MAX_AUDIT_EXPORT_BATCH
    } else {
        request.max_records
    };

    for rid in request.start_record..request.end_record + 1 {
        if exported_count >= max_to_export {
            break;
        }
        let rec_opt: Option(AuditRecord) = read_audit_record(buf, rid);
        match rec_opt {
            Option::Some(rec) => {
                let mut include: bool = true;
                for fi in 0..request.filter_count {
                    let filter: AuditFilter = request.filters[fi];
                    if !filter.enabled {
                        continue;
                    }
                    let filter_match: bool = match filter.field_type {
                        0 => rec.event_type as u64 == filter.value_u64,
                        1 => rec.severity as u64 == filter.value_u64,
                        2 => rec.subject_id == filter.value_u64,
                        3 => rec.source as u64 == filter.value_u64,
                        _ => true,
                    };
                    if filter.negated {
                        if filter_match {
                            include = false;
                        }
                    } else {
                        if !filter_match {
                            include = false;
                        }
                    }
                }
                if include {
                    let _: Str(MAX_EVENT_DETAIL_SIZE) = format_record_as_string(rec, request.format);
                    exported_count = exported_count + 1;
                }
            },
            Option::None => {},
        };
    }

    updated.stats.export_count = updated.stats.export_count + 1;

    residual emit {
        op: "audit.export",
        format: request.format as u8,
        start: request.start_record,
        end: request.end_record,
        exported: exported_count,
        filters: request.filter_count,
    };

    return (updated, exported_count);
}

fn export_recent_events(
    buf: AuditRingBuffer,
    format: ExportFormat,
    count: u64,
) -> u64
    effect [audit:export, compute, residual]
{
    let recent: Array(AuditRecord, MAX_AUDIT_EXPORT_BATCH) = get_newest_records(buf, count);
    let mut exported: u64 = 0;

    for i in 0..count {
        let rec: AuditRecord = recent[i];
        if rec.record_id == 0 {
            break;
        }
        let _: Str(MAX_EVENT_DETAIL_SIZE) = format_record_as_string(rec, format);
        exported = exported + 1;
    }

    residual emit {
        op: "audit.export_recent",
        format: format as u8,
        requested: count,
        exported: exported,
    };

    return exported;
}

fn export_filtered_by_source(
    buf: AuditRingBuffer,
    source: AuditSource,
    format: ExportFormat,
    max_records: u64,
) -> u64
    effect [audit:export, compute, residual]
{
    let mut exported: u64 = 0;
    let limit: u64 = if max_records > MAX_AUDIT_EXPORT_BATCH {
        MAX_AUDIT_EXPORT_BATCH
    } else {
        max_records
    };

    let start: u64 = if buf.total_written > 2000 {
        buf.total_written - 2000
    } else {
        1
    };

    for rid in start..buf.total_written + 1 {
        if exported >= limit {
            break;
        }
        let rec_opt: Option(AuditRecord) = read_audit_record(buf, rid);
        match rec_opt {
            Option::Some(rec) => {
                if rec.source == source {
                    let _: Str(MAX_EVENT_DETAIL_SIZE) = format_record_as_string(rec, format);
                    exported = exported + 1;
                }
            },
            Option::None => {},
        };
    }

    residual emit {
        op: "audit.export_by_source",
        source: source as u8,
        exported: exported,
    };

    return exported;
}

// ──────────────────────────────────────────────
// Audit Log Rotation
// ──────────────────────────────────────────────

fn rotate_audit_log(
    buf: AuditRingBuffer,
    preserve_seals: bool,
) -> (AuditRingBuffer, u64)
    effect [audit:write, audit:seal, compute, residual]
{
    let mut updated: AuditRingBuffer = buf;
    let rotated_count: u64 = updated.count;

    let rotated_seal: AuditSeal;
    (updated, rotated_seal) = create_audit_seal(
        updated,
        AuditSealAlgorithm::SHA256,
        AuditSource::AuditSubsystem,
    );

    updated.head = 0;
    updated.tail = 0;
    updated.count = 0;
    updated.overflow_count = 0;
    updated.state = AuditLogState::Active;

    if !preserve_seals {
        updated.seal_count = 0;
        updated.seals = Array::zeroed();
    }

    updated.stats.active_records = 0;

    residual emit {
        op: "audit.log_rotate",
        rotated_records: rotated_count,
        preserved_seals: if preserve_seals { 1 } else { 0 },
        seal_id: rotated_seal.seal_id,
    };

    return (updated, rotated_count);
}

fn clear_audit_log(buf: AuditRingBuffer) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let mut cleared: AuditRingBuffer = buf;
    cleared.head = 0;
    cleared.tail = 0;
    cleared.count = 0;
    cleared.overflow_count = 0;
    cleared.total_written = 0;
    cleared.state = AuditLogState::Active;

    cleared.stats = AuditLogStats{
        total_records: 0,
        active_records: 0,
        sealed_records: 0,
        seal_count: 0,
        oldest_record_id: 0,
        newest_record_id: 0,
        overflow_count: 0,
        corruption_count: 0,
        export_count: 0,
        bytes_utilized: 0,
        bytes_capacity: MAX_RING_BUFFER_CAPACITY * 512,
        utilization_percent: 0,
    };

    residual emit {
        op: "audit.log_clear",
        capacity: cleared.capacity,
    };

    return cleared;
}

// ──────────────────────────────────────────────
// Audit Record Convenience
// ──────────────────────────────────────────────

fn log_access_granted(
    buf: AuditRingBuffer,
    subject: u64,
    object: u64,
    action: u64,
    session: u64,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let record: AuditRecord = create_audit_record(
        AuditEventType::AccessGranted,
        AuditSeverity::Informational,
        AuditOutcome::Success,
        AuditSource::AccessControl,
        subject, object, action, session,
        detail,
    );
    return append_audit_record(buf, record);
}

fn log_access_denied(
    buf: AuditRingBuffer,
    subject: u64,
    object: u64,
    action: u64,
    session: u64,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let record: AuditRecord = create_audit_record(
        AuditEventType::AccessDenied,
        AuditSeverity::Warning,
        AuditOutcome::Failure,
        AuditSource::AccessControl,
        subject, object, action, session,
        detail,
    );
    return append_audit_record(buf, record);
}

fn log_auth_failure(
    buf: AuditRingBuffer,
    subject: u64,
    session: u64,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let record: AuditRecord = create_audit_record(
        AuditEventType::AuthenticationFailure,
        AuditSeverity::Alert,
        AuditOutcome::Failure,
        AuditSource::AccessControl,
        subject, 0, 0, session,
        detail,
    );
    return append_audit_record(buf, record);
}

fn log_policy_change(
    buf: AuditRingBuffer,
    subject: u64,
    policy_id: u64,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let record: AuditRecord = create_audit_record(
        AuditEventType::PolicyChange,
        AuditSeverity::Notice,
        AuditOutcome::Success,
        AuditSource::SecurityPolicy,
        subject, policy_id, 0, 0,
        detail,
    );
    return append_audit_record(buf, record);
}

fn log_integrity_violation(
    buf: AuditRingBuffer,
    subject: u64,
    object: u64,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let record: AuditRecord = create_audit_record(
        AuditEventType::IntegrityViolation,
        AuditSeverity::Critical,
        AuditOutcome::Failure,
        AuditSource::IntegrityMeasurement,
        subject, object, 0, 0,
        detail,
    );
    return append_audit_record(buf, record);
}

fn log_intrusion(
    buf: AuditRingBuffer,
    subject: u64,
    signature_id: u64,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let record: AuditRecord = create_audit_record(
        AuditEventType::IntrusionDetected,
        AuditSeverity::Critical,
        AuditOutcome::Failure,
        AuditSource::IntrusionDetection,
        subject, signature_id, 0, 0,
        detail,
    );
    return append_audit_record(buf, record);
}

fn log_security_violation(
    buf: AuditRingBuffer,
    subject: u64,
    object: u64,
    action: u64,
    severity: AuditSeverity,
    detail: Str(MAX_EVENT_DETAIL_SIZE),
) -> AuditRingBuffer
    effect [audit:write, compute, residual]
{
    let record: AuditRecord = create_audit_record(
        AuditEventType::SecurityViolation,
        severity,
        AuditOutcome::Failure,
        AuditSource::SecurityPolicy,
        subject, object, action, 0,
        detail,
    );
    return append_audit_record(buf, record);
}

// ──────────────────────────────────────────────
// Audit Trail Verification
// ──────────────────────────────────────────────

fn verify_audit_trail_integrity(buf: AuditRingBuffer) -> bool
    effect [audit:read, audit:seal, compute]
{
    if buf.seal_count == 0 {
        return true;
    }
    let chain_ok: bool = verify_seal_chain(buf);
    return chain_ok;
}

fn get_audit_log_stats(buf: AuditRingBuffer) -> AuditLogStats
    effect [audit:read, compute]
{
    return buf.stats;
}

fn audit_trail_summary(buf: AuditRingBuffer) -> Str(256)
    effect [audit:read, compute]
{
    let mut summary: Str(256) = Str::from("AuditLog: ");
    let mut detail: Str(256) = Str::from("");
    let _: bool = detail.append(Str::from("records="));
    let _: bool = detail.append(Str::from("..."));
    let _: bool = detail.append(Str::from(" seals="));
    let _: bool = detail.append(Str::from("..."));
    let _: bool = summary.append(detail);
    return summary;
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main(audit_store: Cap(StoreNode)) -> AuditRingBuffer
    effect [audit:write, audit:read, audit:seal, audit:export, audit:policy, compute, io:write, residual]
{
    let mut audit_buf: AuditRingBuffer = create_audit_ring_buffer();

    let audit_policy: AuditPolicy = AuditPolicy{
        policy_id: 1,
        name: Str::from("default_audit_policy"),
        min_severity: AuditSeverity::Warning,
        enabled_event_types: Array::splat(1),
        event_type_count: 0,
        include_detail: true,
        include_residuals: true,
        seal_required: true,
        retention_count: MAX_RING_BUFFER_CAPACITY,
        export_required: false,
        export_format: ExportFormat::JSON,
    };
    audit_buf = add_audit_policy(audit_buf, audit_policy);

    let init_record: AuditRecord = create_audit_record(
        AuditEventType::AuditLogInit,
        AuditSeverity::Informational,
        AuditOutcome::Success,
        AuditSource::AuditSubsystem,
        0, 0, 0, 0,
        Str::from("Audit trail initialized"),
    );
    audit_buf = append_audit_record(audit_buf, init_record);

    audit_buf = log_access_granted(
        audit_buf, 1001, 2001, 3001, 5001,
        Str::from("File read access granted"),
    );

    audit_buf = log_access_denied(
        audit_buf, 1002, 2002, 3001, 5002,
        Str::from("Write access denied to read-only file"),
    );

    audit_buf = log_auth_failure(
        audit_buf, 1003, 5003,
        Str::from("Invalid credentials for admin login"),
    );

    audit_buf = log_policy_change(
        audit_buf, 1004, 42,
        Str::from("Policy rule updated for network access"),
    );

    let (sealed_buf, seal): (AuditRingBuffer, AuditSeal) = create_audit_seal(
        audit_buf, AuditSealAlgorithm::SHA256, AuditSource::AuditSubsystem,
    );
    audit_buf = sealed_buf;

    let chain_ok: bool = verify_seal_chain(audit_buf);
    assert(chain_ok, "audit_trail: seal chain verified");

    let _: u64 = export_recent_events(audit_buf, ExportFormat::JSON, 5);

    let stats: AuditLogStats = get_audit_log_stats(audit_buf);
    assert(stats.total_records >= 6, "audit_trail: records appended");
    assert(stats.seal_count >= 1, "audit_trail: seal created");
    assert(stats.active_records > 0, "audit_trail: active records present");

    residual emit {
        op: "audit_trail.init_complete",
        total_records: stats.total_records,
        active: stats.active_records,
        seals: stats.seal_count,
        overflow: stats.overflow_count,
        policies: audit_buf.policy_count,
    };

    return audit_buf;
}
