// nvme_full.phor — Full NVMe driver with admin command set, NVM command set,
// arbitration, power management, temperature monitoring, sanitize,
// persistent event log, and residual for every command.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/nvme_full.phor
// Court: nvme_full_driver:v2

package drivers.nvme_full;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type NvmeFullError = enum {
    NvmeNotInitialized         = 0x600,
    NvmeControllerNotFound     = 0x601,
    NvmeQueueFull              = 0x602,
    NvmeCompletionTimeout      = 0x603,
    NvmeInvalidQueue           = 0x604,
    NvmeInvalidCommand         = 0x605,
    NvmeDmaError               = 0x606,
    NvmePrpError               = 0x607,
    NvmeIdentifyFailed         = 0x608,
    NvmeNamespaceInvalid       = 0x609,
    NvmeReadError              = 0x60A,
    NvmeWriteError             = 0x60B,
    NvmeCapabilityError        = 0x60C,
    NvmeDoorbellError          = 0x60D,
    NvmeFatalControllerStatus  = 0x60E,
    NvmeInvalidBlockCount      = 0x60F,
    NvmeInvalidLbaRange        = 0x610,
    NvmeAdminCmdFailed         = 0x611,
    NvmeNoPrpListSpace         = 0x612,
    NvmeMaxQueuesExceeded      = 0x613,
    NvmeFormatFailed           = 0x614,
    NvmeFwDownloadFailed       = 0x615,
    NvmeFwActivateFailed       = 0x616,
    NvmeSanitizeFailed         = 0x617,
    NvmeLogPageInvalid         = 0x618,
    NvmePersistentEventLogFull = 0x619,
    NvmeArbitrationError       = 0x61A,
    NvmePowerStateError        = 0x61B,
    NvmeTemperatureCritical    = 0x61C,
    NvmeDatasetMgmtError       = 0x61D,
    NvmeCompareError           = 0x61E,
    NvmeWriteZeroesError       = 0x61F,
    NvmeFeatureNotSupported    = 0x620,
    NvmeResidualStoreFull      = 0x621,
}

// ─────────────────────────────────────────────────────────────
// NVMe Full Capability
// ─────────────────────────────────────────────────────────────

struct NvmeFullCapability {
    object_id: Identity,
    generation: u64,
    can_admin: bool,
    can_read: bool,
    can_write: bool,
    can_identify: bool,
    can_dma: bool,
    can_format: bool,
    can_sanitize: bool,
    can_fw_download: bool,
    can_fw_activate: bool,
    can_power_mgmt: bool,
    can_arbitration: bool,
    can_dsm: bool,
    can_compare: bool,
    can_write_zeroes: bool,
    can_persistent_log: bool,
    can_temperature: bool,
    max_io_queues: u64,
}

// ─────────────────────────────────────────────────────────────
// NVMe MMIO Register Offsets (Extended)
// ─────────────────────────────────────────────────────────────

struct NvmeFullMmioRegs {
    mmio_base: u64,
}

impl NvmeFullMmioRegs {
    fn cap_offset() -> u64 { return 0x0000; }
    fn vs_offset() -> u64 { return 0x0008; }
    fn intms_offset() -> u64 { return 0x000C; }
    fn intmc_offset() -> u64 { return 0x0010; }
    fn cc_offset() -> u64 { return 0x0014; }
    fn csts_offset() -> u64 { return 0x001C; }
    fn nss_offset() -> u64 { return 0x0020; }
    fn aqa_offset() -> u64 { return 0x0024; }
    fn asq_offset() -> u64 { return 0x0028; }
    fn acq_offset() -> u64 { return 0x0030; }
    fn sq0_tdb_offset() -> u64 { return 0x1000; }
    fn cq0_hdb_offset() -> u64 { return 0x1004; }
    fn sq_tdb_offset(qid: u32) -> u64 { return 0x1000 + (qid as u64) * 8; }
    fn cq_hdb_offset(qid: u32) -> u64 { return 0x1004 + (qid as u64) * 8; }

    fn pmr_cap_offset() -> u64 { return 0x0E00; }
    fn pmr_ctrl_offset() -> u64 { return 0x0E04; }
    fn pmr_status_offset() -> u64 { return 0x0E08; }
    fn pmr_eecp_offset() -> u64 { return 0x0E10; }

    fn read32(self, offset: u64) -> u32
        effect [memory:mmio]
    {
        return trusted reason "NVMe MMIO register read at verified offset, NVM Express Spec §3.1" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            return *ptr;
        };
    }

    fn read64(self, offset: u64) -> u64
        effect [memory:mmio]
    {
        return trusted reason "NVMe MMIO 64-bit register read" {
            let ptr: *(u64) = (self.mmio_base + offset) as *(u64);
            return *ptr;
        };
    }

    fn write32(self, offset: u64, value: u32) -> void
        effect [memory:mmio]
    {
        trusted reason "NVMe MMIO register write at verified offset, NVM Express Spec §3.1" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            *ptr = value;
        };
    }

    fn write64(self, offset: u64, value: u64) -> void
        effect [memory:mmio]
    {
        trusted reason "NVMe MMIO 64-bit register write" {
            let ptr: *(u64) = (self.mmio_base + offset) as *(u64);
            *ptr = value;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// NVMe Capabilities Register (CAP) Extended
// ─────────────────────────────────────────────────────────────

struct NvmeFullCap {
    mqes: u16,
    timeout: u8,
    css_nvm: bool,
    dstrd: u8,
    to: u8,
    ams: u8,
    cqr: bool,
    css: u8,
    bins: u8,
    crto: u32,
    pmrs: bool,
    pmru: bool,
    nsscc: u8,
}

fn nvme_full_parse_cap(reg: u64) -> NvmeFullCap
    effect [deterministic]
{
    return NvmeFullCap {
        mqes: ((reg >> 0) & 0xFFFF) as u16,
        timeout: ((reg >> 24) & 0xFF) as u8,
        css_nvm: ((reg >> 37) & 0x01) != 0,
        dstrd: ((reg >> 32) & 0x0F) as u8,
        to: ((reg >> 24) & 0xFF) as u8,
        ams: ((reg >> 36) & 0x03) as u8,
        cqr: ((reg >> 39) & 0x01) != 0,
        css: ((reg >> 37) & 0x07) as u8,
        bins: ((reg >> 48) & 0xFF) as u8,
        crto: ((reg >> 40) & 0xFF) as u32,
        pmrs: ((reg >> 56) & 0x01) != 0,
        pmru: ((reg >> 57) & 0x01) != 0,
        nsscc: ((reg >> 54) & 0x03) as u8,
    };
}

// ─────────────────────────────────────────────────────────────
// NVMe Version Parsing
// ─────────────────────────────────────────────────────────────

struct NvmeFullVersion {
    major: u16,
    minor: u8,
    tertiary: u8,
}

fn nvme_full_parse_version(ver: u32) -> NvmeFullVersion
    effect [deterministic]
{
    return NvmeFullVersion {
        major: ((ver >> 16) & 0xFFFF) as u16,
        minor: ((ver >> 8) & 0xFF) as u8,
        tertiary: (ver & 0xFF) as u8,
    };
}

// ─────────────────────────────────────────────────────────────
// NVMe Submission Queue Entry (SQE)
// ─────────────────────────────────────────────────────────────

struct NvmeFullSqe {
    cdw0: u32,
    nsid: u32,
    cdw2: u32,
    cdw3: u32,
    metadata_ptr: u64,
    data_ptr1: u64,
    data_ptr2: u64,
    cdw10: u32,
    cdw11: u32,
    cdw12: u32,
    cdw13: u32,
    cdw14: u32,
    cdw15: u32,
}

// ─────────────────────────────────────────────────────────────
// NVMe Completion Queue Entry (CQE)
// ─────────────────────────────────────────────────────────────

struct NvmeFullCqe {
    command_id: u16,
    sq_head_ptr: u16,
    sq_identifier: u16,
    status_field: u16,
    status_code: u8,
    status_code_type: u8,
    more: bool,
    phase_tag: bool,
    result: u32,
}

fn nvme_full_parse_cqe(dw0: u32, dw1: u32, dw2: u32, dw3: u32) -> NvmeFullCqe
    effect [deterministic]
{
    let status_raw: u16 = ((dw3 >> 16) & 0xFFFF) as u16;
    return NvmeFullCqe {
        command_id: (dw2 & 0xFFFF) as u16,
        sq_head_ptr: ((dw2 >> 16) & 0xFFFF) as u16,
        sq_identifier: (dw0 & 0xFFFF) as u16,
        status_field: status_raw,
        status_code: (status_raw & 0xFF) as u8,
        status_code_type: ((status_raw >> 8) & 0x07) as u8,
        more: (dw0 & 0x10000) != 0,
        phase_tag: (dw3 & 0x01) != 0,
        result: dw1,
    };
}

// ─────────────────────────────────────────────────────────────
// NVMe Queue Pair (Full)
// ─────────────────────────────────────────────────────────────

struct NvmeFullQueuePair {
    queue_id: u16,
    submission_queue: Array(NvmeFullSqe, 256),
    completion_queue: Array(NvmeFullCqe, 256),
    sq_tail: u16,
    sq_head: u16,
    cq_head: u16,
    cq_phase: bool,
    sq_phys_addr: u64,
    cq_phys_addr: u64,
    sq_size: u16,
    cq_size: u16,
    sq_doorbell: u64,
    cq_doorbell: u64,
    qprio: u8,
    doorbell_stride: u8,
    initialized: bool,
    is_admin: bool,
    outstanding_commands: u16,
}

// ─────────────────────────────────────────────────────────────
// PRP Entry and PRP List
// ─────────────────────────────────────────────────────────────

struct NvmeFullPrpEntry {
    phys_addr: u64,
}

struct NvmeFullPrpList {
    entries: Array(NvmeFullPrpEntry, 128),
    entry_count: u64,
    list_phys_addr: u64,
}

