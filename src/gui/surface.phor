// surface.phor — Phorensic Surface Types
// Surface types: Window, Overlay, Cursor, Popup; lifecycle, buffer management
// All operations bounded to fixed capacities. Every function declares effects.
// Part of the Phorensic OS GUI subsystem.

package gui.surface;

import gui.protocol;

// ──────────────────────────────────────────────
// Surface Configuration Constants
// ──────────────────────────────────────────────

const MAX_SURFACE_SLOTS: u64 = 4096;
const MAX_PENDING_BUFFERS: u64 = 4;
const MAX_DAMAGE_REGIONS: u64 = 64;
const MAX_CALLBACKS: u64 = 32;
const MAX_SUBSURFACES: u64 = 64;
const MAX_POPUP_PARENT_CHAIN: u64 = 16;
const CURSOR_DEFAULT_SIZE: u64 = 64;
const SURFACE_NAME_MAX: u64 = 128;
const MAX_FRAME_CALLBACKS: u64 = 16;

// ──────────────────────────────────────────────
// Surface Handle (generation-tagged)
// ──────────────────────────────────────────────

struct SurfaceHandle {
    id: u64,
    generation: u64,
}

// ──────────────────────────────────────────────
// Buffer State
// ──────────────────────────────────────────────

enum BufferState {
    Free,
    Allocated,
    Attached,
    Released,
    Shared,
    Damaged,
    Presenting,
}

struct SurfaceBuffer {
    buffer_id: u64,
    state: BufferState,
    format: protocol.BufferFormat,
    size: protocol.Size,
    stride: u32,
    data: Array(u8, 4194304), // 4MB max for a full framebuffer
    damage: RingBuf(protocol.Rectangle, MAX_DAMAGE_REGIONS),
    age: u64,
    release_fence: u64,
    committed: bool,
}

// ──────────────────────────────────────────────
// Frame Callback
// ──────────────────────────────────────────────

struct FrameCallback {
    callback_id: u64,
    surface_id: u64,
    serial: u64,
    pending: bool,
    delivered: bool,
    timestamp_ns: u64,
}

// ──────────────────────────────────────────────
// Base Surface Type (shared fields)
// ──────────────────────────────────────────────

struct SurfaceCommon {
    id: u64,
    generation: u64,
    type_: protocol.SurfaceType,
    state: protocol.SurfaceState,
    role: protocol.SurfaceRole,
    position: protocol.Point,
    size: protocol.Size,
    input_region: protocol.Rectangle,
    opaque_region: protocol.Rectangle,
    visible: bool,
    opacity: f64,
    buffer_count: u64,
    current_buffer: u64,
    pending_buffer: u64,
    buffers: RingBuf(SurfaceBuffer, MAX_PENDING_BUFFERS),
    frame_callbacks: RingBuf(FrameCallback, MAX_FRAME_CALLBACKS),
    scale: f64,
    transform: u64,
    damage_serial: u64,
    client_id: u64,
    last_present_serial: u64,
    presented_frame_count: u64,
    creation_time_ns: u64,
    last_present_time_ns: u64,
    name: Array(u8, SURFACE_NAME_MAX),
}

// ──────────────────────────────────────────────
// Window Surface
// ──────────────────────────────────────────────

struct WindowSurface {
    common: SurfaceCommon,
    title: Array(u8, 256),
    app_id: Array(u8, 128),
    decorated: bool,
    decoration_extents: protocol.Margins,
    window_state: u64,
    minimized: bool,
    maximized: bool,
    fullscreen: bool,
    resizing: bool,
    transient_for: protocol.SurfaceHandle,
    parent_id: u64,
    min_size: protocol.Size,
    max_size: protocol.Size,
    stacking_order: u64,
    pid: u64,
    configured_serial: u64,
    ack_pending: bool,
    subsurfaces: RingBuf(u64, MAX_SUBSURFACES),
    last_configure: protocol.SurfaceConfiguration,
}

// ──────────────────────────────────────────────
// Overlay Surface (for compositor overlays, HUDs)
// ──────────────────────────────────────────────

struct OverlaySurface {
    common: SurfaceCommon,
    overlay_type: u64,
    exclusive: bool,
    passthrough_input: bool,
    keep_above: bool,
    animate_opacity: bool,
    target_opacity: f64,
    animation_progress: f64,
    source_rect: protocol.Rectangle,
    dest_rect: protocol.Rectangle,
    blend_mode: u64,
    color_key: Option(protocol.ColorRGBA),
    color_key_enabled: bool,
    hardware_overlay: bool,
    z_position: u64,
}

// ──────────────────────────────────────────────
// Cursor Surface
// ──────────────────────────────────────────────

enum CursorImage {
    Arrow,
    Crosshair,
    Hand,
    IBeam,
    Wait,
    WaitArrow,
    ResizeNWSE,
    ResizeNESW,
    ResizeWE,
    ResizeNS,
    ResizeAll,
    NotAllowed,
    PointerMove,
    Grab,
    Grabbing,
    Text,
    VerticalText,
    Cell,
    Help,
    Progress,
    Custom(u64),
}

struct CursorSurface {
    common: SurfaceCommon,
    image: CursorImage,
    hotspot_x: i32,
    hotspot_y: i32,
    pointer_id: u64,
    constrained: bool,
    constrain_rect: protocol.Rectangle,
    visible: bool,
    default_cursor: bool,
    size: u64,
    scale: f64,
    serial: u64,
}

// ──────────────────────────────────────────────
// Popup Surface
// ──────────────────────────────────────────────

struct PopupSurface {
    common: SurfaceCommon,
    parent_id: u64,
    parent_position: protocol.Point,
    anchor_rect: protocol.Rectangle,
    anchor_edge: u64,
    anchor_gravity: u64,
    popup_gravity: u64,
    constrain_adjustment: u64,
    grab_keyboard: bool,
    modal: bool,
    dismissed: bool,
    dismissal_serial: u64,
    chain_depth: u64,
}

// ──────────────────────────────────────────────
// Surface Operations
// ──────────────────────────────────────────────

// Initialize a surface common block
fn init_surface_common(id: u64, gen: u64, type_: protocol.SurfaceType, client: u64, now: u64) -> SurfaceCommon
    effect [compute, residual]
{
    let sc: SurfaceCommon = SurfaceCommon {
        id: id,
        generation: gen,
        type_: type_,
        state: protocol.SurfaceState::Initial,
        role: protocol.SurfaceRole::TopLevel,
        position: protocol.make_point(0, 0),
        size: protocol.make_size(1280, 720),
        input_region: protocol.make_rect(0, 0, 1280, 720),
        opaque_region: protocol.make_rect(0, 0, 1280, 720),
        visible: false,
        opacity: 1.0,
        buffer_count: 0,
        current_buffer: 0,
        pending_buffer: 0,
        buffers: RingBuf::new(),
        frame_callbacks: RingBuf::new(),
        scale: 1.0,
        transform: 0,
        damage_serial: 0,
        client_id: client,
        last_present_serial: 0,
        presented_frame_count: 0,
        creation_time_ns: now,
        last_present_time_ns: 0,
        name: Array::zeroed(),
    };
    residual emit {
        op: "surface:init",
        id: id,
        type_: type_ as u64,
        client: client,
        timestamp: now,
    };
    return sc;
}

// Allocate a buffer slot on a surface
fn surface_allocate_buffer(sc: SurfaceCommon, size: protocol.Size, fmt: protocol.BufferFormat) -> Result(SurfaceCommon, u64)
    effect [compute, io:write]
    bound iterations MAX_PENDING_BUFFERS
{
    let mut updated: SurfaceCommon = sc;
    let slot: u64 = 0;
    let found: bool = false;
    for i in 0..MAX_PENDING_BUFFERS {
        let buf_opt: Option(SurfaceBuffer) = updated.buffers[i];
        match buf_opt {
            Option::Some(b) => {
                if b.state == BufferState::Free {
                    slot = i;
                    found = true;
                    break;
                }
            }
            Option::None => {
                slot = i;
                found = true;
                break;
            }
        }
    }
    if !found {
        return Result::Err(1); // no free slots
    }
    let new_buf: SurfaceBuffer = SurfaceBuffer {
        buffer_id: updated.last_present_serial + 1,
        state: BufferState::Allocated,
        format: fmt,
        size: size,
        stride: size.width * 4, // RGBA32
        data: Array::zeroed(),
        damage: RingBuf::new(),
        age: 0,
        release_fence: 0,
        committed: false,
    };
    updated.buffers[slot] = Option::Some(new_buf);
    updated.buffer_count = updated.buffer_count + 1;
    return Result::Ok(updated);
}

// Attach a buffer to the pending slot
fn surface_attach_buffer(sc: SurfaceCommon, buffer_id: u64) -> Result(SurfaceCommon, u64)
    effect [compute]
    bound iterations MAX_PENDING_BUFFERS
{
    let mut updated: SurfaceCommon = sc;
    let found: bool = false;
    for i in 0..MAX_PENDING_BUFFERS {
        let buf_opt: Option(SurfaceBuffer) = updated.buffers[i];
        match buf_opt {
            Option::Some(b) => {
                if b.buffer_id == buffer_id {
                    let attached: SurfaceBuffer = SurfaceBuffer {
                        buffer_id: b.buffer_id,
                        state: BufferState::Attached,
                        format: b.format,
                        size: b.size,
                        stride: b.stride,
                        data: b.data,
                        damage: b.damage,
                        age: b.age,
                        release_fence: b.release_fence,
                        committed: false,
                    };
                    updated.buffers[i] = Option::Some(attached);
                    updated.pending_buffer = i;
                    return Result::Ok(updated);
                }
            }
            Option::None => {}
        }
    }
    return Result::Err(2); // buffer not found
}

// Commit the pending buffer (make it current)
fn surface_commit(sc: SurfaceCommon) -> Result(SurfaceCommon, u64)
    effect [compute, residual]
{
    let mut updated: SurfaceCommon = sc;
    let pending_idx: u64 = updated.pending_buffer;
    let buf_opt: Option(SurfaceBuffer) = updated.buffers[pending_idx];
    match buf_opt {
        Option::Some(b) => {
            let committed: SurfaceBuffer = SurfaceBuffer {
                buffer_id: b.buffer_id,
                state: BufferState::Attached,
                format: b.format,
                size: b.size,
                stride: b.stride,
                data: b.data,
                damage: b.damage,
                age: b.age + 1,
                release_fence: b.release_fence,
                committed: true,
            };
            updated.buffers[pending_idx] = Option::Some(committed);
            updated.current_buffer = pending_idx;
            updated.damage_serial = updated.damage_serial + 1;
            residual emit {
                op: "surface:commit",
                id: updated.id,
                buffer: b.buffer_id,
                serial: updated.damage_serial,
            };
            return Result::Ok(updated);
        }
        Option::None => {
            return Result::Err(3); // no buffer at pending slot
        }
    }
}

// Set surface position
fn surface_set_position(sc: SurfaceCommon, pos: protocol.Point) -> SurfaceCommon
    effect [compute]
{
    return SurfaceCommon {
        id: sc.id,
        generation: sc.generation,
        type_: sc.type_,
        state: sc.state,
        role: sc.role,
        position: pos,
        size: sc.size,
        input_region: sc.input_region,
        opaque_region: sc.opaque_region,
        visible: sc.visible,
        opacity: sc.opacity,
        buffer_count: sc.buffer_count,
        current_buffer: sc.current_buffer,
        pending_buffer: sc.pending_buffer,
        buffers: sc.buffers,
        frame_callbacks: sc.frame_callbacks,
        scale: sc.scale,
        transform: sc.transform,
        damage_serial: sc.damage_serial,
        client_id: sc.client_id,
        last_present_serial: sc.last_present_serial,
        presented_frame_count: sc.presented_frame_count,
        creation_time_ns: sc.creation_time_ns,
        last_present_time_ns: sc.last_present_time_ns,
        name: sc.name,
    };
}

// Set surface size
fn surface_set_size(sc: SurfaceCommon, sz: protocol.Size) -> SurfaceCommon
    effect [compute]
{
    return SurfaceCommon {
        id: sc.id,
        generation: sc.generation,
        type_: sc.type_,
        state: sc.state,
        role: sc.role,
        position: sc.position,
        size: sz,
        input_region: protocol.make_rect(sc.position.x, sc.position.y, sz.width, sz.height),
        opaque_region: protocol.make_rect(sc.position.x, sc.position.y, sz.width, sz.height),
        visible: sc.visible,
        opacity: sc.opacity,
        buffer_count: sc.buffer_count,
        current_buffer: sc.current_buffer,
        pending_buffer: sc.pending_buffer,
        buffers: sc.buffers,
        frame_callbacks: sc.frame_callbacks,
        scale: sc.scale,
        transform: sc.transform,
        damage_serial: sc.damage_serial,
        client_id: sc.client_id,
        last_present_serial: sc.last_present_serial,
        presented_frame_count: sc.presented_frame_count,
        creation_time_ns: sc.creation_time_ns,
        last_present_time_ns: sc.last_present_time_ns,
        name: sc.name,
    };
}

// Set surface visibility
fn surface_set_visible(sc: SurfaceCommon, vis: bool) -> SurfaceCommon
    effect [compute, residual]
{
    residual emit {
        op: "surface:visible",
        id: sc.id,
        visible: vis,
    };
    return SurfaceCommon {
        id: sc.id,
        generation: sc.generation,
        type_: sc.type_,
        state: if vis { protocol.SurfaceState::Mapped } else { protocol.SurfaceState::Unmapped },
        role: sc.role,
        position: sc.position,
        size: sc.size,
        input_region: sc.input_region,
        opaque_region: sc.opaque_region,
        visible: vis,
        opacity: sc.opacity,
        buffer_count: sc.buffer_count,
        current_buffer: sc.current_buffer,
        pending_buffer: sc.pending_buffer,
        buffers: sc.buffers,
        frame_callbacks: sc.frame_callbacks,
        scale: sc.scale,
        transform: sc.transform,
        damage_serial: sc.damage_serial,
        client_id: sc.client_id,
        last_present_serial: sc.last_present_serial,
        presented_frame_count: sc.presented_frame_count,
        creation_time_ns: sc.creation_time_ns,
        last_present_time_ns: sc.last_present_time_ns,
        name: sc.name,
    };
}

// Add a frame callback
fn surface_add_callback(sc: SurfaceCommon, callback_id: u64, serial: u64) -> SurfaceCommon
    effect [compute]
    bound iterations MAX_FRAME_CALLBACKS
{
    let mut updated: SurfaceCommon = sc;
    for i in 0..MAX_FRAME_CALLBACKS {
        let cb_opt: Option(FrameCallback) = updated.frame_callbacks[i];
        match cb_opt {
            Option::None => {
                let cb: FrameCallback = FrameCallback {
                    callback_id: callback_id,
                    surface_id: updated.id,
                    serial: serial,
                    pending: true,
                    delivered: false,
                    timestamp_ns: 0,
                };
                updated.frame_callbacks[i] = Option::Some(cb);
                break;
            }
            Option::Some(_) => {}
        }
    }
    return updated;
}

// Deliver a frame callback
fn surface_deliver_callback(sc: SurfaceCommon, callback_id: u64, now: u64) -> SurfaceCommon
    effect [compute, residual]
    bound iterations MAX_FRAME_CALLBACKS
{
    let mut updated: SurfaceCommon = sc;
    for i in 0..MAX_FRAME_CALLBACKS {
        let cb_opt: Option(FrameCallback) = updated.frame_callbacks[i];
        match cb_opt {
            Option::Some(cb) => {
                if cb.callback_id == callback_id && cb.pending {
                    let delivered: FrameCallback = FrameCallback {
                        callback_id: cb.callback_id,
                        surface_id: cb.surface_id,
                        serial: cb.serial,
                        pending: false,
                        delivered: true,
                        timestamp_ns: now,
                    };
                    updated.frame_callbacks[i] = Option::Some(delivered);
                    residual emit {
                        op: "surface:frame_callback",
                        surface: updated.id,
                        serial: cb.serial,
                        timestamp: now,
                    };
                    break;
                }
            }
            Option::None => {}
        }
    }
    return updated;
}

// ──────────────────────────────────────────────
// Window Surface Operations
// ──────────────────────────────────────────────

fn init_window_surface(id: u64, gen: u64, client: u64, now: u64, title: Slice(u8)) -> WindowSurface
    effect [compute, residual]
{
    let common: SurfaceCommon = init_surface_common(id, gen, protocol.SurfaceType::Window, client, now);
    let default_sz: protocol.Size = protocol.make_size(1280, 720);
    let positioned: SurfaceCommon = surface_set_size(common, default_sz);
    let mut title_buf: Array(u8, 256) = Array::zeroed();
    for i in 0..256 {
        if i >= title.len() { break; }
        title_buf[i] = title[i];
    }
    let ws: WindowSurface = WindowSurface {
        common: positioned,
        title: title_buf,
        app_id: Array::zeroed(),
        decorated: true,
        decoration_extents: protocol.Margins { left: 8, right: 8, top: 32, bottom: 8 },
        window_state: 0,
        minimized: false,
        maximized: false,
        fullscreen: false,
        resizing: false,
        transient_for: protocol.SurfaceHandle { id: 0, generation: 0 },
        parent_id: 0,
        min_size: protocol.make_size(128, 128),
        max_size: protocol.make_size(7680, 4320),
        stacking_order: 0,
        pid: 0,
        configured_serial: 0,
        ack_pending: false,
        subsurfaces: RingBuf::new(),
        last_configure: protocol.SurfaceConfiguration {
            surface_id: id,
            fields: Array::zeroed(),
            serial: 0,
            committed: false,
        },
    };
    residual emit {
        op: "window:create",
        id: id,
        client: client,
        timestamp: now,
    };
    return ws;
}

fn window_set_title(ws: WindowSurface, title: Slice(u8)) -> WindowSurface
    effect [compute]
    bound iterations 256
{
    let mut updated: WindowSurface = ws;
    for i in 0..256 {
        if i >= title.len() { break; }
        updated.title[i] = title[i];
    }
    if title.len() < 256 {
        updated.title[title.len()] = 0; // null terminate
    }
    return updated;
}

fn window_configure(ws: WindowSurface, cfg: protocol.SurfaceConfiguration) -> WindowSurface
    effect [compute, residual]
{
    let mut updated: WindowSurface = ws;
    updated.last_configure = cfg;
    updated.configured_serial = cfg.serial;
    updated.ack_pending = true;
    for i in 0..32 {
        let field_opt: Option(protocol.ConfigureField) = cfg.fields[i];
        match field_opt {
            Option::Some(f) => {
                match f {
                    protocol.ConfigureField::Position(p) => {
                        updated.common = surface_set_position(updated.common, p);
                    }
                    protocol.ConfigureField::Size(s) => {
                        updated.common = surface_set_size(updated.common, s);
                    }
                    protocol.ConfigureField::Minimized(m) => {
                        updated.minimized = m;
                    }
                    protocol.ConfigureField::Maximized(m) => {
                        updated.maximized = m;
                    }
                    protocol.ConfigureField::Fullscreen(fs) => {
                        updated.fullscreen = fs;
                    }
                    protocol.ConfigureField::Decorated(d) => {
                        updated.decorated = d;
                    }
                    protocol.ConfigureField::Visible(v) => {
                        updated.common = surface_set_visible(updated.common, v);
                    }
                    _ => {}
                }
            }
            Option::None => {}
        }
    }
    residual emit {
        op: "window:configure",
        id: ws.common.id,
        serial: cfg.serial,
    };
    return updated;
}

fn window_ack_configure(ws: WindowSurface) -> WindowSurface
    effect [compute]
{
    return WindowSurface {
        common: ws.common,
        title: ws.title,
        app_id: ws.app_id,
        decorated: ws.decorated,
        decoration_extents: ws.decoration_extents,
        window_state: ws.window_state,
        minimized: ws.minimized,
        maximized: ws.maximized,
        fullscreen: ws.fullscreen,
        resizing: ws.resizing,
        transient_for: ws.transient_for,
        parent_id: ws.parent_id,
        min_size: ws.min_size,
        max_size: ws.max_size,
        stacking_order: ws.stacking_order,
        pid: ws.pid,
        configured_serial: ws.configured_serial,
        ack_pending: false,
        subsurfaces: ws.subsurfaces,
        last_configure: ws.last_configure,
    };
}

// ──────────────────────────────────────────────
// Overlay Surface Operations
// ──────────────────────────────────────────────

fn init_overlay_surface(id: u64, gen: u64, client: u64, now: u64) -> OverlaySurface
    effect [compute, residual]
{
    let common: SurfaceCommon = init_surface_common(id, gen, protocol.SurfaceType::Overlay, client, now);
    let positioned: SurfaceCommon = surface_set_size(common, protocol.make_size(400, 300));
    let os: OverlaySurface = OverlaySurface {
        common: positioned,
        overlay_type: 0,
        exclusive: false,
        passthrough_input: true,
        keep_above: true,
        animate_opacity: false,
        target_opacity: 1.0,
        animation_progress: 1.0,
        source_rect: protocol.make_rect(0, 0, 400, 300),
        dest_rect: protocol.make_rect(0, 0, 400, 300),
        blend_mode: 0,
        color_key: Option::None,
        color_key_enabled: false,
        hardware_overlay: false,
        z_position: 1000,
    };
    residual emit {
        op: "overlay:create",
        id: id,
        client: client,
        timestamp: now,
    };
    return os;
}

fn overlay_set_source_rect(os: OverlaySurface, r: protocol.Rectangle) -> OverlaySurface
    effect [compute]
{
    return OverlaySurface {
        common: os.common,
        overlay_type: os.overlay_type,
        exclusive: os.exclusive,
        passthrough_input: os.passthrough_input,
        keep_above: os.keep_above,
        animate_opacity: os.animate_opacity,
        target_opacity: os.target_opacity,
        animation_progress: os.animation_progress,
        source_rect: r,
        dest_rect: os.dest_rect,
        blend_mode: os.blend_mode,
        color_key: os.color_key,
        color_key_enabled: os.color_key_enabled,
        hardware_overlay: os.hardware_overlay,
        z_position: os.z_position,
    };
}

fn overlay_set_dest_rect(os: OverlaySurface, r: protocol.Rectangle) -> OverlaySurface
    effect [compute]
{
    return OverlaySurface {
        common: os.common,
        overlay_type: os.overlay_type,
        exclusive: os.exclusive,
        passthrough_input: os.passthrough_input,
        keep_above: os.keep_above,
        animate_opacity: os.animate_opacity,
        target_opacity: os.target_opacity,
        animation_progress: os.animation_progress,
        source_rect: os.source_rect,
        dest_rect: r,
        blend_mode: os.blend_mode,
        color_key: os.color_key,
        color_key_enabled: os.color_key_enabled,
        hardware_overlay: os.hardware_overlay,
        z_position: os.z_position,
    };
}

// ──────────────────────────────────────────────
// Cursor Surface Operations
// ──────────────────────────────────────────────

fn init_cursor_surface(id: u64, gen: u64, client: u64, now: u64) -> CursorSurface
    effect [compute, residual]
{
    let common: SurfaceCommon = init_surface_common(id, gen, protocol.SurfaceType::Cursor, client, now);
    let sized: SurfaceCommon = surface_set_size(common, protocol.make_size(CURSOR_DEFAULT_SIZE, CURSOR_DEFAULT_SIZE));
    let cs: CursorSurface = CursorSurface {
        common: sized,
        image: CursorImage::Arrow,
        hotspot_x: 0,
        hotspot_y: 0,
        pointer_id: 0,
        constrained: false,
        constrain_rect: protocol.make_rect(0, 0, 0, 0),
        visible: true,
        default_cursor: true,
        size: CURSOR_DEFAULT_SIZE,
        scale: 1.0,
        serial: 0,
    };
    residual emit {
        op: "cursor:create",
        id: id,
        client: client,
        timestamp: now,
    };
    return cs;
}

fn cursor_set_image(cs: CursorSurface, img: CursorImage, hot_x: i32, hot_y: i32) -> CursorSurface
    effect [compute, residual]
{
    residual emit {
        op: "cursor:set_image",
        id: cs.common.id,
        image: img as u64,
        hotspot_x: hot_x,
        hotspot_y: hot_y,
    };
    return CursorSurface {
        common: cs.common,
        image: img,
        hotspot_x: hot_x,
        hotspot_y: hot_y,
        pointer_id: cs.pointer_id,
        constrained: cs.constrained,
        constrain_rect: cs.constrain_rect,
        visible: cs.visible,
        default_cursor: false,
        size: cs.size,
        scale: cs.scale,
        serial: cs.serial + 1,
    };
}

fn cursor_move(cs: CursorSurface, pos: protocol.Point) -> CursorSurface
    effect [compute]
{
    let moved: SurfaceCommon = surface_set_position(cs.common, pos);
    return CursorSurface {
        common: moved,
        image: cs.image,
        hotspot_x: cs.hotspot_x,
        hotspot_y: cs.hotspot_y,
        pointer_id: cs.pointer_id,
        constrained: cs.constrained,
        constrain_rect: cs.constrain_rect,
        visible: cs.visible,
        default_cursor: cs.default_cursor,
        size: cs.size,
        scale: cs.scale,
        serial: cs.serial + 1,
    };
}

fn cursor_set_visible(cs: CursorSurface, vis: bool) -> CursorSurface
    effect [compute]
{
    return CursorSurface {
        common: cs.common,
        image: cs.image,
        hotspot_x: cs.hotspot_x,
        hotspot_y: cs.hotspot_y,
        pointer_id: cs.pointer_id,
        constrained: cs.constrained,
        constrain_rect: cs.constrain_rect,
        visible: vis,
        default_cursor: cs.default_cursor,
        size: cs.size,
        scale: cs.scale,
        serial: cs.serial + 1,
    };
}

// ──────────────────────────────────────────────
// Popup Surface Operations
// ──────────────────────────────────────────────

fn init_popup_surface(id: u64, gen: u64, client: u64, now: u64, parent: u64) -> PopupSurface
    effect [compute, residual]
{
    let common: SurfaceCommon = init_surface_common(id, gen, protocol.SurfaceType::Popup, client, now);
    let popup: PopupSurface = PopupSurface {
        common: common,
        parent_id: parent,
        parent_position: protocol.make_point(0, 0),
        anchor_rect: protocol.make_rect(0, 0, 0, 0),
        anchor_edge: 0,
        anchor_gravity: 0,
        popup_gravity: 0,
        constrain_adjustment: 0,
        grab_keyboard: true,
        modal: false,
        dismissed: false,
        dismissal_serial: 0,
        chain_depth: 0,
    };
    residual emit {
        op: "popup:create",
        id: id,
        parent: parent,
        client: client,
        timestamp: now,
    };
    return popup;
}

fn popup_dismiss(popup: PopupSurface, serial: u64) -> PopupSurface
    effect [compute, residual]
{
    residual emit {
        op: "popup:dismiss",
        id: popup.common.id,
        serial: serial,
    };
    return PopupSurface {
        common: popup.common,
        parent_id: popup.parent_id,
        parent_position: popup.parent_position,
        anchor_rect: popup.anchor_rect,
        anchor_edge: popup.anchor_edge,
        anchor_gravity: popup.anchor_gravity,
        popup_gravity: popup.popup_gravity,
        constrain_adjustment: popup.constrain_adjustment,
        grab_keyboard: popup.grab_keyboard,
        modal: popup.modal,
        dismissed: true,
        dismissal_serial: serial,
        chain_depth: popup.chain_depth,
    };
}

fn popup_set_anchor(popup: PopupSurface, rect: protocol.Rectangle, edge: u64, grav: u64, popup_grav: u64) -> PopupSurface
    effect [compute]
{
    return PopupSurface {
        common: popup.common,
        parent_id: popup.parent_id,
        parent_position: popup.parent_position,
        anchor_rect: rect,
        anchor_edge: edge,
        anchor_gravity: grav,
        popup_gravity: popup_grav,
        constrain_adjustment: popup.constrain_adjustment,
        grab_keyboard: popup.grab_keyboard,
        modal: popup.modal,
        dismissed: popup.dismissed,
        dismissal_serial: popup.dismissal_serial,
        chain_depth: popup.chain_depth,
    };
}

// ──────────────────────────────────────────────
// Surface Registry (flat array, fixed capacity)
// ──────────────────────────────────────────────

struct SurfaceRegistryEntry {
    in_use: bool,
    surface_type: protocol.SurfaceType,
    generation: u64,
    window: Option(WindowSurface),
    overlay: Option(OverlaySurface),
    cursor: Option(CursorSurface),
    popup: Option(PopupSurface),
    client_id: u64,
    created_at: u64,
    destroyed_at: u64,
}

struct SurfaceRegistry {
    entries: Array(SurfaceRegistryEntry, MAX_SURFACE_SLOTS),
    active_count: u64,
    next_id: u64,
}

fn registry_init() -> SurfaceRegistry
    effect [compute]
{
    return SurfaceRegistry {
        entries: Array::zeroed(),
        active_count: 0,
        next_id: 1,
    };
}

fn registry_alloc_id(reg: SurfaceRegistry) -> (SurfaceRegistry, u64)
    effect [compute]
    bound iterations MAX_SURFACE_SLOTS
{
    let mut updated: SurfaceRegistry = reg;
    for i in 0..MAX_SURFACE_SLOTS {
        let idx: u64 = (updated.next_id + i) % MAX_SURFACE_SLOTS;
        if !updated.entries[idx].in_use {
            updated.next_id = idx + 1;
            return (updated, idx);
        }
    }
    return (updated, 0); // 0 means out of IDs
}

fn registry_register(reg: SurfaceRegistry, idx: u64, type_: protocol.SurfaceType, gen: u64, client: u64, now: u64) -> SurfaceRegistry
    effect [compute, residual]
{
    let mut updated: SurfaceRegistry = reg;
    let entry: SurfaceRegistryEntry = SurfaceRegistryEntry {
        in_use: true,
        surface_type: type_,
        generation: gen,
        window: Option::None,
        overlay: Option::None,
        cursor: Option::None,
        popup: Option::None,
        client_id: client,
        created_at: now,
        destroyed_at: 0,
    };
    updated.entries[idx] = entry;
    updated.active_count = updated.active_count + 1;
    residual emit {
        op: "registry:register",
        id: idx,
        type_: type_ as u64,
        client: client,
    };
    return updated;
}

fn registry_unregister(reg: SurfaceRegistry, idx: u64, now: u64) -> SurfaceRegistry
    effect [compute, residual]
{
    let mut updated: SurfaceRegistry = reg;
    let entry: SurfaceRegistryEntry = SurfaceRegistryEntry {
        in_use: false,
        surface_type: protocol.SurfaceType::Window,
        generation: 0,
        window: Option::None,
        overlay: Option::None,
        cursor: Option::None,
        popup: Option::None,
        client_id: 0,
        created_at: 0,
        destroyed_at: now,
    };
    updated.entries[idx] = entry;
    updated.active_count = updated.active_count - 1;
    residual emit {
        op: "registry:unregister",
        id: idx,
        timestamp: now,
    };
    return updated;
}

fn registry_lookup(reg: SurfaceRegistry, id: u64) -> Option(SurfaceRegistryEntry)
    effect [compute]
{
    if id >= MAX_SURFACE_SLOTS {
        return Option::None;
    }
    if !reg.entries[id].in_use {
        return Option::None;
    }
    return Option::Some(reg.entries[id]);
}
