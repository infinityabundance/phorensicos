fn display_residual_volume(rv: ResidualVolumeSnapshot, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Residual Volume ===\n"));
    let mut line: Str(256) = Str::from("Total: ");
    line.append(rv.total_residuals as Str(16));
    line.append(Str::from("  New: "));
    line.append(rv.new_since_last as Str(16));
    line.append(Str::from("  Rate: "));
    line.append(rv.rate_per_sec as Str(16));
    line.append(Str::from("/sec  Peak: "));
    line.append(rv.peak_rate as Str(16));
    line.append(Str::from("/sec\n"));
    console.write(line);

    for i in 0..rv.op_count {
        let oc: OperationCounter = rv.by_operation[i];
        let mut oline: Str(128) = Str::from("  ");
        oline.append(oc.op_name);
        oline.append(Str::from(": "));
        oline.append(oc.count as Str(16));
        oline.append(Str::from(" (avg "));
        oline.append(oc.avg_size as Str(16));
        oline.append(Str::from(" bytes)\n"));
        console.write(oline);
    }
}

