            0x09 => FixedString::from("MCA"),
            0x0A => FixedString::from("EISA"),
            0x0B => FixedString::from("PCMCIA"),
            0x0C => FixedString::from("VL-Bus"),
            0x0D => FixedString::from("Proprietary"),
            0x0E => FixedString::from("Processor Slot"),
            0x0F => FixedString::from("Memory Slot"),
            0x10 => FixedString::from("I/O Riser"),
            0xA0 => FixedString::from("PCI-E 2.0 x1"),
            0xA1 => FixedString::from("PCI-E 2.0 x2"),
            0xA2 => FixedString::from("PCI-E 2.0 x4"),
            0xA3 => FixedString::from("PCI-E 2.0 x8"),
            0xA4 => FixedString::from("PCI-E 2.0 x16"),
            0xA5 => FixedString::from("PCI-E 3.0 x1"),
            0xA6 => FixedString::from("PCI-E 3.0 x2"),
            0xA7 => FixedString::from("PCI-E 3.0 x4"),
            0xA8 => FixedString::from("PCI-E 3.0 x8"),
            0xA9 => FixedString::from("PCI-E 3.0 x16"),
            0xAA => FixedString::from("PCI-E 4.0 x1"),
            0xAB => FixedString::from("PCI-E 4.0 x2"),
