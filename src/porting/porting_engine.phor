// ============================================================================
// porting_engine.phor — Full Porting Pipeline Orchestration
// ============================================================================
// The Porting Engine orchestrates the full 13-stage porting pipeline that
// transforms foreign code into native sealed packages. Each stage is a
// checkpoint with residuals, receipts, and court-verified evidence.
//
// Core rule: Replace only what has been observed, explained, replayed,
//            and sealed. Unknown regions remain sandboxed.
// ============================================================================

package "phorensic:porting_engine:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type PortingError = enum {
    StageFailed = 0x01,
    StageAlreadyCompleted = 0x02,
    StagePrerequisiteMissing = 0x03,
    ClassificationFailed = 0x04,
    CageLoadingFailed = 0x05,
    ObservationFailed = 0x06,
    ResidualExtractionFailed = 0x07,
    SemanticAnalysisFailed = 0x08,
    CandidateGenerationFailed = 0x09,
    ReplayVerificationFailed = 0x0A,
    OracleComparisonFailed = 0x0B,
    CourtVerificationFailed = 0x0C,
    NativeSliceExtractionFailed = 0x0D,
    SliceSealingFailed = 0x0E,
    PackageAssemblyFailed = 0x0F,
    PromotionFailed = 0x10,
    PackageAlreadyPromoted = 0x11,
    InternalError = 0xFF,
}

// ============================================================================
// Porting Stage Enum
// ============================================================================

type PortingStageID = enum {
    DialectClassification = 0x01,
    CageLoading = 0x02,
    Observation = 0x03,
    ResidualExtraction = 0x04,
    SemanticAnalysis = 0x05,
    CandidateGeneration = 0x06,
    ReplayVerification = 0x07,
    OracleComparison = 0x08,
    CourtVerification = 0x09,
    NativeSliceExtraction = 0x0A,
    SliceSealing = 0x0B,
    PackageAssembly = 0x0C,
    Promotion = 0x0D,
}

// ============================================================================
// Trust State
// ============================================================================

type TrustState = enum {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Stage Record
// ============================================================================

type StageRecord = struct {
    stage_id: PortingStageID,
    stage_name: FixedString[128],
    status: StageStatus,
    input_hash: Hash256,
    output_hash: Hash256,
    residuals: Array[Hash256, 64],
    residual_count: u64,
    started_at: u64,
    completed_at: u64,
    error_message: FixedString[512],
    evidence_refs: Array[Hash256, 32],
    evidence_count: u64,
}

type StageStatus = enum {
    Pending = 0x01,
    InProgress = 0x02,
    Completed = 0x03,
    Failed = 0x04,
    Skipped = 0x05,
    Blocked = 0x06,
}

// ============================================================================
// Porting Pipeline State
// ============================================================================

type PortingPipeline = struct {
    pipeline_id: Hash256,
    foreign_source_hash: Hash256,
    dialect_profile_hash: Hash256,
    package_name: FixedString[256],
    package_version: FixedString[32],
    stages: Array[StageRecord, 13],
    stage_count: u64,
    current_stage: u64,
    foreign_code_hash: Hash256,
    residual_bundle_hash: Hash256,
    candidate_slices: Array[Hash256, 256],
    candidate_count: u64,
    verified_slices: Array[Hash256, 128],
    verified_count: u64,
    sealed_slices: Array[Hash256, 64],
    sealed_count: u64,
    package_key: Option[Hash256],
    final_trust_state: TrustState,
    is_complete: bool,
    is_failed: bool,
    started_at: u64,
    completed_at: u64,
    generation: u64,
}

// ============================================================================
// Porting Engine
// ============================================================================

type PortingEngine = struct {
    pipelines: Array[PortingPipeline, 64],
    pipeline_count: u64,
    generation: u64,
}

type Option[T] = enum {
    Some(value: T),
    None,
}

// ============================================================================
// Create Porting Pipeline
// ============================================================================

fn create_porting_pipeline(foreign_source_hash: Hash256, dialect_profile_hash: Hash256, package_name: &FixedString[256], package_version: &FixedString[32]) -> PortingPipeline
    effects: [compute]
{
    let empty_stages: Array[StageRecord, 13] = Array[StageRecord, 13]::zeroed();
    let empty_candidates: Array[Hash256, 256] = Array[Hash256, 256]::zeroed();
    let empty_verified: Array[Hash256, 128] = Array[Hash256, 128]::zeroed();
    let empty_sealed: Array[Hash256, 64] = Array[Hash256, 64]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    // Initialize stage records
    let mut stages: Array[StageRecord, 13] = empty_stages;

    stages[0] = StageRecord {
        stage_id: PortingStageID::DialectClassification,
        stage_name: FixedString[128]::from_literal("dialect_classification"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[1] = StageRecord {
        stage_id: PortingStageID::CageLoading,
        stage_name: FixedString[128]::from_literal("cage_loading"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[2] = StageRecord {
        stage_id: PortingStageID::Observation,
        stage_name: FixedString[128]::from_literal("observation"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[3] = StageRecord {
        stage_id: PortingStageID::ResidualExtraction,
        stage_name: FixedString[128]::from_literal("residual_extraction"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[4] = StageRecord {
        stage_id: PortingStageID::SemanticAnalysis,
        stage_name: FixedString[128]::from_literal("semantic_analysis"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[5] = StageRecord {
        stage_id: PortingStageID::CandidateGeneration,
        stage_name: FixedString[128]::from_literal("candidate_generation"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[6] = StageRecord {
        stage_id: PortingStageID::ReplayVerification,
        stage_name: FixedString[128]::from_literal("replay_verification"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[7] = StageRecord {
        stage_id: PortingStageID::OracleComparison,
        stage_name: FixedString[128]::from_literal("oracle_comparison"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[8] = StageRecord {
        stage_id: PortingStageID::CourtVerification,
        stage_name: FixedString[128]::from_literal("court_verification"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[9] = StageRecord {
        stage_id: PortingStageID::NativeSliceExtraction,
        stage_name: FixedString[128]::from_literal("native_slice_extraction"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[10] = StageRecord {
        stage_id: PortingStageID::SliceSealing,
        stage_name: FixedString[128]::from_literal("slice_sealing"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[11] = StageRecord {
        stage_id: PortingStageID::PackageAssembly,
        stage_name: FixedString[128]::from_literal("package_assembly"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    stages[12] = StageRecord {
        stage_id: PortingStageID::Promotion,
        stage_name: FixedString[128]::from_literal("promotion"),
        status: StageStatus::Pending,
        input_hash: zero_hash,
        output_hash: zero_hash,
        residuals: Array[Hash256, 64]::zeroed(),
        residual_count: 0,
        started_at: 0,
        completed_at: 0,
        error_message: FixedString[512]::zeroed(),
        evidence_refs: Array[Hash256, 32]::zeroed(),
        evidence_count: 0,
    };

    return PortingPipeline {
        pipeline_id: zero_hash,
        foreign_source_hash: foreign_source_hash,
        dialect_profile_hash: dialect_profile_hash,
        package_name: *package_name,
        package_version: *package_version,
        stages: stages,
        stage_count: 13,
        current_stage: 0,
        foreign_code_hash: zero_hash,
        residual_bundle_hash: zero_hash,
        candidate_slices: empty_candidates,
        candidate_count: 0,
        verified_slices: empty_verified,
        verified_count: 0,
        sealed_slices: empty_sealed,
        sealed_count: 0,
        package_key: Option::None,
        final_trust_state: TrustState::Unknown,
        is_complete: false,
        is_failed: false,
        started_at: kernel.tick_count(),
        completed_at: 0,
        generation: 1,
    };
}

// ============================================================================
// Create Porting Engine
// ============================================================================

fn create_porting_engine() -> PortingEngine
    effects: [compute]
{
    let empty_pipelines: Array[PortingPipeline, 64] = Array[PortingPipeline, 64]::zeroed();

    return PortingEngine {
        pipelines: empty_pipelines,
        pipeline_count: 0,
        generation: 1,
    };
}

// ============================================================================
// Start Stage
// ============================================================================

fn start_stage(pipeline: &mut PortingPipeline, stage_idx: u64) -> Result[(), PortingError]
    effects: [compute, residual]
{
    if stage_idx >= 13 {
        return Err(PortingError::StageFailed);
    }

    if pipeline.stages[stage_idx].status != StageStatus::Pending {
        return Err(PortingError::StageAlreadyCompleted);
    }

    // Check prerequisite: all prior stages must be completed
    for i in 0..stage_idx {
        if pipeline.stages[i].status != StageStatus::Completed {
            return Err(PortingError::StagePrerequisiteMissing);
        }
    }

    pipeline.stages[stage_idx].status = StageStatus::InProgress;
    pipeline.stages[stage_idx].started_at = kernel.tick_count();
    pipeline.current_stage = stage_idx;

    @emit_residual("porting_engine.stage_start", "stage_started", stage_idx);

    return Ok(());
}

// ============================================================================
// Complete Stage
// ============================================================================

fn complete_stage(pipeline: &mut PortingPipeline, stage_idx: u64, output_hash: Hash256, evidence_refs: &Array[Hash256, 32], evidence_count: u64) -> Result[(), PortingError]
    effects: [compute, residual]
{
    if stage_idx >= 13 {
        return Err(PortingError::StageFailed);
    }

    if pipeline.stages[stage_idx].status != StageStatus::InProgress {
        return Err(PortingError::StageFailed);
    }

    pipeline.stages[stage_idx].status = StageStatus::Completed;
    pipeline.stages[stage_idx].completed_at = kernel.tick_count();
    pipeline.stages[stage_idx].output_hash = output_hash;

    for i in 0..evidence_count {
        pipeline.stages[stage_idx].evidence_refs[i] = evidence_refs[i];
    }
    pipeline.stages[stage_idx].evidence_count = evidence_count;

    @emit_residual("porting_engine.stage_complete", "stage_completed", stage_idx);

    return Ok(());
}

// ============================================================================
// Fail Stage
// ============================================================================

fn fail_stage(pipeline: &mut PortingPipeline, stage_idx: u64, error_msg: &FixedString[512]) -> Result[(), PortingError]
    effects: [compute, residual]
{
    if stage_idx >= 13 {
        return Err(PortingError::StageFailed);
    }

    pipeline.stages[stage_idx].status = StageStatus::Failed;
    pipeline.stages[stage_idx].completed_at = kernel.tick_count();
    pipeline.stages[stage_idx].error_message = *error_msg;
    pipeline.is_failed = true;
    pipeline.completed_at = kernel.tick_count();

    @emit_residual("porting_engine.stage_fail", "stage_failed", stage_idx);

    return Ok(());
}

// ============================================================================
// Check Stage Prerequisites
// ============================================================================

fn check_stage_prerequisites(pipeline: &PortingPipeline, stage_idx: u64) -> bool
    effects: [compute]
{
    if stage_idx >= 13 {
        return false;
    }

    for i in 0..stage_idx {
        if pipeline.stages[i].status != StageStatus::Completed &&
           pipeline.stages[i].status != StageStatus::Skipped {
            return false;
        }
    }

    return true;
}

// ============================================================================
// Stage 1: Dialect Classification
// ============================================================================

fn run_dialect_classification(pipeline: &mut PortingPipeline, foreign_code: &Array[u8, 1048576], code_len: u64) -> Result[Hash256, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 0)?;

    // Classify the foreign code
    let class_hash: Hash256 = classify_foreign_code_stub(foreign_code, code_len);

    let evidence: Array[Hash256, 1] = fixed_buf! [class_hash];

    @emit_residual("porting_engine.classify", "code_classified", class_hash);

    let _ = complete_stage(pipeline, 0, class_hash, &evidence, 1)?;

    return Ok(class_hash);
}

// ============================================================================
// Stage 2: Cage Loading
// ============================================================================

fn run_cage_loading(pipeline: &mut PortingPipeline, profile_hash: Hash256, code: &Array[u8, 1048576], code_len: u64) -> Result[Hash256, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 1)?;

    let cage_load_hash: Hash256 = load_cage_stub(profile_hash, code, code_len);

    let evidence: Array[Hash256, 1] = fixed_buf! [cage_load_hash];

    @emit_residual("porting_engine.cage_load", "cage_loaded", cage_load_hash);

    let _ = complete_stage(pipeline, 1, cage_load_hash, &evidence, 1)?;

    return Ok(cage_load_hash);
}

// ============================================================================
// Stage 3: Observation
// ============================================================================

fn run_observation(pipeline: &mut PortingPipeline, cage_id: Hash256, entry: &FixedString[256], args_hash: Hash256) -> Result[Hash256, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 2)?;

    let observation_hash: Hash256 = observe_execution_stub(cage_id, entry, args_hash);

    let evidence: Array[Hash256, 1] = fixed_buf! [observation_hash];

    @emit_residual("porting_engine.observe", "execution_observed", observation_hash);

    let _ = complete_stage(pipeline, 2, observation_hash, &evidence, 1)?;

    return Ok(observation_hash);
}

// ============================================================================
// Stage 4: Residual Extraction
// ============================================================================

fn run_residual_extraction(pipeline: &mut PortingPipeline, cage_id: Hash256) -> Result[Hash256, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 3)?;

    let residual_hash: Hash256 = extract_residuals_stub(cage_id);

    pipeline.residual_bundle_hash = residual_hash;

    let evidence: Array[Hash256, 1] = fixed_buf! [residual_hash];

    @emit_residual("porting_engine.residual_extract", "residuals_extracted", residual_hash);

    let _ = complete_stage(pipeline, 3, residual_hash, &evidence, 1)?;

    return Ok(residual_hash);
}

// ============================================================================
// Stage 5: Semantic Analysis
// ============================================================================

fn run_semantic_analysis(pipeline: &mut PortingPipeline, residual_hash: Hash256) -> Result[Hash256, PortingError]
    effects: [compute, residual]
{
    let _ = start_stage(pipeline, 4)?;

    let analysis_hash: Hash256 = analyze_residuals_stub(residual_hash);

    let evidence: Array[Hash256, 1] = fixed_buf! [analysis_hash];

    @emit_residual("porting_engine.analyze", "semantics_analyzed", analysis_hash);

    let _ = complete_stage(pipeline, 4, analysis_hash, &evidence, 1)?;

    return Ok(analysis_hash);
}

// ============================================================================
// Stage 6: Candidate Generation
// ============================================================================

fn run_candidate_generation(pipeline: &mut PortingPipeline, analysis_hash: Hash256) -> Result[u64, PortingError]
    effects: [compute, residual]
{
    let _ = start_stage(pipeline, 5)?;

    let candidate_count: u64 = generate_candidates_stub(analysis_hash, &mut pipeline.candidate_slices, &mut pipeline.candidate_count);

    let evidence: Array[Hash256, 1] = fixed_buf! [Hash256 { bytes: Array[u8, 32]::zeroed() }];

    @emit_residual("porting_engine.candidate_generate", "candidates_generated", candidate_count);

    let _ = complete_stage(pipeline, 5, hash_from_u64(candidate_count), &evidence, 1)?;

    return Ok(candidate_count);
}

// ============================================================================
// Stage 7: Replay Verification
// ============================================================================

fn run_replay_verification(pipeline: &mut PortingPipeline) -> Result[u64, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 6)?;

    let mut verified_count: u64 = 0;

    for i in 0..pipeline.candidate_count {
        let candidate_hash: Hash256 = pipeline.candidate_slices[i];
        let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

        if candidate_hash == zero_hash {
            break;
        }

        let replay_result: bool = verify_candidate_replay_stub(candidate_hash);
        if replay_result {
            if pipeline.verified_count < 128 {
                pipeline.verified_slices[pipeline.verified_count] = candidate_hash;
                pipeline.verified_count = pipeline.verified_count + 1;
                verified_count = verified_count + 1;
            }
        }
    }

    let evidence: Array[Hash256, 1] = fixed_buf! [hash_from_u64(verified_count)];

    @emit_residual("porting_engine.replay_verify", "replays_verified", verified_count);

    let _ = complete_stage(pipeline, 6, hash_from_u64(verified_count), &evidence, 1)?;

    return Ok(verified_count);
}

// ============================================================================
// Stage 8: Oracle Comparison
// ============================================================================

fn run_oracle_comparison(pipeline: &mut PortingPipeline, oracle_id: Hash256) -> Result[u64, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 7)?;

    let mut compared_count: u64 = 0;

    for i in 0..pipeline.verified_count {
        let slice_hash: Hash256 = pipeline.verified_slices[i];
        let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

        if slice_hash == zero_hash {
            break;
        }

        let oracle_result: bool = compare_with_oracle_stub(slice_hash, oracle_id);
        if oracle_result {
            pipeline.sealed_slices[pipeline.sealed_count] = slice_hash;
            pipeline.sealed_count = pipeline.sealed_count + 1;
            compared_count = compared_count + 1;
        }
    }

    let evidence: Array[Hash256, 1] = fixed_buf! [hash_from_u64(compared_count)];

    @emit_residual("porting_engine.oracle_compare", "oracle_comparisons_done", compared_count);

    let _ = complete_stage(pipeline, 7, hash_from_u64(compared_count), &evidence, 1)?;

    return Ok(compared_count);
}

// ============================================================================
// Stage 9: Court Verification
// ============================================================================

fn run_court_verification(pipeline: &mut PortingPipeline) -> Result[u64, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 8)?;

    let mut accepted_count: u64 = 0;

    for i in 0..pipeline.sealed_count {
        let slice_hash: Hash256 = pipeline.sealed_slices[i];
        let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

        if slice_hash == zero_hash {
            break;
        }

        let court_result: bool = court_verify_slice_stub(slice_hash);
        if court_result {
            accepted_count = accepted_count + 1;
        }
    }

    let evidence: Array[Hash256, 1] = fixed_buf! [hash_from_u64(accepted_count)];

    @emit_residual("porting_engine.court_verify", "court_verifications_done", accepted_count);

    let _ = complete_stage(pipeline, 8, hash_from_u64(accepted_count), &evidence, 1)?;

    return Ok(accepted_count);
}

// ============================================================================
// Stage 10: Native Slice Extraction
// ============================================================================

fn run_native_slice_extraction(pipeline: &mut PortingPipeline) -> Result[u64, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 9)?;

    let extraction_hash: Hash256 = extract_native_slices_stub(&pipeline.sealed_slices, pipeline.sealed_count);

    let evidence: Array[Hash256, 1] = fixed_buf! [extraction_hash];

    @emit_residual("porting_engine.slice_extract", "native_slices_extracted", pipeline.sealed_count);

    let _ = complete_stage(pipeline, 9, extraction_hash, &evidence, 1)?;

    return Ok(pipeline.sealed_count);
}

// ============================================================================
// Stage 11: Slice Sealing
// ============================================================================

fn run_slice_sealing(pipeline: &mut PortingPipeline, developer_key: Hash256) -> Result[u64, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 10)?;

    let seal_count: u64 = seal_slices_stub(&pipeline.sealed_slices, pipeline.sealed_count, developer_key);

    let evidence: Array[Hash256, 1] = fixed_buf! [hash_from_u64(seal_count)];

    @emit_residual("porting_engine.slice_seal", "slices_sealed", seal_count);

    let _ = complete_stage(pipeline, 10, hash_from_u64(seal_count), &evidence, 1)?;

    return Ok(seal_count);
}

// ============================================================================
// Stage 12: Package Assembly
// ============================================================================

fn run_package_assembly(pipeline: &mut PortingPipeline) -> Result[Hash256, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 11)?;

    let package_key_hash: Hash256 = assemble_package_stub(pipeline);

    pipeline.package_key = Option::Some(package_key_hash);

    let evidence: Array[Hash256, 1] = fixed_buf! [package_key_hash];

    @emit_residual("porting_engine.package_assemble", "package_assembled", package_key_hash);

    let _ = complete_stage(pipeline, 11, package_key_hash, &evidence, 1)?;

    return Ok(package_key_hash);
}

// ============================================================================
// Stage 13: Promotion
// ============================================================================

fn run_promotion(pipeline: &mut PortingPipeline, store_cap: Hash256) -> Result[TrustState, PortingError]
    effects: [compute, io, residual]
{
    let _ = start_stage(pipeline, 12)?;

    let trust_state: TrustState = promote_package_stub(pipeline, store_cap);

    pipeline.final_trust_state = trust_state;
    pipeline.is_complete = true;
    pipeline.completed_at = kernel.tick_count();

    let evidence: Array[Hash256, 1] = fixed_buf! [hash_from_u64(trust_state as u64)];

    @emit_residual("porting_engine.promote", "package_promoted", trust_state as u64);

    let _ = complete_stage(pipeline, 12, hash_from_u64(trust_state as u64), &evidence, 1)?;

    return Ok(trust_state);
}

// ============================================================================
// Run Full Pipeline
// ============================================================================

fn run_full_porting_pipeline(
    pipeline: &mut PortingPipeline,
    foreign_code: &Array[u8, 1048576],
    code_len: u64,
    profile_hash: Hash256,
    entry: &FixedString[256],
    args_hash: Hash256,
    oracle_id: Hash256,
    developer_key: Hash256,
    store_cap: Hash256
) -> Result[TrustState, PortingError]
    effects: [compute, io, residual]
{
    // Stage 1: Dialect Classification
    let class_hash: Hash256 = run_dialect_classification(pipeline, foreign_code, code_len)?;
    if pipeline.is_failed { return Err(PortingError::ClassificationFailed); }

    // Stage 2: Cage Loading
    let cage_id: Hash256 = run_cage_loading(pipeline, profile_hash, foreign_code, code_len)?;
    if pipeline.is_failed { return Err(PortingError::CageLoadingFailed); }

    // Stage 3: Observation
    let obs_hash: Hash256 = run_observation(pipeline, cage_id, entry, args_hash)?;
    if pipeline.is_failed { return Err(PortingError::ObservationFailed); }

    // Stage 4: Residual Extraction
    let res_hash: Hash256 = run_residual_extraction(pipeline, cage_id)?;
    if pipeline.is_failed { return Err(PortingError::ResidualExtractionFailed); }

    // Stage 5: Semantic Analysis
    let analysis_hash: Hash256 = run_semantic_analysis(pipeline, res_hash)?;
    if pipeline.is_failed { return Err(PortingError::SemanticAnalysisFailed); }

    // Stage 6: Candidate Generation
    let candidate_count: u64 = run_candidate_generation(pipeline, analysis_hash)?;
    if pipeline.is_failed { return Err(PortingError::CandidateGenerationFailed); }

    // Stage 7: Replay Verification
    let verified_count: u64 = run_replay_verification(pipeline)?;
    if pipeline.is_failed { return Err(PortingError::ReplayVerificationFailed); }

    // Stage 8: Oracle Comparison
    let compared_count: u64 = run_oracle_comparison(pipeline, oracle_id)?;
    if pipeline.is_failed { return Err(PortingError::OracleComparisonFailed); }

    // Stage 9: Court Verification
    let court_accepted: u64 = run_court_verification(pipeline)?;
    if pipeline.is_failed { return Err(PortingError::CourtVerificationFailed); }

    // Stage 10: Native Slice Extraction
    let slice_count: u64 = run_native_slice_extraction(pipeline)?;
    if pipeline.is_failed { return Err(PortingError::NativeSliceExtractionFailed); }

    // Stage 11: Slice Sealing
    let sealed_count: u64 = run_slice_sealing(pipeline, developer_key)?;
    if pipeline.is_failed { return Err(PortingError::SliceSealingFailed); }

    // Stage 12: Package Assembly
    let pkg_key: Hash256 = run_package_assembly(pipeline)?;
    if pipeline.is_failed { return Err(PortingError::PackageAssemblyFailed); }

    // Stage 13: Promotion
    let trust: TrustState = run_promotion(pipeline, store_cap)?;
    if pipeline.is_failed { return Err(PortingError::PromotionFailed); }

    return Ok(trust);
}

// ============================================================================
// Get Pipeline Report
// ============================================================================

type PipelineReport = struct {
    pipeline_id: Hash256,
    package_name: FixedString[256],
    package_version: FixedString[32],
    stages: Array[StageRecord, 13],
    current_stage: u64,
    candidate_count: u64,
    verified_count: u64,
    sealed_count: u64,
    package_key: Option[Hash256],
    final_trust_state: TrustState,
    is_complete: bool,
    is_failed: bool,
    started_at: u64,
    completed_at: u64,
    duration_us: u64,
}

fn get_pipeline_report(pipeline: &PortingPipeline) -> PipelineReport
    effects: [compute]
{
    let duration: u64 = if pipeline.is_complete || pipeline.is_failed {
        pipeline.completed_at - pipeline.started_at
    } else {
        kernel.tick_count() - pipeline.started_at
    };

    return PipelineReport {
        pipeline_id: pipeline.pipeline_id,
        package_name: pipeline.package_name,
        package_version: pipeline.package_version,
        stages: pipeline.stages,
        current_stage: pipeline.current_stage,
        candidate_count: pipeline.candidate_count,
        verified_count: pipeline.verified_count,
        sealed_count: pipeline.sealed_count,
        package_key: pipeline.package_key,
        final_trust_state: pipeline.final_trust_state,
        is_complete: pipeline.is_complete,
        is_failed: pipeline.is_failed,
        started_at: pipeline.started_at,
        completed_at: pipeline.completed_at,
        duration_us: duration,
    };
}

// ============================================================================
// Engine Pipeline Management
// ============================================================================

fn engine_start_pipeline(engine: &mut PortingEngine, foreign_source_hash: Hash256, profile_hash: Hash256, name: &FixedString[256], version: &FixedString[32]) -> Result[Hash256, PortingError]
    effects: [compute, residual]
{
    if engine.pipeline_count >= 64 {
        return Err(PortingError::InternalError);
    }

    let pipeline: PortingPipeline = create_porting_pipeline(foreign_source_hash, profile_hash, name, version);
    let pipeline_id: Hash256 = pipeline.pipeline_id;

    engine.pipelines[engine.pipeline_count] = pipeline;
    engine.pipeline_count = engine.pipeline_count + 1;

    @emit_residual("porting_engine.start_pipeline", "pipeline_started", pipeline_id);

    return Ok(pipeline_id);
}

fn engine_get_pipeline(engine: &PortingEngine, pipeline_id: Hash256) -> Result[&PortingPipeline, PortingError]
    effects: [compute]
{
    for i in 0..engine.pipeline_count {
        if engine.pipelines[i].pipeline_id == pipeline_id {
            return Ok(engine.pipelines[i]);
        }
    }
    return Err(PortingError::InternalError);
}

fn engine_get_pipeline_mut(engine: &mut PortingEngine, pipeline_id: Hash256) -> Result[&mut PortingPipeline, PortingError]
    effects: [compute]
{
    for i in 0..engine.pipeline_count {
        if engine.pipelines[i].pipeline_id == pipeline_id {
            return Ok(engine.pipelines[i]);
        }
    }
    return Err(PortingError::InternalError);
}

