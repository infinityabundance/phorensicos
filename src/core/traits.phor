// ──────────────────────────────────────────────
// Trait: CircuitBreaker
// ──────────────────────────────────────────────
// Prevents cascading failures with circuit breaker pattern.
// Evidence path: TRAIT-CB-001 through TRAIT-CB-015

pub type CircuitState : u8 = enum {
    CircuitClosed    = 0x00,  // Normal operation
    CircuitOpen      = 0x01,  // Failing; reject requests
    CircuitHalfOpen  = 0x02,  // Testing if recovered
}

pub trait CircuitBreaker : {
    fn state(self) -> CircuitState
        effects: [deterministic]

    fn is_closed(self) -> bool
        effects: [deterministic]
        { self.state() == CircuitState::CircuitClosed }

    fn is_open(self) -> bool
        effects: [deterministic]
        { self.state() == CircuitState::CircuitOpen }

    fn is_half_open(self) -> bool
        effects: [deterministic]
        { self.state() == CircuitState::CircuitHalfOpen }

    // Record a success.
    fn record_success(self: ref mut)
        effects: [deterministic, clock]

    // Record a failure.
    fn record_failure(self: ref mut)
        effects: [deterministic, clock]

    // Get the failure count.
    fn failure_count(self) -> u32
        effects: [deterministic]

    // Get the failure threshold.
    fn failure_threshold(self) -> u32
        effects: [deterministic]

    // Get the timeout before transitioning to half-open.
    fn timeout(self) -> Duration
        effects: [deterministic]

    // Attempt to reset the circuit breaker.
    fn reset(self: ref mut)
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Trait Implementation Macros fro Core Types
// ──────────────────────────────────────────────
// Evidence path: TRAIT-IMPL2-001 through TRAIT-IMPL2-025

impl Bounded for Byte {
    fn min_value() -> Byte { Byte::from_u8(0) }
    fn max_value() -> Byte { Byte::from_u8(0xFF) }
    fn is_in_bounds(self) -> bool { true }
    fn clamp(self) -> Byte { self }
    fn range_size() -> Word64 { Word64::from_u64(256) }
}

impl Bounded for Word64 {
    fn min_value() -> Word64 { Word64::zero() }
    fn max_value() -> Word64 { Word64::max() }
    fn is_in_bounds(self) -> bool { true }
    fn clamp(self) -> Word64 { self }
    fn range_size() -> Word64 { Word64::from_u64(0xFFFF_FFFF_FFFF_FFFF) }
}

impl Bounded for Word32 {
    fn min_value() -> Word32 { Word32::zero() }
    fn max_value() -> Word32 { Word32::from_u32(0xFFFF_FFFF) }
    fn is_in_bounds(self) -> bool { true }
    fn clamp(self) -> Word32 { self }
    fn range_size() -> Word64 { Word64::from_u64(0x1_0000_0000) }
}

impl Monotonic for GenerationTag {
    fn advance(self: ref mut)
        effects: [deterministic]
    { self.bump() }

    fn current(self) -> GenerationTag
        effects: [deterministic]
    { self }

    fn is_ahead(self, other: GenerationTag) -> bool
        effects: [deterministic]
    { self.gt(other) }

    fn difference(self, other: GenerationTag) -> Word64
        effects: [deterministic]
    {
        if self.value > other.value {
            Word64::from_u64((self.value - other.value) as u64)
        } else {
            Word64::zero()
        }
    }

    fn has_wrapped(self) -> bool
        effects: [deterministic]
    { false }
}

impl Perishable for Capability {
    fn perish(self)
        effects: [deterministic, capability]
    {
        self.revoke().unwrap_or(())
    }

    fn is_perished(self) -> bool
        effects: [deterministic]
    { self.is_consumed() }
}

impl Perishable for Handle {
    fn perish(self)
        effects: [deterministic]
    {
        self.revoke()
    }

    fn is_perished(self) -> bool
        effects: [deterministic]
    { self.is_null() }
}

impl Switchable for Session {
    fn is_enabled(self) -> bool { self.is_active() }
    fn enable(self: ref mut) { /* session reactivation */ }
    fn disable(self: ref mut) { self.close() }
    fn toggle(self: ref mut) {
        if self.is_active() { self.close() } else { /* reactivate */ }
    }
    fn enable_for(self: ref mut, duration: Duration)
        effects: [deterministic, clock, timer]
    {
        self.enable()
        // In production: set timer to auto-close
    }
}

// ──────────────────────────────────────────────
// Trait Object Helpers
// ──────────────────────────────────────────────
// Evidence path: TRAIT-OBJ-001 through TRAIT-OBJ-015

// A trait-object-like wrapper that avoids hidden dynamic dispatch
// by using explicit function pointer tables.
// This is NOT a trait object — it's an explicit vtable struct.

pub type ReadableVTable : struct {
    read_fn: fn(ref mut, Offset, ref mut Byte[], Size) -> Result[Size, StoreError],
    read_byte_fn: fn(ref mut, Offset) -> Result[Byte, StoreError],
    read_word64_fn: fn(ref mut, Offset) -> Result[Word64, StoreError],
    is_available_fn: fn(Offset) -> bool,
    total_size_fn: fn() -> Result[Size, StoreError],
    verify_integrity_fn: fn(Offset, Size, Hash256) -> Result[bool, StoreError],
}

impl ReadableVTable {
    pub fn empty() -> ReadableVTable
        effects: [deterministic]
    {
        ReadableVTable {
            read_fn: |_, _, _, _| Result::Err(store_io_error(FixedString[128]::from_slice("No Readable impl"))),
            read_byte_fn: |_, _| Result::Err(store_io_error(FixedString[128]::from_slice("No Readable impl"))),
            read_word64_fn: |_, _| Result::Err(store_io_error(FixedString[128]::from_slice("No Readable impl"))),
            is_available_fn: |_| false,
            total_size_fn: || Result::Err(store_io_error(FixedString[128]::from_slice("No Readable impl"))),
            verify_integrity_fn: |_, _, _| Result::Err(store_io_error(FixedString[128]::from_slice("No Readable impl"))),
        }
    }

    pub fn new[T: Readable]() -> ReadableVTable
        effects: [deterministic]
    {
        // In production: extracts function pointers from T's Readable impl.
        ReadableVTable::empty()
    }
}

pub type WriteableVTable : struct {
    write_fn: fn(ref mut, Offset, ref Byte[], Size) -> Result[Size, StoreError],
    write_byte_fn: fn(ref mut, Offset, Byte) -> Result[(), StoreError],
    write_word64_fn: fn(ref mut, Offset, Word64) -> Result[(), StoreError],
    flush_fn: fn(ref mut) -> Result[(), StoreError],
    truncate_fn: fn(ref mut, Size) -> Result[(), StoreError],
    seal_write_fn: fn(ref mut, Hash256) -> Result[(), StoreError],
}

impl WriteableVTable {
    pub fn empty() -> WriteableVTable { /* similar to ReadableVTable::empty */ }
}

// ──────────────────────────────────────────────
// Trait Grouping and Dispatch
// ──────────────────────────────────────────────
// Evidence path: TRAIT-GROUP-001 through TRAIT-GROUP-015

// A grouping of multiple traits for a single resource type.
// Used to pass "capability bundles" across boundaries without dynamic dispatch.

pub type StorageVTable : struct {
    readable: ReadableVTable,
    writeable: WriteableVTable,
    identity_fn: fn() -> Identity,
    open_fn: fn(Handle, Capability) -> Result[Handle, StoreError],
    close_fn: fn(ref mut) -> Result[(), StoreError],
    format_fn: fn(ref mut, StorageParameters) -> Result[(), StoreError],
    metadata_fn: fn() -> Result[StorageMetadata, StoreError],
    snapshot_fn: fn(ref mut) -> Result[Handle, StoreError],
    restore_fn: fn(ref mut, Handle) -> Result[(), StoreError],
}

impl StorageVTable {
    pub fn empty() -> StorageVTable
        effects: [deterministic]
    {
        StorageVTable {
            readable: ReadableVTable::empty(),
            writeable: WriteableVTable::empty(),
            identity_fn: || Identity::null(),
            open_fn: |_, _| Result::Err(store_io_error(FixedString[128]::from_slice("No Storage impl"))),
            close_fn: |_| Result::Err(store_io_error(FixedString[128]::from_slice("No Storage impl"))),
            format_fn: |_, _| Result::Err(store_io_error(FixedString[128]::from_slice("No Storage impl"))),
            metadata_fn: || Result::Err(store_io_error(FixedString[128]::from_slice("No Storage impl"))),
            snapshot_fn: |_| Result::Err(store_io_error(FixedString[128]::from_slice("No Storage impl"))),
            restore_fn: |_, _| Result::Err(store_io_error(FixedString[128]::from_slice("No Storage impl"))),
        }
    }
}
