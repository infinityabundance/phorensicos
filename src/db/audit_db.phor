    effects: [deterministic, residual]
{
    AuditDatabase::record_event(adb, AuditSeverity::AuditSeverity_Warning, cat, msg, src, ts)
}

pub fn log_error(adb: ref mut AuditDatabase, cat: FixedString[AUDIT_NAME_CAP], msg: FixedString[512], src: FixedString[AUDIT_NAME_CAP], ts: Word64) -> Result[Word32, BoundsError>
    effects: [deterministic, residual]
{
