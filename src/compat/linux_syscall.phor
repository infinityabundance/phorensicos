//==============================================================================
// linux_syscall.phor — Linux Syscall Compatibility Layer
//
// Provides Linux syscall number mapping, argument translation, errno mapping,
// ioctl forwarding, signal compatibility, file descriptor emulation,
// fork/exec emulation, and /proc/@self emulation.
//
// All operations are capability-gated, bounded-loop, and residual-recorded.
//==============================================================================

module linux_syscall
  @[receipt("linux-compat-v1")]
  @[audit("LINUX-COMPAT")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{syscall, alloc, unsafe, io};
use core::residual::*;
use core::mem::*;
use abi::syscall_interface::*;
use abi::phor_abi::*;

//==============================================================================
// Linux Syscall Number Table
//==============================================================================

