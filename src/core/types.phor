        loop: bounds[BOUND_SMALL] for i in 0..len {
            result.data[i as usize] = slice[i]
        }
        result.length = len
        Result::Ok(result)
    }

    pub fn push_byte(self: ref mut, b: Byte) -> Result[(), BoundsError]
        effects: [deterministic]
    {
        if self.length >= N {
            return Result::Err(BoundsError::new(DIAG_COLLECTION_BASE | 0x002,
                              "FixedString capacity exceeded"))
        }
        self.data[self.length as usize] = b
        self.length = self.length + 1
        Result::Ok(())
    }

    pub fn append(self: ref mut, other: FixedString[Known]) -> Result[(), BoundsError>
        effects: [deterministic]
    {
        let other_len: u32 = other.len()
        if (self.length + other_len) > N {
            return Result::Err(BoundsError::new(DIAG_COLLECTION_BASE | 0x003,
                              "FixedString append exceeds capacity"))
        }
        // loop: bounds[BOUND_SMALL] — bounded by other length
        loop: bounds[BOUND_SMALL] for i in 0..other_len {
            self.data[(self.length + i) as usize] = other.byte_at(i)
        }
        self.length = self.length + other_len
        Result::Ok(())
    }

    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        N
    }

    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }

    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.length >= N
    }

    pub fn byte_at(self, index: u32) -> Byte
        effects: [deterministic]
    {
        // Bounds-checked access; panics on OOB.
        if index < self.length {
            self.data[index as usize]
        } else {
            Byte::from_u8(0)
        }
    }

    pub fn as_slice(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let mut slice: Byte[Slice] = Byte[Slice]::new(self.length)
        // loop: bounds[BOUND_SMALL] — bounded by length
        loop: bounds[BOUND_SMALL] for i in 0..self.length {
            slice[i] = self.data[i as usize]
        }
        slice
    }

    pub fn eq(self, other: FixedString[Known]) -> bool
        effects: [deterministic]
    {
        if self.length != other.len() {
            return false
        }
        // loop: bounds[BOUND_SMALL] — bounded by length
        loop: bounds[BOUND_SMALL] for i in 0..self.length {
            if !self.data[i as usize].eq(other.byte_at(i)) {
                return false
            }
        }
        true
    }

    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.length = 0
    }
}
