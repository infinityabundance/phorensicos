// ============================================================================
// dialect_profile.phor — DialectProfile, Dialect Classification, Profile Mgmt
// ============================================================================
// A dialect profile describes the characteristics of a foreign dialect that
// a DialectCage must handle. Profiles are used to classify foreign code,
// configure cages, and drive translation decisions.
//
// Dialect families: posix, win32, c-abi, cpp-abi, wayland, x11, etc.
// ============================================================================

package "phorensic:dialect_profile:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type ProfileError = enum {
    InvalidName = 0x01,
    InvalidVersion = 0x02,
    InvalidFamily = 0x03,
    FamilyMismatch = 0x04,
    VersionMismatch = 0x05,
    FeatureConflict = 0x06,
    RestrictionViolation = 0x07,
    ProfileNotFound = 0x08,
    ProfileAlreadyRegistered = 0x09,
    ProfileCorrupted = 0x0A,
    MaximumProfilesExceeded = 0x0B,
    IncompatibleABI = 0x0C,
    UnsupportedLanguage = 0x0D,
    MissingRequiredFeature = 0x0E,
    ProfileLocked = 0x0F,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type DialectFamily = enum {
    POSIX = 0x01,
    Win32 = 0x02,
    C = 0x03,
    CXX = 0x04,
    Wayland = 0x05,
    X11 = 0x06,
    GNU = 0x07,
    BSD = 0x08,
    LinuxKernel = 0x09,
    Assembly = 0x0A,
    WebAssembly = 0x0B,
    Custom = 0xFF,
}

type ABISpec = enum {
    SystemV_x86_64 = 0x01,
    SystemV_i386 = 0x02,
    Win64 = 0x03,
    Win32 = 0x04,
    ARM_AAPCS = 0x05,
    ARM64_AAPCS = 0x06,
    RISCV64 = 0x07,
    CustomABI = 0xFF,
}

type ObjectFormatSpec = enum {
    ELF = 0x01,
    MachO = 0x02,
    PE = 0x03,
    COFF = 0x04,
    WASM = 0x05,
    Raw = 0xFF,
}

type LinkerSpec = enum {
    GNU_LD = 0x01,
    LLVM_LD = 0x02,
    MSVC_LINK = 0x03,
    WASM_LD = 0x04,
    CustomLinker = 0xFF,
}

type LanguageID = enum {
    C89 = 0x01,
    C99 = 0x02,
    C11 = 0x03,
    C17 = 0x04,
    C23 = 0x05,
    CPP98 = 0x10,
    CPP11 = 0x11,
    CPP14 = 0x12,
    CPP17 = 0x13,
    CPP20 = 0x14,
    CPP23 = 0x15,
    Rust = 0x20,
    Assembly_x86 = 0x30,
    Assembly_ARM = 0x31,
    Assembly_RISCV = 0x32,
    WaylandProtocol = 0x40,
    CustomLanguage = 0xFF,
}

// ============================================================================
// Entry Point Description
// ============================================================================

type EntryPoint = struct {
    name: FixedString[128],
    signature: FixedString[256],
    effect_tags: Array[FixedString[64], 8],
    effect_count: u64,
    argument_count: u64,
    return_type: FixedString[64],
    is_variadic: bool,
    calling_convention: FixedString[64],
}

// ============================================================================
// Syscall Mapping
// ============================================================================

type SyscallEntry = struct {
    syscall_number: u64,
    syscall_name: FixedString[128],
    argument_types: Array[FixedString[64], 8],
    argument_count: u64,
    return_type: FixedString[64],
    expected_effects: Array[FixedString[64], 4],
    effect_count: u64,
}

type SyscallTable = struct {
    entries: Array[SyscallEntry, 512],
    entry_count: u64,
}

// ============================================================================
// Library Import
// ============================================================================

type LibraryImport = struct {
    library_name: FixedString[128],
    expected_signature: FixedString[256],
    version_required: FixedString[32],
    is_optional: bool,
    is_static: bool,
}

type LibraryImportTable = struct {
    imports: Array[LibraryImport, 256],
    import_count: u64,
}

// ============================================================================
// DialectProfile
// ============================================================================

type DialectProfile = struct {
    profile_hash: Hash256,
    dialect_name: FixedString[128],
    dialect_version: FixedString[32],
    dialect_family: DialectFamily,
    language: LanguageID,
    abi_spec: ABISpec,
    object_format: ObjectFormatSpec,
    linker_assumptions: LinkerSpec,
    entry_points: Array[EntryPoint, 128],
    entry_point_count: u64,
    syscall_table: SyscallTable,
    library_imports: LibraryImportTable,
    features: Array[FixedString[128], 64],
    feature_count: u64,
    restrictions: Array[FixedString[128], 64],
    restriction_count: u64,
    complexity_score: u64,
    source_language_detected: Array[LanguageID, 8],
    detected_language_count: u64,
    targeting_platform: FixedString[128],
    compiler_version_min: FixedString[32],
    compiler_version_max: FixedString[32],
    ub_reliance_count: u64,
    is_locked: bool,
    registration_time: u64,
    generation: u64,
}

// ============================================================================
// FixedString and Hash256 (forward declarations match cage.phor)
// ============================================================================

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

type Hash256 = struct {
    bytes: Array[u8, 32],
}

// ============================================================================
// Profile Registry (global — fixed capacity)
// ============================================================================

type DialectProfileRegistry = struct {
    profiles: Array[DialectProfile, 256],
    profile_count: u64,
    generation: u64,
}

// ============================================================================
// Create Empty Profile
// ============================================================================

fn create_profile(name: &FixedString[128], version: &FixedString[32], family: DialectFamily, language: LanguageID) -> Result[DialectProfile, ProfileError]
    effects: [compute, residual]
{
    // Validate name is not empty
    if name.len == 0 {
        return Err(ProfileError::InvalidName);
    }

    // Validate version is not empty
    if version.len == 0 {
        return Err(ProfileError::InvalidVersion);
    }

    // Validate family is recognized
    if family == DialectFamily::Custom {
        // Custom is allowed
    }

    // Generate profile hash from name + version + family
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let profile_hash: Hash256 = hash_name_version(name, version, family);

    let empty_entries: Array[EntryPoint, 128] = Array[EntryPoint, 128]::zeroed();
    let empty_syscalls: Array[SyscallEntry, 512] = Array[SyscallEntry, 512]::zeroed();
    let empty_imports: Array[LibraryImport, 256] = Array[LibraryImport, 256]::zeroed();
    let empty_features: Array[FixedString[128], 64] = Array[FixedString[128], 64]::zeroed();
    let empty_restrictions: Array[FixedString[128], 64] = Array[FixedString[128], 64]::zeroed();
    let empty_languages: Array[LanguageID, 8] = Array[LanguageID, 8]::zeroed();

    let profile: DialectProfile = DialectProfile {
        profile_hash: profile_hash,
        dialect_name: *name,
        dialect_version: *version,
        dialect_family: family,
        language: language,
        abi_spec: ABISpec::SystemV_x86_64,
        object_format: ObjectFormatSpec::ELF,
        linker_assumptions: LinkerSpec::GNU_LD,
        entry_points: empty_entries,
        entry_point_count: 0,
        syscall_table: SyscallTable {
            entries: empty_syscalls,
            entry_count: 0,
        },
        library_imports: LibraryImportTable {
            imports: empty_imports,
            import_count: 0,
        },
        features: empty_features,
        feature_count: 0,
        restrictions: empty_restrictions,
        restriction_count: 0,
        complexity_score: 0,
        source_language_detected: empty_languages,
        detected_language_count: 1,
        targeting_platform: FixedString[128]::zeroed(),
        compiler_version_min: FixedString[32]::zeroed(),
        compiler_version_max: FixedString[32]::zeroed(),
        ub_reliance_count: 0,
        is_locked: false,
        registration_time: kernel.tick_count(),
        generation: 1,
    };

    profile.source_language_detected[0] = language;

    @emit_residual("profile.create", "profile_created", profile_hash);

    return Ok(profile);
}

// ============================================================================
// Add Entry Point to Profile
// ============================================================================

fn profile_add_entry(profile: &mut DialectProfile, entry: EntryPoint) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    if profile.entry_point_count >= 128 {
        return Err(ProfileError::MaximumProfilesExceeded);
    }

    // Check for duplicate entry name
    for i in 0..profile.entry_point_count {
        if profile.entry_points[i].name == entry.name {
            return Err(ProfileError::FeatureConflict);
        }
    }

    profile.entry_points[profile.entry_point_count] = entry;
    profile.entry_point_count = profile.entry_point_count + 1;

    @emit_residual("profile.add_entry", "entry_point_added", profile.entry_point_count);

    return Ok(());
}

// ============================================================================
// Add Syscall to Profile
// ============================================================================

fn profile_add_syscall(profile: &mut DialectProfile, syscall: SyscallEntry) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    if profile.syscall_table.entry_count >= 512 {
        return Err(ProfileError::MaximumProfilesExceeded);
    }

    // Check for duplicate syscall number
    for i in 0..profile.syscall_table.entry_count {
        if profile.syscall_table.entries[i].syscall_number == syscall.syscall_number {
            return Err(ProfileError::FeatureConflict);
        }
    }

    profile.syscall_table.entries[profile.syscall_table.entry_count] = syscall;
    profile.syscall_table.entry_count = profile.syscall_table.entry_count + 1;

    @emit_residual("profile.add_syscall", "syscall_added", syscall.syscall_number);

    return Ok(());
}

// ============================================================================
// Add Library Import to Profile
// ============================================================================

fn profile_add_import(profile: &mut DialectProfile, import: LibraryImport) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    if profile.library_imports.import_count >= 256 {
        return Err(ProfileError::MaximumProfilesExceeded);
    }

    profile.library_imports.imports[profile.library_imports.import_count] = import;
    profile.library_imports.import_count = profile.library_imports.import_count + 1;

    @emit_residual("profile.add_import", "library_import_added", profile.library_imports.import_count);

    return Ok(());
}

// ============================================================================
// Add Feature to Profile
// ============================================================================

fn profile_add_feature(profile: &mut DialectProfile, feature: &FixedString[128]) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    if profile.feature_count >= 64 {
        return Err(ProfileError::MaximumProfilesExceeded);
    }

    // Check for duplicate
    for i in 0..profile.feature_count {
        if profile.features[i] == *feature {
            return Err(ProfileError::FeatureConflict);
        }
    }

    profile.features[profile.feature_count] = *feature;
    profile.feature_count = profile.feature_count + 1;

    @emit_residual("profile.add_feature", "feature_added", profile.feature_count);

    return Ok(());
}

// ============================================================================
// Add Restriction to Profile
// ============================================================================

fn profile_add_restriction(profile: &mut DialectProfile, restriction: &FixedString[128]) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    if profile.restriction_count >= 64 {
        return Err(ProfileError::MaximumProfilesExceeded);
    }

    profile.restrictions[profile.restriction_count] = *restriction;
    profile.restriction_count = profile.restriction_count + 1;

    @emit_residual("profile.add_restriction", "restriction_added", profile.restriction_count);

    return Ok(());
}

// ============================================================================
// Lock Profile
// ============================================================================
// Once locked, a profile cannot be modified. This ensures consistency
// for cages that reference it.

fn lock_profile(profile: &mut DialectProfile) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    profile.is_locked = true;

    @emit_residual("profile.lock", "profile_locked", profile.generation);

    return Ok(());
}

// ============================================================================
// Set ABI Spec on Profile
// ============================================================================

fn profile_set_abi(profile: &mut DialectProfile, abi: ABISpec) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    profile.abi_spec = abi;

    @emit_residual("profile.set_abi", "abi_set", abi as u64);

    return Ok(());
}

// ============================================================================
// Set Object Format on Profile
// ============================================================================

fn profile_set_object_format(profile: &mut DialectProfile, fmt: ObjectFormatSpec) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    profile.object_format = fmt;

    @emit_residual("profile.set_object_format", "object_format_set", fmt as u64);

    return Ok(());
}

// ============================================================================
// Set Linker Spec on Profile
// ============================================================================

fn profile_set_linker(profile: &mut DialectProfile, linker: LinkerSpec) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    profile.linker_assumptions = linker;

    @emit_residual("profile.set_linker", "linker_set", linker as u64);

    return Ok(());
}

// ============================================================================
// Add Detected Language to Profile
// ============================================================================

fn profile_add_language(profile: &mut DialectProfile, lang: LanguageID) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.detected_language_count >= 8 {
        return Err(ProfileError::MaximumProfilesExceeded);
    }

    // Check for duplicate
    for i in 0..profile.detected_language_count {
        if profile.source_language_detected[i] == lang {
            return Err(ProfileError::FeatureConflict);
        }
    }

    profile.source_language_detected[profile.detected_language_count] = lang;
    profile.detected_language_count = profile.detected_language_count + 1;

    @emit_residual("profile.add_language", "language_detected", lang as u64);

    return Ok(());
}

// ============================================================================
// Set Target Platform
// ============================================================================

fn profile_set_target(profile: &mut DialectProfile, target: &FixedString[128]) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    profile.targeting_platform = *target;

    @emit_residual("profile.set_target", "target_set", profile.feature_count);

    return Ok(());
}

// ============================================================================
// Set Compiler Version Range
// ============================================================================

fn profile_set_compiler_range(profile: &mut DialectProfile, min_ver: &FixedString[32], max_ver: &FixedString[32]) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    if profile.is_locked {
        return Err(ProfileError::ProfileLocked);
    }

    profile.compiler_version_min = *min_ver;
    profile.compiler_version_max = *max_ver;

    @emit_residual("profile.set_compiler_range", "compiler_range_set", 0);

    return Ok(());
}

// ============================================================================
// Compute Complexity Score
// ============================================================================
// Scores the complexity of a dialect based on entry points, syscalls,
// library imports, features, and restrictions.

fn compute_complexity_score(profile: &DialectProfile) -> u64
    effects: [compute]
{
    let mut score: u64 = 0;

    // Base score from entry points
    score = score + profile.entry_point_count * 10;

    // Syscall complexity
    score = score + profile.syscall_table.entry_count * 20;

    // Library import complexity
    score = score + profile.library_imports.import_count * 15;

    // Feature diversity
    score = score + profile.feature_count * 5;

    // Restriction penalties
    score = score + profile.restriction_count * 8;

    // UB reliance penalty
    score = score + profile.ub_reliance_count * 50;

    // Language diversity bonus
    score = score + profile.detected_language_count * 25;

    return score;
}

// ============================================================================
// Profile Compatibility Check
// ============================================================================
// Checks whether two dialect profiles are compatible for merging or chaining.

fn check_profile_compatibility(a: &DialectProfile, b: &DialectProfile) -> Result[bool, ProfileError]
    effects: [compute]
{
    // Family must match for compatibility
    if a.dialect_family != b.dialect_family {
        return Err(ProfileError::FamilyMismatch);
    }

    // ABI must match
    if a.abi_spec != b.abi_spec {
        return Err(ProfileError::IncompatibleABI);
    }

    // Check for conflicting features
    for i in 0..a.feature_count {
        for j in 0..b.feature_count {
            if a.features[i] == b.features[j] {
                // Feature exists in both — allowed
            }
        }
    }

    // Check for conflicting restrictions
    for i in 0..a.restriction_count {
        for j in 0..b.restriction_count {
            if a.restrictions[i] == b.restrictions[j] {
                // Restriction exists in both — allowed
            }
        }
    }

    return Ok(true);
}

// ============================================================================
// Classify Foreign Code
// ============================================================================
// Scans foreign code to determine its dialect profile.

fn classify_foreign_code(code: &Array[u8, 1048576], code_len: u64) -> Result[DialectClassification, ProfileError]
    effects: [compute, residual]
{
    let empty_files: Array[FixedString[256], 256] = Array[FixedString[256], 256]::zeroed();
    let empty_langs: Array[LanguageID, 8] = Array[LanguageID, 8]::zeroed();

    let classification: DialectClassification = DialectClassification {
        source_languages: empty_langs,
        detected_language_count: 0,
        abi_family: ABISpec::SystemV_x86_64,
        syscall_surface: SyscallTable {
            entries: Array[SyscallEntry, 512]::zeroed(),
            entry_count: 0,
        },
        library_dependencies: LibraryImportTable {
            imports: Array[LibraryImport, 256]::zeroed(),
            import_count: 0,
        },
        build_system_type: BuildSystemType::Unknown,
        target_platform_assumptions: empty_files,
        assumption_count: 0,
        compiler_version_required: FixedString[32]::zeroed(),
        runtime_version_required: FixedString[32]::zeroed(),
        ub_reliance_sites: Array[UBSite, 64]::zeroed(),
        ub_site_count: 0,
        dialect_complexity_score: 0,
    };

    // Scan first 4096 bytes for language indicators
    let scan_limit: u64 = if code_len < 4096 { code_len } else { 4096 };

    for i in 0..scan_limit {
        // Check for C/C++ keywords
        if code[i] == '#' as u8 && i + 1 < scan_limit {
            if code[i + 1] == 'i' as u8 {
                // Could be #include — C/C++ indicator
                if classification.detected_language_count < 8 {
                    classification.source_languages[classification.detected_language_count] = LanguageID::C89;
                    classification.detected_language_count = classification.detected_language_count + 1;
                }
                break;
            }
        }

        // Check for ELF magic
        if code[i] == 0x7F && i + 3 < scan_limit {
            if code[i + 1] == 'E' as u8 && code[i + 2] == 'L' as u8 && code[i + 3] == 'F' as u8 {
                // ELF binary detected
                classification.abi_family = ABISpec::SystemV_x86_64;
                break;
            }
        }

        // Check for Wayland protocol XML
        if code[i] == '<' as u8 && i + 20 < scan_limit {
            // Simple check for XML protocol declaration
        }
    }

    classification.dialect_complexity_score = compute_classification_score(&classification);

    @emit_residual("profile.classify", "code_classified", classification.dialect_complexity_score);

    return Ok(classification);
}

// ============================================================================
// DialectClassification (returned by classify_foreign_code)
// ============================================================================

type BuildSystemType = enum {
    Unknown = 0x00,
    Autotools = 0x01,
    CMake = 0x02,
    Make = 0x03,
    Meson = 0x04,
    Bazel = 0x05,
    Cargo = 0x06,
    MSBuild = 0x07,
    Ninja = 0x08,
    Custom = 0xFF,
}

type UBSite = struct {
    location: FixedString[256],
    ub_type: FixedString[128],
    observed_behavior: FixedString[256],
    platform_assumption: FixedString[256],
}

type DialectClassification = struct {
    source_languages: Array[LanguageID, 8],
    detected_language_count: u64,
    abi_family: ABISpec,
    syscall_surface: SyscallTable,
    library_dependencies: LibraryImportTable,
    build_system_type: BuildSystemType,
    target_platform_assumptions: Array[FixedString[256], 256],
    assumption_count: u64,
    compiler_version_required: FixedString[32],
    runtime_version_required: FixedString[32],
    ub_reliance_sites: Array[UBSite, 64],
    ub_site_count: u64,
    dialect_complexity_score: u64,
}

// ============================================================================
// Compute Classification Score
// ============================================================================

fn compute_classification_score(class: &DialectClassification) -> u64
    effects: [compute]
{
    let mut score: u64 = 0;

    // Language diversity
    score = score + class.detected_language_count * 20;

    // Syscall surface
    score = score + class.syscall_surface.entry_count * 15;

    // Library dependencies
    score = score + class.library_dependencies.import_count * 10;

    // Platform assumptions
    score = score + class.assumption_count * 8;

    // UB sites
    score = score + class.ub_site_count * 30;

    return score;
}

// ============================================================================
// Generate Profile From Classification
// ============================================================================

fn generate_profile_from_classification(class: &DialectClassification) -> Result[DialectProfile, ProfileError]
    effects: [compute, residual]
{
    let name: FixedString[128] = FixedString[128]::from_literal("auto-classified-dialect");
    let version: FixedString[32] = FixedString[32]::from_literal("1.0.0");
    let family: DialectFamily = map_abi_to_family(class.abi_family);
    let primary_lang: LanguageID = if class.detected_language_count > 0 { class.source_languages[0] } else { LanguageID::CustomLanguage };

    let mut profile: DialectProfile = create_profile(&name, &version, family, primary_lang)?;

    // Set ABI from classification
    profile_set_abi(&mut profile, class.abi_family)?;

    // Copy syscall surface
    for i in 0..class.syscall_surface.entry_count {
        profile_add_syscall(&mut profile, class.syscall_surface.entries[i])?;
    }

    // Copy library dependencies
    for i in 0..class.library_dependencies.import_count {
        profile_add_import(&mut profile, class.library_dependencies.imports[i])?;
    }

    // Set complexity score
    profile.complexity_score = class.dialect_complexity_score;

    // Add UB sites
    for i in 0..class.ub_site_count {
        let feature: FixedString[128] = FixedString[128]::from_literal("ub_site_detected");
        profile_add_feature(&mut profile, &feature)?;
    }

    // Add languages
    for i in 0..class.detected_language_count {
        profile_add_language(&mut profile, class.source_languages[i])?;
    }

    @emit_residual("profile.generate", "profile_generated", profile.profile_hash);

    return Ok(profile);
}

// ============================================================================
// Map ABI to Family
// ============================================================================

fn map_abi_to_family(abi: ABISpec) -> DialectFamily
    effects: [compute]
{
    match abi {
        ABISpec::SystemV_x86_64 => return DialectFamily::POSIX;
        ABISpec::SystemV_i386 => return DialectFamily::POSIX;
        ABISpec::Win64 => return DialectFamily::Win32;
        ABISpec::Win32 => return DialectFamily::Win32;
        ABISpec::ARM_AAPCS => return DialectFamily::POSIX;
        ABISpec::ARM64_AAPCS => return DialectFamily::POSIX;
        ABISpec::RISCV64 => return DialectFamily::POSIX;
        ABISpec::CustomABI => return DialectFamily::Custom;
    }
}

// ============================================================================
// Profile Registry Operations
// ============================================================================

fn create_profile_registry() -> DialectProfileRegistry
    effects: [compute]
{
    let empty: Array[DialectProfile, 256] = Array[DialectProfile, 256]::zeroed();
    return DialectProfileRegistry {
        profiles: empty,
        profile_count: 0,
        generation: 1,
    };
}

fn registry_register(registry: &mut DialectProfileRegistry, profile: DialectProfile) -> Result[Hash256, ProfileError]
    effects: [compute, residual]
{
    if registry.profile_count >= 256 {
        return Err(ProfileError::MaximumProfilesExceeded);
    }

    // Check for duplicate by name and version
    for i in 0..registry.profile_count {
        if registry.profiles[i].dialect_name == profile.dialect_name &&
           registry.profiles[i].dialect_version == profile.dialect_version {
            return Err(ProfileError::ProfileAlreadyRegistered);
        }
    }

    let hash: Hash256 = profile.profile_hash;
    registry.profiles[registry.profile_count] = profile;
    registry.profile_count = registry.profile_count + 1;

    @emit_residual("registry.register", "profile_registered", hash);

    return Ok(hash);
}

fn registry_find(registry: &DialectProfileRegistry, name: &FixedString[128], version: &FixedString[32]) -> Result[&DialectProfile, ProfileError]
    effects: [compute]
{
    for i in 0..registry.profile_count {
        if registry.profiles[i].dialect_name == *name &&
           registry.profiles[i].dialect_version == *version {
            return Ok(registry.profiles[i]);
        }
    }
    return Err(ProfileError::ProfileNotFound);
}

fn registry_find_by_family(registry: &DialectProfileRegistry, family: DialectFamily) -> Result[Array[DialectProfile, 256], ProfileError]
    effects: [compute]
{
    let mut results: Array[DialectProfile, 256] = Array[DialectProfile, 256]::zeroed();
    let mut count: u64 = 0;

    for i in 0..registry.profile_count {
        if registry.profiles[i].dialect_family == family {
            if count < 256 {
                results[count] = registry.profiles[i];
                count = count + 1;
            }
        }
    }

    return Ok(results);
}

fn registry_remove(registry: &mut DialectProfileRegistry, name: &FixedString[128], version: &FixedString[32]) -> Result[(), ProfileError]
    effects: [compute, residual]
{
    for i in 0..registry.profile_count {
        if registry.profiles[i].dialect_name == *name &&
           registry.profiles[i].dialect_version == *version {
            // Shift remaining profiles
            for j in i..registry.profile_count - 1 {
                registry.profiles[j] = registry.profiles[j + 1];
            }
            registry.profile_count = registry.profile_count - 1;

            @emit_residual("registry.remove", "profile_removed", 0);
            return Ok(());
        }
    }
    return Err(ProfileError::ProfileNotFound);
}

// ============================================================================
// Hash Helper
// ============================================================================

fn hash_name_version(name: &FixedString[128], version: &FixedString[32], family: DialectFamily) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let family_byte: u8 = family as u8;

    // Mix name bytes
    for i in 0..name.len {
        let idx: u64 = i & 31;
        result.bytes[idx] = result.bytes[idx] ^ name.data[i];
    }

    // Mix version bytes
    for i in 0..version.len {
        let idx: u64 = (i + 8) & 31;
        result.bytes[idx] = result.bytes[idx] ^ version.data[i];
    }

    // Mix family
    result.bytes[0] = result.bytes[0] ^ family_byte;

    return result;
}

// ============================================================================
// Validate Profile Integrity
// ============================================================================
// Validates that a profile is internally consistent and has all required fields.

fn validate_profile(profile: &DialectProfile) -> Result[bool, ProfileError]
    effects: [compute]
{
    // Name must not be empty
    if profile.dialect_name.len == 0 {
        return Err(ProfileError::InvalidName);
    }

    // Version must not be empty
    if profile.dialect_version.len == 0 {
        return Err(ProfileError::InvalidVersion);
    }

    // Must have at least one entry point for executable dialect
    // (library dialects may have zero entry points)
    // This is a soft check — no error if zero entry points

    // Syscall numbers must be unique
    for i in 0..profile.syscall_table.entry_count {
        for j in (i + 1)..profile.syscall_table.entry_count {
            if profile.syscall_table.entries[i].syscall_number ==
               profile.syscall_table.entries[j].syscall_number {
                return Err(ProfileError::FeatureConflict);
            }
        }
    }

    // Library imports must have names
    for i in 0..profile.library_imports.import_count {
        if profile.library_imports.imports[i].library_name.len == 0 {
            return Err(ProfileError::InvalidName);
        }
    }

    return Ok(true);
}

// ============================================================================
// Merge Two Profiles
// ============================================================================
// Merges two compatible profiles into one. Both must be from the same family.

fn merge_profiles(a: &DialectProfile, b: &DialectProfile) -> Result[DialectProfile, ProfileError]
    effects: [compute, residual]
{
    // Check compatibility
    let compatible: bool = check_profile_compatibility(a, b)?;

    let merged_name: FixedString[128] = FixedString[128]::from_literal("merged-profile");
    let merged_version: FixedString[32] = FixedString[32]::from_literal("1.0.0-merged");

    let mut merged: DialectProfile = create_profile(&merged_name, &merged_version, a.dialect_family, a.language)?;

    // Copy entry points from both
    for i in 0..a.entry_point_count {
        profile_add_entry(&mut merged, a.entry_points[i])?;
    }
    for i in 0..b.entry_point_count {
        // Check for duplicate before adding
        let mut duplicate: bool = false;
        for j in 0..a.entry_point_count {
            if a.entry_points[j].name == b.entry_points[i].name {
                duplicate = true;
                break;
            }
        }
        if !duplicate {
            profile_add_entry(&mut merged, b.entry_points[i])?;
        }
    }

    // Copy syscalls from both
    for i in 0..a.syscall_table.entry_count {
        profile_add_syscall(&mut merged, a.syscall_table.entries[i])?;
    }
    for i in 0..b.syscall_table.entry_count {
        // Check for duplicate
        let mut duplicate: bool = false;
        for j in 0..a.syscall_table.entry_count {
            if a.syscall_table.entries[j].syscall_number == b.syscall_table.entries[i].syscall_number {
                duplicate = true;
                break;
            }
        }
        if !duplicate {
            profile_add_syscall(&mut merged, b.syscall_table.entries[i])?;
        }
    }

    // Copy features from both
    for i in 0..a.feature_count {
        profile_add_feature(&mut merged, &a.features[i])?;
    }
    for i in 0..b.feature_count {
        profile_add_feature(&mut merged, &b.features[i])?;
    }

    // Copy languages from both
    for i in 0..a.detected_language_count {
        profile_add_language(&mut merged, a.source_language_detected[i])?;
    }
    for i in 0..b.detected_language_count {
        profile_add_language(&mut merged, b.source_language_detected[i])?;
    }

    // Compute merged complexity
    merged.complexity_score = compute_complexity_score(&merged);

    @emit_residual("profile.merge", "profiles_merged", merged.profile_hash);

    return Ok(merged);
}
