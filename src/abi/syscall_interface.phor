//==============================================================================
// syscall_interface.phor — Phorensic Syscall Interface
//
// Defines the complete syscall ABI: syscall numbers, argument marshaling,
// capability validation, return value encoding, error propagation,
// syscall tracing, audit hooks, residual generation for every syscall.
//
// Every syscall path is capability-gated and residual-recorded.
//==============================================================================

module syscall_interface
  @[receipt("syscall-interface-v1")]
  @[audit("SYSCALL-DEF")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{syscall, audit, alloc, unsafe, io, unwind};
use core::residual::*;
use core::mem::*;
use core::sync::atomic;
use abi::phor_abi::*;

//==============================================================================
// Syscall Number Table
//==============================================================================

/// Syscall number assignment — all Phorensic-specific syscalls.
pub enum SyscallNumber : u64 {
  // --- Process Management (0x00-0x0F) ---
  Exit                      = 0x00,
  Fork                      = 0x01,
  Exec                      = 0x02,
  Wait                      = 0x03,
  GetPid                    = 0x04,
  GetTid                    = 0x05,
  Kill                      = 0x06,
  Sleep                     = 0x07,
  Yield                     = 0x08,
  SetPriority               = 0x09,
  GetPriority               = 0x0A,
  CreateThread              = 0x0B,
  ExitThread                = 0x0C,
  JoinThread                = 0x0D,
  DetachThread              = 0x0E,
  ThreadSelf                = 0x0F,

  // --- Memory Management (0x10-0x1F) ---
  MapMemory                 = 0x10,
  UnmapMemory               = 0x11,
  ProtectMemory             = 0x12,
  AllocateCap               = 0x13,
  RevokeCap                 = 0x14,
  SealCap                   = 0x15,
  UnsealCap                 = 0x16,
  GrantCap                  = 0x17,
  MemShare                  = 0x18,
  MemInfo                   = 0x19,
  AllocateResidual          = 0x1A,
  ReleaseResidual           = 0x1B,

  // --- Capability Operations (0x20-0x2F) ---
  CapInspect                = 0x20,
  CapReduce                 = 0x21,
  CapCopy                   = 0x22,
  CapMove                   = 0x23,
  CapDelete                 = 0x24,
  CapDerive                 = 0x25,
  CapValidate               = 0x26,
  CapList                   = 0x27,
  CapTransfer               = 0x28,
  CapMint                   = 0x29,
  CapBurn                   = 0x2A,
  CapRestrict               = 0x2B,
  CapUnrestrict             = 0x2C,

  // --- IPC and Communication (0x30-0x3F) ---
  SendMessage               = 0x30,
  ReceiveMessage            = 0x31,
  CreateChannel             = 0x32,
  CloseChannel              = 0x33,
  ChannelSelect             = 0x34,
  ChannelInfo               = 0x35,
  SignalSend                = 0x36,
  SignalWait                = 0x37,
  SharedMemoryOpen          = 0x38,
  SharedMemoryClose         = 0x39,
  PipeCreate                = 0x3A,
  PipeRead                  = 0x3B,
  PipeWrite                 = 0x3C,
  SocketCreate              = 0x3D,
  SocketConnect             = 0x3E,
  SocketSend                = 0x3F,

  // --- I/O Operations (0x40-0x4F) ---
  Open                      = 0x40,
  Close                     = 0x41,
  Read                      = 0x42,
  Write                     = 0x43,
  Seek                      = 0x44,
  FStat                     = 0x45,
  FSync                     = 0x46,
  FTruncate                 = 0x47,
  IOControl                 = 0x48,
  Mmap                       = 0x49,
  Munmap                    = 0x4A,
  DirectoryCreate           = 0x4B,
  DirectoryRead             = 0x4C,
  Link                      = 0x4D,
  Unlink                    = 0x4E,
  Rename                    = 0x4F,

  // --- Audit and Residual (0x50-0x5F) ---
  AuditEvent                = 0x50,
  ReadResidual              = 0x51,
  ClearResidual             = 0x52,
  SetAuditFilter            = 0x53,
  GetAuditLog               = 0x54,
  AttachResidualChain        = 0x55,
  DetachResidualChain        = 0x56,
  QueryResidualStats         = 0x57,
  EnableTracing             = 0x58,
  DisableTracing            = 0x59,
  TracePoint                = 0x5A,

  // --- Timer and Clock (0x60-0x6F) ---
  ClockGetTime              = 0x60,
  ClockSetTime              = 0x61,
  TimerCreate               = 0x62,
  TimerDelete               = 0x63,
  TimerSet                  = 0x64,
  TimerWait                 = 0x65,
  Nanosleep                 = 0x66,
  GetTsc                    = 0x67,

  // --- Security and Capability (0x70-0x7F) ---
  SecurityInfo              = 0x70,
  CapabilityDebug           = 0x71,
  SetCapPolicy             = 0x72,
  GetCapPolicy             = 0x73,
  AuditPolicy              = 0x74,
  LoadCapModule            = 0x75,
  UnloadCapModule          = 0x76,
  QueryCaps               = 0x77,

  // --- Hypervisor (0x80-0x8F) ---
  VMCreate                  = 0x80,
  VMRun                     = 0x81,
  VMDestroy                 = 0x82,
  VMPause                   = 0x83,
  VMResume                  = 0x84,
  VMInjectIRQ              = 0x85,
  VMMapMemory              = 0x86,
  VMUnmapMemory            = 0x87,
  VMQueryState             = 0x88,
  VMSetRegisters           = 0x89,
  VMGetRegisters           = 0x8A,
  VMMigrate                = 0x8B,
  VMSnapshot               = 0x8C,
  VMRestore                = 0x8D,

  // --- Debug and Profiling (0x90-0x9F) ---
  DebugBreak               = 0x90,
  DebugReadReg             = 0x91,
  DebugWriteReg            = 0x92,
  ProfilingStart           = 0x93,
  ProfilingStop            = 0x94,
  ProfilingRead            = 0x95,
  SetWatchpoint             = 0x96,
  ClearWatchpoint           = 0x97,

  // --- Compatibility Layer (0xA0-0xAF) ---
  LinuxSyscall              = 0xA0,
  Win32Syscall              = 0xA1,
  PosixCompat               = 0xA2,
  TranslateError            = 0xA3,
  GetCompatInfo            = 0xA4,
  SetCompatMode            = 0xA5,

  // --- Module Loading (0xB0-0xBF) ---
  LoadModule                = 0xB0,
  UnloadModule              = 0xB1,
  QueryModule               = 0xB2,
  GetSymbol                 = 0xB3,
  ModuleInfo                = 0xB4,

  // --- Residual and Audit (0xC0-0xCF) ---
  ReadAuditLog              = 0xC0,
  ClearAuditLog             = 0xC1,
  SetAuditMask             = 0xC2,
  GetAuditMask             = 0xC3,
  FlushResiduals            = 0xC4,
  ArchiveResiduals          = 0xC5,

  // --- Reserved for future expansion ---
  Reserved0                 = 0xD0,
  Reserved1                 = 0xD1,
  Reserved2                 = 0xD2,
  Reserved3                 = 0xD3,
  Reserved4                 = 0xD4,
  Reserved5                 = 0xD5,

  // --- Platform-specific (0xE0-0xFF) ---
  PlatformBase              = 0xE0,
}

/// Maximum syscall number value.
const MAX_SYSCALL_NUMBER: u64 = 0xFF;

/// Total number of defined syscalls.
const TOTAL_SYSCALL_COUNT: u32 = 256;

//==============================================================================
// Syscall Argument Marshaling
//==============================================================================

/// Syscall argument descriptor — used to validate and marshal arguments.
pub struct SyscallArg(
  kind: SyscallArgKind,
  value: u64,
  size: u32,
  capability_slot: Option[CapabilitySlot],
  is_affine: bool,
  requires_audit: bool,
) : effect:(pure);

pub enum SyscallArgKind : u8 {
  Integer     = 0,
  Pointer     = 1,
  Capability  = 2,
  Buffer      = 3,
  Handle      = 4,
  Flags       = 5,
  Structure   = 6,
  String      = 7,
  ResidualRef = 8,
  AffineId    = 9,
}

/// Complete set of marshaled arguments for a syscall.
pub struct MarshaledSyscall(
  number: SyscallNumber,
  args: [SyscallArg; 8],
  num_args: u32,
  caller_cap_token: u64,
  caller_thread_id: u64,
  caller_process_id: u64,
  timestamp: u64,
  generation: u64,
) : effect:(alloc);

/// Marshal user-space arguments into kernel-space representation.
pub fn marshal_syscall_args[
  raw_args: SyscallArgs,
  call_site: u64,
  caller_cap: CapabilitySlot,
] -> Result[MarshaledSyscall, SyscallError] : (syscall, alloc, unsafe)
  loop: bounded(8)
{
  let num: SyscallNumber = @int_to_enum(raw_args.number);
  let signature: SyscallSignature = lookup_syscall_signature(num);
  let mut marshaled: MarshaledSyscall = MarshaledSyscall(
    number: num,
    args: Default,
    num_args: signature.num_params,
    caller_cap_token: caller_cap.generation,
    caller_thread_id: get_current_thread_id(),
    caller_process_id: get_current_process_id(),
    timestamp: read_timestamp(),
    generation: generate_unique_id(),
  );

  let raw_values: [u64; 6] = [
    raw_args.arg0, raw_args.arg1, raw_args.arg2,
    raw_args.arg3, raw_args.arg4, raw_args.arg5,
  ];

  for var i: u32 = 0; i < signature.num_params; i += 1 {
    let param_type: SyscallParamType = signature.params[i];
    let raw_val: u64 = raw_values[i];
    let arg: SyscallArg = classify_and_validate_param(param_type, raw_val, i)?;
    marshaled.args[i] = arg;
  }

  // Handle capability arguments if present
  if let Some(cap0) = raw_args.cap0 {
    marshaled.args[signature.num_params] = SyscallArg(
      kind: SyscallArgKind::Capability,
      value: cap0.value,
      size: 16,
      capability_slot: Some(cap0),
      is_affine: false,
      requires_audit: true,
    );
    marshaled.num_args += 1;
  }
  if let Some(cap1) = raw_args.cap1 {
    let idx: u32 = marshaled.num_args;
    marshaled.args[idx] = SyscallArg(
      kind: SyscallArgKind::Capability,
      value: cap1.value,
      size: 16,
      capability_slot: Some(cap1),
      is_affine: false,
      requires_audit: true,
    );
    marshaled.num_args += 1;
  }

  // Validate the caller has capability to invoke this syscall
  validate_syscall_capability(num, caller_cap)?;

  // Audit the syscall entry
  audit_syscall_entry(num, &marshaled);

  return Ok(marshaled);
}

/// Classify and validate a single syscall parameter.
fn classify_and_validate_param[
  param_type: SyscallParamType,
  raw_value: u64,
  index: u32,
] -> Result[SyscallArg, SyscallError] : (syscall, unsafe)
  loop: bounded(1)
{
  match param_type {
    SyscallParamType::Integer => {
      return Ok(SyscallArg(
        kind: SyscallArgKind::Integer,
        value: raw_value,
        size: 8,
        capability_slot: None,
        is_affine: false,
        requires_audit: false,
      ));
    },
    SyscallParamType::Pointer => {
      // Validate pointer is in valid user address range
      if !is_user_address(raw_value) {
        return Err(SyscallError::BadAddress);
      }
      return Ok(SyscallArg(
        kind: SyscallArgKind::Pointer,
        value: raw_value,
        size: 8,
        capability_slot: None,
        is_affine: false,
        requires_audit: false,
      ));
    },
    SyscallParamType::Buffer => {
      if !is_user_address(raw_value) {
        return Err(SyscallError::BadAddress);
      }
      return Ok(SyscallArg(
        kind: SyscallArgKind::Buffer,
        value: raw_value,
        size: 8,
        capability_slot: None,
        is_affine: false,
        requires_audit: true,
      ));
    },
    SyscallParamType::CapabilitySlot => {
      // Capability handles must be validated separately
      return Ok(SyscallArg(
        kind: SyscallArgKind::Handle,
        value: raw_value,
        size: 8,
        capability_slot: None,
        is_affine: false,
        requires_audit: true,
      ));
    },
    SyscallParamType::Flags => {
      let valid: bool = validate_flags(raw_value, param_type.valid_mask);
      if !valid {
        return Err(SyscallError::InvalidArgument);
      }
      return Ok(SyscallArg(
        kind: SyscallArgKind::Flags,
        value: raw_value,
        size: 8,
        capability_slot: None,
        is_affine: false,
        requires_audit: false,
      ));
    },
    SyscallParamType::AffineRef => {
      return Ok(SyscallArg(
        kind: SyscallArgKind::AffineId,
        value: raw_value,
        size: 8,
        capability_slot: None,
        is_affine: true,
        requires_audit: true,
      ));
    },
    SyscallParamType::ResidualHandle => {
      return Ok(SyscallArg(
        kind: SyscallArgKind::ResidualRef,
        value: raw_value,
        size: 8,
        capability_slot: None,
        is_affine: false,
        requires_audit: true,
      ));
    },
  }
}

/// Validate that the caller's capability permits invoking this syscall.
fn validate_syscall_capability[
  syscall_num: SyscallNumber,
  caller_cap: CapabilitySlot,
] -> Result[(), SyscallError] : (syscall, unsafe)
  loop: bounded(1)
{
  if !caller_cap.valid {
    return Err(SyscallError::InvalidCapability);
  }

  let required_rights: SyscallRights = get_syscall_required_rights(syscall_num);
  let caller_rights: SyscallRights = SyscallRights(caller_cap.rights);

  if (caller_rights & required_rights) != required_rights {
    return Err(SyscallError::InsufficientRights);
  }

  return Ok(());
}

//==============================================================================
// Return Value Encoding
//==============================================================================

/// Encoded syscall return value.
pub struct SyscallReturnValue(
  result: u64,
  result_cap: Option[CapabilitySlot],
  error: SyscallError,
  residual_handle: u64,
  has_more_data: bool,
  more_data_handle: u64,
  generation: u64,
  audit_token: u64,
) : effect:(alloc);

/// Encode the return value for a syscall.
pub fn encode_syscall_return[
  result: u64,
  error_code: SyscallError,
  cap_result: Option[CapabilitySlot],
  residual: Option[*Residual],
  syscall_gen: u64,
] -> SyscallReturnValue : (syscall, alloc, unsafe) {
  var ret: SyscallReturnValue = SyscallReturnValue(
    result: result,
    result_cap: cap_result,
    error: error_code,
    residual_handle: 0,
    has_more_data: false,
    more_data_handle: 0,
    generation: syscall_gen,
    audit_token: 0,
  );

  if let Some(r) = residual {
    ret.residual_handle = r.encode();
  }

  ret.audit_token = generate_audit_token();

  return ret;
}

/// Encode the return value for kernel exit (sets a0, a1, a2 in register file).
pub fn encode_return_for_user[
  ret: SyscallReturnValue,
  regs: *RegisterFile,
] : effect:(unsafe) {
  regs.gp_regs[0] = ret.result;  // a0 = result
  regs.gp_regs[1] = ret.error as u64;  // a1 = error code
  regs.gp_regs[2] = ret.residual_handle;  // a2 = residual handle
  regs.gp_regs[3] = ret.generation;  // a3 = generation

  if let Some(cap) = ret.result_cap {
    regs.cap_regs[0] = cap;
  }

  // Record the residual for the return
  record_syscall_residual(
    syscall_number: 0,  // will be set by caller
    result: ret,
  );
}

//==============================================================================
// Error Propagation
//==============================================================================

/// Error context for syscall error propagation.
pub struct SyscallErrorContext(
  original_error: SyscallError,
  propagated_from: u64,
  source_location: SourceLocation,
  call_chain: [u64; 64],
  call_depth: u32,
  residual_id: u64,
  capability_violation: Option[CapViolationInfo],
  timestamp: u64,
) : effect:(alloc);

/// Propagate an error with full context recording.
pub fn propagate_syscall_error[
  error: SyscallError,
  context: SyscallErrorContext,
] -> SyscallReturnValue : (syscall, alloc, unsafe) {
  // Record the error in the residual chain
  let residual: Residual = create_error_residual(
    error_code: error as u64,
    context: &context,
  );

  let ret: SyscallReturnValue = SyscallReturnValue(
    result: 0,
    result_cap: None,
    error: error,
    residual_handle: residual.encode(),
    has_more_data: false,
    more_data_handle: 0,
    generation: context.residual_id,
    audit_token: 0,
  );

  // Audit the error
  audit_syscall_error(error, &context);

  return ret;
}

/// Convert a kernel internal error to a user-visible syscall error.
pub fn internal_to_syscall_error[
  internal: InternalError,
] -> SyscallError : effect:(pure) {
  match internal {
    InternalError::OutOfMemory => SyscallError::ResourceExhausted,
    InternalError::InvalidHandle => SyscallError::InvalidArgument,
    InternalError::CapNotFound => SyscallError::InvalidCapability,
    InternalError::NotPermitted => SyscallError::PermissionDenied,
    InternalError::NotFound => SyscallError::NotFound,
    InternalError::AlreadyExists => SyscallError::AlreadyExists,
    InternalError::Busy => SyscallError::WouldBlock,
    InternalError::Interrupted => SyscallError::Interrupted,
    InternalError::NotImplemented => SyscallError::NotSupported,
    InternalError::CapViolation => SyscallError::CapabilityViolation,
    InternalError::AffineViolation => SyscallError::AffineViolation,
    InternalError::AuditFailure => SyscallError::AuditFailure,
    InternalError::ResidualOverflow => SyscallError::ResidualOverflow,
    _ => SyscallError::InvalidArgument,
  }
}

//==============================================================================
// Syscall Tracing
//==============================================================================

/// Tracing configuration for syscalls.
pub struct TraceConfig(
  enabled: bool,
  filter_mask: u64,
  max_events: u32,
  output_buffer: u64,
  output_buffer_size: u32,
  trace_capability: Option[CapabilitySlot],
  include_args: bool,
  include_results: bool,
  include_timestamps: bool,
) : effect:(alloc, unsafe);

/// A single trace event entry.
pub struct TraceEvent(
  syscall_number: SyscallNumber,
  timestamp: u64,
  thread_id: u64,
  process_id: u64,
  args_hash: u64,
  result_code: SyscallError,
  duration_ns: u64,
  residual_id: u64,
  caller_pc: u64,
  capability_used: Option[CapabilitySlot],
) : effect:(pure);

/// Trace buffer for storing syscall trace events.
pub struct TraceBuffer(
  events: [TraceEvent; 4096],
  write_pos: u32,
  read_pos: u32,
  count: u32,
  config: TraceConfig,
  overflow_count: u32,
) : effect:(alloc, unsafe);

/// Record a trace event for a syscall.
pub fn record_trace_event[
  buffer: *TraceBuffer,
  syscall_num: SyscallNumber,
  args: *MarshaledSyscall,
  result: SyscallError,
  duration_ns: u64,
] : effect:(syscall, unsafe)
  loop: bounded(1)
{
  if !buffer.config.enabled {
    return;
  }

  // Check filter mask
  let num_val: u64 = syscall_num as u64;
  if (buffer.config.filter_mask & (1 << (num_val & 63))) == 0 {
    return;
  }

  let pos: u32 = buffer.write_pos;
  buffer.events[pos] = TraceEvent(
    syscall_number: syscall_num,
    timestamp: read_timestamp(),
    thread_id: args.caller_thread_id,
    process_id: args.caller_process_id,
    args_hash: hash_args(args),
    result_code: result,
    duration_ns: duration_ns,
    residual_id: args.generation,
    caller_pc: read_caller_pc(),
    capability_used: args.args[0].capability_slot,
  );

  buffer.write_pos = (pos + 1) % 4096;
  if buffer.count < 4096 {
    buffer.count += 1;
  } else {
    buffer.read_pos = (buffer.read_pos + 1) % 4096;
    buffer.overflow_count += 1;
  }
}

/// Retrieve trace events from the buffer (consuming).
pub fn read_trace_events[
  buffer: *TraceBuffer,
  max_events: u32,
  dest: *[TraceEvent; 64],
] -> u32 : effect:(syscall, unsafe)
  loop: bounded(64)
{
  var read_count: u32 = 0;
  for var i: u32 = 0; i < max_events; i += 1 {
    if read_count >= buffer.count {
      break;
    }
    if read_count >= 64 {
      break;
    }
    dest[read_count] = buffer.events[buffer.read_pos];
    buffer.read_pos = (buffer.read_pos + 1) % 4096;
    buffer.count -= 1;
    read_count += 1;
  }
  return read_count;
}

//==============================================================================
// Audit Hooks
//==============================================================================

/// Severity levels for audit events.
pub enum AuditSeverity : u8 {
  Debug     = 0,
  Info      = 1,
  Notice    = 2,
  Warning   = 3,
  Error     = 4,
  Critical  = 5,
  Alert     = 6,
  Emergency = 7,
}

/// An audit event recorded during syscall processing.
pub struct AuditEvent(
  event_type: AuditEventType,
  syscall_number: SyscallNumber,
  timestamp: u64,
  thread_id: u64,
  process_id: u64,
  severity: AuditSeverity,
  details_hash: u64,
  residual_id: u64,
  capability_snapshot: CapabilitySnapshot,
  caller_identity: u64,
) : effect:(alloc);

pub enum AuditEventType : u8 {
  SyscallEnter     = 0,
  SyscallExit      = 1,
  SyscallError     = 2,
  CapabilityUse    = 3,
  CapabilityViolation = 4,
  MemoryMap        = 5,
  MemoryUnmap      = 6,
  ProcessCreate    = 7,
  ProcessDestroy   = 8,
  ThreadCreate     = 9,
  ThreadDestroy    = 10,
  IPC              = 11,
  AuditConfigChange = 12,
  SecurityViolation = 13,
  HypervisorOp     = 14,
  ModuleLoad       = 15,
  ModuleUnload     = 16,
  ResidualEvent    = 17,
  TracingEnabled   = 18,
  TracingDisabled  = 19,
}

/// Audit hook invoked on syscall entry.
pub fn audit_syscall_entry[
  syscall_num: SyscallNumber,
  args: *MarshaledSyscall,
] : effect:(audit, syscall, alloc)
  loop: bounded(1)
{
  let event: AuditEvent = AuditEvent(
    event_type: AuditEventType::SyscallEnter,
    syscall_number: syscall_num,
    timestamp: args.timestamp,
    thread_id: args.caller_thread_id,
    process_id: args.caller_process_id,
    severity: AuditSeverity::Info,
    details_hash: hash_args(args),
    residual_id: args.generation,
    capability_snapshot: capture_capability_snapshot(),
    caller_identity: read_caller_identity(),
  );

  submit_audit_event(&event);
}

/// Audit hook invoked on syscall error.
pub fn audit_syscall_error[
  error: SyscallError,
  context: *SyscallErrorContext,
] : effect:(audit, alloc)
  loop: bounded(1)
{
  let severity: AuditSeverity = match error {
    SyscallError::CapabilityViolation => AuditSeverity::Alert,
    SyscallError::PermissionDenied => AuditSeverity::Warning,
    SyscallError::AuditFailure => AuditSeverity::Critical,
    SyscallError::AffineViolation => AuditSeverity::Warning,
    _ => AuditSeverity::Notice,
  };

  let event: AuditEvent = AuditEvent(
    event_type: AuditEventType::SyscallError,
    syscall_number: SyscallNumber::Exit,  // filled by caller
    timestamp: context.timestamp,
    thread_id: 0,
    process_id: 0,
    severity: severity,
    details_hash: error as u64,
    residual_id: context.residual_id,
    capability_snapshot: capture_capability_snapshot(),
    caller_identity: 0,
  );

  submit_audit_event(&event);
}

/// Submit an audit event to the audit subsystem.
fn submit_audit_event[
  event: *AuditEvent,
] : effect:(audit) {
  // In production, writes to the audit log ring buffer.
  // Triggers any registered audit callbacks.
  __audit_write(event);
}

//==============================================================================
// Residual Generation
//==============================================================================

/// Residual record generated for each syscall.
pub struct SyscallResidual(
  syscall_number: SyscallNumber,
  args_hash: u64,
  result_code: u64,
  result_value: u64,
  timestamp: u64,
  thread_id: u64,
  process_id: u64,
  generation: u64,
  caller_cap_token: u64,
  duration_ns: u64,
  error_details: Option[ErrorDetail],
  capability_effects: [CapEffect; 8],
  num_cap_effects: u32,
  previous_residual: u64,
) : effect:(alloc);

/// Record a residual for a completed syscall.
pub fn record_syscall_residual[
  syscall_number: SyscallNumber,
  result: SyscallReturnValue,
  args: *MarshaledSyscall,
  duration_ns: u64,
  residual_chain: *ResidualChain,
] : effect:(syscall, alloc, unsafe)
  loop: bounded(1)
{
  let residual: SyscallResidual = SyscallResidual(
    syscall_number: syscall_number,
    args_hash: hash_marshaled_args(args),
    result_code: result.error as u64,
    result_value: result.result,
    timestamp: read_timestamp(),
    thread_id: args.caller_thread_id,
    process_id: args.caller_process_id,
    generation: result.generation,
    caller_cap_token: args.caller_cap_token,
    duration_ns: duration_ns,
    error_details: if result.error != SyscallError::Success {
      Some(ErrorDetail(result.error as u64, result.residual_handle))
    } else {
      None
    },
    capability_effects: Default,
    num_cap_effects: 0,
    previous_residual: residual_chain.last_id,
  );

  // Append to the thread's residual chain
  append_to_residual_chain(residual_chain, &residual);
}

/// Residual record for capability operations within a syscall.
pub struct CapEffect(
  cap_type: CapabilityType,
  operation: CapOperation,
  success: bool,
  generation_before: u64,
  generation_after: u64,
) : effect:(pure);

pub enum CapOperation : u8 {
  Inspect  = 0,
  Reduce   = 1,
  Copy     = 2,
  Move     = 3,
  Delete   = 4,
  Derive   = 5,
  Transfer = 6,
  Seal     = 7,
  Unseal   = 8,
  Mint     = 9,
  Burn     = 10,
}

//==============================================================================
// Per-Syscall Dispatch and Validation
//==============================================================================

/// Signature descriptor for a syscall's parameters.
pub struct SyscallSignature(
  syscall_number: SyscallNumber,
  num_params: u32,
  params: [SyscallParamType; 8],
  required_rights: SyscallRights,
  is_restricted: bool,
  requires_capability: bool,
  has_affine_params: bool,
  generates_residual: bool,
  audit_level: AuditSeverity,
) : effect:(pure);

/// Parameter type for a syscall signature.
pub struct SyscallParamType(
  kind: SyscallParamKind,
  valid_mask: u64,
  min_value: u64,
  max_value: u64,
  is_output: bool,
  requires_cap: bool,
) : effect:(pure);

pub enum SyscallParamKind : u8 {
  Integer        = 0,
  Pointer        = 1,
  Buffer         = 2,
  Flags          = 3,
  Handle         = 4,
  CapabilitySlot = 5,
  AffineRef      = 6,
  ResidualHandle = 7,
  Enumeration    = 8,
}

/// Rights type for syscall capability gating.
pub struct SyscallRights(:u64);

const SYSCALL_RIGHT_BASIC: SyscallRights    = SyscallRights(1 << 0);
const SYSCALL_RIGHT_MEMORY: SyscallRights   = SyscallRights(1 << 1);
const SYSCALL_RIGHT_IPC: SyscallRights      = SyscallRights(1 << 2);
const SYSCALL_RIGHT_IO: SyscallRights       = SyscallRights(1 << 3);
const SYSCALL_RIGHT_PROCESS: SyscallRights  = SyscallRights(1 << 4);
const SYSCALL_RIGHT_CAP: SyscallRights      = SyscallRights(1 << 5);
const SYSCALL_RIGHT_AUDIT: SyscallRights    = SyscallRights(1 << 6);
const SYSCALL_RIGHT_HYPERVISOR: SyscallRights = SyscallRights(1 << 7);
const SYSCALL_RIGHT_DEBUG: SyscallRights    = SyscallRights(1 << 8);
const SYSCALL_RIGHT_COMPAT: SyscallRights   = SyscallRights(1 << 9);
const SYSCALL_RIGHT_ALL: SyscallRights      = SyscallRights(0xFFFF);

/// Lookup the signature for a syscall number.
pub fn lookup_syscall_signature[
  num: SyscallNumber,
] -> SyscallSignature : (syscall, pure)
  loop: bounded(1)
{
  match num {
    SyscallNumber::Exit => SyscallSignature(
      syscall_number: num,
      num_params: 1,
      params: [SyscallParamType(Integer, 0, 0, 0xFFFFFFFF, false, false), Default],
      required_rights: SYSCALL_RIGHT_BASIC,
      is_restricted: false,
      requires_capability: true,
      has_affine_params: false,
      generates_residual: true,
      audit_level: AuditSeverity::Notice,
    ),
    SyscallNumber::MapMemory => SyscallSignature(
      syscall_number: num,
      num_params: 4,
      params: [
        SyscallParamType(Pointer, 0, 0, 0, false, true),
        SyscallParamType(Integer, 0, 0, 0xFFFFFFFF_FFFF, false, false),
        SyscallParamType(Integer, 0, 0, 0xFFFF, false, false),
        SyscallParamType(Integer, 0, 0, 0xFFFF, false, false),
      ],
      required_rights: SYSCALL_RIGHT_MEMORY,
      is_restricted: false,
      requires_capability: true,
      has_affine_params: false,
      generates_residual: true,
      audit_level: AuditSeverity::Info,
    ),
    SyscallNumber::SendMessage => SyscallSignature(
      syscall_number: num,
      num_params: 4,
      params: [
        SyscallParamType(Integer, 0, 0, 0, false, false),
        SyscallParamType(Pointer, 0, 0, 0, false, false),
        SyscallParamType(Integer, 0, 0, 0xFFFF, false, false),
        SyscallParamType(Integer, 0, 0, 0xFF, false, false),
      ],
      required_rights: SYSCALL_RIGHT_IPC,
      is_restricted: false,
      requires_capability: true,
      has_affine_params: false,
      generates_residual: true,
      audit_level: AuditSeverity::Info,
    ),
    SyscallNumber::VMCreate => SyscallSignature(
      syscall_number: num,
      num_params: 2,
      params: [
        SyscallParamType(Integer, 0, 0, 0, false, true),
        SyscallParamType(Pointer, 0, 0, 0, true, false),
      ],
      required_rights: SYSCALL_RIGHT_HYPERVISOR,
      is_restricted: true,
      requires_capability: true,
      has_affine_params: false,
      generates_residual: true,
      audit_level: AuditSeverity::Alert,
    ),
    SyscallNumber::CapInspect => SyscallSignature(
      syscall_number: num,
      num_params: 2,
      params: [
        SyscallParamType(CapabilitySlot, 0, 0, 0, false, false),
        SyscallParamType(Pointer, 0, 0, 0, true, false),
      ],
      required_rights: SYSCALL_RIGHT_CAP,
      is_restricted: false,
      requires_capability: true,
      has_affine_params: false,
      generates_residual: true,
      audit_level: AuditSeverity::Info,
    ),
    SyscallNumber::LinuxSyscall => SyscallSignature(
      syscall_number: num,
      num_params: 4,
      params: [
        SyscallParamType(Integer, 0, 0, 0xFFFF, false, false),
        SyscallParamType(Integer, 0, 0, 0, false, false),
        SyscallParamType(Integer, 0, 0, 0, false, false),
        SyscallParamType(Integer, 0, 0, 0, false, false),
      ],
      required_rights: SYSCALL_RIGHT_COMPAT,
      is_restricted: false,
      requires_capability: true,
      has_affine_params: false,
      generates_residual: true,
      audit_level: AuditSeverity::Info,
    ),
    _ => SyscallSignature(
      syscall_number: num,
      num_params: 0,
      params: Default,
      required_rights: SYSCALL_RIGHT_BASIC,
      is_restricted: false,
      requires_capability: true,
      has_affine_params: false,
      generates_residual: true,
      audit_level: AuditSeverity::Info,
    ),
  }
}

/// Get the required rights for a syscall.
pub fn get_syscall_required_rights[
  num: SyscallNumber,
] -> SyscallRights : (pure)
  loop: bounded(1)
{
  return lookup_syscall_signature(num).required_rights;
}

//==============================================================================
// Syscall Dispatcher
//==============================================================================

/// Main syscall dispatcher — called from the kernel's syscall handler.
pub fn dispatch_syscall[
  raw_args: SyscallArgs,
  call_site: u64,
  caller_cap: CapabilitySlot,
  trace_buffer: *TraceBuffer,
  residual_chain: *ResidualChain,
] -> SyscallReturnValue : (syscall, audit, alloc, unsafe)
  loop: bounded(SYSCALL_DISPATCH_MAX_ITERATIONS)
{
  let start_time: u64 = read_timestamp();

  // Marshal and validate arguments
  let marshaled: MarshaledSyscall = marshal_syscall_args(raw_args, call_site, caller_cap)?;

  // Dispatch based on syscall category
  let result: SyscallReturnValue = match marshaled.number {
    // Process Management
    SyscallNumber::Exit => handle_exit(&marshaled),
    SyscallNumber::Fork => handle_fork(&marshaled),
    SyscallNumber::Exec => handle_exec(&marshaled),
    SyscallNumber::Wait => handle_wait(&marshaled),
    SyscallNumber::GetPid => handle_get_pid(&marshaled),
    SyscallNumber::GetTid => handle_get_tid(&marshaled),
    SyscallNumber::Kill => handle_kill(&marshaled),
    SyscallNumber::Sleep => handle_sleep(&marshaled),
    SyscallNumber::Yield => handle_yield(&marshaled),
    SyscallNumber::CreateThread => handle_create_thread(&marshaled),
    SyscallNumber::ExitThread => handle_exit_thread(&marshaled),
    SyscallNumber::JoinThread => handle_join_thread(&marshaled),

    // Memory Management
    SyscallNumber::MapMemory => handle_map_memory(&marshaled),
    SyscallNumber::UnmapMemory => handle_unmap_memory(&marshaled),
    SyscallNumber::ProtectMemory => handle_protect_memory(&marshaled),
    SyscallNumber::MemShare => handle_mem_share(&marshaled),

    // Capability Operations
    SyscallNumber::CapInspect => handle_cap_inspect(&marshaled),
    SyscallNumber::CapReduce => handle_cap_reduce(&marshaled),
    SyscallNumber::CapCopy => handle_cap_copy(&marshaled),
    SyscallNumber::CapMove => handle_cap_move(&marshaled),
    SyscallNumber::CapDelete => handle_cap_delete(&marshaled),
    SyscallNumber::CapDerive => handle_cap_derive(&marshaled),
    SyscallNumber::CapValidate => handle_cap_validate(&marshaled),
    SyscallNumber::CapTransfer => handle_cap_transfer(&marshaled),

    // IPC
    SyscallNumber::SendMessage => handle_send_message(&marshaled),
    SyscallNumber::ReceiveMessage => handle_receive_message(&marshaled),
    SyscallNumber::CreateChannel => handle_create_channel(&marshaled),
    SyscallNumber::CloseChannel => handle_close_channel(&marshaled),

    // I/O
    SyscallNumber::Open => handle_open(&marshaled),
    SyscallNumber::Close => handle_close(&marshaled),
    SyscallNumber::Read => handle_read(&marshaled),
    SyscallNumber::Write => handle_write(&marshaled),
    SyscallNumber::Seek => handle_seek(&marshaled),
    SyscallNumber::IOControl => handle_ioctl(&marshaled),

    // Audit and Residual
    SyscallNumber::AuditEvent => handle_audit_event(&marshaled),
    SyscallNumber::ReadResidual => handle_read_residual(&marshaled),
    SyscallNumber::ClearResidual => handle_clear_residual(&marshaled),
    SyscallNumber::QueryResidualStats => handle_query_residual_stats(&marshaled),

    // Timer
    SyscallNumber::ClockGetTime => handle_clock_get_time(&marshaled),
    SyscallNumber::Nanosleep => handle_nanosleep(&marshaled),

    // Hypervisor
    SyscallNumber::VMCreate => handle_vm_create(&marshaled),
    SyscallNumber::VMRun => handle_vm_run(&marshaled),
    SyscallNumber::VMDestroy => handle_vm_destroy(&marshaled),
    SyscallNumber::VMPause => handle_vm_pause(&marshaled),
    SyscallNumber::VMInjectIRQ => handle_vm_inject_irq(&marshaled),
    SyscallNumber::VMMapMemory => handle_vm_map_memory(&marshaled),
    SyscallNumber::VMQueryState => handle_vm_query_state(&marshaled),
    SyscallNumber::VMSnapshot => handle_vm_snapshot(&marshaled),
    SyscallNumber::VMRestore => handle_vm_restore(&marshaled),

    // Debug
    SyscallNumber::DebugBreak => handle_debug_break(&marshaled),
    SyscallNumber::SetWatchpoint => handle_set_watchpoint(&marshaled),

    // Compatibility
    SyscallNumber::LinuxSyscall => handle_linux_syscall(&marshaled),
    SyscallNumber::Win32Syscall => handle_win32_syscall(&marshaled),
    SyscallNumber::TranslateError => handle_translate_error(&marshaled),

    // Module Loading
    SyscallNumber::LoadModule => handle_load_module(&marshaled),
    SyscallNumber::GetSymbol => handle_get_symbol(&marshaled),

    _ => encode_syscall_return(0, SyscallError::NotSupported, None, None, raw_args.generation),
  };

  // Record timing
  let end_time: u64 = read_timestamp();
  let duration: u64 = end_time - start_time;

  // Trace the syscall
  record_trace_event(trace_buffer, marshaled.number, &marshaled, result.error, duration);

  // Record residual
  record_syscall_residual(marshaled.number, result, &marshaled, duration, residual_chain);

  return result;
}

const SYSCALL_DISPATCH_MAX_ITERATIONS: u32 = 200;

//==============================================================================
// Syscall Handler Stubs (each would be implemented in its respective subsystem)
//==============================================================================

fn handle_exit[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, unsafe) { abort(); }
fn handle_fork[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, alloc, unsafe) { default_return() }
