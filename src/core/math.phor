pub fn u32_to_u64(v: u32) -> u64
    effects: [deterministic]
{ v as u64 }

// Checked u64 to usize conversion for indexing.
pub fn u64_to_usize(v: u64) -> Result[usize, OverflowError>
    effects: [deterministic]
{
    if v > 0xFFFF_FFFF as u64 {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x800),
            FixedString[128]::from_slice("u64 to usize overflow")))
    }
    Result::Ok(v as usize)
}

// Checked u32 to usize conversion.
pub fn u32_to_usize(v: u32) -> usize
    effects: [deterministic]
{
    v as usize
}

// ──────────────────────────────────────────────
// Comparison Predicates for Sorting
// ──────────────────────────────────────────────
// Evidence path: MATH-CMP2-001 through MATH-CMP2-020

pub fn is_sorted_ascending(values: Word64[], count: u32) -> bool
    effects: [deterministic]
{
    if count <= 1 { return true }
    let mut i: u32 = 1
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] while i < count {
        if values[i as usize].lt(values[(i - 1) as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

pub fn is_sorted_descending(values: Word64[], count: u32) -> bool
    effects: [deterministic]
{
    if count <= 1 { return true }
    let mut i: u32 = 1
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] while i < count {
        if values[i as usize].gt(values[(i - 1) as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

// Find min and max in a single pass.
// loop: bounds[BOUND_MEDIUM] — bounded by count.
pub fn min_max(values: Word64[], count: u32) -> Result[(Word64, Word64), ArithmeticError>
    effects: [deterministic]
{
    if count == 0 {
        return Result::Err(ArithmeticError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x900),
            FixedString[128]::from_slice("min_max on empty array")))
    }
    let mut min_val: Word64 = values[0]
    let mut max_val: Word64 = values[0]
    let mut i: u32 = 1
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] while i < count {
        if values[i as usize].lt(min_val) { min_val = values[i as usize] }
        if values[i as usize].gt(max_val) { max_val = values[i as usize] }
        i = i + 1
    }
    Result::Ok((min_val, max_val))
}

// ──────────────────────────────────────────────
// Integer Overflow Detection Algorithms
// ──────────────────────────────────────────────
// Evidence path: MATH-OVDET2-001 through MATH-OVDET2-020

// Detect overflow in addition by checking sign (for i64).
pub fn would_overflow_add_i64(a: i64, b: i64) -> bool
    effects: [deterministic]
{
    // Overflow occurs if a and b have the same sign, and result has different sign.
    if a > 0 && b > 0 {
        return a > (i64::MAX - b)
    }
    if a < 0 && b < 0 {
        return a < (i64::MIN - b)
    }
    false
}

// Detect overflow in absolute value.
pub fn would_overflow_abs_i64(a: i64) -> bool
    effects: [deterministic]
{
    a == i64::MIN
}

// Detect overflow in negation.
pub fn would_overflow_neg_i64(a: i64) -> bool
    effects: [deterministic]
{
    a == i64::MIN
}

// ──────────────────────────────────────────────
// Euclidean Division
// ──────────────────────────────────────────────
// Evidence path: MATH-EUCLID-001 through MATH-EUCLID-015

// Euclidean modulo (always non-negative result).
pub fn euclidean_mod(a: i64, b: i64) -> Result<i64, DivisionByZeroError>
    effects: [deterministic]
{
    if b == 0 {
        return Result::Err(DivisionByZeroError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0xA00),
            FixedString[128]::from_slice("Euclidean mod by zero")))
    }
    let r: i64 = a % b
    if r < 0 {
        Result::Ok(r + b.abs())
    } else {
        Result::Ok(r)
    }
}

// Euclidean division (rounds toward negative infinity).
pub fn euclidean_div(a: i64, b: i64) -> Result<i64, DivisionByZeroError>
    effects: [deterministic]
{
    if b == 0 {
        return Result::Err(DivisionByZeroError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0xA01),
            FixedString[128]::from_slice("Euclidean div by zero")))
    }
    let q: i64 = a / b
    let r: i64 = a % b
    if r < 0 {
        if b > 0 {
            Result::Ok(q - 1)
        } else {
            Result::Ok(q + 1)
        }
    } else {
        Result::Ok(q)
    }
}

// ──────────────────────────────────────────────
// Statistical Helpers
// ──────────────────────────────────────────────
// Evidence path: MATH-STAT-001 through MATH-STAT-020

// Compute the arithmetic mean of an array.
// loop: bounds[BOUND_MEDIUM] — bounded by count.
pub fn mean(values: Word64[], count: u32) -> Result[Word64, ArithmeticError>
    effects: [deterministic]
{
    if count == 0 {
        return Result::Err(ArithmeticError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0xB00),
            FixedString[128]::from_slice("mean of empty array")))
    }
    let sum: Word64 = checked_sum(values, count)?
    sum.checked_div(Word64::from_u64(count as u64))
}

// Compute the median (requires sorted array).
pub fn median(sorted_values: Word64[], count: u32) -> Result[Word64, ArithmeticError>
    effects: [deterministic]
{
    if count == 0 {
        return Result::Err(ArithmeticError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0xB01),
            FixedString[128]::from_slice("median of empty array")))
    }
    if count % 2 == 1 {
        let mid: u32 = count / 2
        Result::Ok(sorted_values[mid as usize])
    } else {
        let mid: u32 = count / 2
        let a: Word64 = sorted_values[(mid - 1) as usize]
        let b: Word64 = sorted_values[mid as usize]
        // Average without overflow.
        let sum: Word64 = a.checked_add(b).unwrap_or(Word64::max())
        sum.checked_div(Word64::from_u64(2))
    }
}

// ──────────────────────────────────────────────
// Base-N Conversion
// ──────────────────────────────────────────────
// Evidence path: MATH-BASE-001 through MATH-BASE-020

// Convert a u64 to its hexadecimal string representation.
pub fn to_hex_string(value: Word64) -> FixedString[16]
    effects: [deterministic]
{
    let hex_chars: [u8; 16] = [
        b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7',
        b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
    ]
    let mut buf: FixedString[16] = FixedString::new()
    let mut v: u64 = value.to_u64()
    // loop: bounds[BOUND_TINY] — exactly 16 iterations (max hex digits for u64)
    loop: bounds[BOUND_TINY] for _ in 0..16 {
        let nibble: u8 = (v >> 60) as u8
        let _: Result<(), BoundsError> = buf.push_byte(Byte::from_u8(hex_chars[nibble as usize]))
        v = v << 4
    }
    buf
}

// Convert a u64 to its decimal string representation.
pub fn to_decimal_string(value: Word64) -> FixedString[20]
    effects: [deterministic]
{
    let mut buf: FixedString[20] = FixedString::new()
    if value.is_zero() {
        let _: Result<(), BoundsError> = buf.push_byte(Byte::from_u8(b'0'))
        return buf
    }
    // Convert digits in reverse.
    let mut digits: [u8; 20] = [0; 20]
    let mut digit_count: u32 = 0
    let mut v: u64 = value.to_u64()
    // loop: bounds[BOUND_TINY] — at most 20 digits for u64
    loop: bounds[BOUND_TINY] while v > 0 {
        digits[digit_count as usize] = (v % 10) as u8 + b'0'
        v = v / 10
        digit_count = digit_count + 1
    }
    // Output in correct order.
    let mut i: u32 = digit_count
    // loop: bounds[BOUND_TINY] — bounded by digit count
    loop: bounds[BOUND_TINY] while i > 0 {
        i = i - 1
        let _: Result<(), BoundsError> = buf.push_byte(Byte::from_u8(digits[i as usize]))
    }
    buf
}

// ──────────────────────────────────────────────
// Integer Width Detection
// ──────────────────────────────────────────────
// Evidence path: MATH-WIDTH-001 through MATH-WIDTH-015

// Detect the minimum number of bits needed to represent a value.
pub fn bit_width(value: Word64) -> u32
    effects: [deterministic]
{
    if value.is_zero() { return 0 }
    64 - value.leading_zeros()
}

// Detect the minimum number of bytes needed to represent a value.
pub fn byte_width(value: Word64) -> u32
    effects: [deterministic]
{
    let bits: u32 = bit_width(value)
    if bits == 0 { return 0 }
    (bits + 7) / 8
}

// Detect the minimum number of hex digits needed.
pub fn hex_digit_width(value: Word64) -> u32
    effects: [deterministic]
{
    let bits: u32 = bit_width(value)
    if bits == 0 { return 1 }  // At least "0"
    (bits + 3) / 4
}

// Detect the minimum number of decimal digits needed.
pub fn decimal_digit_width(value: Word64) -> u32
    effects: [deterministic]
{
    if value.is_zero() { return 1 }
    floor_log10(value).unwrap_or(0) + 1
}

// ──────────────────────────────────────────────
// Rounding Operations
// ──────────────────────────────────────────────
// Evidence path: MATH-ROUND-001 through MATH-ROUND-015

// Round to nearest with ties rounding up.
pub fn round_half_up(value: Word64, precision: Word64) -> Result[Word64, DivisionByZeroError>
    effects: [deterministic]
{
    if precision.is_zero() {
        return Result::Err(DivisionByZeroError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0xC00),
            FixedString[128]::from_slice("round_half_up by zero precision")))
    }
    let half: Word64 = precision.checked_div(Word64::from_u64(2))?
    let remainder: Word64 = value.checked_rem(precision)?
    if remainder.gte(half) {
        let adjustment: Word64 = precision.checked_sub(remainder)?
        value.checked_add(adjustment)
    } else {
        value.checked_sub(remainder)
    }
}

// Round to nearest with ties rounding down.
pub fn round_half_down(value: Word64, precision: Word64) -> Result[Word64, DivisionByZeroError>
    effects: [deterministic]
{
    if precision.is_zero() {
        return Result::Err(DivisionByZeroError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0xC01),
            FixedString[128]::from_slice("round_half_down by zero precision")))
    }
    let half: Word64 = precision.checked_div(Word64::from_u64(2))?
    let remainder: Word64 = value.checked_rem(precision)?
    if remainder.gt(half) {
        let adjustment: Word64 = precision.checked_sub(remainder)?
        value.checked_add(adjustment)
    } else {
        value.checked_sub(remainder)
    }
}

// Truncate toward zero.
pub fn truncate(value: Word64, precision: Word64) -> Result[Word64, DivisionByZeroError>
    effects: [deterministic]
{
    if precision.is_zero() {
        return Result::Err(DivisionByZeroError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0xC02),
            FixedString[128]::from_slice("truncate by zero precision")))
    }
    let remainder: Word64 = value.checked_rem(precision)?
    value.checked_sub(remainder)
}
