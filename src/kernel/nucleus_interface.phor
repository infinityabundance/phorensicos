    can_register: bool,
}

struct NucleusCallCapability {
    object_id: Identity,
    generation: u64,
    allowed_operations: Bitmap(u32),
    max_calls_per_second: u64,
    can_enter_nucleus: bool,
    can_exit_nucleus: bool,
    can_query_state: bool,
    can_request_self_test: bool,
}

struct CapabilityToken {
