//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_error_translation[] : effect:(pure) {
  let win_err: Win32Error = syscall_to_win32_error(SyscallError::NotFound);
  assert(win_err == Win32Error::FileNotFound);

  let sys_err: SyscallError = win32_error_to_syscall(Win32Error::AccessDenied);
  assert(sys_err == SyscallError::PermissionDenied);
}

@Test
pub fn test_registry_init[] : effect:(pure) {
  let reg: Win32Registry = win32_init_registry();
  assert(reg.count == 5);
  assert(reg.keys[2].num_subkeys == 1);
}

@Test
pub fn test_pe_header_validation[] : effect:(unsafe) {
  var dos: [u8; 64] = Default;
  dos[0] = 0x4D;  // 'M'
  dos[1] = 0x5A;  // 'Z'
  // In real test, would validate PE loading
}

@Test
pub fn test_message_translation[] : effect:(pure) {
  let msg: Win32Msg = translate_to_win32_message(0, 5);  // WM_CLOSE
  assert(msg.message == 0x0010);
}
