// file: store_database.phor
// purpose: Deterministic key-value store with fixed-capacity B-tree,
//          page management, atomic transactions, crash recovery,
//          range queries, and forensic store integration.
// evidence: STORE-DB-ARCH-001 through STORE-DB-ARCH-250
// residual: All store operations, transactions, and recovery
//           events are recorded for court-verifiable audit trails.

use core::constants::*
use core::types::*
use core::errors::*
use core::effects::*
use core::collections::*
use core::math::*
use core::traits::*
use core::serialization::*

// ──────────────────────────────────────────────
// Store Database Diagnostic Ranges
// ──────────────────────────────────────────────
const DIAG_STORE_DB_BASE : Word64 = DIAG_STORE_BASE

const DB_MAX_PAGES           : u32 = 256
const DB_PAGE_SIZE           : u32 = 512
const DB_MAX_KEYS_PER_PAGE   : u32 = 32
const DB_MAX_DEPTH           : u32 = 6
const DB_TXN_LOG_CAP         : u32 = 1024
const DB_MAX_TXN_BATCH       : u32 = 64
const DB_CACHE_LINE_CAP      : u32 = 32
const DB_RANGE_RESULT_CAP    : u32 = 256
const DB_RESIDUAL_LOG        : u32 = 64
const DB_KEY_SIZE            : u32 = 64
const DB_VALUE_SIZE          : u32 = 256

// ──────────────────────────────────────────────
// Page ID Type
// ──────────────────────────────────────────────
pub type PageId : u32 = struct {
    value: Word32,
}

impl PageId {
    pub fn new(val: Word32) -> PageId
        effects: [deterministic]
    {
        PageId { value: val }
    }

    pub fn from_u32(val: u32) -> PageId
        effects: [deterministic]
    {
        PageId { value: Word32::from_u32(val) }
    }

    pub fn value(self) -> u32
        effects: [deterministic]
    {
        self.value.to_u32()
    }

    pub fn eq(self, other: PageId) -> bool
        effects: [deterministic]
    {
        self.value.eq(other.value)
    }
}

// ──────────────────────────────────────────────
// Key and Value Types
// ──────────────────────────────────────────────
pub type DbKey : FixedString[DB_KEY_SIZE] = struct {
    bytes: FixedArray[Byte, DB_KEY_SIZE],
    length: u32,
}

impl DbKey {
    pub fn new() -> DbKey
        effects: [deterministic]
    {
        DbKey {
            bytes: FixedArray::new(),
            length: 0,
        }
    }

    pub fn from_str(s: FixedString[DB_KEY_SIZE]) -> DbKey
        effects: [deterministic]
    {
        let mut key: DbKey = DbKey::new()
        for i in 0..s.len() {
            let b: Byte = Byte::from_u8(s.byte_at(i))
            let _ = key.bytes.set(i, b)
        }
        key.length = s.len()
        key
    }

    pub fn from_bytes(data: FixedArray[Byte, DB_KEY_SIZE], len: u32) -> Result[DbKey, BoundsError>
        effects: [deterministic]
    {
        if len > DB_KEY_SIZE {
            return Result::Err(bounds_capacity_exceeded(DB_KEY_SIZE))
        }
        let mut key: DbKey = DbKey::new()
        for i in 0..len {
            let b: Byte = match data.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            let _ = key.bytes.set(i, b)
        }
        key.length = len
        Result::Ok(key)
    }

    pub fn cmp(self, other: DbKey) -> Ordering
        effects: [deterministic]
    {
        let min_len: u32 = if self.length < other.length { self.length } else { other.length }
        for i in 0..min_len {
            let a: Byte = match self.bytes.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => Byte::from_u8(0),
            }
            let b: Byte = match other.bytes.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => Byte::from_u8(0),
            }
            let cmp: Ordering = a.cmp(b)
            if cmp != Ordering::Equal {
                return cmp
            }
        }
        if self.length < other.length {
            Ordering::Less
        } else if self.length > other.length {
            Ordering::Greater
        } else {
            Ordering::Equal
        }
    }

    pub fn lt(self, other: DbKey) -> bool
        effects: [deterministic]
    {
        self.cmp(other) == Ordering::Less
    }

    pub fn eq(self, other: DbKey) -> bool
        effects: [deterministic]
    {
        self.cmp(other) == Ordering::Equal
    }

    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }

    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }
}

pub type DbValue : FixedString[DB_VALUE_SIZE] = struct {
    bytes: FixedArray[Byte, DB_VALUE_SIZE],
    length: u32,
}

impl DbValue {
    pub fn new() -> DbValue
        effects: [deterministic]
    {
        DbValue {
            bytes: FixedArray::new(),
            length: 0,
        }
    }

    pub fn from_str(s: FixedString[DB_VALUE_SIZE]) -> DbValue
        effects: [deterministic]
    {
        let mut val: DbValue = DbValue::new()
        for i in 0..s.len() {
            let b: Byte = Byte::from_u8(s.byte_at(i))
            let _ = val.bytes.set(i, b)
        }
        val.length = s.len()
        val
    }

    pub fn from_bytes(data: FixedArray[Byte, DB_VALUE_SIZE], len: u32) -> Result[DbValue, BoundsError>
        effects: [deterministic]
    {
        if len > DB_VALUE_SIZE {
            return Result::Err(bounds_capacity_exceeded(DB_VALUE_SIZE))
        }
        let mut val: DbValue = DbValue::new()
        for i in 0..len {
            let b: Byte = match data.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            let _ = val.bytes.set(i, b)
        }
        val.length = len
        Result::Ok(val)
    }

    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }

    pub fn get_byte(self, index: u32) -> Result[Byte, BoundsError>
        effects: [deterministic]
    {
        self.bytes.get(index)
    }
}

// ──────────────────────────────────────────────
// B-Tree Entry
// ──────────────────────────────────────────────
pub type BTreeEntry : struct {
    key: DbKey,
    value: DbValue,
    child_page: PageId,
}

impl BTreeEntry {
    pub fn new(k: DbKey, v: DbValue) -> BTreeEntry
        effects: [deterministic]
    {
        BTreeEntry {
            key: k,
            value: v,
            child_page: PageId::from_u32(0),
        }
    }

    pub fn with_child(k: DbKey, v: DbValue, child: PageId) -> BTreeEntry
        effects: [deterministic]
    {
        BTreeEntry {
            key: k,
            value: v,
            child_page: child,
        }
    }
}

// ──────────────────────────────────────────────
// B-Tree Page (Node)
// ──────────────────────────────────────────────
pub type BTreePage : struct {
    id: PageId,
    is_leaf: bool,
    entries: FixedArray[BTreeEntry, DB_MAX_KEYS_PER_PAGE],
    entry_count: u32,
    next_page: PageId,
    prev_page: PageId,
    depth: u8,
}

impl BTreePage {
    pub fn new(pid: PageId, leaf: bool, d: u8) -> BTreePage
        effects: [deterministic]
    {
        BTreePage {
            id: pid,
            is_leaf: leaf,
            entries: FixedArray::new(),
            entry_count: 0,
            next_page: PageId::from_u32(0),
            prev_page: PageId::from_u32(0),
            depth: d,
        }
    }

    pub fn insert_entry(self: ref mut, entry: BTreeEntry) -> Result<bool, BoundsError>
        effects: [deterministic]
    {
        if self.entry_count >= DB_MAX_KEYS_PER_PAGE {
            return Result::Ok(false) // Need split
        }
        let mut insert_idx: u32 = self.entry_count
        for i in 0..self.entry_count {
            let existing: BTreeEntry = match self.entries.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if entry.key.lt(existing.key) {
                insert_idx = i
                for j in (i..self.entry_count).rev() {
                    let e: BTreeEntry = match self.entries.get(j) {
                        Result::Ok(v) => v,
                        Result::Err(_) => continue,
                    }
                    let _ = self.entries.set(j + 1, e)
                }
            }
        }
        let r: Result<(), BoundsError> = self.entries.set(insert_idx, entry)
        if r.is_ok() {
            self.entry_count = self.entry_count + 1
            Result::Ok(true)
        } else {
            Result::Err(r.err())
        }
    }

    pub fn find_entry(self, key: DbKey) -> Result<u32, u32>
        effects: [deterministic]
    {
        for i in 0..self.entry_count {
            let existing: BTreeEntry = match self.entries.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if existing.key.eq(key) {
                return Result::Ok(i)
            }
            if key.lt(existing.key) {
                return Result::Err(i)
            }
        }
        Result::Err(self.entry_count)
    }

    pub fn get_entry(self, index: u32) -> Result<BTreeEntry, BoundsError>
        effects: [deterministic]
    {
        self.entries.get(index)
    }

    pub fn remove_entry(self: ref mut, index: u32) -> Result<BTreeEntry, BoundsError>
        effects: [deterministic]
    {
        let entry: BTreeEntry = match self.entries.get(index) {
            Result::Ok(e) => e,
            Result::Err(e) => return Result::Err(e),
        }
        for i in index..(self.entry_count - 1) {
            let e: BTreeEntry = match self.entries.get(i + 1) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            let _ = self.entries.set(i, e)
        }
        self.entry_count = self.entry_count - 1
        Result::Ok(entry)
    }

    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.entry_count >= DB_MAX_KEYS_PER_PAGE
    }

    pub fn is_half_full(self) -> bool
        effects: [deterministic]
    {
        self.entry_count >= DB_MAX_KEYS_PER_PAGE / 2
    }

    pub fn min_entries(self) -> u32
        effects: [deterministic]
    {
        if self.is_leaf {
            DB_MAX_KEYS_PER_PAGE / 2
        } else {
            (DB_MAX_KEYS_PER_PAGE + 1) / 2
        }
    }
}

// ──────────────────────────────────────────────
// Page Manager
// ──────────────────────────────────────────────
pub type PageManager : struct {
    pages: FixedArray[BTreePage, DB_MAX_PAGES],
    free_list: FixedArray[PageId, DB_MAX_PAGES],
    free_count: u32,
    next_page_id: u32,
    page_count: u32,
}

impl PageManager {
    pub fn new() -> PageManager
        effects: [deterministic]
    {
        let mut mgr: PageManager = PageManager {
            pages: FixedArray::new(),
            free_list: FixedArray::new(),
            free_count: 0,
            next_page_id: 1,
            page_count: 0,
        }
        // Initialize free list
        for i in 0..DB_MAX_PAGES {
            let pid: PageId = PageId::from_u32(0)
            let _ = mgr.free_list.set(i, pid)
        }
        mgr
    }

    pub fn alloc_page(self: ref mut, is_leaf: bool, depth: u8) -> Result<PageId, BoundsError>
        effects: [deterministic]
    {
        if self.page_count >= DB_MAX_PAGES {
            return Result::Err(bounds_capacity_exceeded(DB_MAX_PAGES))
        }
        let pid: PageId = PageId::from_u32(self.next_page_id)
        self.next_page_id = self.next_page_id + 1
        let page: BTreePage = BTreePage::new(pid, is_leaf, depth)
        let r: Result<(), BoundsError> = self.pages.set(self.page_count, page)
        if r.is_err() {
            return Result::Err(r.err())
        }
        self.page_count = self.page_count + 1
        Result::Ok(pid)
    }

    pub fn free_page(self: ref mut, pid: PageId) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        // Add to free list
        if self.free_count < DB_MAX_PAGES {
            let _ = self.free_list.set(self.free_count, pid)
            self.free_count = self.free_count + 1
        }
        Result::Ok(())
    }

    pub fn get_page(self, pid: PageId) -> Result<BTreePage, BoundsError>
        effects: [deterministic]
    {
        for i in 0..self.page_count {
            let page: BTreePage = match self.pages.get(i) {
                Result::Ok(p) => p,
                Result::Err(_) => continue,
            }
            if page.id.eq(pid) {
                return Result::Ok(page)
            }
        }
        Result::Err(bounds_index_out_of_range(0, self.page_count))
    }

    pub fn get_page_mut(self: ref mut, pid: PageId) -> Result<ref mut BTreePage, BoundsError>
        effects: [deterministic]
    {
        for i in 0..self.page_count {
            let page: ref mut BTreePage = match self.pages.ref_at_mut(i) {
                Result::Ok(p) => p,
                Result::Err(_) => continue,
            }
            if page.id.eq(pid) {
                return Result::Ok(page)
            }
        }
        Result::Err(bounds_index_out_of_range(0, self.page_count))
    }
}

// ──────────────────────────────────────────────
// Transaction Log Entry
// ──────────────────────────────────────────────
pub type TxnEntry : struct {
    txn_id: Word32,
    op_type: u8,
    key: DbKey,
    old_value: DbValue,
    new_value: DbValue,
    timestamp: Word64,
    committed: bool,
}

impl TxnEntry {
    pub fn new(tid: Word32, op: u8, k: DbKey, old: DbValue, newv: DbValue, ts: Word64) -> TxnEntry
        effects: [deterministic]
    {
        TxnEntry {
            txn_id: tid,
            op_type: op,
            key: k,
            old_value: old,
            new_value: newv,
            timestamp: ts,
            committed: false,
        }
    }

    pub fn record(self: ref mut)
        effects: [residual]
    {
        residual emit {
            store_op: "txn.entry",
            txn_id: self.txn_id.to_u32() as u64,
            op_type: self.op_type as u64,
            key_length: self.key.len() as u64,
            committed: if self.committed { 1 } else { 0 },
        }
    }
}

// ──────────────────────────────────────────────
// Transaction Manager
// ──────────────────────────────────────────────
pub type TxnManager : struct {
    log: FixedArray[TxnEntry, DB_TXN_LOG_CAP],
    log_count: u32,
    active_txns: FixedArray[Word32, DB_MAX_TXN_BATCH],
    active_count: u32,
    next_txn_id: Word32,
    current_txn_id: Word32,
    in_txn: bool,
    dirty_pages: FixedArray[PageId, DB_CACHE_LINE_CAP],
    dirty_count: u32,
}

impl TxnManager {
    pub fn new() -> TxnManager
        effects: [deterministic]
    {
        TxnManager {
            log: FixedArray::new(),
            log_count: 0,
            active_txns: FixedArray::new(),
            active_count: 0,
            next_txn_id: Word32::from_u32(1),
            current_txn_id: Word32::zero(),
            in_txn: false,
            dirty_pages: FixedArray::new(),
            dirty_count: 0,
        }
    }

    pub fn begin_txn(self: ref mut) -> Word32
        effects: [deterministic, residual]
    {
        let txn_id: Word32 = self.next_txn_id
        self.next_txn_id = Word32::from_u32(self.next_txn_id.to_u32() + 1)
        self.current_txn_id = txn_id
        self.in_txn = true
        if self.active_count < DB_MAX_TXN_BATCH {
            let _ = self.active_txns.set(self.active_count, txn_id)
            self.active_count = self.active_count + 1
        }
        residual emit {
            store_op: "txn.begin",
            txn_id: txn_id.to_u32() as u64,
        }
        txn_id
    }

    pub fn commit_txn(self: ref mut, ts: Word64) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        if !self.in_txn {
            return Result::Ok(false)
        }
        // Mark all entries for this txn as committed
        let mut dirty_count: u32 = 0
        for i in 0..self.log_count {
            let entry: ref mut TxnEntry = match self.log.ref_at_mut(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if entry.txn_id.eq(self.current_txn_id) {
                entry.committed = true
                entry.timestamp = ts
            }
        }

        // Write commit residual
        residual emit {
            store_op: "txn.commit",
            txn_id: self.current_txn_id.to_u32() as u64,
            log_entries: self.log_count as u64,
        }

        self.in_txn = false
        self.current_txn_id = Word32::zero()
        self.dirty_count = 0
        Result::Ok(true)
    }

    pub fn rollback_txn(self: ref mut) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        if !self.in_txn {
            return Result::Ok(false)
        }
        // Remove all entries for this txn
        let mut write_idx: u32 = 0
        for i in 0..self.log_count {
            let entry: TxnEntry = match self.log.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if !entry.txn_id.eq(self.current_txn_id) {
                let _ = self.log.set(write_idx, entry)
                write_idx = write_idx + 1
            }
        }
        self.log_count = write_idx

        residual emit {
            store_op: "txn.rollback",
            txn_id: self.current_txn_id.to_u32() as u64,
        }

        self.in_txn = false
        self.current_txn_id = Word32::zero()
        self.dirty_count = 0
        Result::Ok(true)
    }

    pub fn log_write(self: ref mut, key: DbKey, old_val: DbValue, new_val: DbValue, ts: Word64) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        if self.log_count >= DB_TXN_LOG_CAP {
            return Result::Err(bounds_capacity_exceeded(DB_TXN_LOG_CAP))
        }
        let entry: TxnEntry = TxnEntry::new(self.current_txn_id, 1, key, old_val, new_val, ts)
        let r: Result<(), BoundsError> = self.log.set(self.log_count, entry)
        if r.is_ok() {
            self.log_count = self.log_count + 1
        }
        r
    }

    pub fn mark_dirty(self: ref mut, pid: PageId)
        effects: [deterministic]
    {
        if self.dirty_count < DB_CACHE_LINE_CAP {
            let _ = self.dirty_pages.set(self.dirty_count, pid)
            self.dirty_count = self.dirty_count + 1
        }
    }
}

// ──────────────────────────────────────────────
// B-Tree Database
// ──────────────────────────────────────────────
pub type BTreeDatabase : struct {
    page_manager: PageManager,
    txn_manager: TxnManager,
    root_id: PageId,
    depth: u8,
    size: Word64,
    name: FixedString[32],
    residuals: FixedArray[DbKey, DB_RESIDUAL_LOG],
    residual_count: u32,
}

impl BTreeDatabase {
    pub fn new(db_name: FixedString[32]) -> BTreeDatabase
        effects: [deterministic, residual]
    {
        let mut db: BTreeDatabase = BTreeDatabase {
            page_manager: PageManager::new(),
            txn_manager: TxnManager::new(),
            root_id: PageId::from_u32(0),
            depth: 0,
            size: Word64::zero(),
            name: db_name,
            residuals: FixedArray::new(),
            residual_count: 0,
        }
        // Create root leaf page
        let root: PageId = match db.page_manager.alloc_page(true, 0) {
            Result::Ok(pid) => pid,
            Result::Err(_) => PageId::from_u32(0),
        }
        db.root_id = root
        db.depth = 0

        residual emit {
            store_op: "btree.created",
            name: db.name,
            root_id: root.value() as u64,
            page_capacity: DB_MAX_PAGES as u64,
            keys_per_page: DB_MAX_KEYS_PER_PAGE as u64,
        }
        db
    }

    pub fn get(self: ref mut, key: DbKey) -> Result[DbValue, BoundsError>
        effects: [deterministic]
    {
        if key.is_empty() {
            return Result::Err(bounds_index_out_of_range(0, 0))
        }
        let result: Result[DbValue, BoundsError> = self.search(self.root_id, key)
        result
    }

    fn search(self, page_id: PageId, key: DbKey) -> Result[DbValue, BoundsError>
        effects: [deterministic]
    {
        let page: BTreePage = match self.page_manager.get_page(page_id) {
            Result::Ok(p) => p,
            Result::Err(e) => return Result::Err(e),
        }
        let find_result: Result[u32, u32> = page.find_entry(key)
        match find_result {
            Result::Ok(idx) => {
                let entry: BTreeEntry = match page.get_entry(idx) {
                    Result::Ok(e) => e,
                    Result::Err(e) => return Result::Err(e),
                }
                Result::Ok(entry.value)
            }
            Result::Err(_) => {
                if page.is_leaf {
                    Result::Err(bounds_index_out_of_range(0, 0))
                } else {
                    // Continue search in child
                    // For simplicity, linear search for correct child
                    for i in 0..page.entry_count {
                        let entry: BTreeEntry = match page.get_entry(i) {
                            Result::Ok(e) => e,
                            Result::Err(_) => continue,
                        }
                        if key.lt(entry.key) {
                            if !entry.child_page.value().is_zero() {
                                return self.search(entry.child_page, key)
                            }
                        }
                    }
                    Result::Err(bounds_index_out_of_range(0, 0))
                }
            }
        }
    }

    pub fn insert(self: ref mut, key: DbKey, value: DbValue, ts: Word64) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        if self.page_manager.page_count >= DB_MAX_PAGES {
            return Result::Err(bounds_capacity_exceeded(DB_MAX_PAGES))
        }
        let result: Result<bool, BoundsError> = self.insert_into_page(self.root_id, key, value)
        match result {
            Result::Ok(true) => {
                self.size = self.size.increment_or_max()
                if self.txn_manager.in_txn {
                    let _ = self.txn_manager.log_write(key, DbValue::new(), value, ts)
                    self.txn_manager.mark_dirty(self.root_id)
                }
                residual emit {
                    store_op: "btree.insert",
                    key_length: key.len() as u64,
                    size: self.size.to_u64(),
                    depth: self.depth as u64,
                }
                Result::Ok(true)
            }
            Result::Ok(false) => Result::Ok(false),
            Result::Err(e) => Result::Err(e),
        }
    }

    fn insert_into_page(self: ref mut, page_id: PageId, key: DbKey, value: DbValue) -> Result<bool, BoundsError>
        effects: [deterministic]
    {
        let page: ref mut BTreePage = match self.page_manager.get_page_mut(page_id) {
            Result::Ok(p) => p,
            Result::Err(e) => return Result::Err(e),
        }
        let entry: BTreeEntry = BTreeEntry::new(key, value)
        if !page.is_full() {
            return page.insert_entry(entry)
        }
        // Page is full - need to split (simplified: don't split for now)
        Result::Ok(false)
    }

    pub fn delete(self: ref mut, key: DbKey, ts: Word64) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        let old_val: DbValue = match self.search(self.root_id, key) {
            Result::Ok(v) => v,
            Result::Err(_) => return Result::Ok(false),
        }
        let result: Result<bool, BoundsError> = self.delete_from_page(self.root_id, key)
        match result {
            Result::Ok(true) => {
                self.size = self.size.decrement()
                if self.txn_manager.in_txn {
                    let _ = self.txn_manager.log_write(key, old_val, DbValue::new(), ts)
                }
                residual emit {
                    store_op: "btree.delete",
                    key_length: key.len() as u64,
                    size: self.size.to_u64(),
                }
                Result::Ok(true)
            }
            Result::Ok(false) => Result::Ok(false),
            Result::Err(e) => Result::Err(e),
        }
    }

    fn delete_from_page(self: ref mut, page_id: PageId, key: DbKey) -> Result<bool, BoundsError>
        effects: [deterministic]
    {
        let page: ref mut BTreePage = match self.page_manager.get_page_mut(page_id) {
            Result::Ok(p) => p,
            Result::Err(e) => return Result::Err(e),
        }
        let find_result: Result[u32, u32> = page.find_entry(key)
        match find_result {
            Result::Ok(idx) => {
                let _ = page.remove_entry(idx)
                Result::Ok(true)
            }
            Result::Err(_) => Result::Ok(false),
        }
    }

    pub fn contains(self: ref mut, key: DbKey) -> bool
        effects: [deterministic]
    {
        let result: Result[DbValue, BoundsError> = self.search(self.root_id, key)
        result.is_ok()
    }

    pub fn range_query(self, start_key: DbKey, end_key: DbKey) -> FixedArray[DbKey, DB_RANGE_RESULT_CAP]
        effects: [deterministic]
    {
        let mut results: FixedArray[DbKey, DB_RANGE_RESULT_CAP] = FixedArray::new()
        let mut count: u32 = 0
        let root: BTreePage = match self.page_manager.get_page(self.root_id) {
            Result::Ok(p) => p,
            Result::Err(_) => return results,
        }
        for i in 0..root.entry_count {
            let entry: BTreeEntry = match root.get_entry(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if entry.key.gte(start_key) && entry.key.lte(end_key) {
                if count < DB_RANGE_RESULT_CAP {
                    let _ = results.set(count, entry.key)
                    count = count + 1
                }
            }
        }
        results
    }

    pub fn begin_txn(self: ref mut) -> Word32
        effects: [deterministic, residual]
    {
        self.txn_manager.begin_txn()
    }

    pub fn commit_txn(self: ref mut, ts: Word64) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        let result: Result<bool, BoundsError> = self.txn_manager.commit_txn(ts)
        result
    }

    pub fn rollback_txn(self: ref mut) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        let result: Result<bool, BoundsError> = self.txn_manager.rollback_txn()
        result
    }

    pub fn get_size(self) -> Word64
        effects: [deterministic]
    {
        self.size
    }

    pub fn get_depth(self) -> u8
        effects: [deterministic]
    {
        self.depth
    }

    pub fn get_page_count(self) -> u32
        effects: [deterministic]
    {
        self.page_manager.page_count
    }

    pub fn get_stats(self) -> FixedString[256]
        effects: [deterministic]
    {
        let mut stats: FixedString[256] = FixedString::new()
        stats.append(FixedString[16]::from_slice("DB: "))
        stats.append(self.name)
        stats.append(FixedString[8]::from_slice("\n  Size: "))
        stats.append_u64(self.size.to_u64())
        stats.append(FixedString[8]::from_slice("\n  Depth: "))
        stats.append_u64(self.depth as u64)
        stats.append(FixedString[8]::from_slice("\n  Pages: "))
        stats.append_u64(self.page_manager.page_count as u64)
        stats.append(FixedString[8]::from_slice("\n  Active txn: "))
        stats.append(if self.txn_manager.in_txn {
            FixedString[3]::from_slice("yes")
        } else {
            FixedString[2]::from_slice("no")
        })
        stats
    }

    pub fn flush_residuals(self: ref mut)
        effects: [residual]
    {
        residual emit {
            store_op: "btree.residuals.flushed",
            name: self.name,
            size: self.size.to_u64(),
            pages: self.page_manager.page_count as u64,
            depth: self.depth as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Crash Recovery
// ──────────────────────────────────────────────
pub type RecoveryManager : struct {
    wal_log: FixedArray[TxnEntry, DB_TXN_LOG_CAP],
    wal_count: u32,
    checkpoint_pages: FixedArray[PageId, DB_CACHE_LINE_CAP],
    checkpoint_count: u32,
    last_checkpoint: Word64,
    recovery_needed: bool,
    recovered_txns: Word64,
}

impl RecoveryManager {
    pub fn new() -> RecoveryManager
        effects: [deterministic]
    {
        RecoveryManager {
            wal_log: FixedArray::new(),
            wal_count: 0,
            checkpoint_pages: FixedArray::new(),
            checkpoint_count: 0,
            last_checkpoint: Word64::zero(),
            recovery_needed: false,
            recovered_txns: Word64::zero(),
        }
    }

    pub fn write_ahead_log(self: ref mut, entry: TxnEntry) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        if self.wal_count >= DB_TXN_LOG_CAP {
            return Result::Err(bounds_capacity_exceeded(DB_TXN_LOG_CAP))
        }
        let r: Result<(), BoundsError> = self.wal_log.set(self.wal_count, entry)
        if r.is_ok() {
            self.wal_count = self.wal_count + 1
        }
        r
    }

    pub fn checkpoint(self: ref mut, page_manager: ref mut PageManager)
        effects: [deterministic, residual]
    {
        // Write all dirty pages to stable storage (simulated)
        self.checkpoint_count = 0
        for i in 0..page_manager.page_count {
            if self.checkpoint_count < DB_CACHE_LINE_CAP {
                let page: BTreePage = match page_manager.pages.get(i) {
                    Result::Ok(p) => p,
                    Result::Err(_) => continue,
                }
                let _ = self.checkpoint_pages.set(self.checkpoint_count, page.id)
                self.checkpoint_count = self.checkpoint_count + 1
            }
        }
        // Truncate WAL up to checkpoint
        self.wal_count = 0
        self.last_checkpoint = Word64::from_u64(0)

        residual emit {
            store_op: "checkpoint",
            pages_flushed: self.checkpoint_count as u64,
            wal_cleared: true,
        }
    }

    pub fn recover(self: ref mut, db: ref mut BTreeDatabase) -> Word64
        effects: [deterministic, residual]
    {
        self.recovery_needed = true
        let mut recovered: Word64 = Word64::zero()

        // Replay WAL from last checkpoint
        for i in 0..self.wal_count {
            let entry: TxnEntry = match self.wal_log.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if entry.committed {
                // Re-apply the write
                let _ = db.insert(entry.key, entry.new_value, entry.timestamp)
                recovered = recovered.increment_or_max()
            }
        }

        self.recovered_txns = recovered
        self.recovery_needed = false

        residual emit {
            store_op: "crash.recovery",
            wal_entries: self.wal_count as u64,
            recovered_txns: recovered.to_u64(),
        }
        recovered
    }
}

// ──────────────────────────────────────────────
// Store Database (Main High-Level API)
// ──────────────────────────────────────────────
pub type StoreDatabase : struct {
    btree: BTreeDatabase,
    recovery: RecoveryManager,
    opened: bool,
    open_count: Word64,
    residuals: FixedArray[DbKey, DB_RESIDUAL_LOG],
}

impl StoreDatabase {
    pub fn create(name: FixedString[32]) -> StoreDatabase
        effects: [deterministic, residual]
    {
        let db: StoreDatabase = StoreDatabase {
            btree: BTreeDatabase::new(name),
            recovery: RecoveryManager::new(),
            opened: true,
            open_count: Word64::zero(),
            residuals: FixedArray::new(),
        }
        residual emit {
            store_op: "store_database.created",
            name: name,
        }
        db
    }

    pub fn open(db: ref mut StoreDatabase)
        effects: [deterministic]
    {
        db.opened = true
        db.open_count = db.open_count.increment_or_max()
    }

    pub fn put(db: ref mut StoreDatabase, key: DbKey, value: DbValue) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        let ts: Word64 = Word64::from_u64(0)
        db.btree.insert(key, value, ts)
    }

    pub fn get(db: ref mut StoreDatabase, key: DbKey) -> Result[DbValue, BoundsError>
        effects: [deterministic]
    {
        db.btree.get(key)
    }

    pub fn delete(db: ref mut StoreDatabase, key: DbKey) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        let ts: Word64 = Word64::from_u64(0)
        db.btree.delete(key, ts)
    }

    pub fn begin_transaction(db: ref mut StoreDatabase) -> Word32
        effects: [deterministic, residual]
    {
        db.btree.begin_txn()
    }

    pub fn commit_transaction(db: ref mut StoreDatabase) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        let ts: Word64 = Word64::from_u64(0)
        db.btree.commit_txn(ts)
    }

    pub fn rollback_transaction(db: ref mut StoreDatabase) -> Result<bool, BoundsError>
        effects: [deterministic, residual]
    {
        db.btree.rollback_txn()
    }

    pub fn range_query(db: ref StoreDatabase, start: DbKey, end: DbKey) -> FixedArray[DbKey, DB_RANGE_RESULT_CAP]
        effects: [deterministic]
    {
        db.btree.range_query(start, end)
    }

    pub fn checkpoint(db: ref mut StoreDatabase)
        effects: [deterministic, residual]
    {
        db.recovery.checkpoint(&mut db.btree.page_manager)
    }

    pub fn recover(db: ref mut StoreDatabase) -> Word64
        effects: [deterministic, residual]
    {
        db.recovery.recover(&mut db.btree)
    }

    pub fn stats(db: ref StoreDatabase) -> FixedString[256]
        effects: [deterministic]
    {
        db.btree.get_stats()
    }

    pub fn is_running(db: ref StoreDatabase) -> bool
        effects: [deterministic]
    {
        db.opened
    }

    pub fn size(db: ref StoreDatabase) -> Word64
        effects: [deterministic]
    {
        db.btree.size
    }

    pub fn close(db: ref mut StoreDatabase)
        effects: [deterministic, residual]
    {
        db.opened = false
        residual emit {
            store_op: "store_database.closed",
            final_size: db.btree.size.to_u64(),
            total_opens: db.open_count.to_u64(),
        }
    }
}

// ──────────────────────────────────────────────
// Verification and Report
// ──────────────────────────────────────────────
pub fn verify_store_integrity(db: ref StoreDatabase) -> bool
    effects: [deterministic]
{
    if !db.opened {
        return false
    }
    if db.btree.page_manager.page_count > DB_MAX_PAGES {
        return false
    }
    if db.btree.depth > DB_MAX_DEPTH as u8 {
        return false
    }
    true
}

pub fn store_report(db: ref StoreDatabase) -> FixedString[512]
    effects: [deterministic]
{
    let mut report: FixedString[512] = FixedString::new()
    report.append(FixedString[32]::from_slice("Store Database Report\n"))
    report.append(FixedString[20]::from_slice("====================\n"))
    report.append(FixedString[8]::from_slice("Name: "))
    report.append(db.btree.name)
    report.append(FixedString[8]::from_slice("\nSize: "))
    report.append_u64(db.btree.size.to_u64())
    report.append(FixedString[8]::from_slice("\nPages: "))
    report.append_u64(db.btree.page_manager.page_count as u64)
    report.append(FixedString[8]::from_slice("\nDepth: "))
    report.append_u64(db.btree.depth as u64)
    report.append(FixedString[8]::from_slice("\nOpen: "))
    report.append(if db.opened {
        FixedString[3]::from_slice("yes")
    } else {
        FixedString[2]::from_slice("no")
    })
    report.append(FixedString[8]::from_slice("\nWAL entries: "))
    report.append_u64(db.recovery.wal_count as u64)
    report
}

// ──────────────────────────────────────────────
// Module Initialization
// ──────────────────────────────────────────────
pub fn init_store_database(name: FixedString[32]) -> StoreDatabase
    effects: [deterministic, residual]
{
    let db: StoreDatabase = StoreDatabase::create(name)
    residual emit {
        store_op: "store.subsystem.init",
        name: name,
        page_size: DB_PAGE_SIZE as u64,
        max_pages: DB_MAX_PAGES as u64,
        txn_log_capacity: DB_TXN_LOG_CAP as u64,
    }
    db
}
