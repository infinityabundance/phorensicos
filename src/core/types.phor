// ──────────────────────────────────────────────
// Bool Operations
// ──────────────────────────────────────────────
// Phorensic does not have a built-in bool; we define it.
// Evidence path: TYPES-BOOL-001 through TYPES-BOOL-010

pub type Bool : u8 = enum {
    False = 0x00,
    True  = 0x01,
}

impl Bool {
    pub fn not(self) -> Bool
        effects: [deterministic]
    {
        if self == Bool::True { Bool::False } else { Bool::True }
    }

    pub fn and(self, other: Bool) -> Bool
        effects: [deterministic]
    {
        if self == Bool::True && other == Bool::True { Bool::True } else { Bool::False }
    }

    pub fn or(self, other: Bool) -> Bool
        effects: [deterministic]
    {
        if self == Bool::True || other == Bool::True { Bool::True } else { Bool::False }
    }

    pub fn xor(self, other: Bool) -> Bool
        effects: [deterministic]
    {
        if self != other { Bool::True } else { Bool::False }
    }

    pub fn to_bool(self) -> bool
        effects: [deterministic]
    {
        self == Bool::True
    }

    pub fn from_bool(b: bool) -> Bool
        effects: [deterministic]
    {
        if b { Bool::True } else { Bool::False }
    }
}

// ──────────────────────────────────────────────
// Option Type
// ──────────────────────────────────────────────
// Evidence path: TYPES-OPT-001 through TYPES-OPT-015

pub type Option[T] : enum {
    Some(value: T),
    None,
}

impl[T] Option[T] {
    pub fn is_some(self) -> bool
        effects: [deterministic]
    {
        match self {
            Option::Some(_) => true,
            Option::None    => false,
        }
    }

    pub fn is_none(self) -> bool
        effects: [deterministic]
    {
        !self.is_some()
    }

    pub fn unwrap(self) -> T
        effects: [deterministic, panic]
    {
        match self {
            Option::Some(value) => value,
            Option::None => panic("Option unwrap on None"),
        }
    }

    pub fn unwrap_or(self, default: T) -> T
        effects: [deterministic]
    {
        match self {
            Option::Some(value) => value,
            Option::None => default,
        }
    }

    pub fn map[U](self, f: fn(T) -> U) -> Option[U]
        effects: [deterministic]
    {
        match self {
            Option::Some(value) => Option::Some(f(value)),
            Option::None => Option::None,
        }
    }

    pub fn and_then[U](self, f: fn(T) -> Option[U]) -> Option[U]
        effects: [deterministic]
    {
        match self {
            Option::Some(value) => f(value),
            Option::None => Option::None,
        }
    }

    pub fn or_else(self, other: fn() -> Option[T]) -> Option[T]
        effects: [deterministic]
    {
        match self {
            Option::Some(value) => Option::Some(value),
            Option::None => other(),
        }
    }
}

// ──────────────────────────────────────────────
// Result Type
// ──────────────────────────────────────────────
// Evidence path: TYPES-RES-001 through TYPES-RES-020

pub type Result[T, E] : enum {
    Ok(value: T),
    Err(error: E),
}

impl[T, E] Result[T, E] {
    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        match self {
            Result::Ok(_)  => true,
            Result::Err(_) => false,
        }
    }

    pub fn is_err(self) -> bool
        effects: [deterministic]
    {
        !self.is_ok()
    }

    pub fn ok(self) -> Option[T]
        effects: [deterministic]
    {
        match self {
            Result::Ok(value) => Option::Some(value),
            Result::Err(_)    => Option::None,
        }
    }

    pub fn err(self) -> Option[E]
        effects: [deterministic]
    {
        match self {
            Result::Ok(_)     => Option::None,
            Result::Err(err)  => Option::Some(err),
        }
    }

    pub fn unwrap(self) -> T
        effects: [deterministic, panic]
    {
        match self {
            Result::Ok(value) => value,
            Result::Err(e)    => panic("Result unwrap on Err"),
        }
    }

    pub fn unwrap_or(self, default: T) -> T
        effects: [deterministic]
    {
        match self {
            Result::Ok(value) => value,
            Result::Err(_)    => default,
        }
    }

    pub fn map[U](self, f: fn(T) -> U) -> Result[U, E]
        effects: [deterministic]
    {
        match self {
            Result::Ok(value) => Result::Ok(f(value)),
            Result::Err(e)    => Result::Err(e),
        }
    }

    pub fn map_err[F](self, f: fn(E) -> F) -> Result[T, F]
        effects: [deterministic]
    {
        match self {
            Result::Ok(value) => Result::Ok(value),
            Result::Err(e)    => Result::Err(f(e)),
        }
    }

    pub fn and_then[U](self, f: fn(T) -> Result[U, E]) -> Result[U, E]
        effects: [deterministic]
    {
        match self {
            Result::Ok(value) => f(value),
            Result::Err(e)    => Result::Err(e),
        }
    }

    pub fn or_else(self, f: fn(E) -> Result[T, E]) -> Result[T, E]
        effects: [deterministic]
    {
        match self {
            Result::Ok(value) => Result::Ok(value),
            Result::Err(e)    => f(e),
        }
    }

    pub fn transpose(self) -> E
        effects: [deterministic, panic]
    {
        match self {
            Result::Ok(_)     => panic("Result transpose on Ok"),
            Result::Err(e)    => e,
        }
    }
}

// ──────────────────────────────────────────────
// FixedString Type
// ──────────────────────────────────────────────
// A fixed-capacity string for diagnostic messages and hex output.
// Evidence path: TYPES-STR-001 through TYPES-STR-025

pub type FixedString[N: static] : struct {
