// shell.phor — Phorensic Desktop Shell
// Panel, application launcher, system tray, notifications
// All operations bounded. Every function declares effects.

package gui.shell;

import gui.protocol;
import gui.surface;
import gui.canvas;
import gui.widgets;
import gui.window_manager;

// ──────────────────────────────────────────────
// Shell Constants
// ──────────────────────────────────────────────

const MAX_PANEL_ITEMS: u64 = 32;
const MAX_LAUNCHER_APPS: u64 = 128;
const MAX_NOTIFICATIONS: u64 = 64;
const MAX_TRAY_ICONS: u64 = 32;
const MAX_DESKTOP_ICONS: u64 = 64;
const MAX_WORKSPACES: u64 = 8;
const PANEL_HEIGHT: u32 = 40;
const PANEL_MARGIN: u32 = 4;
const ICON_SIZE: u32 = 24;
const CLOCK_UPDATE_INTERVAL_MS: u64 = 1000;
const NOTIFICATION_TIMEOUT_MS: u64 = 5000;
const MAX_LAUNCHER_QUERY_LEN: u64 = 128;
const MAX_RECENT_APPS: u64 = 16;
const MAX_FAVORITE_APPS: u64 = 16;

// ──────────────────────────────────────────────
// Panel Item Types
// ──────────────────────────────────────────────

enum PanelItemType {
    AppLauncher,
    WorkspaceSwitcher(u64),
    WindowList,
    SystemTray,
    Clock,
    NotificationArea,
    QuickSettings,
    SearchBar,
    Spacer,
    Separator,
    CustomMenu(u64),
}

// ──────────────────────────────────────────────
// Panel Item
// ──────────────────────────────────────────────

struct PanelItem {
    item_type: PanelItemType,
    widget_id: u64,
    surface_id: u64,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    icon_id: u64,
    label: Array(u8, 64),
    active: bool,
    visible: bool,
    priority: u64,
}

// ──────────────────────────────────────────────
// Panel Configuration
// ──────────────────────────────────────────────

struct PanelConfig {
    height: u32,
    position: u64, // 0=bottom, 1=top, 2=left, 3=right
    autohide: bool,
    opacity: f64,
    items: RingBuf(PanelItem, MAX_PANEL_ITEMS),
    item_count: u64,
    bg_color: protocol.ColorRGBA,
    fg_color: protocol.ColorRGBA,
    accent_color: protocol.ColorRGBA,
    font_size: u32,
}

// ──────────────────────────────────────────────
// Application Entry
// ──────────────────────────────────────────────

struct AppEntry {
    app_id: u64,
    name: Array(u8, 128),
    exec: Array(u8, 256),
    icon: Array(u8, 64),
    comment: Array(u8, 256),
    categories: Array(u8, 128),
    favorite: bool,
    recent_launch_ms: u64,
    launch_count: u64,
    terminal: bool,
    running: bool,
    window_ids: Array(u64, 8),
    window_count: u64,
}

// ──────────────────────────────────────────────
// Notification
// ──────────────────────────────────────────────

struct Notification {
    id: u64,
    app_id: Array(u8, 128),
    summary: Array(u8, 256),
    body: Array(u8, 512),
    urgency: protocol.NotificationUrgency,
    created_at_ms: u64,
    expire_at_ms: u64,
    icon: Array(u8, 64),
    actions: Array(Array(u8, 64), 8),
    action_count: u64,
    dismissed: bool,
    clicked: bool,
    surface_id: u64,
    popup_visible: bool,
}

// ──────────────────────────────────────────────
// System Tray Icon
// ──────────────────────────────────────────────

struct TrayIcon {
    id: u64,
    app_id: Array(u8, 128),
    icon: Array(u8, 64),
    tooltip: Array(u8, 128),
    surface_id: u64,
    active: bool,
    attention: bool,
    category: u64,
    status: u64,
    widget_id: u64,
}

// ──────────────────────────────────────────────
// Desktop Shell State
// ──────────────────────────────────────────────

struct DesktopShell {
    initialized: bool,

    // Panel
    panel_config: PanelConfig,
    panel_surface_id: u64,
    panel_widget_id: u64,
    panel_visible: bool,

    // Launcher
    app_entries: RingBuf(AppEntry, MAX_LAUNCHER_APPS),
    app_count: u64,
    next_app_id: u64,
    launcher_open: bool,
    launcher_surface_id: u64,
    launcher_query: Array(u8, MAX_LAUNCHER_QUERY_LEN),
    launcher_query_len: u64,
    search_results: Array(u64, 16),
    search_count: u64,
    recent_apps: RingBuf(u64, MAX_RECENT_APPS),
    recent_count: u64,
    favorite_apps: RingBuf(u64, MAX_FAVORITE_APPS),
    favorite_count: u64,

    // Notifications
    notifications: RingBuf(Notification, MAX_NOTIFICATIONS),
    notification_count: u64,
    next_notification_id: u64,
    notification_surface_id: u64,

    // System tray
    tray_icons: RingBuf(TrayIcon, MAX_TRAY_ICONS),
    tray_count: u64,
    next_tray_id: u64,

    // Workspaces
    workspaces: u64,
    current_workspace: u64,
    workspace_names: Array(Array(u8, 32), MAX_WORKSPACES),

    // Desktop icons
    desktop_icons: Array(u64, MAX_DESKTOP_ICONS),
    desktop_icon_count: u64,

    // Clock
    current_time: u64,
    current_time_str: Array(u8, 32),

    // Widget references
    clock_widget_id: u64,
    tray_widget_id: u64,
    launcher_widget_id: u64,

    // Statistics
    launch_count: u64,
    notification_count_total: u64,
    panel_open_count: u64,
}

// ──────────────────────────────────────────────
// Shell Initialization
// ──────────────────────────────────────────────

fn shell_init() -> DesktopShell
    effect [compute, residual]
{
    let panel: PanelConfig = PanelConfig {
        height: PANEL_HEIGHT,
        position: 0,
        autohide: false,
        opacity: 0.95,
        items: RingBuf::new(),
        item_count: 0,
        bg_color: protocol.ColorRGBA { r: 30, g: 30, b: 30, a: 242 },
        fg_color: protocol.ColorRGBA { r: 255, g: 255, b: 255, a: 255 },
        accent_color: protocol.ColorRGBA { r: 74, g: 144, b: 226, a: 255 },
        font_size: 12,
    };

    let sh: DesktopShell = DesktopShell {
        initialized: true,
        panel_config: panel,
        panel_surface_id: 0,
        panel_widget_id: 0,
        panel_visible: true,
        app_entries: RingBuf::new(),
        app_count: 0,
        next_app_id: 1,
        launcher_open: false,
        launcher_surface_id: 0,
        launcher_query: Array::zeroed(),
        launcher_query_len: 0,
        search_results: Array::zeroed(),
        search_count: 0,
        recent_apps: RingBuf::new(),
        recent_count: 0,
        favorite_apps: RingBuf::new(),
        favorite_count: 0,
        notifications: RingBuf::new(),
        notification_count: 0,
        next_notification_id: 1,
        notification_surface_id: 0,
        tray_icons: RingBuf::new(),
        tray_count: 0,
        next_tray_id: 1,
        workspaces: 1,
        current_workspace: 0,
        workspace_names: Array::zeroed(),
        desktop_icons: Array::zeroed(),
        desktop_icon_count: 0,
        current_time: 0,
        current_time_str: Array::zeroed(),
        clock_widget_id: 0,
        tray_widget_id: 0,
        launcher_widget_id: 0,
        launch_count: 0,
        notification_count_total: 0,
        panel_open_count: 0,
    };
    residual emit {
        op: "shell:init",
    };
    return sh;
}

// ──────────────────────────────────────────────
// Application Launcher
// ──────────────────────────────────────────────

fn shell_register_app(sh: DesktopShell, name: Slice(u8), exec: Slice(u8), icon: Slice(u8), comment: Slice(u8), categories: Slice(u8)) -> (DesktopShell, u64)
    effect [compute, io:write, residual]
    bound iterations MAX_LAUNCHER_APPS
{
    let mut updated: DesktopShell = sh;
    let app_id: u64 = updated.next_app_id;
    updated.next_app_id = updated.next_app_id + 1;

    let mut name_buf: Array(u8, 128) = Array::zeroed();
    let mut exec_buf: Array(u8, 256) = Array::zeroed();
    let mut icon_buf: Array(u8, 64) = Array::zeroed();
    let mut comment_buf: Array(u8, 256) = Array::zeroed();
    let mut cat_buf: Array(u8, 128) = Array::zeroed();

    for i in 0..128 { if i < name.len() { name_buf[i] = name[i]; } }
    for i in 0..256 { if i < exec.len() { exec_buf[i] = exec[i]; } }
    for i in 0..64 { if i < icon.len() { icon_buf[i] = icon[i]; } }
    for i in 0..256 { if i < comment.len() { comment_buf[i] = comment[i]; } }
    for i in 0..128 { if i < categories.len() { cat_buf[i] = categories[i]; } }

    let entry: AppEntry = AppEntry {
        app_id: app_id,
        name: name_buf,
        exec: exec_buf,
        icon: icon_buf,
        comment: comment_buf,
        categories: cat_buf,
        favorite: false,
        recent_launch_ms: 0,
        launch_count: 0,
        terminal: false,
        running: false,
        window_ids: Array::zeroed(),
        window_count: 0,
    };

    for i in 0..MAX_LAUNCHER_APPS {
        let e_opt: Option(AppEntry) = updated.app_entries[i];
        match e_opt {
            Option::None => {
                updated.app_entries[i] = Option::Some(entry);
                updated.app_count = updated.app_count + 1;
                residual emit {
                    op: "shell:register_app",
                    app_id: app_id,
                };
                return (updated, app_id);
            }
            Option::Some(_) => {}
        }
    }
    return (updated, 0);
}

fn shell_launch_app(sh: DesktopShell, app_id: u64) -> DesktopShell
    effect [compute, io:write, residual]
    bound iterations MAX_LAUNCHER_APPS
{
    let mut updated: DesktopShell = sh;
    for i in 0..MAX_LAUNCHER_APPS {
        let e_opt: Option(AppEntry) = updated.app_entries[i];
        match e_opt {
            Option::Some(e) => {
                if e.app_id == app_id {
                    let launched: AppEntry = AppEntry {
                        app_id: e.app_id,
                        name: e.name,
                        exec: e.exec,
                        icon: e.icon,
                        comment: e.comment,
                        categories: e.categories,
                        favorite: e.favorite,
                        recent_launch_ms: updated.current_time,
                        launch_count: e.launch_count + 1,
                        terminal: e.terminal,
                        running: true,
                        window_ids: e.window_ids,
                        window_count: e.window_count,
                    };
                    updated.app_entries[i] = Option::Some(launched);
                    updated.launch_count = updated.launch_count + 1;
                    // Add to recent
                    for j in 0..MAX_RECENT_APPS {
                        let r_opt: Option(u64) = updated.recent_apps[j];
                        match r_opt {
                            Option::None => {
                                updated.recent_apps[j] = Option::Some(app_id);
                                updated.recent_count = updated.recent_count + 1;
                                break;
                            }
                            Option::Some(rid) => {
                                if rid == app_id {
                                    // Already in recent, move to front
                                    break;
                                }
                            }
                        }
                    }
                    residual emit {
                        op: "shell:launch",
                        app_id: app_id,
                    };
                    break;
                }
            }
            Option::None => {}
        }
    }
    return updated;
}

fn shell_search_apps(sh: DesktopShell, query: Slice(u8), query_len: u64) -> Array(u64, 16)
    effect [compute]
    bound iterations MAX_LAUNCHER_APPS
{
    let mut results: Array(u64, 16) = Array::zeroed();
    let mut count: u64 = 0;
    for i in 0..MAX_LAUNCHER_APPS {
        if count >= 16 { break; }
        let e_opt: Option(AppEntry) = sh.app_entries[i];
        match e_opt {
            Option::Some(e) => {
                // Simple substring match on name
                let mut matched: bool = false;
                if query_len == 0 {
                    matched = true;
                } else {
                    for j in 0..128 {
                        if j >= query_len { break; }
                        if j >= 128 { break; }
                        if e.name[j] != query[j] { matched = false; break; }
                        matched = true;
                    }
                }
                if matched {
                    results[count] = e.app_id;
                    count = count + 1;
                }
            }
            Option::None => {}
        }
    }
    return results;
}

fn shell_toggle_favorite(sh: DesktopShell, app_id: u64) -> DesktopShell
    effect [compute]
    bound iterations MAX_FAVORITE_APPS
{
    let mut updated: DesktopShell = sh;
    // Toggle favorite
    for i in 0..MAX_LAUNCHER_APPS {
        let e_opt: Option(AppEntry) = updated.app_entries[i];
        match e_opt {
            Option::Some(e) => {
                if e.app_id == app_id {
                    let toggled: AppEntry = AppEntry {
                        app_id: e.app_id,
                        name: e.name,
                        exec: e.exec,
                        icon: e.icon,
                        comment: e.comment,
                        categories: e.categories,
                        favorite: !e.favorite,
                        recent_launch_ms: e.recent_launch_ms,
                        launch_count: e.launch_count,
                        terminal: e.terminal,
                        running: e.running,
                        window_ids: e.window_ids,
                        window_count: e.window_count,
                    };
                    updated.app_entries[i] = Option::Some(toggled);
                    if toggled.favorite {
                        for j in 0..MAX_FAVORITE_APPS {
                            let f_opt: Option(u64) = updated.favorite_apps[j];
                            match f_opt {
                                Option::None => {
                                    updated.favorite_apps[j] = Option::Some(app_id);
                                    updated.favorite_count = updated.favorite_count + 1;
                                    break;
                                }
                                Option::Some(_) => {}
                            }
                        }
                    } else {
                        for j in 0..MAX_FAVORITE_APPS {
                            let f_opt: Option(u64) = updated.favorite_apps[j];
                            match f_opt {
                                Option::Some(fid) => {
                                    if fid == app_id {
                                        updated.favorite_apps[j] = Option::None;
                                        updated.favorite_count = updated.favorite_count - 1;
                                        break;
                                    }
                                }
                                Option::None => {}
                            }
                        }
                    }
                    break;
                }
            }
            Option::None => {}
        }
    }
    return updated;
}

// ──────────────────────────────────────────────
// Notification Management
// ──────────────────────────────────────────────

fn shell_show_notification(sh: DesktopShell, app_name: Slice(u8), summary: Slice(u8), body: Slice(u8), urgency: protocol.NotificationUrgency, timeout_ms: u64, now_ms: u64) -> (DesktopShell, u64)
    effect [compute, io:write, residual]
    bound iterations MAX_NOTIFICATIONS
{
    let mut updated: DesktopShell = sh;
    let notif_id: u64 = updated.next_notification_id;
    updated.next_notification_id = updated.next_notification_id + 1;

    let mut app_buf: Array(u8, 128) = Array::zeroed();
    let mut sum_buf: Array(u8, 256) = Array::zeroed();
    let mut body_buf: Array(u8, 512) = Array::zeroed();
    for i in 0..128 { if i < app_name.len() { app_buf[i] = app_name[i]; } }
    for i in 0..256 { if i < summary.len() { sum_buf[i] = summary[i]; } }
    for i in 0..512 { if i < body.len() { body_buf[i] = body[i]; } }

    let expire: u64 = if timeout_ms > 0 { now_ms + timeout_ms } else { now_ms + NOTIFICATION_TIMEOUT_MS };

    let notif: Notification = Notification {
        id: notif_id,
        app_id: app_buf,
        summary: sum_buf,
        body: body_buf,
        urgency: urgency,
        created_at_ms: now_ms,
        expire_at_ms: expire,
        icon: Array::zeroed(),
        actions: Array::zeroed(),
        action_count: 0,
        dismissed: false,
        clicked: false,
        surface_id: 0,
        popup_visible: false,
    };

    for i in 0..MAX_NOTIFICATIONS {
        let n_opt: Option(Notification) = updated.notifications[i];
        match n_opt {
            Option::None => {
                updated.notifications[i] = Option::Some(notif);
                updated.notification_count = updated.notification_count + 1;
                updated.notification_count_total = updated.notification_count_total + 1;
                residual emit {
                    op: "shell:notification",
                    id: notif_id,
                    urgency: urgency as u64,
                };
                return (updated, notif_id);
            }
            Option::Some(_) => {}
        }
    }
    return (updated, 0);
}

fn shell_dismiss_notification(sh: DesktopShell, notif_id: u64) -> DesktopShell
    effect [compute]
    bound iterations MAX_NOTIFICATIONS
{
    let mut updated: DesktopShell = sh;
    for i in 0..MAX_NOTIFICATIONS {
        let n_opt: Option(Notification) = updated.notifications[i];
        match n_opt {
            Option::Some(n) => {
                if n.id == notif_id && !n.dismissed {
                    let dismissed: Notification = Notification {
                        id: n.id,
                        app_id: n.app_id,
                        summary: n.summary,
                        body: n.body,
                        urgency: n.urgency,
                        created_at_ms: n.created_at_ms,
                        expire_at_ms: n.expire_at_ms,
                        icon: n.icon,
                        actions: n.actions,
                        action_count: n.action_count,
                        dismissed: true,
                        clicked: n.clicked,
                        surface_id: n.surface_id,
                        popup_visible: false,
                    };
                    updated.notifications[i] = Option::Some(dismissed);
                    updated.notification_count = updated.notification_count - 1;
                    break;
                }
            }
            Option::None => {}
        }
    }
    return updated;
}

fn shell_expire_notifications(sh: DesktopShell, now_ms: u64) -> DesktopShell
    effect [compute]
    bound iterations MAX_NOTIFICATIONS
{
    let mut updated: DesktopShell = sh;
    for i in 0..MAX_NOTIFICATIONS {
        let n_opt: Option(Notification) = updated.notifications[i];
        match n_opt {
            Option::Some(n) => {
                if !n.dismissed && now_ms >= n.expire_at_ms {
                    let expired: Notification = Notification {
                        id: n.id,
                        app_id: n.app_id,
                        summary: n.summary,
                        body: n.body,
                        urgency: n.urgency,
                        created_at_ms: n.created_at_ms,
                        expire_at_ms: n.expire_at_ms,
                        icon: n.icon,
                        actions: n.actions,
                        action_count: n.action_count,
                        dismissed: true,
                        clicked: n.clicked,
                        surface_id: n.surface_id,
                        popup_visible: false,
                    };
                    updated.notifications[i] = Option::Some(expired);
                    updated.notification_count = updated.notification_count - 1;
                }
            }
            Option::None => {}
        }
    }
    return updated;
}

// ──────────────────────────────────────────────
// System Tray
// ──────────────────────────────────────────────

fn shell_register_tray_icon(sh: DesktopShell, app_name: Slice(u8), icon: Slice(u8), tooltip: Slice(u8)) -> (DesktopShell, u64)
    effect [compute, io:write, residual]
    bound iterations MAX_TRAY_ICONS
{
    let mut updated: DesktopShell = sh;
    let tray_id: u64 = updated.next_tray_id;
    updated.next_tray_id = updated.next_tray_id + 1;

    let mut app_buf: Array(u8, 128) = Array::zeroed();
    let mut icon_buf: Array(u8, 64) = Array::zeroed();
    let mut tip_buf: Array(u8, 128) = Array::zeroed();
    for i in 0..128 { if i < app_name.len() { app_buf[i] = app_name[i]; } }
    for i in 0..64 { if i < icon.len() { icon_buf[i] = icon[i]; } }
    for i in 0..128 { if i < tooltip.len() { tip_buf[i] = tooltip[i]; } }

    let ti: TrayIcon = TrayIcon {
        id: tray_id,
        app_id: app_buf,
        icon: icon_buf,
        tooltip: tip_buf,
        surface_id: 0,
        active: true,
        attention: false,
        category: 0,
        status: 0,
        widget_id: 0,
    };

    for i in 0..MAX_TRAY_ICONS {
        let t_opt: Option(TrayIcon) = updated.tray_icons[i];
        match t_opt {
            Option::None => {
                updated.tray_icons[i] = Option::Some(ti);
                updated.tray_count = updated.tray_count + 1;
                residual emit {
                    op: "shell:tray_icon_add",
                    id: tray_id,
                };
                return (updated, tray_id);
            }
            Option::Some(_) => {}
        }
    }
    return (updated, 0);
}

fn shell_remove_tray_icon(sh: DesktopShell, tray_id: u64) -> DesktopShell
    effect [compute]
    bound iterations MAX_TRAY_ICONS
{
    let mut updated: DesktopShell = sh;
    for i in 0..MAX_TRAY_ICONS {
        let t_opt: Option(TrayIcon) = updated.tray_icons[i];
        match t_opt {
            Option::Some(t) => {
                if t.id == tray_id {
                    updated.tray_icons[i] = Option::None;
                    updated.tray_count = updated.tray_count - 1;
                    break;
                }
            }
            Option::None => {}
        }
    }
    return updated;
}

fn shell_set_tray_attention(sh: DesktopShell, tray_id: u64, attention: bool) -> DesktopShell
    effect [compute]
    bound iterations MAX_TRAY_ICONS
{
    let mut updated: DesktopShell = sh;
    for i in 0..MAX_TRAY_ICONS {
        let t_opt: Option(TrayIcon) = updated.tray_icons[i];
        match t_opt {
            Option::Some(t) => {
                if t.id == tray_id {
                    let updated_t: TrayIcon = TrayIcon {
                        id: t.id,
                        app_id: t.app_id,
                        icon: t.icon,
                        tooltip: t.tooltip,
                        surface_id: t.surface_id,
                        active: t.active,
                        attention: attention,
                        category: t.category,
                        status: t.status,
                        widget_id: t.widget_id,
                    };
                    updated.tray_icons[i] = Option::Some(updated_t);
                    break;
                }
            }
            Option::None => {}
        }
    }
    return updated;
}

// ──────────────────────────────────────────────
// Panel Management
// ──────────────────────────────────────────────

fn shell_add_panel_item(sh: DesktopShell, item_type: PanelItemType, label: Slice(u8), priority: u64) -> (DesktopShell, u64)
    effect [compute, io:write]
    bound iterations MAX_PANEL_ITEMS
{
    let mut updated: DesktopShell = sh;
    let mut label_buf: Array(u8, 64) = Array::zeroed();
    for i in 0..64 { if i < label.len() { label_buf[i] = label[i]; } }

    let item: PanelItem = PanelItem {
        item_type: item_type,
        widget_id: 0,
        surface_id: 0,
        x: 0, y: 0,
        width: 48, height: updated.panel_config.height - PANEL_MARGIN * 2,
        icon_id: 0,
        label: label_buf,
        active: false,
        visible: true,
        priority: priority,
    };

    for i in 0..MAX_PANEL_ITEMS {
        let p_opt: Option(PanelItem) = updated.panel_config.items[i];
        match p_opt {
            Option::None => {
                updated.panel_config.items[i] = Option::Some(item);
                updated.panel_config.item_count = updated.panel_config.item_count + 1;
                return (updated, i);
            }
            Option::Some(_) => {}
        }
    }
    return (updated, 0);
}

fn shell_update_panel_item(sh: DesktopShell, idx: u64, item: PanelItem) -> DesktopShell
    effect [compute]
{
    let mut updated: DesktopShell = sh;
    if idx < MAX_PANEL_ITEMS {
        updated.panel_config.items[idx] = Option::Some(item);
    }
    return updated;
}

// ──────────────────────────────────────────────
// Workspace Management
// ──────────────────────────────────────────────

fn shell_set_workspace_count(sh: DesktopShell, count: u64) -> DesktopShell
    effect [compute, residual]
{
    let mut updated: DesktopShell = sh;
    let clamped: u64 = if count > MAX_WORKSPACES { MAX_WORKSPACES } else { count };
    if clamped < 1 { return updated; }
    updated.workspaces = clamped;
    if updated.current_workspace >= clamped {
        updated.current_workspace = 0;
    }
    residual emit {
        op: "shell:workspace_count",
        count: clamped,
    };
    return updated;
}

fn shell_switch_workspace(sh: DesktopShell, workspace: u64) -> DesktopShell
    effect [compute, residual]
{
    let mut updated: DesktopShell = sh;
    if workspace < updated.workspaces && workspace != updated.current_workspace {
        updated.current_workspace = workspace;
        residual emit {
            op: "shell:workspace_switch",
            workspace: workspace,
        };
    }
    return updated;
}

// ──────────────────────────────────────────────
// Clock Update
// ──────────────────────────────────────────────

fn shell_update_clock(sh: DesktopShell, now_ms: u64) -> DesktopShell
    effect [compute]
{
    let mut updated: DesktopShell = sh;
    updated.current_time = now_ms;
    // Format time as simple string (HH:MM)
    let hours: u64 = (now_ms / 3600000) % 24;
    let minutes: u64 = (now_ms / 60000) % 60;
    let mut time_str: Array(u8, 32) = Array::zeroed();
    time_str[0] = 48 + ((hours / 10) as u8);
    time_str[1] = 48 + ((hours % 10) as u8);
    time_str[2] = 58; // ':'
    time_str[3] = 48 + ((minutes / 10) as u8);
    time_str[4] = 48 + ((minutes % 10) as u8);
    time_str[5] = 0;
    updated.current_time_str = time_str;
    return updated;
}

// ──────────────────────────────────────────────
// Shell Rendering (delegates to widget tree)
// ──────────────────────────────────────────────

fn shell_render_panel(sh: DesktopShell, cs: canvas.CanvasState) -> canvas.CanvasState
    effect [io:read, io:write, compute]
{
    let mut updated_cs: canvas.CanvasState = cs;
    // Draw panel background
    let panel_rect: protocol.Rectangle = protocol.make_rect(0, 0, cs.width, sh.panel_config.height);
    updated_cs = canvas.canvas_set_fill_color(updated_cs, sh.panel_config.bg_color);
    updated_cs = canvas.canvas_fill_rect(updated_cs, panel_rect);

    // Draw panel items
    for i in 0..MAX_PANEL_ITEMS {
        let item_opt: Option(PanelItem) = sh.panel_config.items[i];
        match item_opt {
            Option::Some(item) => {
                if !item.visible { continue; }
                // Draw item background if active
                if item.active {
                    let item_rect: protocol.Rectangle = protocol.make_rect(item.x, item.y, item.width, item.height);
                    updated_cs = canvas.canvas_set_fill_color(updated_cs, sh.panel_config.accent_color);
                    updated_cs = canvas.canvas_fill_rounded_rect(updated_cs, item_rect, 4);
                }
                // Draw label
                updated_cs = canvas.canvas_set_fill_color(updated_cs, sh.panel_config.fg_color);
                let label_slice: Slice(u8) = Slice::from_array(item.label);
                updated_cs = canvas.canvas_draw_text(updated_cs, canvas.FontAtlas { glyphs: Array::zeroed(), glyph_count: 0, font_size: sh.panel_config.font_size, line_height: sh.panel_config.font_size + sh.panel_config.font_size / 2, space_width: sh.panel_config.font_size / 3, tab_width: sh.panel_config.font_size * 2 }, label_slice, item.x + 8, item.y + (item.height as i32 - sh.panel_config.font_size as i32) / 2);
            }
            Option::None => {}
        }
    }

    // Draw clock on right side
    let clock_x: i32 = (cs.width as i32) - 80;
    let clock_y: i32 = ((sh.panel_config.height as i32) - sh.panel_config.font_size as i32) / 2;
    updated_cs = canvas.canvas_set_fill_color(updated_cs, sh.panel_config.fg_color);
    let clock_slice: Slice(u8) = Slice::from_array(sh.current_time_str);
    updated_cs = canvas.canvas_draw_text(updated_cs, canvas.FontAtlas { glyphs: Array::zeroed(), glyph_count: 0, font_size: sh.panel_config.font_size, line_height: sh.panel_config.font_size + sh.panel_config.font_size / 2, space_width: sh.panel_config.font_size / 3, tab_width: sh.panel_config.font_size * 2 }, clock_slice, clock_x, clock_y);

    return updated_cs;
}

fn shell_render_desktop(sh: DesktopShell, cs: canvas.CanvasState) -> canvas.CanvasState
    effect [io:read, io:write, compute]
{
    let mut updated_cs: canvas.CanvasState = cs;
    // Draw desktop background gradient
    let desktop_rect: protocol.Rectangle = protocol.make_rect(0, 0, cs.width, cs.height);
    let top_color: protocol.ColorRGBA = protocol.ColorRGBA { r: 45, g: 55, b: 75, a: 255 };
    let bot_color: protocol.ColorRGBA = protocol.ColorRGBA { r: 25, g: 30, b: 45, a: 255 };
    updated_cs = canvas.canvas_fill_rect_gradient_v(updated_cs, desktop_rect, top_color, bot_color);
    return updated_cs;
}

// ──────────────────────────────────────────────
// Shell Info
// ──────────────────────────────────────────────

struct ShellInfo {
    initialized: bool,
    app_count: u64,
    notification_count: u64,
    tray_count: u64,
    panel_item_count: u64,
    workspaces: u64,
    current_workspace: u64,
    launcher_open: bool,
    panel_visible: bool,
    launch_count_total: u64,
    notification_count_total: u64,
}

fn shell_get_info(sh: DesktopShell) -> ShellInfo
    effect [compute]
{
    return ShellInfo {
        initialized: sh.initialized,
        app_count: sh.app_count,
        notification_count: sh.notification_count,
        tray_count: sh.tray_count,
        panel_item_count: sh.panel_config.item_count,
        workspaces: sh.workspaces,
        current_workspace: sh.current_workspace,
        launcher_open: sh.launcher_open,
        panel_visible: sh.panel_visible,
        launch_count_total: sh.launch_count,
        notification_count_total: sh.notification_count_total,
    };
}
