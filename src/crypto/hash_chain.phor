// file: hash_chain.phor
// purpose: Hash chain with incremental hashing, chain verification, Merkle tree
//          construction, proof generation, proof verification, and receipt hash.
// evidence: HCHAIN-ARCH-001 through HCHAIN-ARCH-200
// residual: All operations are deterministic with bounded loops.

package "phorensic:crypto:hash_chain:v1.0";

use core::constants::*
use core::types::*
use core::math::*
use core::errors::*
use core::collections::*

use crypto::sha256::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────
// Evidence path: HCHAIN-CONST-001 through HCHAIN-CONST-015

const HASH_CHAIN_MAX_LENGTH : u32 = 65536
const MERKLE_MAX_LEAVES : u32 = 4096
const MERKLE_MAX_DEPTH : u32 = 12
const MERKLE_MAX_PROOF_SIZE : u32 = 12
const RECEIPT_HASH_SIZE : u32 = 32

// ──────────────────────────────────────────────
// Hash Chain
// ──────────────────────────────────────────────
// Evidence path: HCHAIN-CHAIN-001 through HCHAIN-CHAIN-050

pub type HashChain : struct {
    chain: FixedArray[65536, SHA256Digest],
    length: u32,
    seed: SHA256Digest,
}

impl HashChain {
    // Create a new hash chain starting from a seed.
    pub fn new(seed: ref SHA256Digest) -> HashChain
        effects: [deterministic]
    {
        let mut chain: FixedArray[65536, SHA256Digest] = FixedArray::new()
        let _ = chain.push(*seed)

        HashChain {
            chain: chain,
            length: 1,
            seed: *seed,
        }
    }

    // Extend the chain by appending a new hash.
    pub fn extend(self: ref mut, data: ref Byte[], data_len: u32) -> Result[(), ChainError]
        effects: [deterministic, hash]
    {
        if self.length >= HASH_CHAIN_MAX_LENGTH {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x100),
                FixedString[128]::from_slice("hash chain: max length reached")))
        }

        let prev: ref SHA256Digest = self.chain.ref_at(self.length - 1)?
        let prev_bytes: ref Byte[32] = prev.as_bytes()

        // H(next) = SHA256(prev || data)
        let mut input: Byte[64] = [Byte::from_u8(0); 64]
        let copy_len: u32 = if data_len > 32 { 32 } else { data_len }

        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            input[i as usize] = prev_bytes[i as usize]
        }
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..copy_len {
            input[(32 + i) as usize] = data[i as usize]
        }

        let next_hash: SHA256Digest = SHA256::hash(&input, 32 + copy_len)
        let _ = self.chain.push(next_hash)
        self.length = self.length + 1

        Result::Ok(())
    }

    // Get the current tip of the chain.
    pub fn tip(self) -> Result[SHA256Digest, ChainError]
        effects: [deterministic]
    {
        if self.length == 0 {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x101),
                FixedString[128]::from_slice("hash chain: empty chain")))
        }
        let _ = self.chain.ref_at(self.length - 1)
        Result::Ok(self.chain[self.length - 1])
    }

    // Verify chain integrity from a known anchor.
    pub fn verify_chain(self, anchor: ref SHA256Digest) -> bool
        effects: [deterministic, hash]
    {
        // Check seed matches anchor
        if !SHA256::verify_constant_time(self.chain[0], *anchor) {
            return false
        }

        // Verify each link in the chain
        // loop: bounds[BOUND_LARGE] — bounded by chain length
        loop: bounds[BOUND_LARGE] for i in 1..self.length {
            let prev: ref SHA256Digest = self.chain.ref_at(i - 1)?
            let curr: ref SHA256Digest = self.chain.ref_at(i)?
            let expected: SHA256Digest = SHA256::hash(prev.as_bytes(), 32)
            if !SHA256::verify_constant_time(*curr, expected) {
                return false
            }
        }
        true
    }

    // Verify a specific link in the chain.
    pub fn verify_link(self, index: u32) -> bool
        effects: [deterministic, hash]
    {
        if index == 0 || index >= self.length {
            return false
        }

        let prev: ref SHA256Digest = self.chain.ref_at(index - 1)?
        let curr: ref SHA256Digest = self.chain.ref_at(index)?
        let expected: SHA256Digest = SHA256::hash(prev.as_bytes(), 32)
        SHA256::verify_constant_time(*curr, expected)
    }

    // Reset the chain to seed.
    pub fn reset(self: ref mut, seed: ref SHA256Digest)
        effects: [deterministic]
    {
        self.chain.clear()
        let _ = self.chain.push(*seed)
        self.length = 1
    }

    // Get the chain length.
    pub fn len(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    // Check if the chain is empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.length == 0
    }
}

// ──────────────────────────────────────────────
// Incremental Hash Chain
// ──────────────────────────────────────────────
// Evidence path: HCHAIN-INC-001 through HCHAIN-INC-030

pub type IncrementalHashChain : struct {
    current: SHA256Digest,
    count: u64,
    is_empty: bool,
}

impl IncrementalHashChain {
    // Create a new incremental hash chain from a seed.
    pub fn new(seed: ref SHA256Digest) -> IncrementalHashChain
        effects: [deterministic]
    {
        IncrementalHashChain {
            current: *seed,
            count: 0,
            is_empty: true,
        }
    }

    // Absorb data into the chain incrementally.
    pub fn absorb(self: ref mut, data: ref Byte[], data_len: u32)
        effects: [deterministic, hash]
    {
        if self.is_empty {
            self.current = SHA256::hash(data, data_len)
            self.is_empty = false
        } else {
            let mut input: Byte[64] = [Byte::from_u8(0); 64]
            let prev_bytes: ref Byte[32] = self.current.as_bytes()
            // loop: bounds[BOUND_SMALL] — bounded by 32
            loop: bounds[BOUND_SMALL] for i in 0..32 {
                input[i as usize] = prev_bytes[i as usize]
            }
            let copy_len: u32 = if data_len > 32 { 32 } else { data_len }
            // loop: bounds[BOUND_SMALL] — bounded by 32
            loop: bounds[BOUND_SMALL] for i in 0..copy_len {
                input[(32 + i) as usize] = data[i as usize]
            }
            self.current = SHA256::hash(&input, 32 + copy_len)
        }
        self.count = self.count + 1
    }

    // Get the current hash state.
    pub fn current_hash(self) -> SHA256Digest
        effects: [deterministic]
    {
        self.current
    }

    // Get the number of elements absorbed.
    pub fn count(self) -> u64
        effects: [deterministic]
    {
        self.count
    }

    // Verify the chain against a known final value.
    pub fn verify_chain(self, expected: ref SHA256Digest) -> bool
        effects: [deterministic]
    {
        SHA256::verify_constant_time(self.current, *expected)
    }
}

// ──────────────────────────────────────────────
// Merkle Tree
// ──────────────────────────────────────────────
// Evidence path: HCHAIN-MERKLE-001 through HCHAIN-MERKLE-060

pub type MerkleTree : struct {
    nodes: FixedArray[8191, SHA256Digest],  // 2 * 4096 - 1 max nodes
    leaf_count: u32,
    node_count: u32,
    depth: u32,
}

impl MerkleTree {
    // Build a Merkle tree from leaf data.
    pub fn build(leaves: ref SHA256Digest[], count: u32) -> Result[MerkleTree, ChainError]
        effects: [deterministic, hash]
    {
        if count > MERKLE_MAX_LEAVES || count == 0 {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x110),
                FixedString[128]::from_slice("merkle: invalid leaf count")))
        }

        let mut tree: MerkleTree = MerkleTree {
            nodes: FixedArray::new(),
            leaf_count: count,
            node_count: 0,
            depth: 0,
        }

        // Calculate tree depth
        let mut depth: u32 = 0
        let mut size: u32 = count
        // loop: bounds[BOUND_SMALL] — bounded by max depth
        loop: bounds[BOUND_SMALL] while size > 1 {
            depth = depth + 1
            size = (size + 1) / 2
        }
        tree.depth = depth

        // Copy leaves to internal storage
        // loop: bounds[BOUND_LARGE] — bounded by 4096 leaves
        loop: bounds[BOUND_LARGE] for i in 0..count {
            let _ = tree.nodes.push(leaves[i as usize])
            tree.node_count = tree.node_count + 1
        }

        // Build internal nodes bottom-up
        let mut current_level_start: u32 = 0
        let mut current_count: u32 = count

        // loop: bounds[BOUND_MEDIUM] — bounded by tree depth
        loop: bounds[BOUND_MEDIUM] while current_count > 1 {
            let next_count: u32 = (current_count + 1) / 2
            // loop: bounds[BOUND_MEDIUM] — bounded by nodes at current level
            loop: bounds[BOUND_MEDIUM] for i in 0..next_count {
                let left_idx: u32 = current_level_start + (i * 2)
                let right_idx: u32 = left_idx + 1

                let left: ref SHA256Digest = tree.nodes.ref_at(left_idx)?
                let right: SHA256Digest

                if right_idx < current_level_start + current_count {
                    right = *tree.nodes.ref_at(right_idx)?
                } else {
                    // Duplicate last node if odd count
                    right = *left
                }

                let mut combined: Byte[64] = [Byte::from_u8(0); 64]
                let lb: ref Byte[32] = left.as_bytes()
                let rb: ref Byte[32] = right.as_bytes()
                // loop: bounds[BOUND_SMALL] — bounded by 32
                loop: bounds[BOUND_SMALL] for j in 0..32 {
                    combined[j as usize] = lb[j as usize]
                    combined[(32 + j) as usize] = rb[j as usize]
                }

                let parent: SHA256Digest = SHA256::hash(&combined, 64)
                let _ = tree.nodes.push(parent)
                tree.node_count = tree.node_count + 1
            }

            current_level_start = current_level_start + current_count
            current_count = next_count
        }

        Result::Ok(tree)
    }

    // Get the Merkle root.
    pub fn root(self) -> Result[SHA256Digest, ChainError>
        effects: [deterministic]
    {
        if self.node_count == 0 {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x111),
                FixedString[128]::from_slice("merkle: empty tree")))
        }
        // Root is the last node added
        let root_idx: u32 = self.node_count - 1
        Result::Ok(self.nodes[root_idx as usize])
    }

    // Generate a Merkle proof for a leaf at given index.
    pub fn generate_proof(self, leaf_index: u32) -> Result[MerkleProof, ChainError>
        effects: [deterministic]
    {
        if leaf_index >= self.leaf_count {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x112),
                FixedString[128]::from_slice("merkle: leaf index out of range")))
        }

        let mut proof: MerkleProof = MerkleProof::new()

        let mut index: u32 = leaf_index
        let mut level_start: u32 = 0
        let mut level_count: u32 = self.leaf_count

        // loop: bounds[BOUND_SMALL] — bounded by tree depth
        loop: bounds[BOUND_SMALL] while level_count > 1 {
            let sibling_index: u32 = if index % 2 == 0 {
                index + 1
            } else {
                index - 1
            }

            // Get sibling if it exists
            if sibling_index < level_count {
                let sibling: SHA256Digest = self.nodes[(level_start + sibling_index) as usize]
                let is_left: bool = (index % 2) != 0  // Sibling is left if current is right
                let _ = proof.add_sibling(sibling, is_left)
            }

            // Move to parent level
            let next_count: u32 = (level_count + 1) / 2
            level_start = level_start + level_count
            index = index / 2
            level_count = next_count
        }

        proof
    }

    // Verify a Merkle proof against the root.
    pub fn verify_proof(root: ref SHA256Digest, leaf: ref SHA256Digest, proof: ref MerkleProof) -> bool
        effects: [deterministic, hash]
    {
        let mut computed: SHA256Digest = *leaf

        // loop: bounds[BOUND_SMALL] — bounded by proof size (max 12)
        loop: bounds[BOUND_SMALL] for i in 0..proof.size() {
            let sibling: SHA256Digest = proof.get_sibling(i)
            let is_left: bool = proof.is_sibling_left(i)

            let mut combined: Byte[64] = [Byte::from_u8(0); 64]
            let c_bytes: ref Byte[32] = computed.as_bytes()
            let s_bytes: ref Byte[32] = sibling.as_bytes()

            if is_left {
                // Sibling is on the left: H(sibling || computed)
                // loop: bounds[BOUND_SMALL] — bounded by 32
                loop: bounds[BOUND_SMALL] for j in 0..32 {
                    combined[j as usize] = s_bytes[j as usize]
                    combined[(32 + j) as usize] = c_bytes[j as usize]
                }
            } else {
                // Sibling is on the right: H(computed || sibling)
                // loop: bounds[BOUND_SMALL] — bounded by 32
                loop: bounds[BOUND_SMALL] for j in 0..32 {
                    combined[j as usize] = c_bytes[j as usize]
                    combined[(32 + j) as usize] = s_bytes[j as usize]
                }
            }
            computed = SHA256::hash(&combined, 64)
        }

        SHA256::verify_constant_time(computed, *root)
    }

    // Get the leaf count.
    pub fn leaf_count(self) -> u32
        effects: [deterministic]
    {
        self.leaf_count
    }

    // Get tree depth.
    pub fn depth(self) -> u32
        effects: [deterministic]
    {
        self.depth
    }

    // Get a specific leaf.
    pub fn get_leaf(self, index: u32) -> Result[SHA256Digest, ChainError>
        effects: [deterministic]
    {
        if index >= self.leaf_count {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x113),
                FixedString[128]::from_slice("merkle: leaf index out of range")))
        }
        Result::Ok(self.nodes[index as usize])
    }
}

// ──────────────────────────────────────────────
// Merkle Proof
// ──────────────────────────────────────────────
// Evidence path: HCHAIN-PROOF-001 through HCHAIN-PROOF-030

pub type ProofSibling : struct {
    hash: SHA256Digest,
    is_left: bool,
}

pub type MerkleProof : struct {
    siblings: FixedArray[12, ProofSibling],
    size: u32,
}

impl MerkleProof {
    pub fn new() -> MerkleProof
        effects: [deterministic]
    {
        MerkleProof {
            siblings: FixedArray::new(),
            size: 0,
        }
    }

    pub fn add_sibling(self: ref mut, hash: SHA256Digest, is_left: bool) -> Result[(), ChainError>
        effects: [deterministic]
    {
        if self.size >= MERKLE_MAX_PROOF_SIZE {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x120),
                FixedString[128]::from_slice("merkle proof: max size reached")))
        }
        let sibling: ProofSibling = ProofSibling { hash: hash, is_left: is_left }
        let _ = self.siblings.push(sibling)
        self.size = self.size + 1
        Result::Ok(())
    }

    pub fn size(self) -> u32
        effects: [deterministic]
    {
        self.size
    }

    pub fn get_sibling(self, index: u32) -> SHA256Digest
        effects: [deterministic]
    {
        let sib: ref ProofSibling = self.siblings.ref_at(index)
        sib.hash
    }

    pub fn is_sibling_left(self, index: u32) -> bool
        effects: [deterministic]
    {
        let sib: ref ProofSibling = self.siblings.ref_at(index)
        sib.is_left
    }

    // Serialize proof to bytes.
    pub fn to_bytes(self) -> FixedArray[416, Byte]
        effects: [deterministic]
    {
        let mut bytes: FixedArray[416, Byte] = FixedArray::new()
        let _ = bytes.push(Byte::from_u8(self.size as u8))

        // loop: bounds[BOUND_SMALL] — bounded by proof size
        loop: bounds[BOUND_SMALL] for i in 0..self.size {
            let sib: ref ProofSibling = self.siblings.ref_at(i)
            let hb: ref Byte[32] = sib.hash.as_bytes()
            // loop: bounds[BOUND_SMALL] — bounded by 32
            loop: bounds[BOUND_SMALL] for j in 0..32 {
                let _ = bytes.push(hb[j as usize])
            }
            let _ = bytes.push(if sib.is_left { Byte::from_u8(1) } else { Byte::from_u8(0) })
        }
        bytes
    }

    // Deserialize proof from bytes.
    pub fn from_bytes(bytes: ref Byte[], length: u32) -> Result[MerkleProof, ChainError>
        effects: [deterministic]
    {
        if length < 1 {
            return Result::Err(ChainError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x121),
                FixedString[128]::from_slice("merkle proof: invalid length")))
        }
        let count: u32 = bytes[0].to_u8() as u32
        let mut proof: MerkleProof = MerkleProof::new()

        let mut offset: u32 = 1
        // loop: bounds[BOUND_SMALL] — bounded by max proof size
        loop: bounds[BOUND_SMALL] for i in 0..count {
            if offset + 33 > length {
                return Result::Err(ChainError::new(
                    Word64::from_u64(DIAG_CRYPTO_BASE | 0x122),
                    FixedString[128]::from_slice("merkle proof: truncated data")))
            }
            let mut hash_bytes: Byte[32] = [Byte::from_u8(0); 32]
            // loop: bounds[BOUND_SMALL] — bounded by 32
            loop: bounds[BOUND_SMALL] for j in 0..32 {
                hash_bytes[j as usize] = bytes[(offset + j) as usize]
            }
            let hash: SHA256Digest = SHA256Digest::from_bytes(hash_bytes)
            let is_left: bool = bytes[(offset + 32) as usize].to_u8() != 0
            let _ = proof.add_sibling(hash, is_left)
            offset = offset + 33
        }

        Result::Ok(proof)
    }
}

// ──────────────────────────────────────────────
// Receipt Hash
// ──────────────────────────────────────────────
// Evidence path: HCHAIN-RECEIPT-001 through HCHAIN-RECEIPT-025

pub type ReceiptHash : struct {
    hash: SHA256Digest,
    chain_ref: HashChain,
    merkle_ref: MerkleTree,
    chain_tip: u32,
    merkle_root_idx: u32,
    timestamp: u64,
}

impl ReceiptHash {
    // Create a receipt hash from a hash chain and merkle tree.
    pub fn new(chain: ref HashChain, tree: ref MerkleTree, timestamp: u64) -> Result[ReceiptHash, ChainError]
        effects: [deterministic, hash]
    {
        let chain_tip: SHA256Digest = chain.tip()?
        let merkle_root: SHA256Digest = tree.root()?

        // Combine into a single receipt hash
        let mut combined: Byte[64] = [Byte::from_u8(0); 64]
        let ct_bytes: ref Byte[32] = chain_tip.as_bytes()
        let mr_bytes: ref Byte[32] = merkle_root.as_bytes()
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            combined[i as usize] = ct_bytes[i as usize]
            combined[(32 + i) as usize] = mr_bytes[i as usize]
        }

        let receipt: SHA256Digest = SHA256::hash(&combined, 64)

        Result::Ok(ReceiptHash {
            hash: receipt,
            chain_ref: *chain,
            merkle_ref: *tree,
            chain_tip: chain.len() - 1,
            merkle_root_idx: tree.node_count - 1,
            timestamp: timestamp,
        })
    }

    // Get the receipt hash value.
    pub fn value(self) -> SHA256Digest
        effects: [deterministic]
    {
        self.hash
    }

    // Verify the receipt against chain and merkle state.
    pub fn verify(self, expected: ref SHA256Digest) -> bool
        effects: [deterministic, hash]
    {
        SHA256::verify_constant_time(self.hash, *expected)
    }

    // Recompute and verify.
    pub fn recompute_and_verify(self, chain: ref HashChain, tree: ref MerkleTree) -> bool
        effects: [deterministic, hash]
    {
        let mut combined: Byte[64] = [Byte::from_u8(0); 64]
        let chain_tip: SHA256Digest = chain.tip()??
        let merkle_root: SHA256Digest = tree.root()??
        let ct_bytes: ref Byte[32] = chain_tip.as_bytes()
        let mr_bytes: ref Byte[32] = merkle_root.as_bytes()
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            combined[i as usize] = ct_bytes[i as usize]
            combined[(32 + i) as usize] = mr_bytes[i as usize]
        }
        let recomputed: SHA256Digest = SHA256::hash(&combined, 64)
        SHA256::verify_constant_time(recomputed, self.hash)
    }

    // Get the timestamp.
    pub fn get_timestamp(self) -> u64
        effects: [deterministic]
    {
        self.timestamp
    }
}

// ──────────────────────────────────────────────
// Error Types
// ──────────────────────────────────────────────

pub type ChainError : struct {
    code: Word64,
    message: FixedString[128],
}

impl ChainError {
    pub fn new(code: Word64, message: FixedString[128]) -> ChainError
        effects: [deterministic]
    {
        ChainError { code: code, message: message }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.message
    }
}

// ──────────────────────────────────────────────
// Test Vectors
// ──────────────────────────────────────────────
// Evidence path: HCHAIN-TEST-001 through HCHAIN-TEST-035

pub fn run_hash_chain_test_vectors() -> bool
    effects: [deterministic, hash, residual]
{
    // Test hash chain
    let seed: SHA256Digest = SHA256::hash(&[Byte::from_u8(0x01)], 1)
    let mut chain: HashChain = HashChain::new(&seed)
    assert(chain.len() == 1, "hashchain: initial length is 1")

    let data1: Byte[4] = [Byte::from_u8(0x61), Byte::from_u8(0x62), Byte::from_u8(0x63), Byte::from_u8(0x64)]
    let _ = chain.extend(&data1, 4)
    assert(chain.len() == 2, "hashchain: extended to length 2")

    let data2: Byte[3] = [Byte::from_u8(0x65), Byte::from_u8(0x66), Byte::from_u8(0x67)]
    let _ = chain.extend(&data2, 3)
    assert(chain.len() == 3, "hashchain: extended to length 3")

    let tip: SHA256Digest = chain.tip()?
    assert(true, "hashchain: tip retrievable")

    // Verify chain integrity
    let chain_ok: bool = chain.verify_chain(&seed)
    assert(chain_ok, "hashchain: chain verification succeeds")

    // Incremental hash chain
    let mut inc_chain: IncrementalHashChain = IncrementalHashChain::new(&seed)
    inc_chain.absorb(&data1, 4)
    inc_chain.absorb(&data2, 3)
    assert(inc_chain.count() == 2, "hashchain: incremental count is 2")

    let inc_hash: SHA256Digest = inc_chain.current_hash()
    assert(true, "hashchain: incremental hash produced")

    // Merkle tree
    let leaf1: SHA256Digest = SHA256::hash(&[Byte::from_u8(0x01)], 1)
    let leaf2: SHA256Digest = SHA256::hash(&[Byte::from_u8(0x02)], 1)
    let leaf3: SHA256Digest = SHA256::hash(&[Byte::from_u8(0x03)], 1)
    let leaf4: SHA256Digest = SHA256::hash(&[Byte::from_u8(0x04)], 1)

    let leaves: FixedArray[4, SHA256Digest] = FixedArray::from_raw(
        [leaf1, leaf2, leaf3, leaf4], 4)?

    let tree: MerkleTree = MerkleTree::build(&leaves.data[0..4], 4)?
    let root: SHA256Digest = tree.root()?
    assert(tree.leaf_count() == 4, "merkle: 4 leaves")
    assert(tree.depth() >= 2, "merkle: depth >= 2")

    // Generate and verify proof for leaf 0
    let proof0: MerkleProof = tree.generate_proof(0)?
    let verify0: bool = MerkleTree::verify_proof(&root, &leaf1, &proof0)
    assert(verify0, "merkle: proof for leaf 0 verifies")

    // Generate and verify proof for leaf 2
    let proof2: MerkleProof = tree.generate_proof(2)?
    let verify2: bool = MerkleTree::verify_proof(&root, &leaf3, &proof2)
    assert(verify2, "merkle: proof for leaf 2 verifies")

    // Invalid proof should fail
    let bad_leaf: SHA256Digest = SHA256::hash(&[Byte::from_u8(0xFF)], 1)
    let bad_verify: bool = MerkleTree::verify_proof(&root, &bad_leaf, &proof0)
    assert(!bad_verify, "merkle: invalid leaf fails verification")

    // Proof serialization round-trip
    let proof_bytes: FixedArray[416, Byte] = proof0.to_bytes()
    let deserialized: MerkleProof = MerkleProof::from_bytes(&proof_bytes.data[0..proof_bytes.len()], proof_bytes.len())?
    let verify_deser: bool = MerkleTree::verify_proof(&root, &leaf1, &deserialized)
    assert(verify_deser, "merkle: serialized proof round-trip verifies")

    // Receipt hash
    let receipt: ReceiptHash = ReceiptHash::new(&chain, &tree, 12345678)?
    let receipt_val: SHA256Digest = receipt.value()
    let receipt_ok: bool = receipt.verify(&receipt_val)
    assert(receipt_ok, "receipt: self-verification succeeds")

    let recompute_ok: bool = receipt.recompute_and_verify(&chain, &tree)
    assert(recompute_ok, "receipt: recompute and verify succeeds")

    // Odd leaf count test
    let leaves3: FixedArray[3, SHA256Digest] = FixedArray::from_raw([leaf1, leaf2, leaf3], 3)?
    let tree3: MerkleTree = MerkleTree::build(&leaves3.data[0..3], 3)?
    let root3: SHA256Digest = tree3.root()?
    assert(tree3.leaf_count() == 3, "merkle: 3 leaves tree built")

    let proof3_0: MerkleProof = tree3.generate_proof(0)?
    let verify3_0: bool = MerkleTree::verify_proof(&root3, &leaf1, &proof3_0)
    assert(verify3_0, "merkle: proof for odd-count tree verifies")

    // Chain reset
    let new_seed: SHA256Digest = SHA256::hash(&[Byte::from_u8(0xFF)], 1)
    chain.reset(&new_seed)
    assert(chain.len() == 1, "hashchain: reset chain length is 1")
    assert(chain.verify_chain(&new_seed), "hashchain: reset chain verifies")

    // Verify chain link individually
    let mut chain2: HashChain = HashChain::new(&leaf1)
    let _ = chain2.extend(&data1, 4)
    let _ = chain2.extend(&data2, 3)
    assert(chain2.verify_link(1), "hashchain: link 1 verified")
    assert(chain2.verify_link(2), "hashchain: link 2 verified")
    assert(!chain2.verify_link(0), "hashchain: link 0 (seed) not verifiable as link")
    assert(!chain2.verify_link(5), "hashchain: out-of-range link fails")

    // Empty merkle tree edge case
    let empty_result: Result[MerkleTree, ChainError] = MerkleTree::build(&leaves.data[0..0], 0)
    match empty_result {
        Result::Ok(_) => assert(false, "merkle: empty leaf count should fail"),
        Result::Err(_) => assert(true, "merkle: empty leaves rejected"),
    }

    // Single leaf merkle tree
    let single_leaves: FixedArray[1, SHA256Digest] = FixedArray::from_raw([leaf1], 1)?
    let single_tree: MerkleTree = MerkleTree::build(&single_leaves.data[0..1], 1)?
    let single_root: SHA256Digest = single_tree.root()?
    assert(SHA256::verify_constant_time(single_root, leaf1), "merkle: single leaf root = leaf")

    // Proof for single leaf
    let single_proof: MerkleProof = single_tree.generate_proof(0)?
    assert(single_proof.size() == 0, "merkle: single leaf proof size 0")
    let single_verify: bool = MerkleTree::verify_proof(&single_root, &leaf1, &single_proof)
    assert(single_verify, "merkle: single leaf proof verifies")

    // Hash chain is_empty check
    assert(!chain.is_empty(), "hashchain: chain not empty after adding")

    // Incremental chain final value verification
    let mut inc_chain2: IncrementalHashChain = IncrementalHashChain::new(&seed)
    inc_chain2.absorb(&data1, 4)
    inc_chain2.absorb(&data2, 3)
    let inc_final: SHA256Digest = inc_chain2.current_hash()
    assert(inc_chain2.verify_chain(&inc_final), "hashchain: incremental self-verify")

    // Receipt timestamp
    let receipt2: ReceiptHash = ReceiptHash::new(&chain2, &tree, 98765432)?
    assert(receipt2.get_timestamp() == 98765432, "receipt: timestamp stored correctly")

    residual emit {
        op: "hash_chain.test_vectors",
        chain_extend: true,
        chain_verify: chain_ok,
        incremental: true,
        merkle_build: true,
        proof_verify_0: verify0,
        proof_verify_2: verify2,
        bad_proof: bad_verify,
        proof_serde: verify_deser,
        receipt: receipt_ok,
        recompute: recompute_ok,
        odd_count: verify3_0,
        chain_reset: true,
        link_verify: true,
        empty_tree_rejected: true,
        single_leaf: true,
        incremental_self: true,
        receipt_timestamp: true,
    }

    true
}
