// hda_audio_full.phor — HD Audio full driver
// CORB/RIRB, DMA engines (PCM input/output), converter management,
// widget power state, audio function group, amplitude/mute controls,
// unsolicited responses, HDMI audio (infoframe, ELD), codec probing.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/hda_audio_full.phor
// Court: hda_audio_full_driver:v2

package drivers.hda_audio_full;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type HdaAudioError = enum {
    HdaNotInitialized           = 0xE00,
    HdaControllerNotFound       = 0xE01,
    HdaCodecNotFound            = 0xE02,
    HdaCodecNotResponding       = 0xE03,
    HdaCorbFull                 = 0xE04,
    HdaRirbEmpty                = 0xE05,
    HdaDmaError                 = 0xE06,
    HdaConverterError           = 0xE07,
    HdaWidgetError              = 0xE08,
    HdaFormatNotSupported       = 0xE09,
    HdaAmpError                 = 0xE0A,
    HdaMuteError                = 0xE0B,
    HdaUnsolicitedError         = 0xE0C,
    HdaHdmiInfoframeError       = 0xE0D,
    HdaEldError                 = 0xE0E,
    HdaPowerStateError          = 0xE0F,
    HdaCapabilityError          = 0xE10,
    HdaCodecProbeFailed         = 0xE11,
    HdaPcmOpenError             = 0xE12,
    HdaMaxDevicesExceeded       = 0xE13,
    HdaResidualStoreFull        = 0xE14,
    HdaCorruptionDetected       = 0xE15,
    HdaInvalidNode              = 0xE16,
    HdaNoDmaEngine              = 0xE17,
}

// ─────────────────────────────────────────────────────────────
// HD Audio Full Capability
// ─────────────────────────────────────────────────────────────

struct HdaAudioCapability {
    object_id: Identity,
    generation: u64,
    can_init: bool,
    can_pcm: bool,
    can_hdmi: bool,
    can_amplifier: bool,
    can_power: bool,
    can_unsolicited: bool,
    can_codec_probe: bool,
    max_streams: u64,
}

// ─────────────────────────────────────────────────────────────
// HD Audio Register Offsets (MMIO)
// ─────────────────────────────────────────────────────────────

struct HdaRegisters {
    mmio_base: u64,
}

impl HdaRegisters {
    fn gc_offset() -> u64 { return 0x08; }
    fn intctl_offset() -> u64 { return 0x20; }
    fn intsts_offset() -> u64 { return 0x24; }
    fn wallclk_offset() -> u64 { return 0x30; }
    fn sdma_stream_base(stream: u64) -> u64 { return 0x80 + stream * 0x20; }
    fn corb_base_offset() -> u64 { return 0x40; }
    fn corbwp_offset() -> u64 { return 0x48; }
    fn corbrp_offset() -> u64 { return 0x4A; }
    fn corbctl_offset() -> u64 { return 0x4C; }
    fn corbsts_offset() -> u64 { return 0x4D; }
    fn corbsize_offset() -> u64 { return 0x4E; }
    fn rirbbase_offset() -> u64 { return 0x50; }
    fn rirbwp_offset() -> u64 { return 0x58; }
    fn rirbwp_hi_offset() -> u64 { return 0x5A; }
    fn rirbintcnt_offset() -> u64 { return 0x5C; }
    fn rirbctl_offset() -> u64 { return 0x5D; }
    fn rirbsts_offset() -> u64 { return 0x5E; }
    fn rirbsize_offset() -> u64 { return 0x5F; }
    fn statesave_offset() -> u64 { return 0x60; }
    fn wakeen_offset() -> u64 { return 0x70; }
    fn statests_offset() -> u64 { return 0x74; }
    fn sdiowakeen_offset() -> u64 { return 0x78; }

    fn read8(self, offset: u64) -> u8
        effect [memory:mmio]
    {
        return trusted reason "HD Audio MMIO 8-bit register read, HDA Spec §3.3" {
            let ptr: *(u8) = (self.mmio_base + offset) as *(u8);
            return *ptr;
        };
    }

    fn read16(self, offset: u64) -> u16
        effect [memory:mmio]
    {
        return trusted reason "HD Audio MMIO 16-bit register read" {
            let ptr: *(u16) = (self.mmio_base + offset) as *(u16);
            return *ptr;
        };
    }

    fn read32(self, offset: u64) -> u32
        effect [memory:mmio]
    {
        return trusted reason "HD Audio MMIO 32-bit register read" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            return *ptr;
        };
    }

    fn write8(self, offset: u64, value: u8) -> void
        effect [memory:mmio]
    {
        trusted reason "HD Audio MMIO 8-bit register write" {
            let ptr: *(u8) = (self.mmio_base + offset) as *(u8);
            *ptr = value;
        };
    }

    fn write16(self, offset: u64, value: u16) -> void
        effect [memory:mmio]
    {
        trusted reason "HD Audio MMIO 16-bit register write" {
            let ptr: *(u16) = (self.mmio_base + offset) as *(u16);
            *ptr = value;
        };
    }

    fn write32(self, offset: u64, value: u32) -> void
        effect [memory:mmio]
    {
        trusted reason "HD Audio MMIO 32-bit register write" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            *ptr = value;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// HD Audio Stream Descriptor
// ─────────────────────────────────────────────────────────────

struct HdaStreamDesc {
    stream_id: u8,
    stream_type: HdaStreamType,
    bdl_phys: u64,
    bdl_size: u16,
    lvi: u32,
    ctl: u32,
    sts: u8,
    link_position: u16,
    fifo_size: u16,
    fifo_write_ptr: u16,
    format: u16,
    buffer_size: u32,
    flags: HdaStreamFlags,
}

type HdaStreamType = enum {
    PcmOutput = 0,
    PcmInput  = 1,
    BdlOutput = 2,
    BdlInput  = 3,
}

struct HdaStreamFlags {
    active: bool,
    running: bool,
    interrupt_on_completion: bool,
    stripe: u8,
    dma_descriptor_type: u8,
    traffic_priority: bool,
}

// ─────────────────────────────────────────────────────────────
// CORB (Command Output Ring Buffer) Entry
// ─────────────────────────────────────────────────────────────

struct HdaCorbEntry {
    verb: u32,
    cad: u8,
    node_id: u16,
    payload: u16,
}

// ─────────────────────────────────────────────────────────────
// RIRB (Response Input Ring Buffer) Entry
// ─────────────────────────────────────────────────────────────

struct HdaRirbEntry {
    response: u32,
    response_ex: u32,
    unsolicited: bool,
    sd_id: u8,
}

// ─────────────────────────────────────────────────────────────
// HDA Codec Node / Widget
// ─────────────────────────────────────────────────────────────

type HdaWidgetType = enum {
    AudioFunctionGroup  = 0x00,
    AudioOutput         = 0x01,
    AudioInput          = 0x02,
    AudioMixer          = 0x03,
    AudioSelector       = 0x04,
    PinComplex          = 0x05,
    PowerWidget         = 0x06,
    VolumeKnob          = 0x07,
    BeepGenerator       = 0x08,
    VendorDefined       = 0x0F,
    UnknownWidget       = 0xFF,
}

// ─────────────────────────────────────────────────────────────
// Audio Function Group
// ─────────────────────────────────────────────────────────────

struct HdaFunctionGroup {
    node_id: u16,
    vendor_id: u32,
    revision_id: u32,
    widget_count: u8,
    widget_start: u16,
    widgets: Array(HdaWidget, 32),
    default_pcm: u8,
    default_stream_tag: u8,
    gpio_count: u8,
    supp_rates: u16,
    supp_bit_depths: u16,
    supp_formats: u16,
}

// ─────────────────────────────────────────────────────────────
// Widget State
// ─────────────────────────────────────────────────────────────

struct HdaWidget {
    node_id: u16,
    widget_type: HdaWidgetType,
    capabilities: u32,
    amp_in_cap: u32,
    amp_out_cap: u32,
    pcm_cap: u32,
    pin_cap: u32,
    volume: u32,
    mute: bool,
    power_state: HdaPowerState,
    connected_nodes: Array(u16, 8),
    conn_count: u8,
    conn_idx: u8,
    eapd_btl: bool,
    dp_mst_count: u8,
    converter_stream: u8,
    converter_channel: u8,
    unsol_capable: bool,
    unsol_enabled: bool,
}

type HdaPowerState = enum {
    D0  = 0,
    D1  = 1,
    D2  = 2,
    D3  = 3,
    D3Cold = 4,
}

// ─────────────────────────────────────────────────────────────
// Audio Format
// ─────────────────────────────────────────────────────────────

struct HdaAudioFormat {
