  console_handle: u32,
  mode: u32,
] -> bool : effect:(unsafe)
  loop: bounded(1)
{
  return true;
}

/// Write to the console.
pub fn win32_write_console[
  console_handle: u32,
  buffer: *u8,
  chars_to_write: u32,
  chars_written: *u32,
  reserved: *u8,
] -> bool : effect:(io, unsafe)
  loop: bounded(1)
{
  if chars_written != null {
    chars_written = chars_to_write;
  }
  record_win32_residual(Win32Op::ConsoleWrite, console_handle as u64, chars_to_write as u64);
  return true;
}

/// Read from the console.
