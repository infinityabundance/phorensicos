//==============================================================================
// device_virt.phor — Device Virtualization
//
// Provides emulated devices (PIC, PIT, RTC, UART), virtio-mmio device
// backend, interrupt injection, DMA remapping, PCIe pass-through with
// IOMMU, and device hotplug.
//
// All operations are capability-gated, bounded-loop, and residual-recorded.
//==============================================================================

module device_virt
  @[receipt("dev-virt-v1")]
  @[audit("DEV-VIRT")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{syscall, alloc, unsafe, io};
use core::residual::*;
use core::mem::*;
use hypervisor::vcpu::*;
use hypervisor::memory_virt::*;

//==============================================================================
// Emulated Device Base
//==============================================================================

/// Base device structure for all emulated devices.
pub struct EmulatedDevice(
  device_type: DeviceType,
  device_id: u64,
  vm_id: u64,
  mmio_base: u64,
  mmio_size: u32,
  irq_line: u32,
  cap_token: u64,
  is_plugged: bool,
  generation: u64,
) : effect:(alloc, unsafe);

pub enum DeviceType : u8 {
  PIC       = 0,   // 8259 Programmable Interrupt Controller
  PIT       = 1,   // 8254 Programmable Interval Timer
  RTC       = 2,   // MC146818 Real-Time Clock
  UART      = 3,   // 16550 UART
  VirtioMMIO = 4,  // Virtio over MMIO transport
  PCIe      = 5,   // PCI Express device
  IOAPIC    = 6,   // I/O APIC
  HPET      = 7,   // High Precision Event Timer
  ACPI      = 8,   // ACPI controller
  SMBus     = 9,   // System Management Bus
  PS2Kbd    = 10,  // PS/2 Keyboard
  PS2Mouse  = 11,  // PS/2 Mouse
  VGA       = 12,  // VGA-compatible display
  XHCI      = 13,  // USB 3.0 controller
  AHCI      = 14,  // SATA controller
  NVMe      = 15,  // NVMe storage
  VirtioBlk = 16,  // Virtio block device
  VirtioNet = 17,  // Virtio network device
  VirtioConsole = 18, // Virtio console
}

//==============================================================================
// 8259 PIC (Programmable Interrupt Controller)
//==============================================================================

/// PIC state (two cascaded 8259s).
pub struct PicState(
  irq_base: u32,
  irq_count: u32,
  imr: u8,           // Interrupt Mask Register
  irr: u8,           // Interrupt Request Register
  isr: u8,           // In-Service Register
  icw: [u8; 4],      // Initialization Command Words
  ocw: [u8; 3],      // Operation Command Words
  auto_eoi: bool,
  read_reg_select: bool,
  poll: bool,
  special_mask: bool,
  cascade: bool,
  slave_id: u8,
  elcr: u8,          // Edge/Level Control Register
  base_dev: EmulatedDevice,
) : effect:(alloc, unsafe);

/// Initialize PIC state.
pub fn pic_init[
  vm_id: u64,
  irq_base: u32,
  cap_token: u64,
] -> *PicState : effect:(alloc, unsafe) {
  let pic: *PicState = @alloc(PicState);
  pic.irq_base = irq_base;
  pic.irq_count = 8;
  pic.imr = 0xFF;    // all masked
  pic.irr = 0;
  pic.isr = 0;
  pic.auto_eoi = false;
  pic.read_reg_select = false;
  pic.poll = false;
  pic.special_mask = false;
  pic.cascade = false;
  pic.slave_id = 0xFF;
  pic.elcr = 0;
  pic.base_dev = EmulatedDevice(
    device_type: DeviceType::PIC,
    device_id: 0, vm_id: vm_id,
    mmio_base: 0x20, mmio_size: 2, irq_line: 0,
    cap_token: cap_token, is_plugged: true,
    generation: 1,
  );
  return pic;
}

/// PIC I/O read handler.
pub fn pic_ioread[
  pic: *PicState,
  offset: u32,
  size: u32,
] -> u32 : effect:(unsafe)
  loop: bounded(1)
{
  match offset {
    0 => {
      // Read IRR (if read_reg_select == 0) or ISR (if == 1)
      if pic.read_reg_select {
        return pic.isr as u32;
      }
      return pic.irr as u32;
    },
    1 => {
      return pic.imr as u32;
    },
    _ => return 0,
  }
}

/// PIC I/O write handler.
pub fn pic_iowrite[
  pic: *PicState,
  offset: u32,
  size: u32,
  value: u32,
] : effect:(unsafe)
  loop: bounded(1)
{
  match offset {
    0 => {
      // ICW1 or OCW2/OCW3 depending on context
      if value & 0x10 != 0 {
        // ICW1
        pic.icw[0] = value as u8;
        pic.read_reg_select = false;
        pic.poll = false;
      } else if value & 0x08 != 0 {
        // OCW3
        pic.ocw[2] = value as u8;
        pic.read_reg_select = value & 0x02 != 0;
        pic.poll = value & 0x04 != 0;
        pic.special_mask = value & 0x20 != 0;
      } else {
        // OCW2
        pic.ocw[1] = value as u8;
        let command: u8 = (value >> 5) & 7;
        let irq: u8 = value & 7;
        match command {
          0 => {},  // NOP
          1 => { pic.isr &= !(1 << irq); },  // Non-specific EOI
          2 => {},  // Specific EOI
          3 => { pic.isr &= !(1 << irq); pic.irr &= !(1 << irq); }, // Rotate on non-specific EOI
          _ => {},
        }
      }
    },
    1 => {
      if value & 0x80 != 0 {
        // ICW2
        pic.icw[1] = value as u8;
        pic.irq_base = (value as u32) & 0xF8;
      } else if value & 0x40 != 0 {
        // ICW3
        pic.icw[2] = value as u8;
        if pic.cascade {
          pic.slave_id = value as u8;
        }
      } else if value & 0x10 != 0 {
        // ICW4
        pic.icw[3] = value as u8;
        pic.auto_eoi = value & 0x02 != 0;
      } else {
        // OCW1 — set IMR
        pic.imr = value as u8;
      }
    },
    _ => {},
  }
}

/// Assert an IRQ line on the PIC.
pub fn pic_assert_irq[
  pic: *PicState,
  irq: u8,
] : effect:(unsafe)
  loop: bounded(1)
{
  if irq > 7 { return; }
  pic.irr |= 1 << irq;
  record_device_residual(DevOp::PicAssert, irq as u64, 0);
}

/// Read the highest-priority pending interrupt from the PIC.
pub fn pic_acknowledge[
  pic: *PicState,
] -> u32 : effect:(pure)
  loop: bounded(8)
{
  let pending: u8 = pic.irr & !pic.imr;
  if pending == 0 {
    return 0;  // spurious interrupt
  }

  for var i: u32 = 0; i < 8; i += 1 {
    if (pending & (1 << i)) != 0 {
      pic.irr &= !(1 << i);
      if !pic.auto_eoi {
        pic.isr |= 1 << i;
      }
      return pic.irq_base + i;
    }
  }

  return 0;
}

//==============================================================================
// 8254 PIT (Programmable Interval Timer)
//==============================================================================

/// PIT channel state.
pub struct PitChannel(
  mode: u8,
  counter: u16,
  reload_value: u16,
  gate: bool,
  output: bool,
  bcd: bool,
  null_count: bool,
  latch_value: u16,
  latch_valid: bool,
) : effect:(pure);

/// PIT state.
pub struct PitState(
  channels: [PitChannel; 3],
  speaker_data: bool,
  counter_outputs: [bool; 3],
  base_dev: EmulatedDevice,
) : effect:(alloc, unsafe);

/// Initialize PIT.
pub fn pit_init[
  vm_id: u64,
  cap_token: u64,
] -> *PitState : effect:(alloc, unsafe) {
  let pit: *PitState = @alloc(PitState);
  pit.channels = Default;
  pit.channels[0] = PitChannel(mode: 3, counter: 0, reload_value: 0, gate: true, output: false, bcd: false, null_count: true, latch_value: 0, latch_valid: false);
  pit.channels[1] = PitChannel(mode: 2, counter: 0, reload_value: 0, gate: true, output: false, bcd: false, null_count: true, latch_value: 0, latch_valid: false);
  pit.channels[2] = PitChannel(mode: 0, counter: 0, reload_value: 0, gate: true, output: false, bcd: false, null_count: true, latch_value: 0, latch_valid: false);
  pit.speaker_data = false;
  pit.counter_outputs = Default;
  pit.base_dev = EmulatedDevice(device_type: DeviceType::PIT, device_id: 1, vm_id: vm_id, mmio_base: 0x40, mmio_size: 4, irq_line: 0, cap_token: cap_token, is_plugged: true, generation: 1);
  return pit;
}

/// Tick the PIT (called periodically).
pub fn pit_tick[
  pit: *PitState,
  delta: u64,
] : effect:(unsafe)
  loop: bounded(3)
{
  for var i: u32 = 0; i < 3; i += 1 {
    let ch: *PitChannel = &pit.channels[i];
    if ch.counter > 0 {
      ch.counter -= if delta < ch.counter as u64 { delta as u16 } else { ch.counter };
    }
    if ch.counter == 0 && !ch.null_count {
      match ch.mode {
        0 => { ch.output = true; },  // Interrupt on terminal count
        2 => { ch.counter = ch.reload_value; ch.output = true; },  // Rate generator
        3 => { ch.counter = ch.reload_value; ch.output = !ch.output; },  // Square wave
        _ => {},
      }
      if i == 0 {
        // Channel 0 triggers IRQ 0
        pit.counter_outputs[0] = true;
        record_device_residual(DevOp::PitIrq, 0, ch.counter as u64);
      }
    }
  }
}

//==============================================================================
// MC146818 RTC (Real-Time Clock)
//==============================================================================

/// RTC state.
pub struct RtcState(
  seconds: u8,
  minutes: u8,
  hours: u8,
  day_of_week: u8,
  day_of_month: u8,
  month: u8,
  year: u8,
  century: u8,
  status_a: u8,
  status_b: u8,
  status_c: u8,
  status_d: u8,
  register_a: u8,
  register_b: u8,
  register_c: u8,
  register_d: u8,
  cmos_data: [u8; 128],
  current_index: u8,
  is_update_in_progress: bool,
  bcd_mode: bool,
  hour_format_24: bool,
  base_dev: EmulatedDevice,
) : effect:(alloc);

/// Initialize RTC.
pub fn rtc_init[
  vm_id: u64,
  cap_token: u64,
] -> *RtcState : effect:(alloc) {
  let rtc: *RtcState = @alloc(RtcState);
  rtc.seconds = 0;
  rtc.minutes = 0;
  rtc.hours = 0;
  rtc.day_of_week = 1;
  rtc.day_of_month = 1;
  rtc.month = 1;
  rtc.year = 24;
  rtc.century = 20;
  rtc.status_a = 0x26;
  rtc.status_b = 0x02;
  rtc.status_c = 0;
  rtc.status_d = 0x80;
  rtc.is_update_in_progress = false;
  rtc.bcd_mode = true;
  rtc.hour_format_24 = true;
  rtc.base_dev = EmulatedDevice(device_type: DeviceType::RTC, device_id: 2, vm_id: vm_id, mmio_base: 0x70, mmio_size: 2, irq_line: 8, cap_token: cap_token, is_plugged: true, generation: 1);
  return rtc;
}

/// Read RTC register.
pub fn rtc_read[
  rtc: *RtcState,
  index: u8,
] -> u8 : effect:(pure)
  loop: bounded(1)
{
  // Return time data based on selected index
  match index {
    0x00 => rtc.seconds,
    0x02 => rtc.minutes,
    0x04 => rtc.hours,
    0x06 => rtc.day_of_week,
    0x07 => rtc.day_of_month,
    0x08 => rtc.month,
    0x09 => rtc.year,
    0x32 => rtc.century,
    0x0A => rtc.status_a,
    0x0B => rtc.status_b,
    0x0C => { rtc.status_c = 0x00; rtc.status_c },  // Clear on read
    0x0D => rtc.status_d,
    _ => {
      if index < 128 { rtc.cmos_data[index] } else { 0 }
    },
  }
}

/// Write RTC register.
pub fn rtc_write[
  rtc: *RtcState,
  index: u8,
  value: u8,
] : effect:(unsafe)
  loop: bounded(1)
{
  match index {
    0x00 => rtc.seconds = value,
    0x02 => rtc.minutes = value,
    0x04 => rtc.hours = value,
    0x06 => rtc.day_of_week = value,
    0x07 => rtc.day_of_month = value,
    0x08 => rtc.month = value,
    0x09 => rtc.year = value,
    0x32 => rtc.century = value,
    0x0A => { rtc.status_a = value & 0x7F; },
    0x0B => { rtc.status_b = value; },
    0x0C => { rtc.status_c = 0; },
    0x0D => { rtc.status_d = value; },
    _ => {
      if index < 128 { rtc.cmos_data[index] = value; }
    },
  }
}

//==============================================================================
// 16550 UART
//==============================================================================

/// UART state.
pub struct UartState(
  data: u8,
  interrupt_enable: u8,
  fifo_control: u8,
  line_control: u8,
  modem_control: u8,
  line_status: u8,
  modem_status: u8,
  scratch: u8,
  divisor_low: u8,
  divisor_high: u8,
  dlab: bool,
  fifo_enabled: bool,
  fifo: [u8; 16],
  fifo_pos: u32,
  fifo_count: u32,
  irq_pending: bool,
  base_dev: EmulatedDevice,
) : effect:(alloc, unsafe);

/// Initialize UART.
pub fn uart_init[
  vm_id: u64,
  cap_token: u64,
] -> *UartState : effect:(alloc, unsafe) {
  let uart: *UartState = @alloc(UartState);
  uart.data = 0;
  uart.interrupt_enable = 0;
  uart.fifo_control = 0;
  uart.line_control = 0x03;  // 8N1
  uart.modem_control = 0;
  uart.line_status = 0x60;   // TEMT + THRE
  uart.modem_status = 0xB0;
  uart.scratch = 0;
  uart.dlab = false;
  uart.fifo_enabled = false;
  uart.fifo = Default;
  uart.fifo_pos = 0;
  uart.fifo_count = 0;
  uart.irq_pending = false;
  uart.base_dev = EmulatedDevice(device_type: DeviceType::UART, device_id: 3, vm_id: vm_id, mmio_base: 0x3F8, mmio_size: 8, irq_line: 4, cap_token: cap_token, is_plugged: true, generation: 1);
  return uart;
}

/// Write to UART.
pub fn uart_write[
  uart: *UartState,
  offset: u32,
  value: u8,
] : effect:(io, unsafe)
  loop: bounded(1)
{
  match offset {
    0 => {
      if uart.dlab {
        uart.divisor_low = value;
      } else {
        // THR — transmit holding register
        uart.data = value;
        uart.line_status |= 0x20;  // THRE
        // In production, emit to console/compat layer
        __uart_console_write(value);
        record_device_residual(DevOp::UartWrite, value as u64, 0);
      }
    },
    1 => {
      if uart.dlab {
        uart.divisor_high = value;
      } else {
        uart.interrupt_enable = value & 0x0F;
      }
    },
    2 => {
      uart.fifo_control = value;
      uart.fifo_enabled = (value & 0x01) != 0;
      if value & 0x02 != 0 {
        uart.fifo_count = 0;
        uart.fifo_pos = 0;
      }
    },
    3 => {
      uart.line_control = value;
      uart.dlab = (value & 0x80) != 0;
    },
    4 => {
      uart.modem_control = value & 0x1F;
    },
    5 => { /* No-op */ },
    6 => { /* No-op */ },
    7 => {
      uart.scratch = value;
    },
    _ => {},
  }
}

/// Read from UART.
pub fn uart_read[
  uart: *UartState,
  offset: u32,
] -> u8 : effect:(pure)
  loop: bounded(1)
{
  match offset {
    0 => {
      if uart.dlab { return uart.divisor_low; }
      // RBR — receiver buffer register
      if uart.fifo_enabled && uart.fifo_count > 0 {
        let val: u8 = uart.fifo[uart.fifo_pos];
        uart.fifo_pos = (uart.fifo_pos + 1) % 16;
        uart.fifo_count -= 1;
        if uart.fifo_count == 0 {
          uart.line_status &= !0x01;  // Clear DR
        }
        return val;
      }
      let val: u8 = uart.data;
      uart.line_status &= !0x01;  // Clear DR
      return val;
    },
    1 => {
      if uart.dlab { return uart.divisor_high; }
      return uart.interrupt_enable;
    },
    2 => {
      // IIR — interrupt identification
      if uart.irq_pending { return 0x02; }  // THR empty
      return 0x01;  // No interrupt
    },
    3 => return uart.line_control,
    4 => return uart.modem_control,
    5 => return uart.line_status,
    6 => return uart.modem_status,
    7 => return uart.scratch,
    _ => return 0,
  }
}

//==============================================================================
// Virtio-MMIO Device
//==============================================================================

/// Virtio MMIO transport registers.
pub struct VirtioMmioDevice(
  magic_value: u32,          // 0x74726976 ("virt")
  version: u32,              // 2 for modern virtio
  device_id: u32,
  vendor_id: u32,
  host_features: u64,
  guest_features: u64,
  queue_address: u64,
  queue_size: u16,
  queue_sel: u16,
  queue_notify: u16,
  interrupt_status: u8,
  device_status: u8,
  config_generation: u8,
  config_space: [u8; 256],
  irq_line: u32,
  queues: [VirtQueue; 16],
  num_queues: u32,
  driver_notified: bool,
  base_dev: EmulatedDevice,
) : effect:(alloc, unsafe);

/// VirtIO queue descriptor.
pub struct VirtQueue(
  desc_table: u64,
  avail_ring: u64,
  used_ring: u64,
  size: u16,
  last_idx: u16,
  enabled: bool,
) : effect:(pure);

/// Initialize a virtio-mmio device.
pub fn virtio_mmio_init[
  vm_id: u64,
  device_id: u32,
  vendor_id: u32,
  mmio_base: u64,
  irq_line: u32,
  cap_token: u64,
] -> *VirtioMmioDevice : effect:(alloc, unsafe) {
  let dev: *VirtioMmioDevice = @alloc(VirtioMmioDevice);
  dev.magic_value = 0x74726976;
  dev.version = 2;
  dev.device_id = device_id;
  dev.vendor_id = vendor_id;
  dev.host_features = 0;
  dev.guest_features = 0;
  dev.queue_address = 0;
  dev.queue_size = 0;
  dev.queue_sel = 0;
  dev.queue_notify = 0;
  dev.interrupt_status = 0;
  dev.device_status = 0;
  dev.config_generation = 0;
  dev.irq_line = irq_line;
  dev.queues = Default;
  dev.num_queues = 0;
  dev.driver_notified = false;
  dev.base_dev = EmulatedDevice(device_type: DeviceType::VirtioMMIO, device_id: device_id as u64, vm_id: vm_id, mmio_base: mmio_base, mmio_size: 0x200, irq_line: irq_line, cap_token: cap_token, is_plugged: true, generation: 1);
  return dev;
}

/// Handle virtio-mmio read.
pub fn virtio_mmio_read[
  dev: *VirtioMmioDevice,
  offset: u32,
  size: u32,
] -> u64 : effect:(pure)
  loop: bounded(1)
{
  match offset {
    0x00 => dev.magic_value as u64,
    0x04 => dev.version as u64,
    0x08 => dev.device_id as u64,
    0x0C => dev.vendor_id as u64,
    0x10 => dev.host_features,
    0x14 => dev.host_features >> 32,
    0x20 => dev.guest_features,
    0x24 => dev.guest_features >> 32,
    0x30 => dev.queue_address,
    0x34 => dev.queue_address >> 32,
    0x38 => dev.queue_size as u64,
    0x3C => dev.queue_sel as u64,
    0x40 => dev.queue_notify as u64,
    0x44 => dev.interrupt_status as u64,
    0x48 => dev.device_status as u64,
    0x4C => dev.config_generation as u64,
    _ => {
      if offset >= 0x50 && offset < 0x50 + 256 {
        dev.config_space[(offset - 0x50) as u32] as u64
      } else {
        0
      }
    },
  }
}

/// Handle virtio-mmio write.
pub fn virtio_mmio_write[
  dev: *VirtioMmioDevice,
  offset: u32,
  size: u32,
  value: u64,
  vcpu: *Vcpu,
] : effect:(syscall, unsafe)
  loop: bounded(1)
{
  match offset {
    0x20 => { dev.guest_features = (dev.guest_features & 0xFFFFFFFF00000000) | value; },
    0x24 => { dev.guest_features = (dev.guest_features & 0xFFFFFFFF) | (value << 32); },
    0x30 => { dev.queue_address = (dev.queue_address & 0xFFFFFFFF00000000) | value; },
    0x34 => { dev.queue_address = (dev.queue_address & 0xFFFFFFFF) | (value << 32);
      // Queue is now set up
      if dev.queue_address != 0 && dev.queue_size > 0 {
        let q: *VirtQueue = &dev.queues[dev.queue_sel];
        q.desc_table = dev.queue_address;
        q.size = dev.queue_size;
        q.enabled = true;
        if dev.queue_sel >= dev.num_queues as u16 {
          dev.num_queues = dev.queue_sel as u32 + 1;
        }
      }
    },
    0x38 => { dev.queue_size = value as u16; },
    0x3C => { dev.queue_sel = value as u16; },
    0x40 => {
      dev.queue_notify = value as u16;
      dev.driver_notified = true;
      process_virtio_queue(dev, dev.queue_notify, vcpu);
    },
    0x44 => { dev.interrupt_status &= value as u8; },
    0x48 => {
      dev.device_status = value as u8;
      // Handle status transitions
      if dev.device_status == 0x00 {
        // Reset
        dev.guest_features = 0;
        dev.num_queues = 0;
        dev.driver_notified = false;
      }
    },
    _ => {
      if offset >= 0x50 && offset < 0x50 + 256 {
        dev.config_space[(offset - 0x50) as u32] = value as u8;
      }
    },
  }

  record_device_residual(DevOp::VirtioMmioWrite, offset as u64, value);
}

/// Process a virtio queue notification.
fn process_virtio_queue[
  dev: *VirtioMmioDevice,
  queue_idx: u16,
  vcpu: *Vcpu,
] : effect:(syscall, unsafe)
  loop: bounded(1024)
{
  if queue_idx >= dev.num_queues as u16 { return; }
  let queue: VirtQueue = dev.queues[queue_idx];
  if !queue.enabled { return; }

  // Process available descriptors from the avail ring
  let avail_ring: u64 = queue.avail_ring;
  let used_ring: u64 = queue.used_ring;

  // Simplified: notify the device backend
  dev.interrupt_status |= 0x01;  // Used buffer notification

  // Inject interrupt to VCPU
  vcpu_inject_irq(vcpu, dev.irq_line as u8, 0,
    CapabilitySlot(type_tag: 0, rights: (1 << 44), value: 0, generation: 1, valid: true));
}

//==============================================================================
// Interrupt Injection
//==============================================================================

/// Inject an interrupt into a VCPU via the emulated PIC/IOAPIC.
pub fn inject_interrupt[
  pic: *PicState,
  ioapic: *IoApicState,
  vcpu: *Vcpu,
  irq: u32,
  hv_cap: CapabilitySlot,
] -> Result[(), DevError> : (syscall, unsafe)
  loop: bounded(1)
{
  if irq < 8 {
    // PIC slave
    pic_assert_irq(pic, irq as u8);
    let vector: u32 = pic_acknowledge(pic);
    if vector != 0 {
      vcpu_inject_irq(vcpu, vector as u8, 0, hv_cap)?;
    }
  } else {
    // IOAPIC route
    ioapic_assert_irq(ioapic, irq);
    let rte: IoApicEntry = ioapic_get_rte(ioapic, irq);
    if rte.masked == 0 {
      vcpu_inject_irq(vcpu, rte.vector as u8, rte.trigger_mode, hv_cap)?;
    }
  }

  record_device_residual(DevOp::InjectIrq, irq as u64, 0);
  return Ok(());
}

//==============================================================================
// I/O APIC
//==============================================================================

/// I/O APIC entry (Redirection Table Entry).
pub struct IoApicEntry(
  vector: u32,
  delivery_mode: u32,
  destination_mode: u32,
  delivery_status: u32,
  polarity: u32,
  irr: u32,
  trigger_mode: u32,
  masked: u32,
  destination: u32,
) : effect:(pure);

/// I/O APIC state.
pub struct IoApicState(
  id: u32,
  version: u32,
  gsi_base: u32,
  entries: [IoApicEntry; 24],
  irr: u32,
  ioregsel: u32,
  base_dev: EmulatedDevice,
) : effect:(alloc);

const IOAPIC_BASE: u64 = 0xFEC00000;

/// Initialize I/O APIC.
pub fn ioapic_init[
  vm_id: u64,
  cap_token: u64,
] -> *IoApicState : effect:(alloc) {
  let ioapic: *IoApicState = @alloc(IoApicState);
  ioapic.id = 0;
  ioapic.version = 0x11;  // I/O APIC version
  ioapic.gsi_base = 0;
  ioapic.entries = Default;
  ioapic.irr = 0;
  ioapic.ioregsel = 0;
  ioapic.base_dev = EmulatedDevice(device_type: DeviceType::IOAPIC, device_id: 4, vm_id: vm_id, mmio_base: IOAPIC_BASE, mmio_size: 0x100, irq_line: 0, cap_token: cap_token, is_plugged: true, generation: 1);

  // Initialize all entries as masked
  for var i: u32 = 0; i < 24; i += 1 {
    ioapic.entries[i] = IoApicEntry(
      vector: 0, delivery_mode: 0, destination_mode: 0,
      delivery_status: 0, polarity: 0, irr: 0,
      trigger_mode: 0, masked: 1, destination: 0,
    );
  }

  return ioapic;
}

/// Read I/O APIC register.
pub fn ioapic_read[
  ioapic: *IoApicState,
  offset: u32,
] -> u32 : effect:(pure)
  loop: bounded(1)
{
  match offset {
    0x00 => ioapic.id,
    0x01 => ioapic.version | (24 << 16),  // max redir entries
    _ => {
      // Redirect table entries
      let entry_idx: u32 = (offset - 0x10) / 2;
      let is_high: bool = (offset - 0x10) % 2 == 1;
      if entry_idx < 24 {
        let entry: IoApicEntry = ioapic.entries[entry_idx];
        if is_high {
          return entry.destination;
        }
        return entry.vector | (entry.delivery_mode << 8) | (entry.destination_mode << 11)
             | (entry.delivery_status << 12) | (entry.polarity << 13)
             | (entry.irr << 14) | (entry.trigger_mode << 15)
             | (entry.masked << 16);
      }
      0
    },
  }
}

/// Write I/O APIC register.
pub fn ioapic_write[
  ioapic: *IoApicState,
  offset: u32,
  value: u32,
] : effect:(unsafe)
  loop: bounded(1)
{
  match offset {
    0x00 => { ioapic.id = value & 0xF; },
    0x01 => { /* Read-only */ },
    _ => {
      let entry_idx: u32 = (offset - 0x10) / 2;
      let is_high: bool = (offset - 0x10) % 2 == 1;
      if entry_idx < 24 {
        if is_high {
          ioapic.entries[entry_idx].destination = value;
        } else {
          ioapic.entries[entry_idx].vector = value & 0xFF;
          ioapic.entries[entry_idx].delivery_mode = (value >> 8) & 7;
          ioapic.entries[entry_idx].destination_mode = (value >> 11) & 1;
          ioapic.entries[entry_idx].polarity = (value >> 13) & 1;
          ioapic.entries[entry_idx].trigger_mode = (value >> 15) & 1;
          ioapic.entries[entry_idx].masked = (value >> 16) & 1;
        }
      }
    },
  }
}

pub fn ioapic_assert_irq[ioapic: *IoApicState, irq: u32] : effect:(unsafe) {
  if irq < 24 {
    ioapic.irr |= 1 << irq;
  }
}

pub fn ioapic_get_rte[ioapic: *IoApicState, irq: u32] -> IoApicEntry : effect:(pure) {
  if irq < 24 { return ioapic.entries[irq]; }
  return IoApicEntry(vector: 0, delivery_mode: 0, destination_mode: 0, delivery_status: 0, polarity: 0, irr: 0, trigger_mode: 0, masked: 1, destination: 0);
}

//==============================================================================
// DMA Remapping / IOMMU
//==============================================================================

/// IOMMU state for DMA remapping.
pub struct IommuState(
  enabled: bool,
  page_table_ptr: u64,
  domains: [IommuDomain; 64],
  num_domains: u32,
  fault_log: [IommuFault; 32],
  num_faults: u32,
  cap_token: u64,
) : effect:(alloc);

pub struct IommuDomain(
  domain_id: u32,
  page_table: u64,
  addresses: u64,
  device_bdf: u32,
  is_passthrough: bool,
) : effect:(pure);

pub struct IommuFault(
  source_bdf: u32,
  guest_addr: u64,
  is_write: bool,
  fault_code: u32,
) : effect:(pure);

/// Translate a device DMA address through the IOMMU.
pub fn iommu_translate[
  iommu: *IommuState,
  device_bdf: u32,
  dma_addr: u64,
  is_write: bool,
] -> Result<u64, DevError> : effect:(unsafe)
  loop: bounded(1)
{
  if !iommu.enabled {
    // Bypass IOMMU
    return Ok(dma_addr);
  }

  // Find domain for this device
  for var i: u32 = 0; i < iommu.num_domains; i += 1 {
    let domain: IommuDomain = iommu.domains[i];
    if domain.device_bdf == device_bdf {
      if domain.is_passthrough {
        return Ok(dma_addr);
      }

      // Walk the IOMMU page table
      let translated: u64 = walk_iommu_page_table(domain.page_table, dma_addr);
      if translated == 0 {
        // Record fault
        if iommu.num_faults < 32 {
          iommu.fault_log[iommu.num_faults] = IommuFault(
            source_bdf: device_bdf,
            guest_addr: dma_addr,
            is_write: is_write,
            fault_code: 1,  // Not present
          );
          iommu.num_faults += 1;
        }
        return Err(DevError::DmaTranslationFault);
      }

      return Ok(translated);
    }
  }

  // No domain found — DMA blocked
  return Err(DevError::DeviceNotInDomain);
}

fn walk_iommu_page_table[table: u64, addr: u64] -> u64 : effect:(unsafe) {
  return 0;
}

//==============================================================================
// Device Hotplug
//==============================================================================

/// Hotplug a device into a VM.
pub fn device_hotplug[
  device: *EmulatedDevice,
  vm_id: u64,
  mmio_base: u64,
  irq_line: u32,
  hv_cap: CapabilitySlot,
] -> Result<(), DevError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let rights: CapRights = CapRights(hv_cap.rights);
  if (rights & RIGHT_HV_CREATE) == 0 {
    return Err(DevError::InsufficientRights);
  }

  device.mmio_base = mmio_base;
  device.irq_line = irq_line;
  device.vm_id = vm_id;
  device.is_plugged = true;
  device.generation = generate_dev_generation();

  record_device_residual(DevOp::Hotplug, device.device_type as u64, device.device_id);

  return Ok(());
}

/// Unplug a device from a VM.
pub fn device_unplug[
  device: *EmulatedDevice,
  hv_cap: CapabilitySlot,
] -> Result<(), DevError> : (syscall, unsafe)
  loop: bounded(1)
{
  device.is_plugged = false;
  record_device_residual(DevOp::Unplug, device.device_id, 0);
  return Ok(());
}

//==============================================================================
// Error Handling
//==============================================================================

pub enum DevError : u64 {
  Success               = 0,
  InsufficientRights    = 1,
  InvalidCapability     = 2,
  DeviceNotFound        = 3,
  DeviceAlreadyPlugged  = 4,
  DeviceNotPlugged      = 5,
  DmaTranslationFault   = 6,
  DeviceNotInDomain     = 7,
  OutOfResources        = 8,
  IrqInjectionFailed    = 9,
  NotImplemented        = 10,
}

pub enum DevOp : u8 {
  PicAssert      = 0,
  PitIrq         = 1,
  UartWrite      = 2,
  VirtioMmioWrite = 3,
  InjectIrq      = 4,
  Hotplug        = 5,
  Unplug         = 6,
}

fn record_device_residual[op: DevOp, arg1: u64, arg2: u64] : effect:(unsafe) {
  __dev_residual_write(op as u64, arg1, arg2);
}

fn generate_dev_generation[] -> u64 : effect:(pure) { return 1; }
fn __uart_console_write[c: u8] : effect:(io) {}
fn __dev_residual_write[op: u64, a1: u64, a2: u64] : effect:(unsafe) {}

pub type CapRights(:u64);
pub const RIGHT_HV_CREATE: CapRights = CapRights(1 << 40);
pub type CapabilitySlot = core::capabilities::CapabilitySlot;
fn @alloc[T](...) -> *T : effect:(alloc, unsafe) { return null; }

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_pic_irq[] : effect:(unsafe) {
  let pic: *PicState = pic_init(1, 0x20, 0);
  pic_assert_irq(pic, 3);
  let vector: u32 = pic_acknowledge(pic);
  assert(vector == 0x23);  // base 0x20 + irq 3
}

#[test]
pub fn test_uart_write_read[] : effect:(unsafe) {
  let uart: *UartState = uart_init(1, 0);
  uart_write(uart, 0, 0x41);  // Write 'A'
  let val: u8 = uart_read(uart, 0);
  assert(val == 0x41);
}

#[test]
pub fn test_virtio_mmio[] : effect:(unsafe) {
  let dev: *VirtioMmioDevice = virtio_mmio_init(1, 1, 0x1AF4, 0x1000, 10, 0);
  let magic: u64 = virtio_mmio_read(dev, 0x00, 4);
  assert(magic == 0x74726976);
}

#[test]
pub fn test_ioapic[] : effect:(unsafe) {
  let ioapic: *IoApicState = ioapic_init(1, 0);
  let ver: u32 = ioapic_read(ioapic, 0x01);
  assert((ver & 0xFF) == 0x11);
}
