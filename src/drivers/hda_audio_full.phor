    codec_address: u8,
}

// ─────────────────────────────────────────────────────────────
// Codec State
// ─────────────────────────────────────────────────────────────

struct HdaCodec {
    codec_address: u8,
    vendor_id: u32,
    revision_id: u32,
    major_rev: u8,
    minor_rev: u8,
    afg: HdaFunctionGroup,
    function_groups: Array(HdaFunctionGroup, 4),
    fg_count: u8,
    dma_engines: Array(HdaDmaEngine, 8),
    dma_engine_count: u8,
    hdmi_state: HdaHdmiAudioState,
    hdmi_present: bool,
    spdif_present: bool,
    analog_present: bool,
    power_state: HdaPowerState,
    initialized: bool,
}

// ─────────────────────────────────────────────────────────────
// Controller State
// ─────────────────────────────────────────────────────────────

struct HdaController {
    controller_identity: Identity,
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    codecs: Array(HdaCodec, 4),
    codec_count: u8,
    dma_engines: Array(HdaDmaEngine, 8),
    dma_engine_count: u8,
    corb: Array(HdaCorbEntry, 256),
    corb_wp: u16,
    corb_rp: u16,
    corb_size: u16,
    rirb: Array(HdaRirbEntry, 256),
    rirb_wp: u16,
    rirb_rp: u16,
    rirb_size: u16,
    unsol_queue: RingBuf(HdaUnsolicitedResponse, 16),
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct HdaAudioDriverState {
    driver_identity: Identity,
    controllers: Array(HdaController, 4),
    controller_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_operations: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// CORB: Write Verb to CORB
// ─────────────────────────────────────────────────────────────

fn hda_corb_write(
    controller: Handle(HdaController),
    cad: u8,
    node_id: u16,
    verb: u32,
    payload: u16,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_corb_write:v1"
{
    let regs: HdaRegisters = HdaRegisters { mmio_base: controller.mmio_base };

    let wp: u16 = controller.corb_wp;
    let rp: u16 = controller.corb_rp;

    let next_wp: u16 = (wp + 1) & (controller.corb_size - 1);
    if next_wp == rp {
        return Result::Err(HdaAudioError::HdaCorbFull);
    };

    let entry: HdaCorbEntry = HdaCorbEntry {
        verb: verb,
        cad: cad,
        node_id: node_id,
        payload: payload,
    };

    controller.corb[wp as u64] = entry;
    controller.corb_wp = next_wp;

    regs.write16(HdaRegisters::corbwp_offset(), next_wp);

    residual emit {
        op: "hda.corb_write",
        cad: cad as u64,
        node_id: node_id as u64,
        verb: verb as u64,
        payload: payload as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// RIRB: Read Response
// ─────────────────────────────────────────────────────────────

fn hda_rirb_read(
    controller: Handle(HdaController),
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(HdaRirbEntry, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_rirb_read:v1"
{
    let regs: HdaRegisters = HdaRegisters { mmio_base: controller.mmio_base };

    let wp: u16 = regs.read16(HdaRegisters::rirbwp_offset());
    let rp: u16 = controller.rirb_rp;

    if wp == rp {
        return Result::Err(HdaAudioError::HdaRirbEmpty);
    };

    let next_rp: u16 = (rp + 1) & (controller.rirb_size - 1);
    let entry: HdaRirbEntry = controller.rirb[next_rp as u64];
    controller.rirb_rp = next_rp;

    residual emit {
        op: "hda.rirb_read",
        response: entry.response as u64,
        unsolicited: entry.unsolicited,
        timestamp: timestamp,
    };

    return Result::Ok(entry);
}

// ─────────────────────────────────────────────────────────────
// Send Verb via CORB / Wait on RIRB
// ─────────────────────────────────────────────────────────────

fn hda_send_verb(
    controller: Handle(HdaController),
    cad: u8,
    node_id: u16,
    verb: u32,
    payload: u16,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(u32, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_send_verb:v1"
{
    let corb_result: Result(void, HdaAudioError) = hda_corb_write(controller, cad, node_id, verb, payload, cap, timestamp);
    match corb_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let rirb_result: Result(HdaRirbEntry, HdaAudioError) = hda_rirb_read(controller, cap, timestamp);
    match rirb_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(entry) => { return Result::Ok(entry.response); },
    };
}

// ─────────────────────────────────────────────────────────────
// Probe Codec Vendor ID
// ─────────────────────────────────────────────────────────────

fn hda_codec_probe_vendor(
    controller: Handle(HdaController),
    cad: u8,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(u32, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_codec_probe_vendor:v1"
{
    if !cap.can_codec_probe {
        return Result::Err(HdaAudioError::HdaCapabilityError);
    };

    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, cad, 0x00, 0x0F0000, 0x00, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(vendor) => {
            residual emit {
                op: "hda.codec_probe_vendor",
                cad: cad as u64,
                vendor_id: vendor as u64,
                timestamp: timestamp,
            };
            return Result::Ok(vendor);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// Probe Widget Capabilities
// ─────────────────────────────────────────────────────────────

fn hda_probe_widget(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    node_id: u16,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(HdaWidget, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_probe_widget:v1"
{
    let cap_result: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, node_id, 0x0F0004, 0x00, cap, timestamp,
    );
    let widget_cap: u32;
    match cap_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(c) => { widget_cap = c; },
    };

    let widget_type: HdaWidgetType = ((widget_cap >> 20) & 0x0F) as HdaWidgetType;
    let power_states: u8 = ((widget_cap >> 16) & 0x0F) as u8;

    let mut widget: HdaWidget = HdaWidget {
        node_id: node_id,
        widget_type: widget_type,
        capabilities: widget_cap,
        amp_in_cap: 0,
        amp_out_cap: 0,
        pcm_cap: 0,
        pin_cap: 0,
        volume: 0,
        mute: false,
        power_state: HdaPowerState::D0,
        connected_nodes: Array::zeroed(),
        conn_count: 0,
        conn_idx: 0,
        eapd_btl: false,
        dp_mst_count: 0,
        converter_stream: 0,
        converter_channel: 0,
        unsol_capable: false,
        unsol_enabled: false,
    };

    if widget_type == HdaWidgetType::AudioOutput || widget_type == HdaWidgetType::AudioInput {
        let pcm_result: Result(u32, HdaAudioError) = hda_send_verb(
            controller, codec.codec_address, node_id, 0x0F0002, 0x00, cap, timestamp,
        );
        match pcm_result {
            Result::Ok(pcm) => { widget.pcm_cap = pcm; },
            Result::Err(_) => {},
        };
    };

    if widget_type == HdaWidgetType::PinComplex {
        let pin_result: Result(u32, HdaAudioError) = hda_send_verb(
            controller, codec.codec_address, node_id, 0x0F000C, 0x00, cap, timestamp,
        );
        match pin_result {
            Result::Ok(pin) => { widget.pin_cap = pin; },
            Result::Err(_) => {},
        };
    };

    residual emit {
        op: "hda.probe_widget",
        node_id: node_id as u64,
        widget_type: widget_type as u64,
        timestamp: timestamp,
    };

    return Result::Ok(widget);
}

// ─────────────────────────────────────────────────────────────
// Set Widget Power State
// ─────────────────────────────────────────────────────────────

fn hda_set_power_state(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    node_id: u16,
    state: HdaPowerState,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_set_power_state:v1"
{
    if !cap.can_power {
        return Result::Err(HdaAudioError::HdaCapabilityError);
    };

    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, node_id, 0x070500, state as u16, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "hda.set_power_state",
        node_id: node_id as u64,
        state: state as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Amplifier Gain / Mute
// ─────────────────────────────────────────────────────────────

fn hda_set_amp(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    node_id: u16,
    direction: u8,
    index: u8,
    gain: u8,
    mute: bool,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_set_amp:v1"
{
    if !cap.can_amplifier {
        return Result::Err(HdaAudioError::HdaCapabilityError);
    };

    let mut verb: u32 = 0x030200;
    if direction == 1 {
        verb = 0x030300;
    };
    let mut payload: u16 = (gain as u16) & 0x7F;
    if mute {
        payload = payload | 0x80;
    };
    payload = payload | ((index as u16) << 8);

    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, node_id, verb, payload, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "hda.set_amp",
        node_id: node_id as u64,
        gain: gain as u64,
        muted: mute,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Converter Format
// ─────────────────────────────────────────────────────────────

fn hda_set_converter_format(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    node_id: u16,
    format: u16,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_set_converter_format:v1"
{
    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, node_id, 0x020200, format, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "hda.set_converter_format",
        node_id: node_id as u64,
        format: format as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Converter Stream + Channel
// ─────────────────────────────────────────────────────────────

fn hda_set_converter_stream(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    node_id: u16,
    stream_tag: u8,
    channel_id: u8,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_set_converter_stream:v1"
{
    let payload: u16 = ((stream_tag as u16) << 4) | (channel_id as u16);
    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, node_id, 0x020600, payload, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "hda.set_converter_stream",
        node_id: node_id as u64,
        stream_tag: stream_tag as u64,
        channel_id: channel_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Enable / Disable Unsolicited Responses
// ─────────────────────────────────────────────────────────────

fn hda_set_unsolicited(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    node_id: u16,
    enable: bool,
    tag: u8,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_set_unsolicited:v1"
{
    if !cap.can_unsolicited {
        return Result::Err(HdaAudioError::HdaCapabilityError);
    };

    let mut payload: u16 = (tag as u16) & 0x3F;
    if enable {
        payload = payload | 0x80;
    };

    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, node_id, 0x020800, payload, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "hda.set_unsolicited",
        node_id: node_id as u64,
        enabled: enable,
        tag: tag as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Pin Widget Control (EAPD / Output / Input)
// ─────────────────────────────────────────────────────────────

fn hda_set_pin_control(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    node_id: u16,
    output_enable: bool,
    input_enable: bool,
    hp_enable: bool,
    eapd_enable: bool,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_set_pin_control:v1"
{
    let mut payload: u16 = 0;
    if output_enable { payload = payload | 0x40; };
    if input_enable { payload = payload | 0x20; };
    if hp_enable { payload = payload | 0x80; };
    if eapd_enable { payload = payload | 0x02; };

    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, node_id, 0x070700, payload, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "hda.set_pin_control",
        node_id: node_id as u64,
        eapd: eapd_enable,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// HDMI: Set Audio Infoframe
// ─────────────────────────────────────────────────────────────

fn hda_hdmi_set_infoframe(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    pin_node: u16,
    infoframe: HdaHdmiInfoframe,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_hdmi_set_infoframe:v1"
{
    if !cap.can_hdmi {
        return Result::Err(HdaAudioError::HdaCapabilityError);
    };

    let dip_freq: u32 = 0x02F0;
    let dip_size: u32 = 0x02F1;
    let dip_index: u32 = 0x02F2;
    let dip_data: u32 = 0x02F3;

    let frmct: u16 = ((infoframe.length as u16) << 8) | (infoframe.data_type as u16);
    let response: Result(u32, HdaAudioError) = hda_send_verb(
        controller, codec.codec_address, pin_node, dip_freq, frmct, cap, timestamp,
    );
    match response {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let hdmi_state: Handle(HdaHdmiAudioState) = Handle(HdaHdmiAudioState)::from_ptr(&codec.hdmi_state);
    hdmi_state.infoframe = infoframe;
    hdmi_state.infoframe_valid = true;

    residual emit {
        op: "hda.hdmi_set_infoframe",
        pin_node: pin_node as u64,
        data_type: infoframe.data_type as u64,
        channel_count: infoframe.audio_channel_count as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// HDMI: Read ELD (EDID-Like Data)
// ─────────────────────────────────────────────────────────────

fn hda_hdmi_read_eld(
    controller: Handle(HdaController),
    codec: Handle(HdaCodec),
    pin_node: u16,
    buffer: Handle(Array(u8, 256)),
    buffer_size: u8,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(u8, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_hdmi_read_eld:v1"
{
    if !cap.can_hdmi {
        return Result::Err(HdaAudioError::HdaCapabilityError);
    };

    let eld_verb: u32 = 0x02F5;

    let mut total_bytes: u8 = 0;
    loop bound 64 {
        if total_bytes >= buffer_size || total_bytes >= 64 {
            break;
        };
        let idx: u16 = total_bytes as u16;
        let response: Result(u32, HdaAudioError) = hda_send_verb(
            controller, codec.codec_address, pin_node, eld_verb, idx, cap, timestamp,
        );
        match response {
            Result::Err(_) => { break; },
            Result::Ok(data) => {
                buffer.val[total_bytes as u64] = (data & 0xFF) as u8;
            },
        };
        total_bytes = total_bytes + 1;
    };

    let hdmi_state: Handle(HdaHdmiAudioState) = Handle(HdaHdmiAudioState)::from_ptr(&codec.hdmi_state);
    hdmi_state.eld_valid = true;
    hdmi_state.eld_size = total_bytes;

    residual emit {
        op: "hda.hdmi_read_eld",
        pin_node: pin_node as u64,
        eld_size: total_bytes as u64,
        timestamp: timestamp,
    };

    return Result::Ok(total_bytes);
}

// ─────────────────────────────────────────────────────────────
// DMA Engine: Setup BDL
// ─────────────────────────────────────────────────────────────

fn hda_dma_setup_bdl(
    engine: Handle(HdaDmaEngine),
    bdl_entries: Array(HdaBdlEntry, 32),
    entry_count: u16,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [deterministic, residual]
    court "hda_dma_setup_bdl:v1"
{
    loop bound 32 {
        let mut i: u64 = 0;
        if i >= (entry_count as u64) {
            break;
        };
        engine.bdl_entries[i] = bdl_entries[i];
        i = i + 1;
    };

    engine.bdl_count = entry_count;

    residual emit {
        op: "hda.dma_setup_bdl",
        engine_id: engine.engine_id as u64,
        entry_count: entry_count as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// DMA Engine: Start
// ─────────────────────────────────────────────────────────────

fn hda_dma_start(
    controller: Handle(HdaController),
    engine: Handle(HdaDmaEngine),
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_dma_start:v1"
{
    let regs: HdaRegisters = HdaRegisters { mmio_base: controller.mmio_base };
    let stream_base: u64 = HdaRegisters::sdma_stream_base(engine.engine_id as u64);
    let ctl: u32 = regs.read32(stream_base + 0x04);
    regs.write32(stream_base + 0x04, ctl | 0x01);

    engine.stream.flags.running = true;
    engine.started = true;

    residual emit {
        op: "hda.dma_start",
        engine_id: engine.engine_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// DMA Engine: Stop
// ─────────────────────────────────────────────────────────────

fn hda_dma_stop(
    controller: Handle(HdaController),
    engine: Handle(HdaDmaEngine),
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_dma_stop:v1"
{
    let regs: HdaRegisters = HdaRegisters { mmio_base: controller.mmio_base };
    let stream_base: u64 = HdaRegisters::sdma_stream_base(engine.engine_id as u64);
    let ctl: u32 = regs.read32(stream_base + 0x04);
    regs.write32(stream_base + 0x04, ctl & !0x01);

    engine.stream.flags.running = false;
    engine.started = false;

    residual emit {
        op: "hda.dma_stop",
        engine_id: engine.engine_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Codec Initialization
// ─────────────────────────────────────────────────────────────

fn hda_codec_init(
    controller: Handle(HdaController),
    cad: u8,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_codec_init:v1"
{
    let vendor: Result(u32, HdaAudioError) = hda_codec_probe_vendor(controller, cad, cap, timestamp);
    let vendor_id: u32;
    match vendor {
        Result::Err(_) => { return Result::Err(HdaAudioError::HdaCodecNotResponding); },
        Result::Ok(v) => { vendor_id = v; },
    };

    if vendor_id == 0 || vendor_id == 0xFFFFFFFF {
        return Result::Err(HdaAudioError::HdaCodecNotFound);
    };

    let rev_result: Result(u32, HdaAudioError) = hda_send_verb(
        controller, cad, 0x00, 0x0F0005, 0x00, cap, timestamp,
    );
    let revision_id: u32;
    match rev_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(r) => { revision_id = r; },
    };

    let codec: Handle(HdaCodec) = Handle(HdaCodec)::from_ptr(&controller.codecs[cad as u64]);
    codec.codec_address = cad;
    codec.vendor_id = vendor_id;
    codec.revision_id = revision_id;
    codec.initialized = true;

    let afg_result: Result(u32, HdaAudioError) = hda_send_verb(
        controller, cad, 0x01, 0x0F0004, 0x00, cap, timestamp,
    );
    match afg_result {
        Result::Ok(afg_cap) => {
            codec.afg.node_id = 0x01;
            codec.afg.vendor_id = vendor_id;
            codec.afg.revision_id = revision_id;
            codec.afg.widget_count = ((afg_cap >> 23) & 0x1F) as u8;
        },
        Result::Err(_) => {},
    };

    controller.codec_count = controller.codec_count + 1;

    residual emit {
        op: "hda.codec_init",
        cad: cad as u64,
        vendor_id: vendor_id as u64,
        revision_id: revision_id as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Controller Initialization
// ─────────────────────────────────────────────────────────────

fn hda_controller_init(
    controller: Handle(HdaController),
    mmio_base: u64,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> Result(void, HdaAudioError)
    effect [memory:mmio, deterministic, residual]
    court "hda_controller_init:v1"
{
    let regs: HdaRegisters = HdaRegisters { mmio_base: mmio_base };

    regs.write32(HdaRegisters::gc_offset(), 0x01);

    regs.write8(HdaRegisters::corbctl_offset(), 0x00);
    regs.write8(HdaRegisters::corbctl_offset(), 0x02);

    regs.write16(HdaRegisters::rirbctl_offset(), 0x00);
    regs.write8(HdaRegisters::rirbctl_offset(), 0x02);

    regs.write8(HdaRegisters::wakeen_offset(), 0x00);

    regs.write32(HdaRegisters::intctl_offset(), 0x01);

    controller.initialized = true;

    residual emit {
        op: "hda.controller_init",
        mmio_base: mmio_base,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn hda_driver_init(
    driver_identity: Identity,
    cap: HdaAudioCapability,
    timestamp: u64,
) -> HdaAudioDriverState
    effect [deterministic, residual]
    court "hda_driver_init:v1"
{
    let state: HdaAudioDriverState = HdaAudioDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_operations: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "hda.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}
