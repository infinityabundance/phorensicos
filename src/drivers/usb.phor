// usb.phor — USB host controller driver
// EHCI/XHCI register interface, device enumeration, transfer descriptors, HID discovery
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/usb.phor
// Court: usb_driver:v2

package drivers.usb;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type UsbError = enum {
    UsbNotInitialized          = 0x400,  // E0400: USB driver not initialized
    UsbControllerNotFound      = 0x401,  // E0401: USB host controller not found
    UsbHcNotOperational        = 0x402,  // E0402: host controller not operational
    UsbDeviceNotFound          = 0x403,  // E0403: device not found on bus
    UsbEnumerationFailed       = 0x404,  // E0404: device enumeration failed
    UsbTransferFailed          = 0x405,  // E0405: USB transfer failed
    UsbTransferTimeout         = 0x406,  // E0406: USB transfer timed out
    UsbInvalidDescriptor       = 0x407,  // E0407: invalid USB descriptor
    UsbCapabilityError         = 0x408,  // E0408: insufficient capability
    UsbQueueFull               = 0x409,  // E0409: transfer queue full
    UsbNoBandwidth             = 0x40A,  // E040A: no available bandwidth
    UsbStallError              = 0x40B,  // E040B: endpoint stalled
    UsbBabbleError             = 0x40C,  // E040C: babble detected
    UsbXferOverflow            = 0x40D,  // E040D: data overflow
    UsbPortNotEnabled          = 0x40E,  // E040E: port is not enabled
    UsbPortResetFailed         = 0x40F,  // E040F: port reset failed
    UsbHidReportInvalid        = 0x410,  // E0410: HID report descriptor invalid
    UsbMaxDevicesExceeded      = 0x411,  // E0411: max USB devices exceeded
}

// ─────────────────────────────────────────────────────────────
// USB Speeds
// ─────────────────────────────────────────────────────────────

type UsbSpeed = enum {
    LowSpeed    = 0,  // 1.5 Mbps
    FullSpeed   = 1,  // 12 Mbps
    HighSpeed   = 2,  // 480 Mbps
    SuperSpeed  = 3,  // 5 Gbps
    SuperPlus   = 4,  // 10 Gbps
    UnknownSpeed = 5,
}

// ─────────────────────────────────────────────────────────────
// Host Controller Types
// ─────────────────────────────────────────────────────────────

type HcType = enum {
    Uhci        = 0,  // Universal HCI
    Ohci        = 1,  // Open HCI
    Ehci        = 2,  // Enhanced HCI
    Xhci        = 3,  // eXtensible HCI
    UnknownHc   = 4,
}

// ─────────────────────────────────────────────────────────────
// USB Device States
// ─────────────────────────────────────────────────────────────

type UsbDeviceState = enum {
    Connected     = 0,
    Addressed     = 1,
    Configured    = 2,
    Suspended     = 3,
    Disconnected  = 4,
}

// ─────────────────────────────────────────────────────────────
// Standard USB Request Codes
// ─────────────────────────────────────────────────────────────

type UsbRequestCode = enum {
    GetStatus         = 0,
    ClearFeature      = 1,
    SetFeature        = 3,
    SetAddress        = 5,
    GetDescriptor     = 6,
    SetDescriptor     = 7,
    GetConfiguration  = 8,
    SetConfiguration  = 9,
    GetInterface      = 10,
    SetInterface      = 11,
    SynchFrame        = 12,
}

// ─────────────────────────────────────────────────────────────
// Standard USB Descriptor Types
// ─────────────────────────────────────────────────────────────

type UsbDescriptorType = enum {
    Device          = 1,
    Config          = 2,
    String          = 3,
    Interface       = 4,
    Endpoint        = 5,
    DeviceQualifier = 6,
    OtherSpeed      = 7,
    InterfacePower  = 8,
    Hid             = 0x21,
    HidReport       = 0x22,
    Hub             = 0x29,
}

// ─────────────────────────────────────────────────────────────
// USB Device Descriptor
// ─────────────────────────────────────────────────────────────

struct UsbDeviceDescriptor {
    bLength: u8,
    bDescriptorType: u8,
    bcdUsb: u16,
    bDeviceClass: u8,
    bDeviceSubClass: u8,
    bDeviceProtocol: u8,
    bMaxPacketSize0: u8,
    idVendor: u16,
    idProduct: u16,
    bcdDevice: u16,
    iManufacturer: u8,
    iProduct: u8,
    iSerialNumber: u8,
    bNumConfigurations: u8,
}

// ─────────────────────────────────────────────────────────────
// USB Configuration Descriptor
// ─────────────────────────────────────────────────────────────

struct UsbConfigDescriptor {
    bLength: u8,
    bDescriptorType: u8,
    wTotalLength: u16,
    bNumInterfaces: u8,
    bConfigurationValue: u8,
    iConfiguration: u8,
    bmAttributes: u8,
    bMaxPower: u8,
}

// ─────────────────────────────────────────────────────────────
// USB Interface Descriptor
// ─────────────────────────────────────────────────────────────

struct UsbInterfaceDescriptor {
    bLength: u8,
    bDescriptorType: u8,
    bInterfaceNumber: u8,
    bAlternateSetting: u8,
    bNumEndpoints: u8,
    bInterfaceClass: u8,
    bInterfaceSubClass: u8,
    bInterfaceProtocol: u8,
    iInterface: u8,
}

// ─────────────────────────────────────────────────────────────
// USB Endpoint Descriptor
// ─────────────────────────────────────────────────────────────

type UsbEndpointDir = enum {
    Out         = 0,
    In          = 1,
}

type UsbTransferType = enum {
    Control     = 0,
    Isochronous = 1,
    Bulk        = 2,
    Interrupt   = 3,
}

struct UsbEndpointDescriptor {
    bLength: u8,
    bDescriptorType: u8,
    bEndpointAddress: u8,
    bmAttributes: u8,
    wMaxPacketSize: u16,
    bInterval: u8,
    direction: UsbEndpointDir,
    transfer_type: UsbTransferType,
}

// ─────────────────────────────────────────────────────────────
// USB Device
// ─────────────────────────────────────────────────────────────

struct UsbDevice {
    device_identity: Identity,
    port: u8,
    address: u8,
    speed: UsbSpeed,
    state: UsbDeviceState,
    descriptor: UsbDeviceDescriptor,
    config_descriptor: UsbConfigDescriptor,
    interfaces: Array(UsbInterfaceDescriptor, 8),
    endpoints: Array(UsbEndpointDescriptor, 16),
    interface_count: u64,
    endpoint_count: u64,
    is_hid: bool,
    hid_report_descriptor: Array(u8, 256),
    hid_report_length: u64,
    parent_hub_port: u8,
    hub_depth: u8,
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 16),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// EHCI Register Set
// ─────────────────────────────────────────────────────────────

struct EhciRegisters {
    mmio_base: u64,
}

impl EhciRegisters {
    fn usbcmd_offset() -> u32 { return 0x000; }   // USB Command
    fn usbsts_offset() -> u32 { return 0x004; }   // USB Status
    fn usbintr_offset() -> u32 { return 0x008; }  // USB Interrupt Enable
    fn frindex_offset() -> u32 { return 0x00C; }  // Frame Index
    fn ctrldssegment_offset() -> u32 { return 0x010; }
    fn periodiclistbase_offset() -> u32 { return 0x014; }
    fn asynclistaddr_offset() -> u32 { return 0x018; }
    fn configflag_offset() -> u32 { return 0x040; }
    fn portsc_offset(port: u8) -> u32 { return 0x044 + (port as u32) * 4; }

    fn read32(self, offset: u32) -> u32
        effect [memory:mmio]
    {
        return trusted reason "EHCI MMIO register read at verified offset, EHCI Spec §2.3" {
            let ptr: *(u32) = (self.mmio_base + offset as u64) as *(u32);
            return *ptr;
        };
    }

    fn write32(self, offset: u32, value: u32) -> void
        effect [memory:mmio]
    {
        trusted reason "EHCI MMIO register write at verified offset, EHCI Spec §2.3" {
            let ptr: *(u32) = (self.mmio_base + offset as u64) as *(u32);
            *ptr = value;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// XHCI Register Set
// ─────────────────────────────────────────────────────────────

struct XhciRegisters {
    mmio_base: u64,
}

impl XhciRegisters {
    fn cap_length_offset() -> u64 { return 0x00; }
    fn hci_version_offset() -> u64 { return 0x02; }
    fn hcs_params1_offset() -> u64 { return 0x04; }
    fn hcs_params2_offset() -> u64 { return 0x08; }
    fn hcs_params3_offset() -> u64 { return 0x0C; }
    fn hcc_params1_offset() -> u64 { return 0x10; }
    fn dboff_offset() -> u64 { return 0x14; }
    fn rtsoff_offset() -> u64 { return 0x18; }
    fn hcc_params2_offset() -> u64 { return 0x1C; }

    fn xecp_offset(base: u64) -> u64 { return base; }

    fn read8(self, offset: u64) -> u8
        effect [memory:mmio]
    {
        return trusted reason "XHCI MMIO byte read" {
            let ptr: *(u8) = (self.mmio_base + offset) as *(u8);
            return *ptr;
        };
    }

    fn read32(self, offset: u64) -> u32
        effect [memory:mmio]
    {
        return trusted reason "XHCI MMIO register read, xHCI Spec §3.2" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            return *ptr;
        };
    }

    fn read64(self, offset: u64) -> u64
        effect [memory:mmio]
    {
        return trusted reason "XHCI MMIO register read 64-bit" {
            let ptr: *(u64) = (self.mmio_base + offset) as *(u64);
            return *ptr;
        };
    }

    fn write32(self, offset: u64, value: u32) -> void
        effect [memory:mmio]
    {
        trusted reason "XHCI MMIO register write, xHCI Spec §3.2" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            *ptr = value;
        };
    }

    fn write64(self, offset: u64, value: u64) -> void
        effect [memory:mmio]
    {
        trusted reason "XHCI MMIO register write 64-bit" {
            let ptr: *(u64) = (self.mmio_base + offset) as *(u64);
            *ptr = value;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// XHCI Doorbell Register
// ─────────────────────────────────────────────────────────────

struct XhciDoorbell {
    doorbell_base: u64,
}

impl XhciDoorbell {
    fn db_offset(target: u8) -> u64 { return (target as u64) * 4; }

    fn ring(self, target: u8, stream_id: u16) -> void
        effect [memory:mmio]
    {
        let db_val: u32 = stream_id as u32;
        trusted reason "XHCI doorbell register write, xHCI Spec §4.17.2" {
            let ptr: *(u32) = (self.doorbell_base + XhciDoorbell::db_offset(target)) as *(u32);
            *ptr = db_val;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// XHCI Port Register Set
// ─────────────────────────────────────────────────────────────

struct XhciPortRegs {
    portsc: u32,
    portpmsc: u32,
    portli: u32,
    porthlpmc: u32,
}

// ─────────────────────────────────────────────────────────────
// Transfer Request Block (TRB) — XHCI
// ─────────────────────────────────────────────────────────────

struct Trb {
    parameter: u64,
    status: u32,
    flags: u32,
    control: u32,
}

type TrbType = enum {
    Normal            = 1,
    Setup             = 2,
    Data              = 3,
    Status            = 4,
    Isoch             = 5,
    Link              = 6,
    EventData         = 7,
    NoOp              = 8,
    EnableSlot        = 9,
    DisableSlot       = 10,
    AddressDevice     = 11,
    ConfigureEndpoint = 12,
    EvaluateContext   = 13,
    ResetEndpoint     = 14,
    StopEndpoint      = 15,
    SetTrDequeue      = 16,
    ResetDevice       = 17,
    ForceEvent        = 18,
    NegotiateBandwidth = 19,
    SetLatency        = 20,
    GetPortBandwidth  = 21,
    ForceHeader       = 22,
    Command           = 23,
}

// ─────────────────────────────────────────────────────────────
// XHCI Slot Context / Endpoint Context (simplified)
// ─────────────────────────────────────────────────────────────

struct XhciSlotContext {
    dw0: u32,
    dw1: u32,
    dw2: u32,
    dw3: u32,
}

struct XhciEndpointContext {
    dw0: u32,
    dw1: u32,
    dw2: u32,
    dw3: u32,
    dequeue_ptr: u64,
    dw6: u32,
    dw7: u32,
}

// ─────────────────────────────────────────────────────────────
// Transfer Descriptor (EHCI qTD)
// ─────────────────────────────────────────────────────────────

struct EhciQtd {
    next_qtd_ptr: u32,
    alt_next_qtd_ptr: u32,
    token: u32,
    buffer: [u32; 5],
    buffer_hi: [u32; 5],
}

// ─────────────────────────────────────────────────────────────
// USB Transfer
// ─────────────────────────────────────────────────────────────

struct UsbTransfer {
    device_address: u8,
    endpoint: u8,
    transfer_type: UsbTransferType,
    direction: UsbEndpointDir,
    data_buffer: u64,
    data_length: u64,
    max_packet_size: u16,
    toggle_bit: u8,
    timeout_ms: u64,
    setup_packet: Array(u8, 8),
    setup_valid: bool,
    completed: bool,
    success: bool,
    bytes_transferred: u64,
    error_code: u64,
}

// ─────────────────────────────────────────────────────────────
// Host Controller State
// ─────────────────────────────────────────────────────────────

struct HostController {
    hc_type: HcType,
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    ehci: EhciRegisters,
    xhci: XhciRegisters,
    xhci_cap_length: u8,
    xhci_hci_version: u16,
    xhci_max_slots: u8,
    xhci_max_ports: u8,
    xhci_doorbell_base: u64,
    xhci_runtime_base: u64,
    xhci_erst_base: u64,
    xhci_erst_size: u16,
    xhci_erst_entry_count: u64,
    operational: bool,
    initialized: bool,
}

// ─────────────────────────────────────────────────────────────
// USB Driver State
// ─────────────────────────────────────────────────────────────

struct UsbDriverState {
    driver_identity: Identity,
    controllers: Array(HostController, 8),
    controller_count: u64,
    devices: Array(UsbDevice, 32),
    device_count: u64,
    xhci_device_slots: Array(u8, 32),
    xhci_slot_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

struct UsbCapability {
    object_id: Identity,
    generation: u64,
    can_control: bool,
    can_bulk: bool,
    can_interrupt: bool,
    can_isochronous: bool,
    can_configure: bool,
    max_devices: u64,
}

// ─────────────────────────────────────────────────────────────
// Reset XHCI Controller
// ─────────────────────────────────────────────────────────────

fn xhci_controller_reset(
    hc: Handle(HostController),
    timestamp: u64,
) -> Result(void, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_reset:v1"
{
    let xhci: XhciRegisters = XhciRegisters { mmio_base: hc.mmio_base };

    // Read capability registers
    let caplength: u8 = xhci.read8(XhciRegisters::cap_length_offset()) as u8;
    hc.xhci_cap_length = caplength;
    let hci_version: u16 = trusted reason "XHCI HCI version read" {
        let ptr: *(u16) = (hc.mmio_base + XhciRegisters::hci_version_offset()) as *(u16);
        return *ptr;
    };
    hc.xhci_hci_version = hci_version;

    let hcs_params1: u32 = xhci.read32(XhciRegisters::hcs_params1_offset());
    hc.xhci_max_slots = ((hcs_params1 >> 0) & 0xFF) as u8;
    hc.xhci_max_ports = ((hcs_params1 >> 24) & 0xFF) as u8;

    // Get doorbell and runtime offsets
    let dboff: u32 = xhci.read32(XhciRegisters::dboff_offset());
    let rtsoff: u32 = xhci.read32(XhciRegisters::rtsoff_offset());
    hc.xhci_doorbell_base = hc.mmio_base + dboff as u64;
    hc.xhci_runtime_base = hc.mmio_base + rtsoff as u64;

    // USBCMD register is at caplength
    let usbcmd_offset: u64 = caplength as u64;
    let usbsts_offset: u64 = caplength as u64 + 4;

    // Issue reset
    let cmd: u32 = xhci.read32(usbcmd_offset);
    xhci.write32(usbcmd_offset, cmd | 0x02);  // Set HCRST

    // Wait for reset to complete
    loop bound 1000 {
        let sts: u32 = xhci.read32(usbsts_offset);
        if (sts & 0x02) == 0 {  // HCHalted cleared
            break;
        };
    };

    hc.operational = true;

    residual emit {
        op: "xhci.reset",
        mmio_base: hc.mmio_base,
        max_slots: hc.xhci_max_slots as u64,
        max_ports: hc.xhci_max_ports as u64,
        hci_version: hci_version as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Initialize XHCI Controller
// ─────────────────────────────────────────────────────────────

fn xhci_controller_init(
    hc: Handle(HostController),
    timestamp: u64,
) -> Result(void, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_init:v1"
{
    let reset_result: Result(void, UsbError) = xhci_controller_reset(hc, timestamp);
    match reset_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let xhci: XhciRegisters = XhciRegisters { mmio_base: hc.mmio_base };
    let caplength: u8 = hc.xhci_cap_length;
    let usbcmd_offset: u64 = caplength as u64;
    let usbsts_offset: u64 = caplength as u64 + 4;

    // Configure max slots
    let config_offset: u64 = caplength as u64 + 0x38;
    xhci.write32(config_offset, hc.xhci_max_slots as u32);

    // Start the host controller
    let cmd: u32 = xhci.read32(usbcmd_offset);
    xhci.write32(usbcmd_offset, cmd | 0x01);  // Set RUN/STOP

    // Wait for HCHalted to clear
    loop bound 1000 {
        let sts: u32 = xhci.read32(usbsts_offset);
        if (sts & 0x01) == 0 {  // HCHalted bit clear = running
            break;
        };
    };

    hc.operational = true;
    hc.initialized = true;

    residual emit {
        op: "xhci.init",
        mmio_base: hc.mmio_base,
        max_slots: hc.xhci_max_slots as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// XHCI Port Status and Reset
// ─────────────────────────────────────────────────────────────

fn xhci_port_reset(
    hc: Handle(HostController),
    port: u8,
    timestamp: u64,
) -> Result(void, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_port_reset:v1"
{
    let xhci: XhciRegisters = XhciRegisters { mmio_base: hc.mmio_base };
    let caplength: u8 = hc.xhci_cap_length;

    // Port registers start at caplength + 0x400
    let port_reg_base: u64 = (caplength as u64) + 0x400;
    let portsc_offset: u64 = port_reg_base + (port as u64) * 0x10;

    let portsc: u32 = xhci.read32(portsc_offset);
    if (portsc & 0x01) == 0 {  // Port not connected
        return Result::Err(UsbError::UsbPortNotEnabled);
    };

    // Set port reset bit and clear other changes
    xhci.write32(portsc_offset, portsc | 0x10);

    // Wait for reset to complete (reset bit clears automatically)
    loop bound 100 {
        let sc: u32 = xhci.read32(portsc_offset);
        if (sc & 0x10) == 0 {
            break;
        };
    };

    residual emit {
        op: "xhci.port_reset",
        port: port as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// XHCI Enable Slot
// ─────────────────────────────────────────────────────────────

fn xhci_enable_slot(
    hc: Handle(HostController),
) -> Result(u8, UsbError)
    effect [memory:mmio, deterministic]
    court "xhci_enable_slot:v1"
{
    return Result::Ok(1);  // Placeholder: slot ID 1 always assigned
}

// ─────────────────────────────────────────────────────────────
// USB Device Descriptor Parsing
// ─────────────────────────────────────────────────────────────

fn usb_parse_device_descriptor(
    raw_desc: Array(u8, 18),
) -> UsbDeviceDescriptor
    effect [deterministic]
{
    return UsbDeviceDescriptor {
        bLength: raw_desc[0],
        bDescriptorType: raw_desc[1],
        bcdUsb: (raw_desc[3] as u16) << 8 | (raw_desc[2] as u16),
        bDeviceClass: raw_desc[4],
        bDeviceSubClass: raw_desc[5],
        bDeviceProtocol: raw_desc[6],
        bMaxPacketSize0: raw_desc[7],
        idVendor: (raw_desc[9] as u16) << 8 | (raw_desc[8] as u16),
        idProduct: (raw_desc[11] as u16) << 8 | (raw_desc[10] as u16),
        bcdDevice: (raw_desc[13] as u16) << 8 | (raw_desc[12] as u16),
        iManufacturer: raw_desc[14],
        iProduct: raw_desc[15],
        iSerialNumber: raw_desc[16],
        bNumConfigurations: raw_desc[17],
    };
}

// ─────────────────────────────────────────────────────────────
// Check if Device is HID
// ─────────────────────────────────────────────────────────────

fn usb_is_hid_device(
    device: Handle(UsbDevice),
) -> bool
    effect [deterministic]
{
    loop bound 8 {
        let i: u64 = 0;
        if i >= device.interface_count {
            break;
        };
        let iface: UsbInterfaceDescriptor = device.interfaces[i];
        if iface.bInterfaceClass == 0x03 {  // HID class
            return true;
        };
    };
    return false;
}

// ─────────────────────────────────────────────────────────────
// Enumerate USB Device
// ─────────────────────────────────────────────────────────────

fn usb_enumerate_device(
    state: Handle(UsbDriverState),
    controller_idx: u64,
    port: u8,
    speed: UsbSpeed,
    enum_cap: UsbCapability,
    timestamp: u64,
) -> Result(u64, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "usb_enum_device:v1"
{
    if state.device_count >= 32 {
        return Result::Err(UsbError::UsbMaxDevicesExceeded);
    };

    let device_identity: Identity = identity_new(
        0x555342, timestamp, state.device_count as u64, port as u64,
    );

    // Simulate reading device descriptor (in real hw, would issue control transfer)
    let raw_desc: Array(u8, 18) = Array(u8, 18) {
        data: [18, 1, 0x00, 0x02, 0x00, 0x00, 0x00, 8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0, 0, 0, 1],
    };
    let desc: UsbDeviceDescriptor = usb_parse_device_descriptor(raw_desc);

    let device: UsbDevice = UsbDevice {
        device_identity: device_identity,
        port: port,
        address: (state.device_count + 1) as u8,
        speed: speed,
        state: UsbDeviceState::Connected,
        descriptor: desc,
        config_descriptor: UsbConfigDescriptor {
            bLength: 9, bDescriptorType: 2, wTotalLength: 25,
            bNumInterfaces: 1, bConfigurationValue: 1,
            iConfiguration: 0, bmAttributes: 0x80, bMaxPower: 50,
        },
        interfaces: Array::zeroed(),
        endpoints: Array::zeroed(),
        interface_count: 0,
        endpoint_count: 0,
        is_hid: false,
        hid_report_descriptor: Array::zeroed(),
        hid_report_length: 0,
        parent_hub_port: port,
        hub_depth: 0,
        initialized: true,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.devices[state.device_count] = device;
    let dev_idx: u64 = state.device_count;
    state.device_count = state.device_count + 1;

    residual emit {
        op: "usb.enumerate_device",
        controller: controller_idx,
        port: port as u64,
        speed: speed as u64,
        vendor: desc.idVendor as u64,
        product: desc.idProduct as u64,
        dev_class: desc.bDeviceClass as u64,
        dev_idx: dev_idx,
        timestamp: timestamp,
    };

    return Result::Ok(dev_idx);
}

// ─────────────────────────────────────────────────────────────
// USB Driver Initialization
// ─────────────────────────────────────────────────────────────

fn usb_driver_init(
    driver_identity: Identity,
    cap: UsbCapability,
    timestamp: u64,
) -> UsbDriverState
    effect [deterministic, residual]
    court "usb_driver_init:v2"
{
    let state: UsbDriverState = UsbDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        devices: Array::zeroed(),
        device_count: 0,
        xhci_device_slots: Array::zeroed(),
        xhci_slot_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "usb_driver.init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add XHCI Controller
// ─────────────────────────────────────────────────────────────

fn usb_add_xhci_controller(
    state: Handle(UsbDriverState),
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    timestamp: u64,
) -> Result(u64, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "usb_add_xhci:v1"
{
    if state.controller_count >= 8 {
        return Result::Err(UsbError::UsbControllerNotFound);
    };

    let idx: u64 = state.controller_count;

    let hc: HostController = HostController {
        hc_type: HcType::Xhci,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        irq_vector: irq_vector,
        ehci: EhciRegisters { mmio_base: 0 },
        xhci: XhciRegisters { mmio_base: mmio_base },
        xhci_cap_length: 0,
        xhci_hci_version: 0,
        xhci_max_slots: 0,
        xhci_max_ports: 0,
        xhci_doorbell_base: 0,
        xhci_runtime_base: 0,
        xhci_erst_base: 0,
        xhci_erst_size: 0,
        xhci_erst_entry_count: 0,
        operational: false,
        initialized: false,
    };

    state.controllers[idx] = hc;
    state.controller_count = state.controller_count + 1;

    let hc_handle: Handle(HostController) = Handle(HostController)::from_ptr(&state.controllers[idx]);
    let init_result: Result(void, UsbError) = xhci_controller_init(hc_handle, timestamp);
    match init_result {
        Result::Ok(_) => {},
        Result::Err(e) => { return Result::Err(e); },
    };

    residual emit {
        op: "usb.add_xhci",
        idx: idx,
        mmio_base: mmio_base,
        max_slots: state.controllers[idx].xhci_max_slots as u64,
        max_ports: state.controllers[idx].xhci_max_ports as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// Add EHCI Controller
// ─────────────────────────────────────────────────────────────

fn usb_add_ehci_controller(
    state: Handle(UsbDriverState),
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    timestamp: u64,
) -> Result(u64, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "usb_add_ehci:v1"
{
    if state.controller_count >= 8 {
        return Result::Err(UsbError::UsbControllerNotFound);
    };

    let idx: u64 = state.controller_count;

    let hc: HostController = HostController {
        hc_type: HcType::Ehci,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        irq_vector: irq_vector,
        ehci: EhciRegisters { mmio_base: mmio_base },
        xhci: XhciRegisters { mmio_base: 0 },
        xhci_cap_length: 0,
        xhci_hci_version: 0,
        xhci_max_slots: 0,
        xhci_max_ports: 0,
        xhci_doorbell_base: 0,
        xhci_runtime_base: 0,
        xhci_erst_base: 0,
        xhci_erst_size: 0,
        xhci_erst_entry_count: 0,
        operational: false,
        initialized: false,
    };

    state.controllers[idx] = hc;
    state.controller_count = state.controller_count + 1;

    // Start EHCI controller
    let ehci: EhciRegisters = EhciRegisters { mmio_base: mmio_base };
    ehci.write32(EhciRegisters::usbcmd_offset(), 0x01);  // Run
    state.controllers[idx].operational = true;
    state.controllers[idx].initialized = true;

    residual emit {
        op: "usb.add_ehci",
        idx: idx,
        mmio_base: mmio_base,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// Create USB Control Transfer
// ─────────────────────────────────────────────────────────────

fn usb_create_setup_packet(
    request_type: u8,
    request: u8,
    value: u16,
    index: u16,
    length: u16,
) -> Array(u8, 8)
    effect [deterministic]
{
    let mut packet: Array(u8, 8) = Array::zeroed();
    packet[0] = request_type;
    packet[1] = request;
    packet[2] = (value & 0xFF) as u8;
    packet[3] = ((value >> 8) & 0xFF) as u8;
    packet[4] = (index & 0xFF) as u8;
    packet[5] = ((index >> 8) & 0xFF) as u8;
    packet[6] = (length & 0xFF) as u8;
    packet[7] = ((length >> 8) & 0xFF) as u8;
    return packet;
}

// ─────────────────────────────────────────────────────────────
// Issue Control Transfer (simplified)
// ─────────────────────────────────────────────────────────────

fn usb_control_transfer(
    state: Handle(UsbDriverState),
    device_idx: u64,
    request_type: u8,
    request: u8,
    value: u16,
    index: u16,
    data_buffer: u64,
    data_length: u16,
    xfer_cap: UsbCapability,
    timestamp: u64,
) -> Result(u64, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "usb_control_xfer:v1"
{
    if device_idx >= state.device_count {
        return Result::Err(UsbError::UsbDeviceNotFound);
    };

    if !xfer_cap.can_control {
        return Result::Err(UsbError::UsbCapabilityError);
    };

    let setup: Array(u8, 8) = usb_create_setup_packet(request_type, request, value, index, data_length);

    // In a real driver, this would submit to the host controller
    // For now, simulate success with data_length transferred

    residual emit {
        op: "usb.control_transfer",
        device_idx: device_idx,
        request: request as u64,
        value: value as u64,
        length: data_length as u64,
        timestamp: timestamp,
    };

    return Result::Ok(data_length as u64);
}

// ─────────────────────────────────────────────────────────────
// Get Device Descriptor
// ─────────────────────────────────────────────────────────────

fn usb_get_device_descriptor(
    state: Handle(UsbDriverState),
    device_idx: u64,
    xfer_cap: UsbCapability,
    timestamp: u64,
) -> Result(UsbDeviceDescriptor, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "usb_get_dev_desc:v1"
{
    let result: Result(u64, UsbError) = usb_control_transfer(
        state, device_idx, 0x80,  // Device-to-host, standard, dev
        UsbRequestCode::GetDescriptor as u8,
        (UsbDescriptorType::Device as u16) << 8,
        0, 0, 18, xfer_cap, timestamp,
    );
    match result {
        Result::Ok(_) => {
            // In real driver, would read data from buffer
            let desc: UsbDeviceDescriptor = UsbDeviceDescriptor {
                bLength: 18, bDescriptorType: 1,
                bcdUsb: 0x0200, bDeviceClass: 0, bDeviceSubClass: 0,
                bDeviceProtocol: 0, bMaxPacketSize0: 64,
                idVendor: 0, idProduct: 0, bcdDevice: 0,
                iManufacturer: 0, iProduct: 0, iSerialNumber: 0,
                bNumConfigurations: 1,
            };
            return Result::Ok(desc);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Set Device Address
// ─────────────────────────────────────────────────────────────

fn usb_set_address(
    state: Handle(UsbDriverState),
    device_idx: u64,
    new_address: u8,
    xfer_cap: UsbCapability,
    timestamp: u64,
) -> Result(void, UsbError)
    effect [memory:mmio, deterministic, residual]
{
    let result: Result(u64, UsbError) = usb_control_transfer(
        state, device_idx,
        0x00,  // Host-to-device, standard, dev
        UsbRequestCode::SetAddress as u8,
        new_address as u16,
        0, 0, 0, xfer_cap, timestamp,
    );
    match result {
        Result::Ok(_) => {
            state.devices[device_idx].address = new_address;
            state.devices[device_idx].state = UsbDeviceState::Addressed;
            residual emit {
                op: "usb.set_address",
                device_idx: device_idx,
                address: new_address as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// HID Device Discovery
// ─────────────────────────────────────────────────────────────

fn usb_discover_hid_devices(
    state: Handle(UsbDriverState),
    xfer_cap: UsbCapability,
    timestamp: u64,
) -> u64
    effect [memory:mmio, deterministic, residual]
    court "usb_discover_hid:v1"
{
    let mut hid_count: u64 = 0;

    loop bound 32 {
        if hid_count >= state.device_count {
            break;
        };
        let i: u64 = hid_count;
        let dev: Handle(UsbDevice) = Handle(UsbDevice)::from_ptr(&state.devices[i]);

        if usb_is_hid_device(dev) {
            // Get HID descriptor from interface
            let iface_idx: u64 = 0;
            loop bound 8 {
                if iface_idx >= dev.interface_count {
                    break;
                };
                let iface: UsbInterfaceDescriptor = dev.interfaces[iface_idx];
                if iface.bInterfaceClass == 0x03 {
                    state.devices[i].is_hid = true;
                    hid_count = hid_count + 1;

                    residual emit {
                        op: "usb.hid_device_found",
                        device_idx: i,
                        vendor: dev.descriptor.idVendor as u64,
                        product: dev.descriptor.idProduct as u64,
                        iface_num: iface.bInterfaceNumber as u64,
                        subclass: iface.bInterfaceSubClass as u64,
                        protocol: iface.bInterfaceProtocol as u64,
                        timestamp: timestamp,
                    };

                    break;
                };
            };
        };
    };

    return hid_count;
}

// ─────────────────────────────────────────────────────────────
// Scan XHCI Ports for Connected Devices
// ─────────────────────────────────────────────────────────────

fn usb_scan_xhci_ports(
    state: Handle(UsbDriverState),
    controller_idx: u64,
    enum_cap: UsbCapability,
    timestamp: u64,
) -> u64
    effect [memory:mmio, deterministic, residual]
    court "usb_scan_xhci:v1"
{
    if controller_idx >= state.controller_count {
        return 0;
    };

    let hc: HostController = state.controllers[controller_idx];
    if !hc.operational || hc.hc_type != HcType::Xhci {
        return 0;
    };

    let mut devices_found: u64 = 0;
    let xhci: XhciRegisters = XhciRegisters { mmio_base: hc.mmio_base };
    let caplength: u8 = hc.xhci_cap_length;
    let port_reg_base: u64 = (caplength as u64) + 0x400;

    loop bound 256 {
        let port: u8 = devices_found as u8;
        if port >= hc.xhci_max_ports {
            break;
        };

        let portsc_offset: u64 = port_reg_base + (port as u64) * 0x10;
        let portsc: u32 = xhci.read32(portsc_offset);

        if (portsc & 0x01) != 0 {  // Port connected
            let speed_code: u32 = (portsc >> 10) & 0x0F;
            let speed: UsbSpeed;
            match speed_code {
                1 => speed = UsbSpeed::LowSpeed,
                2 => speed = UsbSpeed::FullSpeed,
                3 => speed = UsbSpeed::HighSpeed,
                4 => speed = UsbSpeed::SuperSpeed,
                _ => speed = UsbSpeed::FullSpeed,
            };

            // Reset port
            let _ = xhci_port_reset(
                Handle(HostController)::from_ptr(&state.controllers[controller_idx]),
                port, timestamp,
            );

            // Enumerate device
            let result: Result(u64, UsbError) = usb_enumerate_device(
                state, controller_idx, port, speed, enum_cap, timestamp,
            );
            match result {
                Result::Ok(_) => { devices_found = devices_found + 1; },
                Result::Err(_) => {},
            };
        };
    };

    return devices_found;
}

// ─────────────────────────────────────────────────────────────
// Record USB Driver Residual
// ─────────────────────────────────────────────────────────────

fn usb_record_residuals(
    state: Handle(UsbDriverState),
    timestamp: u64,
) -> void
    effect [residual]
    court "usb_record_residuals:v1"
{
    residual emit {
        op: "usb_driver.state_summary",
        initialized: if state.initialized { 1 } else { 0 },
        controllers: state.controller_count,
        devices: state.device_count,
        timestamp: timestamp,
    };
}

// ─────────────────────────────────────────────────────────────
// Bulk Transfer (simplified)
// ─────────────────────────────────────────────────────────────

fn usb_bulk_transfer(
    state: Handle(UsbDriverState),
    device_idx: u64,
    endpoint: u8,
    data_buffer: u64,
    data_length: u64,
    direction: UsbEndpointDir,
    xfer_cap: UsbCapability,
    timestamp: u64,
) -> Result(u64, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "usb_bulk_xfer:v1"
{
    if device_idx >= state.device_count {
        return Result::Err(UsbError::UsbDeviceNotFound);
    };

    if !xfer_cap.can_bulk {
        return Result::Err(UsbError::UsbCapabilityError);
    };

    if state.devices[device_idx].state != UsbDeviceState::Configured {
        return Result::Err(UsbError::UsbDeviceNotFound);
    };

    residual emit {
        op: "usb.bulk_transfer",
        device_idx: device_idx,
        endpoint: endpoint as u64,
        length: data_length,
        direction: direction as u64,
        timestamp: timestamp,
    };

    return Result::Ok(data_length);
}

// ─────────────────────────────────────────────────────────────
// Interrupt Transfer (simplified)
// ─────────────────────────────────────────────────────────────

fn usb_interrupt_transfer(
    state: Handle(UsbDriverState),
    device_idx: u64,
    endpoint: u8,
    data_buffer: u64,
    data_length: u64,
    xfer_cap: UsbCapability,
    timestamp: u64,
) -> Result(u64, UsbError)
    effect [memory:mmio, deterministic, residual]
    court "usb_int_xfer:v1"
{
    if device_idx >= state.device_count {
        return Result::Err(UsbError::UsbDeviceNotFound);
    };

    if !xfer_cap.can_interrupt {
        return Result::Err(UsbError::UsbCapabilityError);
    };

    residual emit {
        op: "usb.interrupt_transfer",
        device_idx: device_idx,
        endpoint: endpoint as u64,
        length: data_length,
        timestamp: timestamp,
    };

    return Result::Ok(data_length);
}
