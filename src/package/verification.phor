// verification.phor — Package verifier: 11-check verification, rejection conditions
// Phorensic Package: verification subsystem
// Spec: SEALED_PACKAGE_FORMAT.md — Package Verification (11 conditions)
// Grammar: PHORENSIC_GRAMMAR.md §42, §66

package package.verification;

use forensic_store.store_object::{
    Hash256, hash256_zero, hash256_equal,
    TrustState, TrustLevel,
    Identity, identity_equal, identity_is_valid,
    Signature, AuditorStamp,
    StageReceipt, ResidualRecord, ResidualHistory,
};
use forensic_store.store_key::{
    StoreKey, store_key_equal, store_key_zero,
};
use package.container::{
    PackageContainer, PackageHeader, SourceEvidence,
    BuildEvidence, BinaryEvidence, SourceToBinarySeal,
    ExpansionEvidence, CompilationEvidence,
    ReplayEvidence, CourtEvidence, PackageSignatures,
    ObjectVerdict, ReplayStatus, ReplayVerdict,
};

// ============================================================================
// Verification Check Types
// ============================================================================

/// Result of a single package verification check.
type PkgCheckResult = enum {
    Pass = 0,
    Fail = 1,
    Skip = 2,
    Warning = 3,
}

/// A single package verification check.
struct PkgVerificationCheck
    layout packed
{
    /// Check number (1-11)
    check_number: u32,
    /// Check name
    check_name: Array[u8, 64],
    check_name_len: u32,
    /// Check description
    description: Array[u8, 256],
    description_len: u32,
    /// Result
    result: PkgCheckResult,
    /// Failure reason
    failure_reason: Array[u8, 512],
    failure_reason_len: u32,
}

// ============================================================================
// Package Verification Report
// ============================================================================

/// Complete package verification report.
struct PkgVerificationReport
    layout packed
{
    /// The package that was verified
    package_name: Array[u8, 128],
    package_name_len: u32,
    /// Package version
    package_version: Array[u8, 32],
    package_version_len: u32,
    /// Overall verification result
    result: PkgVerificationResult,
    /// All 11 checks
    checks: Array[PkgVerificationCheck, 11],
    check_count: u32,
    /// Pass count
    passed: u32,
    /// Fail count
    failed: u32,
    /// Skip count
    skipped: u32,
    /// Warning count
    warnings: u32,
    /// Verifier identity
    verifier: Identity,
    /// Timestamp
    verified_at: u64,
    /// Whether the package is quarantine-recommended
    quarantine_recommended: bool,
    /// Overall failure reason
    failure_summary: Array[u8, 512],
    failure_summary_len: u32,
}

/// Overall verification result.
type PkgVerificationResult = enum {
    /// All checks passed — package is valid
    Verified = 0,
    /// All critical checks passed, warnings present
    VerifiedWithWarnings = 1,
    /// Some checks failed — package is rejected
    Rejected = 2,
    /// Verification could not complete
    Incomplete = 3,
}

// ============================================================================
// Report Construction
// ============================================================================

/// Create a new package verification report.
fn pkg_verification_report_new(
    name: Array[u8, 128],
    name_len: u32,
    version: Array[u8, 32],
    version_len: u32,
    verifier: Identity,
    timestamp: u64,
) -> PkgVerificationReport
    effect [compute]
{
    return PkgVerificationReport {
        package_name: name,
        package_name_len: name_len,
        package_version: version,
        package_version_len: version_len,
        result: PkgVerificationResult::Incomplete,
        checks: Array[PkgVerificationCheck, 11]::zeroed(),
        check_count: 0,
        passed: 0,
        failed: 0,
        skipped: 0,
        warnings: 0,
        verifier: verifier,
        verified_at: timestamp,
        quarantine_recommended: false,
        failure_summary: Array[u8, 512]::zeroed(),
        failure_summary_len: 0,
    };
}

/// Add a check result to the report.
fn pkg_report_add_check(
    report: PkgVerificationReport,
    check: PkgVerificationCheck,
) -> PkgVerificationReport
    effect [compute]
{
    let mut new_report: PkgVerificationReport = report;
    if new_report.check_count < 11 {
        new_report.checks[new_report.check_count] = check;
        new_report.check_count = new_report.check_count + 1;
        match check.result {
            PkgCheckResult::Pass => {
                new_report.passed = new_report.passed + 1;
            },
            PkgCheckResult::Fail => {
                new_report.failed = new_report.failed + 1;
            },
            PkgCheckResult::Skip => {
                new_report.skipped = new_report.skipped + 1;
            },
            PkgCheckResult::Warning => {
                new_report.warnings = new_report.warnings + 1;
            },
        }
    }
    return new_report;
}

/// Finalize a verification report.
fn pkg_report_finalize(
    report: PkgVerificationReport,
) -> PkgVerificationReport
    effect [compute, residual]
{
    let result: PkgVerificationResult;
    let quarantine: bool;
    let summary: Array[u8, 512] = Array[u8, 512]::zeroed();
    let mut summary_len: u32 = 0;

    if report.failed > 0 {
        result = PkgVerificationResult::Rejected;
        quarantine = true;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Package rejected: some verification checks failed");
        for i in 0..57 { summary[i] = msg[i]; }
        summary_len = 57;
    } else if report.warnings > 0 {
        result = PkgVerificationResult::VerifiedWithWarnings;
        quarantine = false;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Package verified with warnings");
        for i in 0..32 { summary[i] = msg[i]; }
        summary_len = 32;
    } else {
        result = PkgVerificationResult::Verified;
        quarantine = false;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Package verified: all checks passed");
        for i in 0..40 { summary[i] = msg[i]; }
        summary_len = 40;
    }

    residual emit {
        op: "pkg_verification.finalize",
        result: result as u64,
        passed: report.passed,
        failed: report.failed,
    };

    return PkgVerificationReport {
        package_name: report.package_name,
        package_name_len: report.package_name_len,
        package_version: report.package_version,
        package_version_len: report.package_version_len,
        result: result,
        checks: report.checks,
        check_count: report.check_count,
        passed: report.passed,
        failed: report.failed,
        skipped: report.skipped,
        warnings: report.warnings,
        verifier: report.verifier,
        verified_at: report.verified_at,
        quarantine_recommended: quarantine,
        failure_summary: summary,
        failure_summary_len: summary_len,
    };
}

// ============================================================================
// Check 1: Source Evidence Present
// ============================================================================

fn check_source_present(pkg: PackageContainer) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("source_evidence_present");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Source evidence section must be present and non-empty");
    let ok: bool = pkg.source_evidence.manifest_count > 0 &&
                   !hash256_is_zero(pkg.source_evidence.source_hash);
    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let fail_len: u32 = 0;

    if ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Source evidence is missing or empty — mandatory per source-seal rule");
        for i in 0..75 { fail_detail[i] = msg[i]; }
        fail_len = 75;
    }

    residual emit { op: "pkg_check.1.source_present", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 1,
        check_name: name, check_name_len: 23,
        description: desc, description_len: 65,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

// ============================================================================
// Check 2: Source Hash Match
// ============================================================================

fn check_source_hash(pkg: PackageContainer) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("source_hash_match");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Source hash in header matches the source evidence hash");
    let ok: bool = hash256_equal(pkg.header.source_hash, pkg.source_evidence.source_hash);
    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let fail_len: u32 = 0;

    if ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Source hash mismatch: header hash != source evidence hash");
        for i in 0..62 { fail_detail[i] = msg[i]; }
        fail_len = 62;
    }

    residual emit { op: "pkg_check.2.source_hash", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 2, check_name: name, check_name_len: 17,
        description: desc, description_len: 72,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

