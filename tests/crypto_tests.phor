// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, CryptoError)
    effects: [compute, io:write, residual]
{
    console.write_line("Cryptography Tests")!;
    console.write_line("===================")!;

    // SHA-256 tests
    test_sha256_empty_string();
    console.write_line("  [PASS] SHA-256 empty string")!;
    test_sha256_abc();
    console.write_line("  [PASS] SHA-256 abc")!;
    test_sha256_long();
    console.write_line("  [PASS] SHA-256 long vector")!;

    // AES tests
    test_aes_encrypt_decrypt();
    console.write_line("  [PASS] AES encrypt/decrypt")!;
    test_aes_key_expansion();
    console.write_line("  [PASS] AES key expansion")!;

    // ChaCha20-Poly1305 tests
    test_chacha20_encrypt();
    console.write_line("  [PASS] ChaCha20 encrypt")!;
    test_poly1305_mac();
    console.write_line("  [PASS] Poly1305 MAC")!;

    // Curve25519 tests
    test_curve25519_keygen();
    console.write_line("  [PASS] Curve25519 keygen")!;

    // Ed25519 tests
    test_ed25519_sign_verify();
    console.write_line("  [PASS] Ed25519 sign/verify")!;

    // Merkle tree tests
    test_merkle_tree_build();
    console.write_line("  [PASS] Merkle tree build")!;
    test_merkle_proof();
    console.write_line("  [PASS] Merkle tree proof")!;

    // CSPRNG health tests
    test_csprng_health_basic();
    console.write_line("  [PASS] CSPRNG health basic")!;
    test_csprng_stuck_detection();
    console.write_line("  [PASS] CSPRNG stuck detection")!;

    residual emit {
        op: "crypto_tests.complete",
        sha256_tests: 3,
        aes_tests: 2,
        chacha_poly_tests: 2,
        curve25519_tests: 1,
        ed25519_tests: 1,
        merkle_tests: 2,
        csprng_tests: 2,
        total_tests: 13,
        result: "all_passed",
    };

    console.write_line("")!;
    console.write_line("All 13 cryptography tests passed!")!;
    return Ok(void);
}
