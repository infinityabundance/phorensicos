// forensic_browser.phor — Forensic evidence browser for store objects
//
// Demonstrates:
//   - Tree view of store objects with hierarchical navigation
//   - Residual history display with timeline navigation
//   - Provenance graph browser with parent/child traversal
//   - Trust state visualization across trust ladder
//   - Court verdict viewer with evidence chain display
//   - Source to binary seal verification display
//   - Depth-limited recursive tree traversal
//   - Fixed-capacity collections for all state
//   - Affine capability passing for store access
//
// Expected behavior:
//   - Browses store objects in a navigable tree hierarchy
//   - Displays residual records ordered by timestamp
//   - Shows provenance graph with ancestor/descendant links
//   - Visualizes trust state with ladder progression indicators
//   - Views court verdicts with full evidence chain
//   - Verifies source-to-binary seal integrity
//   - All operations bounded, effect-declared, residual-recorded
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:forensic_browser:v1.0";

const MAX_TREE_NODES: u64 = 512;
const MAX_CHILDREN_PER_NODE: u64 = 32;
const MAX_RESIDUALS: u64 = 256;
const MAX_PROVENANCE_CHAIN: u64 = 64;
const MAX_EVIDENCE_ITEMS: u64 = 32;
const MAX_SEAL_CHAIN: u64 = 16;
const MAX_TREE_DEPTH: u64 = 16;
const MAX_DISPLAY_LINES: u64 = 256;
const MAX_VERDICT_TEXT: u64 = 1024;
const MAX_SEAL_MAPPINGS: u64 = 64;
const MAX_TRUST_STEPS: u64 = 7;

enum TrustState : u8 {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

struct StoreNodeInfo {
    node_id: u64,
    name: Str(64),
    node_type: u8,
    size: u64,
    hash: u64,
    trust_state: TrustState,
    parent_id: u64,
    child_count: u64,
    children: Array(u64, 32),
    created: u64,
    modified: u64,
}

struct ResidualRecord {
    residual_id: u64,
    timestamp: u64,
    operation: Str(64),
    object_id: u64,
    details: Str(128),
    source_line: u32,
    source_file: Str(64),
}

struct ProvenanceLink {
    from_id: u64,
    to_id: u64,
    relation: Str(32),
    timestamp: u64,
    verified: bool,
}

struct EvidenceItem {
    item_id: u64,
    item_type: Str(32),
    item_hash: u64,
    description: Str(128),
    verified: bool,
}

struct CourtVerdictDisplay {
    session_id: u64,
    object_id: u64,
    verdict: u8,
    verdict_text: Str(64),
    trust_before: TrustState,
    trust_after: TrustState,
    evidence_items: Array(EvidenceItem, 32),
    evidence_count: u64,
    oracle_name: Str(32),
    comparison_type: u8,
    timestamp: u64,
    sealed: bool,
}

struct SealMapping {
    source_offset: u64,
    source_size: u64,
    source_hash: u64,
    binary_offset: u64,
    binary_size: u64,
    binary_hash: u64,
    rule_type: Str(16),
    verified: bool,
}

struct SealVerification {
    object_id: u64,
    source_hash: u64,
    binary_hash: u64,
    mappings: Array(SealMapping, 64),
    mapping_count: u64,
    seal_hash: u64,
    seal_algorithm: Str(16),
    all_verified: bool,
    signed_by: Str(64),
    auditor_count: u32,
}

struct BrowserViewState {
    root_node_id: u64,
    selected_node_id: u64,
    view_depth: u64,
    show_residuals: bool,
    show_provenance: bool,
    show_seal: bool,
    current_page: u64,
    detail_object: u64,
}

fn get_trust_state_name(state: TrustState) -> Str(16)
    effect [compute]
{
    match state {
        TrustState::Unknown => return Str::from("Unknown"),
        TrustState::Observed => return Str::from("Observed"),
        TrustState::Replayed => return Str::from("Replayed"),
        TrustState::OracleCompared => return Str::from("OracleCmp"),
        TrustState::ResidualStable => return Str::from("ResidualStable"),
        TrustState::Sealed => return Str::from("Sealed"),
        TrustState::Promoted => return Str::from("Promoted"),
        _ => return Str::from("Unknown"),
    }
}

fn render_trust_ladder(current: TrustState) -> Str(64)
    effect [compute]
{
    let labels: Array(Str(10), 7) = Array::splat(Str::from(""));
    labels[0] = Str::from("U");
    labels[1] = Str::from("O");
    labels[2] = Str::from("R");
    labels[3] = Str::from("OC");
    labels[4] = Str::from("RS");
    labels[5] = Str::from("S");
    labels[6] = Str::from("P");

    let mut result: Str(64) = Str::from("[");
    for i in 0..7 {
        let cur_val: u64 = current as u64;
        if i <= cur_val {
            result.append(labels[i]);
            if i < 6 {
                result.append(Str::from("="));
            }
        } else {
            result.append(Str::from("-"));
            if i < 6 {
                result.append(Str::from("-"));
            }
        }
    }
    result.append(Str::from("]"));
    return result;
}

fn fetch_tree_node(store: Cap(StoreNode), node_id: u64) -> StoreNodeInfo
    effect [io:read]
{
    let info: StoreNodeInfo = store.get_node_info(node_id);

    let children: Array(u64, 32) = store.get_children(node_id);
    let mut child_list: Array(u64, 32) = Array::splat(0);
    let mut child_count: u64 = 0;
    for i in 0..children.capacity() {
        if children[i] > 0 && child_count < 32 {
            child_list[child_count] = children[i];
            child_count = child_count + 1;
        }
    }

    info.children = child_list;
    info.child_count = child_count;
    return info;
}

fn render_tree_node(info: StoreNodeInfo, depth: u64, is_last: bool) -> Str(128)
    effect [compute]
{
    let mut line: Str(128) = Str::from("");
    for i in 0..depth {
        line.append(Str::from("  "));
    }

    let trust_name: Str(16) = get_trust_state_name(info.trust_state);
    line.append(info.name);
    line.append(Str::from(" ["));
    line.append(trust_name);
    line.append(Str::from("]"));
    if info.node_type == 1 {
        line.append(Str::from("/"));
    }
    line.append(Str::from(" ("));
    line.append(info.node_id as Str(16));
    line.append(Str::from(")"));
    return line;
}

fn build_tree_recursive(store: Cap(StoreNode), parent_id: u64, depth: u64, max_depth: u64,
                        mut lines: Array(Str(128), 256), mut line_count: u64) -> (Array(Str(128), 256), u64)
    effect [io:read]
{
    if depth > max_depth || depth > MAX_TREE_DEPTH {
        return (lines, line_count);
    }
    if line_count >= MAX_DISPLAY_LINES {
        return (lines, line_count);
    }

    let node: StoreNodeInfo = fetch_tree_node(store, parent_id);
    if node.node_id == 0 {
        return (lines, line_count);
    }

    let rendered: Str(128) = render_tree_node(node, depth, false);
    if line_count < MAX_DISPLAY_LINES {
        lines[line_count] = rendered;
        line_count = line_count + 1;
    }

    for i in 0..node.child_count {
        let child_id: u64 = node.children[i];
        let recursive_result: (Array(Str(128), 256), u64) =
            build_tree_recursive(store, child_id, depth + 1, max_depth, lines, line_count);
        lines = recursive_result.0;
        line_count = recursive_result.1;
        if line_count >= MAX_DISPLAY_LINES {
            break;
        }
    }

    return (lines, line_count);
}

fn fetch_residuals(store: Cap(StoreNode), object_id: u64, max_count: u64) -> Array(ResidualRecord, 256)
    effect [io:read]
{
    let records: Array(ResidualRecord, 256) = store.get_residuals(object_id, max_count);
    return records;
}

fn display_residuals(residuals: Array(ResidualRecord, 256), console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Residual History ===\n"));
    for i in 0..residuals.capacity() {
        let rec: ResidualRecord = residuals[i];
        if rec.residual_id == 0 { continue; }
        let mut line: Str(256) = Str::from("");
        line.append(rec.timestamp as Str(16));
        line.append(Str::from("  "));
        line.append(rec.operation);
        line.append(Str::from("  obj:"));
        line.append(rec.object_id as Str(16));
        line.append(Str::from("  "));
        line.append(rec.details);
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn build_provenance_chain(store: Cap(StoreNode), object_id: u64, max_steps: u64) -> Array(ProvenanceLink, 64)
    effect [io:read]
{
    let chain: Array(ProvenanceLink, 64) = store.get_provenance_chain(object_id, max_steps);
    return chain;
}

fn display_provenance(chain: Array(ProvenanceLink, 64), console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Provenance Graph ===\n"));
    for i in 0..chain.capacity() {
        let link: ProvenanceLink = chain[i];
        if link.from_id == 0 && link.to_id == 0 { continue; }
        let mut line: Str(256) = Str::from("");
        line.append(link.from_id as Str(16));
        line.append(Str::from(" --["));
        line.append(link.relation);
        line.append(Str::from("]--> "));
        line.append(link.to_id as Str(16));
        if link.verified {
            line.append(Str::from(" [verified]"));
        } else {
            line.append(Str::from(" [unverified]"));
        }
        line.append(Str::from(" @ "));
        line.append(link.timestamp as Str(16));
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn fetch_verdict(store: Cap(StoreNode), object_id: u64) -> CourtVerdictDisplay
    effect [io:read, court:request]
{
    let verdict_raw: CourtVerdictDisplay = store.get_court_verdict(object_id);
    let evidence: Array(EvidenceItem, 32) = store.get_evidence_items(verdict_raw.session_id);

    let mut ev_items: Array(EvidenceItem, 32) = Array::splat(
        EvidenceItem{ item_id: 0, item_type: Str::from(""), item_hash: 0,
                      description: Str::from(""), verified: false }
    );
    let mut ev_count: u64 = 0;
    for i in 0..evidence.capacity() {
        if evidence[i].item_id > 0 && ev_count < 32 {
            ev_items[ev_count] = evidence[i];
            ev_count = ev_count + 1;
        }
    }

    verdict_raw.evidence_items = ev_items;
    verdict_raw.evidence_count = ev_count;
    return verdict_raw;
}

fn display_verdict(verdict: CourtVerdictDisplay, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Court Verdict ===\n"));
    let mut line1: Str(256) = Str::from("Session: ");
    line1.append(verdict.session_id as Str(16));
    line1.append(Str::from("  Object: "));
    line1.append(verdict.object_id as Str(16));
    line1.append(Str::from("\n"));
    console.write(line1);

    let mut line2: Str(256) = Str::from("Verdict: ");
    line2.append(verdict.verdict_text);
    line2.append(Str::from("  Oracle: "));
    line2.append(verdict.oracle_name);
    line2.append(Str::from("\n"));
    console.write(line2);

    let trust_before: Str(16) = get_trust_state_name(verdict.trust_before);
    let trust_after: Str(16) = get_trust_state_name(verdict.trust_after);
    let mut line3: Str(256) = Str::from("Trust: ");
    line3.append(trust_before);
    line3.append(Str::from(" -> "));
    line3.append(trust_after);
    line3.append(Str::from("\n"));
    console.write(line3);

    let ladder: Str(64) = render_trust_ladder(verdict.trust_after);
    let mut line4: Str(256) = Str::from("Ladder: ");
    line4.append(ladder);
    line4.append(Str::from("\n"));
    console.write(line4);

    console.write(Str::from("Evidence items:\n"));
    for i in 0..verdict.evidence_count {
        let item: EvidenceItem = verdict.evidence_items[i];
        let mut ev_line: Str(256) = Str::from("  [");
        if item.verified { ev_line.append(Str::from("OK")); }
        else { ev_line.append(Str::from("--")); }
        ev_line.append(Str::from("] "));
        ev_line.append(item.item_type);
        ev_line.append(Str::from(": "));
        ev_line.append(item.description);
        ev_line.append(Str::from(" ("));
        ev_line.append(item.item_hash as Str(16));
        ev_line.append(Str::from(")\n"));
        console.write(ev_line);
    }

    if verdict.sealed {
        console.write(Str::from("Session sealed: yes\n"));
    } else {
        console.write(Str::from("Session sealed: no\n"));
    }
}

fn fetch_seal_verification(store: Cap(StoreNode), object_id: u64) -> SealVerification
    effect [io:read]
{
    let seal: SealVerification = store.get_seal_verification(object_id);
    let mappings: Array(SealMapping, 64) = store.get_seal_mappings(object_id);

    let mut mapping_list: Array(SealMapping, 64) = Array::splat(
        SealMapping{ source_offset: 0, source_size: 0, source_hash: 0,
                     binary_offset: 0, binary_size: 0, binary_hash: 0,
                     rule_type: Str::from(""), verified: false }
    );
    let mut map_count: u64 = 0;
    for i in 0..mappings.capacity() {
        if mappings[i].source_hash > 0 && map_count < 64 {
            mapping_list[map_count] = mappings[i];
            map_count = map_count + 1;
        }
    }

    seal.mappings = mapping_list;
    seal.mapping_count = map_count;

    let mut all_ok: bool = true;
    for i in 0..map_count {
        if !seal.mappings[i].verified {
            all_ok = false;
            break;
        }
    }
    seal.all_verified = all_ok;
    return seal;
}

fn display_seal_verification(seal: SealVerification, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Source to Binary Seal Verification ===\n"));
    let mut line1: Str(256) = Str::from("Object: ");
    line1.append(seal.object_id as Str(16));
    line1.append(Str::from("  Algorithm: "));
    line1.append(seal.seal_algorithm);
    line1.append(Str::from("\n"));
    console.write(line1);

    let mut line2: Str(256) = Str::from("Source hash: ");
    line2.append(seal.source_hash as Str(16));
    line2.append(Str::from("  Binary hash: "));
    line2.append(seal.binary_hash as Str(16));
    line2.append(Str::from("\n"));
    console.write(line2);

    let mut line3: Str(256) = Str::from("Seal hash: ");
    line3.append(seal.seal_hash as Str(16));
    line3.append(Str::from("  Signed by: "));
    line3.append(seal.signed_by);
    line3.append(Str::from("\n"));
    console.write(line3);

    let mut line4: Str(256) = Str::from("Overall status: ");
    if seal.all_verified {
        line4.append(Str::from("VERIFIED"));
    } else {
        line4.append(Str::from("UNVERIFIED"));
    }
    line4.append(Str::from("  Auditors: "));
    line4.append(seal.auditor_count as Str(16));
    line4.append(Str::from("\n"));
    console.write(line4);

    console.write(Str::from("Source-to-Binary Mappings:\n"));
    let header: Str(128) = Str::from("  Offset  Size  Hash              Rule\n");
    console.write(header);

    for i in 0..seal.mapping_count {
        let m: SealMapping = seal.mappings[i];
        let mut mline: Str(256) = Str::from("  ");
        if m.verified { mline.append(Str::from("[OK]")); }
        else { mline.append(Str::from("[!!]")); }
        mline.append(Str::from(" "));
        mline.append(m.source_offset as Str(16));
        mline.append(Str::from("/"));
        mline.append(m.source_size as Str(16));
        mline.append(Str::from(" -> "));
        mline.append(m.binary_offset as Str(16));
        mline.append(Str::from("/"));
        mline.append(m.binary_size as Str(16));
        mline.append(Str::from("  "));
        mline.append(m.rule_type);
        mline.append(Str::from("\n"));
        console.write(mline);
    }
}

fn select_node(store: Cap(StoreNode), current_id: u64, direction: i8, mut state: BrowserViewState) -> BrowserViewState
    effect [io:read]
{
    let node: StoreNodeInfo = fetch_tree_node(store, current_id);
    if direction > 0 && node.child_count > 0 {
        state.selected_node_id = node.children[0];
    } else if direction < 0 {
        state.selected_node_id = node.parent_id;
    }
    return state;
}

fn browse_tab_complete(store: Cap(StoreNode), prefix: Str(64), current_id: u64) -> Array(u64, 32)
    effect [io:read]
{
    let node: StoreNodeInfo = fetch_tree_node(store, current_id);
    let mut matches: Array(u64, 32) = Array::splat(0);
    let mut match_count: u64 = 0;

    for i in 0..node.child_count {
        let child_id: u64 = node.children[i];
        let child: StoreNodeInfo = fetch_tree_node(store, child_id);
        let mut matches_prefix: bool = true;
        for j in 0..prefix.len() {
            if j >= child.name.len() || child.name[j] != prefix[j] {
                matches_prefix = false;
                break;
            }
        }
        if matches_prefix && match_count < 32 {
            matches[match_count] = child_id;
            match_count = match_count + 1;
        }
    }
    return matches;
}

fn display_trust_summary(store: Cap(StoreNode), root_id: u64, console: Cap(Console)) -> void
    effect [io:read, io:write]
{
    let mut trust_counts: Array(u64, 7) = Array::splat(0);
    let trust_labels: Array(Str(12), 7) = Array::splat(Str::from(""));
    trust_labels[0] = Str::from("Unknown");
    trust_labels[1] = Str::from("Observed");
    trust_labels[2] = Str::from("Replayed");
    trust_labels[3] = Str::from("OracleCompared");
    trust_labels[4] = Str::from("ResidualStable");
    trust_labels[5] = Str::from("Sealed");
    trust_labels[6] = Str::from("Promoted");

    console.write(Str::from("=== Trust State Distribution ===\n"));
    for i in 0..7 {
        let trust_val: TrustState = i as TrustState;
        let mut line: Str(256) = Str::from("");
        line.append(trust_labels[i]);
        line.append(Str::from(": "));
        line.append(trust_counts[i] as Str(16));
        line.append(Str::from("\n"));
        console.write(line);
    }
}

fn view_residual_detail(store: Cap(StoreNode), residual_id: u64, console: Cap(Console)) -> void
    effect [io:read, io:write]
{
    let detail: ResidualRecord = store.get_residual_detail(residual_id);
    let mut line: Str(512) = Str::from("=== Residual Detail ===\n");
    line.append(Str::from("ID: "));
    line.append(detail.residual_id as Str(16));
    line.append(Str::from("\nTimestamp: "));
    line.append(detail.timestamp as Str(16));
    line.append(Str::from("\nOperation: "));
    line.append(detail.operation);
    line.append(Str::from("\nObject: "));
    line.append(detail.object_id as Str(16));
    line.append(Str::from("\nSource: "));
    line.append(detail.source_file);
    line.append(Str::from(":"));
    line.append(detail.source_line as Str(16));
    line.append(Str::from("\nDetails: "));
    line.append(detail.details);
    line.append(Str::from("\n"));
    console.write(line);
}

fn export_evidence_chain(store: Cap(StoreNode), verdict: CourtVerdictDisplay, console: Cap(Console)) -> void
    effect [io:read, io:write, residual]
{
    console.write(Str::from("=== Evidence Chain Export ===\n"));
    console.write(Str::from("Format: court-evidence/v1\n"));

    for i in 0..verdict.evidence_count {
        let item: EvidenceItem = verdict.evidence_items[i];
        let mut line: Str(256) = Str::from("");
        line.append(Str::from("evidence { id: "));
        line.append(item.item_id as Str(16));
        line.append(Str::from(", type: \""));
        line.append(item.item_type);
        line.append(Str::from("\", hash: "));
        line.append(item.item_hash as Str(16));
        line.append(Str::from(", verified: "));
        if item.verified { line.append(Str::from("true")); }
        else { line.append(Str::from("false")); }
        line.append(Str::from(" }"));
        line.append(Str::from("\n"));
        console.write(line);
    }

    residual emit {
        op: "forensic_browser.export_chain",
        object: verdict.object_id,
        evidence: verdict.evidence_count,
        verdict: verdict.verdict,
    };
}

fn compare_trust_states(before: TrustState, after: TrustState, console: Cap(Console)) -> void
    effect [io:write]
{
    let mut line: Str(256) = Str::from("Trust promotion: ");
    line.append(get_trust_state_name(before));
    line.append(Str::from(" -> "));
    line.append(get_trust_state_name(after));
    line.append(Str::from("  "));

    let before_val: u64 = before as u64;
    let after_val: u64 = after as u64;
    if after_val > before_val {
        line.append(Str::from("(promoted)"));
    } else if after_val == before_val {
        line.append(Str::from("(unchanged)"));
    } else {
        line.append(Str::from("(DEMOTED!)"));
    }
    line.append(Str::from("\n"));
    console.write(line);
}

fn verify_seal_chain(seal: SealVerification, console: Cap(Console)) -> bool
    effect [io:write]
{
    let all_ok: bool = seal.all_verified;
    if all_ok {
        console.write(Str::from("Seal chain: INTACT\n"));
    } else {
        console.write(Str::from("Seal chain: BROKEN\n"));
        for i in 0..seal.mapping_count {
            if !seal.mappings[i].verified {
                let mut line: Str(256) = Str::from("  Broken mapping: ");
                line.append(seal.mappings[i].source_offset as Str(16));
                line.append(Str::from(" -> "));
                line.append(seal.mappings[i].binary_offset as Str(16));
                line.append(Str::from("\n"));
                console.write(line);
            }
        }
    }
    return all_ok;
}

fn render_trust_histogram(states: Array(TrustState, 32), console: Cap(Console)) -> void
    effect [io:write]
{
    let dist: Array(u64, 7) = Array::splat(0);
    for i in 0..states.capacity() {
        let s: TrustState = states[i];
        if s == TrustState::Unknown && i > 0 { break; }
        let idx: u64 = s as u64;
        if idx < 7 {
            dist[idx] = dist[idx] + 1;
        }
    }

    let labels: Array(Str(12), 7) = Array::splat(Str::from(""));
    labels[0] = Str::from("Unknown");
    labels[1] = Str::from("Observed");
    labels[2] = Str::from("Replayed");
    labels[3] = Str::from("Oracle");
    labels[4] = Str::from("ResidStab");
    labels[5] = Str::from("Sealed");
    labels[6] = Str::from("Promoted");

    for i in 0..7 {
        if dist[i] > 0 {
            let mut line: Str(128) = Str::from("  ");
            line.append(labels[i]);
            line.append(Str::from(": "));
            line.append(dist[i] as Str(16));
            line.append(Str::from(" "));
            let bar_len: u64 = dist[i];
            for j in 0..bar_len {
                if j >= 20 { break; }
                line.append(Str::from("#"));
            }
            line.append(Str::from("\n"));
            console.write(line);
        }
    }
}

fn main(console: Cap(Console), store: Cap(StoreNode)) -> void
    effect [io:write, io:read, court:request, residual]
{
    console.write(Str::from("Forensic Evidence Browser v1.0\n"));
    console.write(Str::from("================================\n"));

    // Step 1: Display tree view starting from root
    console.write(Str::from("\n--- Store Object Tree ---\n"));
    let root_id: u64 = 1;
    let mut tree_lines: Array(Str(128), 256) = Array::splat(Str::from(""));
    let mut line_count: u64 = 0;
    let tree_result: (Array(Str(128), 256), u64) = build_tree_recursive(store, root_id, 0, 4, tree_lines, line_count);
    tree_lines = tree_result.0;
    line_count = tree_result.1;

    for i in 0..line_count {
        console.write(tree_lines[i]);
        console.write(Str::from("\n"));
    }
    assert(line_count > 0, "fb: tree has nodes");

    // Step 2: Fetch and display residuals for root node
    console.write(Str::from("\n--- Residual History for Root ---\n"));
    let residuals: Array(ResidualRecord, 256) = fetch_residuals(store, root_id, 10);
    display_residuals(residuals, console);
    assert(residuals.len() > 0, "fb: residuals exist");

    // Step 3: Build and display provenance chain
    console.write(Str::from("\n--- Provenance Graph for Root ---\n"));
    let provenance: Array(ProvenanceLink, 64) = build_provenance_chain(store, root_id, 10);
    display_provenance(provenance, console);
    assert(provenance.len() > 0, "fb: provenance chain exists");

    // Step 4: Display trust state distribution
    console.write(Str::from("\n--- Trust State Distribution ---\n"));
    display_trust_summary(store, root_id, console);

    // Step 5: Fetch and display court verdict
    console.write(Str::from("\n--- Court Verdict for Object 1 ---\n"));
    let verdict: CourtVerdictDisplay = fetch_verdict(store, 1);
    display_verdict(verdict, console);
    assert(verdict.session_id > 0, "fb: court verdict exists");

    // Step 6: Display seal verification
    console.write(Str::from("\n--- Seal Verification for Object 1 ---\n"));
    let seal: SealVerification = fetch_seal_verification(store, 1);
    display_seal_verification(seal, console);
    assert(seal.mapping_count > 0, "fb: seal mappings exist");

    // Step 7: Verify seal chain integrity
    console.write(Str::from("\n--- Seal Chain Verification ---\n"));
    let seal_intact: bool = verify_seal_chain(seal, console);
    assert(seal_intact, "fb: seal chain intact");

    // Step 8: Export evidence chain
    console.write(Str::from("\n--- Evidence Chain Export ---\n"));
    export_evidence_chain(store, verdict, console);

    // Step 9: Compare trust states
    console.write(Str::from("\n--- Trust Promotion ---\n"));
    compare_trust_states(TrustState::Observed, TrustState::Promoted, console);

    // Step 10: View residual detail
    console.write(Str::from("\n--- Residual Detail ---\n"));
    view_residual_detail(store, 1, console);

    // Step 11: Node selection simulation
    let state: BrowserViewState = BrowserViewState{
        root_node_id: root_id,
        selected_node_id: root_id,
        view_depth: 4,
        show_residuals: true,
        show_provenance: true,
        show_seal: true,
        current_page: 0,
        detail_object: 1,
    };
    let new_state: BrowserViewState = select_node(store, root_id, 1, state);
    assert(new_state.selected_node_id > 0, "fb: node selection works");

    // Step 12: Tab completion simulation
    let completions: Array(u64, 32) = browse_tab_complete(store, Str::from("sys"), root_id);

    // Step 13: Trust histogram
    console.write(Str::from("\n--- Trust State Histogram ---\n"));
    let states_sample: Array(TrustState, 32) = Array::splat(TrustState::Unknown);
    states_sample[0] = TrustState::Promoted;
    states_sample[1] = TrustState::Sealed;
    states_sample[2] = TrustState::Observed;
    states_sample[3] = TrustState::Sealed;
    states_sample[4] = TrustState::Unknown;
    render_trust_histogram(states_sample, console);

    // Final verification
    console.write(Str::from("\n=== All forensic browser displays complete ===\n"));

    residual emit {
        op: "forensic_browser.complete",
        tree_nodes: line_count,
        residual_count: residuals.len(),
        provenance_links: provenance.len(),
        evidence_items: verdict.evidence_count,
        seal_mappings: seal.mapping_count,
        seal_valid: if seal_intact { 1 } else { 0 },
    };

    assert(line_count > 0, "fb: tree displayed");
    assert(seal_intact, "fb: final seal integrity");
    assert(verdict.evidence_count > 0, "fb: evidence displayed");
}
