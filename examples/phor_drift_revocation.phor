// phor_drift_revocation.phor — Trust Drift Detection & Driver Revocation
//
// Demonstrates:
//   - Trust drift detection on active drivers
//   - Driver revocation on trust violation
//   - Court-mandated re-verification flow
//   - Bounded trust history tracking
//   - Residual emission on revocation events
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:phor_drift_revocation:v1.0";

// ── Constants ───────────────────────────────────────────

const MAX_TRUST_HISTORY: u64 = 8;
const MAX_DRIVERS: u64 = 16;
const MIN_TRUST_FOR_ACTIVE: u8 = 5;

// ── Trust Levels ───────────────────────────────────────

type TrustLevel = u8;

const TRUST_UNKNOWN: TrustLevel = 0;
const TRUST_SEALED: TrustLevel = 5;

// ── Driver States ──────────────────────────────────────

type DrvState = u8;

const STATE_UNLOADED: DrvState = 0;
const STATE_LOADED: DrvState = 1;
const STATE_INITIALIZED: DrvState = 2;
const STATE_ACTIVE: DrvState = 3;
const STATE_REVOKED: DrvState = 5;

// ── Trust Record ───────────────────────────────────────

struct TrustRecord {
    recorded_tick: u64,
    trust_level: TrustLevel,
    passed: bool,
}

impl TrustRecord {
    fn new(tick: u64, level: TrustLevel, ok: bool) -> TrustRecord
        effect [compute]
    {
        return TrustRecord {
            recorded_tick: tick,
            trust_level: level,
            passed: ok,
        };
    }
}

// ── Trust Monitor ──────────────────────────────────────

struct TrustMonitor {
    trust_history: Array(TrustRecord, 8),
    history_count: u64,
    current_trust: TrustLevel,
    drift_count: u64,
    revoked: bool,
}

impl TrustMonitor {
    fn new() -> TrustMonitor
        effect [compute]
    {
        return TrustMonitor {
            trust_history: Array::splat_zeroed(),
            history_count: 0,
            current_trust: TRUST_UNKNOWN,
            drift_count: 0,
            revoked: false,
        };
    }

    fn record_check(mut self, tick: u64, level: TrustLevel, passed: bool) -> TrustMonitor
        effect [compute, residual]
    {
        if self.history_count < MAX_TRUST_HISTORY {
            self.trust_history[self.history_count] = TrustRecord::new(tick, level, passed);
            self.history_count = self.history_count + 1;
        }
        self.current_trust = level;

        if !passed {
            self.drift_count = self.drift_count + 1;
            self.revoked = true;

            residual emit {
                op: "trust.drift_detected",
                tick: tick,
                level: level as u64,
                drift_count: self.drift_count,
            };
        }

        return self;
    }

    fn revoke(mut self) -> TrustMonitor
        effect [compute, residual]
    {
        self.revoked = true;

        residual emit {
            op: "trust.revoked",
            drift_count: self.drift_count,
        };

        return self;
    }

    fn is_revoked(self) -> bool
        effect [compute]
    {
        return self.revoked;
    }

    fn drift_count(self) -> u64
        effect [compute]
    {
        return self.drift_count;
    }

    fn can_activate(self) -> bool
        effect [compute]
    {
        return !self.revoked && self.current_trust >= MIN_TRUST_FOR_ACTIVE;
    }
}

// ── Test ───────────────────────────────────────────────

fn test_revocation() -> bool
    effect [compute, residual]
{
    // Create trust monitor
    let mut monitor: TrustMonitor = TrustMonitor::new();
    assert(!monitor.is_revoked(), "drift: monitor starts clean");
    assert(monitor.drift_count() == 0, "drift: no drifts initially");

    // Record a passing check at Sealed level
    monitor = monitor.record_check(100, TRUST_SEALED, true);
    assert(!monitor.is_revoked(), "drift: still clean after passing check");
    assert(monitor.can_activate(), "drift: can activate after passing check");

    // Record a drift event
    monitor = monitor.record_check(200, TRUST_SEALED, false);
    assert(monitor.is_revoked(), "drift: revoked after failed check");
    assert(monitor.drift_count() == 1, "drift: 1 drift detected");
    assert(!monitor.can_activate(), "drift: cannot activate after revocation");

    // Revoke explicitly
    let mut monitor2: TrustMonitor = TrustMonitor::new();
    monitor2 = monitor2.record_check(100, TRUST_SEALED, true);
    assert(!monitor2.is_revoked(), "drift: second monitor clean");
    monitor2 = monitor2.revoke();
    assert(monitor2.is_revoked(), "drift: explicitly revoked");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute, residual]
{
    let passed: bool = test_revocation();
    assert(passed, "drift revocation: all tests pass");

    console.write(Str::from("Driver Trust Revocation:"));
    console.write(Str::from("  Trust monitor creation: PASS"));
    console.write(Str::from("  Passing trust check: PASS"));
    console.write(Str::from("  Drift detection and revocation: PASS"));
    console.write(Str::from("  Explicit revocation: PASS"));
    console.write(Str::from("  Activation gating after revocation: PASS"));
    console.write(Str::from("Drift revocation demo passed!"));
}
