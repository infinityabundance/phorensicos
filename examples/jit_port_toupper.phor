// jit_port_toupper.phor — first JIT-Porting Court target (native candidate)
//
// Clean-room native port of libc `toupper` (C locale, single byte), expressed in
// Phorensic and compiled by `phorc` to ELF64. This file is the *candidate source*
// bound into the sealed package
// (phost/evidence/porting/toupper/sealed_package.json: candidate_source_hash).
//
// Court flow (executed by phost::porting on the host):
//   foreign behavior → dialect cage → oracle traces → behavior signature
//   → native candidate → replay court → comparison → trust promotion
//   → sealed package → compiled-object execution court
//
// The candidate is written from the public C-locale specification and the
// observed traces — not from any foreign source.
//
// ABI — the executed entry point (see phost::porting::exec):
//   symbol `_phor_phor_toupper`; SysV AMD64: one u64 argument in RDI, result in
//   RAX. The folded byte is the low 8 bits of the result.
//   The function is a leaf: no calls, no relocations, no heap, no syscalls.
//
// Scope: API-surface JIT-porting (byte-in/byte-out). NOT arbitrary binary
// translation. The cage observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_toupper:v1.0";

// ── Target identity and domain ───────────────────────────

const DOMAIN: u64 = 256;        // the exhaustive corpus: 0x00..=0xff
const FIRST_LOWER: u64 = 97;    // 'a'
const LAST_LOWER: u64 = 122;    // 'z'
const LETTER_COUNT: u64 = 26;   // LAST_LOWER - FIRST_LOWER + 1
const CASE_DELTA: u64 = 32;     // 'a' - 'A'

// ── Target and evidence records ──────────────────────────
// These mirror the residuals the court seals for this target.

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    input_schema: Str(64),
    output_schema: Str(64),
}

struct ReplayVerdict {
    target: Str(32),
    cases_run: u64,
    cases_passed: u64,
    cases_failed: u64,
    verdict: u8,
}

struct SealedPackage {
    target: Str(32),
    dialect_name: Str(16),
    trust_level: u8,
    case_count: u64,
    oracle_hash: Str(64),
    candidate_hash: Str(64),
}

// ── Native clean-room candidate ──────────────────────────
// ASCII a..z fold to A..Z; every other byte is unchanged (C locale contract).
//
// Branchless and leaf, so the execution court can map and call exactly this
// function. For b < 97 the subtraction wraps to a large u64 and the unsigned
// `t < 26` test is false; for b > 122 it is false as well. No control-flow
// lowering is needed, which matters because `phorc`'s bootstrap lowerer emits a
// single basic block.

fn phor_toupper(b: u64) -> u64
    effect [compute]
{
    let t: u64 = b - FIRST_LOWER;
    let in_range: u64 = (t < LETTER_COUNT) as u64;
    let delta: u64 = in_range * CASE_DELTA;
    return b - delta;
}
