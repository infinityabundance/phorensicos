// phor_serial_driver.phor — Native .phor Serial Port Driver
//
// Demonstrates:
//   - Capability-gated hardware access from .phor
//   - Driver lifecycle (unloaded -> loaded -> initialized -> active)
//   - Residual emission on every hardware operation
//   - Bounded transmit/receive buffers
//   - Stable diagnostic error codes
//   - Pure compute register calculation functions
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:phor_serial_driver:v1.0";

// ── Diagnostic Error Codes ─────────────────────────────

const ERR_NOT_INITIALIZED: u64 = 0xC0;
const ERR_PORT_INVALID: u64 = 0xC1;
const ERR_TX_TIMEOUT: u64 = 0xC3;
const ERR_CAPABILITY: u64 = 0xC7;

// ── Driver States ──────────────────────────────────────

type DriverState = u8;

const STATE_UNLOADED: DriverState = 0;
const STATE_LOADED: DriverState = 1;
const STATE_INITIALIZED: DriverState = 2;
const STATE_ACTIVE: DriverState = 3;
const STATE_ERROR: DriverState = 4;

// ── UART Register Constants ────────────────────────────

const UART_THR: u16 = 0;
const UART_LCR: u16 = 3;
const UART_LSR: u16 = 5;
const LSR_THR_EMPTY: u8 = 0x20;

// ── Serial Port Driver ─────────────────────────────────

struct SerialDriver {
    port_base: u16,
    state: DriverState,
    baud_rate: u64,
    data_bits: u8,
    stop_bits: u8,
    parity: u8,
    fifo_enabled: bool,
    tx_count: u64,
    rx_count: u64,
    error_count: u64,
}

impl SerialDriver {
    fn new(port_base: u16) -> SerialDriver
        effect [compute]
    {
        return SerialDriver {
            port_base: port_base,
            state: STATE_UNLOADED,
            baud_rate: 0,
            data_bits: 8,
            stop_bits: 1,
            parity: 0,
            fifo_enabled: false,
            tx_count: 0,
            rx_count: 0,
            error_count: 0,
        };
    }

    fn load(mut self) -> SerialDriver
        effect [compute, residual]
    {
        // Validate port base
        if self.port_base != 0x3F8 && self.port_base != 0x2F8
            && self.port_base != 0x3E8 && self.port_base != 0x2E8 {
            self.state = STATE_ERROR;
            self.error_count = self.error_count + 1;

            residual emit {
                op: "driver.load_error",
                port: self.port_base as u64,
                error: ERR_PORT_INVALID,
            };

            return self;
        }

        self.state = STATE_LOADED;
        self.baud_rate = 115200;
        self.data_bits = 8;
        self.stop_bits = 1;
        self.parity = 0;

        residual emit {
            op: "driver.loaded",
            port: self.port_base as u64,
            baud: self.baud_rate,
        };

        return self;
    }

    fn init(mut self) -> SerialDriver
        effect [compute, residual]
    {
        if self.state < STATE_LOADED {
            self.error_count = self.error_count + 1;
            residual emit {
                op: "driver.init_error",
                reason: ERR_NOT_INITIALIZED,
            };
            return self;
        }

        self.state = STATE_INITIALIZED;
        self.fifo_enabled = true;

        residual emit {
            op: "driver.initialized",
            port: self.port_base as u64,
            fifo: 1,
        };

        return self;
    }

    fn activate(mut self) -> SerialDriver
        effect [compute, residual]
    {
        if self.state < STATE_INITIALIZED {
            return self;
        }

        self.state = STATE_ACTIVE;

        residual emit {
            op: "driver.activated",
            port: self.port_base as u64,
        };

        return self;
    }

    fn send_byte(mut self, byte: u8) -> SerialDriver
        effect [machine:ioport, compute, residual]
    {
        if self.state < STATE_ACTIVE {
            self.error_count = self.error_count + 1;
            residual emit {
                op: "driver.tx_error",
                error: ERR_NOT_INITIALIZED,
            };
            return self;
        }

        // Pure compute: build LCR register value
        let lcr: u8 = build_lcr(self.data_bits, self.stop_bits, self.parity);

        // Simulated hardware access (in a real driver, this would use port I/O)
        self.tx_count = self.tx_count + 1;

        residual emit {
            op: "driver.tx_byte",
            port: self.port_base as u64,
            byte: byte as u64,
            lcr: lcr as u64,
            tx_count: self.tx_count,
        };

        return self;
    }

    fn send_str(mut self, s: Array(u8, 256), len: u64) -> SerialDriver
        effect [machine:ioport, compute, residual]
    {
        let limit: u64 = len.min(256);
        for i in 0..limit {
            self = self.send_byte(s[i]);
        }
        return self;
    }

    fn state(self) -> DriverState
        effect [compute]
    {
        return self.state;
    }

    fn is_active(self) -> bool
        effect [compute]
    {
        return self.state == STATE_ACTIVE;
    }

    fn tx_count(self) -> u64
        effect [compute]
    {
        return self.tx_count;
    }

    fn error_count(self) -> u64
        effect [compute]
    {
        return self.error_count;
    }

    fn statistics(self) -> (u64, u64, u64)
        effect [compute]
    {
        return (self.tx_count, self.rx_count, self.error_count);
    }
}

// ── Pure Compute Helpers ───────────────────────────────

fn build_lcr(data_bits: u8, stop_bits: u8, parity: u8) -> u8
    effect [compute]
{
    let mut lcr: u8 = 0;
    if data_bits == 5 { lcr = lcr; }
    if data_bits == 6 { lcr = lcr | 0x01; }
    if data_bits == 7 { lcr = lcr | 0x02; }
    if data_bits == 8 { lcr = lcr | 0x03; }
    if stop_bits == 2 { lcr = lcr | 0x04; }
    if parity == 1 { lcr = lcr | 0x08; }
    if parity == 2 { lcr = lcr | 0x18; }
    return lcr;
}

fn is_thr_empty(lsr: u8) -> bool
    effect [compute]
{
    return (lsr & LSR_THR_EMPTY) != 0;
}

fn is_valid_port(base: u16) -> bool
    effect [compute]
{
    return base == 0x3F8 || base == 0x2F8 || base == 0x3E8 || base == 0x2E8;
}

// ── Test ───────────────────────────────────────────────

fn test_serial_driver() -> bool
    effect [machine:ioport, compute, residual]
{
    // Create driver
    let mut drv: SerialDriver = SerialDriver::new(0x3F8);
    assert(drv.state() == STATE_UNLOADED, "driver: starts unloaded");
    assert(!drv.is_active(), "driver: not active initially");

    // Load
    drv = drv.load();
    assert(drv.state() == STATE_LOADED, "driver: loaded");

    // Initialize
    drv = drv.init();
    assert(drv.state() == STATE_INITIALIZED, "driver: initialized");

    // Activate
    drv = drv.activate();
    assert(drv.is_active(), "driver: active");

    // Send bytes
    drv = drv.send_byte(0x48); // 'H'
    drv = drv.send_byte(0x65); // 'e'
    drv = drv.send_byte(0x6C); // 'l'
    drv = drv.send_byte(0x6C); // 'l'
    drv = drv.send_byte(0x6F); // 'o'
    assert(drv.tx_count() == 5, "driver: 5 bytes sent");

    // Send string
    let mut msg: Array(u8, 256) = Array::splat(0);
    msg[0] = 0x57; msg[1] = 0x6F; msg[2] = 0x72; // "Wor"
    msg[3] = 0x6C; msg[4] = 0x64;                 // "ld"
    drv = drv.send_str(msg, 5);
    assert(drv.tx_count() == 10, "driver: 10 total bytes sent");

    // Error handling: invalid port
    let mut bad_drv: SerialDriver = SerialDriver::new(0x0000);
    bad_drv = bad_drv.load();
    assert(bad_drv.state() == STATE_ERROR, "driver: invalid port -> error");
    assert(bad_drv.error_count() > 0, "driver: error counted");

    // Test helper functions
    let lcr: u8 = build_lcr(8, 1, 0);
    assert(lcr == 0x03, "driver: LCR 8n1 = 0x03");

    let empty: bool = is_thr_empty(0x60);
    assert(empty, "driver: LSR bit 5 set = THR empty");

    let valid: bool = is_valid_port(0x3F8);
    assert(valid, "driver: COM1 is valid");

    // Test statistics
    let (tx, _rx, err): (u64, u64, u64) = drv.statistics();
    assert(tx == 10, "driver: stats tx = 10");
    assert(err == 0, "driver: stats err = 0");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, machine:ioport, compute, residual]
{
    let passed: bool = test_serial_driver();
    assert(passed, "phor serial driver: all tests pass");

    console.write(Str::from("Phor Serial Driver:"));
    console.write(Str::from("  Driver lifecycle (load/init/activate): PASS"));
    console.write(Str::from("  Byte transmission with residual emission: PASS"));
    console.write(Str::from("  String transmission: PASS"));
    console.write(Str::from("  Error handling (invalid port): PASS"));
    console.write(Str::from("  Pure compute register helpers: PASS"));
    console.write(Str::from("Phor serial driver validated!"));
}
