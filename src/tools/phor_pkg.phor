// phor_pkg.phor — Package Management Tool: Package Creation, Verification,
//                  Source-Seal Checking, Signature Management, Store Operations
// Phorensic Package Manager — CLI Tool for Package Management
//
// This tool manages Phorensic packages, including creation, verification,
// source-seal integrity checking, cryptographic signature management, and
// forensic store operations. Packages are the unit of distribution in the
// Phorensic ecosystem.
//
// Operations performed:
// 1. Package creation — creates packages from source and sealed containers
// 2. Verification — verifies package integrity and authenticity
// 3. Source-seal checking — verifies source-to-binary chain integrity
// 4. Signature management — manages package signatures
// 5. Store operations — publishes and retrieves packages from the store
//
// Evidence semantics: Package operations produce PackageReceipt records that
// chain back to the compiler receipts embedded in the sealed container.
//
// Boundedness: All collections are fixed-capacity. Dependencies are bounded
// at MAX_PACKAGE_DEPS (128). Package metadata is bounded at 256 bytes.
//
// Effect declarations: Package operations require [io] for store access,
// [seal] for signing, and [verify] for signature verification.

use core::fixed::Array64;
use core::fixed::Array128;
use core::fixed::Array256;
use core::result::Result;
use core::option::Option;
use core::string::FixedString256;

use compiler::diagnostics::*;
use compiler::receipts::*;
use compiler::sealer::*;

// ──────────────────────────────────────────────
// PackageMetadata: Metadata for a Phorensic package
// ──────────────────────────────────────────────
// Evidence path: PKG-META-001 through PKG-META-020

pub struct PackageMetadata {
    /// Package name.
    pub name : FixedString256,
    /// Package version (major.minor.patch).
    pub version_major : u16,
    pub version_minor : u16,
    pub version_patch : u16,
    /// Human-readable description.
    pub description : FixedString256,
    /// Author identity.
    pub author : FixedString256,
    /// Package license identifier.
    pub license : FixedString256,
    /// Package format version.
    pub format_version : u8,
    /// Creation timestamp (monotonic counter).
    pub created_at : u64,
}

impl PackageMetadata {
    pub fn new(
        name : FixedString256,
        version_major : u16,
        version_minor : u16,
        version_patch : u16,
        author : FixedString256,
    ) -> PackageMetadata [pure] {
        PackageMetadata {
            name: name,
            version_major: version_major,
            version_minor: version_minor,
            version_patch: version_patch,
            description: FixedString256::new(),
            author: author,
            license: FixedString256::from("MIT"),
            format_version: PACKAGE_FORMAT_VER,
            created_at: 0u64,
        }
    }

    pub fn with_description(mut self, desc : FixedString256) -> PackageMetadata [pure] {
        self.description = desc;
        self
    }

    pub fn with_license(mut self, license : FixedString256) -> PackageMetadata [pure] {
        self.license = license;
        self
    }

    pub fn version_string(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_u16(self.version_major);
        result.push_str(FixedString256::from("."));
        result.push_u16(self.version_minor);
        result.push_str(FixedString256::from("."));
        result.push_u16(self.version_patch);
        result
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(self.name);
        result.push_str(FixedString256::from(" v"));
        result.push_str(self.version_string());
        result.push_str(FixedString256::from(" by "));
        result.push_str(self.author);
        result.push_str(FixedString256::from(" ["));
        result.push_str(self.license);
        result.push_str(FixedString256::from("]"));
        result
    }
}

// ──────────────────────────────────────────────
// PackageDependency: A dependency of a package
// ──────────────────────────────────────────────
// Evidence path: PKG-DEP-001 through PKG-DEP-015

pub struct PackageDependency {
    /// Name of the dependency.
    pub name : FixedString256,
    /// Minimum version required.
    pub min_version_major : u16,
    pub min_version_minor : u16,
    pub min_version_patch : u16,
    /// Whether the dependency is optional.
    pub optional : bool,
    /// Dependency hash for integrity verification.
    pub dependency_hash : u64,
}

impl PackageDependency {
    pub fn new(
        name : FixedString256,
        version_major : u16,
        version_minor : u16,
        version_patch : u16,
    ) -> PackageDependency [pure] {
        var hash : u64 = 14695981039346656037u64;
        // loop: bounds[BOUND_MEDIUM] — bounded by name length.
        loop: bounds[BOUND_MEDIUM] for i in 0..name.len() {
            hash ^= name.get_byte(i) as u64;
            hash *= 1099511628211u64;
        }
        hash ^= version_major as u64;
        hash *= 1099511628211u64;
        hash ^= version_minor as u64;
        hash *= 1099511628211u64;
        hash ^= version_patch as u64;
        hash *= 1099511628211u64;

        PackageDependency {
            name: name,
            min_version_major: version_major,
            min_version_minor: version_minor,
            min_version_patch: version_patch,
            optional: false,
            dependency_hash: hash,
        }
    }

    pub fn optional_dependency(mut self) -> PackageDependency [pure] {
        self.optional = true;
        self
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(self.name);
        result.push_str(FixedString256::from(" >= "));
        result.push_u16(self.min_version_major);
        result.push_str(FixedString256::from("."));
        result.push_u16(self.min_version_minor);
        result.push_str(FixedString256::from("."));
        result.push_u16(self.min_version_patch);
        if self.optional {
            result.push_str(FixedString256::from(" (optional)"));
        }
        result
    }
}

// ──────────────────────────────────────────────
// PackageSignature: Cryptographic signature for a package
// ──────────────────────────────────────────────
// Evidence path: PKG-SIG-001 through PKG-SIG-020

pub struct PackageSignature {
    /// Signer identity.
    pub signer : FixedString256,
    /// Signature value.
    pub signature_value : u64,
    /// Signature algorithm identifier.
    pub algorithm : u8,
    /// Timestamp of signing.
    pub signed_at : u64,
    /// Whether the signature has been verified.
    pub verified : bool,
}

impl PackageSignature {
    pub fn new(signer : FixedString256, algorithm : u8, signed_at : u64) -> PackageSignature [pure] {
        // Compute deterministic signature.
        var sig : u64 = 14695981039346656037u64;
        // loop: bounds[BOUND_MEDIUM] — bounded by signer length.
        loop: bounds[BOUND_MEDIUM] for i in 0..signer.len() {
            sig ^= signer.get_byte(i) as u64;
            sig *= 1099511628211u64;
        }
        sig ^= algorithm as u64;
        sig *= 1099511628211u64;
        sig ^= signed_at;
        sig *= 1099511628211u64;

        PackageSignature {
            signer: signer,
            signature_value: sig,
            algorithm: algorithm,
            signed_at: signed_at,
            verified: false,
        }
    }

    pub fn verify(mut self, expected_payload_hash : u64) -> PackageSignature [pure] {
        var expected_sig : u64 = 14695981039346656037u64;
        // loop: bounds[BOUND_MEDIUM] — bounded by signer length.
        loop: bounds[BOUND_MEDIUM] for i in 0..self.signer.len() {
            expected_sig ^= self.signer.get_byte(i) as u64;
            expected_sig *= 1099511628211u64;
        }
        expected_sig ^= self.algorithm as u64;
        expected_sig *= 1099511628211u64;
        expected_sig ^= self.signed_at;
        expected_sig *= 1099511628211u64;
        expected_sig ^= expected_payload_hash;
        expected_sig *= 1099511628211u64;

        self.verified = expected_sig == self.signature_value;
        self
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("signature by "));
        result.push_str(self.signer);
        result.push_str(FixedString256::from(" (algorithm=0x"));
        result.push_u32(self.algorithm as u32);
        result.push_str(FixedString256::from(", verified="));
        if self.verified {
            result.push_str(FixedString256::from("yes"));
        } else {
            result.push_str(FixedString256::from("no"));
        }
        result.push_str(FixedString256::from(")"));
        result
    }
}

// ──────────────────────────────────────────────
// Package: A complete Phorensic package
// ──────────────────────────────────────────────
// Evidence path: PKG-PACKAGE-001 through PKG-PACKAGE-025

pub struct Package {
    /// Package metadata.
    pub metadata : PackageMetadata,
    /// The sealed container (compiler output).
    pub container : Option<SealedContainer>,
    /// Dependencies (bounded: 128 max).
    pub dependencies : Array128<PackageDependency>,
    /// Signatures (bounded: 32 max).
    pub signatures : Array64<PackageSignature>,
    /// Source hash for source-seal verification.
    pub source_hash : u64,
    /// Package hash (for integrity verification).
    pub package_hash : u64,
    /// Whether the package has been verified.
    pub verified : bool,
}

impl Package {
    pub fn new(metadata : PackageMetadata) -> Package [pure] {
        var pkg_hash : u64 = 14695981039346656037u64;
        // loop: bounds[BOUND_MEDIUM] — bounded by metadata.
        loop: bounds[BOUND_MEDIUM] for i in 0..metadata.name.len() {
            pkg_hash ^= metadata.name.get_byte(i) as u64;
            pkg_hash *= 1099511628211u64;
        }
        pkg_hash ^= metadata.version_major as u64;
        pkg_hash *= 1099511628211u64;
        pkg_hash ^= metadata.version_minor as u64;
        pkg_hash *= 1099511628211u64;
        pkg_hash ^= metadata.version_patch as u64;
        pkg_hash *= 1099511628211u64;

        Package {
            metadata: metadata,
            container: Option::None,
            dependencies: Array128::new(),
            signatures: Array64::new(),
            source_hash: 0u64,
            package_hash: pkg_hash,
            verified: false,
        }
    }

    pub fn attach_container(mut self, container : SealedContainer) -> Package [pure] {
        self.container = Option::Some(container);
        // Update package hash with container hash.
        self.package_hash ^= container.seal_hash;
        self.package_hash *= 1099511628211u64;
        self
    }

    pub fn add_dependency(mut self, dep : PackageDependency) -> Package [pure] {
        if self.dependencies.len() < self.dependencies.capacity() {
            let _ = self.dependencies.push(dep);
            self.package_hash ^= dep.dependency_hash;
            self.package_hash *= 1099511628211u64;
        }
        self
    }

    pub fn add_signature(mut self, sig : PackageSignature) -> Package [pure] {
        if self.signatures.len() < self.signatures.capacity() {
            let _ = self.signatures.push(sig);
        }
        self
    }

    pub fn set_source_hash(mut self, source_hash : u64) -> Package [pure] {
        self.source_hash = source_hash;
        self.package_hash ^= source_hash;
        self.package_hash *= 1099511628211u64;
        self
    }

    pub fn verify(mut self) -> Package [pure] {
        // Verify all signatures.
        // loop: bounds[BOUND_SMALL] — bounded by 64 signatures.
        loop: bounds[BOUND_SMALL] for i in 0..self.signatures.len() {
            let sig : PackageSignature = self.signatures.get(i);
            let verified : PackageSignature = sig.verify(self.package_hash);
            self.signatures.set(i, verified);
        }

        // Verify source-seal chain if container is present.
        match self.container {
            Option::Some(container) => {
                let seal_valid : bool = container.status == SealStatus::Valid || container.status == SealStatus::Unverified;
                self.verified = seal_valid;
            }
            Option::None => {
                self.verified = self.signatures.len() > 0u32;
            }
        }

        self
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(self.metadata.format());
        result.push_str(FixedString256::from("\n  Package Hash: 0x"));
        result.push_u64(self.package_hash);
        result.push_str(FixedString256::from("\n  Dependencies ("));
        result.push_u32(self.dependencies.len());
        result.push_str(FixedString256::from("):\n"));

        // loop: bounds[BOUND_MEDIUM] — bounded by 128 deps.
        loop: bounds[BOUND_MEDIUM] for di in 0..self.dependencies.len() {
            result.push_str(FixedString256::from("    - "));
            result.push_str(self.dependencies.get(di).format());
            result.push_str(FixedString256::from("\n"));
        }

        result.push_str(FixedString256::from("  Signatures ("));
        result.push_u32(self.signatures.len());
        result.push_str(FixedString256::from("):\n"));

        // loop: bounds[BOUND_SMALL] — bounded by 64 sigs.
        loop: bounds[BOUND_SMALL] for si in 0..self.signatures.len() {
            result.push_str(FixedString256::from("    - "));
            result.push_str(self.signatures.get(si).format());
            result.push_str(FixedString256::from("\n"));
        }

        result.push_str(FixedString256::from("  Verified: "));
        if self.verified {
            result.push_str(FixedString256::from("yes"));
        } else {
            result.push_str(FixedString256::from("no"));
        }
        result.push_str(FixedString256::from("\n"));
        result
    }
}

// ──────────────────────────────────────────────
// SourceSealChecker: Verifies source-to-seal integrity
// ──────────────────────────────────────────────
// Checks that the source code hash matches the hash embedded in the
// sealed container's receipt chain.
// Evidence path: PKG-SRCSEAL-001 through PKG-SRCSEAL-015

pub struct SourceSealChecker {
    /// Source code hash.
    pub source_hash : u64,
    /// Container seal hash.
    pub seal_hash : u64,
    /// Whether the source matches the seal.
    pub matches : bool,
}

impl SourceSealChecker {
    pub fn new(source_hash : u64, seal_hash : u64) -> SourceSealChecker [pure] {
        let matches : bool = source_hash == seal_hash;
        SourceSealChecker {
            source_hash: source_hash,
            seal_hash: seal_hash,
            matches: matches,
        }
    }

    pub fn check_with_receipt_chain(
        source_hash : u64,
        chain : ReceiptChain,
    ) -> SourceSealChecker [pure] {
        let chain_root : u64 = chain.root_hash;
        let matches : bool = source_hash == chain_root;
        SourceSealChecker {
            source_hash: source_hash,
            seal_hash: chain_root,
            matches: matches,
        }
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Source-Seal Check: "));
        if self.matches {
            result.push_str(FixedString256::from("PASS"));
        } else {
            result.push_str(FixedString256::from("FAIL"));
        }
        result.push_str(FixedString256::from("\n  Source hash: 0x"));
        result.push_u64(self.source_hash);
        result.push_str(FixedString256::from("\n  Seal hash:   0x"));
        result.push_u64(self.seal_hash);
        result.push_str(FixedString256::from("\n"));
        result
    }
}

// ──────────────────────────────────────────────
// StoreOperation: Forensic store operations for packages
// ──────────────────────────────────────────────
// Evidence path: PKG-STORE-001 through PKG-STORE-020

pub struct StoreOperation {
    /// Store endpoint.
    pub endpoint : FixedString256,
    /// Whether the store is available.
    pub available : bool,
}

impl StoreOperation {
    pub fn new(endpoint : FixedString256) -> StoreOperation [pure] {
        StoreOperation {
            endpoint: endpoint,
            available: false,
        }
    }

    pub fn publish_package(pkg : Package, endpoint : FixedString256) -> Result<FixedString256, FixedString256> [io] {
        if !pkg.verified {
            return Result::Err(FixedString256::from("cannot publish unverified package"));
        }
        let confirmation : FixedString256 = FixedString256::from("package '");
        let msg : FixedString256 = confirmation + pkg.metadata.name + FixedString256::from("' published to ") + endpoint;
        Result::Ok(msg)
    }

    pub fn retrieve_package(name : FixedString256, version_str : FixedString256, endpoint : FixedString256) -> Result<Package, FixedString256> [io] {
        // In a real implementation, this would download from the store.
        let meta : PackageMetadata = PackageMetadata::new(name, 0u16, 1u16, 0u16, FixedString256::from("store"));
        let pkg : Package = Package::new(meta);
        Result::Ok(pkg)
    }

    pub fn list_packages(endpoint : FixedString256) -> Result<Array64<FixedString256>, FixedString256> [io] {
        let mut packages : Array64<FixedString256> = Array64::new();
        let _ = packages.push(FixedString256::from("(store listing not implemented)"));
        Result::Ok(packages)
    }
}

// ──────────────────────────────────────────────
// PhorPkg: Main package management tool
// ──────────────────────────────────────────────
// Evidence path: PKG-TOOL-001 through PKG-TOOL-030

pub struct PhorPkg {
    /// Packages being managed (bounded: 64 max).
    pub packages : Array64<Package>,
    /// Current package index.
    pub current_package : u32,
    /// Store endpoint.
    pub store_endpoint : FixedString256,
    /// Whether initialized.
    pub initialized : bool,
}

impl PhorPkg {
    pub fn new(store_endpoint : FixedString256) -> PhorPkg [pure] {
        PhorPkg {
            packages: Array64::new(),
            current_package: 0u32,
            store_endpoint: store_endpoint,
            initialized: true,
        }
    }

    // ── Package Creation ──

    pub fn create_package(
        mut self,
        name : FixedString256,
        major : u16,
        minor : u16,
        patch : u16,
        author : FixedString256,
    ) -> Result<PhorPkg, FixedString256> [pure] {
        if self.packages.len() >= self.packages.capacity() {
            return Result::Err(FixedString256::from("package capacity exceeded"));
        }
        let meta : PackageMetadata = PackageMetadata::new(name, major, minor, patch, author);
        let pkg : Package = Package::new(meta);
        let _ = self.packages.push(pkg);
        self.current_package = self.packages.len() - 1u32;
        Result::Ok(self)
    }

    pub fn create_package_with_description(
        mut self,
        name : FixedString256,
        major : u16,
        minor : u16,
        patch : u16,
        author : FixedString256,
        description : FixedString256,
    ) -> Result<PhorPkg, FixedString256> [pure] {
        let result : Result<PhorPkg, FixedString256> = self.create_package(name, major, minor, patch, author);
        match result {
            Result::Ok(pkg_tool) => {
                let pkg : Package = pkg_tool.packages.get(pkg_tool.current_package);
                let described : Package = Package {
                    metadata: pkg.metadata.with_description(description),
                    ..pkg
                };
                let mut updated_pkg_tool : PhorPkg = pkg_tool;
                updated_pkg_tool.packages.set(updated_pkg_tool.current_package, described);
                Result::Ok(updated_pkg_tool)
            }
            Result::Err(msg) => Result::Err(msg),
        }
    }

    // ── Package Attachment ──

    pub fn attach_container(
        mut self,
        container : SealedContainer,
    ) -> Result<PhorPkg, FixedString256> [pure] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let pkg : Package = self.packages.get(self.current_package);
        let updated : Package = pkg.attach_container(container);
        self.packages.set(self.current_package, updated);
        Result::Ok(self)
    }

    // ── Dependency Management ──

    pub fn add_dependency(
        mut self,
        name : FixedString256,
        major : u16,
        minor : u16,
        patch : u16,
    ) -> Result<PhorPkg, FixedString256> [pure] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let dep : PackageDependency = PackageDependency::new(name, major, minor, patch);
        let pkg : Package = self.packages.get(self.current_package);
        let updated : Package = pkg.add_dependency(dep);
        self.packages.set(self.current_package, updated);
        Result::Ok(self)
    }

    // ── Signature Management ──

    pub fn sign_package(
        mut self,
        signer : FixedString256,
    ) -> Result<PhorPkg, FixedString256> [pure] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let sig : PackageSignature = PackageSignature::new(signer, CRYPTO_ED25519, 0u64);
        let pkg : Package = self.packages.get(self.current_package);
        let updated : Package = pkg.add_signature(sig);
        self.packages.set(self.current_package, updated);
        Result::Ok(self)
    }

    pub fn verify_signatures(mut self) -> Result<PhorPkg, FixedString256> [pure] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let pkg : Package = self.packages.get(self.current_package);
        // loop: bounds[BOUND_SMALL] — bounded by 64 sigs.
        loop: bounds[BOUND_SMALL] for i in 0..pkg.signatures.len() {
            let sig : PackageSignature = pkg.signatures.get(i);
            let verified : PackageSignature = sig.verify(pkg.package_hash);
            // In-place update would be needed; for now just mark.
        }
        Result::Ok(self)
    }

    // ── Verification ──

    pub fn verify_package(mut self) -> Result<PhorPkg, FixedString256> [pure] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let pkg : Package = self.packages.get(self.current_package);
        let verified : Package = pkg.verify();
        self.packages.set(self.current_package, verified);
        if !verified.verified {
            return Result::Err(FixedString256::from("package verification failed"));
        }
        Result::Ok(self)
    }

    // ── Source-Seal Checking ──

    pub fn check_source_seal(
        &self,
        source_hash : u64,
    ) -> Result<SourceSealChecker, FixedString256> [pure] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let pkg : Package = self.packages.get(self.current_package);
        match pkg.container {
            Option::Some(container) => {
                let checker : SourceSealChecker = SourceSealChecker::new(source_hash, container.seal_hash);
                Result::Ok(checker)
            }
            Option::None => {
                Result::Err(FixedString256::from("no container in package for source-seal check"))
            }
        }
    }

    // ── Store Operations ──

    pub fn publish_to_store(&self) -> Result<FixedString256, FixedString256> [io] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let pkg : Package = self.packages.get(self.current_package);
        StoreOperation::publish_package(pkg, self.store_endpoint)
    }

    pub fn retrieve_from_store(
        mut self,
        name : FixedString256,
        version : FixedString256,
    ) -> Result<PhorPkg, FixedString256> [io] {
        match StoreOperation::retrieve_package(name, version, self.store_endpoint) {
            Result::Ok(pkg) => {
                if self.packages.len() >= self.packages.capacity() {
                    return Result::Err(FixedString256::from("package capacity exceeded"));
                }
                let _ = self.packages.push(pkg);
                self.current_package = self.packages.len() - 1u32;
                Result::Ok(self)
            }
            Result::Err(msg) => Result::Err(msg),
        }
    }

    // ── Display ──

    pub fn display_current(&self) -> Result<FixedString256, FixedString256> [io] {
        if self.current_package >= self.packages.len() {
            return Result::Err(FixedString256::from("no current package"));
        }
        let pkg : Package = self.packages.get(self.current_package);
        Result::Ok(pkg.format())
    }

    pub fn list_packages(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Packages:\n"));
        // loop: bounds[BOUND_SMALL] — bounded by 64 packages.
        loop: bounds[BOUND_SMALL] for i in 0..self.packages.len() {
            let pkg : Package = self.packages.get(i);
            result.push_str(FixedString256::from("  "));
            result.push_str(pkg.metadata.format());
            result.push_str(FixedString256::from("\n"));
        }
        result
    }
}

// ──────────────────────────────────────────────
// Entry point function
// ──────────────────────────────────────────────

pub fn phor_pkg_main(args : Array64<FixedString256>) -> Result<u8, FixedString256> [io, seal] {
    if args.len() < 2u32 {
        return Result::Err(FixedString256::from("usage: phor_pkg <command> [options]"));
    }

    let command : FixedString256 = args.get(1u32);
    let endpoint : FixedString256 = FixedString256::from("local");
    let mut pkg_tool : PhorPkg = PhorPkg::new(endpoint);

    if command == FixedString256::from("create") {
        if args.len() < 4u32 {
            return Result::Err(FixedString256::from("usage: phor_pkg create <name> <author>"));
        }
        let name : FixedString256 = args.get(2u32);
        let author : FixedString256 = args.get(3u32);
        let _ = pkg_tool.create_package(name, 0u16, 1u16, 0u16, author);
        Result::Ok(0u8)
    } else if command == FixedString256::from("list") {
        let output : FixedString256 = pkg_tool.list_packages();
        Result::Ok(0u8)
    } else if command == FixedString256::from("verify") {
        match pkg_tool.verify_package() {
            Result::Ok(_) => Result::Ok(0u8),
            Result::Err(msg) => Result::Err(msg),
        }
    } else if command == FixedString256::from("publish") {
        match pkg_tool.publish_to_store() {
            Result::Ok(msg) => Result::Ok(0u8),
            Result::Err(msg) => Result::Err(msg),
        }
    } else if command == FixedString256::from("sign") {
        if args.len() < 3u32 {
            return Result::Err(FixedString256::from("usage: phor_pkg sign <signer>"));
        }
        let signer : FixedString256 = args.get(2u32);
        let _ = pkg_tool.sign_package(signer);
        Result::Ok(0u8)
    } else {
        Result::Err(FixedString256::from("unknown command: ") + command)
    }
}

// ──────────────────────────────────────────────
// PackageValidator: Validates package structure and integrity
// ──────────────────────────────────────────────
// Evidence path: PKG-VALIDATOR-001 through PKG-VALIDATOR-025

pub struct PackageValidator {
    /// Whether the package structure is valid.
    pub structure_valid : bool,
    /// Whether dependencies are satisfied.
    pub dependencies_satisfied : bool,
    /// Whether signatures are valid.
    pub signatures_valid : bool,
    /// Whether the source-seal chain is intact.
    pub source_seal_intact : bool,
    /// Validation messages.
    pub messages : Array64<FixedString256>,
    /// Overall validation passed.
    pub passed : bool,
}

impl PackageValidator {
    pub fn new() -> PackageValidator [pure] {
        PackageValidator {
            structure_valid: false,
            dependencies_satisfied: false,
            signatures_valid: false,
            source_seal_intact: false,
            messages: Array64::new(),
            passed: false,
        }
    }

    pub fn validate_structure(mut self, pkg : Package) -> PackageValidator [pure] {
        self.structure_valid = true;
        if pkg.metadata.name.is_empty() {
            let _ = self.messages.push(FixedString256::from("package name is empty"));
            self.structure_valid = false;
        }
        self
    }

    pub fn validate_dependencies(mut self, pkg : Package, available : Array64<FixedString256>) -> PackageValidator [pure] {
        self.dependencies_satisfied = true;
        // loop: bounds[BOUND_MEDIUM] — bounded by 128 deps.
        loop: bounds[BOUND_MEDIUM] for di in 0..pkg.dependencies.len() {
            let dep : PackageDependency = pkg.dependencies.get(di);
            let mut found : bool = false;
            // loop: bounds[BOUND_SMALL] — bounded by 64 available.
            loop: bounds[BOUND_SMALL] for ai in 0..available.len() {
                if available.get(ai) == dep.name {
                    found = true;
                }
            }
            if !found && !dep.optional {
                let msg : FixedString256 = FixedString256::from("missing dependency: ") + dep.name;
                let _ = self.messages.push(msg);
                self.dependencies_satisfied = false;
            }
        }
        self
    }

    pub fn validate_signatures(mut self, pkg : Package) -> PackageValidator [pure] {
        self.signatures_valid = pkg.signatures.len() > 0u32;
        // loop: bounds[BOUND_SMALL] — bounded by 64 sigs.
        loop: bounds[BOUND_SMALL] for si in 0..pkg.signatures.len() {
            let sig : PackageSignature = pkg.signatures.get(si);
            if !sig.verified {
                let msg : FixedString256 = FixedString256::from("unverified signature by ") + sig.signer;
                let _ = self.messages.push(msg);
                self.signatures_valid = false;
            }
        }
        self
    }

    pub fn validate_source_seal(mut self, pkg : Package, source_hash : u64) -> PackageValidator [pure] {
        match pkg.container {
            Option::Some(container) => {
                self.source_seal_intact = source_hash == container.seal_hash;
                if !self.source_seal_intact {
                    let _ = self.messages.push(FixedString256::from("source-seal chain broken"));
                }
            }
            Option::None => {
                self.source_seal_intact = false;
                let _ = self.messages.push(FixedString256::from("no container in package"));
            }
        }
        self
    }

    pub fn finalize(mut self) -> PackageValidator [pure] {
        self.passed = self.structure_valid
            && self.dependencies_satisfied
            && self.signatures_valid
            && self.source_seal_intact;
        self
    }

    pub fn format_report(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Package Validation Report:\n"));
        result.push_str(FixedString256::from("  Structure: "));
        result.push_str(if self.structure_valid { FixedString256::from("PASS") } else { FixedString256::from("FAIL") });
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  Dependencies: "));
        result.push_str(if self.dependencies_satisfied { FixedString256::from("PASS") } else { FixedString256::from("FAIL") });
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  Signatures: "));
        result.push_str(if self.signatures_valid { FixedString256::from("PASS") } else { FixedString256::from("FAIL") });
        result.push_str(FixedString256::from("\n"));
        result.push_str(FixedString256::from("  Source-Seal: "));
        result.push_str(if self.source_seal_intact { FixedString256::from("PASS") } else { FixedString256::from("FAIL") });
        result.push_str(FixedString256::from("\n"));
        // loop: bounds[BOUND_SMALL] — bounded by 64 messages.
        loop: bounds[BOUND_SMALL] for mi in 0..self.messages.len() {
            result.push_str(FixedString256::from("  ! "));
            result.push_str(self.messages.get(mi));
            result.push_str(FixedString256::from("\n"));
        }
        result.push_str(FixedString256::from("  Overall: "));
        result.push_str(if self.passed { FixedString256::from("PASS") } else { FixedString256::from("FAIL") });
        result.push_str(FixedString256::from("\n"));
        result
    }
}

// ──────────────────────────────────────────────
// PackageMirror: Handles package mirroring and replication
// ──────────────────────────────────────────────
// Evidence path: PKG-MIRROR-001 through PKG-MIRROR-015

pub struct PackageMirror {
    /// Source store endpoint.
    pub source_endpoint : FixedString256,
    /// Destination store endpoint.
    pub dest_endpoint : FixedString256,
    /// Packages mirrored.
    pub mirrored_count : u32,
}

impl PackageMirror {
    pub fn new(source : FixedString256, dest : FixedString256) -> PackageMirror [pure] {
        PackageMirror {
            source_endpoint: source,
            dest_endpoint: dest,
            mirrored_count: 0u32,
        }
    }

    pub fn mirror_package(name : FixedString256, version : FixedString256, source : FixedString256, dest : FixedString256) -> Result<FixedString256, FixedString256> [io] {
        let confirmation : FixedString256 = FixedString256::from("mirrored ") + name + FixedString256::from(" v") + version + FixedString256::from(" from ") + source + FixedString256::from(" to ") + dest;
        Result::Ok(confirmation)
    }

    pub fn format_mirror_report(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Mirror: "));
        result.push_u32(self.mirrored_count);
        result.push_str(FixedString256::from(" packages mirrored from "));
        result.push_str(self.source_endpoint);
        result.push_str(FixedString256::from(" to "));
        result.push_str(self.dest_endpoint);
        result
    }
}

// ──────────────────────────────────────────────
// PackageResolver: Resolves package dependencies
// ──────────────────────────────────────────────
// Evidence path: PKG-RESOLVE-001 through PKG-RESOLVE-020

pub struct PackageResolver {
    /// Resolution results.
    pub resolved : Array64<FixedString256>,
    /// Unresolved dependencies.
    pub unresolved : Array64<FixedString256>,
    /// Resolution graph.
    pub resolution_order : Array64<FixedString256>,
    /// Whether resolution is complete.
    pub complete : bool,
}

impl PackageResolver {
    pub fn new() -> PackageResolver [pure] {
        PackageResolver {
            resolved: Array64::new(),
            unresolved: Array64::new(),
            resolution_order: Array64::new(),
            complete: false,
        }
    }

    pub fn resolve(mut self, pkg : Package) -> PackageResolver [pure] {
        // loop: bounds[BOUND_MEDIUM] — bounded by 128 deps.
        loop: bounds[BOUND_MEDIUM] for di in 0..pkg.dependencies.len() {
            let dep : PackageDependency = pkg.dependencies.get(di);
            let _ = self.resolved.push(dep.name);
            let _ = self.resolution_order.push(dep.name);
        }
        self.complete = true;
        self
    }

    pub fn check_satisfied(&self) -> bool [pure] {
        self.unresolved.len() == 0u32
    }

    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(FixedString256::from("Resolution order:\n"));
        // loop: bounds[BOUND_SMALL] — bounded by 64 resolved.
        loop: bounds[BOUND_SMALL] for i in 0..self.resolution_order.len() {
            result.push_str(FixedString256::from("  "));
            result.push_u32(i + 1u32);
            result.push_str(FixedString256::from(". "));
            result.push_str(self.resolution_order.get(i));
            result.push_str(FixedString256::from("\n"));
        }
        result
    }
}
