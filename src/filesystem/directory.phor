// ──────────────────────────────────────────────
// Directory Constants
// ──────────────────────────────────────────────
// Evidence path: DIR-ARCH-001 through DIR-ARCH-020

const DIAG_DIR_BASE          : Word64 = 0x5300
const MAX_DIR_ENTRIES        : u32 = 4096
const MAX_DIR_CURSOR_DEPTH   : u32 = 64
const DIRENT_CACHE_SIZE      : u32 = 128
const DIR_DOT_INODE          : Word64 = Word64::from_u64(0)
const DIR_DOTDOT_INODE       : Word64 = Word64::from_u64(1)
const DIRENT_SIZE_FIXED      : u32 = 280

const BOUND_DIR_SMALL        : u32 = 64
const BOUND_DIR_MEDIUM       : u32 = 256
const BOUND_DIR_LARGE        : u32 = 1024
const BOUND_DIR_XLARGE       : u32 = 4096

// ──────────────────────────────────────────────
// Directory Error Types
// ──────────────────────────────────────────────
// Evidence path: DIR-ERR-001 through DIR-ERR-015

pub type DirError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl DirError {
    pub fn new(code: Word64, msg: FixedString[128]) -> DirError
        effects: [deterministic]
    {
        DirError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }
}

impl Error for DirError {
    fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }
    fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }
    fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust
    }
    fn in_range(self, base: Word64, end: Word64) -> bool
        effects: [deterministic]
    {
        self.code.gte(base) && self.code.lte(end)
    }
}

pub fn dir_io_error(msg: FixedString[128]) -> DirError
    effects: [deterministic]
{
    DirError::new(Word64::from_u64(DIAG_DIR_BASE | 0x001), msg)
}

pub fn dir_not_found(msg: FixedString[128]) -> DirError
    effects: [deterministic]
{
    DirError::new(Word64::from_u64(DIAG_DIR_BASE | 0x002), msg)
}

pub fn dir_exists(msg: FixedString[128]) -> DirError
    effects: [deterministic]
{
    DirError::new(Word64::from_u64(DIAG_DIR_BASE | 0x003), msg)
}

pub fn dir_not_empty(msg: FixedString[128]) -> DirError
    effects: [deterministic]
{
    DirError::new(Word64::from_u64(DIAG_DIR_BASE | 0x004), msg)
}

pub fn dir_invalid(msg: FixedString[128]) -> DirError
    effects: [deterministic]
{
    DirError::new(Word64::from_u64(DIAG_DIR_BASE | 0x005), msg)
}

pub fn dir_cursor_invalid(msg: FixedString[128]) -> DirError
    effects: [deterministic]
{
    DirError::new(Word64::from_u64(DIAG_DIR_BASE | 0x006), msg)
}

// ──────────────────────────────────────────────
// Directory Entry Cache (per-directory)
// ──────────────────────────────────────────────
// Evidence path: DIR-DCACHE-001 through DIR-DCACHE-025

pub type DirEntryCacheEntry : struct {
    name: Byte[255],                  // Entry name
    name_length: Word32,              // Name length
    inode_number: Word64,             // Inode number
    file_type: InodeType,             // File type
    offset: Word64,                   // Offset within directory
    valid: bool,                      // Cache entry is valid
    timestamp: Word64,                // Cache timestamp
}

impl DirEntryCacheEntry {
    pub fn empty() -> DirEntryCacheEntry
        effects: [deterministic]
    {
        DirEntryCacheEntry {
            name: [Byte::from_u8(0); 255],
            name_length: Word32::from_u32(0),
            inode_number: Word64::zero(),
            file_type: InodeType::InodeType_Unknown,
            offset: Word64::zero(),
            valid: false,
            timestamp: Word64::zero(),
        }
    }

    pub fn new(name: Byte[Slice], inum: Word64, ftype: InodeType, off: Word64) -> DirEntryCacheEntry
        effects: [deterministic]
    {
        let len: u32 = name.len()
        let mut entry: DirEntryCacheEntry = DirEntryCacheEntry {
            name: [Byte::from_u8(0); 255],
            name_length: Word32::from_u32(len),
            inode_number: inum,
            file_type: ftype,
            offset: off,
            valid: true,
            timestamp: __builtin_timestamp(),
        }
        // loop: bounds[BOUND_FS_SMALL] — bounded by 255
        loop: bounds[BOUND_FS_SMALL] for i in 0..len {
            entry.name[i as usize] = name[i as usize]
        }
        entry
    }

    pub fn matches(self, name: Byte[Slice]) -> bool
        effects: [deterministic]
    {
        if !self.valid { return false }
        let len: u32 = self.name_length.to_u32()
        if len != name.len() { return false }
        // loop: bounds[BOUND_FS_SMALL] — bounded by 255
        loop: bounds[BOUND_FS_SMALL] for i in 0..len {
            if self.name[i as usize].neq(name[i as usize]) { return false }
        }
        true
    }

    pub fn invalidate(self: ref mut)
        effects: [deterministic]
    {
        self.valid = false
    }
}

pub type DirEntryCache : struct {
    entries: FixedArray[128, DirEntryCacheEntry],
    count: Word32,
    hits: Word32,
    misses: Word32,
}

impl DirEntryCache {
    pub fn new() -> DirEntryCache
        effects: [deterministic]
    {
        DirEntryCache {
            entries: FixedArray::new(),
            count: Word32::from_u32(0),
            hits: Word32::from_u32(0),
            misses: Word32::from_u32(0),
        }
    }

    pub fn lookup(self: ref mut, name: Byte[Slice]) -> Option[DirEntryCacheEntry]
        effects: [deterministic]
    {
        // loop: bounds[BOUND_DIR_SMALL] — bounded by 128
        loop: bounds[BOUND_DIR_SMALL] for i in 0..self.entries.len() {
            let entry: DirEntryCacheEntry = self.entries.get(i).unwrap_or(DirEntryCacheEntry::empty())
            if entry.matches(name) {
                self.hits = self.hits.checked_add(Word32::from_u32(1)).unwrap_or(self.hits)
                return Option::Some(entry)
            }
        }
        self.misses = self.misses.checked_add(Word32::from_u32(1)).unwrap_or(self.misses)
        Option::None
    }

    pub fn insert(self: ref mut, entry: DirEntryCacheEntry) -> Result<(), DirError>
        effects: [deterministic]
    {
        if !self.entries.is_full() {
            self.entries.push(entry)
            self.count = Word32::from_u32(self.entries.len())
            return Result::Ok(())
        }
        // LRU eviction.
        let mut oldest_idx: u32 = 0
        let mut oldest_time: Word64 = self.entries.get(0).unwrap_or(DirEntryCacheEntry::empty()).timestamp
        // loop: bounds[BOUND_DIR_SMALL] — bounded by 128
        loop: bounds[BOUND_DIR_SMALL] for i in 1..self.entries.len() {
            let e: DirEntryCacheEntry = self.entries.get(i).unwrap_or(DirEntryCacheEntry::empty())
            if e.timestamp.lt(oldest_time) {
                oldest_time = e.timestamp
                oldest_idx = i
            }
        }
        self.entries.set(oldest_idx, entry)
        Result::Ok(())
    }

    pub fn invalidate(self: ref mut)
        effects: [deterministic]
    {
        self.entries.clear()
        self.count = Word32::from_u32(0)
    }

    pub fn invalidate_name(self: ref mut, name: Byte[Slice])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_DIR_SMALL] — bounded by 128
        loop: bounds[BOUND_DIR_SMALL] for i in 0..self.entries.len() {
            let entry: DirEntryCacheEntry = self.entries.get(i).unwrap_or(DirEntryCacheEntry::empty())
            if entry.matches(name) {
                let mut e: DirEntryCacheEntry = entry
                e.invalidate()
                self.entries.set(i, e)
                break
            }
        }
    }

    pub fn stats(self) -> (Word32, Word32)
        effects: [deterministic]
    {
        (self.hits, self.misses)
    }
}

// ──────────────────────────────────────────────
// Directory Cursor
// ──────────────────────────────────────────────
// Evidence path: DIR-CURSOR-001 through DIR-CURSOR-025

pub type DirCursor : struct {
    dir_inode: Word64,                   // Directory inode being iterated
    mount_id: Word32,                    // Mount point ID
    position: Word64,                    // Current offset in directory
    block_index: Word32,                 // Current block being read
    entry_index: Word32,                 // Current entry within block
    buffer: Byte[4096],                  // Current block buffer
    buffer_valid: bool,                  // Buffer contents valid
    buffer_entries: Word32,              // Number of entries in buffer
    eof: bool,                           // End of directory reached
    generation: Word32,                  // Generation for validation
    valid: bool,                         // Cursor is valid
}

impl DirCursor {
    pub fn new(dir_inum: Word64, mid: Word32) -> DirCursor
        effects: [deterministic]
    {
        DirCursor {
            dir_inode: dir_inum,
            mount_id: mid,
            position: Word64::zero(),
            block_index: Word32::from_u32(0),
            entry_index: Word32::from_u32(0),
            buffer: [Byte::from_u8(0); 4096],
            buffer_valid: false,
            buffer_entries: Word32::from_u32(0),
            eof: false,
            generation: Word32::from_u32(1),
            valid: true,
        }
    }

    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.valid
    }

    pub fn invalidate(self: ref mut)
        effects: [deterministic]
    {
        self.valid = false
    }

    pub fn check_generation(self, expected: Word32) -> bool
        effects: [deterministic]
    {
        self.generation.eq(expected) && self.valid
    }

    pub fn at_end(self) -> bool
        effects: [deterministic]
    {
        self.eof || !self.valid
    }

    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.position = Word64::zero()
        self.block_index = Word32::from_u32(0)
        self.entry_index = Word32::from_u32(0)
        self.buffer_valid = false
        self.eof = false
    }

    pub fn next_entry(self: ref mut) -> Option[DirEntry]
        effects: [io, deterministic]
    {
        if self.eof || !self.valid {
            return Option::None
        }
        // If buffer is not valid, read the next block.
        if !self.buffer_valid {
            // In a real implementation, read block from filesystem.
            self.buffer_valid = true
            self.buffer_entries = Word32::from_u32(0)
            self.entry_index = Word32::from_u32(0)
            // Placeholder: fill buffer with dummy entries.
        }

        // Check if we need to read next block.
        if self.entry_index.to_u32() >= self.buffer_entries.to_u32() {
            if self.buffer_entries.to_u32() < MAX_DIRENT_PER_BLOCK {
                self.eof = true
                return Option::None
            }
            // Read next block.
            self.block_index = self.block_index.checked_add(Word32::from_u32(1)).unwrap_or(self.block_index)
            self.entry_index = Word32::from_u32(0)
            self.buffer_valid = false
            return self.next_entry()
        }

        // Parse entry from buffer.
        let entry_offset: u32 = self.entry_index.to_u32() * 280
        if (entry_offset + 280) > 4096 {
            self.eof = true
            return Option::None
        }
        let mut entry_bytes: Byte[280] = [Byte::from_u8(0); 280]
        // loop: bounds[BOUND_DIR_SMALL] — bounded by 280
        loop: bounds[BOUND_DIR_SMALL] for i in 0..280 {
            entry_bytes[i] = self.buffer[(entry_offset + i) as usize]
        }
        let entry: DirEntry = DirEntry::from_serialized(entry_bytes)

        // Update position.
        self.position = self.position.checked_add(Word64::from_u64(entry.entry_total_size() as u64)).unwrap_or(self.position)
        self.entry_index = self.entry_index.checked_add(Word32::from_u32(1)).unwrap_or(self.entry_index)

        Option::Some(entry)
    }

    pub fn seek_to(self: ref mut, position: Word64)
        effects: [deterministic]
    {
        if !self.valid { return }
        self.position = position
        self.block_index = Word32::from_u32(0)
        self.entry_index = Word32::from_u32(0)
        self.buffer_valid = false
        self.eof = false
    }

    pub fn current_position(self) -> Word64
        effects: [deterministic]
    {
        self.position
    }
}

// ──────────────────────────────────────────────
// Directory Operations
// ──────────────────────────────────────────────
// Evidence path: DIR-OPS-001 through DIR-OPS-040

pub type DirectoryOps : struct {
    // Placeholder structure for directory operation context
    mount_id: Word32,
    dir_inode: Word64,
    cache: DirEntryCache,
}

impl DirectoryOps {
    pub fn new(mid: Word32, dir_inum: Word64) -> DirectoryOps
        effects: [deterministic]
    {
        DirectoryOps {
            mount_id: mid,
            dir_inode: dir_inum,
            cache: DirEntryCache::new(),
        }
    }

    pub fn lookup_entry(self: ref mut, name: Byte[Slice]) -> Result[DirEntry, DirError>
        effects: [io, deterministic]
    {
        // Check cache first.
        let cached: Option[DirEntryCacheEntry] = self.cache.lookup(name)
        if cached.is_some() {
            let ce: DirEntryCacheEntry = cached.unwrap()
            return Result::Ok(DirEntry::new(
                ce.inode_number, name, ce.file_type))
        }

        // Scan directory for the entry.
        let mut cursor: DirCursor = DirCursor::new(self.dir_inode, self.mount_id)
        // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
            let entry_opt: Option[DirEntry] = cursor.next_entry()
            if entry_opt.is_none() {
                break
            }
            let entry: DirEntry = entry_opt.unwrap()
            if entry.matches_name(name) {
                // Cache the result.
                let ce: DirEntryCacheEntry = DirEntryCacheEntry::new(
                    name, entry.inode_number,
                    DirEntry::inode_type_from_byte(entry.file_type),
                    cursor.current_position())
                self.cache.insert(ce)
                return Result::Ok(entry)
            }
        }
        Result::Err(dir_not_found("Entry not found in directory"))
    }

    pub fn list_entries(self: ref mut) -> Result[FixedArray[256, DirEntry], DirError>
        effects: [io, deterministic]
    {
        let mut entries: FixedArray[256, DirEntry] = FixedArray::new()
        let mut cursor: DirCursor = DirCursor::new(self.dir_inode, self.mount_id)
        // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
            if entries.is_full() {
                break
            }
            let entry_opt: Option[DirEntry] = cursor.next_entry()
            if entry_opt.is_none() {
                break
            }
            entries.push(entry_opt.unwrap())
        }
        Result::Ok(entries)
    }

    pub fn add_entry(self: ref mut, name: Byte[Slice], inum: Word64, ftype: InodeType) -> Result<(), DirError>
        effects: [io, deterministic]
    {
        // Check if entry already exists.
        let exists: Result[DirEntry, DirError> = self.lookup_entry(name)
        if exists.is_ok() {
            return Result::Err(dir_exists("Entry already exists"))
        }

        // Create new directory entry.
        let entry: DirEntry = DirEntry::new(inum, name, ftype)?

        // In a real implementation, write entry to directory data blocks.
        // This involves finding free space in the directory's extent tree
        // and serializing the entry.

        // Invalidate cache for this name.
        self.cache.invalidate_name(name)

        // Record residual.
        residual emit {
            subsystem: "directory",
            operation: "add_entry",
            dir_inode: self.dir_inode,
            entry_inode: inum,
            name_length: name.len(),
            timestamp: __builtin_timestamp(),
        }

        Result::Ok(())
    }

    pub fn remove_entry(self: ref mut, name: Byte[Slice]) -> Result<Word64, DirError>
        effects: [io, deterministic]
    {
        // Look up entry first.
        let entry: DirEntry = self.lookup_entry(name)?

        // Mark entry as deleted (zero inode number).
        // In a real implementation, rewrite the directory entry with inode=0.

        // Invalidate cache.
        self.cache.invalidate_name(name)

        // Record residual.
        residual emit {
            subsystem: "directory",
            operation: "remove_entry",
            dir_inode: self.dir_inode,
            removed_inode: entry.inode_number,
            name_length: name.len(),
            timestamp: __builtin_timestamp(),
        }

        Result::Ok(entry.inode_number)
    }

    pub fn rename_entry(self: ref mut, old_name: Byte[Slice], new_name: Byte[Slice]) -> Result<(), DirError>
        effects: [io, deterministic]
    {
        // Look up old entry.
        let entry: DirEntry = self.lookup_entry(old_name)?

        // Check if new name already exists.
        let exists: Result[DirEntry, DirError> = self.lookup_entry(new_name)
        if exists.is_ok() {
            // Remove existing entry.
            let existing: DirEntry = exists.unwrap()
            self.remove_entry(new_name)?
        }

        // Delete old entry.
        self.remove_entry(old_name)?

        // Add new entry.
        let ftype: InodeType = DirEntry::inode_type_from_byte(entry.file_type)
        self.add_entry(new_name, entry.inode_number, ftype)?

        // Record residual.
        residual emit {
            subsystem: "directory",
            operation: "rename_entry",
            dir_inode: self.dir_inode,
            old_name_length: old_name.len(),
            new_name_length: new_name.len(),
            timestamp: __builtin_timestamp(),
        }

        Result::Ok(())
    }

    pub fn entry_count(self: ref mut) -> Result<Word32, DirError>
        effects: [io, deterministic]
    {
        let mut count: Word32 = Word32::from_u32(0)
        let mut cursor: DirCursor = DirCursor::new(self.dir_inode, self.mount_id)
        // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
            let entry_opt: Option[DirEntry] = cursor.next_entry()
            if entry_opt.is_none() {
                break
            }
            let entry: DirEntry = entry_opt.unwrap()
            if !entry.is_empty_slot() {
                count = count.checked_add(Word32::from_u32(1)).unwrap_or(count)
            }
        }
        Result::Ok(count)
    }

    pub fn search_entries(self: ref mut, prefix: Byte[Slice]) -> Result<FixedArray[64, DirEntry], DirError>
        effects: [io, deterministic]
    {
        let mut matches: FixedArray[64, DirEntry] = FixedArray::new()
        let prefix_len: u32 = prefix.len()
        let mut cursor: DirCursor = DirCursor::new(self.dir_inode, self.mount_id)
        // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
            if matches.is_full() {
                break
            }
            let entry_opt: Option[DirEntry] = cursor.next_entry()
            if entry_opt.is_none() {
                break
            }
            let entry: DirEntry = entry_opt.unwrap()
            if entry.is_empty_slot() {
                continue
            }
            let entry_name: Byte[Slice] = entry.name()
            if entry_name.len() < prefix_len {
                continue
            }
            let mut match_prefix: bool = true
            // loop: bounds[BOUND_FS_SMALL] — bounded by prefix
            loop: bounds[BOUND_FS_SMALL] for i in 0..prefix_len {
                if entry_name[i as usize].neq(prefix[i as usize]) {
                    match_prefix = false
                    break
                }
            }
            if match_prefix {
                matches.push(entry)
            }
        }
        Result::Ok(matches)
    }
}

// ──────────────────────────────────────────────
// DirEntry Inode Type Helper
// ──────────────────────────────────────────────
// Evidence path: DIR-HELPER-001 through DIR-HELPER-010

impl DirEntry {
    pub fn inode_type_from_byte(b: Byte) -> InodeType
        effects: [deterministic]
    {
        let v: u8 = b.to_u8()
        if v == 0x01 { InodeType::InodeType_File }
        else if v == 0x02 { InodeType::InodeType_Directory }
        else if v == 0x03 { InodeType::InodeType_Symlink }
        else { InodeType::InodeType_Unknown }
    }
}

// ──────────────────────────────────────────────
// Directory Create/Delete High-Level Operations
// ──────────────────────────────────────────────
// Evidence path: DIR-HIGH-001 through DIR-HIGH-025

pub fn create_directory(
    fs: ref mut PhorensicFS,
    parent_inum: Word64,
    name: Byte[Slice],
    owner: Identity,
    group: Identity
) -> Result[Word64, DirError>
    effects: [io, deterministic]
{
    if fs.is_read_only() {
        return Result::Err(dir_io_error("Filesystem is read-only"))
    }

    // In a real implementation:
    // 1. Allocate a new inode
    // 2. Set up . and .. entries
    // 3. Add entry to parent directory
    // 4. Update parent inode's link count
    // 5. Record residual

    let new_inum: Word64 = Word64::from_u64(3)  // Placeholder

    residual emit {
        subsystem: "directory",
        operation: "create_directory",
        parent_inode: parent_inum,
        new_inode: new_inum,
        owner: owner,
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(new_inum)
}

pub fn delete_directory(
    fs: ref mut PhorensicFS,
    parent_inum: Word64,
    target_inum: Word64,
    name: Byte[Slice]
) -> Result<(), DirError>
    effects: [io, deterministic]
{
    if fs.is_read_only() {
        return Result::Err(dir_io_error("Filesystem is read-only"))
    }

    // In a real implementation:
    // 1. Check directory is empty (only . and ..)
    // 2. Remove entry from parent
    // 3. Free inode and blocks
    // 4. Record residual

    residual emit {
        subsystem: "directory",
        operation: "delete_directory",
        parent_inode: parent_inum,
        target_inode: target_inum,
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(())
}

pub fn rename_directory(
    fs: ref mut PhorensicFS,
    old_parent_inum: Word64,
    old_name: Byte[Slice],
    new_parent_inum: Word64,
    new_name: Byte[Slice]
) -> Result<(), DirError>
    effects: [io, deterministic]
{
    if fs.is_read_only() {
        return Result::Err(dir_io_error("Filesystem is read-only"))
    }

    residual emit {
        subsystem: "directory",
        operation: "rename_directory",
        old_parent: old_parent_inum,
        new_parent: new_parent_inum,
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(())
}

// ──────────────────────────────────────────────
// Directory Verification
// ──────────────────────────────────────────────
// Evidence path: DIR-VERIFY-001 through DIR-VERIFY-015

pub fn verify_directory_structure(dir_ops: DirectoryOps) -> Result<Word32, DirError>
    effects: [io, deterministic]
{
    let mut errors: Word32 = Word32::from_u32(0)
    let mut cursor: DirCursor = DirCursor::new(dir_ops.dir_inode, dir_ops.mount_id)
    // loop: bounds[BOUND_DIR_XLARGE] — bounded by 4096
    loop: bounds[BOUND_DIR_XLARGE] for _ in 0..4096 {
        let entry_opt: Option[DirEntry] = cursor.next_entry()
        if entry_opt.is_none() {
            break
        }
        let entry: DirEntry = entry_opt.unwrap()
        if entry.is_empty_slot() {
            continue
        }
        // Verify entry length is within block.
        if entry.entry_total_size() > 4096 {
            errors = errors.checked_add(Word32::from_u32(1)).unwrap_or(errors)
        }
        // Verify name is not empty.
        if entry.name_length.to_u32() == 0 {
            errors = errors.checked_add(Word32::from_u32(1)).unwrap_or(errors)
        }
        // Verify name doesn't contain invalid chars.
        let name: Byte[Slice] = entry.name()
        // loop: bounds[BOUND_FS_SMALL] — bounded by 255
        loop: bounds[BOUND_FS_SMALL] for i in 0..name.len() {
            if name[i as usize].eq(Byte::from_u8(0)) {
                errors = errors.checked_add(Word32::from_u32(1)).unwrap_or(errors)
                break
            }
        }
    }
    Result::Ok(errors)
}

// ──────────────────────────────────────────────
// Directory Iterator (convenience wrapper)
// ──────────────────────────────────────────────
// Evidence path: DIR-ITER-001 through DIR-ITER-015

pub type DirectoryIterator : struct {
    cursor: DirCursor,
    finished: bool,
}

impl DirectoryIterator {
    pub fn new(dir_inum: Word64, mid: Word32) -> DirectoryIterator
        effects: [deterministic]
    {
        DirectoryIterator {
            cursor: DirCursor::new(dir_inum, mid),
            finished: false,
        }
    }

    pub fn next(self: ref mut) -> Option[DirEntry]
        effects: [io, deterministic]
    {
        if self.finished { return Option::None }
        let entry_opt: Option[DirEntry] = self.cursor.next_entry()
        if entry_opt.is_none() {
            self.finished = true
            return Option::None
        }
        let entry: DirEntry = entry_opt.unwrap()
        if entry.is_empty_slot() {
            return self.next()
        }
        Option::Some(entry)
    }

    pub fn skip_to(self: ref mut, name: Byte[Slice]) -> Option[DirEntry>
        effects: [io, deterministic]
    {
        if self.finished { return Option::None }
        // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
            let entry_opt: Option[DirEntry] = self.cursor.next_entry()
            if entry_opt.is_none() {
                self.finished = true
                return Option::None
            }
            let entry: DirEntry = entry_opt.unwrap()
            if entry.matches_name(name) {
                return Option::Some(entry)
            }
        }
        Option::None
    }

    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.cursor.reset()
        self.finished = false
    }
}

// ──────────────────────────────────────────────
// Directory Block Layout
// ──────────────────────────────────────────────
// Evidence path: DIR-LAYOUT-001 through DIR-LAYOUT-015

pub fn compute_dirent_total_size(name_len: u32) -> u32
    effects: [deterministic]
{
    let base: u32 = 13 + name_len
    (base + 3) & !3  // Align to 4 bytes
}

pub fn max_entries_per_block() -> u32
    effects: [deterministic]
{
    MAX_DIRENT_PER_BLOCK
}

pub fn compute_dir_size_blocks(entry_count: u32) -> u32
    effects: [deterministic]
{
    let est: u32 = entry_count * 64  // Average entry size
    (est + 4095) / 4096
}

pub fn dirent_to_dir_entry(de: DirEntry) -> DirEntry
    effects: [deterministic]
{
    de
}

// ──────────────────────────────────────────────
// Batch Directory Operations
// ──────────────────────────────────────────────
// Evidence path: DIR-BATCH-001 through DIR-BATCH-015

pub fn batch_lookup(dir_ops: ref mut DirectoryOps, names: FixedArray[16, Byte[Slice]]) -> FixedArray[16, Option[DirEntry]]
    effects: [io, deterministic]
{
    let mut results: FixedArray[16, Option[DirEntry]] = FixedArray::new()
    // loop: bounds[BOUND_DIR_SMALL] — bounded by 16
    loop: bounds[BOUND_DIR_SMALL] for i in 0..names.len() {
        let name: Byte[Slice] = names.get(i).unwrap_or(Byte[Slice]::new(0))
        let result: Result[DirEntry, DirError> = dir_ops.lookup_entry(name)
        if result.is_ok() {
            results.push(Option::Some(result.unwrap()))
        } else {
            results.push(Option::None)
        }
    }
    results
}

pub fn batch_add_entries(dir_ops: ref mut DirectoryOps, entries: FixedArray[16, (Byte[255], Word64, InodeType)]) -> FixedArray[16, bool]
    effects: [io, deterministic]
{
    let mut results: FixedArray[16, bool] = FixedArray::new()
    // loop: bounds[BOUND_DIR_SMALL] — bounded by 16
    loop: bounds[BOUND_DIR_SMALL] for i in 0..entries.len() {
        let (name_bytes, inum, ftype): (Byte[255], Word64, InodeType) = entries.get(i).unwrap_or(([Byte::from_u8(0); 255], Word64::zero(), InodeType::InodeType_Unknown))
        let mut name_slice: Byte[Slice] = Byte[Slice]::new(255)
        // Truncated for brevity
        let result: Result[(), DirError> = dir_ops.add_entry(name_slice, inum, ftype)
        results.push(result.is_ok())
    }
    results
}

// ──────────────────────────────────────────────
// Empty Directory Check
// ──────────────────────────────────────────────
// Evidence path: DIR-EMPTY-001 through DIR-EMPTY-010

pub fn is_directory_empty(dir_ops: ref mut DirectoryOps) -> Result[bool, DirError>
    effects: [io, deterministic]
{
    let count: Word32 = dir_ops.entry_count()?
    let count_val: u32 = count.to_u32()
    // Every directory has . and .., so empty means count <= 2.
    Result::Ok(count_val <= 2)
}

pub fn directory_has_children(dir_ops: ref mut DirectoryOps) -> Result[bool, DirError>
    effects: [io, deterministic]
{
    let count: Word32 = dir_ops.entry_count()?
    Result::Ok(count.to_u32() > 2)
}

// ──────────────────────────────────────────────
// Directory Deep Operations
// ──────────────────────────────────────────────
// Evidence path: DIR-DEEP-001 through DIR-DEEP-020

pub type DirectoryWalker : struct {
    dir_ops: DirectoryOps,
    cursor: DirCursor,
    depth: Word32,
    max_depth: Word32,
    visited_inodes: FixedArray[64, Word64],
}

impl DirectoryWalker {
    pub fn new(dir_inum: Word64, mid: Word32, max_d: Word32) -> DirectoryWalker
        effects: [deterministic]
    {
        DirectoryWalker {
            dir_ops: DirectoryOps::new(mid, dir_inum),
            cursor: DirCursor::new(dir_inum, mid),
            depth: Word32::from_u32(0),
            max_depth: max_d,
            visited_inodes: FixedArray::new(),
        }
    }

    pub fn walk(self: ref mut, visit_file: fn(Word64, Byte[Slice], Word32), visit_dir: fn(Word64, Byte[Slice], Word32))
        effects: [io, deterministic]
    {
        // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
            if self.depth.to_u32() >= self.max_depth.to_u32() {
                break
            }
            let entry_opt: Option[DirEntry> = self.cursor.next_entry()
            if entry_opt.is_none() {
                break
            }
            let entry: DirEntry = entry_opt.unwrap()
            if entry.is_empty_slot() {
                continue
            }
            let name: Byte[Slice] = entry.name()
            let inum: Word64 = entry.inode_number
            // Check for loop.
            let mut loop_found: bool = false
            // loop: bounds[BOUND_DIR_SMALL] — bounded by 64
            loop: bounds[BOUND_DIR_SMALL] for i in 0..self.visited_inodes.len() {
                if self.visited_inodes.get(i).unwrap_or(Word64::zero()).eq(inum) {
                    loop_found = true
                    break
                }
            }
            if loop_found { continue }
            self.visited_inodes.push(inum)
            let ftype: InodeType = DirEntry::inode_type_from_byte(entry.file_type)
            if ftype == InodeType::InodeType_Directory {
                visit_dir(inum, name, self.depth)
                // Recurse into subdirectory.
                if self.depth.to_u32() < self.max_depth.to_u32() {
                    self.depth = self.depth.checked_add(Word32::from_u32(1)).unwrap_or(self.depth)
                    let sub_walker: DirectoryWalker = DirectoryWalker::new(inum, self.dir_ops.mount_id, self.max_depth)
                    // Restore depth after recursion.
                    if self.depth.to_u32() > 0 {
                        self.depth = self.depth.checked_sub(Word32::from_u32(1)).unwrap_or(self.depth)
                    }
                }
            } else {
                visit_file(inum, name, self.depth)
            }
        }
    }

    pub fn collect_all(self: ref mut) -> Result[FixedArray[256, DirEntry], DirError>
        effects: [io, deterministic]
    {
        let mut all: FixedArray[256, DirEntry> = FixedArray::new()
        // loop: bounds[BOUND_DIR_XLARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_XLARGE] for _ in 0..4096 {
            if all.is_full() { break }
            let entry_opt: Option[DirEntry> = self.cursor.next_entry()
            if entry_opt.is_none() { break }
            let entry: DirEntry = entry_opt.unwrap()
            if !entry.is_empty_slot() {
                all.push(entry)
            }
        }
        Result::Ok(all)
    }
}

// ──────────────────────────────────────────────
// Directory Entry Verification
// ──────────────────────────────────────────────
// Evidence path: DIR-VERIFY-EXT-001 through DIR-VERIFY-015

pub fn verify_entry_name(name: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let len: u32 = name.len()
    if len == 0 || len > 255 {
        return false
    }
    // loop: bounds[BOUND_FS_SMALL] — bounded by 255
    loop: bounds[BOUND_FS_SMALL] for i in 0..len {
        let b: Byte = name[i as usize]
        if b.eq(Byte::from_u8(0)) { return false }
        if b.eq(Byte::from_u8(b'/')) { return false }
    }
    true
}

pub fn verify_dir_entries_integrity(
    dir_ops: ref mut DirectoryOps,
    inode_usage: ref BlockBitmap
) -> Result[FixedArray[64, DirError>, DirError>
    effects: [io, deterministic]
{
    let mut errors: FixedArray[64, DirError> = FixedArray::new()
    let mut cursor: DirCursor = DirCursor::new(dir_ops.dir_inode, dir_ops.mount_id)
    // loop: bounds[BOUND_DIR_XLARGE] — bounded by 4096
    loop: bounds[BOUND_DIR_XLARGE] for _ in 0..4096 {
        if errors.is_full() { break }
        let entry_opt: Option[DirEntry> = cursor.next_entry()
        if entry_opt.is_none() { break }
        let entry: DirEntry = entry_opt.unwrap()
        if entry.is_empty_slot() { continue }
        // Verify inode number is within valid range.
        if entry.inode_number.is_zero() {
            errors.push(dir_invalid("Directory entry has zero inode number"))
        }
        // Verify entry length is reasonable.
        if entry.entry_total_size() < 12 || entry.entry_total_size() > 4096 {
            errors.push(dir_invalid("Directory entry invalid size"))
        }
        // Verify name length matches actual.
        let name_len: u32 = entry.name_length.to_u32()
        if name_len == 0 || name_len > 255 {
            errors.push(dir_invalid("Directory entry invalid name length"))
        }
        // Verify name looks valid.
        let name: Byte[Slice] = entry.name()
        if !verify_entry_name(name) {
            errors.push(dir_invalid("Directory entry invalid name"))
        }
        // Check inode is marked as used.
        if !inode_usage.is_allocated(Word32::from_u32(entry.inode_number.to_u32())) {
            errors.push(dir_invalid("Directory entry references unallocated inode"))
        }
    }
    Result::Ok(errors)
}

// ──────────────────────────────────────────────
// Directory Entry Serialization (batch)
// ──────────────────────────────────────────────
// Evidence path: DIR-SER-001 through DIR-SER-015

pub fn serialize_dir_block(entries: FixedArray[64, DirEntry>) -> Byte[4096]
    effects: [deterministic, serialize]
{
    let mut block: Byte[4096] = [Byte::from_u8(0); 4096]
    let mut offset: u32 = 0
    // loop: bounds[BOUND_DIR_SMALL] — bounded by 64
    loop: bounds[BOUND_DIR_SMALL] for i in 0..entries.len() {
        let entry: DirEntry = entries.get(i).unwrap_or(
            DirEntry::new(Word64::zero(), Byte[Slice]::new(0), InodeType::InodeType_Unknown))
        let entry_size: u32 = entry.entry_total_size()
        if (offset + entry_size) > 4096 { break }
        let serialized: Byte[280] = entry.to_serialized()
        // loop: bounds[BOUND_DIR_SMALL] — bounded by entry_size
        loop: bounds[BOUND_DIR_SMALL] for j in 0..entry_size {
            if j < 280 {
                block[(offset + j) as usize] = serialized[j as usize]
            }
        }
        offset = offset + entry_size
    }
    block
}

pub fn deserialize_dir_block(block: Byte[4096]) -> FixedArray[64, DirEntry>
    effects: [deterministic, deserialize]
{
    let mut entries: FixedArray[64, DirEntry> = FixedArray::new()
    let mut offset: u32 = 0
    // loop: bounds[BOUND_DIR_SMALL] — bounded by 64
    loop: bounds[BOUND_DIR_SMALL] for _ in 0..64 {
        if offset >= 4096 { break }
        let mut entry_bytes: Byte[280] = [Byte::from_u8(0); 280]
        // loop: bounds[BOUND_DIR_SMALL] — bounded by 280
        loop: bounds[BOUND_DIR_SMALL] for i in 0..280 {
            if (offset + i) < 4096 {
                entry_bytes[i] = block[(offset + i) as usize]
            }
        }
        let entry: DirEntry = DirEntry::from_serialized(entry_bytes)
        let entry_size: u32 = entry.entry_total_size()
        if entry_size == 0 || entry_size > 4096 { break }
        entries.push(entry)
        offset = offset + entry_size
    }
    entries
}

// ──────────────────────────────────────────────
// Directory Entry Search Optimization
// ──────────────────────────────────────────────
// Evidence path: DIR-SEARCH-001 through DIR-SEARCH-015

pub fn find_entry_by_inode(dir_ops: ref mut DirectoryOps, inum: Word64) -> Option[DirEntry>
    effects: [io, deterministic]
{
    let mut cursor: DirCursor = DirCursor::new(dir_ops.dir_inode, dir_ops.mount_id)
    // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
    loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
        let entry_opt: Option[DirEntry> = cursor.next_entry()
        if entry_opt.is_none() { break }
        let entry: DirEntry = entry_opt.unwrap()
        if entry.inode_number.eq(inum) && !entry.is_empty_slot() {
            return Option::Some(entry)
        }
    }
    Option::None
}

pub fn find_entry_by_prefix(dir_ops: ref mut DirectoryOps, prefix: Byte[Slice]) -> FixedArray[32, DirEntry>
    effects: [io, deterministic]
{
    let mut matches: FixedArray[32, DirEntry> = FixedArray::new()
    let prefix_len: u32 = prefix.len()
    let mut cursor: DirCursor = DirCursor::new(dir_ops.dir_inode, dir_ops.mount_id)
    // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
    loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
        if matches.is_full() { break }
        let entry_opt: Option[DirEntry> = cursor.next_entry()
        if entry_opt.is_none() { break }
        let entry: DirEntry = entry_opt.unwrap()
        if entry.is_empty_slot() { continue }
        let name: Byte[Slice] = entry.name()
        if name.len() < prefix_len { continue }
        let mut match_prefix: bool = true
        // loop: bounds[BOUND_FS_SMALL] — bounded by prefix_len
        loop: bounds[BOUND_FS_SMALL] for i in 0..prefix_len {
            if name[i as usize].neq(prefix[i as usize]) {
                match_prefix = false
                break
            }
        }
        if match_prefix {
            matches.push(entry)
        }
    }
    matches
}

// ──────────────────────────────────────────────
// Directory Stats
// ──────────────────────────────────────────────
// Evidence path: DIR-STATS-001 through DIR-STATS-015

pub type DirectoryStats : struct {
    total_entries: Word32,
    file_count: Word32,
    dir_count: Word32,
    symlink_count: Word32,
    other_count: Word32,
    total_size_bytes: Word64,
    largest_entry_name: Word32,
    empty_slots: Word32,
}

impl DirectoryStats {
    pub fn new() -> DirectoryStats
        effects: [deterministic]
    {
        DirectoryStats {
            total_entries: Word32::from_u32(0),
            file_count: Word32::from_u32(0),
            dir_count: Word32::from_u32(0),
            symlink_count: Word32::from_u32(0),
            other_count: Word32::from_u32(0),
            total_size_bytes: Word64::zero(),
            largest_entry_name: Word32::from_u32(0),
            empty_slots: Word32::from_u32(0),
        }
    }

    pub fn compute(dir_ops: ref mut DirectoryOps) -> Result[DirectoryStats, DirError>
        effects: [io, deterministic]
    {
        let mut stats: DirectoryStats = DirectoryStats::new()
        let mut cursor: DirCursor = DirCursor::new(dir_ops.dir_inode, dir_ops.mount_id)
        // loop: bounds[BOUND_DIR_XLARGE] — bounded by 4096
        loop: bounds[BOUND_DIR_XLARGE] for _ in 0..4096 {
            let entry_opt: Option[DirEntry> = cursor.next_entry()
            if entry_opt.is_none() { break }
            let entry: DirEntry = entry_opt.unwrap()
            if entry.is_empty_slot() {
                stats.empty_slots = stats.empty_slots.checked_add(Word32::from_u32(1)).unwrap_or(stats.empty_slots)
                continue
            }
            stats.total_entries = stats.total_entries.checked_add(Word32::from_u32(1)).unwrap_or(stats.total_entries)
            stats.total_size_bytes = stats.total_size_bytes.checked_add(Word64::from_u64(entry.entry_total_size() as u64)).unwrap_or(stats.total_size_bytes)
            let name_len: u32 = entry.name_length.to_u32()
            if name_len > stats.largest_entry_name.to_u32() {
                stats.largest_entry_name = entry.name_length
            }
            let ftype: InodeType = DirEntry::inode_type_from_byte(entry.file_type)
            if ftype == InodeType::InodeType_File {
                stats.file_count = stats.file_count.checked_add(Word32::from_u32(1)).unwrap_or(stats.file_count)
            } else if ftype == InodeType::InodeType_Directory {
                stats.dir_count = stats.dir_count.checked_add(Word32::from_u32(1)).unwrap_or(stats.dir_count)
            } else if ftype == InodeType::InodeType_Symlink {
                stats.symlink_count = stats.symlink_count.checked_add(Word32::from_u32(1)).unwrap_or(stats.symlink_count)
            } else {
                stats.other_count = stats.other_count.checked_add(Word32::from_u32(1)).unwrap_or(stats.other_count)
            }
        }
        Result::Ok(stats)
    }
}

// ──────────────────────────────────────────────
// Residual Recording for Directory Operations
// ──────────────────────────────────────────────
// Evidence path: DIR-RESID-001 through DIR-RESID-010

pub fn residual_directory_change(dir_inum: Word64, operation: FixedString[64], detail: FixedString[128])
    effects: [io, deterministic]
{
    residual emit {
        subsystem: "directory",
        operation: operation,
        dir_inode: dir_inum,
        detail: detail,
        timestamp: __builtin_timestamp(),
    }
}
