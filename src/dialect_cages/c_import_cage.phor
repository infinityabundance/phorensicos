// ============================================================================
// c_import_cage.phor — C Language Dialect Cage: Build Context, Macros,
//                       Headers, ABI Scanning
// ============================================================================
// The C Import Cage handles importing C source code into the Phorensic
// ecosystem. It scans for build context, macros, headers, ABI assumptions,
// syscalls, environment use, locale use, file behavior, undefined behavior,
// compiler flags, linker assumptions, and generated files.
//
// Every detected construct is recorded as an expansion receipt or residual
// for progressive trust building.
// ============================================================================

package "phorensic:c_import_cage:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type CImportError = enum {
    ParseFailed = 0x01,
    UnsupportedConstruct = 0x02,
    MacroComplexityExceeded = 0x03,
    HeaderNotFound = 0x04,
    ABIViolation = 0x05,
    ExternalSymbolNotResolved = 0x06,
    InlineAssemblyNotSupported = 0x07,
    VariadicFunctionNotSupported = 0x08,
    SetjmpDetected = 0x09,
    VLAUsageDetected = 0x0A,
    FunctionPointerCast = 0x0B,
    UnionTypeRequiresReview = 0x0C,
    BitfieldLayoutUncertain = 0x0D,
    AliasAnalysisRequired = 0x0E,
    UBDetected = 0x0F,
    InternalError = 0xFF,
}

// ============================================================================
// C Language Construct Types
// ============================================================================

type CConstructType = enum {
    Include = 0x01,
    MacroDefine = 0x02,
    MacroFunction = 0x03,
    MacroConditional = 0x04,
    Typedef = 0x05,
    StructDecl = 0x06,
    UnionDecl = 0x07,
    Bitfield = 0x08,
    EnumDecl = 0x09,
    FunctionDecl = 0x0A,
    FunctionDef = 0x0B,
    VariableDecl = 0x0C,
    InlineAssembly = 0x0D,
    Attribute = 0x0E,
    Pragma = 0x0F,
    StaticAssert = 0x10,
    Unknown = 0xFF,
}

type UBSiteType = enum {
    SignedOverflow = 0x01,
    UnsequencedSideEffect = 0x02,
    NullPointerDeref = 0x03,
    BufferOverflow = 0x04,
    ShiftOverflow = 0x05,
    FreeAfterUse = 0x06,
    DoubleFree = 0x07,
    InvalidFree = 0x08,
    SignedLeftShift = 0x09,
    UnionTypePunning = 0x0A,
    RestrictViolation = 0x0B,
    InlineAssemblyUB = 0x0C,
    SetjmpLongjmp = 0x0D,
    VLAStackOverflow = 0x0E,
    FunctionPointerMismatch = 0x0F,
    IntegerDivisionByZero = 0x10,
    CustomUB = 0xFF,
}

// ============================================================================
// Hash256 and FixedString
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// C Scan Structures
// ============================================================================

type CIncludeDirective = struct {
    include_path: FixedString[512],
    resolved_path: FixedString[512],
    is_system_header: bool,
    is_standard_library: bool,
    is_local: bool,
    resolved_hash: Hash256,
    found: bool,
}

type MacroDefine = struct {
    macro_name: FixedString[256],
    macro_body_hash: Hash256,
    parameter_count: u64,
    is_function_like: bool,
    is_variadic: bool,
    expansion_count: u64,
    complexity_score: u64,
    uses_token_paste: bool,
    uses_stringify: bool,
    location: FixedString[256],
}

type ABIAssumption = struct {
    assumption_type: FixedString[128],
    description: FixedString[512],
    struct_name: FixedString[128],
    field_name: FixedString[128],
    expected_offset: u64,
    expected_size: u64,
    alignment: u64,
    is_packed: bool,
    is_verified: bool,
}

type CSyscallDetected = struct {
    syscall_name: FixedString[128],
    syscall_number: u64,
    source_location: FixedString[256],
    argument_count: u64,
    is_indirect: bool,
    through_library: FixedString[128],
}

type CMacroScanResult = struct {
    defines: Array[MacroDefine, 512],
    define_count: u64,
    conditionals: Array[FixedString[512], 256],
    conditional_count: u64,
    total_complexity: u64,
}

type CHeaderScanResult = struct {
    includes: Array[CIncludeDirective, 512],
    include_count: u64,
    resolved_count: u64,
    unresolved_count: u64,
    system_headers: u64,
    local_headers: u64,
}

type CScanResult = struct {
    macros: CMacroScanResult,
    headers: CHeaderScanResult,
    abi_assumptions: Array[ABIAssumption, 256],
    abi_assumption_count: u64,
    syscalls: Array[CSyscallDetected, 256],
    syscall_count: u64,
    ub_sites: Array[UBSiteDetected, 128],
    ub_site_count: u64,
    compiler_flags: Array[FixedString[256], 128],
    compiler_flag_count: u64,
    undefined_behavior_sites: Array[UBSiteDetected, 128],
    ub_site_count_detailed: u64,
}

type UBSiteDetected = struct {
    site_type: UBSiteType,
    location: FixedString[256],
    source_line: u64,
    description: FixedString[512],
    observed_behavior: FixedString[512],
    platform_assumption: FixedString[256],
    severity: DivergenceSeverity,
}

type DivergenceSeverity = enum {
    Acceptable = 0x01,
    Minor = 0x02,
    Significant = 0x03,
    Critical = 0x04,
}

// ============================================================================
// C Import Cage State
// ============================================================================

type CImportCage = struct {
    cage_id: Hash256,
    source_code: Array[u8, 2097152],  // 2MB fixed buffer for C source
    source_length: u64,
    source_hash: Hash256,
    scan_result: CScanResult,
    build_context: FixedString[4096],
    compiler_flags_detected: Array[FixedString[256], 128],
    compiler_flag_count: u64,
    linker_assumptions: Array[FixedString[256], 64],
    linker_assumption_count: u64,
    environment_variables: Array[FixedString[256], 64],
    env_var_count: u64,
    generated_file_references: Array[FixedString[512], 128],
    generated_file_count: u64,
    configure_assumptions: Array[FixedString[512], 128],
    configure_assumption_count: u64,
    observation_count: u64,
    generation: u64,
}

// ============================================================================
// Create C Import Cage
// ============================================================================

fn create_c_import_cage() -> CImportCage
    effects: [compute]
{
    let empty_source: Array[u8, 2097152] = Array[u8, 2097152]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_scan: CScanResult = CScanResult {
        macros: CMacroScanResult {
            defines: Array[MacroDefine, 512]::zeroed(),
            define_count: 0,
            conditionals: Array[FixedString[512], 256]::zeroed(),
            conditional_count: 0,
            total_complexity: 0,
        },
        headers: CHeaderScanResult {
            includes: Array[CIncludeDirective, 512]::zeroed(),
            include_count: 0,
            resolved_count: 0,
            unresolved_count: 0,
            system_headers: 0,
            local_headers: 0,
        },
        abi_assumptions: Array[ABIAssumption, 256]::zeroed(),
        abi_assumption_count: 0,
        syscalls: Array[CSyscallDetected, 256]::zeroed(),
        syscall_count: 0,
        ub_sites: Array[UBSiteDetected, 128]::zeroed(),
        ub_site_count: 0,
        compiler_flags: Array[FixedString[256], 128]::zeroed(),
        compiler_flag_count: 0,
        undefined_behavior_sites: Array[UBSiteDetected, 128]::zeroed(),
        ub_site_count_detailed: 0,
    };

    let empty_build_context: FixedString[4096] = FixedString[4096]::zeroed();
    let empty_compiler_flags: Array[FixedString[256], 128] = Array[FixedString[256], 128]::zeroed();
    let empty_linker: Array[FixedString[256], 64] = Array[FixedString[256], 64]::zeroed();
    let empty_env: Array[FixedString[256], 64] = Array[FixedString[256], 64]::zeroed();
    let empty_generated: Array[FixedString[512], 128] = Array[FixedString[512], 128]::zeroed();
    let empty_configure: Array[FixedString[512], 128] = Array[FixedString[512], 128]::zeroed();

    return CImportCage {
        cage_id: zero_hash,
        source_code: empty_source,
        source_length: 0,
        source_hash: zero_hash,
        scan_result: empty_scan,
        build_context: empty_build_context,
        compiler_flags_detected: empty_compiler_flags,
        compiler_flag_count: 0,
        linker_assumptions: empty_linker,
        linker_assumption_count: 0,
        environment_variables: empty_env,
        env_var_count: 0,
        generated_file_references: empty_generated,
        generated_file_count: 0,
        configure_assumptions: empty_configure,
        configure_assumption_count: 0,
        observation_count: 0,
        generation: 1,
    };
}

// ============================================================================
// Load C Source
// ============================================================================

fn load_c_source(cage: &mut CImportCage, source: &Array[u8, 2097152], length: u64) -> Result[Hash256, CImportError]
    effects: [compute, residual]
{
    if length > 2097152 {
        return Err(CImportError::ParseFailed);
    }

    for i in 0..length {
        cage.source_code[i] = source[i];
    }
    cage.source_length = length;
    cage.source_hash = hash_c_data(source, length);

    @emit_residual("c_import.load", "source_loaded", cage.source_hash);

    return Ok(cage.source_hash);
}

// ============================================================================
// Scan Macros in C Source
// ============================================================================

fn scan_c_macros(source: &Array[u8, 2097152], source_len: u64) -> CMacroScanResult
    effects: [compute, residual]
{
    let empty_defines: Array[MacroDefine, 512] = Array[MacroDefine, 512]::zeroed();
    let empty_conditionals: Array[FixedString[512], 256] = Array[FixedString[512], 256]::zeroed();

    let mut result: CMacroScanResult = CMacroScanResult {
        defines: empty_defines,
        define_count: 0,
        conditionals: empty_conditionals,
        conditional_count: 0,
        total_complexity: 0,
    };

    // Scan for #define directives
    let scan_limit: u64 = if source_len < 2097152 { source_len } else { 2097152 };
    let mut i: u64 = 0;

    while i < scan_limit - 7 {
        // Check for '#define '
        if source[i] == '#' as u8 &&
           source[i + 1] == 'd' as u8 &&
           source[i + 2] == 'e' as u8 &&
           source[i + 3] == 'f' as u8 &&
           source[i + 4] == 'i' as u8 &&
           source[i + 5] == 'n' as u8 &&
           source[i + 6] == 'e' as u8 {

            // Found a #define — extract macro name
            let mut macro_start: u64 = i + 7;
            // Skip whitespace
            while macro_start < scan_limit && (source[macro_start] == ' ' as u8 || source[macro_start] == '\t' as u8) {
                macro_start = macro_start + 1;
            }

            let mut macro_end: u64 = macro_start;
            while macro_end < scan_limit &&
                  source[macro_end] != ' ' as u8 &&
                  source[macro_end] != '(' as u8 &&
                  source[macro_end] != '\n' as u8 &&
                  source[macro_end] != '\r' as u8 {
                macro_end = macro_end + 1;
            }

            let macro_len: u64 = if macro_end > macro_start { macro_end - macro_start } else { 0 };

            if macro_len > 0 && macro_len <= 256 && result.define_count < 512 {
                let mut macro_name: FixedString[256] = FixedString[256]::zeroed();
                macro_name.len = macro_len;
                for j in 0..macro_len {
                    macro_name.data[j] = source[macro_start + j];
                }

                // Check if function-like (has parenthesis after name)
                let is_func_like: bool = macro_end < scan_limit && source[macro_end] == '(' as u8;

                // Compute hash of body
                let body_hash: Hash256 = hash_c_data(source, macro_len);

                let define: MacroDefine = MacroDefine {
                    macro_name: macro_name,
                    macro_body_hash: body_hash,
                    parameter_count: if is_func_like { 1 } else { 0 },
                    is_function_like: is_func_like,
                    is_variadic: false,
                    expansion_count: 0,
                    complexity_score: if is_func_like { 10 } else { 5 },
                    uses_token_paste: false,
                    uses_stringify: false,
                    location: FixedString[256]::from_literal("source"),
                };

                result.defines[result.define_count] = define;
                result.define_count = result.define_count + 1;
                result.total_complexity = result.total_complexity + define.complexity_score;

                // Emit residual for each macro found
                @emit_residual("c_import.scan_macro", "macro_detected", macro_len);
            }

            // Skip to end of line
            while i < scan_limit && source[i] != '\n' as u8 {
                i = i + 1;
            }
        }

        // Check for #if / #ifdef / #ifndef directives
        if source[i] == '#' as u8 &&
           (source[i + 1] == 'i' as u8 && source[i + 2] == 'f' as u8) {
            let mut conditional_start: u64 = i;
            let mut conditional_end: u64 = i;
            while conditional_end < scan_limit && source[conditional_end] != '\n' as u8 {
                conditional_end = conditional_end + 1;
            }
            let cond_len: u64 = if conditional_end > conditional_start { conditional_end - conditional_start } else { 0 };
            if cond_len > 0 && cond_len <= 512 && result.conditional_count < 256 {
                let mut cond_str: FixedString[512] = FixedString[512]::zeroed();
                cond_str.len = cond_len;
                for j in 0..cond_len {
                    cond_str.data[j] = source[conditional_start + j];
                }
                result.conditionals[result.conditional_count] = cond_str;
                result.conditional_count = result.conditional_count + 1;
                result.total_complexity = result.total_complexity + 3;
            }
        }

        i = i + 1;
    }

    @emit_residual("c_import.scan_macros", "macro_scan_complete", result.define_count);

    return result;
}

// ============================================================================
// Scan Headers in C Source
// ============================================================================

fn scan_c_headers(source: &Array[u8, 2097152], source_len: u64) -> CHeaderScanResult
    effects: [compute, residual]
{
    let empty_includes: Array[CIncludeDirective, 512] = Array[CIncludeDirective, 512]::zeroed();

    let mut result: CHeaderScanResult = CHeaderScanResult {
        includes: empty_includes,
        include_count: 0,
        resolved_count: 0,
        unresolved_count: 0,
        system_headers: 0,
        local_headers: 0,
    };

    let scan_limit: u64 = if source_len < 2097152 { source_len } else { 2097152 };
    let mut i: u64 = 0;

    while i < scan_limit - 8 {
        // Check for #include directive
        if source[i] == '#' as u8 &&
           source[i + 1] == 'i' as u8 &&
           source[i + 2] == 'n' as u8 &&
           source[i + 3] == 'c' as u8 &&
           source[i + 4] == 'l' as u8 &&
           source[i + 5] == 'u' as u8 &&
           source[i + 6] == 'd' as u8 &&
           source[i + 7] == 'e' as u8 {

            let mut inc_start: u64 = i + 8;
            // Skip whitespace
            while inc_start < scan_limit && (source[inc_start] == ' ' as u8 || source[inc_start] == '\t' as u8) {
                inc_start = inc_start + 1;
            }

            // Determine if system (<>) or local ("") include
            let is_system: bool = inc_start < scan_limit && source[inc_start] == '<' as u8;
            let is_local: bool = inc_start < scan_limit && source[inc_start] == '"' as u8;

            let close_char: u8 = if is_system { '>' as u8 } else { '"' as u8 };
            let path_start: u64 = inc_start + 1;

            let mut path_end: u64 = path_start;
            while path_end < scan_limit && source[path_end] != close_char && source[path_end] != '\n' as u8 {
                path_end = path_end + 1;
            }

            let path_len: u64 = if path_end > path_start { path_end - path_start } else { 0 };

            if path_len > 0 && path_len <= 512 && result.include_count < 512 {
                let mut include_path: FixedString[512] = FixedString[512]::zeroed();
                include_path.len = path_len;
                for j in 0..path_len {
                    include_path.data[j] = source[path_start + j];
                }

                let directive: CIncludeDirective = CIncludeDirective {
                    include_path: include_path,
                    resolved_path: FixedString[512]::zeroed(),
                    is_system_header: is_system,
                    is_standard_library: is_system,
                    is_local: is_local,
                    resolved_hash: Hash256 { bytes: Array[u8, 32]::zeroed() },
                    found: false,
                };

                result.includes[result.include_count] = directive;
                result.include_count = result.include_count + 1;

                if is_system {
                    result.system_headers = result.system_headers + 1;
                } else {
                    result.local_headers = result.local_headers + 1;
                }
            }
        }

        i = i + 1;
    }

    @emit_residual("c_import.scan_headers", "header_scan_complete", result.include_count);

    return result;
}

// ============================================================================
// Detect ABI Assumptions
// ============================================================================

fn detect_abi_assumptions(source: &Array[u8, 2097152], source_len: u64) -> Result[Array[ABIAssumption, 256], CImportError]
    effects: [compute, residual]
{
    let mut assumptions: Array[ABIAssumption, 256] = Array[ABIAssumption, 256]::zeroed();
    let mut count: u64 = 0;

    let scan_limit: u64 = if source_len < 2097152 { source_len } else { 2097152 };
    let mut i: u64 = 0;

    while i < scan_limit - 5 {
        // Check for 'sizeof' — indicates ABI assumption about type sizes
        if source[i] == 's' as u8 && source[i + 1] == 'i' as u8 &&
           source[i + 2] == 'z' as u8 && source[i + 3] == 'e' as u8 &&
           source[i + 4] == 'o' as u8 && source[i + 5] == 'f' as u8 {
            if count < 256 {
                assumptions[count] = ABIAssumption {
                    assumption_type: FixedString[128]::from_literal("type_size"),
                    description: FixedString[512]::from_literal("sizeof operator — assumes specific type sizes"),
                    struct_name: FixedString[128]::zeroed(),
                    field_name: FixedString[128]::zeroed(),
                    expected_offset: 0,
                    expected_size: 0,
                    alignment: 0,
                    is_packed: false,
                    is_verified: false,
                };
                count = count + 1;
            }
        }

        // Check for '__attribute__((packed))' — struct packing assumption
        if source[i] == '_' as u8 && i + 20 < scan_limit {
            // Simple heuristic check
        }

        // Check for 'offsetof' — field offset assumption
        if source[i] == 'o' as u8 && source[i + 1] == 'f' as u8 &&
           source[i + 2] == 'f' as u8 && source[i + 3] == 's' as u8 &&
           source[i + 4] == 'e' as u8 && source[i + 5] == 't' as u8 &&
           source[i + 6] == 'o' as u8 && source[i + 7] == 'f' as u8 {
            if count < 256 {
                assumptions[count] = ABIAssumption {
                    assumption_type: FixedString[128]::from_literal("field_offset"),
                    description: FixedString[512]::from_literal("offsetof macro — assumes specific struct layout"),
                    struct_name: FixedString[128]::zeroed(),
                    field_name: FixedString[128]::zeroed(),
                    expected_offset: 0,
                    expected_size: 0,
                    alignment: 0,
                    is_packed: false,
                    is_verified: false,
                };
                count = count + 1;
            }
        }

        i = i + 1;
    }

    @emit_residual("c_import.scan_abi", "abi_assumptions_detected", count);

    return Ok(assumptions);
}

// ============================================================================
// Detect System Calls
// ============================================================================

fn detect_c_syscalls(source: &Array[u8, 2097152], source_len: u64) -> Result[Array[CSyscallDetected, 256], CImportError]
    effects: [compute, residual]
{
    let mut syscalls: Array[CSyscallDetected, 256] = Array[CSyscallDetected, 256]::zeroed();
    let mut count: u64 = 0;

    // Common POSIX syscall wrappers to detect
    let known_syscalls: Array[FixedString[32], 48] = fixed_buf! [
        "open", "read", "write", "close", "stat", "fstat", "lseek",
        "mmap", "munmap", "brk", "sbrk", "ioctl", "fcntl",
        "socket", "bind", "listen", "accept", "connect", "send", "recv",
        "fork", "execve", "exit", "waitpid", "kill", "getpid",
        "chdir", "getcwd", "uname", "time", "nanosleep",
        "geteuid", "getegid", "getuid", "getgid", "setuid",
        "pipe", "dup", "dup2", "poll", "select", "epoll_create",
        "sigaction", "sigprocmask", "getrlimit", "setrlimit",
        "sysinfo", "clock_gettime"
    ];

    let scan_limit: u64 = if source_len < 2097152 { source_len } else { 2097152 };
    let mut i: u64 = 0;

    while i < scan_limit {
        // Heuristic: check for function call patterns like "open(" or "read("
        for s in 0..48 {
            let syscall_name: FixedString[32] = known_syscalls[s];
            if syscall_name.len == 0 {
                break;
            }

            // Check if function name appears followed by '('
            let mut match_found: bool = true;
            if i + syscall_name.len < scan_limit {
                for j in 0..syscall_name.len {
                    if source[i + j] != syscall_name.data[j] {
                        match_found = false;
                        break;
                    }
                }
                if match_found && i + syscall_name.len < scan_limit &&
                   source[i + syscall_name.len] == '(' as u8 {
                    // Found a syscall wrapper call
                    if count < 256 {
                        let mut name: FixedString[128] = FixedString[128]::zeroed();
                        name.len = syscall_name.len;
                        for j in 0..syscall_name.len {
                            name.data[j] = syscall_name.data[j];
                        }

                        syscalls[count] = CSyscallDetected {
                            syscall_name: name,
                            syscall_number: s as u64,
                            source_location: FixedString[256]::from_literal("source"),
                            argument_count: 0,
                            is_indirect: false,
                            through_library: FixedString[128]::from_literal("libc"),
                        };
                        count = count + 1;
                    }
                    break;
                }
            }
        }

        i = i + 1;
    }

    @emit_residual("c_import.scan_syscalls", "syscalls_detected", count);

    return Ok(syscalls);
}

// ============================================================================
// Detect Undefined Behavior Sites
// ============================================================================

fn detect_ub_sites(source: &Array[u8, 2097152], source_len: u64) -> Result[Array[UBSiteDetected, 128], CImportError]
    effects: [compute, residual]
{
    let mut ub_sites: Array[UBSiteDetected, 128] = Array[UBSiteDetected, 128]::zeroed();
    let mut count: u64 = 0;

    let scan_limit: u64 = if source_len < 2097152 { source_len } else { 2097152 };
    let mut i: u64 = 0;

    while i < scan_limit - 4 {
        // Check for inline assembly ('asm' keyword)
        if (source[i] == 'a' as u8 && source[i + 1] == 's' as u8 && source[i + 2] == 'm' as u8) {
            if count < 128 {
                ub_sites[count] = UBSiteDetected {
                    site_type: UBSiteType::InlineAssemblyUB,
                    location: FixedString[256]::from_literal("source"),
                    source_line: 0,
                    description: FixedString[512]::from_literal("Inline assembly detected — platform-specific UB risk"),
                    observed_behavior: FixedString[512]::zeroed(),
                    platform_assumption: FixedString[256]::from_literal("target architecture"),
                    severity: DivergenceSeverity::Critical,
                };
                count = count + 1;
            }
        }

        // Check for setjmp/longjmp
        if source[i] == 's' as u8 && source[i + 1] == 'e' as u8 &&
           source[i + 2] == 't' as u8 && source[i + 3] == 'j' as u8 &&
           source[i + 4] == 'm' as u8 && source[i + 5] == 'p' as u8 {
            if count < 128 {
                ub_sites[count] = UBSiteDetected {
                    site_type: UBSiteType::SetjmpLongjmp,
                    location: FixedString[256]::from_literal("source"),
                    source_line: 0,
                    description: FixedString[512]::from_literal("setjmp/longjmp detected — non-local goto UB risk"),
                    observed_behavior: FixedString[512]::zeroed(),
                    platform_assumption: FixedString[256]::from_literal("stack unwinding behavior"),
                    severity: DivergenceSeverity::Critical,
                };
                count = count + 1;
            }
        }

        // Check for variable-length arrays
        // Simple heuristic: look for array declaration with non-constant size
        // This is simplified; real detection requires parsing

        i = i + 1;
    }

    @emit_residual("c_import.scan_ub", "ub_sites_detected", count);

    return Ok(ub_sites);
}

// ============================================================================
// Full C Surface Scan
// ============================================================================

fn perform_c_surface_scan(cage: &mut CImportCage) -> Result[&CScanResult, CImportError]
    effects: [compute, residual]
{
    // Scan macros
    let macro_result: CMacroScanResult = scan_c_macros(&cage.source_code, cage.source_length);
    cage.scan_result.macros = macro_result;

    // Scan headers
    let header_result: CHeaderScanResult = scan_c_headers(&cage.source_code, cage.source_length);
    cage.scan_result.headers = header_result;

    // Detect ABI assumptions
    let abi_result: Array[ABIAssumption, 256] = detect_abi_assumptions(&cage.source_code, cage.source_length)?;
    for i in 0..256 {
        cage.scan_result.abi_assumptions[i] = abi_result[i];
        if abi_result[i].expected_size != 0 || abi_result[i].assumption_type.len != 0 {
            cage.scan_result.abi_assumption_count = cage.scan_result.abi_assumption_count + 1;
        }
    }

    // Detect syscalls
    let syscall_result: Array[CSyscallDetected, 256] = detect_c_syscalls(&cage.source_code, cage.source_length)?;
    for i in 0..256 {
        cage.scan_result.syscalls[i] = syscall_result[i];
        if syscall_result[i].syscall_name.len != 0 {
            cage.scan_result.syscall_count = cage.scan_result.syscall_count + 1;
        }
    }

    // Detect UB sites
    let ub_result: Array[UBSiteDetected, 128] = detect_ub_sites(&cage.source_code, cage.source_length)?;
    for i in 0..128 {
        cage.scan_result.ub_sites[i] = ub_result[i];
        if ub_result[i].site_type != UBSiteType::CustomUB || ub_result[i].description.len != 0 {
            cage.scan_result.ub_site_count = cage.scan_result.ub_site_count + 1;
        }
    }

    cage.observation_count = cage.observation_count + 1;

    @emit_residual("c_import.full_scan", "surface_scan_complete", cage.observation_count);

    return Ok(&cage.scan_result);
}

// ============================================================================
// Set Build Context
// ============================================================================

fn set_c_build_context(cage: &mut CImportCage, context: &FixedString[4096]) -> Result[(), CImportError]
    effects: [compute, residual]
{
    cage.build_context = *context;

    @emit_residual("c_import.build_context", "build_context_set", 0);

    return Ok(());
}

// ============================================================================
// Add Compiler Flag
// ============================================================================

fn add_c_compiler_flag(cage: &mut CImportCage, flag: &FixedString[256]) -> Result[(), CImportError]
    effects: [compute, residual]
{
    if cage.compiler_flag_count >= 128 {
        return Err(CImportError::ParseFailed);
    }

    // Check for duplicate
    for i in 0..cage.compiler_flag_count {
        if cage.compiler_flags_detected[i] == *flag {
            return Ok(());  // Silently skip duplicates
        }
    }

    cage.compiler_flags_detected[cage.compiler_flag_count] = *flag;
    cage.compiler_flag_count = cage.compiler_flag_count + 1;

    @emit_residual("c_import.compiler_flag", "compiler_flag_added", cage.compiler_flag_count);

    return Ok(());
}

// ============================================================================
// Add Linker Assumption
// ============================================================================

fn add_c_linker_assumption(cage: &mut CImportCage, assumption: &FixedString[256]) -> Result[(), CImportError]
    effects: [compute, residual]
{
    if cage.linker_assumption_count >= 64 {
        return Err(CImportError::ParseFailed);
    }

    cage.linker_assumptions[cage.linker_assumption_count] = *assumption;
    cage.linker_assumption_count = cage.linker_assumption_count + 1;

    return Ok(());
}

// ============================================================================
// Add Environment Variable Usage
// ============================================================================

fn add_c_env_usage(cage: &mut CImportCage, env_var: &FixedString[256]) -> Result[(), CImportError]
    effects: [compute, residual]
{
    if cage.env_var_count >= 64 {
        return Err(CImportError::ParseFailed);
    }

    cage.environment_variables[cage.env_var_count] = *env_var;
    cage.env_var_count = cage.env_var_count + 1;

    return Ok(());
}

// ============================================================================
// Generate C Import Report
// ============================================================================

type CImportReport = struct {
    source_hash: Hash256,
    macro_count: u64,
    header_count: u64,
    abi_assumption_count: u64,
    syscall_count: u64,
    ub_site_count: u64,
    compiler_flags: Array[FixedString[256], 128],
    compiler_flag_count: u64,
    undefeined_behavior_summary: FixedString[1024],
    porting_recommendation: FixedString[1024],
    observation_count: u64,
}

fn generate_c_import_report(cage: &CImportCage) -> CImportReport
    effects: [compute]
{
    let mut ub_summary: FixedString[1024] = FixedString[1024]::zeroed();
    let ub_copy_len: u64 = if cage.scan_result.ub_site_count < 10 {
        cage.scan_result.ub_site_count
    } else {
        10
    };
    let mut summary_idx: u64 = 0;
    for i in 0..ub_copy_len {
        if cage.scan_result.ub_sites[i].description.len > 0 {
            for j in 0..cage.scan_result.ub_sites[i].description.len {
                if summary_idx < 1024 {
                    ub_summary.data[summary_idx] = cage.scan_result.ub_sites[i].description.data[j];
                    summary_idx = summary_idx + 1;
                }
            }
            if summary_idx < 1024 {
                ub_summary.data[summary_idx] = ';' as u8;
                summary_idx = summary_idx + 1;
            }
        }
    }
    ub_summary.len = summary_idx;

    return CImportReport {
        source_hash: cage.source_hash,
        macro_count: cage.scan_result.macros.define_count,
        header_count: cage.scan_result.headers.include_count,
        abi_assumption_count: cage.scan_result.abi_assumption_count,
        syscall_count: cage.scan_result.syscall_count,
        ub_site_count: cage.scan_result.ub_site_count,
        compiler_flags: cage.compiler_flags_detected,
        compiler_flag_count: cage.compiler_flag_count,
        undefeined_behavior_summary: ub_summary,
        porting_recommendation: FixedString[1024]::from_literal("Review UB sites before porting"),
        observation_count: cage.observation_count,
    };
}

// ============================================================================
// Hash Helper
// ============================================================================

fn hash_c_data(data: &Array[u8, 2097152], len: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let hash_len: u64 = if len < 2097152 { len } else { 2097152 };

    for i in 0..hash_len {
        let idx: u64 = i & 31;
        result.bytes[idx] = result.bytes[idx] ^ data[i];
    }

    return result;
}
