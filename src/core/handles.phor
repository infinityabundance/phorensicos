// file: handles.phor
// purpose: GenerationTag, Handle, and Session types for the Phorensic OS.
//          Handles are generation-tagged to detect stale references after
//          revocation. Sessions provide scoped access with automatic cleanup.
// evidence: HNDL-ARCH-001 through HNDL-ARCH-120
// residual: All types are no_std, no_alloc; generation tags are u32.

use core::constants::*
use core::types::*
use core::errors::*

// ──────────────────────────────────────────────
// GenerationTag: Monotonically increasing version tag
// ──────────────────────────────────────────────
// Used to detect stale handles after resource revocation.
// Evidence path: HNDL-GEN-001 through HNDL-GEN-045

pub type GenerationTag : Word32 = struct {
    value: Word32,
}

impl GenerationTag {
    // Create a generation tag with an initial value.
    pub fn new(value: Word32) -> GenerationTag
        effects: [deterministic]
    {
        GenerationTag { value: value }
    }

    // Create a zero generation (invalid/stale).
    pub fn zero() -> GenerationTag
        effects: [deterministic]
    {
        GenerationTag { value: 0 }
    }

    // Create the initial generation (starts at 1; 0 is reserved for null).
    pub fn initial() -> GenerationTag
        effects: [deterministic]
    {
        GenerationTag { value: 1 }
    }

    // Bump the generation to the next value.
    // Wraps on overflow, but 0 is skipped (reserved for null).
    pub fn bump(self: ref mut)
        effects: [deterministic]
    {
        // trust: Wrapping addition is safe; 0 is reserved for null.
        // evidence: HNDL-BUMP-001: Generation bump skips zero to preserve null sentinel.
        trusted("generation bump: wraps around but skips zero") {
            let next: Word32 = self.value + 1
            if next == 0 {
                self.value = 1  // Skip zero
            } else {
                self.value = next
            }
        }
    }

    // Get the raw value.
    pub fn value(self) -> Word32
        effects: [deterministic]
    {
        self.value
    }

    // Check if this tag is valid (non-zero).
    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.value != 0
    }

    // Check if this tag is stale (zero).
    pub fn is_stale(self) -> bool
        effects: [deterministic]
    {
        self.value == 0
    }

    // Compare two generation tags for equality.
    pub fn eq(self, other: GenerationTag) -> bool
        effects: [deterministic]
    {
        self.value == other.value
    }

    // Check if this generation matches an expected value.
    pub fn matches(self, expected: Word32) -> bool
        effects: [deterministic]
    {
        self.value == expected
    }

    // Check ordering.
    pub fn lt(self, other: GenerationTag) -> bool
        effects: [deterministic]
    {
        self.value < other.value
    }

    pub fn gt(self, other: GenerationTag) -> bool
        effects: [deterministic]
    {
        self.value > other.value
    }

    // Convert to bytes for serialization.
    pub fn to_le_bytes(self) -> Byte[4]
        effects: [deterministic]
    {
        let raw: [u8; 4] = __builtin_u32_to_le_bytes(self.value)
        let mut result: Byte[4] = [Byte::from_u8(0); 4]
        // loop: bounds[BOUND_TINY] — exactly 4 iterations
        loop: bounds[BOUND_TINY] for i in 0..4 {
            result[i] = Byte::from_u8(raw[i])
        }
        result
    }

    // Create from little-endian bytes.
    pub fn from_le_bytes(bytes: Byte[4]) -> GenerationTag
        effects: [deterministic]
    {
        let mut raw: [u8; 4] = [0; 4]
        // loop: bounds[BOUND_TINY] — exactly 4 iterations
        loop: bounds[BOUND_TINY] for i in 0..4 {
            raw[i] = bytes[i].to_u8()
        }
        let value: u32 = __builtin_u32_from_le_bytes(raw)
        GenerationTag { value: value }
    }
}

// ──────────────────────────────────────────────
// Handle: Generation-tagged resource reference
// ──────────────────────────────────────────────
// A handle pairs a slot index with a generation tag. The handle is valid
// only if the generation matches the current generation of the resource slot.
// Evidence path: HNDL-HNDL-001 through HNDL-HNDL-060

pub type Handle : struct {
    // Index into the resource table.
    index: Word32,
    // Generation tag for stale detection.
    generation: GenerationTag,
    // Identity of the resource owner.
    owner: Identity,
    // Whether this handle is still active.
    active: bool,
}

impl Handle {
    // Create a new handle.
    pub fn new(index: Word32, generation: GenerationTag, owner: Identity) -> Handle
        effects: [deterministic]
    {
        Handle {
            index: index,
            generation: generation,
            owner: owner,
            active: true,
        }
    }

    // Create an invalid/null handle.
    pub fn null() -> Handle
        effects: [deterministic]
    {
        Handle {
            index: NULL_HANDLE,
            generation: GenerationTag::zero(),
            owner: Identity::null(),
            active: false,
        }
    }

    // Get the slot index.
    pub fn index(self) -> Word32
        effects: [deterministic]
    {
        self.index
    }

    // Get the generation tag.
    pub fn generation(self) -> GenerationTag
        effects: [deterministic]
    {
        self.generation
    }

    // Get the owner identity.
    pub fn owner(self) -> Identity
        effects: [deterministic]
    {
        self.owner
    }

    // Check if the handle is active.
    pub fn is_active(self) -> bool
        effects: [deterministic]
    {
        self.active && self.generation.is_valid()
    }

    // Check if the handle is null/invalid.
    pub fn is_null(self) -> bool
        effects: [deterministic]
    {
        !self.active || self.generation.is_stale()
    }

    // Validate the handle's generation against a table's expected generation.
    pub fn validate(self, expected_generation: GenerationTag) -> bool
        effects: [deterministic]
    {
        self.active && self.generation.eq(expected_generation)
    }

    // Invalidate the handle (consumes it — affine semantics).
    pub fn invalidate(self: ref mut)
        effects: [deterministic]
    {
        self.active = false
    }

    // Revoke the handle by zeroing the generation.
    pub fn revoke(self: ref mut)
        effects: [deterministic]
    {
        self.generation = GenerationTag::zero()
        self.active = false
    }

    // Clone the handle (only if it's still active).
    // Note: Handles are NOT affine; they can be copied because they
    // represent references, not ownership. Only capabilities are affine.
    pub fn clone(self) -> Handle
        effects: [deterministic]
    {
        Handle {
            index: self.index,
            generation: self.generation,
            owner: self.owner,
            active: self.active,
        }
    }

    // Equality check.
    pub fn eq(self, other: Handle) -> bool
        effects: [deterministic]
    {
        self.index == other.index
            && self.generation.eq(other.generation)
            && self.owner.eq(other.owner)
    }

    // Convert handle to a Word64 for hashing.
    pub fn to_word64(self) -> Word64
        effects: [deterministic]
    {
        let idx_part: u64 = (self.index as u64) << 32
        let gen_part: u64 = self.generation.value() as u64
        Word64::from_u64(idx_part | gen_part)
    }

    // Serialize handle to bytes.
    pub fn to_bytes(self) -> Byte[12]
        effects: [deterministic, serialize]
    {
        // 4 bytes index + 4 bytes generation + 8 bytes owner = 16 bytes
        let mut buf: Byte[16] = [Byte::from_u8(0); 16]
        let idx_bytes: Byte[4] = __builtin_u32_to_le_bytes_as_byte_array(self.index)
        let gen_bytes: Byte[4] = self.generation.to_byte_array()
        let own_bytes: Byte[8] = self.owner.to_le_bytes()
        // loop: bounds[BOUND_SMALL] — bounded copy
        loop: bounds[BOUND_SMALL] for i in 0..4 {
            buf[i] = idx_bytes[i]
            buf[4 + i] = gen_bytes[i]
        }
        // loop: bounds[BOUND_TINY] — exact 8
        loop: bounds[BOUND_TINY] for i in 0..8 {
            buf[8 + i] = own_bytes[i]
        }
        buf
    }
}

// ──────────────────────────────────────────────
// HandleTable: Fixed-capacity handle table
// ──────────────────────────────────────────────
// Manages a fixed array of handle slots with generation tracking.
// Evidence path: HNDL-TABLE-001 through HNDL-TABLE-055

pub type HandleSlot : struct {
    generation: GenerationTag,
    in_use: bool,
    owner: Identity,
}

impl HandleSlot {
    pub fn empty() -> HandleSlot
        effects: [deterministic]
    {
        HandleSlot {
            generation: GenerationTag::zero(),
            in_use: false,
            owner: Identity::null(),
        }
    }

    pub fn is_free(self) -> bool
        effects: [deterministic]
    {
        !self.in_use
    }

    pub fn generation(self) -> GenerationTag
        effects: [deterministic]
    {
        self.generation
    }
}

pub type HandleTable : struct {
    slots: [HandleSlot; MAX_HANDLE_SLOTS],
    count: u32,
}

impl HandleTable {
    pub fn new() -> HandleTable
        effects: [deterministic]
    {
        let mut slots: [HandleSlot; MAX_HANDLE_SLOTS] = [HandleSlot::empty(); MAX_HANDLE_SLOTS]
        HandleTable { slots: slots, count: 0 }
    }

    // Allocate a new handle slot, returning a Handle.
    pub fn allocate(self: ref mut, owner: Identity) -> Result[Handle, HandleError>
        effects: [deterministic]
    {
        if self.count >= MAX_HANDLE_SLOTS {
            return Result::Err(handle_table_full())
        }

        // Find a free slot using linear scan (bounded).
        let mut idx: u32 = 0
        let mut found: bool = false
        // loop: bounds[BOUND_LARGE] — bounded by MAX_HANDLE_SLOTS (256)
        loop: bounds[BOUND_LARGE] while idx < MAX_HANDLE_SLOTS {
            if self.slots[idx as usize].is_free() {
                found = true
                break
            }
            idx = idx + 1
        }

        if !found {
            return Result::Err(handle_table_full())
        }

        // Bump generation (skip zero).
        let mut gen: GenerationTag = self.slots[idx as usize].generation
        if gen.is_stale() {
            gen = GenerationTag::initial()
        } else {
            gen.bump()
        }

        self.slots[idx as usize] = HandleSlot {
            generation: gen,
            in_use: true,
            owner: owner,
        }
        self.count = self.count + 1

        let handle: Handle = Handle::new(idx as Word32, gen, owner)
        Result::Ok(handle)
    }

    // Get the generation for a slot.
    pub fn get_generation(self, index: Word32) -> Result[GenerationTag, HandleError>
        effects: [deterministic]
    {
        let i: u32 = index as u32
        if i >= MAX_HANDLE_SLOTS {
            return Result::Err(handle_not_found(index))
        }
        if !self.slots[i as usize].in_use {
            return Result::Err(handle_not_found(index))
        }
        Result::Ok(self.slots[i as usize].generation)
    }

    // Validate a handle against the table.
    pub fn validate(self, handle: Handle) -> bool
        effects: [deterministic]
    {
        let idx: u32 = handle.index() as u32
        if idx >= MAX_HANDLE_SLOTS {
            return false
        }
        if !self.slots[idx as usize].in_use {
            return false
        }
        handle.generation().eq(self.slots[idx as usize].generation)
    }

    // Free a handle slot.
    pub fn free(self: ref mut, handle: Handle) -> Result[(), HandleError>
        effects: [deterministic]
    {
        let idx: u32 = handle.index() as u32
        if idx >= MAX_HANDLE_SLOTS {
            return Result::Err(handle_not_found(handle.index()))
        }
        if !self.slots[idx as usize].in_use {
            return Result::Err(handle_not_found(handle.index()))
        }
        if !handle.generation().eq(self.slots[idx as usize].generation) {
            return Result::Err(handle_stale(handle.generation().value()))
        }

        self.slots[idx as usize].in_use = false
        if self.count > 0 {
            self.count = self.count - 1
        }
        Result::Ok(())
    }

    // Get the number of allocated slots.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.count
    }

    // Check if the table is full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.count >= MAX_HANDLE_SLOTS
    }

    // Check if the table is empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.count == 0
    }

    // Clear all slots (for teardown).
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        // loop: bounds[BOUND_LARGE] — bounded by MAX_HANDLE_SLOTS (256)
        loop: bounds[BOUND_LARGE] for i in 0..MAX_HANDLE_SLOTS {
            self.slots[i as usize].in_use = false
        }
        self.count = 0
    }

    // Iterate over all active handles.
    pub fn for_each(self, f: fn(Handle))
        effects: [deterministic]
    {
        // loop: bounds[BOUND_LARGE] — bounded by MAX_HANDLE_SLOTS (256)
        loop: bounds[BOUND_LARGE] for i in 0..MAX_HANDLE_SLOTS {
            if self.slots[i as usize].in_use {
                let handle: Handle = Handle::new(
                    i as Word32,
                    self.slots[i as usize].generation,
                    self.slots[i as usize].owner,
                )
                f(handle)
            }
        }
    }

    // Get the owner of a slot.
    pub fn owner(self, index: Word32) -> Result[Identity, HandleError>
        effects: [deterministic]
    {
        let i: u32 = index as u32
        if i >= MAX_HANDLE_SLOTS || !self.slots[i as usize].in_use {
            return Result::Err(handle_not_found(index))
        }
        Result::Ok(self.slots[i as usize].owner)
    }
}

// ──────────────────────────────────────────────
// Session: Scoped access session with auto-cleanup
// ──────────────────────────────────────────────
// A session wraps a set of handles and provides scoped access.
// When the session is consumed/dropped, all handles are freed.
// Evidence path: HNDL-SESS-001 through HNDL-SESS-060

pub type Session : struct {
    // The handles in this session.
    handles: Handle[MAX_SESSION_DEPTH],
    // Reference to the handle table.
    table: ref mut HandleTable,
    // Number of active handles in this session.
    count: u32,
    // Whether the session is still active.
    active: bool,
    // Session depth for nesting control.
    depth: u32,
    // Session identity.
    session_id: Identity,
}

impl Session {
    // Create a new empty session.
    pub fn new(table: ref mut HandleTable, session_id: Identity) -> Session
        effects: [deterministic]
    {
        let handles: Handle[MAX_SESSION_DEPTH] = [Handle::null(); MAX_SESSION_DEPTH]
        Session {
            handles: handles,
            table: table,
            count: 0,
            active: true,
            depth: 0,
            session_id: session_id,
        }
    }

    // Add a handle to the session.
    // This consumes the handle and adds it to the session's scope.
    pub fn add_handle(self: ref mut, handle: Handle) -> Result<(), HandleError>
        effects: [deterministic]
    {
        if !self.active {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x010),
                FixedString[128]::from_slice("Session is closed")))
        }
        if self.count >= MAX_SESSION_DEPTH {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x011),
                FixedString[128]::from_slice("Session handle limit reached")))
        }
        // Validate the handle against the table.
        if !self.table.validate(handle) {
            return Result::Err(handle_stale(handle.generation().value()))
        }
        self.handles[self.count as usize] = handle
        self.count = self.count + 1
        Result::Ok(())
    }

    // Get a handle from the session by index.
    pub fn get_handle(self, session_local_index: u32) -> Result[Handle, HandleError>
        effects: [deterministic]
    {
        if !self.active {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x012),
                FixedString[128]::from_slice("Session is closed")))
        }
        if session_local_index >= self.count {
            return Result::Err(handle_not_found(session_local_index as Word32))
        }
        Result::Ok(self.handles[session_local_index as usize])
    }

    // Validate all handles in the session.
    pub fn validate_all(self) -> bool
        effects: [deterministic]
    {
        if !self.active {
            return false
        }
        // loop: bounds[BOUND_SMALL] — bounded by session depth
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if !self.table.validate(self.handles[i as usize]) {
                return false
            }
        }
        true
    }

    // Get the number of handles in the session.
    pub fn handle_count(self) -> u32
        effects: [deterministic]
    {
        self.count
    }

    // Check if the session is active.
    pub fn is_active(self) -> bool
        effects: [deterministic]
    {
        self.active
    }

    // Get the session depth.
    pub fn depth(self) -> u32
        effects: [deterministic]
    {
        self.depth
    }

    // Enter a nested sub-session.
    pub fn enter_sub_session(self: ref mut) -> Result[SessionGuard, HandleError>
        effects: [deterministic]
    {
        if !self.active {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x013),
                FixedString[128]::from_slice("Session is closed")))
        }
        if self.depth >= MAX_SESSION_DEPTH {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x014),
                FixedString[128]::from_slice("Session depth exceeded")))
        }
        let guard: SessionGuard = SessionGuard {
            saved_count: self.count,
            saved_depth: self.depth,
        }
        self.depth = self.depth + 1
        Result::Ok(guard)
    }

    // Exit a sub-session and restore handles.
    pub fn exit_sub_session(self: ref mut, guard: SessionGuard)
        effects: [deterministic]
    {
        // Restore the saved handle count (abandon sub-session handles).
        self.count = guard.saved_count
        if self.depth > 0 {
            self.depth = self.depth - 1
        }
    }

    // Consume the session, releasing all handles.
    pub fn close(self: ref mut)
        effects: [deterministic]
    {
        if !self.active {
            return
        }
        // Free all handles in the session.
        // loop: bounds[BOUND_SMALL] — bounded by session count
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            let handle: Handle = self.handles[i as usize]
            // Attempt to free; ignore errors (handle may already be freed).
            let _: Result[(), HandleError] = self.table.free(handle)
        }
        self.count = 0
        self.active = false
    }

    // Transfer a handle out of the session.
    // This removes it from the session without freeing it.
    pub fn take_handle(self: ref mut, session_local_index: u32) -> Result[Handle, HandleError>
        effects: [deterministic]
    {
        if !self.active {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x015),
                FixedString[128]::from_slice("Session is closed")))
        }
        if session_local_index >= self.count {
            return Result::Err(handle_not_found(session_local_index as Word32))
        }
        let handle: Handle = self.handles[session_local_index as usize]
        // Compact the array by shifting remaining handles left.
        // loop: bounds[BOUND_SMALL] — bounded by session count
        loop: bounds[BOUND_SMALL] for i in (session_local_index + 1)..self.count {
            self.handles[(i - 1) as usize] = self.handles[i as usize]
        }
        self.count = self.count - 1
        Result::Ok(handle)
    }

    // Get the session identity.
    pub fn session_id(self) -> Identity
        effects: [deterministic]
    {
        self.session_id
    }

    // Check if a specific handle is in the session.
    pub fn contains(self, handle: Handle) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by session count
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if self.handles[i as usize].eq(handle) {
                return true
            }
        }
        false
    }

    // Count active handles that match a predicate.
    pub fn count_if(self, predicate: fn(Handle) -> bool) -> u32
        effects: [deterministic]
    {
        let mut count: u32 = 0
        // loop: bounds[BOUND_SMALL] — bounded by session count
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if predicate(self.handles[i as usize]) {
                count = count + 1
            }
        }
        count
    }
}

// ──────────────────────────────────────────────
// SessionGuard: RAII guard for sub-sessions
// ──────────────────────────────────────────────
// Evidence path: HNDL-GUARD-001 through HNDL-GUARD-020

pub type SessionGuard : struct {
    saved_count: u32,
    saved_depth: u32,
}

impl SessionGuard {
    pub fn new(saved_count: u32, saved_depth: u32) -> SessionGuard
        effects: [deterministic]
    {
        SessionGuard {
            saved_count: saved_count,
            saved_depth: saved_depth,
        }
    }

    // Dismiss the guard, keeping sub-session handles promoted to parent.
    pub fn dismiss(self: ref mut)
        effects: [deterministic]
    {
        // Simply leak the guard; parent count is not restored.
        // This means sub-session handles are promoted.
    }
}

// ──────────────────────────────────────────────
// Handle Manager: Creates and manages handles
// ──────────────────────────────────────────────
// Evidence path: HNDL-MGR-001 through HNDL-MGR-030

pub type HandleManager : struct {
    table: HandleTable,
    next_session_id: Word64,
}

impl HandleManager {
    pub fn new() -> HandleManager
        effects: [deterministic]
    {
        HandleManager {
            table: HandleTable::new(),
            next_session_id: 1,
        }
    }

    // Open a new handle.
    pub fn open(self: ref mut, owner: Identity) -> Result[Handle, HandleError>
        effects: [deterministic]
    {
        self.table.allocate(owner)
    }

    // Close a handle.
    pub fn close(self: ref mut, handle: Handle) -> Result[(), HandleError>
        effects: [deterministic]
    {
        self.table.free(handle)
    }

    // Validate a handle.
    pub fn is_valid(self, handle: Handle) -> bool
        effects: [deterministic]
    {
        self.table.validate(handle)
    }

    // Create a new session.
    pub fn create_session(self: ref mut) -> Session
        effects: [deterministic]
    {
        let session_id_val: Word64 = self.next_session_id
        self.next_session_id = self.next_session_id + 1
        let sid: Identity = Identity::new(Word64::from_u64(session_id_val))
        Session::new(&mut self.table, sid)
    }

    // Get the handle table (for direct access).
    pub fn table(self: ref mut) -> ref mut HandleTable
        effects: [deterministic]
    {
        &mut self.table
    }

    // Get the number of handles.
    pub fn handle_count(self) -> u32
        effects: [deterministic]
    {
        self.table.count()
    }

    // Close all handles (for teardown).
    pub fn close_all(self: ref mut)
        effects: [deterministic]
    {
        self.table.clear()
    }
}

// ──────────────────────────────────────────────
// TypedHandle: Handle with a type tag for type safety
// ──────────────────────────────────────────────
// Evidence path: HNDL-TYPED-001 through HNDL-TYPED-025

pub type TypedHandle[T] : struct {
    handle: Handle,
}

impl[T] TypedHandle[T] {
    pub fn new(handle: Handle) -> TypedHandle[T]
        effects: [deterministic]
    {
        TypedHandle { handle: handle }
    }

    pub fn null() -> TypedHandle[T]
        effects: [deterministic]
    {
        TypedHandle { handle: Handle::null() }
    }

    pub fn inner(self) -> Handle
        effects: [deterministic]
    {
        self.handle
    }

    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.handle.is_active()
    }

    pub fn is_null(self) -> bool
        effects: [deterministic]
    {
        self.handle.is_null()
    }

    pub fn index(self) -> Word32
        effects: [deterministic]
    {
        self.handle.index()
    }

    pub fn generation(self) -> GenerationTag
        effects: [deterministic]
    {
        self.handle.generation()
    }

    // Convert typed handle to raw handle (for table operations).
    pub fn into_raw(self) -> Handle
        effects: [deterministic]
    {
        self.handle
    }
}

// ──────────────────────────────────────────────
// Handle-based resource protection
// ──────────────────────────────────────────────
// Evidence path: HNDL-PROTECT-001 through HNDL-PROTECT-015

// Check if a handle provides a specific capability right.
// This is the bridge between handles and capabilities.
pub fn handle_has_right(
    handle: Handle,
    required_right: Word64,
    capability_table: ref CapabilityTable,
) -> Result[bool, HandleError>
    effects: [deterministic]
{
    if !handle.is_active() {
        return Result::Err(handle_stale(handle.generation().value()))
    }
    // The handle's owner in the capability table determines access.
    let owner: Identity = handle.owner()
    // loop: bounds[BOUND_LARGE] — bounded by capability table slots
    // In practice, this is a lookup by owner identity.
    Result::Ok(true) // Placeholder: actual check requires capability lookup.
}

// ──────────────────────────────────────────────
// Handle Index: Type-safe index into handle tables
// ──────────────────────────────────────────────
// Evidence path: HNDL-IDX-001 through HNDL-IDX-025

pub type HandleIndex : struct {
    value: u32,
}

impl HandleIndex {
    pub fn new(value: u32) -> HandleIndex
        effects: [deterministic]
    {
        HandleIndex { value: value }
    }

    pub fn null() -> HandleIndex
        effects: [deterministic]
    {
        HandleIndex { value: NULL_HANDLE }
    }

    pub fn value(self) -> u32
        effects: [deterministic]
    {
        self.value
    }

    pub fn is_null(self) -> bool
        effects: [deterministic]
    {
        self.value == NULL_HANDLE
    }

    pub fn eq(self, other: HandleIndex) -> bool
        effects: [deterministic]
    {
        self.value == other.value
    }
}

// ──────────────────────────────────────────────
// HandleAllocator: Efficient handle slot allocation
// ──────────────────────────────────────────────
// Uses a free-list for O(1) allocation.
// Evidence path: HNDL-ALLOC-001 through HNDL-ALLOC-030

pub type HandleAllocator : struct {
    free_list: FixedArray[MAX_HANDLE_SLOTS, u32],
    free_count: u32,
    next_index: u32,
    initialized: bool,
}

impl HandleAllocator {
    pub fn new() -> HandleAllocator
        effects: [deterministic]
    {
        let mut alloc: HandleAllocator = HandleAllocator {
            free_list: FixedArray::new(),
            free_count: 0,
            next_index: 0,
            initialized: false,
        }
        // Build free list.
        // loop: bounds[BOUND_LARGE] — bounded by MAX_HANDLE_SLOTS
        loop: bounds[BOUND_LARGE] for i in 0..MAX_HANDLE_SLOTS {
            let _: Result<(), BoundsError> = alloc.free_list.push(i)
        }
        alloc.free_count = MAX_HANDLE_SLOTS
        alloc.next_index = 0
        alloc.initialized = true
        alloc
    }

    // Allocate a handle index.
    pub fn allocate(self: ref mut) -> Result[u32, HandleError>
        effects: [deterministic]
    {
        if self.free_count == 0 {
            return Result::Err(handle_table_full())
        }
        let idx: u32 = self.free_list.get(self.next_index).unwrap()
        self.next_index = self.next_index + 1
        self.free_count = self.free_count - 1
        Result::Ok(idx)
    }

    // Free a handle index (return to free list).
    pub fn free(self: ref mut, index: u32) -> Result<(), HandleError>
        effects: [deterministic]
    {
        if self.free_count >= MAX_HANDLE_SLOTS {
            return Result::Err(handle_table_full())
        }
        // Add to the free list at the position just after current next.
        // This is a stack-based free list for cache efficiency.
        if self.next_index > 0 {
            self.next_index = self.next_index - 1
            self.free_list.set(self.next_index, index).unwrap_or(())
        }
        self.free_count = self.free_count + 1
        Result::Ok(())
    }

    // Get the number of free slots.
    pub fn free_count(self) -> u32
        effects: [deterministic]
    {
        self.free_count
    }

    // Get the number of used slots.
    pub fn used_count(self) -> u32
        effects: [deterministic]
    {
        MAX_HANDLE_SLOTS - self.free_count
    }

    // Check if the allocator is full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.free_count == 0
    }

    // Check if the allocator is empty.
    pub fn is_empty(self) -> bool
        effects: [deterministic]
    {
        self.free_count == MAX_HANDLE_SLOTS
    }
}

// ──────────────────────────────────────────────
// Handle Table Iterator
// ──────────────────────────────────────────────
// Evidence path: HNDL-ITER-001 through HNDL-ITER-020

pub type HandleTableIterator : struct {
    table: ref HandleTable,
    current: u32,
    remaining: u32,
}

impl HandleTableIterator {
    pub fn new(table: ref HandleTable) -> HandleTableIterator
        effects: [deterministic]
    {
        HandleTableIterator {
            table: table,
            current: 0,
            remaining: table.count(),
        }
    }

    // Get the next active handle.
    pub fn next(self: ref mut) -> Option[Handle>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_LARGE] — bounded by MAX_HANDLE_SLOTS
        loop: bounds[BOUND_LARGE] while self.current < MAX_HANDLE_SLOTS && self.remaining > 0 {
            if self.table.slots[self.current as usize].in_use {
                self.remaining = self.remaining - 1
                let handle: Handle = Handle::new(
                    self.current as Word32,
                    self.table.slots[self.current as usize].generation,
                    self.table.slots[self.current as usize].owner,
                )
                self.current = self.current + 1
                return Option::Some(handle)
            }
            self.current = self.current + 1
        }
        Option::None
    }

    // Check if there are more handles.
    pub fn has_next(self) -> bool
        effects: [deterministic]
    {
        self.remaining > 0
    }

    // Collect all remaining handles into an array.
    pub fn collect(self: ref mut) -> FixedArray[MAX_HANDLE_SLOTS, Handle>
        effects: [deterministic]
    {
        let mut result: FixedArray[MAX_HANDLE_SLOTS, Handle> = FixedArray::new()
        // loop: bounds[BOUND_LARGE] — bounded by MAX_HANDLE_SLOTS
        loop: bounds[BOUND_LARGE] while self.remaining > 0 {
            match self.next() {
                Option::Some(handle) => {
                    let _: Result<(), BoundsError> = result.push(handle)
                },
                Option::None => break,
            }
        }
        result
    }
}

// ──────────────────────────────────────────────
// Session Pair: Bidirectional session connection
// ──────────────────────────────────────────────
// Evidence path: HNDL-SPAIR-001 through HNDL-SPAIR-025

pub type SessionPair : struct {
    local_session: Session,
    remote_session: Session,
    connection_id: Identity,
    established: bool,
}

impl SessionPair {
    pub fn new(
        local_table: ref mut HandleTable,
        remote_table: ref mut HandleTable,
        connection_id: Identity,
    ) -> SessionPair
        effects: [deterministic]
    {
        let local_sess: Session = Session::new(local_table, connection_id)
        let remote_sess: Session = Session::new(remote_table, connection_id)
        SessionPair {
            local_session: local_sess,
            remote_session: remote_sess,
            connection_id: connection_id,
            established: false,
        }
    }

    // Establish the session pair.
    pub fn establish(self: ref mut)
        effects: [deterministic]
    {
        self.established = true
    }

    // Send a handle from local to remote.
    pub fn send_handle(self: ref mut, handle: Handle) -> Result<(), HandleError>
        effects: [deterministic]
    {
        if !self.established {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x020),
                FixedString[128]::from_slice("Session pair not established")))
        }
        self.remote_session.add_handle(handle)
    }

    // Receive a handle from remote to local.
    pub fn recv_handle(self: ref mut, handle: Handle) -> Result<(), HandleError>
        effects: [deterministic]
    {
        if !self.established {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x021),
                FixedString[128]::from_slice("Session pair not established")))
        }
        self.local_session.add_handle(handle)
    }

    // Close both sessions.
    pub fn close(self: ref mut)
        effects: [deterministic]
    {
        self.local_session.close()
        self.remote_session.close()
        self.established = false
    }

    // Check if the session pair is established.
    pub fn is_established(self) -> bool
        effects: [deterministic]
    {
        self.established
    }

    // Get the connection identity.
    pub fn connection_id(self) -> Identity
        effects: [deterministic]
    {
        self.connection_id
    }
}

// ──────────────────────────────────────────────
// Handle Policy: Access control policy for handles
// ──────────────────────────────────────────────
// Evidence path: HNDL-POLICY-001 through HNDL-POLICY-020

pub type HandlePolicy : struct {
    max_handles_per_session: u32,
    allow_cross_session_transfer: bool,
    require_generation_check: bool,
    auto_revoke_on_close: bool,
    trust_required: TrustLevel,
}

impl HandlePolicy {
    pub fn default() -> HandlePolicy
        effects: [deterministic]
    {
        HandlePolicy {
            max_handles_per_session: MAX_SESSION_DEPTH,
            allow_cross_session_transfer: false,
            require_generation_check: true,
            auto_revoke_on_close: true,
            trust_required: TrustLevel::Trust_Scoped,
        }
    }

    pub fn strict() -> HandlePolicy
        effects: [deterministic]
    {
        HandlePolicy {
            max_handles_per_session: 8,
            allow_cross_session_transfer: false,
            require_generation_check: true,
            auto_revoke_on_close: true,
            trust_required: TrustLevel::Trust_Verified,
        }
    }

    pub fn relaxed() -> HandlePolicy
        effects: [deterministic]
    {
        HandlePolicy {
            max_handles_per_session: MAX_SESSION_DEPTH,
            allow_cross_session_transfer: true,
            require_generation_check: false,
            auto_revoke_on_close: false,
            trust_required: TrustLevel::Trust_Untrusted,
        }
    }

    // Validate a handle operation against this policy.
    pub fn validate_operation(self, operation: FixedString[32], trust: TrustLevel) -> Result<(), HandleError>
        effects: [deterministic]
    {
        if trust.to_ordinal() < self.trust_required.to_ordinal() {
            return Result::Err(handle_invalid_access(
                FixedString[128]::from_slice("Insufficient trust for handle operation")))
        }
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Handle Multi-Table Router
// ──────────────────────────────────────────────
// Routes handle operations across multiple handle tables.
// Evidence path: HNDL-ROUTER-001 through HNDL-ROUTER-025

pub type HandleTableRouter : struct {
    tables: FixedArray[CAPACITY_MEDIUM, HandleTable],
    table_count: u32,
}

impl HandleTableRouter {
    pub fn new() -> HandleTableRouter
        effects: [deterministic]
    {
        HandleTableRouter {
            tables: FixedArray::new(),
            table_count: 0,
        }
    }

    // Register a handle table.
    pub fn register_table(self: ref mut, table: HandleTable) -> Result<u32, BoundsError>
        effects: [deterministic]
    {
        let idx: u32 = self.table_count
        self.tables.push(table)?;
        self.table_count = self.table_count + 1
        Result::Ok(idx)
    }

    // Route a handle to its owning table and validate.
    pub fn validate(self, handle: Handle) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by table count
        loop: bounds[BOUND_MEDIUM] for i in 0..self.table_count {
            let table: HandleTable = self.tables.get(i).unwrap()
            if table.validate(handle) {
                return true
            }
        }
        false
    }

    // Free a handle across all tables.
    pub fn free(self: ref mut, handle: Handle) -> Result<(), HandleError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by table count
        loop: bounds[BOUND_MEDIUM] for i in 0..self.table_count {
            let result: Result<(), HandleError> = self.tables.get_mut(i).unwrap().free(handle)
            if result.is_ok() {
                return result
            }
        }
        Result::Err(handle_not_found(handle.index()))
    }

    // Get the number of registered tables.
    pub fn table_count(self) -> u32 { self.table_count }
}

// ──────────────────────────────────────────────
// Handle Leasing (time-bounded handle grants)
// ──────────────────────────────────────────────
// Evidence path: HNDL-LEASE-001 through HNDL-LEASE-025

pub type HandleLease : struct {
    handle: Handle,
    issued_at: Timestamp,
    expires_at: Timestamp,
    renewable: bool,
    active: bool,
}

impl HandleLease {
    pub fn new(
        handle: Handle,
        issued_at: Timestamp,
        expires_at: Timestamp,
        renewable: bool,
    ) -> HandleLease
        effects: [deterministic]
    {
        HandleLease {
            handle: handle,
            issued_at: issued_at,
            expires_at: expires_at,
            renewable: renewable,
            active: true,
        }
    }

    pub fn handle(self) -> Handle { self.handle }
    pub fn issued(self) -> Timestamp { self.issued_at }
    pub fn expires(self) -> Timestamp { self.expires_at }
    pub fn is_renewable(self) -> bool { self.renewable }

    // Check if the lease is still valid.
    pub fn is_valid(self, now: Timestamp) -> bool
        effects: [deterministic]
    {
        self.active && now.lte(self.expires_at)
    }

    // Check if the lease has expired.
    pub fn is_expired(self, now: Timestamp) -> bool
        effects: [deterministic]
    {
        now.gt(self.expires_at)
    }

    // Renew the lease for an additional duration.
    pub fn renew(self: ref mut, additional_duration: Duration) -> Result<(), HandleError>
        effects: [deterministic]
    {
        if !self.renewable {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x030),
                FixedString[128]::from_slice("Handle lease is not renewable")))
        }
        if !self.active {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x031),
                FixedString[128]::from_slice("Handle lease is not active")))
        }
        let new_expiry: Timestamp = self.expires_at.checked_add_nanos(additional_duration.as_nanos())?
        self.expires_at = new_expiry
        Result::Ok(())
    }

    // Revoke the lease (early termination).
    pub fn revoke(self: ref mut)
        effects: [deterministic]
    {
        self.active = false
    }

    // Extend to a specific absolute time.
    pub fn extend_to(self: ref mut, new_expiry: Timestamp) -> Result<(), HandleError>
        effects: [deterministic]
    {
        if !self.renewable {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x032),
                FixedString[128]::from_slice("Handle lease is not extendable")))
        }
        if new_expiry.lt(self.expires_at) {
            return Result::Err(HandleError::new(
                Word64::from_u64(DIAG_HANDLE_BASE | 0x033),
                FixedString[128]::from_slice("New expiry must be after current expiry")))
        }
        self.expires_at = new_expiry
        Result::Ok(())
    }

    // Get the remaining duration.
    pub fn remaining(self, now: Timestamp) -> Duration
        effects: [deterministic]
    {
        if now.gte(self.expires_at) {
            Duration::zero()
        } else {
            self.expires_at.duration_to(now)
        }
    }
}

// ──────────────────────────────────────────────
// Handle Table Statistics
// ──────────────────────────────────────────────
// Evidence path: HNDL-STATS-001 through HNDL-STATS-020

pub type HandleTableStats : struct {
    total_slots: u32,
    used_slots: u32,
    free_slots: u32,
    peak_used: u32,
    allocation_count: u64,
    free_count: u64,
    stale_detections: u64,
    last_generation_bump: Timestamp,
}

impl HandleTableStats {
    pub fn new() -> HandleTableStats
        effects: [deterministic]
    {
        HandleTableStats {
            total_slots: MAX_HANDLE_SLOTS,
            used_slots: 0,
            free_slots: MAX_HANDLE_SLOTS,
            peak_used: 0,
            allocation_count: 0,
            free_count: 0,
            stale_detections: 0,
            last_generation_bump: Timestamp::zero(),
        }
    }

    // Record an allocation.
    pub fn record_alloc(self: ref mut, new_used: u32)
        effects: [deterministic]
    {
        self.used_slots = new_used
        self.free_slots = self.total_slots - new_used
        self.allocation_count = self.allocation_count + 1
        if new_used > self.peak_used {
            self.peak_used = new_used
        }
    }

    // Record a free.
    pub fn record_free(self: ref mut, new_used: u32)
        effects: [deterministic]
    {
        self.used_slots = new_used
        self.free_slots = self.total_slots - new_used
        self.free_count = self.free_count + 1
    }

    // Record a stale detection.
    pub fn record_stale(self: ref mut)
        effects: [deterministic]
    {
        self.stale_detections = self.stale_detections + 1
    }

    // Record a generation bump.
    pub fn record_gen_bump(self: ref mut, time: Timestamp)
        effects: [deterministic]
    {
        self.last_generation_bump = time
    }

    // Get utilization ratio as a percentage [0, 100].
    pub fn utilization_pct(self) -> u32
        effects: [deterministic]
    {
        if self.total_slots == 0 { return 0 }
        (self.used_slots * 100) / self.total_slots
    }

    // Check if statistics indicate health.
    pub fn is_healthy(self) -> bool
        effects: [deterministic]
    {
        self.stale_detections < 1000 && self.utilization_pct() < 95
    }

    // Format statistics as a string.
    pub fn format(self) -> FixedString[128]
        effects: [deterministic]
    {
        let mut buf: FixedString[128] = FixedString::new()
        buf.append(FixedString::from_slice("Used: "))
        // In production: append formatted number
        buf.append(FixedString::from_slice("/"))
        buf.append(FixedString::from_slice("Peak: "))
        buf.append(FixedString::from_slice(" Stale: "))
        buf
    }
}
