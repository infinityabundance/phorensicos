// file: path.phor
// purpose: Path resolution: canonicalization, parent traversal, symlink resolution,
//          mount point crossing, access checking, path component iteration
// effects: [io, deterministic]
// status: [VERIFIED]

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::handles::*
use core::capabilities::*
use filesystem::phorensic_fs::*
use filesystem::vfs::*

// ──────────────────────────────────────────────
// Path Constants
// ──────────────────────────────────────────────
// Evidence path: PATH-ARCH-001 through PATH-ARCH-015

const DIAG_PATH_BASE      : Word64 = 0x5200
const MAX_PATH_DEPTH      : u32 = 64
const MAX_SYMLINK_CHAIN   : u32 = 40
const MAX_PATH_BYTES      : u32 = 1024

const BOUND_PATH_SMALL    : u32 = 64
const BOUND_PATH_MEDIUM   : u32 = 256
const BOUND_PATH_LARGE    : u32 = 1024

// ──────────────────────────────────────────────
// Path Error Types
// ──────────────────────────────────────────────
// Evidence path: PATH-ERR-001 through PATH-ERR-010

pub type PathError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl PathError {
    pub fn new(code: Word64, msg: FixedString[128]) -> PathError
        effects: [deterministic]
    {
        PathError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }
}

impl Error for PathError {
    fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust
    }

    fn in_range(self, base: Word64, end: Word64) -> bool
        effects: [deterministic]
    {
        self.code.gte(base) && self.code.lte(end)
    }
}

pub fn path_invalid(msg: FixedString[128]) -> PathError
    effects: [deterministic]
{
    PathError::new(Word64::from_u64(DIAG_PATH_BASE | 0x001), msg)
}

pub fn path_too_long(msg: FixedString[128]) -> PathError
    effects: [deterministic]
{
    PathError::new(Word64::from_u64(DIAG_PATH_BASE | 0x002), msg)
}

pub fn path_loop(msg: FixedString[128]) -> PathError
    effects: [deterministic]
{
    PathError::new(Word64::from_u64(DIAG_PATH_BASE | 0x003), msg)
}

pub fn path_not_found(msg: FixedString[128]) -> PathError
    effects: [deterministic]
{
    PathError::new(Word64::from_u64(DIAG_PATH_BASE | 0x004), msg)
}

pub fn path_perm_denied(msg: FixedString[128]) -> PathError
    effects: [deterministic]
{
    PathError::new(Word64::from_u64(DIAG_PATH_BASE | 0x005), msg)
}

// ──────────────────────────────────────────────
// Path Component Type
// ──────────────────────────────────────────────
// Evidence path: PATH-COMP-001 through PATH-COMP-020

pub type PathComponent : struct {
    name: Byte[255],               // Component name bytes
    name_length: Word32,           // Length of name
    component_type: InodeType,     // Type of component (file, dir, symlink)
    inode_number: Word64,          // Inode number if resolved
    mount_id: Word32,              // Mount ID if resolved
    resolved: bool,                // Whether this component is resolved
}

impl PathComponent {
    pub fn new(name: Byte[Slice]) -> Result[PathComponent, PathError>
        effects: [deterministic]
    {
        let len: u32 = name.len()
        if len == 0 {
            return Result::Err(path_invalid("Empty path component"))
        }
        if len > 255 {
            return Result::Err(path_too_long("Path component exceeds 255 bytes"))
        }
        let mut pc: PathComponent = PathComponent {
            name: [Byte::from_u8(0); 255],
            name_length: Word32::from_u32(len),
            component_type: InodeType::InodeType_Unknown,
            inode_number: Word64::zero(),
            mount_id: Word32::from_u32(0),
            resolved: false,
        }
        // loop: bounds[BOUND_FS_SMALL] — bounded by 255
        loop: bounds[BOUND_FS_SMALL] for i in 0..len {
            pc.name[i as usize] = name[i as usize]
        }
        Result::Ok(pc)
    }

    pub fn is_dot(self) -> bool
        effects: [deterministic]
    {
        self.name_length.to_u32() == 1 && self.name[0].eq(Byte::from_u8(b'.'))
    }

    pub fn is_dotdot(self) -> bool
        effects: [deterministic]
    {
        self.name_length.to_u32() == 2 && self.name[0].eq(Byte::from_u8(b'.')) && self.name[1].eq(Byte::from_u8(b'.'))
    }

    pub fn to_slice(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let len: u32 = self.name_length.to_u32()
        let mut slice: Byte[Slice] = Byte[Slice]::new(len)
        // loop: bounds[BOUND_FS_SMALL] — bounded by 255
        loop: bounds[BOUND_FS_SMALL] for i in 0..len {
            slice[i] = self.name[i as usize]
        }
        slice
    }

    pub fn matches(self, other: Byte[Slice]) -> bool
        effects: [deterministic]
    {
        let len: u32 = self.name_length.to_u32()
        if len != other.len() {
            return false
        }
        // loop: bounds[BOUND_FS_SMALL] — bounded by 255
        loop: bounds[BOUND_FS_SMALL] for i in 0..len {
            if self.name[i as usize].neq(other[i as usize]) {
                return false
            }
        }
        true
    }
}

// ──────────────────────────────────────────────
// Path Structure
// ──────────────────────────────────────────────
// Evidence path: PATH-STRUCT-001 through PATH-STRUCT-025

pub type Path : struct {
    components: FixedArray[64, PathComponent],  // Path components (up to 64)
    component_count: Word32,                    // Number of components
    absolute: bool,                             // Whether path is absolute
    raw_path: Byte[MAX_PATH_BYTES],             // Original raw path
    raw_length: Word32,                         // Length of raw path
    mount_id: Word32,                           // Mount point ID
}

impl Path {
    pub fn from_slice(path_bytes: Byte[Slice]) -> Result[Path, PathError>
        effects: [deterministic]
    {
        let len: u32 = path_bytes.len()
        if len > MAX_PATH_BYTES {
            return Result::Err(path_too_long("Path exceeds maximum length"))
        }
        if len == 0 {
            return Result::Err(path_invalid("Empty path"))
        }

        let is_abs: bool = path_bytes[0].eq(Byte::from_u8(b'/'))
        let mut p: Path = Path {
            components: FixedArray::new(),
            component_count: Word32::from_u32(0),
            absolute: is_abs,
            raw_path: [Byte::from_u8(0); MAX_PATH_BYTES],
            raw_length: Word32::from_u32(len),
            mount_id: Word32::from_u32(0),
        }

        // Copy raw path.
        // loop: bounds[BOUND_PATH_LARGE] — bounded by MAX_PATH_BYTES
        loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
            p.raw_path[i as usize] = path_bytes[i as usize]
        }

        // Parse components.
        let mut iter: PathIterator = PathIterator::new(path_bytes)
        // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
        loop: bounds[BOUND_PATH_SMALL] for _ in 0..64 {
            let comp_opt: Option[Byte[Slice]] = iter.next_component()
            if comp_opt.is_none() {
                break
            }
            let comp: Byte[Slice] = comp_opt.unwrap()
            let pc: PathComponent = PathComponent::new(comp)?
            p.components.push(pc)
        }
        p.component_count = Word32::from_u32(p.components.len())
        Result::Ok(p)
    }

    pub fn is_absolute(self) -> bool
        effects: [deterministic]
    {
        self.absolute
    }

    pub fn is_root(self) -> bool
        effects: [deterministic]
    {
        self.component_count.to_u32() == 0 && self.absolute
    }

    pub fn component_count(self) -> u32
        effects: [deterministic]
    {
        self.component_count.to_u32()
    }

    pub fn get_component(self, index: u32) -> Option[PathComponent]
        effects: [deterministic]
    {
        self.components.get(index)
    }

    pub fn first_component(self) -> Option[PathComponent]
        effects: [deterministic]
    {
        self.components.first()
    }

    pub fn last_component(self) -> Option[PathComponent]
        effects: [deterministic]
    {
        self.components.last()
    }

    pub fn parent_path(self) -> Result[Path, PathError>
        effects: [deterministic]
    {
        if self.component_count.to_u32() == 0 {
            if self.absolute {
                return Result::Ok(self)
            }
            return Result::Err(path_invalid("No parent of empty relative path"))
        }
        // Remove last component and rebuild.
        let new_count: u32 = self.component_count.to_u32() - 1
        let mut new_components: FixedArray[64, PathComponent] = FixedArray::new()
        // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
        loop: bounds[BOUND_PATH_SMALL] for i in 0..new_count {
            let comp: PathComponent = self.components.get(i).unwrap_or(PathComponent::new(Byte[Slice]::new(0)))
            new_components.push(comp)
        }
        let mut p: Path = Path {
            components: new_components,
            component_count: Word32::from_u32(new_count),
            absolute: self.absolute,
            raw_path: [Byte::from_u8(0); MAX_PATH_BYTES],
            raw_length: self.raw_length,
            mount_id: self.mount_id,
        }
        Result::Ok(p)
    }

    pub fn append_component(self: ref mut, component: Byte[Slice]) -> Result<(), PathError>
        effects: [deterministic]
    {
        if self.component_count.to_u32() >= 64 {
            return Result::Err(path_too_long("Maximum path components reached"))
        }
        let pc: PathComponent = PathComponent::new(component)?
        self.components.push(pc)
        self.component_count = Word32::from_u32(self.components.len())
        Result::Ok(())
    }

    pub fn to_slice(self) -> Byte[Slice]
        effects: [deterministic]
    {
        // Calculate total length: slashes between components.
        let count: u32 = self.component_count.to_u32()
        let mut total: u32 = 0
        // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
        loop: bounds[BOUND_PATH_SMALL] for i in 0..count {
            let comp: PathComponent = self.components.get(i).unwrap_or(PathComponent::new(Byte[Slice]::new(0)))
            total = total + comp.name_length.to_u32()
        }
        if count > 0 {
            total = total + (count - 1)  // slashes between
        }
        if self.absolute {
            total = total + 1  // leading slash
        }
        if total > MAX_PATH_BYTES {
            total = MAX_PATH_BYTES
        }
        let mut result: Byte[Slice] = Byte[Slice]::new(total)
        let mut pos: u32 = 0
        if self.absolute {
            result[pos] = Byte::from_u8(b'/')
            pos = pos + 1
        }
        // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
        loop: bounds[BOUND_PATH_SMALL] for i in 0..count {
            if i > 0 || self.absolute {
                if pos < total {
                    // Slash already placed for absolute
                }
            }
            let comp: PathComponent = self.components.get(i).unwrap_or(PathComponent::new(Byte[Slice]::new(0)))
            let clen: u32 = comp.name_length.to_u32()
            // loop: bounds[BOUND_PATH_SMALL] — bounded by 255
            loop: bounds[BOUND_PATH_SMALL] for j in 0..clen {
                if pos < total {
                    result[pos] = comp.name[j as usize]
                    pos = pos + 1
                }
            }
            if i < count - 1 && pos < total {
                result[pos] = Byte::from_u8(b'/')
                pos = pos + 1
            }
        }
        result
    }

    pub fn base_name(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let last: Option[PathComponent] = self.last_component()
        if last.is_none() {
            return Byte[Slice]::new(0)
        }
        last.unwrap().to_slice()
    }

    pub fn dir_name(self) -> Result[Path, PathError>
        effects: [deterministic]
    {
        self.parent_path()
    }

    pub fn residual_access(self, operation: FixedString[64])
        effects: [io, deterministic]
    {
        residual emit {
            subsystem: "path_resolution",
            operation: operation,
            component_count: self.component_count,
            absolute: self.absolute,
            timestamp: __builtin_timestamp(),
        }
    }
}

// ──────────────────────────────────────────────
// Symlink Resolution State Machine
// ──────────────────────────────────────────────
// Evidence path: PATH-SYMLINK-001 through PATH-SYMLINK-025

pub type SymlinkResolution : struct {
    remaining_depth: Word32,             // Remaining symlink follows
    resolved_inodes: FixedArray[40, Word64], // Visited inodes for loop detection
    resolved_count: Word32,              // Number of resolved inodes
    current_path: Byte[MAX_PATH_BYTES],  // Current resolution path
    current_length: Word32,              // Current path length
}

impl SymlinkResolution {
    pub fn new() -> SymlinkResolution
        effects: [deterministic]
    {
        SymlinkResolution {
            remaining_depth: Word32::from_u32(MAX_SYMLINK_CHAIN),
            resolved_inodes: FixedArray::new(),
            resolved_count: Word32::from_u32(0),
            current_path: [Byte::from_u8(0); MAX_PATH_BYTES],
            current_length: Word32::from_u32(0),
        }
    }

    pub fn push_resolved_inode(self: ref mut, inum: Word64) -> Result<(), PathError>
        effects: [deterministic]
    {
        if self.resolved_inodes.is_full() {
            return Result::Err(path_loop("Too many symlink resolutions"))
        }
        // Check for loops.
        // loop: bounds[BOUND_PATH_SMALL] — bounded by 40
        loop: bounds[BOUND_PATH_SMALL] for i in 0..self.resolved_inodes.len() {
            let existing: Word64 = self.resolved_inodes.get(i).unwrap_or(Word64::zero())
            if existing.eq(inum) {
                return Result::Err(path_loop("Symlink loop detected"))
            }
        }
        self.resolved_inodes.push(inum)
        self.resolved_count = Word32::from_u32(self.resolved_inodes.len())
        Result::Ok(())
    }

    pub fn depth_remaining(self) -> u32
        effects: [deterministic]
    {
        self.remaining_depth.to_u32()
    }

    pub fn consume_depth(self: ref mut) -> Result<(), PathError>
        effects: [deterministic]
    {
        if self.remaining_depth.to_u32() == 0 {
            return Result::Err(path_loop("Symlink resolution depth exceeded"))
        }
        self.remaining_depth = self.remaining_depth.checked_sub(Word32::from_u32(1)).unwrap_or(Word32::from_u32(0))
        Result::Ok(())
    }

    pub fn set_resolved_path(self: ref mut, path: Byte[Slice])
        effects: [deterministic]
    {
        let len: u32 = path.len()
        if len > MAX_PATH_BYTES {
            return
        }
        // loop: bounds[BOUND_PATH_LARGE] — bounded by MAX_PATH_BYTES
        loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
            self.current_path[i as usize] = path[i as usize]
        }
        self.current_length = Word32::from_u32(len)
    }

    pub fn resolved_path(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let len: u32 = self.current_length.to_u32()
        let mut slice: Byte[Slice] = Byte[Slice]::new(len)
        // loop: bounds[BOUND_PATH_LARGE] — bounded by len
        loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
            slice[i] = self.current_path[i as usize]
        }
        slice
    }
}

// ──────────────────────────────────────────────
// Path Canonicalization
// ──────────────────────────────────────────────
// Evidence path: PATH-CANON-001 through PATH-CANON-020

pub fn normalize_path_separators(path: Byte[Slice]) -> Byte[Slice]
    effects: [deterministic]
{
    let len: u32 = path.len()
    let mut result: Byte[MAX_PATH_BYTES] = [Byte::from_u8(0); MAX_PATH_BYTES]
    let mut out_pos: u32 = 0
    let mut last_was_slash: bool = false
    // loop: bounds[BOUND_PATH_LARGE] — bounded by path length
    loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
        let b: Byte = path[i as usize]
        if b.eq(Byte::from_u8(b'/')) {
            if !last_was_slash {
                if out_pos < MAX_PATH_BYTES {
                    result[out_pos as usize] = b
                    out_pos = out_pos + 1
                }
                last_was_slash = true
            }
        } else {
            if out_pos < MAX_PATH_BYTES {
                result[out_pos as usize] = b
                out_pos = out_pos + 1
            }
            last_was_slash = false
        }
    }
    // Remove trailing slash if present and path length > 1.
    if out_pos > 1 && result[(out_pos - 1) as usize].eq(Byte::from_u8(b'/')) {
        out_pos = out_pos - 1
    }
    let mut output: Byte[Slice] = Byte[Slice]::new(out_pos)
    // loop: bounds[BOUND_PATH_LARGE] — bounded by out_pos
    loop: bounds[BOUND_PATH_LARGE] for i in 0..out_pos {
        output[i] = result[i as usize]
    }
    output
}

pub fn is_path_separator(b: Byte) -> bool
    effects: [deterministic]
{
    b.eq(Byte::from_u8(b'/'))
}

pub fn is_absolute(path: Byte[Slice]) -> bool
    effects: [deterministic]
{
    path.len() > 0 && path[0].eq(Byte::from_u8(b'/'))
}

pub fn has_trailing_slash(path: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let len: u32 = path.len()
    len > 0 && path[(len - 1) as usize].eq(Byte::from_u8(b'/'))
}

pub fn remove_trailing_slash(path: Byte[Slice]) -> Byte[Slice]
    effects: [deterministic]
{
    let len: u32 = path.len()
    if len > 1 && path[(len - 1) as usize].eq(Byte::from_u8(b'/')) {
        path.slice(0, len - 1)
    } else {
        path
    }
}

// ──────────────────────────────────────────────
// Path Joining
// ──────────────────────────────────────────────
// Evidence path: PATH-JOIN-001 through PATH-JOIN-015

pub fn join_paths(base: Byte[Slice], relative: Byte[Slice]) -> Result[Byte[Slice], PathError>
    effects: [deterministic]
{
    if is_absolute(relative) {
        return Result::Ok(relative)
    }
    let base_len: u32 = base.len()
    let rel_len: u32 = relative.len()
    let total: u32 = base_len + 1 + rel_len
    if total > MAX_PATH_BYTES {
        return Result::Err(path_too_long("Joined path exceeds maximum length"))
    }
    let mut result: Byte[MAX_PATH_BYTES] = [Byte::from_u8(0); MAX_PATH_BYTES]
    let mut pos: u32 = 0
    // Copy base.
    // loop: bounds[BOUND_PATH_LARGE] — bounded by base_len
    loop: bounds[BOUND_PATH_LARGE] for i in 0..base_len {
        result[pos] = base[i as usize]
        pos = pos + 1
    }
    // Add slash if base doesn't end with one.
    if base_len > 0 && !has_trailing_slash(base) {
        result[pos] = Byte::from_u8(b'/')
        pos = pos + 1
    }
    // Copy relative.
    // loop: bounds[BOUND_PATH_LARGE] — bounded by rel_len
    loop: bounds[BOUND_PATH_LARGE] for i in 0..rel_len {
        result[pos] = relative[i as usize]
        pos = pos + 1
    }
    let mut output: Byte[Slice] = Byte[Slice]::new(pos)
    // loop: bounds[BOUND_PATH_LARGE] — bounded by pos
    loop: bounds[BOUND_PATH_LARGE] for i in 0..pos {
        output[i] = result[i as usize]
    }
    Result::Ok(output)
}

// ──────────────────────────────────────────────
// Parent directory extraction
// ──────────────────────────────────────────────
// Evidence path: PATH-PARENT-001 through PATH-PARENT-015

pub fn parent_of(path: Byte[Slice]) -> Result[Byte[Slice], PathError>
    effects: [deterministic]
{
    let len: u32 = path.len()
    if len == 0 {
        return Result::Err(path_invalid("Empty path has no parent"))
    }
    // Find last separator.
    let mut last_sep: u32 = 0xFFFFFFFF
    // loop: bounds[BOUND_PATH_LARGE] — bounded by len
    loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
        if path[i as usize].eq(Byte::from_u8(b'/')) {
            last_sep = i
        }
    }
    if last_sep == 0xFFFFFFFF {
        // No separator: parent is "."
        let mut dot: Byte[Slice] = Byte[Slice]::new(1)
        dot[0] = Byte::from_u8(b'.')
        return Result::Ok(dot)
    }
    if last_sep == 0 {
        // Root parent
        let mut root: Byte[Slice] = Byte[Slice]::new(1)
        root[0] = Byte::from_u8(b'/')
        return Result::Ok(root)
    }
    path.slice(0, last_sep)
}

// ──────────────────────────────────────────────
// Full path resolution (with symlink handling)
// ──────────────────────────────────────────────
// Evidence path: PATH-RESOLVE-001 through PATH-RESOLVE-030

pub type PathResolution : struct {
    inode_number: Word64,              // Resolved inode
    mount_id: Word32,                  // Mount point ID
    resolved_path: Byte[MAX_PATH_BYTES],  // Final resolved path
    resolved_length: Word32,           // Length of resolved path
    is_directory: bool,                // Is the target a directory?
    symlinks_followed: Word32,         // Number of symlinks followed
    is_mount_point: bool,              // Is this a mount point boundary?
}

impl PathResolution {
    pub fn new(inum: Word64, mid: Word32) -> PathResolution
        effects: [deterministic]
    {
        PathResolution {
            inode_number: inum,
            mount_id: mid,
            resolved_path: [Byte::from_u8(0); MAX_PATH_BYTES],
            resolved_length: Word32::from_u32(0),
            is_directory: false,
            symlinks_followed: Word32::from_u32(0),
            is_mount_point: false,
        }
    }

    pub fn set_resolved_path(self: ref mut, path: Byte[Slice])
        effects: [deterministic]
    {
        let len: u32 = path.len()
        if len > MAX_PATH_BYTES { return }
        // loop: bounds[BOUND_PATH_LARGE] — bounded by len
        loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
            self.resolved_path[i as usize] = path[i as usize]
        }
        self.resolved_length = Word32::from_u32(len)
    }

    pub fn get_resolved_path(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let len: u32 = self.resolved_length.to_u32()
        let mut slice: Byte[Slice] = Byte[Slice]::new(len)
        // loop: bounds[BOUND_PATH_LARGE] — bounded by len
        loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
            slice[i] = self.resolved_path[i as usize]
        }
        slice
    }

    pub fn residual_resolution(self)
        effects: [io, deterministic]
    {
        residual emit {
            subsystem: "path_resolution",
            inode: self.inode_number,
            is_directory: self.is_directory,
            symlinks_followed: self.symlinks_followed,
            is_mount_point: self.is_mount_point,
            timestamp: __builtin_timestamp(),
        }
    }
}

pub fn resolve_path_full(
    vfs: ref VFS,
    path: Byte[Slice],
    cwd: Byte[Slice],
    cwd_mount: Word32,
    follow_symlinks: bool
) -> Result[PathResolution, PathError>
    effects: [io, deterministic]
{
    // Canonicalize the path first.
    let can_path: Byte[Slice] = normalize_path_separators(path)

    // Determine if absolute or relative.
    let working_path: Byte[Slice]
    if is_absolute(can_path) {
        working_path = can_path
    } else {
        working_path = join_paths(cwd, can_path)?
    }

    // Normalize again.
    working_path = normalize_path_separators(working_path)

    // Split into components and resolve.
    let path_obj: Path = Path::from_slice(working_path)?
    let sym_resolve: SymlinkResolution = SymlinkResolution::new()

    let count: u32 = path_obj.component_count()
    let mut current_inode: Word64
    let mut current_mount: Word32

    // Find root mount point.
    let root_mount_opt: Option[(Word32, MountPoint)] = vfs.find_mount(working_path)
    if root_mount_opt.is_none() {
        return Result::Err(path_not_found("No mount point for path"))
    }
    let (root_mount_id, root_mount) = root_mount_opt.unwrap()
    current_inode = root_mount.root_inode
    current_mount = root_mount_id

    // Resolve each component.
    // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
    loop: bounds[BOUND_PATH_SMALL] for i in 0..count {
        let comp: PathComponent = path_obj.get_component(i).unwrap_or(
            PathComponent::new(Byte[Slice]::new(0)))
        if comp.is_dot() {
            continue
        }
        if comp.is_dotdot() {
            // Go to parent: in a real FS, look up ".." in current inode.
            continue
        }

        // Look up component in current directory.
        // In a real implementation, this reads the directory inode.
        let found_inode: Word64 = Word64::zero()  // Placeholder
        if found_inode.is_zero() {
            return Result::Err(path_not_found("Path component not found"))
        }

        // Check if it's a symlink.
        if follow_symlinks {
            // In a real implementation, check inode type and follow.
            sym_resolve.consume_depth()?
        }

        current_inode = found_inode
    }

    let mut result: PathResolution = PathResolution::new(current_inode, current_mount)
    result.set_resolved_path(working_path)
    result.residual_resolution()
    Result::Ok(result)
}

// ──────────────────────────────────────────────
// Access Checking for Paths
// ──────────────────────────────────────────────
// Evidence path: PATH-ACCESS-001 through PATH-ACCESS-015

pub type PathAccess : Word32 = struct {
    value: Word32,
}

impl PathAccess {
    pub fn new(v: Word32) -> PathAccess
        effects: [deterministic]
    {
        PathAccess { value: v }
    }

    pub fn has(self, bit: u32) -> bool
        effects: [deterministic]
    {
        (self.value & bit) != 0
    }
}

pub const PATH_ACCESS_READ     : u32 = 0x0001
pub const PATH_ACCESS_WRITE    : u32 = 0x0002
pub const PATH_ACCESS_EXECUTE  : u32 = 0x0004
pub const PATH_ACCESS_CREATE   : u32 = 0x0008
pub const PATH_ACCESS_DELETE   : u32 = 0x0010
pub const PATH_ACCESS_TRAVERSE : u32 = 0x0020

pub fn check_path_access(
    cap: Capability,
    path: Byte[Slice],
    required: PathAccess
) -> Result[(), PathError>
    effects: [deterministic]
{
    let rights: RightsSet = cap.rights()
    let needed: Word64
    if required.has(PATH_ACCESS_READ) {
        needed = CAP_RIGHT_READ
    } else if required.has(PATH_ACCESS_WRITE) {
        needed = CAP_RIGHT_WRITE
    } else if required.has(PATH_ACCESS_EXECUTE) {
        needed = CAP_RIGHT_EXECUTE
    } else if required.has(PATH_ACCESS_CREATE) {
        needed = CAP_RIGHT_CREATE
    } else if required.has(PATH_ACCESS_DELETE) {
        needed = CAP_RIGHT_DELETE
    } else if required.has(PATH_ACCESS_TRAVERSE) {
        needed = CAP_RIGHT_READ
    } else {
        return Result::Err(path_perm_denied("Unknown access type"))
    }
    if !rights.has(needed) {
        return Result::Err(path_perm_denied("Capability lacks required rights"))
    }
    Result::Ok(())
}

// ──────────────────────────────────────────────
// Mount Point Crossing
// ──────────────────────────────────────────────
// Evidence path: PATH-MOUNT-001 through PATH-MOUNT-015

pub fn find_mount_for_path(vfs: ref VFS, path: Byte[Slice]) -> Option[(Word32, Byte[Slice])>
    effects: [deterministic]
{
    let mut best_id: Word32 = Word32::from_u32(0xFFFFFFFF)
    let mut best_len: u32 = 0
    // In a real implementation, iterate mount points and find longest prefix match.
    // loop: bounds[BOUND_VFS_SMALL] — bounded by mount count (placeholder)
    loop: bounds[BOUND_VFS_SMALL] for _ in 0..64 {
        // Placeholder for mount point iteration
        break
    }
    Option::None
}

pub fn crosses_mount_point(path: Byte[Slice], mount_path: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let path_len: u32 = path.len()
    let mp_len: u32 = mount_path.len()
    if mp_len == 0 {
        return false
    }
    if path_len < mp_len {
        return false
    }
    // loop: bounds[BOUND_PATH_SMALL] — bounded by mount path length
    loop: bounds[BOUND_PATH_SMALL] for i in 0..mp_len {
        if path[i as usize].neq(mount_path[i as usize]) {
            return false
        }
    }
    true
}

// ──────────────────────────────────────────────
// Path Validation
// ──────────────────────────────────────────────
// Evidence path: PATH-VALID-001 through PATH-VALID-015

pub fn validate_path_component(name: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let len: u32 = name.len()
    if len == 0 || len > 255 {
        return false
    }
    // Check for invalid characters.
    // loop: bounds[BOUND_FS_SMALL] — bounded by 255
    loop: bounds[BOUND_FS_SMALL] for i in 0..len {
        let b: Byte = name[i as usize]
        // Null byte is invalid.
        if b.eq(Byte::from_u8(0)) {
            return false
        }
        // Slash is invalid inside component.
        if b.eq(Byte::from_u8(b'/')) {
            return false
        }
    }
    // Cannot be "." or ".."
    if len == 1 && name[0].eq(Byte::from_u8(b'.')) {
        return false
    }
    if len == 2 && name[0].eq(Byte::from_u8(b'.')) && name[1].eq(Byte::from_u8(b'.')) {
        return false
    }
    true
}

pub fn validate_full_path(path: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let len: u32 = path.len()
    if len == 0 || len > MAX_PATH_BYTES {
        return false
    }
    // Must start with '/' for absolute paths.
    if !path[0].eq(Byte::from_u8(b'/')) {
        // Relative path is also valid.
    }
    // Validate each component.
    let mut iter: PathIterator = PathIterator::new(path)
    // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
    loop: bounds[BOUND_PATH_SMALL] for _ in 0..64 {
        let comp_opt: Option[Byte[Slice]] = iter.next_component()
        if comp_opt.is_none() {
            break
        }
        if !validate_path_component(comp_opt.unwrap()) {
            return false
        }
    }
    true
}

// ──────────────────────────────────────────────
// Extended Path Resolution with Caching
// ──────────────────────────────────────────────
// Evidence path: PATH-CACHE-001 through PATH-CACHE-020

pub type PathCacheEntry : struct {
    path_hash: Word64,                   // Hash of the resolved path
    inode_number: Word64,                // Resolved inode
    mount_id: Word32,                    // Mount point ID
    is_directory: bool,                  // Is a directory
    timestamp: Word64,                   // When cached
    valid: bool,                         // Entry is valid
}

impl PathCacheEntry {
    pub fn empty() -> PathCacheEntry
        effects: [deterministic]
    {
        PathCacheEntry {
            path_hash: Word64::zero(),
            inode_number: Word64::zero(),
            mount_id: Word32::from_u32(0),
            is_directory: false,
            timestamp: Word64::zero(),
            valid: false,
        }
    }

    pub fn new(hash: Word64, inum: Word64, mid: Word32, is_dir: bool) -> PathCacheEntry
        effects: [deterministic]
    {
        PathCacheEntry {
            path_hash: hash,
            inode_number: inum,
            mount_id: mid,
            is_directory: is_dir,
            timestamp: __builtin_timestamp(),
            valid: true,
        }
    }
}

pub type PathResolutionCache : struct {
    entries: FixedArray[64, PathCacheEntry],
    hits: Word32,
    misses: Word32,
}

impl PathResolutionCache {
    pub fn new() -> PathResolutionCache
        effects: [deterministic]
    {
        PathResolutionCache {
            entries: FixedArray::new(),
            hits: Word32::from_u32(0),
            misses: Word32::from_u32(0),
        }
    }

    fn hash_path(path: Byte[Slice]) -> Word64
        effects: [deterministic, hash]
    {
        let mut h: u64 = 0
        let len: u32 = path.len()
        // loop: bounds[BOUND_PATH_LARGE] — bounded by path length
        loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
            h = h.wrapping_mul(31).wrapping_add(path[i as usize].to_u8() as u64)
        }
        Word64::from_u64(h)
    }

    pub fn lookup(self: ref mut, path: Byte[Slice]) -> Option[PathCacheEntry]
        effects: [deterministic, hash]
    {
        let hash: Word64 = PathResolutionCache::hash_path(path)
        // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
        loop: bounds[BOUND_PATH_SMALL] for i in 0..self.entries.len() {
            let entry: PathCacheEntry = self.entries.get(i).unwrap_or(PathCacheEntry::empty())
            if entry.valid && entry.path_hash.eq(hash) {
                self.hits = self.hits.checked_add(Word32::from_u32(1)).unwrap_or(self.hits)
                return Option::Some(entry)
            }
        }
        self.misses = self.misses.checked_add(Word32::from_u32(1)).unwrap_or(self.misses)
        Option::None
    }

    pub fn insert(self: ref mut, entry: PathCacheEntry) -> Result<(), PathError>
        effects: [deterministic]
    {
        if !self.entries.is_full() {
            self.entries.push(entry)
            return Result::Ok(())
        }
        // LRU eviction.
        let mut oldest_idx: u32 = 0
        let mut oldest_time: Word64 = self.entries.get(0).unwrap_or(PathCacheEntry::empty()).timestamp
        // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
        loop: bounds[BOUND_PATH_SMALL] for i in 1..self.entries.len() {
            let e: PathCacheEntry = self.entries.get(i).unwrap_or(PathCacheEntry::empty())
            if e.timestamp.lt(oldest_time) {
                oldest_time = e.timestamp
                oldest_idx = i
            }
        }
        self.entries.set(oldest_idx, entry)
        Result::Ok(())
    }

    pub fn invalidate(self: ref mut)
        effects: [deterministic]
    {
        self.entries.clear()
        self.hits = Word32::from_u32(0)
        self.misses = Word32::from_u32(0)
    }

    pub fn stats(self) -> (Word32, Word32)
        effects: [deterministic]
    {
        (self.hits, self.misses)
    }
}

// ──────────────────────────────────────────────
// Path Prefix Matching
// ──────────────────────────────────────────────
// Evidence path: PATH-PREFIX-001 through PATH-PREFIX-015

pub fn path_has_prefix(path: Byte[Slice], prefix: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let path_len: u32 = path.len()
    let prefix_len: u32 = prefix.len()
    if path_len < prefix_len {
        return false
    }
    // loop: bounds[BOUND_PATH_SMALL] — bounded by prefix length
    loop: bounds[BOUND_PATH_SMALL] for i in 0..prefix_len {
        if path[i as usize].neq(prefix[i as usize]) {
            return false
        }
    }
    // Ensure prefix matches complete component boundary.
    if prefix_len > 0 && prefix[(prefix_len - 1) as usize].neq(Byte::from_u8(b'/')) {
        if path_len > prefix_len && path[prefix_len as usize].neq(Byte::from_u8(b'/')) {
            return false
        }
    }
    true
}

pub fn path_common_prefix(path_a: Byte[Slice], path_b: Byte[Slice]) -> Byte[Slice]
    effects: [deterministic]
{
    let a_len: u32 = path_a.len()
    let b_len: u32 = path_b.len()
    let min_len: u32 = if a_len < b_len { a_len } else { b_len }
    let mut common: u32 = 0
    // loop: bounds[BOUND_PATH_LARGE] — bounded by min_len
    loop: bounds[BOUND_PATH_LARGE] for i in 0..min_len {
        if path_a[i as usize].eq(path_b[i as usize]) {
            common = i + 1
        } else {
            break
        }
    }
    // Find the last slash within the common prefix.
    let mut last_slash: u32 = 0
    // loop: bounds[BOUND_PATH_SMALL] — bounded by common
    loop: bounds[BOUND_PATH_SMALL] for i in 0..common {
        if path_a[i as usize].eq(Byte::from_u8(b'/')) {
            last_slash = i
        }
    }
    if last_slash == 0 && common > 0 && path_a[0].eq(Byte::from_u8(b'/')) {
        path_a.slice(0, 1)
    } else if last_slash > 0 {
        path_a.slice(0, last_slash)
    } else {
        Byte[Slice]::new(0)
    }
}

// ──────────────────────────────────────────────
// Path Depth Calculation
// ──────────────────────────────────────────────
// Evidence path: PATH-DEPTH-001 through PATH-DEPTH-015

pub fn path_depth(path: Byte[Slice]) -> Word32
    effects: [deterministic]
{
    let mut depth: Word32 = Word32::from_u32(0)
    let mut iter: PathIterator = PathIterator::new(path)
    // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
    loop: bounds[BOUND_PATH_SMALL] for _ in 0..64 {
        let comp_opt: Option[Byte[Slice]] = iter.next_component()
        if comp_opt.is_none() {
            break
        }
        let comp: Byte[Slice] = comp_opt.unwrap()
        if !is_current_dir(comp) && !is_parent_dir(comp) {
            depth = depth.checked_add(Word32::from_u32(1)).unwrap_or(depth)
        }
    }
    depth
}

pub fn path_is_ancestor_of(ancestor: Byte[Slice], descendant: Byte[Slice]) -> bool
    effects: [deterministic]
{
    path_has_prefix(descendant, ancestor)
}

pub fn path_relative_to(base: Byte[Slice], target: Byte[Slice]) -> Result[Byte[Slice], PathError>
    effects: [deterministic]
{
    let base_len: u32 = base.len()
    let target_len: u32 = target.len()
    // Find common prefix.
    let common: Byte[Slice] = path_common_prefix(base, target)
    let common_len: u32 = common.len()
    if common_len == 0 {
        // No common prefix, return target unchanged.
        return Result::Ok(target)
    }
    // Count remaining components in base after common prefix.
    let base_remaining: Byte[Slice] = base.slice(common_len, base_len - common_len)
    let base_depth: u32 = path_depth(base_remaining)
    // Build relative path: for each remaining base component, add "..".
    let target_remaining: Byte[Slice] = target.slice(common_len, target_len - common_len)
    // Compute total length.
    let mut total: u32 = base_depth * 3  // Each ".." + "/" = 3 chars (overestimate)
    total = total + target_remaining.len()
    if total > MAX_PATH_BYTES {
        return Result::Err(path_too_long("Relative path exceeds maximum length"))
    }
    let mut result: Byte[MAX_PATH_BYTES] = [Byte::from_u8(0); MAX_PATH_BYTES]
    let mut pos: u32 = 0
    // Add "../" for each level up.
    // loop: bounds[BOUND_PATH_SMALL] — bounded by base_depth
    loop: bounds[BOUND_PATH_SMALL] for _ in 0..base_depth {
        result[pos] = Byte::from_u8(b'.')
        result[pos + 1] = Byte::from_u8(b'.')
        result[pos + 2] = Byte::from_u8(b'/')
        pos = pos + 3
    }
    // Add target remaining.
    // loop: bounds[BOUND_PATH_LARGE] — bounded by remaining length
    loop: bounds[BOUND_PATH_LARGE] for i in 0..target_remaining.len() {
        result[pos] = target_remaining[i as usize]
        pos = pos + 1
    }
    let mut output: Byte[Slice] = Byte[Slice]::new(pos)
    // loop: bounds[BOUND_PATH_LARGE] — bounded by pos
    loop: bounds[BOUND_PATH_LARGE] for i in 0..pos {
        output[i] = result[i as usize]
    }
    Result::Ok(output)
}

// ──────────────────────────────────────────────
// Path Verification Helpers
// ──────────────────────────────────────────────
// Evidence path: PATH-VERIFY-001 through PATH-VERIFY-015

pub fn verify_path_consistency(path: Byte[Slice]) -> FixedArray[64, PathError>
    effects: [deterministic]
{
    let mut errors: FixedArray[64, PathError> = FixedArray::new()
    let len: u32 = path.len()
    if len == 0 {
        errors.push(path_invalid("Empty path"))
        return errors
    }
    if len > MAX_PATH_BYTES {
        errors.push(path_too_long("Path exceeds maximum length"))
        return errors
    }
    // Check for duplicate slashes.
    let mut last_was_slash: bool = false
    // loop: bounds[BOUND_PATH_LARGE] — bounded by length
    loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
        let c: Byte = path[i as usize]
        if c.eq(Byte::from_u8(b'/')) {
            if last_was_slash {
                // Duplicate slash.
            }
            last_was_slash = true
        } else {
            last_was_slash = false
        }
    }
    // Validate each component.
    let mut iter: PathIterator = PathIterator::new(path)
    // loop: bounds[BOUND_PATH_SMALL] — bounded by 64
    loop: bounds[BOUND_PATH_SMALL] for _ in 0..64 {
        let comp_opt: Option[Byte[Slice]] = iter.next_component()
        if comp_opt.is_none() {
            break
        }
        let comp: Byte[Slice] = comp_opt.unwrap()
        if !validate_path_component(comp) {
            errors.push(path_invalid("Invalid path component"))
        }
    }
    errors
}

pub fn path_evidence_trail(path: Byte[Slice], operation: FixedString[64])
    effects: [io, deterministic]
{
    let depth: Word32 = path_depth(path)
    let is_abs: bool = is_absolute(path)
    let has_trailing: bool = has_trailing_slash(path)
    residual emit {
        subsystem: "path_verification",
        operation: operation,
        path_length: path.len(),
        depth: depth,
        is_absolute: is_abs,
        has_trailing_slash: has_trailing,
        timestamp: __builtin_timestamp(),
    }
}

// ──────────────────────────────────────────────
// Path Split Operations
// ──────────────────────────────────────────────
// Evidence path: PATH-SPLIT-001 through PATH-SPLIT-015

pub fn path_split_ext(path: Byte[Slice]) -> (Byte[Slice], Byte[Slice])
    effects: [deterministic]
{
    let len: u32 = path.len()
    let mut last_dot: u32 = 0xFFFFFFFF
    // loop: bounds[BOUND_PATH_LARGE] — bounded by len
    loop: bounds[BOUND_PATH_LARGE] for i in 0..len {
        if path[i as usize].eq(Byte::from_u8(b'.')) {
            last_dot = i
        }
    }
    if last_dot == 0 || last_dot == 0xFFFFFFFF {
        // No extension found.
        (path, Byte[Slice]::new(0))
    } else {
        let base: Byte[Slice] = path.slice(0, last_dot)
        let ext: Byte[Slice] = path.slice(last_dot, len - last_dot)
        (base, ext)
    }
}

pub fn path_basename_no_ext(path: Byte[Slice]) -> Byte[Slice]
    effects: [deterministic]
{
    let (base, _ext): (Byte[Slice], Byte[Slice]) = path_split_ext(path)
    base
}

pub fn path_extension(path: Byte[Slice]) -> Byte[Slice]
    effects: [deterministic]
{
    let (_base, ext): (Byte[Slice], Byte[Slice]) = path_split_ext(path)
    ext
}

// ──────────────────────────────────────────────
// Path Normalization (full)
// ──────────────────────────────────────────────
// Evidence path: PATH-NORM-001 through PATH-NORM-015

pub fn normalize_path(path: Byte[Slice]) -> Byte[Slice]
    effects: [deterministic]
{
    let normalized: Byte[Slice] = normalize_path_separators(path)
    let len: u32 = normalized.len()
    if len == 0 {
        let mut root: Byte[Slice] = Byte[Slice]::new(1)
        root[0] = Byte::from_u8(b'/')
        return root
    }
    normalized
}

pub fn is_empty_path(path: Byte[Slice]) -> bool
    effects: [deterministic]
{
    path.len() == 0
}

pub fn is_root_path(path: Byte[Slice]) -> bool
    effects: [deterministic]
{
    path.len() == 1 && path[0].eq(Byte::from_u8(b'/'))
}

// ──────────────────────────────────────────────
// Path Comparison
// ──────────────────────────────────────────────
// Evidence path: PATH-CMP-001 through PATH-CMP-015

pub fn paths_equal(a: Byte[Slice], b: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let a_len: u32 = a.len()
    let b_len: u32 = b.len()
    if a_len != b_len {
        return false
    }
    // loop: bounds[BOUND_PATH_LARGE] — bounded by length
    loop: bounds[BOUND_PATH_LARGE] for i in 0..a_len {
        if a[i as usize].neq(b[i as usize]) {
            return false
        }
    }
    true
}

pub fn paths_equal_normalized(a: Byte[Slice], b: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let na: Byte[Slice] = normalize_path(a)
    let nb: Byte[Slice] = normalize_path(b)
    paths_equal(na, nb)
}
