// trust_policy.phor — Trust Policy Subsystem
//
// Provides:
//   - Trust threshold configuration (minimum trust scores)
//   - Promotion requirements (evidence-based trust escalation)
//   - Demotion rules (trust degradation and revocation)
//   - Cross-domain trust (federated trust relationships)
//   - Trust review schedules (periodic reassessment)
//   - Full residual recording on every trust operation
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every trust decision produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:trust_policy:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_TRUST_ENTITIES: u64 = 512;
const MAX_TRUST_DOMAINS: u64 = 32;
const MAX_TRUST_THRESHOLDS: u64 = 16;
const MAX_PROMOTION_RULES: u64 = 64;
const MAX_DEMOTION_RULES: u64 = 64;
const MAX_CROSS_DOMAIN_TRUSTS: u64 = 128;
const MAX_REVIEW_SCHEDULES: u64 = 32;
const MAX_TRUST_EVIDENCE: u64 = 256;
const MAX_TRUST_HIERARCHY_DEPTH: u64 = 16;
const MAX_TRUST_SCORE_COMPONENTS: u64 = 8;
const MAX_DELEGATION_CHAIN: u64 = 8;
const MAX_REVIEW_HISTORY: u64 = 128;
const MAX_TRUST_ATTRIBUTES: u64 = 32;
const MAX_DOMAIN_ANCESTORS: u64 = 8;

effect trust:evaluate;
effect trust:promote;
effect trust:demote;
effect trust:crossdomain;
effect trust:review;

// ──────────────────────────────────────────────
// Trust Types
// ──────────────────────────────────────────────

enum TrustLevel {
    None,
    Unverified,
    Minimal,
    Low,
    Medium,
    High,
    VeryHigh,
    Maximum,
}

enum TrustState {
    Initial,
    Learning,
    Established,
    Degraded,
    Revoked,
    Expired,
    Frozen,
}

enum PromotionRequirement {
    CourtVerification,
    ResidualConsistency,
    TimeElapsed,
    PeerReview,
    MultipleSources,
    CodeReview,
    AuditTrail,
    ManualApproval,
}

enum DemotionReason {
    TimeDecay,
    ResidualInconsistency,
    CourtFailure,
    ViolationDetected,
    PolicyChange,
    ManualDemotion,
    SourceCompromised,
    EvidenceExpired,
}

enum CrossDomainTrustType {
    Direct,
    Hierarchical,
    Federated,
    WebOfTrust,
    Reciprocal,
    Delegated,
}

enum ReviewFrequency {
    Continuous,
    Daily,
    Weekly,
    Monthly,
    Quarterly,
    Annually,
    OnDemand,
}

// ──────────────────────────────────────────────
// Trust Data Structures
// ──────────────────────────────────────────────

struct TrustEntity {
    entity_id: u64,
    name: Str(64),
    domain_id: u64,
    trust_level: TrustLevel,
    trust_state: TrustState,
    trust_score: u64,
    score_components: Array(u64, MAX_TRUST_SCORE_COMPONENTS),
    component_count: u64,
    evidence_count: u64,
    evidence_ids: Array(u64, MAX_TRUST_EVIDENCE),
    created_at: u64,
    last_updated: u64,
    last_reviewed: u64,
    parent_entity: u64,
    hierarchy_level: u64,
    attributes: Array(u64, MAX_TRUST_ATTRIBUTES),
    attribute_count: u64,
    delegation_depth: u64,
    attributes_hash: Array(u8, 32),
}

struct TrustDomain {
    domain_id: u64,
    name: Str(64),
    description: Str(256),
    parent_domain: u64,
    hierarchy_level: u64,
    trust_threshold: u64,
    default_trust: TrustLevel,
    member_count: u64,
    member_ids: Array(u64, MAX_TRUST_ENTITIES),
    is_authoritative: bool,
    self_certifying: bool,
    audit_all_transitions: bool,
}

struct TrustThreshold {
    threshold_id: u64,
    name: Str(64),
    trust_level: TrustLevel,
    min_score: u64,
    max_score: u64,
    min_evidence_count: u64,
    min_evidence_age: u64,
    require_court_verification: bool,
    require_multiple_sources: bool,
    require_manual_approval: bool,
    time_to_live: u64,
}

struct PromotionRule {
    rule_id: u64,
    name: Str(64),
    from_level: TrustLevel,
    to_level: TrustLevel,
    requirement: PromotionRequirement,
    min_score_increase: u64,
    min_evidence_required: u64,
    min_time_days: u64,
    require_approval: bool,
    approver_role: u64,
    court_required: bool,
    auto_promote: bool,
    enabled: bool,
}

struct DemotionRule {
    rule_id: u64,
    name: Str(64),
    from_level: TrustLevel,
    to_level: TrustLevel,
    reason: DemotionReason,
    score_decrease_threshold: u64,
    max_violations: u64,
    violation_window: u64,
    require_manual: bool,
    auto_demote: bool,
    notify: bool,
    enabled: bool,
}

struct CrossDomainTrust {
    trust_id: u64,
    local_domain: u64,
    remote_domain: u64,
    trust_type: CrossDomainTrustType,
    trust_level: TrustLevel,
    max_delegation_depth: u64,
    reciprocal: bool,
    mapped_attributes: Array(u64, MAX_TRUST_ATTRIBUTES),
    attribute_count: u64,
    established_at: u64,
    expires_at: u64,
    last_reviewed: u64,
    active: bool,
    audit_all_access: bool,
}

struct ReviewSchedule {
    schedule_id: u64,
    domain_id: u64,
    frequency: ReviewFrequency,
    interval_seconds: u64,
    last_review: u64,
    next_review: u64,
    auto_review: bool,
    notify_on_completion: bool,
    reviewer_role: u64,
    enabled: bool,
}

struct TrustTransitionRecord {
    transition_id: u64,
    entity_id: u64,
    from_state: TrustState,
    to_state: TrustState,
    from_level: TrustLevel,
    to_level: TrustLevel,
    from_score: u64,
    to_score: u64,
    reason: Str(256),
    triggered_by: u64,
    timestamp: u64,
    evidence_id: u64,
    approved_by: u64,
}

struct TrustPolicyState {
    entities: Array(TrustEntity, MAX_TRUST_ENTITIES),
    entity_count: u64,
    domains: Array(TrustDomain, MAX_TRUST_DOMAINS),
    domain_count: u64,
    thresholds: Array(TrustThreshold, MAX_TRUST_THRESHOLDS),
    threshold_count: u64,
    promotion_rules: Array(PromotionRule, MAX_PROMOTION_RULES),
    promotion_count: u64,
    demotion_rules: Array(DemotionRule, MAX_DEMOTION_RULES),
    demotion_count: u64,
    cross_domain_trusts: Array(CrossDomainTrust, MAX_CROSS_DOMAIN_TRUSTS),
    cross_domain_count: u64,
    review_schedules: Array(ReviewSchedule, MAX_REVIEW_SCHEDULES),
    schedule_count: u64,
    transition_history: Array(TrustTransitionRecord, MAX_REVIEW_HISTORY),
    history_count: u64,
    min_trust_for_access: TrustLevel,
    audit_all_trust_changes: bool,
    policy_version: u64,
}

// ──────────────────────────────────────────────
// Trust Entity Management
// ──────────────────────────────────────────────

fn create_trust_entity(
    entity_id: u64,
    name: Str(64),
    domain_id: u64,
) -> TrustEntity
    effect [trust:evaluate, compute, residual]
{
    residual emit {
        op: "trust.entity_create",
        id: entity_id,
        name: name,
        domain: domain_id,
    };

    return TrustEntity{
        entity_id: entity_id,
        name: name,
        domain_id: domain_id,
        trust_level: TrustLevel::None,
        trust_state: TrustState::Initial,
        trust_score: 0,
        score_components: Array::splat(0),
        component_count: 0,
        evidence_count: 0,
        evidence_ids: Array::splat(0),
        created_at: 0,
        last_updated: 0,
        last_reviewed: 0,
        parent_entity: 0,
        hierarchy_level: 0,
        attributes: Array::splat(0),
        attribute_count: 0,
        delegation_depth: 0,
        attributes_hash: Array::splat(0),
    };
}

fn add_entity_to_state(state: TrustPolicyState, entity: TrustEntity) -> TrustPolicyState
    effect [trust:evaluate, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    if updated.entity_count < MAX_TRUST_ENTITIES {
        updated.entities[updated.entity_count] = entity;
        updated.entity_count = updated.entity_count + 1;

        residual emit {
            op: "trust.entity_add",
            id: entity.entity_id,
            domain: entity.domain_id,
            total: updated.entity_count,
        };
    }
    return updated;
}

fn find_entity_by_id(state: TrustPolicyState, entity_id: u64) -> Option(TrustEntity)
    effect [compute]
{
    for i in 0..state.entity_count {
        if state.entities[i].entity_id == entity_id {
            return Option::Some(state.entities[i]);
        }
    }
    return Option::None;
}

fn update_entity_trust_score(
    state: TrustPolicyState,
    entity_id: u64,
    new_score: u64,
    reason: Str(256),
) -> (TrustPolicyState, bool)
    effect [trust:evaluate, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    let mut found: bool = false;

    for i in 0..updated.entity_count {
        if updated.entities[i].entity_id == entity_id {
            let entity: TrustEntity = updated.entities[i];
            let old_score: u64 = entity.trust_score;
            let mut e: TrustEntity = entity;
            e.trust_score = new_score;
            e.last_updated = 0;
            updated.entities[i] = e;
            found = true;

            residual emit {
                op: "trust.score_update",
                entity: entity_id,
                old_score: old_score,
                new_score: new_score,
                reason: reason,
            };
            break;
        }
    }
    return (updated, found);
}

fn add_evidence_to_entity(
    state: TrustPolicyState,
    entity_id: u64,
    evidence_id: u64,
) -> TrustPolicyState
    effect [trust:evaluate, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    for i in 0..updated.entity_count {
        if updated.entities[i].entity_id == entity_id {
            let mut e: TrustEntity = updated.entities[i];
            if e.evidence_count < MAX_TRUST_EVIDENCE {
                e.evidence_ids[e.evidence_count] = evidence_id;
                e.evidence_count = e.evidence_count + 1;
                updated.entities[i] = e;
            }
            break;
        }
    }

    residual emit {
        op: "trust.evidence_add",
        entity: entity_id,
        evidence: evidence_id,
    };

    return updated;
}

// ──────────────────────────────────────────────
// Trust Threshold Configuration
// ──────────────────────────────────────────────

fn create_trust_threshold(
    threshold_id: u64,
    name: Str(64),
    level: TrustLevel,
    min_score: u64,
    max_score: u64,
) -> TrustThreshold
    effect [trust:evaluate, compute, residual]
{
    residual emit {
        op: "trust.threshold_create",
        id: threshold_id,
        name: name,
        level: level as u8,
        min: min_score,
        max: max_score,
    };

    return TrustThreshold{
        threshold_id: threshold_id,
        name: name,
        trust_level: level,
        min_score: min_score,
        max_score: max_score,
        min_evidence_count: 0,
        min_evidence_age: 0,
        require_court_verification: false,
        require_multiple_sources: false,
        require_manual_approval: false,
        time_to_live: 86400,
    };
}

fn add_trust_threshold(state: TrustPolicyState, threshold: TrustThreshold) -> TrustPolicyState
    effect [trust:evaluate, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    if updated.threshold_count < MAX_TRUST_THRESHOLDS {
        updated.thresholds[updated.threshold_count] = threshold;
        updated.threshold_count = updated.threshold_count + 1;

        residual emit {
            op: "trust.threshold_add",
            id: threshold.threshold_id,
            level: threshold.trust_level as u8,
            min: threshold.min_score,
            max: threshold.max_score,
        };
    }
    return updated;
}

fn get_trust_level_for_score(state: TrustPolicyState, score: u64) -> TrustLevel
    effect [compute]
{
    let mut level: TrustLevel = TrustLevel::None;
    for i in 0..state.threshold_count {
        let t: TrustThreshold = state.thresholds[i];
        if score >= t.min_score && score <= t.max_score {
            if t.trust_level as u8 > level as u8 {
                level = t.trust_level;
            }
        }
    }
    return level;
}

fn score_meets_threshold(state: TrustPolicyState, score: u64, required: TrustLevel) -> bool
    effect [compute]
{
    let actual: TrustLevel = get_trust_level_for_score(state, score);
    return actual as u8 >= required as u8;
}

// ──────────────────────────────────────────────
// Promotion Rules & Execution
// ──────────────────────────────────────────────

fn add_promotion_rule(state: TrustPolicyState, rule: PromotionRule) -> TrustPolicyState
    effect [trust:promote, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    if updated.promotion_count < MAX_PROMOTION_RULES {
        updated.promotion_rules[updated.promotion_count] = rule;
        updated.promotion_count = updated.promotion_count + 1;

        residual emit {
            op: "trust.promotion_rule_add",
            rule: rule.rule_id,
            from: rule.from_level as u8,
            to: rule.to_level as u8,
            req: rule.requirement as u8,
        };
    }
    return updated;
}

fn check_promotion_requirements(
    state: TrustPolicyState,
    entity: TrustEntity,
    rule: PromotionRule,
) -> bool
    effect [trust:promote, compute]
{
    if entity.trust_level != rule.from_level {
        return false;
    }
    if entity.trust_score < rule.min_score_increase {
        return false;
    }
    if entity.evidence_count < rule.min_evidence_required {
        return false;
    }
    return true;
}

fn perform_promotion(
    state: TrustPolicyState,
    entity_id: u64,
    rule_id: u64,
    approver: u64,
) -> (TrustPolicyState, bool)
    effect [trust:promote, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    let mut promoted: bool = false;

    let entity_opt: Option(TrustEntity) = find_entity_by_id(updated, entity_id);
    match entity_opt {
        Option::Some(entity) => {
            for ri in 0..updated.promotion_count {
                let rule: PromotionRule = updated.promotion_rules[ri];
                if rule.rule_id == rule_id && rule.enabled {
                    if check_promotion_requirements(updated, entity, rule) {
                        if !rule.require_approval || approver != 0 {
                            let mut e: TrustEntity = entity;
                            let old_level: TrustLevel = e.trust_level;
                            let old_state: TrustState = e.trust_state;
                            e.trust_level = rule.to_level;
                            e.trust_state = TrustState::Established;
                            e.last_updated = 0;
                            e.last_reviewed = 0;
                            updated.entities[entity_id as u8] = e;
                            promoted = true;

                            if updated.history_count < MAX_REVIEW_HISTORY {
                                let record: TrustTransitionRecord = TrustTransitionRecord{
                                    transition_id: updated.history_count + 1,
                                    entity_id: entity_id,
                                    from_state: old_state,
                                    to_state: e.trust_state,
                                    from_level: old_level,
                                    to_level: rule.to_level,
                                    from_score: entity.trust_score,
                                    to_score: e.trust_score,
                                    reason: Str::from("Promotion"),
                                    triggered_by: approver,
                                    timestamp: 0,
                                    evidence_id: 0,
                                    approved_by: approver,
                                };
                                updated.transition_history[updated.history_count] = record;
                                updated.history_count = updated.history_count + 1;
                            }

                            residual emit {
                                op: "trust.promotion",
                                entity: entity_id,
                                from: old_level as u8,
                                to: rule.to_level as u8,
                                rule: rule_id,
                                approver: approver,
                            };
                        }
                    }
                    break;
                }
            }
        },
        Option::None => {},
    };

    return (updated, promoted);
}

fn evaluate_auto_promotions(state: TrustPolicyState) -> (TrustPolicyState, u64)
    effect [trust:promote, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    let mut promoted_count: u64 = 0;

    for ei in 0..updated.entity_count {
        let entity: TrustEntity = updated.entities[ei];
        for ri in 0..updated.promotion_count {
            let rule: PromotionRule = updated.promotion_rules[ri];
            if rule.enabled && rule.auto_promote {
                if check_promotion_requirements(updated, entity, rule) {
                    let (new_state, ok): (TrustPolicyState, bool) = perform_promotion(
                        updated, entity.entity_id, rule.rule_id, 0,
                    );
                    updated = new_state;
                    if ok {
                        promoted_count = promoted_count + 1;
                    }
                }
            }
        }
    }

    residual emit {
        op: "trust.auto_promotions",
        promoted: promoted_count,
    };

    return (updated, promoted_count);
}

// ──────────────────────────────────────────────
// Demotion Rules & Execution
// ──────────────────────────────────────────────

fn add_demotion_rule(state: TrustPolicyState, rule: DemotionRule) -> TrustPolicyState
    effect [trust:demote, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    if updated.demotion_count < MAX_DEMOTION_RULES {
        updated.demotion_rules[updated.demotion_count] = rule;
        updated.demotion_count = updated.demotion_count + 1;

        residual emit {
            op: "trust.demotion_rule_add",
            rule: rule.rule_id,
            from: rule.from_level as u8,
            to: rule.to_level as u8,
            reason: rule.reason as u8,
        };
    }
    return updated;
}

fn check_demotion_conditions(
    state: TrustPolicyState,
    entity: TrustEntity,
    rule: DemotionRule,
) -> bool
    effect [trust:demote, compute]
{
    if entity.trust_level != rule.from_level {
        return false;
    }
    let score_drop: u64 = if entity.trust_score > rule.score_decrease_threshold {
        entity.trust_score - rule.score_decrease_threshold
    } else {
        0
    };
    if score_drop == 0 {
        return false;
    }
    return true;
}

fn perform_demotion(
    state: TrustPolicyState,
    entity_id: u64,
    rule_id: u64,
    triggered_by: u64,
) -> (TrustPolicyState, bool)
    effect [trust:demote, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    let mut demoted: bool = false;

    let entity_opt: Option(TrustEntity) = find_entity_by_id(updated, entity_id);
    match entity_opt {
        Option::Some(entity) => {
            for ri in 0..updated.demotion_count {
                let rule: DemotionRule = updated.demotion_rules[ri];
                if rule.rule_id == rule_id && rule.enabled {
                    if check_demotion_conditions(updated, entity, rule) {
                        let mut e: TrustEntity = entity;
                        let old_level: TrustLevel = e.trust_level;
                        let old_state: TrustState = e.trust_state;
                        e.trust_level = rule.to_level;
                        e.trust_state = TrustState::Degraded;
                        e.last_updated = 0;
                        updated.entities[entity_id as u8] = e;
                        demoted = true;

                        if updated.history_count < MAX_REVIEW_HISTORY {
                            let record: TrustTransitionRecord = TrustTransitionRecord{
                                transition_id: updated.history_count + 1,
                                entity_id: entity_id,
                                from_state: old_state,
                                to_state: e.trust_state,
                                from_level: old_level,
                                to_level: rule.to_level,
                                from_score: entity.trust_score,
                                to_score: e.trust_score,
                                reason: Str::from("Demotion"),
                                triggered_by: triggered_by,
                                timestamp: 0,
                                evidence_id: 0,
                                approved_by: 0,
                            };
                            updated.transition_history[updated.history_count] = record;
                            updated.history_count = updated.history_count + 1;
                        }

                        residual emit {
                            op: "trust.demotion",
                            entity: entity_id,
                            from: old_level as u8,
                            to: rule.to_level as u8,
                            rule: rule_id,
                            reason: rule.reason as u8,
                        };
                    }
                    break;
                }
            }
        },
        Option::None => {},
    };

    return (updated, demoted);
}

fn evaluate_auto_demotions(state: TrustPolicyState) -> (TrustPolicyState, u64)
    effect [trust:demote, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    let mut demoted_count: u64 = 0;

    for ei in 0..updated.entity_count {
        let entity: TrustEntity = updated.entities[ei];
        for ri in 0..updated.demotion_count {
            let rule: DemotionRule = updated.demotion_rules[ri];
            if rule.enabled && rule.auto_demote {
                if check_demotion_conditions(updated, entity, rule) {
                    let (new_state, ok): (TrustPolicyState, bool) = perform_demotion(
                        updated, entity.entity_id, rule.rule_id, 0,
                    );
                    updated = new_state;
                    if ok {
                        demoted_count = demoted_count + 1;
                    }
                }
            }
        }
    }

    residual emit {
        op: "trust.auto_demotions",
        demoted: demoted_count,
    };

    return (updated, demoted_count);
}

// ──────────────────────────────────────────────
// Cross-Domain Trust
// ──────────────────────────────────────────────

fn add_cross_domain_trust(state: TrustPolicyState, cd: CrossDomainTrust) -> TrustPolicyState
    effect [trust:crossdomain, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    if updated.cross_domain_count < MAX_CROSS_DOMAIN_TRUSTS {
        updated.cross_domain_trusts[updated.cross_domain_count] = cd;
        updated.cross_domain_count = updated.cross_domain_count + 1;

        residual emit {
            op: "trust.cross_domain_add",
            id: cd.trust_id,
            local: cd.local_domain,
            remote: cd.remote_domain,
            type: cd.trust_type as u8,
            level: cd.trust_level as u8,
        };
    }
    return updated;
}

fn evaluate_cross_domain_trust(
    state: TrustPolicyState,
    local_entity: u64,
    remote_entity: u64,
    local_domain: u64,
    remote_domain: u64,
) -> TrustLevel
    effect [trust:crossdomain, compute, residual]
{
    let mut effective_trust: TrustLevel = TrustLevel::None;

    for i in 0..state.cross_domain_count {
        let cd: CrossDomainTrust = state.cross_domain_trusts[i];
        if cd.local_domain == local_domain && cd.remote_domain == remote_domain && cd.active {
            effective_trust = cd.trust_level;
            break;
        }
    }

    residual emit {
        op: "trust.cross_domain_evaluate",
        local: local_entity,
        remote: remote_entity,
        local_domain: local_domain,
        remote_domain: remote_domain,
        trust: effective_trust as u8,
    };

    return effective_trust;
}

fn create_domain(
    domain_id: u64,
    name: Str(64),
    parent_domain: u64,
    threshold: u64,
) -> TrustDomain
    effect [trust:evaluate, compute, residual]
{
    let mut hierarchy: u64 = 0;
    if parent_domain != 0 {
        hierarchy = 1;
    }

    residual emit {
        op: "trust.domain_create",
        id: domain_id,
        name: name,
        parent: parent_domain,
        threshold: threshold,
    };

    return TrustDomain{
        domain_id: domain_id,
        name: name,
        description: Str::from(""),
        parent_domain: parent_domain,
        hierarchy_level: hierarchy,
        trust_threshold: threshold,
        default_trust: TrustLevel::None,
        member_count: 0,
        member_ids: Array::splat(0),
        is_authoritative: false,
        self_certifying: false,
        audit_all_transitions: true,
    };
}

fn add_domain_to_state(state: TrustPolicyState, domain: TrustDomain) -> TrustPolicyState
    effect [trust:evaluate, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    if updated.domain_count < MAX_TRUST_DOMAINS {
        updated.domains[updated.domain_count] = domain;
        updated.domain_count = updated.domain_count + 1;

        residual emit {
            op: "trust.domain_add",
            id: domain.domain_id,
            name: domain.name,
        };
    }
    return updated;
}

fn add_entity_to_domain(
    state: TrustPolicyState,
    entity_id: u64,
    domain_id: u64,
) -> TrustPolicyState
    effect [trust:evaluate, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    for di in 0..updated.domain_count {
        if updated.domains[di].domain_id == domain_id {
            let mut d: TrustDomain = updated.domains[di];
            if d.member_count < MAX_TRUST_ENTITIES {
                d.member_ids[d.member_count] = entity_id;
                d.member_count = d.member_count + 1;
                updated.domains[di] = d;
            }
            break;
        }
    }

    residual emit {
        op: "trust.entity_domain_add",
        entity: entity_id,
        domain: domain_id,
    };

    return updated;
}

// ──────────────────────────────────────────────
// Trust Review Schedules
// ──────────────────────────────────────────────

fn add_review_schedule(state: TrustPolicyState, schedule: ReviewSchedule) -> TrustPolicyState
    effect [trust:review, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    if updated.schedule_count < MAX_REVIEW_SCHEDULES {
        updated.review_schedules[updated.schedule_count] = schedule;
        updated.schedule_count = updated.schedule_count + 1;

        residual emit {
            op: "trust.schedule_add",
            id: schedule.schedule_id,
            domain: schedule.domain_id,
            frequency: schedule.frequency as u8,
        };
    }
    return updated;
}

fn perform_trust_review(
    state: TrustPolicyState,
    entity_id: u64,
    reviewer_id: u64,
) -> (TrustPolicyState, TrustEntity)
    effect [trust:review, compute, residual]
{
    let mut updated: TrustPolicyState = state;
    let entity_opt: Option<TrustEntity> = find_entity_by_id(updated, entity_id);
    match entity_opt {
        Option::Some(entity) => {
            let mut e: TrustEntity = entity;
            e.last_reviewed = 0;
            updated.entities[entity_id as u8] = e;

            residual emit {
                op: "trust.review_perform",
                entity: entity_id,
                reviewer: reviewer_id,
                current_level: e.trust_level as u8,
                current_score: e.trust_score,
            };
            return (updated, e);
        },
        Option::None => {
            let empty: TrustEntity = TrustEntity{
                entity_id: 0, name: Str::from(""), domain_id: 0,
                trust_level: TrustLevel::None, trust_state: TrustState::Initial,
                trust_score: 0, score_components: Array::splat(0),
                component_count: 0, evidence_count: 0, evidence_ids: Array::splat(0),
                created_at: 0, last_updated: 0, last_reviewed: 0,
                parent_entity: 0, hierarchy_level: 0, attributes: Array::splat(0),
                attribute_count: 0, delegation_depth: 0, attributes_hash: Array::splat(0),
            };
            return (updated, empty);
        },
    };
}

fn check_review_due(state: TrustPolicyState, schedule_id: u64, current_time: u64) -> bool
    effect [compute]
{
    for i in 0..state.schedule_count {
        if state.schedules[i].schedule_id == schedule_id {
            let s: ReviewSchedule = state.schedules[i];
            if s.enabled && current_time >= s.next_review {
                return true;
            }
        }
    }
    return false;
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main() -> TrustPolicyState
    effect [trust:evaluate, trust:promote, trust:demote, trust:crossdomain, trust:review, compute, io:write, residual]
{
    let mut state: TrustPolicyState = TrustPolicyState{
        entities: Array::zeroed(), entity_count: 0,
        domains: Array::zeroed(), domain_count: 0,
        thresholds: Array::zeroed(), threshold_count: 0,
        promotion_rules: Array::zeroed(), promotion_count: 0,
        demotion_rules: Array::zeroed(), demotion_count: 0,
        cross_domain_trusts: Array::zeroed(), cross_domain_count: 0,
        review_schedules: Array::zeroed(), schedule_count: 0,
        transition_history: Array::zeroed(), history_count: 0,
        min_trust_for_access: TrustLevel::Low,
        audit_all_trust_changes: true,
        policy_version: 1,
    };

    let domain_local: TrustDomain = create_domain(1, Str::from("local_domain"), 0, 50);
    state = add_domain_to_state(state, domain_local);

    let t_none: TrustThreshold = create_trust_threshold(1, Str::from("none"), TrustLevel::None, 0, 9);
    state = add_trust_threshold(state, t_none);

    let t_low: TrustThreshold = create_trust_threshold(2, Str::from("low"), TrustLevel::Low, 10, 39);
    state = add_trust_threshold(state, t_low);

    let t_medium: TrustThreshold = create_trust_threshold(3, Str::from("medium"), TrustLevel::Medium, 40, 69);
    state = add_trust_threshold(state, t_medium);

    let t_high: TrustThreshold = create_trust_threshold(4, Str::from("high"), TrustLevel::High, 70, 100);
    state = add_trust_threshold(state, t_high);

    let entity: TrustEntity = create_trust_entity(1001, Str::from("build_server"), 1);
    let mut e: TrustEntity = entity;
    e.trust_score = 45;
    e.trust_level = TrustLevel::Medium;
    e.trust_state = TrustState::Established;
    state = add_entity_to_state(state, e);

    let entity2: TrustEntity = create_trust_entity(1002, Str::from("dev_workstation"), 1);
    let mut e2: TrustEntity = entity2;
    e2.trust_score = 20;
    e2.trust_level = TrustLevel::Low;
    state = add_entity_to_state(state, e2);

    let prom_rule: PromotionRule = PromotionRule{
        rule_id: 1, name: Str::from("low_to_medium"),
        from_level: TrustLevel::Low, to_level: TrustLevel::Medium,
        requirement: PromotionRequirement::TimeElapsed,
        min_score_increase: 30, min_evidence_required: 3,
        min_time_days: 30, require_approval: false,
        approver_role: 0, court_required: false,
        auto_promote: true, enabled: true,
    };
    state = add_promotion_rule(state, prom_rule);

    let dem_rule: DemotionRule = DemotionRule{
        rule_id: 1, name: Str::from("time_decay"),
        from_level: TrustLevel::Medium, to_level: TrustLevel::Low,
        reason: DemotionReason::TimeDecay,
        score_decrease_threshold: 20, max_violations: 3,
        violation_window: 86400, require_manual: false,
        auto_demote: true, notify: true, enabled: true,
    };
    state = add_demotion_rule(state, dem_rule);

    let level: TrustLevel = get_trust_level_for_score(state, 45);
    assert(level == TrustLevel::Medium, "trust_policy: score 45 maps to Medium");

    let meets: bool = score_meets_threshold(state, 45, TrustLevel::Medium);
    assert(meets, "trust_policy: score 45 meets Medium threshold");

    let (promoted_state, promoted): (TrustPolicyState, bool) = perform_promotion(state, 1002, 1, 0);
    state = promoted_state;

    assert(state.entity_count >= 2, "trust_policy: entities created");
    assert(state.threshold_count >= 4, "trust_policy: thresholds configured");
    assert(state.promotion_count >= 1, "trust_policy: promotion rules added");

    residual emit {
        op: "trust_policy.init_complete",
        entities: state.entity_count,
        domains: state.domain_count,
        thresholds: state.threshold_count,
        promotions: state.promotion_count,
        demotions: state.demotion_count,
        cross_domain: state.cross_domain_count,
        history: state.history_count,
    };

    return state;
}
