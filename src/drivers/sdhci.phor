// sdhci.phor — SDHCI/eMMC driver
// SD/eMMC protocol (CMD/ADMA), bus width, speed modes (HS, UHS, HS400),
// card detection, write protection, partition management, erase, trim/discard,
// packed commands.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/sdhci.phor
// Court: sdhci_driver:v2

package drivers.sdhci;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type SdhciError = enum {
    SdhciNotInitialized          = 0xC00,
    SdhciControllerNotFound      = 0xC01,
    SdhciCardNotPresent          = 0xC02,
    SdhciCardDetectionFailed     = 0xC03,
    SdhciCmdTimeout              = 0xC04,
    SdhciDataTimeout             = 0xC05,
    SdhciCrcError                = 0xC06,
    SdhciIllegalCommand          = 0xC07,
    SdhciAdmaError               = 0xC08,
    SdhciBusy                    = 0xC09,
    SdhciCapabilityError         = 0xC0A,
    SdhciInvalidBusWidth         = 0xC0B,
    SdhciSpeedModeError          = 0xC0C,
    SdhciTuningFailed            = 0xC0D,
    SdhciEraseError              = 0xC0E,
    SdhciTrimError               = 0xC0F,
    SdhciPartitionError          = 0xC10,
    SdhciWriteProtectError       = 0xC11,
    SdhciPackedCmdError          = 0xC12,
    SdhciDmaError                = 0xC13,
    SdhciMaxDevicesExceeded      = 0xC14,
    SdhciResidualStoreFull       = 0xC15,
    SdhciCardIncompatible        = 0xC16,
    SdhciPowerCycleRequired      = 0xC17,
    SdhciUhsNotSupported         = 0xC18,
    SdhciHs400TuningFail         = 0xC19,
}

// ─────────────────────────────────────────────────────────────
// SDHCI Full Capability
// ─────────────────────────────────────────────────────────────

struct SdhciCapability {
    object_id: Identity,
    generation: u64,
    can_read: bool,
    can_write: bool,
    can_erase: bool,
    can_trim: bool,
    can_packed_cmd: bool,
    can_adma: bool,
    can_speed_change: bool,
    can_tuning: bool,
    can_partition: bool,
    max_slots: u64,
}

// ─────────────────────────────────────────────────────────────
// SDHCI Register Offsets
// ─────────────────────────────────────────────────────────────

struct SdhciRegisters {
    mmio_base: u64,
}

impl SdhciRegisters {
    fn sdma_addr_offset() -> u64 { return 0x00; }
    fn block_size_offset() -> u64 { return 0x04; }
    fn block_count_offset() -> u64 { return 0x06; }
    fn argument_offset() -> u64 { return 0x08; }
    fn transfer_mode_offset() -> u64 { return 0x0C; }
    fn command_offset() -> u64 { return 0x0E; }
    fn response_offset(i: u64) -> u64 { return 0x10 + i * 4; }
    fn data_buffer_offset() -> u64 { return 0x20; }
    fn present_state_offset() -> u64 { return 0x24; }
    fn host_control1_offset() -> u64 { return 0x28; }
    fn power_control_offset() -> u64 { return 0x29; }
    fn block_gap_control_offset() -> u64 { return 0x2A; }
    fn wakeup_control_offset() -> u64 { return 0x2B; }
    fn clock_control_offset() -> u64 { return 0x2C; }
    fn timeout_control_offset() -> u64 { return 0x2E; }
    fn software_reset_offset() -> u64 { return 0x2F; }
    fn irq_status_offset() -> u64 { return 0x30; }
    fn irq_enable_offset() -> u64 { return 0x34; }
    fn irq_signal_enable_offset() -> u64 { return 0x38; }
    fn acmd_err_status_offset() -> u64 { return 0x3C; }
    fn host_control2_offset() -> u64 { return 0x3E; }
    fn capabilities1_offset() -> u64 { return 0x40; }
    fn capabilities2_offset() -> u64 { return 0x44; }
    fn max_current_cap_offset() -> u64 { return 0x48; }
    fn force_auto_cmd12_offset() -> u64 { return 0x50; }
    fn host_control3_offset() -> u64 { return 0x52; }
    fn adma_err_status_offset() -> u64 { return 0x54; }
    fn adma_sys_addr_offset() -> u64 { return 0x58; }
    fn preset_val_init_offset() -> u64 { return 0x60; }
    fn preset_val_default_offset() -> u64 { return 0x62; }
    fn preset_val_hs_offset() -> u64 { return 0x64; }
    fn preset_val_uhs_sdr12_offset() -> u64 { return 0x66; }
    fn preset_val_uhs_sdr25_offset() -> u64 { return 0x68; }
    fn preset_val_uhs_sdr50_offset() -> u64 { return 0x6A; }
    fn preset_val_uhs_sdr104_offset() -> u64 { return 0x6C; }
    fn preset_val_uhs_ddr50_offset() -> u64 { return 0x6E; }
    fn preset_val_uhs_ddr104_offset() -> u64 { return 0x70; }

    fn read8(self, offset: u64) -> u8
        effect [memory:mmio]
    {
        return trusted reason "SDHCI MMIO register read (8-bit), SDHCI Spec §2.3" {
            let ptr: *(u8) = (self.mmio_base + offset) as *(u8);
            return *ptr;
        };
    }

    fn read16(self, offset: u64) -> u16
        effect [memory:mmio]
    {
        return trusted reason "SDHCI MMIO register read (16-bit)" {
            let ptr: *(u16) = (self.mmio_base + offset) as *(u16);
            return *ptr;
        };
    }

    fn read32(self, offset: u64) -> u32
        effect [memory:mmio]
    {
        return trusted reason "SDHCI MMIO register read (32-bit)" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            return *ptr;
        };
    }

    fn write8(self, offset: u64, value: u8) -> void
        effect [memory:mmio]
    {
        trusted reason "SDHCI MMIO register write (8-bit)" {
            let ptr: *(u8) = (self.mmio_base + offset) as *(u8);
            *ptr = value;
        };
    }

    fn write16(self, offset: u64, value: u16) -> void
        effect [memory:mmio]
    {
        trusted reason "SDHCI MMIO register write (16-bit)" {
            let ptr: *(u16) = (self.mmio_base + offset) as *(u16);
            *ptr = value;
        };
    }

    fn write32(self, offset: u64, value: u32) -> void
        effect [memory:mmio]
    {
        trusted reason "SDHCI MMIO register write (32-bit)" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            *ptr = value;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// SDHCI Capabilities
// ─────────────────────────────────────────────────────────────

struct SdhciHostCap {
    timeout_clk_freq: u8,
    timeout_clk_unit: bool,
    base_clk_freq: u8,
    max_block_len: u8,
    bus_8bit: bool,
    adma2: bool,
    high_speed: bool,
    dma: bool,
    suspend_resume: bool,
    voltage_33v: bool,
    voltage_30v: bool,
    voltage_18v: bool,
    vdd_18v: bool,
    sdma_64bit: bool,
    v3_00_se: bool,
    sdr50: bool,
    sdr104: bool,
    ddr50: bool,
    drv_a: bool,
    drv_b: bool,
    drv_c: bool,
    drv_d: bool,
    retune_rates: u8,
}

fn sdhci_parse_caps1(cap: u32) -> SdhciHostCap
    effect [deterministic]
{
    return SdhciHostCap {
        timeout_clk_freq: (cap & 0x3F) as u8,
        timeout_clk_unit: ((cap >> 7) & 0x01) != 0,
        base_clk_freq: ((cap >> 8) & 0x3F) as u8,
        max_block_len: ((cap >> 16) & 0x03) as u8,
        bus_8bit: ((cap >> 18) & 0x01) != 0,
        adma2: ((cap >> 19) & 0x01) != 0,
        high_speed: ((cap >> 21) & 0x01) != 0,
        dma: ((cap >> 22) & 0x01) != 0,
        suspend_resume: ((cap >> 23) & 0x01) != 0,
        voltage_33v: ((cap >> 24) & 0x01) != 0,
        voltage_30v: ((cap >> 25) & 0x01) != 0,
        voltage_18v: ((cap >> 26) & 0x01) != 0,
        vdd_18v: false,
        sdma_64bit: false,
        v3_00_se: false,
        sdr50: false, sdr104: false, ddr50: false,
        drv_a: false, drv_b: false, drv_c: false, drv_d: false,
        retune_rates: 0,
    };
}

// ─────────────────────────────────────────────────────────────
// Card Types
// ─────────────────────────────────────────────────────────────

type SdhciCardType = enum {
    UnknownCard    = 0,
    SdCard         = 1,
    MmcCard        = 2,
    SdioCard       = 3,
    ComboCard      = 4,
}

// ─────────────────────────────────────────────────────────────
// Speed Modes
// ─────────────────────────────────────────────────────────────

type SdhciSpeedMode = enum {
    DefaultSpeed    = 0,
    HighSpeed       = 1,
    Sdr12           = 2,
    Sdr25           = 3,
    Sdr50           = 4,
    Sdr104          = 5,
    Ddr50           = 6,
    Hs200           = 7,
    Hs400           = 8,
    UnknownSpeedMode = 9,
}

// ─────────────────────────────────────────────────────────────
// Bus Width
// ─────────────────────────────────────────────────────────────

type SdhciBusWidth = enum {
    Width1Bit  = 0,
    Width4Bit  = 1,
    Width8Bit  = 2,
}

// ─────────────────────────────────────────────────────────────
// Partition Types (eMMC)
// ─────────────────────────────────────────────────────────────

type SdhciPartitionType = enum {
    UserPartition    = 0,
    BootPartition1   = 1,
    BootPartition2   = 2,
    RpmiPartition    = 3,
    Gpp1             = 4,
    Gpp2             = 5,
    Gpp3             = 6,
    Gpp4             = 7,
}

// ─────────────────────────────────────────────────────────────
// Card State
// ─────────────────────────────────────────────────────────────

struct SdhciCardState {
    card_type: SdhciCardType,
    speed_mode: SdhciSpeedMode,
    bus_width: SdhciBusWidth,
    rca: u16,
    ocr: u32,
    csd: Array(u8, 16),
    cid: Array(u8, 16),
    scr: Array(u8, 8),
    sd_status: Array(u8, 64),
    ext_csd: Array(u8, 512),
    block_len: u32,
    block_count: u64,
    capacity_sectors: u64,
    write_protected: bool,
    perm_write_protect: bool,
    tpr_write_protect: bool,
    erased: bool,
    tuning_done: bool,
    hs400_tuning: bool,
    re_tuning_required: bool,
    current_partition: SdhciPartitionType,
    boot_partition_enabled: bool,
    boot_ack_enabled: bool,
    boot_bus_width: SdhciBusWidth,
    packed_cmd_supported: bool,
    cache_size: u32,
    max_enh_size: u64,
    enh_start_addr: u64,
    enh_partition_size: u64,
}

// ─────────────────────────────────────────────────────────────
// ADMA Descriptor
// ─────────────────────────────────────────────────────────────

struct SdhciAdmaDesc {
    attribute: u16,
    length: u16,
    address: u32,
    address_hi: u32,
}

// ─────────────────────────────────────────────────────────────
// ADMA State
// ─────────────────────────────────────────────────────────────

struct SdhciAdmaState {
    descriptors: Array(SdhciAdmaDesc, 64),
    desc_count: u64,
    desc_phys: u64,
    adma_enabled: bool,
    adma_error: bool,
    adma_desc_index: u64,
}

// ─────────────────────────────────────────────────────────────
// Command Information
// ─────────────────────────────────────────────────────────────

struct SdhciCmdInfo {
    cmd_index: u8,
    cmd_type: SdhciCmdType,
    data_present: bool,
    cmd_index_check: bool,
    cmd_crc_check: bool,
    response_type: SdhciResponseType,
    response: Array(u32, 4),
    response_len: u8,
}

type SdhciCmdType = enum {
    Normal       = 0,
    Suspend      = 1,
    Resume       = 2,
    Abort        = 3,
}

type SdhciResponseType = enum {
    NoResponse    = 0,
    Response136   = 1,
    Response48    = 2,
    Response48Busy = 3,
}

// ─────────────────────────────────────────────────────────────
// Slot (Controller Instance)
// ─────────────────────────────────────────────────────────────

struct SdhciSlot {
    slot_number: u8,
    mmio_base: u64,
    regs: SdhciRegisters,
    caps: SdhciHostCap,
    card: SdhciCardState,
    adma: SdhciAdmaState,
    clock_khz: u32,
    base_clock_khz: u32,
    irq_vector: u8,
    card_detect_pin: bool,
    write_protect_pin: bool,
    power_enabled: bool,
    initialized: bool,
    card_present: bool,
    residual_log: RingBuf(ResidualRecord, 32),
}

// ─────────────────────────────────────────────────────────────
// Controller State
// ─────────────────────────────────────────────────────────────

struct SdhciController {
    controller_identity: Identity,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    mmio_base: u64,
    mmio_size: u64,
    irq_base: u8,
    slots: Array(SdhciSlot, 2),
    slot_count: u8,
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct SdhciDriverState {
    driver_identity: Identity,
    controllers: Array(SdhciController, 4),
    controller_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_io: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Send Command to Card
// ─────────────────────────────────────────────────────────────

fn sdhci_send_command(
    slot: Handle(SdhciSlot),
    cmd: SdhciCmdInfo,
    arg: u32,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_send_command:v1"
{
    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };

    loop bound 1000 {
        let state: u32 = regs.read32(SdhciRegisters::present_state_offset());
        if (state & 0x00040000) == 0 {
            break;
        };
    };

    regs.write32(SdhciRegisters::argument_offset(), arg);

    let mut cmd_reg: u16 = (cmd.cmd_index as u16) | ((cmd.cmd_type as u16) << 5);
    if cmd.data_present {
        cmd_reg = cmd_reg | (1 << 4);
    };
    if cmd.cmd_index_check {
        cmd_reg = cmd_reg | (1 << 6);
    };
    if cmd.cmd_crc_check {
        cmd_reg = cmd_reg | (1 << 7);
    };
    cmd_reg = cmd_reg | ((cmd.response_type as u16) << 8);

    regs.write16(SdhciRegisters::command_offset(), cmd_reg);

    loop bound 10000 {
        let irq: u32 = regs.read32(SdhciRegisters::irq_status_offset());
        if (irq & 0x01) != 0 {
            regs.write32(SdhciRegisters::irq_status_offset(), 0x01);
            if cmd.response_type == SdhciResponseType::Response136 {
                slot.card.csd[0] = regs.read32(SdhciRegisters::response_offset(0)) as u8;
                cmd.response[0] = regs.read32(SdhciRegisters::response_offset(0));
                cmd.response[1] = regs.read32(SdhciRegisters::response_offset(1));
                cmd.response[2] = regs.read32(SdhciRegisters::response_offset(2));
                cmd.response[3] = regs.read32(SdhciRegisters::response_offset(3));
            } else {
                cmd.response[0] = regs.read32(SdhciRegisters::response_offset(0));
            };
            residual emit {
                op: "sdhci.send_command",
                cmd_index: cmd.cmd_index as u64,
                arg: arg,
                response: cmd.response[0] as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
        if (irq & 0x8000) != 0 {
            regs.write32(SdhciRegisters::irq_status_offset(), 0x8000);
            return Result::Err(SdhciError::SdhciCmdTimeout);
        };
        if (irq & 0x0008) != 0 {
            regs.write32(SdhciRegisters::irq_status_offset(), 0x0008);
            return Result::Err(SdhciError::SdhciCrcError);
        };
        if (irq & 0x0020) != 0 {
            regs.write32(SdhciRegisters::irq_status_offset(), 0x0020);
            return Result::Err(SdhciError::SdhciIllegalCommand);
        };
    };

    return Result::Err(SdhciError::SdhciCmdTimeout);
}

// ─────────────────────────────────────────────────────────────
// Set Bus Width
// ─────────────────────────────────────────────────────────────

fn sdhci_set_bus_width(
    slot: Handle(SdhciSlot),
    width: SdhciBusWidth,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_set_bus_width:v1"
{
    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };
    let hc1: u8 = regs.read8(SdhciRegisters::host_control1_offset());

    let new_hc1: u8;
    if width == SdhciBusWidth::Width8Bit {
        new_hc1 = (hc1 & !0x03) | 0x02;
    } else if width == SdhciBusWidth::Width4Bit {
        new_hc1 = (hc1 & !0x03) | 0x01;
    } else {
        new_hc1 = hc1 & !0x03;
    };

    regs.write8(SdhciRegisters::host_control1_offset(), new_hc1);
    slot.card.bus_width = width;

    residual emit {
        op: "sdhci.set_bus_width",
        width: width as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Clock Frequency
// ─────────────────────────────────────────────────────────────

fn sdhci_set_clock(
    slot: Handle(SdhciSlot),
    target_khz: u32,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_set_clock:v1"
{
    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };
    let base_khz: u32 = slot.base_clock_khz;

    if target_khz > base_khz {
        return Result::Err(SdhciError::SdhciSpeedModeError);
    };

    let divider: u32;
    if target_khz >= base_khz {
        divider = 1;
    } else {
        divider = (base_khz + target_khz - 1) / target_khz;
        if divider < 2 {
            divider = 2;
        };
    };

    let sdclk: u16;
    if divider <= 1 {
        sdclk = 0x0800;
    } else if divider <= 2 {
        sdclk = 0x0800 | 0x01;
    } else if divider <= 4 {
        sdclk = 0x0800 | 0x02;
    } else if divider <= 8 {
        sdclk = 0x0800 | 0x03;
    } else if divider <= 16 {
        sdclk = 0x0800 | 0x04;
    } else if divider <= 32 {
        sdclk = 0x0800 | 0x05;
    } else if divider <= 64 {
        sdclk = 0x0800 | 0x06;
    } else if divider <= 128 {
        sdclk = 0x0800 | 0x07;
    } else if divider <= 256 {
        sdclk = 0x0800 | 0x08;
    } else if divider <= 512 {
        sdclk = 0x0800 | 0x09;
    } else {
        sdclk = 0x0800 | 0x0A;
    };

    regs.write16(SdhciRegisters::clock_control_offset(), sdclk);

    loop bound 1000 {
        let clk: u16 = regs.read16(SdhciRegisters::clock_control_offset());
        if (clk & 0x8000) != 0 {
            break;
        };
    };

    slot.clock_khz = base_khz / divider;

    residual emit {
        op: "sdhci.set_clock",
        target_khz: target_khz,
        actual_khz: slot.clock_khz,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Speed Mode (UHS / HS / HS200 / HS400)
// ─────────────────────────────────────────────────────────────

fn sdhci_set_speed_mode(
    slot: Handle(SdhciSlot),
    mode: SdhciSpeedMode,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_set_speed_mode:v1"
{
    if !cap.can_speed_change {
        return Result::Err(SdhciError::SdhciCapabilityError);
    };

    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };
    let hc2: u16 = regs.read16(SdhciRegisters::host_control2_offset());

    let mut new_hc2: u16 = hc2 & !0x7000;
    let uhs_mode: u16;

    if mode == SdhciSpeedMode::HighSpeed || mode == SdhciSpeedMode::DefaultSpeed {
        uhs_mode = 0;
    } else if mode == SdhciSpeedMode::Sdr12 {
        uhs_mode = 0x1000;
    } else if mode == SdhciSpeedMode::Sdr25 {
        uhs_mode = 0x2000;
    } else if mode == SdhciSpeedMode::Sdr50 {
        uhs_mode = 0x3000;
    } else if mode == SdhciSpeedMode::Sdr104 {
        uhs_mode = 0x4000;
    } else if mode == SdhciSpeedMode::Ddr50 {
        uhs_mode = 0x5000;
    } else {
        uhs_mode = 0;
    };

    new_hc2 = new_hc2 | uhs_mode;
    regs.write16(SdhciRegisters::host_control2_offset(), new_hc2);
    slot.card.speed_mode = mode;

    residual emit {
        op: "sdhci.set_speed_mode",
        mode: mode as u64,
        uhs_value: uhs_mode as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Card Detection
// ─────────────────────────────────────────────────────────────

fn sdhci_card_detect(
    slot: Handle(SdhciSlot),
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(bool, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_card_detect:v1"
{
    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };
    let state: u32 = regs.read32(SdhciRegisters::present_state_offset());
    let card_present: bool = (state & 0x00010000) != 0;

    slot.card_present = card_present;
    slot.card_detect_pin = card_present;

    residual emit {
        op: "sdhci.card_detect",
        present: card_present,
        timestamp: timestamp,
    };

    return Result::Ok(card_present);
}

// ─────────────────────────────────────────────────────────────
// Read Write Protect Status
// ─────────────────────────────────────────────────────────────

fn sdhci_read_write_protect(
    slot: Handle(SdhciSlot),
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(bool, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_read_write_protect:v1"
{
    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };
    let state: u32 = regs.read32(SdhciRegisters::present_state_offset());
    let wp: bool = (state & 0x00020000) != 0;

    slot.write_protect_pin = wp;
    slot.card.write_protected = wp;

    residual emit {
        op: "sdhci.read_write_protect",
        write_protected: wp,
        timestamp: timestamp,
    };

    return Result::Ok(wp);
}

// ─────────────────────────────────────────────────────────────
// Partition Management: Select Partition
// ─────────────────────────────────────────────────────────────

fn sdhci_select_partition(
    slot: Handle(SdhciSlot),
    partition: SdhciPartitionType,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_select_partition:v1"
{
    if !cap.can_partition {
        return Result::Err(SdhciError::SdhciCapabilityError);
    };

    let cmd: SdhciCmdInfo = SdhciCmdInfo {
        cmd_index: 6,
        cmd_type: SdhciCmdType::Normal,
        data_present: false,
        cmd_index_check: true,
        cmd_crc_check: true,
        response_type: SdhciResponseType::Response48,
        response: Array::zeroed(),
        response_len: 4,
    };

    let arg: u32 = (partition as u32) << 24;
    let cmd_result: Result(void, SdhciError) = sdhci_send_command(slot, cmd, arg, cap, timestamp);
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    slot.card.current_partition = partition;

    residual emit {
        op: "sdhci.select_partition",
        partition: partition as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Erase (eMMC: Erase, SD: Erase)
// ─────────────────────────────────────────────────────────────

fn sdhci_erase(
    slot: Handle(SdhciSlot),
    start_lba: u64,
    end_lba: u64,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_erase:v1"
{
    if !cap.can_erase {
        return Result::Err(SdhciError::SdhciCapabilityError);
    };

    let erase_arg: u32 = 0x00000000;
    let start_arg: u32 = (start_lba & 0xFFFFFFFF) as u32;
    let end_arg: u32 = (end_lba & 0xFFFFFFFF) as u32;

    let cmd35: SdhciCmdInfo = SdhciCmdInfo {
        cmd_index: 35,
        cmd_type: SdhciCmdType::Normal, data_present: false,
        cmd_index_check: true, cmd_crc_check: true,
        response_type: SdhciResponseType::Response48,
        response: Array::zeroed(), response_len: 4,
    };

    let cmd35_result: Result(void, SdhciError) = sdhci_send_command(slot, cmd35, erase_arg, cap, timestamp);
    match cmd35_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let cmd36: SdhciCmdInfo = SdhciCmdInfo {
        cmd_index: 36,
        cmd_type: SdhciCmdType::Normal, data_present: false,
        cmd_index_check: true, cmd_crc_check: true,
        response_type: SdhciResponseType::Response48,
        response: Array::zeroed(), response_len: 4,
    };

    let cmd36_result: Result(void, SdhciError) = sdhci_send_command(slot, cmd36, start_arg, cap, timestamp);
    match cmd36_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let cmd38: SdhciCmdInfo = SdhciCmdInfo {
        cmd_index: 38,
        cmd_type: SdhciCmdType::Normal, data_present: false,
        cmd_index_check: true, cmd_crc_check: true,
        response_type: SdhciResponseType::Response48Busy,
        response: Array::zeroed(), response_len: 4,
    };

    let cmd38_result: Result(void, SdhciError) = sdhci_send_command(slot, cmd38, end_arg, cap, timestamp);
    match cmd38_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "sdhci.erase",
        start_lba: start_lba,
        end_lba: end_lba,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Trim/Discard (eMMC Trim / SD Discard)
// ─────────────────────────────────────────────────────────────

fn sdhci_trim(
    slot: Handle(SdhciSlot),
    start_lba: u64,
    end_lba: u64,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_trim:v1"
{
    if !cap.can_trim {
        return Result::Err(SdhciError::SdhciCapabilityError);
    };

    let cmd_result: Result(void, SdhciError) = sdhci_erase(slot, start_lba, end_lba, cap, timestamp);
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "sdhci.trim",
        start_lba: start_lba,
        end_lba: end_lba,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// ADMA Setup
// ─────────────────────────────────────────────────────────────

fn sdhci_adma_setup(
    slot: Handle(SdhciSlot),
    data_phys: u64,
    data_size: u32,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_adma_setup:v1"
{
    if !cap.can_adma {
        return Result::Err(SdhciError::SdhciCapabilityError);
    };

    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };

    let mut desc_count: u64 = 0;
    let mut remaining: u32 = data_size;
    let mut current_addr: u64 = data_phys;

    loop bound 64 {
        if remaining == 0 || desc_count >= 64 {
            break;
        };
        let chunk: u32;
        if remaining > 65536 {
            chunk = 65536;
        } else {
            chunk = remaining;
        };

        let attr: u16 = 0x01;
        slot.adma.descriptors[desc_count] = SdhciAdmaDesc {
            attribute: attr,
            length: chunk,
            address: (current_addr & 0xFFFFFFFF) as u32,
            address_hi: ((current_addr >> 32) & 0xFFFFFFFF) as u32,
        };

        remaining = remaining - chunk;
        current_addr = current_addr + chunk;
        desc_count = desc_count + 1;
    };

    slot.adma.descriptors[desc_count - 1].attribute = slot.adma.descriptors[desc_count - 1].attribute | 0x03;
    slot.adma.desc_count = desc_count;

    let adma_sys: u64 = slot.adma.desc_phys;
    regs.write32(SdhciRegisters::adma_sys_addr_offset(), (adma_sys & 0xFFFFFFFF) as u32);

    let hc1: u8 = regs.read8(SdhciRegisters::host_control1_offset());
    regs.write8(SdhciRegisters::host_control1_offset(), hc1 | 0x04);

    slot.adma.adma_enabled = true;

    residual emit {
        op: "sdhci.adma_setup",
        data_phys: data_phys,
        data_size: data_size,
        desc_count: desc_count,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Data Transfer (via SDMA or ADMA)
// ─────────────────────────────────────────────────────────────

fn sdhci_data_transfer(
    slot: Handle(SdhciSlot),
    data_phys: u64,
    block_size: u16,
    block_count: u16,
    is_write: bool,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_data_transfer:v1"
{
    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };
    let total_size: u32 = (block_size as u32) * (block_count as u32);

    regs.write16(SdhciRegisters::block_size_offset(), block_size);
    regs.write16(SdhciRegisters::block_count_offset(), block_count);

    if slot.adma.adma_enabled {
        let adma_result: Result(void, SdhciError) = sdhci_adma_setup(slot, data_phys, total_size, cap, timestamp);
        match adma_result {
            Result::Err(e) => { return Result::Err(e); },
            Result::Ok(_) => {},
        };
    } else {
        regs.write32(SdhciRegisters::sdma_addr_offset(), (data_phys & 0xFFFFFFFF) as u32);
    };

    let mut transfer_mode: u16 = 0;
    if is_write {
        transfer_mode = transfer_mode | 0x20;
    };
    if block_count > 1 {
        transfer_mode = transfer_mode | 0x01;
    };
    if slot.adma.adma_enabled {
        transfer_mode = transfer_mode | 0x02;
    };

    regs.write16(SdhciRegisters::transfer_mode_offset(), transfer_mode);

    let cmd: SdhciCmdInfo = SdhciCmdInfo {
        cmd_index: 17,
        cmd_type: SdhciCmdType::Normal,
        data_present: true,
        cmd_index_check: true,
        cmd_crc_check: true,
        response_type: SdhciResponseType::Response48,
        response: Array::zeroed(),
        response_len: 4,
    };

    let cmd_result: Result(void, SdhciError) = sdhci_send_command(slot, cmd, 0, cap, timestamp);
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "sdhci.data_transfer",
        block_size: block_size as u64,
        block_count: block_count as u64,
        is_write: is_write,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// HS400 Tuning
// ─────────────────────────────────────────────────────────────

fn sdhci_hs400_tuning(
    slot: Handle(SdhciSlot),
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_hs400_tuning:v1"
{
    if !cap.can_tuning {
        return Result::Err(SdhciError::SdhciCapabilityError);
    };

    let regs: SdhciRegisters = SdhciRegisters { mmio_base: slot.mmio_base };
    let hc2: u16 = regs.read16(SdhciRegisters::host_control2_offset());

    regs.write16(SdhciRegisters::host_control2_offset(), hc2 | 0x8000);

    loop bound 10000 {
        let irq: u32 = regs.read32(SdhciRegisters::irq_status_offset());
        if (irq & 0x8000) != 0 {
            regs.write32(SdhciRegisters::irq_status_offset(), 0x8000);
            return Result::Err(SdhciError::SdhciHs400TuningFail);
        };
        if (irq & 0x04000000) != 0 {
            regs.write32(SdhciRegisters::irq_status_offset(), 0x04000000);
            slot.card.tuning_done = true;
            slot.card.hs400_tuning = true;
            residual emit {
                op: "sdhci.hs400_tuning",
                success: true,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        };
    };

    return Result::Err(SdhciError::SdhciTuningFailed);
}

// ─────────────────────────────────────────────────────────────
// Packed Command (eMMC)
// ─────────────────────────────────────────────────────────────

struct SdhciPackedCmd {
    is_write: bool,
    num_entries: u8,
    lbas: Array(u64, 16),
    block_counts: Array(u16, 16),
    data_phys: u64,
}

fn sdhci_packed_command(
    slot: Handle(SdhciSlot),
    pcmd: SdhciPackedCmd,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_packed_command:v1"
{
    if !cap.can_packed_cmd {
        return Result::Err(SdhciError::SdhciCapabilityError);
    };

    if !slot.card.packed_cmd_supported {
        return Result::Err(SdhciError::SdhciPackedCmdError);
    };

    let cmd_index: u8;
    if pcmd.is_write {
        cmd_index = 45;
    } else {
        cmd_index = 44;
    };

    let num_entries: u32 = (pcmd.num_entries as u32) - 1;
    let cmd: SdhciCmdInfo = SdhciCmdInfo {
        cmd_index: cmd_index,
        cmd_type: SdhciCmdType::Normal,
        data_present: true,
        cmd_index_check: true,
        cmd_crc_check: true,
        response_type: SdhciResponseType::Response48,
        response: Array::zeroed(),
        response_len: 4,
    };

    let result: Result(void, SdhciError) = sdhci_send_command(slot, cmd, num_entries, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "sdhci.packed_command",
        num_entries: pcmd.num_entries as u64,
        is_write: pcmd.is_write,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Slot Initialization
// ─────────────────────────────────────────────────────────────

fn sdhci_slot_init(
    slot: Handle(SdhciSlot),
    mmio_base: u64,
    cap: SdhciCapability,
    timestamp: u64,
) -> Result(void, SdhciError)
    effect [memory:mmio, deterministic, residual]
    court "sdhci_slot_init:v1"
{
    let regs: SdhciRegisters = SdhciRegisters { mmio_base: mmio_base };

    regs.write8(SdhciRegisters::software_reset_offset(), 0x07);

    loop bound 100 {
        let rst: u8 = regs.read8(SdhciRegisters::software_reset_offset());
        if (rst & 0x07) == 0 {
            break;
        };
    };

    let caps1: u32 = regs.read32(SdhciRegisters::capabilities1_offset());
    slot.caps = sdhci_parse_caps1(caps1);

    slot.base_clock_khz = (slot.caps.base_clk_freq as u32) * 1000;
    slot.clock_khz = slot.base_clock_khz;

    let power: u8 = 0x0E;
    regs.write8(SdhciRegisters::power_control_offset(), power);

    regs.write8(SdhciRegisters::host_control1_offset(), 0x00);

    let clk: u16 = 0x0800;
    regs.write16(SdhciRegisters::clock_control_offset(), clk);

    loop bound 1000 {
        let clk_st: u16 = regs.read16(SdhciRegisters::clock_control_offset());
        if (clk_st & 0x8000) != 0 {
            break;
        };
    };

    regs.write32(SdhciRegisters::irq_signal_enable_offset(), 0x01FF00FF);
    regs.write32(SdhciRegisters::irq_enable_offset(), 0x01FF00FF);

    slot.power_enabled = true;
    slot.initialized = true;

    residual emit {
        op: "sdhci.slot_init",
        mmio_base: mmio_base,
        base_clock_khz: slot.base_clock_khz,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn sdhci_driver_init(
    driver_identity: Identity,
    cap: SdhciCapability,
    timestamp: u64,
) -> SdhciDriverState
    effect [deterministic, residual]
    court "sdhci_driver_init:v1"
{
    let state: SdhciDriverState = SdhciDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_io: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "sdhci.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}
