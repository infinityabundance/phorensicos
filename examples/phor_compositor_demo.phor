// phor_compositor_demo.phor — Native .phor GUI Compositor Demo
//
// Demonstrates:
//   - Surface creation and management from .phor
//   - Window with title, position, size
//   - Draw commands: clear, fill_rect, set_pixel
//   - Multiple window management
//   - Capability-gated compositor access
//   - Bounded draw command queues
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:phor_compositor_demo:v1.0";

// ── Constants ───────────────────────────────────────────

const MAX_SURFACES: u64 = 16;
const MAX_DRAW_COMMANDS: u64 = 64;
const MAX_TITLE_LEN: u64 = 64;

// ── Draw Command Types ─────────────────────────────────

type DrawOp = u8;

const OP_CLEAR: DrawOp = 0;
const OP_SET_PIXEL: DrawOp = 1;
const OP_FILL_RECT: DrawOp = 2;
const OP_PRESENT: DrawOp = 3;

// ── Draw Command ───────────────────────────────────────

struct DrawCmd {
    op: DrawOp,
    x: u32,
    y: u32,
    w: u32,
    h: u32,
    r: u8,
    g: u8,
    b: u8,
}

impl DrawCmd {
    fn clear(r: u8, g: u8, b: u8) -> DrawCmd
        effect [compute]
    {
        return DrawCmd { op: OP_CLEAR, x: 0, y: 0, w: 0, h: 0, r: r, g: g, b: b };
    }

    fn fill_rect(x: u32, y: u32, w: u32, h: u32, r: u8, g: u8, b: u8) -> DrawCmd
        effect [compute]
    {
        return DrawCmd { op: OP_FILL_RECT, x: x, y: y, w: w, h: h, r: r, g: g, b: b };
    }

    fn present() -> DrawCmd
        effect [compute]
    {
        return DrawCmd { op: OP_PRESENT, x: 0, y: 0, w: 0, h: 0, r: 0, g: 0, b: 0 };
    }
}

// ── Surface ─────────────────────────────────────────────

struct Surface {
    surface_id: u64,
    width: u32,
    height: u32,
    title: Array(u8, 64),
    title_len: u64,
    draw_queue: Array(DrawCmd, 64),
    cmd_count: u64,
    created: bool,
}

impl Surface {
    fn new(id: u64, w: u32, h: u32, title_str: Array(u8, 64), tlen: u64) -> Surface
        effect [compute]
    {
        return Surface {
            surface_id: id,
            width: w,
            height: h,
            title: title_str,
            title_len: tlen,
            draw_queue: Array::splat_zeroed(),
            cmd_count: 0,
            created: true,
        };
    }

    fn push_cmd(mut self, cmd: DrawCmd) -> Surface
        effect [compute]
    {
        if self.cmd_count < MAX_DRAW_COMMANDS {
            self.draw_queue[self.cmd_count] = cmd;
            self.cmd_count = self.cmd_count + 1;
        }
        return self;
    }

    fn cmd_count(self) -> u64
        effect [compute]
    {
        return self.cmd_count;
    }

    fn is_created(self) -> bool
        effect [compute]
    {
        return self.created;
    }
}

// ── PhorCompositor (simulated in .phor) ────────────────

struct PhorCompositor {
    surfaces: Array(Surface, 16),
    surface_count: u64,
    next_id: u64,
}

impl PhorCompositor {
    fn new() -> PhorCompositor
        effect [compute]
    {
        return PhorCompositor {
            surfaces: Array::splat_zeroed(),
            surface_count: 0,
            next_id: 1,
        };
    }

    fn create_surface(mut self, w: u32, h: u32, title: Array(u8, 64), tlen: u64) -> (PhorCompositor, Surface)
        effect [compute]
    {
        let id: u64 = self.next_id;
        self.next_id = self.next_id + 1;
        let surf: Surface = Surface::new(id, w, h, title, tlen);
        if self.surface_count < MAX_SURFACES {
            self.surfaces[self.surface_count] = surf;
            self.surface_count = self.surface_count + 1;
        }
        return (self, surf);
    }

    fn surface_count(self) -> u64
        effect [compute]
    {
        return self.surface_count;
    }
}

// ── Test ───────────────────────────────────────────────

fn test_compositor_demo() -> bool
    effect [compute]
{
    // Create compositor
    let mut comp: PhorCompositor = PhorCompositor::new();
    assert(comp.surface_count() == 0, "phor_comp: empty compositor");

    // Create title string
    let mut title: Array(u8, 64) = Array::splat(0);
    title[0] = 0x48; title[1] = 0x65; title[2] = 0x6C; // "Hel"
    title[3] = 0x6C; title[4] = 0x6F;                   // "lo"

    // Create first surface
    let (comp, mut surf): (PhorCompositor, Surface) = comp.create_surface(320, 200, title, 5);
    assert(surf.is_created(), "phor_comp: surface created");
    assert(surf.surface_id == 1, "phor_comp: surface id = 1");
    assert(surf.surface_id > 0, "phor_comp: non-zero surface ID");

    // Queue draw commands
    let clear: DrawCmd = DrawCmd::clear(10, 10, 30);
    surf = surf.push_cmd(clear);

    let rect1: DrawCmd = DrawCmd::fill_rect(30, 40, 100, 80, 255, 68, 68);
    surf = surf.push_cmd(rect1);

    let rect2: DrawCmd = DrawCmd::fill_rect(180, 50, 80, 60, 68, 255, 68);
    surf = surf.push_cmd(rect2);

    let present: DrawCmd = DrawCmd::present();
    surf = surf.push_cmd(present);

    assert(surf.cmd_count() == 4, "phor_comp: 4 draw commands queued");

    // Create second surface
    let mut title2: Array(u8, 64) = Array::splat(0);
    title2[0] = 0x57; title2[1] = 0x6F; title2[2] = 0x72; // "Wor"
    title2[3] = 0x6C; title2[4] = 0x64;                   // "ld"
    let (comp, _surf2): (PhorCompositor, Surface) = comp.create_surface(400, 300, title2, 5);
    assert(comp.surface_count() == 2, "phor_comp: 2 surfaces created");

    // Verify surface metadata
    assert(surf.width == 320, "phor_comp: surface width");
    assert(surf.height == 200, "phor_comp: surface height");

    // Verify draw command content
    let cmd0: DrawCmd = surf.draw_queue[0];
    assert(cmd0.op == OP_CLEAR, "phor_comp: first command is clear");
    let cmd1: DrawCmd = surf.draw_queue[1];
    assert(cmd1.op == OP_FILL_RECT, "phor_comp: second command is fill_rect");
    assert(cmd1.x == 30, "phor_comp: fill_rect x=30");
    assert(cmd1.y == 40, "phor_comp: fill_rect y=40");
    assert(cmd1.r == 255, "phor_comp: fill_rect r=255");

    let cmd3: DrawCmd = surf.draw_queue[3];
    assert(cmd3.op == OP_PRESENT, "phor_comp: fourth command is present");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute]
{
    let passed: bool = test_compositor_demo();
    assert(passed, "phor compositor demo: all tests pass");

    console.write(Str::from("Phor Compositor Demo:"));
    console.write(Str::from("  Surface creation and management: PASS"));
    console.write(Str::from("  Draw command queue: PASS"));
    console.write(Str::from("  Fill rect operations: PASS"));
    console.write(Str::from("  Present flow: PASS"));
    console.write(Str::from("  Multiple surfaces: PASS"));
    console.write(Str::from("Phor compositor demo passed!"));
}
