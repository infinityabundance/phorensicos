// ──────────────────────────────────────────────
// Protocol Message Types
// ──────────────────────────────────────────────

enum ProtocolOpcode {
    // Session management
    Connect,
    Disconnect,
    ConnectAck(u64),
    ConnectNack(u64),

    // Surface management
    CreateSurface,
    DestroySurface,
    SurfaceConfigure,
    SurfaceAckConfig,

    // Buffer management
    AllocateBuffer,
    ReleaseBuffer,
    BufferAllocated(u64),
    BufferShared(u64),

    // Presentation
    AttachBuffer,
    Present,
    FrameCallback(u64),
    PresentReceipt(u64),

    // Input
    InputEvent,
    InputSubscribe,
    InputUnsubscribe,
    CursorMove,
    CursorButton,
    CursorAxis,
    KeyboardKey,
    TouchEvent,

    // Output
    OutputList,
    OutputAdded(u64),
    OutputRemoved(u64),
    OutputMode(u64),
    OutputDone,

    // Window management
    WMEnumerate,
    WMConfigureSurface,
    WMFocusSurface,
    WMStackChange,
    WMDecoration,

    // Shell
    ShellPanelInfo,
    ShellLauncherQuery,
    ShellNotification,
    ShellTrayUpdate,

    // Inspector
    InspectorDump,
    InspectorCapTree,
    InspectorResidualList,
    InspectorProvenanceChain,

    // Error
    ProtocolError(u64),
    CapabilityError(u64),
}

struct ProtocolHeader {
    opcode: ProtocolOpcode,
    serial: u64,
    sender_id: u64,
    capability_id: u64,
    generation: u64,
    payload_len: u32,
}

struct ProtocolMessage {
    header: ProtocolHeader,
    payload: Array(u8, MAX_PROTOCOL_MSG_SIZE),
}

// ──────────────────────────────────────────────
// Session Types
// ──────────────────────────────────────────────

enum SessionState {
    Connecting,
    Active,
    Suspended,
    Disconnected,
    Error(u64),
}

struct SessionCapability {
    cap_id: CapabilityId,
    granted_at: u64,
    expires_at: u64,
    provenance: u64,
    revoked: bool,
}

struct SessionInfo {
    session_id: u64,
    state: SessionState,
    client_id: u64,
    connected_at: u64,
    capabilities: RingBuf(SessionCapability, MAX_CAP_GRANTS),
    surfaces: RingBuf(u64, MAX_SURFACE_PER_CLIENT),
    pending_events: u64,
    protocol_version: (u64, u64),
}

