fn default_return[] -> SyscallReturnValue : (pure) {
  return SyscallReturnValue(result: 0, result_cap: None, error: SyscallError::NotSupported, residual_handle: 0, has_more_data: false, more_data_handle: 0, generation: 0, audit_token: 0);
}

//==============================================================================
// Utility Functions
//==============================================================================

fn is_user_address[addr: u64] -> bool : (pure) {
  return addr < 0x8000_0000_0000 && addr >= 0x1000;
}

fn read_timestamp[] -> u64 : (syscall) {
  return __read_cycle_counter();
}

fn read_caller_pc[] -> u64 : (unsafe) {
  return 0;
}

fn read_caller_identity[] -> u64 : (syscall) {
  return 0;
}

fn get_current_thread_id[] -> u64 : (syscall) {
  return 0;
}

fn get_current_process_id[] -> u64 : (syscall) {
  return 0;
}

fn generate_unique_id[] -> u64 : (pure) {
  return 1;
}

fn generate_audit_token[] -> u64 : (pure) {
  return 0;
}

fn hash_args[args: *MarshaledSyscall] -> u64 : (pure) {
  return 0;
}

fn hash_marshaled_args[args: *MarshaledSyscall] -> u64 : (pure) {
  return 0;
}

fn validate_flags[value: u64, mask: u64] -> bool : (pure) {
  return (value & !mask) == 0;
}

fn create_error_residual[error_code: u64, context: *SyscallErrorContext] -> Residual : (alloc) {
  return Residual(0);
}

fn append_to_residual_chain[chain: *ResidualChain, residual: *SyscallResidual] : (syscall, unsafe) {
}

fn capture_capability_snapshot[] -> CapabilitySnapshot : (syscall, unsafe) {
  return CapabilitySnapshot(0);
}

fn abort[] -> ! : (unsafe) {
  __builtin_trap();
}

//==============================================================================
// External Declarations
//==============================================================================

pub type InternalError = u64;
pub struct CapabilitySnapshot(:u64);
pub struct ErrorDetail(:u64, :u64);
pub struct ResidualChain(last_id: u64);
pub type TypeId = u64;
pub type RegisterFile = phor_abi::RegisterFile;

fn __audit_write[event: *AuditEvent] : effect:(audit) {}
fn __read_cycle_counter[] -> u64 : (syscall) { return 0; }
fn __builtin_trap[] : (unsafe) {}

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_syscall_number_enum[] : effect:(pure) {
  let exit_num: SyscallNumber = SyscallNumber::Exit;
  let exit_val: u64 = exit_num as u64;
  assert(exit_val == 0x00);

  let vm_create: SyscallNumber = SyscallNumber::VMCreate;
  assert(vm_create as u64 == 0x80);
}

@Test
pub fn test_signature_lookup[] : effect:(pure) {
  let sig: SyscallSignature = lookup_syscall_signature(SyscallNumber::Exit);
  assert(sig.num_params == 1);
  assert(sig.required_rights == SYSCALL_RIGHT_BASIC);
  assert(sig.generates_residual == true);
}

@Test
pub fn test_validate_syscall_capability[] : effect:(unsafe) {
  let cap: CapabilitySlot = CapabilitySlot(
    type_tag: CapabilityType(1),
    rights: CapabilityRights(1),
    value: 0x1000,
    generation: 1,
    valid: true,
  );
  let result: Result[(), SyscallError] = validate_syscall_capability(SyscallNumber::Exit, cap);
  // Exit requires SYSCALL_RIGHT_BASIC (bit 0), cap has rights = 1 (bit 0)
  // In a real test, this would be Ok(())
  // assert(result.is_ok());
}

#[inline]
pub fn syscall_error_to_string[err: SyscallError] -> str : (pure) {
  match err {
    SyscallError::Success => "Success",
    SyscallError::InvalidNumber => "Invalid syscall number",
    SyscallError::InvalidArgument => "Invalid argument",
    SyscallError::InvalidCapability => "Invalid capability",
    SyscallError::InsufficientRights => "Insufficient rights",
    SyscallError::BadAddress => "Bad address",
    SyscallError::ResourceExhausted => "Resource exhausted",
    SyscallError::NotFound => "Not found",
    SyscallError::AlreadyExists => "Already exists",
    SyscallError::PermissionDenied => "Permission denied",
    SyscallError::WouldBlock => "Would block",
    SyscallError::Interrupted => "Interrupted",
    SyscallError::NotSupported => "Not supported",
    SyscallError::CapabilityViolation => "Capability violation",
    SyscallError::AffineViolation => "Affine type violation",
    SyscallError::ResidualOverflow => "Residual overflow",
    SyscallError::AuditFailure => "Audit failure",
    _ => "Unknown syscall error",
  }
}
