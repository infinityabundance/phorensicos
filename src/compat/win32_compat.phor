  handle: u32,
  timeout_ms: u32,
  table: *Win32HandleTable,
] -> u32 : effect:(syscall)
  loop: bounded(1)
{
  record_win32_residual(Win32Op::WaitSingle, handle as u64, timeout_ms as u64);
  return 0;  // WAIT_OBJECT_0
}

