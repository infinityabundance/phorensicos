// ============================================================================
// Profile Management Operations
// ============================================================================

/// Create a new profile.
fn profile_create(
    name: Array[u8, 128],
    name_len: u32,
    kind: ProfileKind,
    identity: Identity,
    creator: Identity,
    timestamp: u64,
    generation: u64,
) -> Profile
    effect [compute, residual]
{
    let zero_hash: Hash256 = hash256_zero();
    let history: ResidualHistory = ResidualHistory {
        records: Array[ResidualRecord, 1024]::zeroed(),
        count: 0,
        head: 0,
        tail: 0,
        total_emitted: 0,
        owner_hash: zero_hash,
    };

    residual emit {
        op: "profile.create",
        name_prefix: name[0] as u64,
        kind: kind as u64,
        creator_fp: creator.key_fingerprint.bytes[0] as u64,
    };

    return Profile {
        name: name,
        name_len: name_len,
        version: 1,
        kind: kind,
        identity: identity,
        store_capabilities: ProfileStoreCapabilities {
            can_read_objects: false, can_write_objects: false,
            can_delete_objects: false, can_audit: false,
            can_verify: false, can_configure: false,
            can_enumerate: false, can_promote: false,
            can_pin: false, can_unpin: false,
        },
        package_capabilities: ProfilePackageCapabilities {
            can_create_packages: false, can_sign_packages: false,
            can_verify_packages: false, can_promote_packages: false,
            can_audit_packages: false, can_seal_packages: false,
            can_add_auditor_stamps: false, can_import_packages: false,
            can_export_packages: false,
        },
        generation_capabilities: ProfileGenerationCapabilities {
            can_create_generations: false, can_activate_generations: false,
            can_rollback_generations: false, can_deactivate_generations: false,
            can_describe_generations: false, can_compare_generations: false,
            can_verify_generations: false, can_delete_generations: false,
        },
        profile_capabilities: ProfileProfileCapabilities {
            can_view_own_profile: true, can_modify_own_profile: true,
            can_view_any_profile: false, can_create_profiles: false,
            can_modify_any_profile: false, can_delete_profiles: false,
            can_lock_profiles: false, can_unlock_profiles: false,
        },
        court_capabilities: ProfileCourtCapabilities {
            can_request_replay: false, can_submit_evidence: false,
            can_view_verdicts: false, can_act_as_oracle: false,
            can_act_as_judge: false, can_audit_court: false,
        },
        residual_trust_threshold: TrustLevel::IntegrityVerified,
        package_generation: generation,
        allowed_dialects: Array[DialectProfile, 32]::zeroed(),
        allowed_dialect_count: 0,
        allowed_effects: Array[Array[u8, 64], 32]::zeroed(),
        allowed_effect_lens: Array[u32, 32]::zeroed(),
        allowed_effect_count: 0,
        replay_court_policy: CourtPolicy {
            required_court_name: Array[u8, 64]::zeroed(),
            required_court_name_len: 0,
            min_oracle_comparisons: 1,
            replay_required: true,
            acceptable_divergence: DivergenceLevel::None,
            retain_court_evidence: true,
        },
        default_court: Array[u8, 64]::zeroed(),
        default_court_len: 0,
        can_create_profiles: false,
        can_modify_profiles: false,
        can_delete_profiles: false,
        can_bypass_trust: false,
        active: true,
        locked: false,
        created_at: timestamp,
        modified_at: timestamp,
        created_by: creator,
        modified_by: creator,
        creation_generation: generation,
        ttl_seconds: 0,
        expires_at: 0,
        descriptor_hash: zero_hash,
        signatures: Array[Signature, 16]::zeroed(),
        signature_count: 0,
        profile_residuals: history,
        reserved: Array[u64, 16]::zeroed(),
    };
}

/// Update a profile's capabilities.
fn profile_update_capabilities(
    profile: Profile,
    store_caps: ProfileStoreCapabilities,
    package_caps: ProfilePackageCapabilities,
    gen_caps: ProfileGenerationCapabilities,
    prof_caps: ProfileProfileCapabilities,
    court_caps: ProfileCourtCapabilities,
    modifier: Identity,
    timestamp: u64,
) -> Profile
    effect [compute, residual]
{
    if profile.locked {
        residual emit {
            op: "profile.update.rejected",
            reason: "profile_locked",
        };
        return profile;
    }

    residual emit {
        op: "profile.update.capabilities",
        name_prefix: profile.name[0] as u64,
    };

    return Profile {
        name: profile.name,
        name_len: profile.name_len,
        version: profile.version + 1,
        kind: profile.kind,
        identity: profile.identity,
        store_capabilities: store_caps,
        package_capabilities: package_caps,
        generation_capabilities: gen_caps,
        profile_capabilities: prof_caps,
        court_capabilities: court_caps,
        residual_trust_threshold: profile.residual_trust_threshold,
        package_generation: profile.package_generation,
        allowed_dialects: profile.allowed_dialects,
        allowed_dialect_count: profile.allowed_dialect_count,
        allowed_effects: profile.allowed_effects,
        allowed_effect_lens: profile.allowed_effect_lens,
        allowed_effect_count: profile.allowed_effect_count,
        replay_court_policy: profile.replay_court_policy,
        default_court: profile.default_court,
        default_court_len: profile.default_court_len,
        can_create_profiles: profile.can_create_profiles,
        can_modify_profiles: profile.can_modify_profiles,
        can_delete_profiles: profile.can_delete_profiles,
        can_bypass_trust: profile.can_bypass_trust,
        active: profile.active,
        locked: profile.locked,
        created_at: profile.created_at,
        modified_at: timestamp,
        created_by: profile.created_by,
        modified_by: modifier,
        creation_generation: profile.creation_generation,
        ttl_seconds: profile.ttl_seconds,
        expires_at: profile.expires_at,
        descriptor_hash: profile.descriptor_hash,
        signatures: profile.signatures,
        signature_count: profile.signature_count,
        profile_residuals: profile.profile_residuals,
        reserved: profile.reserved,
    };
}

/// Update the trust threshold for a profile.
fn profile_set_trust_threshold(
    profile: Profile,
    threshold: TrustLevel,
    modifier: Identity,
    timestamp: u64,
) -> Profile
    effect [compute, residual]
{
    if profile.locked {
        return profile;
    }

    residual emit {
        op: "profile.set_trust_threshold",
        name_prefix: profile.name[0] as u64,
        new_threshold: threshold as u64,
    };

    return Profile {
        name: profile.name,
        name_len: profile.name_len,
        version: profile.version + 1,
        kind: profile.kind,
        identity: profile.identity,
        store_capabilities: profile.store_capabilities,
        package_capabilities: profile.package_capabilities,
        generation_capabilities: profile.generation_capabilities,
        profile_capabilities: profile.profile_capabilities,
        court_capabilities: profile.court_capabilities,
        residual_trust_threshold: threshold,
        package_generation: profile.package_generation,
        allowed_dialects: profile.allowed_dialects,
        allowed_dialect_count: profile.allowed_dialect_count,
        allowed_effects: profile.allowed_effects,
        allowed_effect_lens: profile.allowed_effect_lens,
        allowed_effect_count: profile.allowed_effect_count,
        replay_court_policy: profile.replay_court_policy,
        default_court: profile.default_court,
        default_court_len: profile.default_court_len,
        can_create_profiles: profile.can_create_profiles,
        can_modify_profiles: profile.can_modify_profiles,
        can_delete_profiles: profile.can_delete_profiles,
        can_bypass_trust: profile.can_bypass_trust,
        active: profile.active,
        locked: profile.locked,
        created_at: profile.created_at,
        modified_at: timestamp,
        created_by: profile.created_by,
        modified_by: modifier,
        creation_generation: profile.creation_generation,
        ttl_seconds: profile.ttl_seconds,
        expires_at: profile.expires_at,
        descriptor_hash: profile.descriptor_hash,
        signatures: profile.signatures,
        signature_count: profile.signature_count,
        profile_residuals: profile.profile_residuals,
        reserved: profile.reserved,
    };
}

/// Add an allowed dialect to a profile.
fn profile_add_dialect(
    profile: Profile,
    dialect: DialectProfile,
    modifier: Identity,
    timestamp: u64,
) -> Profile
    effect [compute, residual]
{
    if profile.locked {
        return profile;
    }
    if profile.allowed_dialect_count >= 32 {
        return profile;
    }

    let mut new_dialects: Array[DialectProfile, 32] = profile.allowed_dialects;
    new_dialects[profile.allowed_dialect_count] = dialect;

    residual emit {
        op: "profile.add_dialect",
        name_prefix: profile.name[0] as u64,
        dialect_name_prefix: dialect.name[0] as u64,
    };

    return Profile {
        name: profile.name,
        name_len: profile.name_len,
        version: profile.version + 1,
        kind: profile.kind,
        identity: profile.identity,
        store_capabilities: profile.store_capabilities,
        package_capabilities: profile.package_capabilities,
        generation_capabilities: profile.generation_capabilities,
        profile_capabilities: profile.profile_capabilities,
        court_capabilities: profile.court_capabilities,
        residual_trust_threshold: profile.residual_trust_threshold,
        package_generation: profile.package_generation,
        allowed_dialects: new_dialects,
        allowed_dialect_count: profile.allowed_dialect_count + 1,
        allowed_effects: profile.allowed_effects,
        allowed_effect_lens: profile.allowed_effect_lens,
        allowed_effect_count: profile.allowed_effect_count,
        replay_court_policy: profile.replay_court_policy,
        default_court: profile.default_court,
        default_court_len: profile.default_court_len,
        can_create_profiles: profile.can_create_profiles,
        can_modify_profiles: profile.can_modify_profiles,
        can_delete_profiles: profile.can_delete_profiles,
        can_bypass_trust: profile.can_bypass_trust,
        active: profile.active,
        locked: profile.locked,
        created_at: profile.created_at,
        modified_at: timestamp,
        created_by: profile.created_by,
        modified_by: modifier,
        creation_generation: profile.creation_generation,
        ttl_seconds: profile.ttl_seconds,
        expires_at: profile.expires_at,
        descriptor_hash: profile.descriptor_hash,
        signatures: profile.signatures,
        signature_count: profile.signature_count,
        profile_residuals: profile.profile_residuals,
        reserved: profile.reserved,
    };
}

/// Lock a profile — prevents further modifications.
fn profile_lock(
    profile: Profile,
    locker: Identity,
    timestamp: u64,
) -> Profile
    effect [compute, residual]
{
    residual emit {
        op: "profile.lock",
        name_prefix: profile.name[0] as u64,
    };

    return Profile {
        name: profile.name,
        name_len: profile.name_len,
        version: profile.version + 1,
        kind: profile.kind,
        identity: profile.identity,
        store_capabilities: profile.store_capabilities,
        package_capabilities: profile.package_capabilities,
        generation_capabilities: profile.generation_capabilities,
        profile_capabilities: profile.profile_capabilities,
        court_capabilities: profile.court_capabilities,
        residual_trust_threshold: profile.residual_trust_threshold,
        package_generation: profile.package_generation,
        allowed_dialects: profile.allowed_dialects,
        allowed_dialect_count: profile.allowed_dialect_count,
        allowed_effects: profile.allowed_effects,
        allowed_effect_lens: profile.allowed_effect_lens,
        allowed_effect_count: profile.allowed_effect_count,
        replay_court_policy: profile.replay_court_policy,
        default_court: profile.default_court,
        default_court_len: profile.default_court_len,
        can_create_profiles: profile.can_create_profiles,
        can_modify_profiles: profile.can_modify_profiles,
        can_delete_profiles: profile.can_delete_profiles,
        can_bypass_trust: profile.can_bypass_trust,
        active: profile.active,
        locked: true,
        created_at: profile.created_at,
        modified_at: timestamp,
        created_by: profile.created_by,
        modified_by: locker,
        creation_generation: profile.creation_generation,
        ttl_seconds: profile.ttl_seconds,
        expires_at: profile.expires_at,
        descriptor_hash: profile.descriptor_hash,
        signatures: profile.signatures,
        signature_count: profile.signature_count,
        profile_residuals: profile.profile_residuals,
        reserved: profile.reserved,
    };
}

/// Deactivate a profile (soft delete).
fn profile_deactivate(
    profile: Profile,
    deactivator: Identity,
    timestamp: u64,
) -> Profile
    effect [compute, residual]
{
    if profile.locked {
        return profile;
    }

    residual emit {
        op: "profile.deactivate",
        name_prefix: profile.name[0] as u64,
    };

    return Profile {
        name: profile.name,
        name_len: profile.name_len,
        version: profile.version + 1,
        kind: profile.kind,
        identity: profile.identity,
        store_capabilities: profile.store_capabilities,
        package_capabilities: profile.package_capabilities,
        generation_capabilities: profile.generation_capabilities,
        profile_capabilities: profile.profile_capabilities,
        court_capabilities: profile.court_capabilities,
        residual_trust_threshold: profile.residual_trust_threshold,
        package_generation: profile.package_generation,
        allowed_dialects: profile.allowed_dialects,
        allowed_dialect_count: profile.allowed_dialect_count,
        allowed_effects: profile.allowed_effects,
        allowed_effect_lens: profile.allowed_effect_lens,
        allowed_effect_count: profile.allowed_effect_count,
        replay_court_policy: profile.replay_court_policy,
        default_court: profile.default_court,
        default_court_len: profile.default_court_len,
        can_create_profiles: profile.can_create_profiles,
        can_modify_profiles: profile.can_modify_profiles,
        can_delete_profiles: profile.can_delete_profiles,
        can_bypass_trust: profile.can_bypass_trust,
        active: false,
        locked: profile.locked,
        created_at: profile.created_at,
        modified_at: timestamp,
        created_by: profile.created_by,
        modified_by: deactivator,
        creation_generation: profile.creation_generation,
        ttl_seconds: profile.ttl_seconds,
        expires_at: profile.expires_at,
        descriptor_hash: profile.descriptor_hash,
        signatures: profile.signatures,
        signature_count: profile.signature_count,
        profile_residuals: profile.profile_residuals,
        reserved: profile.reserved,
    };
}

// ============================================================================
// Profile Verification
// ============================================================================

/// Verify a profile's consistency and integrity.
fn profile_verify(profile: Profile) -> bool
    effect [compute, residual]
{
    let mut ok: bool = true;

    // Name must be non-empty
    if profile.name_len == 0 {
        ok = false;
    }

    // Identity must be valid
    if !identity_is_valid(profile.identity) {
        ok = false;
    }

    // Version must be >= 1
    if profile.version < 1 {
        ok = false;
    }

    // Active profiles must have a creation timestamp
    if profile.active && profile.created_at == 0 {
        ok = false;
    }

    // Trust threshold must be within valid range
    if profile.residual_trust_threshold > TrustLevel::TrustedNucleus {
        ok = false;
    }

    residual emit {
        op: "profile.verify",
        name_prefix: profile.name[0] as u64,
        valid: ok as u64,
    };

    return ok;
}

// ============================================================================
// Profile Registry
// ============================================================================

/// A bounded registry of profiles (max 256).
struct ProfileRegistry
    layout packed
{
    profiles: Array[Profile, 256],
    count: u32,
}

/// Create an empty profile registry.
fn profile_registry_new() -> ProfileRegistry
    effect [compute]
{
    return ProfileRegistry {
        profiles: Array[Profile, 256]::zeroed(),
        count: 0,
    };
}

/// Add a profile to the registry.
fn profile_registry_add(
    registry: ProfileRegistry,
    profile: Profile,
) -> ProfileRegistry
    effect [compute, residual]
{
    if registry.count >= 256 {
        residual emit {
            op: "profile_registry.full",
            count: registry.count,
        };
        return registry;
    }

    let mut new_reg: ProfileRegistry = registry;
    new_reg.profiles[registry.count] = profile;
    new_reg.count = registry.count + 1;

    residual emit {
        op: "profile_registry.add",
        name_prefix: profile.name[0] as u64,
    };

    return new_reg;
}

/// Find a profile by name.
fn profile_registry_find_by_name(
    registry: ProfileRegistry,
    name: Array[u8, 128],
    name_len: u32,
) -> Result[Profile, u32]
    effect [compute]
{
    for i in 0..registry.count as u64 {
        let p: Profile = registry.profiles[i];
        if p.name_len == name_len {
            let mut match_name: bool = true;
            for j in 0..name_len as u64 {
                if p.name[j] != name[j] {
                    match_name = false;
                }
            }
            if match_name {
                return Result[Profile, u32]::Ok(p);
            }
        }
    }
    return Result[Profile, u32]::Err(0);
}

/// Find a profile by identity key fingerprint.
fn profile_registry_find_by_key(
    registry: ProfileRegistry,
    key_fingerprint: Hash256,
) -> Result[Profile, u32]
    effect [compute]
{
    for i in 0..registry.count as u64 {
        let p: Profile = registry.profiles[i];
        if hash256_equal(p.identity.key_fingerprint, key_fingerprint) {
            return Result[Profile, u32]::Ok(p);
        }
    }
    return Result[Profile, u32]::Err(0);
}

/// Check if a profile is allowed to use a specific dialect.
fn profile_allows_dialect(
    profile: Profile,
    dialect_name: Array[u8, 64],
    dialect_name_len: u32,
) -> bool
    effect [compute]
{
    // Empty dialect list means all dialects allowed
    if profile.allowed_dialect_count == 0 {
        return true;
    }
    for i in 0..profile.allowed_dialect_count as u64 {
        let d: DialectProfile = profile.allowed_dialects[i];
        if d.name_len == dialect_name_len {
            let mut match_name: bool = true;
            for j in 0..dialect_name_len as u64 {
                if d.name[j] != dialect_name[j] {
                    match_name = false;
                }
            }
            if match_name {
                return true;
            }
        }
    }
    return false;
}

/// Check if a profile is allowed to use a specific effect.
fn profile_allows_effect(
    profile: Profile,
    effect_name: Array[u8, 64],
    effect_name_len: u32,
) -> bool
    effect [compute]
{
    if profile.allowed_effect_count == 0 {
        return true;
    }
    for i in 0..profile.allowed_effect_count as u64 {
        let e: Array[u8, 64] = profile.allowed_effects[i];
        let el: u32 = profile.allowed_effect_lens[i];
        if el == effect_name_len {
            let mut match_name: bool = true;
            for j in 0..effect_name_len as u64 {
                if e[j] != effect_name[j] {
                    match_name = false;
                }
            }
            if match_name {
                return true;
            }
        }
    }
    return false;
}
