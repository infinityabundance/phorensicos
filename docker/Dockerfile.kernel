# phorensicos — kernel image
#
# Builds the no_std Multiboot kernel, boots it in QEMU (headless), captures the
# boot evidence, and verifies it. QEMU runs inside this minimal container, so a
# full build+boot+verify cycle is one `docker compose` command.
#
#   docker compose run --rm kernel
#
FROM rust:1.98.0-slim-bookworm

# nasm: assemble the 32-bit entry stub.
# lld + binutils: link the flat Multiboot image (ld.lld, objcopy).
# qemu-system-x86: boot the image and capture framebuffer evidence.
# python3 + jq: evidence verifier + manifest comparison.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential ca-certificates \
        nasm lld binutils qemu-system-x86 python3 jq \
 && rm -rf /var/lib/apt/lists/*

# The kernel staticlib is cross-compiled for the bare-metal target.
RUN rustup target add x86_64-unknown-none

WORKDIR /work

COPY . .

# Warm the dependency graph so the build needs no registry access at run time.
RUN cargo fetch --locked || cargo fetch

CMD ["bash", "-c", "./scripts/ci_kernel.sh"]
