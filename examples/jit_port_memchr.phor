// jit_port_memchr.phor — third JIT-Porting Court target (native candidate)
//
// Clean-room native port of libc `memchr` at the search boundary. `memchr`
// returns a *pointer* to the first match, or NULL; a pointer value is not
// portable behavior, so the court normalizes the observable to the **index** of
// the first matching byte (`0..n-1`), or `-1` when the byte is absent. That is
// the actual C contract (`result - s`), and it is what a native caller needs.
//
// This file is the *candidate source* bound into the sealed package
// (phost/evidence/porting/memchr/sealed_package.json: candidate_source_hash).
//
// The haystack is modelled as up to 8 bytes packed LITTLE-ENDIAN into a u64 (byte
// i occupies bits 8*i, i.e. the machine word you get by loading the buffer on
// x86-64); the deterministic corpus never searches more than 8 bytes.
//
// ABI — the executed entry point (see phost::porting::exec):
//   symbol `_phor_phor_memchr_index`; SysV AMD64 (RDI, RSI, RDX) -> RAX, i.e.
//   `phor_memchr_index(wh: u64, needle: u64, n: u64) -> u64`.
//   The result is an i64 index (`-1` when absent).
//   The function is a leaf: no calls, no relocations, no heap, no syscalls.
//
// The lowerer emits a single basic block (no branches), so the scan is written
// branchlessly: iterate the indices from the highest down, and let the last
// assignment win — that yields the *smallest* matching index, i.e. the first
// match. `hit` is 1 only when the byte equals the needle AND its index is
// within the searched length.
//
// Scope: API-surface JIT-porting. NOT arbitrary binary translation. The cage
// observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_memchr:v1.0";

// ── Domain constants ─────────────────────────────────────

const WIDTH: u64 = 8;         // bytes packed per haystack word
const BYTE_MASK: u64 = 255;   // the needle is a single byte
const NOT_FOUND: u64 = 0 - 1; // -1, all bits set

// ── Target and evidence records ──────────────────────────
// These mirror the residuals the court seals for this target.

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    input_schema: Str(64),
    output_schema: Str(64),
}

struct ReplayVerdict {
    target: Str(32),
    cases_run: u64,
    cases_passed: u64,
    cases_failed: u64,
    verdict: u8,
}

struct SealedPackage {
    target: Str(32),
    dialect_name: Str(16),
    trust_level: u8,
    case_count: u64,
    oracle_hash: Str(64),
    candidate_hash: Str(64),
}

// ── Native clean-room candidate ──────────────────────────
//
// Branchless and leaf. Byte i of the little-endian word is `(wh >> (8*i)) & 255`.
// Scanning i = 7 → 0 and overwriting on a hit leaves the smallest matching index.
// `idx - hit * (idx - i)` is a branchless select: unchanged when hit is 0,
// exactly `i` when hit is 1.

fn phor_memchr_index(wh: u64, needle: u64, n: u64) -> u64
    effect [compute]
{
    let c: u64 = needle & BYTE_MASK;
    let mut idx: u64 = NOT_FOUND;

    let b7: u64 = (wh >> 56) & BYTE_MASK;
    let hit7: u64 = ((b7 == c) as u64) * ((n > 7) as u64);
    idx = idx - hit7 * (idx - 7);

    let b6: u64 = (wh >> 48) & BYTE_MASK;
    let hit6: u64 = ((b6 == c) as u64) * ((n > 6) as u64);
    idx = idx - hit6 * (idx - 6);

    let b5: u64 = (wh >> 40) & BYTE_MASK;
    let hit5: u64 = ((b5 == c) as u64) * ((n > 5) as u64);
    idx = idx - hit5 * (idx - 5);

    let b4: u64 = (wh >> 32) & BYTE_MASK;
    let hit4: u64 = ((b4 == c) as u64) * ((n > 4) as u64);
    idx = idx - hit4 * (idx - 4);

    let b3: u64 = (wh >> 24) & BYTE_MASK;
    let hit3: u64 = ((b3 == c) as u64) * ((n > 3) as u64);
    idx = idx - hit3 * (idx - 3);

    let b2: u64 = (wh >> 16) & BYTE_MASK;
    let hit2: u64 = ((b2 == c) as u64) * ((n > 2) as u64);
    idx = idx - hit2 * (idx - 2);

    let b1: u64 = (wh >> 8) & BYTE_MASK;
    let hit1: u64 = ((b1 == c) as u64) * ((n > 1) as u64);
    idx = idx - hit1 * (idx - 1);

    let b0: u64 = wh & BYTE_MASK;
    let hit0: u64 = ((b0 == c) as u64) * ((n > 0) as u64);
    idx = idx - hit0 * (idx - 0);

    return idx;
}
