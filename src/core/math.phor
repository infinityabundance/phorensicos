pub fn u16_to_u32(v: u16) -> u32
    effects: [deterministic]
{ v as u32 }

// Convert u16 to u64 with guaranteed success.
pub fn u16_to_u64(v: u16) -> u64
    effects: [deterministic]
{ v as u64 }

