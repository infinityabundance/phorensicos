// gpu.phor — GPU initialization and basic 2D acceleration
// MMIO register discovery, framebuffer BAR mapping, display controller init,
// mode setting (VESA/EDID), solid fill, blit, CPU reference path, court-verifiable regs
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/gpu.phor
// Court: gpu_driver:v2

package drivers.gpu;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type GpuError = enum {
    GpuNotInitialized         = 0x700,  // E0700: GPU driver not initialized
    GpuDeviceNotFound         = 0x701,  // E0701: GPU device not found
    GpuMmioNotMapped          = 0x702,  // E0702: MMIO registers not mapped
    GpuFramebufferNotMapped   = 0x703,  // E0703: framebuffer not mapped
    GpuInvalidMode            = 0x704,  // E0704: invalid display mode
    GpuModeSetFailed          = 0x705,  // E0705: mode set failed
    GpuDisplayNotFound        = 0x706,  // E0706: no display connected
    GpuCapabilityError        = 0x707,  // E0707: insufficient capability
    GpuBlitUnsupported        = 0x708,  // E0708: blit not supported
    GpuSolidFillUnsupported   = 0x709,  // E0709: solid fill not supported
    GpuEdidInvalid            = 0x70A,  // E070A: EDID data invalid
    GpuVesaBiosFailed         = 0x70B,  // E070B: VESA BIOS call failed
    GpuRegisterInvalid        = 0x70C,  // E070C: invalid register offset
    GpuCrtcNotFound           = 0x70D,  // E070D: CRTC not found
    GpuEncoderNotFound        = 0x70E,  // E070E: encoder not found
    GpuConnectorNotFound      = 0x70F,  // E070F: connector not found
    GpuNoAvailableFb          = 0x710,  // E0710: no framebuffer available
    GpuDmaBufError            = 0x711,  // E0711: DMA buffer error
    GpuTimeout                = 0x712,  // E0712: GPU operation timeout
    GpuVerificationFailed     = 0x713,  // E0713: court verification check failed
    GpuCpuPathRequired        = 0x714,  // E0714: CPU reference path is required
    GpuRegisterAccessError    = 0x715,  // E0715: register access denied
}

// ─────────────────────────────────────────────────────────────
// GPU Vendor Types
// ─────────────────────────────────────────────────────────────

type GpuVendor = enum {
    Unknown        = 0,
    Intel          = 1,
    Amd            = 2,
    Nvidia         = 3,
    Vmware         = 4,
    Virtio         = 5,
    Bochs          = 6,
    Qemu           = 7,
    Simulator      = 8,
}

// ─────────────────────────────────────────────────────────────
// GPU Architecture Generation
// ─────────────────────────────────────────────────────────────

type GpuArch = enum {
    UnknownArch         = 0,
    LegacyVga           = 1,  // VGA-compatible
    IntelGen4           = 2,  // Intel GMA
    IntelGen6           = 3,  // Sandy/Ivy Bridge
    IntelGen7           = 4,  // Haswell/Broadwell
    IntelGen8           = 5,  // Skylake/Kaby Lake
    IntelGen9           = 6,  // Ice/Tiger Lake
    IntelGen12          = 7,  // Alder/Raptor Lake
    AmdTeraScale        = 8,
    AmdGcn              = 9,
    AmdRdna             = 10,
    AmdRdna2            = 11,
    NvidiaTesla         = 12,
    NvidiaFermi         = 13,
    NvidiaKepler        = 14,
    NvidiaMaxwell       = 15,
    NvidiaPascal        = 16,
    NvidiaTuring        = 17,
    NvidiaAmpere        = 18,
    VmwareSvga2         = 19,
    VirtioGpu           = 20,
    BochsDispi          = 21,
    SimpleFramebuffer   = 22,
}

// ─────────────────────────────────────────────────────────────
// Display Connector Types
// ─────────────────────────────────────────────────────────────

type ConnectorType = enum {
    UnknownConnector   = 0,
    Vga                = 1,
    Dvi                = 2,
    Hdmi               = 3,
    DisplayPort        = 4,
    Edp                = 5,  // Embedded DisplayPort
    Lvds               = 6,
    Dsi                = 7,
    UsbC               = 8,
    VirtualConnector   = 9,
}

// ─────────────────────────────────────────────────────────────
// GPU MMIO Register Range
// ─────────────────────────────────────────────────────────────

struct GpuRegisterRange {
    bar_index: u8,
    phys_base: u64,
    virt_base: u64,
    size: u64,
    is_mmio: bool,
    is_framebuffer: bool,
}

// ─────────────────────────────────────────────────────────────
// Display Mode (extended)
// ─────────────────────────────────────────────────────────────

struct GpuDisplayMode {
    width: u64,
    height: u64,
    pitch: u64,
    format: GpuPixelFormat,
    bpp: u8,
    refresh_rate_hz: u64,
    clock_hz: u64,
    h_front_porch: u16,
    h_sync: u16,
    h_back_porch: u16,
    v_front_porch: u16,
    v_sync: u16,
    v_back_porch: u16,
    h_polarity: bool,
    v_polarity: bool,
    interlaced: bool,
    preferred: bool,
    edid_detailed: bool,
}

type GpuPixelFormat = enum {
    UnknownFormat    = 0,
    Rgb565           = 1,
    Xrgb8888         = 2,
    Argb8888         = 3,
    Rgb888           = 4,
    Bgr565           = 5,
    Xbgr8888         = 6,
    Abgr8888         = 7,
    Yuv420           = 8,
    Nv12             = 9,
    Monochrome8      = 10,
}

// ─────────────────────────────────────────────────────────────
// EDID (Extended Display Identification Data)
// ─────────────────────────────────────────────────────────────

struct EdidData {
    raw_data: Array(u8, 256),
    data_length: u64,
    valid: bool,
    manufacturer_id: [u8; 2],
    product_code: u16,
    serial_number: u32,
    week_of_manufacture: u8,
    year_of_manufacture: u16,
    edid_version: u8,
    edid_revision: u8,
    basic_params: u8,
    chroma_info: Array(u8, 10),
    established_timings: Array(u8, 3),
    standard_timings: Array(u16, 8),
    detailed_modes: Array(EdidDetailedTiming, 4),
    monitor_name: String(32),
    serial_string: String(32),
    preferred_mode_index: u64,
    max_h_size_cm: u8,
    max_v_size_cm: u8,
    gamma: u8,
    features: u8,
}

struct EdidDetailedTiming {
    pixel_clock_10khz: u16,
    h_active: u16,
    h_blank: u16,
    v_active: u16,
    v_blank: u16,
    h_sync_offset: u16,
    h_sync_pulse: u16,
    v_sync_offset: u8,
    v_sync_pulse: u8,
    h_image_size_mm: u16,
    v_image_size_mm: u16,
    h_border: u16,
    v_border: u16,
    flags: u8,
    refresh_rate_hz: u64,
}

// ─────────────────────────────────────────────────────────────
// Display Pipeline Components
// ─────────────────────────────────────────────────────────────

struct GpuCrtc {
    crtc_index: u8,
    enabled: bool,
    current_mode: GpuDisplayMode,
    fb_address: u64,
    fb_stride: u64,
    gamma_lut: Array(u16, 256 * 3),
    cursor_x: u16,
    cursor_y: u16,
    cursor_enabled: bool,
    interrupt_enabled: bool,
    vblank_count: u64,
    mmio_crtc_offset: u64,
}

struct GpuEncoder {
    encoder_index: u8,
    encoder_type: u32,
    crtc_mask: u8,
    possible_crtcs: u8,
    enabled: bool,
    active_crtc: u8,
    mmio_encoder_offset: u64,
}

struct GpuConnector {
    connector_index: u8,
    connector_type: ConnectorType,
    encoder_index: u8,
    edid: EdidData,
    modes: Array(GpuDisplayMode, 32),
    mode_count: u64,
    connected: bool,
    preferred_mode: u64,
    mmio_connector_offset: u64,
}

// ─────────────────────────────────────────────────────────────
// GPU Controller State
// ─────────────────────────────────────────────────────────────

struct GpuController {
    controller_identity: Identity,
    vendor: GpuVendor,
    arch: GpuArch,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    register_ranges: Array(GpuRegisterRange, 8),
    range_count: u64,
    fb_bar_index: u8,
    fb_phys_base: u64,
    fb_virt_base: u64,
    fb_size: u64,
    mmio_bar_index: u8,
    mmio_phys_base: u64,
    mmio_virt_base: u64,
    mmio_size: u64,
    crtcs: Array(GpuCrtc, 4),
    crtc_count: u64,
    encoders: Array(GpuEncoder, 4),
    encoder_count: u64,
    connectors: Array(GpuConnector, 4),
    connector_count: u64,
    active_connector: u64,
    initialized: bool,
    display_detected: bool,
    dma_buf_base: u64,
    dma_buf_size: u64,
    host_visible_size: u64,
    generation: u64,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
}

// ─────────────────────────────────────────────────────────────
// GPU Driver State
// ─────────────────────────────────────────────────────────────

struct GpuDriverState {
    driver_identity: Identity,
    controllers: Array(GpuController, 4),
    controller_count: u64,
    active_controller: u64,
    default_mode: GpuDisplayMode,
    initialized: bool,
    initialization_timestamp: u64,
    total_present_count: u64,
    total_fill_ops: u64,
    total_blit_ops: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

struct GpuCapability {
    object_id: Identity,
    generation: u64,
    can_set_mode: bool,
    can_write_fb: bool,
    can_accelerate: bool,
    can_dma: bool,
    can_edid: bool,
    max_width: u64,
    max_height: u64,
    supported_formats: u64,
    verify_cpu_path: bool,
}

// ─────────────────────────────────────────────────────────────
// MMIO Register Read/Write (CPU Reference Path)
// ─────────────────────────────────────────────────────────────

fn gpu_mmio_read32(
    controller: Handle(GpuController),
    offset: u64,
) -> Result(u32, GpuError)
    effect [memory:mmio, deterministic]
    court "gpu_mmio_read32:v1"
{
    if controller.mmio_virt_base == 0 {
        return Result::Err(GpuError::GpuMmioNotMapped);
    };

    if offset >= controller.mmio_size {
        return Result::Err(GpuError::GpuRegisterInvalid);
    };

    return Result::Ok(trusted reason "GPU MMIO register read at verified offset, vendor GPU spec §2.3" {
        let ptr: *(u32) = (controller.mmio_virt_base + offset) as *(u32);
        return *ptr;
    });
}

fn gpu_mmio_write32(
    controller: Handle(GpuController),
    offset: u64,
    value: u32,
) -> Result(void, GpuError)
    effect [memory:mmio, deterministic]
    court "gpu_mmio_write32:v1"
{
    if controller.mmio_virt_base == 0 {
        return Result::Err(GpuError::GpuMmioNotMapped);
    };

    if offset >= controller.mmio_size {
        return Result::Err(GpuError::GpuRegisterInvalid);
    };

    trusted reason "GPU MMIO register write at verified offset, vendor GPU spec §2.3" {
        let ptr: *(u32) = (controller.mmio_virt_base + offset) as *(u32);
        *ptr = value;
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Register Programming Record (Court-Verifiable)
// ─────────────────────────────────────────────────────────────

struct GpuRegisterWrite {
    offset: u64,
    value: u32,
    mask: u32,
    timestamp: u64,
    reason: String(64),
    verified: bool,
}

struct GpuRegisterJournal {
    writes: Array(GpuRegisterWrite, 256),
    write_count: u64,
    court_signature: u64,
    integrity_hash: u64,
}

fn gpu_journal_register_write(
    journal: Handle(GpuRegisterJournal),
    offset: u64,
    value: u32,
    mask: u32,
    reason: String(64),
    timestamp: u64,
) -> void
    effect [deterministic]
    court "gpu_journal_write:v1"
{
    if journal.write_count >= 256 {
        return;
    };

    let entry: GpuRegisterWrite = GpuRegisterWrite {
        offset: offset,
        value: value,
        mask: mask,
        timestamp: timestamp,
        reason: reason,
        verified: false,
    };

    journal.writes[journal.write_count] = entry;
    journal.write_count = journal.write_count + 1;

    // Update integrity hash
    journal.integrity_hash = journal.integrity_hash ^ (offset * 31 + value as u64);
}

// ─────────────────────────────────────────────────────────────
// Parse EDID Block
// ─────────────────────────────────────────────────────────────

fn gpu_parse_edid(
    raw: Array(u8, 256),
    length: u64,
) -> EdidData
    effect [deterministic]
    court "gpu_parse_edid:v1"
{
    let mut edid: EdidData = EdidData {
        raw_data: raw,
        data_length: length,
        valid: false,
        manufacturer_id: [0; 2],
        product_code: 0,
        serial_number: 0,
        week_of_manufacture: 0,
        year_of_manufacture: 0,
        edid_version: 0,
        edid_revision: 0,
        basic_params: 0,
        chroma_info: Array::zeroed(),
        established_timings: Array::zeroed(),
        standard_timings: Array::zeroed(),
        detailed_modes: Array::zeroed(),
        monitor_name: String::new(),
        serial_string: String::new(),
        preferred_mode_index: 0,
        max_h_size_cm: 0,
        max_v_size_cm: 0,
        gamma: 0,
        features: 0,
    };

    if length < 128 {
        return edid;
    };

    // Check EDID header: 00 FF FF FF FF FF FF 00
    if raw[0] != 0x00 || raw[1] != 0xFF || raw[2] != 0xFF
        || raw[3] != 0xFF || raw[4] != 0xFF || raw[5] != 0xFF
        || raw[6] != 0xFF || raw[7] != 0x00
    {
        return edid;
    };

    // EDID checksum (byte 127)
    let mut checksum: u8 = 0;
    for i in 0..128 {
        checksum = checksum + raw[i];
    };
    if checksum != 0 {
        return edid;
    };

    edid.valid = true;
    edid.manufacturer_id[0] = ((raw[0x08] >> 2) & 0x1F) + 0x40;
    edid.manufacturer_id[1] = ((raw[0x08] & 0x03) << 3 | (raw[0x09] >> 5) & 0x07) + 0x40;
    edid.product_code = (raw[0x0B] as u16) << 8 | raw[0x0A] as u16;
    edid.serial_number = (raw[0x0F] as u32) << 24 | (raw[0x0E] as u32) << 16
                        | (raw[0x0D] as u32) << 8 | raw[0x0C] as u32;
    edid.week_of_manufacture = raw[0x10];
    edid.year_of_manufacture = 1990 + raw[0x11] as u16;
    edid.edid_version = raw[0x12];
    edid.edid_revision = raw[0x13];
    edid.basic_params = raw[0x14];
    edid.max_h_size_cm = raw[0x15];
    edid.max_v_size_cm = raw[0x16];
    edid.gamma = raw[0x17];
    edid.features = raw[0x18];

    // Chromaticity data at bytes 0x19-0x22
    for i in 0..10 {
        if i < 10 {
            edid.chroma_info[i] = raw[0x19 + i];
        };
    };

    // Established timings at bytes 0x23-0x25
    for i in 0..3 {
        edid.established_timings[i] = raw[0x23 + i];
    };

    // Standard timings at bytes 0x26-0x35 (2 bytes each)
    for i in 0..8 {
        let idx: u64 = 0x26 + i * 2;
        edid.standard_timings[i] = (raw[idx] as u16) << 8 | raw[idx + 1] as u16;
    };

    // Detailed timings at bytes 0x36-0x47, 0x48-0x59, 0x5A-0x6B, 0x6C-0x7D
    let dt_starts: Array(u64, 4) = Array(u64, 4) { data: [0x36, 0x48, 0x5A, 0x6C] };
    for dt_idx in 0..4 {
        let start: u64 = dt_starts[dt_idx];
        let pixel_clock: u16 = (raw[start + 1] as u16) << 8 | raw[start] as u16;

        if pixel_clock == 0 {
            // Monitor descriptor block (not a timing descriptor)
            let tag: u8 = raw[start + 3];
            let desc_type: u8 = raw[start + 3];
            if desc_type == 0xFC {
                // Monitor name
                let name_start: u64 = start + 5;
                let mut name_buf: Array(u8, 32) = Array::zeroed();
                for j in 0..13 {
                    name_buf[j] = raw[name_start + j];
                };
                edid.monitor_name = String::from_bytes(Slice(u8)::from_ptr(&name_buf));
            } else if desc_type == 0xFF {
                // Serial string
                let ser_start: u64 = start + 5;
                let mut ser_buf: Array(u8, 32) = Array::zeroed();
                for j in 0..13 {
                    ser_buf[j] = raw[ser_start + j];
                };
                edid.serial_string = String::from_bytes(Slice(u8)::from_ptr(&ser_buf));
            };
            continue;
        };

        let h_active: u16 = ((raw[start + 4] as u16) & 0xF0) << 4 | raw[start + 2] as u16;
        let h_blank: u16 = ((raw[start + 5] as u16) & 0xF0) << 4 | raw[start + 3] as u16;
        let v_active: u16 = ((raw[start + 7] as u16) & 0xF0) << 4 | raw[start + 5] as u16;
        let v_blank: u16 = ((raw[start + 9] as u16) & 0xF0) << 4 | raw[start + 6] as u16;
        let h_sync_offset: u16 = ((raw[start + 11] as u16) & 0xC0) << 2 | raw[start + 8] as u16;
        let h_sync_pulse: u16 = ((raw[start + 11] as u16) & 0x30) << 4 | raw[start + 9] as u16;
        let v_sync_offset: u8 = ((raw[start + 11] as u8) >> 4) & 0x0F;
        let v_sync_pulse: u8 = (raw[start + 11] as u8) & 0x0F;
        let h_image_size: u16 = ((raw[start + 14] as u16) & 0xF0) << 4 | raw[start + 12] as u16;
        let v_image_size: u16 = ((raw[start + 15] as u16) & 0xF0) << 4 | raw[start + 13] as u16;
        let h_border: u16 = raw[start + 15] as u16;
        let v_border: u16 = raw[start + 16] as u16;
        let flags: u8 = raw[start + 17];

        // Calculate refresh rate from pixel clock
        let total_h: u64 = h_active as u64 + h_blank as u64;
        let total_v: u64 = v_active as u64 + v_blank as u64;
        let refresh_hz: u64 = if total_h > 0 && total_v > 0 {
            (pixel_clock as u64 * 10000) / (total_h * total_v)
        } else { 60 };

        let timing: EdidDetailedTiming = EdidDetailedTiming {
            pixel_clock_10khz: pixel_clock,
            h_active: h_active,
            h_blank: h_blank,
            v_active: v_active,
            v_blank: v_blank,
            h_sync_offset: h_sync_offset,
            h_sync_pulse: h_sync_pulse,
            v_sync_offset: v_sync_offset as u8,
            v_sync_pulse: v_sync_pulse,
            h_image_size_mm: h_image_size,
            v_image_size_mm: v_image_size,
            h_border: h_border,
            v_border: v_border,
            flags: flags,
            refresh_rate_hz: refresh_hz,
        };

        edid.detailed_modes[dt_idx] = timing;
        if dt_idx == 0 {
            edid.preferred_mode_index = 0;
        };
    };

    return edid;
}

// ─────────────────────────────────────────────────────────────
// Convert EDID Detailed Timing to Display Mode
// ─────────────────────────────────────────────────────────────

fn gpu_edid_timing_to_mode(
    timing: EdidDetailedTiming,
    format: GpuPixelFormat,
    bpp: u8,
) -> GpuDisplayMode
    effect [deterministic]
    court "gpu_edid_to_mode:v1"
{
    return GpuDisplayMode {
        width: timing.h_active as u64,
        height: timing.v_active as u64,
        pitch: timing.h_active as u64 * (bpp as u64 / 8),
        format: format,
        bpp: bpp,
        refresh_rate_hz: timing.refresh_rate_hz,
        clock_hz: (timing.pixel_clock_10khz as u64) * 10000,
        h_front_porch: 0, h_sync: timing.h_sync_pulse, h_back_porch: 0,
        v_front_porch: 0, v_sync: timing.v_sync_pulse, v_back_porch: 0,
        h_polarity: (timing.flags & 0x02) != 0,
        v_polarity: (timing.flags & 0x04) != 0,
        interlaced: (timing.flags & 0x80) != 0,
        preferred: false,
        edid_detailed: true,
    };
}

// ─────────────────────────────────────────────────────────────
// Discover GPU MMIO and Framebuffer BARs
// ─────────────────────────────────────────────────────────────

fn gpu_discover_bars(
    controller: Handle(GpuController),
    bar0_addr: u64,
    bar0_size: u64,
    bar1_addr: u64,
    bar1_size: u64,
    bar2_addr: u64,
    bar2_size: u64,
    bar_type0: u8,
    bar_type1: u8,
    bar_type2: u8,
    timestamp: u64,
) -> Result(void, GpuError)
    effect [deterministic, residual]
    court "gpu_discover_bars:v1"
{
    let mut range_cnt: u64 = 0;
    let bars: Array(u64, 6) = Array(u64, 6) {
        data: [bar0_addr, bar0_size, bar1_addr, bar1_size, bar2_addr, bar2_size],
    };
    let bar_types: Array(u8, 3) = Array(u8, 3) {
        data: [bar_type0, bar_type1, bar_type2],
    };

    for i in 0..3 {
        if range_cnt >= 8 { break; };
        let addr: u64 = bars[i * 2];
        let size: u64 = bars[i * 2 + 1];
        let btype: u8 = bar_types[i];

        if addr == 0 || size == 0 {
            continue;
        };

        let is_fb: bool = (btype & 0x01) == 0;  // 0=memory, 1=I/O (for PCI BARs)
        let is_64: bool = (btype & 0x02) != 0;

        let range: GpuRegisterRange = GpuRegisterRange {
            bar_index: i as u8,
            phys_base: addr,
            virt_base: addr,  // Identity mapping for early boot
            size: size,
            is_mmio: !is_fb,
            is_framebuffer: is_fb,
        };

        controller.register_ranges[range_cnt] = range;
        range_cnt = range_cnt + 1;

        if is_fb {
            controller.fb_bar_index = i as u8;
            controller.fb_phys_base = addr;
            controller.fb_virt_base = addr;
            controller.fb_size = size;
        } else {
            controller.mmio_bar_index = i as u8;
            controller.mmio_phys_base = addr;
            controller.mmio_virt_base = addr;
            controller.mmio_size = size;
        };
    };

    controller.range_count = range_cnt;

    residual emit {
        op: "gpu.discover_bars",
        mmio_base: controller.mmio_phys_base,
        mmio_size: controller.mmio_size,
        fb_base: controller.fb_phys_base,
        fb_size: controller.fb_size,
        ranges: range_cnt,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// VESA BIOS Mode Info (simulated)
// ─────────────────────────────────────────────────────────────

struct VesaModeInfo {
    mode_attributes: u16,
    width: u16,
    height: u16,
    pitch: u16,
    bpp: u8,
    memory_model: u8,
    phys_base: u32,
    phys_base_hi: u32,
}

fn gpu_vesa_get_mode_info(mode: u16) -> VesaModeInfo
    effect [deterministic]
    court "gpu_vesa_mode_info:v1"
{
    // Simulated VESA mode info - in real driver uses INT 0x10
    let info: VesaModeInfo = VesaModeInfo {
        mode_attributes: 0x00BB,
        width: 1024,
        height: 768,
        pitch: 4096,
        bpp: 32,
        memory_model: 6,  // Direct Color
        phys_base: 0xE0000000,
        phys_base_hi: 0,
    };
    return info;
}

// ─────────────────────────────────────────────────────────────
// GPU Controller Initialization
// ─────────────────────────────────────────────────────────────

fn gpu_controller_init(
    controller: Handle(GpuController),
    gpu_cap: GpuCapability,
    journal: Handle(GpuRegisterJournal),
    timestamp: u64,
) -> Result(void, GpuError)
    effect [memory:mmio, deterministic, residual]
    court "gpu_controller_init:v2"
{
    if controller.mmio_virt_base == 0 {
        return Result::Err(GpuError::GpuMmioNotMapped);
    };

    if !gpu_cap.can_set_mode {
        return Result::Err(GpuError::GpuCapabilityError);
    };

    // Read vendor-specific identification registers
    let vendor_id_result: Result(u32, GpuError) = gpu_mmio_read32(controller, 0x00);
    let device_id_result: Result(u32, GpuError) = gpu_mmio_read32(controller, 0x04);

    let _ = vendor_id_result;
    let _ = device_id_result;

    // Journal the register read
    if gpu_cap.verify_cpu_path {
        gpu_journal_register_write(journal, 0x00, 0, 0xFFFFFFFF,
            String::from_bytes(Slice(u8)::from_str("Vendor ID register")), timestamp);
        gpu_journal_register_write(journal, 0x04, 0, 0xFFFFFFFF,
            String::from_bytes(Slice(u8)::from_str("Device ID register")), timestamp);
    };

    // Initialize CRTC 0 with default state
    let crtc0: GpuCrtc = GpuCrtc {
        crtc_index: 0, enabled: false,
        current_mode: GpuDisplayMode {
            width: 0, height: 0, pitch: 0, format: GpuPixelFormat::UnknownFormat,
            bpp: 0, refresh_rate_hz: 0, clock_hz: 0,
            h_front_porch: 0, h_sync: 0, h_back_porch: 0,
            v_front_porch: 0, v_sync: 0, v_back_porch: 0,
            h_polarity: false, v_polarity: false,
            interlaced: false, preferred: false, edid_detailed: false,
        },
        fb_address: 0, fb_stride: 0,
        gamma_lut: Array::zeroed(),
        cursor_x: 0, cursor_y: 0, cursor_enabled: false,
        interrupt_enabled: false, vblank_count: 0,
        mmio_crtc_offset: 0x1000,  // Typical CRTC offset
    };

    controller.crtcs[0] = crtc0;
    controller.crtc_count = 1;

    // Initialize headless encoder
    let encoder0: GpuEncoder = GpuEncoder {
        encoder_index: 0, encoder_type: 0,
        crtc_mask: 0x01, possible_crtcs: 0x01,
        enabled: false, active_crtc: 0,
        mmio_encoder_offset: 0x2000,
    };
    controller.encoders[0] = encoder0;
    controller.encoder_count = 1;

    // Initialize connector placeholder
    let connector0: GpuConnector = GpuConnector {
        connector_index: 0, connector_type: ConnectorType::VirtualConnector,
        encoder_index: 0,
        edid: EdidData {
            raw_data: Array::zeroed(), data_length: 0, valid: false,
            manufacturer_id: [0;2], product_code: 0, serial_number: 0,
            week_of_manufacture: 0, year_of_manufacture: 0,
            edid_version: 0, edid_revision: 0, basic_params: 0,
            chroma_info: Array::zeroed(), established_timings: Array::zeroed(),
            standard_timings: Array::zeroed(), detailed_modes: Array::zeroed(),
            monitor_name: String::new(), serial_string: String::new(),
            preferred_mode_index: 0, max_h_size_cm: 0, max_v_size_cm: 0,
            gamma: 0, features: 0,
        },
        modes: Array::zeroed(), mode_count: 0,
        connected: false, preferred_mode: 0,
        mmio_connector_offset: 0x3000,
    };
    controller.connectors[0] = connector0;
    controller.connector_count = 1;
    controller.active_connector = 0;

    // Enable the display engine if applicable
    // For Intel: write to display enable register at offset 0x70000
    if controller.vendor == GpuVendor::Intel || controller.vendor == GpuVendor::Bochs {
        let enable_result: Result(void, GpuError) = gpu_mmio_write32(controller, 0x70000, 0x80000000);
        match enable_result {
            Result::Ok(_) => {
                gpu_journal_register_write(journal, 0x70000, 0x80000000, 0x80000000,
                    String::from_bytes(Slice(u8)::from_str("Display engine enable")), timestamp);
            },
            Result::Err(_) => {},
        };
    };

    controller.initialized = true;
    controller.display_detected = true;

    residual emit {
        op: "gpu.controller_init",
        vendor: controller.vendor as u64,
        arch: controller.arch as u64,
        mmio_base: controller.mmio_virt_base,
        fb_base: controller.fb_virt_base,
        fb_size: controller.fb_size,
        crtcs: controller.crtc_count,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Set Display Mode
// ─────────────────────────────────────────────────────────────

fn gpu_set_mode(
    controller: Handle(GpuController),
    connector_idx: u64,
    mode_idx: u64,
    gpu_cap: GpuCapability,
    journal: Handle(GpuRegisterJournal),
    timestamp: u64,
) -> Result(void, GpuError)
    effect [memory:mmio, deterministic, residual]
    court "gpu_set_mode:v2"
{
    if !controller.initialized {
        return Result::Err(GpuError::GpuNotInitialized);
    };

    if !gpu_cap.can_set_mode {
        return Result::Err(GpuError::GpuCapabilityError);
    };

    if connector_idx >= controller.connector_count {
        return Result::Err(GpuError::GpuConnectorNotFound);
    };

    let conn: GpuConnector = controller.connectors[connector_idx];
    if mode_idx >= conn.mode_count {
        return Result::Err(GpuError::GpuInvalidMode);
    };

    let mode: GpuDisplayMode = conn.modes[mode_idx];
    let crtc: Handle(GpuCrtc) = Handle(GpuCrtc)::from_ptr(&controller.crtcs[0]);

    // Calculate framebuffer address and stride
    let fb_addr: u64 = controller.fb_virt_base;
    let stride: u64 = mode.width * (mode.bpp as u64 / 8);

    crtc.current_mode = mode;
    crtc.fb_address = fb_addr;
    crtc.fb_stride = stride;
    crtc.enabled = true;

    // Update encoder
    if controller.encoder_count > 0 {
        controller.encoders[0].enabled = true;
        controller.encoders[0].active_crtc = 0;
    };

    // Program display timings via MMIO (vendor-specific)
    // For Bochs VGA / QEMU stdvga: write mode to index/data registers
    if controller.vendor == GpuVendor::Bochs || controller.vendor == GpuVendor::Qemu {
        let _ = gpu_mmio_write32(controller, 0x400, (mode.width as u32));
        let _ = gpu_mmio_write32(controller, 0x404, (mode.height as u32));
        let _ = gpu_mmio_write32(controller, 0x408, (stride as u32));
        let _ = gpu_mmio_write32(controller, 0x40C, (mode.bpp as u32));
        let _ = gpu_mmio_write32(controller, 0x410, 0x01);  // Enable

        if gpu_cap.verify_cpu_path {
            gpu_journal_register_write(journal, 0x400, mode.width as u32, 0xFFFFFFFF,
                String::from_bytes(Slice(u8)::from_str("Bochs VBE width")), timestamp);
            gpu_journal_register_write(journal, 0x404, mode.height as u32, 0xFFFFFFFF,
                String::from_bytes(Slice(u8)::from_str("Bochs VBE height")), timestamp);
            gpu_journal_register_write(journal, 0x408, stride as u32, 0xFFFFFFFF,
                String::from_bytes(Slice(u8)::from_str("Bochs VBE stride")), timestamp);
            gpu_journal_register_write(journal, 0x40C, mode.bpp as u32, 0xFFFFFFFF,
                String::from_bytes(Slice(u8)::from_str("Bochs VBE bpp")), timestamp);
            gpu_journal_register_write(journal, 0x410, 0x01, 0x01,
                String::from_bytes(Slice(u8)::from_str("Bochs VBE enable")), timestamp);
        };
    };

    residual emit {
        op: "gpu.set_mode",
        connector: connector_idx,
        mode_index: mode_idx,
        width: mode.width,
        height: mode.height,
        bpp: mode.bpp as u64,
        refresh: mode.refresh_rate_hz,
        stride: stride,
        fb_addr: fb_addr,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Solid Fill Rectangle (2D Acceleration - CPU Reference Path)
// ─────────────────────────────────────────────────────────────

fn gpu_solid_fill(
    controller: Handle(GpuController),
    x: u64,
    y: u64,
    width: u64,
    height: u64,
    color_r: u8,
    color_g: u8,
    color_b: u8,
    color_a: u8,
    gpu_cap: GpuCapability,
    journal: Handle(GpuRegisterJournal),
    timestamp: u64,
) -> Result(void, GpuError)
    effect [memory:mmio, deterministic, residual]
    court "gpu_solid_fill:v2"
{
    if !controller.initialized {
        return Result::Err(GpuError::GpuNotInitialized);
    };

    if !gpu_cap.can_write_fb {
        return Result::Err(GpuError::GpuCapabilityError);
    };

    if controller.fb_virt_base == 0 {
        return Result::Err(GpuError::GpuFramebufferNotMapped);
    };

    let crtc: GpuCrtc = controller.crtcs[0];
    if !crtc.enabled {
        return Result::Err(GpuError::GpuModeSetFailed);
    };

    if x + width > crtc.current_mode.width || y + height > crtc.current_mode.height {
        return Result::Err(GpuError::GpuInvalidMode);
    };

    // CPU reference path: write each pixel through the CPU
    // This is the verifiable "software fallback" path
    let bpp_bytes: u64 = (crtc.current_mode.bpp as u64) / 8;
    let pitch: u64 = crtc.fb_stride;

    for row in 0..height {
        let y_pos: u64 = y + row;
        let row_offset: u64 = y_pos * pitch + x * bpp_bytes;
        let row_ptr: *(u8) = (controller.fb_virt_base + row_offset) as *(u8);

        for col in 0..width {
            let pixel_offset: u64 = col * bpp_bytes;
            trusted reason "GPU CPU-path solid fill pixel write, bounds-checked" {
                if bpp_bytes >= 4 {
                    *(row_ptr + pixel_offset) = color_b;
                    *(row_ptr + pixel_offset + 1) = color_g;
                    *(row_ptr + pixel_offset + 2) = color_r;
                    *(row_ptr + pixel_offset + 3) = color_a;
                } else if bpp_bytes == 3 {
                    *(row_ptr + pixel_offset) = color_b;
                    *(row_ptr + pixel_offset + 1) = color_g;
                    *(row_ptr + pixel_offset + 2) = color_r;
                } else if bpp_bytes == 2 {
                    let pixel: u16 = ((color_r as u16 >> 3) << 11)
                                   | ((color_g as u16 >> 2) << 5)
                                   | (color_b as u16 >> 3);
                    *(row_ptr + pixel_offset as *(u16)) = pixel;
                } else {
                    let gray: u8 = ((color_r as u16 + color_g as u16 + color_b as u16) / 3) as u8;
                    *(row_ptr + pixel_offset) = gray;
                };
            };
        };
    };

    if gpu_cap.verify_cpu_path {
        gpu_journal_register_write(journal, x | (y << 16), width as u32, height as u32,
            String::from_bytes(Slice(u8)::from_str("CPU solid fill rect")), timestamp);
    };

    residual emit {
        op: "gpu.solid_fill",
        x: x, y: y, width: width, height: height,
        row_count: height, col_count: width,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Blit (Bit Block Transfer - CPU Reference Path)
// ─────────────────────────────────────────────────────────────

fn gpu_blit(
    controller: Handle(GpuController),
    src_x: u64,
    src_y: u64,
    dst_x: u64,
    dst_y: u64,
    width: u64,
    height: u64,
    src_pitch: u64,
    dst_pitch: u64,
    gpu_cap: GpuCapability,
    journal: Handle(GpuRegisterJournal),
    timestamp: u64,
) -> Result(void, GpuError)
    effect [memory:mmio, deterministic, residual]
    court "gpu_blit:v2"
{
    if !controller.initialized {
        return Result::Err(GpuError::GpuNotInitialized);
    };

    if !gpu_cap.can_write_fb {
        return Result::Err(GpuError::GpuCapabilityError);
    };

    if controller.fb_virt_base == 0 {
        return Result::Err(GpuError::GpuFramebufferNotMapped);
    };

    let crtc: GpuCrtc = controller.crtcs[0];
    if !crtc.enabled {
        return Result::Err(GpuError::GpuModeSetFailed);
    };

    let bpp_bytes: u64 = (crtc.current_mode.bpp as u64) / 8;
    let fb_base: u64 = controller.fb_virt_base;

    // CPU reference path: copy row by row
    // Handle overlapping regions by copying in correct direction
    let y_start: u64;
    let y_end: u64;
    let y_step: i64;
    let forward: bool = dst_y < src_y || (dst_y == src_y && dst_x <= src_x);

    if forward {
        y_start = 0;
        y_end = height;
        y_step = 1;
    } else {
        y_start = height - 1;
        y_end = 0;
        y_step = -1;
    };

    let mut row: i64 = y_start as i64;
    loop bound 8192 {
        if forward {
            if (row as u64) >= y_end {
                break;
            };
        } else {
            if row < (y_end as i64) {
                break;
            };
        };
        if (row as u64) >= height {
            break;
        };

        let y_src: u64 = (src_y as i64 + row) as u64;
        let y_dst: u64 = (dst_y as i64 + row) as u64;

        let src_off: u64 = y_src * src_pitch + src_x * bpp_bytes;
        let dst_off: u64 = y_dst * dst_pitch + dst_x * bpp_bytes;

        let src_ptr: *(u8) = (fb_base + src_off) as *(u8);
        let dst_ptr: *(u8) = (fb_base + dst_off) as *(u8);

        // Copy row pixel by pixel
        for col in 0..width {
            let off: u64 = col * bpp_bytes;
            trusted reason "GPU CPU-path blit pixel copy, bounds-checked" {
                if bpp_bytes == 4 {
                    let pixel: u32 = *(src_ptr + off) as u32
                                   | ((*(src_ptr + off + 1) as u32) << 8)
                                   | ((*(src_ptr + off + 2) as u32) << 16)
                                   | ((*(src_ptr + off + 3) as u32) << 24);
                    *(dst_ptr + off) = pixel as u8;
                    *(dst_ptr + off + 1) = (pixel >> 8) as u8;
                    *(dst_ptr + off + 2) = (pixel >> 16) as u8;
                    *(dst_ptr + off + 3) = (pixel >> 24) as u8;
                } else if bpp_bytes == 3 {
                    *(dst_ptr + off) = *(src_ptr + off);
                    *(dst_ptr + off + 1) = *(src_ptr + off + 1);
                    *(dst_ptr + off + 2) = *(src_ptr + off + 2);
                } else if bpp_bytes == 2 {
                    *(dst_ptr + off as *(u16)) = *(src_ptr + off as *(u16));
                } else {
                    *(dst_ptr + off) = *(src_ptr + off);
                };
            };
        };

        row = row + y_step;
        if (row as u64) >= 8192 {
            break;
        };
    };

    if gpu_cap.verify_cpu_path {
        gpu_journal_register_write(journal, src_x | (src_y << 16), dst_x | (dst_y << 16),
            width as u32 | (height as u32 << 16),
            String::from_bytes(Slice(u8)::from_str("CPU blit operation")), timestamp);
    };

    residual emit {
        op: "gpu.blit",
        src_x: src_x, src_y: src_y, dst_x: dst_x, dst_y: dst_y,
        width: width, height: height,
        src_pitch: src_pitch, dst_pitch: dst_pitch,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Add EDID-Based Modes to Connector
// ─────────────────────────────────────────────────────────────

fn gpu_add_edid_modes(
    controller: Handle(GpuController),
    connector_idx: u64,
    format: GpuPixelFormat,
    bpp: u8,
    gpu_cap: GpuCapability,
    timestamp: u64,
) -> u64
    effect [deterministic, residual]
    court "gpu_add_edid_modes:v1"
{
    if connector_idx >= controller.connector_count {
        return 0;
    };

    if !gpu_cap.can_edid {
        return 0;
    };

    let conn: Handle(GpuConnector) = Handle(GpuConnector)::from_ptr(&controller.connectors[connector_idx]);
    if !conn.edid.valid {
        return 0;
    };

    let mut added: u64 = 0;
    for i in 0..4 {
        let timing: EdidDetailedTiming = conn.edid.detailed_modes[i];
        if timing.pixel_clock_10khz == 0 {
            continue;
        };

        if added >= 32 {
            break;
        };

        let mut mode: GpuDisplayMode = gpu_edid_timing_to_mode(timing, format, bpp);
        if i == conn.edid.preferred_mode_index {
            mode.preferred = true;
        };

        conn.modes[added] = mode;
        added = added + 1;
    };

    conn.mode_count = added;
    if conn.preferred_mode < added {
        conn.connected = true;
    };

    residual emit {
        op: "gpu.add_edid_modes",
        connector: connector_idx,
        modes_added: added,
        timestamp: timestamp,
    };

    return added;
}

// ─────────────────────────────────────────────────────────────
// Add Fallback Modes (if no EDID available)
// ─────────────────────────────────────────────────────────────

fn gpu_add_fallback_modes(
    controller: Handle(GpuController),
    connector_idx: u64,
    format: GpuPixelFormat,
    bpp: u8,
    timestamp: u64,
) -> u64
    effect [deterministic, residual]
    court "gpu_add_fallback_modes:v1"
{
    if connector_idx >= controller.connector_count {
        return 0;
    };

    let conn: Handle(GpuConnector) = Handle(GpuConnector)::from_ptr(&controller.connectors[connector_idx]);
    let mut added: u64 = 0;

    let fallback_modes: Array(GpuDisplayMode, 6) = Array(GpuDisplayMode, 6) {
        data: [
            GpuDisplayMode { width: 640, height: 480, pitch: 2560, format: format, bpp: bpp, refresh_rate_hz: 60, clock_hz: 25175000, h_front_porch: 0, h_sync: 0, h_back_porch: 0, v_front_porch: 0, v_sync: 0, v_back_porch: 0, h_polarity: false, v_polarity: false, interlaced: false, preferred: true, edid_detailed: false },
            GpuDisplayMode { width: 800, height: 600, pitch: 3200, format: format, bpp: bpp, refresh_rate_hz: 60, clock_hz: 40000000, h_front_porch: 0, h_sync: 0, h_back_porch: 0, v_front_porch: 0, v_sync: 0, v_back_porch: 0, h_polarity: false, v_polarity: false, interlaced: false, preferred: false, edid_detailed: false },
            GpuDisplayMode { width: 1024, height: 768, pitch: 4096, format: format, bpp: bpp, refresh_rate_hz: 60, clock_hz: 65000000, h_front_porch: 0, h_sync: 0, h_back_porch: 0, v_front_porch: 0, v_sync: 0, v_back_porch: 0, h_polarity: false, v_polarity: false, interlaced: false, preferred: false, edid_detailed: false },
            GpuDisplayMode { width: 1280, height: 720, pitch: 5120, format: format, bpp: bpp, refresh_rate_hz: 60, clock_hz: 74250000, h_front_porch: 0, h_sync: 0, h_back_porch: 0, v_front_porch: 0, v_sync: 0, v_back_porch: 0, h_polarity: false, v_polarity: false, interlaced: false, preferred: false, edid_detailed: false },
            GpuDisplayMode { width: 1280, height: 1024, pitch: 5120, format: format, bpp: bpp, refresh_rate_hz: 60, clock_hz: 108000000, h_front_porch: 0, h_sync: 0, h_back_porch: 0, v_front_porch: 0, v_sync: 0, v_back_porch: 0, h_polarity: false, v_polarity: false, interlaced: false, preferred: false, edid_detailed: false },
            GpuDisplayMode { width: 1920, height: 1080, pitch: 7680, format: format, bpp: bpp, refresh_rate_hz: 60, clock_hz: 148500000, h_front_porch: 0, h_sync: 0, h_back_porch: 0, v_front_porch: 0, v_sync: 0, v_back_porch: 0, h_polarity: false, v_polarity: false, interlaced: false, preferred: false, edid_detailed: false },
        ],
    };

    for i in 0..6 {
        conn.modes[i] = fallback_modes[i];
        added = added + 1;
    };

    conn.mode_count = added;
    conn.connected = true;

    residual emit {
        op: "gpu.add_fallback_modes",
        connector: connector_idx,
        modes_added: added,
        timestamp: timestamp,
    };

    return added;
}

// ─────────────────────────────────────────────────────────────
// GPU Driver Initialization
// ─────────────────────────────────────────────────────────────

fn gpu_driver_init(
    driver_identity: Identity,
    gpu_cap: GpuCapability,
    timestamp: u64,
) -> GpuDriverState
    effect [deterministic, residual]
    court "gpu_driver_init:v2"
{
    let default_mode: GpuDisplayMode = GpuDisplayMode {
        width: 1024, height: 768, pitch: 4096, format: GpuPixelFormat::Xrgb8888,
        bpp: 32, refresh_rate_hz: 60, clock_hz: 65000000,
        h_front_porch: 0, h_sync: 0, h_back_porch: 0,
        v_front_porch: 0, v_sync: 0, v_back_porch: 0,
        h_polarity: false, v_polarity: false,
        interlaced: false, preferred: true, edid_detailed: false,
    };

    let state: GpuDriverState = GpuDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        active_controller: 0,
        default_mode: default_mode,
        initialized: true,
        initialization_timestamp: timestamp,
        total_present_count: 0,
        total_fill_ops: 0,
        total_blit_ops: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "gpu_driver.init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add GPU Controller
// ─────────────────────────────────────────────────────────────

fn gpu_add_controller(
    state: Handle(GpuDriverState),
    vendor: GpuVendor,
    arch: GpuArch,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    bar0_addr: u64,
    bar0_size: u64,
    bar1_addr: u64,
    bar1_size: u64,
    bar2_addr: u64,
    bar2_size: u64,
    bar_type0: u8,
    bar_type1: u8,
    bar_type2: u8,
    gpu_cap: GpuCapability,
    journal: Handle(GpuRegisterJournal),
    timestamp: u64,
) -> Result(u64, GpuError)
    effect [memory:mmio, deterministic, residual]
    court "gpu_add_controller:v2"
{
    if state.controller_count >= 4 {
        return Result::Err(GpuError::GpuDeviceNotFound);
    };

    let idx: u64 = state.controller_count;
    let ctrl_identity: Identity = identity_new(
        0x475055, timestamp, idx, vendor as u64,
    );

    let controller: GpuController = GpuController {
        controller_identity: ctrl_identity,
        vendor: vendor,
        arch: arch,
        pci_bus: pci_bus, pci_device: pci_device, pci_func: pci_func,
        register_ranges: Array::zeroed(), range_count: 0,
        fb_bar_index: 0, fb_phys_base: 0, fb_virt_base: 0, fb_size: 0,
        mmio_bar_index: 0, mmio_phys_base: 0, mmio_virt_base: 0, mmio_size: 0,
        crtcs: Array::zeroed(), crtc_count: 0,
        encoders: Array::zeroed(), encoder_count: 0,
        connectors: Array::zeroed(), connector_count: 0,
        active_connector: 0,
        initialized: false, display_detected: false,
        dma_buf_base: 0, dma_buf_size: 0, host_visible_size: 0,
        generation: 1,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
    };

    state.controllers[idx] = controller;

    let ctrl_handle: Handle(GpuController) = Handle(GpuController)::from_ptr(&state.controllers[idx]);

    // Discover BARs
    let bars_result: Result(void, GpuError) = gpu_discover_bars(
        ctrl_handle, bar0_addr, bar0_size, bar1_addr, bar1_size,
        bar2_addr, bar2_size, bar_type0, bar_type1, bar_type2, timestamp,
    );
    match bars_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    // Initialize controller
    let init_result: Result(void, GpuError) = gpu_controller_init(ctrl_handle, gpu_cap, journal, timestamp);
    match init_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    // Add fallback modes
    gpu_add_fallback_modes(ctrl_handle, 0, GpuPixelFormat::Xrgb8888, 32, timestamp);

    state.controller_count = state.controller_count + 1;

    residual emit {
        op: "gpu.add_controller",
        idx: idx,
        vendor: vendor as u64,
        arch: arch as u64,
        mmio_base: state.controllers[idx].mmio_phys_base,
        fb_base: state.controllers[idx].fb_phys_base,
        fb_size: state.controllers[idx].fb_size,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// Record GPU Residuals
// ─────────────────────────────────────────────────────────────

fn gpu_record_residuals(
    state: Handle(GpuDriverState),
    timestamp: u64,
) -> void
    effect [residual]
    court "gpu_record_residuals:v1"
{
    residual emit {
        op: "gpu_driver.state_summary",
        initialized: if state.initialized { 1 } else { 0 },
        controller_count: state.controller_count,
        fills: state.total_fill_ops,
        blits: state.total_blit_ops,
        presents: state.total_present_count,
        errors: state.total_errors,
        timestamp: timestamp,
    };
}

// ─────────────────────────────────────────────────────────────
// Clear Framebuffer to Solid Color
// ─────────────────────────────────────────────────────────────

fn gpu_clear_screen(
    controller: Handle(GpuController),
    color_r: u8,
    color_g: u8,
    color_b: u8,
    gpu_cap: GpuCapability,
    journal: Handle(GpuRegisterJournal),
    timestamp: u64,
) -> Result(void, GpuError)
    effect [memory:mmio, deterministic, residual]
    court "gpu_clear_screen:v1"
{
    if !controller.initialized {
        return Result::Err(GpuError::GpuNotInitialized);
    };

    if controller.fb_virt_base == 0 {
        return Result::Err(GpuError::GpuFramebufferNotMapped);
    };

    let crtc: GpuCrtc = controller.crtcs[0];
    let fb_size: u64 = crtc.fb_stride * crtc.current_mode.height;

    // CPU-path clear: write each pixel to the entire framebuffer
    let bpp_bytes: u64 = (crtc.current_mode.bpp as u64) / 8;
    let pitch: u64 = crtc.fb_stride;

    for row in 0..crtc.current_mode.height {
        let row_offset: u64 = row * pitch;
        let row_ptr: *(u8) = (controller.fb_virt_base + row_offset) as *(u8);

        for col in 0..crtc.current_mode.width {
            let offset: u64 = col * bpp_bytes;
            trusted reason "GPU clear screen pixel write via CPU reference path" {
                if bpp_bytes >= 4 {
                    *(row_ptr + offset) = color_b;
                    *(row_ptr + offset + 1) = color_g;
                    *(row_ptr + offset + 2) = color_r;
                    *(row_ptr + offset + 3) = 255;
                } else if bpp_bytes == 3 {
                    *(row_ptr + offset) = color_b;
                    *(row_ptr + offset + 1) = color_g;
                    *(row_ptr + offset + 2) = color_r;
                } else if bpp_bytes == 2 {
                    let pixel: u16 = ((color_r as u16 >> 3) << 11)
                                   | ((color_g as u16 >> 2) << 5)
                                   | (color_b as u16 >> 3);
                    *(row_ptr + offset as *(u16)) = pixel;
                } else {
                    let gray: u8 = ((color_r as u16 + color_g as u16 + color_b as u16) / 3) as u8;
                    *(row_ptr + offset) = gray;
                };
            };
        };
    };

    residual emit {
        op: "gpu.clear_screen",
        width: crtc.current_mode.width,
        height: crtc.current_mode.height,
        color: ((color_r as u64) << 16) | ((color_g as u64) << 8) | (color_b as u64),
        timestamp: timestamp,
    };

    return Result::Ok(void);
}
