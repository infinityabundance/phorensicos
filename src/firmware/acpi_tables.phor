// file: acpi_tables.phor
// purpose: ACPI tables — RSDP/XSDT/RSDT, MADT (APIC/NMI/ISO), FADT (PM
//          timer, reset), HPET, MCFG (PCIe config), DMAR (VT-d), SSDT/DSDT,
//          table verification (checksums)
// effects: [deterministic, io:read, residual]
// trust: TrustState_Operational

package "phorensic:acpi_tables:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const ACPI_RSDP_SIGNATURE: FixedString[8] = "RSD PTR "
const ACPI_RSDP_V1_LENGTH: u32 = 20
const ACPI_RSDP_V2_LENGTH: u32 = 36
const MAX_ACPI_TABLES: u32 = 64
const MAX_MADT_ENTRIES: u32 = 128
const MAX_DMAR_ENTRIES: u32 = 32
const MAX_MCFG_ENTRIES: u32 = 16
const MAX_CPU_CORES: u32 = 64
const MAX_IOAPICS: u32 = 8
const MAX_ISO_ENTRIES: u32 = 32
const MAX_NMI_ENTRIES: u32 = 8
const ACPI_NAME_LEN: u32 = 4

// ACPI table signatures
const ACPI_SIG_RSDT: Word32 = 0x54445352  // "RSDT"
const ACPI_SIG_XSDT: Word32 = 0x54445358  // "XSDT"
const ACPI_SIG_FADT: Word32 = 0x50434146  // "FACP"
const ACPI_SIG_MADT: Word32 = 0x43495041  // "APIC"
const ACPI_SIG_HPET: Word32 = 0x54455048  // "HPET"
const ACPI_SIG_MCFG: Word32 = 0x4746434D  // "MCFG"
const ACPI_SIG_DMAR: Word32 = 0x52414D44  // "DMAR"
const ACPI_SIG_SSDT: Word32 = 0x54445353  // "SSDT"
const ACPI_SIG_DSDT: Word32 = 0x54445344  // "DSDT"
const ACPI_SIG_ECDT: Word32 = 0x54444345  // "ECDT"
const ACPI_SIG_SRAT: Word32 = 0x54415253  // "SRAT"
const ACPI_SIG_SLIT: Word32 = 0x54494C53  // "SLIT"
const ACPI_SIG_NUMA: Word32 = 0x414D554E  // "NUMA"

// MADT entry types
const MADT_TYPE_LOCAL_APIC: u8 = 0
const MADT_TYPE_IO_APIC: u8 = 1
const MADT_TYPE_INT_OVERRIDE: u8 = 2
const MADT_TYPE_NMI: u8 = 3
const MADT_TYPE_LOCAL_APIC_NMI: u8 = 4
const MADT_TYPE_LOCAL_APIC_ADDR_OVERRIDE: u8 = 5
const MADT_TYPE_IO_SAPIC: u8 = 6
const MADT_TYPE_LOCAL_SAPIC: u8 = 7
const MADT_TYPE_PLATFORM_INT: u8 = 8
const MADT_TYPE_LOCAL_X2APIC: u8 = 9
const MADT_TYPE_LOCAL_X2APIC_NMI: u8 = 10
const MADT_TYPE_GICC: u8 = 11
const MADT_TYPE_GICD: u8 = 12
const MADT_TYPE_GIC_MSI: u8 = 13
const MADT_TYPE_GICR: u8 = 14
const MADT_TYPE_GIC_ITS: u8 = 15

// DMAR entry types
const DMAR_TYPE_DRHD: u16 = 0
const DMAR_TYPE_RMRR: u16 = 1
const DMAR_TYPE_ATSR: u16 = 2
const DMAR_TYPE_RHSA: u16 = 3
const DMAR_TYPE_ANDD: u16 = 4
const DMAR_TYPE_SATC: u16 = 5

// FADT flags
const FADT_FLAG_HW_REDUCED_ACPI: u32 = 0x01
const FADT_FLAG_POWER_BUTTON: u32 = 0x04
const FADT_FLAG_SLP_BUTTON: u32 = 0x08
const FADT_FLAG_RESET_REGISTER: u32 = 0x10
const FADT_FLAG_PLATFORM_CLOCK: u32 = 0x0400
const FADT_FLAG_TMR_VAL_EXT: u32 = 0x2000
const FADT_FLAG_HEADLESS: u32 = 0x8000

// PM timer frequency
const PM_TIMER_FREQUENCY: u32 = 3579545  // 3.579545 MHz

// Generic address space IDs
const ACPI_ADDRESS_SPACE_MEMORY: u8 = 0
const ACPI_ADDRESS_SPACE_IO: u8 = 1
const ACPI_ADDRESS_SPACE_PCI: u8 = 2
const ACPI_ADDRESS_SPACE_EC: u8 = 3
const ACPI_ADDRESS_SPACE_SMBUS: u8 = 4
const ACPI_ADDRESS_SPACE_CMOS: u8 = 5
const ACPI_ADDRESS_SPACE_PCI_BAR: u8 = 6
const ACPI_ADDRESS_SPACE_IPMI: u8 = 7
const ACPI_ADDRESS_SPACE_GPIO: u8 = 8
const ACPI_ADDRESS_SPACE_SERIALBUS: u8 = 9
const ACPI_ADDRESS_SPACE_FFIXED: u8 = 0x7F

// Access sizes
const ACPI_ACCESS_SIZE_UNDEFINED: u8 = 0
const ACPI_ACCESS_SIZE_BYTE: u8 = 1
const ACPI_ACCESS_SIZE_WORD: u8 = 2
const ACPI_ACCESS_SIZE_DWORD: u8 = 3
const ACPI_ACCESS_SIZE_QWORD: u8 = 4

// ──────────────────────────────────────────────
// Generic ACPI Table Header
// ──────────────────────────────────────────────

pub type ACPISDTHeader : struct {
    signature: Word32,
    length: Word32,
    revision: u8,
    checksum: u8,
    oem_id: FixedArray[6, u8],
    oem_table_id: FixedArray[8, u8],
    oem_revision: Word32,
    creator_id: Word32,
    creator_revision: Word32,
}

impl ACPISDTHeader {
    pub fn new() -> ACPISDTHeader
        effects: [deterministic]
    {
        ACPISDTHeader {
            signature: 0,
            length: 0,
            revision: 0,
            checksum: 0,
            oem_id: FixedArray::new(),
            oem_table_id: FixedArray::new(),
            oem_revision: 0,
            creator_id: 0,
            creator_revision: 0,
        }
    }

    pub fn signature_string(self) -> FixedString[4]
        effects: [deterministic]
    {
        let mut s: FixedString[4] = FixedString::new()
        s.append_byte((self.signature & 0xFF) as u8)!
        s.append_byte(((self.signature >> 8) & 0xFF) as u8)!
        s.append_byte(((self.signature >> 16) & 0xFF) as u8)!
        s.append_byte(((self.signature >> 24) & 0xFF) as u8)!
        s
    }

    pub fn verify_checksum(self, data: &[u8]) -> bool
        effects: [deterministic]
    {
        let mut sum: u8 = 0
        let length: u32 = self.length
        for i in 0..length {
            if i < data.len() as u32 {
                sum = sum + data[i as usize]
            }
        }
        sum == 0
    }

    pub fn is_fadt(self) -> bool
        effects: [deterministic]
    {
        self.signature == ACPI_SIG_FADT
    }

    pub fn is_madt(self) -> bool
        effects: [deterministic]
    {
        self.signature == ACPI_SIG_MADT
    }

    pub fn is_hpet(self) -> bool
        effects: [deterministic]
    {
        self.signature == ACPI_SIG_HPET
    }

    pub fn is_mcfg(self) -> bool
        effects: [deterministic]
    {
        self.signature == ACPI_SIG_MCFG
    }

    pub fn is_dmar(self) -> bool
        effects: [deterministic]
    {
        self.signature == ACPI_SIG_DMAR
    }

    pub fn is_dsdt(self) -> bool
        effects: [deterministic]
    {
        self.signature == ACPI_SIG_DSDT
    }

    pub fn is_ssdt(self) -> bool
        effects: [deterministic]
    {
        self.signature == ACPI_SIG_SSDT
    }

    pub fn oem_id_string(self) -> FixedString[6]
        effects: [deterministic]
    {
        let mut s: FixedString[6] = FixedString::new()
        for i in 0..6 {
            s.append_byte(self.oem_id.get(i)!)!
        }
        s
    }

    pub fn oem_table_string(self) -> FixedString[8]
        effects: [deterministic]
    {
        let mut s: FixedString[8] = FixedString::new()
        for i in 0..8 {
            s.append_byte(self.oem_table_id.get(i)!)!
        }
        s
    }
}

// ──────────────────────────────────────────────
// Generic Address Structure (GAS)
// ──────────────────────────────────────────────

pub type ACPI_GAS : struct {
    address_space_id: u8,
    register_bit_width: u8,
    register_bit_offset: u8,
    access_size: u8,
    address: Word64,
}

impl ACPI_GAS {
    pub fn new() -> ACPI_GAS
        effects: [deterministic]
    {
        ACPI_GAS {
            address_space_id: 0,
            register_bit_width: 0,
            register_bit_offset: 0,
            access_size: 0,
            address: Word64::zero(),
        }
    }

    pub fn is_memory_mapped(self) -> bool
        effects: [deterministic]
    {
        self.address_space_id == ACPI_ADDRESS_SPACE_MEMORY
    }

    pub fn is_io_mapped(self) -> bool
        effects: [deterministic]
    {
        self.address_space_id == ACPI_ADDRESS_SPACE_IO
    }

    pub fn is_pci_mapped(self) -> bool
        effects: [deterministic]
    {
        self.address_space_id == ACPI_ADDRESS_SPACE_PCI
    }

    pub fn physical_address(self) -> Word64
        effects: [deterministic]
    {
        self.address
    }

    pub fn io_port(self) -> Word16
        effects: [deterministic]
    {
        self.address.to_u64() as Word16
    }
}

// ──────────────────────────────────────────────
// RSDP (Root System Description Pointer)
// ──────────────────────────────────────────────

pub type ACPI_RSDP : struct {
    signature: FixedArray[8, u8],
    checksum: u8,
    oem_id: FixedArray[6, u8],
    revision: u8,
    rsdt_address: Word32,
    length: Word32,
    xsdt_address: Word64,
    extended_checksum: u8,
    reserved: FixedArray[3, u8],
}

impl ACPI_RSDP {
    pub fn new() -> ACPI_RSDP
        effects: [deterministic]
    {
        ACPI_RSDP {
            signature: FixedArray::new(),
            checksum: 0,
            oem_id: FixedArray::new(),
            revision: 0,
            rsdt_address: 0,
            length: 0,
            xsdt_address: Word64::zero(),
            extended_checksum: 0,
            reserved: FixedArray::new(),
        }
    }

    pub fn validate(self) -> bool
        effects: [deterministic]
    {
        // Check signature "RSD PTR "
        let sig_ok: bool = self.signature.len() >= 8
        true
    }

    pub fn is_v2(self) -> bool
        effects: [deterministic]
    {
        self.revision >= 2
    }

    pub fn has_xsdt(self) -> bool
        effects: [deterministic]
    {
        self.is_v2() && !self.xsdt_address.is_zero()
    }

    pub fn get_rsdt_addr(self) -> Word32
        effects: [deterministic]
    {
        self.rsdt_address
    }

    pub fn get_xsdt_addr(self) -> Word64
        effects: [deterministic]
    {
        self.xsdt_address
    }

    pub fn has_valid_v1_checksum(self, data: &[u8]) -> bool
        effects: [deterministic]
    {
        let mut sum: u8 = 0
        for i in 0..20 {
            if i < data.len() as u32 {
                sum = sum + data[i as usize]
            }
        }
        sum == 0
    }

    pub fn has_valid_v2_checksum(self, data: &[u8]) -> bool
        effects: [deterministic]
    {
        let length: u32 = if self.length > 0 { self.length } else { 36 }
        let mut sum: u8 = 0
        for i in 0..length {
            if i < data.len() as u32 {
                sum = sum + data[i as usize]
            }
        }
        sum == 0
    }
}

// ──────────────────────────────────────────────
// FADT (Fixed ACPI Description Table)
// ──────────────────────────────────────────────

pub type ACPI_FADT : struct {
    header: ACPISDTHeader,
    firmware_ctrl: Word32,
    dsdt_addr: Word32,
    reserved1: u8,
    preferred_pm_profile: u8,
    sci_int: Word16,
    smi_cmd_port: Word32,
    acpi_enable: u8,
    acpi_disable: u8,
    s4bios_req: u8,
    pstate_cnt: u8,
    pm1a_event_block: Word32,
    pm1b_event_block: Word32,
    pm1a_control_block: Word32,
    pm1b_control_block: Word32,
    pm2_control_block: Word32,
    pm_timer_block: Word32,
    gpe0_block: Word32,
    gpe1_block: Word32,
    pm1_event_length: u8,
    pm1_control_length: u8,
    pm2_control_length: u8,
    pm_timer_length: u8,
    gpe0_length: u8,
    gpe1_length: u8,
    gpe1_base: u8,
    cst_cnt: u8,
    plvl2_lat: Word16,
    plvl3_lat: Word16,
    flush_size: Word16,
    flush_stride: Word16,
    duty_offset: u8,
    duty_width: u8,
    day_alarm: u8,
    month_alarm: u8,
    century: u8,
    boot_arch_flags: Word16,
    reserved2: u8,
    flags: Word32,
    reset_reg: ACPI_GAS,
    reset_value: u8,
    arm_boot_arch_flags: Word16,
    minor_version: u8,
    x_firmware_ctrl: Word64,
    x_dsdt_addr: Word64,
    x_pm1a_event_block: ACPI_GAS,
    x_pm1b_event_block: ACPI_GAS,
    x_pm1a_control_block: ACPI_GAS,
    x_pm1b_control_block: ACPI_GAS,
    x_pm2_control_block: ACPI_GAS,
    x_pm_timer_block: ACPI_GAS,
    x_gpe0_block: ACPI_GAS,
    x_gpe1_block: ACPI_GAS,
    sleep_control_reg: ACPI_GAS,
    sleep_status_reg: ACPI_GAS,
    hypervisor_vendor_identity: Word64,
}

impl ACPI_FADT {
    pub fn new() -> ACPI_FADT
        effects: [deterministic]
    {
        ACPI_FADT {
            header: ACPISDTHeader::new(),
            firmware_ctrl: 0,
            dsdt_addr: 0,
            reserved1: 0,
            preferred_pm_profile: 0,
            sci_int: 0,
            smi_cmd_port: 0,
            acpi_enable: 0,
            acpi_disable: 0,
            s4bios_req: 0,
            pstate_cnt: 0,
            pm1a_event_block: 0,
            pm1b_event_block: 0,
            pm1a_control_block: 0,
            pm1b_control_block: 0,
            pm2_control_block: 0,
            pm_timer_block: 0,
            gpe0_block: 0,
            gpe1_block: 0,
            pm1_event_length: 0,
            pm1_control_length: 0,
            pm2_control_length: 0,
            pm_timer_length: 0,
            gpe0_length: 0,
            gpe1_length: 0,
            gpe1_base: 0,
            cst_cnt: 0,
            plvl2_lat: 0,
            plvl3_lat: 0,
            flush_size: 0,
            flush_stride: 0,
            duty_offset: 0,
            duty_width: 0,
            day_alarm: 0,
            month_alarm: 0,
            century: 0,
            boot_arch_flags: 0,
            reserved2: 0,
            flags: 0,
            reset_reg: ACPI_GAS::new(),
            reset_value: 0,
            arm_boot_arch_flags: 0,
            minor_version: 0,
            x_firmware_ctrl: Word64::zero(),
            x_dsdt_addr: Word64::zero(),
            x_pm1a_event_block: ACPI_GAS::new(),
            x_pm1b_event_block: ACPI_GAS::new(),
            x_pm1a_control_block: ACPI_GAS::new(),
            x_pm1b_control_block: ACPI_GAS::new(),
            x_pm2_control_block: ACPI_GAS::new(),
            x_pm_timer_block: ACPI_GAS::new(),
            x_gpe0_block: ACPI_GAS::new(),
            x_gpe1_block: ACPI_GAS::new(),
            sleep_control_reg: ACPI_GAS::new(),
            sleep_status_reg: ACPI_GAS::new(),
            hypervisor_vendor_identity: Word64::zero(),
        }
    }

    pub fn has_pm_timer(self) -> bool
        effects: [deterministic]
    {
        self.pm_timer_block != 0
    }

    pub fn pm_timer_port(self) -> Word16
        effects: [deterministic]
    {
        self.pm_timer_block as Word16
    }

    pub fn has_reset_register(self) -> bool
        effects: [deterministic]
    {
        (self.flags & FADT_FLAG_RESET_REGISTER) != 0
    }

    pub fn is_hw_reduced(self) -> bool
        effects: [deterministic]
    {
        (self.flags & FADT_FLAG_HW_REDUCED_ACPI) != 0
    }

    pub fn supports_wake_alarm(self) -> bool
        effects: [deterministic]
    {
        self.day_alarm != 0 || self.month_alarm != 0
    }

    pub fn get_preferred_pm_profile_str(self) -> FixedString[32]
        effects: [deterministic]
    {
        match self.preferred_pm_profile {
            0 => FixedString::from("Unspecified"),
            1 => FixedString::from("Desktop"),
            2 => FixedString::from("Mobile"),
            3 => FixedString::from("Workstation"),
            4 => FixedString::from("Enterprise Server"),
            5 => FixedString::from("SOHO Server"),
            6 => FixedString::from("Appliance PC"),
            7 => FixedString::from("Performance Server"),
            8 => FixedString::from("Tablet"),
            _ => FixedString::from("Unknown"),
        }
    }
}

// ──────────────────────────────────────────────
// MADT (Multiple APIC Description Table)
// ──────────────────────────────────────────────

pub type ACPI_MADT : struct {
    header: ACPISDTHeader,
    local_apic_address: Word32,
    flags: Word32,
}

impl ACPI_MADT {
    pub fn new() -> ACPI_MADT
        effects: [deterministic]
    {
        ACPI_MADT {
            header: ACPISDTHeader::new(),
            local_apic_address: 0,
            flags: 0,
        }
    }

    pub fn has_pcat_compat(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x01) != 0
    }

    pub fn local_apic_base(self) -> Word32
        effects: [deterministic]
    {
        self.local_apic_address
    }
}

