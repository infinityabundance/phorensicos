// jit_port_toupper.phor — first JIT-Porting Court target (native candidate)
//
// Clean-room native port of libc `toupper`, expressed in Phorensic. This mirrors
// phost::porting::candidate::phor_toupper and is referenced by the candidate
// residual (phost/evidence/porting/toupper/candidate_signature.json).
//
// Court flow (host): phost port promote toupper
//   foreign behavior → dialect cage → oracle traces → behavior signature
//   → native candidate → replay court → comparison → promotion → sealed package
//
// Scope: API-surface JIT-porting (byte-in/byte-out). NOT arbitrary binary
// translation. The cage observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_toupper:v1.0";

// ── Domain and trust constants ───────────────────────────

const DOMAIN: u64 = 256;
const FIRST_LOWER: u8 = 97;   // 'a'
const LAST_LOWER: u8 = 122;   // 'z'
const CASE_DELTA: u8 = 32;    // 'a' - 'A'

const TRUST_UNKNOWN: u8 = 0;
const TRUST_OBSERVED: u8 = 1;
const TRUST_ORACLE_COMPARED: u8 = 3;
const TRUST_SEALED: u8 = 5;

const VERDICT_CONSISTENT: u8 = 0;
const VERDICT_INCONSISTENT: u8 = 1;

// ── Target and evidence records ──────────────────────────

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    input_schema: Str(64),
    output_schema: Str(64),
}

struct ReplayVerdict {
    target: Str(32),
    cases_run: u64,
    cases_passed: u64,
    cases_failed: u64,
    verdict: u8,
}

struct SealedPackage {
    target: Str(32),
    dialect_name: Str(16),
    trust_level: u8,
    case_count: u64,
    oracle_hash: Str(64),
    candidate_hash: Str(64),
}

// ── Native clean-room candidate ──────────────────────────
// ASCII a..z fold to A..Z; every other byte is unchanged (C locale contract).

fn phor_toupper(b: u8) -> u8
    effect [compute]
{
    if b >= FIRST_LOWER && b <= LAST_LOWER {
        return b - CASE_DELTA;
    }
    return b;
}

// ── Dialect cage ─────────────────────────────────────────
// The host court observes the foreign libc `toupper` through
// phost::porting::dialect_cage. This local model stands in for that black-box
// observation inside the .phor expression of the court.

fn cage_observed_toupper(b: u8) -> u8
    effect [compute]
{
    if b >= FIRST_LOWER && b <= LAST_LOWER {
        return b - CASE_DELTA;
    }
    return b;
}

// ── Replay court + comparison ────────────────────────────
// Replays the complete 0..=255 domain. The verdict derives from case
// comparisons, not from receipt counts.

fn run_replay_court(symbol: Str(32)) -> ReplayVerdict
    effect [compute, residual]
{
    let mut passed: u64 = 0;
    let mut failed: u64 = 0;

    for i in 0..DOMAIN {
        let input: u8 = i as u8;
        let expected: u8 = cage_observed_toupper(input);
        let actual: u8 = phor_toupper(input);
        if expected == actual {
            passed = passed + 1;
        } else {
            failed = failed + 1;
        }
    }

    residual emit {
        op: "porting.replay",
        target: "toupper",
        cases_run: DOMAIN,
        cases_passed: passed,
        cases_failed: failed,
    };

    if failed == 0 {
        return ReplayVerdict {
            target: symbol,
            cases_run: DOMAIN,
            cases_passed: passed,
            cases_failed: failed,
            verdict: VERDICT_CONSISTENT,
        };
    }
    return ReplayVerdict {
        target: symbol,
        cases_run: DOMAIN,
        cases_passed: passed,
        cases_failed: failed,
        verdict: VERDICT_INCONSISTENT,
    };
}

// ── Trust promotion ──────────────────────────────────────
// Promotion to sealed requires: full non-empty replay, zero failures, and a
// consistent verdict. Fail closed.

fn promote(v: ReplayVerdict) -> u8
    effect [compute, residual]
{
    if v.cases_run == 0 {
        return TRUST_UNKNOWN;
    }
    if v.verdict != VERDICT_CONSISTENT || v.cases_failed != 0 {
        return TRUST_ORACLE_COMPARED;
    }
    residual emit {
        op: "porting.promote",
        target: "toupper",
        trust: TRUST_SEALED,
    };
    return TRUST_SEALED;
}

// ── Court entry ──────────────────────────────────────────

fn main() -> void
    effect [compute, residual]
{
    let target: PortTarget = PortTarget {
        dialect_name: Str::from("libc"),
        symbol: Str::from("toupper"),
        version: Str::from("host-observed-v1"),
        input_schema: Str::from("u8 (single byte, 0..=255)"),
        output_schema: Str::from("u8 (single byte)"),
    };

    assert(target.symbol == Str::from("toupper"), "porting: target is toupper");
    assert(target.dialect_name == Str::from("libc"), "porting: dialect is libc");

    // Observe + replay the full domain.
    let verdict: ReplayVerdict = run_replay_court(target.symbol);
    assert(verdict.cases_run == DOMAIN, "porting: full domain replayed");
    assert(verdict.cases_passed == DOMAIN, "porting: all 256 cases passed");
    assert(verdict.cases_failed == 0, "porting: no mismatches");

    // Promote only on a consistent verdict.
    let trust_level: u8 = promote(verdict);
    assert(trust_level == TRUST_SEALED, "porting: promoted to sealed");

    // Native candidate boundary checks.
    let lower_a: u8 = 97;
    let upper_a: u8 = 65;
    let lower_z: u8 = 122;
    let upper_z: u8 = 90;
    let digit_0: u8 = 48;
    let non_ascii: u8 = 233;

    assert(phor_toupper(lower_a) == upper_a, "porting: a -> A");
    assert(phor_toupper(lower_z) == upper_z, "porting: z -> Z");
    assert(phor_toupper(upper_a) == upper_a, "porting: A -> A");
    assert(phor_toupper(digit_0) == digit_0, "porting: 0 -> 0");
    assert(phor_toupper(non_ascii) == non_ascii, "porting: non-ASCII unchanged");
}
