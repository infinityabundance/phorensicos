// file: errors.phor
// purpose: All error types with stable diagnostic codes for every subsystem.
//          Each error carries a unique Word64 diagnostic code that is
//          stable across versions, plus a human-readable message.
// evidence: ERR-ARCH-001 through ERR-ARCH-120
// residual: All errors are value types; no allocation or unsafe.

use core::constants::*

// ──────────────────────────────────────────────
// Error Base Trait
// ──────────────────────────────────────────────
// Every error type implements this base trait.
// Evidence path: ERR-BASE-001 through ERR-BASE-010

pub trait Error : {
    // Return the stable diagnostic code for this error.
    fn code(self) -> Word64
        effects: [deterministic]

    // Return the human-readable message for this error.
    fn message(self) -> FixedString[128]
        effects: [deterministic]

    // Return the trust level at which this error was generated.
    fn trust_level(self) -> TrustLevel
        effects: [deterministic]

    // Check if this error is of a given diagnostic range.
    fn in_range(self, base: Word64, end: Word64) -> bool
        effects: [deterministic]
    {
        let c: Word64 = self.code()
        c.gte(base) && c.lte(end)
    }
}

// ──────────────────────────────────────────────
// Kernel Error Types
// ──────────────────────────────────────────────
// Errors originating from the kernel layer.
// Evidence path: ERR-KERN-001 through ERR-KERN-030

pub type KernelError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl KernelError {
    pub fn new(code: Word64, msg: FixedString[128]) -> KernelError
        effects: [deterministic]
    {
        KernelError {
            code: code,
            msg: msg,
            trust: TrustLevel::Trust_System,
        }
    }

    pub fn with_trust(code: Word64, msg: FixedString[128], trust: TrustLevel) -> KernelError
        effects: [deterministic]
    {
        KernelError { code: code, msg: msg, trust: trust }
    }
}

impl Error for KernelError {
    fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust
    }

    fn in_range(self, base: Word64, end: Word64) -> bool
        effects: [deterministic]
    {
        self.code.gte(base) && self.code.lte(end)
    }
}

// Kernel error constructors
pub fn kernel_panic(msg: FixedString[128]) -> KernelError
    effects: [deterministic]
{
    KernelError::new(Word64::from_u64(DIAG_KERNEL_BASE | 0x001), msg)
}

pub fn kernel_invalid_state(msg: FixedString[128]) -> KernelError
    effects: [deterministic]
{
    KernelError::new(Word64::from_u64(DIAG_KERNEL_BASE | 0x002), msg)
