// bounded_loop.phor — Example showing bounded loop acceptance
//
// Demonstrates:
//   - For loop with fixed bound (accepted)
//   - For loop over array capacity (accepted)
//   - While loop with 'proven' annotation (accepted)
//   - Bounded loop with explicit bound count (accepted)
//   - While loop without 'proven' (REJECTED with E0501)
//   - For loop over ring buffer capacity
//   - Loop with nested if-else and bounded inner loop
//   - Loop bound from const expression
//   - Bounded loop with mutable accumulator patterns
//
// Expected outcomes:
//   - All bounded loop forms compile successfully ✓
//   - While loop without 'proven' produces E0501 ✗
//   - Loop bounds are statically verifiable ✓
//   - For loop bound from collection.capacity() ✓
//   - Nested loops each require their own bound or proven annotation ✓
//
// Compilation: accepted (with noted rejection for unbounded while)
// Trust state: Observed

package "phorensic:bounded_loop:v1.0";

const ARRAY_SIZE: u64 = 100;
const LOOP_BOUND: u64 = 50;
const MATRIX_SIZE: u64 = 5;

fn test_for_fixed_bound() -> u64
    effect [compute]
{
    let mut sum: u64 = 0;
    // Accepted: for loop with fixed range
    for i in 0..LOOP_BOUND {
        sum = sum + i;
    }
    return sum; // sum of 0..49 = 1225
}

fn test_for_over_array() -> u64
    effect [compute]
{
    let arr: Array(u64, ARRAY_SIZE) = Array::splat(1);
    let mut sum: u64 = 0;

    // Accepted: bound = arr.capacity() = 100 (statically known)
    for i in 0..arr.capacity() {
        sum = sum + arr[i];
    }
    return sum; // 100
}

fn test_for_over_ringbuf() -> u64
    effect [compute]
{
    let mut buf: RingBuf(u64, 32) = RingBuf::new();
    for i in 0..16 {
        buf.push(i as u64);
    }

    // Accepted: bound from ring buffer capacity
    let mut sum: u64 = 0;
    for i in 0..buf.capacity() {
        // Only access valid elements
        if i < buf.len() {
            let val: u64 = match buf.pop() {
                Option::Some(v) => v,
                Option::None => 0,
            };
            sum = sum + val;
        }
    }
    return sum; // sum of 0..15 = 120
}

fn test_while_proven(x: u64) -> u64
    effect [compute]
{
    let mut count: u64 = 0;
    let mut result: u64 = 0;

    // Accepted: 'proven' attests court-verified termination
    while count < x proven {
        result = result + count;
        count = count + 1;
    }
    return result;
}

fn test_bounded_loop_explicit() -> u64
    effect [compute]
{
    let mut acc: u64 = 0;
    // Accepted: explicit bound declaration
    loop bound 10 {
        acc = acc + 1;
    };
    return acc; // 10
}

fn test_nested_bounded_loops() -> u64
    effect [compute]
{
    let mut sum: u64 = 0;
    // Both loops have bounds — each requires its own
    for i in 0..MATRIX_SIZE {
        for j in 0..MATRIX_SIZE {
            sum = sum + 1;
        }
    }
    return sum; // 25
}

fn test_loop_with_conditional_inner() -> u64
    effect [compute]
{
    let mut arr: Array(u64, 20) = Array::zeroed();
    for i in 0..20 {
        // Conditional inner work
        if i % 2 == 0 {
            // Even indices get value
            arr[i] = i as u64;
        } else {
            // Odd indices get doubled value
            for j in 0..2 {
                let val: u64 = arr[i - 1] + (j as u64);
                if j == 1 {
                    arr[i] = val;
                }
            }
        }
    }
    let mut sum: u64 = 0;
    for i in 0..20 {
        sum = sum + arr[i];
    }
    return sum;
}

fn test_factorial_bounded() -> u64
    effect [compute]
    bound depth 20
{
    // Iterative factorial with bounded loop
    let n: u64 = 10;
    let mut result: u64 = 1;
    let mut i: u64 = 2;
    while i <= n proven {
        result = result * i;
        i = i + 1;
    }
    return result; // 10! = 3628800
}

fn test_product_of_sums() -> u64
    effect [compute]
{
    let mut total: u64 = 0;
    for i in 0..10 {
        let mut inner_sum: u64 = 0;
        for j in 0..10 {
            inner_sum = inner_sum + (i as u64) * (j as u64);
        }
        total = total + inner_sum;
    }
    return total; // sum(i * sum(j) for i in 0..9, j in 0..9) = ?*?
}

// fn test_while_unproven() -> void
//     effect [compute]
// {
//     let mut x: u64 = 0;
//     // COMPILE ERROR E0501: while without 'proven' is rejected
//     while x < 10 {
//         x = x + 1;
//     }
// }

fn test_bounded_loop_countdown() -> u64
    effect [compute]
{
    // Countdown loop with explicit bound
    let mut count: u64 = 10;
    let mut result: u64 = 0;
    loop bound 10 {
        result = result + count;
        count = count - 1;
    };
    return result; // 10+9+8+...+1 = 55
}

fn test_for_each_range() -> u64
    effect [compute]
{
    // Test inclusive range
    let mut sum: u64 = 0;
    for i in 0..=5 {
        sum = sum + i;
    }
    return sum; // 0+1+2+3+4+5 = 15
}

fn test_nested_loop_matrix_product() -> u64
    effect [compute]
{
    // Matrix 3x3 product: sum of all elements in resulting matrix
    let mut a: Array(Array(u64, 3), 3) = Array::splat(Array::splat(1 as u64));
    let mut b: Array(Array(u64, 3), 3) = Array::splat(Array::splat(2 as u64));
    let mut result: u64 = 0;

    for i in 0..3 {
        for j in 0..3 {
            for k in 0..3 {
                result = result + a[i][k] * b[k][j];
            }
        }
    }
    // Each element = 1*2+1*2+1*2 = 6, 9 elements = 54
    return result;
}

fn test_bounded_loop_with_early_exit() -> u64
    effect [compute]
{
    let mut arr: Array(u64, 100) = Array::splat(0);
    arr[42] = 99;

    // Search with bounded loop and early exit
    let mut found: u64 = 0;
    let mut found_index: u64 = 0xFFFFFFFF;
    for i in 0..arr.capacity() {
        if arr[i] == 99 {
            found = 1;
            found_index = i as u64;
            break;
        }
    }
    assert(found == 1, "loops: early exit found value");
    assert(found_index == 42, "loops: early exit found at index 42");
    return found_index;
}

fn test_proven_while_countdown() -> u64
    effect [compute]
{
    let mut n: u64 = 100;
    let mut sum: u64 = 0;
    while n > 0 proven {
        sum = sum + n;
        n = n - 1;
    }
    return sum; // 100+99+...+1 = 5050
}

fn test_string_bounded_iteration() -> void
    effect [compute]
{
    let s: Str(32) = Str::from("Phorensic");
    let mut char_count: u64 = 0;
    for i in 0..s.len() {
        char_count = char_count + 1;
    }
    assert(char_count == 9, "loops: string iteration count");
}

fn test_bounded_loop_nested_while() -> u64
    effect [compute]
{
    // Nested while loops both with proven
    let mut outer_sum: u64 = 0;
    let mut outer: u64 = 0;
    while outer < 5 proven {
        let mut inner: u64 = 0;
        while inner < 5 proven {
            outer_sum = outer_sum + (outer + inner);
            inner = inner + 1;
        }
        outer = outer + 1;
    }
    return outer_sum;
}

fn test_bounded_loop_const_bound() -> u64
    effect [compute]
{
    // Loop bound from compile-time constant
    const BOUND: u64 = 10;
    let mut sum: u64 = 0;
    for i in 0..BOUND {
        sum = sum + i;
    }
    return sum; // 0+1+...+9 = 45
}

fn test_bounded_compute_fibonacci() -> u64
    effect [compute]
    bound depth 30
{
    let n: u64 = 10;
    let mut a: u64 = 0;
    let mut b: u64 = 1;
    let mut i: u64 = 2;
    while i <= n proven {
        let c: u64 = a + b;
        a = b;
        b = c;
        i = i + 1;
    }
    return b; // fib(10) = 55
}

fn main() -> u64
    effect [compute]
{
    let r1: u64 = test_for_fixed_bound();
    assert(r1 == 1225, "loops: sum 0..49 = 1225");
    let r2: u64 = test_for_over_array();
    assert(r2 == 100, "loops: array sum = 100");
    let r3: u64 = test_while_proven(10);
    assert(r3 == 45, "loops: while sum 0..9 = 45");
    let r4: u64 = test_bounded_loop_explicit();
    assert(r4 == 10, "loops: bounded 10 iterations");
    let r5: u64 = test_nested_bounded_loops();
    assert(r5 == 25, "loops: 5x5 nested = 25");
    let r6: u64 = test_factorial_bounded();
    assert(r6 == 3628800, "loops: 10! = 3628800");
    let r7: u64 = test_for_over_ringbuf();
    assert(r7 == 120, "loops: ringbuf sum 0..15 = 120");
    let r8: u64 = test_loop_with_conditional_inner();
    assert(r8 > 0, "loops: conditional inner loops");
    let r9: u64 = test_product_of_sums();
    let r10: u64 = test_bounded_loop_countdown();
    assert(r10 == 55, "loops: countdown 10..1 = 55");
    let r11: u64 = test_for_each_range();
    assert(r11 == 15, "loops: inclusive range 0..=5 = 15");
    let r12: u64 = test_nested_loop_matrix_product();
    assert(r12 == 54, "loops: 3x3 matrix product sum = 54");
    let r13: u64 = test_bounded_loop_with_early_exit();
    assert(r13 == 42, "loops: early exit at index 42");
    let r14: u64 = test_proven_while_countdown();
    assert(r14 == 5050, "loops: countdown 100..1 = 5050");
    let r15: u64 = test_bounded_loop_nested_while();
    let r16: u64 = test_bounded_loop_const_bound();
    assert(r16 == 45, "loops: const bound 0..9 = 45");
    let r17: u64 = test_bounded_compute_fibonacci();
    assert(r17 == 55, "loops: fib(10) = 55");
    test_string_bounded_iteration();

    // Verify all results are positive
    let results: Array(u64, 17) = Array::splat(0);
    results[0] = r1;
    results[1] = r2;
    results[2] = r3;
    results[3] = r4;
    results[4] = r5;
    results[5] = r6;
    results[6] = r7;
    results[7] = r8;
    results[8] = r9;
    results[9] = r10;
    results[10] = r11;
    results[11] = r12;
    results[12] = r13;
    results[13] = r14;
    results[14] = r15;
    results[15] = r16;
    results[16] = r17;

    for i in 0..17 {
        assert(results[i] > 0, "loops: all results positive");
    }

    // Final verification: all results should form a valid sum
    let grand_total: u64 = r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + r11 + r12 + r13 + r14 + r15 + r16 + r17;
    assert(grand_total > 0, "loops: grand total positive");

    return grand_total;
}
