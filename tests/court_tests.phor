// court_tests.phor — Tests for replay courts, oracle comparison, verdicts, trust promotion
// Tests: court sessions, oracle comparison, verdict issuance, trust ladder progression
//
// Expected outcomes:
//   - Court sessions follow lifecycle: open → submit → replay → compare → verdict → close
//   - Oracle comparison correctly classifies ByteIdentical, StructurallyEquivalent,
//     BehaviorallyEquivalent, and Divergent results
//   - Divergence is properly classified (Semantic, Optimization, Dialect, Nondeterministic, Acceptable)
//   - Verdict issuance produces Accept, Refine, Reject, or MoreEvidence
//   - Trust promotion follows the ladder: Unknown→Observed→Replayed→OracleCompared→ResidualStable→Sealed→Promoted
//   - Multiple oracle sessions strengthen trust
//   - All court operations produce residuals

package "phorensic:court_tests:v1.0";

// ============================================================================
// Section 1: Court Session Lifecycle Tests
// ============================================================================

struct CourtSession {
    session_id: u64,
    object_key: u64,
    oracle_id: Str(32),
    evidence_count: u32,
    replayed: bool,
    compared: bool,
    verdict_issued: bool,
    closed: bool,
}

fn test_court_session_open() -> void
    effect [io:write, court:request, residual]
{
    // Open a court session for an object with a specific oracle
    let session: CourtSession = CourtSession{
        session_id: 0x1001,
        object_key: 0xAABBCCDD,
        oracle_id: Str::from("phc-v2.0.0"),
        evidence_count: 0,
        replayed: false,
        compared: false,
        verdict_issued: false,
        closed: false,
    };

    assert(session.session_id != 0, "court: session has valid ID");
    assert(!session.closed, "court: session starts open");

    residual emit {
        op: "court.session_open",
        session_id: session.session_id,
        oracle: session.oracle_id,
    };
}

fn test_court_session_lifecycle() -> void
    effect [io:write, court:request, residual]
{
    // Full lifecycle: open → submit evidence → run replay → compare with oracle → issue verdict → close
    let mut session: CourtSession = CourtSession{
        session_id: 0x2002,
        object_key: 0xBBCCDDEE,
        oracle_id: Str::from("phc-v2.0.0"),
        evidence_count: 0,
        replayed: false,
        compared: false,
        verdict_issued: false,
        closed: false,
    };

    // Step 2: Submit evidence
    session.evidence_count = 5;
    assert(session.evidence_count == 5, "court: evidence submitted");

    // Step 3: Run replay
    session.replayed = true;
    assert(session.replayed, "court: replay completed");

    // Step 4: Compare with oracle
    session.compared = true;
    assert(session.compared, "court: oracle comparison completed");

    // Step 5: Issue verdict
    session.verdict_issued = true;
    assert(session.verdict_issued, "court: verdict issued");

    // Step 6: Close
    session.closed = true;
    assert(session.closed, "court: session closed");

    residual emit {
        op: "court.session_lifecycle",
        session_id: session.session_id,
        evidence_count: session.evidence_count,
        verdict_issued: if session.verdict_issued { 1 } else { 0 },
    };
}

// ============================================================================
// Section 2: Oracle Comparison Tests
// ============================================================================

struct ComparisonResult {
    comparison_type: u8, // 0=ByteIdentical, 1=StructurallyEquivalent, 2=BehaviorallyEquivalent, 3=Divergent
    native_hash: u64,
    oracle_hash: u64,
    divergence_count: u32,
}

fn test_oracle_byte_identical() -> void
    effect [io:write, court:request, residual]
{
    // Byte-identical: outputs are exactly the same bytes
    let result: ComparisonResult = ComparisonResult{
        comparison_type: 0,
        native_hash: 0xAABBCCDD,
        oracle_hash: 0xAABBCCDD,
        divergence_count: 0,
    };

    assert(result.comparison_type == 0, "court: byte-identical comparison");
    assert(result.native_hash == result.oracle_hash, "court: hashes match");
    assert(result.divergence_count == 0, "court: no divergence");

    // Byte-identical → strong positive trust effect
    let trust_effect: Str(16) = Str::from("strong_positive");
    assert(trust_effect == Str::from("strong_positive"), "court: strong positive trust");

    residual emit {
        op: "court.compare_identical",
        native: result.native_hash,
        oracle: result.oracle_hash,
    };
}

fn test_oracle_structurally_equivalent() -> void
    effect [io:write, court:request, residual]
{
    // Structurally equivalent: differ in non-semantic bytes (timestamps, addresses)
    // but semantic structure is identical
    let result: ComparisonResult = ComparisonResult{
        comparison_type: 1,
        native_hash: 0x11112222,
        oracle_hash: 0x33334444,
        divergence_count: 2, // Non-semantic differences
    };

    assert(result.comparison_type == 1, "court: structurally equivalent");
    assert(result.native_hash != result.oracle_hash, "court: different hashes due to metadata");

    // Verdict: equivalent with residual record of differences
    // Trust effect: positive with noted non-semantic drift
    let trust_effect: Str(16) = Str::from("positive_drift");
    assert(trust_effect == Str::from("positive_drift"), "court: positive with drift");

    residual emit {
        op: "court.compare_equivalent",
        native: result.native_hash,
        oracle: result.oracle_hash,
        non_semantic_diffs: result.divergence_count,
    };
}

fn test_oracle_divergent() -> void
    effect [io:write, court:request, residual]
{
    // Divergent: outputs differ in semantic content
    let result: ComparisonResult = ComparisonResult{
        comparison_type: 3,
        native_hash: 0xDEADBEEF,
        oracle_hash: 0xCAFEBABE,
        divergence_count: 5,
    };

    assert(result.comparison_type == 3, "court: divergent comparison");

    // Divergent → negative trust effect, cannot be promoted
    // Requires investigation of divergence cause
    let can_promote: bool = result.comparison_type != 3;
    assert(!can_promote, "court: divergent object cannot be promoted");

    residual emit {
        op: "court.compare_divergent",
        native: result.native_hash,
        oracle: result.oracle_hash,
        divergence_count: result.divergence_count,
        can_promote: 0,
    };
}

// ============================================================================
// Section 3: Divergence Classification Tests
// ============================================================================

struct DivergenceRecord {
    class: u8,     // 0=Semantic, 1=Optimization, 2=Dialect, 3=Nondeterministic, 4=Acceptable
    severity: u8,  // 0=low, 1=medium, 2=high
    description: Str(64),
}

fn test_divergence_semantic() -> void
    effect [io:write, court:request, residual]
{
    // Semantic divergence: different computation results or control flow
    let divergence: DivergenceRecord = DivergenceRecord{
        class: 0,
        severity: 2, // high
        description: Str::from("different computation result"),
    };

    assert(divergence.severity == 2, "court: semantic divergence is high severity");

    residual emit {
        op: "court.divergence_semantic",
        severity: divergence.severity,
    };
}

fn test_divergence_optimization() -> void
    effect [io:write, court:request, residual]
{
    // Optimization divergence: different instruction selection, register allocation, scheduling
    let divergence: DivergenceRecord = DivergenceRecord{
        class: 1,
        severity: 1, // medium
        description: Str::from("different instruction selection"),
    };

    // Medium severity if behavior preserved, high if behavior affected
    let behavior_preserved: bool = true;
    let effective_severity: u8 = if behavior_preserved { 1 } else { 2 };
    assert(effective_severity == 1, "court: optimization divergence medium if behavior preserved");

    residual emit {
        op: "court.divergence_optimization",
        severity: effective_severity,
    };
}

fn test_divergence_acceptable() -> void
    effect [io:write, court:request, residual]
{
    // Acceptable divergence: pre-declared acceptable differences
    let divergence: DivergenceRecord = DivergenceRecord{
        class: 4,
        severity: 0, // low
        description: Str::from("documented non-semantic variation"),
    };

    assert(divergence.severity == 0, "court: acceptable divergence is low severity");

    residual emit {
        op: "court.divergence_acceptable",
        severity: divergence.severity,
    };
}

// ============================================================================
// Section 4: Verdict Tests
// ============================================================================

struct Verdict {
    verdict_type: u8, // 0=Accept, 1=Refine, 2=Reject, 3=MoreEvidence
    promoted_to: u8,
    evidence_refs: Array(u64, 4),
}

fn test_verdict_accept() -> void
    effect [io:write, court:request, residual]
{
    // Accept: evidence sufficient for trust promotion
    let verdict: Verdict = Verdict{
        verdict_type: 0,
        promoted_to: 6, // Promoted
        evidence_refs: Array::splat(0),
    };

    verdict.evidence_refs[0] = 0xAAAA;
    verdict.evidence_refs[1] = 0xBBBB;

    assert(verdict.verdict_type == 0, "court: Accept verdict");
    assert(verdict.promoted_to == 6, "court: promoted to Promoted");

    // Object moves to next trust state
    // Residual chain sealed

    residual emit {
        op: "court.verdict_accept",
        promoted_to: verdict.promoted_to,
    };
}

fn test_verdict_refine() -> void
    effect [io:write, court:request, residual]
{
    // Refine: correct direction but insufficient evidence
    let verdict: Verdict = Verdict{
        verdict_type: 1,
        promoted_to: 0xFF, // no promotion
        evidence_refs: Array::splat(0),
    };

    assert(verdict.verdict_type == 1, "court: Refine verdict");
    // Object remains at current trust state
    // Specific additional evidence requested

    residual emit {
        op: "court.verdict_refine",
        request: "additional evidence needed",
    };
}

fn test_verdict_reject() -> void
    effect [io:write, court:request, residual]
{
    // Reject: behavioral divergence detected
    let verdict: Verdict = Verdict{
        verdict_type: 2,
        promoted_to: 0xFF, // no promotion
        evidence_refs: Array::splat(0),
    };

    assert(verdict.verdict_type == 2, "court: Reject verdict");
    // Object cannot be promoted
    // Object may be demoted if previously promoted

    residual emit {
        op: "court.verdict_reject",
        reason: "behavioral divergence",
    };
}

fn test_verdict_more_evidence() -> void
    effect [io:write, court:request, residual]
{
    // MoreEvidence: insufficient evidence to determine
    let verdict: Verdict = Verdict{
        verdict_type: 3,
        promoted_to: 0xFF,
        evidence_refs: Array::splat(0),
    };

    assert(verdict.verdict_type == 3, "court: MoreEvidence verdict");
    // Specific evidence types requested
    // Object stays at current state

    residual emit {
        op: "court.verdict_more_evidence",
        request: "additional evidence types needed",
    };
}

// ============================================================================
// Section 5: Trust Ladder Promotion Tests
// ============================================================================

fn test_trust_ladder_full_promotion() -> void
    effect [io:write, court:request, residual]
{
    // Full trust ladder: Unknown → Observed → Replayed → OracleCompared → ResidualStable → Sealed → Promoted
    let mut trust: u8 = 0; // Unknown

    // Step 1: Observe
    let observed: bool = true;
    if observed {
        trust = 1; // Observed
    }
    assert(trust == 1, "court: promoted to Observed");

    // Step 2: Replay
    let replayed: bool = true;
    if replayed {
        trust = 2; // Replayed
    }
    assert(trust == 2, "court: promoted to Replayed");

    // Step 3: Oracle Compare
    let oracle_compared: bool = true;
    let comparison_type: u8 = 0; // ByteIdentical
    if oracle_compared && comparison_type <= 1 { // ByteIdentical or StructurallyEquivalent
        trust = 3; // OracleCompared
    }
    assert(trust == 3, "court: promoted to OracleCompared");

    // Step 4: Residual Stable
    let stable_count: u64 = 5;
    if stable_count >= 3 {
        trust = 4; // ResidualStable
    }
    assert(trust == 4, "court: promoted to ResidualStable");

    // Step 5: Seal
    trust = 5; // Sealed
    assert(trust == 5, "court: promoted to Sealed");

    // Step 6: Full Promotion
    let final_verdict: u8 = 0; // Accept
    if final_verdict == 0 {
        trust = 6; // Promoted
    }
    assert(trust == 6, "court: promoted to Promoted");

    residual emit {
        op: "court.trust_ladder_full",
        final_trust: trust,
    };
}

fn test_trust_ladder_partial() -> void
    effect [io:write, court:request, residual]
{
    // Object may not reach full promotion
    let mut trust: u8 = 0;

    // Observation succeeds
    trust = 1;

    // Replay fails (divergence detected)
    let replay_success: bool = false;
    if !replay_success {
        // Object stays at Observed
        assert(trust == 1, "court: stuck at Observed after replay failure");
    }

    residual emit {
        op: "court.trust_ladder_partial",
        current_trust: trust,
        replay_passed: 0,
    };
}

// ============================================================================
// Section 6: Multiple Oracle Sessions Tests
// ============================================================================

fn test_multiple_oracle_sessions() -> void
    effect [io:write, court:request, residual]
{
    // An object may be evaluated by multiple oracle sessions
    // Each session strengthens trust

    let compiler_oracle_match: bool = true;
    let hardware_oracle_match: bool = true;

    // Oracle session 1: compiler version oracle
    let session1_passed: bool = compiler_oracle_match;
    assert(session1_passed, "court: compiler oracle session passed");

    // Oracle session 2: reference hardware oracle
    let session2_passed: bool = hardware_oracle_match;
    assert(session2_passed, "court: hardware oracle session passed");

    // Both oracles agree → strong trust promotion
    let both_passed: bool = session1_passed && session2_passed;
    assert(both_passed, "court: both oracle sessions agree");

    residual emit {
        op: "court.multi_oracle",
        compiler: if compiler_oracle_match { 1 } else { 0 },
        hardware: if hardware_oracle_match { 1 } else { 0 },
        both_agree: 1,
    };
}

// ============================================================================
// Section 7: Court Requirement Tests
// ============================================================================

fn test_court_requirements() -> void
    effect [io:write, court:request, residual]
{
    // For an object to be promoted, it must have:
    //   1. At least one successful replay session
    //   2. At least one successful oracle comparison (if oracle available)
    //   3. No unclassified divergences
    //   4. All residuals recorded and sealed
    //   5. Evidence chain complete and signed

    let has_replay: bool = true;
    let has_oracle: bool = true;
    let no_unclassified_divergence: bool = true;
    let residuals_sealed: bool = true;
    let evidence_chain_complete: bool = true;

    let eligible_for_promotion: bool = has_replay
        && has_oracle
        && no_unclassified_divergence
        && residuals_sealed
        && evidence_chain_complete;

    assert(eligible_for_promotion, "court: all promotion requirements met");

    // Missing one requirement → not eligible
    let missing_oracle: bool = has_replay
        && false // no oracle
        && no_unclassified_divergence
        && residuals_sealed
        && evidence_chain_complete;
    assert(!missing_oracle, "court: missing oracle → not eligible");

    residual emit {
        op: "court.requirements_check",
        all_met: if eligible_for_promotion { 1 } else { 0 },
    };
}

fn test_court_evidence_logging() -> void
    effect [io:write, court:request, residual]
{
    // Every court operation produces a residual
    let session_id: u64 = 3003;
    let operations: Array(Str(32), 6) = Array::splat(Str::from(""));
    // In a real court: "open", "submit_evidence", "run_replay", "compare", "verdict", "close"

    let expected_ops: u64 = 6;
    assert(true, "court: 6 residuals per session lifecycle");

    // Each residual records: session_id, operation, input_refs, output_refs, verdict, hash
    residual emit {
        op: "court.evidence_logging",
        session: session_id,
        residual_count: 6,
    };
}

fn test_court_residual_format() -> void
    effect [io:write, court:request, residual]
{
    // Court residuals follow a standard format:
    //   court_session_id
    //   operation: "open" | "submit_evidence" | "run_replay" | "compare" | "verdict" | "close"
    //   input_refs: list of Hash256
    //   output_refs: list of Hash256
    //   verdict: Option[VerdictType]
    //   residual_hash: Hash256
    //   timestamp

    let session_id: u64 = 4004;
    let operation: Str(16) = Str::from("verdict");
    let input_hash: u64 = 0xAAAAAAAA;
    let output_hash: u64 = 0xBBBBBBBB;
    let verdict_type: u8 = 0; // Accept
    let residual_hash: u64 = hash(session_id, input_hash, output_hash);

    assert(operation == Str::from("verdict"), "court: residual operation field");
    assert(residual_hash != 0, "court: residual hash computed");

    residual emit {
        op: "court.residual_format",
        session: session_id,
        operation: "verdict",
        input: input_hash,
        output: output_hash,
    };
}

fn test_court_promotion_denial() -> void
    effect [io:write, court:request, residual]
{
    // Object cannot be promoted if:
    //   - Replay fails
    //   - Oracle comparison is divergent
    //   - Unclassified divergences exist
    //   - Evidence chain is incomplete

    let replay_success: bool = false;
    let oracle_match: bool = true;
    let unclassified_divergence: bool = false;
    let evidence_complete: bool = true;

    let can_promote: bool = replay_success
        && oracle_match
        && !unclassified_divergence
        && evidence_complete;

    assert(!can_promote, "court: promotion denied due to replay failure");

    residual emit {
        op: "court.promotion_denial",
        reason: "replay failure",
        denied: 1,
    };
}

fn test_court_demotion_on_divergence() -> void
    effect [io:write, court:request, residual]
{
    // Previously promoted object can be demoted if new evidence shows divergence
    let current_trust: u8 = 6; // Promoted
    let new_divergence_detected: bool = true;
    let divergence_severity: u8 = 2; // high

    let demoted: u8 = if new_divergence_detected && divergence_severity >= 2 {
        2 // Replayed (demoted from Promoted)
    } else {
        current_trust
    };

    assert(demoted == 2, "court: object demoted from Promoted to Replayed");
    assert(demoted < current_trust, "court: trust level decreased");

    residual emit {
        op: "court.demotion",
        from: current_trust,
        to: demoted,
        reason: "new divergence detected",
    };
}

fn test_court_replay_with_divergence() -> void
    effect [io:write, court:request, residual]
{
    // When replay produces divergence, the court must classify it
    let replay_hash: u64 = 0x11111111;
    let original_hash: u64 = 0x22222222;

    // Divergence detected
    let diverged: bool = replay_hash != original_hash;
    assert(diverged, "court: replay divergence detected");

    // Classify divergence
    let severity: u8 = 1; // medium — optimization divergence
    let requires_investigation: bool = severity >= 1;
    assert(requires_investigation, "court: divergence requires investigation");

    residual emit {
        op: "court.replay_divergence",
        native: replay_hash,
        original: original_hash,
        severity: severity,
    };
}

fn test_court_verdict_evidence_requirements() -> void
    effect [io:write, court:request, residual]
{
    // Each verdict type requires different evidence
    // Accept: complete evidence chain, byte-identical comparison
    // Refine: partial evidence, some comparison mismatches
    // Reject: semantic divergence detected
    // MoreEvidence: insufficient data to decide

    let has_evidence: bool = true;
    let comparison_passed: bool = true;
    let no_divergence: bool = true;

    let can_accept: bool = has_evidence && comparison_passed && no_divergence;
    assert(can_accept, "court: evidence requirements for Accept verdict");

    residual emit {
        op: "court.verdict_evidence_reqs",
        can_accept: if can_accept { 1 } else { 0 },
    };
}

fn test_court_session_reopening() -> void
    effect [io:write, court:request, residual]
{
    // A closed session can be reopened with additional evidence
    let session_id: u64 = 5005;
    let reopened: bool = true;
    let additional_evidence_count: u32 = 3;

    assert(reopened, "court: session reopened with new evidence");
    assert(additional_evidence_count == 3, "court: 3 new evidence items");

    residual emit {
        op: "court.session_reopen",
        session: session_id,
        new_evidence: additional_evidence_count,
    };
}

// ============================================================================
// Main: Run all court tests
// ============================================================================

fn main() -> void
    effect [compute, io:write, io:read, court:request, residual]
{
    // Section 1: Session Lifecycle
    test_court_session_open();
    test_court_session_lifecycle();

    // Section 2: Oracle Comparison
    test_oracle_byte_identical();
    test_oracle_structurally_equivalent();
    test_oracle_divergent();

    // Section 3: Divergence Classification
    test_divergence_semantic();
    test_divergence_optimization();
    test_divergence_acceptable();

    // Section 4: Verdicts
    test_verdict_accept();
    test_verdict_refine();
    test_verdict_reject();
    test_verdict_more_evidence();

    // Section 5: Trust Ladder
    test_trust_ladder_full_promotion();
    test_trust_ladder_partial();

    // Section 6: Multiple Oracles
    test_multiple_oracle_sessions();

    // Section 7: Requirements
    test_court_requirements();

    // Section 8: Evidence Logging
    test_court_evidence_logging();
    test_court_residual_format();

    // Section 9: Promotion Control
    test_court_promotion_denial();
    test_court_demotion_on_divergence();

    // Section 10: Advanced Court Operations
    test_court_replay_with_divergence();
    test_court_verdict_evidence_requirements();
    test_court_session_reopening();

    residual emit {
        op: "court_tests.complete",
        total_sections: 10,
        status: "pass",
    };
}
