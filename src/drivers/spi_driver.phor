// spi_driver.phor — SPI driver
// Master/slave mode, clock polarity/phase, chip select, FIFO management,
// DMA transfers, SPI-NOR flash (read, write, erase, status register, SFDP),
// quad/dual SPI.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/spi_driver.phor
// Court: spi_driver:v2

package drivers.spi_driver;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type SpiError = enum {
    SpiNotInitialized          = 0x1000,
    SpiControllerNotFound      = 0x1001,
    SpiBusError                = 0x1002,
    SpiTimeout                 = 0x1003,
    SpiFifoOverflow            = 0x1004,
    SpiFifoUnderflow           = 0x1005,
    SpiModeNotSupported        = 0x1006,
    SpiCsError                 = 0x1007,
    SpiDmaError                = 0x1008,
    SpiCapabilityError         = 0x1009,
    SpiNorFlashError           = 0x100A,
    SpiNorReadError            = 0x100B,
    SpiNorWriteError           = 0x100C,
    SpiNorEraseError           = 0x100D,
    SpiNorSfdpInvalid          = 0x100E,
    SpiQuadNotSupported        = 0x100F,
    SpiDualNotSupported        = 0x1010,
    SpiInvalidDevice           = 0x1011,
    SpiSlaveModeError          = 0x1012,
    SpiMaxDevicesExceeded      = 0x1013,
    SpiResidualStoreFull       = 0x1014,
    SpiClockPolarityConflict   = 0x1015,
    SpiNorStatusError          = 0x1016,
    SpiNorWriteInProgress      = 0x1017,
    SpiNorProtectionError      = 0x1018,
}

// ─────────────────────────────────────────────────────────────
// SPI Full Capability
// ─────────────────────────────────────────────────────────────

struct SpiCapability {
    object_id: Identity,
    generation: u64,
    can_master: bool,
    can_slave: bool,
    can_dma: bool,
    can_quad: bool,
    can_dual: bool,
    can_nor_flash: bool,
    can_fifo: bool,
    max_devices: u64,
}

// ─────────────────────────────────────────────────────────────
// SPI Clock Polarity and Phase
// ─────────────────────────────────────────────────────────────

type SpiClockMode = enum {
    Mode0 = 0,
    Mode1 = 1,
    Mode2 = 2,
    Mode3 = 3,
}

// ─────────────────────────────────────────────────────────────
// SPI Chip Select
// ─────────────────────────────────────────────────────────────

type SpiCsPolarity = enum {
    ActiveLow  = 0,
    ActiveHigh = 1,
}

// ─────────────────────────────────────────────────────────────
// SPI NOR Flash Commands
// ─────────────────────────────────────────────────────────────

type SpiNorCmd = enum {
    ReadId              = 0x9F,
    ReadStatusReg1      = 0x05,
    ReadStatusReg2      = 0x35,
    ReadStatusReg3      = 0x15,
    WriteEnable         = 0x06,
    WriteDisable        = 0x04,
    ReadData            = 0x03,
    FastRead            = 0x0B,
    FastReadQuad        = 0x6B,
    QuadInputOutput     = 0xEB,
    DualRead            = 0x3B,
    PageProgram         = 0x02,
    QuadPageProgram     = 0x32,
    SectorErase4K       = 0x20,
    BlockErase32K       = 0x52,
    BlockErase64K       = 0xD8,
    ChipErase           = 0xC7,
    WriteStatusReg1     = 0x01,
    WriteStatusReg2     = 0x31,
    ReadSfdpHeader      = 0x5A,
    Enter4ByteAddr      = 0xB7,
    Exit4ByteAddr       = 0xE9,
    ReadUniqueId        = 0x4B,
    Reset               = 0x99,
    DeepPowerDown       = 0xB9,
    ReleasePowerDown    = 0xAB,
}

// ─────────────────────────────────────────────────────────────
// SPI NOR SFDP (Serial Flash Discoverable Parameters)
// ─────────────────────────────────────────────────────────────

struct SpiNorSfdpHeader {
    signature: [u8; 4],
    minor_rev: u8,
    major_rev: u8,
    num_params: u8,
    access_protocol: u8,
}

struct SpiNorSfdpParam {
    param_id: u16,
    param_minor: u8,
    param_major: u8,
    data: Array(u32, 8),
    data_len: u8,
}

// ─────────────────────────────────────────────────────────────
// SPI NOR Flash Device
// ─────────────────────────────────────────────────────────────

struct SpiNorFlash {
    vendor_id: u8,
    device_id: u8,
    capacity_bytes: u64,
    page_size: u16,
    sector_size: u32,
    block_size: u32,
    sector_count: u32,
    quad_supported: bool,
    dual_supported: bool,
    sfdp_valid: bool,
    sfdp: Array(u8, 256),
    sfdp_params: Array(SpiNorSfdpParam, 8),
    sfdp_param_count: u8,
    status_reg1: u8,
    status_reg2: u8,
    status_reg3: u8,
    write_in_progress: bool,
    write_protected: bool,
    initialized: bool,
}

// ─────────────────────────────────────────────────────────────
// SPI Device
// ─────────────────────────────────────────────────────────────

struct SpiDeviceConfig {
    chip_select: u8,
    max_speed_hz: u32,
    clock_mode: SpiClockMode,
    cs_polarity: SpiCsPolarity,
    bits_per_word: u8,
    use_dma: bool,
    use_quad: bool,
    use_dual: bool,
}

struct SpiDevice {
    device_identity: Identity,
    config: SpiDeviceConfig,
    nor_flash: SpiNorFlash,
    nor_flash_present: bool,
    transfer_in_progress: bool,
}

// ─────────────────────────────────────────────────────────────
// SPI Controller
// ─────────────────────────────────────────────────────────────

struct SpiController {
    controller_identity: Identity,
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    devices: Array(SpiDevice, 8),
    device_count: u8,
    bus_busy: bool,
    fifo_depth: u16,
    fifo_used: u16,
    supports_dma: bool,
    supports_quad: bool,
    supports_dual: bool,
    initialized: bool,
    residual_log: RingBuf(ResidualRecord, 64),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct SpiDriverState {
    driver_identity: Identity,
    controllers: Array(SpiController, 4),
    controller_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_transfers: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// SPI MMIO Helpers
// ─────────────────────────────────────────────────────────────

fn spi_mmio_read32(base: u64, offset: u64) -> u32
    effect [memory:mmio]
{
    return trusted reason "SPI MMIO register read" {
        let ptr: *(u32) = (base + offset) as *(u32);
        return *ptr;
    };
}

fn spi_mmio_write32(base: u64, offset: u64, value: u32) -> void
    effect [memory:mmio]
{
    trusted reason "SPI MMIO register write" {
        let ptr: *(u32) = (base + offset) as *(u32);
        *ptr = value;
    };
}

// ─────────────────────────────────────────────────────────────
// Wait for SPI Bus Idle
// ─────────────────────────────────────────────────────────────

fn spi_wait_idle(
    controller: Handle(SpiController),
    timeout_us: u64,
) -> Result(void, SpiError)
    effect [memory:mmio, deterministic]
    court "spi_wait_idle:v1"
{
    let status_off: u64 = 0x0C;
    loop bound 10000 {
        let status: u32 = spi_mmio_read32(controller.mmio_base, status_off);
        if (status & 0x01) == 0 {
            return Result::Ok(void);
        };
    };
    return Result::Err(SpiError::SpiTimeout);
}

// ─────────────────────────────────────────────────────────────
// SPI Transfer (Full-Duplex)
// ─────────────────────────────────────────────────────────────

fn spi_transfer(
    controller: Handle(SpiController),
    device_idx: u8,
    tx_buf: Array(u8, 256),
    rx_buf: Handle(Array(u8, 256)),
    len: u16,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(u16, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_transfer:v1"
{
    if !cap.can_master {
        return Result::Err(SpiError::SpiCapabilityError);
    };

    if (device_idx as u64) >= (controller.device_count as u64) {
        return Result::Err(SpiError::SpiInvalidDevice);
    };

    let idle_result: Result(void, SpiError) = spi_wait_idle(controller, 1000);
    match idle_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let dev: Handle(SpiDevice) = Handle(SpiDevice)::from_ptr(&controller.devices[device_idx as u64]);
    let cs_off: u64 = 0x00;
    let cs_val: u32 = 1 << dev.config.chip_select;
    if dev.config.cs_polarity == SpiCsPolarity::ActiveLow {
        spi_mmio_write32(controller.mmio_base, cs_off, !cs_val);
    } else {
        spi_mmio_write32(controller.mmio_base, cs_off, cs_val);
    };

    let data_off: u64 = 0x04;
    let mut transferred: u16 = 0;
    loop bound 256 {
        if transferred >= len {
            break;
        };
        let tx_byte: u32 = tx_buf[transferred as u64] as u32;
        spi_mmio_write32(controller.mmio_base, data_off, tx_byte);
        let rx_byte: u32 = spi_mmio_read32(controller.mmio_base, data_off);
        rx_buf.val[transferred as u64] = (rx_byte & 0xFF) as u8;
        transferred = transferred + 1;
    };

    spi_mmio_write32(controller.mmio_base, cs_off, 0xFFFFFFFF);

    controller.bus_busy = false;

    residual emit {
        op: "spi.transfer",
        device: device_idx as u64,
        len: transferred as u64,
        timestamp: timestamp,
    };

    return Result::Ok(transferred);
}

// ─────────────────────────────────────────────────────────────
// SPI DMA Transfer
// ─────────────────────────────────────────────────────────────

fn spi_dma_transfer(
    controller: Handle(SpiController),
    device_idx: u8,
    tx_phys: u64,
    rx_phys: u64,
    len: u32,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(u32, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_dma_transfer:v1"
{
    if !cap.can_dma {
        return Result::Err(SpiError::SpiCapabilityError);
    };

    let dma_tx_off: u64 = 0x10;
    let dma_rx_off: u64 = 0x18;
    let dma_len_off: u64 = 0x20;

    spi_mmio_write32(controller.mmio_base, dma_tx_off, (tx_phys & 0xFFFFFFFF) as u32);
    spi_mmio_write32(controller.mmio_base, dma_rx_off, (rx_phys & 0xFFFFFFFF) as u32);
    spi_mmio_write32(controller.mmio_base, dma_len_off, len);

    let ctrl_off: u64 = 0x24;
    spi_mmio_write32(controller.mmio_base, ctrl_off, 0x01);

    loop bound 10000 {
        let status: u32 = spi_mmio_read32(controller.mmio_base, 0x0C);
        if (status & 0x02) != 0 {
            break;
        };
    };

    residual emit {
        op: "spi.dma_transfer",
        device: device_idx as u64,
        len: len,
        timestamp: timestamp,
    };

    return Result::Ok(len);
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Read ID
// ─────────────────────────────────────────────────────────────

fn spi_nor_read_id(
    controller: Handle(SpiController),
    device_idx: u8,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(u32, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_read_id:v1"
{
    if !cap.can_nor_flash {
        return Result::Err(SpiError::SpiCapabilityError);
    };

    let tx_buf: Array(u8, 256) = [0x9F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00; 256];
    let rx_buf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());

    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, rx_buf, 4, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            let id: u32 = (rx_buf.val[1] as u32) | ((rx_buf.val[2] as u32) << 8) | ((rx_buf.val[3] as u32) << 16);
            let dev: Handle(SpiDevice) = Handle(SpiDevice)::from_ptr(&controller.devices[device_idx as u64]);
            dev.nor_flash.vendor_id = rx_buf.val[1];
            dev.nor_flash.device_id = rx_buf.val[2];
            residual emit {
                op: "spi.nor_read_id",
                device: device_idx as u64,
                vendor: rx_buf.val[1] as u64,
                device_id: rx_buf.val[2] as u64,
                timestamp: timestamp,
            };
            return Result::Ok(id);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Read Status Register
// ─────────────────────────────────────────────────────────────

fn spi_nor_read_status(
    controller: Handle(SpiController),
    device_idx: u8,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(u8, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_read_status:v1"
{
    let tx_buf: Array(u8, 256) = [0x05, 0x00; 256];
    let rx_buf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());

    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, rx_buf, 2, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            let status: u8 = rx_buf.val[1];
            let dev: Handle(SpiDevice) = Handle(SpiDevice)::from_ptr(&controller.devices[device_idx as u64]);
            dev.nor_flash.status_reg1 = status;
            dev.nor_flash.write_in_progress = (status & 0x01) != 0;
            residual emit {
                op: "spi.nor_read_status",
                device: device_idx as u64,
                status: status as u64,
                timestamp: timestamp,
            };
            return Result::Ok(status);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Write Enable
// ─────────────────────────────────────────────────────────────

fn spi_nor_write_enable(
    controller: Handle(SpiController),
    device_idx: u8,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(void, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_write_enable:v1"
{
    let tx_buf: Array(u8, 256) = [0x06; 256];
    let rx_buf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());

    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, rx_buf, 1, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "spi.nor_write_enable",
                device: device_idx as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Read Data (Normal)
// ─────────────────────────────────────────────────────────────

fn spi_nor_read_data(
    controller: Handle(SpiController),
    device_idx: u8,
    addr: u32,
    buf: Handle(Array(u8, 256)),
    length: u16,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(u16, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_read_data:v1"
{
    let tx_buf: Array(u8, 256) = Array::zeroed();
    tx_buf[0] = 0x03;
    tx_buf[1] = ((addr >> 16) & 0xFF) as u8;
    tx_buf[2] = ((addr >> 8) & 0xFF) as u8;
    tx_buf[3] = (addr & 0xFF) as u8;

    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, buf, length + 4, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "spi.nor_read_data",
                device: device_idx as u64,
                addr: addr as u64,
                length: length as u64,
                timestamp: timestamp,
            };
            return Result::Ok(length);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Page Program (Write)
// ─────────────────────────────────────────────────────────────

fn spi_nor_page_program(
    controller: Handle(SpiController),
    device_idx: u8,
    addr: u32,
    data: Array(u8, 256),
    length: u16,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(void, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_page_program:v1"
{
    let we_result: Result(void, SpiError) = spi_nor_write_enable(controller, device_idx, cap, timestamp);
    match we_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let tx_buf: Array(u8, 256) = Array::zeroed();
    tx_buf[0] = 0x02;
    tx_buf[1] = ((addr >> 16) & 0xFF) as u8;
    tx_buf[2] = ((addr >> 8) & 0xFF) as u8;
    tx_buf[3] = (addr & 0xFF) as u8;
    loop bound 256 {
        let mut i: u64 = 0;
        if i >= (length as u64) || (i + 4) >= 256 {
            break;
        };
        tx_buf[i + 4] = data[i];
        i = i + 1;
    };

    let rx_buf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());
    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, rx_buf, length + 4, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "spi.nor_page_program",
                device: device_idx as u64,
                addr: addr as u64,
                length: length as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Sector Erase (4K)
// ─────────────────────────────────────────────────────────────

fn spi_nor_sector_erase(
    controller: Handle(SpiController),
    device_idx: u8,
    addr: u32,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(void, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_sector_erase:v1"
{
    let we_result: Result(void, SpiError) = spi_nor_write_enable(controller, device_idx, cap, timestamp);
    match we_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let tx_buf: Array(u8, 256) = Array::zeroed();
    tx_buf[0] = 0x20;
    tx_buf[1] = ((addr >> 16) & 0xFF) as u8;
    tx_buf[2] = ((addr >> 8) & 0xFF) as u8;
    tx_buf[3] = (addr & 0xFF) as u8;

    let rx_buf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());
    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, rx_buf, 4, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "spi.nor_sector_erase",
                device: device_idx as u64,
                addr: addr as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Block Erase (64K)
// ─────────────────────────────────────────────────────────────

fn spi_nor_block_erase(
    controller: Handle(SpiController),
    device_idx: u8,
    addr: u32,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(void, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_block_erase:v1"
{
    let we_result: Result(void, SpiError) = spi_nor_write_enable(controller, device_idx, cap, timestamp);
    match we_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let tx_buf: Array(u8, 256) = Array::zeroed();
    tx_buf[0] = 0xD8;
    tx_buf[1] = ((addr >> 16) & 0xFF) as u8;
    tx_buf[2] = ((addr >> 8) & 0xFF) as u8;
    tx_buf[3] = (addr & 0xFF) as u8;

    let rx_buf: Handle(Array(u8, 256)) = Handle(Array(u8, 256))::from_ptr(&Array::zeroed());
    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, rx_buf, 4, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "spi.nor_block_erase",
                device: device_idx as u64,
                addr: addr as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
    };
}

// ─────────────────────────────────────────────────────────────
// NOR Flash: Read SFDP
// ─────────────────────────────────────────────────────────────

fn spi_nor_read_sfdp(
    controller: Handle(SpiController),
    device_idx: u8,
    buf: Handle(Array(u8, 256)),
    cap: SpiCapability,
    timestamp: u64,
) -> Result(void, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_nor_read_sfdp:v1"
{
    let tx_buf: Array(u8, 256) = Array::zeroed();
    tx_buf[0] = 0x5A;
    tx_buf[1] = 0x00;
    tx_buf[2] = 0x00;
    tx_buf[3] = 0x00;
    tx_buf[4] = 0x00;

    let result: Result(u16, SpiError) = spi_transfer(controller, device_idx, tx_buf, buf, 32, cap, timestamp);
    match result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {
            residual emit {
                op: "spi.nor_read_sfdp",
                device: device_idx as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
    };
}

// ─────────────────────────────────────────────
// Controller Init
// ─────────────────────────────────────────────

fn spi_controller_init(
    controller: Handle(SpiController),
    mmio_base: u64,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(void, SpiError)
    effect [memory:mmio, deterministic, residual]
    court "spi_controller_init:v1"
{
    controller.mmio_base = mmio_base;
    controller.supports_dma = cap.can_dma;
    controller.supports_quad = cap.can_quad;
    controller.supports_dual = cap.can_dual;
    controller.initialized = true;

    let ctrl_off: u64 = 0x08;
    spi_mmio_write32(controller.mmio_base, ctrl_off, 0x00);

    residual emit {
        op: "spi.controller_init",
        mmio_base: mmio_base,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Add NOR Flash Device
// ─────────────────────────────────────────────────────────────

fn spi_add_nor_device(
    controller: Handle(SpiController),
    cs: u8,
    max_speed: u32,
    clock_mode: SpiClockMode,
    cap: SpiCapability,
    timestamp: u64,
) -> Result(u8, SpiError)
    effect [deterministic, residual]
    court "spi_add_nor_device:v1"
{
    if (controller.device_count as u64) >= 8 {
        return Result::Err(SpiError::SpiMaxDevicesExceeded);
    };

    let idx: u64 = controller.device_count as u64;
    let dev: SpiDevice = SpiDevice {
        device_identity: identity_new(0x535049, timestamp, idx, cs as u64),
        config: SpiDeviceConfig {
            chip_select: cs,
            max_speed_hz: max_speed,
            clock_mode: clock_mode,
            cs_polarity: SpiCsPolarity::ActiveLow,
            bits_per_word: 8,
            use_dma: cap.can_dma,
            use_quad: cap.can_quad,
            use_dual: cap.can_dual,
        },
        nor_flash: SpiNorFlash {
            vendor_id: 0, device_id: 0, capacity_bytes: 0,
            page_size: 256, sector_size: 4096, block_size: 65536,
            sector_count: 0, quad_supported: cap.can_quad,
            dual_supported: cap.can_dual, sfdp_valid: false,
            sfdp: Array::zeroed(), sfdp_params: Array::zeroed(),
            sfdp_param_count: 0, status_reg1: 0, status_reg2: 0,
            status_reg3: 0, write_in_progress: false,
            write_protected: false, initialized: false,
        },
        nor_flash_present: true,
        transfer_in_progress: false,
    };

    controller.devices[idx] = dev;
    controller.device_count = controller.device_count + 1;

    residual emit {
        op: "spi.add_nor_device",
        cs: cs as u64,
        max_speed: max_speed,
        timestamp: timestamp,
    };

    return Result::Ok(idx as u8);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn spi_driver_init(
    driver_identity: Identity,
    cap: SpiCapability,
    timestamp: u64,
) -> SpiDriverState
    effect [deterministic, residual]
    court "spi_driver_init:v1"
{
    let state: SpiDriverState = SpiDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_transfers: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "spi.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}
