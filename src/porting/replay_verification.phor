// ============================================================================
// replay_verification.phor — Replay Verification: Execute, Compare, Report
// ============================================================================
// Replay verification re-executes candidate translations in a controlled
// environment and compares the output and behavior against the original
// caged foreign execution. Each replay produces a detailed report with
// residuals for court verification.
//
// If the replay matches, the candidate is promoted to verified.
// If it mismatches, the candidate is refined or rejected.
// ============================================================================

package "phorensic:replay_verification:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type ReplayVerificationError = enum {
    CandidateNotFound = 0x01,
    ReplayExecutionFailed = 0x02,
    ComparisonMismatch = 0x03,
    OutputHashMismatch = 0x04,
    BehaviorMismatch = 0x05,
    ResidualMismatch = 0x06,
    SequenceHashMismatch = 0x07,
    TimingVarianceExceeded = 0x08,
    MissingBaseline = 0x09,
    CandidateNotRunnable = 0x0A,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Replay Match Level
// ============================================================================

type ReplayMatchLevel = enum {
    FullMatch = 0x01,
    OutputMatch = 0x02,
    BehaviorMatch = 0x03,
    ResidualStable = 0x04,
    PartialMatch = 0x05,
    NoMatch = 0x06,
    Divergent = 0x07,
    Unknown = 0xFF,
}

// ============================================================================
// Test Case
// ============================================================================

type ReplayTestCase = struct {
    case_id: u64,
    input_hash: Hash256,
    expected_output_hash: Hash256,
    expected_behavior_hash: Hash256,
    expected_residual_hash: Hash256,
    is_selected: bool,
}

// ============================================================================
// Comparison Detail
// ============================================================================

type ReplayComparison = struct {
    comparison_id: u64,
    test_case_id: u64,
    output_match: bool,
    behavior_match: bool,
    residual_match: bool,
    actual_output_hash: Hash256,
    actual_behavior_hash: Hash256,
    actual_residual_hash: Hash256,
    timing_variance_us: u64,
    divergence_description: FixedString[512],
    match_level: ReplayMatchLevel,
}

// ============================================================================
// Replay Verification Report
// ============================================================================

type ReplayVerificationReport = struct {
    report_id: Hash256,
    candidate_id: u64,
    foreign_operation: FixedString[128],
    native_sequence_hash: Hash256,
    test_cases: Array[ReplayTestCase, 512],
    test_case_count: u64,
    comparisons: Array[ReplayComparison, 512],
    comparison_count: u64,
    total_tests: u64,
    passed_tests: u64,
    failed_tests: u64,
    overall_match_level: ReplayMatchLevel,
    overall_match: bool,
    execution_status: ReplayExecutionStatus,
    residual_bundle_hash: Hash256,
    started_at: u64,
    completed_at: u64,
    duration_us: u64,
    evidence_hashes: Array[Hash256, 32],
    evidence_count: u64,
    is_finalized: bool,
}

type ReplayExecutionStatus = enum {
    Success = 0x01,
    Partial = 0x02,
    Failed = 0x03,
    TimedOut = 0x04,
    BoundedInterrupt = 0x05,
    NotExecuted = 0x06,
}

// ============================================================================
// Replay Session
// ============================================================================

type ReplaySession = struct {
    session_id: Hash256,
    baseline_residual_hash: Hash256,
    report: ReplayVerificationReport,
    verification_count: u64,
    max_test_cases: u64,
    is_active: bool,
    generation: u64,
}

// ============================================================================
// Create Replay Session
// ============================================================================

fn create_replay_session(baseline_residual_hash: Hash256, max_test_cases: u64) -> ReplaySession
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_cases: Array[ReplayTestCase, 512] = Array[ReplayTestCase, 512]::zeroed();
    let empty_comparisons: Array[ReplayComparison, 512] = Array[ReplayComparison, 512]::zeroed();
    let empty_evidence: Array[Hash256, 32] = Array[Hash256, 32]::zeroed();

    let report: ReplayVerificationReport = ReplayVerificationReport {
        report_id: zero_hash,
        candidate_id: 0,
        foreign_operation: FixedString[128]::zeroed(),
        native_sequence_hash: zero_hash,
        test_cases: empty_cases,
        test_case_count: 0,
        comparisons: empty_comparisons,
        comparison_count: 0,
        total_tests: 0,
        passed_tests: 0,
        failed_tests: 0,
        overall_match_level: ReplayMatchLevel::Unknown,
        overall_match: false,
        execution_status: ReplayExecutionStatus::NotExecuted,
        residual_bundle_hash: zero_hash,
        started_at: 0,
        completed_at: 0,
        duration_us: 0,
        evidence_hashes: empty_evidence,
        evidence_count: 0,
        is_finalized: false,
    };

    return ReplaySession {
        session_id: zero_hash,
        baseline_residual_hash: baseline_residual_hash,
        report: report,
        verification_count: 0,
        max_test_cases: max_test_cases,
        is_active: true,
        generation: 1,
    };
}

// ============================================================================
// Generate Test Cases from Baseline
// ============================================================================
// Derives test cases from the baseline residual bundle to ensure
// comprehensive coverage of observed behavior.

fn generate_replay_test_cases(session: &mut ReplaySession, baseline_hash: Hash256) -> Result[u64, ReplayVerificationError]
    effects: [compute, residual]
{
    let max_cases: u64 = if session.max_test_cases < 512 { session.max_test_cases } else { 512 };
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    for i in 0..max_cases {
        let case_hash: Hash256 = hash_replay_combine(baseline_hash, i);

        session.report.test_cases[i] = ReplayTestCase {
            case_id: i,
            input_hash: case_hash,
            expected_output_hash: baseline_hash,
            expected_behavior_hash: baseline_hash,
            expected_residual_hash: baseline_hash,
            is_selected: true,
        };
    }
    session.report.test_case_count = max_cases;
    session.report.total_tests = max_cases;

    @emit_residual("replay_verification.generate_cases", "test_cases_generated", max_cases);

    return Ok(max_cases);
}

// ============================================================================
// Execute Replay for Candidate
// ============================================================================
// Executes a candidate translation against test cases and captures results.

fn execute_replay(session: &mut ReplaySession, candidate_sequence_hash: Hash256, candidate_id: u64, foreign_op: &FixedString[128]) -> Result[u64, ReplayVerificationError]
    effects: [compute, io, residual]
{
    session.report.candidate_id = candidate_id;
    session.report.foreign_operation = *foreign_op;
    session.report.native_sequence_hash = candidate_sequence_hash;
    session.report.started_at = kernel.tick_count();

    let mut passed: u64 = 0;
    let mut failed: u64 = 0;

    for i in 0..session.report.test_case_count {
        let test_case: ReplayTestCase = session.report.test_cases[i];

        // Simulate executing the native sequence with the test case input
        let actual_output: Hash256 = execute_native_sequence_sim(candidate_sequence_hash, test_case.input_hash);
        let actual_behavior: Hash256 = hash_replay_combine(actual_output, test_case.case_id);
        let actual_residual: Hash256 = hash_replay_combine(actual_behavior, 0);

        let output_match: bool = actual_output == test_case.expected_output_hash;
        let behavior_match: bool = actual_behavior == test_case.expected_behavior_hash;
        let residual_match: bool = actual_residual == test_case.expected_residual_hash;

        let match_level: ReplayMatchLevel;
        if output_match && behavior_match && residual_match {
            match_level = ReplayMatchLevel::FullMatch;
            passed = passed + 1;
        } elif output_match && behavior_match {
            match_level = ReplayMatchLevel::ResidualStable;
            passed = passed + 1;
        } elif output_match {
            match_level = ReplayMatchLevel::OutputMatch;
            passed = passed + 1;
        } elif behavior_match {
            match_level = ReplayMatchLevel::BehaviorMatch;
            failed = failed + 1;
        } else {
            match_level = ReplayMatchLevel::Divergent;
            failed = failed + 1;
        }

        if session.report.comparison_count < 512 {
            session.report.comparisons[i] = ReplayComparison {
                comparison_id: i,
                test_case_id: test_case.case_id,
                output_match: output_match,
                behavior_match: behavior_match,
                residual_match: residual_match,
                actual_output_hash: actual_output,
                actual_behavior_hash: actual_behavior,
                actual_residual_hash: actual_residual,
                timing_variance_us: 0,
                divergence_description: FixedString[512]::zeroed(),
                match_level: match_level,
            };
            session.report.comparison_count = i + 1;
        }
    }

    session.report.passed_tests = passed;
    session.report.failed_tests = failed;

    // Determine overall match
    if passed == session.report.total_tests {
        session.report.overall_match = true;
        session.report.overall_match_level = ReplayMatchLevel::FullMatch;
        session.report.execution_status = ReplayExecutionStatus::Success;
    } elif passed > 0 {
        session.report.overall_match = false;
        session.report.overall_match_level = ReplayMatchLevel::PartialMatch;
        session.report.execution_status = ReplayExecutionStatus::Partial;
    } else {
        session.report.overall_match = false;
        session.report.overall_match_level = ReplayMatchLevel::NoMatch;
        session.report.execution_status = ReplayExecutionStatus::Failed;
    }

    session.report.completed_at = kernel.tick_count();
    session.report.duration_us = session.report.completed_at - session.report.started_at;

    session.verification_count = session.verification_count + 1;

    @emit_residual("replay_verification.execute", "replay_executed", passed);

    return Ok(passed);
}

// ============================================================================
// Execute Native Sequence Simulation (stub)
// ============================================================================

fn execute_native_sequence_sim(sequence_hash: Hash256, input_hash: Hash256) -> Hash256
    effects: [compute]
{
    // In real implementation, this would execute the native ops.
    // For now, produce a deterministic hash.
    return hash_replay_combine(sequence_hash, input_hash);
}

// ============================================================================
// Compare Replay Results
// ============================================================================
// Produces a detailed comparison between baseline and replay execution.

fn compare_replay_results(session: &ReplaySession) -> Result[ReplayComparison, ReplayVerificationError]
    effects: [compute]
{
    if session.report.comparison_count == 0 {
        return Err(ReplayVerificationError::ComparisonMismatch);
    }

    // Aggregate all comparisons into a unified view
    let mut all_match: bool = true;
    let mut worst_level: ReplayMatchLevel = ReplayMatchLevel::FullMatch;
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    for i in 0..session.report.comparison_count {
        if !session.report.comparisons[i].output_match {
            all_match = false;
        }
        if session.report.comparisons[i].match_level > worst_level {
            worst_level = session.report.comparisons[i].match_level;
        }
    }

    return Ok(ReplayComparison {
        comparison_id: 0,
        test_case_id: 0,
        output_match: all_match,
        behavior_match: session.report.passed_tests > 0,
        residual_match: session.report.overall_match_level == ReplayMatchLevel::FullMatch,
        actual_output_hash: zero_hash,
        actual_behavior_hash: zero_hash,
        actual_residual_hash: zero_hash,
        timing_variance_us: session.report.duration_us,
        divergence_description: FixedString[512]::zeroed(),
        match_level: worst_level,
    });
}

// ============================================================================
// Finalize Replay Report
// ============================================================================

fn finalize_replay_report(session: &mut ReplaySession) -> Result[ReplayVerificationReport, ReplayVerificationError]
    effects: [compute, residual]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut report_hash: Hash256 = zero_hash;

    // Compute report hash from results
    report_hash = hash_replay_combine(report_hash, session.report.passed_tests);
    report_hash = hash_replay_combine(report_hash, session.report.failed_tests);
    report_hash = hash_replay_combine(report_hash, session.report.overall_match_level as u64);

    session.report.report_id = report_hash;
    session.report.is_finalized = true;
    session.is_active = false;

    // Add evidence
    if session.report.evidence_count < 32 {
        session.report.evidence_hashes[session.report.evidence_count] = report_hash;
        session.report.evidence_count = session.report.evidence_count + 1;
    }

    @emit_residual("replay_verification.finalize", "report_finalized", report_hash);

    return Ok(session.report);
}

// ============================================================================
// Check if Candidate Passes Replay
// ============================================================================

fn does_candidate_pass_replay(report: &ReplayVerificationReport, minimum_match: ReplayMatchLevel) -> bool
    effects: [compute]
{
    if report.execution_status == ReplayExecutionStatus::Failed {
        return false;
    }

    return report.overall_match_level as u64 <= minimum_match as u64;
}

// ============================================================================
// Get Replay Summary
// ============================================================================

type ReplaySummary = struct {
    candidate_id: u64,
    foreign_operation: FixedString[128],
    total_tests: u64,
    passed: u64,
    failed: u64,
    pass_rate: u64,
    overall_match_level: ReplayMatchLevel,
    execution_status: ReplayExecutionStatus,
    overall_match: bool,
    duration_us: u64,
    is_finalized: bool,
}

fn get_replay_summary(report: &ReplayVerificationReport) -> ReplaySummary
    effects: [compute]
{
    let pass_rate: u64 = if report.total_tests > 0 {
        (report.passed_tests * 100) / report.total_tests
    } else {
        0
    };

    return ReplaySummary {
        candidate_id: report.candidate_id,
        foreign_operation: report.foreign_operation,
        total_tests: report.total_tests,
        passed: report.passed_tests,
        failed: report.failed_tests,
        pass_rate: pass_rate,
        overall_match_level: report.overall_match_level,
        execution_status: report.execution_status,
        overall_match: report.overall_match,
        duration_us: report.duration_us,
        is_finalized: report.is_finalized,
    };
}

// ============================================================================
// Categorize Test Failures
// ============================================================================

type FailureCategory = struct {
    category: ReplayMatchLevel,
    count: u64,
    examples: Array[u64, 16],
    example_count: u64,
}

fn categorize_failures(report: &ReplayVerificationReport) -> Result[Array[FailureCategory, 6], ReplayVerificationError]
    effects: [compute]
{
    let empty: Array[FailureCategory, 6] = Array[FailureCategory, 6]::zeroed();
    let mut categories: Array[FailureCategory, 6] = empty;

    // Initialize categories
    categories[0] = FailureCategory { category: ReplayMatchLevel::OutputMatch, count: 0, examples: Array[u64, 16]::zeroed(), example_count: 0 };
    categories[1] = FailureCategory { category: ReplayMatchLevel::BehaviorMatch, count: 0, examples: Array[u64, 16]::zeroed(), example_count: 0 };
    categories[2] = FailureCategory { category: ReplayMatchLevel::ResidualStable, count: 0, examples: Array[u64, 16]::zeroed(), example_count: 0 };
    categories[3] = FailureCategory { category: ReplayMatchLevel::PartialMatch, count: 0, examples: Array[u64, 16]::zeroed(), example_count: 0 };
    categories[4] = FailureCategory { category: ReplayMatchLevel::Divergent, count: 0, examples: Array[u64, 16]::zeroed(), example_count: 0 };
    categories[5] = FailureCategory { category: ReplayMatchLevel::NoMatch, count: 0, examples: Array[u64, 16]::zeroed(), example_count: 0 };

    for i in 0..report.comparison_count {
        let comp: ReplayComparison = report.comparisons[i];

        for c in 0..6 {
            if categories[c].category == comp.match_level {
                categories[c].count = categories[c].count + 1;
                if categories[c].example_count < 16 {
                    categories[c].examples[categories[c].example_count] = comp.test_case_id;
                    categories[c].example_count = categories[c].example_count + 1;
                }
                break;
            }
        }
    }

    return Ok(categories);
}

// ============================================================================
// Hash Helpers
// ============================================================================

fn hash_replay_combine(a: Hash256, b: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut tmp: u64 = b;
    for i in 0..8 {
        result.bytes[i] = a.bytes[i] ^ ((tmp >> (i * 8)) & 0xFF) as u8;
    }
    for i in 8..32 {
        result.bytes[i] = a.bytes[i];
    }
    return result;
}

fn hash_replay_combine(a: Hash256, b: Hash256) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    return result;
}

// ============================================================================
// Aggregate Multiple Replay Sessions
// ============================================================================
// Combines results from multiple replay sessions into a unified report.

type AggregatedReplayResult = struct {
    total_sessions: u64,
    total_tests: u64,
    total_passed: u64,
    total_failed: u64,
    overall_pass_rate: u64,
    best_match_level: ReplayMatchLevel,
    worst_match_level: ReplayMatchLevel,
    is_consistent: bool,
}

fn aggregate_replay_sessions(reports: &Array[ReplayVerificationReport, 32], count: u64) -> AggregatedReplayResult
    effects: [compute]
{
    let mut total_tests: u64 = 0;
    let mut total_passed: u64 = 0;
    let mut total_failed: u64 = 0;
    let mut best: ReplayMatchLevel = ReplayMatchLevel::Divergent;
    let mut worst: ReplayMatchLevel = ReplayMatchLevel::FullMatch;
    let mut is_consistent: bool = true;

    for i in 0..count {
        total_tests = total_tests + reports[i].total_tests;
        total_passed = total_passed + reports[i].passed_tests;
        total_failed = total_failed + reports[i].failed_tests;

        if reports[i].overall_match_level as u64 < best as u64 {
            best = reports[i].overall_match_level;
        }
        if reports[i].overall_match_level as u64 > worst as u64 {
            worst = reports[i].overall_match_level;
        }
    }

    // Check consistency: all sessions should have the same match
    for i in 1..count {
        if reports[i].overall_match != reports[0].overall_match {
            is_consistent = false;
            break;
        }
    }

    let pass_rate: u64 = if total_tests > 0 { (total_passed * 100) / total_tests } else { 0 };

    return AggregatedReplayResult {
        total_sessions: count,
        total_tests: total_tests,
        total_passed: total_passed,
        total_failed: total_failed,
        overall_pass_rate: pass_rate,
        best_match_level: best,
        worst_match_level: worst,
        is_consistent: is_consistent,
    };
}

// ============================================================================
// Timing Variance Analysis
// ============================================================================
// Analyzes timing differences between baseline and replay executions.

type TimingVarianceReport = struct {
    total_comparisons: u64,
    total_variance_us: u64,
    max_variance_us: u64,
    min_variance_us: u64,
    average_variance_us: u64,
    variance_ratio: u64,
    is_timing_stable: bool,
}

fn analyze_timing_variance(report: &ReplayVerificationReport) -> TimingVarianceReport
    effects: [compute]
{
    if report.comparison_count == 0 {
        return TimingVarianceReport {
            total_comparisons: 0,
            total_variance_us: 0,
            max_variance_us: 0,
            min_variance_us: 0,
            average_variance_us: 0,
            variance_ratio: 0,
            is_timing_stable: false,
        };
    }

    let mut total_var: u64 = 0;
    let mut max_var: u64 = 0;
    let mut min_var: u64 = 18446744073709551615;  // u64::MAX

    for i in 0..report.comparison_count {
        let variance: u64 = report.comparisons[i].timing_variance_us;
        total_var = total_var + variance;
        if variance > max_var {
            max_var = variance;
        }
        if variance < min_var {
            min_var = variance;
        }
    }

    let avg_var: u64 = total_var / report.comparison_count;
    let duration: u64 = if report.duration_us > 0 { report.duration_us } else { 1 };
    let variance_ratio: u64 = (avg_var * 100) / duration;

    return TimingVarianceReport {
        total_comparisons: report.comparison_count,
        total_variance_us: total_var,
        max_variance_us: max_var,
        min_variance_us: min_var,
        average_variance_us: avg_var,
        variance_ratio: variance_ratio,
        is_timing_stable: variance_ratio < 10,
    };
}

// ============================================================================
// Check Determinism Across Multiple Runs
// ============================================================================

fn check_replay_determinism(reports: &Array[ReplayVerificationReport, 16], count: u64) -> bool
    effects: [compute]
{
    if count < 3 {
        return false;  // Need at least 3 runs for determinism check
    }

    // All reports must have the same overall match level
    let baseline: ReplayMatchLevel = reports[0].overall_match_level;

    for i in 1..count {
        if reports[i].overall_match_level != baseline {
            return false;
        }
        // Hash chains must match
        if reports[i].report_id != reports[0].report_id {
            return false;
        }
    }

    return true;
}

// ============================================================================
// Generate Replay Witness
// ============================================================================
// Produces a compact witness that can be used to verify a replay
// result without revealing the full report.

type ReplayWitness = struct {
    candidate_id: u64,
    overall_match: bool,
    match_level: ReplayMatchLevel,
    passed_count: u64,
    total_count: u64,
    witness_hash: Hash256,
}

fn generate_replay_witness(report: &ReplayVerificationReport) -> ReplayWitness
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut witness_hash: Hash256 = zero_hash;

    witness_hash = hash_replay_combine(witness_hash, report.candidate_id);
    witness_hash = hash_replay_combine(witness_hash, report.passed_tests);
    witness_hash = hash_replay_combine(witness_hash, report.failed_tests);

    return ReplayWitness {
        candidate_id: report.candidate_id,
        overall_match: report.overall_match,
        match_level: report.overall_match_level,
        passed_count: report.passed_tests,
        total_count: report.total_tests,
        witness_hash: witness_hash,
    };
}

// ============================================================================
// Serialize Report Metadata
// ============================================================================

type ReportMetadata = struct {
    report_id: Hash256,
    candidate_id: u64,
    foreign_op: FixedString[128],
    test_count: u64,
    pass_count: u64,
    execution_status: ReplayExecutionStatus,
    match_level: ReplayMatchLevel,
    duration_us: u64,
    is_finalized: bool,
    evidence_count: u64,
}

fn get_report_metadata(report: &ReplayVerificationReport) -> ReportMetadata
    effects: [compute]
{
    return ReportMetadata {
        report_id: report.report_id,
        candidate_id: report.candidate_id,
        foreign_op: report.foreign_operation,
        test_count: report.total_tests,
        pass_count: report.passed_tests,
        execution_status: report.execution_status,
        match_level: report.overall_match_level,
        duration_us: report.duration_us,
        is_finalized: report.is_finalized,
        evidence_count: report.evidence_count,
    };
}

// ============================================================================
// Replay Comparison Matrices
// ============================================================================
// Builds a matrix of comparison results across multiple test cases
// and candidates.

type ComparisonMatrix = struct {
    candidate_ids: Array[u64, 64],
    test_case_ids: Array[u64, 128],
    results: Array[Array[bool, 128], 64],  // [candidate][test_case]
    candidate_count: u64,
    test_case_count: u64,
    pass_rate_by_candidate: Array[u64, 64],
}

fn build_comparison_matrix(reports: &Array[ReplayVerificationReport, 64], report_count: u64) -> ComparisonMatrix
    effects: [compute]
{
    let mut matrix: ComparisonMatrix = ComparisonMatrix {
        candidate_ids: Array[u64, 64]::zeroed(),
        test_case_ids: Array[u64, 128]::zeroed(),
        results: Array[Array[bool, 128], 64]::zeroed(),
        candidate_count: 0,
        test_case_count: 0,
        pass_rate_by_candidate: Array[u64, 64]::zeroed(),
    };

    for i in 0..report_count {
        matrix.candidate_ids[i] = reports[i].candidate_id;
        matrix.candidate_count = i + 1;

        let mut passed: u64 = 0;
        for j in 0..reports[i].comparison_count {
            if j < 128 {
                let match_result: bool = reports[i].comparisons[j].match_level == ReplayMatchLevel::FullMatch ||
                                        reports[i].comparisons[j].match_level == ReplayMatchLevel::OutputMatch;
                matrix.results[i][j] = match_result;
                matrix.test_case_ids[j] = reports[i].comparisons[j].test_case_id;
                if match_result {
                    passed = passed + 1;
                }
            }
        }

        if i == 0 {
            matrix.test_case_count = if reports[i].comparison_count < 128 { reports[i].comparison_count } else { 128 };
        }

        let total: u64 = if reports[i].comparison_count > 0 { reports[i].comparison_count } else { 1 };
        matrix.pass_rate_by_candidate[i] = (passed * 100) / total;
    }

    return matrix;
}

// ============================================================================
// Abort and Resume Replay
// ============================================================================

fn abort_replay(session: &mut ReplaySession) -> Result<(), ReplayVerificationError>
    effects: [compute, residual]
{
    session.is_active = false;
    session.report.execution_status = ReplayExecutionStatus::BoundedInterrupt;
    @emit_residual("replay_verification.abort", "replay_aborted", session.report.passed_tests);
    return Ok(());
}

fn resume_replay(session: &mut ReplaySession) -> Result<(), ReplayVerificationError>
    effects: [compute, residual]
{
    if session.is_active {
        return Err(ReplayVerificationError::InternalError);
    }
    session.is_active = true;
    @emit_residual("replay_verification.resume", "replay_resumed", session.report.passed_tests);
    return Ok(());
}

// ============================================================================
// Verify Single Test Case
// ============================================================================

fn verify_single_case(sequence_hash: Hash256, test_input: Hash256, expected: Hash256) -> bool
    effects: [compute]
{
    let actual: Hash256 = execute_native_sequence_sim(sequence_hash, test_input);
    return actual == expected;
}

// ============================================================================
// Hash Helper: u64 from Hash256
// ============================================================================

fn u64_from_hash(h: Hash256) -> u64
    effects: [compute]
{
    let mut result: u64 = 0;
    for i in 0..8 {
        result = result | ((h.bytes[i] as u64) << (i * 8));
    }
    return result;
}
