//==============================================================================
// posix_compat.phor — POSIX Compatibility Layer
//
// Provides POSIX-compatible abstractions: file operations, process operations,
// signal operations, termios, socket operations, time operations,
// user/group database emulation, and environment variable emulation.
//
// All operations are capability-gated, bounded-loop, and residual-recorded.
//==============================================================================

module posix_compat
  @[receipt("posix-compat-v1")]
  @[audit("POSIX-COMPAT")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{syscall, alloc, unsafe, io};
use core::residual::*;
use core::mem::*;
use compat::linux_syscall::*;

//==============================================================================
// POSIX File Operations
//==============================================================================

/// POSIX file descriptor abstraction.
pub struct PosixFd(
  fd: i32,
  flags: PosixFdFlags,
  offset: i64,
  path: [u8; 256],
  type: PosixFileType,
  cap: CapabilitySlot,
) : effect:(unsafe);

pub struct PosixFdFlags(
  bits: u32,
) : effect:(pure);

const O_RDONLY: PosixFdFlags   = PosixFdFlags(0);
const O_WRONLY: PosixFdFlags   = PosixFdFlags(1);
const O_RDWR: PosixFdFlags     = PosixFdFlags(2);
const O_CREAT: PosixFdFlags    = PosixFdFlags(0x40);
const O_EXCL: PosixFdFlags     = PosixFdFlags(0x80);
const O_TRUNC: PosixFdFlags    = PosixFdFlags(0x200);
const O_APPEND: PosixFdFlags   = PosixFdFlags(0x400);
const O_NONBLOCK: PosixFdFlags = PosixFdFlags(0x800);
const O_CLOEXEC: PosixFdFlags  = PosixFdFlags(0x4000);
const O_DIRECTORY: PosixFdFlags = PosixFdFlags(0x100000);
const O_NOFOLLOW: PosixFdFlags = PosixFdFlags(0x200000);

pub enum PosixFileType : u8 {
  Regular   = 0,
  Directory = 1,
  CharDev   = 2,
  BlockDev  = 3,
  Pipe      = 4,
  Socket    = 5,
  SymLink   = 6,
  Unknown   = 7,
}

/// POSIX file stat structure.
pub struct PosixStat(
  dev: u64,
  ino: u64,
  mode: u32,
  nlink: u32,
  uid: u32,
  gid: u32,
  rdev: u64,
  size: i64,
  blksize: i64,
  blocks: i64,
  atime: u64,
  mtime: u64,
  ctime: u64,
  cap_token: u64,
) : effect:(pure);

/// Open a file with POSIX semantics.
pub fn posix_open[
  path: *u8,
  flags: PosixFdFlags,
  mode: u32,
  io_cap: CapabilitySlot,
] -> Result[i32, PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Validate capability
  let rights: CapRights = CapRights(io_cap.rights);
  if (rights & RIGHT_IO) == 0 {
    return Err(PosixError::AccessDenied);
  }

  // Translate to Phorensic syscall
  let phor_flags: u64 = translate_open_flags(flags.bits as u64);
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Open,
    [@ptr_to_int(path), phor_flags, mode as u64, 0, 0, 0],
    io_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  // Allocate a POSIX fd for the result handle
  let fd: i32 = result.result as i32;

  record_posix_residual(PosixOp::Open, fd as u64, 0);

  return Ok(fd);
}

/// Read from a file descriptor.
pub fn posix_read[
  fd: i32,
  buf: *u8,
  count: u64,
  io_cap: CapabilitySlot,
] -> Result<i64, PosixError> : (syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Read,
    [fd as u64, @ptr_to_int(buf), count, 0, 0, 0],
    io_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  record_posix_residual(PosixOp::Read, fd as u64, result.result);

  return Ok(result.result as i64);
}

/// Write to a file descriptor.
pub fn posix_write[
  fd: i32,
  buf: *u8,
  count: u64,
  io_cap: CapabilitySlot,
] -> Result<i64, PosixError> : (syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Write,
    [fd as u64, @ptr_to_int(buf), count, 0, 0, 0],
    io_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  record_posix_residual(PosixOp::Write, fd as u64, result.result);

  return Ok(result.result as i64);
}

/// Close a file descriptor.
pub fn posix_close[
  fd: i32,
  io_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Close,
    [fd as u64, 0, 0, 0, 0, 0],
    io_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  record_posix_residual(PosixOp::Close, fd as u64, 0);

  return Ok(());
}

/// Seek to a position in a file.
pub fn posix_lseek[
  fd: i32,
  offset: i64,
  whence: i32,
  io_cap: CapabilitySlot,
] -> Result<i64, PosixError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Seek,
    [fd as u64, offset as u64, whence as u64, 0, 0, 0],
    io_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(result.result as i64);
}

/// Get file status.
pub fn posix_fstat[
  fd: i32,
  stat_buf: *PosixStat,
  io_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::FStat,
    [fd as u64, @ptr_to_int(stat_buf), 0, 0, 0, 0],
    io_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(());
}

/// Duplicate a file descriptor.
pub fn posix_dup[
  old_fd: i32,
  io_cap: CapabilitySlot,
] -> Result<i32, PosixError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Phorensic: duplicate via capability copy
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::CapCopy,
    [old_fd as u64, 0, 0, 0, 0, 0],
    io_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(result.result as i32);
}

//==============================================================================
// POSIX Process Operations
//==============================================================================

const POSIX_PID_MAX: u32 = 65536;
const POSIX_PID_MAX: u32 = 65536;

/// POSIX process identifier mapping.
pub struct PosixProcess(
  pid: u32,
  ppid: u32,
  pgid: u32,
  sid: u32,
  uid: u32,
  gid: u32,
  euid: u32,
  egid: u32,
  state: ProcessStateCompat,
  exit_code: i32,
  cap: CapabilitySlot,
) : effect:(unsafe);

pub enum ProcessStateCompat : u8 {
  Running   = 0,
  Sleeping  = 1,
  Stopped   = 2,
  Zombie    = 3,
  Dead      = 4,
}

/// Emulate POSIX fork().
pub fn posix_fork[
  proc_cap: CapabilitySlot,
] -> Result<u32, PosixError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Requires process control capability
  let rights: CapRights = CapRights(proc_cap.rights);
  if (rights & RIGHT_PROC_CREATE) == 0 {
    return Err(PosixError::NotPermitted);
  }

  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Fork,
    [0, 0, 0, 0, 0, 0],
    proc_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  record_posix_residual(PosixOp::Fork, result.result, 0);
  return Ok(result.result as u32);
}

/// Emulate POSIX exec().
pub fn posix_exec[
  path: *u8,
  argv: *u8,
  envp: *u8,
  proc_cap: CapabilitySlot,
] -> Result<(), PosixError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Exec,
    [@ptr_to_int(path), @ptr_to_int(argv), @ptr_to_int(envp), 0, 0, 0],
    proc_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  record_posix_residual(PosixOp::Exec, @ptr_to_int(path), 0);
  return Ok(());
}

/// Emulate POSIX wait().
pub fn posix_wait[
  wstatus: *i32,
  options: i32,
  proc_cap: CapabilitySlot,
] -> Result<u32, PosixError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Wait,
    [@ptr_to_int(wstatus), options as u64, 0, 0, 0, 0],
    proc_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(result.result as u32);
}

/// Get POSIX process ID.
pub fn posix_getpid[] -> u32 : effect:(syscall) {
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(SyscallNumber::GetPid, [0; 6], cap)?;
  let result: SyscallReturnValue = dispatch_syscall(marshal);
  return result.result as u32;
}

/// Kill a process.
pub fn posix_kill[
  pid: u32,
  sig: i32,
  proc_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Kill,
    [pid as u64, sig as u64, 0, 0, 0, 0],
    proc_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(());
}

//==============================================================================
// POSIX Signal Operations
//==============================================================================

/// POSIX signal action structure.
pub struct PosixSigAction(
  handler: u64,
  mask: u64,
  flags: u32,
  restorer: u64,
) : effect:(pure);

/// Set up a POSIX signal handler.
pub fn posix_sigaction[
  signum: i32,
  act: *PosixSigAction,
  old_act: *PosixSigAction,
  sig_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let rights: CapRights = CapRights(sig_cap.rights);
  if (rights & RIGHT_PROC_SCHED) == 0 {
    return Err(PosixError::NotPermitted);
  }

  // Store signal handler in emulated signal table
  register_signal_handler(signum, act);

  record_posix_residual(PosixOp::Sigaction, signum as u64, 0);
  return Ok(());
}

/// Send a signal to the current process.
pub fn posix_raise[
  signum: i32,
  sig_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  return posix_kill(posix_getpid(), signum, sig_cap);
}

//==============================================================================
// POSIX Termios
//==============================================================================

/// Termios structure (subset).
pub struct Termios(
  iflag: u32,
  oflag: u32,
  cflag: u32,
  lflag: u32,
  cc: [u8; 20],
  ispeed: u32,
  ospeed: u32,
) : effect:(pure);

/// Termios ioctl operations.
pub const TCGETS: u32 = 0x5401;
pub const TCSETS: u32 = 0x5402;
pub const TCSETSW: u32 = 0x5403;
pub const TCSETSF: u32 = 0x5404;
pub const TIOCGWINSZ: u32 = 0x5413;
pub const TIOCSWINSZ: u32 = 0x5414;

/// Emulated window size structure.
pub struct Winsize(
  ws_row: u16,
  ws_col: u16,
  ws_xpixel: u16,
  ws_ypixel: u16,
) : effect:(pure);

/// Handle a termios ioctl.
pub fn termios_ioctl[
  fd: i32,
  request: u32,
  arg: u64,
  term_cap: CapabilitySlot,
] -> Result<u32, PosixError> : (syscall, unsafe)
  loop: bounded(1)
{
  match request {
    TCGETS => {
      // Return emulated termios structure
      let termios: Termios = Termios(
        iflag: 0,
        oflag: 0,
        cflag: 0x0BFC,  // typical defaults
        lflag: 0x5AF,
        cc: Default,
        ispeed: 38400,
        ospeed: 38400,
      );
      @memcpy(@int_to_ptr(arg), &termios, 44);
      return Ok(0);
    },
    TCSETS | TCSETSW | TCSETSF => {
      // Accept termios setting (simplified: no-op)
      return Ok(0);
    },
    TIOCGWINSZ => {
      let ws: Winsize = Winsize(ws_row: 24, ws_col: 80, ws_xpixel: 800, ws_ypixel: 600);
      @memcpy(@int_to_ptr(arg), &ws, 8);
      return Ok(0);
    },
    TIOCSWINSZ => {
      return Ok(0);
    },
    _ => {
      return Err(PosixError::NotSupported);
    },
  }
}

//==============================================================================
// POSIX Socket Operations
//==============================================================================

/// Socket domain constants.
pub const AF_UNIX: i32    = 1;
pub const AF_INET: i32    = 2;
pub const AF_INET6: i32   = 10;
pub const AF_PHOR: i32    = 40;  // Phorensic socket domain

/// Socket type constants.
pub const SOCK_STREAM: i32    = 1;
pub const SOCK_DGRAM: i32     = 2;
pub const SOCK_RAW: i32       = 3;
pub const SOCK_SEQPACKET: i32 = 5;

/// Create a POSIX socket.
pub fn posix_socket[
  domain: i32,
  stype: i32,
  protocol: i32,
  net_cap: CapabilitySlot,
] -> Result<i32, PosixError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let rights: CapRights = CapRights(net_cap.rights);
  if (rights & RIGHT_IPC_SEND) == 0 {
    return Err(PosixError::AccessDenied);
  }

  // Map to Phorensic channel/socket creation
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::SocketCreate,
    [domain as u64, stype as u64, protocol as u64, 0, 0, 0],
    net_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(result.result as i32);
}

/// Connect a socket.
pub fn posix_connect[
  fd: i32,
  addr: *u8,
  addrlen: u32,
  net_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::SocketConnect,
    [fd as u64, @ptr_to_int(addr), addrlen as u64, 0, 0, 0],
    net_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(());
}

/// Send data over a socket.
pub fn posix_send[
  fd: i32,
  buf: *u8,
  len: u64,
  flags: i32,
  net_cap: CapabilitySlot,
] -> Result<i64, PosixError> : (syscall, io, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::SocketSend,
    [fd as u64, @ptr_to_int(buf), len, flags as u64, 0, 0],
    net_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(result.result as i64);
}

//==============================================================================
// POSIX Time Operations
//==============================================================================

/// POSIX time structures.
pub struct Timespec(
  tv_sec: i64,
  tv_nsec: i64,
) : effect:(pure);

pub struct Timeval(
  tv_sec: i64,
  tv_usec: i64,
) : effect:(pure);

pub struct Timezone(
  tz_minuteswest: i32,
  tz_dsttime: i32,
) : effect:(pure);

/// Get current time of day.
pub fn posix_gettimeofday[
  tv: *Timeval,
  tz: *Timezone,
  time_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::ClockGetTime,
    [@ptr_to_int(tv), @ptr_to_int(tz), 0, 0, 0, 0],
    time_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(());
}

/// Sleep for a specified duration.
pub fn posix_nanosleep[
  req: *Timespec,
  rem: *Timespec,
  time_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::Nanosleep,
    [@ptr_to_int(req), @ptr_to_int(rem), 0, 0, 0, 0],
    time_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(());
}

//==============================================================================
// POSIX User/Group Database Emulation
//==============================================================================

/// POSIX passwd structure.
pub struct Passwd(
  pw_name: [u8; 32],
  pw_passwd: [u8; 32],
  pw_uid: u32,
  pw_gid: u32,
  pw_gecos: [u8; 128],
  pw_dir: [u8; 256],
  pw_shell: [u8; 256],
) : effect:(pure);

/// POSIX group structure.
pub struct Group(
  gr_name: [u8; 32],
  gr_passwd: [u8; 32],
  gr_gid: u32,
  gr_mem: [u32; 64],
  gr_mem_count: u32,
) : effect:(pure);

/// Emulated user database.
pub struct UserDatabase(
  users: [Passwd; 32],
  num_users: u32,
  groups: [Group; 16],
  num_groups: u32,
  next_uid: u32,
  next_gid: u32,
) : effect:(alloc);

/// Initialize the user/group database with default entries.
pub fn init_user_database[] -> UserDatabase : effect:(alloc) {
  var db: UserDatabase = UserDatabase(
    users: Default,
    num_users: 2,
    groups: Default,
    num_groups: 1,
    next_uid: 1000,
    next_gid: 1000,
  );

  // Root user
  db.users[0] = Passwd(
    pw_name: string_to_fixed("root\0"),
    pw_passwd: string_to_fixed("x\0"),
    pw_uid: 0,
    pw_gid: 0,
    pw_gecos: string_to_fixed("root\0"),
    pw_dir: string_to_fixed("/root\0"),
    pw_shell: string_to_fixed("/bin/phor_sh\0"),
  );

  // Default user
  db.users[1] = Passwd(
    pw_name: string_to_fixed("phor\0"),
    pw_passwd: string_to_fixed("x\0"),
    pw_uid: 1000,
    pw_gid: 1000,
    pw_gecos: string_to_fixed("Phorensic User\0"),
    pw_dir: string_to_fixed("/home/phor\0"),
    pw_shell: string_to_fixed("/bin/phor_sh\0"),
  );

  // Root group
  db.groups[0] = Group(
    gr_name: string_to_fixed("root\0"),
    gr_passwd: string_to_fixed("x\0"),
    gr_gid: 0,
    gr_mem: Default,
    gr_mem_count: 1,
  );
  db.groups[0].gr_mem[0] = 0;  // root user

  return db;
}

/// Lookup user by UID.
pub fn getpwuid[
  uid: u32,
  db: *UserDatabase,
] -> Option[Passwd] : effect:(pure)
  loop: bounded(32)
{
  for var i: u32 = 0; i < db.num_users; i += 1 {
    if db.users[i].pw_uid == uid {
      return Some(db.users[i]);
    }
  }
  return None;
}

/// Lookup user by name.
pub fn getpwnam[
  name: *u8,
  name_len: u32,
  db: *UserDatabase,
] -> Option[Passwd] : effect:(pure)
  loop: bounded(32)
{
  for var i: u32 = 0; i < db.num_users; i += 1 {
    if string_match(name, name_len, db.users[i].pw_name) {
      return Some(db.users[i]);
    }
  }
  return None;
}

/// Lookup group by GID.
pub fn getgrgid[
  gid: u32,
  db: *UserDatabase,
] -> Option[Group] : effect:(pure)
  loop: bounded(16)
{
  for var i: u32 = 0; i < db.num_groups; i += 1 {
    if db.groups[i].gr_gid == gid {
      return Some(db.groups[i]);
    }
  }
  return None;
}

//==============================================================================
// POSIX Environment Variables
//==============================================================================

/// POSIX environment variable storage.
pub struct Environment(
  vars: [EnvVar; 128],
  count: u32,
  capacity: u32,
) : effect:(alloc);

pub struct EnvVar(
  name: [u8; 64],
  value: [u8; 256],
  is_set: bool,
) : effect:(pure);

/// Initialize environment with default variables.
pub fn init_environment[] -> Environment : effect:(alloc) {
  var env: Environment = Environment(vars: Default, count: 5, capacity: 128);

  env.vars[0] = EnvVar(name: string_to_fixed("HOME\0"), value: string_to_fixed("/home/phor\0"), is_set: true);
  env.vars[1] = EnvVar(name: string_to_fixed("PATH\0"), value: string_to_fixed("/usr/bin:/bin\0"), is_set: true);
  env.vars[2] = EnvVar(name: string_to_fixed("USER\0"), value: string_to_fixed("phor\0"), is_set: true);
  env.vars[3] = EnvVar(name: string_to_fixed("SHELL\0"), value: string_to_fixed("/bin/phor_sh\0"), is_set: true);
  env.vars[4] = EnvVar(name: string_to_fixed("TERM\0"), value: string_to_fixed("xterm-256color\0"), is_set: true);

  return env;
}

/// Get environment variable.
pub fn getenv[
  name: *u8,
  name_len: u32,
  env: *Environment,
] -> Option[[u8; 256]] : effect:(pure)
  loop: bounded(128)
{
  for var i: u32 = 0; i < env.count; i += 1 {
    if env.vars[i].is_set && string_match(name, name_len, env.vars[i].name) {
      return Some(env.vars[i].value);
    }
  }
  return None;
}

/// Set environment variable.
pub fn setenv[
  name: *u8,
  name_len: u32,
  value: *u8,
  value_len: u32,
  overwrite: bool,
  env: *Environment,
] -> Result[(), PosixError> : effect:(alloc, unsafe)
  loop: bounded(128)
{
  for var i: u32 = 0; i < env.count; i += 1 {
    if env.vars[i].is_set && string_match(name, name_len, env.vars[i].name) {
      if overwrite {
        copy_string(env.vars[i].value, value, value_len);
      }
      return Ok(());
    }
  }

  if env.count >= env.capacity {
    return Err(PosixError::NoSpace);
  }

  let idx: u32 = env.count;
  copy_string(env.vars[idx].name, name, name_len);
  copy_string(env.vars[idx].value, value, value_len);
  env.vars[idx].is_set = true;
  env.count += 1;

  return Ok(());
}

/// Unset environment variable.
pub fn unsetenv[
  name: *u8,
  name_len: u32,
  env: *Environment,
] : effect:(unsafe)
  loop: bounded(128)
{
  for var i: u32 = 0; i < env.count; i += 1 {
    if env.vars[i].is_set && string_match(name, name_len, env.vars[i].name) {
      env.vars[i].is_set = false;
      return;
    }
  }
}

//==============================================================================
// POSIX Error Handling
//==============================================================================

/// POSIX error codes.
pub enum PosixError : u64 {
  Success         = 0,
  AccessDenied    = 1,
  NoEntry         = 2,
  InvalidArgument = 3,
  TooMany        = 4,
  NoSpace        = 5,
  NoMemory       = 6,
  NotPermitted   = 7,
  NotSupported   = 8,
  WouldBlock     = 9,
  Interrupted    = 10,
  BadFileDesc    = 11,
  IOError        = 12,
  NotFound       = 13,
  AlreadyExists  = 14,
  NotDir         = 15,
  IsDir          = 16,
  Again          = 17,
}

/// Convert a SyscallError to a PosixError.
pub fn posix_error_from_syscall[err: SyscallError] -> PosixError : effect:(pure) {
  match err {
    SyscallError::Success => PosixError::Success,
    SyscallError::InvalidArgument => PosixError::InvalidArgument,
    SyscallError::InvalidCapability => PosixError::BadFileDesc,
    SyscallError::InsufficientRights => PosixError::AccessDenied,
    SyscallError::BadAddress => PosixError::InvalidArgument,
    SyscallError::ResourceExhausted => PosixError::NoMemory,
    SyscallError::NotFound => PosixError::NotFound,
    SyscallError::AlreadyExists => PosixError::AlreadyExists,
    SyscallError::PermissionDenied => PosixError::NotPermitted,
    SyscallError::WouldBlock => PosixError::WouldBlock,
    SyscallError::Interrupted => PosixError::Interrupted,
    SyscallError::NotSupported => PosixError::NotSupported,
    SyscallError::CapabilityViolation => PosixError::AccessDenied,
    SyscallError::AffineViolation => PosixError::InvalidArgument,
    SyscallError::ResidualOverflow => PosixError::NoSpace,
    SyscallError::AuditFailure => PosixError::NotPermitted,
    _ => PosixError::InvalidArgument,
  }
}

//==============================================================================
// POSIX Thread Operations
//==============================================================================

/// POSIX thread identifier.
pub type PosixThread = u64;

/// Create a POSIX thread.
pub fn posix_pthread_create[
  thread: *PosixThread,
  attr: *u8,
  start_routine: u64,
  arg: *u8,
  thread_cap: CapabilitySlot,
] -> Result<(), PosixError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::CreateThread,
    [start_routine, @ptr_to_int(arg), 0, 0, 0, 0],
    thread_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  thread = result.result;
  return Ok(());
}

/// Join a POSIX thread.
pub fn posix_pthread_join[
  thread: PosixThread,
  retval: **u8,
  thread_cap: CapabilitySlot,
] -> Result[(), PosixError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let marshal: MarshaledSyscall = marshal_syscall_for_compat(
    SyscallNumber::JoinThread,
    [thread, @ptr_to_int(retval), 0, 0, 0, 0],
    thread_cap,
  )?;

  let result: SyscallReturnValue = dispatch_syscall(marshal);
  if result.error != SyscallError::Success {
    return Err(posix_error_from_syscall(result.error));
  }

  return Ok(());
}

//==============================================================================
// Utility Functions
//==============================================================================

/// POSIX operations for residual tracking.
pub enum PosixOp : u8 {
  Open      = 0,
  Close     = 1,
  Read      = 2,
  Write     = 3,
  Fork      = 4,
  Exec      = 5,
  Sigaction = 6,
  Socket    = 7,
  Connect   = 8,
  Send      = 9,
  Recv      = 10,
}

/// Record a POSIX compatibility residual.
fn record_posix_residual[op: PosixOp, arg1: u64, arg2: u64] : effect:(unsafe) {
  __posix_residual_write(op as u64, arg1, arg2);
}

fn string_to_fixed[s: *u8] -> [u8; 256] : effect:(pure) {
  var result: [u8; 256] = Default;
  for var i: u32 = 0; i < 255; i += 1 {
    result[i] = s[i];
    if s[i] == 0 { break; }
  }
  return result;
}

fn string_match[a: *u8, a_len: u32, b: [u8; 256]] -> bool : effect:(pure) {
  for var i: u32 = 0; i < a_len; i += 1 {
    if a[i] != b[i] { return false; }
    if a[i] == 0 { return true; }
  }
  return b[a_len] == 0;
}

fn copy_string[dest: [u8; 256], src: *u8, len: u32] : effect:(unsafe) {
  for var i: u32 = 0; i < 256 && i < len; i += 1 {
    dest[i] = src[i];
    if src[i] == 0 { break; }
  }
}

fn register_signal_handler[signum: i32, act: *PosixSigAction] : effect:(unsafe) {}

fn marshal_syscall_for_compat[num: SyscallNumber, args: [u64; 6], cap: CapabilitySlot] -> MarshaledSyscall : (alloc, syscall) {
  return MarshaledSyscall(number: num, args: Default, num_args: 0, caller_cap_token: 0, caller_thread_id: 0, caller_process_id: 0, timestamp: 0, generation: 0);
}

fn dispatch_syscall[m: MarshaledSyscall] -> SyscallReturnValue : (syscall, alloc, unsafe) {
  return SyscallReturnValue(result: 0, result_cap: None, error: SyscallError::NotSupported, residual_handle: 0, has_more_data: false, more_data_handle: 0, generation: 0, audit_token: 0);
}

fn __posix_residual_write[op: u64, a1: u64, a2: u64] : effect:(unsafe) {}

pub type CapRights = u64;
pub const RIGHT_IO: u64 = 1 << 0;
pub const RIGHT_PROC_CREATE: u64 = 1 << 28;
pub const RIGHT_PROC_SCHED: u64 = 1 << 30;
pub const RIGHT_IPC_SEND: u64 = 1 << 32;
pub type SyscallReturnValue = syscall_interface::SyscallReturnValue;
pub type MarshaledSyscall = syscall_interface::MarshaledSyscall;
pub type SyscallNumber = syscall_interface::SyscallNumber;
pub type SyscallError = syscall_interface::SyscallError;

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_user_database[] : effect:(pure) {
  let db: UserDatabase = init_user_database();
  assert(db.num_users == 2);
  assert(db.users[0].pw_uid == 0);
  assert(db.users[1].pw_uid == 1000);
}

@Test
pub fn test_environment[] : effect:(alloc) {
  let env: Environment = init_environment();
  assert(env.count == 5);
  assert(env.vars[0].is_set);
}

@Test
pub fn test_error_conversion[] : effect:(pure) {
  let posix_err: PosixError = posix_error_from_syscall(SyscallError::NotFound);
  assert(posix_err == PosixError::NotFound);

  let posix_err2: PosixError = posix_error_from_syscall(SyscallError::PermissionDenied);
  assert(posix_err2 == PosixError::NotPermitted);
}

@Test
pub fn test_termios_ioctl[] : effect:(unsafe) {
  let cap: CapabilitySlot = CapabilitySlot(type_tag: 0, rights: 0, value: 0, generation: 0, valid: true);
  // No crash on TCGETS
  // let result = termios_ioctl(0, TCGETS, 0, cap);
}
