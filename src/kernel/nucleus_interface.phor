    generation_at_event: u64,
    verified: bool,
}

// ─────────────────────────────────────────────────────────────
// Kernel Object Base — Every Kernel Object Carries These
// ─────────────────────────────────────────────────────────────

struct KernelObject {
    identity: Identity,
    capabilities: CapabilitySet,
    provenance: ProvenanceRecord,
    residual_history: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
    object_type: ObjectType,
    is_active: bool,
}

type ObjectType = enum {
    ProcessObject       = 0,
    ThreadObject        = 1,
    CapabilityObject    = 2,
    HandleObject        = 3,
    MemoryRegionObject  = 4,
    IpcChannelObject    = 5,
    DeviceObject        = 6,
    DriverObject        = 7,
    ContainerObject     = 8,
    PackageObject       = 9,
    GenerationObject    = 10,
    SessionObject       = 11,
    PortObject          = 12,
    StoreNodeObject     = 13,
    ServiceObject       = 14,
}

struct CapabilitySet {
    can_read: bool,
    can_write: bool,
    can_execute: bool,
    can_delete: bool,
    can_transfer: bool,
    can_delegate: bool,
    can_observe: bool,
    can_audit: bool,
    can_promote: bool,
}

// ─────────────────────────────────────────────────────────────
// Bitmap Type — Fixed-Size Bitmap
// ─────────────────────────────────────────────────────────────

struct Bitmap(size: u64) {
    data: Array(u64, size),  // actual size determined at compile time
}

impl Bitmap {
    fn new(size: u64) -> Bitmap(size) {
        let mut bm: Bitmap(size) = Bitmap(size) { data: Array::zeroed() };
        return bm;
    }

    fn set(mut self, bit: u64) -> void
        effect []
        court "bitmap:v1"
    {
        trusted reason "bit index bound-checked, array access safe" {
            if bit < self.size * 64 {
                let idx: u64 = bit / 64;
                let off: u64 = bit % 64;
                self.data[idx] = self.data[idx] | (1 << off);
            };
        }
    }

    fn clear(mut self, bit: u64) -> void
        effect []
    {
        trusted reason "bit index bound-checked, clear is safe" {
            if bit < self.size * 64 {
                let idx: u64 = bit / 64;
                let off: u64 = bit % 64;
                self.data[idx] = self.data[idx] & !(1 << off);
            };
        }
    }

    fn test(self, bit: u64) -> bool
        effect []
    {
        let idx: u64 = bit / 64;
        let off: u64 = bit % 64;
        if idx < self.size {
            let mask: u64 = 1 << off;
            return (self.data[idx] & mask) != 0;
        };
        return false;
    }
}

// ─────────────────────────────────────────────────────────────
// Ring Buffer Type — Fixed-Capacity FIFO
// ─────────────────────────────────────────────────────────────

struct RingBuf(T, N: u64) {
    data: Array(T, N),
    head: u64,
    tail: u64,
    count: u64,
}

impl RingBuf {
    fn new() -> RingBuf(T, N)
        effect []
    {
        return RingBuf(T, N) {
            data: Array::zeroed(),
            head: 0,
            tail: 0,
            count: 0,
        };
    }

    fn push(mut self, item: T) -> bool
        effect []
    {
        if self.count < N {
            self.data[self.tail] = item;
            self.tail = (self.tail + 1) % N;
            self.count = self.count + 1;
            return true;
        };
        return false;
    }

    fn pop(mut self) -> Option(T)
        effect []
    {
        if self.count > 0 {
            let item: T = self.data[self.head];
            self.head = (self.head + 1) % N;
            self.count = self.count - 1;
            return Option::Some(item);
        };
        return Option::None;
    }

    fn peek(self) -> Option(T)
        effect []
    {
        if self.count > 0 {
            return Option::Some(self.data[self.head]);
        };
        return Option::None;
    }

    fn is_empty(self) -> bool
        effect []
    {
        return self.count == 0;
    }

    fn is_full(self) -> bool
        effect []
    {
        return self.count == N;
    }

    fn capacity(self) -> u64
        effect []
    {
        return N;
    }

    fn len(self) -> u64
        effect []
    {
        return self.count;
    }
}

// ─────────────────────────────────────────────────────────────
// String Type — Fixed-Capacity String
// ─────────────────────────────────────────────────────────────

struct String(N: u64) {
    data: Array(u8, N),
    length: u64,
}

impl String {
    fn new() -> String(N)
        effect []
    {
        return String(N) {
            data: Array::zeroed(),
            length: 0,
        };
    }

    fn from_bytes(bytes: Slice(u8)) -> String(N)
        effect []
        court "string:v1"
    {
        let mut s: String(N) = String::new();
        let max_len: u64 = bytes.len();
        let copy_len: u64 = if max_len < N { max_len } else { N };
        for i in 0..copy_len {
            s.data[i] = bytes[i];
        };
        s.length = copy_len;
        return s;
    }

    fn append(mut self, byte: u8) -> bool
        effect []
    {
        if self.length < N {
            self.data[self.length] = byte;
            self.length = self.length + 1;
            return true;
        };
        return false;
    }

    fn len(self) -> u64
        effect []
    {
        return self.length;
    }

    fn capacity(self) -> u64
        effect []
    {
        return N;
    }

    fn as_slice(self) -> Slice(u8)
        effect []
    {
        return Slice::from_array(self.data, self.length);
    }
}

// ─────────────────────────────────────────────────────────────
// Identity Generation
// ─────────────────────────────────────────────────────────────

fn identity_new(creator: u64, timestamp: u64, epoch: u64, nonce: u64) -> Identity
    effect [deterministic]
    court "identity:v1"
{
    let id: Identity = Identity {
        id_hash: hash_combine(creator, timestamp, epoch, nonce),
        creation_timestamp: timestamp,
        creation_epoch: epoch,
        nonce: nonce,
        creator: creator,
    };
    return id;
}

fn identity_equal(a: Identity, b: Identity) -> bool
    effect []
{
    return a.id_hash == b.id_hash
        && a.creation_timestamp == b.creation_timestamp
        && a.creation_epoch == b.creation_epoch
        && a.nonce == b.nonce
        && a.creator == b.creator;
}

fn hash_combine(a: u64, b: u64, c: u64, d: u64) -> u64
    effect [deterministic]
{
    // Simple hash combiner: deterministic, no IO
    let h: u64 = a;
    h = h ^ (b + 0x9e3779b97f4a7c15 + (h << 6) + (h >> 2));
    h = h ^ (c + 0x9e3779b97f4a7c15 + (h << 6) + (h >> 2));
    h = h ^ (d + 0x9e3779b97f4a7c15 + (h << 6) + (h >> 2));
    return h;
}

// ─────────────────────────────────────────────────────────────
// Kernel Object Construction
// ─────────────────────────────────────────────────────────────

fn kernel_object_new(object_type: ObjectType, creator_identity: Identity, created_at: u64) -> KernelObject
    effect [deterministic]
    court "kernel_object:v1"
{
    let obj_id: Identity = identity_new(
        creator_identity.id_hash,
        created_at,
        0,
        object_type as u64,
    );

    let prov: ProvenanceRecord = ProvenanceRecord {
        creator_identity: creator_identity,
        creation_receipt_hash: 0,
        parent_identities: Array::zeroed(),
        compilation_receipt: Option::None,
        porting_receipt: Option::None,
        court_verdicts: RingBuf::new(),
    };

    let obj: KernelObject = KernelObject {
        identity: obj_id,
        capabilities: CapabilitySet {
            can_read: false,
            can_write: false,
            can_execute: false,
            can_delete: false,
            can_transfer: false,
            can_delegate: false,
            can_observe: false,
            can_audit: false,
            can_promote: false,
        },
        provenance: prov,
        residual_history: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 0,
        object_type: object_type,
        is_active: true,
    };
    return obj;
}

// ─────────────────────────────────────────────────────────────
// Mode Transition Functions
// ─────────────────────────────────────────────────────────────

fn validate_mode_transition(from: CpuMode, to: CpuMode, cap: Cap(NucleusCallCapability)) -> Result(ModeTransitionType, NucleusError)
    effect [deterministic]
    court "mode_transition:v2"
{
    // Validate capability
    if cap.generation == 0 {
        residual emit {
            op: "nucleus.capability.invalid",
            from_mode: from as u64,
            to_mode: to as u64,
            reason: "stale generation zero",
        };
        return Result::Err(NucleusError::CapabilityViolation);
    };

    // Determine transition type based on mode pair
    let transition: ModeTransitionType = match (from, to) {
        (CpuMode::UserMode, CpuMode::KernelMode) => ModeTransitionType::UserToKernel,
        (CpuMode::KernelMode, CpuMode::NucleusMode) => ModeTransitionType::KernelToNucleus,
        (CpuMode::NucleusMode, CpuMode::KernelMode) => ModeTransitionType::NucleusToKernel,
        (CpuMode::KernelMode, CpuMode::UserMode) => ModeTransitionType::KernelToUser,
        (CpuMode::IdleMode, CpuMode::KernelMode) => ModeTransitionType::WakeFromIdle,
        _ => return Result::Err(NucleusError::InvalidTransition),
    };

    // Verify capability allows this transition
    if !cap.allowed_operations.test(transition as u64) {
        residual emit {
            op: "nucleus.transition.denied",
            from_mode: from as u64,
            to_mode: to as u64,
            transition_type: transition as u64,
            reason: "capability does not include this transition",
        };
        return Result::Err(NucleusError::CapabilityViolation);
    };

    return Result::Ok(transition);
}

fn record_mode_transition(
    transition_type: ModeTransitionType,
    from_mode: CpuMode,
    to_mode: CpuMode,
    caller_identity: Identity,
    caller_cap: Cap(CapabilityToken),
    timestamp: u64,
    success: bool,
    failure_reason: Option(NucleusError),
) -> ModeTransitionRecord
    effect [deterministic, residual]
    court "mode_transition_record:v1"
{
    let residual: ResidualRecord = ResidualRecord {
        timestamp: timestamp,
        event_type: 0x01,  // mode transition
        event_data_hash: transition_type as u64,
        cause_identity: caller_identity,
        prior_state_hash: from_mode as u64,
        new_state_hash: to_mode as u64,
        delta_description: String::from_bytes(Slice(u8)::from_str(transition_describe(transition_type))),
        generation_at_event: 0,
        verified: false,
    };

    let record: ModeTransitionRecord = ModeTransitionRecord {
        transition_type: transition_type,
        from_mode: from_mode,
        to_mode: to_mode,
        caller_identity: caller_identity,
        caller_capability: caller_cap,
        transition_timestamp: timestamp,
        transition_reason: TransitionReason::SystemCall,
        residual_record: residual,
        verification_token: 0,
        transition_success: success,
        failure_reason: failure_reason,
        generation_at_transition: 0,
        integrity_measurement: 0,
    };

    // Emit residual for audit trail
    residual emit {
        op: "nucleus.mode_transition",
        transition_type: transition_type as u64,
        from_mode: from_mode as u64,
        to_mode: to_mode as u64,
        caller: caller_identity.id_hash,
        timestamp: timestamp,
        success: if success { 1 } else { 0 },
    };

    return record;
}

fn transition_describe(t: ModeTransitionType) -> Slice(u8)
    effect []
{
    let desc: String(32) = String::new();
    match t {
        ModeTransitionType::UserToKernel => desc = String::from_bytes(Slice(u8)::from_str("user->kernel")),
        ModeTransitionType::KernelToNucleus => desc = String::from_bytes(Slice(u8)::from_str("kernel->nucleus")),
        ModeTransitionType::NucleusToKernel => desc = String::from_bytes(Slice(u8)::from_str("nucleus->kernel")),
        ModeTransitionType::KernelToUser => desc = String::from_bytes(Slice(u8)::from_str("kernel->user")),
        ModeTransitionType::InterruptEntry => desc = String::from_bytes(Slice(u8)::from_str("interrupt_entry")),
        ModeTransitionType::InterruptReturn => desc = String::from_bytes(Slice(u8)::from_str("interrupt_return")),
        ModeTransitionType::TrapEntry => desc = String::from_bytes(Slice(u8)::from_str("trap_entry")),
        ModeTransitionType::ContextSwitch => desc = String::from_bytes(Slice(u8)::from_str("context_switch")),
        _ => desc = String::from_bytes(Slice(u8)::from_str("unknown_transition")),
    };
    return desc.as_slice();
}

// ─────────────────────────────────────────────────────────────
// Interrupt Dispatch
// ─────────────────────────────────────────────────────────────

fn dispatch_interrupt(
    irq: u8,
    vector: u8,
    context: MinimalCpuContext,
    timestamp: u64,
    table: Handle(Array(InterruptDescriptor, 256)),
) -> InterruptDispatchContext
    effect [io:read, deterministic, interrupt]
    court "interrupt_dispatch:v1"
{
    let mut decision: DispatchDecision = DispatchDecision::SpuriousIgnore;
    let mut handler_result: InterruptResult = InterruptResult::Unhandled;

    // Verify vector is in range
    if vector >= 256 {
        decision = DispatchDecision::HaltSystem;
        residual emit {
            op: "nucleus.interrupt.invalid_vector",
            vector: vector as u64,
            irq: irq as u64,
            decision: "halt",
        };
    } else {
        let desc: InterruptDescriptor = table[vector as u64];

        if !desc.is_masked && desc.registered_handler.is_some() {
            decision = DispatchDecision::DispatchToHandler;
            handler_result = InterruptResult::Handled;
        } else if desc.is_masked {
            decision = DispatchDecision::MaskAndContinue;
            handler_result = InterruptResult::Ignored;
        } else if desc.is_pending && !desc.shared {
            decision = DispatchDecision::SpuriousIgnore;
            handler_result = InterruptResult::Ignored;
        } else {
            decision = DispatchDecision::QueueForDeferral;
            handler_result = InterruptResult::NeedsKernelDispatch;
        };
    };

    let dispatch: InterruptDispatchContext = InterruptDispatchContext {
        irq: irq,
        vector: vector,
        saved_context: context,
        timestamp_enter: timestamp,
        dispatch_decision: decision,
        handler_result: handler_result,
        timestamp_exit: timestamp,
        residual_record: ResidualRecord {
            timestamp: timestamp,
            event_type: 0x02,  // interrupt dispatch
            event_data_hash: (irq as u64) | ((vector as u64) << 8),
            cause_identity: Identity {
                id_hash: 0,
                creation_timestamp: 0,
                creation_epoch: 0,
                nonce: 0,
                creator: irq as u64,
            },
            prior_state_hash: 0,
            new_state_hash: decision as u64,
            delta_description: String::new(),
            generation_at_event: 0,
            verified: false,
        },
    };

    return dispatch;
}

fn register_interrupt_handler(
    irq: u8,
    handler: Handle(InterruptHandler),
    capability: Cap(InterruptCapability),
    table: Handle(Array(InterruptDescriptor, 256)),
) -> Result(InterruptDescriptor, NucleusError)
    effect [io:write, deterministic]
    court "interrupt_register:v1"
{
    // Validate capability
    if !capability.can_register {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    // Validate IRQ range
    if irq >= 256 {
        return Result::Err(NucleusError::InvalidTrapVector);
    };

    // Check IRQ is in allowed set
    if !capability.allowed_irqs.test(irq as u64) {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    // Assign vector from IRQ (identity mapping for simplicity)
    let vector: u8 = irq + 32;  // IRQ 0 -> vector 32

    let desc: InterruptDescriptor = InterruptDescriptor {
        irq_number: irq,
        vector: vector,
        registered_handler: Option::Some(handler),
        handler_capability: capability,
        is_masked: false,
        is_pending: false,
        trigger_mode: TriggerMode::EdgeTriggered,
        polarity: Polarity::ActiveHigh,
        shared: false,
        residual_capture: true,
        timestamp_last_fired: 0,
        fire_count: 0,
        handler_residuals: RingBuf::new(),
    };

    table[irq as u64] = desc;

    residual emit {
        op: "nucleus.interrupt.register",
        irq: irq as u64,
        vector: vector as u64,
        handler_identity: handler.id_hash,
    };

    return Result::Ok(desc);
}

fn unregister_interrupt_handler(
    irq: u8,
    capability: Cap(InterruptCapability),
    table: Handle(Array(InterruptDescriptor, 256)),
) -> Result(InterruptDescriptor, NucleusError)
    effect [io:write, deterministic]
{
    if !capability.can_register {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    if irq >= 256 {
        return Result::Err(NucleusError::InvalidTrapVector);
    };

    let mut desc: InterruptDescriptor = table[irq as u64];
    desc.registered_handler = Option::None;
    desc.is_masked = true;
    table[irq as u64] = desc;

    residual emit {
        op: "nucleus.interrupt.unregister",
        irq: irq as u64,
    };

    return Result::Ok(desc);
}

// ─────────────────────────────────────────────────────────────
// Minimal Interrupt Handler (stub for nucleus registration)
// ─────────────────────────────────────────────────────────────

struct InterruptHandler {
    id_hash: u64,
    handler_fn: u64,      // function pointer, resolved at link time
    context_ptr: u64,      // opaque context pointer
    capability: Cap(InterruptCapability),
    residual_buffer: Handle(RingBuf(ResidualRecord, 64)),
}

// ─────────────────────────────────────────────────────────────
// Nucleus Call Gates
// ─────────────────────────────────────────────────────────────

type NucleusOperation = enum {
    QueryMachineConfig    = 0,
    ReadClock             = 1,
    WriteDebugByte        = 2,
    WriteDebugString      = 3,
    SetWatchdog           = 4,
    PetWatchdog           = 5,
    QueryWatchdog         = 6,
    IntegritySelfTest     = 7,
    ReadGenerationCounter = 8,
    HaltCpu               = 9,
    ResetCpu              = 10,
    FlushTlb              = 11,
    ReadMsr               = 12,
    WriteMsr              = 13,
    IOPortRead            = 14,
    IOPortWrite           = 15,
    MemoryBarrier         = 16,
    CpuId                 = 17,
    Hlt                   = 18,
}

struct NucleusCallResult {
    operation: NucleusOperation,
    success: bool,
    error: Option(NucleusError),
    output_values: Array(u64, 4),
    output_data: Array(u8, 256),
    duration_cycles: u64,
    residual: ResidualRecord,
}

fn nucleus_call_enter(
    op: NucleusOperation,
    args: Array(u64, 4),
    capability: Cap(NucleusCallCapability),
    caller_mode: CpuMode,
    timestamp: u64,
) -> Result(NucleusCallResult, NucleusError)
    effect [io:read, io:write, deterministic, interrupt]
    court "nucleus_call:v2"
{
    // Validate capability
    if capability.generation == 0 {
        return Result::Err(NucleusError::StaleGeneration);
    };

    if !capability.can_enter_nucleus {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    // Check operation is allowed
    if !capability.allowed_operations.test(op as u64) {
        residual emit {
            op: "nucleus.call.denied",
            operation: op as u64,
            caller: caller_mode as u64,
            reason: "operation not in allowed set",
        };
        return Result::Err(NucleusError::CapabilityViolation);
    };

    // Record the call for audit
    residual emit {
        op: "nucleus.call.enter",
        operation: op as u64,
        caller_mode: caller_mode as u64,
        timestamp: timestamp,
        arg0: args[0],
        arg1: args[1],
    };

    let result: NucleusCallResult = NucleusCallResult {
        operation: op,
        success: true,
        error: Option::None,
        output_values: Array::zeroed(),
        output_data: Array::zeroed(),
        duration_cycles: 0,
        residual: ResidualRecord {
            timestamp: timestamp,
            event_type: 0x03,
            event_data_hash: op as u64,
            cause_identity: Identity {
                id_hash: capability.object_id.id_hash,
                creation_timestamp: 0,
                creation_epoch: 0,
                nonce: 0,
                creator: 0,
            },
            prior_state_hash: 0,
            new_state_hash: 0,
            delta_description: String::new(),
            generation_at_event: 0,
            verified: false,
        },
    };

    return Result::Ok(result);
}

fn nucleus_call_exit(
    result: NucleusCallResult,
    target_mode: CpuMode,
    capability: Cap(NucleusCallCapability),
    timestamp: u64,
) -> MinimalCpuContext
    effect [deterministic]
{
    residual emit {
        op: "nucleus.call.exit",
        operation: result.operation as u64,
        target_mode: target_mode as u64,
        success: if result.success { 1 } else { 0 },
        timestamp: timestamp,
    };

    // Return a default minimal context (actual context loaded by ASM trampoline)
    let ctx: MinimalCpuContext = MinimalCpuContext {
        rax: result.success as u64,
        rbx: 0,
        rcx: result.operation as u64,
        rdx: result.error.map_or(0, |e| e as u64),
        rsi: result.output_values[0],
        rdi: result.output_values[1],
        rbp: 0,
        rsp: 0,
        rip: 0,
        rflags: 0x202,  // IF set
        cs: 0,
        ss: 0,
        error_code: 0,
        trap_number: 0,
    };
    return ctx;
}

// ─────────────────────────────────────────────────────────────
// CPU Entry Initialization
// ─────────────────────────────────────────────────────────────

fn cpu_entry_initialize(
    boot_cpu: bool,
    apic_id: u32,
    processor_index: u32,
    nucleus_base: u64,
    nucleus_size: u64,
    kernel_entry: u64,
    stack: u64,
    page_table: u64,
    gen_counter: u64,
    cap_seed: u64,
    integrity: u64,
    timestamp: u64,
    machine: MachineConfig,
) -> CpuEntryProtocol
    effect [io:write, deterministic]
    court "cpu_entry:v1"
{
    let protocol: CpuEntryProtocol = CpuEntryProtocol {
        boot_cpu: boot_cpu,
        apic_id: apic_id,
        processor_index: processor_index,
        startup_context: CpuRegisterState {
            rax: 0,
            rbx: 0,
            rcx: 0,
            rdx: 0,
            rsi: 0,
            rdi: 0,
            rbp: 0,
            rsp: stack,
            r8: 0,
            r9: 0,
            r10: 0,
            r11: 0,
            r12: 0,
            r13: 0,
            r14: 0,
            r15: 0,
            rip: kernel_entry,
            rflags: 0x202,
            cs: 0x08,        // kernel code segment
            ds: 0x10,        // kernel data segment
            es: 0x10,
            fs: 0x10,
            gs: 0x10,
            ss: 0x10,
            cr0: 0x80000001, // PE | PG
            cr2: 0,
            cr3: page_table,
            cr4: 0x20,       // PAE
            efer: 0x100,     // LME
            gdtr_base: 0,
            gdtr_limit: 0,
            idtr_base: 0,
            idtr_limit: 0,
            tr_segment: 0,
            fs_base: 0,
            gs_base: 0,
            kernel_stack: stack,
        },
        nucleus_base: nucleus_base,
        nucleus_size: nucleus_size,
        kernel_entry_point: kernel_entry,
        stack_pointer: stack,
        page_table_base: page_table,
        generation_counter: gen_counter,
        capability_seed: cap_seed,
        integrity_hash: integrity,
        boot_timestamp: timestamp,
        machine_config: machine,
    };

    residual emit {
        op: "nucleus.cpu_entry.initialize",
        boot_cpu: if boot_cpu { 1 } else { 0 },
        apic_id: apic_id as u64,
        processor_index: processor_index as u64,
        gen_counter: gen_counter,
        page_table: page_table,
        kernel_entry: kernel_entry,
    };

    return protocol;
}

// ─────────────────────────────────────────────────────────────
// Trap Handling
// ─────────────────────────────────────────────────────────────

fn handle_trap(
    vector: TrapVector,
    context: MinimalCpuContext,
    trap_table: Handle(Array(TrapDescriptor, 256)),
    timestamp: u64,
) -> TrapLeaveRecord
    effect [io:read, deterministic, interrupt]
    court "trap_handling:v1"
{
    // Check vector range
    if vector >= 256 {
        residual emit {
            op: "nucleus.trap.invalid_vector",
            vector: vector as u64,
            action: "halt",
        };
        // Return halt-level trap leave
        return TrapLeaveRecord {
            trap_vector: vector,
            caller_identity: Identity {
                id_hash: 0,
                creation_timestamp: 0,
                creation_epoch: 0,
                nonce: 0,
                creator: 0,
            },
            caller_capability_hash: 0,
            entry_context: context,
            residual_captured: false,
            residual_hash: 0,
            trap_timestamp: timestamp,
            handler_address: 0,
            handler_generation: 0,
            return_context: context,
            trapleave_duration_cycles: 0,
            transition_record: ModeTransitionRecord {
                transition_type: ModeTransitionType::TrapEntry,
                from_mode: CpuMode::UserMode,
                to_mode: CpuMode::NucleusMode,
                caller_identity: Identity {
                    id_hash: 0,
                    creation_timestamp: 0,
                    creation_epoch: 0,
                    nonce: 0,
                    creator: 0,
                },
                caller_capability: Cap(CapabilityToken)::null(),
                transition_timestamp: timestamp,
                transition_reason: TransitionReason::Exception,
                residual_record: ResidualRecord {
                    timestamp: timestamp,
                    event_type: 0x04,
                    event_data_hash: vector as u64,
                    cause_identity: Identity {
                        id_hash: 0,
                        creation_timestamp: 0,
                        creation_epoch: 0,
                        nonce: 0,
                        creator: 0,
                    },
                    prior_state_hash: 0,
                    new_state_hash: 0,
                    delta_description: String::new(),
                    generation_at_event: 0,
                    verified: false,
                },
                verification_token: 0,
                transition_success: false,
                failure_reason: Option::Some(NucleusError::InvalidTrapVector),
                generation_at_transition: 0,
                integrity_measurement: 0,
            },
        };
    };

    let desc: TrapDescriptor = trap_table[vector as u64];

    if !desc.present {
        residual emit {
            op: "nucleus.trap.not_present",
            vector: vector as u64,
            action: "halt",
        };
        return TrapLeaveRecord {
            trap_vector: vector,
            caller_identity: Identity {
                id_hash: 0, creation_timestamp: 0,
                creation_epoch: 0, nonce: 0, creator: 0,
            },
            caller_capability_hash: 0,
            entry_context: context,
            residual_captured: false,
            residual_hash: 0,
            trap_timestamp: timestamp,
            handler_address: 0,
            handler_generation: 0,
            return_context: context,
            trapleave_duration_cycles: 0,
            transition_record: ModeTransitionRecord {
                transition_type: ModeTransitionType::TrapEntry,
                from_mode: CpuMode::UserMode,
                to_mode: CpuMode::NucleusMode,
                caller_identity: Identity {
                    id_hash: 0, creation_timestamp: 0,
                    creation_epoch: 0, nonce: 0, creator: 0,
                },
                caller_capability: Cap(CapabilityToken)::null(),
                transition_timestamp: timestamp,
                transition_reason: TransitionReason::Exception,
                residual_record: ResidualRecord {
                    timestamp: timestamp,
                    event_type: 0x04,
                    event_data_hash: vector as u64,
                    cause_identity: Identity {
                        id_hash: 0, creation_timestamp: 0,
                        creation_epoch: 0, nonce: 0, creator: 0,
                    },
                    prior_state_hash: 0,
                    new_state_hash: 0,
                    delta_description: String::new(),
                    generation_at_event: 0,
                    verified: false,
                },
                verification_token: 0,
                transition_success: false,
                failure_reason: Option::Some(NucleusError::TrapNotRegistered),
                generation_at_transition: 0,
                integrity_measurement: 0,
            },
        };
    };

    // Capture residual
    let residual: ResidualRecord = ResidualRecord {
        timestamp: timestamp,
        event_type: 0x04,
        event_data_hash: vector as u64,
        cause_identity: Identity {
            id_hash: context.cs,
            creation_timestamp: 0, creation_epoch: 0,
            nonce: context.rip, creator: context.rax,
        },
        prior_state_hash: context.rflags,
        new_state_hash: desc.handler_address,
        delta_description: String::from_bytes(Slice(u8)::from_str("trap_dispatched")),
        generation_at_event: 0,
        verified: false,
    };

    let leave: TrapLeaveRecord = TrapLeaveRecord {
        trap_vector: vector,
        caller_identity: Identity {
            id_hash: context.cs,
            creation_timestamp: 0, creation_epoch: 0,
            nonce: context.rip, creator: context.rax,
        },
        caller_capability_hash: desc.handler_capability.object_id.id_hash,
        entry_context: context,
        residual_captured: true,
        residual_hash: residual.event_data_hash,
        trap_timestamp: timestamp,
        handler_address: desc.handler_address,
        handler_generation: 0,
        return_context: context,
        trapleave_duration_cycles: 0,
        transition_record: ModeTransitionRecord {
            transition_type: ModeTransitionType::TrapEntry,
            from_mode: CpuMode::UserMode,
            to_mode: CpuMode::NucleusMode,
            caller_identity: Identity {
                id_hash: context.cs, creation_timestamp: 0,
                creation_epoch: 0, nonce: context.rip, creator: context.rax,
            },
            caller_capability: Cap(CapabilityToken)::null(),
            transition_timestamp: timestamp,
            transition_reason: TransitionReason::Exception,
            residual_record: residual,
            verification_token: 0,
            transition_success: true,
            failure_reason: Option::None,
            generation_at_transition: 0,
            integrity_measurement: 0,
        },
    };

    // Emit trap residual
    residual emit {
        op: "nucleus.trap.handled",
        vector: vector as u64,
        handler_address: desc.handler_address,
        error_code: context.error_code,
        timestamp: timestamp,
    };

    return leave;
}

// ─────────────────────────────────────────────────────────────
// Debug Output Functions
// ─────────────────────────────────────────────────────────────

fn debug_write_byte(
    byte: u8,
    port: Handle(DebugOutputPort),
    cap: Cap(DebugOutputCapability),
) -> Result(void, NucleusError)
    effect [io:write, deterministic]
    court "debug_output:v1"
{
    if !cap.can_write_byte {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    trusted reason "serial output at fixed MMIO address verified by hardware manual" {
        // write byte via nucleus ASM trampoline at port.port_address
    };

    residual emit {
        op: "nucleus.debug.write_byte",
        byte: byte as u64,
        port_type: port.port_type as u64,
    };

    return Result::Ok(void);
}

fn debug_write_string(
    data: Slice(u8),
    port: Handle(DebugOutputPort),
    cap: Cap(DebugOutputCapability),
) -> Result(void, NucleusError)
    effect [io:write, deterministic]
{
    if !cap.can_write_string {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    let len: u64 = data.len();
    for i in 0..len {
        let byte: u8 = data[i];
        // write byte via nucleus
    };

    residual emit {
        op: "nucleus.debug.write_string",
        length: len,
        port_type: port.port_type as u64,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Watchdog Functions
// ─────────────────────────────────────────────────────────────

fn watchdog_set(
    interval_ms: u64,
    capability: Cap(WatchdogCapability),
) -> Result(WatchdogState, NucleusError)
    effect [io:write, deterministic]
    court "watchdog:v1"
{
    if !capability.can_set {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    if interval_ms < capability.min_interval_ms || interval_ms > capability.max_interval_ms {
        return Result::Err(NucleusError::InvalidTransition);
    };

    let state: WatchdogState = WatchdogState {
        enabled: true,
        interval_ms: interval_ms,
        remaining_ms: interval_ms,
        last_pet_timestamp: 0,
        pet_count: 0,
        expiry_count: 0,
        expiry_action: WatchdogExpiryAction::CaptureResidualAndContinue,
        capability: capability,
        residual_record: ResidualRecord {
            timestamp: 0,
            event_type: 0x05,
            event_data_hash: interval_ms,
            cause_identity: Identity {
                id_hash: capability.object_id.id_hash,
                creation_timestamp: 0, creation_epoch: 0,
                nonce: 0, creator: 0,
            },
            prior_state_hash: 0,
            new_state_hash: interval_ms,
            delta_description: String::from_bytes(Slice(u8)::from_str("watchdog_set")),
            generation_at_event: 0,
            verified: false,
        },
    };

    residual emit {
        op: "nucleus.watchdog.set",
        interval_ms: interval_ms,
    };

    return Result::Ok(state);
}

fn watchdog_pet(
    state: Handle(WatchdogState),
    capability: Cap(WatchdogCapability),
    timestamp: u64,
) -> Result(void, NucleusError)
    effect [io:write, deterministic]
{
    if !capability.can_pet {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    state.remaining_ms = state.interval_ms;
    state.last_pet_timestamp = timestamp;
    state.pet_count = state.pet_count + 1;

    residual emit {
        op: "nucleus.watchdog.pet",
        pet_count: state.pet_count,
        remaining_ms: state.remaining_ms,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Integrity Self-Test
// ─────────────────────────────────────────────────────────────

fn nucleus_integrity_self_test(
    nucleus_base: u64,
    nucleus_size: u64,
    stored_hash: u64,
) -> Result(u64, NucleusError)
    effect [deterministic]
    court "integrity:v1"
{
    let mut measured_hash: u64 = 0;
    let word_count: u64 = nucleus_size / 8;
    let words: Slice(u64) = Slice(u64)::from_raw(nucleus_base, word_count);

    // Bounded loop over nucleus code
    for i in 0..word_count {
        let word: u64 = words[i];
        measured_hash = measured_hash ^ (word + 0x9e3779b97f4a7c15 + (measured_hash << 6) + (measured_hash >> 2));
    };

    if measured_hash != stored_hash {
        residual emit {
            op: "nucleus.integrity.failure",
            measured_hash: measured_hash,
            stored_hash: stored_hash,
        };
        return Result::Err(NucleusError::IntegrityFailure);
    };

    residual emit {
        op: "nucleus.integrity.pass",
        hash: measured_hash,
    };

    return Result::Ok(measured_hash);
}

// ─────────────────────────────────────────────────────────────
// Generation Counter Access
// ─────────────────────────────────────────────────────────────

fn read_generation_counter(
    counter_ptr: Handle(u64),
    capability: Cap(NucleusCallCapability),
) -> Result(u64, NucleusError)
    effect [deterministic]
    court "generation_counter:v1"
{
    if !capability.can_query_state {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    let counter: u64 = counter_ptr.value;
    return Result::Ok(counter);
}

fn increment_generation_counter(
    counter_ptr: Handle(u64),
    capability: Cap(NucleusCallCapability),
) -> Result(u64, NucleusError)
    effect [io:write, deterministic]
{
    if !capability.can_enter_nucleus {
        return Result::Err(NucleusError::CapabilityViolation);
    };

    counter_ptr.value = counter_ptr.value + 1;
    let new_val: u64 = counter_ptr.value;

    residual emit {
        op: "nucleus.generation_counter.increment",
        new_value: new_val,
    };

    return Result::Ok(new_val);
}

// ─────────────────────────────────────────────────────────────
// Mode Transition Validation Table
// ─────────────────────────────────────────────────────────────

struct TransitionRule {
    from: CpuMode,
    to: CpuMode,
    allowed: bool,
    requires_capability: bool,
    cap_type: CapabilityTokenType,
    residual_on_entry: bool,
    residual_on_exit: bool,
}

fn get_transition_rules() -> Array(TransitionRule, 12)
    effect [deterministic]
{
    let rules: Array(TransitionRule, 12) = Array(TransitionRule, 12) {
        data: [
            TransitionRule { from: CpuMode::UserMode, to: CpuMode::KernelMode, allowed: true, requires_capability: true, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::KernelMode, to: CpuMode::NucleusMode, allowed: true, requires_capability: true, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::NucleusMode, to: CpuMode::KernelMode, allowed: true, requires_capability: false, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: false, residual_on_exit: true },
            TransitionRule { from: CpuMode::KernelMode, to: CpuMode::UserMode, allowed: true, requires_capability: false, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: false, residual_on_exit: true },
            TransitionRule { from: CpuMode::UserMode, to: CpuMode::NucleusMode, allowed: false, requires_capability: true, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::NucleusMode, to: CpuMode::UserMode, allowed: false, requires_capability: true, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::KernelMode, to: CpuMode::KernelMode, allowed: true, requires_capability: false, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::IdleMode, to: CpuMode::KernelMode, allowed: true, requires_capability: false, cap_type: CapabilityTokenType::InterruptToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::KernelMode, to: CpuMode::IdleMode, allowed: true, requires_capability: true, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::UserMode, to: CpuMode::UserMode, allowed: true, requires_capability: false, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: false, residual_on_exit: false },
            TransitionRule { from: CpuMode::SystemManagementMode, to: CpuMode::NucleusMode, allowed: true, requires_capability: true, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
            TransitionRule { from: CpuMode::NucleusMode, to: CpuMode::SystemManagementMode, allowed: true, requires_capability: true, cap_type: CapabilityTokenType::NucleusCallToken, residual_on_entry: true, residual_on_exit: true },
        ],
    };
    return rules;
}

// ─────────────────────────────────────────────────────────────
// Interrupt Descriptor Table Initialization
// ─────────────────────────────────────────────────────────────

fn idt_init() -> Array(TrapDescriptor, 256)
    effect [deterministic]
    court "idt_init:v1"
{
    let mut idt: Array(TrapDescriptor, 256) = Array::zeroed();
    for i in 0..256 {
        idt[i] = TrapDescriptor {
            vector: i as TrapVector,
            handler_type: TrapHandlerType::InterruptGate,
            handler_address: 0,
            handler_capability: Cap(TrapHandlerCapability)::null(),
            stack_switch: false,
            ist_index: 0,
            present: false,
            dpl: 0,
            residual_after_trap: true,
        };
    };
    return idt;
}

// ─────────────────────────────────────────────────────────────
// Interrupt Descriptor Initialization
// ─────────────────────────────────────────────────────────────

fn interrupt_table_init() -> Array(InterruptDescriptor, 256)
    effect [deterministic]
{
    let mut table: Array(InterruptDescriptor, 256) = Array::zeroed();
    for i in 0..256 {
        table[i] = InterruptDescriptor {
            irq_number: i as u8,
            vector: i as TrapVector,
            registered_handler: Option::None,
            handler_capability: Cap(InterruptCapability)::null(),
            is_masked: true,
            is_pending: false,
            trigger_mode: TriggerMode::EdgeTriggered,
            polarity: Polarity::ActiveHigh,
            shared: false,
            residual_capture: true,
            timestamp_last_fired: 0,
            fire_count: 0,
            handler_residuals: RingBuf::new(),
        };
    };
    return table;
}

// ─────────────────────────────────────────────────────────────
// Option and Result Helper Functions
// ─────────────────────────────────────────────────────────────

impl Option(T) {
    fn is_some(self) -> bool
        effect []
    {
        match self {
            Option::Some(_) => return true,
            Option::None => return false,
        };
    }

    fn is_none(self) -> bool
        effect []
    {
        match self {
            Option::Some(_) => return false,
            Option::None => return true,
        };
    }

    fn map_or(self, default: U, f: fn(T) -> U) -> U
        effect [..]
    {
        match self {
            Option::Some(val) => return f(val),
            Option::None => return default,
        };
    }

    fn unwrap(self) -> T
        effect []
    {
        match self {
            Option::Some(val) => return val,
            Option::None => return T::default(),
        };
    }
}

impl Cap(T) {
    fn null() -> Cap(T)
        effect []
    {
        return Cap(T) { object_id: Identity { id_hash: 0, creation_timestamp: 0, creation_epoch: 0, nonce: 0, creator: 0 }, generation: 0 };
    }
}

impl Result(T, E) {
    fn is_ok(self) -> bool
        effect []
    {
        match self {
            Result::Ok(_) => return true,
            Result::Err(_) => return false,
        };
    }

    fn is_err(self) -> bool
        effect []
    {
        match self {
            Result::Ok(_) => return false,
            Result::Err(_) => return true,
        };
    }
}

// ─────────────────────────────────────────────────────────────
// Slice Helper Extensions
// ─────────────────────────────────────────────────────────────

impl Slice(u8) {
    fn from_str(s: Slice(u8)) -> Slice(u8)
        effect []
    {
        return s;
    }

    fn from_array(arr: Array(u8, N), len: u64) -> Slice(u8)
        effect []
    {
        // Create a slice view over the array data
        return Slice(u8)::from_raw(arr.base_ptr(), len);
    }
}

impl Slice(u64) {
    fn from_raw(base: u64, len: u64) -> Slice(u64)
        effect []
    {
        return Slice(u64) { base: base, length: len };
    }
}
