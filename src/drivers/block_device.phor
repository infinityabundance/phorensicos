// block_device.phor — NVMe/AHCI block device driver
// DMA-capable block I/O with residual recording
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/block_device.phor
// Court: block_driver:v2

package drivers.block_device;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type BlockError = enum {
    BlockNotInitialized     = 0xF0,  // E00F0: block driver not initialized
    BlockDeviceNotFound     = 0xF1,  // E00F1: block device not found
    BlockReadError          = 0xF2,  // E00F2: block read operation failed
    BlockWriteError         = 0xF3,  // E00F3: block write operation failed
    BlockInvalidLba         = 0xF4,  // E00F4: invalid logical block address
    BlockInvalidSize        = 0xF5,  // E00F5: invalid block count
    BlockCapabilityError    = 0xF6,  // E00F6: insufficient capability
    BlockDmaError           = 0xF7,  // E00F7: DMA transfer error
    BlockTimeout            = 0xF8,  // E00F8: I/O operation timeout
    BlockQueueFull          = 0xF9,  // E00F9: command queue full
    BlockControllerError    = 0xFA,  // E00FA: controller error
    BlockMediaError         = 0xFB,  // E00FB: media error (bad sector)
    BlockNcmError           = 0xFC,  // E00FC: NCM (NVMe) error
    BlockInterruptError     = 0xFD,  // E00FD: interrupt handling error
    BlockPowerStateError    = 0xFE,  // E00FE: device power state error
    BlockAbort              = 0xFF,  // E00FF: I/O was aborted
}

// ─────────────────────────────────────────────────────────────
// Block Device Types
// ─────────────────────────────────────────────────────────────

type BlockDeviceType = enum {
    Unknown     = 0,
    Nvme        = 1,  // NVM Express
    Ahci        = 2,  // AHCI/SATA
    VirtioBlk   = 3,  // Virtio Block
    AtaPio      = 4,  // ATA PIO (legacy)
    RamDisk     = 5,  // Memory-backed block device
    LoopDevice  = 6,  // Loop device
}

// ─────────────────────────────────────────────────────────────
// Block Device Information
// ─────────────────────────────────────────────────────────────

struct BlockDeviceInfo {
    device_type: BlockDeviceType,
    block_size: u64,
    block_count: u64,
    max_transfer: u64,  // Maximum blocks per I/O command
    serial_number: String(32),
    model_number: String(64),
    firmware_revision: String(16),
    pci_vendor: u16,
    pci_device: u16,
    pci_bus: u8,
    pci_device_fn: u8,
    capabilities: BlockDeviceCap,
}

struct BlockDeviceCap {
    dma_supported: bool,
    trim_supported: bool,
    flush_supported: bool,
    power_management: bool,
    write_protected: bool,
    removable: bool,
    nvme_queues: u64,
    ahci_ports: u64,
}

// ─────────────────────────────────────────────────────────────
// Block I/O Command
// ─────────────────────────────────────────────────────────────

struct BlockIoCommand {
    command_type: BlockIoType,
    lba: u64,
    block_count: u64,
    data_buffer: u64,       // Physical address of data buffer
    data_buffer_size: u64,
    dma_region: u64,         // DMA region handle
    callback: u64,           // Completion callback address
    callback_context: u64,   // Opaque context for callback
    command_tag: u64,        // Unique command identifier
    timestamp_submit: u64,
    timestamp_complete: u64,
    status: BlockIoStatus,
    error_detail: u64,
    residual: ResidualRecord,
}

type BlockIoType = enum {
    Read            = 0,
    Write           = 1,
    Flush           = 2,
    Trim            = 3,
    Identify        = 4,
    ReadCapacity    = 5,
    SecuritySend    = 6,
    SecurityReceive = 7,
    NvmeAdmin      = 8,
    NvmeIo         = 9,
}

type BlockIoStatus = enum {
    Pending         = 0,
    Submitted       = 1,
    InFlight        = 2,
    Completed       = 3,
    Error           = 4,
    Aborted         = 5,
    Timeout         = 6,
}

// ─────────────────────────────────────────────────────────────
// NVMe Queue Pair
// ─────────────────────────────────────────────────────────────

struct NvmeQueuePair {
    admin_submission: Array(NvmeCommand, 64),
    admin_completion: Array(NvmeCompletion, 64),
    io_submission: Array(NvmeCommand, 256),
    io_completion: Array(NvmeCompletion, 256),
    admin_sq_tail: u64,
    admin_cq_head: u64,
    io_sq_tail: u64,
    io_cq_head: u64,
    admin_sq_phys: u64,
    admin_cq_phys: u64,
    io_sq_phys: u64,
    io_cq_phys: u64,
    doorbell_admin_sq: u64,
    doorbell_admin_cq: u64,
    doorbell_io_sq: u64,
    doorbell_io_cq: u64,
    io_queue_depth: u64,
    initialized: bool,
}

struct NvmeCommand {
    cdw0: u32,
    cdw1: u32,
    cdw2: u32,
    cdw3: u32,
    cdw4: u32,
    cdw5: u32,
    cdw6: u32,
    cdw7: u32,
    cdw8: u32,
    cdw9: u32,
    cdw10: u32,
    cdw11: u32,
    cdw12: u32,
    cdw13: u32,
    cdw14: u32,
    cdw15: u32,
    metadata_ptr: u64,
    data_ptr1: u64,
    data_ptr2: u64,
    command_id: u16,
}

struct NvmeCompletion {
    command_id: u16,
    status_field: u32,
    status_code: u8,
    status_code_type: u8,
    more: bool,
    phase_tag: bool,
    result: u32,
    sq_head_ptr: u16,
    sq_identifier: u16,
}

// ─────────────────────────────────────────────────────────────
// Block Device State
// ─────────────────────────────────────────────────────────────

struct BlockDevice {
    device_id: Identity,
    device_info: BlockDeviceInfo,
    mmio_base: u64,
    mmio_size: u64,
    capability: Cap(BlockCapability),
    command_queue: RingBuf(BlockIoCommand, 256),
    pending_commands: Array(BlockIoCommand, 64),
    pending_count: u64,
    completed_commands: RingBuf(BlockIoCommand, 64),
    nvme_qp: NvmeQueuePair,
    interrupt_registered: bool,
    interrupt_handler: u64,
    initialized: bool,
    connected: bool,
    read_count: u64,
    write_count: u64,
    error_count: u64,
    total_bytes_read: u64,
    total_bytes_written: u64,
    last_activity: u64,
    residual_log: RingBuf(ResidualRecord, 128),
    trust_state: TrustState,
    generation: u64,
}

struct BlockCapability {
    object_id: Identity,
    generation: u64,
    can_read: bool,
    can_write: bool,
    can_trim: bool,
    can_flush: bool,
    can_identify: bool,
    max_io_size: u64,
    dma_allowed: bool,
}

// ─────────────────────────────────────────────────────────────
// Block Driver State
// ─────────────────────────────────────────────────────────────

struct BlockDriverState {
    devices: Array(BlockDevice, 8),
    device_count: u64,
    driver_identity: Identity,
    default_cap: Cap(BlockCapability),
    initialized: bool,
    initialization_timestamp: u64,
    total_io_operations: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    dma_region_base: u64,
    dma_region_size: u64,
}

// ─────────────────────────────────────────────────────────────
// Block Driver Initialization
// ─────────────────────────────────────────────────────────────

fn block_driver_init(
    driver_identity: Identity,
    cap: Cap(BlockCapability),
    dma_base: u64,
    dma_size: u64,
    timestamp: u64,
) -> BlockDriverState
    effect [memory:mmio, deterministic, residual]
    court "block_driver_init:v1"
{
    let state: BlockDriverState = BlockDriverState {
        devices: Array::zeroed(),
        device_count: 0,
        driver_identity: driver_identity,
        default_cap: cap,
        initialized: true,
        initialization_timestamp: timestamp,
        total_io_operations: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        dma_region_base: dma_base,
        dma_region_size: dma_size,
    };

    residual emit {
        op: "block_driver.init",
        driver_identity: driver_identity.id_hash,
        dma_base: dma_base,
        dma_size: dma_size,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Probe NVMe Device
// ─────────────────────────────────────────────────────────────

fn block_probe_nvme(
    state: Handle(BlockDriverState),
    mmio_base: u64,
    pci_vendor: u16,
    pci_device: u16,
    pci_bus: u8,
    pci_devfn: u8,
    probe_cap: Cap(BlockCapability),
    timestamp: u64,
) -> Result(Identity, BlockError)
    effect [memory:mmio, deterministic, residual]
    court "block_probe_nvme:v1"
{
    if !state.initialized {
        return Result::Err(BlockError::BlockNotInitialized);
    };

    if state.device_count >= 8 {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    // Read NVMe capabilities from MMIO registers
    // Simplified: in a real driver, this would read CAP, VS, etc.

    let device_id: Identity = identity_new(
        0x424C_4B,  // "BLK"
        timestamp,
        state.device_count as u64,
        pci_vendor as u64,
    );

    let info: BlockDeviceInfo = BlockDeviceInfo {
        device_type: BlockDeviceType::Nvme,
        block_size: 512,
        block_count: 0,   // Would be read from identify
        max_transfer: 256,
        serial_number: String::from_bytes(Slice(u8)::from_str("NVME-SIM-0001")),
        model_number: String::from_bytes(Slice(u8)::from_str("Phorensic NVMe Simulator")),
        firmware_revision: String::from_bytes(Slice(u8)::from_str("1.0")),
        pci_vendor: pci_vendor,
        pci_device: pci_device,
        pci_bus: pci_bus,
        pci_device_fn: pci_devfn,
        capabilities: BlockDeviceCap {
            dma_supported: true,
            trim_supported: true,
            flush_supported: true,
            power_management: false,
            write_protected: false,
            removable: false,
            nvme_queues: 2,
            ahci_ports: 0,
        },
    };

    let qp: NvmeQueuePair = NvmeQueuePair {
        admin_submission: Array::zeroed(),
        admin_completion: Array::zeroed(),
        io_submission: Array::zeroed(),
        io_completion: Array::zeroed(),
        admin_sq_tail: 0,
        admin_cq_head: 0,
        io_sq_tail: 0,
        io_cq_head: 0,
        admin_sq_phys: 0,
        admin_cq_phys: 0,
        io_sq_phys: 0,
        io_cq_phys: 0,
        doorbell_admin_sq: mmio_base + 0x1000,
        doorbell_admin_cq: mmio_base + 0x1004,
        doorbell_io_sq: mmio_base + 0x1008,
        doorbell_io_cq: mmio_base + 0x100C,
        io_queue_depth: 256,
        initialized: true,
    };

    let device: BlockDevice = BlockDevice {
        device_id: device_id,
        device_info: info,
        mmio_base: mmio_base,
        mmio_size: 0x4000,
        capability: state.default_cap,
        command_queue: RingBuf::new(),
        pending_commands: Array::zeroed(),
        pending_count: 0,
        completed_commands: RingBuf::new(),
        nvme_qp: qp,
        interrupt_registered: false,
        interrupt_handler: 0,
        initialized: true,
        connected: true,
        read_count: 0,
        write_count: 0,
        error_count: 0,
        total_bytes_read: 0,
        total_bytes_written: 0,
        last_activity: timestamp,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.devices[state.device_count] = device;
    state.device_count = state.device_count + 1;

    residual emit {
        op: "block_driver.probe_nvme",
        device_id: device_id.id_hash,
        mmio_base: mmio_base,
        vendor: pci_vendor as u64,
        device: pci_device as u64,
    };

    return Result::Ok(device_id);
}

// ─────────────────────────────────────────────────────────────
// Probe AHCI Device
// ─────────────────────────────────────────────────────────────

fn block_probe_ahci(
    state: Handle(BlockDriverState),
    mmio_base: u64,
    pci_vendor: u16,
    pci_device: u16,
    pci_bus: u8,
    pci_devfn: u8,
    probe_cap: Cap(BlockCapability),
    timestamp: u64,
) -> Result(Identity, BlockError)
    effect [memory:mmio, deterministic, residual]
{
    if !state.initialized {
        return Result::Err(BlockError::BlockNotInitialized);
    };

    if state.device_count >= 8 {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    let device_id: Identity = identity_new(
        0x424C_4B,  // "BLK"
        timestamp,
        state.device_count as u64,
        pci_vendor as u64,
    );

    let info: BlockDeviceInfo = BlockDeviceInfo {
        device_type: BlockDeviceType::Ahci,
        block_size: 512,
        block_count: 0,
        max_transfer: 128,
        serial_number: String::from_bytes(Slice(u8)::from_str("AHCI-SIM-0001")),
        model_number: String::from_bytes(Slice(u8)::from_str("Phorensic AHCI Simulator")),
        firmware_revision: String::from_bytes(Slice(u8)::from_str("1.0")),
        pci_vendor: pci_vendor,
        pci_device: pci_device,
        pci_bus: pci_bus,
        pci_device_fn: pci_devfn,
        capabilities: BlockDeviceCap {
            dma_supported: true,
            trim_supported: false,
            flush_supported: true,
            power_management: false,
            write_protected: false,
            removable: false,
            nvme_queues: 0,
            ahci_ports: 6,
        },
    };

    let device: BlockDevice = BlockDevice {
        device_id: device_id,
        device_info: info,
        mmio_base: mmio_base,
        mmio_size: 0x10000,
        capability: state.default_cap,
        command_queue: RingBuf::new(),
        pending_commands: Array::zeroed(),
        pending_count: 0,
        completed_commands: RingBuf::new(),
        nvme_qp: NvmeQueuePair {
            admin_submission: Array::zeroed(), admin_completion: Array::zeroed(),
            io_submission: Array::zeroed(), io_completion: Array::zeroed(),
            admin_sq_tail: 0, admin_cq_head: 0,
            io_sq_tail: 0, io_cq_head: 0,
            admin_sq_phys: 0, admin_cq_phys: 0,
            io_sq_phys: 0, io_cq_phys: 0,
            doorbell_admin_sq: 0, doorbell_admin_cq: 0,
            doorbell_io_sq: 0, doorbell_io_cq: 0,
            io_queue_depth: 0, initialized: false,
        },
        interrupt_registered: false,
        interrupt_handler: 0,
        initialized: true,
        connected: true,
        read_count: 0, write_count: 0, error_count: 0,
        total_bytes_read: 0, total_bytes_written: 0,
        last_activity: timestamp,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.devices[state.device_count] = device;
    state.device_count = state.device_count + 1;

    residual emit {
        op: "block_driver.probe_ahci",
        device_id: device_id.id_hash,
        mmio_base: mmio_base,
    };

    return Result::Ok(device_id);
}

// ─────────────────────────────────────────────────────────────
// Submit Block I/O Command
// ─────────────────────────────────────────────────────────────

fn block_submit_io(
    state: Handle(BlockDriverState),
    device_idx: u64,
    io_type: BlockIoType,
    lba: u64,
    block_count: u64,
    data_buffer: u64,
    data_size: u64,
    command_tag: u64,
    submitter_cap: Cap(BlockCapability),
    timestamp: u64,
) -> Result(u64, BlockError)
    effect [memory:mmio, deterministic, residual]
    court "block_submit:v2"
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    let device: Handle(BlockDevice) = Handle(BlockDevice)::from_ptr(&state.devices[device_idx]);

    if !device.initialized || !device.connected {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    // Validate capability
    match io_type {
        BlockIoType::Read => {
            if !device.capability.can_read {
                return Result::Err(BlockError::BlockCapabilityError);
            };
        },
        BlockIoType::Write => {
            if !device.capability.can_write {
                return Result::Err(BlockError::BlockCapabilityError);
            };
        },
        _ => {},
    };

    // Validate LBA
    if lba + block_count > device.device_info.block_count {
        return Result::Err(BlockError::BlockInvalidLba);
    };

    // Validate block count
    if block_count > device.device_info.max_transfer {
        return Result::Err(BlockError::BlockInvalidSize);
    };

    // Check command queue space
    if device.command_queue.is_full() {
        return Result::Err(BlockError::BlockQueueFull);
    };

    // Build command
    let command: BlockIoCommand = BlockIoCommand {
        command_type: io_type,
        lba: lba,
        block_count: block_count,
        data_buffer: data_buffer,
        data_buffer_size: data_size,
        dma_region: 0,
        callback: 0,
        callback_context: 0,
        command_tag: command_tag,
        timestamp_submit: timestamp,
        timestamp_complete: 0,
        status: BlockIoStatus::Pending,
        error_detail: 0,
        residual: ResidualRecord {
            timestamp: timestamp,
            event_type: 0x90,
            event_data_hash: command_tag,
            cause_identity: submitter_cap.object_id,
            prior_state_hash: lba,
            new_state_hash: lba + block_count,
            delta_description: String::from_bytes(Slice(u8)::from_str("block I/O submitted")),
            generation_at_event: device.generation,
            verified: false,
        },
    };

    device.command_queue.push(command);
    state.total_io_operations = state.total_io_operations + 1;

    match io_type {
        BlockIoType::Read => device.read_count = device.read_count + 1,
        BlockIoType::Write => device.write_count = device.write_count + 1,
        _ => {},
    };

    residual emit {
        op: "block_driver.submit_io",
        device_idx: device_idx,
        io_type: io_type as u64,
        lba: lba,
        block_count: block_count,
        data_buffer: data_buffer,
        tag: command_tag,
    };

    return Result::Ok(command_tag);
}

// ─────────────────────────────────────────────────────────────
// Complete Block I/O (call from interrupt handler)
// ─────────────────────────────────────────────────────────────

fn block_complete_io(
    state: Handle(BlockDriverState),
    device_idx: u64,
    command_tag: u64,
    success: bool,
    error_detail: u64,
    timestamp: u64,
) -> Result(BlockIoCommand, BlockError)
    effect [deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    let device: Handle(BlockDevice) = Handle(BlockDevice)::from_ptr(&state.devices[device_idx]);

    // Find the pending command
    let mut found_idx: u64 = 0;
    let mut found: bool = false;
    for i in 0..device.pending_count {
        if device.pending_commands[i].command_tag == command_tag {
            found_idx = i;
            found = true;
            break;
        };
    };

    if !found {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    let cmd: BlockIoCommand = device.pending_commands[found_idx];

    // Update status
    let mut updated_cmd: BlockIoCommand = cmd;
    updated_cmd.status = if success { BlockIoStatus::Completed } else { BlockIoStatus::Error };
    updated_cmd.timestamp_complete = timestamp;
    updated_cmd.error_detail = error_detail;

    // Remove from pending, add to completed
    for i in found_idx..(device.pending_count - 1) {
        device.pending_commands[i] = device.pending_commands[i + 1];
    };
    device.pending_count = device.pending_count - 1;
    device.completed_commands.push(updated_cmd);

    device.last_activity = timestamp;

    if !success {
        device.error_count = device.error_count + 1;
        state.total_errors = state.total_errors + 1;

        residual emit {
            op: "block_driver.io_error",
            device_idx: device_idx,
            command_tag: command_tag,
            error_detail: error_detail,
            total_errors: state.total_errors,
        };
    };

    residual emit {
        op: "block_driver.complete_io",
        device_idx: device_idx,
        command_tag: command_tag,
        success: if success { 1 } else { 0 },
        io_type: updated_cmd.command_type as u64,
    };

    return Result::Ok(updated_cmd);
}

// ─────────────────────────────────────────────────────────────
// Poll for Completed Commands
// ─────────────────────────────────────────────────────────────

fn block_poll_completions(
    state: Handle(BlockDriverState),
    device_idx: u64,
    poller_cap: Cap(BlockCapability),
) -> Result(Array(BlockIoCommand, 64), BlockError)
    effect [memory:mmio, deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    let device: Handle(BlockDevice) = Handle(BlockDevice)::from_ptr(&state.devices[device_idx]);

    // In a real driver, this would check NVMe CQ or AHCI port registers
    // For the stub, just drain the completed queue

    let mut results: Array(BlockIoCommand, 64) = Array::zeroed();
    let mut count: u64 = 0;

    while !device.completed_commands.is_empty() && count < 64 {
        let cmd: BlockIoCommand = device.completed_commands.pop().unwrap();
        results[count] = cmd;
        count = count + 1;
    };

    residual emit {
        op: "block_driver.poll_completions",
        device_idx: device_idx,
        completed_count: count,
    };

    return Result::Ok(results);
}

// ─────────────────────────────────────────────────────────────
// Get Device Info
// ─────────────────────────────────────────────────────────────

fn block_get_info(
    state: Handle(BlockDriverState),
    device_idx: u64,
    querier_cap: Cap(BlockCapability),
) -> Result(BlockDeviceInfo, BlockError)
    effect [deterministic]
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    return Result::Ok(state.devices[device_idx].device_info);
}

// ─────────────────────────────────────────────────────────────
// Flush Device
// ─────────────────────────────────────────────────────────────

fn block_flush(
    state: Handle(BlockDriverState),
    device_idx: u64,
    flusher_cap: Cap(BlockCapability),
    timestamp: u64,
) -> Result(void, BlockError)
    effect [memory:mmio, deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    let device: Handle(BlockDevice) = Handle(BlockDevice)::from_ptr(&state.devices[device_idx]);

    if !device.capability.can_flush {
        return Result::Err(BlockError::BlockCapabilityError);
    };

    // Issue flush command
    // In a real driver, this would send NVMe flush or ATA flush cache

    residual emit {
        op: "block_driver.flush",
        device_idx: device_idx,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Block Driver Self-Test
// ─────────────────────────────────────────────────────────────

fn block_self_test(
    state: Handle(BlockDriverState),
) -> Result(u64, BlockError)
    effect [deterministic]
    court "block_self_test:v1"
{
    let mut checks: u64 = 0;

    if state.initialized {
        checks = checks + 1;
    };

    if state.device_count <= 8 {
        checks = checks + 1;
    };

    let mut initialized_devices: u64 = 0;
    for i in 0..state.device_count {
        if state.devices[i].initialized {
            initialized_devices = initialized_devices + 1;
        };
    };

    if initialized_devices == state.device_count {
        checks = checks + 1;
    };

    let mut no_queue_overflow: bool = true;
    for i in 0..state.device_count {
        if state.devices[i].pending_count > 64 {
            no_queue_overflow = false;
            break;
        };
    };

    if no_queue_overflow {
        checks = checks + 1;
    };

    residual emit {
        op: "block_driver.self_test",
        checks_passed: checks,
        device_count: state.device_count,
        total_io: state.total_io_operations,
    };

    return Result::Ok(checks);
}

// ─────────────────────────────────────────────────────────────
// Block Device Diagnostics
// ─────────────────────────────────────────────────────────────

struct BlockDiagnostics {
    device_idx: u64,
    device_type: BlockDeviceType,
    initialized: bool,
    connected: bool,
    block_size: u64,
    block_count: u64,
    read_count: u64,
    write_count: u64,
    error_count: u64,
    total_bytes_read: u64,
    total_bytes_written: u64,
    pending_cmds: u64,
    queue_level: u64,
    completed_cmds: u64,
    serial_number: String(32),
    model_number: String(64),
    trust_state: TrustState,
    generation: u64,
    nvme_queues_initialized: bool,
}

fn block_diagnostics(
    state: Handle(BlockDriverState),
    device_idx: u64,
    diag_cap: Cap(BlockCapability),
) -> Result(BlockDiagnostics, BlockError)
    effect [deterministic]
    court "block_diagnostics:v1"
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    let dev: BlockDevice = state.devices[device_idx];

    let diag: BlockDiagnostics = BlockDiagnostics {
        device_idx: device_idx,
        device_type: dev.device_info.device_type,
        initialized: dev.initialized,
        connected: dev.connected,
        block_size: dev.device_info.block_size,
        block_count: dev.device_info.block_count,
        read_count: dev.read_count,
        write_count: dev.write_count,
        error_count: dev.error_count,
        total_bytes_read: dev.total_bytes_read,
        total_bytes_written: dev.total_bytes_written,
        pending_cmds: dev.pending_count,
        queue_level: dev.command_queue.len(),
        completed_cmds: dev.completed_commands.len(),
        serial_number: dev.device_info.serial_number,
        model_number: dev.device_info.model_number,
        trust_state: dev.trust_state,
        generation: dev.generation,
        nvme_queues_initialized: dev.nvme_qp.initialized,
    };

    return Result::Ok(diag);
}

// ─────────────────────────────────────────────────────────────
// Block Device Identify — Full identify command
// ─────────────────────────────────────────────────────────────

fn block_identify(
    state: Handle(BlockDriverState),
    device_idx: u64,
    ident_cap: Cap(BlockCapability),
    timestamp: u64,
) -> Result(BlockDeviceInfo, BlockError)
    effect [memory:mmio, deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    // Issue identify command (NVMe Admin cmd 0x06, ATA IDENTIFY)
    // In a real driver, this would populate the device info from controller

    residual emit {
        op: "block_driver.identify",
        device_idx: device_idx,
        timestamp: timestamp,
    };

    return Result::Ok(state.devices[device_idx].device_info);
}

// ─────────────────────────────────────────────────────────────
// Block Device Read Capacity
// ─────────────────────────────────────────────────────────────

fn block_read_capacity(
    state: Handle(BlockDriverState),
    device_idx: u64,
    cap: Cap(BlockCapability),
    timestamp: u64,
) -> Result(BlockDeviceInfo, BlockError)
    effect [memory:mmio, deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    residual emit {
        op: "block_driver.read_capacity",
        device_idx: device_idx,
        timestamp: timestamp,
    };

    return Result::Ok(state.devices[device_idx].device_info);
}

// ─────────────────────────────────────────────────────────────
// Block Device Power Management
// ─────────────────────────────────────────────────────────────

fn block_set_power_state(
    state: Handle(BlockDriverState),
    device_idx: u64,
    power_state: u8,
    admin_cap: Cap(BlockCapability),
    timestamp: u64,
) -> Result(void, BlockError)
    effect [memory:mmio, deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(BlockError::BlockDeviceNotFound);
    };

    residual emit {
        op: "block_driver.set_power",
        device_idx: device_idx,
        power_state: power_state as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Block Device Capacity Check
// ─────────────────────────────────────────────────────────────

fn block_check_capacity(
    state: Handle(BlockDriverState),
    device_idx: u64,
    lba: u64,
    block_count: u64,
    cap: Cap(BlockCapability),
) -> bool
    effect [deterministic]
{
    if device_idx >= state.device_count {
        return false;
    };

    let info: BlockDeviceInfo = state.devices[device_idx].device_info;
    if lba + block_count > info.block_count {
        return false;
    };

    if block_count > info.max_transfer {
        return false;
    };

    return true;
}
