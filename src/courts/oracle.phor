// ============================================================================
// oracle.phor — Oracle Types: Compiler, Execution, Dialect, Hardware
// ============================================================================
// Oracles are reference implementations used by forensic courts to verify
// the correctness of native translations. Each oracle type provides a
// canonical behavior for comparison: compiler oracles for compilation
// verification, execution oracles for runtime verification, dialect oracles
// for dialect assumption verification, and hardware oracles for platform
// verification.
// ============================================================================

package "phorensic:oracle:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type OracleError = enum {
    OracleNotAvailable = 0x01,
    OracleVersionMismatch = 0x02,
    OracleConnectionFailed = 0x03,
    OracleExecutionFailed = 0x04,
    OracleResultCorrupted = 0x05,
    OracleIdentityNotVerified = 0x06,
    OracleSealBroken = 0x07,
    OracleTrustInsufficient = 0x08,
    OracleTimeout = 0x09,
    OracleResourceExhausted = 0x0A,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

type Option[T] = enum {
    Some(value: T),
    None,
}

// ============================================================================
// Trust State
// ============================================================================

type TrustState = enum {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

// ============================================================================
// Oracle Type ID
// ============================================================================

type OracleTypeID = enum {
    Compiler = 0x01,
    Execution = 0x02,
    Dialect = 0x03,
    Hardware = 0x04,
    Combined = 0x05,
    Custom = 0xFF,
}

// ============================================================================
// Oracle Identity
// ============================================================================

type OracleIdentity = struct {
    oracle_id: Hash256,
    oracle_type: OracleTypeID,
    name: FixedString[256],
    version: FixedString[32],
    source_hash: Hash256,
    binary_hash: Hash256,
    trust_state: TrustState,
    description: FixedString[512],
    supported_features: Array[FixedString[128], 32],
    feature_count: u64,
    is_sealed: bool,
    registration_time: u64,
}

// ============================================================================
// Compiler Oracle
// ============================================================================

type CompilerOracle = struct {
    identity: OracleIdentity,
    compiler_binary_hash: Hash256,
    compiler_image_ref: FixedString[256],
    known_good_outputs: Array[KnownGoodOutput, 256],
    known_good_count: u64,
    version_matched: bool,
    standard_flags: FixedString[512],
    optimization_levels: Array[FixedString[16], 8],
    level_count: u64,
    target_arch: FixedString[64],
    runtime_library_hash: Hash256,
}

type KnownGoodOutput = struct {
    input_hash: Hash256,
    output_hash: Hash256,
    compiler_flags: FixedString[256],
    verified_by: FixedString[128],
    verification_time: u64,
}

// ============================================================================
// Execution Oracle
// ============================================================================

type ExecutionOracle = struct {
    identity: OracleIdentity,
    reference_platform: FixedString[256],
    platform_hash: Hash256,
    captures_outputs: bool,
    captures_residuals: bool,
    captures_behavior: bool,
    environment_capsule: FixedString[1024],
    max_execution_time_us: u64,
    supported_syscalls: Array[FixedString[64], 256],
    syscall_count: u64,
}

// ============================================================================
// Dialect Oracle
// ============================================================================

type DialectOracle = struct {
    identity: OracleIdentity,
    dialect_name: FixedString[128],
    dialect_family: FixedString[64],
    reference_implementation: FixedString[256],
    specification_ref: FixedString[256],
    known_divergences: Array[FixedString[512], 128],
    divergence_count: u64,
    compliance_level: FixedString[32],
    abi_spec_hash: Hash256,
}

// ============================================================================
// Hardware Oracle
// ============================================================================

type HardwareOracle = struct {
    identity: OracleIdentity,
    platform_name: FixedString[128],
    architecture: FixedString[64],
    cpu_features: Array[FixedString[64], 64],
    feature_count: u64,
    memory_model: FixedString[64],
    cache_line_size: u64,
    page_size: u64,
    known_behavior: Array[FixedString[512], 128],
    behavior_count: u64,
    reference_platform_hash: Hash256,
}

// ============================================================================
// Oracle Registry
// ============================================================================

type OracleRegistry = struct {
    compiler_oracles: Array[CompilerOracle, 32],
    compiler_count: u64,
    execution_oracles: Array[ExecutionOracle, 32],
    execution_count: u64,
    dialect_oracles: Array[DialectOracle, 32],
    dialect_count: u64,
    hardware_oracles: Array[HardwareOracle, 16],
    hardware_count: u64,
    all_identities: Array[OracleIdentity, 128],
    identity_count: u64,
    generation: u64,
}

// ============================================================================
// Create Oracle Registry
// ============================================================================

fn create_oracle_registry() -> OracleRegistry
    effects: [compute]
{
    let empty_compilers: Array[CompilerOracle, 32] = Array[CompilerOracle, 32]::zeroed();
    let empty_execs: Array[ExecutionOracle, 32] = Array[ExecutionOracle, 32]::zeroed();
    let empty_dialects: Array[DialectOracle, 32] = Array[DialectOracle, 32]::zeroed();
    let empty_hardware: Array[HardwareOracle, 16] = Array[HardwareOracle, 16]::zeroed();
    let empty_ids: Array[OracleIdentity, 128] = Array[OracleIdentity, 128]::zeroed();

    return OracleRegistry {
        compiler_oracles: empty_compilers,
        compiler_count: 0,
        execution_oracles: empty_execs,
        execution_count: 0,
        dialect_oracles: empty_dialects,
        dialect_count: 0,
        hardware_oracles: empty_hardware,
        hardware_count: 0,
        all_identities: empty_ids,
        identity_count: 0,
        generation: 1,
    };
}

// ============================================================================
// Create Compiler Oracle
// ============================================================================

fn create_compiler_oracle(name: &FixedString[256], version: &FixedString[32], binary_hash: Hash256, target_arch: &FixedString[64]) -> CompilerOracle
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_outputs: Array[KnownGoodOutput, 256] = Array[KnownGoodOutput, 256]::zeroed();
    let empty_levels: Array[FixedString[16], 8] = Array[FixedString[16], 8]::zeroed();
    let empty_features: Array[FixedString[128], 32] = Array[FixedString[128], 32]::zeroed();

    let ident: OracleIdentity = OracleIdentity {
        oracle_id: hash_oracle_data(name.data, name.len, OracleTypeID::Compiler),
        oracle_type: OracleTypeID::Compiler,
        name: *name,
        version: *version,
        source_hash: zero_hash,
        binary_hash: binary_hash,
        trust_state: TrustState::Sealed,
        description: FixedString[512]::zeroed(),
        supported_features: empty_features,
        feature_count: 0,
        is_sealed: true,
        registration_time: kernel.tick_count(),
    };

    return CompilerOracle {
        identity: ident,
        compiler_binary_hash: binary_hash,
        compiler_image_ref: FixedString[256]::zeroed(),
        known_good_outputs: empty_outputs,
        known_good_count: 0,
        version_matched: true,
        standard_flags: FixedString[512]::from_literal("-O2 -target native"),
        optimization_levels: empty_levels,
        level_count: 0,
        target_arch: *target_arch,
        runtime_library_hash: zero_hash,
    };
}

// ============================================================================
// Create Execution Oracle
// ============================================================================

fn create_execution_oracle(name: &FixedString[256], version: &FixedString[32], platform: &FixedString[256]) -> ExecutionOracle
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_syscalls: Array[FixedString[64], 256] = Array[FixedString[64], 256]::zeroed();
    let empty_features: Array[FixedString[128], 32] = Array[FixedString[128], 32]::zeroed();

    let ident: OracleIdentity = OracleIdentity {
        oracle_id: hash_oracle_data(name.data, name.len, OracleTypeID::Execution),
        oracle_type: OracleTypeID::Execution,
        name: *name,
        version: *version,
        source_hash: zero_hash,
        binary_hash: zero_hash,
        trust_state: TrustState::Sealed,
        description: FixedString[512]::zeroed(),
        supported_features: empty_features,
        feature_count: 0,
        is_sealed: true,
        registration_time: kernel.tick_count(),
    };

    return ExecutionOracle {
        identity: ident,
        reference_platform: *platform,
        platform_hash: zero_hash,
        captures_outputs: true,
        captures_residuals: true,
        captures_behavior: true,
        environment_capsule: FixedString[1024]::zeroed(),
        max_execution_time_us: 1000000,
        supported_syscalls: empty_syscalls,
        syscall_count: 0,
    };
}

// ============================================================================
// Create Dialect Oracle
// ============================================================================

fn create_dialect_oracle(name: &FixedString[256], version: &FixedString[32], dialect_name: &FixedString[128], family: &FixedString[64]) -> DialectOracle
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_divergences: Array[FixedString[512], 128] = Array[FixedString[512], 128]::zeroed();
    let empty_features: Array[FixedString[128], 32] = Array[FixedString[128], 32]::zeroed();

    let ident: OracleIdentity = OracleIdentity {
        oracle_id: hash_oracle_data(name.data, name.len, OracleTypeID::Dialect),
        oracle_type: OracleTypeID::Dialect,
        name: *name,
        version: *version,
        source_hash: zero_hash,
        binary_hash: zero_hash,
        trust_state: TrustState::Sealed,
        description: FixedString[512]::zeroed(),
        supported_features: empty_features,
        feature_count: 0,
        is_sealed: true,
        registration_time: kernel.tick_count(),
    };

    return DialectOracle {
        identity: ident,
        dialect_name: *dialect_name,
        dialect_family: *family,
        reference_implementation: FixedString[256]::zeroed(),
        specification_ref: FixedString[256]::zeroed(),
        known_divergences: empty_divergences,
        divergence_count: 0,
        compliance_level: FixedString[32]::from_literal("full"),
        abi_spec_hash: zero_hash,
    };
}

// ============================================================================
// Create Hardware Oracle
// ============================================================================

fn create_hardware_oracle(name: &FixedString[256], version: &FixedString[32], arch: &FixedString[64]) -> HardwareOracle
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_features: Array[FixedString[64], 64] = Array[FixedString[64], 64]::zeroed();
    let empty_behavior: Array[FixedString[512], 128] = Array[FixedString[512], 128]::zeroed();
    let empty_sup_features: Array[FixedString[128], 32] = Array[FixedString[128], 32]::zeroed();

    let ident: OracleIdentity = OracleIdentity {
        oracle_id: hash_oracle_data(name.data, name.len, OracleTypeID::Hardware),
        oracle_type: OracleTypeID::Hardware,
        name: *name,
        version: *version,
        source_hash: zero_hash,
        binary_hash: zero_hash,
        trust_state: TrustState::Sealed,
        description: FixedString[512]::zeroed(),
        supported_features: empty_sup_features,
        feature_count: 0,
        is_sealed: true,
        registration_time: kernel.tick_count(),
    };

    return HardwareOracle {
        identity: ident,
        platform_name: *name,
        architecture: *arch,
        cpu_features: empty_features,
        feature_count: 0,
        memory_model: FixedString[64]::from_literal("flat"),
        cache_line_size: 64,
        page_size: 4096,
        known_behavior: empty_behavior,
        behavior_count: 0,
        reference_platform_hash: zero_hash,
    };
}

// ============================================================================
// Register Oracle in Registry
// ============================================================================

fn register_oracle(registry: &mut OracleRegistry, identity: OracleIdentity) -> Result[Hash256, OracleError]
    effects: [compute, residual]
{
    if registry.identity_count >= 128 {
        return Err(OracleError::OracleResourceExhausted);
    }

    registry.all_identities[registry.identity_count] = identity;
    registry.identity_count = registry.identity_count + 1;

    @emit_residual("oracle.register", "oracle_registered", identity.oracle_id);

    return Ok(identity.oracle_id);
}

// ============================================================================
// Register Compiler Oracle
// ============================================================================

fn register_compiler_oracle(registry: &mut OracleRegistry, oracle: CompilerOracle) -> Result[Hash256, OracleError>
    effects: [compute, residual]
{
    if registry.compiler_count >= 32 {
        return Err(OracleError::OracleResourceExhausted);
    }

    let id: Hash256 = oracle.identity.oracle_id;
    registry.compiler_oracles[registry.compiler_count] = oracle;
    registry.compiler_count = registry.compiler_count + 1;

    // Also register the identity
    register_oracle(registry, oracle.identity)?;

    @emit_residual("oracle.register_compiler", "compiler_oracle_registered", id);

    return Ok(id);
}

// ============================================================================
// Register Execution Oracle
// ============================================================================

fn register_execution_oracle(registry: &mut OracleRegistry, oracle: ExecutionOracle) -> Result[Hash256, OracleError>
    effects: [compute, residual]
{
    if registry.execution_count >= 32 {
        return Err(OracleError::OracleResourceExhausted);
    }

    let id: Hash256 = oracle.identity.oracle_id;
    registry.execution_oracles[registry.execution_count] = oracle;
    registry.execution_count = registry.execution_count + 1;

    register_oracle(registry, oracle.identity)?;

    @emit_residual("oracle.register_execution", "execution_oracle_registered", id);

    return Ok(id);
}

// ============================================================================
// Register Dialect Oracle
// ============================================================================

fn register_dialect_oracle(registry: &mut OracleRegistry, oracle: DialectOracle) -> Result[Hash256, OracleError>
    effects: [compute, residual]
{
    if registry.dialect_count >= 32 {
        return Err(OracleError::OracleResourceExhausted);
    }

    let id: Hash256 = oracle.identity.oracle_id;
    registry.dialect_oracles[registry.dialect_count] = oracle;
    registry.dialect_count = registry.dialect_count + 1;

    register_oracle(registry, oracle.identity)?;

    @emit_residual("oracle.register_dialect", "dialect_oracle_registered", id);

    return Ok(id);
}

// ============================================================================
// Register Hardware Oracle
// ============================================================================

fn register_hardware_oracle(registry: &mut OracleRegistry, oracle: HardwareOracle) -> Result[Hash256, OracleError>
    effects: [compute, residual]
{
    if registry.hardware_count >= 16 {
        return Err(OracleError::OracleResourceExhausted);
    }

    let id: Hash256 = oracle.identity.oracle_id;
    registry.hardware_oracles[registry.hardware_count] = oracle;
    registry.hardware_count = registry.hardware_count + 1;

    register_oracle(registry, oracle.identity)?;

    @emit_residual("oracle.register_hardware", "hardware_oracle_registered", id);

    return Ok(id);
}

// ============================================================================
// Find Oracle by ID
// ============================================================================

fn find_oracle_identity(registry: &OracleRegistry, oracle_id: Hash256) -> Result<&OracleIdentity, OracleError>
    effects: [compute]
{
    for i in 0..registry.identity_count {
        if registry.all_identities[i].oracle_id == oracle_id {
            return Ok(registry.all_identities[i]);
        }
    }
    return Err(OracleError::OracleNotAvailable);
}

// ============================================================================
// Find Compiler Oracle
// ============================================================================

fn find_compiler_oracle(registry: &OracleRegistry, oracle_id: Hash256) -> Result<&CompilerOracle, OracleError>
    effects: [compute]
{
    for i in 0..registry.compiler_count {
        if registry.compiler_oracles[i].identity.oracle_id == oracle_id {
            return Ok(registry.compiler_oracles[i]);
        }
    }
    return Err(OracleError::OracleNotAvailable);
}

// ============================================================================
// Add Known Good Output to Compiler Oracle
// ============================================================================

fn add_known_good_output(oracle: &mut CompilerOracle, input_hash: Hash256, output_hash: Hash256, flags: &FixedString[256], verifier: &FixedString[128]) -> Result<(), OracleError>
    effects: [compute, residual]
{
    if oracle.known_good_count >= 256 {
        return Err(OracleError::OracleResourceExhausted);
    }

    oracle.known_good_outputs[oracle.known_good_count] = KnownGoodOutput {
        input_hash: input_hash,
        output_hash: output_hash,
        compiler_flags: *flags,
        verified_by: *verifier,
        verification_time: kernel.tick_count(),
    };
    oracle.known_good_count = oracle.known_good_count + 1;

    @emit_residual("oracle.add_known_good", "known_good_output_added", oracle.known_good_count);

    return Ok(());
}

// ============================================================================
// Verify Compiler Output Against Known Good
// ============================================================================

fn verify_against_known_good(oracle: &CompilerOracle, input_hash: Hash256, output_hash: Hash256) -> Result<bool, OracleError>
    effects: [compute]
{
    for i in 0..oracle.known_good_count {
        if oracle.known_good_outputs[i].input_hash == input_hash {
            return Ok(oracle.known_good_outputs[i].output_hash == output_hash);
        }
    }
    return Err(OracleError::OracleNotAvailable);
}

// ============================================================================
// Add Supported Syscall to Execution Oracle
// ============================================================================

fn add_supported_syscall(oracle: &mut ExecutionOracle, syscall_name: &FixedString[64]) -> Result<(), OracleError>
    effects: [compute, residual]
{
    if oracle.syscall_count >= 256 {
        return Err(OracleError::OracleResourceExhausted);
    }

    oracle.supported_syscalls[oracle.syscall_count] = *syscall_name;
    oracle.syscall_count = oracle.syscall_count + 1;

    return Ok(());
}

// ============================================================================
// Add Known Divergence to Dialect Oracle
// ============================================================================

fn add_dialect_divergence(oracle: &mut DialectOracle, divergence: &FixedString[512]) -> Result<(), OracleError>
    effects: [compute, residual]
{
    if oracle.divergence_count >= 128 {
        return Err(OracleError::OracleResourceExhausted);
    }

    oracle.known_divergences[oracle.divergence_count] = *divergence;
    oracle.divergence_count = oracle.divergence_count + 1;

    return Ok(());
}

// ============================================================================
// Add CPU Feature to Hardware Oracle
// ============================================================================

fn add_cpu_feature(oracle: &mut HardwareOracle, feature: &FixedString[64]) -> Result<(), OracleError>
    effects: [compute, residual]
{
    if oracle.feature_count >= 64 {
        return Err(OracleError::OracleResourceExhausted);
    }

    oracle.cpu_features[oracle.feature_count] = *feature;
    oracle.feature_count = oracle.feature_count + 1;

    return Ok(());
}

// ============================================================================
// Check Oracle Trust Level
// ============================================================================

fn check_oracle_trust(identity: &OracleIdentity, minimum_trust: TrustState) -> bool
    effects: [compute]
{
    return identity.trust_state as u64 >= minimum_trust as u64;
}

// ============================================================================
// Verify Oracle Seal
// ============================================================================

fn verify_oracle_seal(identity: &OracleIdentity) -> bool
    effects: [compute]
{
    return identity.is_sealed && identity.trust_state >= TrustState::Sealed;
}

// ============================================================================
// Get Oracle Summary
// ============================================================================

type OracleSummary = struct {
    oracle_id: Hash256,
    oracle_type: OracleTypeID,
    name: FixedString[256],
    version: FixedString[32],
    trust_state: TrustState,
    is_sealed: bool,
    description: FixedString[512],
}

fn get_oracle_summary(identity: &OracleIdentity) -> OracleSummary
    effects: [compute]
{
    return OracleSummary {
        oracle_id: identity.oracle_id,
        oracle_type: identity.oracle_type,
        name: identity.name,
        version: identity.version,
        trust_state: identity.trust_state,
        is_sealed: identity.is_sealed,
        description: identity.description,
    };
}

// ============================================================================
// Registry Statistics
// ============================================================================

type OracleRegistryStats = struct {
    total_oracles: u64,
    compiler_count: u64,
    execution_count: u64,
    dialect_count: u64,
    hardware_count: u64,
    sealed_count: u64,
    promoted_count: u64,
}

fn get_registry_stats(registry: &OracleRegistry) -> OracleRegistryStats
    effects: [compute]
{
    let mut sealed: u64 = 0;
    let mut promoted: u64 = 0;

    for i in 0..registry.identity_count {
        if registry.all_identities[i].is_sealed {
            sealed = sealed + 1;
        }
        if registry.all_identities[i].trust_state >= TrustState::Promoted {
            promoted = promoted + 1;
        }
    }

    return OracleRegistryStats {
        total_oracles: registry.identity_count,
        compiler_count: registry.compiler_count,
        execution_count: registry.execution_count,
        dialect_count: registry.dialect_count,
        hardware_count: registry.hardware_count,
        sealed_count: sealed,
        promoted_count: promoted,
    };
}

// ============================================================================
// Hash Helper
// ============================================================================

fn hash_oracle_data(data: &Array[u8, 256], len: u64, oracle_type: OracleTypeID) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let hash_len: u64 = if len < 256 { len } else { 256 };

    // Mix type byte
    result.bytes[0] = oracle_type as u8;

    // Mix data
    for i in 0..hash_len {
        let idx: u64 = (i + 1) & 31;
        result.bytes[idx] = result.bytes[idx] ^ data[i];
    }

    return result;
}

// ============================================================================
// Execute Oracle Comparison
// ============================================================================
// Runs a comparison between a native object and a registered oracle.

fn execute_oracle_comparison(registry: &OracleRegistry, oracle_id: Hash256, native_hash: Hash256, test_inputs: &Array[Hash256, 256], input_count: u64) -> Result[OracleComparisonResult, OracleError]
    effects: [compute, io, residual]
{
    // Find the oracle
    let identity: &OracleIdentity = find_oracle_identity(registry, oracle_id)?;

    if !verify_oracle_seal(identity) {
        return Err(OracleError::OracleSealBroken);
    }

    let mut match_count: u64 = 0;
    let mut total_count: u64 = input_count;

    // Execute oracle on each test input and compare
    for i in 0..input_count {
        let input: Hash256 = test_inputs[i];
        let oracle_output: Hash256 = simulate_oracle_execution(identity.oracle_type, input);
        let native_output: Hash256 = hash_oracle_combine(native_hash, input);

        if oracle_output == native_output {
            match_count = match_count + 1;
        }
    }

    let match_ratio: u64 = if total_count > 0 { (match_count * 100) / total_count } else { 0 };

    let result: OracleComparisonResult = OracleComparisonResult {
        oracle_id: oracle_id,
        oracle_type: identity.oracle_type,
        native_hash: native_hash,
        total_tests: total_count,
        matching_tests: match_count,
        match_ratio: match_ratio,
        is_match: match_count == total_count,
        timestamp: kernel.tick_count(),
    };

    @emit_residual("oracle.execute_comparison", "comparison_executed", match_count);

    return Ok(result);
}

type OracleComparisonResult = struct {
    oracle_id: Hash256,
    oracle_type: OracleTypeID,
    native_hash: Hash256,
    total_tests: u64,
    matching_tests: u64,
    match_ratio: u64,
    is_match: bool,
    timestamp: u64,
}

// ============================================================================
// Simulate Oracle Execution
// ============================================================================
// Placeholder for actual oracle execution. In real implementation, this
// would invoke the oracle binary/reference.

fn simulate_oracle_execution(oracle_type: OracleTypeID, input_hash: Hash256) -> Hash256
    effects: [compute]
{
    // Deterministic hash based on oracle type and input
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = input_hash.bytes[i] ^ (oracle_type as u8);
    }
    return result;
}

// ============================================================================
// Combined Oracle Verification
// ============================================================================
// Runs verification against multiple oracle types and produces a unified
// result.

fn combined_oracle_verification(registry: &OracleRegistry, native_hash: Hash256, test_inputs: &Array[Hash256, 256], input_count: u64) -> Result[CombinedOracleResult, OracleError]
    effects: [compute, io, residual]
{
    let mut compiler_result: Option[OracleComparisonResult] = Option::None;
    let mut execution_result: Option[OracleComparisonResult] = Option::None;
    let mut dialect_result: Option[OracleComparisonResult] = Option::None;
    let mut hardware_result: Option[OracleComparisonResult] = Option::None;

    // Try compiler oracle
    if registry.compiler_count > 0 {
        let oid: Hash256 = registry.compiler_oracles[0].identity.oracle_id;
        match execute_oracle_comparison(registry, oid, native_hash, test_inputs, input_count) {
            Ok(res) => { compiler_result = Option::Some(res); }
            Err(_) => {}
        }
    }

    // Try execution oracle
    if registry.execution_count > 0 {
        let oid: Hash256 = registry.execution_oracles[0].identity.oracle_id;
        match execute_oracle_comparison(registry, oid, native_hash, test_inputs, input_count) {
            Ok(res) => { execution_result = Option::Some(res); }
            Err(_) => {}
        }
    }

    // Try dialect oracle
    if registry.dialect_count > 0 {
        let oid: Hash256 = registry.dialect_oracles[0].identity.oracle_id;
        match execute_oracle_comparison(registry, oid, native_hash, test_inputs, input_count) {
            Ok(res) => { dialect_result = Option::Some(res); }
            Err(_) => {}
        }
    }

    // Compute overall result
    let mut all_match: bool = true;
    let mut total_match: u64 = 0;
    let mut total_tests: u64 = 0;

    match compiler_result {
        Option::Some(res) => {
            if !res.is_match { all_match = false; }
            total_match = total_match + res.matching_tests;
            total_tests = total_tests + res.total_tests;
        }
        Option::None => {}
    }
    match execution_result {
        Option::Some(res) => {
            if !res.is_match { all_match = false; }
            total_match = total_match + res.matching_tests;
            total_tests = total_tests + res.total_tests;
        }
        Option::None => {}
    }
    match dialect_result {
        Option::Some(res) => {
            if !res.is_match { all_match = false; }
            total_match = total_match + res.matching_tests;
            total_tests = total_tests + res.total_tests;
        }
        Option::None => {}
    }

    let overall_ratio: u64 = if total_tests > 0 { (total_match * 100) / total_tests } else { 0 };

    return Ok(CombinedOracleResult {
        compiler_result: compiler_result,
        execution_result: execution_result,
        dialect_result: dialect_result,
        hardware_result: hardware_result,
        overall_match: all_match,
        overall_match_ratio: overall_ratio,
        oracle_count: if compiler_result != Option::None { 1 } else { 0 } +
                      if execution_result != Option::None { 1 } else { 0 } +
                      if dialect_result != Option::None { 1 } else { 0 } +
                      if hardware_result != Option::None { 1 } else { 0 },
    });
}

type CombinedOracleResult = struct {
    compiler_result: Option[OracleComparisonResult],
    execution_result: Option[OracleComparisonResult],
    dialect_result: Option[OracleComparisonResult],
    hardware_result: Option[OracleComparisonResult],
    overall_match: bool,
    overall_match_ratio: u64,
    oracle_count: u64,
}

// ============================================================================
// Hash Helper for Oracle Module
// ============================================================================

fn hash_oracle_combine(a: Hash256, b: Hash256) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    return result;
}
