// store_object.phor — StoreObject type, identity, provenance, residual history, trust state
// Phorensic Forensic Store: immutable content-addressed storage substrate
// Spec: FORENSIC_STORE.md — Store Object Model
// Grammar: PHORENSIC_GRAMMAR.md §43 Store Operation Grammar

package forensic_store.store_object;

// ============================================================================
// Fundamental Hash Type
// ============================================================================

/// 256-bit cryptographic hash used as content address and integrity proof.
/// Fixed-size array — no heap allocation, no dynamic resizing.
struct Hash256
    layout packed
{
    bytes: Array[u8, 32],
}

// ============================================================================
// Identity
// ============================================================================

/// Identity of an actor (user, service, device, compiler, court) in the store.
/// Carries a human-readable name, a machine-verifiable key fingerprint,
/// and the dialect scope within which this identity is recognized.
struct Identity
    layout packed
{
    /// Human-readable label (e.g. "developer@phorensic.org")
    name: Array[u8, 128],
    /// Length of the name string (0..128)
    name_len: u32,
    /// Public key fingerprint (hash of the verifying key)
    key_fingerprint: Hash256,
    /// Dialect scope identifier — empty for universal identities
    dialect_scope: Array[u8, 64],
    /// Length of dialect scope string
    dialect_scope_len: u32,
    /// Identity version for rotation support
    version: u32,
    /// Generation at which this identity was established
    established_at_gen: u64,
}

// ============================================================================
// Trust Level and Trust State
// ============================================================================

/// Trust level enumeration — defines the confidence in a store object.
/// Higher numeric values represent stronger trust.
type TrustLevel = enum {
    /// No trust evaluation has been performed
    Untrusted = 0,
    /// Object has been ingested but not verified
    Ingested = 1,
    /// Integrity hash verified
    IntegrityVerified = 2,
    /// Signatures match trusted keyring
    SignatureVerified = 3,
    /// Source↔binary seal chain is intact
    SealVerified = 4,
    /// Receipt chain is continuous and valid
    ReceiptChainVerified = 5,
    /// Promoted after replay court verification
    CourtVerified = 6,
    /// Promoted by auditor review
    AuditorApproved = 7,
    /// Maximum trust — hardwired trusted nucleus path
    TrustedNucleus = 8,
}

/// Trust state of a store object — level, promotion metadata, and decay.
struct TrustState
    layout packed
{
    /// Current trust level
    level: TrustLevel,
    /// Generation reference when this trust level was achieved
    promoted_at_gen: u64,
    /// Identity that performed the promotion
    promoted_by: Identity,
    /// Timestamp of last trust level change
    promoted_at_timestamp: u64,
    /// Decay interval in seconds — trust decays after this period
    decay_interval_seconds: u64,
    /// Set to true if trust has decayed since last verification
    decayed: bool,
    /// Hash of the evidence chain that justifies this trust level
    evidence_chain_hash: Hash256,
    /// Number of independent verifications performed
    verification_count: u32,
    /// Reserved for future trust metrics
    reserved: Array[u64, 4],
}

// ============================================================================
// Trust State Operations
// ============================================================================

/// Create a new TrustState at the Untrusted level.
fn trust_state_new() -> TrustState
    effect [compute]
{
    let zero_id: Identity = Identity {
        name: Array[u8, 128]::zeroed(),
        name_len: 0,
        key_fingerprint: Hash256 { bytes: Array[u8, 32]::zeroed() },
        dialect_scope: Array[u8, 64]::zeroed(),
        dialect_scope_len: 0,
        version: 0,
        established_at_gen: 0,
    };
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    return TrustState {
        level: TrustLevel::Untrusted,
        promoted_at_gen: 0,
        promoted_by: zero_id,
        promoted_at_timestamp: 0,
        decay_interval_seconds: 0,
        decayed: false,
        evidence_chain_hash: zero_hash,
        verification_count: 0,
        reserved: Array[u64, 4]::zeroed(),
    };
}

/// Promote a trust state to a higher level with evidence.
fn trust_state_promote(
    state: TrustState,
    new_level: TrustLevel,
    promoter: Identity,
    timestamp: u64,
    generation: u64,
    evidence_hash: Hash256,
) -> TrustState
    effect [compute]
{
    // Validate: promotion must be to a higher or equal level
    if new_level >= state.level {
        residual emit {
            op: "trust.promote",
            from_level: state.level as u64,
            to_level: new_level as u64,
            promoter_fp: promoter.key_fingerprint.bytes[0],
            timestamp: timestamp,
        };
        return TrustState {
            level: new_level,
            promoted_at_gen: generation,
            promoted_by: promoter,
            promoted_at_timestamp: timestamp,
            decay_interval_seconds: state.decay_interval_seconds,
            decayed: false,
            evidence_chain_hash: evidence_hash,
            verification_count: state.verification_count + 1,
            reserved: state.reserved,
        };
    } else {
        // Cannot demote via promote — use trust_state_decay instead
        residual emit {
            op: "trust.promote_rejected",
            reason: "target_level_not_higher",
            current: state.level as u64,
            requested: new_level as u64,
        };
        return state;
    }
}

/// Apply trust decay — mark the state as decayed.
fn trust_state_decay(state: TrustState) -> TrustState
    effect [compute]
{
    return TrustState {
        level: state.level,
        promoted_at_gen: state.promoted_at_gen,
        promoted_by: state.promoted_by,
        promoted_at_timestamp: state.promoted_at_timestamp,
        decay_interval_seconds: state.decay_interval_seconds,
        decayed: true,
        evidence_chain_hash: state.evidence_chain_hash,
        verification_count: state.verification_count,
        reserved: state.reserved,
    };
}

/// Check if a trust state meets a minimum threshold.
fn trust_state_meets_threshold(
    state: TrustState,
    minimum: TrustLevel,
) -> bool
    effect [compute]
{
    if state.decayed {
        return false;
    }
    return state.level >= minimum;
}

/// Get a human-readable string for a trust level.
fn trust_level_name(level: TrustLevel) -> Array[u8, 32]
    effect [compute]
{
    let result: Array[u8, 32] = Array[u8, 32]::zeroed();
    match level {
        TrustLevel::Untrusted => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("untrusted");
            for i in 0..9 {
                result[i] = label[i];
            }
        },
        TrustLevel::Ingested => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("ingested");
            for i in 0..8 {
                result[i] = label[i];
            }
        },
        TrustLevel::IntegrityVerified => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("integrity_verified");
            for i in 0..18 {
                result[i] = label[i];
            }
        },
        TrustLevel::SignatureVerified => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("signature_verified");
            for i in 0..18 {
                result[i] = label[i];
            }
        },
        TrustLevel::SealVerified => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("seal_verified");
            for i in 0..13 {
                result[i] = label[i];
            }
        },
        TrustLevel::ReceiptChainVerified => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("receipt_chain_verified");
            for i in 0..22 {
                result[i] = label[i];
            }
        },
        TrustLevel::CourtVerified => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("court_verified");
            for i in 0..14 {
                result[i] = label[i];
            }
        },
        TrustLevel::AuditorApproved => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("auditor_approved");
            for i in 0..16 {
                result[i] = label[i];
            }
        },
        TrustLevel::TrustedNucleus => {
            let label: Array[u8, 32] = Array[u8, 32]::from_literal("trusted_nucleus");
            for i in 0..15 {
                result[i] = label[i];
            }
        },
    }
    return result;
}

// ============================================================================
// Provenance
// ============================================================================

/// Provenance record — tracks the origin and justification of a store object.
struct Provenance
    layout packed
{
    /// Identity that created the object
    creator: Identity,
    /// Source identifier (URL, path, or reference)
    source_ref: Array[u8, 256],
    /// Length of the source reference string
    source_ref_len: u32,
    /// Justification string — reason this object exists
    justification: Array[u8, 512],
    /// Length of justification
    justification_len: u32,
    /// Timestamp of creation
    created_at: u64,
    /// Generation at which this provenance was recorded
    generation: u64,
    /// Hash of the parent object (if derived)
    parent_hash: Hash256,
    /// Dialect profile used during creation
    dialect_profile_name: Array[u8, 64],
    dialect_profile_name_len: u32,
    /// Compiler version used (if applicable)
    compiler_version: Array[u8, 64],
    compiler_version_len: u32,
    /// Role of this object in the store
    object_role: ObjectRole,
    /// Reserved for future provenance fields
    reserved: Array[u64, 8],
}

/// Role an object plays in the store.
type ObjectRole = enum {
    /// Raw source data
    Source = 0,
    /// Compiled binary output
    Binary = 1,
    /// Build recipe descriptor
    BuildRecipe = 2,
    /// Dialect profile descriptor
    DialectProfile = 3,
    /// Expansion receipt container
    ExpansionReceipt = 4,
    /// Compilation stage receipt
    CompilationReceipt = 5,
    /// Replay checkpoint
    ReplayCheckpoint = 6,
    /// Residual graph node
    ResidualNode = 7,
    /// Court evidence bundle
    CourtEvidence = 8,
    /// Signature container
    SignatureContainer = 9,
    /// Source↔binary seal
    SourceBinarySeal = 10,
    /// Full sealed package container
    PackageContainer = 11,
    /// Generation descriptor
    GenerationDescriptor = 12,
    /// Profile descriptor
    ProfileDescriptor = 13,
    /// GC retention policy
    GCPolicy = 14,
    /// Auditor stamp record
    AuditorStamp = 15,
    /// Trust promotion record
    TrustPromotion = 16,
    /// Kernel container image
    KernelContainer = 17,
    /// Trusted nucleus image
    TrustedNucleusImage = 18,
    /// Compiler image
    CompilerImage = 19,
    /// Oracle trace data
    OracleTrace = 20,
    /// Court verdict record
    CourtVerdict = 21,
    /// Environment capsule
    EnvironmentCapsule = 22,
    /// Dependency graph
    DependencyGraph = 23,
    /// Byte comparison provenance map
    ByteComparisonMap = 24,
}

// ============================================================================
// Provenance Operations
// ============================================================================

/// Create a new provenance record.
fn provenance_new(
    creator: Identity,
    source_ref: Array[u8, 256],
    source_ref_len: u32,
    justification: Array[u8, 512],
    justification_len: u32,
    timestamp: u64,
    generation: u64,
    parent_hash: Hash256,
    dialect_profile: Array[u8, 64],
    dialect_profile_len: u32,
    compiler_ver: Array[u8, 64],
    compiler_ver_len: u32,
    role: ObjectRole,
) -> Provenance
    effect [compute, residual]
{
    residual emit {
        op: "provenance.create",
        role: role as u64,
        timestamp: timestamp,
        generation: generation,
    };
    return Provenance {
        creator: creator,
        source_ref: source_ref,
        source_ref_len: source_ref_len,
        justification: justification,
        justification_len: justification_len,
        created_at: timestamp,
        generation: generation,
        parent_hash: parent_hash,
        dialect_profile_name: dialect_profile,
        dialect_profile_name_len: dialect_profile_len,
        compiler_version: compiler_ver,
        compiler_version_len: compiler_ver_len,
        object_role: role,
        reserved: Array[u64, 8]::zeroed(),
    };
}

/// Verify that a provenance record is internally consistent.
fn provenance_verify(provenance: Provenance) -> bool
    effect [compute]
{
    // A valid provenance must have a creator with a non-zero key fingerprint
    let fp_zero: bool = true;
    for i in 0..32 {
        if provenance.creator.key_fingerprint.bytes[i] != 0 {
            fp_zero = false;
        }
    }
    if fp_zero {
        residual emit {
            op: "provenance.verify.fail",
            reason: "zero_fingerprint",
        };
        return false;
    }

    // Source reference must be non-empty for non-trivial objects
    if provenance.source_ref_len == 0 {
        residual emit {
            op: "provenance.verify.fail",
            reason: "empty_source_ref",
        };
        return false;
    }

    // Justification must be non-empty for promoted roles
    if provenance.object_role >= ObjectRole::PackageContainer {
        if provenance.justification_len == 0 {
            residual emit {
                op: "provenance.verify.fail",
                reason: "empty_justification_for_promoted",
            };
            return false;
        }
    }

    residual emit {
        op: "provenance.verify.pass",
        role: provenance.object_role as u64,
    };
    return true;
}

// ============================================================================
// Residual Record
// ============================================================================

/// A single residual record — captures an operation, its context, and its outcome.
/// Residuals are the forensic substrate of the system. Every operation that
/// affects state must produce a residual.
struct ResidualRecord
    layout packed
{
    /// Operation identifier string
    op_name: Array[u8, 128],
    /// Length of the operation name
    op_name_len: u32,
    /// Operation type classification
    op_type: ResidualOpType,
    /// Timestamp of the residual event
    timestamp: u64,
    /// Generation at which this residual was emitted
    generation: u64,
    /// Identity of the actor that caused this residual
    actor: Identity,
    /// Hash of the affected store object (if applicable)
    object_hash: Hash256,
    /// Severity level
    severity: ResidualSeverity,
    /// Key-value fields stored as interleaved arrays
    field_keys: Array[Array[u8, 64], 16],
    field_values: Array[Array[u8, 256], 16],
    field_key_lens: Array[u32, 16],
    field_value_lens: Array[u32, 16],
    field_count: u32,
    /// Hash of the parent residual (for chain construction)
    parent_residual_hash: Hash256,
    /// Monotonically increasing event sequence number
    event_id: u64,
    /// Causal category for GC reachability analysis
    causal_category: CausalCategory,
    /// Reserved for future residual metadata
    reserved: Array[u64, 8],
}

/// Classification of residual operations.
type ResidualOpType = enum {
    /// Store operation (store, resolve, delete)
    StoreOp = 0,
    /// Verification operation
    VerificationOp = 1,
    /// Trust state change
    TrustChange = 2,
    /// Generation operation (create, activate, rollback)
    GenerationOp = 3,
    /// Garbage collection operation
    GCOperation = 4,
    /// Compilation stage event
    CompilationOp = 5,
    /// Expansion event
    ExpansionOp = 6,
    /// Package operation (seal, verify, sign)
    PackageOp = 7,
    /// Source↔binary seal operation
    SealOp = 8,
    /// Court interaction
    CourtOp = 9,
    /// Oracle observation
    OracleOp = 10,
    /// Profile operation
    ProfileOp = 11,
    /// Capability operation
    CapabilityOp = 12,
    /// IPC message
    IPCOp = 13,
    /// Kernel event
    KernelOp = 14,
    /// Auditor action
    AuditorOp = 15,
}

/// Severity of a residual — affects GC retention priority.
type ResidualSeverity = enum {
    /// Informational — may be GC'd earliest
    Info = 0,
    /// Debug detail — retained for active debugging
    Debug = 1,
    /// Normal operation log
    Normal = 2,
    /// Warning — potential concern
    Warning = 3,
    /// Error condition
    Error = 4,
    /// Critical failure that affected system state
    Critical = 5,
    /// Audit-critical — must be retained per policy
    AuditCritical = 6,
    /// Court evidence — retained until court evidence is promoted
    CourtEvidence = 7,
}

/// Causal category — determines how the GC treats this residual.
type CausalCategory = enum {
    /// Directly referenced by an active object
    ActiveReference = 0,
    /// Part of a rollback generation's evidence
    RollbackEvidence = 1,
    /// Historical residual for drift analysis
    DriftAnalysis = 2,
    /// Court evidence retained for audit
    CourtRetained = 3,
    /// Receipt retained for legal compliance
    LegalRetention = 4,
    /// Orphaned — no remaining references
    Orphaned = 5,
    /// Temporary — will be GC'd on next cycle
    Temporary = 6,
}

// ============================================================================
// Residual History
// ============================================================================

/// A bounded container of residual records for a single object's history.
/// Fixed capacity of 1024 records — no heap allocation.
struct ResidualHistory
    layout packed
{
    /// Ordered array of residual records (newest appended at tail)
    records: Array[ResidualRecord, 1024],
    /// Current number of valid records in the array
    count: u32,
    /// Head index (oldest record)
    head: u32,
    /// Tail index (next insertion point)
    tail: u32,
    /// Total number of residuals ever emitted (monotonic counter)
    total_emitted: u64,
    /// Hash of the object this history belongs to
    owner_hash: Hash256,
}

// ============================================================================
// Residual History Operations
// ============================================================================

/// Create an empty residual history for an object.
fn residual_history_new(owner: Hash256) -> ResidualHistory
    effect [compute]
{
    return ResidualHistory {
        records: Array[ResidualRecord, 1024]::zeroed(),
        count: 0,
        head: 0,
        tail: 0,
        total_emitted: 0,
        owner_hash: owner,
    };
}

/// Append a residual record to the history. Overwrites oldest if full.
fn residual_history_append(
    history: ResidualHistory,
    record: ResidualRecord,
) -> ResidualHistory
    effect [compute, residual]
{
    let new_history: ResidualHistory = ResidualHistory {
        records: history.records,
        count: history.count,
        head: history.head,
        tail: history.tail,
        total_emitted: history.total_emitted + 1,
        owner_hash: history.owner_hash,
    };

    // Update event_id from the monotonic counter
    let updated_record: ResidualRecord = ResidualRecord {
        op_name: record.op_name,
        op_name_len: record.op_name_len,
        op_type: record.op_type,
        timestamp: record.timestamp,
        generation: record.generation,
        actor: record.actor,
        object_hash: record.object_hash,
        severity: record.severity,
        field_keys: record.field_keys,
        field_values: record.field_values,
        field_key_lens: record.field_key_lens,
        field_value_lens: record.field_value_lens,
        field_count: record.field_count,
        parent_residual_hash: record.parent_residual_hash,
        event_id: new_history.total_emitted,
        causal_category: record.causal_category,
        reserved: record.reserved,
    };

    new_history.records[history.tail as u64] = updated_record;

    // Advance tail
    let next_tail: u32 = (history.tail + 1) % 1024;
    new_history.tail = next_tail;

    if new_history.count < 1024 {
        new_history.count = new_history.count + 1;
    } else {
        // History full — head moves forward, oldest is overwritten
        new_history.head = (history.head + 1) % 1024;
    }

    residual emit {
        op: "residual_history.append",
        event_id: updated_record.event_id,
        op_type: updated_record.op_type as u64,
        severity: updated_record.severity as u64,
        history_count: new_history.count,
    };

    return new_history;
}

/// Iterate over residual records from oldest to newest.
fn residual_history_for_each(
    history: ResidualHistory,
) -> bool
    effect [compute, residual]
{
    if history.count == 0 {
        residual emit {
            op: "residual_history.iterate.empty",
        };
        return false;
    }

    // Bounded loop: maximum 1024 iterations
    for i in 0..history.count {
        let idx: u32 = (history.head + i) % 1024;
        let rec: ResidualRecord = history.records[idx];
        // Process — in a real system this would invoke a callback
        residual emit {
            op: "residual_history.iterate.record",
            index: i,
            event_id: rec.event_id,
            op_name_hash: rec.op_name[0] as u64,
            severity: rec.severity as u64,
        };
    }

    return true;
}

/// Extract residuals matching a specific severity threshold.
fn residual_history_filter_by_severity(
    history: ResidualHistory,
    min_severity: ResidualSeverity,
    result: ResidualHistory,
) -> ResidualHistory
    effect [compute, residual]
{
    let filtered: ResidualHistory = residual_history_new(history.owner_hash);

    // Bounded loop: maximum 1024 iterations
    for i in 0..history.count {
        let idx: u32 = (history.head + i) % 1024;
        let rec: ResidualRecord = history.records[idx];
        if rec.severity >= min_severity {
            filtered = residual_history_append(filtered, rec);
        }
    }

    residual emit {
        op: "residual_history.filter",
        input_count: history.count,
        output_count: filtered.count,
        min_severity: min_severity as u64,
    };

    return filtered;
}

/// Compute a hash over the entire residual chain for integrity verification.
fn residual_history_chain_hash(
    history: ResidualHistory,
) -> Hash256
    effect [compute]
{
    let accum: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    // Bounded loop: maximum 1024 iterations
    for i in 0..history.count {
        let idx: u32 = (history.head + i) % 1024;
        let rec: ResidualRecord = history.records[idx];
        // XOR-based chain hash (placeholder for real hash function)
        for j in 0..32 {
            accum.bytes[j] = accum.bytes[j] ^ rec.parent_residual_hash.bytes[j];
            accum.bytes[j] = accum.bytes[j] ^ (rec.event_id & 0xFF) as u8;
        }
    }

    return accum;
}

// ============================================================================
// StoreObject — The Core Type
// ============================================================================

/// A StoreObject is the fundamental unit of the forensic store.
/// Every object carries:
///   - content: the raw bytes of the stored artifact
///   - identity: who created it and under what authority
///   - provenance: how it was derived and why
///   - residual history: every operation that affected this object
///   - trust state: current confidence level with evidence chain
///   - signatures: cryptographic attestations
///   - receipts: compilation/expansion/verification receipts
struct StoreObject
    layout packed
{
    /// The store key — content-addressed hash of semantic inputs
    key: Hash256,
    /// Content bytes (e.g., source archive, binary, receipt JSON)
    content: Array[u8, 65536],
    /// Actual content length
    content_len: u32,
    /// Content hash (redundant with key, stored for fast access)
    content_hash: Hash256,
    /// Source snapshot hash (if this object derives from source)
    source_snapshot_hash: Hash256,
    /// Dialect profile used during creation
    dialect_profile: DialectProfile,
    /// Trust state with full evidence chain reference
    trust_state: TrustState,
    /// Provenance record
    provenance: Provenance,
    /// Identity embedded in the object
    identity: Identity,
    /// Residual history for this object
    residual_history: ResidualHistory,
    /// Build recipe (if applicable)
    build_recipe: BuildRecipe,
    /// Expansion receipts (bounded set)
    expansion_receipts: Array[ExpansionReceipt, 64],
    expansion_receipt_count: u32,
    /// Compilation pass receipts (bounded set)
    compilation_receipts: Array[StageReceipt, 64],
    compilation_receipt_count: u32,
    /// Replay checkpoints (bounded set)
    replay_checkpoints: Array[ReplayCheckpoint, 32],
    replay_checkpoint_count: u32,
    /// Residual graph edges (bounded set)
    residual_edges: Array[ResidualEdge, 256],
    residual_edge_count: u32,
    /// Signatures over this object
    signatures: ObjectSignatures,
    /// Object role classification
    object_role: ObjectRole,
    /// Object size in bytes (content only)
    object_size: u64,
    /// Generation at which this object was stored
    stored_at_gen: u64,
    /// Timestamp of storage
    stored_at_timestamp: u64,
    /// Whether this object is sealed (source↔binary chain complete)
    sealed: bool,
    /// Number of times this object has been referenced
    reference_count: u64,
    /// Whether this object is pinned (exempt from GC)
    pinned: bool,
    /// Reserved for future extension
    reserved: Array[u64, 16],
}

// ============================================================================
// Supporting Types Referenced by StoreObject
// ============================================================================

/// Dialect profile — identifies the language dialect, ABI, and feature set.
struct DialectProfile
    layout packed
{
    name: Array[u8, 64],
    name_len: u32,
    version: Array[u8, 32],
    version_len: u32,
    language: Array[u8, 32],
    language_len: u32,
    abi: Array[u8, 32],
    abi_len: u32,
    features: Array[Array[u8, 64], 32],
    feature_lens: Array[u32, 32],
    feature_count: u32,
    restrictions: Array[Array[u8, 128], 32],
    restriction_lens: Array[u32, 32],
    restriction_count: u32,
}

/// Build recipe — describes how to build from source.
struct BuildRecipe
    layout packed
{
    name: Array[u8, 128],
    name_len: u32,
    version: Array[u8, 64],
    version_len: u32,
    dependencies: Array[DependencySpec, 64],
    dependency_count: u32,
    build_steps: Array[BuildStep, 64],
    step_count: u32,
    output_artifacts: Array[Array[u8, 128], 16],
    output_artifact_lens: Array[u32, 16],
    output_count: u32,
    environment_capsule: EnvironmentCapsule,
}

/// A single dependency specification in a build recipe.
struct DependencySpec
    layout packed
{
    dep_name: Array[u8, 128],
    dep_name_len: u32,
    dep_version: Array[u8, 64],
    dep_version_len: u32,
    dep_source: Array[u8, 256],
    dep_source_len: u32,
    dep_store_key: Hash256,
}

/// A single build step.
struct BuildStep
    layout packed
{
    step_name: Array[u8, 128],
    step_name_len: u32,
    command: Array[u8, 512],
    command_len: u32,
    input_hashes: Array[Hash256, 32],
    input_count: u32,
    output_hashes: Array[Hash256, 32],
    output_count: u32,
}

/// Environment capsule — fully specified build environment.
struct EnvironmentCapsule
    layout packed
{
    cpu_features: Array[Array[u8, 64], 16],
    cpu_feature_lens: Array[u32, 16],
    cpu_feature_count: u32,
    memory_config_name: Array[u8, 64],
    memory_config_name_len: u32,
    memory_size_mb: u64,
    device_map: Array[Array[u8, 64], 16],
    device_map_lens: Array[u32, 16],
    device_map_count: u32,
    oracle_identities: Array[Identity, 16],
    oracle_count: u32,
    court_versions: Array[Array[u8, 64], 16],
    court_version_lens: Array[u32, 16],
    court_version_count: u32,
}

/// Expansion receipt — records a macro expansion or include resolution.
struct ExpansionReceipt
    layout packed
{
    receipt_name: Array[u8, 128],
    receipt_name_len: u32,
    input_hash: Hash256,
    output_hash: Hash256,
    applied_rules: Array[RuleRef, 32],
    rule_count: u32,
    residuals: Array[ResidualRecord, 32],
    residual_count: u32,
    timestamp: u64,
}

/// Reference to a compiler rule or pass.
struct RuleRef
    layout packed
{
    rule_id: Array[u8, 64],
    rule_id_len: u32,
    rule_version: Array[u8, 32],
    rule_version_len: u32,
}

/// Stage receipt — records a single compilation stage.
struct StageReceipt
    layout packed
{
    stage_name: Array[u8, 64],
    stage_name_len: u32,
    stage_version: Array[u8, 32],
    stage_version_len: u32,
    input_hash: Hash256,
    output_hash: Hash256,
    applied_rules: Array[RuleRef, 32],
    rule_count: u32,
    residuals: Array[ResidualRecord, 32],
    residual_count: u32,
    timestamp: u64,
}

/// Replay checkpoint — a snapshot of state at a replay stage boundary.
struct ReplayCheckpoint
    layout packed
{
    stage_name: Array[u8, 64],
    stage_name_len: u32,
    state_hash: Hash256,
    input_hash: Hash256,
    output_hash: Hash256,
    checkpoint_index: u32,
    timestamp: u64,
}

/// An edge in the residual dependency graph.
struct ResidualEdge
    layout packed
{
    source_residual_id: u64,
    target_residual_id: u64,
    edge_type: ResidualEdgeType,
    metadata: Array[u8, 64],
    metadata_len: u32,
}

type ResidualEdgeType = enum {
    /// source causes target
    Causal = 0,
    /// source depends on target
    DependsOn = 1,
    /// source produces target
    Produces = 2,
    /// source verifies target
    Verifies = 3,
    /// source seals target
    Seals = 4,
    /// source references target
    References = 5,
}

/// Signatures attached to an object.
struct ObjectSignatures
    layout packed
{
    /// Signature over the full content
    content_signature: Signature,
    /// Whether content signature is present
    content_sig_present: bool,
    /// Signatures over the evidence chain
    evidence_signatures: Array[Signature, 16],
    evidence_sig_count: u32,
    /// Auditor stamps
    auditor_stamps: Array[AuditorStamp, 16],
    auditor_stamp_count: u32,
}

/// A cryptographic signature.
struct Signature
    layout packed
{
    /// Signing algorithm identifier
    algorithm: Array[u8, 32],
    algorithm_len: u32,
    /// Raw signature bytes
    sig_bytes: Array[u8, 512],
    sig_bytes_len: u32,
    /// Public key of the signer
    signer_key: Hash256,
    /// Identity of the signer
    signer_identity: Identity,
    /// Signature timestamp
    signed_at: u64,
    /// Whether this signature has been verified
    verified: bool,
}

/// An auditor stamp — review/audit/certify attestation.
struct AuditorStamp
    layout packed
{
    auditor_identity: Identity,
    stamp_type: AuditStampType,
    timestamp: u64,
    /// Signature over the container hash
    stamp_signature: Signature,
    /// Reference to the auditor's report residual
    report_residual_id: u64,
}

type AuditStampType = enum {
    Review = 0,
    Audit = 1,
    Certify = 2,
}

// ============================================================================
// StoreObject Construction
// ============================================================================

/// Create a new StoreObject with minimal required fields.
fn store_object_new(
    content: Array[u8, 65536],
    content_len: u32,
    content_hash: Hash256,
    source_hash: Hash256,
    dialect: DialectProfile,
    provenance: Provenance,
    identity: Identity,
    role: ObjectRole,
    generation: u64,
    timestamp: u64,
) -> StoreObject
    effect [compute, residual]
{
    let zero_key: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_receipts: Array[ExpansionReceipt, 64] = Array[ExpansionReceipt, 64]::zeroed();
    let empty_stages: Array[StageReceipt, 64] = Array[StageReceipt, 64]::zeroed();
    let empty_checkpoints: Array[ReplayCheckpoint, 32] = Array[ReplayCheckpoint, 32]::zeroed();
    let empty_edges: Array[ResidualEdge, 256] = Array[ResidualEdge, 256]::zeroed();
    let empty_sigs: ObjectSignatures = ObjectSignatures {
        content_signature: Signature {
            algorithm: Array[u8, 32]::zeroed(),
            algorithm_len: 0,
            sig_bytes: Array[u8, 512]::zeroed(),
            sig_bytes_len: 0,
            signer_key: zero_key,
            signer_identity: identity,
            signed_at: timestamp,
            verified: false,
        },
        content_sig_present: false,
        evidence_signatures: Array[Signature, 16]::zeroed(),
        evidence_sig_count: 0,
        auditor_stamps: Array[AuditorStamp, 16]::zeroed(),
        auditor_stamp_count: 0,
    };
    let empty_build: BuildRecipe = BuildRecipe {
        name: Array[u8, 128]::zeroed(),
        name_len: 0,
        version: Array[u8, 64]::zeroed(),
        version_len: 0,
        dependencies: Array[DependencySpec, 64]::zeroed(),
        dependency_count: 0,
        build_steps: Array[BuildStep, 64]::zeroed(),
        step_count: 0,
        output_artifacts: Array[Array[u8, 128], 16]::zeroed(),
        output_artifact_lens: Array[u32, 16]::zeroed(),
        output_count: 0,
        environment_capsule: EnvironmentCapsule {
            cpu_features: Array[Array[u8, 64], 16]::zeroed(),
            cpu_feature_lens: Array[u32, 16]::zeroed(),
            cpu_feature_count: 0,
            memory_config_name: Array[u8, 64]::zeroed(),
            memory_config_name_len: 0,
            memory_size_mb: 0,
            device_map: Array[Array[u8, 64], 16]::zeroed(),
            device_map_lens: Array[u32, 16]::zeroed(),
            device_map_count: 0,
            oracle_identities: Array[Identity, 16]::zeroed(),
            oracle_count: 0,
            court_versions: Array[Array[u8, 64], 16]::zeroed(),
            court_version_lens: Array[u32, 16]::zeroed(),
            court_version_count: 0,
        },
    };
    let history: ResidualHistory = residual_history_new(zero_key);

    residual emit {
        op: "store_object.create",
        role: role as u64,
        content_len: content_len,
        content_hash_prefix: content_hash.bytes[0] as u64,
        generation: generation,
    };

    return StoreObject {
        key: zero_key,
        content: content,
        content_len: content_len,
        content_hash: content_hash,
        source_snapshot_hash: source_hash,
        dialect_profile: dialect,
        trust_state: trust_state_new(),
        provenance: provenance,
        identity: identity,
        residual_history: history,
        build_recipe: empty_build,
        expansion_receipts: empty_receipts,
        expansion_receipt_count: 0,
        compilation_receipts: empty_stages,
        compilation_receipt_count: 0,
        replay_checkpoints: empty_checkpoints,
        replay_checkpoint_count: 0,
        residual_edges: empty_edges,
        residual_edge_count: 0,
        signatures: empty_sigs,
        object_role: role,
        object_size: content_len as u64,
        stored_at_gen: generation,
        stored_at_timestamp: timestamp,
        sealed: false,
        reference_count: 0,
        pinned: false,
        reserved: Array[u64, 16]::zeroed(),
    };
}

/// Set the store key on an object after computation.
fn store_object_set_key(
    obj: StoreObject,
    key: Hash256,
) -> StoreObject
    effect [compute, residual]
{
    residual emit {
        op: "store_object.set_key",
        key_prefix: key.bytes[0] as u64,
    };
    return StoreObject {
        key: key,
        content: obj.content,
        content_len: obj.content_len,
        content_hash: obj.content_hash,
        source_snapshot_hash: obj.source_snapshot_hash,
        dialect_profile: obj.dialect_profile,
        trust_state: obj.trust_state,
        provenance: obj.provenance,
        identity: obj.identity,
        residual_history: obj.residual_history,
        build_recipe: obj.build_recipe,
        expansion_receipts: obj.expansion_receipts,
        expansion_receipt_count: obj.expansion_receipt_count,
        compilation_receipts: obj.compilation_receipts,
        compilation_receipt_count: obj.compilation_receipt_count,
        replay_checkpoints: obj.replay_checkpoints,
        replay_checkpoint_count: obj.replay_checkpoint_count,
        residual_edges: obj.residual_edges,
        residual_edge_count: obj.residual_edge_count,
        signatures: obj.signatures,
        object_role: obj.object_role,
        object_size: obj.object_size,
        stored_at_gen: obj.stored_at_gen,
        stored_at_timestamp: obj.stored_at_timestamp,
        sealed: obj.sealed,
        reference_count: obj.reference_count,
        pinned: obj.pinned,
        reserved: obj.reserved,
    };
}

/// Mark a StoreObject as sealed (full source↔binary chain verified).
fn store_object_seal(obj: StoreObject) -> StoreObject
    effect [compute, residual]
{
    residual emit {
        op: "store_object.seal",
        key_prefix: obj.key.bytes[0] as u64,
        role: obj.object_role as u64,
    };
    return StoreObject {
        key: obj.key,
        content: obj.content,
        content_len: obj.content_len,
        content_hash: obj.content_hash,
        source_snapshot_hash: obj.source_snapshot_hash,
        dialect_profile: obj.dialect_profile,
        trust_state: obj.trust_state,
        provenance: obj.provenance,
        identity: obj.identity,
        residual_history: obj.residual_history,
        build_recipe: obj.build_recipe,
        expansion_receipts: obj.expansion_receipts,
        expansion_receipt_count: obj.expansion_receipt_count,
        compilation_receipts: obj.compilation_receipts,
        compilation_receipt_count: obj.compilation_receipt_count,
        replay_checkpoints: obj.replay_checkpoints,
        replay_checkpoint_count: obj.replay_checkpoint_count,
        residual_edges: obj.residual_edges,
        residual_edge_count: obj.residual_edge_count,
        signatures: obj.signatures,
        object_role: obj.object_role,
        object_size: obj.object_size,
        stored_at_gen: obj.stored_at_gen,
        stored_at_timestamp: obj.stored_at_timestamp,
        sealed: true,
        reference_count: obj.reference_count,
        pinned: obj.pinned,
        reserved: obj.reserved,
    };
}

/// Pin an object — exempt it from GC.
fn store_object_pin(obj: StoreObject) -> StoreObject
    effect [compute, residual]
{
    residual emit {
        op: "store_object.pin",
        key_prefix: obj.key.bytes[0] as u64,
    };
    return StoreObject {
        key: obj.key,
        content: obj.content,
        content_len: obj.content_len,
        content_hash: obj.content_hash,
        source_snapshot_hash: obj.source_snapshot_hash,
        dialect_profile: obj.dialect_profile,
        trust_state: obj.trust_state,
        provenance: obj.provenance,
        identity: obj.identity,
        residual_history: obj.residual_history,
        build_recipe: obj.build_recipe,
        expansion_receipts: obj.expansion_receipts,
        expansion_receipt_count: obj.expansion_receipt_count,
        compilation_receipts: obj.compilation_receipts,
        compilation_receipt_count: obj.compilation_receipt_count,
        replay_checkpoints: obj.replay_checkpoints,
        replay_checkpoint_count: obj.replay_checkpoint_count,
        residual_edges: obj.residual_edges,
        residual_edge_count: obj.residual_edge_count,
        signatures: obj.signatures,
        object_role: obj.object_role,
        object_size: obj.object_size,
        stored_at_gen: obj.stored_at_gen,
        stored_at_timestamp: obj.stored_at_timestamp,
        sealed: obj.sealed,
        reference_count: obj.reference_count,
        pinned: true,
        reserved: obj.reserved,
    };
}

/// Increment the reference count of an object.
fn store_object_add_reference(obj: StoreObject) -> StoreObject
    effect [compute]
{
    return StoreObject {
        key: obj.key,
        content: obj.content,
        content_len: obj.content_len,
        content_hash: obj.content_hash,
        source_snapshot_hash: obj.source_snapshot_hash,
        dialect_profile: obj.dialect_profile,
        trust_state: obj.trust_state,
        provenance: obj.provenance,
        identity: obj.identity,
        residual_history: obj.residual_history,
        build_recipe: obj.build_recipe,
        expansion_receipts: obj.expansion_receipts,
        expansion_receipt_count: obj.expansion_receipt_count,
        compilation_receipts: obj.compilation_receipts,
        compilation_receipt_count: obj.compilation_receipt_count,
        replay_checkpoints: obj.replay_checkpoints,
        replay_checkpoint_count: obj.replay_checkpoint_count,
        residual_edges: obj.residual_edges,
        residual_edge_count: obj.residual_edge_count,
        signatures: obj.signatures,
        object_role: obj.object_role,
        object_size: obj.object_size,
        stored_at_gen: obj.stored_at_gen,
        stored_at_timestamp: obj.stored_at_timestamp,
        sealed: obj.sealed,
        reference_count: obj.reference_count + 1,
        pinned: obj.pinned,
        reserved: obj.reserved,
    };
}

/// Decrement the reference count.
fn store_object_remove_reference(obj: StoreObject) -> StoreObject
    effect [compute]
{
    if obj.reference_count > 0 {
        return StoreObject {
            key: obj.key,
            content: obj.content,
            content_len: obj.content_len,
            content_hash: obj.content_hash,
            source_snapshot_hash: obj.source_snapshot_hash,
            dialect_profile: obj.dialect_profile,
            trust_state: obj.trust_state,
            provenance: obj.provenance,
            identity: obj.identity,
            residual_history: obj.residual_history,
            build_recipe: obj.build_recipe,
            expansion_receipts: obj.expansion_receipts,
            expansion_receipt_count: obj.expansion_receipt_count,
            compilation_receipts: obj.compilation_receipts,
            compilation_receipt_count: obj.compilation_receipt_count,
            replay_checkpoints: obj.replay_checkpoints,
            replay_checkpoint_count: obj.replay_checkpoint_count,
            residual_edges: obj.residual_edges,
            residual_edge_count: obj.residual_edge_count,
            signatures: obj.signatures,
            object_role: obj.object_role,
            object_size: obj.object_size,
            stored_at_gen: obj.stored_at_gen,
            stored_at_timestamp: obj.stored_at_timestamp,
            sealed: obj.sealed,
            reference_count: obj.reference_count - 1,
            pinned: obj.pinned,
            reserved: obj.reserved,
        };
    }
    return obj;
}

// ============================================================================
// Identity Operations
// ============================================================================

/// Check whether an identity has a non-zero key fingerprint.
fn identity_is_valid(id: Identity) -> bool
    effect [compute]
{
    for i in 0..32 {
        if id.key_fingerprint.bytes[i] != 0 {
            return true;
        }
    }
    return false;
}

/// Compare two identities for equality.
fn identity_equal(a: Identity, b: Identity) -> bool
    effect [compute]
{
    if a.name_len != b.name_len {
        return false;
    }
    for i in 0..a.name_len as u64 {
        if a.name[i] != b.name[i] {
            return false;
        }
    }
    for i in 0..32 {
        if a.key_fingerprint.bytes[i] != b.key_fingerprint.bytes[i] {
            return false;
        }
    }
    return a.version == b.version;
}

// ============================================================================
// Hash256 Operations
// ============================================================================

/// Compare two hashes for equality.
fn hash256_equal(a: Hash256, b: Hash256) -> bool
    effect [compute]
{
    for i in 0..32 {
        if a.bytes[i] != b.bytes[i] {
            return false;
        }
    }
    return true;
}

/// Compute whether a hash is all zeros.
fn hash256_is_zero(h: Hash256) -> bool
    effect [compute]
{
    for i in 0..32 {
        if h.bytes[i] != 0 {
            return false;
        }
    }
    return true;
}

/// Create a zero hash.
fn hash256_zero() -> Hash256
    effect [compute]
{
    return Hash256 { bytes: Array[u8, 32]::zeroed() };
}

// ============================================================================
// Store Object Serialization Helpers
// ============================================================================

/// Extract the content hash from a StoreObject and verify it matches declared hash.
fn store_object_verify_content_hash(obj: StoreObject) -> bool
    effect [compute, residual]
{
    // Compute a simple hash over the content bytes (placeholder for real hash)
    let computed: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..obj.content_len as u64 {
        computed.bytes[i % 32] = computed.bytes[i % 32] ^ obj.content[i];
    }

    let match_result: bool = hash256_equal(computed, obj.content_hash);
    residual emit {
        op: "store_object.verify_content_hash",
        key_prefix: obj.key.bytes[0] as u64,
        match: match_result as u64,
    };
    return match_result;
}

/// Get a summary string for an object's role.
fn object_role_to_string(role: ObjectRole) -> Array[u8, 32]
    effect [compute]
{
    let result: Array[u8, 32] = Array[u8, 32]::zeroed();
    match role {
        ObjectRole::Source => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("source");
            for i in 0..6 { result[i] = s[i]; }
        },
        ObjectRole::Binary => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("binary");
            for i in 0..6 { result[i] = s[i]; }
        },
        ObjectRole::PackageContainer => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("package");
            for i in 0..7 { result[i] = s[i]; }
        },
        ObjectRole::GenerationDescriptor => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("generation");
            for i in 0..10 { result[i] = s[i]; }
        },
        ObjectRole::ProfileDescriptor => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("profile");
            for i in 0..7 { result[i] = s[i]; }
        },
        ObjectRole::CourtEvidence => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("court_evidence");
            for i in 0..14 { result[i] = s[i]; }
        },
        ObjectRole::SignatureContainer => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("signatures");
            for i in 0..10 { result[i] = s[i]; }
        },
        _ => {
            let s: Array[u8, 32] = Array[u8, 32]::from_literal("unknown");
            for i in 0..7 { result[i] = s[i]; }
        },
    }
    return result;
}
