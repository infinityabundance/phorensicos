// court_example.phor — Example court session flow
//
// Demonstrates:
//   - Opening a court session with an oracle reference
//   - Submitting compilation and execution evidence
//   - Running replay and comparing with oracle
//   - Issuing verdict and promoting trust state
//   - Closing the session with sealed evidence
//   - Multiple oracle comparison types
//   - Divergence classification and handling
//   - Court residual recording
//   - Trust ladder progression through court verification
//
// Expected outcomes:
//   - Full court lifecycle executes correctly
//   - Byte-identical comparison produces strong positive trust
//   - Structural equivalence with documented non-semantic drift
//   - Divergence is classified and requires investigation
//   - Object progresses through trust ladder stages
//   - Court residuals are recorded for each operation
//   - Multiple oracle sessions can strengthen trust
//
// Compilation: accepted
// Trust state: Promoted (after court verification)

package "phorensic:court_example:v1.0";

struct CourtSession {
    id: u64,
    object_key: u64,
    oracle: Str(32),
    verdict: u8,
    evidence_count: u32,
    replayed: bool,
    compared: bool,
}

fn open_court_session(object_key: u64, oracle_name: Str(32)) -> CourtSession
    effect [court:request, residual]
{
    residual emit {
        op: "court.session_open",
        object: object_key,
        oracle: oracle_name,
    };

    let session: CourtSession = CourtSession{
        id: 1001,
        object_key: object_key,
        oracle: oracle_name,
        verdict: 0,
        evidence_count: 0,
        replayed: false,
        compared: false,
    };

    return session;
}

fn submit_evidence(mut session: CourtSession, evidence_hash: u64) -> CourtSession
    effect [court:request, residual]
{
    session.evidence_count = session.evidence_count + 1;

    residual emit {
        op: "court.evidence_submit",
        session: session.id,
        evidence: evidence_hash,
        count: session.evidence_count,
    };

    return session;
}

fn run_replay(mut session: CourtSession) -> CourtSession
    effect [court:request, residual]
{
    session.replayed = true;

    residual emit {
        op: "court.replay_run",
        session: session.id,
        status: "completed",
    };

    return session;
}

fn compare_with_oracle(mut session: CourtSession, comparison_type: u8) -> CourtSession
    effect [court:request, residual]
{
    session.compared = true;

    residual emit {
        op: "court.oracle_compare",
        session: session.id,
        comparison_type: comparison_type,
    };

    return session;
}

fn issue_verdict(mut session: CourtSession, verdict_type: u8) -> CourtSession
    effect [court:request, residual]
{
    session.verdict = verdict_type;

    residual emit {
        op: "court.verdict_issue",
        session: session.id,
        verdict: verdict_type,
    };

    return session;
}

fn close_session(session: CourtSession) -> void
    effect [court:request, residual]
{
    residual emit {
        op: "court.session_close",
        session: session.id,
        final_verdict: session.verdict,
        evidence_count: session.evidence_count,
    };
}

fn demonstrate_failed_promotion_scenario() -> void
    effect [io:write, court:request, residual]
{
    // Scenario: object cannot be promoted because oracle comparison diverges
    let session: CourtSession = CourtSession{
        id: 7777,
        object_key: 0xDEADBEEF,
        oracle: Str::from("reference-phc-v2.0.0"),
        verdict: 2, // Reject
        evidence_count: 5,
        replayed: false,
        compared: false,
    };

    // Replay fails
    let replay_match: bool = false;

    // Comparison diverges
    let comparison_type: u8 = 3; // Divergent

    // Cannot promote
    let can_promote: bool = replay_match && comparison_type <= 1;
    assert(!can_promote, "court: failed promotion scenario demonstrated");
    assert(session.verdict == 2, "court: verdict is Reject");

    residual emit {
        op: "court_example.failed_promotion",
        session: session.id,
        verdict: session.verdict,
        reason: "oracle divergence",
        promoted: 0,
    };
}

fn main() -> void
    effect [io:write, court:request, residual]
{
    // Step 1: Open court session with compiler oracle
    let oracle: Str(32) = Str::from("reference-phc-v2.0.0");
    let object_key: u64 = 0xAABBCCDD;

    let mut session: CourtSession = open_court_session(object_key, oracle);

    // Step 2: Submit evidence (receipts, provenance, residuals)
    session = submit_evidence(session, 0xAAAA); // parse receipt
    session = submit_evidence(session, 0xBBBB); // expand receipt
    session = submit_evidence(session, 0xCCCC); // lower receipt
    session = submit_evidence(session, 0xDDDD); // optimize receipt
    session = submit_evidence(session, 0xEEEE); // codegen receipt

    assert(session.evidence_count == 5, "court: 5 evidence items submitted");

    // Step 3: Run replay
    session = run_replay(session);
    assert(session.replayed, "court: replay completed");

    // Step 4: Compare with oracle — ByteIdentical
    session = compare_with_oracle(session, 0); // 0 = ByteIdentical
    assert(session.compared, "court: oracle comparison completed");

    // Step 5: Issue verdict — Accept
    session = issue_verdict(session, 0); // 0 = Accept
    assert(session.verdict == 0, "court: Accept verdict issued");

    // Step 6: Promote trust state
    let trust_state: u8 = 6; // Promoted
    assert(trust_state == 6, "court: Promoted trust state");

    // Step 7: Close session
    close_session(session);

    // Demonstrate different comparison types
    // ByteIdentical: exact match, strong positive trust
    let byte_identical: bool = true;
    assert(byte_identical, "court: byte-identical comparison possible");

    // StructurallyEquivalent: non-semantic differences (timestamps, addresses)
    let structurally_equivalent: bool = true;
    assert(structurally_equivalent, "court: structural equivalence acceptable");

    // Divergent: semantic differences, requires investigation
    let divergent: bool = false;
    assert(!divergent, "court: no divergence in this session");

    // Demonstrate trust ladder progression
    let trust_unknown: u8 = 0;
    let trust_observed: u8 = 1;
    let trust_replayed: u8 = 2;
    let trust_oracle_compared: u8 = 3;
    let trust_residual_stable: u8 = 4;
    let trust_sealed: u8 = 5;
    let trust_promoted: u8 = 6;

    assert(trust_unknown < trust_observed, "court: trust ladder ordering");
    assert(trust_replayed < trust_oracle_compared, "court: trust ladder ordering");
    assert(trust_residual_stable < trust_sealed, "court: trust ladder ordering");
    assert(trust_sealed < trust_promoted, "court: trust ladder ordering");

    // Demonstrate multiple oracle sessions
    let compiler_oracle_match: bool = true;
    let hardware_oracle_match: bool = true;
    let both_match: bool = compiler_oracle_match && hardware_oracle_match;
    assert(both_match, "court: multiple oracle sessions strengthen trust");

    // Demonstrate failed promotion scenario
    demonstrate_failed_promotion_scenario();

    residual emit {
        op: "court_example.complete",
        session: session.id,
        verdict: session.verdict,
        trust: trust_state,
        oracle: session.oracle,
        evidence_count: session.evidence_count,
        trust_ladder: trust_promoted,
        multi_oracle: if both_match { 1 } else { 0 },
    };
}
