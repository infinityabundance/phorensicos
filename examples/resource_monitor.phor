// resource_monitor.phor — System resource monitor with real-time graph display
//
// Demonstrates:
//   - CPU usage monitoring with per-core breakdown
//   - Memory usage tracking with allocation/free patterns
//   - Store usage with generation diff tracking
//   - Capability usage per session with type breakdown
//   - Court backlog monitoring with pending session count
//   - Residual volume tracking with rate computation
//   - Trust state summary across all objects
//   - Real-time ASCII graph display for trending data
//   - Fixed-capacity collections and bounded sample windows
//   - Full residual recording for monitoring operations
//
// Expected behavior:
//   - Collects system-wide resource metrics
//   - Displays numerical values and ASCII trend graphs
//   - Tracks changes between sampling intervals (deltas)
//   - Monitors resource consumption with capacity warnings
//   - All operations bounded, effect-declared, residual-recorded
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:resource_monitor:v1.0";

const MAX_CORES: u64 = 32;
const MAX_SESSIONS: u64 = 64;
const MAX_SAMPLE_WINDOW: u64 = 60;
const MAX_GRAPH_WIDTH: u64 = 40;
const MAX_STORE_GENERATIONS: u64 = 16;
const MAX_TRUST_SUMMARY: u64 = 7;
const MAX_CAP_TYPES: u64 = 16;
const MAX_WARNING_THRESHOLD: u64 = 4;
const WARN_LEVEL: u64 = 80;
const CRIT_LEVEL: u64 = 95;

struct CpuSample {
    user_pct: u8,
    system_pct: u8,
    idle_pct: u8,
    core_id: u8,
    frequency_mhz: u32,
    temperature_c: u8,
}

struct CpuSnapshot {
    samples: Array(CpuSample, 32),
    core_count: u64,
    total_user: u8,
    total_system: u8,
    total_idle: u8,
    load_avg_1m: u8,
    load_avg_5m: u8,
    load_avg_15m: u8,
}

struct MemorySnapshot {
    total_kb: u64,
    used_kb: u64,
    free_kb: u64,
    cached_kb: u64,
    kernel_kb: u64,
    available_kb: u64,
    swap_total_kb: u64,
    swap_used_kb: u64,
    usage_pct: u8,
}

struct StoreGenerationUsage {
    gen_id: u64,
    object_count: u64,
    total_size_kb: u64,
    residual_count: u64,
    trust_distribution: Array(u64, 7),
}

struct StoreSnapshot {
    total_objects: u64,
    total_size_kb: u64,
    free_slots: u64,
    generations: Array(StoreGenerationUsage, 16),
    gen_count: u64,
    active_gen: u64,
    reserved_kb: u64,
    sealed_object_count: u64,
    promoted_object_count: u64,
}

struct CapabilityUsageSnapshot {
    total_caps: u64,
    caps_per_session: Array(u64, 64),
    session_count: u64,
    caps_by_type: Array(u64, 16),
    type_count: u64,
    total_granted: u64,
    total_derived: u64,
    total_revoked: u64,
    total_transferred: u64,
}

struct CourtBacklogSnapshot {
    pending_sessions: u64,
    active_sessions: u64,
    completed_sessions: u64,
    pending_evidence: u64,
    pending_replay: u64,
    pending_comparison: u64,
    avg_wait_time_ms: u64,
    backlogged: bool,
}

struct ResidualVolumeSnapshot {
    total_residuals: u64,
    new_since_last: u64,
    rate_per_sec: u64,
    by_operation: Array(OperationCounter, 32),
    op_count: u64,
    peak_rate: u64,
    total_size_kb: u64,
}

struct OperationCounter {
    op_name: Str(32),
    count: u64,
    avg_size: u64,
}

struct TrustSummarySnapshot {
    unknown_count: u64,
    observed_count: u64,
    replayed_count: u64,
    oracle_compared_count: u64,
    residual_stable_count: u64,
    sealed_count: u64,
    promoted_count: u64,
    total_objects: u64,
    avg_trust_level: u8,
}

struct GraphDataPoint {
    value: u8,
    label: Str(8),
}

struct AsciiGraph {
    title: Str(32),
    data: Array(GraphDataPoint, 60),
    point_count: u64,
    max_value: u8,
    min_value: u8,
    width: u64,
}

fn collect_cpu_snapshot() -> CpuSnapshot
    effect [io:read, residual]
{
    let samples: Array(CpuSample, 32) = Array::splat(
        CpuSample{ user_pct: 0, system_pct: 0, idle_pct: 0, core_id: 0,
                   frequency_mhz: 0, temperature_c: 0 }
    );

    for i in 0..4 {
        let s: CpuSample = CpuSample{
            user_pct: 15, system_pct: 8, idle_pct: 77, core_id: i as u8,
            frequency_mhz: 2400, temperature_c: 45,
        };
        samples[i] = s;
    }

    let snapshot: CpuSnapshot = CpuSnapshot{
        samples: samples,
        core_count: 4,
        total_user: 15,
        total_system: 8,
        total_idle: 77,
        load_avg_1m: 12,
        load_avg_5m: 10,
        load_avg_15m: 8,
    };

    residual emit {
        op: "resource_monitor.cpu",
        cores: 4,
        user: 15,
        system: 8,
    };

    return snapshot;
}

fn collect_memory_snapshot() -> MemorySnapshot
    effect [io:read, residual]
{
    let used: u64 = 4096;
    let total: u64 = 16384;
    let pct: u8 = ((used * 100) / total) as u8;

    let snapshot: MemorySnapshot = MemorySnapshot{
        total_kb: total,
        used_kb: used,
        free_kb: total - used,
        cached_kb: 1024,
        kernel_kb: 512,
        available_kb: total - used + 1024,
        swap_total_kb: 8192,
        swap_used_kb: 256,
        usage_pct: pct,
    };

    residual emit {
        op: "resource_monitor.memory",
        used_kb: used,
        total_kb: total,
        pct: pct,
    };

    return snapshot;
}

fn collect_store_snapshot() -> StoreSnapshot
    effect [io:read, residual]
{
    let gens: Array(StoreGenerationUsage, 16) = Array::splat(
        StoreGenerationUsage{ gen_id: 0, object_count: 0, total_size_kb: 0,
                              residual_count: 0, trust_distribution: Array::splat(0) }
    );

    for i in 0..3 {
        let trust_dist: Array(u64, 7) = Array::splat(0);
        trust_dist[1] = 5;
        trust_dist[3] = 3;
        trust_dist[5] = 2;
        let g: StoreGenerationUsage = StoreGenerationUsage{
            gen_id: i + 1,
            object_count: 10,
            total_size_kb: 1024 + i * 512,
            residual_count: 50 + i * 10,
            trust_distribution: trust_dist,
        };
        gens[i] = g;
    }

    let snapshot: StoreSnapshot = StoreSnapshot{
        total_objects: 30,
        total_size_kb: 4096,
        free_slots: 100,
        generations: gens,
        gen_count: 3,
        active_gen: 3,
        reserved_kb: 1024,
        sealed_object_count: 6,
        promoted_object_count: 3,
    };

    residual emit {
        op: "resource_monitor.store",
        objects: 30,
        size_kb: 4096,
        gens: 3,
    };

    return snapshot;
}

fn collect_capability_usage() -> CapabilityUsageSnapshot
    effect [io:read, residual]
{
    let caps_per_sess: Array(u64, 64) = Array::splat(0);
    caps_per_sess[0] = 8;
    caps_per_sess[1] = 12;
    caps_per_sess[2] = 5;

    let caps_by_type: Array(u64, 16) = Array::splat(0);
    caps_by_type[0] = 10;
    caps_by_type[1] = 8;
    caps_by_type[2] = 5;
    caps_by_type[3] = 2;

    let snapshot: CapabilityUsageSnapshot = CapabilityUsageSnapshot{
        total_caps: 25,
        caps_per_session: caps_per_sess,
        session_count: 3,
        caps_by_type: caps_by_type,
        type_count: 4,
        total_granted: 40,
        total_derived: 15,
        total_revoked: 5,
        total_transferred: 3,
    };

    residual emit {
        op: "resource_monitor.cap_usage",
        total: 25,
        sessions: 3,
        types: 4,
    };

    return snapshot;
}

fn collect_court_backlog() -> CourtBacklogSnapshot
    effect [court:request, residual]
{
    let backlog: CourtBacklogSnapshot = CourtBacklogSnapshot{
        pending_sessions: 3,
        active_sessions: 2,
        completed_sessions: 15,
        pending_evidence: 12,
        pending_replay: 3,
        pending_comparison: 3,
        avg_wait_time_ms: 450,
        backlogged: false,
    };

    residual emit {
        op: "resource_monitor.court_backlog",
        pending: 3,
        active: 2,
    };

    return backlog;
}

fn collect_residual_volume() -> ResidualVolumeSnapshot
    effect [io:read, residual]
{
    let ops: Array(OperationCounter, 32) = Array::splat(
        OperationCounter{ op_name: Str::from(""), count: 0, avg_size: 0 }
    );
    ops[0] = OperationCounter{ op_name: Str::from("compile"), count: 150, avg_size: 256 };
    ops[1] = OperationCounter{ op_name: Str::from("store_read"), count: 450, avg_size: 128 };
    ops[2] = OperationCounter{ op_name: Str::from("store_write"), count: 320, avg_size: 512 };
    ops[3] = OperationCounter{ op_name: Str::from("court"), count: 80, avg_size: 196 };

    let snapshot: ResidualVolumeSnapshot = ResidualVolumeSnapshot{
        total_residuals: 1000,
        new_since_last: 25,
        rate_per_sec: 5,
        by_operation: ops,
        op_count: 4,
        peak_rate: 12,
        total_size_kb: 512,
    };

    residual emit {
        op: "resource_monitor.residual_vol",
        total: 1000,
        rate: 5,
    };

    return snapshot;
}

fn collect_trust_summary() -> TrustSummarySnapshot
    effect [io:read]
{
    let total: u64 = 30;
    let avg: u8 = ((0 * 2 + 1 * 5 + 2 * 4 + 3 * 6 + 4 * 3 + 5 * 7 + 6 * 3) / total) as u8;

    let summary: TrustSummarySnapshot = TrustSummarySnapshot{
        unknown_count: 2,
        observed_count: 5,
        replayed_count: 4,
        oracle_compared_count: 6,
        residual_stable_count: 3,
        sealed_count: 7,
        promoted_count: 3,
        total_objects: total,
        avg_trust_level: avg,
    };
    return summary;
}

fn build_trend_graph(values: Array(u8, 60), count: u64, title: Str(32), width: u64) -> AsciiGraph
    effect [compute]
{
    let mut max_v: u8 = 0;
    let mut min_v: u8 = 100;
    let data: Array(GraphDataPoint, 60) = Array::splat(
        GraphDataPoint{ value: 0, label: Str::from("") }
    );

    for i in 0..count {
        let v: u8 = values[i];
        data[i] = GraphDataPoint{ value: v, label: Str::from("") };
        if v > max_v { max_v = v; }
        if v < min_v { min_v = v; }
    }

    let graph: AsciiGraph = AsciiGraph{
        title: title,
        data: data,
        point_count: count,
        max_value: max_v,
        min_value: min_v,
        width: width,
    };
    return graph;
}

fn render_ascii_graph(graph: AsciiGraph, console: Cap(Console)) -> void
    effect [io:write]
{
    let mut header: Str(64) = Str::from("");
    header.append(graph.title);
    header.append(Str::from(" (max="));
    header.append(graph.max_value as Str(16));
    header.append(Str::from("%, min="));
    header.append(graph.min_value as Str(16));
    header.append(Str::from("%)\n"));
    console.write(header);

    for i in 0..graph.point_count {
        let pt: GraphDataPoint = graph.data[i];
        let mut line: Str(64) = Str::from("");
        line.append(pt.label);
        line.append(Str::from("|"));
        let bar_len: u64 = (pt.value as u64 * graph.width) / 100;
        for j in 0..bar_len {
            if j >= 40 { break; }
            line.append(Str::from("#"));
        }
        line.append(Str::from(" "));
        line.append(pt.value as Str(16));
        line.append(Str::from("%\n"));
        console.write(line);
    }
}

fn display_cpu_info(cpu: CpuSnapshot, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== CPU Usage ===\n"));
    let mut line: Str(128) = Str::from("Cores: ");
    line.append(cpu.core_count as Str(16));
    line.append(Str::from("  Load: "));
    line.append(cpu.load_avg_1m as Str(16));
    line.append(Str::from("/"));
    line.append(cpu.load_avg_5m as Str(16));
    line.append(Str::from("/"));
    line.append(cpu.load_avg_15m as Str(16));
    line.append(Str::from("\n"));
    console.write(line);

    for i in 0..cpu.core_count {
        let s: CpuSample = cpu.samples[i];
        let mut cline: Str(128) = Str::from("  Core ");
        cline.append(s.core_id as Str(16));
        cline.append(Str::from(": user="));
        cline.append(s.user_pct as Str(16));
        cline.append(Str::from("% sys="));
        cline.append(s.system_pct as Str(16));
        cline.append(Str::from("% idle="));
        cline.append(s.idle_pct as Str(16));
        cline.append(Str::from("%  "));
        cline.append(s.frequency_mhz as Str(16));
        cline.append(Str::from("MHz "));
        cline.append(s.temperature_c as Str(16));
        cline.append(Str::from("C\n"));
        console.write(cline);
    }
}

fn display_memory_info(mem: MemorySnapshot, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Memory Usage ===\n"));
    let mut line: Str(256) = Str::from("Used: ");
    line.append(mem.used_kb as Str(16));
    line.append(Str::from(" KB / "));
    line.append(mem.total_kb as Str(16));
    line.append(Str::from(" KB ("));
    line.append(mem.usage_pct as Str(16));
    line.append(Str::from("%)\n"));
    console.write(line);

    let mut line2: Str(256) = Str::from("Free: ");
    line2.append(mem.free_kb as Str(16));
    line2.append(Str::from(" KB  Cached: "));
    line2.append(mem.cached_kb as Str(16));
    line2.append(Str::from(" KB  Kernel: "));
    line2.append(mem.kernel_kb as Str(16));
    line2.append(Str::from(" KB\n"));
    console.write(line2);

    if mem.usage_pct >= CRIT_LEVEL as u8 {
        console.write(Str::from("WARNING: Critical memory usage!\n"));
    } else if mem.usage_pct >= WARN_LEVEL as u8 {
        console.write(Str::from("WARNING: High memory usage!\n"));
    }
}

fn display_store_info(store: StoreSnapshot, console: Cap(Console)) -> void
    effect [io:write]
{
    console.write(Str::from("=== Store Usage ===\n"));
    let mut line: Str(256) = Str::from("Objects: ");
    line.append(store.total_objects as Str(16));
    line.append(Str::from("  Size: "));
    line.append(store.total_size_kb as Str(16));
    line.append(Str::from(" KB  Free: "));
    line.append(store.free_slots as Str(16));
    line.append(Str::from(" slots\n"));
    console.write(line);

    let mut line2: Str(256) = Str::from("Sealed: ");
    line2.append(store.sealed_object_count as Str(16));
    line2.append(Str::from("  Promoted: "));
    line2.append(store.promoted_object_count as Str(16));
    line2.append(Str::from("  Active gen: "));
    line2.append(store.active_gen as Str(16));
    line2.append(Str::from("\n"));
    console.write(line2);

    for i in 0..store.gen_count {
        let g: StoreGenerationUsage = store.generations[i];
        let mut gline: Str(256) = Str::from("  Gen ");
        gline.append(g.gen_id as Str(16));
        gline.append(Str::from(": "));
        gline.append(g.object_count as Str(16));
        gline.append(Str::from(" objects, "));
        gline.append(g.total_size_kb as Str(16));
        gline.append(Str::from(" KB, "));
        gline.append(g.residual_count as Str(16));
        gline.append(Str::from(" residuals\n"));
        console.write(gline);
    }
}

