// ============================================================================
// Check 9: Receipts Chain Valid
// ============================================================================

fn check_receipts_chain(pkg: PackageContainer) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("receipts_chain_valid");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Compilation evidence receipts form a continuous chain from source to binary");
    let mut chain_ok: bool = true;

    // Check parse → expansion → lowering → codegen → link continuity
    let parse: StageReceipt = pkg.compilation_evidence.parse_receipt;
    let expand: StageReceipt = pkg.compilation_evidence.expansion_receipt;
    let lower: StageReceipt = pkg.compilation_evidence.lowering_receipt;
    let codegen: StageReceipt = pkg.compilation_evidence.codegen_receipt;
    let link: StageReceipt = pkg.compilation_evidence.link_receipt;

    // Parse must have non-empty stage name
    if parse.stage_name_len == 0 { chain_ok = false; }

    // Expansion input must match parse output
    if expand.stage_name_len > 0 {
        if !hash256_equal(expand.input_hash, parse.output_hash) {
            chain_ok = false;
        }
    }

    // Lowering input must match expansion output
    if lower.stage_name_len > 0 {
        if !hash256_equal(lower.input_hash, expand.output_hash) {
            chain_ok = false;
        }
    }

    // Codegen input must match lowering output
    if codegen.stage_name_len > 0 {
        if !hash256_equal(codegen.input_hash, lower.output_hash) {
            chain_ok = false;
        }
    }

    // Link input must match codegen output
    if link.stage_name_len > 0 {
        if !hash256_equal(link.input_hash, codegen.output_hash) {
            chain_ok = false;
        }
    }

    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let fail_len: u32 = 0;
    if chain_ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Compilation receipt chain is discontinuous — stage output/input hash mismatch");
        for i in 0..80 { fail_detail[i] = msg[i]; }
        fail_len = 80;
    }

    residual emit { op: "pkg_check.9.receipts_chain", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 9, check_name: name, check_name_len: 21,
        description: desc, description_len: 87,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

// ============================================================================
// Check 10: Replay Verification
// ============================================================================

fn check_replay_verification(pkg: PackageContainer) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("replay_verification_valid");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Replay evidence must be present and show successful replay");

    let replay: ReplayEvidence = pkg.replay_evidence;
    let report = replay.replay_verification_report;
    let ok: bool = report.checkpoint_count > 0 &&
                   report.replay_status == ReplayStatus::Full;

    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let fail_len: u32 = 0;
    if ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Replay verification failed — checkpoints missing or replay did not complete");
        for i in 0..79 { fail_detail[i] = msg[i]; }
        fail_len = 79;
    }

    residual emit { op: "pkg_check.10.replay", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 10, check_name: name, check_name_len: 25,
        description: desc, description_len: 71,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

// ============================================================================
// Check 11: Court Verdicts Present and Favorable
// ============================================================================

fn check_court_verdicts(pkg: PackageContainer) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("court_verdicts_valid");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Court verdicts must be present and must not be Rejected or Inauthentic");

    let court: CourtEvidence = pkg.court_evidence;
    let mut ok: bool = true;

    if court.verdict_count == 0 {
        ok = false;
    } else {
        for i in 0..court.verdict_count as u64 {
            let verdict = court.court_verdicts[i].verdict;
            if verdict == ObjectVerdict::Rejected ||
               verdict == ObjectVerdict::Inauthentic ||
               verdict == ObjectVerdict::Divergent {
                ok = false;
            }
        }
    }

    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let fail_len: u32 = 0;
    if ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Court verdicts missing or contain rejections — package cannot be promoted");
        for i in 0..77 { fail_detail[i] = msg[i]; }
        fail_len = 77;
    }

    residual emit { op: "pkg_check.11.court", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 11, check_name: name, check_name_len: 21,
        description: desc, description_len: 86,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

// ============================================================================
// Hash256 zero check helper
// ============================================================================

fn hash256_is_zero(h: Hash256) -> bool
    effect [compute]
{
    for i in 0..32 {
        if h.bytes[i] != 0 {
            return false;
        }
    }
    return true;
}

// ============================================================================
// Complete Package Verification — 11-Check Orchestrator
// ============================================================================

/// Verify a package container against all 11 conditions.
///
/// The verifier rejects any package where:
///   (1) source is missing
///   (2) source hash does not match embedded source
///   (3) binary evidence is missing
///   (4) binary hash does not match emitted binary
///   (5) source signature is missing or invalid
///   (6) binary signature is missing or invalid
///   (7) source↔binary seal is unsigned or missing
///   (8) build recipe is missing
///   (9) receipt chain is discontinuous
///   (10) replay verification failed
///   (11) court verdicts are missing or unfavorable
fn verify_package(
    pkg: PackageContainer,
    trusted_keys: Array[Hash256, 64],
    trusted_key_count: u32,
    verifier: Identity,
    timestamp: u64,
) -> PkgVerificationReport
    effect [compute, residual]
{
    let report: PkgVerificationReport = pkg_verification_report_new(
        pkg.header.package_name,
        pkg.header.package_name_len,
        pkg.header.package_version,
        pkg.header.package_version_len,
        verifier,
        timestamp,
    );
    let mut rep: PkgVerificationReport = report;

    residual emit {
        op: "verify_package.start",
        name_prefix: pkg.header.package_name[0] as u64,
    };

    // Check 1: Source present
    let c1: PkgVerificationCheck = check_source_present(pkg);
    rep = pkg_report_add_check(rep, c1);

    // Check 2: Source hash match
    let c2: PkgVerificationCheck = check_source_hash(pkg);
    rep = pkg_report_add_check(rep, c2);

    // Check 3: Binary present
    let c3: PkgVerificationCheck = check_binary_present(pkg);
    rep = pkg_report_add_check(rep, c3);

    // Check 4: Binary hash match
    let c4: PkgVerificationCheck = check_binary_hash(pkg);
    rep = pkg_report_add_check(rep, c4);

    // Check 5: Source signature
    let c5: PkgVerificationCheck = check_source_signature(pkg, trusted_keys, trusted_key_count);
    rep = pkg_report_add_check(rep, c5);

    // Check 6: Binary signature
    let c6: PkgVerificationCheck = check_binary_signature(pkg, trusted_keys, trusted_key_count);
    rep = pkg_report_add_check(rep, c6);

    // Check 7: Seal signature
    let c7: PkgVerificationCheck = check_seal_signature(pkg, trusted_keys, trusted_key_count);
    rep = pkg_report_add_check(rep, c7);

    // Check 8: Build recipe
    let c8: PkgVerificationCheck = check_build_recipe(pkg);
    rep = pkg_report_add_check(rep, c8);

    // Check 9: Receipts chain
    let c9: PkgVerificationCheck = check_receipts_chain(pkg);
    rep = pkg_report_add_check(rep, c9);

    // Check 10: Replay verification
    let c10: PkgVerificationCheck = check_replay_verification(pkg);
    rep = pkg_report_add_check(rep, c10);

    // Check 11: Court verdicts
    let c11: PkgVerificationCheck = check_court_verdicts(pkg);
    rep = pkg_report_add_check(rep, c11);

    // Finalize
    let rep: PkgVerificationReport = pkg_report_finalize(rep);

    residual emit {
        op: "verify_package.complete",
        name_prefix: pkg.header.package_name[0] as u64,
        result: rep.result as u64,
        passed: rep.passed,
        failed: rep.failed,
    };

    return rep;
}

// ============================================================================
// Additional Package Verification Utilities
// ============================================================================

/// Verify that a package's source archive matches its manifest.
fn check_source_archive_integrity(pkg: PackageContainer) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("source_archive_integrity");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Source archive content matches manifest entries and source hash");

    let mut ok: bool = true;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let mut fail_len: u32 = 0;

    // Check that manifest is non-empty when archive is present
    if pkg.source_evidence.source_archive_len > 0 {
        if pkg.source_evidence.manifest_count == 0 {
            ok = false;
            let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Source archive present but manifest is empty");
            for i in 0..47 { fail_detail[i] = msg[i]; }
            fail_len = 47;
        }
    }

    // Check that all manifest entries have non-zero hashes
    for i in 0..pkg.source_evidence.manifest_count as u64 {
        let entry: SourceManifestEntry = pkg.source_evidence.manifest[i];
        if hash256_is_zero(entry.file_hash) {
            ok = false;
        }
        if entry.path_len == 0 {
            ok = false;
        }
    }

    let result: PkgCheckResult;
    if ok { result = PkgCheckResult::Pass; } else { result = PkgCheckResult::Fail; }

    residual emit { op: "pkg_check.extra.archive_integrity", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 12, check_name: name, check_name_len: 24,
        description: desc, description_len: 74,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

/// Verify that the environment capsule is fully specified.
fn check_environment_capsule(pkg: PackageContainer) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("environment_capsule_complete");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Environment capsule must specify CPU features, memory, oracles, and courts");

    let capsule = pkg.build_evidence.environment_capsule;
    let mut ok: bool = true;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let mut fail_len: u32 = 0;

    if capsule.cpu_feature_count == 0 {
        ok = false;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Environment capsule missing CPU features");
        for i in 0..42 { fail_detail[i] = msg[i]; }
        fail_len = 42;
    }

    if capsule.oracle_count == 0 {
        ok = false;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Environment capsule missing oracle identities");
        for i in 0..49 { fail_detail[i] = msg[i]; }
        fail_len = 49;
    }

    if capsule.court_version_count == 0 {
        ok = false;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Environment capsule missing court version references");
        for i in 0..55 { fail_detail[i] = msg[i]; }
        if fail_len == 0 { fail_len = 55; }
    }

    let result: PkgCheckResult;
    if ok { result = PkgCheckResult::Pass; } else { result = PkgCheckResult::Fail; }

    residual emit { op: "pkg_check.extra.environment_capsule", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 13, check_name: name, check_name_len: 27,
        description: desc, description_len: 83,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

/// Verify that package signature count meets minimum threshold.
fn check_signature_threshold(pkg: PackageContainer, min_signatures: u32) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("signature_count_threshold");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Package must have at least the minimum number of valid signatures");

    let mut count: u32 = 0;
    if pkg.signatures.full_sig_present { count = count + 1; }
    if pkg.signatures.evidence_sig_present { count = count + 1; }
    count = count + pkg.signatures.auditor_stamp_count;

    let ok: bool = count >= min_signatures;
    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let mut fail_len: u32 = 0;

    if ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Insufficient signatures on package");
        for i in 0..36 { fail_detail[i] = msg[i]; }
        fail_len = 36;
    }

    residual emit { op: "pkg_check.extra.signature_threshold", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 14, check_name: name, check_name_len: 26,
        description: desc, description_len: 76,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

// ============================================================================
// Complete Extended Verification (14 checks)
// ============================================================================

/// Run extended package verification with all 14 checks.
fn verify_package_extended(
    pkg: PackageContainer,
    trusted_keys: Array[Hash256, 64],
    trusted_key_count: u32,
    min_signatures: u32,
    verifier: Identity,
    timestamp: u64,
) -> PkgVerificationReport
    effect [compute, residual]
{
    let report: PkgVerificationReport = pkg_verification_report_new(
        pkg.header.package_name,
        pkg.header.package_name_len,
        pkg.header.package_version,
        pkg.header.package_version_len,
        verifier,
        timestamp,
    );
    let mut rep: PkgVerificationReport = report;

    residual emit {
        op: "verify_package_extended.start",
        name_prefix: pkg.header.package_name[0] as u64,
    };

    // Core 11 checks
    let c1 = check_source_present(pkg); rep = pkg_report_add_check(rep, c1);
    let c2 = check_source_hash(pkg); rep = pkg_report_add_check(rep, c2);
    let c3 = check_binary_present(pkg); rep = pkg_report_add_check(rep, c3);
    let c4 = check_binary_hash(pkg); rep = pkg_report_add_check(rep, c4);
    let c5 = check_source_signature(pkg, trusted_keys, trusted_key_count); rep = pkg_report_add_check(rep, c5);
    let c6 = check_binary_signature(pkg, trusted_keys, trusted_key_count); rep = pkg_report_add_check(rep, c6);
    let c7 = check_seal_signature(pkg, trusted_keys, trusted_key_count); rep = pkg_report_add_check(rep, c7);
    let c8 = check_build_recipe(pkg); rep = pkg_report_add_check(rep, c8);
    let c9 = check_receipts_chain(pkg); rep = pkg_report_add_check(rep, c9);
    let c10 = check_replay_verification(pkg); rep = pkg_report_add_check(rep, c10);
    let c11 = check_court_verdicts(pkg); rep = pkg_report_add_check(rep, c11);

    // Extended checks
    let c12 = check_source_archive_integrity(pkg); rep = pkg_report_add_check(rep, c12);
    let c13 = check_environment_capsule(pkg); rep = pkg_report_add_check(rep, c13);
    let c14 = check_signature_threshold(pkg, min_signatures); rep = pkg_report_add_check(rep, c14);

    let rep = pkg_report_finalize(rep);

    residual emit {
        op: "verify_package_extended.complete",
        passed: rep.passed,
        failed: rep.failed,
        result: rep.result as u64,
    };

    return rep;
}

// ============================================================================
// SourceManifestEntry type alias for extra checks
// ============================================================================

struct SourceManifestEntry
    layout packed
{
    path: Array[u8, 256],
    path_len: u32,
    file_hash: Hash256,
    file_size: u64,
    file_type: u8,
}
