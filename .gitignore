# ---------------------------------------------------------------------------
# Rust build output
# ---------------------------------------------------------------------------
/target/
**/target/

# ---------------------------------------------------------------------------
# Phorensic compiler outputs (regenerated by `phorc`)
# ---------------------------------------------------------------------------
*.o
*.a
*.rlib
*.exe
*.d
kernel_obj-*
*.receipts.json
*.sealed_package.json

# ---------------------------------------------------------------------------
# The promoted leaf objects ARE the seal. They are committed as evidence so the
# persistent sealed-port store (phost/evidence/store/index.json) can be loaded
# and dispatched without invoking the compiler. The verifier independently
# recompiles each source and requires byte-equality with the committed object,
# so committing it strengthens the check rather than weakening it.
# ---------------------------------------------------------------------------
!phost/evidence/porting/*/candidate.o
# A leaf published by an autonomous campaign is committed the same way: the seal
# is the object's bytes, and the generation-session runtime loads it (no compiler).
!phost/evidence/autonomous/*/candidate.o

# ---------------------------------------------------------------------------
# Kernel link outputs / boot images
# ---------------------------------------------------------------------------
*.elf
*.elf.elf
*.img
*.iso

# ---------------------------------------------------------------------------
# QEMU boot evidence (regenerated by phost_kernel/boot_qemu.sh)
# Covers evidence/, evidence2/, evidence-t2/, evidence-trace/, evidence-final2/, ...
# ---------------------------------------------------------------------------
phost_kernel/evidence*/
*.ppm
*.log

# ---------------------------------------------------------------------------
# Generated dumps in the phorc evidence pack
# ---------------------------------------------------------------------------
phorc/evidence_pack/readelf-*.txt
phorc/evidence_pack/objdump-*.txt

# ---------------------------------------------------------------------------
# Composition oracle traces (regenerated deterministically; only the compact
# composition verdict is committed, since the traces are large and derivable
# from the committed leaf corpora + libc).
# ---------------------------------------------------------------------------
phost/evidence/composition/**/composition_oracle_traces.json
phost/evidence/composition_ir/**/composition_oracle_traces.json

# ---------------------------------------------------------------------------
# phorport (Phase 4): generated FRF-Fuzz target projects, work objects and the
# FRF-Fuzz campaign store are local build artifacts; only the minimized
# counterexample evidence is committed.
# ---------------------------------------------------------------------------
.phorport/
.frf-fuzz/
.fuzzspike/

# ---------------------------------------------------------------------------
# Private design notes (not published)
# ---------------------------------------------------------------------------
IDEA.md

# Read-only reconnaissance of the sibling FRF / FRF-Fuzz / Gemel repositories,
# extracted with `git archive` for local architecture review. Never committed.
/.recon/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
nul
.DS_Store
Thumbs.db
*.swp
