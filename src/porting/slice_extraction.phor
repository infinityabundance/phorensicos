// ============================================================================
// slice_extraction.phor — Native Slice Extraction, Sealing, Promotion
// ============================================================================
// Native slice extraction takes verified candidate translations and produces
// standalone native Phorensic code slices. Each slice is compiled with full
// receipts, verified against the original behavior, sealed with an evidence
// chain, and promoted into the forensic store.
// ============================================================================

package "phorensic:slice_extraction:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type SliceExtractionError = enum {
    MissingSource = 0x01,
    CompilationFailed = 0x02,
    VerificationFailed = 0x03,
    SealingFailed = 0x04,
    PromotionDenied = 0x05,
    EvidenceChainBroken = 0x06,
    TrustStateInsufficient = 0x07,
    SliceAlreadySealed = 0x08,
    SliceNotFound = 0x09,
    StoreOperationFailed = 0x0A,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Trust State
// ============================================================================

type TrustState = enum {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

// ============================================================================
// Native Slice
// ============================================================================

type NativeSlice = struct {
    slice_id: Hash256,
    slice_name: FixedString[256],
    foreign_operation_hash: Hash256,
    native_sequence_hash: Hash256,
    phorensic_source: Array[u8, 65536],
    source_length: u64,
    source_hash: Hash256,
    phorensic_binary: Array[u8, 65536],
    binary_length: u64,
    binary_hash: Hash256,
    compilation_receipt: CompilationReceipt,
    trust_state: TrustState,
    evidence_chain: Array[EvidenceNode, 64],
    evidence_count: u64,
    is_sealed: bool,
    is_promoted: bool,
    created_at: u64,
    sealed_at: u64,
    promoted_at: u64,
    generation: u64,
}

// ============================================================================
// Compilation Receipt
// ============================================================================

type CompilationReceipt = struct {
    receipt_hash: Hash256,
    compiler_version: FixedString[32],
    compilation_flags: FixedString[256],
    source_hash: Hash256,
    binary_hash: Hash256,
    passes_passed: u64,
    passes_total: u64,
    optimization_level: FixedString[16],
    bounded_loops_verified: u64,
    effects_verified: u64,
    capabilities_checked: u64,
    warnings: Array[FixedString[256], 64],
    warning_count: u64,
    errors: Array[FixedString[256], 32],
    error_count: u64,
    compilation_success: bool,
    timestamp: u64,
}

// ============================================================================
// Evidence Node (for evidence chain)
// ============================================================================

type EvidenceNode = struct {
    node_index: u64,
    evidence_type: SliceEvidenceType,
    evidence_hash: Hash256,
    previous_hash: Hash256,
    description: FixedString[256],
    timestamp: u64,
    verified_by: FixedString[128],
}

type SliceEvidenceType = enum {
    ForeignObservation = 0x01,
    ResidualBundle = 0x02,
    CandidateTranslation = 0x03,
    ReplayReport = 0x04,
    OracleComparison = 0x05,
    CourtVerdict = 0x06,
    SourceArtifact = 0x07,
    BinaryArtifact = 0x08,
    CompilationReceipt = 0x09,
    SealSignature = 0x0A,
    AuditorStamp = 0x0B,
    ManualReview = 0x0C,
    Unknown = 0xFF,
}

// ============================================================================
// Slice Store
// ============================================================================

type SliceStore = struct {
    slices: Array[NativeSlice, 256],
    slice_count: u64,
    generation: u64,
}

// ============================================================================
// Create Empty Native Slice
// ============================================================================

fn create_native_slice(slice_name: &FixedString[256], foreign_op_hash: Hash256, native_seq_hash: Hash256) -> NativeSlice
    effects: [compute]
{
    let empty_source: Array[u8, 65536] = Array[u8, 65536]::zeroed();
    let empty_binary: Array[u8, 65536] = Array[u8, 65536]::zeroed();
    let empty_evidence: Array[EvidenceNode, 64] = Array[EvidenceNode, 64]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_warnings: Array[FixedString[256], 64] = Array[FixedString[256], 64]::zeroed();
    let empty_errors: Array[FixedString[256], 32] = Array[FixedString[256], 32]::zeroed();

    let receipt: CompilationReceipt = CompilationReceipt {
        receipt_hash: zero_hash,
        compiler_version: FixedString[32]::from_literal("phc-2.0.0"),
        compilation_flags: FixedString[256]::zeroed(),
        source_hash: zero_hash,
        binary_hash: zero_hash,
        passes_passed: 0,
        passes_total: 0,
        optimization_level: FixedString[16]::from_literal("none"),
        bounded_loops_verified: 0,
        effects_verified: 0,
        capabilities_checked: 0,
        warnings: empty_warnings,
        warning_count: 0,
        errors: empty_errors,
        error_count: 0,
        compilation_success: false,
        timestamp: 0,
    };

    return NativeSlice {
        slice_id: zero_hash,
        slice_name: *slice_name,
        foreign_operation_hash: foreign_op_hash,
        native_sequence_hash: native_seq_hash,
        phorensic_source: empty_source,
        source_length: 0,
        source_hash: zero_hash,
        phorensic_binary: empty_binary,
        binary_length: 0,
        binary_hash: zero_hash,
        compilation_receipt: receipt,
        trust_state: TrustState::Unknown,
        evidence_chain: empty_evidence,
        evidence_count: 0,
        is_sealed: false,
        is_promoted: false,
        created_at: kernel.tick_count(),
        sealed_at: 0,
        promoted_at: 0,
        generation: 1,
    };
}

// ============================================================================
// Create Slice Store
// ============================================================================

fn create_slice_store() -> SliceStore
    effects: [compute]
{
    let empty_slices: Array[NativeSlice, 256] = Array[NativeSlice, 256]::zeroed();
    return SliceStore {
        slices: empty_slices,
        slice_count: 0,
        generation: 1,
    };
}

// ============================================================================
// Write Phorensic Source for Slice
// ============================================================================
// Generates Phorensic source code from the native operation sequence.

fn write_slice_source(slice: &mut NativeSlice, source: &Array[u8, 65536], source_len: u64) -> Result[Hash256, SliceExtractionError]
    effects: [compute, residual]
{
    if source_len > 65536 {
        return Err(SliceExtractionError::MissingSource);
    }

    for i in 0..source_len {
        slice.phorensic_source[i] = source[i];
    }
    slice.source_length = source_len;
    slice.source_hash = hash_slice_data(source, source_len);

    @emit_residual("slice_extraction.write_source", "source_written", slice.source_hash);

    return Ok(slice.source_hash);
}

// ============================================================================
// Compile Slice
// ============================================================================
// Compiles the native slice source to binary with full receipt tracking.

fn compile_slice(slice: &mut NativeSlice, compiler_flags: &FixedString[256]) -> Result[CompilationReceipt, SliceExtractionError]
    effects: [compute, io, residual]
{
    if slice.source_length == 0 {
        return Err(SliceExtractionError::MissingSource);
    }

    // Simulated compilation — in real implementation, invokes phc compiler
    slice.compilation_receipt.compilation_flags = *compiler_flags;
    slice.compilation_receipt.source_hash = slice.source_hash;
    slice.compilation_receipt.compilation_success = true;
    slice.compilation_receipt.passes_passed = 8;
    slice.compilation_receipt.passes_total = 8;
    slice.compilation_receipt.bounded_loops_verified = 4;
    slice.compilation_receipt.effects_verified = 2;
    slice.compilation_receipt.capabilities_checked = 1;
    slice.compilation_receipt.timestamp = kernel.tick_count();

    // Simulate binary output
    let bin_len: u64 = if slice.source_length < 65536 { slice.source_length } else { 65536 };
    for i in 0..bin_len {
        slice.phorensic_binary[i] = slice.phorensic_source[i] ^ 0xAA;  // Simulated transform
    }
    slice.binary_length = bin_len;
    slice.binary_hash = hash_slice_data(&slice.phorensic_binary, bin_len);

    slice.compilation_receipt.binary_hash = slice.binary_hash;

    // Compute receipt hash
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut receipt_hash: Hash256 = zero_hash;
    receipt_hash = hash_receipt_combine(receipt_hash, slice.source_hash);
    receipt_hash = hash_receipt_combine(receipt_hash, slice.binary_hash);
    receipt_hash = hash_receipt_combine(receipt_hash, slice.compilation_receipt.passes_passed);
    slice.compilation_receipt.receipt_hash = receipt_hash;

    @emit_residual("slice_extraction.compile", "slice_compiled", slice.binary_hash);

    return Ok(slice.compilation_receipt);
}

// ============================================================================
// Verify Slice Against Foreign Behavior
// ============================================================================
// Verifies that the compiled slice produces the same output as the foreign
// operation for a set of test inputs.

fn verify_slice_behavior(slice: &mut NativeSlice, foreign_op_hash: Hash256, test_inputs_hash: Hash256) -> Result<bool, SliceExtractionError>
    effects: [compute, io, residual]
{
    // Simulated verification — compares binary hash against expected
    let expected_hash: Hash256 = hash_slice_combine(foreign_op_hash, test_inputs_hash);
    let actual_hash: Hash256 = hash_slice_combine(slice.binary_hash, test_inputs_hash);

    let match_result: bool = expected_hash == actual_hash;

    if match_result {
        slice.trust_state = TrustState::OracleCompared;

        @emit_residual("slice_extraction.verify", "slice_verified", slice.binary_hash);
    } else {
        @emit_residual("slice_extraction.verify_failed", "slice_verification_failed", slice.binary_hash);
    }

    return Ok(match_result);
}

// ============================================================================
// Add Evidence to Chain
// ============================================================================

fn add_slice_evidence(slice: &mut NativeSlice, evidence_type: SliceEvidenceType, evidence_hash: Hash256, desc: &FixedString[256], verifier: &FixedString[128]) -> Result<u64, SliceExtractionError>
    effects: [compute, residual]
{
    if slice.evidence_count >= 64 {
        return Err(SliceExtractionError::EvidenceChainBroken);
    }

    let prev_hash: Hash256 = if slice.evidence_count > 0 {
        slice.evidence_chain[slice.evidence_count - 1].evidence_hash
    } else {
        Hash256 { bytes: Array[u8, 32]::zeroed() }
    };

    let node: EvidenceNode = EvidenceNode {
        node_index: slice.evidence_count,
        evidence_type: evidence_type,
        evidence_hash: evidence_hash,
        previous_hash: prev_hash,
        description: *desc,
        timestamp: kernel.tick_count(),
        verified_by: *verifier,
    };

    slice.evidence_chain[slice.evidence_count] = node;
    slice.evidence_count = slice.evidence_count + 1;

    @emit_residual("slice_extraction.add_evidence", "evidence_added", slice.evidence_count);

    return Ok(slice.evidence_count);
}

// ============================================================================
// Seal Slice
// ============================================================================
// Seals the native slice with the complete evidence chain. Once sealed,
// the slice cannot be modified.

fn seal_slice(slice: &mut NativeSlice) -> Result[Hash256, SliceExtractionError]
    effects: [compute, residual]
{
    if slice.is_sealed {
        return Err(SliceExtractionError::SliceAlreadySealed);
    }

    if slice.trust_state < TrustState::OracleCompared {
        return Err(SliceExtractionError::TrustStateInsufficient);
    }

    // Compute final slice ID from source, binary, and evidence
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut combined_hash: Hash256 = zero_hash;
    combined_hash = hash_slice_combine(combined_hash, slice.source_hash);
    combined_hash = hash_slice_combine(combined_hash, slice.binary_hash);
    combined_hash = hash_slice_combine(combined_hash, slice.compilation_receipt.receipt_hash);

    for i in 0..slice.evidence_count {
        combined_hash = hash_slice_combine(combined_hash, slice.evidence_chain[i].evidence_hash);
    }

    slice.slice_id = combined_hash;
    slice.trust_state = TrustState::Sealed;
    slice.is_sealed = true;
    slice.sealed_at = kernel.tick_count();

    @emit_residual("slice_extraction.seal", "slice_sealed", slice.slice_id);

    return Ok(slice.slice_id);
}

// ============================================================================
// Promote Slice to Forensic Store
// ============================================================================
// Promotes a sealed slice to the Promoted trust state in the forensic store.

fn promote_slice(slice: &mut NativeSlice, store_capability: Hash256) -> Result[TrustState, SliceExtractionError]
    effects: [compute, io, residual]
{
    if !slice.is_sealed {
        return Err(SliceExtractionError::TrustStateInsufficient);
    }

    if slice.is_promoted {
        return Err(SliceExtractionError::SliceAlreadySealed);
    }

    // Verify evidence chain integrity
    let chain_valid: bool = verify_evidence_chain(slice);

    if !chain_valid {
        return Err(SliceExtractionError::EvidenceChainBroken);
    }

    slice.trust_state = TrustState::Promoted;
    slice.is_promoted = true;
    slice.promoted_at = kernel.tick_count();

    @emit_residual("slice_extraction.promote", "slice_promoted", slice.slice_id);

    return Ok(TrustState::Promoted);
}

// ============================================================================
// Verify Evidence Chain
// ============================================================================
// Verifies that the evidence chain is intact and unbroken.

fn verify_evidence_chain(slice: &NativeSlice) -> bool
    effects: [compute]
{
    if slice.evidence_count == 0 {
        return false;
    }

    // Verify that each node's previous_hash matches the previous node's hash
    for i in 1..slice.evidence_count {
        if slice.evidence_chain[i].previous_hash != slice.evidence_chain[i - 1].evidence_hash {
            return false;
        }
    }

    return true;
}

// ============================================================================
// Store Operations
// ============================================================================

fn store_add_slice(store: &mut SliceStore, slice: NativeSlice) -> Result[Hash256, SliceExtractionError]
    effects: [compute, residual]
{
    if store.slice_count >= 256 {
        return Err(SliceExtractionError::StoreOperationFailed);
    }

    // Check for duplicate
    for i in 0..store.slice_count {
        if store.slices[i].slice_id == slice.slice_id {
            return Err(SliceExtractionError::SliceAlreadySealed);
        }
    }

    let hash: Hash256 = slice.slice_id;
    store.slices[store.slice_count] = slice;
    store.slice_count = store.slice_count + 1;

    @emit_residual("slice_extraction.store_add", "slice_stored", hash);

    return Ok(hash);
}

fn store_get_slice(store: &SliceStore, slice_id: Hash256) -> Result<&NativeSlice, SliceExtractionError>
    effects: [compute]
{
    for i in 0..store.slice_count {
        if store.slices[i].slice_id == slice_id {
            return Ok(store.slices[i]);
        }
    }
    return Err(SliceExtractionError::SliceNotFound);
}

fn store_get_slice_mut(store: &mut SliceStore, slice_id: Hash256) -> Result<&mut NativeSlice, SliceExtractionError>
    effects: [compute]
{
    for i in 0..store.slice_count {
        if store.slices[i].slice_id == slice_id {
            return Ok(store.slices[i]);
        }
    }
    return Err(SliceExtractionError::SliceNotFound);
}

fn store_get_slices_by_trust(store: &SliceStore, state: TrustState) -> Result[Array[NativeSlice, 256], SliceExtractionError]
    effects: [compute]
{
    let mut results: Array[NativeSlice, 256] = Array[NativeSlice, 256]::zeroed();
    let mut count: u64 = 0;

    for i in 0..store.slice_count {
        if store.slices[i].trust_state == state {
            if count < 256 {
                results[count] = store.slices[i];
                count = count + 1;
            }
        }
    }

    return Ok(results);
}

fn store_get_sealed_slices(store: &SliceStore) -> Result[Array[NativeSlice, 256], SliceExtractionError>
    effects: [compute]
{
    let mut results: Array[NativeSlice, 256] = Array[NativeSlice, 256]::zeroed();
    let mut count: u64 = 0;

    for i in 0..store.slice_count {
        if store.slices[i].is_sealed {
            if count < 256 {
                results[count] = store.slices[i];
                count = count + 1;
            }
        }
    }

    return Ok(results);
}

// ============================================================================
// Extract and Seal Pipeline (Full Flow)
// ============================================================================
// Performs the complete extraction, compilation, verification, sealing,
// and promotion flow for a single candidate.

fn extract_and_seal_slice(
    store: &mut SliceStore,
    slice_name: &FixedString[256],
    foreign_op_hash: Hash256,
    native_seq_hash: Hash256,
    source: &Array[u8, 65536],
    source_len: u64,
    compiler_flags: &FixedString[256],
    test_inputs_hash: Hash256,
    store_capability: Hash256
) -> Result[Hash256, SliceExtractionError]
    effects: [compute, io, residual]
{
    // Step 1: Create slice
    let mut slice: NativeSlice = create_native_slice(slice_name, foreign_op_hash, native_seq_hash);

    // Step 2: Write source
    write_slice_source(&mut slice, source, source_len)?;

    // Step 3: Compile
    let receipt: CompilationReceipt = compile_slice(&mut slice, compiler_flags)?;
    if !receipt.compilation_success {
        return Err(SliceExtractionError::CompilationFailed);
    }

    // Step 4: Verify against foreign behavior
    let verified: bool = verify_slice_behavior(&mut slice, foreign_op_hash, test_inputs_hash)?;
    if !verified {
        return Err(SliceExtractionError::VerificationFailed);
    }

    // Step 5: Add evidence chain
    let evidence_desc: FixedString[256] = FixedString[256]::from_literal("Slice extracted and verified");
    let verifier: FixedString[128] = FixedString[128]::from_literal("porting_engine");
    add_slice_evidence(&mut slice, SliceEvidenceType::SourceArtifact, slice.source_hash, &evidence_desc, &verifier)?;
    add_slice_evidence(&mut slice, SliceEvidenceType::CompilationReceipt, receipt.receipt_hash, &FixedString[256]::from_literal("Compilation receipt"), &verifier)?;

    // Step 6: Seal
    let slice_id: Hash256 = seal_slice(&mut slice)?;

    // Step 7: Store
    store_add_slice(store, slice)?;

    // Step 8: Promote
    // (In practice this would be done after court verification)
    // promote_slice(&mut slice, store_capability)?;

    @emit_residual("slice_extraction.extract_and_seal", "slice_extracted_and_sealed", slice_id);

    return Ok(slice_id);
}

// ============================================================================
// Get Slice Summary
// ============================================================================

type SliceSummary = struct {
    slice_id: Hash256,
    slice_name: FixedString[256],
    source_hash: Hash256,
    binary_hash: Hash256,
    trust_state: TrustState,
    evidence_count: u64,
    is_sealed: bool,
    is_promoted: bool,
    created_at: u64,
    sealed_at: u64,
    promoted_at: u64,
    compilaton_success: bool,
}

fn get_slice_summary(slice: &NativeSlice) -> SliceSummary
    effects: [compute]
{
    return SliceSummary {
        slice_id: slice.slice_id,
        slice_name: slice.slice_name,
        source_hash: slice.source_hash,
        binary_hash: slice.binary_hash,
        trust_state: slice.trust_state,
        evidence_count: slice.evidence_count,
        is_sealed: slice.is_sealed,
        is_promoted: slice.is_promoted,
        created_at: slice.created_at,
        sealed_at: slice.sealed_at,
        promoted_at: slice.promoted_at,
        compilaton_success: slice.compilation_receipt.compilation_success,
    };
}

// ============================================================================
// Hash Helpers
// ============================================================================

fn hash_slice_data(data: &Array[u8, 65536], len: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let hash_len: u64 = if len < 65536 { len } else { 65536 };
    for i in 0..hash_len {
        let idx: u64 = i & 31;
        result.bytes[idx] = result.bytes[idx] ^ data[i];
    }
    return result;
}

fn hash_slice_combine(a: Hash256, b: Hash256) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    return result;
}

fn hash_receipt_combine(a: Hash256, b: Hash256) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    return result;
}

fn hash_receipt_combine(a: Hash256, b: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..8 {
        result.bytes[i] = a.bytes[i] ^ ((b >> (i * 8)) & 0xFF) as u8;
    }
    for i in 8..32 {
        result.bytes[i] = a.bytes[i];
    }
    return result;
}

// ============================================================================
// Verify Slice Against Original Foreign Behavior
// ============================================================================
// Runs a comprehensive verification of the slice against the original
// foreign operation's observed behavior.

type SliceVerificationReport = struct {
    slice_id: Hash256,
    foreign_op_hash: Hash256,
    verification_type: SliceVerificationType,
    test_case_count: u64,
    passed: u64,
    failed: u64,
    output_hash: Hash256,
    expected_hash: Hash256,
    is_match: bool,
    details: FixedString[1024],
    timestamp: u64,
}

type SliceVerificationType = enum {
    ByteExact = 0x01,
    Behavioral = 0x02,
    ResidualMatch = 0x03,
    CourtProven = 0x04,
}

fn verify_slice_comprehensive(slice: &NativeSlice, foreign_op_hash: Hash256, test_inputs: &Array[Hash256, 256], input_count: u64) -> SliceVerificationReport
    effects: [compute, io, residual]
{
    let mut passed: u64 = 0;
    let mut failed: u64 = 0;
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut output_hash: Hash256 = zero_hash;
    let mut is_match: bool = true;

    for i in 0..input_count {
        let input: Hash256 = test_inputs[i];
        if input == zero_hash {
            break;
        }

        // Simulate running the slice against the input
        let slice_result: Hash256 = hash_slice_combine(slice.binary_hash, input);
        let expected: Hash256 = hash_slice_combine(foreign_op_hash, input);

        if slice_result == expected {
            passed = passed + 1;
        } else {
            failed = failed + 1;
            is_match = false;
        }
        output_hash = hash_slice_combine(output_hash, slice_result);
    }

    let report: SliceVerificationReport = SliceVerificationReport {
        slice_id: slice.slice_id,
        foreign_op_hash: foreign_op_hash,
        verification_type: SliceVerificationType::Behavioral,
        test_case_count: passed + failed,
        passed: passed,
        failed: failed,
        output_hash: output_hash,
        expected_hash: foreign_op_hash,
        is_match: is_match,
        details: FixedString[1024]::from_literal("Slice verification complete"),
        timestamp: kernel.tick_count(),
    };

    @emit_residual("slice_extraction.verify_comprehensive", "comprehensive_verification_done", passed);

    return report;
}

// ============================================================================
// Batch Extract Multiple Slices
// ============================================================================
// Processes multiple candidates into sealed slices in a batch.

fn batch_extract_slices(store: &mut SliceStore, candidates: &Array[(FixedString[256], Hash256, Hash256, Array[u8, 65536], u64), 32], count: u64, compiler_flags: &FixedString[256], test_inputs: &Array[Hash256, 256], input_count: u64, store_cap: Hash256) -> Result<u64, SliceExtractionError>
    effects: [compute, io, residual]
{
    let mut sealed_count: u64 = 0;

    for i in 0..count {
        let (slice_name, foreign_hash, seq_hash, source, src_len): (FixedString[256], Hash256, Hash256, Array[u8, 65536], u64) = candidates[i];
        if slice_name.len == 0 {
            break;
        }

        match extract_and_seal_slice(store, &slice_name, foreign_hash, seq_hash, &source, src_len, compiler_flags, test_inputs[0], store_cap) {
            Ok(_) => {
                sealed_count = sealed_count + 1;
            }
            Err(e) => {
                // Log failure but continue with other candidates
            }
        }
    }

    @emit_residual("slice_extraction.batch_extract", "batch_extraction_complete", sealed_count);

    return Ok(sealed_count);
}

// ============================================================================
// Generate Slice Evidence Chain Document
// ============================================================================

type EvidenceChainDocument = struct {
    slice_id: Hash256,
    slice_name: FixedString[256],
    trust_state: TrustState,
    nodes: Array[EvidenceNode, 64],
    node_count: u64,
    chain_valid: bool,
    chain_hash: Hash256,
    generated_at: u64,
}

fn generate_evidence_document(slice: &NativeSlice) -> EvidenceChainDocument
    effects: [compute]
{
    let chain_valid: bool = verify_evidence_chain(slice);
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut chain_hash: Hash256 = zero_hash;

    for i in 0..slice.evidence_count {
        chain_hash = hash_slice_combine(chain_hash, slice.evidence_chain[i].evidence_hash);
    }

    return EvidenceChainDocument {
        slice_id: slice.slice_id,
        slice_name: slice.slice_name,
        trust_state: slice.trust_state,
        nodes: slice.evidence_chain,
        node_count: slice.evidence_count,
        chain_valid: chain_valid,
        chain_hash: chain_hash,
        generated_at: kernel.tick_count(),
    };
}
