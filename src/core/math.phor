// ──────────────────────────────────────────────
// Power and Root Operations
// ──────────────────────────────────────────────
// Evidence path: MATH-POW-001 through MATH-POW-020

// Checked integer square root (floor).
// loop: bounds[BOUND_TINY] — binary search on 64-bit range (64 iterations).
pub fn isqrt(value: Word64) -> Result[Word64, ArithmeticError>
    effects: [deterministic]
{
    if value.is_zero() {
        return Result::Ok(Word64::zero())
    }
    let mut low: u64 = 1
    let mut high: u64 = value.to_u64()
    let mut result: u64 = 0
    // loop: bounds[BOUND_SMALL] — binary search over 64-bit space (max 64 iterations)
    loop: bounds[BOUND_SMALL] while low <= high {
        let mid: u64 = low + (high - low) / 2
        let (sq, overflow): (u64, bool) = __builtin_mul_u64_overflow(mid, mid)
        if !overflow && sq <= value.to_u64() {
            low = mid + 1
            result = mid
        } else {
            if mid == 0 {
                break
            }
            high = mid - 1
        }
    }
    Result::Ok(Word64::from_u64(result))
}

// Integer cube root (floor).
// loop: bounds[BOUND_TINY] — bounded search.
pub fn icbrt(value: Word64) -> Result[Word64, ArithmeticError>
    effects: [deterministic]
{
    if value.is_zero() {
        return Result::Ok(Word64::zero())
    }
    let mut low: u64 = 1
    let mut high: u64 = value.to_u64()
    let mut result: u64 = 0
    // loop: bounds[BOUND_SMALL] — binary search
    loop: bounds[BOUND_SMALL] while low <= high {
        let mid: u64 = low + (high - low) / 2
        let (sq, ov1): (u64, bool) = __builtin_mul_u64_overflow(mid, mid)
        if ov1 {
            high = mid - 1
            continue
        }
        let (cube, ov2): (u64, bool) = __builtin_mul_u64_overflow(sq, mid)
        if !ov2 && cube <= value.to_u64() {
            low = mid + 1
            result = mid
        } else {
            if mid == 0 {
                break
            }
            high = mid - 1
        }
    }
    Result::Ok(Word64::from_u64(result))
}

// Checked 10^x for x in [0, 19] (max within u64).
pub fn checked_pow10(exp: u32) -> Result[Word64, OverflowError>
    effects: [deterministic]
{
    if exp > 19 {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x300),
            FixedString[128]::from_slice("10^exp exceeds u64 range")))
    }
    let powers: u64[20] = [
        1, 10, 100, 1000, 10000, 100000, 1000000, 10000000,
        100000000, 1000000000, 10000000000, 100000000000,
        1000000000000, 10000000000000, 100000000000000,
        1000000000000000, 10000000000000000, 100000000000000000,
        1000000000000000000, 10000000000000000000,
    ]
    Result::Ok(Word64::from_u64(powers[exp as usize]))
}

// ──────────────────────────────────────────────
// Comparison and Ordering
// ──────────────────────────────────────────────
// Evidence path: MATH-CMP-001 through MATH-CMP-015

// 3-way comparison returning Ordering.
pub fn compare_u64(a: u64, b: u64) -> Ordering
    effects: [deterministic]
{
    if a < b { Ordering::Less }
    else if a > b { Ordering::Greater }
    else { Ordering::Equal }
}

// 3-way comparison for u32.
pub fn compare_u32(a: u32, b: u32) -> Ordering
    effects: [deterministic]
{
    if a < b { Ordering::Less }
    else if a > b { Ordering::Greater }
    else { Ordering::Equal }
}

// Check if a value is within [lo, hi] inclusive.
pub fn in_range_u64(value: u64, lo: u64, hi: u64) -> bool
    effects: [deterministic]
{
    value >= lo && value <= hi
}

// Check if a value is within [lo, hi] inclusive for Word64.
pub fn in_range_word64(value: Word64, lo: Word64, hi: Word64) -> bool
    effects: [deterministic]
{
    value.gte(lo) && value.lte(hi)
}

// ──────────────────────────────────────────────
// Overflow-Safe Accumulation
// ──────────────────────────────────────────────
// Evidence path: MATH-ACCUM-001 through MATH-ACCUM-015

// Accumulate a sum over an array with overflow detection.
// loop: bounds[BOUND_MEDIUM] — bounded by array length.
pub fn checked_sum(values: Word64[], count: u32) -> Result[Word64, OverflowError>
    effects: [deterministic]
{
    let mut sum: Word64 = Word64::zero()
    let mut i: u32 = 0
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] while i < count {
        sum = sum.checked_add(values[i as usize])?
        i = i + 1
    }
    Result::Ok(sum)
}

// Accumulate a product over an array with overflow detection.
// loop: bounds[BOUND_MEDIUM] — bounded by array length.
pub fn checked_product(values: Word64[], count: u32) -> Result[Word64, OverflowError>
    effects: [deterministic]
{
    let mut product: Word64 = Word64::one()
    let mut i: u32 = 0
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] while i < count {
        product = product.checked_mul(values[i as usize])?
        i = i + 1
    }
    Result::Ok(product)
}

// Safe average of two Word64 values (no overflow in intermediate).
pub fn safe_average(a: Word64, b: Word64) -> Word64
    effects: [deterministic]
{
    let a_val: u64 = a.to_u64()
    let b_val: u64 = b.to_u64()
    // (a + b) / 2 without overflow: (a/2) + (b/2) + ((a%2)*(b%2))
    let half_sum: u64 = (a_val >> 1) + (b_val >> 1) + (a_val & b_val & 1)
    Word64::from_u64(half_sum)
}

// ──────────────────────────────────────────────
// Fixed-Point Math (simulated with Word64 scaling)
// ──────────────────────────────────────────────
// Evidence path: MATH-FP-001 through MATH-FP-020

// Scale factor for fixed-point: 10^12 (picometer precision at km scale).
const FP_SCALE: u64 = 1_000_000_000_000

// Create a fixed-point value from an integer.
pub fn fp_from_int(value: Word64) -> Word64
    effects: [deterministic]
{
    value.checked_mul(Word64::from_u64(FP_SCALE)).unwrap_or(value)
}

// Extract integer part from fixed-point.
pub fn fp_trunc(value: Word64) -> Word64
    effects: [deterministic]
{
    value.checked_div(Word64::from_u64(FP_SCALE)).unwrap_or(Word64::zero())
}

// Fixed-point addition.
pub fn fp_add(a: Word64, b: Word64) -> Result[Word64, OverflowError>
    effects: [deterministic]
{
    a.checked_add(b)
}

// Fixed-point subtraction.
pub fn fp_sub(a: Word64, b: Word64) -> Result[Word64, OverflowError>
    effects: [deterministic]
{
    a.checked_sub(b)
}

// Fixed-point multiplication (a * b / scale).
pub fn fp_mul(a: Word64, b: Word64) -> Result[Word64, OverflowError>
    effects: [deterministic]
{
    let prod: Word64 = a.checked_mul(b)?
    prod.checked_div(Word64::from_u64(FP_SCALE))
}

// Fixed-point division (a * scale / b).
pub fn fp_div(a: Word64, b: Word64) -> Result[Word64, DivisionByZeroError>
    effects: [deterministic]
{
    let scaled: Word64 = a.checked_mul(Word64::from_u64(FP_SCALE))
        .unwrap_or(Word64::max())
    scaled.checked_div(b)
}

// ──────────────────────────────────────────────
// Byte-level Math Operations
// ──────────────────────────────────────────────
// Evidence path: MATH-BYTE-001 through MATH-BYTE-015

// Add bytes with carry, returning (sum, carry).
pub fn byte_add_with_carry(a: Byte, b: Byte, carry_in: Byte) -> (Byte, Byte)
    effects: [deterministic]
{
    let a_val: u16 = a.to_u8() as u16
    let b_val: u16 = b.to_u8() as u16
    let c_val: u16 = carry_in.to_u8() as u16
    let sum: u16 = a_val + b_val + c_val
    let result_byte: u8 = (sum & 0xFF) as u8
    let carry_out: u8 = (sum >> 8) as u8
    (Byte::from_u8(result_byte), Byte::from_u8(carry_out))
}

// Big-endian addition of two byte arrays (fixed length).
// loop: bounds[BOUND_LARGE] — bounded by array length.
pub fn bigint_add(result: ref mut Byte[], a: Byte[], b: Byte[], len: u32)
    effects: [deterministic]
{
    let mut carry: Byte = Byte::from_u8(0)
    let mut i: u32 = len
    // loop: bounds[BOUND_LARGE] — bounded by len
    loop: bounds[BOUND_LARGE] while i > 0 {
        i = i - 1
        let (sum, new_carry): (Byte, Byte) = byte_add_with_carry(a[i as usize], b[i as usize], carry)
        result[i as usize] = sum
            carry = new_carry
        }
    }

    // ──────────────────────────────────────────────
    // Bounded Random Number Generation
    // ──────────────────────────────────────────────
    // Deterministic pseudo-random using a simple LCG.
    // NOT cryptographically secure — use only for tests/hashing.
    // Evidence path: MATH-RNG-001 through MATH-RNG-020

    pub fn xorshift64(state: ref mut Word64) -> Word64
        effects: [deterministic]
    {
        let mut x: u64 = state.to_u64()
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        state = Word64::from_u64(x)
        Word64::from_u64(x)
    }

    pub fn xorshift32(state: ref mut Word32) -> Word32
        effects: [deterministic]
    {
        let mut x: u32 = state
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
        state = x
        x
    }

    // Generate a random u32 in [0, bound).
    pub fn random_range(rng_state: ref mut Word64, bound: u32) -> u32
        effects: [deterministic]
    {
        let rand: Word64 = xorshift64(rng_state)
        let rand_u32: u32 = (rand.to_u64() % bound as u64) as u32
        rand_u32
    }

    // Fisher-Yates shuffle on a slice (deterministic, bounded).
    // loop: bounds[BOUND_SORT] — bounded by array length.
    pub fn fisher_yates_shuffle[T](
        array: ref mut FixedArray[KnownN, T],
        rng: ref mut Word64,
    )
        effects: [deterministic]
    {
        let len: u32 = array.len()
        if len <= 1 {
            return
        }
        let mut i: u32 = len - 1
        // loop: bounds[BOUND_SORT] — bounded by length
        loop: bounds[BOUND_SORT] while i > 0 {
            let j: u32 = random_range(rng, i + 1)
            array.swap(i, j).unwrap_or(())
            i = i - 1
        }
    }

    // ──────────────────────────────────────────────
    // Integer Factoring and Number Theory
    // ──────────────────────────────────────────────
    // Evidence path: MATH-NUM-001 through MATH-NUM-025

    // Trial division to check if a number is prime.
    // loop: bounds[BOUND_LARGE] — bounded by sqrt(n).
    pub fn is_prime(n: Word64) -> bool
        effects: [deterministic]
    {
        let val: u64 = n.to_u64()
        if val < 2 { return false }
        if val == 2 { return true }
        if val % 2 == 0 { return false }
        let mut i: u64 = 3
        // loop: bounds[BOUND_LARGE] — bounded by sqrt
        loop: bounds[BOUND_LARGE] while i * i <= val && i <= 65536 {
            if val % i == 0 {
                return false
            }
            i = i + 2
        }
        true
    }

    // Get the next prime after n.
    // loop: bounds[BOUND_MEDIUM] — bounded by search space.
    pub fn next_prime(n: Word64) -> Word64
        effects: [deterministic]
    {
        let mut candidate: Word64 = n
        // loop: bounds[BOUND_MEDIUM] — bounded search
        loop: bounds[BOUND_MEDIUM] for _ in 0..1000 {
            candidate = candidate.checked_add(Word64::one()).unwrap_or(candidate)
            if is_prime(candidate) {
                return candidate
            }
        }
        n  // Fallback
    }

    // Count the number of set bits (hamming weight).
    pub fn popcount_word64(value: Word64) -> u32
        effects: [deterministic]
    {
        value.count_ones()
    }

    // Compute the parity of a Word64 (1 if odd number of bits set).
    pub fn parity_word64(value: Word64) -> u32
        effects: [deterministic]
    {
        let ones: u32 = value.count_ones()
        ones & 1
    }

    // Compute modular exponentiation (base^exp % modulus).
    // loop: bounds[BOUND_SMALL] — bounded by exponent bits (64).
    pub fn mod_pow(base: Word64, exp: Word64, modulus: Word64) -> Result[Word64, DivisionByZeroError>
        effects: [deterministic]
    {
        if modulus.is_zero() {
            return Result::Err(DivisionByZeroError::new(
                Word64::from_u64(DIAG_MATH_BASE | 0x400),
                FixedString[128]::from_slice("Modular exponentiation by zero")))
        }
        let m: u64 = modulus.to_u64()
        let mut result: u64 = 1
        let mut b: u64 = base.to_u64() % m
        let mut e: u64 = exp.to_u64()
        // loop: bounds[BOUND_SMALL] — at most 64 iterations (bits in exponent)
        loop: bounds[BOUND_SMALL] while e > 0 {
            if (e & 1) == 1 {
                result = (result * b) % m
            }
            e = e >> 1
            b = (b * b) % m
        }
        Result::Ok(Word64::from_u64(result))
    }

    // ──────────────────────────────────────────────
    // Interval Arithmetic
    // ──────────────────────────────────────────────
    // Evidence path: MATH-INT-001 through MATH-INT-020

    pub type Interval : struct {
        lo: Word64,
        hi: Word64,
    }

    impl Interval {
        pub fn new(lo: Word64, hi: Word64) -> Result[Interval, ArithmeticError>
            effects: [deterministic]
        {
            if lo.gt(hi) {
                return Result::Err(ArithmeticError::new(
                    Word64::from_u64(DIAG_MATH_BASE | 0x500),
                    FixedString[128]::from_slice("Interval lo > hi")))
            }
            Result::Ok(Interval { lo: lo, hi: hi })
        }

        pub fn contains(self, value: Word64) -> bool
            effects: [deterministic]
        {
            value.gte(self.lo) && value.lte(self.hi)
        }

        pub fn lo(self) -> Word64 { self.lo }
        pub fn hi(self) -> Word64 { self.hi }

        pub fn width(self) -> Result[Word64, OverflowError>
            effects: [deterministic]
        {
            self.hi.checked_sub(self.lo)
        }

        pub fn midpoint(self) -> Word64
            effects: [deterministic]
        {
            safe_average(self.lo, self.hi)
        }

        pub fn intersect(self, other: Interval) -> Option[Interval]
            effects: [deterministic]
        {
            let new_lo: Word64 = self.lo.max(other.lo)
            let new_hi: Word64 = self.hi.min(other.hi)
            if new_lo.gt(new_hi) {
                Option::None
            } else {
                Option::Some(Interval { lo: new_lo, hi: new_hi })
            }
        }

        pub fn union(self, other: Interval) -> Interval
            effects: [deterministic]
        {
            Interval {
                lo: self.lo.min(other.lo),
                hi: self.hi.max(other.hi),
            }
        }
    }

    // ──────────────────────────────────────────────
    // Safe Integer Conversions with Rounding
    // ──────────────────────────────────────────────
    // Evidence path: MATH-CONV2-001 through MATH-CONV2-015

    // Round a u64 down to the nearest multiple of alignment.
    pub fn round_down(value: u64, alignment: u64) -> u64
        effects: [deterministic]
    {
        if alignment == 0 { return value }
        value - (value % alignment)
    }

    // Round a u64 up to the nearest multiple of alignment.
    pub fn round_up(value: u64, alignment: u64) -> u64
        effects: [deterministic]
    {
        if alignment == 0 { return value }
        let rem: u64 = value % alignment
        if rem == 0 { value } else { value + (alignment - rem) }
    }

    // Checked narrowing: u128 to u64.
    pub fn u128_to_u64(high: u64, low: u64) -> Result[u64, OverflowError>
        effects: [deterministic]
    {
        if high != 0 {
            return Result::Err(OverflowError::new(
                Word64::from_u64(DIAG_MATH_BASE | 0x600),
                FixedString[128]::from_slice("u128 to u64 overflow")))
        }
        Result::Ok(low)
    }

    // Safe absolute difference.
    pub fn abs_diff(a: Word64, b: Word64) -> Word64
        effects: [deterministic]
    {
        if a.gt(b) {
            a.checked_sub(b).unwrap_or(Word64::zero())
        } else {
            b.checked_sub(a).unwrap_or(Word64::zero())
        }
    }

    // ──────────────────────────────────────────────
    // Saturated Math Extensions
    // ──────────────────────────────────────────────
    // Evidence path: MATH-SATEXT-001 through MATH-SATEXT-015

    // Saturating addition of two u64 values with Result return.
    pub fn saturating_add_result(a: Word64, b: Word64) -> Word64
        effects: [deterministic]
    {
        let (sum, overflow): (u64, bool) = __builtin_add_u64_overflow(a.to_u64(), b.to_u64())
        if overflow {
            Word64::max()
        } else {
            Word64::from_u64(sum)
        }
    }

    // Saturating multiplication returning Word64.
    pub fn saturating_mul_result(a: Word64, b: Word64) -> Word64
        effects: [deterministic]
    {
        let (prod, overflow): (u64, bool) = __builtin_mul_u64_overflow(a.to_u64(), b.to_u64())
        if overflow {
            Word64::max()
        } else {
            Word64::from_u64(prod)
        }
    }

    // Clamp to maximum value without panicking.
    pub fn clamped_add(a: Word64, b: Word64, max_val: Word64) -> Word64
        effects: [deterministic]
    {
        let result: Word64 = saturating_add_result(a, b)
        result.min(max_val)
    }

    // ──────────────────────────────────────────────
    // Overflow Detection Helpers
    // ──────────────────────────────────────────────
    // Evidence path: MATH-OVDET-001 through MATH-OVDET-015

    // Check if a + b would overflow u64.
    pub fn would_overflow_add_u64(a: u64, b: u64) -> bool
        effects: [deterministic]
    {
        let (_sum, overflow): (u64, bool) = __builtin_add_u64_overflow(a, b)
        overflow
    }

    // Check if a * b would overflow u64.
    pub fn would_overflow_mul_u64(a: u64, b: u64) -> bool
        effects: [deterministic]
    {
        let (_prod, overflow): (u64, bool) = __builtin_mul_u64_overflow(a, b)
        overflow
    }

    // Check if a - b would underflow u64.
    pub fn would_underflow_sub_u64(a: u64, b: u64) -> bool
        effects: [deterministic]
    {
        b > a
    }

    // Check if a value can fit in a smaller type.
    pub fn fits_in_u32(value: Word64) -> bool
        effects: [deterministic]
    {
        let max_u32: u64 = 0xFFFF_FFFF
        value.to_u64() <= max_u32
    }

    // ──────────────────────────────────────────────
    // Log-scale computations
    // ──────────────────────────────────────────────
    // Evidence path: MATH-LOG-001 through MATH-LOG-015

    // Compute floor(log2(x)) for x > 0.
    pub fn floor_log2(x: Word64) -> Result[u32, ArithmeticError>
        effects: [deterministic]
    {
        if x.is_zero() {
            return Result::Err(ArithmeticError::new(
                Word64::from_u64(DIAG_MATH_BASE | 0x700),
                FixedString[128]::from_slice("log2 of zero")))
        }
        let leading: u32 = x.leading_zeros()
        Result::Ok(63 - leading)
    }

    // Compute ceil(log2(x)) for x > 0.
    pub fn ceil_log2(x: Word64) -> Result[u32, ArithmeticError>
        effects: [deterministic]
    {
        let floor: u32 = floor_log2(x)?
        let power: Word64 = Word64::from_u64(1 << floor as u64)
        if power.eq(x) {
            Result::Ok(floor)
        } else {
            Result::Ok(floor + 1)
        }
    }

    // Compute floor(log10(x)) for x > 0.
    pub fn floor_log10(x: Word64) -> Result<u32, ArithmeticError>
        effects: [deterministic]
    {
        if x.is_zero() {
            return Result::Err(ArithmeticError::new(
                Word64::from_u64(DIAG_MATH_BASE | 0x701),
                FixedString[128]::from_slice("log10 of zero")))
        }
        let mut val: u64 = x.to_u64()
        let mut digits: u32 = 0
        // loop: bounds[BOUND_TINY] — at most 20 iterations (max u64 = 10^19)
        loop: bounds[BOUND_TINY] while val >= 10 {
            val = val / 10
            digits = digits + 1
        }
        Result::Ok(digits)
    }

    // ──────────────────────────────────────────────
    // Bounded Summation with Precision Tracking
    // ──────────────────────────────────────────────
    // Evidence path: MATH-SUM-001 through MATH-SUM-020

    // Kahan-Babuška-Neumaier compensated summation for higher precision.
    // loop: bounds[BOUND_MEDIUM] — bounded by array length.
    pub fn compensated_sum(values: Word64[], count: u32) -> Word64
        effects: [deterministic]
    {
        let mut sum: u64 = 0
        let mut compensation: u64 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by count
        loop: bounds[BOUND_MEDIUM] for i in 0..count {
            let val: u64 = values[i as usize].to_u64()
            let y: u64 = val - compensation
            let (t, overflow): (u64, bool) = __builtin_add_u64_overflow(sum, y)
            if overflow {
                // On overflow, saturate.
                sum = 0xFFFF_FFFF_FFFF_FFFF
                break
            }
            compensation = (t - sum) - y
            sum = t
        }
        Word64::from_u64(sum)
    }

    // Parallel prefix sum (inclusive scan).
    // loop: bounds[BOUND_MEDIUM] — bounded by array length.
    pub fn prefix_sum(values: Word64[], count: u32) -> Result[Word64[], OverflowError>
        effects: [deterministic]
    {
        let mut result: Word64[KnownN] = [Word64::zero(); KnownN]
        let mut running: Word64 = Word64::zero()
        // loop: bounds[BOUND_MEDIUM] — bounded by count
        loop: bounds[BOUND_MEDIUM] for i in 0..count {
            running = running.checked_add(values[i as usize])?
            result[i as usize] = running
        }
        Result::Ok(result)
    }

