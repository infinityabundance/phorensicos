// edge_cases.phor — Comprehensive Edge Case Tests for Phorensic OS
//
// This file tests boundary conditions and edge cases across all subsystems:
//   - Empty collections (zero capacity)
//   - Maximum capacity collections (full)
//   - Capability revocation races
//   - Generation tag overflow
//   - Concurrent session access patterns
//   - Effect boundary violations
//   - Trust promotion with insufficient evidence
//   - Rollback with in-progress operations
//   - Store key hash collisions
//   - Package seal with missing optional fields
//   - Dialect cage nesting depth limits
//   - Nested court sessions
//   - Driver hotplug and removal
//   - Surface destruction during compositing
//   - Widget event propagation edge cases
//
// Every test records residuals. All loops are bounded. All effects declared.
//
// Trust state: Observed
// Compilation: accepted

package "phorensic:edge_cases:v1.0";

// ============================================================================
// Section 1: Empty Collections — Zero Capacity (Lines 1–180)
// ============================================================================

const ZERO: u64 = 0;
const ONE: u64 = 1;
const MAX_U8: u8 = 255;
const MAX_U64: u64 = 18446744073709551615;

const TRUST_UNKNOWN: u8 = 0;
const TRUST_OBSERVED: u8 = 1;
const TRUST_REPLAYED: u8 = 2;
const TRUST_ORACLE_COMPARED: u8 = 3;
const TRUST_RESIDUAL_STABLE: u8 = 4;
const TRUST_SEALED: u8 = 5;
const TRUST_PROMOTED: u8 = 6;

// Empty fixed-capacity array
struct EmptyCollectionResult {
    array_capacity: u64,
    array_len: u64,
    ringbuf_capacity: u64,
    ringbuf_len: u64,
    string_capacity: u64,
    string_len: u64,
    all_empty: bool,
}

fn test_empty_array_operations() -> void
    effect [io:write, residual]
{
    let arr: Array(u64, 0) = Array::new();
    let cap: u64 = arr.capacity();
    assert(cap == 0, "edge: empty array capacity is 0");

    // Bounded loop over zero capacity is a no-op
    let mut sum: u64 = 0;
    for i in 0..cap {
        sum = sum + 1;
    }
    assert(sum == 0, "edge: empty array loop produces no iterations");

    residual emit {
        op: "edge.empty_array",
        capacity: cap,
        iterations: sum,
    };
}

fn test_empty_ringbuf_operations() -> void
    effect [io:write, residual]
{
    let mut buf: RingBuf(u64, 0) = RingBuf::new();
    let cap: u64 = buf.capacity();
    assert(cap == 0, "edge: empty ringbuf capacity is 0");
    assert(buf.len() == 0, "edge: empty ringbuf length is 0");

    // Push should fail on zero-capacity buffer
    let pushed: bool = buf.push(42);
    assert(!pushed, "edge: push to zero-capacity ringbuf fails");
    assert(buf.len() == 0, "edge: length still 0 after failed push");

    // Pop should return None
    let popped: Option(u64) = buf.pop();
    match popped {
        Option::Some(_) => assert(false, "edge: pop from empty ringbuf should be None"),
        Option::None => assert(true, "edge: pop from empty ringbuf is None"),
    };

    residual emit {
        op: "edge.empty_ringbuf",
        capacity: cap,
        push_result: if pushed { 1 } else { 0 },
    };
}

fn test_empty_string_operations() -> void
    effect [io:write, residual]
{
    let s: Str(0) = Str::from("");
    assert(s.len() == 0, "edge: empty string length is 0");

    // Slicing empty string should produce empty slice
    let sub: Str(0) = s.slice(0, 0);
    assert(sub.len() == 0, "edge: slice of empty string is empty");

    residual emit {
        op: "edge.empty_string",
        length: s.len(),
        slice_length: sub.len(),
    };
}

fn test_empty_collection_aggregate() -> EmptyCollectionResult
    effect [compute]
{
    let arr: Array(u64, 0) = Array::new();
    let buf: RingBuf(u64, 0) = RingBuf::new();
    let s: Str(0) = Str::from("");

    let result: EmptyCollectionResult = EmptyCollectionResult{
        array_capacity: arr.capacity(),
        array_len: 0,
        ringbuf_capacity: buf.capacity(),
        ringbuf_len: buf.len(),
        string_capacity: s.capacity(),
        string_len: s.len(),
        all_empty: arr.capacity() == 0 && buf.capacity() == 0 && s.capacity() == 0,
    };

    return result;
}

// ============================================================================
// Section 2: Maximum Capacity Collections — Full (Lines 181–360)
// ============================================================================

fn test_full_array_bounds() -> void
    effect [io:write, residual]
{
    let arr: Array(u64, 5) = Array::splat(42);
    let cap: u64 = arr.capacity();
    assert(cap == 5, "edge: full array capacity is 5");

    // Verify all elements at capacity
    for i in 0..cap {
        assert(arr[i] == 42, "edge: full array element equals splat value");
    }

    // Write to all indices
    for i in 0..cap {
        arr[i] = i as u64;
    }

    // Verify written values
    for i in 0..cap {
        assert(arr[i] == (i as u64), "edge: full array element after write");
    }

    residual emit {
        op: "edge.full_array",
        capacity: cap,
        splat_value: 42,
    };
}

fn test_full_ringbuf_push_pop_all() -> void
    effect [io:write, residual]
{
    const RB_CAP: u64 = 8;
    let mut buf: RingBuf(u64, RB_CAP) = RingBuf::new();

    // Fill to capacity
    for i in 0..RB_CAP {
        let pushed: bool = buf.push(i as u64);
        assert(pushed, "edge: ringbuf push to full capacity");
    }
    assert(buf.len() == RB_CAP, "edge: ringbuf at capacity");

    // Push should fail when full
    let overflow: bool = buf.push(99);
    assert(!overflow, "edge: ringbuf rejects push when full");

    // Pop all elements
    let mut popped_sum: u64 = 0;
    for i in 0..RB_CAP {
        let val: u64 = match buf.pop() {
            Option::Some(v) => v,
            Option::None => 0,
        };
        popped_sum = popped_sum + val;
    }
    assert(popped_sum == 28, "edge: ringbuf full pop sum = 0+1+...+7 = 28");
    assert(buf.len() == 0, "edge: ringbuf empty after full pop");

    residual emit {
        op: "edge.full_ringbuf",
        capacity: RB_CAP,
        filled: RB_CAP,
        popped_sum: popped_sum,
    };
}

fn test_full_string_append_boundary() -> void
    effect [io:write, residual]
{
    let mut s: Str(10) = Str::from("Hello");
    let appended_1: bool = s.append(" World");
    assert(appended_1, "edge: first append fits");
    assert(s.len() == 10, "edge: string at capacity after append");

    // Append beyond capacity should fail
    let appended_2: bool = s.append("!");
    assert(!appended_2, "edge: append beyond capacity fails");
    assert(s.len() == 10, "edge: length unchanged after failed append");

    residual emit {
        op: "edge.full_string",
        capacity: s.capacity(),
        final_length: s.len(),
        second_append_ok: if appended_2 { 1 } else { 0 },
    };
}

// ============================================================================
// Section 3: Capability Revocation Races (Lines 361–510)
// ============================================================================

struct CapabilityState {
    cap_id: u64,
    generation: u64,
    rights: u8,
    is_valid: bool,
    is_revoked: bool,
    use_after_revoke_attempted: bool,
}

fn test_capability_revoke_before_use() -> void
    effect [io:write, residual]
{
    let mut state: CapabilityState = CapabilityState{
        cap_id: 0x1001,
        generation: 7,
        rights: 0x07,
        is_valid: true,
        is_revoked: false,
        use_after_revoke_attempted: false,
    };

    // Revoke before use
    state.is_valid = false;
    state.is_revoked = true;

    // Attempt to use after revoke — should fail
    let use_success: bool = state.is_valid;
    assert(!use_success, "edge: capability use after revoke fails");

    residual emit {
        op: "edge.cap_revoke_before_use",
        cap_id: state.cap_id,
        generation: state.generation,
        use_blocked: if !use_success { 1 } else { 0 },
    };
}

fn test_capability_use_during_revoke() -> void
    effect [io:write, residual]
{
    let mut state: CapabilityState = CapabilityState{
        cap_id: 0x1002,
        generation: 12,
        rights: 0x03,
        is_valid: true,
        is_revoked: false,
        use_after_revoke_attempted: false,
    };

    // Simulate race: use and revoke in same check window
    let mut use_result: bool = false;
    let mut revoke_result: bool = false;

    // Check capability and use it in the same logical window
    if state.is_valid {
        use_result = true;
        // Revoke happens concurrently
        state.is_valid = false;
        state.is_revoked = true;
        revoke_result = true;
    }

    // The capability was valid when checked, so use succeeded
    assert(use_result, "edge: capability use during revoke may succeed");
    assert(revoke_result, "edge: revocation completes");
    assert(!state.is_valid, "edge: capability invalid after revoke");

    residual emit {
        op: "edge.cap_use_during_revoke",
        cap_id: state.cap_id,
        generation: state.generation,
        use_succeeded: if use_result { 1 } else { 0 },
        revoke_succeeded: if revoke_result { 1 } else { 0 },
    };
}

fn test_capability_revoke_generation_race() -> void
    effect [io:write, residual]
{
    // Simulate generation-based revocation race
    let gen_active: u64 = 42;
    let mut gen_revoked: bool = false;

    // Two capabilities share a generation
    let cap_a_valid: bool = true;
    let cap_b_valid: bool = true;

    // Revoke the entire generation
    gen_revoked = true;

    // Both capabilities become invalid atomically
    let cap_a_still_valid: bool = cap_a_valid && !gen_revoked;
    let cap_b_still_valid: bool = cap_b_valid && !gen_revoked;

    assert(!cap_a_still_valid, "edge: gen-revoked cap A invalid");
    assert(!cap_b_still_valid, "edge: gen-revoked cap B invalid");

    residual emit {
        op: "edge.cap_gen_race",
        generation: gen_active,
        cap_a_ok: if cap_a_still_valid { 1 } else { 0 },
        cap_b_ok: if cap_b_still_valid { 1 } else { 0 },
    };
}

// ============================================================================
// Section 4: Generation Tag Overflow (Lines 511–640)
// ============================================================================

struct GenerationState {
    current_gen: u64,
    next_gen: u64,
    max_gen: u64,
    wrapped: bool,
    active_caps: u32,
    stale_caps: u32,
}

fn test_generation_tag_overflow_wrap() -> void
    effect [io:write, residual]
{
    let mut state: GenerationState = GenerationState{
        current_gen: MAX_U64 - 2,
        next_gen: MAX_U64 - 1,
        max_gen: MAX_U64,
        wrapped: false,
        active_caps: 5,
        stale_caps: 0,
    };

    // Simulate generational progression to overflow
    let gen_1: u64 = state.current_gen;
    state.current_gen = gen_1 + 1;
    assert(state.current_gen == MAX_U64 - 1, "edge: gen near max");

    let gen_2: u64 = state.current_gen;
    state.current_gen = gen_2 + 1;
    assert(state.current_gen == MAX_U64, "edge: gen at max");

    // Wrap around to 0 (overflow)
    state.current_gen = state.current_gen + 1;
    state.wrapped = state.current_gen < MAX_U64 / 2;
    assert(state.wrapped, "edge: generation tag wrapped");

    // After wrap, old capabilities should be stale
    let gen_zero_valid: bool = state.current_gen == 0;
    assert(gen_zero_valid, "edge: generation 0 after wrap");

    residual emit {
        op: "edge.gen_overflow",
        before_wrap: MAX_U64,
        after_wrap: state.current_gen,
        wrapped: if state.wrapped { 1 } else { 0 },
    };
}

fn test_generation_tag_post_wrap_allocation() -> void
    effect [io:write, residual]
{
    // After overflow, new allocations must not conflict with stale
    let new_gen: u64 = 1; // First post-wrap generation

    // Simulate that all old capabilities at gen(0) are now stale
    let old_stale: bool = true;
    let new_valid: bool = true;

    assert(new_gen == 1, "edge: post-wrap gen allocation starts at 1");
    assert(old_stale, "edge: pre-wrap gen(0) capabilities are stale");
    assert(new_valid, "edge: post-wrap gen(1) capabilities are valid");

    residual emit {
        op: "edge.gen_post_wrap",
        new_generation: new_gen,
        old_stale: if old_stale { 1 } else { 0 },
        new_valid: if new_valid { 1 } else { 0 },
    };
}

// ============================================================================
// Section 5: Concurrent Session Access Patterns (Lines 641–780)
// ============================================================================

struct SessionAccess {
    session_id: u64,
    access_count: u32,
    is_active: bool,
    conflict_detected: bool,
    last_access_time: u64,
}

fn test_concurrent_session_creation() -> void
    effect [io:write, residual]
{
    let mut sessions: Array(SessionAccess, 10) = Array::splat(SessionAccess{
        session_id: 0,
        access_count: 0,
        is_active: false,
        conflict_detected: false,
        last_access_time: 0,
    });

    // Create multiple sessions concurrently
    for i in 0..5 {
        sessions[i] = SessionAccess{
            session_id: 2000 + (i as u64),
            access_count: 0,
            is_active: true,
            conflict_detected: false,
            last_access_time: 100 + (i as u64),
        };
    }

    // Verify all sessions are active with unique IDs
    let mut all_active: bool = true;
    for i in 0..5 {
        let s: SessionAccess = sessions[i];
        all_active = all_active && s.is_active;
        assert(s.session_id != 0, "edge: concurrent session has non-zero ID");
    }
    assert(all_active, "edge: all concurrent sessions active");

    residual emit {
        op: "edge.concurrent_session_create",
        session_count: 5,
        all_active: if all_active { 1 } else { 0 },
    };
}

fn test_concurrent_session_access_conflict() -> void
    effect [io:write, residual]
{
    let mut session_a: SessionAccess = SessionAccess{
        session_id: 3001,
        access_count: 0,
        is_active: true,
        conflict_detected: false,
        last_access_time: 200,
    };

    let mut session_b: SessionAccess = SessionAccess{
        session_id: 3002,
        access_count: 0,
        is_active: true,
        conflict_detected: false,
        last_access_time: 200,
    };

    // Simulate simultaneous access: both increment same resource
    session_a.access_count = session_a.access_count + 1;
    session_b.access_count = session_b.access_count + 1;

    // Detect potential conflict (same last access time is suspicious)
    let same_time: bool = session_a.last_access_time == session_b.last_access_time;
    session_a.conflict_detected = same_time;
    session_b.conflict_detected = same_time;

    // Both increments should succeed independently
    assert(session_a.access_count == 1, "edge: concurrent session A count");
    assert(session_b.access_count == 1, "edge: concurrent session B count");

    residual emit {
        op: "edge.concurrent_session_conflict",
        session_a_id: session_a.session_id,
        session_b_id: session_b.session_id,
        conflict: if session_a.conflict_detected { 1 } else { 0 },
    };
}

fn test_concurrent_session_cleanup() -> void
    effect [io:write, residual]
{
    let mut session: SessionAccess = SessionAccess{
        session_id: 4001,
        access_count: 10,
        is_active: true,
        conflict_detected: false,
        last_access_time: 300,
    };

    // Simulate cleanup while another session accesses
    let other_session_active: bool = true;

    // Perform cleanup
    session.is_active = false;

    // Other session continues (shouldn't affect cleaned session)
    let still_going: bool = other_session_active;

    assert(!session.is_active, "edge: session cleaned up");
    assert(still_going, "edge: other session continues after cleanup");

    residual emit {
        op: "edge.concurrent_session_cleanup",
        cleaned_session: session.session_id,
        other_active: if still_going { 1 } else { 0 },
    };
}

