// command_shell.phor — Phorensic command shell with full pipeline execution
//
// Demonstrates:
//   - Command parsing and tokenization
//   - Built-in commands (ls, cat, echo, ps, cap, court, pkg, help)
//   - Pipeline execution with bounded segment chains
//   - Path resolution through store hierarchy
//   - Tab completion with candidate generation
//   - Command history with ring buffer navigation
//   - Environment variable management
//   - Script execution with line-by-line parsing
//   - Residual emission for each command
//   - Fixed-capacity collections throughout
//   - Affine capability passing for store access
//
// Expected behavior:
//   - Parses commands into tokens and pipelines
//   - Executes all 8 built-in commands with correct output
//   - Supports piped command chains (cmd1 | cmd2 | cmd3)
//   - Resolves store paths (absolute and relative)
//   - Generates tab completion candidates from store index
//   - Maintains command history ring buffer (last 32 commands)
//   - Loads/saves environment variables
//   - Runs scripts from store paths
//   - All operations bounded, effect-declared, residual-recorded
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:command_shell:v1.0";

const MAX_INPUT_LENGTH: u64 = 512;
const MAX_TOKENS: u64 = 32;
const MAX_PIPELINE_SEGMENTS: u64 = 8;
const MAX_HISTORY: u64 = 32;
const MAX_ENV_VARS: u64 = 64;
const MAX_ENV_KEY_LENGTH: u64 = 64;
const MAX_ENV_VAL_LENGTH: u64 = 256;
const MAX_PATH_DEPTH: u64 = 16;
const MAX_PATH_COMPONENTS: u64 = 16;
const MAX_COMPLETIONS: u64 = 16;
const MAX_LINE_LENGTH: u64 = 256;
const MAX_HELP_TEXT: u64 = 1024;
const MAX_SCRIPT_LINES: u64 = 256;
const MAX_PS_ENTRIES: u64 = 64;
const TAB_COMPLETION_MAX: u64 = 16;
const MAX_CAT_BYTES: u64 = 4096;
const MAX_PIPE_DATA: u64 = 4096;

enum CommandType : u8 {
    Ls = 0,
    Cat = 1,
    Echo = 2,
    Ps = 3,
    Cap = 4,
    Court = 5,
    Pkg = 6,
    Help = 7,
    External = 8,
}

struct Token {
    text: Str(64),
    arg_type: u8,
}

struct ParsedCommand {
    command_type: CommandType,
    command_name: Str(32),
    tokens: Array(Token, 32),
    token_count: u64,
    pipe_to_next: bool,
}

struct Pipeline {
    segments: Array(ParsedCommand, 8),
    segment_count: u64,
    pipe_buffers: Array(RingBuf(u8, 4096), 7),
}

struct HistoryEntry {
    command_line: Str(256),
    timestamp: u64,
}

struct CommandHistory {
    entries: RingBuf(HistoryEntry, 32),
    cursor: u64,
}

struct EnvEntry {
    key: Str(64),
    value: Str(256),
}

struct Environment {
    vars: Array(EnvEntry, 64),
    count: u64,
}

struct CompletionCandidate {
    text: Str(64),
    kind: u8,
}

struct ShellState {
    history: CommandHistory,
    environment: Environment,
    current_dir: Str(128),
    prompt: Str(32),
    running: bool,
    cmd_count: u64,
    store_handle: u64,
}

fn classify_command(name: Str(32)) -> CommandType
    effect [compute]
{
    if name == Str::from("ls")    { return CommandType::Ls; }
    if name == Str::from("cat")   { return CommandType::Cat; }
    if name == Str::from("echo")  { return CommandType::Echo; }
    if name == Str::from("ps")    { return CommandType::Ps; }
    if name == Str::from("cap")   { return CommandType::Cap; }
    if name == Str::from("court") { return CommandType::Court; }
    if name == Str::from("pkg")   { return CommandType::Pkg; }
    if name == Str::from("help")  { return CommandType::Help; }
    return CommandType::External;
}

fn tokenize_input(input: Str(256)) -> ParsedCommand
    effect [compute]
{
    let result: ParsedCommand = ParsedCommand{
        command_type: CommandType::External,
        command_name: Str::from(""),
        tokens: Array::splat(Token{ text: Str::from(""), arg_type: 0 }),
        token_count: 0,
        pipe_to_next: false,
    };

    let trimmed: Str(256) = input;
    let space_pos: u64 = 0;
    let mut idx: u64 = 0;
    let mut in_token: bool = false;
    let mut token_start: u64 = 0;
    let mut token_count: u64 = 0;
    let mut first_token: bool = true;

    while idx < trimmed.len() && idx < 256 proven {
        let ch: u8 = trimmed[idx];
        if ch == 32 || ch == 9 {
            if in_token {
                let tlen: u64 = idx - token_start;
                let tok: Str(64) = trimmed.slice(token_start, token_start + tlen);
                if first_token {
                    result.command_type = classify_command(tok);
                    result.command_name = tok;
                    first_token = false;
                } else if token_count < 32 {
                    result.tokens[token_count] = Token{ text: tok, arg_type: 0 };
                    token_count = token_count + 1;
                }
                in_token = false;
            }
        } else if ch == 124 {
            if in_token {
                let tlen: u64 = idx - token_start;
                let tok: Str(64) = trimmed.slice(token_start, token_start + tlen);
                if first_token {
                    result.command_type = classify_command(tok);
                    result.command_name = tok;
                    first_token = false;
                } else if token_count < 32 {
                    result.tokens[token_count] = Token{ text: tok, arg_type: 0 };
                    token_count = token_count + 1;
                }
                in_token = false;
            }
            result.pipe_to_next = true;
        } else {
            if !in_token {
                token_start = idx;
                in_token = true;
            }
        }
        idx = idx + 1;
    }

    if in_token {
        let tlen: u64 = idx - token_start;
        let tok: Str(64) = trimmed.slice(token_start, token_start + tlen);
        if first_token {
            result.command_type = classify_command(tok);
            result.command_name = tok;
        } else if token_count < 32 {
            result.tokens[token_count] = Token{ text: tok, arg_type: 0 };
            token_count = token_count + 1;
        }
    }

    result.token_count = token_count;
    return result;
}

fn parse_pipeline(input: Str(256)) -> Pipeline
    effect [compute]
{
    let pl: Pipeline = Pipeline{
        segments: Array::splat(ParsedCommand{
            command_type: CommandType::External,
            command_name: Str::from(""),
            tokens: Array::splat(Token{ text: Str::from(""), arg_type: 0 }),
            token_count: 0,
            pipe_to_next: false,
        }),
        segment_count: 0,
        pipe_buffers: Array::splat(RingBuf::new()),
    };

    let mut seg_start: u64 = 0;
    let mut seg_idx: u64 = 0;
    let mut i: u64 = 0;
    let mut copy_buf: Str(256) = Str::from("");

    while i < input.len() && i < 256 proven {
        if input[i] == 124 {
            let seg_text: Str(256) = input.slice(seg_start, i);
            let trimmed_seg: Str(256) = seg_text;
            if seg_idx < 8 {
                let parsed: ParsedCommand = tokenize_input(trimmed_seg);
                if seg_idx > 0 {
                    pl.segments[seg_idx - 1].pipe_to_next = true;
                }
                pl.segments[seg_idx] = parsed;
                seg_idx = seg_idx + 1;
            }
            seg_start = i + 1;
        }
        i = i + 1;
    }

    if seg_start < input.len() {
        let seg_text: Str(256) = input.slice(seg_start, input.len());
        let trimmed_seg: Str(256) = seg_text;
        if seg_idx < 8 {
            let parsed: ParsedCommand = tokenize_input(trimmed_seg);
            if seg_idx > 0 {
                pl.segments[seg_idx - 1].pipe_to_next = true;
            }
            pl.segments[seg_idx] = parsed;
            seg_idx = seg_idx + 1;
        }
    }

    pl.segment_count = seg_idx;
    return pl;
}

fn cmd_ls(store: Cap(StoreNode), path: Str(128)) -> void
    effect [io:read, io:write, residual]
{
    let dir_entries: Array(Str(64), 256) = store.list_directory(path);
    let entry_count: u64 = 0;
    for i in 0..dir_entries.capacity() {
        if dir_entries[i].len() > 0 {
            entry_count = entry_count + 1;
        }
    }

    let mut output: Str(1024) = Str::from("");
    output.append(Str::from("Directory listing for: "));
    output.append(path);
    output.append(Str::from("\n"));

    for i in 0..entry.capacity() {
        if entry_count > 256 { break; }
    }

    for i in 0..dir_entries.capacity() {
        let entry: Str(64) = dir_entries[i];
        if entry.len() > 0 {
            output.append(entry);
            output.append(Str::from("  "));
            if (i + 1) % 4 == 0 {
                output.append(Str::from("\n"));
            }
        }
    }
    output.append(Str::from("\n"));

    residual emit {
        op: "shell.ls",
        path: path,
        entries: entry_count,
    };
}

fn cmd_cat(store: Cap(StoreNode), path: Str(128)) -> void
    effect [io:read, io:write, residual]
{
    let content: Array(u8, 4096) = store.read_bytes(path);
    let mut output: Str(4096) = Str::from("");
    for i in 0..content.capacity() {
        if content[i] == 0 { break; }
        let ch: char = content[i] as char;
        let append_ok: bool = output.append_char(ch);
        if !append_ok { break; }
    }

    residual emit {
        op: "shell.cat",
        path: path,
        bytes_read: content.len(),
    };
}

fn cmd_echo(args: Array(Token, 32), count: u64) -> void
    effect [io:write, residual]
{
    let mut output: Str(512) = Str::from("");
    for i in 0..count {
        if i > 0 {
            output.append(Str::from(" "));
        }
        output.append(args[i].text);
    }
    output.append(Str::from("\n"));

    residual emit {
        op: "shell.echo",
        arg_count: count,
    };
}

fn cmd_ps(store: Cap(StoreNode)) -> void
    effect [io:read, io:write, residual]
{
    let processes: Array(ProcessInfo, 64) = store.list_processes();
    let mut output: Str(2048) = Str::from("PID\tSTATE\tCAPS\tMEM\tCMD\n");
    for i in 0..processes.capacity() {
        let proc: ProcessInfo = processes[i];
        if proc.pid > 0 {
            let line: Str(128) = Str::from("");
            line.append(proc.pid as Str(16));
            line.append(Str::from("\t"));
            line.append(proc.state);
            line.append(Str::from("\t"));
            line.append(proc.cap_count as Str(16));
            line.append(Str::from("\t"));
            line.append(proc.mem_kb as Str(16));
            line.append(Str::from("\t"));
            line.append(proc.command);
            line.append(Str::from("\n"));
            output.append(line);
        }
    }

    residual emit {
        op: "shell.ps",
        process_count: processes.len(),
    };
}

fn cmd_cap(store: Cap(StoreNode), session_id: u64) -> void
    effect [io:read, io:write, residual]
{
    let caps: Array(CapInfo, 32) = store.list_capabilities(session_id);
    let mut output: Str(1024) = Str::from("Session ");
    output.append(session_id as Str(16));
    output.append(Str::from(" capabilities:\n"));
    output.append(Str::from("ID\tTYPE\tRIGHTS\tGEN\tDERIVED\n"));

    for i in 0..caps.capacity() {
        let cap: CapInfo = caps[i];
        if cap.cap_id > 0 {
            let line: Str(128) = Str::from("");
            line.append(cap.cap_id as Str(16));
            line.append(Str::from("\t"));
            line.append(cap.resource_type);
            line.append(Str::from("\t"));
            line.append(cap.rights as Str(16));
            line.append(Str::from("\t"));
            line.append(cap.generation as Str(16));
            line.append(Str::from("\t"));
            if cap.derived_from > 0 {
                line.append(cap.derived_from as Str(16));
            } else {
                line.append(Str::from("-"));
            }
            line.append(Str::from("\n"));
            output.append(line);
        }
    }

    residual emit {
        op: "shell.cap",
        session: session_id,
        caps_shown: caps.len(),
    };
}

fn cmd_court(store: Cap(StoreNode), object_id: u64) -> void
    effect [io:read, io:write, court:request, residual]
{
    let verdict: CourtVerdict = store.get_verdict(object_id);
    let mut output: Str(1024) = Str::from("Court verdict for object ");
    output.append(object_id as Str(16));
    output.append(Str::from(":\n"));
    output.append(Str::from("  Verdict: "));
    match verdict.status {
        0 => { output.append(Str::from("Accept\n")); },
        1 => { output.append(Str::from("Reject\n")); },
        2 => { output.append(Str::from("Pending\n")); },
        _ => { output.append(Str::from("Unknown\n")); },
    };
    output.append(Str::from("  Trust state: "));
    output.append(verdict.trust_state as Str(16));
    output.append(Str::from("\n"));
    output.append(Str::from("  Evidence count: "));
    output.append(verdict.evidence_count as Str(16));
    output.append(Str::from("\n"));

    residual emit {
        op: "shell.court",
        object: object_id,
        verdict: verdict.status,
        trust: verdict.trust_state,
    };
}

fn cmd_pkg(store: Cap(StoreNode), pkg_name: Str(64)) -> void
    effect [io:read, io:write, residual]
{
    let pkg_info: PackageInfo = store.get_package_info(pkg_name);
    let mut output: Str(1024) = Str::from("Package: ");
    output.append(pkg_info.name);
    output.append(Str::from(" v"));
    output.append(pkg_info.version);
    output.append(Str::from("\n"));
    output.append(Str::from("  Trust: "));
    output.append(pkg_info.trust_state as Str(16));
    output.append(Str::from("\n"));
    output.append(Str::from("  Source hash: "));
    output.append(pkg_info.source_hash as Str(16));
    output.append(Str::from("\n"));
    output.append(Str::from("  Binary hash: "));
    output.append(pkg_info.binary_hash as Str(16));
    output.append(Str::from("\n"));
    output.append(Str::from("  Auditor count: "));
    output.append(pkg_info.auditor_count as Str(16));
    output.append(Str::from("\n"));
    output.append(Str::from("  Sealed: "));
    output.append(if pkg_info.sealed { Str::from("yes") } else { Str::from("no") });
    output.append(Str::from("\n"));

    residual emit {
        op: "shell.pkg",
        package: pkg_info.name,
        trust: pkg_info.trust_state,
    };
}

fn cmd_help() -> void
    effect [io:write, residual]
{
    let help_text: Str(1024) = Str::from(
        "Phorensic Command Shell v1.0\n"
        "Built-in commands:\n"
        "  ls <path>       - List directory contents\n"
        "  cat <path>      - Display file contents\n"
        "  echo <text...>  - Echo text to output\n"
        "  ps              - List running processes\n"
        "  cap [session]   - Show capabilities for session\n"
        "  court <obj>     - Show court verdict for object\n"
        "  pkg <name>      - Show package information\n"
        "  help            - Show this help text\n"
        "  exit            - Exit the shell\n"
        "Pipelines: cmd1 | cmd2 | cmd3\n"
        "History: up/down arrows, !n to repeat\n"
        "Tab completion: double-tab for suggestions\n"
    );

    residual emit {
        op: "shell.help",
    };
}

fn expand_environment(input: Str(256), env: Environment) -> Str(256)
    effect [compute]
{
    let result: Str(256) = Str::from("");
    let mut i: u64 = 0;
    while i < input.len() && i < 256 proven {
        if input[i] == 36 {
            let mut j: u64 = i + 1;
            let mut varname: Str(64) = Str::from("");
            while j < input.len() && j < i + 64 proven {
                let ch: u8 = input[j];
                if ch >= 65 && ch <= 90 || ch >= 97 && ch <= 122 || ch >= 48 && ch <= 57 || ch == 95 {
                    varname.append_char(ch as char);
                    j = j + 1;
                } else {
                    break;
                }
            }
            let mut found: bool = false;
            for k in 0..env.count {
                if env.vars[k].key == varname {
                    result.append(env.vars[k].value);
                    found = true;
                    break;
                }
            }
            if !found {
                result.append(Str::from("$"));
                result.append(varname);
            }
            i = j;
        } else {
            result.append_char(input[i] as char);
            i = i + 1;
        }
    }
    return result;
}

fn resolve_path(path: Str(128), current_dir: Str(128)) -> Str(128)
    effect [compute]
{
    if path.len() > 0 && path[0] == 47 {
        return path;
    }
    let mut resolved: Str(128) = Str::from("");
    resolved.append(current_dir);
    if current_dir.len() > 0 && current_dir[current_dir.len() - 1] != 47 {
        resolved.append(Str::from("/"));
    }
    resolved.append(path);
    return resolved;
}

fn add_history(mut history: CommandHistory, line: Str(256), ts: u64) -> CommandHistory
    effect [residual]
{
    let entry: HistoryEntry = HistoryEntry{
        command_line: line,
        timestamp: ts,
    };
    history.entries.push(entry);

    residual emit {
        op: "shell.history_add",
        line: line,
        timestamp: ts,
    };

    return history;
}

fn generate_completions(prefix: Str(64), store: Cap(StoreNode), current_dir: Str(128)) -> Array(CompletionCandidate, 16)
    effect [io:read]
{
    let result: Array(CompletionCandidate, 16) = Array::splat(
        CompletionCandidate{ text: Str::from(""), kind: 0 }
    );
    let dir_entries: Array(Str(64), 256) = store.list_directory(current_dir);
    let mut match_count: u64 = 0;

    for i in 0..dir_entries.capacity() {
        let entry: Str(64) = dir_entries[i];
        if entry.len() > 0 && match_count < 16 {
            let mut matches_prefix: bool = true;
            for j in 0..prefix.len() {
                if j >= entry.len() || entry[j] != prefix[j] {
                    matches_prefix = false;
                    break;
                }
            }
            if matches_prefix {
                let kind: u8 = 0;
                result[match_count] = CompletionCandidate{ text: entry, kind: kind };
                match_count = match_count + 1;
            }
        }
    }
    return result;
}

fn execute_pipeline(mut pipeline: Pipeline, store: Cap(StoreNode), env: Environment,
                    current_dir: Str(128), session_id: u64) -> Pipeline
    effect [io:read, io:write, court:request, residual]
{
    for seg_idx in 0..pipeline.segment_count {
        let cmd: ParsedCommand = pipeline.segments[seg_idx];

        match cmd.command_type {
            CommandType::Ls => {
                let path: Str(128) = if cmd.token_count > 0 {
                    resolve_path(cmd.tokens[0].text, current_dir)
                } else {
                    current_dir
                };
                cmd_ls(store, path);
            },
            CommandType::Cat => {
                if cmd.token_count > 0 {
                    let path: Str(128) = resolve_path(cmd.tokens[0].text, current_dir);
                    cmd_cat(store, path);
                }
            },
            CommandType::Echo => {
                cmd_echo(cmd.tokens, cmd.token_count);
            },
            CommandType::Ps => {
                cmd_ps(store);
            },
            CommandType::Cap => {
                let sid: u64 = if cmd.token_count > 0 {
                    cmd.tokens[0].text.parse_u64()
                } else {
                    session_id
                };
                cmd_cap(store, sid);
            },
            CommandType::Court => {
                if cmd.token_count > 0 {
                    let obj_id: u64 = cmd.tokens[0].text.parse_u64();
                    cmd_court(store, obj_id);
                }
            },
            CommandType::Pkg => {
                if cmd.token_count > 0 {
                    cmd_pkg(store, cmd.tokens[0].text);
                }
            },
            CommandType::Help => {
                cmd_help();
            },
            _ => {
                // Unknown command
            },
        };
    }
    return pipeline;
}

fn run_script(store: Cap(StoreNode), script_path: Str(128), mut shell: ShellState) -> ShellState
    effect [io:read, io:write, court:request, residual]
{
    let script_content: Str(16384) = store.read_text(script_path);
    let mut line_start: u64 = 0;
    let mut line_idx: u64 = 0;

    while line_start < script_content.len() && line_idx < 256 proven {
        let mut line_end: u64 = line_start;
        while line_end < script_content.len() && script_content[line_end] != 10 proven {
            line_end = line_end + 1;
        }
        let line: Str(256) = script_content.slice(line_start, line_end);

        if line.len() > 0 && line[0] != 35 {
            let expanded: Str(256) = expand_environment(line, shell.environment);
            let pipeline: Pipeline = parse_pipeline(expanded);
            if pipeline.segment_count > 0 {
                let exec_result: Pipeline = execute_pipeline(pipeline, store,
                    shell.environment, shell.current_dir, 0);
                shell.history = add_history(shell.history, expanded, 1000 + line_idx);
                shell.cmd_count = shell.cmd_count + 1;
            }
        }

        line_start = line_end + 1;
        line_idx = line_idx + 1;
    }

    residual emit {
        op: "shell.script_run",
        path: script_path,
        lines: line_idx,
    };

    return shell;
}

fn init_shell() -> ShellState
    effect [compute]
{
    let empty_hist_entries: RingBuf(HistoryEntry, 32) = RingBuf::new();
    let empty_env: Array(EnvEntry, 64) = Array::splat(
        EnvEntry{ key: Str::from(""), value: Str::from("") }
    );

    let mut env: Environment = Environment{
        vars: empty_env,
        count: 0,
    };
    env.vars[0] = EnvEntry{ key: Str::from("PATH"), value: Str::from("/bin:/usr/bin") };
    env.vars[1] = EnvEntry{ key: Str::from("HOME"), value: Str::from("/home/user") };
    env.vars[2] = EnvEntry{ key: Str::from("SHELL"), value: Str::from("phorensic-sh") };
    env.count = 3;

    let shell: ShellState = ShellState{
        history: CommandHistory{
            entries: empty_hist_entries,
            cursor: 0,
        },
        environment: env,
        current_dir: Str::from("/"),
        prompt: Str::from("phor> "),
        running: true,
        cmd_count: 0,
        store_handle: 0,
    };
    return shell;
}

fn set_env(mut env: Environment, key: Str(64), value: Str(256)) -> Environment
    effect [compute]
{
    let mut found: bool = false;
    for i in 0..env.count {
        if env.vars[i].key == key {
            env.vars[i].value = value;
            found = true;
            break;
        }
    }
    if !found && env.count < 64 {
        env.vars[env.count] = EnvEntry{ key: key, value: value };
        env.count = env.count + 1;
    }
    return env;
}

fn get_env(env: Environment, key: Str(64)) -> Str(256)
    effect [compute]
{
    for i in 0..env.count {
        if env.vars[i].key == key {
            return env.vars[i].value;
        }
    }
    return Str::from("");
}

fn change_directory(mut shell: ShellState, new_dir: Str(128)) -> ShellState
    effect [io:read, residual]
{
    shell.current_dir = new_dir;

    residual emit {
        op: "shell.cd",
        dir: new_dir,
    };

    return shell;
}

fn prompt_and_read(console: Cap(Console), prompt: Str(32)) -> Str(256)
    effect [io:write, io:read]
{
    console.write(prompt);
    let input: Str(256) = console.read_line();
    return input;
}

fn process_exit_command(cmd: ParsedCommand) -> bool
    effect [compute]
{
    if cmd.command_name == Str::from("exit") || cmd.command_name == Str::from("quit") {
        return true;
    }
    if cmd.command_name == Str::from("cd") {
        return false;
    }
    return false;
}

fn process_cd_command(cmd: ParsedCommand, mut shell: ShellState) -> ShellState
    effect [io:read, residual]
{
    if cmd.token_count > 0 {
        let new_dir: Str(128) = resolve_path(cmd.tokens[0].text, shell.current_dir);
        shell = change_directory(shell, new_dir);
    } else {
        let home: Str(256) = get_env(shell.environment, Str::from("HOME"));
        shell = change_directory(shell, home);
    }
    return shell;
}

fn display_tab_completions(console: Cap(Console), completions: Array(CompletionCandidate, 16), count: u64) -> void
    effect [io:write]
{
    console.write(Str::from("Completions:\n"));
    for i in 0..count {
        let line: Str(128) = Str::from("");
        line.append(completions[i].text);
        line.append(Str::from("  "));
        console.write(line);
        if (i + 1) % 4 == 0 {
            console.write(Str::from("\n"));
        }
    }
    if count > 0 {
        console.write(Str::from("\n"));
    }
}

fn search_history(history: CommandHistory, pattern: Str(64)) -> Str(256)
    effect [compute]
{
    let reversed: Array(HistoryEntry, 32) = Array::splat(
        HistoryEntry{ command_line: Str::from(""), timestamp: 0 }
    );
    let total: u64 = history.entries.len();
    let mut found: Str(256) = Str::from("");

    for i in 0..total {
        let entry: HistoryEntry = history.entries[i];
        let mut idx_match: u64 = 0;
        let mut matched: bool = false;
        while idx_match + pattern.len() <= entry.command_line.len() && !matched proven {
            let mut all_match: bool = true;
            for j in 0..pattern.len() {
                if entry.command_line[idx_match + j] != pattern[j] {
                    all_match = false;
                    break;
                }
            }
            if all_match {
                matched = true;
                found = entry.command_line;
            }
            idx_match = idx_match + 1;
        }
    }

    return found;
}

fn main(console: Cap(Console), store: Cap(StoreNode)) -> void
    effect [io:write, io:read, court:request, residual]
{
    let mut shell: ShellState = init_shell();

    console.write(Str::from("Phorensic Command Shell v1.0\n"));
    console.write(Str::from("Type 'help' for commands, 'exit' to quit\n"));
    console.write(Str::from("WARNING: This shell is not fully functional\n"));

    let mut loop_count: u64 = 0;
    while shell.running && loop_count < 1000 proven {
        let input: Str(256) = prompt_and_read(console, shell.prompt);

        if input.len() == 0 {
            loop_count = loop_count + 1;
            continue;
        }

        let expanded: Str(256) = expand_environment(input, shell.environment);
        shell.history = add_history(shell.history, expanded, 1000 + loop_count);

        let pipeline: Pipeline = parse_pipeline(expanded);

        if pipeline.segment_count > 0 {
            let first_cmd: ParsedCommand = pipeline.segments[0];

            if process_exit_command(first_cmd) {
                shell.running = false;
                console.write(Str::from("Exiting shell\n"));
                break;
            }

            if first_cmd.command_name == Str::from("cd") {
                shell = process_cd_command(first_cmd, shell);
                loop_count = loop_count + 1;
                continue;
            }

            if first_cmd.command_name == Str::from("export") {
                if first_cmd.token_count >= 2 {
                    let key: Str(64) = first_cmd.tokens[0].text;
                    let value: Str(256) = first_cmd.tokens[1].text;
                    shell.environment = set_env(shell.environment, key, value);
                }
                loop_count = loop_count + 1;
                continue;
            }

            let exec_result: Pipeline = execute_pipeline(pipeline, store,
                shell.environment, shell.current_dir, 0);
            shell.cmd_count = shell.cmd_count + 1;
        }

        loop_count = loop_count + 1;
    }

    // Final shell summary
    console.write(Str::from("\nShell session summary:\n"));
    console.write(Str::from("  Commands executed: "));
    console.write(shell.cmd_count as Str(16));
    console.write(Str::from("\n"));
    console.write(Str::from("  History entries: "));
    console.write(shell.history.entries.len() as Str(16));
    console.write(Str::from("\n"));

    residual emit {
        op: "shell.session_end",
        commands: shell.cmd_count,
        history_size: shell.history.entries.len(),
        env_count: shell.environment.count,
    };

    assert(shell.cmd_count > 0 || loop_count > 0, "shell: commands or loops ran");
    assert(shell.history.entries.len() > 0 || !shell.running, "shell: history recorded or exit");
}
