        effects: [deterministic]

    // Migrate from an older version.
    fn migrate(self: ref mut, from_version: Word64) -> Result<(), MigrationError>
        effects: [deterministic]

    // Check if migration is needed.
    fn needs_migration(self) -> bool
        effects: [deterministic]
    {
        self.format_version() < Self::latest_format_version()
    }

    // Get the latest supported format version.
    fn latest_format_version() -> Word64
        effects: [deterministic]

    // Get supported format versions.
    fn supported_versions() -> FixedArray[CAPACITY_SMALL, Word64>
        effects: [deterministic]
}

pub type MigrationError : struct {
    from_version: Word64,
    to_version: Word64,
    msg: FixedString[128],
}

impl MigrationError {
    pub fn new(from: Word64, to: Word64, msg: FixedString[128]) -> MigrationError
        effects: [deterministic]
    {
        MigrationError {
            from_version: from,
            to_version: to,
            msg: msg,
        }
    }

    pub fn from_version(self) -> Word64 { self.from_version }
    pub fn to_version(self) -> Word64 { self.to_version }
    pub fn message(self) -> FixedString[128] { self.msg }
}

// ──────────────────────────────────────────────
// Trait: Indexable
// ──────────────────────────────────────────────
// Types that provide index-based access.
// Evidence path: TRAIT-INDEX-001 through TRAIT-INDEX-020

pub trait Indexable[T] : {
    // Get the element at index.
    fn at(self, index: u32) -> Result[T, BoundsError>
        effects: [deterministic]

    // Set the element at index.
    fn set_at(self: ref mut, index: u32, value: T) -> Result[(), BoundsError>
        effects: [deterministic]

    // Get the number of elements.
    fn length(self) -> u32
        effects: [deterministic]

    // Check if an index is valid.
    fn is_valid_index(self, index: u32) -> bool
        effects: [deterministic]
    {
        index < self.length()
    }

    // Get the first element.
    fn first(self) -> Option[T>
        effects: [deterministic]
    {
        if self.length() > 0 {
            Option::Some(self.at(0).unwrap())
        } else {
            Option::None
        }
    }

    // Get the last element.
    fn last(self) -> Option[T>
        effects: [deterministic]
    {
        let len: u32 = self.length()
        if len > 0 {
            Option::Some(self.at(len - 1).unwrap())
        } else {
            Option::None
        }
    }
}

// ──────────────────────────────────────────────
// Trait: Iterable
// ──────────────────────────────────────────────
// Types that support iteration.
// Evidence path: TRAIT-ITER-001 through TRAIT-ITER-020

pub trait Iterable[T] : Indexable[T] {
    // Call a function for each element.
    fn for_each(self, f: fn(T))
        effects: [deterministic]
    {
        let len: u32 = self.length()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..len {
            f(self.at(i).unwrap())
        }
    }

    // Count elements matching a predicate.
    fn count_if(self, predicate: fn(T) -> bool) -> u32
        effects: [deterministic]
    {
        let mut count: u32 = 0
        let len: u32 = self.length()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..len {
            if predicate(self.at(i).unwrap()) {
                count = count + 1
            }
        }
        count
    }

    // Check if any element matches a predicate.
    fn any(self, predicate: fn(T) -> bool) -> bool
        effects: [deterministic]
    {
        let len: u32 = self.length()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..len {
            if predicate(self.at(i).unwrap()) {
                return true
            }
        }
        false
    }

    // Check if all elements match a predicate.
    fn all(self, predicate: fn(T) -> bool) -> bool
        effects: [deterministic]
    {
        let len: u32 = self.length()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..len {
            if !predicate(self.at(i).unwrap()) {
                return false
            }
        }
        true
    }

    // Find the first element matching a predicate.
    fn find_first(self, predicate: fn(T) -> bool) -> Option[u32>
        effects: [deterministic]
    {
        let len: u32 = self.length()
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..len {
            if predicate(self.at(i).unwrap()) {
                return Option::Some(i)
            }
        }
        Option::None
    }
}

// ──────────────────────────────────────────────
// Trait: Serialize (for types with custom serialization)
// ──────────────────────────────────────────────
// Evidence path: TRAIT-SER-001 through TRAIT-SER-020

pub trait Serialize : Measurable {
    // Serialize into a buffer.
    fn serialize(self, buf: ref mut SerializeBuffer[KnownN]) -> Result<(), SerializationError>
        effects: [deterministic, serialize]

    // Deserialize from a buffer.
    fn deserialize(buf: ref mut DeserializeBuffer[KnownN]) -> Result[Self, SerializationError>
        effects: [deterministic, deserialize]

    // Serialize to a byte array.
    fn to_bytes(self) -> Result<Byte[], SerializationError>
        effects: [deterministic, serialize, hash]
    {
        let size: u64 = self.byte_size().as_word64().to_u64()
        let mut buf: SerializeBuffer[KnownN] = SerializeBuffer::new()
        self.serialize(&mut buf)?;
        buf.finalize()?;
        let result_len: u32 = buf.position()
        let mut result: Byte[] = Byte[]::new(result_len)
        // loop: bounds[BOUND_SERIAL] — bounded by result length
        loop: bounds[BOUND_SERIAL] for i in 0..result_len {
            result[i as usize] = buf.data[i as usize]
        }
        Result::Ok(result)
    }

    // Deserialize from a byte array.
    fn from_bytes(data: Byte[], length: u32) -> Result[Self, SerializationError>
        effects: [deterministic, deserialize, hash]
    {
        let mut buf: DeserializeBuffer[KnownN] = DeserializeBuffer::new(data, length)
        let value: Self = Self::deserialize(&mut buf)?
        buf.verify_checksum()?;
        Result::Ok(value)
    }
}

// ──────────────────────────────────────────────
// Trait: Monotonic
// ──────────────────────────────────────────────
// Types with monotonically non-decreasing values.
// Evidence path: TRAIT-MONO-001 through TRAIT-MONO-015

pub trait Monotonic : {
    // Advance to the next value (never decreases).
    fn advance(self: ref mut)
        effects: [deterministic]

    // Get the current value.
    fn current(self) -> Self
        effects: [deterministic]

    // Check if a value is ahead of the current.
    fn is_ahead(self, other: Self) -> bool
        effects: [deterministic]

    // Get the difference from another value.
    fn difference(self, other: Self) -> Word64
        effects: [deterministic]

    // Check if this monotonic value has wrapped.
    fn has_wrapped(self) -> bool
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Trait: Bounded
// ──────────────────────────────────────────────
// Types with well-defined bounds.
// Evidence path: TRAIT-BOUND-001 through TRAIT-BOUND-015

pub trait Bounded : {
    // The minimum possible value.
    fn min_value() -> Self
        effects: [deterministic]

    // The maximum possible value.
    fn max_value() -> Self
        effects: [deterministic]

    // Check if a value is within valid bounds.
    fn is_in_bounds(self) -> bool
        effects: [deterministic]

    // Clamp to valid bounds.
    fn clamp(self) -> Self
        effects: [deterministic]

    // Get the total range size.
    fn range_size() -> Word64
        effects: [deterministic]
}

// ──────────────────────────────────────────────
// Trait: Reservoir
// ──────────────────────────────────────────────
// Types that act as data reservoirs with capacity.
// Evidence path: TRAIT-RES-001 through TRAIT-RES-015

pub trait Reservoir : {
    // Get the total capacity.
    fn capacity(self) -> Size
        effects: [deterministic]

    // Get the current fill level.
    fn fill_level(self) -> Size
        effects: [deterministic]

    // Get the remaining space.
    fn remaining(self) -> Size
        effects: [deterministic]
        { self.capacity() - self.fill_level() }

    // Check if the reservoir is empty.
    fn is_empty(self) -> bool
        effects: [deterministic]
        { self.fill_level().is_zero() }

    // Check if the reservoir is full.
    fn is_full(self) -> bool
        effects: [deterministic]
        { self.fill_level().gte(self.capacity()) }

    // Get utilization as a ratio [0.0, 1.0] in fixed-point.
    fn utilization(self) -> Word64
        effects: [deterministic]
    {
        if self.capacity().is_zero() {
            Word64::zero()
        } else {
            self.fill_level().checked_mul(Word64::from_u64(FP_SCALE))
                .unwrap_or(Word64::zero())
                .checked_div(self.capacity())
                .unwrap_or(Word64::zero())
        }
    }
}

