// store_layout.phor — Physical store layout: object storage, generation storage, residual storage
// Phorensic Forensic Store: on-disk and in-memory layout
// Spec: FORENSIC_STORE.md — Store Layout section
// Grammar: PHORENSIC_GRAMMAR.md §43

package forensic_store.store_layout;

use forensic_store.store_object::{
    StoreObject, Hash256, hash256_zero, hash256_equal,
    TrustState, TrustLevel,
    Identity, identity_equal,
    ResidualRecord, ResidualHistory, ResidualOpType, ResidualSeverity, CausalCategory,
    ObjectRole, DialectProfile,
    Signature, AuditorStamp,
};
use forensic_store.store_key::{
    StoreKey, store_key_equal, store_key_zero,
    store_key_partition, store_key_directory_prefix,
};

// ============================================================================
// Layout Constants
// ============================================================================

/// Maximum path component length.
const MAX_PATH_LEN: u64 = 512;

/// Maximum filename length.
const MAX_FILENAME_LEN: u64 = 256;

/// Number of partition buckets for object storage.
const PARTITION_COUNT: u64 = 256;

/// Maximum objects per partition.
const OBJECTS_PER_PARTITION: u64 = 64;

/// Maximum generations.
const MAX_GENERATIONS: u64 = 256;

/// Maximum profiles.
const MAX_PROFILES: u64 = 256;

/// Maximum residuals per object.
const MAX_RESIDUALS_PER_OBJECT: u64 = 1024;

// ============================================================================
// Path Types
// ============================================================================

/// A bounded filesystem path component.
struct LayoutPath
    layout packed
{
    /// Path bytes
    bytes: Array[u8, 512],
    /// Length of the path string
    len: u32,
}

/// A file extension identifier.
type LayoutExtension = enum {
    /// Object storage file (.phor-object)
    Object = 0,
    /// Object signature file (.phor-object.sig)
    ObjectSignature = 1,
    /// Object metadata file (.phor-object.meta)
    ObjectMeta = 2,
    /// Generation descriptor (.phor-generation)
    Generation = 3,
    /// Generation signature (.phor-generation.sig)
    GenerationSignature = 4,
    /// Profile descriptor (.phor-profile)
    Profile = 5,
    /// Profile signature (.phor-profile.sig)
    ProfileSignature = 6,
    /// Residual record (.phor-residual)
    Residual = 7,
    /// Object content file (.phor-content)
    ObjectContent = 8,
    /// Evidence chain file (.phor-evidence)
    EvidenceChain = 9,
    /// Court evidence file (.phor-court-evidence)
    CourtEvidence = 10,
    /// Receipt file (.phor-receipt)
    Receipt = 11,
    /// Checkpoint file (.phor-checkpoint)
    Checkpoint = 12,
    /// Container file (.phor-spec)
    Container = 13,
    /// Seal file (.phor-seal)
    Seal = 14,
    /// Lock file (.phor-lock)
    Lock = 15,
}

// ============================================================================
// Store Layout Descriptor
// ============================================================================

/// Complete description of the store's physical layout.
/// Used for store initialization, repair, and inspection.
struct StoreLayout
    layout packed
{
    /// Root path of the store
    root_path: LayoutPath,
    /// Object storage path (/objects/)
    objects_path: LayoutPath,
    /// Generation storage path (/generations/)
    generations_path: LayoutPath,
    /// Profile storage path (/profiles/)
    profiles_path: LayoutPath,
    /// Residual storage path (/residuals/)
    residuals_path: LayoutPath,
    /// Temporary storage path (/tmp/)
    temp_path: LayoutPath,
    /// Lock file path
    lock_path: LayoutPath,
    /// Store format version
    format_version: u32,
    /// Store layout version
    layout_version: u32,
    /// Block size for storage operations
    block_size: u32,
    /// Maximum object size in bytes
    max_object_size: u64,
    /// Whether the store is initialized
    initialized: bool,
    /// Number of partition directories
    partition_count: u32,
    /// Partition directory prefix length (hex chars)
    partition_prefix_len: u32,
    /// Whether signatures are stored inline or separate
    separate_signatures: bool,
    /// Whether metadata is stored inline or separate
    separate_metadata: bool,
    /// Compression algorithm for object storage
    compression: CompressionType,
    /// Encryption algorithm for object storage (0 = none)
    encryption: EncryptionType,
}

/// Compression type for stored objects.
type CompressionType = enum {
    None = 0,
    Zstd = 1,
    Lz4 = 2,
}

/// Encryption type for stored objects.
type EncryptionType = enum {
    None = 0,
    Aes256Gcm = 1,
    Chacha20Poly1305 = 2,
}

// ============================================================================
// Object Storage Layout
// ============================================================================

/// Descriptor for an object's physical storage location.
struct ObjectStorageLocation
    layout packed
{
    /// The store key
    key: StoreKey,
    /// Partition bucket (0..255)
    partition: u8,
    /// Object index within partition
    partition_index: u32,
    /// Path to the object file
    object_path: LayoutPath,
    /// Path to the signature file
    signature_path: LayoutPath,
    /// Path to the metadata file
    metadata_path: LayoutPath,
    /// Path to the content file (if separate from object)
    content_path: LayoutPath,
    /// Object file size
    object_file_size: u64,
    /// Content offset within object file
    content_offset: u64,
    /// Content length
    content_length: u64,
    /// Whether this location is currently occupied
    occupied: bool,
    /// Whether this location is marked for GC
    marked_for_gc: bool,
    /// Generation stamp
    generation: u64,
}

/// A partition directory containing objects.
struct ObjectPartition
    layout packed
{
    /// Partition index (0..255)
    index: u8,
    /// Hex prefix for directory name
    prefix: Array[u8, 2],
    /// Objects in this partition
    objects: Array[ObjectStorageLocation, 64],
    /// Number of occupied slots
    occupied_count: u32,
    /// Number of GC-marked slots
    gc_marked_count: u32,
}

/// Complete object storage area.
struct ObjectStorageArea
    layout packed
{
    /// All 256 partitions
    partitions: Array[ObjectPartition, 256],
    /// Total objects across all partitions
    total_objects: u32,
    /// Total GC-marked objects
    total_gc_marked: u32,
}

// ============================================================================
// Generation Storage Layout
// ============================================================================

/// Descriptor for a generation's physical storage location.
struct GenerationStorageLocation
    layout packed
{
    /// Generation number
    generation_number: u64,
    /// Path to the generation descriptor file
    descriptor_path: LayoutPath,
    /// Path to the generation signature file
    signature_path: LayoutPath,
    /// Whether this generation is stored
    stored: bool,
    /// File size of the descriptor
    descriptor_size: u64,
}

/// Complete generation storage area.
struct GenerationStorageArea
    layout packed
{
    /// All generation storage locations
    generations: Array[GenerationStorageLocation, 256],
    /// Number of stored generations
    stored_count: u32,
    /// Next generation number
    next_generation: u64,
}

// ============================================================================
// Profile Storage Layout
// ============================================================================

/// Descriptor for a profile's physical storage location.
struct ProfileStorageLocation
    layout packed
{
    /// Profile name
    name: Array[u8, 128],
    name_len: u32,
    /// Path to the profile descriptor file
    descriptor_path: LayoutPath,
    /// Path to the profile signature file
    signature_path: LayoutPath,
    /// Whether this profile is stored
    stored: bool,
    /// Whether this profile is active
    active: bool,
}

/// Complete profile storage area.
struct ProfileStorageArea
    layout packed
{
    /// All profile storage locations
    profiles: Array[ProfileStorageLocation, 256],
    /// Number of stored profiles
    stored_count: u32,
}

// ============================================================================
// Residual Storage Layout
// ============================================================================

/// Descriptor for a residual record's physical storage location.
struct ResidualStorageLocation
    layout packed
{
    /// The object key this residual belongs to
    owner_key: StoreKey,
    /// The residual event ID
    event_id: u64,
    /// Timestamp from the residual
    timestamp: u64,
    /// Path to the residual file
    residual_path: LayoutPath,
    /// Whether this residual is stored
    stored: bool,
    /// Residual record size
    residual_size: u64,
}

/// Complete residual storage area.
struct ResidualStorageArea
    layout packed
{
    /// All residual storage locations
    residuals: Array[ResidualStorageLocation, 65536],
    /// Number of stored residuals
    stored_count: u32,
    /// Maximum residuals
    max_residuals: u32,
}

// ============================================================================
// Layout Construction
// ============================================================================

/// Build a LayoutPath from a string literal.
fn layout_path_from_string(
    s: Array[u8, 512],
    len: u32,
) -> LayoutPath
    effect [compute]
{
    return LayoutPath {
        bytes: s,
        len: len,
    };
}

/// Concatenate two path components with a separator.
fn layout_path_join(
    base: LayoutPath,
    component: Array[u8, 256],
    component_len: u32,
    separator: u8,
) -> LayoutPath
    effect [compute]
{
    let result: Array[u8, 512] = Array[u8, 512]::zeroed();
    let mut pos: u32 = 0;

    // Copy base
    for i in 0..base.len as u64 {
        result[pos as u64] = base.bytes[i];
        pos = pos + 1;
    }

    // Add separator if base doesn't end with one
    if base.len > 0 && base.bytes[(base.len - 1) as u64] != separator {
        result[pos as u64] = separator;
        pos = pos + 1;
    }

    // Copy component
    for i in 0..component_len as u64 {
        result[pos as u64] = component[i];
        pos = pos + 1;
    }

    return LayoutPath {
        bytes: result,
        len: pos,
    };
}

/// Create the standard store layout descriptor.
fn store_layout_create(
    root: Array[u8, 512],
    root_len: u32,
) -> StoreLayout
    effect [compute]
{
    let root_path: LayoutPath = LayoutPath {
        bytes: root,
        len: root_len,
    };

    let sep: u8 = '/';
    let objects_str: Array[u8, 256] = Array[u8, 256]::from_literal("objects");
    let gens_str: Array[u8, 256] = Array[u8, 256]::from_literal("generations");
    let profs_str: Array[u8, 256] = Array[u8, 256]::from_literal("profiles");
    let residuals_str: Array[u8, 256] = Array[u8, 256]::from_literal("residuals");
    let tmp_str: Array[u8, 256] = Array[u8, 256]::from_literal("tmp");
    let lock_str: Array[u8, 256] = Array[u8, 256]::from_literal("store.lock");

    return StoreLayout {
        root_path: root_path,
        objects_path: layout_path_join(root_path, objects_str, 7, sep),
        generations_path: layout_path_join(root_path, gens_str, 10, sep),
        profiles_path: layout_path_join(root_path, profs_str, 8, sep),
        residuals_path: layout_path_join(root_path, residuals_str, 9, sep),
        temp_path: layout_path_join(root_path, tmp_str, 3, sep),
        lock_path: layout_path_join(root_path, lock_str, 9, sep),
        format_version: 1,
        layout_version: 1,
        block_size: 4096,
        max_object_size: 67108864,
        initialized: false,
        partition_count: 256,
        partition_prefix_len: 2,
        separate_signatures: true,
        separate_metadata: true,
        compression: CompressionType::None,
        encryption: EncryptionType::None,
    };
}

// ============================================================================
// Storage Location Computation
// ============================================================================

/// Compute the storage location for an object given its key and layout.
fn compute_object_location(
    layout: StoreLayout,
    key: StoreKey,
    index: u32,
) -> ObjectStorageLocation
    effect [compute]
{
    let partition: u8 = store_key_partition(key);
    let prefix: Array[u8, 2] = store_key_directory_prefix(key);

    // Build object filename: {prefix}/{key}.phor-object
    let partition_dir: Array[u8, 256] = Array[u8, 256]::zeroed();
    partition_dir[0] = prefix[0];
    partition_dir[1] = prefix[1];
    partition_dir[2] = '/';

    // Build full object path
    let obj_path: LayoutPath = layout_path_join(
        layout.objects_path,
        partition_dir,
        3,
        '/',
    );

    // Build signature path
    let sig_path: LayoutPath = LayoutPath {
        bytes: obj_path.bytes,
        len: obj_path.len,
    };

    // Build metadata path
    let meta_path: LayoutPath = LayoutPath {
        bytes: obj_path.bytes,
        len: obj_path.len,
    };

    // Build content path (same as object for inline content)
    let content_path: LayoutPath = obj_path;

    return ObjectStorageLocation {
        key: key,
        partition: partition,
        partition_index: index,
        object_path: obj_path,
        signature_path: sig_path,
        metadata_path: meta_path,
        content_path: content_path,
        object_file_size: 0,
        content_offset: 0,
        content_length: 0,
        occupied: false,
        marked_for_gc: false,
        generation: 0,
    };
}

/// Compute the storage location for a generation.
fn compute_generation_location(
    layout: StoreLayout,
    gen_number: u64,
) -> GenerationStorageLocation
    effect [compute]
{
    // Generation path: /generations/{gen_number}/
    let gen_dir: Array[u8, 256] = Array[u8, 256]::zeroed();
    let mut pos: u32 = 0;
    let digits: Array[u8, 20] = Array[u8, 20]::from_literal("0123456789");
    let mut n: u64 = gen_number;
    let mut temp_digits: Array[u8, 20] = Array[u8, 20]::zeroed();
    let mut digit_count: u32 = 0;

    // Extract digits
    if n == 0 {
        temp_digits[0] = 0;
        digit_count = 1;
    } else {
        while n > 0 {
            temp_digits[digit_count as u64] = (n % 10) as u8;
            n = n / 10;
            digit_count = digit_count + 1;
        }
    }

    // Reverse digits into gen_dir
    let mut di: u32 = 0;
    while di < digit_count {
        let src_idx: u64 = (digit_count - 1 - di) as u64;
        gen_dir[di as u64] = digits[temp_digits[src_idx] as u64];
        di = di + 1;
    }

    gen_dir[di as u64] = '/';
    di = di + 1;

    let desc_path: LayoutPath = layout_path_join(
        layout.generations_path,
        gen_dir,
        di,
        '/',
    );

    return GenerationStorageLocation {
        generation_number: gen_number,
        descriptor_path: desc_path,
        signature_path: LayoutPath {
            bytes: desc_path.bytes,
            len: desc_path.len,
        },
        stored: false,
        descriptor_size: 0,
    };
}

/// Compute the storage location for a residual record.
fn compute_residual_location(
    layout: StoreLayout,
    owner_key: StoreKey,
    event_id: u64,
    timestamp: u64,
) -> ResidualStorageLocation
    effect [compute]
{
    let prefix: Array[u8, 2] = store_key_directory_prefix(owner_key);

    // Build residual filename: {timestamp}_{event_id}.phor-residual
    let filename: Array[u8, 256] = Array[u8, 256]::zeroed();
    let digits: Array[u8, 20] = Array[u8, 20]::from_literal("0123456789");
    let mut pos: u32 = 0;

    // Timestamp
    let mut ts: u64 = timestamp;
    let mut ts_digits: Array[u8, 20] = Array[u8, 20]::zeroed();
    let mut ts_count: u32 = 0;
    if ts == 0 {
        ts_digits[0] = 0;
        ts_count = 1;
    } else {
        while ts > 0 {
            ts_digits[ts_count as u64] = (ts % 10) as u8;
            ts = ts / 10;
            ts_count = ts_count + 1;
        }
    }
    let mut di: u32 = 0;
    while di < ts_count {
        let src_idx: u64 = (ts_count - 1 - di) as u64;
        filename[pos as u64] = digits[ts_digits[src_idx] as u64];
        pos = pos + 1;
        di = di + 1;
    }

    // Underscore separator
    filename[pos as u64] = '_';
    pos = pos + 1;

    // Event ID
    let mut eid: u64 = event_id;
    let mut eid_digits: Array[u8, 20] = Array[u8, 20]::zeroed();
    let mut eid_count: u32 = 0;
    if eid == 0 {
        eid_digits[0] = 0;
        eid_count = 1;
    } else {
        while eid > 0 {
            eid_digits[eid_count as u64] = (eid % 10) as u8;
            eid = eid / 10;
            eid_count = eid_count + 1;
        }
    }
    di = 0;
    while di < eid_count {
        let src_idx: u64 = (eid_count - 1 - di) as u64;
        filename[pos as u64] = digits[eid_digits[src_idx] as u64];
        pos = pos + 1;
        di = di + 1;
    }

    // Extension
    let ext: Array[u8, 13] = Array[u8, 13]::from_literal(".phor-residual");
    for i in 0..13 {
        filename[pos as u64] = ext[i];
        pos = pos + 1;
    }

    // Build path: /residuals/{prefix}/{filename}
    let res_dir: Array[u8, 256] = Array[u8, 256]::zeroed();
    res_dir[0] = prefix[0];
    res_dir[1] = prefix[1];
    res_dir[2] = '/';

    let res_path: LayoutPath = layout_path_join(
        layout.residuals_path,
        res_dir,
        3,
        '/',
    );

    return ResidualStorageLocation {
        owner_key: owner_key,
        event_id: event_id,
        timestamp: timestamp,
        residual_path: res_path,
        stored: false,
        residual_size: 0,
    };
}

// ============================================================================
// Layout Initialization
// ============================================================================

/// Initialize the store layout — creates all required directory structures.
fn store_layout_initialize(
    layout: StoreLayout,
) -> StoreLayout
    effect [compute, residual]
{
    residual emit {
        op: "store_layout.initialize",
        root_prefix: layout.root_path.bytes[0] as u64,
        format_version: layout.format_version,
        partition_count: layout.partition_count,
    };

    return StoreLayout {
        root_path: layout.root_path,
        objects_path: layout.objects_path,
        generations_path: layout.generations_path,
        profiles_path: layout.profiles_path,
        residuals_path: layout.residuals_path,
        temp_path: layout.temp_path,
        lock_path: layout.lock_path,
        format_version: layout.format_version,
        layout_version: layout.layout_version,
        block_size: layout.block_size,
        max_object_size: layout.max_object_size,
        initialized: true,
        partition_count: layout.partition_count,
        partition_prefix_len: layout.partition_prefix_len,
        separate_signatures: layout.separate_signatures,
        separate_metadata: layout.separate_metadata,
        compression: layout.compression,
        encryption: layout.encryption,
    };
}

/// Validate that a layout is internally consistent.
fn store_layout_validate(layout: StoreLayout) -> bool
    effect [compute, residual]
{
    let mut ok: bool = true;

    if layout.root_path.len == 0 {
        ok = false;
    }
    if layout.format_version == 0 {
        ok = false;
    }
    if layout.partition_count == 0 || layout.partition_count > 256 {
        ok = false;
    }
    if layout.block_size == 0 {
        ok = false;
    }
    if layout.max_object_size == 0 {
        ok = false;
    }

    residual emit {
        op: "store_layout.validate",
        valid: ok as u64,
    };

    return ok;
}

// ============================================================================
// Layout Statistics
// ============================================================================

/// Statistics about the store layout.
struct LayoutStats
    layout packed
{
    root_path: LayoutPath,
    format_version: u32,
    layout_version: u32,
    initialized: bool,
    block_size: u32,
    max_object_size: u64,
    partition_count: u32,
    separate_signatures: bool,
    compression_name: Array[u8, 16],
    encryption_name: Array[u8, 16],
}

/// Get statistics about the store layout.
fn store_layout_stats(layout: StoreLayout) -> LayoutStats
    effect [compute]
{
    let comp_name: Array[u8, 16] = Array[u8, 16]::zeroed();
    match layout.compression {
        CompressionType::None => {
            let s: Array[u8, 16] = Array[u8, 16]::from_literal("none");
            for i in 0..4 { comp_name[i] = s[i]; }
        },
        CompressionType::Zstd => {
            let s: Array[u8, 16] = Array[u8, 16]::from_literal("zstd");
            for i in 0..4 { comp_name[i] = s[i]; }
        },
        CompressionType::Lz4 => {
            let s: Array[u8, 16] = Array[u8, 16]::from_literal("lz4");
            for i in 0..3 { comp_name[i] = s[i]; }
        },
    }

    let enc_name: Array[u8, 16] = Array[u8, 16]::zeroed();
    match layout.encryption {
        EncryptionType::None => {
            let s: Array[u8, 16] = Array[u8, 16]::from_literal("none");
            for i in 0..4 { enc_name[i] = s[i]; }
        },
        EncryptionType::Aes256Gcm => {
            let s: Array[u8, 16] = Array[u8, 16]::from_literal("aes-256-gcm");
            for i in 0..11 { enc_name[i] = s[i]; }
        },
        EncryptionType::Chacha20Poly1305 => {
            let s: Array[u8, 16] = Array[u8, 16]::from_literal("chacha20-poly1305");
            for i in 0..17 { enc_name[i] = s[i]; }
        },
    }

    return LayoutStats {
        root_path: layout.root_path,
        format_version: layout.format_version,
        layout_version: layout.layout_version,
        initialized: layout.initialized,
        block_size: layout.block_size,
        max_object_size: layout.max_object_size,
        partition_count: layout.partition_count,
        separate_signatures: layout.separate_signatures,
        compression_name: comp_name,
        encryption_name: enc_name,
    };
}

// ============================================================================
// Object Area Operations
// ============================================================================

/// Create an empty object storage area.
fn object_storage_area_new() -> ObjectStorageArea
    effect [compute]
{
    let area: ObjectStorageArea = ObjectStorageArea {
        partitions: Array[ObjectPartition, 256]::zeroed(),
        total_objects: 0,
        total_gc_marked: 0,
    };
    return area;
}

/// Find a free slot in the appropriate partition for a key.
fn object_storage_find_slot(
    area: ObjectStorageArea,
    key: StoreKey,
) -> Result[ObjectStorageLocation, u32]
    effect [compute]
{
    let partition: u8 = store_key_partition(key);
    let p: ObjectPartition = area.partitions[partition as u64];

    for i in 0..64 {
        if !p.objects[i].occupied {
            let loc: ObjectStorageLocation = ObjectStorageLocation {
                key: key,
                partition: partition,
                partition_index: i,
                object_path: LayoutPath { bytes: Array[u8, 512]::zeroed(), len: 0 },
                signature_path: LayoutPath { bytes: Array[u8, 512]::zeroed(), len: 0 },
                metadata_path: LayoutPath { bytes: Array[u8, 512]::zeroed(), len: 0 },
                content_path: LayoutPath { bytes: Array[u8, 512]::zeroed(), len: 0 },
                object_file_size: 0,
                content_offset: 0,
                content_length: 0,
                occupied: false,
                marked_for_gc: false,
                generation: 0,
            };
            return Result[ObjectStorageLocation, u32]::Ok(loc);
        }
    }
    return Result[ObjectStorageLocation, u32]::Err(0);
}

/// Mark an object storage location as occupied.
fn object_storage_occupy(
    area: ObjectStorageArea,
    location: ObjectStorageLocation,
) -> ObjectStorageArea
    effect [compute]
{
    let p_idx: u64 = location.partition as u64;
    let o_idx: u64 = location.partition_index as u64;
    let mut new_area: ObjectStorageArea = area;
    new_area.partitions[p_idx].objects[o_idx] = location;
    new_area.partitions[p_idx].objects[o_idx].occupied = true;
    new_area.partitions[p_idx].occupied_count = new_area.partitions[p_idx].occupied_count + 1;
    new_area.total_objects = new_area.total_objects + 1;
    return new_area;
}

/// Mark an object storage location for GC.
fn object_storage_mark_gc(
    area: ObjectStorageArea,
    key: StoreKey,
) -> ObjectStorageArea
    effect [compute, residual]
{
    let partition: u8 = store_key_partition(key);
    let p: ObjectPartition = area.partitions[partition as u64];

    for i in 0..64 {
        if p.objects[i].occupied && store_key_equal(p.objects[i].key, key) {
            let mut new_area: ObjectStorageArea = area;
            new_area.partitions[partition as u64].objects[i].marked_for_gc = true;
            new_area.partitions[partition as u64].gc_marked_count =
                new_area.partitions[partition as u64].gc_marked_count + 1;
            new_area.total_gc_marked = new_area.total_gc_marked + 1;
            return new_area;
        }
    }
    return area;
}

// ============================================================================
// Lock File Management
// ============================================================================

/// Lock state for the store.
type LockState = enum {
    /// Store is unlocked
    Unlocked = 0,
    /// Store is locked for exclusive access
    Locked = 1,
    /// Lock is stale (holder crashed)
    Stale = 2,
    /// Lock is reserved for migration
    Reserved = 3,
}

/// Lock file contents.
struct StoreLock
    layout packed
{
    state: LockState,
    holder_identity: Identity,
    acquired_at: u64,
    expires_at: u64,
    operation: Array[u8, 64],
    operation_len: u32,
    generation: u64,
}

/// Create a store lock.
fn store_lock_create(
    holder: Identity,
    timestamp: u64,
    ttl_seconds: u64,
    operation: Array[u8, 64],
    operation_len: u32,
    gen: u64,
) -> StoreLock
    effect [compute]
{
    return StoreLock {
        state: LockState::Locked,
        holder_identity: holder,
        acquired_at: timestamp,
        expires_at: timestamp + ttl_seconds,
        operation: operation,
        operation_len: operation_len,
        generation: gen,
    };
}

/// Check if a lock is valid (not expired, not stale).
fn store_lock_is_valid(lock: StoreLock, current_time: u64) -> bool
    effect [compute]
{
    if lock.state != LockState::Locked {
        return false;
    }
    if current_time > lock.expires_at {
        return false;
    }
    return true;
}

/// Release a store lock.
fn store_lock_release(lock: StoreLock) -> StoreLock
    effect [compute, residual]
{
    residual emit {
        op: "store_lock.release",
        holder_fp: lock.holder_identity.key_fingerprint.bytes[0] as u64,
        generation: lock.generation,
    };

    return StoreLock {
        state: LockState::Unlocked,
        holder_identity: lock.holder_identity,
        acquired_at: lock.acquired_at,
        expires_at: lock.expires_at,
        operation: lock.operation,
        operation_len: lock.operation_len,
        generation: lock.generation,
    };
}

// ============================================================================
// Store Layout Validation Rules
// ============================================================================

/// A collection of layout validation rules.
struct LayoutValidationRules
    layout packed
{
    /// Maximum path length
    max_path_length: u32,
    /// Maximum filename length
    max_filename_length: u32,
    /// Required subdirectories
    require_objects_dir: bool,
    require_generations_dir: bool,
    require_profiles_dir: bool,
    require_residuals_dir: bool,
    /// Whether to validate paths on initialization
    validate_on_init: bool,
    /// Whether to create missing directories automatically
    auto_create_dirs: bool,
}

/// Create default layout validation rules.
fn layout_validation_rules_default() -> LayoutValidationRules
    effect [compute]
{
    return LayoutValidationRules {
        max_path_length: 512,
        max_filename_length: 256,
        require_objects_dir: true,
        require_generations_dir: true,
        require_profiles_dir: true,
        require_residuals_dir: true,
        validate_on_init: true,
        auto_create_dirs: true,
    };
}

/// Validate a LayoutPath against the validation rules.
fn layout_path_validate(
    path: LayoutPath,
    rules: LayoutValidationRules,
) -> bool
    effect [compute]
{
    if path.len == 0 {
        return false;
    }
    if path.len > rules.max_path_length {
        return false;
    }
    // Check for null bytes in the middle of the path
    for i in 0..path.len as u64 {
        if path.bytes[i] == 0 {
            return false;
        }
    }
    return true;
}

// ============================================================================
// Store Layout Migration
// ============================================================================

/// Descriptor for a layout migration from one version to another.
struct LayoutMigration
    layout packed
{
    /// Source format version
    from_version: u32,
    /// Target format version
    to_version: u32,
    /// Migration description
    description: Array[u8, 256],
    description_len: u32,
    /// Whether this migration is backwards-compatible
    backwards_compatible: bool,
    /// Migration timestamp
    migrated_at: u64,
}

/// Create a layout migration descriptor.
fn layout_migration_create(
    from_version: u32,
    to_version: u32,
    description: Array[u8, 256],
    description_len: u32,
    backwards_compatible: bool,
    timestamp: u64,
) -> LayoutMigration
    effect [compute, residual]
{
    residual emit {
        op: "layout.migration.create",
        from: from_version,
        to: to_version,
    };

    return LayoutMigration {
        from_version: from_version,
        to_version: to_version,
        description: description,
        description_len: description_len,
        backwards_compatible: backwards_compatible,
        migrated_at: timestamp,
    };
}

// ============================================================================
// Object Storage Area — Partition Statistics
// ============================================================================

/// Statistics for a single object partition.
struct PartitionStats
    layout packed
{
    /// Partition index
    index: u8,
    /// Hex prefix
    prefix: Array[u8, 2],
    /// Occupied slots
    occupied: u32,
    /// GC-marked slots
    gc_marked: u32,
    /// Free slots
    free: u32,
    /// Utilization percentage
    utilization_percent: u32,
}

/// Get statistics for a specific partition.
fn partition_stats(area: ObjectStorageArea, partition_index: u8) -> PartitionStats
    effect [compute]
{
    let p: ObjectPartition = area.partitions[partition_index as u64];
    let free: u32 = 64 - p.occupied_count;
    let util: u32 = 0;
    if 64 > 0 {
        util = (p.occupied_count * 100) / 64;
    }
    return PartitionStats {
        index: p.index,
        prefix: p.prefix,
        occupied: p.occupied_count,
        gc_marked: p.gc_marked_count,
        free: free,
        utilization_percent: util,
    };
}

/// Get overall object storage area statistics.
fn object_storage_area_stats(area: ObjectStorageArea) -> ObjectStorageAreaStats
    effect [compute]
{
    let mut total_occupied: u32 = 0;
    let mut total_gc: u32 = 0;
    let mut min_util: u32 = 100;
    let mut max_util: u32 = 0;

    for i in 0..256 {
        let p: ObjectPartition = area.partitions[i];
        total_occupied = total_occupied + p.occupied_count;
        total_gc = total_gc + p.gc_marked_count;
        let util: u32 = (p.occupied_count * 100) / 64;
        if util < min_util { min_util = util; }
        if util > max_util { max_util = util; }
    }

    return ObjectStorageAreaStats {
        total_partitions: 256,
        total_objects: total_occupied,
        total_gc_marked: total_gc,
        min_utilization: min_util,
        max_utilization: max_util,
        avg_utilization: (total_occupied * 100) / (256 * 64),
    };
}

/// Object storage area statistics.
struct ObjectStorageAreaStats
    layout packed
{
    total_partitions: u32,
    total_objects: u32,
    total_gc_marked: u32,
    min_utilization: u32,
    max_utilization: u32,
    avg_utilization: u32,
}
