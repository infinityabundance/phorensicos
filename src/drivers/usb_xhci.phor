// usb_xhci.phor — USB xHCI driver
// Extended capabilities, primary interrupters, roothub emulation,
// endpoint context management, transfer request blocks (TRB) - all types,
// isochronous transfers, LPM (link power management), USB 3.0 specific features.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/usb_xhci.phor
// Court: usb_xhci_driver:v2

package drivers.usb_xhci;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type XhciError = enum {
    XhciNotInitialized            = 0xA00,
    XhciHcNotFound                = 0xA01,
    XhciHcNotOperational          = 0xA02,
    XhciDeviceNotFound            = 0xA03,
    XhciEnumerationFailed         = 0xA04,
    XhciTransferFailed            = 0xA05,
    XhciTransferTimeout           = 0xA06,
    XhciInvalidDescriptor         = 0xA07,
    XhciCapabilityError           = 0xA08,
    XhciTrbFull                   = 0xA09,
    XhciIsochBufferError          = 0xA0A,
    XhciStallError                = 0xA0B,
    XhciBabbleError               = 0xA0C,
    XhciPortNotEnabled            = 0xA0D,
    XhciPortResetFailed           = 0xA0E,
    XhciEndpointError             = 0xA0F,
    XhciContextError              = 0xA10,
    XhciMaxDevicesExceeded        = 0xA11,
    XhciInterrupterError          = 0xA12,
    XhciLpmError                  = 0xA13,
    XhciExtCapNotFound            = 0xA14,
    XhciRoothubPowerError         = 0xA15,
    XhciBandwidthError            = 0xA16,
    XhciMttError                  = 0xA17,
    XhciUsb3SpecificError         = 0xA18,
    XhciResidualStoreFull         = 0xA19,
    XhciDbpOverflow               = 0xA1A,
    XhciInvalidTrbType            = 0xA1B,
    XhciXferNotReady              = 0xA1C,
    XhciSlotStateError            = 0xA1D,
}

// ─────────────────────────────────────────────────────────────
// xHCI Full Capability
// ─────────────────────────────────────────────────────────────

struct XhciFullCapability {
    object_id: Identity,
    generation: u64,
    can_control: bool,
    can_bulk: bool,
    can_isochronous: bool,
    can_interrupt: bool,
    can_manage_port: bool,
    can_lpm: bool,
    can_ext_cap: bool,
    can_dbc: bool,
    max_slots: u64,
    max_endpoints: u64,
}

// ─────────────────────────────────────────────────────────────
// xHCI Register Base Offsets
// ─────────────────────────────────────────────────────────────

struct XhciRegisters {
    mmio_base: u64,
}

impl XhciRegisters {
    fn caplength_offset() -> u64 { return 0x00; }
    fn hciversion_offset() -> u64 { return 0x02; }
    fn hcsparams1_offset() -> u64 { return 0x04; }
    fn hcsparams2_offset() -> u64 { return 0x08; }
    fn hcsparams3_offset() -> u64 { return 0x0C; }
    fn hccparams1_offset() -> u64 { return 0x10; }
    fn dboff_offset() -> u64 { return 0x14; }
    fn rtsoff_offset() -> u64 { return 0x18; }
    fn hccparams2_offset() -> u64 { return 0x1C; }
    fn usbcmd_offset() -> u64 { return 0x20; }
    fn usbsts_offset() -> u64 { return 0x24; }
    fn pagesize_offset() -> u64 { return 0x28; }
    fn dnctrl_offset() -> u64 { return 0x34; }
    fn crcr_offset() -> u64 { return 0x38; }
    fn dcbaap_offset() -> u64 { return 0x50; }
    fn config_offset() -> u64 { return 0x58; }
    fn port_regs_offset(port: u8) -> u64 { return 0x400 + (port as u64) * 0x10; }
    fn portsc_offset(port: u8) -> u64 { return 0x400 + (port as u64) * 0x10; }
    fn portpmsc_offset(port: u8) -> u64 { return 0x400 + (port as u64) * 0x10 + 0x04; }
    fn portli_offset(port: u8) -> u64 { return 0x400 + (port as u64) * 0x10 + 0x08; }
    fn porthlpmc_offset(port: u8) -> u64 { return 0x400 + (port as u64) * 0x10 + 0x0C; }

    fn read32(self, offset: u64) -> u32
        effect [memory:mmio]
    {
        return trusted reason "xHCI MMIO read, xHCI Spec §3.2" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            return *ptr;
        };
    }

    fn read64(self, offset: u64) -> u64
        effect [memory:mmio]
    {
        return trusted reason "xHCI MMIO 64-bit read" {
            let ptr: *(u64) = (self.mmio_base + offset) as *(u64);
            return *ptr;
        };
    }

    fn write32(self, offset: u64, value: u32) -> void
        effect [memory:mmio]
    {
        trusted reason "xHCI MMIO write, xHCI Spec §3.2" {
            let ptr: *(u32) = (self.mmio_base + offset) as *(u32);
            *ptr = value;
        };
    }

    fn write64(self, offset: u64, value: u64) -> void
        effect [memory:mmio]
    {
        trusted reason "xHCI MMIO 64-bit write" {
            let ptr: *(u64) = (self.mmio_base + offset) as *(u64);
            *ptr = value;
        };
    }
}

// ─────────────────────────────────────────────────────────────
// HCSPARAMS1 Fields
// ─────────────────────────────────────────────────────────────

struct XhciHcsParams1 {
    max_slots: u8,
    max_intrs: u16,
    max_ports: u8,
}

fn xhci_parse_hcsparams1(reg: u32) -> XhciHcsParams1
    effect [deterministic]
{
    return XhciHcsParams1 {
        max_slots: (reg & 0xFF) as u8,
        max_intrs: ((reg >> 8) & 0x7FF) as u16,
        max_ports: ((reg >> 24) & 0xFF) as u8,
    };
}

// ─────────────────────────────────────────────────────────────
// HCCPARAMS1 Fields
// ─────────────────────────────────────────────────────────────

struct XhciHccParams1 {
    ac64: bool,
    pne: bool,
    csc: bool,
    ppc: bool,
    pind: bool,
    lhrc: bool,
    ltc: bool,
    nss: bool,
    pae: bool,
    spc: bool,
    sec: bool,
    cfc: bool,
    max_psa_size: u8,
    ext_cap_ptr: u16,
}

fn xhci_parse_hccparams1(reg: u32) -> XhciHccParams1
    effect [deterministic]
{
    return XhciHccParams1 {
        ac64: (reg & 0x01) != 0,
        pne: ((reg >> 1) & 0x01) != 0,
        csc: ((reg >> 2) & 0x01) != 0,
        ppc: ((reg >> 3) & 0x01) != 0,
        pind: ((reg >> 4) & 0x01) != 0,
        lhrc: ((reg >> 5) & 0x01) != 0,
        ltc: ((reg >> 6) & 0x01) != 0,
        nss: ((reg >> 7) & 0x01) != 0,
        pae: ((reg >> 8) & 0x01) != 0,
        spc: ((reg >> 9) & 0x01) != 0,
        sec: ((reg >> 10) & 0x01) != 0,
        cfc: ((reg >> 11) & 0x01) != 0,
        max_psa_size: ((reg >> 12) & 0x0F) as u8,
        ext_cap_ptr: ((reg >> 16) & 0xFFFF) as u16,
    };
}

// ─────────────────────────────────────────────────────────────
// Extended Capability Entry
// ─────────────────────────────────────────────────────────────

struct XhciExtCapEntry {
    cap_id: u8,
    next_off: u8,
    data: Array(u32, 8),
}

type XhciExtCapId = enum {
    Reserved         = 0x00,
    UsbLegacySupport = 0x01,
    SupportedProtocol = 0x02,
    ExtendedPowerManagement = 0x03,
    IoVirtualization = 0x04,
    DebugCapability  = 0x0A,
    ExtendedCapabilitySignaling = 0x1C,
}

// ─────────────────────────────────────────────────────────────
// Supported Protocol Capability (USB 3.0 / 2.0)
// ─────────────────────────────────────────────────────────────

struct XhciSupportedProtocol {
    cap_id: u8,
    next_off: u8,
    revision_minor: u8,
    revision_major: u8,
    name_string: [u8; 4],
    port_offset: u8,
    port_count: u8,
    protocol_speed_id_count: u8,
    protocol_speed_id: u8,
}

// ─────────────────────────────────────────────────────────────
// Primary Interrupter
// ─────────────────────────────────────────────────────────────

struct XhciInterrupter {
    iman: u32,
