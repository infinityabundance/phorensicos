// jit_port_strlen.phor — fourth JIT-Porting Court target (native candidate)
//
// Clean-room native port of libc `strlen` at the NUL-termination boundary. The
// observable is the **length** of the C string: the index of the first NUL byte.
// `strlen` takes no length argument, so the ABI carries `n` only as a
// *precondition bound*: the terminator lies within the first `n` bytes, which is
// what makes the buffer packable into one word and keeps the foreign observation
// from reading past the caller's window. A case whose terminator falls outside
// the bound is out of contract; the candidate fails closed by returning `n`.
//
// This file is the *candidate source* bound into the sealed package
// (phost/evidence/porting/strlen/sealed_package.json: candidate_source_hash).
//
// The buffer is modelled as up to 8 bytes packed LITTLE-ENDIAN into a u64 (byte
// i occupies bits 8*i, i.e. the machine word you get by loading the buffer on
// x86-64); the deterministic corpus never scans more than 8 bytes and always
// places the terminator inside the bound.
//
// ABI — the executed entry point (see phost::porting::exec):
//   symbol `_phor_phor_strlen_len`; SysV AMD64 (RDI, RSI) -> RAX, i.e.
//   `phor_strlen_len(w: u64, n: u64) -> u64`.
//   The result is the u64 length (index of the first NUL byte, little-endian on
//   the wire). The function is a leaf: no calls, no relocations, no heap, no
//   syscalls.
//
// The lowerer emits a single basic block (no branches), so the scan is written
// branchlessly: iterate the indices from the highest down, and let the last
// assignment win — that yields the *smallest* zero byte, i.e. the first NUL.
// `hit` is 1 only when the byte is zero AND its index is within the scan bound.
//
// Scope: API-surface JIT-porting. NOT arbitrary binary translation. The cage
// observes the foreign implementation; it does not copy it.
//
// Trust ladder: unknown(0) → observed(1) → replayed(2) → oracle-compared(3)
//               → residual-stable(4) → sealed(5)

package "phorensic:jit_port_strlen:v1.0";

// ── Domain constants ─────────────────────────────────────

const WIDTH: u64 = 8;       // bytes packed per buffer word
const BYTE_MASK: u64 = 255; // one byte per lane
const NUL: u64 = 0;         // the C string terminator byte

// ── Target and evidence records ──────────────────────────
// These mirror the residuals the court seals for this target.

struct PortTarget {
    dialect_name: Str(16),
    symbol: Str(32),
    version: Str(32),
    input_schema: Str(64),
    output_schema: Str(64),
}

struct ReplayVerdict {
    target: Str(32),
    cases_run: u64,
    cases_passed: u64,
    cases_failed: u64,
    verdict: u8,
}

struct SealedPackage {
    target: Str(32),
    dialect_name: Str(16),
    trust_level: u8,
    case_count: u64,
    oracle_hash: Str(64),
    candidate_hash: Str(64),
}

// ── Native clean-room candidate ──────────────────────────
//
// Branchless and leaf. Byte i of the little-endian word is `(w >> (8*i)) & 255`.
// Scanning i = 7 → 0 and overwriting on a hit leaves the smallest matching index,
// i.e. the first NUL. `idx - hit * (idx - i)` is a branchless select: unchanged
// when hit is 0, exactly `i` when hit is 1. Starting from `idx = n` makes an
// in-bound miss fail closed at `n` instead of reading on.

fn phor_strlen_len(w: u64, n: u64) -> u64
    effect [compute]
{
    let mut idx: u64 = n;

    let b7: u64 = (w >> 56) & BYTE_MASK;
    let hit7: u64 = ((b7 == NUL) as u64) * ((n > 7) as u64);
    idx = idx - hit7 * (idx - 7);

    let b6: u64 = (w >> 48) & BYTE_MASK;
    let hit6: u64 = ((b6 == NUL) as u64) * ((n > 6) as u64);
    idx = idx - hit6 * (idx - 6);

    let b5: u64 = (w >> 40) & BYTE_MASK;
    let hit5: u64 = ((b5 == NUL) as u64) * ((n > 5) as u64);
    idx = idx - hit5 * (idx - 5);

    let b4: u64 = (w >> 32) & BYTE_MASK;
    let hit4: u64 = ((b4 == NUL) as u64) * ((n > 4) as u64);
    idx = idx - hit4 * (idx - 4);

    let b3: u64 = (w >> 24) & BYTE_MASK;
    let hit3: u64 = ((b3 == NUL) as u64) * ((n > 3) as u64);
    idx = idx - hit3 * (idx - 3);

    let b2: u64 = (w >> 16) & BYTE_MASK;
    let hit2: u64 = ((b2 == NUL) as u64) * ((n > 2) as u64);
    idx = idx - hit2 * (idx - 2);

    let b1: u64 = (w >> 8) & BYTE_MASK;
    let hit1: u64 = ((b1 == NUL) as u64) * ((n > 1) as u64);
    idx = idx - hit1 * (idx - 1);

    let b0: u64 = w & BYTE_MASK;
    let hit0: u64 = ((b0 == NUL) as u64) * ((n > 0) as u64);
    idx = idx - hit0 * (idx - 0);

    return idx;
}
