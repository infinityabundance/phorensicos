// file: serialization.phor
// purpose: Deterministic binary serialization and deserialization for all
//          core types. Uses a stable binary format with type tags, length
//          prefixing, and checksum verification. All operations use bounded
//          loops and fixed-capacity buffers.
// evidence: SER-ARCH-001 through SER-ARCH-180
// residual: Serialization is fully deterministic; same input always produces
//           same output (assuming same format version).

use core::constants::*
use core::types::*
use core::errors::*
use core::math::*
use core::collections::*
use core::handles::*
use core::capabilities::*
use core::effects::*

// ──────────────────────────────────────────────
// Serialization Buffer
// ──────────────────────────────────────────────
// A fixed-capacity buffer for serialization operations.
// Evidence path: SER-BUF-001 through SER-BUF-045

pub type SerializeBuffer[N: static] : struct {
    data: Byte[N],
    position: u32,
}

impl[N] SerializeBuffer[N] {
    // Create a new empty serialization buffer.
    pub fn new() -> SerializeBuffer[N]
        effects: [deterministic]
    {
        SerializeBuffer {
            data: [Byte::from_u8(0); N],
            position: 0,
        }
    }

    // Get the current write position.
    pub fn position(self) -> u32
        effects: [deterministic]
    {
        self.position
    }

    // Get the remaining capacity.
    pub fn remaining(self) -> u32
        effects: [deterministic]
    {
        N - self.position
    }

    // Get the total capacity.
    pub fn capacity(self) -> u32
        effects: [deterministic]
    {
        N
    }

    // Check if the buffer is full.
    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.position >= N
    }

    // Get a slice of written data.
    pub fn as_slice(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let mut slice: Byte[Slice] = Byte[Slice]::new(self.position)
        // loop: bounds[BOUND_SERIAL] — bounded by position
        loop: bounds[BOUND_SERIAL] for i in 0..self.position {
            slice[i] = self.data[i as usize]
        }
        slice
    }

    // Reset the buffer.
    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.position = 0
    }

    // Write a single byte.
    pub fn write_byte(self: ref mut, value: Byte) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        if self.position >= N {
            return Result::Err(ser_buffer_overflow())
        }
        self.data[self.position as usize] = value
        self.position = self.position + 1
        Result::Ok(())
    }

    // Write a byte array.
    // loop: bounds[BOUND_SERIAL] — bounded by count.
    pub fn write_bytes(self: ref mut, bytes: Byte[], count: u32) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        if (self.position + count) > N {
            return Result::Err(ser_buffer_overflow())
        }
        // loop: bounds[BOUND_SERIAL] — bounded by count
        loop: bounds[BOUND_SERIAL] for i in 0..count {
            self.data[(self.position + i) as usize] = bytes[i as usize]
        }
        self.position = self.position + count
        Result::Ok(())
    }

    // Write a tag byte.
    pub fn write_tag(self: ref mut, tag: u8) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_byte(Byte::from_u8(tag))
    }

    // Write a u8 value.
    pub fn write_u8(self: ref mut, value: u8) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_BYTE)?;
        self.write_byte(Byte::from_u8(value))
    }

    // Write a u16 value in little-endian.
    pub fn write_u16(self: ref mut, value: u16) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_WORD16)?;
        let bytes: [u8; 2] = __builtin_u16_to_le_bytes(value)
        self.write_byte(Byte::from_u8(bytes[0]))?;
        self.write_byte(Byte::from_u8(bytes[1]))
    }

    // Write a u32 value in little-endian.
    pub fn write_u32(self: ref mut, value: u32) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_WORD32)?;
        let bytes: [u8; 4] = __builtin_u32_to_le_bytes(value)
        // loop: bounds[BOUND_TINY] — exactly 4 iterations
        loop: bounds[BOUND_TINY] for i in 0..4 {
            self.write_byte(Byte::from_u8(bytes[i as usize]))?
        }
        Result::Ok(())
    }

    // Write a u64 value in little-endian.
    pub fn write_u64(self: ref mut, value: u64) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_WORD64)?;
        let bytes: [u8; 8] = __builtin_u64_to_le_bytes(value)
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            self.write_byte(Byte::from_u8(bytes[i as usize]))?
        }
        Result::Ok(())
    }

    // Write a Word64 value.
    pub fn write_word64(self: ref mut, value: Word64) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_u64(value.to_u64())
    }

    // Write a Byte value.
    pub fn write_byte_val(self: ref mut, value: Byte) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_u8(value.to_u8())
    }

    // Write a Size value.
    pub fn write_size(self: ref mut, value: Size) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_word64(Word64::from_u64(value.as_word64().to_u64()))
    }

    // Write an Offset value.
    pub fn write_offset(self: ref mut, value: Offset) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_word64(value.as_word64())
    }

    // Write a Timestamp value.
    pub fn write_timestamp(self: ref mut, value: Timestamp) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_word64(value.as_word64())
    }

    // Write a Duration value.
    pub fn write_duration(self: ref mut, value: Duration) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_word64(value.as_nanos())
    }

    // Write an Identity value.
    pub fn write_identity(self: ref mut, value: Identity) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_IDENTITY)?;
        self.write_u64(value.as_word64().to_u64())
    }

    // Write a Hash256 value.
    pub fn write_hash256(self: ref mut, value: Hash256) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_HASH256)?;
        let bytes: [Byte; 32] = value.as_bytes()
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            self.write_byte(bytes[i as usize])?
        }
        Result::Ok(())
    }

    // Write a Signature64 value.
    pub fn write_signature64(self: ref mut, value: Signature64) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        let bytes: [Byte; 64] = value.as_bytes()
        // loop: bounds[BOUND_SMALL] — exactly 64 iterations
        loop: bounds[BOUND_SMALL] for i in 0..64 {
            self.write_byte(bytes[i as usize])?
        }
        Result::Ok(())
    }

    // Write a bool value.
    pub fn write_bool(self: ref mut, value: bool) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_BOOL)?;
        if value {
            self.write_byte(Byte::from_u8(1))
        } else {
            self.write_byte(Byte::from_u8(0))
        }
    }

    // Write a TrustLevel.
    pub fn write_trust_level(self: ref mut, value: TrustLevel) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_TRUST_LEVEL)?;
        self.write_byte(Byte::from_u8(value as u8))
    }

    // Write a TrustState.
    pub fn write_trust_state(self: ref mut, value: TrustState) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_TRUST_STATE)?;
        self.write_byte(Byte::from_u8(value as u8))
    }

    // Write a GenerationTag.
    pub fn write_generation_tag(self: ref mut, value: GenerationTag) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_GENERATION)?;
        self.write_u32(value.value())
    }

    // Write an Option[T] (with a serialization function for T).
    pub fn write_option[T](
        self: ref mut,
        value: Option[T],
        write_t: fn(ref mut SerializeBuffer[N], T) -> Result[(), SerializationError>,
    ) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        match value {
            Option::Some(val) => {
                self.write_tag(TAG_OPTION_SOME)?;
                write_t(self, val)
            },
            Option::None => {
                self.write_tag(TAG_OPTION_NONE)
            },
        }
    }

    // Write a Result[T, E] (with serialization functions).
    pub fn write_result[T, E](
        self: ref mut,
        value: Result[T, E],
        write_t: fn(ref mut SerializeBuffer[N], T) -> Result[(), SerializationError>,
        write_e: fn(ref mut SerializeBuffer[N], E) -> Result[(), SerializationError>,
    ) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        match value {
            Result::Ok(val) => {
                self.write_tag(TAG_RESULT_OK)?;
                write_t(self, val)
            },
            Result::Err(err) => {
                self.write_tag(TAG_RESULT_ERR)?;
                write_e(self, err)
            },
        }
    }

    // Write a FixedArray elements directly (no length prefix).
    // loop: bounds[BOUND_MEDIUM] — bounded by N.
    pub fn write_fixed_array[T](
        self: ref mut,
        array: ref FixedArray[KnownN, T],
        write_element: fn(ref mut SerializeBuffer[N], ref T) -> Result[(), SerializationError>,
    ) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        let len: u32 = array.len()
        // loop: bounds[BOUND_MEDIUM] — bounded by len
        loop: bounds[BOUND_MEDIUM] for i in 0..len {
            write_element(self, &array.get(i).unwrap())?
        }
        Result::Ok(())
    }

    // Write an array tag + length prefix + array contents.
    pub fn write_array_tagged[T](
        self: ref mut,
        array: ref FixedArray[KnownN, T],
        write_element: fn(ref mut SerializeBuffer[N], ref T) -> Result[(), SerializationError>,
    ) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_ARRAY)?;
        self.write_u32(array.len())?;
        self.write_fixed_array(array, write_element)
    }

    // Write a FixedMap.
    pub fn write_fixed_map[K, V](
        self: ref mut,
        map: ref FixedMap[KnownN, K, V],
        write_key: fn(ref mut SerializeBuffer[N], K) -> Result[(), SerializationError>,
        write_val: fn(ref mut SerializeBuffer[N], V) -> Result[(), SerializationError>,
    ) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_MAP)?;
        self.write_u32(map.count())?;
        map.for_each(|key: K, value: V| {
            write_key(self, key)?;
            write_val(self, value)
        })
    }

    // Write a FixedSet.
    pub fn write_fixed_set[T](
        self: ref mut,
        set: ref FixedSet[KnownN, T],
        write_element: fn(ref mut SerializeBuffer[N], T) -> Result[(), SerializationError>,
    ) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_SET)?;
        self.write_u32(set.count())?;
        set.for_each(|value: T| {
            write_element(self, value)
        })
    }

    // Write a Handle.
    pub fn write_handle(self: ref mut, handle: Handle) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_HANDLE)?;
        self.write_u32(handle.index())?;
        self.write_generation_tag(handle.generation())?;
        self.write_identity(handle.owner())?;
        self.write_bool(handle.is_active())
    }

    // Write a RightsSet.
    pub fn write_rights_set(self: ref mut, rights: RightsSet) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_RIGHTS_SET)?;
        self.write_word64(rights.mask())
    }

    // Write an EffectSet.
    pub fn write_effect_set(self: ref mut, effects: EffectSet) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_EFFECT_SET)?;
        self.write_word64(effects.mask())
    }

    // Write a Capability.
    pub fn write_capability(self: ref mut, cap: Capability) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_CAPABILITY)?;
        self.write_rights_set(cap.rights())?;
        self.write_identity(cap.target())?;
        self.write_identity(cap.issuer())?;
        self.write_u32(cap.generation().value())?;
        self.write_trust_level(cap.trust_required())
    }

    // Write an Error (uses the Error trait's message + code).
    pub fn write_error(self: ref mut, error: ref Error) -> Result[(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_tag(TAG_ERROR)?;
        self.write_word64(error.code())?;
        let msg: FixedString[128] = error.message()
        self.write_u32(msg.len())?;
        // loop: bounds[BOUND_SMALL] — bounded by message length
        loop: bounds[BOUND_SMALL] for i in 0..msg.len() {
            self.write_byte(msg.byte_at(i))?
        }
        Result::Ok(())
    }

    // Compute and write a CRC32 checksum of all written data.
    pub fn write_checksum(self: ref mut) -> Result[(), SerializationError>
        effects: [deterministic, serialize, hash]
    {
        let checksum: u32 = __builtin_crc32(self.data, self.position)
        self.write_u32(checksum)
    }

    // Write the format version header.
    pub fn write_header(self: ref mut) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.write_byte(Byte::from_u8(SERIALIZATION_VERSION))?;
        // Magic word prefix (first 4 bytes of PHOR_MAGIC_WORD)
        self.write_u32(0x50484F52)  // "PHOR" in ASCII
    }

    // Finalize serialization (write checksum at end).
    pub fn finalize(self: ref mut) -> Result<u32, SerializationError>
        effects: [deterministic, serialize, hash]
    {
        let pos: u32 = self.position
        self.write_checksum()?;
        Result::Ok(pos)  // Return content size without checksum
    }
}

// ──────────────────────────────────────────────
// Deserialization Buffer
// ──────────────────────────────────────────────
// A fixed-capacity buffer for deserialization operations.
// Evidence path: SER-DESER-001 through SER-DESER-050

pub type DeserializeBuffer[N: static] : struct {
    data: Byte[N],
    position: u32,
    length: u32,
}

impl[N] DeserializeBuffer[N] {
    // Create a new deserialization buffer from raw data.
    pub fn new(data: Byte[N], length: u32) -> DeserializeBuffer[N]
        effects: [deterministic]
    {
        DeserializeBuffer {
            data: data,
            position: 0,
            length: length,
        }
    }

    // Get the current read position.
    pub fn position(self) -> u32
        effects: [deterministic]
    {
        self.position
    }

    // Get the remaining bytes to read.
    pub fn remaining(self) -> u32
        effects: [deterministic]
    {
        self.length - self.position
    }

    // Get the total length.
    pub fn total_length(self) -> u32
        effects: [deterministic]
    {
        self.length
    }

    // Check if we've consumed all data.
    pub fn is_exhausted(self) -> bool
        effects: [deterministic]
    {
        self.position >= self.length
    }

    // Read a single byte.
    pub fn read_byte(self: ref mut) -> Result[Byte, SerializationError>
        effects: [deterministic, deserialize]
    {
        if self.position >= self.length {
            return Result::Err(ser_buffer_underflow())
        }
        let value: Byte = self.data[self.position as usize]
        self.position = self.position + 1
        Result::Ok(value)
    }

    // Read a tag byte and verify it matches expected.
    pub fn expect_tag(self: ref mut, expected: u8) -> Result<(), SerializationError>
        effects: [deterministic, deserialize]
    {
        let tag_byte: Byte = self.read_byte()?
        let tag: u8 = tag_byte.to_u8()
        if tag != expected {
            return Result::Err(ser_unexpected_tag(expected, tag))
        }
        Result::Ok(())
    }

    // Read multiple bytes into a buffer.
    // loop: bounds[BOUND_SERIAL] — bounded by count.
    pub fn read_bytes(self: ref mut, buffer: ref mut Byte[], count: u32) -> Result<(), SerializationError>
        effects: [deterministic, deserialize]
    {
        if (self.position + count) > self.length {
            return Result::Err(ser_buffer_underflow())
        }
        // loop: bounds[BOUND_SERIAL] — bounded by count
        loop: bounds[BOUND_SERIAL] for i in 0..count {
            buffer[i as usize] = self.data[(self.position + i) as usize]
        }
        self.position = self.position + count
        Result::Ok(())
    }

    // Read a u8 value.
    pub fn read_u8(self: ref mut) -> Result[u8, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_BYTE)?;
        let b: Byte = self.read_byte()?
        Result::Ok(b.to_u8())
    }

    // Read a u16 value (little-endian).
    pub fn read_u16(self: ref mut) -> Result[u16, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_WORD16)?;
        let b0: u8 = self.read_byte()?.to_u8()
        let b1: u8 = self.read_byte()?.to_u8()
        let raw: [u8; 2] = [b0, b1]
        Result::Ok(__builtin_u16_from_le_bytes(raw))
    }

    // Read a u32 value (little-endian).
    pub fn read_u32(self: ref mut) -> Result[u32, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_WORD32)?;
        let mut raw: [u8; 4] = [0; 4]
        // loop: bounds[BOUND_TINY] — exactly 4 iterations
        loop: bounds[BOUND_TINY] for i in 0..4 {
            raw[i as usize] = self.read_byte()?.to_u8()
        }
        Result::Ok(__builtin_u32_from_le_bytes(raw))
    }

    // Read a u64 value (little-endian).
    pub fn read_u64(self: ref mut) -> Result[u64, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_WORD64)?;
        let mut raw: [u8; 8] = [0; 8]
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            raw[i as usize] = self.read_byte()?.to_u8()
        }
        Result::Ok(__builtin_u64_from_le_bytes(raw))
    }

    // Read a Word64 value.
    pub fn read_word64(self: ref mut) -> Result[Word64, SerializationError>
        effects: [deterministic, deserialize]
    {
        let val: u64 = self.read_u64()?
        Result::Ok(Word64::from_u64(val))
    }

    // Read a Byte value.
    pub fn read_byte_val(self: ref mut) -> Result[Byte, SerializationError>
        effects: [deterministic, deserialize]
    {
        let val: u8 = self.read_u8()?
        Result::Ok(Byte::from_u8(val))
    }

    // Read a Size value.
    pub fn read_size(self: ref mut) -> Result[Size, SerializationError>
        effects: [deterministic, deserialize]
    {
        let val: Word64 = self.read_word64()?
        Result::Ok(Size::from_u64(val.to_u64()))
    }

    // Read an Offset value.
    pub fn read_offset(self: ref mut) -> Result[Offset, SerializationError>
        effects: [deterministic, deserialize]
    {
        let val: Word64 = self.read_word64()?
        Result::Ok(Offset::from_u64(val.to_u64()))
    }

    // Read a Timestamp value.
    pub fn read_timestamp(self: ref mut) -> Result[Timestamp, SerializationError>
        effects: [deterministic, deserialize]
    {
        let val: Word64 = self.read_word64()?
        Result::Ok(Timestamp::from_u64(val.to_u64()))
    }

    // Read a Duration value.
    pub fn read_duration(self: ref mut) -> Result[Duration, SerializationError>
        effects: [deterministic, deserialize]
    {
        let val: Word64 = self.read_word64()?
        Result::Ok(Duration::from_nanos(val))
    }

    // Read an Identity value.
    pub fn read_identity(self: ref mut) -> Result[Identity, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_IDENTITY)?;
        let val: u64 = self.read_u64()?
        Result::Ok(Identity::new(Word64::from_u64(val)))
    }

    // Read a Hash256 value.
    pub fn read_hash256(self: ref mut) -> Result[Hash256, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_HASH256)?;
        let mut bytes: [Byte; 32] = [Byte::from_u8(0); 32]
        // loop: bounds[BOUND_TINY] — exactly 32 iterations
        loop: bounds[BOUND_TINY] for i in 0..32 {
            bytes[i as usize] = self.read_byte()?
        }
        Result::Ok(Hash256::from_bytes(bytes))
    }

    // Read a Signature64 value.
    pub fn read_signature64(self: ref mut) -> Result[Signature64, SerializationError>
        effects: [deterministic, deserialize]
    {
        let mut bytes: [Byte; 64] = [Byte::from_u8(0); 64]
        // loop: bounds[BOUND_SMALL] — exactly 64 iterations
        loop: bounds[BOUND_SMALL] for i in 0..64 {
            bytes[i as usize] = self.read_byte()?
        }
        Result::Ok(Signature64::from_bytes(bytes))
    }

    // Read a bool value.
    pub fn read_bool(self: ref mut) -> Result[bool, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_BOOL)?;
        let b: u8 = self.read_byte()?.to_u8()
        Result::Ok(b != 0)
    }

    // Read a TrustLevel.
    pub fn read_trust_level(self: ref mut) -> Result[TrustLevel, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_TRUST_LEVEL)?;
        let raw: u8 = self.read_byte()?.to_u8()
        // Convert u8 to TrustLevel with validation.
        match raw {
            0x00 => Result::Ok(TrustLevel::Trust_Untrusted),
            0x0F => Result::Ok(TrustLevel::Trust_Absolute),
            _ => Result::Ok(TrustLevel::Trust_Untrusted),  // Default fallback
        }
    }

    // Read a GenerationTag.
    pub fn read_generation_tag(self: ref mut) -> Result[GenerationTag, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_GENERATION)?;
        let val: u32 = self.read_u32()?
        Result::Ok(GenerationTag::new(val))
    }

    // Read an Option[T].
    pub fn read_option[T](
        self: ref mut,
        read_t: fn(ref mut DeserializeBuffer[N]) -> Result[T, SerializationError>,
    ) -> Result[Option[T], SerializationError>
        effects: [deterministic, deserialize]
    {
        let tag_byte: Byte = self.read_byte()?
        let tag: u8 = tag_byte.to_u8()
        match tag {
            TAG_OPTION_SOME => {
                let val: T = read_t(self)?
                Result::Ok(Option::Some(val))
            },
            TAG_OPTION_NONE => Result::Ok(Option::None),
            _ => Result::Err(ser_unexpected_tag(TAG_OPTION_SOME, tag)),
        }
    }

    // Read a Result[T, E].
    pub fn read_result[T, E](
        self: ref mut,
        read_t: fn(ref mut DeserializeBuffer[N]) -> Result[T, SerializationError>,
        read_e: fn(ref mut DeserializeBuffer[N]) -> Result[E, SerializationError>,
    ) -> Result[Result[T, E], SerializationError>
        effects: [deterministic, deserialize]
    {
        let tag_byte: Byte = self.read_byte()?
        let tag: u8 = tag_byte.to_u8()
        match tag {
            TAG_RESULT_OK => {
                let val: T = read_t(self)?
                Result::Ok(Result::Ok(val))
            },
            TAG_RESULT_ERR => {
                let err: E = read_e(self)?
                Result::Ok(Result::Err(err))
            },
            _ => Result::Err(ser_unexpected_tag(TAG_RESULT_OK, tag)),
        }
    }

    // Read a RightsSet.
    pub fn read_rights_set(self: ref mut) -> Result[RightsSet, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_RIGHTS_SET)?;
        let mask: Word64 = self.read_word64()?
        Result::Ok(RightsSet::from_mask(mask))
    }

    // Read an EffectSet.
    pub fn read_effect_set(self: ref mut) -> Result[EffectSet, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_EFFECT_SET)?;
        let mask: Word64 = self.read_word64()?
        Result::Ok(EffectSet::from_mask(mask))
    }

    // Read a Handle.
    pub fn read_handle(self: ref mut) -> Result[Handle, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_HANDLE)?;
        let idx: u32 = self.read_u32()?
        let gen: GenerationTag = self.read_generation_tag()?
        let owner: Identity = self.read_identity()?
        let active: bool = self.read_bool()?
        let handle: Handle = Handle::new(idx, gen, owner)
        if !active {
            handle.invalidate()
        }
        Result::Ok(handle)
    }

    // Read a Capability.
    pub fn read_capability(self: ref mut) -> Result[Capability, SerializationError>
        effects: [deterministic, deserialize]
    {
        self.expect_tag(TAG_CAPABILITY)?;
        let rights: RightsSet = self.read_rights_set()?
        let target: Identity = self.read_identity()?
        let issuer: Identity = self.read_identity()?
        let generation: Word32 = self.read_u32()?
        let trust_level: TrustLevel = self.read_trust_level()?
        Result::Ok(Capability::new(rights, target, issuer, generation, trust_level))
    }

    // Verify the checksum at the end of the buffer.
    pub fn verify_checksum(self: ref mut) -> Result<bool, SerializationError>
        effects: [deterministic, deserialize, hash]
    {
        if self.remaining() < 4 {
            return Result::Err(ser_buffer_underflow())
        }
        let data_end: u32 = self.length - 4
        let stored_checksum: u32 = self.read_u32()?
        let computed: u32 = __builtin_crc32(self.data, data_end)
        Result::Ok(stored_checksum == computed)
    }

    // Read and verify the format version header.
    pub fn read_header(self: ref mut) -> Result<(), SerializationError>
        effects: [deterministic, deserialize]
    {
        let version: u8 = self.read_byte()?.to_u8()
        if version != SERIALIZATION_VERSION {
            return Result::Err(ser_version_mismatch(SERIALIZATION_VERSION, version))
        }
        // Read magic word (should be "PHOR")
        let mut magic: [u8; 4] = [0; 4]
        // loop: bounds[BOUND_TINY] — exactly 4 iterations
        loop: bounds[BOUND_TINY] for i in 0..4 {
            magic[i as usize] = self.read_byte()?.to_u8()
        }
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Convenience Serialization Functions
// ──────────────────────────────────────────────
// Evidence path: SER-CONV-001 through SER-CONV-025

// Serialize a single type implementing serialization.
pub fn serialize[T](
    value: T,
    buffer: ref mut SerializeBuffer[KnownN],
    write_fn: fn(ref mut SerializeBuffer[KnownN], T) -> Result[(), SerializationError>,
) -> Result<u32, SerializationError>
    effects: [deterministic, serialize, hash]
{
    buffer.reset()?;
    buffer.write_header()?;
    write_fn(buffer, value)?;
    buffer.finalize()
}

// Deserialize a single type implementing deserialization.
pub fn deserialize[T](
    buffer: ref mut DeserializeBuffer[KnownN],
    read_fn: fn(ref mut DeserializeBuffer[KnownN]) -> Result[T, SerializationError>,
) -> Result[T, SerializationError>
    effects: [deterministic, deserialize, hash]
{
    buffer.read_header()?;
    let value: T = read_fn(buffer)?;
    let checksum_ok: bool = buffer.verify_checksum()?
    if !checksum_ok {
        return Result::Err(ser_checksum_mismatch())
    }
    Result::Ok(value)
}

// Serialize a Word64.
pub fn serialize_word64(value: Word64, buffer: ref mut SerializeBuffer[KnownN]) -> Result<u32, SerializationError>
    effects: [deterministic, serialize, hash]
{
    serialize(value, buffer, |buf: ref mut SerializeBuffer[KnownN], v: Word64| {
        buf.write_word64(v)
    })
}

// Deserialize a Word64.
pub fn deserialize_word64(buffer: ref mut DeserializeBuffer[KnownN]) -> Result[Word64, SerializationError>
    effects: [deterministic, deserialize, hash]
{
    deserialize(buffer, |buf: ref mut DeserializeBuffer[KnownN]| {
        buf.read_word64()
    })
}

// Serialize a Hash256.
pub fn serialize_hash256(value: Hash256, buffer: ref mut SerializeBuffer[KnownN]) -> Result<u32, SerializationError>
    effects: [deterministic, serialize, hash]
{
    serialize(value, buffer, |buf: ref mut SerializeBuffer[KnownN], v: Hash256| {
        buf.write_hash256(v)
    })
}

// Deserialize a Hash256.
pub fn deserialize_hash256(buffer: ref mut DeserializeBuffer[KnownN]) -> Result[Hash256, SerializationError>
    effects: [deterministic, deserialize, hash]
{
    deserialize(buffer, |buf: ref mut DeserializeBuffer[KnownN]| {
        buf.read_hash256()
    })
}

// ──────────────────────────────────────────────
// Deterministic Byte Representation
// ──────────────────────────────────────────────
// Evidence path: SER-DET-001 through SER-DET-015

// Convert any serializable type to its deterministic byte representation.
pub fn to_bytes[T](
    value: T,
    write_fn: fn(ref mut SerializeBuffer[KnownN], T) -> Result[(), SerializationError>,
) -> Result[Byte[], SerializationError>
    effects: [deterministic, serialize, hash]
{
    let mut buf: SerializeBuffer[KnownN] = SerializeBuffer::new()
    let size: u32 = serialize(value, &mut buf, write_fn)?
    // Return a slice of the buffer contents.
    let result: Byte[] = Byte[]::new(size)
    // loop: bounds[BOUND_SERIAL] — bounded by size
    loop: bounds[BOUND_SERIAL] for i in 0..size {
        result[i as usize] = buf.data[i as usize]
    }
    Result::Ok(result)
}

// Convert bytes back to a type.
pub fn from_bytes[T](
    bytes: Byte[],
    length: u32,
    read_fn: fn(ref mut DeserializeBuffer[KnownN]) -> Result[T, SerializationError>,
) -> Result[T, SerializationError>
    effects: [deterministic, deserialize, hash]
{
    let mut buf: DeserializeBuffer[KnownN] = DeserializeBuffer::new(bytes, length)
    deserialize(&mut buf, read_fn)
}

// ──────────────────────────────────────────────
// Compound Serialization for Collections
// ──────────────────────────────────────────────
// Evidence path: SER-COMP-001 through SER-COMP-020

// Serialize a FixedArray of Hash256.
pub fn write_hash256_array(
    buf: ref mut SerializeBuffer[KnownN],
    array: ref FixedArray[KnownM, Hash256],
) -> Result<(), SerializationError>
    effects: [deterministic, serialize]
{
    buf.write_array_tagged(array, |b: ref mut SerializeBuffer[KnownN], h: ref Hash256| {
        b.write_hash256(h)
    })
}

// Deserialize a FixedArray of Hash256.
pub fn read_hash256_array(
    buf: ref mut DeserializeBuffer[KnownN],
) -> Result<FixedArray[KnownM, Hash256], SerializationError>
    effects: [deterministic, deserialize]
{
    buf.expect_tag(TAG_ARRAY)?;
    let count: u32 = buf.read_u32()?
    let mut result: FixedArray[KnownM, Hash256] = FixedArray::new()
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] for _ in 0..count {
        let hash: Hash256 = buf.read_hash256()?
        let _: Result[(), BoundsError> = result.push(hash)
    }
    Result::Ok(result)
}

// Serialize a FixedArray of Identity.
pub fn write_identity_array(
    buf: ref mut SerializeBuffer[KnownN],
    array: ref FixedArray[KnownM, Identity],
) -> Result<(), SerializationError>
    effects: [deterministic, serialize]
{
    buf.write_array_tagged(array, |b: ref mut SerializeBuffer[KnownN], id: ref Identity| {
        b.write_identity(id)
    })
}

// Deserialize a FixedArray of Identity.
pub fn read_identity_array(
    buf: ref mut DeserializeBuffer[KnownN],
) -> Result[FixedArray[KnownM, Identity], SerializationError>
    effects: [deterministic, deserialize]
{
    buf.expect_tag(TAG_ARRAY)?;
    let count: u32 = buf.read_u32()?
    let mut result: FixedArray[KnownM, Identity] = FixedArray::new()
    // loop: bounds[BOUND_MEDIUM] — bounded by count
    loop: bounds[BOUND_MEDIUM] for _ in 0..count {
        let id: Identity = buf.read_identity()?
        let _: Result[(), BoundsError> = result.push(id)
    }
    Result::Ok(result)
}

// Serialize a FixedMap with string keys.
pub fn write_string_map(
    buf: ref mut SerializeBuffer[KnownN],
    map: ref FixedMap[KnownM, FixedString[64], Word64],
) -> Result<(), SerializationError>
    effects: [deterministic, serialize]
{
    buf.write_fixed_map(map,
        |b: ref mut SerializeBuffer[KnownN], k: FixedString[64]| {
            b.write_u32(k.len())?;
            // loop: bounds[BOUND_SMALL] — bounded by string length
            loop: bounds[BOUND_SMALL] for i in 0..k.len() {
                b.write_byte(k.byte_at(i))?
            }
            Result::Ok(())
        },
        |b: ref mut SerializeBuffer[KnownN], v: Word64| {
            b.write_word64(v)
        },
    )
}

// ──────────────────────────────────────────────
// Serialization Format Validator
// ──────────────────────────────────────────────
// Validates that serialized data conforms to expected format.
// Evidence path: SER-VAL-001 through SER-VAL-020

pub type FormatValidator : struct {
    errors: FixedArray[SMALL, FixedString[128]],
}

impl FormatValidator {
    pub fn new() -> FormatValidator
        effects: [deterministic]
    {
        FormatValidator { errors: FixedArray::new() }
    }

    // Validate a serialized buffer's header.
    pub fn validate_header(self: ref mut, buffer: ref DeserializeBuffer[KnownN]) -> bool
        effects: [deterministic, deserialize]
    {
        // Check minimum length.
        if buffer.total_length() < 6 {
            let _: Result<(), BoundsError> = self.errors.push(
                FixedString[128]::from_slice("Buffer too short for header"))
            return false
        }
        true
    }

    // Validate that all tags in the buffer are known.
    // loop: bounds[BOUND_MEDIUM] — bounded by buffer length.
    pub fn validate_tags(self: ref mut, buffer: ref DeserializeBuffer[KnownN]) -> bool
        effects: [deterministic, deserialize]
    {
        let mut valid: bool = true
        // In production, this would walk the entire buffer and validate
        // each tag against the set of known tags.
        valid
    }

    // Get the list of validation errors.
    pub fn errors(self) -> FixedArray[SMALL, FixedString[128]]
        effects: [deterministic]
    {
        self.errors
    }

    // Check if validation passed.
    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.errors.is_empty()
    }
}

// ──────────────────────────────────────────────
// Deterministic Comparison of Serialized Forms
// ──────────────────────────────────────────────
// Evidence path: SER-CMP-001 through SER-CMP-010

// Compare two serialized byte sequences for equality.
pub fn serialized_eq(a: Byte[], a_len: u32, b: Byte[], b_len: u32) -> bool
    effects: [deterministic]
{
    if a_len != b_len {
        return false
    }
    let mut i: u32 = 0
    // loop: bounds[BOUND_COPY] — bounded by length
    loop: bounds[BOUND_COPY] while i < a_len {
        if a[i as usize].neq(b[i as usize]) {
            return false
        }
        i = i + 1
    }
    true
}

// Hash a serialized form deterministically.
pub fn hash_serialized(data: Byte[], length: u32) -> Hash256
    effects: [deterministic, hash]
{
    // In production: BLAKE3(data)
    // Placeholder: construct a hash from the first 32 bytes padded.
    let mut hash_bytes: [Byte; 32] = [Byte::from_u8(0); 32]
    let copy_len: u32 = if length < 32 { length } else { 32 }
    // loop: bounds[BOUND_TINY] — bounded by 32
    loop: bounds[BOUND_TINY] for i in 0..copy_len {
        hash_bytes[i as usize] = data[i as usize]
    }
    Hash256::from_bytes(hash_bytes)
}

// ──────────────────────────────────────────────
// Typed Serialization Records
// ──────────────────────────────────────────────
// Evidence path: SER-TREC-001 through SER-TREC-030

// A serialization record that pairs a type tag with encoded data.
pub type SerializedRecord : struct {
    type_tag: u8,
    length: u32,
    data: Byte[CAPACITY_LARGE],
}

impl SerializedRecord {
    pub fn new(type_tag: u8, length: u32) -> SerializedRecord
        effects: [deterministic]
    {
        SerializedRecord {
            type_tag: type_tag,
            length: length,
            data: [Byte::from_u8(0); CAPACITY_LARGE],
        }
    }

    pub fn type_tag(self) -> u8 { self.type_tag }
    pub fn length(self) -> u32 { self.length }

    // Write this record to a serialization buffer.
    pub fn write(self, buf: ref mut SerializeBuffer[KnownN]) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        buf.write_byte(Byte::from_u8(self.type_tag))?;
        buf.write_u32(self.length)?;
        // loop: bounds[BOUND_MEDIUM] — bounded by length
        loop: bounds[BOUND_MEDIUM] for i in 0..self.length {
            buf.write_byte(self.data[i as usize])?
        }
        Result::Ok(())
    }

    // Read a record from a deserialization buffer.
    pub fn read(buf: ref mut DeserializeBuffer[KnownN]) -> Result[SerializedRecord, SerializationError>
        effects: [deterministic, deserialize]
    {
        let tag: u8 = buf.read_byte()?.to_u8()
        let len: u32 = buf.read_u32()?
        let mut record: SerializedRecord = SerializedRecord::new(tag, len)
        // loop: bounds[BOUND_MEDIUM] — bounded by len
        loop: bounds[BOUND_MEDIUM] for i in 0..len {
            record.data[i as usize] = buf.read_byte()?
        }
        Result::Ok(record)
    }
}

// ──────────────────────────────────────────────
// Schema-Aware Serialization
// ──────────────────────────────────────────────
// Evidence path: SER-SCHEMA-001 through SER-SCHEMA-030

pub type FieldDescriptor : struct {
    field_name: FixedString[32],
    field_tag: u8,
    field_offset: u32,
    field_size: u32,
    is_optional: bool,
}

impl FieldDescriptor {
    pub fn new(name: FixedString[32], tag: u8, offset: u32, size: u32) -> FieldDescriptor
        effects: [deterministic]
    {
        FieldDescriptor {
            field_name: name,
            field_tag: tag,
            field_offset: offset,
            field_size: size,
            is_optional: false,
        }
    }

    pub fn optional(name: FixedString[32], tag: u8, offset: u32, size: u32) -> FieldDescriptor
        effects: [deterministic]
    {
        FieldDescriptor {
            field_name: name,
            field_tag: tag,
            field_offset: offset,
            field_size: size,
            is_optional: true,
        }
    }
}

pub type SchemaDescriptor : struct {
    schema_name: FixedString[64],
    schema_version: Word64,
    fields: FixedArray[CAPACITY_MEDIUM, FieldDescriptor],
}

impl SchemaDescriptor {
    pub fn new(name: FixedString[64], version: Word64) -> SchemaDescriptor
        effects: [deterministic]
    {
        SchemaDescriptor {
            schema_name: name,
            schema_version: version,
            fields: FixedArray::new(),
        }
    }

    pub fn add_field(self: ref mut, field: FieldDescriptor) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.fields.push(field)
    }

    // Validate serialized data against the schema.
    // loop: bounds[BOUND_MEDIUM] — bounded by field count.
    pub fn validate(self, record: ref SerializedRecord) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_MEDIUM] — bounded by field count
        loop: bounds[BOUND_MEDIUM] for i in 0..self.fields.len() {
            let field: FieldDescriptor = self.fields.get(i).unwrap()
            // Check if field tag matches expected.
            // In production, this would walk the record and match fields.
            if field.is_optional {
                // Optional fields may be absent.
                continue
            }
        }
        true
    }
}

// ──────────────────────────────────────────────
// Versioned Serialization
// ──────────────────────────────────────────────
// Evidence path: SER-VERSIONED-001 through SER-VERSIONED-025

pub type VersionedSerializer : struct {
    current_version: u8,
    supported_versions: FixedArray[CAPACITY_SMALL, u8],
}

impl VersionedSerializer {
    pub fn new(version: u8) -> VersionedSerializer
        effects: [deterministic]
    {
        let mut versions: FixedArray[CAPACITY_SMALL, u8] = FixedArray::new()
        let _: Result<(), BoundsError> = versions.push(version)
        VersionedSerializer {
            current_version: version,
            supported_versions: versions,
        }
    }

    pub fn add_supported_version(self: ref mut, version: u8) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.supported_versions.push(version)
    }

    // Write a version header.
    pub fn write_version_header(self, buf: ref mut SerializeBuffer[KnownN]) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        buf.write_byte(Byte::from_u8(self.current_version))
    }

    // Read and validate a version header.
    pub fn read_version_header(self, buf: ref mut DeserializeBuffer[KnownN]) -> Result<u8, SerializationError>
        effects: [deterministic, deserialize]
    {
        let version: u8 = buf.read_byte()?.to_u8()
        // Check if version is supported.
        let mut supported: bool = false
        // loop: bounds[BOUND_SMALL] — bounded by supported versions
        loop: bounds[BOUND_SMALL] for i in 0..self.supported_versions.len() {
            if self.supported_versions.get(i).unwrap() == version {
                supported = true
                break
            }
        }
        if !supported {
            return Result::Err(ser_version_mismatch(self.current_version, version))
        }
        Result::Ok(version)
    }

    // Get the current version.
    pub fn version(self) -> u8 { self.current_version }
}

// ──────────────────────────────────────────────
// Delta Serialization (binary diff)
// ──────────────────────────────────────────────
// Evidence path: SER-DELTA-001 through SER-DELTA-025

pub type DeltaEntry : struct {
    offset: u32,
    length: u32,
    data: Byte[CAPACITY_SMALL],
}

impl DeltaEntry {
    pub fn new(offset: u32, length: u32) -> DeltaEntry
        effects: [deterministic]
    {
        DeltaEntry {
            offset: offset,
            length: length,
            data: [Byte::from_u8(0); CAPACITY_SMALL],
        }
    }
}

pub type DeltaPatch : struct {
    base_hash: Hash256,
    entries: FixedArray[CAPACITY_MEDIUM, DeltaEntry],
}

impl DeltaPatch {
    pub fn new(base_hash: Hash256) -> DeltaPatch
        effects: [deterministic]
    {
        DeltaPatch {
            base_hash: base_hash,
            entries: FixedArray::new(),
        }
    }

    // Add a delta entry.
    pub fn add_entry(self: ref mut, entry: DeltaEntry) -> Result<(), BoundsError>
        effects: [deterministic]
    {
        self.entries.push(entry)
    }

    // Apply the delta patch to base data, producing new data.
    // loop: bounds[BOUND_MEDIUM] — bounded by entries.
    pub fn apply(self, base: Byte[], base_len: u32) -> Byte[CAPACITY_XLARGE]
        effects: [deterministic]
    {
        let mut result: Byte[CAPACITY_XLARGE] = [Byte::from_u8(0); CAPACITY_XLARGE]
        let mut result_len: u32 = base_len
        // Copy base data.
        // loop: bounds[BOUND_COPY] — bounded by base length
        loop: bounds[BOUND_COPY] for i in 0..base_len {
            result[i as usize] = base[i as usize]
        }
        // Apply each delta entry.
        // loop: bounds[BOUND_MEDIUM] — bounded by entries
        loop: bounds[BOUND_MEDIUM] for i in 0..self.entries.len() {
            let entry: DeltaEntry = self.entries.get(i).unwrap()
            // loop: bounds[BOUND_SMALL] — bounded by entry length
            loop: bounds[BOUND_SMALL] for j in 0..entry.length {
                let dst: u32 = entry.offset + j
                if dst < CAPACITY_XLARGE {
                    result[dst as usize] = entry.data[j as usize]
                }
            }
            let end: u32 = entry.offset + entry.length
            if end > result_len {
                result_len = end
            }
        }
        result
    }

    // Serialize the delta patch.
    pub fn serialize(self, buf: ref mut SerializeBuffer[KnownN]) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        buf.write_hash256(self.base_hash)?;
        buf.write_u32(self.entries.len())?;
        // loop: bounds[BOUND_MEDIUM] — bounded by entries
        loop: bounds[BOUND_MEDIUM] for i in 0..self.entries.len() {
            let entry: DeltaEntry = self.entries.get(i).unwrap()
            buf.write_u32(entry.offset)?;
            buf.write_u32(entry.length)?;
            // loop: bounds[BOUND_SMALL] — bounded by entry length
            loop: bounds[BOUND_SMALL] for j in 0..entry.length {
                buf.write_byte(entry.data[j as usize])?
            }
        }
        Result::Ok(())
    }

    // Deserialize a delta patch.
    pub fn deserialize(buf: ref mut DeserializeBuffer[KnownN]) -> Result[DeltaPatch, SerializationError>
        effects: [deterministic, deserialize]
    {
        let base_hash: Hash256 = buf.read_hash256()?
        let count: u32 = buf.read_u32()?
        let mut patch: DeltaPatch = DeltaPatch::new(base_hash)
        // loop: bounds[BOUND_MEDIUM] — bounded by count
        loop: bounds[BOUND_MEDIUM] for _ in 0..count {
            let offset: u32 = buf.read_u32()?
            let length: u32 = buf.read_u32()?
            let mut entry: DeltaEntry = DeltaEntry::new(offset, length)
            // loop: bounds[BOUND_SMALL] — bounded by length
            loop: bounds[BOUND_SMALL] for j in 0..length {
                entry.data[j as usize] = buf.read_byte()?
            }
            let _: Result<(), BoundsError> = patch.add_entry(entry)
        }
        Result::Ok(patch)
    }
}

// ──────────────────────────────────────────────
// Stream-based Serialization
// ──────────────────────────────────────────────
// Evidence path: SER-STREAM-001 through SER-STREAM-025

pub type SerializeStream : struct {
    buffer: SerializeBuffer[CAPACITY_XLARGE],
    finalized: bool,
    chunk_count: u32,
}

impl SerializeStream {
    pub fn new() -> SerializeStream
        effects: [deterministic]
    {
        SerializeStream {
            buffer: SerializeBuffer::new(),
            finalized: false,
            chunk_count: 0,
        }
    }

    // Begin serialization (write header).
    pub fn begin(self: ref mut) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        self.buffer.write_header()
    }

    // Write a chunk of data.
    pub fn write_chunk(self: ref mut, data: Byte[], length: u32) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        if self.finalized {
            return Result::Err(SerializationError::new(
                Word64::from_u64(DIAG_SERIAL_BASE | 0x010),
                FixedString[128]::from_slice("Stream already finalized")))
        }
        self.buffer.write_u32(length)?;
        self.buffer.write_bytes(data, length)?;
        self.chunk_count = self.chunk_count + 1
        Result::Ok(())
    }

    // Finalize the stream.
    pub fn finalize(self: ref mut) -> Result<u32, SerializationError>
        effects: [deterministic, serialize, hash]
    {
        self.finalized = true
        self.buffer.finalize()
    }

    // Get the serialized data.
    pub fn data(self) -> Byte[Slice]
        effects: [deterministic]
    {
        self.buffer.as_slice()
    }

    // Reset for reuse.
    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.buffer.reset()
        self.finalized = false
        self.chunk_count = 0
    }

    // Get the total bytes written.
    pub fn bytes_written(self) -> u32
        effects: [deterministic]
    {
        self.buffer.position()
    }

    // Get the number of chunks.
    pub fn chunk_count(self) -> u32 { self.chunk_count }
}

pub type DeserializeStream : struct {
    buffer: DeserializeBuffer[CAPACITY_XLARGE],
    header_read: bool,
    exhausted: bool,
}

impl DeserializeStream {
    pub fn new(data: Byte[CAPACITY_XLARGE], length: u32) -> DeserializeStream
        effects: [deterministic]
    {
        DeserializeStream {
            buffer: DeserializeBuffer::new(data, length),
            header_read: false,
            exhausted: false,
        }
    }

    // Read the header.
    pub fn read_header(self: ref mut) -> Result<(), SerializationError>
        effects: [deterministic, deserialize]
    {
        if !self.header_read {
            self.buffer.read_header()?;
            self.header_read = true
        }
        Result::Ok(())
    }

    // Read the next chunk.
    pub fn read_chunk(self: ref mut) -> Result[Option[Byte[]], SerializationError>
        effects: [deterministic, deserialize]
    {
        if self.exhausted || self.buffer.is_exhausted() {
            return Result::Ok(Option::None)
        }
        let length: u32 = self.buffer.read_u32()?
        if length == 0 {
            // End of stream marker.
            self.exhausted = true
            return Result::Ok(Option::None)
        }
        let mut chunk: Byte[KnownN] = Byte[KnownN]::new(length)
        self.buffer.read_bytes(&mut chunk, length)?;
        Result::Ok(Option::Some(chunk))
    }

    // Verify the final checksum.
    pub fn verify(self: ref mut) -> Result<bool, SerializationError>
        effects: [deterministic, deserialize, hash]
    {
        self.buffer.verify_checksum()
    }

    // Check if we've exhausted all data.
    pub fn is_exhausted(self) -> bool { self.exhausted }

    // Get current position.
    pub fn position(self) -> u32 { self.buffer.position() }

    // Get total length.
    pub fn length(self) -> u32 { self.buffer.total_length() }
}

// ──────────────────────────────────────────────
// Bit-level Serialization
// ──────────────────────────────────────────────
// Evidence path: SER-BIT-001 through SER-BIT-020

pub type BitWriter : struct {
    buffer: SerializeBuffer[CAPACITY_LARGE],
    current_byte: u8,
    bit_position: u32,
}

impl BitWriter {
    pub fn new() -> BitWriter
        effects: [deterministic]
    {
        BitWriter {
            buffer: SerializeBuffer::new(),
            current_byte: 0,
            bit_position: 0,
        }
    }

    // Write a single bit.
    pub fn write_bit(self: ref mut, bit: bool)
        effects: [deterministic, serialize]
    {
        if bit {
            self.current_byte = self.current_byte | (1 << (7 - self.bit_position))
        }
        self.bit_position = self.bit_position + 1
        if self.bit_position >= 8 {
            let _: Result<(), SerializationError> = self.buffer.write_byte(Byte::from_u8(self.current_byte))
            self.current_byte = 0
            self.bit_position = 0
        }
    }

    // Write multiple bits from a value.
    pub fn write_bits(self: ref mut, value: u64, count: u32)
        effects: [deterministic, serialize]
    {
        // loop: bounds[BOUND_SMALL] — bounded by count (max 64)
        loop: bounds[BOUND_SMALL] for i in 0..count {
            let bit_pos: u32 = count - 1 - i
            let bit: bool = ((value >> bit_pos) & 1) == 1
            self.write_bit(bit)
        }
    }

    // Flush remaining bits (pad with zeros).
    pub fn flush(self: ref mut) -> Result<(), SerializationError>
        effects: [deterministic, serialize]
    {
        if self.bit_position > 0 {
            self.buffer.write_byte(Byte::from_u8(self.current_byte))
            self.current_byte = 0
            self.bit_position = 0
        }
        Result::Ok(())
    }

    // Get the underlying buffer.
    pub fn buffer(self: ref mut) -> ref mut SerializeBuffer[KnownN]
        effects: [deterministic]
    {
        &mut self.buffer
    }
}

pub type BitReader : struct {
    buffer: DeserializeBuffer[CAPACITY_LARGE],
    current_byte: u8,
    bit_position: u32,
}

impl BitReader {
    pub fn new(data: Byte[CAPACITY_LARGE], length: u32) -> BitReader
        effects: [deterministic]
    {
        BitReader {
            buffer: DeserializeBuffer::new(data, length),
            current_byte: 0,
            bit_position: 8,  // Force read next byte
        }
    }

    // Read a single bit.
    pub fn read_bit(self: ref mut) -> Result<bool, SerializationError>
        effects: [deterministic, deserialize]
    {
        if self.bit_position >= 8 {
            self.current_byte = self.buffer.read_byte()?.to_u8()
            self.bit_position = 0
        }
        let bit: bool = ((self.current_byte >> (7 - self.bit_position)) & 1) == 1
        self.bit_position = self.bit_position + 1
        Result::Ok(bit)
    }

    // Read multiple bits into a value.
    pub fn read_bits(self: ref mut, count: u32) -> Result<u64, SerializationError>
        effects: [deterministic, deserialize]
    {
        let mut value: u64 = 0
        // loop: bounds[BOUND_SMALL] — bounded by count (max 64)
        loop: bounds[BOUND_SMALL] for _ in 0..count {
            value = value << 1
            let bit: bool = self.read_bit()?
            if bit {
                value = value | 1
            }
        }
        Result::Ok(value)
    }

    // Check if we've exhausted the bit stream.
    pub fn is_exhausted(self) -> bool
        effects: [deterministic]
    {
        self.bit_position >= 8 && self.buffer.is_exhausted()
    }
}

// ──────────────────────────────────────────────
// Bounded Serialization for Collections
// ──────────────────────────────────────────────
// Evidence path: SER-BND-001 through SER-BND-025

// Serialize a fixed set of bytes with a length prefix.
// loop: bounds[BOUND_COPY] — bounded by length.
pub fn write_len_prefixed_bytes(
    buf: ref mut SerializeBuffer[KnownN],
    data: Byte[],
    length: u32,
) -> Result<(), SerializationError>
    effects: [deterministic, serialize]
{
    buf.write_u32(length)?;
    // loop: bounds[BOUND_COPY] — bounded by length
    loop: bounds[BOUND_COPY] for i in 0..length {
        buf.write_byte(data[i as usize])?
    }
    Result::Ok(())
}

// Deserialize length-prefixed bytes.
pub fn read_len_prefixed_bytes(
    buf: ref mut DeserializeBuffer[KnownN],
) -> Result[Byte[], SerializationError>
    effects: [deterministic, deserialize]
{
    let length: u32 = buf.read_u32()?
    let mut data: Byte[] = Byte[KnownN]::new(length)
    // loop: bounds[BOUND_COPY] — bounded by length
    loop: bounds[BOUND_COPY] for i in 0..length {
        data[i as usize] = buf.read_byte()?
    }
    Result::Ok(data)
}

// Serialize a fixed-length string.
pub fn write_fixed_string(
    buf: ref mut SerializeBuffer[KnownN],
    s: FixedString[KnownLen],
) -> Result<(), SerializationError>
    effects: [deterministic, serialize]
{
    let len: u32 = s.len()
    buf.write_u32(len)?;
    // loop: bounds[BOUND_SMALL] — bounded by string length
    loop: bounds[BOUND_SMALL] for i in 0..len {
        buf.write_byte(s.byte_at(i))?
    }
    Result::Ok(())
}

// Deserialize a fixed-length string.
pub fn read_fixed_string(
    buf: ref mut DeserializeBuffer[KnownN],
) -> Result[FixedString[KnownLen], SerializationError>
    effects: [deterministic, deserialize]
{
    let len: u32 = buf.read_u32()?
    let mut s: FixedString[KnownLen] = FixedString::new()
    // loop: bounds[BOUND_SMALL] — bounded by length
    loop: bounds[BOUND_SMALL] for i in 0..len {
        let b: Byte = buf.read_byte()?
        let _: Result<(), BoundsError> = s.push_byte(b)
    }
    Result::Ok(s)
}

// ──────────────────────────────────────────────
// FlatBuffers-style Zero-Copy Deserialization
// ──────────────────────────────────────────────
// Evidence path: SER-FLAT-001 through SER-FLAT-020

pub type FlatView : struct {
    data: Byte[CAPACITY_XLARGE],
    length: u32,
    position: u32,
}

impl FlatView {
    pub fn new(data: Byte[CAPACITY_XLARGE], length: u32) -> FlatView
        effects: [deterministic]
    {
        FlatView {
            data: data,
            length: length,
            position: 0,
        }
    }

    // Read a value at a specific offset without advancing position.
    pub fn read_at[T](self, offset: u32, read_fn: fn(ref Byte[], u32) -> T) -> T
        effects: [deterministic]
    {
        read_fn(&self.data, offset)
    }

    // Advance the view position.
    pub fn advance(self: ref mut, delta: u32)
        effects: [deterministic]
    {
        self.position = self.position + delta
        if self.position > self.length {
            self.position = self.length
        }
    }

    // Get a slice of the underlying data.
    pub fn slice(self, start: u32, end: u32) -> Byte[Slice]
        effects: [deterministic]
    {
        let slice_len: u32 = if end > self.length { self.length - start } else { end - start }
        let mut result: Byte[Slice] = Byte[Slice]::new(slice_len)
        // loop: bounds[BOUND_COPY] — bounded by length
        loop: bounds[BOUND_COPY] for i in 0..slice_len {
            result[i as usize] = self.data[(start + i) as usize]
        }
        result
    }

    // Read a u32 at a given offset.
    pub fn read_u32_at(self, offset: u32) -> u32
        effects: [deterministic]
    {
        let mut raw: [u8; 4] = [0; 4]
        // loop: bounds[BOUND_TINY] — exactly 4 iterations
        loop: bounds[BOUND_TINY] for i in 0..4 {
            raw[i as usize] = self.data[(offset + i) as usize].to_u8()
        }
        __builtin_u32_from_le_bytes(raw)
    }

    // Read a u64 at a given offset.
    pub fn read_u64_at(self, offset: u32) -> u64
        effects: [deterministic]
    {
        let mut raw: [u8; 8] = [0; 8]
        // loop: bounds[BOUND_TINY] — exactly 8 iterations
        loop: bounds[BOUND_TINY] for i in 0..8 {
            raw[i as usize] = self.data[(offset + i) as usize].to_u8()
        }
        __builtin_u64_from_le_bytes(raw)
    }

    // Get total length.
    pub fn length(self) -> u32 { self.length }

    // Get current position.
    pub fn position(self) -> u32 { self.position }
}

// ──────────────────────────────────────────────
// Serialization Constants for Stream Markers
// ──────────────────────────────────────────────
// Evidence path: SER-MARKERS-001 through SER-MARKERS-010

const SER_STREAM_BEGIN   : u8 = 0x01
const SER_STREAM_CHUNK   : u8 = 0x02
const SER_STREAM_END     : u8 = 0x03
const SER_STREAM_ABORT   : u8 = 0x04
const SER_RECORD_START   : u8 = 0x10
const SER_RECORD_END     : u8 = 0x11
const SER_NESTED_BEGIN   : u8 = 0x20
const SER_NESTED_END     : u8 = 0x21
const SER_CHECKPOINT     : u8 = 0x30
