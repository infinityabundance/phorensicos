// access_control.phor — Access Control Subsystem
//
// Provides:
//   - Capability-based access decisions
//   - Role resolution and hierarchy traversal
//   - Permission evaluation with multi-factor checks
//   - Privilege elevation with audit trail
//   - Access review for compliance verification
//   - Full residual recording on every access decision
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every access decision produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:access_control:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_ROLES: u64 = 256;
const MAX_USERS: u64 = 1024;
const MAX_PERMISSIONS: u64 = 2048;
const MAX_ROLE_HIERARCHY_DEPTH: u64 = 16;
const MAX_PRIVILEGE_LEVELS: u64 = 8;
const MAX_ACCESS_REQUESTS: u64 = 4096;
const MAX_CAPABILITY_RIGHTS: u64 = 16;
const MAX_ROLE_MEMBERS: u64 = 256;
const MAX_PERMISSION_FLAGS: u64 = 32;
const MAX_ACCESS_CONTEXTS: u64 = 64;
const MAX_ELEVATION_TOKENS: u64 = 128;
const MAX_REVIEW_RESULTS: u64 = 1024;
const MAX_SESSION_CREDENTIALS: u64 = 64;
const MAX_RESOURCE_TYPES: u64 = 64;
const MAX_ACCESS_AUDIT_TRAIL: u64 = 2048;
const MAX_DELEGATION_DEPTH: u64 = 4;

effect access:evaluate;
effect access:elevate;
effect access:review;
effect access:role;
effect access:capability;

// ──────────────────────────────────────────────
// Access Control Types
// ──────────────────────────────────────────────

enum AccessDecision {
    Granted,
    Denied,
    Conditional,
    RequiresElevation,
    RequiresReview,
    Indeterminate,
}

enum PrivilegeLevel {
    None,
    Read,
    Write,
    Execute,
    ReadWrite,
    ReadExecute,
    FullControl,
    Admin,
}

enum RoleType {
    Regular,
    Administrative,
    Audit,
    Service,
    Machine,
    Temporary,
}

enum CapabilityRight {
    CapRead,
    CapWrite,
    CapExecute,
    CapDelete,
    CapCreate,
    CapAdmin,
    CapAudit,
    CapDelegate,
    CapImpersonate,
    CapControl,
}

enum AccessContextType {
    Normal,
    Elevated,
    Emergency,
    Maintenance,
    AuditMode,
    Restricted,
    Trusted,
    Isolated,
}

enum ElevationMethod {
    Password,
    Token,
    Biometric,
    MFA,
    JustInTime,
    BreakGlass,
    EscalationRequest,
}

enum AccessReviewStatus {
    Compliant,
    NonCompliant,
    NeedsReview,
    Revoked,
    Expired,
    PendingReview,
}

// ──────────────────────────────────────────────
// Access Control Structures
// ──────────────────────────────────────────────

struct Role {
    role_id: u64,
    name: Str(64),
    role_type: RoleType,
    parent_role_id: u64,
    hierarchy_level: u64,
    member_count: u64,
    members: Array(u64, MAX_ROLE_MEMBERS),
    permission_count: u64,
    permissions: Array(u64, MAX_PERMISSIONS),
    privilege_level: PrivilegeLevel,
    enabled: bool,
    audit_required: bool,
    max_elevation_depth: u64,
    expiry_time: u64,
}

struct Permission {
    permission_id: u64,
    name: Str(64),
    resource_type: u64,
    resource_pattern: u64,
    action_mask: u64,
    privilege_level: PrivilegeLevel,
    conditional: bool,
    condition_check: u64,
    delegated: bool,
    delegation_depth: u64,
    source_role_id: u64,
}

struct AccessContext {
    context_id: u64,
    context_type: AccessContextType,
    session_id: u64,
    elevation_count: u64,
    elevation_method: ElevationMethod,
    start_time: u64,
    expiry_time: u64,
    justification: Str(256),
    audit_required: bool,
    restricted_operations: u64,
}

struct ElevationToken {
    token_id: u64,
    user_id: u64,
    target_role_id: u64,
    target_privilege: PrivilegeLevel,
    method: ElevationMethod,
    issued_time: u64,
    expiry_time: u64,
    used: bool,
    single_use: bool,
    justification: Str(256),
    approver_id: u64,
    audited: bool,
}

struct AccessRequest {
    request_id: u64,
    user_id: u64,
    subject_id: u64,
    resource_id: u64,
    action_id: u64,
    context_id: u64,
    requested_privilege: PrivilegeLevel,
    timestamp: u64,
    decision: AccessDecision,
    evaluated_permissions: Array(u64, MAX_PERMISSIONS),
    permission_count: u64,
    matched_role_id: u64,
    matched_permission_id: u64,
    audit_emitted: bool,
}

struct AccessReviewResult {
    review_id: u64,
    user_id: u64,
    role_id: u64,
    status: AccessReviewStatus,
    reviewed_permission_count: u64,
    violated_permissions: Array(u64, MAX_PERMISSIONS),
    violation_count: u64,
    last_access_time: u64,
    access_frequency: u64,
    recommendation: Str(256),
    reviewer_id: u64,
    review_time: u64,
}

struct CapabilitySet {
    user_id: u64,
    rights_mask: u64,
    rights_count: u64,
    rights: Array(CapabilityRight, MAX_CAPABILITY_RIGHTS),
    delegated_from: u64,
    delegation_depth: u64,
    expiry: u64,
    audited: bool,
}

struct AccessControlState {
    role_count: u64,
    roles: Array(Role, MAX_ROLES),
    permission_count: u64,
    permissions: Array(Permission, MAX_PERMISSIONS),
    active_contexts: Array(AccessContext, MAX_ACCESS_CONTEXTS),
    context_count: u64,
    elevation_tokens: Array(ElevationToken, MAX_ELEVATION_TOKENS),
    token_count: u64,
    default_decision: AccessDecision,
    max_session_credentials: u64,
    session_timeout: u64,
    audit_required: bool,
}

// ──────────────────────────────────────────────
// Role Resolution
// ──────────────────────────────────────────────

fn create_role(
    role_id: u64,
    name: Str(64),
    role_type: RoleType,
    parent_id: u64,
    privilege: PrivilegeLevel,
) -> Role
    effect [access:role, compute, residual]
{
    residual emit {
        op: "access.role_create",
        role: role_id,
        name: name,
        role_type: role_type as u8,
        parent: parent_id,
        privilege: privilege as u8,
    };

    return Role{
        role_id: role_id,
        name: name,
        role_type: role_type,
        parent_role_id: parent_id,
        hierarchy_level: 0,
        member_count: 0,
        members: Array::splat(0),
        permission_count: 0,
        permissions: Array::splat(0),
        privilege_level: privilege,
        enabled: true,
        audit_required: true,
        max_elevation_depth: 3,
        expiry_time: 0,
    };
}

fn add_role_to_state(state: AccessControlState, role: Role) -> AccessControlState
    effect [access:role, compute, residual]
{
    let mut updated: AccessControlState = state;
    if updated.role_count < MAX_ROLES {
        let mut r: Role = role;
        r.hierarchy_level = 0;
        if role.parent_role_id != 0 {
            for i in 0..updated.role_count {
                if updated.roles[i].role_id == role.parent_role_id {
                    r.hierarchy_level = updated.roles[i].hierarchy_level + 1;
                    break;
                }
            }
        }
        updated.roles[updated.role_count] = r;
        updated.role_count = updated.role_count + 1;

        residual emit {
            op: "access.role_add",
            role: role.role_id,
            name: role.name,
            hierarchy: r.hierarchy_level,
        };
    }
    return updated;
}

fn add_user_to_role(state: AccessControlState, role_id: u64, user_id: u64) -> AccessControlState
    effect [access:role, compute, residual]
{
    let mut updated: AccessControlState = state;
    for i in 0..updated.role_count {
        if updated.roles[i].role_id == role_id {
            let mut role: Role = updated.roles[i];
            if role.member_count < MAX_ROLE_MEMBERS {
                role.members[role.member_count] = user_id;
                role.member_count = role.member_count + 1;
                updated.roles[i] = role;
            }
            break;
        }
    }

    residual emit {
        op: "access.user_role_add",
        user: user_id,
        role: role_id,
    };

    return updated;
}

fn resolve_user_roles(state: AccessControlState, user_id: u64) -> Array(Role, MAX_ROLE_HIERARCHY_DEPTH)
    effect [access:role, compute]
{
    let mut resolved: Array(Role, MAX_ROLE_HIERARCHY_DEPTH) = Array::zeroed();
    let mut resolved_count: u64 = 0;
    let mut visited: Array(u8, MAX_ROLES) = Array::splat(0);

    for i in 0..state.role_count {
        let role: Role = state.roles[i];
        if !role.enabled {
            continue;
        }
        let mut is_member: bool = false;
        for j in 0..role.member_count {
            if role.members[j] == user_id {
                is_member = true;
                break;
            }
        }
        if is_member && resolved_count < MAX_ROLE_HIERARCHY_DEPTH {
            resolved[resolved_count] = role;
            resolved_count = resolved_count + 1;
            visited[i] = 1;
        }
    }

    for i in 0..state.role_count {
        if visited[i] != 0 {
            continue;
        }
        let role: Role = state.roles[i];
        if !role.enabled {
            continue;
        }
        for j in 0..resolved_count {
            if resolved[j].role_id == role.parent_role_id {
                if resolved_count < MAX_ROLE_HIERARCHY_DEPTH {
                    resolved[resolved_count] = role;
                    resolved_count = resolved_count + 1;
                }
                break;
            }
        }
    }

    return resolved;
}

fn get_role_hierarchy_path(state: AccessControlState, role_id: u64) -> Array(u64, MAX_ROLE_HIERARCHY_DEPTH)
    effect [compute]
{
    let mut path: Array(u64, MAX_ROLE_HIERARCHY_DEPTH) = Array::splat(0);
    let mut path_count: u64 = 0;
    let mut current_id: u64 = role_id;

    for _ in 0..MAX_ROLE_HIERARCHY_DEPTH {
        if current_id == 0 {
            break;
        }
        if path_count >= MAX_ROLE_HIERARCHY_DEPTH {
            break;
        }
        path[path_count] = current_id;
        path_count = path_count + 1;
        for i in 0..state.role_count {
            if state.roles[i].role_id == current_id {
                current_id = state.roles[i].parent_role_id;
                break;
            }
        }
    }
    return path;
}

fn find_role_by_id(state: AccessControlState, role_id: u64) -> Option(Role)
    effect [compute]
{
    for i in 0..state.role_count {
        if state.roles[i].role_id == role_id {
            return Option::Some(state.roles[i]);
        }
    }
    return Option::None;
}

fn count_users_in_role(state: AccessControlState, role_id: u64) -> u64
    effect [compute]
{
    for i in 0..state.role_count {
        if state.roles[i].role_id == role_id {
            return state.roles[i].member_count;
        }
    }
    return 0;
}

fn check_role_membership(state: AccessControlState, user_id: u64, role_id: u64) -> bool
    effect [compute]
{
    let roles: Array(Role, MAX_ROLE_HIERARCHY_DEPTH) = resolve_user_roles(state, user_id);
    for i in 0..MAX_ROLE_HIERARCHY_DEPTH {
        if roles[i].role_id == role_id {
            return true;
        }
    }
    return false;
}

// ──────────────────────────────────────────────
// Permission Management
// ──────────────────────────────────────────────

fn create_permission(
    perm_id: u64,
    name: Str(64),
    resource_type: u64,
    action_mask: u64,
    privilege: PrivilegeLevel,
) -> Permission
    effect [access:role, compute, residual]
{
    residual emit {
        op: "access.permission_create",
        permission: perm_id,
        name: name,
        resource: resource_type,
        actions: action_mask,
        privilege: privilege as u8,
    };

    return Permission{
        permission_id: perm_id,
        name: name,
        resource_type: resource_type,
        resource_pattern: 0,
        action_mask: action_mask,
        privilege_level: privilege,
        conditional: false,
        condition_check: 0,
        delegated: false,
        delegation_depth: 0,
        source_role_id: 0,
    };
}

fn add_permission_to_role(state: AccessControlState, role_id: u64, permission_id: u64) -> AccessControlState
    effect [access:role, compute, residual]
{
    let mut updated: AccessControlState = state;
    for i in 0..updated.role_count {
        if updated.roles[i].role_id == role_id {
            let mut role: Role = updated.roles[i];
            if role.permission_count < MAX_PERMISSIONS {
                role.permissions[role.permission_count] = permission_id;
                role.permission_count = role.permission_count + 1;
                updated.roles[i] = role;
            }
            break;
        }
    }

    residual emit {
        op: "access.permission_role_add",
        permission: permission_id,
        role: role_id,
    };

    return updated;
}

fn get_role_permissions(state: AccessControlState, role_id: u64) -> Array(Permission, MAX_PERMISSIONS)
    effect [compute]
{
    let mut perms: Array(Permission, MAX_PERMISSIONS) = Array::zeroed();
    let mut perm_count: u64 = 0;

    for i in 0..state.role_count {
        if state.roles[i].role_id == role_id {
            let role: Role = state.roles[i];
            for j in 0..role.permission_count {
                let p_id: u64 = role.permissions[j];
                for k in 0..state.permission_count {
                    if state.permissions[k].permission_id == p_id {
                        if perm_count < MAX_PERMISSIONS {
                            perms[perm_count] = state.permissions[k];
                            perm_count = perm_count + 1;
                        }
                        break;
                    }
                }
            }
            break;
        }
    }
    return perms;
}

fn permission_matches_action(perm: Permission, action_id: u64) -> bool
    effect [compute]
{
    return (perm.action_mask & action_id) != 0;
}

fn permission_matches_resource(perm: Permission, resource_id: u64) -> bool
    effect [compute]
{
    if perm.resource_pattern == 0 {
        return perm.resource_type == resource_id;
    }
    return (perm.resource_pattern & resource_id) != 0;
}

// ──────────────────────────────────────────────
// Permission Evaluation
// ──────────────────────────────────────────────

fn evaluate_permissions(
    state: AccessControlState,
    user_id: u64,
    resource_id: u64,
    action_id: u64,
    context: AccessContext,
) -> AccessRequest
    effect [access:evaluate, compute, residual]
{
    let roles: Array(Role, MAX_ROLE_HIERARCHY_DEPTH) = resolve_user_roles(state, user_id);
    let mut matched_role_id: u64 = 0;
    let mut matched_perm_id: u64 = 0;
    let mut granted: bool = false;
    let mut evaluated_perms: Array(u64, MAX_PERMISSIONS) = Array::splat(0);
    let mut eval_count: u64 = 0;

    for ri in 0..MAX_ROLE_HIERARCHY_DEPTH {
        let role: Role = roles[ri];
        if role.role_id == 0 {
            break;
        }
        for pj in 0..role.permission_count {
            let perm_id: u64 = role.permissions[pj];
            for pk in 0..state.permission_count {
                let perm: Permission = state.permissions[pk];
                if perm.permission_id != perm_id {
                    continue;
                }
                if eval_count < MAX_PERMISSIONS {
                    evaluated_perms[eval_count] = perm_id;
                    eval_count = eval_count + 1;
                }
                let action_match: bool = permission_matches_action(perm, action_id);
                let resource_match: bool = permission_matches_resource(perm, resource_id);
                if action_match && resource_match {
                    matched_role_id = role.role_id;
                    matched_perm_id = perm_id;
                    granted = true;
                }
            }
            if granted {
                break;
            }
        }
        if granted {
            break;
        }
    }

    let decision: AccessDecision = if granted {
        AccessDecision::Granted
    } else if context.context_type == AccessContextType::Elevated {
        AccessDecision::Denied
    } else {
        AccessDecision::RequiresElevation
    };

    let request: AccessRequest = AccessRequest{
        request_id: 0,
        user_id: user_id,
        subject_id: user_id,
        resource_id: resource_id,
        action_id: action_id,
        context_id: context.context_id,
        requested_privilege: PrivilegeLevel::Read,
        timestamp: 0,
        decision: decision,
        evaluated_permissions: evaluated_perms,
        permission_count: eval_count,
        matched_role_id: matched_role_id,
        matched_permission_id: matched_perm_id,
        audit_emitted: false,
    };

    residual emit {
        op: "access.evaluate",
        user: user_id,
        resource: resource_id,
        action: action_id,
        decision: decision as u8,
        matched_role: matched_role_id,
        matched_perm: matched_perm_id,
        evaluated_count: eval_count,
        context: context.context_type as u8,
    };

    return request;
}

fn evaluate_privilege_level(
    state: AccessControlState,
    user_id: u64,
    required_level: PrivilegeLevel,
) -> bool
    effect [access:evaluate, compute]
{
    let roles: Array(Role, MAX_ROLE_HIERARCHY_DEPTH) = resolve_user_roles(state, user_id);
    let mut max_level: PrivilegeLevel = PrivilegeLevel::None;

    for ri in 0..MAX_ROLE_HIERARCHY_DEPTH {
        let role: Role = roles[ri];
        if role.role_id == 0 {
            break;
        }
        if role.privilege_level as u8 > max_level as u8 {
            max_level = role.privilege_level;
        }
    }

    return max_level as u8 >= required_level as u8;
}

fn check_access_context(
    request: AccessRequest,
    context: AccessContext,
) -> bool
    effect [compute]
{
    if context.expiry_time > 0 && context.expiry_time < request.timestamp {
        return false;
    }
    if context.restricted_operations & request.action_id != 0 {
        return false;
    }
    return true;
}

fn check_capability_rights(
    caps: CapabilitySet,
    required_right: CapabilityRight,
) -> bool
    effect [access:capability, compute]
{
    if caps.expiry > 0 && caps.expiry < 0 {
        return false;
    }
    for i in 0..caps.rights_count {
        if caps.rights[i] == required_right {
            return true;
        }
    }
    return false;
}

fn derive_capability(
    source: CapabilitySet,
    new_rights: Array(CapabilityRight, MAX_CAPABILITY_RIGHTS),
    new_right_count: u64,
) -> CapabilitySet
    effect [access:capability, compute, residual]
{
    let mut derived: CapabilitySet = source;
    derived.rights_count = new_right_count;
    for i in 0..new_right_count {
        derived.rights[i] = new_rights[i];
    }
    derived.delegation_depth = source.delegation_depth + 1;
    derived.delegated_from = source.user_id;

    residual emit {
        op: "access.capability_derive",
        from: source.user_id,
        rights: new_right_count,
        depth: derived.delegation_depth,
    };

    return derived;
}

// ──────────────────────────────────────────────
// Privilege Elevation
// ──────────────────────────────────────────────

fn create_elevation_token(
    user_id: u64,
    target_role_id: u64,
    target_privilege: PrivilegeLevel,
    method: ElevationMethod,
    justification: Str(256),
    approver_id: u64,
) -> ElevationToken
    effect [access:elevate, compute, residual]
{
    let token_id: u64 = 0;

    residual emit {
        op: "access.elevation_token_create",
        user: user_id,
        target_role: target_role_id,
        target_priv: target_privilege as u8,
        method: method as u8,
        approver: approver_id,
    };

    return ElevationToken{
        token_id: token_id,
        user_id: user_id,
        target_role_id: target_role_id,
        target_privilege: target_privilege,
        method: method,
        issued_time: 0,
        expiry_time: 0,
        used: false,
        single_use: true,
        justification: justification,
        approver_id: approver_id,
        audited: true,
    };
}

fn add_elevation_token(state: AccessControlState, token: ElevationToken) -> AccessControlState
    effect [access:elevate, compute, residual]
{
    let mut updated: AccessControlState = state;
    if updated.token_count < MAX_ELEVATION_TOKENS {
        updated.elevation_tokens[updated.token_count] = token;
        updated.token_count = updated.token_count + 1;

        residual emit {
            op: "access.elevation_token_store",
            token: token.token_id,
            user: token.user_id,
        };
    }
    return updated;
}

fn use_elevation_token(
    state: AccessControlState,
    token_id: u64,
    user_id: u64,
) -> (AccessControlState, bool)
    effect [access:elevate, compute, residual]
{
    let mut updated: AccessControlState = state;
    let mut valid: bool = false;

    for i in 0..updated.token_count {
        if updated.elevation_tokens[i].token_id == token_id {
            let token: ElevationToken = updated.elevation_tokens[i];
            if token.user_id == user_id && !token.used {
                let mut t: ElevationToken = token;
                t.used = true;
                updated.elevation_tokens[i] = t;
                valid = true;
            }
            break;
        }
    }

    residual emit {
        op: "access.elevation_token_use",
        token: token_id,
        user: user_id,
        valid: if valid { 1 } else { 0 },
    };

    return (updated, valid);
}

fn perform_privilege_elevation(
    state: AccessControlState,
    user_id: u64,
    target_role_id: u64,
    method: ElevationMethod,
    justification: Str(256),
) -> (AccessControlState, bool)
    effect [access:elevate, compute, residual]
{
    let mut elevated: bool = false;
    let role_opt: Option(Role) = find_role_by_id(state, target_role_id);
    match role_opt {
        Option::Some(role) => {
            if role.enabled {
                let token: ElevationToken = create_elevation_token(
                    user_id, target_role_id,
                    role.privilege_level,
                    method, justification, 0,
                );
                let mut updated: AccessControlState = add_elevation_token(state, token);
                let (final_state, used): (AccessControlState, bool) = use_elevation_token(
                    updated, token.token_id, user_id,
                );
                updated = final_state;
                elevated = used;

                residual emit {
                    op: "access.elevation_perform",
                    user: user_id,
                    target_role: target_role_id,
                    method: method as u8,
                    elevated: if elevated { 1 } else { 0 },
                };
            }
        },
        Option::None => {},
    };

    return (state, elevated);
}

fn perform_break_glass_elevation(
    state: AccessControlState,
    user_id: u64,
    emergency_justification: Str(256),
) -> (AccessControlState, bool)
    effect [access:elevate, compute, residual]
{
    let emergency_token: ElevationToken = ElevationToken{
        token_id: 0xFFFFFFFF,
        user_id: user_id,
        target_role_id: 0,
        target_privilege: PrivilegeLevel::Admin,
        method: ElevationMethod::BreakGlass,
        issued_time: 0,
        expiry_time: 0,
        used: true,
        single_use: true,
        justification: emergency_justification,
        approver_id: 0,
        audited: true,
    };

    let mut updated: AccessControlState = add_elevation_token(state, emergency_token);

    residual emit {
        op: "access.break_glass",
        user: user_id,
        justification: emergency_justification,
    };

    return (updated, true);
}

// ──────────────────────────────────────────────
// Access Review
// ──────────────────────────────────────────────

fn perform_access_review(
    state: AccessControlState,
    user_id: u64,
    reviewer_id: u64,
) -> AccessReviewResult
    effect [access:review, compute, residual]
{
    let roles: Array(Role, MAX_ROLE_HIERARCHY_DEPTH) = resolve_user_roles(state, user_id);
    let mut violations: Array(u64, MAX_PERMISSIONS) = Array::splat(0);
    let mut violation_count: u64 = 0;
    let mut total_perms: u64 = 0;
    let mut reviewed_role: u64 = 0;

    for ri in 0..MAX_ROLE_HIERARCHY_DEPTH {
        let role: Role = roles[ri];
        if role.role_id == 0 {
            break;
        }
        reviewed_role = role.role_id;
        total_perms = total_perms + role.permission_count;

        for pj in 0..role.permission_count {
            let perm_id: u64 = role.permissions[pj];
            let mut found_definition: bool = false;
            for pk in 0..state.permission_count {
                if state.permissions[pk].permission_id == perm_id {
                    found_definition = true;
                    let perm: Permission = state.permissions[pk];
                    if perm.privilege_level as u8 > role.privilege_level as u8 {
                        if violation_count < MAX_PERMISSIONS {
                            violations[violation_count] = perm_id;
                            violation_count = violation_count + 1;
                        }
                    }
                    break;
                }
            }
            if !found_definition && violation_count < MAX_PERMISSIONS {
                violations[violation_count] = perm_id;
                violation_count = violation_count + 1;
            }
        }
    }

    let status: AccessReviewStatus = if violation_count > 0 {
        AccessReviewStatus::NonCompliant
    } else {
        AccessReviewStatus::Compliant
    };

    residual emit {
        op: "access.review",
        user: user_id,
        reviewer: reviewer_id,
        status: status as u8,
        violations: violation_count,
        total_permissions: total_perms,
    };

    return AccessReviewResult{
        review_id: 0,
        user_id: user_id,
        role_id: reviewed_role,
        status: status,
        reviewed_permission_count: total_perms,
        violated_permissions: violations,
        violation_count: violation_count,
        last_access_time: 0,
        access_frequency: 0,
        recommendation: Str::from("Review completed"),
        reviewer_id: reviewer_id,
        review_time: 0,
    };
}

fn review_all_roles(state: AccessControlState, reviewer_id: u64) -> Array(AccessReviewResult, MAX_REVIEW_RESULTS)
    effect [access:review, compute, residual]
{
    let mut results: Array(AccessReviewResult, MAX_REVIEW_RESULTS) = Array::zeroed();
    let mut result_count: u64 = 0;

    for ri in 0..state.role_count {
        let role: Role = state.roles[ri];
        let mut reviewed_users: Array(u8, MAX_USERS) = Array::splat(0);
        for mj in 0..role.member_count {
            let uid: u64 = role.members[mj];
            if uid == 0 || reviewed_users[uid as u8] != 0 {
                continue;
            }
            if result_count < MAX_REVIEW_RESULTS {
                let review: AccessReviewResult = perform_access_review(state, uid, reviewer_id);
                results[result_count] = review;
                result_count = result_count + 1;
            }
            reviewed_users[uid as u8] = 1;
        }
    }

    residual emit {
        op: "access.review_all",
        reviewed: result_count,
        reviewer: reviewer_id,
    };

    return results;
}

// ──────────────────────────────────────────────
// Access Decision Engine
// ──────────────────────────────────────────────

fn make_access_decision(
    state: AccessControlState,
    user_id: u64,
    resource_id: u64,
    action_id: u64,
    context: AccessContext,
    capabilities: CapabilitySet,
) -> (AccessDecision, AccessRequest)
    effect [access:evaluate, access:capability, compute, residual]
{
    let ctx_valid: bool = check_access_request_context(context);

    let request: AccessRequest = evaluate_permissions(
        state, user_id, resource_id, action_id, context,
    );

    let final_decision: AccessDecision = match request.decision {
        AccessDecision::Granted => AccessDecision::Granted,
        AccessDecision::RequiresElevation => {
            if context.context_type == AccessContextType::Elevated {
                let has_cap: bool = check_capability_rights(capabilities, CapabilityRight::CapRead);
                if has_cap {
                    AccessDecision::Granted
                } else {
                    AccessDecision::Denied
                }
            } else {
                AccessDecision::RequiresElevation
            }
        },
        AccessDecision::Denied => AccessDecision::Denied,
        _ => AccessDecision::Indeterminate,
    };

    residual emit {
        op: "access.decision",
        user: user_id,
        resource: resource_id,
        action: action_id,
        decision: final_decision as u8,
        context: context.context_type as u8,
    };

    return (final_decision, request);
}

fn check_access_request_context(context: AccessContext) -> bool
    effect [compute]
{
    if context.expiry_time > 0 && context.expiry_time < 0 {
        return false;
    }
    return true;
}

// ──────────────────────────────────────────────
// Access Control State Management
// ──────────────────────────────────────────────

fn create_access_control_state() -> AccessControlState
    effect [compute, residual]
{
    residual emit {
        op: "access.state_init",
    };

    return AccessControlState{
        role_count: 0,
        roles: Array::zeroed(),
        permission_count: 0,
        permissions: Array::zeroed(),
        active_contexts: Array::zeroed(),
        context_count: 0,
        elevation_tokens: Array::zeroed(),
        token_count: 0,
        default_decision: AccessDecision::Denied,
        max_session_credentials: MAX_SESSION_CREDENTIALS,
        session_timeout: 3600,
        audit_required: true,
    };
}

fn add_permission_to_state(state: AccessControlState, perm: Permission) -> AccessControlState
    effect [access:role, compute, residual]
{
    let mut updated: AccessControlState = state;
    if updated.permission_count < MAX_PERMISSIONS {
        updated.permissions[updated.permission_count] = perm;
        updated.permission_count = updated.permission_count + 1;

        residual emit {
            op: "access.permission_store",
            permission: perm.permission_id,
            name: perm.name,
        };
    }
    return updated;
}

fn get_user_max_privilege(state: AccessControlState, user_id: u64) -> PrivilegeLevel
    effect [compute]
{
    let roles: Array(Role, MAX_ROLE_HIERARCHY_DEPTH) = resolve_user_roles(state, user_id);
    let mut max_priv: PrivilegeLevel = PrivilegeLevel::None;
    for i in 0..MAX_ROLE_HIERARCHY_DEPTH {
        if roles[i].role_id == 0 {
            break;
        }
        if roles[i].privilege_level as u8 > max_priv as u8 {
            max_priv = roles[i].privilege_level;
        }
    }
    return max_priv;
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main() -> AccessControlState
    effect [access:evaluate, access:elevate, access:review, access:role, access:capability, compute, io:write, residual]
{
    let mut state: AccessControlState = create_access_control_state();

    let admin_role: Role = create_role(
        1, Str::from("administrator"), RoleType::Administrative, 0, PrivilegeLevel::Admin,
    );
    state = add_role_to_state(state, admin_role);

    let user_role: Role = create_role(
        2, Str::from("regular_user"), RoleType::Regular, 1, PrivilegeLevel::ReadWrite,
    );
    state = add_role_to_state(state, user_role);

    let viewer_role: Role = create_role(
        3, Str::from("viewer"), RoleType::Regular, 2, PrivilegeLevel::Read,
    );
    state = add_role_to_state(state, viewer_role);

    state = add_user_to_role(state, 1, 1001);
    state = add_user_to_role(state, 2, 1002);
    state = add_user_to_role(state, 3, 1003);

    let perm_read: Permission = create_permission(
        101, Str::from("file_read"), 1, 0x01, PrivilegeLevel::Read,
    );
    state = add_permission_to_state(state, perm_read);
    state = add_permission_to_role(state, 3, 101);

    let perm_write: Permission = create_permission(
        102, Str::from("file_write"), 1, 0x02, PrivilegeLevel::Write,
    );
    state = add_permission_to_state(state, perm_write);
    state = add_permission_to_role(state, 2, 102);

    let context: AccessContext = AccessContext{
        context_id: 1,
        context_type: AccessContextType::Normal,
        session_id: 5001,
        elevation_count: 0,
        elevation_method: ElevationMethod::Password,
        start_time: 0,
        expiry_time: 0,
        justification: Str::from("Standard session"),
        audit_required: true,
        restricted_operations: 0,
    };

    let caps: CapabilitySet = CapabilitySet{
        user_id: 1001,
        rights_mask: 0x01,
        rights_count: 1,
        rights: Array::splat(CapabilityRight::CapRead),
        delegated_from: 0,
        delegation_depth: 0,
        expiry: 0,
        audited: true,
    };

    let (decision, request): (AccessDecision, AccessRequest) = make_access_decision(
        state, 1003, 1, 0x01, context, caps,
    );

    let user_max: PrivilegeLevel = get_user_max_privilege(state, 1001);
    let role_check: bool = check_role_membership(state, 1001, 1);

    let review: AccessReviewResult = perform_access_review(state, 1001, 9999);

    assert(state.role_count == 3, "access_control: roles created");
    assert(state.permission_count == 2, "access_control: permissions created");
    assert(role_check, "access_control: user in admin role");
    assert(user_max as u8 >= PrivilegeLevel::Admin as u8, "access_control: max privilege resolved");

    residual emit {
        op: "access_control.init_complete",
        roles: state.role_count,
        permissions: state.permission_count,
        tokens: state.token_count,
        last_decision: decision as u8,
        review_status: review.status as u8,
    };

    return state;
}
