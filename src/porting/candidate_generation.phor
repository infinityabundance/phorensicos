// ============================================================================
// candidate_generation.phor — Candidate Translation Generation with Scoring
// ============================================================================
// Candidate translation generation proposes native Phorensic operation
// sequences for each observed foreign operation. Each proposal is annotated
// with a confidence score based on observation count, replay success,
// oracle comparison results, and semantic complexity.
//
// Candidate translations are never trusted directly. They must pass replay
// and court verification before promotion.
// ============================================================================

package "phorensic:candidate_generation:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type CandidateGenerationError = enum {
    NoOperatonsToTranslate = 0x01,
    CandidateBufferFull = 0x02,
    ConfidenceBelowThreshold = 0x03,
    TranslationNotPossible = 0x04,
    EvidenceChainBroken = 0x05,
    AmbiguousMapping = 0x06,
    MissingSemanticAnalysis = 0x07,
    DependencyCycle = 0x08,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Native Operation Sequence
// ============================================================================

type NativeOp = struct {
    op_name: FixedString[128],
    parameters_hash: Hash256,
    expected_effects: Array[FixedString[64], 8],
    effect_count: u64,
    needs_capability: FixedString[128],
    is_bounded: bool,
    bound_value: u64,
    is_deterministic: bool,
    expected_latency_us: u64,
}

type NativeOpSequence = struct {
    ops: Array[NativeOp, 64],
    op_count: u64,
    sequence_hash: Hash256,
}

// ============================================================================
// Evidence Reference
// ============================================================================

type EvidenceRef = struct {
    evidence_type: EvidenceType,
    evidence_hash: Hash256,
    timestamp: u64,
    description: FixedString[256],
}

type EvidenceType = enum {
    CageExecution = 0x01,
    ResidualBundle = 0x02,
    ReplayReport = 0x03,
    OracleComparison = 0x04,
    CourtVerdict = 0x05,
    ObservationSession = 0x06,
    SemanticAnalysis = 0x07,
    ManualReview = 0x08,
    Unknown = 0xFF,
}

// ============================================================================
// Candidate Translation
// ============================================================================

type CandidateTranslation = struct {
    candidate_id: u64,
    foreign_operation: FixedString[128],
    foreign_operation_hash: Hash256,
    native_sequence: NativeOpSequence,
    confidence_score: u64,
    observation_count: u64,
    replay_count: u64,
    oracle_match_count: u64,
    oracle_total_count: u64,
    complexity_score: u64,
    is_replay_verified: bool,
    is_oracle_verified: bool,
    evidence_chain: Array[EvidenceRef, 32],
    evidence_count: u64,
    alternative_sequences: Array[NativeOpSequence, 8],
    alternative_count: u64,
    semantic_analysis_ref: Hash256,
    generated_at: u64,
    generation: u64,
}

// ============================================================================
// Candidate Generation Session
// ============================================================================

type CandidateGenerationSession = struct {
    session_id: Hash256,
    extraction_bundle_hash: Hash256,
    candidates: Array[CandidateTranslation, 512],
    candidate_count: u64,
    analysis_hash: Hash256,
    total_foreign_ops: u64,
    translated_ops: u64,
    untranslatable_ops: u64,
    average_confidence: u64,
    confidence_threshold: u64,
    is_finalized: bool,
    started_at: u64,
    completed_at: u64,
    generation: u64,
}

// ============================================================================
// Create Candidate Generation Session
// ============================================================================

fn create_candidate_session(extraction_bundle_hash: Hash256, confidence_threshold: u64) -> CandidateGenerationSession
    effects: [compute]
{
    let empty_candidates: Array[CandidateTranslation, 512] = Array[CandidateTranslation, 512]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    return CandidateGenerationSession {
        session_id: zero_hash,
        extraction_bundle_hash: extraction_bundle_hash,
        candidates: empty_candidates,
        candidate_count: 0,
        analysis_hash: zero_hash,
        total_foreign_ops: 0,
        translated_ops: 0,
        untranslatable_ops: 0,
        average_confidence: 0,
        confidence_threshold: confidence_threshold,
        is_finalized: false,
        started_at: kernel.tick_count(),
        completed_at: 0,
        generation: 1,
    };
}

// ============================================================================
// Generate Candidate for Foreign Operation
// ============================================================================

fn generate_candidate(session: &mut CandidateGenerationSession, foreign_op: &FixedString[128], op_hash: Hash256, observation_count: u64, analysis_hash: Hash256) -> Result[u64, CandidateGenerationError]
    effects: [compute, residual]
{
    if session.candidate_count >= 512 {
        return Err(CandidateGenerationError::CandidateBufferFull);
    }

    // Create native sequence based on operation characteristics
    let native_seq: NativeOpSequence = propose_native_sequence(foreign_op, op_hash);

    // Compute confidence score
    let confidence: u64 = compute_confidence(foreign_op, observation_count, native_seq.op_count);

    // Skip candidates below threshold
    if confidence < session.confidence_threshold {
        session.untranslatable_ops = session.untranslatable_ops + 1;

        @emit_residual("candidate_generation.skipped", "candidate_below_threshold", confidence);
        return Err(CandidateGenerationError::ConfidenceBelowThreshold);
    }

    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_alternatives: Array[NativeOpSequence, 8] = Array[NativeOpSequence, 8]::zeroed();
    let empty_evidence: Array[EvidenceRef, 32] = Array[EvidenceRef, 32]::zeroed();

    let candidate: CandidateTranslation = CandidateTranslation {
        candidate_id: session.candidate_count,
        foreign_operation: *foreign_op,
        foreign_operation_hash: op_hash,
        native_sequence: native_seq,
        confidence_score: confidence,
        observation_count: observation_count,
        replay_count: 0,
        oracle_match_count: 0,
        oracle_total_count: 0,
        complexity_score: native_seq.op_count * 10,
        is_replay_verified: false,
        is_oracle_verified: false,
        evidence_chain: empty_evidence,
        evidence_count: 0,
        alternative_sequences: empty_alternatives,
        alternative_count: 0,
        semantic_analysis_ref: analysis_hash,
        generated_at: kernel.tick_count(),
        generation: session.generation,
    };

    session.candidates[session.candidate_count] = candidate;
    session.candidate_count = session.candidate_count + 1;
    session.translated_ops = session.translated_ops + 1;

    @emit_residual("candidate_generation.generate", "candidate_generated", session.candidate_count);

    return Ok(candidate.candidate_id);
}

// ============================================================================
// Propose Native Sequence
// ============================================================================
// Proposes a native Phorensic operation sequence for a given foreign op.

fn propose_native_sequence(foreign_op: &FixedString[128], op_hash: Hash256) -> NativeOpSequence
    effects: [compute]
{
    let empty_ops: Array[NativeOp, 64] = Array[NativeOp, 64]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    let mut sequence: NativeOpSequence = NativeOpSequence {
        ops: empty_ops,
        op_count: 0,
        sequence_hash: zero_hash,
    };

    // Map based on foreign operation name patterns
    if foreign_op.len >= 3 {
        // File I/O operations
        if (foreign_op.data[0] == 'o' as u8 && foreign_op.data[1] == 'p' as u8 && foreign_op.data[2] == 'e' as u8) ||
           (foreign_op.data[0] == 'f' as u8 && foreign_op.data[1] == 'o' as u8 && foreign_op.data[2] == 'p' as u8) {
            // open/fopen → store.resolve + get_capability
            let empty_effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            let mut effects: Array[FixedString[64], 8] = empty_effects;
            effects[0] = FixedString[64]::from_literal("io:read");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("store.resolve_node"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::from_literal("filesystem_read"),
                is_bounded: true,
                bound_value: 1000,
                is_deterministic: true,
                expected_latency_us: 50,
            };
            sequence.ops[1] = NativeOp {
                op_name: FixedString[128]::from_literal("capability.acquire_read"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::from_literal("capability_derive"),
                is_bounded: true,
                bound_value: 100,
                is_deterministic: true,
                expected_latency_us: 10,
            };
            sequence.op_count = 2;
        } elif (foreign_op.data[0] == 'r' as u8 && foreign_op.data[1] == 'e' as u8 && foreign_op.data[2] == 'a' as u8) ||
                (foreign_op.data[0] == 'f' as u8 && foreign_op.data[1] == 'r' as u8 && foreign_op.data[2] == 'e' as u8) {
            // read/fread → store.read_bytes
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("io:read");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("store.read_bytes"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::from_literal("filesystem_read"),
                is_bounded: true,
                bound_value: 65536,
                is_deterministic: true,
                expected_latency_us: 100,
            };
            sequence.op_count = 1;
        } elif (foreign_op.data[0] == 'w' as u8 && foreign_op.data[1] == 'r' as u8 && foreign_op.data[2] == 'i' as u8) ||
                (foreign_op.data[0] == 'f' as u8 && foreign_op.data[1] == 'w' as u8 && foreign_op.data[2] == 'r' as u8) {
            // write/fwrite → store.write_bytes
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("io:write");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("store.write_bytes"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::from_literal("filesystem_write"),
                is_bounded: true,
                bound_value: 65536,
                is_deterministic: true,
                expected_latency_us: 100,
            };
            sequence.op_count = 1;
        } elif (foreign_op.data[0] == 'c' as u8 && foreign_op.data[1] == 'l' as u8 && foreign_op.data[2] == 'o' as u8) ||
                (foreign_op.data[0] == 'f' as u8 && foreign_op.data[1] == 'c' as u8 && foreign_op.data[2] == 'l' as u8) {
            // close/fclose → capability.drop
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("capability:drop");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("capability.drop"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::from_literal("capability_manage"),
                is_bounded: true,
                bound_value: 10,
                is_deterministic: true,
                expected_latency_us: 5,
            };
            sequence.op_count = 1;
        } elif (foreign_op.data[0] == 'm' as u8 && foreign_op.data[1] == 'a' as u8 && foreign_op.data[2] == 'l' as u8) ||
                (foreign_op.data[0] == 'c' as u8 && foreign_op.data[1] == 'a' as u8 && foreign_op.data[2] == 'l' as u8) {
            // malloc/calloc → memory.allocate_bounded
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("memory:allocate");
            effects[1] = FixedString[64]::from_literal("compute");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("memory.allocate_bounded"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 2,
                needs_capability: FixedString[128]::from_literal("memory_alloc"),
                is_bounded: true,
                bound_value: 1048576,
                is_deterministic: false,
                expected_latency_us: 20,
            };
            sequence.op_count = 1;
        } elif (foreign_op.data[0] == 'f' as u8 && foreign_op.data[1] == 'r' as u8 && foreign_op.data[2] == 'e' as u8) {
            // free → memory.release
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("memory:release");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("memory.release"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::from_literal("memory_alloc"),
                is_bounded: true,
                bound_value: 10,
                is_deterministic: true,
                expected_latency_us: 5,
            };
            sequence.op_count = 1;
        } elif (foreign_op.data[0] == 'm' as u8 && foreign_op.data[1] == 'e' as u8 && foreign_op.data[2] == 'm' as u8) {
            // memcpy/memset → memory.copy / memory.set
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("memory:access");
            effects[1] = FixedString[64]::from_literal("compute");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("memory.copy_bounded"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 2,
                needs_capability: FixedString[128]::from_literal("memory_access"),
                is_bounded: true,
                bound_value: 65536,
                is_deterministic: true,
                expected_latency_us: 30,
            };
            sequence.op_count = 1;
        } elif (foreign_op.data[0] == 's' as u8 && foreign_op.data[1] == 't' as u8 && foreign_op.data[2] == 'r' as u8) {
            // strlen/strcmp → string.ops
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("compute");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("string.bounded_operation"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::zeroed(),
                is_bounded: true,
                bound_value: 4096,
                is_deterministic: true,
                expected_latency_us: 15,
            };
            sequence.op_count = 1;
        } else {
            // Generic computation operation
            let mut effects: Array[FixedString[64], 8] = Array[FixedString[64], 8]::zeroed();
            effects[0] = FixedString[64]::from_literal("compute");

            sequence.ops[0] = NativeOp {
                op_name: FixedString[128]::from_literal("compute.generic"),
                parameters_hash: op_hash,
                expected_effects: effects,
                effect_count: 1,
                needs_capability: FixedString[128]::zeroed(),
                is_bounded: true,
                bound_value: 100000,
                is_deterministic: true,
                expected_latency_us: 100,
            };
            sequence.op_count = 1;
        }
    }

    // Compute sequence hash
    let mut seq_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..sequence.op_count {
        for j in 0..sequence.ops[i].op_name.len {
            let idx: u64 = (i + j) & 31;
            seq_hash.bytes[idx] = seq_hash.bytes[idx] ^ sequence.ops[i].op_name.data[j];
        }
    }
    sequence.sequence_hash = seq_hash;

    return sequence;
}

// ============================================================================
// Compute Confidence Score
// ============================================================================

fn compute_confidence(foreign_op: &FixedString[128], observation_count: u64, native_op_count: u64) -> u64
    effects: [compute]
{
    let mut confidence: u64 = 50;  // Base confidence

    // Observation count bonus
    if observation_count >= 10 {
        confidence = confidence + 20;
    } elif observation_count >= 5 {
        confidence = confidence + 10;
    } elif observation_count >= 2 {
        confidence = confidence + 5;
    }

    // Simpler sequences (fewer native ops) get higher confidence
    if native_op_count <= 1 {
        confidence = confidence + 15;
    } elif native_op_count <= 3 {
        confidence = confidence + 5;
    } else {
        confidence = if confidence > 10 { confidence - 10 } else { confidence };
    }

    // Cap at 100
    if confidence > 100 {
        confidence = 100;
    }

    return confidence;
}

// ============================================================================
// Add Alternative Sequence
// ============================================================================

fn add_alternative_sequence(candidate: &mut CandidateTranslation, sequence: NativeOpSequence) -> Result<(), CandidateGenerationError>
    effects: [compute, residual]
{
    if candidate.alternative_count >= 8 {
        return Err(CandidateGenerationError::CandidateBufferFull);
    }

    candidate.alternative_sequences[candidate.alternative_count] = sequence;
    candidate.alternative_count = candidate.alternative_count + 1;

    return Ok(());
}

// ============================================================================
// Add Evidence Reference
// ============================================================================

fn add_candidate_evidence(candidate: &mut CandidateTranslation, evidence_type: EvidenceType, evidence_hash: Hash256, desc: &FixedString[256]) -> Result<(), CandidateGenerationError>
    effects: [compute, residual]
{
    if candidate.evidence_count >= 32 {
        return Err(CandidateGenerationError::EvidenceChainBroken);
    }

    candidate.evidence_chain[candidate.evidence_count] = EvidenceRef {
        evidence_type: evidence_type,
        evidence_hash: evidence_hash,
        timestamp: kernel.tick_count(),
        description: *desc,
    };
    candidate.evidence_count = candidate.evidence_count + 1;

    return Ok(());
}

// ============================================================================
// Mark Replay Verified
// ============================================================================

fn mark_candidate_replay_verified(candidate: &mut CandidateTranslation, success: bool) -> Result<(), CandidateGenerationError>
    effects: [compute, residual]
{
    candidate.replay_count = candidate.replay_count + 1;
    if success {
        candidate.is_replay_verified = true;
        candidate.confidence_score = if candidate.confidence_score + 10 > 100 { 100 } else { candidate.confidence_score + 10 };
    } else {
        candidate.confidence_score = if candidate.confidence_score > 10 { candidate.confidence_score - 10 } else { candidate.confidence_score };
    }

    return Ok(());
}

// ============================================================================
// Mark Oracle Verified
// ============================================================================

fn mark_candidate_oracle_verified(candidate: &mut CandidateTranslation, match_count: u64, total_count: u64) -> Result<(), CandidateGenerationError>
    effects: [compute, residual]
{
    candidate.oracle_match_count = candidate.oracle_match_count + match_count;
    candidate.oracle_total_count = candidate.oracle_total_count + total_count;

    if match_count == total_count && total_count > 0 {
        candidate.is_oracle_verified = true;
        candidate.confidence_score = if candidate.confidence_score + 15 > 100 { 100 } else { candidate.confidence_score + 15 };
    } else if total_count > 0 {
        let ratio: u64 = (match_count * 100) / total_count;
        if ratio >= 80 {
            candidate.confidence_score = if candidate.confidence_score + 5 > 100 { 100 } else { candidate.confidence_score + 5 };
        }
    }

    return Ok(());
}

// ============================================================================
// Get Candidate By ID
// ============================================================================

fn get_candidate(session: &CandidateGenerationSession, candidate_id: u64) -> Result<&CandidateTranslation, CandidateGenerationError>
    effects: [compute]
{
    if candidate_id >= session.candidate_count {
        return Err(CandidateGenerationError::CandidateBufferFull);
    }
    return Ok(session.candidates[candidate_id]);
}

// ============================================================================
// Get Candidates Above Threshold
// ============================================================================

fn get_candidates_above_threshold(session: &CandidateGenerationSession, threshold: u64) -> Result[Array[CandidateTranslation, 512], CandidateGenerationError]
    effects: [compute]
{
    let mut results: Array[CandidateTranslation, 512] = Array[CandidateTranslation, 512]::zeroed();
    let mut count: u64 = 0;

    for i in 0..session.candidate_count {
        if session.candidates[i].confidence_score >= threshold {
            if count < 512 {
                results[count] = session.candidates[i];
                count = count + 1;
            }
        }
    }

    return Ok(results);
}

// ============================================================================
// Finalize Candidate Session
// ============================================================================

fn finalize_candidate_session(session: &mut CandidateGenerationSession) -> Result[Hash256, CandidateGenerationError]
    effects: [compute, residual]
{
    // Compute average confidence
    if session.candidate_count > 0 {
        let mut total_conf: u64 = 0;
        for i in 0..session.candidate_count {
            total_conf = total_conf + session.candidates[i].confidence_score;
        }
        session.average_confidence = total_conf / session.candidate_count;
    }

    session.completed_at = kernel.tick_count();
    session.is_finalized = true;

    @emit_residual("candidate_generation.finalize", "session_finalized", session.candidate_count);

    return Ok(Hash256 { bytes: Array[u8, 32]::zeroed() });
}

// ============================================================================
// Get Session Stats
// ============================================================================

type CandidateSessionStats = struct {
    total_candidates: u64,
    translated_ops: u64,
    untranslatable_ops: u64,
    average_confidence: u64,
    threshold: u64,
    high_confidence_count: u64,
    medium_confidence_count: u64,
    low_confidence_count: u64,
    replay_verified_count: u64,
    oracle_verified_count: u64,
    is_finalized: bool,
    duration_us: u64,
}

fn get_session_stats(session: &CandidateGenerationSession) -> CandidateSessionStats
    effects: [compute]
{
    let mut high: u64 = 0;
    let mut medium: u64 = 0;
    let mut low: u64 = 0;
    let mut replay_verified: u64 = 0;
    let mut oracle_verified: u64 = 0;

    for i in 0..session.candidate_count {
        if session.candidates[i].confidence_score >= 80 {
            high = high + 1;
        } elif session.candidates[i].confidence_score >= 50 {
            medium = medium + 1;
        } else {
            low = low + 1;
        }
        if session.candidates[i].is_replay_verified {
            replay_verified = replay_verified + 1;
        }
        if session.candidates[i].is_oracle_verified {
            oracle_verified = oracle_verified + 1;
        }
    }

    let duration: u64 = if session.is_finalized {
        session.completed_at - session.started_at
    } else {
        kernel.tick_count() - session.started_at
    };

    return CandidateSessionStats {
        total_candidates: session.candidate_count,
        translated_ops: session.translated_ops,
        untranslatable_ops: session.untranslatable_ops,
        average_confidence: session.average_confidence,
        threshold: session.confidence_threshold,
        high_confidence_count: high,
        medium_confidence_count: medium,
        low_confidence_count: low,
        replay_verified_count: replay_verified,
        oracle_verified_count: oracle_verified,
        is_finalized: session.is_finalized,
        duration_us: duration,
    };
}

// ============================================================================
// Batch Candidate Generation
// ============================================================================
// Generates candidates for multiple foreign operations in a single pass.

fn batch_generate_candidates(session: &mut CandidateGenerationSession, foreign_ops: &Array[(FixedString[128], Hash256, u64), 256], op_count: u64, analysis_hash: Hash256) -> Result<u64, CandidateGenerationError>
    effects: [compute, residual]
{
    let mut generated_count: u64 = 0;

    for i in 0..op_count {
        let (op_name, op_hash, obs_count): (FixedString[128], Hash256, u64) = foreign_ops[i];
        if op_name.len == 0 {
            break;
        }

        match generate_candidate(session, &op_name, op_hash, obs_count, analysis_hash) {
            Ok(_) => {
                generated_count = generated_count + 1;
            }
            Err(e) => {
                // Skip candidates below threshold, continue with rest
                if e != CandidateGenerationError::ConfidenceBelowThreshold {
                    // Log error but continue
                }
            }
        }
    }

    @emit_residual("candidate_generation.batch", "batch_candidates_generated", generated_count);

    return Ok(generated_count);
}

// ============================================================================
// Rank Candidates by Confidence
// ============================================================================
// Returns candidates sorted by confidence score (highest first).

fn rank_candidates_by_confidence(session: &CandidateGenerationSession) -> Result[Array[CandidateTranslation, 512], CandidateGenerationError>
    effects: [compute]
{
    let mut sorted: Array[CandidateTranslation, 512] = Array[CandidateTranslation, 512]::zeroed();
    let count: u64 = session.candidate_count;

    // Copy candidates
    for i in 0..count {
        sorted[i] = session.candidates[i];
    }

    // Simple bubble sort by confidence (descending)
    for i in 0..count {
        for j in 0..(count - 1 - i) {
            if sorted[j].confidence_score < sorted[j + 1].confidence_score {
                let tmp: CandidateTranslation = sorted[j];
                sorted[j] = sorted[j + 1];
                sorted[j + 1] = tmp;
            }
        }
    }

    return Ok(sorted);
}

// ============================================================================
// Find Translation for Foreign Operation
// ============================================================================

fn find_translation_for_op(session: &CandidateGenerationSession, foreign_op_name: &FixedString[128]) -> Option[CandidateTranslation]
    effects: [compute]
{
    for i in 0..session.candidate_count {
        if session.candidates[i].foreign_operation == *foreign_op_name {
            return Option::Some(session.candidates[i]);
        }
    }
    return Option::None;
}

// ============================================================================
// Export Candidate Session Summary
// ============================================================================

type CandidateExportSummary = struct {
    session_id: Hash256,
    total_count: u64,
    above_threshold: u64,
    below_threshold: u64,
    average_confidence: u64,
    top_confidence: u64,
    lowest_confidence: u64,
    is_finalized: bool,
    duration_us: u64,
    extraction_bundle_ref: Hash256,
}

fn export_candidate_summary(session: &CandidateGenerationSession) -> CandidateExportSummary
    effects: [compute]
{
    let mut top_conf: u64 = 0;
    let mut low_conf: u64 = 100;

    for i in 0..session.candidate_count {
        if session.candidates[i].confidence_score > top_conf {
            top_conf = session.candidates[i].confidence_score;
        }
        if session.candidates[i].confidence_score < low_conf {
            low_conf = session.candidates[i].confidence_score;
        }
    }

    let duration: u64 = if session.is_finalized {
        session.completed_at - session.started_at
    } else {
        kernel.tick_count() - session.started_at
    };

    return CandidateExportSummary {
        session_id: session.session_id,
        total_count: session.candidate_count + session.untranslatable_ops,
        above_threshold: session.candidate_count,
        below_threshold: session.untranslatable_ops,
        average_confidence: session.average_confidence,
        top_confidence: top_conf,
        lowest_confidence: if low_conf == 100 { 0 } else { low_conf },
        is_finalized: session.is_finalized,
        duration_us: duration,
        extraction_bundle_ref: session.extraction_bundle_hash,
    };
}
