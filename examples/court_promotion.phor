// court_promotion.phor — Court Session & Promotion to Sealed
//
// Demonstrates the full trust promotion lifecycle:
//   1. Evidence submission to court
//   2. Replay verification against oracle traces
//   3. Court verdict computation (test pass/fail counts)
//   4. Trust level promotion (Observed -> Replayed -> OracleCompared -> ResidualStable -> Sealed)
//   5. Evidence receipt with cryptographic hash
//   6. Final sealed package with residual fingerprint
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:court_promotion:v1.0";

// ── Constants ───────────────────────────────────────────

const MAX_EVIDENCE_ITEMS: u64 = 32;
const MAX_ORACLE_TRACES: u64 = 16;
const MAX_VERDICT_HISTORY: u64 = 64;
const MAX_JUDGES: u64 = 8;
const MAX_EVIDENCE_BYTES: u64 = 256;
const SEAL_HASH_SIZE: u64 = 32;
const MAX_RESIDUAL_FIELDS: u64 = 8;

// ── Trust Levels ────────────────────────────────────────

const TRUST_UNKNOWN: u64 = 0;
const TRUST_OBSERVED: u64 = 1;
const TRUST_REPLAYED: u64 = 2;
const TRUST_ORACLE_COMPARED: u64 = 3;
const TRUST_RESIDUAL_STABLE: u64 = 4;
const TRUST_SEALED: u64 = 5;
const TRUST_PROMOTED: u64 = 6;

// ── Verdict Types ───────────────────────────────────────

const VERDICT_CONSISTENT: u64 = 0;
const VERDICT_INCONSISTENT: u64 = 1;
const VERDICT_IDENTICAL: u64 = 2;
const VERDICT_DIVERGENT: u64 = 3;
const VERDICT_INCONCLUSIVE: u64 = 4;
const VERDICT_PROMOTE: u64 = 5;
const VERDICT_DENY: u64 = 6;

// ── Evidence Item ───────────────────────────────────────

struct EvidenceItem {
    item_id: u64,
    name: Str(64),
    data: Array(u8, 256),
    data_size: u64,
    hash: Array(u8, 32),
    captured_at_tick: u64,
    verified: bool,
}

impl EvidenceItem {
    fn new(id: u64, name: Str(64)) -> EvidenceItem
        effect [compute]
    {
        return EvidenceItem {
            item_id: id,
            name: name,
            data: Array::zeroed(),
            data_size: 0,
            hash: Array::zeroed(),
            captured_at_tick: 0,
            verified: false,
        };
    }

    fn set_data(mut self, data: Array(u8, 256), size: u64, tick: u64) -> EvidenceItem
        effect [compute]
    {
        self.data = data;
        self.data_size = size;
        self.captured_at_tick = tick;
        self.hash = compute_hash(data, size);
        return self;
    }

    fn verify_hash(self) -> bool
        effect [compute]
    {
        let computed: Array(u8, 32) = compute_hash(self.data, self.data_size);
        return compare_hashes(self.hash, computed);
    }

    fn mark_verified(mut self) -> EvidenceItem
        effect [compute]
    {
        let ok: bool = self.verify_hash();
        if ok {
            self.verified = true;
        }
        return self;
    }

    fn is_verified(self) -> bool
        effect [compute]
    {
        return self.verified;
    }
}

// ── Oracle Trace ────────────────────────────────────────

struct OracleTrace {
    trace_id: u64,
    component: Str(64),
    input_hash: Array(u8, 32),
    output_hash: Array(u8, 32),
    expected_hash: Array(u8, 32),
    matched: bool,
}

impl OracleTrace {
    fn new(id: u64, component: Str(64)) -> OracleTrace
        effect [compute]
    {
        return OracleTrace {
            trace_id: id,
            component: component,
            input_hash: Array::zeroed(),
            output_hash: Array::zeroed(),
            expected_hash: Array::zeroed(),
            matched: false,
        };
    }

    fn set_hashes(mut self, input: Array(u8, 32), output: Array(u8, 32), expected: Array(u8, 32)) -> OracleTrace
        effect [compute]
    {
        self.input_hash = input;
        self.output_hash = output;
        self.expected_hash = expected;
        self.matched = compare_hashes(output, expected);
        return self;
    }

    fn compare(self) -> bool
        effect [compute]
    {
        return compare_hashes(self.output_hash, self.expected_hash);
    }
}

// ── Court Session ───────────────────────────────────────

struct CourtSession {
    session_id: u64,
    name: Str(64),
    active: bool,
    evidence: Array(EvidenceItem, 32),
    oracle_traces: Array(OracleTrace, 16),
    verdicts: Array(u64, 64),
    evidence_count: u64,
    trace_count: u64,
    verdict_count: u64,
    tests_passed: u64,
    tests_failed: u64,
    current_trust: u64,
}

impl CourtSession {
    fn new(id: u64, name: Str(64)) -> CourtSession
        effect [compute]
    {
        return CourtSession {
            session_id: id,
            name: name,
            active: true,
            evidence: Array::zeroed(),
            oracle_traces: Array::zeroed(),
            verdicts: Array::splat(VERDICT_INCONCLUSIVE),
            evidence_count: 0,
            trace_count: 0,
            verdict_count: 0,
            tests_passed: 0,
            tests_failed: 0,
            current_trust: TRUST_UNKNOWN,
        };
    }

    fn submit_evidence(mut self, item: EvidenceItem) -> CourtSession
        effect [compute, residual]
    {
        if self.evidence_count < MAX_EVIDENCE_ITEMS {
            self.evidence[self.evidence_count] = item;
            self.evidence_count = self.evidence_count + 1;

            residual emit {
                op: "court.evidence_submitted",
                session_id: self.session_id,
                item: item.name,
            };
        }
        return self;
    }

    fn add_oracle(mut self, trace: OracleTrace) -> CourtSession
        effect [compute]
    {
        if self.trace_count < MAX_ORACLE_TRACES {
            self.oracle_traces[self.trace_count] = trace;
            self.trace_count = self.trace_count + 1;
        }
        return self;
    }

    fn run_replay(mut self) -> CourtSession
        effect [compute, residual]
    {
        // Replay each evidence item against oracle traces
        for i in 0..self.evidence_count {
            let evidence: EvidenceItem = self.evidence[i];
            let mut matched_oracle: bool = false;

            for j in 0..self.trace_count {
                if self.oracle_traces[j].compare() {
                    matched_oracle = true;
                }
            }

            if matched_oracle {
                self.tests_passed = self.tests_passed + 1;
                self.verdicts[self.verdict_count] = VERDICT_CONSISTENT;
            } else {
                self.tests_failed = self.tests_failed + 1;
                self.verdicts[self.verdict_count] = VERDICT_DIVERGENT;
            }
            self.verdict_count = self.verdict_count + 1;
        }

        residual emit {
            op: "court.replay_complete",
            session_id: self.session_id,
            passed: self.tests_passed,
            failed: self.tests_failed,
        };

        return self;
    }

    fn compute_verdict(self) -> u64
        effect [compute]
    {
        if self.tests_failed > 0 {
            if self.tests_passed > self.tests_failed {
                return VERDICT_INCONSISTENT;
            }
            return VERDICT_DIVERGENT;
        }
        if self.tests_passed > 0 {
            return VERDICT_IDENTICAL;
        }
        return VERDICT_INCONCLUSIVE;
    }

    fn promote_trust(mut self) -> CourtSession
        effect [compute, residual]
    {
        let verdict: u64 = self.compute_verdict();

        if verdict == VERDICT_IDENTICAL || verdict == VERDICT_CONSISTENT {
            if self.current_trust < TRUST_SEALED {
                self.current_trust = self.current_trust + 1;
            }

            residual emit {
                op: "court.trust_promoted",
                session_id: self.session_id,
                from_level: self.current_trust - 1,
                to_level: self.current_trust,
            };
        } else if verdict == VERDICT_DIVERGENT {
            if self.current_trust > TRUST_UNKNOWN {
                self.current_trust = self.current_trust - 1;
            }
        }

        return self;
    }

    fn close(mut self) -> CourtSession
        effect [compute, residual]
    {
        self.active = false;

        residual emit {
            op: "court.session_closed",
            session_id: self.session_id,
            final_trust: self.current_trust,
        };

        return self;
    }

    fn is_active(self) -> bool
        effect [compute]
    {
        return self.active;
    }

    fn trust_level(self) -> u64
        effect [compute]
    {
        return self.current_trust;
    }
}

// ── Sealed Package ──────────────────────────────────────

struct SealedPackage {
    package_name: Str(64),
    evidence_hash: Array(u8, 32),
    trust_level: u64,
    seal_hash: Array(u8, 32),
    sealed: bool,
    promotion_history: Array(u64, 8),
    history_depth: u64,
    residual_fingerprint: Array(u8, 32),
}

impl SealedPackage {
    fn new(name: Str(64)) -> SealedPackage
        effect [compute]
    {
        return SealedPackage {
            package_name: name,
            evidence_hash: Array::zeroed(),
            trust_level: TRUST_OBSERVED,
            seal_hash: Array::zeroed(),
            sealed: false,
            promotion_history: Array::zeroed(),
            history_depth: 1,
            residual_fingerprint: Array::zeroed(),
        };
    }

    fn set_evidence_hash(mut self, hash: Array(u8, 32)) -> SealedPackage
        effect [compute]
    {
        self.evidence_hash = hash;
        return self;
    }

    fn promote_to(mut self, level: u64) -> SealedPackage
        effect [compute, residual]
    {
        self.promotion_history[self.history_depth] = level;
        self.history_depth = self.history_depth + 1;
        self.trust_level = level;

        residual emit {
            op: "seal.promotion",
            pkg_name: self.package_name,
            level: level,
        };

        return self;
    }

    fn seal(mut self) -> SealedPackage
        effect [compute, residual]
    {
        // Compute seal hash from evidence hash and trust level
        let mut seal_data: Array(u8, 256) = Array::zeroed();
        for i in 0..32 {
            seal_data[i] = self.evidence_hash[i];
        }
        seal_data[32] = self.trust_level as u8;
        self.seal_hash = compute_hash(seal_data, 40);
        self.sealed = true;
        self.trust_level = TRUST_SEALED;

        residual emit {
            op: "seal.package_sealed",
            pkg_name: self.package_name,
            seal_hash_byte: self.seal_hash[0] as u64,
        };

        return self;
    }

    fn is_sealed(self) -> bool
        effect [compute]
    {
        return self.sealed;
    }

    fn get_trust(self) -> u64
        effect [compute]
    {
        return self.trust_level;
    }

    fn verify_seal(self) -> bool
        effect [compute]
    {
        if !self.sealed { return false; }
        // Recompute and verify
        let mut seal_data: Array(u8, 256) = Array::zeroed();
        for i in 0..32 {
            seal_data[i] = self.evidence_hash[i];
        }
        seal_data[32] = self.trust_level as u8;
        let recomputed: Array(u8, 32) = compute_hash(seal_data, 40);
        return compare_hashes(self.seal_hash, recomputed);
    }
}

// ── Hash and Utility Functions ─────────────────────────

fn compute_hash(data: Array(u8, 256), len: u64) -> Array(u8, 32)
    effect [compute]
{
    let mut hash: Array(u8, 32) = Array::zeroed();
    let mut accum: u64 = 5381;
    let limit: u64 = len.min(256);
    for i in 0..limit {
        accum = accum.wrapping_mul(33).wrapping_add(data[i] as u64);
    }
    for i in 0..8 {
        hash[i] = (accum >> (i * 8)) as u8;
    }
    return hash;
}

fn compare_hashes(a: Array(u8, 32), b: Array(u8, 32)) -> bool
    effect [compute]
{
    let mut match_all: bool = true;
    for i in 0..32 {
        if a[i] != b[i] {
            match_all = false;
        }
    }
    return match_all;
}

// ── Full Court Promotion Pipeline ──────────────────────

fn run_court_pipeline() -> bool
    effect [compute, residual]
{
    // ── Phase 1: Create evidence ──
    let mut ev_item: EvidenceItem = EvidenceItem::new(1, Str::from("memcpy_output"));
    let mut sample_data: Array(u8, 256) = Array::zeroed();
    sample_data[0] = 0x48; sample_data[1] = 0x65; sample_data[2] = 0x6C;
    sample_data[3] = 0x6C; sample_data[4] = 0x6F;
    ev_item = ev_item.set_data(sample_data, 8, 1000);
    ev_item = ev_item.mark_verified();
    assert(ev_item.is_verified(), "court: evidence verified");

    // ── Phase 2: Create oracle traces ──
    let mut expected_output: Array(u8, 256) = Array::zeroed();
    expected_output[0] = 0x48; expected_output[1] = 0x65; expected_output[2] = 0x6C;
    expected_output[3] = 0x6C; expected_output[4] = 0x6F;
    let expected_hash: Array(u8, 32) = compute_hash(expected_output, 8);

    let input_hash: Array(u8, 32) = compute_hash(sample_data, 8);
    let output_hash: Array(u8, 32) = compute_hash(expected_output, 8);

    let mut or_trace: OracleTrace = OracleTrace::new(1, Str::from("memcpy_oracle"));
    or_trace = or_trace.set_hashes(input_hash, output_hash, expected_hash);
    assert(or_trace.compare(), "court: oracle trace matches");

    // ── Phase 3: Hold court session ──
    let mut sess: CourtSession = CourtSession::new(1, Str::from("memcpy_porting"));
    assert(sess.is_active(), "court: session active");
    assert(sess.trust_level() == TRUST_UNKNOWN, "court: starts at Unknown");

    sess = sess.submit_evidence(ev_item);
    sess = sess.add_oracle(or_trace);
    sess = sess.run_replay();

    // Check replay results
    assert(sess.tests_passed >= 1, "court: at least one test passed");
    assert(sess.verdict_count >= 1, "court: at least one verdict");

    // Promote through trust ladder
    sess = sess.promote_trust();
    let trust_after_promote: u64 = sess.trust_level();
    assert(trust_after_promote > TRUST_UNKNOWN, "court: promoted from Unknown");

    // Promote again
    sess = sess.promote_trust();
    assert(sess.trust_level() > trust_after_promote, "court: promoted again");

    // Close session
    sess = sess.close();
    assert(!sess.is_active(), "court: session closed");

    // ── Phase 4: Seal the package ──
    let mut pkg: SealedPackage = SealedPackage::new(Str::from("memcpy_port"));
    pkg = pkg.set_evidence_hash(output_hash);
    pkg = pkg.promote_to(TRUST_OBSERVED);
    pkg = pkg.promote_to(TRUST_REPLAYED);
    pkg = pkg.promote_to(TRUST_ORACLE_COMPARED);
    pkg = pkg.promote_to(TRUST_RESIDUAL_STABLE);
    assert(pkg.get_trust() == TRUST_RESIDUAL_STABLE, "court: promoted to ResidualStable");

    pkg = pkg.seal();
    assert(pkg.is_sealed(), "court: package sealed");
    assert(pkg.get_trust() == TRUST_SEALED, "court: sealed at Sealed trust level");

    // Verify seal integrity
    let seal_valid: bool = pkg.verify_seal();
    assert(seal_valid, "court: seal verification passed");

    return true;
}

fn main(console: Cap(Console)) -> void
    effect [io:write, compute, residual]
{
    let passed: bool = run_court_pipeline();
    assert(passed, "court promotion: pipeline completed");

    console.write(Str::from("Court Promotion Pipeline:"));
    console.write(Str::from("  Phase 1 [Evidence]:   Court evidence submitted & verified"));
    console.write(Str::from("  Phase 2 [Oracle]:     Oracle trace captured & matched"));
    console.write(Str::from("  Phase 3 [Court]:      Replay session with verdicts"));
    console.write(Str::from("  Phase 4 [Promotion]:  Trust ladder: Unknown->Sealed"));
    console.write(Str::from("  Phase 5 [Seal]:       Package sealed with hash verification"));
    console.write(Str::from(""));
    console.write(Str::from("Court system validated!"));
    console.write(Str::from("Clean-room porting -> Court -> Sealed pipeline operational."));
}
