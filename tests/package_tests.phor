// package_tests.phor — Tests for sealed package verification and management
// Tests: container verification, source-seal rule enforcement, signatures
//
// Expected outcomes:
//   - Package containers are correctly structured with all required evidence sections
//   - Source-seal rule is enforced: no source → invalid package
//   - Source↔binary signatures are verified; independent signatures without seal are rejected
//   - Receipt chain verification passes for complete chains, fails for broken chains
//   - Package verification produces detailed reports with per-check status
//   - Trust state progression is preserved through package boundaries
//   - All verification operations are deterministic

package "phorensic:package_tests:v1.0";

// ============================================================================
// Section 1: Package Container Structure Tests
// ============================================================================

struct PackageContainer {
    package_name: Str(64),
    package_version: Str(16),
    source_hash: u64,
    binary_hash: u64,
    container_hash: u64,
    trust_state: u8,
    has_source: bool,
    has_binary: bool,
    has_signatures: bool,
    has_receipts: bool,
    has_court_evidence: bool,
}

fn test_package_header() -> void
    effect [io:write, io:read, residual]
{
    let pkg: PackageContainer = PackageContainer{
        package_name: Str::from("hello.phor-spec"),
        package_version: Str::from("1.0.0"),
        source_hash: 0xA1B2C3D4,
        binary_hash: 0xE5F6A7B8,
        container_hash: 0x12345678,
        trust_state: 5, // Sealed
        has_source: true,
        has_binary: true,
        has_signatures: true,
        has_receipts: true,
        has_court_evidence: false,
    };

    assert(pkg.package_name == Str::from("hello.phor-spec"), "pkg: package name");
    assert(pkg.package_version == Str::from("1.0.0"), "pkg: package version");
    assert(pkg.trust_state == 5, "pkg: Sealed trust state");

    residual emit {
        op: "pkg.header",
        name: pkg.package_name,
        version: pkg.package_version,
        trust: pkg.trust_state,
    };
}

fn test_package_sections_present() -> void
    effect [io:write, io:read, residual]
{
    // A complete package has these sections:
    //   - phor-package-header
    //   - source-evidence/
    //   - build-evidence/
    //   - expansion-evidence/
    //   - compilation-evidence/
    //   - binary-evidence/
    //   - replay-evidence/
    //   - court-evidence/
    //   - signatures/

    let pkg: PackageContainer = PackageContainer{
        package_name: Str::from("full.phor-spec"),
        package_version: Str::from("2.1.0"),
        source_hash: 0x11111111,
        binary_hash: 0x22222222,
        container_hash: 0x33333333,
        trust_state: 6, // Promoted
        has_source: true,
        has_binary: true,
        has_signatures: true,
        has_receipts: true,
        has_court_evidence: true,
    };

    assert(pkg.has_source, "pkg: source evidence present");
    assert(pkg.has_binary, "pkg: binary evidence present");
    assert(pkg.has_signatures, "pkg: signatures present");
    assert(pkg.has_receipts, "pkg: compilation receipts present");
    assert(pkg.has_court_evidence, "pkg: court evidence present");

    residual emit {
        op: "pkg.sections",
        source: if pkg.has_source { 1 } else { 0 },
        binary: if pkg.has_binary { 1 } else { 0 },
        signatures: if pkg.has_signatures { 1 } else { 0 },
        receipts: if pkg.has_receipts { 1 } else { 0 },
        court: if pkg.has_court_evidence { 1 } else { 0 },
    };
}

// ============================================================================
// Section 2: Source-Seal Rule Tests
// ============================================================================

struct PackageVerification {
    source_present: bool,
    source_hash_matches: bool,
    binary_hash_matches: bool,
    source_sig_valid: bool,
    binary_sig_valid: bool,
    seal_sig_valid: bool,
    build_recipe_present: bool,
    receipts_chain_valid: bool,
    replay_verified: bool,
}

fn test_source_seal_valid_package() -> void
    effect [io:write, io:read, residual]
{
    // All checks pass for a valid, correctly sealed package
    let check: PackageVerification = PackageVerification{
        source_present: true,
        source_hash_matches: true,
        binary_hash_matches: true,
        source_sig_valid: true,
        binary_sig_valid: true,
        seal_sig_valid: true,
        build_recipe_present: true,
        receipts_chain_valid: true,
        replay_verified: true,
    };

    let all_pass: bool = check.source_present
        && check.source_hash_matches
        && check.binary_hash_matches
        && check.source_sig_valid
        && check.binary_sig_valid
        && check.seal_sig_valid
        && check.build_recipe_present
        && check.receipts_chain_valid
        && check.replay_verified;

    assert(all_pass, "pkg: all source-seal checks pass for valid package");

    residual emit {
        op: "pkg.source_seal_valid",
        all_checks: 9,
        passed: 9,
    };
}

fn test_source_seal_missing_source() -> void
    effect [io:write, io:read, residual]
{
    // Missing source → invalid package
    let check: PackageVerification = PackageVerification{
        source_present: false,  // SOURCE MISSING
        source_hash_matches: false,
        binary_hash_matches: true,
        source_sig_valid: false,
        binary_sig_valid: true,
        seal_sig_valid: false,
        build_recipe_present: true,
        receipts_chain_valid: true,
        replay_verified: true,
    };

    let package_valid: bool = check.source_present
        && check.source_hash_matches;

    assert(!package_valid, "pkg: missing source → invalid package");

    residual emit {
        op: "pkg.source_seal_missing_source",
        valid: 0,
        reason: "source missing",
    };
}

fn test_source_seal_independent_signatures() -> void
    effect [io:write, io:read, residual]
{
    // Source and binary signed independently but NOT sealed together → invalid
    let check: PackageVerification = PackageVerification{
        source_present: true,
        source_hash_matches: true,
        binary_hash_matches: true,
        source_sig_valid: true,
        binary_sig_valid: true,
        seal_sig_valid: false, // SEAL SIGNATURE MISSING
        build_recipe_present: true,
        receipts_chain_valid: true,
        replay_verified: true,
    };

    // The source↔binary seal is separate from individual signatures
    let seal_valid: bool = check.source_present
        && check.source_sig_valid
        && check.binary_sig_valid
        && check.seal_sig_valid;

    assert(!seal_valid, "pkg: independent signatures without seal → invalid");

    residual emit {
        op: "pkg.source_seal_independent_sigs",
        seal_valid: 0,
        reason: "source and binary must be sealed together",
    };
}

// ============================================================================
// Section 3: Signature Verification Tests
// ============================================================================

struct SignatureSet {
    developer_sig_present: bool,
    developer_sig_valid: bool,
    auditor_count: u32,
    auditors_verified: u32,
    evidence_chain_sig_valid: bool,
}

fn test_signature_verification_all_valid() -> void
    effect [io:write, io:read, residual]
{
    let sigs: SignatureSet = SignatureSet{
        developer_sig_present: true,
        developer_sig_valid: true,
        auditor_count: 3,
        auditors_verified: 3,
        evidence_chain_sig_valid: true,
    };

    assert(sigs.developer_sig_present, "pkg: developer signature present");
    assert(sigs.developer_sig_valid, "pkg: developer signature valid");
    assert(sigs.auditor_count == sigs.auditors_verified, "pkg: all auditors verified");
    assert(sigs.evidence_chain_sig_valid, "pkg: evidence chain signature valid");

    residual emit {
        op: "pkg.signature_verify",
        dev_sig: 1,
        auditors: sigs.auditors_verified,
        evidence_chain: 1,
    };
}

fn test_signature_verification_failed_auditor() -> void
    effect [io:write, io:read, residual]
{
    let sigs: SignatureSet = SignatureSet{
        developer_sig_present: true,
        developer_sig_valid: true,
        auditor_count: 3,
        auditors_verified: 2, // One auditor failed
        evidence_chain_sig_valid: true,
    };

    let all_auditors_ok: bool = sigs.auditors_verified == sigs.auditor_count;
    assert(!all_auditors_ok, "pkg: failed auditor invalidates package");

    residual emit {
        op: "pkg.signature_auditor_fail",
        expected: sigs.auditor_count,
        verified: sigs.auditors_verified,
    };
}

// ============================================================================
// Section 4: Receipt Chain Tests
// ============================================================================

struct ReceiptChain {
    stage_count: u32,
    chain_valid: bool,
    first_broken_index: i32,
}

fn test_receipt_chain_complete() -> void
    effect [io:write, io:read, residual]
{
    // Complete chain: parse → expand → lower → optimize → codegen → link → seal
    let chain: ReceiptChain = ReceiptChain{
        stage_count: 7,
        chain_valid: true,
        first_broken_index: -1,
    };

    assert(chain.stage_count == 7, "pkg: complete 7-stage receipt chain");
    assert(chain.chain_valid, "pkg: chain valid");

    let stage_names: Array(Str(16), 7) = Array::splat(Str::from(""));
    // In a real test: each stage receipt has input_hash, output_hash, applied_rules
    // Verification: hash(chain[i-1].output) == chain[i].input

    residual emit {
        op: "pkg.receipt_chain_complete",
        stages: chain.stage_count,
        valid: 1,
    };
}

fn test_receipt_chain_broken() -> void
    effect [io:write, io:read, residual]
{
    // Broken chain at optimization stage
    let chain: ReceiptChain = ReceiptChain{
        stage_count: 7,
        chain_valid: false,
        first_broken_index: 3, // optimize stage hash mismatch
    };

    assert(!chain.chain_valid, "pkg: broken receipt chain detected");
    assert(chain.first_broken_index == 3, "pkg: broken at optimize stage (index 3)");

    residual emit {
        op: "pkg.receipt_chain_broken",
        broken_at: chain.first_broken_index,
    };
}

// ============================================================================
// Section 5: Build Evidence Tests
// ============================================================================

struct BuildEvidence {
    recipe: Str(128),
    dialect_profile: Str(32),
    compiler_version: Str(32),
    compiler_hash: u64,
    dependency_count: u32,
}

fn test_build_evidence_complete() -> void
    effect [io:write, io:read, residual]
{
    let build: BuildEvidence = BuildEvidence{
        recipe: Str::from("phorensic-build -c optimized -t x86_64"),
        dialect_profile: Str::from("native-phorensic-v1"),
        compiler_version: Str::from("phc 2.1.0"),
        compiler_hash: 0xABCD1234,
        dependency_count: 2,
    };

    assert(build.recipe.len() > 0, "pkg: build recipe present");
    assert(build.compiler_hash != 0, "pkg: compiler hash present");
    assert(build.dependency_count == 2, "pkg: 2 dependencies listed");

    residual emit {
        op: "pkg.build_evidence",
        compiler: build.compiler_version,
        deps: build.dependency_count,
    };
}

// ============================================================================
// Section 6: Package Verifier Tests
// ============================================================================

fn test_package_verifier_all_checks() -> void
    effect [io:write, io:read, residual]
{
    // The verifier checks:
    //   1. check_present(source_evidence)
    //   2. check_hash(source_hash, source_archive)
    //   3. check_present(binary_evidence)
    //   4. check_hash(binary_hash, executable_image)
    //   5. check_signature(source_sig, source_hash, trusted_keys)
    //   6. check_signature(binary_sig, binary_hash, trusted_keys)
    //   7. check_seal_signature(seal_sig, source_hash || binary_hash, trusted_keys)
    //   8. check_present(build_recipe)
    //   9. check_receipts_chain(compilation_evidence)
    //   10. check_replay_verification(replay_evidence)
    //   11. check_court_verdicts(court_evidence)

    let checks_passed: u32 = 11;
    let checks_total: u32 = 11;
    let all_pass: bool = checks_passed == checks_total;

    assert(all_pass, "pkg: all 11 verifier checks pass");
    assert(checks_passed <= checks_total, "pkg: checks not exceeding total");

    residual emit {
        op: "pkg.verifier_checks",
        passed: checks_passed,
        total: checks_total,
    };
}

fn test_package_verifier_rejection() -> void
    effect [io:write, io:read, residual]
{
    // Verifier rejects packages with specific failures:

    // Reject: source is missing
    let has_source: bool = false;
    assert(!has_source, "pkg: verifier rejects missing source");

    // Reject: source hash mismatch
    let source_hash_matches: bool = false;
    assert(!source_hash_matches, "pkg: verifier rejects hash mismatch");

    // Reject: binary hash mismatch
    let binary_hash_matches: bool = false;
    assert(!binary_hash_matches, "pkg: verifier rejects binary hash mismatch");

    // Reject: missing build recipe
    let has_recipe: bool = false;
    assert(!has_recipe, "pkg: verifier rejects missing recipe");

    // Reject: stale receipts
    let receipts_fresh: bool = false;
    assert(!receipts_fresh, "pkg: verifier rejects stale receipts");

    residual emit {
        op: "pkg.verifier_rejection",
        reasons: 5,
    };
}

// ============================================================================
// Section 7: Trust State Through Package Tests
// ============================================================================

fn test_package_trust_state_preservation() -> void
    effect [io:write, io:read, residual]
{
    // Trust state is preserved through package boundaries
    let pkg: PackageContainer = PackageContainer{
        package_name: Str::from("trusted.phor-spec"),
        package_version: Str::from("1.5.0"),
        source_hash: 0x77777777,
        binary_hash: 0x88888888,
        container_hash: 0x99999999,
        trust_state: 6, // Promoted
        has_source: true,
        has_binary: true,
        has_signatures: true,
        has_receipts: true,
        has_court_evidence: true,
    };

    // A promoted package stays promoted when stored
    let store_trust: u8 = pkg.trust_state;
    assert(store_trust == 6, "pkg: trust state Promoted preserved");

    // A package cannot exceed configured minimum trust for activation
    let min_trust_for_activation: u8 = 5; // Sealed
    let can_activate: bool = pkg.trust_state >= min_trust_for_activation;
    assert(can_activate, "pkg: trust sufficient for activation");

    residual emit {
        op: "pkg.trust_preservation",
        trust: pkg.trust_state,
        can_activate: if can_activate { 1 } else { 0 },
    };
}

fn test_package_expansion_evidence() -> void
    effect [io:write, io:read, residual]
{
    // Expansion evidence captures macro expansion, include resolution,
    // and template instantiation decisions
    let expansion_receipt_count: u32 = 3;
    let include_resolution_count: u32 = 2;
    let macro_expansion_count: u32 = 1;

    let total_expansion_events: u32 = expansion_receipt_count
        + include_resolution_count
        + macro_expansion_count;
    assert(total_expansion_events == 6, "pkg: 6 expansion events recorded");

    residual emit {
        op: "pkg.expansion_evidence",
        receipts: expansion_receipt_count,
        includes: include_resolution_count,
        macros: macro_expansion_count,
    };
}

fn test_package_compilation_evidence_sections() -> void
    effect [io:write, io:read, residual]
{
    // Each compilation stage produces distinct evidence
    let stages: Array(Str(16), 7) = Array::splat(Str::from(""));
    // In a real package: parse, expansion, lowering, optimize(2), codegen, link

    // Verify all 7 compilation receipts are present
    let receipt_count: u32 = 7;
    assert(receipt_count == 7, "pkg: 7 compilation receipts");

    residual emit {
        op: "pkg.compilation_evidence",
        stage_count: receipt_count,
    };
}

fn test_package_replay_evidence_completeness() -> void
    effect [io:write, io:read, residual]
{
    // Replay evidence includes checkpoints, residual graph, and verification report
    let has_checkpoints: bool = true;
    let has_residual_graph: bool = true;
    let has_verification_report: bool = true;
    let replay_matches: bool = true;

    let replay_evidence_complete: bool = has_checkpoints
        && has_residual_graph
        && has_verification_report
        && replay_matches;
    assert(replay_evidence_complete, "pkg: replay evidence is complete");

    residual emit {
        op: "pkg.replay_evidence",
        checkpoints: if has_checkpoints { 1 } else { 0 },
        graph: if has_residual_graph { 1 } else { 0 },
        report: if has_verification_report { 1 } else { 0 },
    };
}

fn test_package_court_evidence_verdicts() -> void
    effect [io:write, io:read, residual]
{
    // Court evidence includes oracle traces, comparison results, verdicts
    let verdict_count: u32 = 2;
    let oracle_sessions: u32 = 1;
    let trust_promotions: u32 = 1;

    assert(verdict_count == 2, "pkg: 2 court verdicts");
    assert(oracle_sessions == 1, "pkg: 1 oracle session");
    assert(trust_promotions == 1, "pkg: 1 trust promotion");

    residual emit {
        op: "pkg.court_evidence",
        verdicts: verdict_count,
        oracles: oracle_sessions,
        promotions: trust_promotions,
    };
}

fn test_package_signature_chain_verification() -> void
    effect [io:write, io:read, residual]
{
    // Verify that the full signature chain is consistent
    let developer_valid: bool = true;
    let auditor_count: u32 = 3;
    let auditors_valid: u32 = 3;
    let evidence_chain_valid: bool = true;

    let chain_valid: bool = developer_valid
        && auditors_valid == auditor_count
        && evidence_chain_valid;
    assert(chain_valid, "pkg: signature chain verified");

    residual emit {
        op: "pkg.signature_chain",
        developer: 1,
        auditors: auditors_valid,
        evidence_chain: 1,
    };
}

fn test_package_environment_capsule() -> void
    effect [io:write, io:read, residual]
{
    // The environment capsule captures the full build context
    let cpu_features_count: u32 = 4;
    let memory_base: u64 = 0x100000;
    let memory_size: u64 = 0x1000000;
    let oracle_count: u32 = 2;

    assert(cpu_features_count >= 1, "pkg: CPU features documented");
    assert(memory_size > 0, "pkg: memory configuration present");
    assert(oracle_count >= 1, "pkg: oracle identities present");

    residual emit {
        op: "pkg.environment_capsule",
        cpu_features: cpu_features_count,
        oracles: oracle_count,
    };
}

fn test_package_byte_comparison_provenance() -> void
    effect [io:write, io:read, residual]
{
    // Every byte in the binary should have a provenance trail back to source
    let provenanced_bytes: u64 = 15;
    let total_bytes: u64 = 15;
    let all_provenanced: bool = provenanced_bytes == total_bytes;

    assert(all_provenanced, "pkg: all bytes have provenance");
    assert(provenanced_bytes <= total_bytes, "pkg: provenance count valid");

    residual emit {
        op: "pkg.byte_provenance",
        provenanced: provenanced_bytes,
        total: total_bytes,
    };
}

// ============================================================================
// Main: Run all package tests
// ============================================================================

fn main() -> void
    effect [compute, io:write, io:read, residual]
{
    // Section 1: Container Structure
    test_package_header();
    test_package_sections_present();

    // Section 2: Source-Seal Rule
    test_source_seal_valid_package();
    test_source_seal_missing_source();
    test_source_seal_independent_signatures();

    // Section 3: Signatures
    test_signature_verification_all_valid();
    test_signature_verification_failed_auditor();

    // Section 4: Receipt Chains
    test_receipt_chain_complete();
    test_receipt_chain_broken();

    // Section 5: Build Evidence
    test_build_evidence_complete();

    // Section 6: Verifier
    test_package_verifier_all_checks();
    test_package_verifier_rejection();

    // Section 7: Trust
    test_package_trust_state_preservation();

    // Section 8: Expansion Evidence
    test_package_expansion_evidence();

    // Section 9: Compilation Evidence
    test_package_compilation_evidence_sections();

    // Section 10: Replay Evidence
    test_package_replay_evidence_completeness();

    // Section 11: Court Evidence
    test_package_court_evidence_verdicts();

    // Section 12: Signature Chain
    test_package_signature_chain_verification();

    // Section 13: Environment Capsule
    test_package_environment_capsule();

    // Section 14: Byte Provenance
    test_package_byte_comparison_provenance();

    residual emit {
        op: "package_tests.complete",
        total_sections: 14,
        status: "pass",
    };
}
