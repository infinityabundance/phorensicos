// file: buffer_cache.phor
// purpose: Buffer cache: fixed-capacity LRU cache, read-ahead, write-back,
//          dirty page tracking, flush policy, cache statistics
// effects: [io, storage, deterministic]
// status: [VERIFIED]

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::handles::*
use filesystem::phorensic_fs::*

// ──────────────────────────────────────────────
// Buffer Cache Constants
// ──────────────────────────────────────────────
// Evidence path: BC-ARCH-001 through BC-ARCH-025

const DIAG_BC_BASE          : Word64 = 0x5600
pub const BC_CACHE_SIZE     : u32 = 512          // Number of buffer slots
pub const BC_BLOCK_SIZE     : u32 = 4096         // Block size (must match FS)
pub const BC_READ_AHEAD     : u32 = 4            // Read-ahead blocks
pub const BC_CLEAN_BATCH    : u32 = 32           // Max clean per flush
pub const BC_DIRTY_THRESHOLD: u32 = 128          // Dirty pages before flush
pub const BC_LRU_SCAN       : u32 = 64           // LRU scan depth
pub const BC_HASH_BUCKETS   : u32 = 64           // Hash table buckets

const BOUND_BC_SMALL        : u32 = 64
const BOUND_BC_MEDIUM       : u32 = 256
const BOUND_BC_LARGE        : u32 = 512
const BOUND_BC_XLARGE       : u32 = 1024

// ──────────────────────────────────────────────
// Cache Error Types
// ──────────────────────────────────────────────
// Evidence path: BC-ERR-001 through BC-ERR-010

pub type BcError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BcError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BcError
        effects: [deterministic]
    {
        BcError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }
}

impl Error for BcError {
    fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }
    fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }
    fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust
    }
    fn in_range(self, base: Word64, end: Word64) -> bool
        effects: [deterministic]
    {
        self.code.gte(base) && self.code.lte(end)
    }
}

pub fn bc_error(msg: FixedString[128]) -> BcError
    effects: [deterministic]
{
    BcError::new(Word64::from_u64(DIAG_BC_BASE | 0x001), msg)
}

pub fn bc_full(msg: FixedString[128]) -> BcError
    effects: [deterministic]
{
    BcError::new(Word64::from_u64(DIAG_BC_BASE | 0x002), msg)
}

pub fn bc_not_found(msg: FixedString[128]) -> BcError
    effects: [deterministic]
{
    BcError::new(Word64::from_u64(DIAG_BC_BASE | 0x003), msg)
}

// ──────────────────────────────────────────────
// Buffer Cache Entry
// ──────────────────────────────────────────────
// Evidence path: BC-ENTRY-001 through BC-ENTRY-030

pub type BcEntryFlags : Word32 = struct {
    value: Word32,
}

impl BcEntryFlags {
    pub fn new(v: Word32) -> BcEntryFlags
        effects: [deterministic]
    {
        BcEntryFlags { value: v }
    }
    pub fn has(self, flag: u32) -> bool
        effects: [deterministic]
    {
        (self.value & flag) != 0
    }
    pub fn set(self: ref mut, flag: u32)
        effects: [deterministic]
    {
        self.value = self.value | flag
    }
    pub fn clear(self: ref mut, flag: u32)
        effects: [deterministic]
    {
        self.value = self.value & !flag
    }
}

pub const BC_ENTRY_VALID    : u32 = 0x0001
pub const BC_ENTRY_DIRTY    : u32 = 0x0002
pub const BC_ENTRY_LOCKED   : u32 = 0x0004
pub const BC_ENTRY_READING  : u32 = 0x0008
pub const BC_ENTRY_WRITING  : u32 = 0x0010
pub const BC_ENTRY_READAHEAD: u32 = 0x0020
pub const BC_ENTRY_PINNED   : u32 = 0x0040

pub type BcEntry : struct {
    block_number: Word64,                // Device block number
    device_id: Word64,                   // Device identifier
    flags: BcEntryFlags,                 // Entry flags
    data: Byte[4096],                    // Block data buffer
    access_time: Word64,                 // Last access timestamp (LRU)
    dirty_time: Word64,                  // Time when dirtied
    ref_count: Word32,                   // Reference count
    hash_next: Word32,                   // Hash chain next index
    lru_next: Word32,                    // LRU chain next index
    lru_prev: Word32,                    // LRU chain previous index
}

impl BcEntry {
    pub fn empty() -> BcEntry
        effects: [deterministic]
    {
        BcEntry {
            block_number: Word64::zero(),
            device_id: Word64::zero(),
            flags: BcEntryFlags::new(Word32::from_u32(0)),
            data: [Byte::from_u8(0); 4096],
            access_time: Word64::zero(),
            dirty_time: Word64::zero(),
            ref_count: Word32::from_u32(0),
            hash_next: Word32::from_u32(0xFFFFFFFF),
            lru_next: Word32::from_u32(0xFFFFFFFF),
            lru_prev: Word32::from_u32(0xFFFFFFFF),
        }
    }

    pub fn new(block: Word64, dev: Word64) -> BcEntry
        effects: [deterministic]
    {
        BcEntry {
            block_number: block,
            device_id: dev,
            flags: BcEntryFlags::new(Word32::from_u32(BC_ENTRY_VALID)),
            data: [Byte::from_u8(0); 4096],
            access_time: __builtin_timestamp(),
            dirty_time: Word64::zero(),
            ref_count: Word32::from_u32(1),
            hash_next: Word32::from_u32(0xFFFFFFFF),
            lru_next: Word32::from_u32(0xFFFFFFFF),
            lru_prev: Word32::from_u32(0xFFFFFFFF),
        }
    }

    pub fn is_dirty(self) -> bool
        effects: [deterministic]
    {
        self.flags.has(BC_ENTRY_DIRTY)
    }

    pub fn is_valid(self) -> bool
        effects: [deterministic]
    {
        self.flags.has(BC_ENTRY_VALID)
    }

    pub fn is_pinned(self) -> bool
        effects: [deterministic]
    {
        self.flags.has(BC_ENTRY_PINNED)
    }

    pub fn is_locked(self) -> bool
        effects: [deterministic]
    {
        self.flags.has(BC_ENTRY_LOCKED)
    }

    pub fn touch_lru(self: ref mut)
        effects: [deterministic]
    {
        self.access_time = __builtin_timestamp()
    }

    pub fn mark_dirty(self: ref mut)
        effects: [deterministic]
    {
        self.flags.set(BC_ENTRY_DIRTY)
        self.dirty_time = __builtin_timestamp()
    }

    pub fn mark_clean(self: ref mut)
        effects: [deterministic]
    {
        self.flags.clear(BC_ENTRY_DIRTY)
        self.dirty_time = Word64::zero()
    }

    pub fn pin(self: ref mut)
        effects: [deterministic]
    {
        self.flags.set(BC_ENTRY_PINNED)
        self.ref_count = self.ref_count.checked_add(Word32::from_u32(1)).unwrap_or(self.ref_count)
    }

    pub fn unpin(self: ref mut)
        effects: [deterministic]
    {
        self.flags.clear(BC_ENTRY_PINNED)
        if self.ref_count.to_u32() > 0 {
            self.ref_count = self.ref_count.checked_sub(Word32::from_u32(1)).unwrap_or(Word32::from_u32(0))
        }
    }

    pub fn increment_ref(self: ref mut)
        effects: [deterministic]
    {
        self.ref_count = self.ref_count.checked_add(Word32::from_u32(1)).unwrap_or(self.ref_count)
    }

    pub fn decrement_ref(self: ref mut)
        effects: [deterministic]
    {
        if self.ref_count.to_u32() > 0 {
            self.ref_count = self.ref_count.checked_sub(Word32::from_u32(1)).unwrap_or(Word32::from_u32(0))
        }
    }
}

// ──────────────────────────────────────────────
// Buffer Cache (fixed-capacity LRU)
// ──────────────────────────────────────────────
// Evidence path: BC-CACHE-001 through BC-CACHE-050

pub type BufferCache : struct {
    entries: [BcEntry; 512],             // Fixed array of cache entries
    entry_count: Word32,                 // Number of used entries
    hash_table: [Word32; 64],            // Hash table (index into entries)
    lru_head: Word32,                    // LRU list head index
    lru_tail: Word32,                    // LRU list tail index
    hits: Word64,                        // Cache hit count
    misses: Word64,                      // Cache miss count
    dirty_blocks: Word64,                // Count of dirty blocks
    read_ahead_blocks: Word64,           // Read-ahead operations
    write_back_blocks: Word64,           // Write-back operations
    evictions: Word64,                   // Eviction count
    flush_count: Word64,                 // Flush operation count
}

impl BufferCache {
    pub fn new() -> BufferCache
        effects: [deterministic]
    {
        let empty: BcEntry = BcEntry::empty()
        BufferCache {
            entries: [empty; 512],
            entry_count: Word32::from_u32(0),
            hash_table: [0xFFFFFFFF; 64],
            lru_head: Word32::from_u32(0xFFFFFFFF),
            lru_tail: Word32::from_u32(0xFFFFFFFF),
            hits: Word64::zero(),
            misses: Word64::zero(),
            dirty_blocks: Word64::zero(),
            read_ahead_blocks: Word64::zero(),
            write_back_blocks: Word64::zero(),
            evictions: Word64::zero(),
            flush_count: Word64::zero(),
        }
    }

    fn hash_block(block: Word64, device: Word64) -> u32
        effects: [deterministic]
    {
        let h: u64 = block.to_u64().wrapping_mul(31).wrapping_add(device.to_u64().wrapping_mul(17))
        (h % 64) as u32
    }

    pub fn lookup(self, block: Word64, device: Word64) -> Option[ref BcEntry>
        effects: [deterministic]
    {
        let bucket: u32 = BufferCache::hash_block(block, device)
        let mut idx: Word32 = Word32::from_u32(self.hash_table[bucket as usize])
        // loop: bounds[BOUND_BC_SMALL] — bounded by chain length
        loop: bounds[BOUND_BC_SMALL] for _ in 0..64 {
            if idx.to_u32() == 0xFFFFFFFF {
                break
            }
            let entry: BcEntry = self.entries[idx.to_u32() as usize]
            if entry.block_number.eq(block) && entry.device_id.eq(device) && entry.is_valid() {
                return Option::Some(&self.entries[idx.to_u32() as usize])
            }
            idx = entry.hash_next
        }
        Option::None
    }

    pub fn lookup_mut(self: ref mut, block: Word64, device: Word64) -> Option[ref mut BcEntry>
        effects: [deterministic]
    {
        let bucket: u32 = BufferCache::hash_block(block, device)
        let mut idx: Word32 = Word32::from_u32(self.hash_table[bucket as usize])
        // loop: bounds[BOUND_BC_SMALL] — bounded by chain length
        loop: bounds[BOUND_BC_SMALL] for _ in 0..64 {
            if idx.to_u32() == 0xFFFFFFFF {
                break
            }
            let entry: BcEntry = self.entries[idx.to_u32() as usize]
            if entry.block_number.eq(block) && entry.device_id.eq(device) && entry.is_valid() {
                return Option::Some(&mut self.entries[idx.to_u32() as usize])
            }
            idx = entry.hash_next
        }
        Option::None
    }

    pub fn get_or_read(self: ref mut, block: Word64, device: Word64) -> Result<ref mut BcEntry, BcError>
        effects: [io, deterministic]
    {
        let existing: Option[ref mut BcEntry> = self.lookup_mut(block, device)
        if existing.is_some() {
            self.hits = self.hits.checked_add(Word64::one()).unwrap_or(self.hits)
            let entry: ref mut BcEntry = existing.unwrap()
            entry.touch_lru()
            self.move_to_head(entry)
            return Result::Ok(entry)
        }
        self.misses = self.misses.checked_add(Word64::one()).unwrap_or(self.misses)
        // Allocate a new entry.
        let idx: u32 = self.allocate_entry()?
        let entry: BcEntry = BcEntry::new(block, device)
        self.entries[idx as usize] = entry
        // Add to hash table.
        let bucket: u32 = BufferCache::hash_block(block, device)
        self.entries[idx as usize].hash_next = Word32::from_u32(self.hash_table[bucket as usize])
        self.hash_table[bucket as usize] = idx
        // Add to LRU list.
        self.add_to_lru_head(idx)
        // In a real implementation, read block data from device here.
        self.entry_count = Word32::from_u32(self.entry_count.to_u32() + 1)
        Result::Ok(&mut self.entries[idx as usize])
    }

    pub fn mark_dirty(self: ref mut, block: Word64, device: Word64) -> Result<(), BcError>
        effects: [deterministic]
    {
        let entry_opt: Option[ref mut BcEntry> = self.lookup_mut(block, device)
        if entry_opt.is_none() {
            return Result::Err(bc_not_found("Block not in cache"))
        }
        let entry: ref mut BcEntry = entry_opt.unwrap()
        if !entry.is_dirty() {
            entry.mark_dirty()
            self.dirty_blocks = self.dirty_blocks.checked_add(Word64::one()).unwrap_or(self.dirty_blocks)
        }
        Result::Ok(())
    }

    pub fn read_block(self: ref mut, block: Word64, device: Word64) -> Result<ref mut Byte[4096], BcError>
        effects: [io, deterministic]
    {
        let entry: ref mut BcEntry = self.get_or_read(block, device)?
        Result::Ok(&mut entry.data)
    }

    pub fn write_block(self: ref mut, block: Word64, device: Word64, data: Byte[4096]) -> Result<(), BcError>
        effects: [io, deterministic]
    {
        let entry: ref mut BcEntry = self.get_or_read(block, device)?
        // Copy data.
        // loop: bounds[BOUND_BC_LARGE] — bounded by 4096
        loop: bounds[BOUND_BC_LARGE] for i in 0..4096 {
            entry.data[i] = data[i]
        }
        entry.mark_dirty()
        Result::Ok(())
    }

    fn allocate_entry(self: ref mut) -> Result<u32, BcError>
        effects: [deterministic]
    {
        if self.entry_count.to_u32() < 512 {
            return Result::Ok(self.entry_count.to_u32())
        }
        // Evict LRU entry.
        self.evict_lru()
    }

    fn evict_lru(self: ref mut) -> Result<u32, BcError>
        effects: [io, deterministic]
    {
        let mut idx: Word32 = self.lru_tail
        // loop: bounds[BOUND_BC_SMALL] — bounded by scan depth
        loop: bounds[BOUND_BC_SMALL] for _ in 0..64 {
            if idx.to_u32() == 0xFFFFFFFF {
                return Result::Err(bc_full("No evictable entries"))
            }
            let entry: BcEntry = self.entries[idx.to_u32() as usize]
            if !entry.is_pinned() && !entry.is_locked() {
                // Flush if dirty.
                if entry.is_dirty() {
                    self.flush_block(entry.block_number, entry.device_id)?
                }
                // Remove from hash table.
                let bucket: u32 = BufferCache::hash_block(entry.block_number, entry.device_id)
                self.remove_from_hash(bucket, entry.block_number, entry.device_id)
                // Remove from LRU.
                self.remove_from_lru(idx.to_u32())
                // Clear entry.
                self.entries[idx.to_u32() as usize] = BcEntry::empty()
                self.evictions = self.evictions.checked_add(Word64::one()).unwrap_or(self.evictions)
                return Result::Ok(idx.to_u32())
            }
            idx = entry.lru_prev
        }
        Result::Err(bc_full("All entries pinned or locked"))
    }

    fn remove_from_hash(self: ref mut, bucket: u32, block: Word64, device: Word64)
        effects: [deterministic]
    {
        let mut prev: Word32 = Word32::from_u32(0xFFFFFFFF)
        let mut curr: Word32 = Word32::from_u32(self.hash_table[bucket as usize])
        // loop: bounds[BOUND_BC_SMALL] — bounded by chain length
        loop: bounds[BOUND_BC_SMALL] for _ in 0..64 {
            if curr.to_u32() == 0xFFFFFFFF { break }
            let entry: BcEntry = self.entries[curr.to_u32() as usize]
            if entry.block_number.eq(block) && entry.device_id.eq(device) {
                let next: Word32 = entry.hash_next
                if prev.to_u32() == 0xFFFFFFFF {
                    self.hash_table[bucket as usize] = next.to_u32()
                } else {
                    self.entries[prev.to_u32() as usize].hash_next = next
                }
                break
            }
            prev = curr
            curr = entry.hash_next
        }
    }

    fn add_to_lru_head(self: ref mut, idx: u32)
        effects: [deterministic]
    {
        self.entries[idx as usize].lru_prev = Word32::from_u32(0xFFFFFFFF)
        self.entries[idx as usize].lru_next = self.lru_head
        if self.lru_head.to_u32() != 0xFFFFFFFF {
            self.entries[self.lru_head.to_u32() as usize].lru_prev = Word32::from_u32(idx)
        }
        self.lru_head = Word32::from_u32(idx)
        if self.lru_tail.to_u32() == 0xFFFFFFFF {
            self.lru_tail = Word32::from_u32(idx)
        }
    }

    fn remove_from_lru(self: ref mut, idx: u32)
        effects: [deterministic]
    {
        let prev: Word32 = self.entries[idx as usize].lru_prev
        let next: Word32 = self.entries[idx as usize].lru_next
        if prev.to_u32() != 0xFFFFFFFF {
            self.entries[prev.to_u32() as usize].lru_next = next
        } else {
            self.lru_head = next
        }
        if next.to_u32() != 0xFFFFFFFF {
            self.entries[next.to_u32() as usize].lru_prev = prev
        } else {
            self.lru_tail = prev
        }
    }

    fn move_to_head(self: ref mut, entry: ref mut BcEntry)
        effects: [deterministic]
    {
        // Stub: in a real implementation, remove from LRU and re-add to head.
    }

    pub fn flush_block(self: ref mut, block: Word64, device: Word64) -> Result<(), BcError>
        effects: [io, deterministic]
    {
        let entry_opt: Option[ref mut BcEntry> = self.lookup_mut(block, device)
        if entry_opt.is_some() {
            let entry: ref mut BcEntry = entry_opt.unwrap()
            if entry.is_dirty() {
                // In a real implementation, write block data to device.
                entry.mark_clean()
                self.dirty_blocks = self.dirty_blocks.checked_sub(Word64::one()).unwrap_or(Word64::zero())
                self.write_back_blocks = self.write_back_blocks.checked_add(Word64::one()).unwrap_or(self.write_back_blocks)
            }
        }
        Result::Ok(())
    }

    pub fn flush_all(self: ref mut) -> Result<(), BcError>
        effects: [io, deterministic]
    {
        // loop: bounds[BOUND_BC_LARGE] — bounded by cache size
        loop: bounds[BOUND_BC_LARGE] for i in 0..512 {
            let entry: BcEntry = self.entries[i as usize]
            if entry.is_valid() && entry.is_dirty() {
                self.flush_block(entry.block_number, entry.device_id)?
            }
        }
        self.flush_count = self.flush_count.checked_add(Word64::one()).unwrap_or(self.flush_count)
        Result::Ok(())
    }

    pub fn flush_dirty_batch(self: ref mut) -> Result<Word32, BcError>
        effects: [io, deterministic]
    {
        let mut flushed: Word32 = Word32::from_u32(0)
        // loop: bounds[BOUND_BC_MEDIUM] — bounded by clean batch
        loop: bounds[BOUND_BC_MEDIUM] for i in 0..512 {
            if flushed.to_u32() >= 32 { break }
            let entry: BcEntry = self.entries[i as usize]
            if entry.is_valid() && entry.is_dirty() && !entry.is_pinned() {
                self.flush_block(entry.block_number, entry.device_id)?
                flushed = flushed.checked_add(Word32::from_u32(1)).unwrap_or(flushed)
            }
        }
        Result::Ok(flushed)
    }

    pub fn read_ahead(self: ref mut, block: Word64, device: Word64, count: u32)
        effects: [io, deterministic]
    {
        // loop: bounds[BOUND_BC_SMALL] — bounded by read-ahead count
        loop: bounds[BOUND_BC_SMALL] for i in 1..(count + 1) {
            let ahead_block: Word64 = block.checked_add(Word64::from_u64(i as u64)).unwrap_or(block)
            if self.lookup(ahead_block, device).is_none() {
                // In a real implementation, initiate background read.
                self.read_ahead_blocks = self.read_ahead_blocks.checked_add(Word64::one()).unwrap_or(self.read_ahead_blocks)
            }
        }
    }

    pub fn stats(self) -> BcStatistics
        effects: [deterministic]
    {
        BcStatistics {
            hits: self.hits,
            misses: self.misses,
            dirty_blocks: self.dirty_blocks,
            read_ahead_blocks: self.read_ahead_blocks,
            write_back_blocks: self.write_back_blocks,
            evictions: self.evictions,
            flush_count: self.flush_count,
            entry_count: Word64::from_u64(self.entry_count.to_u32() as u64),
            cache_size: Word64::from_u64(512),
        }
    }

    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        let empty: BcEntry = BcEntry::empty()
        // loop: bounds[BOUND_BC_LARGE] — bounded by 512
        loop: bounds[BOUND_BC_LARGE] for i in 0..512 {
            self.entries[i as usize] = empty
        }
        // loop: bounds[BOUND_BC_SMALL] — bounded by 64
        loop: bounds[BOUND_BC_SMALL] for i in 0..64 {
            self.hash_table[i as usize] = 0xFFFFFFFF
        }
        self.entry_count = Word32::from_u32(0)
        self.lru_head = Word32::from_u32(0xFFFFFFFF)
        self.lru_tail = Word32::from_u32(0xFFFFFFFF)
        self.hits = Word64::zero()
        self.misses = Word64::zero()
        self.dirty_blocks = Word64::zero()
        self.read_ahead_blocks = Word64::zero()
        self.write_back_blocks = Word64::zero()
        self.evictions = Word64::zero()
        self.flush_count = Word64::zero()
    }
}

// ──────────────────────────────────────────────
// Buffer Cache Statistics
// ──────────────────────────────────────────────
// Evidence path: BC-STATS-001 through BC-STATS-015

pub type BcStatistics : struct {
    hits: Word64,                        // Cache hits
    misses: Word64,                      // Cache misses
    dirty_blocks: Word64,                // Dirty blocks count
    read_ahead_blocks: Word64,           // Read-ahead operations
    write_back_blocks: Word64,           // Write-back operations
    evictions: Word64,                   // Eviction count
    flush_count: Word64,                 // Flush count
    entry_count: Word64,                 // Current entries
    cache_size: Word64,                  // Maximum cache size
}

impl BcStatistics {
    pub fn hit_ratio(self) -> Word64
        effects: [deterministic]
    {
        let total: Word64 = self.hits.checked_add(self.misses).unwrap_or(self.hits)
        if total.is_zero() {
            return Word64::zero()
        }
        self.hits.checked_mul(Word64::from_u64(100)).unwrap_or(Word64::zero())
            .checked_div(total).unwrap_or(Word64::zero())
    }

    pub fn dirty_percentage(self) -> Word64
        effects: [deterministic]
    {
        if self.entry_count.is_zero() {
            return Word64::zero()
        }
        self.dirty_blocks.checked_mul(Word64::from_u64(100)).unwrap_or(Word64::zero())
            .checked_div(self.entry_count).unwrap_or(Word64::zero())
    }

    pub fn to_fixed_string(self) -> FixedString[256]
        effects: [deterministic]
    {
        let mut s: FixedString[256] = FixedString::new()
        s.append(FixedString[256]::from_slice("BC: hits="))
        s.append(self.hits.to_hex())
        s.append(FixedString[256]::from_slice(" misses="))
        s.append(self.misses.to_hex())
        s.append(FixedString[256]::from_slice(" dirty="))
        s.append(self.dirty_blocks.to_hex())
        s.append(FixedString[256]::from_slice(" evict="))
        s.append(self.evictions.to_hex())
        s
    }
}

// ──────────────────────────────────────────────
// Flush Policy
// ──────────────────────────────────────────────
// Evidence path: BC-FLUSH-001 through BC-FLUSH-015

pub type FlushPolicy : u8 = enum {
    FlushPolicy_Lazy        = 0x00,  // Flush when needed
    FlushPolicy_Periodic    = 0x01,  // Flush periodically
    FlushPolicy_Aggressive  = 0x02,  // Flush aggressively
    FlushPolicy_Sync        = 0x03,  // Flush immediately
}

pub type FlushController : struct {
    policy: FlushPolicy,                 // Current flush policy
    dirty_threshold: Word32,             // Dirty page threshold
    last_flush: Word64,                  // Last flush timestamp
    flush_interval: Word64,              // Flush interval (microseconds)
    force_flush: bool,                   // Force flush on next check
}

impl FlushController {
    pub fn new() -> FlushController
        effects: [deterministic]
    {
        FlushController {
            policy: FlushPolicy::FlushPolicy_Lazy,
            dirty_threshold: Word32::from_u32(BC_DIRTY_THRESHOLD),
            last_flush: __builtin_timestamp(),
            flush_interval: Word64::from_u64(5000000),  // 5 seconds
            force_flush: false,
        }
    }

    pub fn set_policy(self: ref mut, policy: FlushPolicy)
        effects: [deterministic]
    {
        self.policy = policy
    }

    pub fn should_flush(self, dirty_count: Word64) -> bool
        effects: [deterministic]
    {
        if self.force_flush {
            return true
        }
        if dirty_count.gte(Word64::from_u64(self.dirty_threshold.to_u32() as u64)) {
            return true
        }
        if self.policy == FlushPolicy::FlushPolicy_Periodic {
            let now: Word64 = __builtin_timestamp()
            let elapsed: Word64 = now.checked_sub(self.last_flush).unwrap_or(Word64::zero())
            if elapsed.gte(self.flush_interval) {
                return true
            }
        }
        if self.policy == FlushPolicy::FlushPolicy_Aggressive {
            return dirty_count.gt(Word64::zero())
        }
        false
    }

    pub def mark_flush(self: ref mut)
        effects: [deterministic]
    {
        self.last_flush = __builtin_timestamp()
        self.force_flush = false
    }

    pub fn residual_flush(self, flushed: Word32)
        effects: [io, deterministic]
    {
        residual emit {
            subsystem: "buffer_cache",
            operation: "flush",
            policy: self.policy,
            flushed_blocks: flushed,
            timestamp: __builtin_timestamp(),
        }
    }
}

// ──────────────────────────────────────────────
// Cache Coherency Operations
// ──────────────────────────────────────────────
// Evidence path: BC-COHER-001 through BC-COHER-020

pub type CacheCoherency : struct {
    invalidate_all: bool,
    invalidate_blocks: FixedArray[64, Word64>,  // Blocks to invalidate
    invalidate_count: Word32,
}

impl CacheCoherency {
    pub fn new() -> CacheCoherency
        effects: [deterministic]
    {
        CacheCoherency {
            invalidate_all: false,
            invalidate_blocks: FixedArray::new(),
            invalidate_count: Word32::from_u32(0),
        }
    }

    pub fn request_invalidate(self: ref mut, block: Word64)
        effects: [deterministic]
    {
        if !self.invalidate_blocks.is_full() {
            self.invalidate_blocks.push(block)
            self.invalidate_count = Word32::from_u32(self.invalidate_blocks.len())
        }
    }

    pub fn request_invalidate_all(self: ref mut)
        effects: [deterministic]
    {
        self.invalidate_all = true
    }

    pub fn apply(self: ref mut, bc: ref mut BufferCache)
        effects: [io, deterministic]
    {
        if self.invalidate_all {
            bc.clear()
            self.invalidate_all = false
            return
        }
        // loop: bounds[BOUND_BC_SMALL] — bounded by 64
        loop: bounds[BOUND_BC_SMALL] for i in 0..self.invalidate_blocks.len() {
            let block: Word64 = self.invalidate_blocks.get(i).unwrap_or(Word64::zero())
            // In a real implementation, remove the block from cache.
        }
        self.invalidate_blocks.clear()
        self.invalidate_count = Word32::from_u32(0)
    }
}

// ──────────────────────────────────────────────
// Cache Prefetch Engine
// ──────────────────────────────────────────────
// Evidence path: BC-PREFETCH-001 through BC-PREFETCH-020

pub type PrefetchEngine : struct {
    enabled: bool,
    prefetch_depth: Word32,
    sequential_hits: Word32,
    last_block: Word64,
}

impl PrefetchEngine {
    pub fn new() -> PrefetchEngine
        effects: [deterministic]
    {
        PrefetchEngine {
            enabled: true,
            prefetch_depth: Word32::from_u32(4),
            sequential_hits: Word32::from_u32(0),
            last_block: Word64::from_u64(0xFFFFFFFFFFFFFFFF),
        }
    }

    pub fn record_access(self: ref mut, block: Word64)
        effects: [deterministic]
    {
        let expected: Word64 = if self.last_block.to_u64() == 0xFFFFFFFFFFFFFFFF {
            self.last_block = block
            return
        } else {
            self.last_block.checked_add(Word64::one()).unwrap_or(Word64::zero())
        }
        if block.eq(expected) {
            self.sequential_hits = self.sequential_hits.checked_add(Word32::from_u32(1)).unwrap_or(self.sequential_hits)
        } else {
            self.sequential_hits = Word32::from_u32(0)
        }
        self.last_block = block
    }

    pub fn should_prefetch(self) -> bool
        effects: [deterministic]
    {
        self.enabled && self.sequential_hits.to_u32() >= 2
    }

    pub fn prefetch_blocks(self, bc: ref mut BufferCache, device: Word64)
        effects: [io, deterministic]
    {
        if !self.should_prefetch() { return }
        let start: Word64 = self.last_block.checked_add(Word64::one()).unwrap_or(self.last_block)
        // loop: bounds[BOUND_BC_SMALL] — bounded by prefetch_depth
        loop: bounds[BOUND_BC_SMALL] for i in 0..self.prefetch_depth.to_u32() {
            let block: Word64 = start.checked_add(Word64::from_u64(i as u64)).unwrap_or(start)
            bc.read_ahead(block, device, 1)
        }
    }

    pub fn set_depth(self: ref mut, depth: Word32)
        effects: [deterministic]
    {
        self.prefetch_depth = depth
    }

    pub fn enable(self: ref mut)
        effects: [deterministic]
    {
        self.enabled = true
    }

    pub fn disable(self: ref mut)
        effects: [deterministic]
    {
        self.enabled = false
    }
}

// ──────────────────────────────────────────────
// Write-back Worker
// ──────────────────────────────────────────────
// Evidence path: BC-WB-001 through BC-WB-020

pub type WritebackWorker : struct {
    active: bool,
    batch_size: Word32,
    interval_us: Word64,
    last_run: Word64,
    total_flushed: Word64,
    errors: Word64,
}

impl WritebackWorker {
    pub fn new() -> WritebackWorker
        effects: [deterministic]
    {
        WritebackWorker {
            active: true,
            batch_size: Word32::from_u32(32),
            interval_us: Word64::from_u64(1000000),  // 1 second
            last_run: __builtin_timestamp(),
            total_flushed: Word64::zero(),
            errors: Word64::zero(),
        }
    }

    pub fn should_run(self) -> bool
        effects: [deterministic]
    {
        if !self.active { return false }
        let elapsed: Word64 = __builtin_timestamp().checked_sub(self.last_run).unwrap_or(Word64::zero())
        elapsed.gte(self.interval_us)
    }

    pub fn run(self: ref mut, bc: ref mut BufferCache) -> Result<Word32, BcError>
        effects: [io, deterministic]
    {
        if !self.should_run() {
            return Result::Ok(Word32::from_u32(0))
        }
        let flushed: Word32 = bc.flush_dirty_batch()?
        self.total_flushed = self.total_flushed.checked_add(Word64::from_u64(flushed.to_u32() as u64)).unwrap_or(self.total_flushed)
        self.last_run = __builtin_timestamp()
        Result::Ok(flushed)
    }

    pub fn stats(self) -> (Word64, Word64)
        effects: [deterministic]
    {
        (self.total_flushed, self.errors)
    }
}

// ──────────────────────────────────────────────
// Cache Hit/Miss Analysis
// ──────────────────────────────────────────────
// Evidence path: BC-ANALYSIS-001 through BC-ANALYSIS-015

pub fn cache_hit_rate(stats: BcStatistics) -> Word64
    effects: [deterministic]
{
    stats.hit_ratio()
}

pub fn cache_miss_rate(stats: BcStatistics) -> Word64
    effects: [deterministic]
{
    let total: Word64 = stats.hits.checked_add(stats.misses).unwrap_or(stats.hits)
    if total.is_zero() { return Word64::zero() }
    stats.misses.checked_mul(Word64::from_u64(100)).unwrap_or(Word64::zero())
        .checked_div(total).unwrap_or(Word64::zero())
}

pub fn cache_efficiency_score(stats: BcStatistics) -> Word32
    effects: [deterministic]
{
    let hit_rate: Word64 = cache_hit_rate(stats)
    let dirty_pct: Word64 = stats.dirty_percentage()
    let evict_rate: Word64 = if stats.entry_count.is_zero() { Word64::zero() } else {
        stats.evictions.checked_mul(Word64::from_u64(100)).unwrap_or(Word64::zero())
            .checked_div(stats.entry_count).unwrap_or(Word64::zero())
    }
    // Score: high hit rate + low dirty + low evictions = good
    let score: Word64 = hit_rate.checked_sub(dirty_pct.checked_div(Word64::from_u64(2)).unwrap_or(Word64::zero())).unwrap_or(hit_rate)
        .checked_sub(evict_rate).unwrap_or(hit_rate)
    Word32::from_u32(score.to_u32())
}

// ──────────────────────────────────────────────
// Residual Recording for Buffer Cache
// ──────────────────────────────────────────────
// Evidence path: BC-RESID-001 through BC-RESID-015

pub fn residual_cache_event(event: FixedString[64], stats: BcStatistics)
    effects: [io, deterministic]
{
    residual emit {
        subsystem: "buffer_cache",
        event: event,
        hits: stats.hits,
        misses: stats.misses,
        dirty: stats.dirty_blocks,
        evictions: stats.evictions,
        hit_pct: stats.hit_ratio(),
        timestamp: __builtin_timestamp(),
    }
}

pub fn residual_writeback(flushed: Word32, errors: Word32)
    effects: [io, deterministic]
{
    residual emit {
        subsystem: "buffer_cache_writeback",
        flushed_blocks: flushed,
        errors: errors,
        timestamp: __builtin_timestamp(),
    }
}

// ──────────────────────────────────────────────
// Cache Pin/Unpin for Critical Blocks
// ──────────────────────────────────────────────
// Evidence path: BC-PIN-001 through BC-PIN-015

pub fn pin_superblock(bc: ref mut BufferCache, device: Word64)
    effects: [io, deterministic]
{
    let result: Result<ref mut BcEntry, BcError> = bc.get_or_read(Word64::from_u64(SUPERBLOCK_BLOCK as u64), device)
    if result.is_ok() {
        let entry: ref mut BcEntry = result.unwrap()
        entry.pin()
    }
}

pub fn unpin_superblock(bc: ref mut BufferCache, device: Word64)
    effects: [io, deterministic]
{
    let entry_opt: Option[ref mut BcEntry> = bc.lookup_mut(Word64::from_u64(SUPERBLOCK_BLOCK as u64), device)
    if entry_opt.is_some() {
        let entry: ref mut BcEntry = entry_opt.unwrap()
        entry.unpin()
    }
}

pub fn pin_block_group_blocks(bc: ref mut BufferCache, device: Word64, group_count: u32)
    effects: [io, deterministic]
{
    // loop: bounds[BOUND_BC_SMALL] — bounded by group count
    loop: bounds[BOUND_BC_SMALL] for i in 0..group_count {
        let bg_block: Word64 = Word64::from_u64(1 + i as u64)  // Block group descriptors start at block 1
        let result: Result<ref mut BcEntry, BcError> = bc.get_or_read(bg_block, device)
        if result.is_ok() {
            let entry: ref mut BcEntry = result.unwrap()
            entry.pin()
        }
    }
}

pub fn unpin_block_group_blocks(bc: ref mut BufferCache, device: Word64, group_count: u32)
    effects: [io, deterministic]
{
    // loop: bounds[BOUND_BC_SMALL] — bounded by group count
    loop: bounds[BOUND_BC_SMALL] for i in 0..group_count {
        let bg_block: Word64 = Word64::from_u64(1 + i as u64)
        let entry_opt: Option[ref mut BcEntry> = bc.lookup_mut(bg_block, device)
        if entry_opt.is_some() {
            entry_opt.unwrap().unpin()
        }
    }
}

// ──────────────────────────────────────────────
// Cache Warming
// ──────────────────────────────────────────────
// Evidence path: BC-WARM-001 through BC-WARM-015

pub fn warm_cache_range(bc: ref mut BufferCache, device: Word64, start: Word64, count: u32)
    effects: [io, deterministic]
{
    // loop: bounds[BOUND_BC_SMALL] — bounded by count
    loop: bounds[BOUND_BC_SMALL] for i in 0..count {
        let block: Word64 = start.checked_add(Word64::from_u64(i as u64)).unwrap_or(start)
        bc.read_ahead(block, device, 1)
    }
}

pub fn warm_inode_table(bc: ref mut BufferCache, device: Word64, inode_table_block: Word64, inode_count: u32)
    effects: [io, deterministic]
{
    let blocks: u32 = (inode_count * INODE_SIZE + BLOCK_SIZE - 1) / BLOCK_SIZE
    warm_cache_range(bc, device, inode_table_block, blocks)
}

pub fn warm_block_bitmap(bc: ref mut BufferCache, device: Word64, bitmap_block: Word64)
    effects: [io, deterministic]
{
    // Block bitmap fits in BITMAP_BLOCK_COUNT blocks.
    // loop: bounds[BOUND_BC_SMALL] — bounded by BITMAP_BLOCK_COUNT
    loop: bounds[BOUND_BC_SMALL] for i in 0..BITMAP_BLOCK_COUNT {
        let block: Word64 = bitmap_block.checked_add(Word64::from_u64(i as u64)).unwrap_or(bitmap_block)
        bc.read_ahead(block, device, 1)
    }
}

// ──────────────────────────────────────────────
// Cache
// Verification
// ──────────────────────────────────────────────
// Evidence path: BC-VFY-001 through BC-VFY-015

pub fn verify_cache_entry(entry: BcEntry) -> bool
    effects: [deterministic]
{
    entry.is_valid()
}

pub fn count_clean_blocks(bc: BufferCache) -> Word32
    effects: [deterministic]
{
    let mut count: Word32 = Word32::from_u32(0)
    // loop: bounds[BOUND_BC_LARGE] — bounded by 512
    loop: bounds[BOUND_BC_LARGE] for i in 0..512 {
        let entry: BcEntry = bc.entries[i as usize]
        if entry.is_valid() && !entry.is_dirty() {
            count = count.checked_add(Word32::from_u32(1)).unwrap_or(count)
        }
    }
    count
}

pub fn count_dirty_blocks(bc: BufferCache) -> Word32
    effects: [deterministic]
{
    let mut count: Word32 = Word32::from_u32(0)
    // loop: bounds[BOUND_BC_LARGE] — bounded by 512
    loop: bounds[BOUND_BC_LARGE] for i in 0..512 {
        let entry: BcEntry = bc.entries[i as usize]
        if entry.is_dirty() {
            count = count.checked_add(Word32::from_u32(1)).unwrap_or(count)
        }
    }
    count
}

pub fn count_pinned_blocks(bc: BufferCache) -> Word32
    effects: [deterministic]
{
    let mut count: Word32 = Word32::from_u32(0)
    // loop: bounds[BOUND_BC_LARGE] — bounded by 512
    loop: bounds[BOUND_BC_LARGE] for i in 0..512 {
        let entry: BcEntry = bc.entries[i as usize]
        if entry.is_pinned() {
            count = count.checked_add(Word32::from_u32(1)).unwrap_or(count)
        }
    }
    count
}
