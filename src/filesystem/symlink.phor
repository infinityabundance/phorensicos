// file: symlink.phor
// purpose: Symbolic links: creation, resolution, loop detection (bounded depth),
//          target storage (inline or extent), permission checks
// effects: [io, storage, deterministic]
// status: [VERIFIED]

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::handles::*
use core::capabilities::*
use filesystem::phorensic_fs::*
use filesystem::vfs::*
use filesystem::path::*

// ──────────────────────────────────────────────
// Symlink Constants
// ──────────────────────────────────────────────
// Evidence path: SL-ARCH-001 through SL-ARCH-020

const DIAG_SL_BASE          : Word64 = 0x5900
pub const SL_MAX_DEPTH      : u32 = 40
pub const SL_INLINE_MAX     : u32 = 128       // Max inline target length
pub const SL_MAX_TARGET     : u32 = 1024      // Max symlink target path
pub const SL_LOOP_DETECT_SIZE : u32 = 40     // Loop detection table size

const BOUND_SL_SMALL        : u32 = 64
const BOUND_SL_MEDIUM       : u32 = 256
const BOUND_SL_LARGE        : u32 = 1024

// ──────────────────────────────────────────────
// Symlink Error Types
// ──────────────────────────────────────────────
// Evidence path: SL-ERR-001 through SL-ERR-010

pub type SymlinkError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl SymlinkError {
    pub fn new(code: Word64, msg: FixedString[128]) -> SymlinkError
        effects: [deterministic]
    {
        SymlinkError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }
}

impl Error for SymlinkError {
    fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }
    fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }
    fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust
    }
    fn in_range(self, base: Word64, end: Word64) -> bool
        effects: [deterministic]
    {
        self.code.gte(base) && self.code.lte(end)
    }
}

pub fn sl_error(msg: FixedString[128]) -> SymlinkError
    effects: [deterministic]
{
    SymlinkError::new(Word64::from_u64(DIAG_SL_BASE | 0x001), msg)
}

pub fn sl_loop(msg: FixedString[128]) -> SymlinkError
    effects: [deterministic]
{
    SymlinkError::new(Word64::from_u64(DIAG_SL_BASE | 0x002), msg)
}

pub fn sl_too_long(msg: FixedString[128]) -> SymlinkError
    effects: [deterministic]
{
    SymlinkError::new(Word64::from_u64(DIAG_SL_BASE | 0x003), msg)
}

pub fn sl_not_found(msg: FixedString[128]) -> SymlinkError
    effects: [deterministic]
{
    SymlinkError::new(Word64::from_u64(DIAG_SL_BASE | 0x004), msg)
}

// ──────────────────────────────────────────────
// Symlink Target Storage
// ──────────────────────────────────────────────
// Evidence path: SL-STORAGE-001 through SL-STORAGE-020

pub type SymlinkStorage : struct {
    target: Byte[1024],                // Symlink target path
    target_length: Word32,             // Target length
    is_inline: bool,                   // Stored inline in inode
    block_number: Word64,              // Block number if extent-based
}

impl SymlinkStorage {
    pub fn new() -> SymlinkStorage
        effects: [deterministic]
    {
        SymlinkStorage {
            target: [Byte::from_u8(0); 1024],
            target_length: Word32::from_u32(0),
            is_inline: true,
            block_number: Word64::zero(),
        }
    }

    pub fn from_target(target_path: Byte[Slice]) -> Result[SymlinkStorage, SymlinkError>
        effects: [deterministic]
    {
        let len: u32 = target_path.len()
        if len > SL_MAX_TARGET {
            return Result::Err(sl_too_long("Symlink target exceeds maximum length"))
        }
        let mut ss: SymlinkStorage = SymlinkStorage::new()
        ss.target_length = Word32::from_u32(len)
        // Copy target.
        // loop: bounds[BOUND_SL_LARGE] — bounded by 1024
        loop: bounds[BOUND_SL_LARGE] for i in 0..len {
            ss.target[i as usize] = target_path[i as usize]
        }
        ss.is_inline = len <= SL_INLINE_MAX
        Result::Ok(ss)
    }

    pub fn target_path(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let len: u32 = self.target_length.to_u32()
        let mut slice: Byte[Slice] = Byte[Slice]::new(len)
        // loop: bounds[BOUND_SL_LARGE] — bounded by len
        loop: bounds[BOUND_SL_LARGE] for i in 0..len {
            slice[i] = self.target[i as usize]
        }
        slice
    }

    pub fn target_as_string(self) -> FixedString[1024]
        effects: [deterministic]
    {
        let len: u32 = self.target_length.to_u32()
        let mut s: FixedString[1024] = FixedString::new()
        // loop: bounds[BOUND_SL_LARGE] — bounded by len
        loop: bounds[BOUND_SL_LARGE] for i in 0..len {
            s.push_byte(self.target[i as usize])
        }
        s
    }

    pub fn target_length(self) -> u32
        effects: [deterministic]
    {
        self.target_length.to_u32()
    }

    pub fn is_absolute_target(self) -> bool
        effects: [deterministic]
    {
        self.target_length.to_u32() > 0 && self.target[0].eq(Byte::from_u8(b'/'))
    }

    pub fn target_ends_with_slash(self) -> bool
        effects: [deterministic]
    {
        let len: u32 = self.target_length.to_u32()
        len > 0 && self.target[(len - 1) as usize].eq(Byte::from_u8(b'/'))
    }

    pub fn write_inline(self: ref mut, inode: ref mut Inode) -> Result<(), FsError>
        effects: [deterministic]
    {
        let len: u32 = self.target_length.to_u32()
        if len > 128 {
            return Result::Err(fs_invalid("Symlink target too large for inline storage"))
        }
        inode.flags.set_flag(INODE_FLAG_INLINE_DATA)
        inode.inline_data_len = len
        // loop: bounds[BOUND_SL_SMALL] — bounded by 128
        loop: bounds[BOUND_SL_SMALL] for i in 0..len {
            inode.inline_data[i as usize] = self.target[i as usize]
        }
        inode.file_size = Word64::from_u64(len as u64)
        inode.touch_modification_time()
        Result::Ok(())
    }

    pub fn read_inline(inode: Inode) -> SymlinkStorage
        effects: [deterministic]
    {
        let len: u32 = inode.inline_data_len
        let mut ss: SymlinkStorage = SymlinkStorage::new()
        ss.target_length = Word32::from_u32(len)
        ss.is_inline = true
        // loop: bounds[BOUND_SL_SMALL] — bounded by 128
        loop: bounds[BOUND_SL_SMALL] for i in 0..len {
            if i < 1024 {
                ss.target[i as usize] = inode.inline_data[i as usize]
            }
        }
        ss
    }
}

// ──────────────────────────────────────────────
// Symlink Loop Detector
// ──────────────────────────────────────────────
// Evidence path: SL-LOOP-001 through SL-LOOP-020

pub type SymlinkLoopDetector : struct {
    visited_inodes: FixedArray[40, Word64],
    visited_count: Word32,
    max_depth: Word32,
    current_depth: Word32,
}

impl SymlinkLoopDetector {
    pub fn new() -> SymlinkLoopDetector
        effects: [deterministic]
    {
        SymlinkLoopDetector {
            visited_inodes: FixedArray::new(),
            visited_count: Word32::from_u32(0),
            max_depth: Word32::from_u32(SL_MAX_DEPTH),
            current_depth: Word32::from_u32(0),
        }
    }

    pub fn push_inode(self: ref mut, inum: Word64) -> Result<(), SymlinkError>
        effects: [deterministic]
    {
        if self.current_depth.to_u32() >= self.max_depth.to_u32() {
            return Result::Err(sl_loop("Maximum symlink depth exceeded"))
        }
        // Check for loop.
        // loop: bounds[BOUND_SL_SMALL] — bounded by 40
        loop: bounds[BOUND_SL_SMALL] for i in 0..self.visited_inodes.len() {
            let existing: Word64 = self.visited_inodes.get(i).unwrap_or(Word64::zero())
            if existing.eq(inum) {
                return Result::Err(sl_loop("Symlink loop detected"))
            }
        }
        if self.visited_inodes.is_full() {
            return Result::Err(sl_loop("Symlink visited inode table full"))
        }
        self.visited_inodes.push(inum)
        self.visited_count = Word32::from_u32(self.visited_inodes.len())
        self.current_depth = self.current_depth.checked_add(Word32::from_u32(1)).unwrap_or(self.current_depth)
        Result::Ok(())
    }

    pub fn pop_inode(self: ref mut)
        effects: [deterministic]
    {
        if self.visited_inodes.len() > 0 {
            self.visited_inodes.pop()
            self.visited_count = Word32::from_u32(self.visited_inodes.len())
            if self.current_depth.to_u32() > 0 {
                self.current_depth = self.current_depth.checked_sub(Word32::from_u32(1)).unwrap_or(Word32::from_u32(0))
            }
        }
    }

    pub fn depth(self) -> u32
        effects: [deterministic]
    {
        self.current_depth.to_u32()
    }

    pub fn at_max_depth(self) -> bool
        effects: [deterministic]
    {
        self.current_depth.to_u32() >= self.max_depth.to_u32()
    }

    pub fn reset(self: ref mut)
        effects: [deterministic]
    {
        self.visited_inodes.clear()
        self.visited_count = Word32::from_u32(0)
        self.current_depth = Word32::from_u32(0)
    }

    pub fn residual_loop_detected(self, inum: Word64)
        effects: [io, deterministic]
    {
        residual emit {
            subsystem: "symlink_loop_detector",
            operation: "loop_detected",
            inode: inum,
            depth: self.current_depth,
            timestamp: __builtin_timestamp(),
        }
    }
}

// ──────────────────────────────────────────────
// Symlink Creation
// ──────────────────────────────────────────────
// Evidence path: SL-CREATE-001 through SL-CREATE-020

pub fn create_symlink(
    fs: ref mut PhorensicFS,
    parent_inum: Word64,
    link_name: Byte[Slice],
    target: Byte[Slice],
    owner: Identity,
    group: Identity,
    cap: Capability
) -> Result[Word64, SymlinkError>
    effects: [io, deterministic]
{
    if fs.is_read_only() {
        return Result::Err(sl_error("Filesystem is read-only"))
    }

    // Validate target length.
    if target.len() > SL_MAX_TARGET {
        return Result::Err(sl_too_long("Symlink target too long"))
    }
    if target.len() == 0 {
        return Result::Err(sl_error("Symlink target cannot be empty"))
    }

    // In a real implementation:
    // 1. Allocate an inode of type InodeType_Symlink
    // 2. Store the target (inline if <= 128 bytes, extent otherwise)
    // 3. Add directory entry to parent
    // 4. Record residual

    let symlink_inum: Word64 = Word64::from_u64(4)  // Placeholder

    let storage: SymlinkStorage = SymlinkStorage::from_target(target)?
    let inline: bool = storage.is_inline

    residual emit {
        subsystem: "symlink",
        operation: "create",
        link_inode: symlink_inum,
        parent_inode: parent_inum,
        target_length: target.len(),
        is_inline: inline,
        owner: owner,
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(symlink_inum)
}

// ──────────────────────────────────────────────
// Symlink Resolution
// ──────────────────────────────────────────────
// Evidence path: SL-RESOLVE-001 through SL-RESOLVE-025

pub type SymlinkResolutionResult : struct {
    resolved_path: Byte[1024],           // Resolved target path
    resolved_length: Word32,             // Length of resolved path
    symlinks_followed: Word32,           // Number of symlinks followed
    is_absolute: bool,                   // Result is absolute
    success: bool,                       // Resolution succeeded
}

impl SymlinkResolutionResult {
    pub fn new() -> SymlinkResolutionResult
        effects: [deterministic]
    {
        SymlinkResolutionResult {
            resolved_path: [Byte::from_u8(0); 1024],
            resolved_length: Word32::from_u32(0),
            symlinks_followed: Word32::from_u32(0),
            is_absolute: false,
            success: false,
        }
    }

    pub fn set_path(self: ref mut, path: Byte[Slice])
        effects: [deterministic]
    {
        let len: u32 = path.len()
        if len > 1024 { return }
        self.resolved_length = Word32::from_u32(len)
        // loop: bounds[BOUND_SL_LARGE] — bounded by len
        loop: bounds[BOUND_SL_LARGE] for i in 0..len {
            self.resolved_path[i as usize] = path[i as usize]
        }
        self.is_absolute = path.len() > 0 && path[0].eq(Byte::from_u8(b'/'))
    }

    pub fn get_path(self) -> Byte[Slice]
        effects: [deterministic]
    {
        let len: u32 = self.resolved_length.to_u32()
        let mut slice: Byte[Slice] = Byte[Slice]::new(len)
        // loop: bounds[BOUND_SL_LARGE] — bounded by len
        loop: bounds[BOUND_SL_LARGE] for i in 0..len {
            slice[i] = self.resolved_path[i as usize]
        }
        slice
    }
}

pub fn resolve_symlink(
    inode: Inode,
    parent_path: Byte[Slice],
    loop_detector: ref mut SymlinkLoopDetector
) -> Result[SymlinkResolutionResult, SymlinkError>
    effects: [io, deterministic]
{
    let result: SymlinkResolutionResult = SymlinkResolutionResult::new()

    // Read symlink target from inode.
    let storage: SymlinkStorage
    if inode.flags.has_flag(INODE_FLAG_INLINE_DATA) {
        storage = SymlinkStorage::read_inline(inode)
    } else {
        // In a real implementation, read from extent tree.
        storage = SymlinkStorage::new()
    }

    let target: Byte[Slice] = storage.target_path()
    if target.len() == 0 {
        return Result::Err(sl_not_found("Symlink target is empty"))
    }

    // Check for loop.
    loop_detector.push_inode(inode.inode_number)?

    // Resolve target.
    let resolved: Byte[Slice]
    if storage.is_absolute_target() {
        resolved = target
    } else {
        // Relative target: resolve against parent path.
        let parent_str: Byte[Slice] = parent_path
        // In a real implementation, concatenate parent + target.
        resolved = target
    }

    result.set_path(resolved)
    result.symlinks_followed = Word32::from_u32(loop_detector.depth())
    result.success = true

    residual emit {
        subsystem: "symlink",
        operation: "resolve",
        inode: inode.inode_number,
        target_length: target.len(),
        depth: loop_detector.depth(),
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(result)
}

// ──────────────────────────────────────────────
// Symlink Read/Write Operations
// ──────────────────────────────────────────────
// Evidence path: SL-RW-001 through SL-RW-015

pub fn read_symlink_target(inode: Inode) -> Result[Byte[Slice], SymlinkError>
    effects: [io, deterministic]
{
    if !inode.is_symlink() {
        return Result::Err(sl_error("Inode is not a symlink"))
    }
    let storage: SymlinkStorage
    if inode.flags.has_flag(INODE_FLAG_INLINE_DATA) {
        storage = SymlinkStorage::read_inline(inode)
    } else {
        storage = SymlinkStorage::new()
    }
    Result::Ok(storage.target_path())
}

pub fn update_symlink_target(
    fs: ref mut PhorensicFS,
    inode: ref mut Inode,
    new_target: Byte[Slice]
) -> Result<(), SymlinkError>
    effects: [io, deterministic]
{
    if fs.is_read_only() {
        return Result::Err(sl_error("Filesystem is read-only"))
    }
    if !inode.is_symlink() {
        return Result::Err(sl_error("Inode is not a symlink"))
    }
    if new_target.len() > SL_MAX_TARGET {
        return Result::Err(sl_too_long("Symlink target too long"))
    }

    let storage: SymlinkStorage = SymlinkStorage::from_target(new_target)?
    if storage.is_inline {
        storage.write_inline(inode)
    }

    residual emit {
        subsystem: "symlink",
        operation: "update_target",
        inode: inode.inode_number,
        new_target_length: new_target.len(),
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(())
}

// ──────────────────────────────────────────────
// Symlink Deletion
// ──────────────────────────────────────────────
// Evidence path: SL-DELETE-001 through SL-DELETE-010

pub fn delete_symlink(
    fs: ref mut PhorensicFS,
    parent_inum: Word64,
    link_name: Byte[Slice]
) -> Result<(), SymlinkError>
    effects: [io, deterministic]
{
    if fs.is_read_only() {
        return Result::Err(sl_error("Filesystem is read-only"))
    }

    residual emit {
        subsystem: "symlink",
        operation: "delete",
        parent_inode: parent_inum,
        name_length: link_name.len(),
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(())
}

// ──────────────────────────────────────────────
// Bounded Symlink Resolution Chain
// ──────────────────────────────────────────────
// Evidence path: SL-CHAIN-001 through SL-CHAIN-015

pub fn resolve_symlink_chain(
    starting_inode: Inode,
    starting_path: Byte[Slice],
    max_follows: u32
) -> Result[SymlinkResolutionResult, SymlinkError>
    effects: [io, deterministic]
{
    let mut detector: SymlinkLoopDetector = SymlinkLoopDetector::new()
    let mut current_inode: Inode = starting_inode
    let mut current_path: Byte[1024] = [Byte::from_u8(0); 1024]
    let mut current_len: u32 = starting_path.len()
    // loop: bounds[BOUND_SL_SMALL] — bounded by max_follows
    loop: bounds[BOUND_SL_SMALL] for i in 0..current_len {
        current_path[i as usize] = starting_path[i as usize]
    }
    let mut follows: u32 = 0

    // loop: bounds[BOUND_SL_SMALL] — bounded by 40
    loop: bounds[BOUND_SL_SMALL] while follows < max_follows {
        if !current_inode.is_symlink() {
            break
        }
        let parent_slice: Byte[Slice] = Byte[Slice]::from_array(&current_path, current_len)
        let result: SymlinkResolutionResult = resolve_symlink(current_inode, parent_slice, ref mut detector)?
        let target_path: Byte[Slice] = result.get_path()
        current_len = target_path.len()
        // loop: bounds[BOUND_SL_LARGE] — bounded by 1024
        loop: bounds[BOUND_SL_LARGE] for j in 0..current_len {
            current_path[j as usize] = target_path[j as usize]
        }
        follows = follows + 1
        // In a real implementation, look up the target inode.
        // Placeholder: break after first symlink.
        break
    }

    let mut final_result: SymlinkResolutionResult = SymlinkResolutionResult::new()
    let final_path: Byte[Slice] = Byte[Slice]::from_array(&current_path, current_len)
    final_result.set_path(final_path)
    final_result.symlinks_followed = Word32::from_u32(follows)
    final_result.success = true

    Result::Ok(final_result)
}

// ──────────────────────────────────────────────
// Symlink Capability Check
// ──────────────────────────────────────────────
// Evidence path: SL-CAP-001 through SL-CAP-010

pub fn check_symlink_creation_capability(cap: Capability) -> Result<(), SymlinkError>
    effects: [deterministic]
{
    let rights: RightsSet = cap.rights()
    if !rights.has(CAP_RIGHT_CREATE) {
        return Result::Err(sl_error("Capability lacks create right for symlinks"))
    }
    Result::Ok(())
}

pub fn check_symlink_read_capability(cap: Capability) -> Result<(), SymlinkError>
    effects: [deterministic]
{
    let rights: RightsSet = cap.rights()
    if !rights.has(CAP_RIGHT_READ) {
        return Result::Err(sl_error("Capability lacks read right for symlinks"))
    }
    Result::Ok(())
}

pub fn check_symlink_delete_capability(cap: Capability) -> Result<(), SymlinkError>
    effects: [deterministic]
{
    let rights: RightsSet = cap.rights()
    if !rights.has(CAP_RIGHT_DELETE) {
        return Result::Err(sl_error("Capability lacks delete right for symlinks"))
    }
    Result::Ok(())
}

// ──────────────────────────────────────────────
// Symlink Target Validation
// ──────────────────────────────────────────────
// Evidence path: SL-VALIDATE-001 through SL-VALIDATE-020

pub fn validate_symlink_target(target: Byte[Slice]) -> bool
    effects: [deterministic]
{
    let len: u32 = target.len()
    if len == 0 || len > SL_MAX_TARGET {
        return false
    }
    // Validate each byte.
    // loop: bounds[BOUND_SL_LARGE] — bounded by len
    loop: bounds[BOUND_SL_LARGE] for i in 0..len {
        let b: Byte = target[i as usize]
        if b.eq(Byte::from_u8(0)) {
            return false
        }
    }
    true
}

pub fn symlink_target_type(target: Byte[Slice]) -> InodeType
    effects: [deterministic]
{
    let len: u32 = target.len()
    if len > 0 && target[(len - 1) as usize].eq(Byte::from_u8(b'/')) {
        InodeType::InodeType_Directory
    } else {
        InodeType::InodeType_File
    }
}

pub fn symlink_needs_extent(target_len: u32) -> bool
    effects: [deterministic]
{
    target_len > SL_INLINE_MAX
}

// ──────────────────────────────────────────────
// Symlink Resolution Cache
// ──────────────────────────────────────────────
// Evidence path: SL-CACHE-001 through SL-CACHE-020

pub type SymlinkCacheEntry : struct {
    inode_number: Word64,
    target: Byte[1024],
    target_length: Word32,
    valid: bool,
    timestamp: Word64,
}

impl SymlinkCacheEntry {
    pub fn empty() -> SymlinkCacheEntry
        effects: [deterministic]
    {
        SymlinkCacheEntry {
            inode_number: Word64::zero(),
            target: [Byte::from_u8(0); 1024],
            target_length: Word32::from_u32(0),
            valid: false,
            timestamp: Word64::zero(),
        }
    }

    pub fn new(inum: Word64, target_path: Byte[Slice]) -> SymlinkCacheEntry
        effects: [deterministic]
    {
        let len: u32 = target_path.len()
        let mut entry: SymlinkCacheEntry = SymlinkCacheEntry {
            inode_number: inum,
            target: [Byte::from_u8(0); 1024],
            target_length: Word32::from_u32(len),
            valid: true,
            timestamp: __builtin_timestamp(),
        }
        // loop: bounds[BOUND_SL_LARGE] — bounded by len
        loop: bounds[BOUND_SL_LARGE] for i in 0..len {
            if i < 1024 { entry.target[i as usize] = target_path[i as usize] }
        }
        entry
    }

    pub fn matches(self, inum: Word64) -> bool
        effects: [deterministic]
    {
        self.valid && self.inode_number.eq(inum)
    }
}

pub type SymlinkCache : struct {
    entries: FixedArray[64, SymlinkCacheEntry],
    hits: Word32,
    misses: Word32,
}

impl SymlinkCache {
    pub fn new() -> SymlinkCache
        effects: [deterministic]
    {
        SymlinkCache {
            entries: FixedArray::new(),
            hits: Word32::from_u32(0),
            misses: Word32::from_u32(0),
        }
    }

    pub fn lookup(self: ref mut, inum: Word64) -> Option[SymlinkCacheEntry>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SL_SMALL] — bounded by 64
        loop: bounds[BOUND_SL_SMALL] for i in 0..self.entries.len() {
            let entry: SymlinkCacheEntry = self.entries.get(i).unwrap_or(SymlinkCacheEntry::empty())
            if entry.matches(inum) {
                self.hits = self.hits.checked_add(Word32::from_u32(1)).unwrap_or(self.hits)
                return Option::Some(entry)
            }
        }
        self.misses = self.misses.checked_add(Word32::from_u32(1)).unwrap_or(self.misses)
        Option::None
    }

    pub fn insert(self: ref mut, entry: SymlinkCacheEntry)
        effects: [deterministic]
    {
        if !self.entries.is_full() {
            self.entries.push(entry)
            return
        }
        // LRU eviction.
        let mut oldest_idx: u32 = 0
        let mut oldest_time: Word64 = self.entries.get(0).unwrap_or(SymlinkCacheEntry::empty()).timestamp
        // loop: bounds[BOUND_SL_SMALL] — bounded by 64
        loop: bounds[BOUND_SL_SMALL] for i in 1..self.entries.len() {
            let e: SymlinkCacheEntry = self.entries.get(i).unwrap_or(SymlinkCacheEntry::empty())
            if e.timestamp.lt(oldest_time) {
                oldest_time = e.timestamp
                oldest_idx = i
            }
        }
        self.entries.set(oldest_idx, entry)
    }

    pub fn invalidate(self: ref mut, inum: Word64)
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SL_SMALL] — bounded by 64
        loop: bounds[BOUND_SL_SMALL] for i in 0..self.entries.len() {
            if self.entries.get(i).unwrap_or(SymlinkCacheEntry::empty()).matches(inum) {
                let mut e: SymlinkCacheEntry = self.entries.get(i).unwrap_or(SymlinkCacheEntry::empty())
                e.valid = false
                self.entries.set(i, e)
                break
            }
        }
    }
}

// ──────────────────────────────────────────────
// Symlink Residual Recording
// ──────────────────────────────────────────────
// Evidence path: SL-RESID-001 through SL-RESID-015

pub fn residual_symlink_event(event: FixedString[64], inum: Word64, depth: Word32, target_len: u32)
    effects: [io, deterministic]
{
    residual emit {
        subsystem: "symlink",
        event: event,
        inode: inum,
        depth: depth,
        target_length: target_len,
        timestamp: __builtin_timestamp(),
    }
}

pub fn residual_symlink_loop(inum: Word64, visited: Word32)
    effects: [io, deterministic]
{
    residual emit {
        subsystem: "symlink",
        event: "loop_detected",
        inode: inum,
        visited_inodes: visited,
        timestamp: __builtin_timestamp(),
    }
}

// ──────────────────────────────────────────────
// Symlink Verification
// ──────────────────────────────────────────────
// Evidence path: SL-VERIFY-001 through SL-VERIFY-015

pub fn verify_symlink_inode(inode: Inode) -> FixedArray[16, SymlinkError>
    effects: [deterministic]
{
    let mut errors: FixedArray[16, SymlinkError> = FixedArray::new()
    if !inode.is_symlink() {
        errors.push(sl_error("Inode is not a symlink type"))
        return errors
    }
    if inode.flags.has_flag(INODE_FLAG_INLINE_DATA) {
        if inode.inline_data_len == 0 || inode.inline_data_len > 128 {
            errors.push(sl_error("Symlink inline data length invalid"))
        }
        if inode.file_size.to_u32() != inode.inline_data_len {
            errors.push(sl_error("Symlink file size does not match inline data length"))
        }
    } else {
        if inode.extent_tree.total_logical_blocks().is_zero() && inode.file_size.gt(Word64::zero()) {
            errors.push(sl_error("Symlink has no extents but file size is non-zero"))
        }
    }
    errors
}

// ──────────────────────────────────────────────
// Symlink Target Path Manipulation
// ──────────────────────────────────────────────
// Evidence path: SL-MANIP-001 through SL-MANIP-020

pub fn resolve_relative_symlink(link_dir: Byte[Slice], target: Byte[Slice]) -> Byte[Slice]
    effects: [deterministic]
{
    if target.len() > 0 && target[0].eq(Byte::from_u8(b'/')) {
        return target  // Absolute target
    }
    // Combine link directory with relative target.
    let dir_len: u32 = link_dir.len()
    let tgt_len: u32 = target.len()
    let total: u32 = dir_len + 1 + tgt_len
    if total > SL_MAX_TARGET {
        return target  // Fallback
    }
    let mut result: Byte[1024] = [Byte::from_u8(0); 1024]
    let mut pos: u32 = 0
    // loop: bounds[BOUND_SL_LARGE] — bounded by dir_len
    loop: bounds[BOUND_SL_LARGE] for i in 0..dir_len {
        result[pos] = link_dir[i as usize]
        pos = pos + 1
    }
    if dir_len > 0 && link_dir[(dir_len - 1) as usize].neq(Byte::from_u8(b'/')) {
        result[pos] = Byte::from_u8(b'/')
        pos = pos + 1
    }
    // loop: bounds[BOUND_SL_LARGE] — bounded by tgt_len
    loop: bounds[BOUND_SL_LARGE] for i in 0..tgt_len {
        result[pos] = target[i as usize]
        pos = pos + 1
    }
    let mut slice: Byte[Slice] = Byte[Slice]::new(pos)
    // loop: bounds[BOUND_SL_LARGE] — bounded by pos
    loop: bounds[BOUND_SL_LARGE] for i in 0..pos {
        slice[i] = result[i as usize]
    }
    slice
}

pub fn symlink_target_contains_loop(target: Byte[Slice], visited: FixedArray[40, Word64>) -> bool
    effects: [deterministic]
{
    // Check if the target path itself encodes a loop.
    // This is a simplified check for paths that reference themselves.
    let target_str: FixedString[1024] = FixedString::from_slice(target)
    // loop: bounds[BOUND_SL_SMALL] — bounded by 40
    loop: bounds[BOUND_SL_SMALL] for i in 0..visited.len() {
        // Check if target mentions the visited inode number.
        // In a real implementation, do a proper check.
    }
    false
}

pub fn symlink_depth_remaining(current_depth: u32, max_depth: u32) -> u32
    effects: [deterministic]
{
    if current_depth >= max_depth { 0 } else { max_depth - current_depth }
}

// ──────────────────────────────────────────────
// Symlink Batch Operations
// ──────────────────────────────────────────────
// Evidence path: SL-BATCH-001 through SL-BATCH-015

pub fn batch_create_symlinks(
    fs: ref mut PhorensicFS,
    parent_inum: Word64,
    links: FixedArray[16, (Byte[255], Byte[1024])>,
    owner: Identity,
    group: Identity,
    cap: Capability
) -> FixedArray[16, Result[Word64, SymlinkError>>
    effects: [io, deterministic]
{
    let mut results: FixedArray[16, Result[Word64, SymlinkError>> = FixedArray::new()
    // loop: bounds[BOUND_SL_SMALL] — bounded by 16
    loop: bounds[BOUND_SL_SMALL] for i in 0..links.len() {
        let (name_bytes, target_bytes): (Byte[255], Byte[1024]) = links.get(i).unwrap_or(([Byte::from_u8(0); 255], [Byte::from_u8(0); 1024]))
        // Create slices for name and target.
        let mut name_slice: Byte[Slice] = Byte[Slice]::new(255)
        for j in 0..255 { name_slice[j] = name_bytes[j] }
        let mut target_slice: Byte[Slice] = Byte[Slice]::new(1024)
        for j in 0..1024 { target_slice[j] = target_bytes[j] }
        let result: Result[Word64, SymlinkError> = create_symlink(fs, parent_inum, name_slice, target_slice, owner, group, cap)
        results.push(result)
    }
    results
}

pub fn batch_resolve_symlinks(
    inodes: FixedArray[16, Inode>,
    base_paths: FixedArray[16, Byte[1024]>
) -> FixedArray[16, Result[SymlinkResolutionResult, SymlinkError>>
    effects: [io, deterministic]
{
    let mut results: FixedArray[16, Result[SymlinkResolutionResult, SymlinkError>> = FixedArray::new()
    // loop: bounds[BOUND_SL_SMALL] — bounded by 16
    loop: bounds[BOUND_SL_SMALL] for i in 0..inodes.len() {
        let inode: Inode = inodes.get(i).unwrap_or(
            Inode::new(Word64::zero(), InodeType::InodeType_Unknown, Identity::null(), Identity::null()))
        let base_path: Byte[1024] = base_paths.get(i).unwrap_or([Byte::from_u8(0); 1024])
        let mut detector: SymlinkLoopDetector = SymlinkLoopDetector::new()
        let base_slice: Byte[Slice] = Byte[Slice]::from_array(&base_path, 1024)
        let result: Result[SymlinkResolutionResult, SymlinkError> = resolve_symlink(inode, base_slice, ref mut detector)
        results.push(result)
    }
    results
}

// ──────────────────────────────────────────────
// Symlink Verification Helpers
// ──────────────────────────────────────────────
// Evidence path: SL-VFY-001 through SL-VFY-020

pub fn verify_symlink_target_path(target: Byte[Slice]) -> bool
    effects: [deterministic]
{
    if target.len() == 0 || target.len() > SL_MAX_TARGET {
        return false
    }
    // loop: bounds[BOUND_SL_LARGE] — bounded by target length
    loop: bounds[BOUND_SL_LARGE] for i in 0..target.len() {
        let b: Byte = target[i as usize]
        if b.eq(Byte::from_u8(0)) {
            return false
        }
    }
    true
}

pub fn symlink_count_links_in_dir(dir_ops: DirectoryOps, inum: Word64) -> Word32
    effects: [io, deterministic]
{
    let mut count: Word32 = Word32::from_u32(0)
    let mut cursor: DirCursor = DirCursor::new(dir_ops.dir_inode, dir_ops.mount_id)
    // loop: bounds[BOUND_DIR_LARGE] — bounded by 4096
    loop: bounds[BOUND_DIR_LARGE] for _ in 0..4096 {
        let entry_opt: Option[DirEntry> = cursor.next_entry()
        if entry_opt.is_none() { break }
        let entry: DirEntry = entry_opt.unwrap()
        if entry.inode_number.eq(inum) && !entry.is_empty_slot() {
            count = count.checked_add(Word32::from_u32(1)).unwrap_or(count)
        }
    }
    count
}

pub fn symlink_check_max_depth(current: u32, max: u32) -> bool
    effects: [deterministic]
{
    current < max
}

pub fn symlink_storage_mode(inode: Inode) -> FixedString[16]
    effects: [deterministic]
{
    if inode.flags.has_flag(INODE_FLAG_INLINE_DATA) {
        FixedString[16]::from_slice("inline")
    } else if inode.extent_tree.extent_count() > 0 {
        FixedString[16]::from_slice("extent")
    } else {
        FixedString[16]::from_slice("unknown")
    }
}

pub fn residual_symlink_batch(count: Word32, succeeded: Word32)
    effects: [io, deterministic]
{
    residual emit {
        subsystem: "symlink_batch",
        total: count,
        succeeded: succeeded,
        timestamp: __builtin_timestamp(),
    }
}
