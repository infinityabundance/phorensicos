// hid_input.phor — HID input driver
// Report descriptor parsing, event emission, keyboard/mouse handling
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/hid_input.phor
// Court: hid_driver:v2

package drivers.hid_input;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type HidError = enum {
    HidNotInitialized       = 0xE0,  // E00E0: HID driver not initialized
    HidDeviceNotFound       = 0xE1,  // E00E1: HID device not found
    HidDescriptorInvalid    = 0xE2,  // E00E2: HID report descriptor invalid
    HidReportUnknown        = 0xE3,  // E00E3: unknown HID report type
    HidCapabilityError      = 0xE4,  // E00E4: insufficient capability
    HidQueueFull            = 0xE5,  // E00E5: input event queue full
    HidQueueEmpty           = 0xE6,  // E00E6: input event queue empty
    HidUnsupportedDevice    = 0xE7,  // E00E7: unsupported HID device type
    HidDescriptorTooLarge   = 0xE8,  // E00E8: HID descriptor exceeds max size
    HidParseError           = 0xE9,  // E00E9: HID descriptor parse error
    HidReportIdMismatch     = 0xEA,  // E00EA: report ID does not match descriptor
    HidProtocolError        = 0xEB,  // E00EB: HID protocol error
    HidDeviceDisconnected   = 0xEC,  // E00EC: HID device disconnected
    HidStaleInput           = 0xED,  // E00ED: input data is stale
}

// ─────────────────────────────────────────────────────────────
// HID Device Types
// ─────────────────────────────────────────────────────────────

type HidDeviceType = enum {
    Unknown     = 0,
    Keyboard    = 1,
    Mouse       = 2,
    Gamepad     = 3,
    Touchscreen = 4,
    Touchpad    = 5,
    Digitizer   = 6,
    Consumer    = 7,  // Consumer control (volume, media keys)
    System      = 8,  // System control (power, sleep)
}

// ─────────────────────────────────────────────────────────────
// Input Event Types
// ─────────────────────────────────────────────────────────────

type InputEventType = enum {
    KeyDown       = 0,
    KeyUp         = 1,
    MouseMove     = 2,
    MouseButtonDown = 3,
    MouseButtonUp = 4,
    MouseScroll   = 5,
    TouchEvent    = 6,
    GamepadAxis   = 7,
    GamepadButton = 8,
    ConsumerKey   = 9,
    SystemKey     = 10,
    RawReport     = 11,
}

// ─────────────────────────────────────────────────────────────
// HID Usage IDs (simplified)
// ─────────────────────────────────────────────────────────────

type HidUsageId = u16;

struct HidUsageConstants {
    // Keyboard usage page (0x07)
    keyboard_a: u64,
    keyboard_b: u64,
    keyboard_c: u64,
    keyboard_d: u64,
    keyboard_e: u64,
    keyboard_f: u64,
    keyboard_g: u64,
    keyboard_h: u64,
    keyboard_i: u64,
    keyboard_j: u64,
    keyboard_k: u64,
    keyboard_l: u64,
    keyboard_m: u64,
    keyboard_n: u64,
    keyboard_o: u64,
    keyboard_p: u64,
    keyboard_q: u64,
    keyboard_r: u64,
    keyboard_s: u64,
    keyboard_t: u64,
    keyboard_u: u64,
    keyboard_v: u64,
    keyboard_w: u64,
    keyboard_x: u64,
    keyboard_y: u64,
    keyboard_z: u64,
    keyboard_1: u64,
    keyboard_2: u64,
    keyboard_3: u64,
    keyboard_4: u64,
    keyboard_5: u64,
    keyboard_6: u64,
    keyboard_7: u64,
    keyboard_8: u64,
    keyboard_9: u64,
    keyboard_0: u64,
    keyboard_enter: u64,
    keyboard_escape: u64,
    keyboard_backspace: u64,
    keyboard_tab: u64,
    keyboard_space: u64,
    keyboard_shift_left: u64,
    keyboard_control_left: u64,
    keyboard_alt_left: u64,
    keyboard_gui_left: u64,
    keyboard_shift_right: u64,
    keyboard_control_right: u64,
    keyboard_alt_right: u64,
    keyboard_gui_right: u64,
    // Mouse usage page (0x09)
    mouse_pointer: u64,
    mouse_left_button: u64,
    mouse_right_button: u64,
    mouse_middle_button: u64,
    mouse_x: u64,
    mouse_y: u64,
    mouse_wheel: u64,
}

// ─────────────────────────────────────────────────────────────
// Input Event
// ─────────────────────────────────────────────────────────────

struct InputEvent {
    event_type: InputEventType,
    device_id: Identity,
    timestamp: u64,
    key_code: u16,
    key_modifiers: u8,
    mouse_x: i64,
    mouse_y: i64,
    mouse_buttons: u8,
    scroll_delta: i64,
    touch_points: u64,
    pressure: u16,
    report_id: u8,
    raw_data: Array(u8, 64),
    raw_length: u64,
    residual: ResidualRecord,
}

// ─────────────────────────────────────────────────────────────
// HID Report Item
// ─────────────────────────────────────────────────────────────

struct HidReportItem {
    item_type: HidItemType,
    item_tag: u8,
    data: u64,
    data_size: u8,
}

type HidItemType = enum {
    Main             = 0,   // Input, Output, Feature, Collection, EndCollection
    Global           = 1,   // UsagePage, LogicalMin/Max, PhysicalMin/Max, ReportSize, ReportCount, ReportId
    Local            = 2,   // Usage, UsageMin, UsageMax, DesignatorIndex, StringIndex
    Reserved         = 3,
    LongItem         = 4,
}

// ─────────────────────────────────────────────────────────────
// HID Descriptor Parser State
// ─────────────────────────────────────────────────────────────

struct HidDescriptorParser {
    descriptor: Array(u8, 1024),
    descriptor_length: u64,
    parse_offset: u64,
    usage_page: u16,
    logical_min: i64,
    logical_max: i64,
    report_size: u64,
    report_count: u64,
    report_id: u8,
    current_usages: Array(u16, 16),
    usage_count: u64,
    collection_depth: u64,
    parse_errors: u64,
    device_type: HidDeviceType,
    has_keyboard_descriptor: bool,
    has_mouse_descriptor: bool,
    input_report_size: u64,
    output_report_size: u64,
    feature_report_size: u64,
}

// ─────────────────────────────────────────────────────────────
// HID Device State
// ─────────────────────────────────────────────────────────────

struct HidDevice {
    device_id: Identity,
    device_type: HidDeviceType,
    descriptor_parsed: bool,
    descriptor: Array(u8, 1024),
    descriptor_length: u64,
    input_report: Array(u8, 64),
    input_report_length: u64,
    output_report: Array(u8, 64),
    output_report_length: u64,
    event_queue: RingBuf(InputEvent, 128),
    prev_keyboard_state: Array(u8, 16),
    keyboard_modifiers: u8,
    mouse_buttons: u8,
    mouse_x: i64,
    mouse_y: i64,
    scroll_accumulator: i64,
    max_event_rate: u64,
    last_event_timestamp: u64,
    capability: Cap(HidCapability),
    residual_log: RingBuf(ResidualRecord, 64),
    initialized: bool,
    connected: bool,
    vendor_id: u16,
    product_id: u16,
    device_name: String(64),
    event_count: u64,
    error_count: u64,
    trust_state: TrustState,
    generation: u64,
}

struct HidCapability {
    object_id: Identity,
    generation: u64,
    can_read: bool,
    can_write: bool,
    can_configure: bool,
    max_devices: u64,
    max_report_size: u64,
    max_events_per_second: u64,
}

// ─────────────────────────────────────────────────────────────
// HID Driver State
// ─────────────────────────────────────────────────────────────

struct HidDriverState {
    devices: Array(HidDevice, 8),
    device_count: u64,
    driver_identity: Identity,
    default_cap: Cap(HidCapability),
    initialized: bool,
    initialization_timestamp: u64,
    total_events_generated: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
}

// ─────────────────────────────────────────────────────────────
// HID Driver Initialization
// ─────────────────────────────────────────────────────────────

fn hid_driver_init(
    driver_identity: Identity,
    cap: Cap(HidCapability),
    timestamp: u64,
) -> HidDriverState
    effect [deterministic, residual]
    court "hid_driver_init:v1"
{
    let state: HidDriverState = HidDriverState {
        devices: Array::zeroed(),
        device_count: 0,
        driver_identity: driver_identity,
        default_cap: cap,
        initialized: true,
        initialization_timestamp: timestamp,
        total_events_generated: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
    };

    residual emit {
        op: "hid_driver.init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Parse HID Report Descriptor
// ─────────────────────────────────────────────────────────────

fn hid_parse_descriptor(
    data: Slice(u8),
) -> HidDescriptorParser
    effect [deterministic]
    court "hid_parse_descriptor:v1"
{
    let mut parser: HidDescriptorParser = HidDescriptorParser {
        descriptor: Array::zeroed(),
        descriptor_length: data.len(),
        parse_offset: 0,
        usage_page: 0,
        logical_min: 0,
        logical_max: 0,
        report_size: 0,
        report_count: 0,
        report_id: 0,
        current_usages: Array::zeroed(),
        usage_count: 0,
        collection_depth: 0,
        parse_errors: 0,
        device_type: HidDeviceType::Unknown,
        has_keyboard_descriptor: false,
        has_mouse_descriptor: false,
        input_report_size: 0,
        output_report_size: 0,
        feature_report_size: 0,
    };

    // Copy descriptor data
    let copy_len: u64 = if data.len() < 1024 { data.len() } else { 1024 };
    for i in 0..copy_len {
        parser.descriptor[i] = data[i];
    };

    // Parse items
    while parser.parse_offset < copy_len {
        let prefix: u8 = parser.descriptor[parser.parse_offset];
        parser.parse_offset = parser.parse_offset + 1;

        let item_type: u8 = (prefix >> 2) & 0x03;
        let item_tag: u8 = (prefix >> 4) & 0x0F;
        let data_size: u8 = prefix & 0x03;

        let actual_size: u64 = if data_size == 0x03 { 4 } else { data_size as u64 };

        let mut item_data: u64 = 0;
        for j in 0..actual_size {
            if parser.parse_offset < copy_len {
                item_data = item_data | ((parser.descriptor[parser.parse_offset] as u64) << (j * 8));
                parser.parse_offset = parser.parse_offset + 1;
            };
        };

        match item_type {
            0 => {
                // Main item
                match item_tag {
                    0x08 => {  // Input
                        let flags: u8 = item_data as u8;
                        let report_bit_size: u64 = parser.report_size * parser.report_count;
                        parser.input_report_size = parser.input_report_size + report_bit_size;

                        // Detect keyboard (keyboard usage page)
                        if parser.usage_page == 0x07 {
                            parser.has_keyboard_descriptor = true;
                            parser.device_type = HidDeviceType::Keyboard;
                        };

                        // Detect mouse (usage page 0x09 or generic desktop 0x01 with mouse usage)
                        if parser.usage_page == 0x09 || parser.usage_page == 0x01 {
                            for k in 0..parser.usage_count {
                                if parser.current_usages[k] == 0x02 {  // Mouse usage
                                    parser.has_mouse_descriptor = true;
                                    parser.device_type = HidDeviceType::Mouse;
                                    break;
                                };
                            };
                        };
                    },
                    0x09 => {  // Output
                        let flags: u8 = item_data as u8;
                        parser.output_report_size = parser.output_report_size + (parser.report_size * parser.report_count);
                    },
                    0x0B => {  // Feature
                        parser.feature_report_size = parser.feature_report_size + (parser.report_size * parser.report_count);
                    },
                    0x0A => {  // Collection
                        parser.collection_depth = parser.collection_depth + 1;
                        // Collection type in item_data
                    },
                    0x0C => {  // End Collection
                        if parser.collection_depth > 0 {
                            parser.collection_depth = parser.collection_depth - 1;
                        };
                    },
                    _ => {},
                };
            },
            1 => {
                // Global item
                match item_tag {
                    0x00 => {  // Usage Page
                        parser.usage_page = item_data as u16;
                    },
                    0x01 => {  // Logical Minimum
                        parser.logical_min = item_data as i64;
                    },
                    0x02 => {  // Logical Maximum
                        parser.logical_max = item_data as i64;
                    },
                    0x07 => {  // Report Size
                        parser.report_size = item_data;
                    },
                    0x08 => {  // Report Count
                        parser.report_count = item_data;
                    },
                    0x09 => {  // Report ID
                        parser.report_id = item_data as u8;
                    },
                    _ => {},
                };
            },
            2 => {
                // Local item
                match item_tag {
                    0x00 => {  // Usage
                        let usage: u16 = item_data as u16;
                        if parser.usage_count < 16 {
                            parser.current_usages[parser.usage_count] = usage;
                            parser.usage_count = parser.usage_count + 1;
                        };
                    },
                    0x01 => {  // Usage Minimum
                        // Not tracked in parser
                    },
                    0x02 => {  // Usage Maximum
                        // Not tracked in parser
                    },
                    _ => {},
                };
            },
            _ => {
                // Reserved or long item
                parser.parse_errors = parser.parse_errors + 1;
            },
        };

        // Bound loop: max descriptor size
        if parser.parse_offset >= 1024 {
            break;
        };
    };

    return parser;
}

// ─────────────────────────────────────────────────────────────
// Register HID Device
// ─────────────────────────────────────────────────────────────

fn hid_register_device(
    state: Handle(HidDriverState),
    descriptor: Slice(u8),
    vendor_id: u16,
    product_id: u16,
    device_name: Slice(u8),
    register_cap: Cap(HidCapability),
    timestamp: u64,
) -> Result(Identity, HidError)
    effect [deterministic, residual]
    court "hid_register:v1"
{
    if !state.initialized {
        return Result::Err(HidError::HidNotInitialized);
    };

    if state.device_count >= 8 {
        return Result::Err(HidError::HidDeviceNotFound);
    };

    // Parse descriptor
    let parser: HidDescriptorParser = hid_parse_descriptor(descriptor);

    if parser.parse_errors > 0 {
        return Result::Err(HidError::HidDescriptorInvalid);
    };

    // Generate device identity
    let device_id: Identity = identity_new(
        0x4849445F,  // "HID_"
        timestamp,
        state.device_count as u64,
        vendor_id as u64,
    );

    let device: HidDevice = HidDevice {
        device_id: device_id,
        device_type: parser.device_type,
        descriptor_parsed: true,
        descriptor: Array::zeroed(),
        descriptor_length: descriptor.len(),
        input_report: Array::zeroed(),
        input_report_length: 0,
        output_report: Array::zeroed(),
        output_report_length: 0,
        event_queue: RingBuf::new(),
        prev_keyboard_state: Array::zeroed(),
        keyboard_modifiers: 0,
        mouse_buttons: 0,
        mouse_x: 0,
        mouse_y: 0,
        scroll_accumulator: 0,
        max_event_rate: 1000,
        last_event_timestamp: timestamp,
        capability: state.default_cap,
        residual_log: RingBuf::new(),
        initialized: true,
        connected: true,
        vendor_id: vendor_id,
        product_id: product_id,
        device_name: String::from_bytes(device_name),
        event_count: 0,
        error_count: 0,
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    // Copy descriptor
    let desc_copy_len: u64 = if descriptor.len() < 1024 { descriptor.len() } else { 1024 };
    for i in 0..desc_copy_len {
        // Copy would be done here
    };

    state.devices[state.device_count] = device;
    state.device_count = state.device_count + 1;

    residual emit {
        op: "hid_driver.register_device",
        device_id: device_id.id_hash,
        device_type: parser.device_type as u64,
        vendor_id: vendor_id as u64,
        product_id: product_id as u64,
    };

    return Result::Ok(device_id);
}

// ─────────────────────────────────────────────────────────────
// Process Keyboard Report
// ─────────────────────────────────────────────────────────────

fn hid_process_keyboard_report(
    state: Handle(HidDriverState),
    device_idx: u64,
    report: Slice(u8),
    timestamp: u64,
) -> Result(u64, HidError)
    effect [deterministic, residual]
    court "hid_process_kbd:v1"
{
    if device_idx >= state.device_count {
        return Result::Err(HidError::HidDeviceNotFound);
    };

    let device: Handle(HidDevice) = Handle(HidDevice)::from_ptr(&state.devices[device_idx]);

    if device.device_type != HidDeviceType::Keyboard {
        return Result::Err(HidError::HidUnsupportedDevice);
    };

    // Standard boot protocol keyboard report: [modifier, reserved, key1, key2, key3, key4, key5, key6]
    if report.len() < 8 {
        return Result::Err(HidError::HidReportUnknown);
    };

    let new_modifiers: u8 = report[0];
    let old_modifiers: u8 = device.keyboard_modifiers;

    // Detect modifier changes
    let modifier_changed: u8 = new_modifiers ^ old_modifiers;
    if modifier_changed != 0 {
        for bit in 0..8 {
            let mask: u8 = 1 << bit;
            if (modifier_changed & mask) != 0 {
                let is_down: bool = (new_modifiers & mask) != 0;
                let event_type: InputEventType = if is_down { InputEventType::KeyDown } else { InputEventType::KeyUp };

                let modifier_key_code: u16 = match bit {
                    0 => 0xE0,  // Left Control
                    1 => 0xE1,  // Left Shift
                    2 => 0xE2,  // Left Alt
                    3 => 0xE3,  // Left GUI
                    4 => 0xE4,  // Right Control
                    5 => 0xE5,  // Right Shift
                    6 => 0xE6,  // Right Alt
                    7 => 0xE7,  // Right GUI
                    _ => 0,
                };

                let event: InputEvent = InputEvent {
                    event_type: event_type,
                    device_id: device.device_id,
                    timestamp: timestamp,
                    key_code: modifier_key_code,
                    key_modifiers: new_modifiers,
                    mouse_x: 0, mouse_y: 0, mouse_buttons: 0, scroll_delta: 0,
                    touch_points: 0, pressure: 0, report_id: 0,
                    raw_data: Array::zeroed(), raw_length: report.len(),
                    residual: ResidualRecord {
                        timestamp: timestamp,
                        event_type: 0x80,
                        event_data_hash: modifier_key_code as u64,
                        cause_identity: device.device_id,
                        prior_state_hash: old_modifiers as u64,
                        new_state_hash: new_modifiers as u64,
                        delta_description: String::from_bytes(Slice(u8)::from_str("keyboard modifier")),
                        generation_at_event: device.generation,
                        verified: false,
                    },
                };

                if !device.event_queue.is_full() {
                    device.event_queue.push(event);
                    device.event_count = device.event_count + 1;
                    state.total_events_generated = state.total_events_generated + 1;
                };
            };
        };
    };

    device.keyboard_modifiers = new_modifiers;

    // Detect key changes (bytes 2-7: up to 6 keys)
    for i in 2..8 {
        let new_key: u8 = if i < report.len() { report[i] } else { 0 };
        let old_key: u8 = device.prev_keyboard_state[i];

        if new_key != old_key {
            // Old key released
            if old_key != 0 {
                let event: InputEvent = InputEvent {
                    event_type: InputEventType::KeyUp,
                    device_id: device.device_id,
                    timestamp: timestamp,
                    key_code: old_key as u16,
                    key_modifiers: new_modifiers,
                    mouse_x: 0, mouse_y: 0, mouse_buttons: 0, scroll_delta: 0,
                    touch_points: 0, pressure: 0, report_id: 0,
                    raw_data: Array::zeroed(), raw_length: report.len(),
                    residual: ResidualRecord {
                        timestamp: timestamp,
                        event_type: 0x81,
                        event_data_hash: old_key as u64,
                        cause_identity: device.device_id,
                        prior_state_hash: 0,
                        new_state_hash: 0,
                        delta_description: String::from_bytes(Slice(u8)::from_str("key up")),
                        generation_at_event: device.generation,
                        verified: false,
                    },
                };

                if !device.event_queue.is_full() {
                    device.event_queue.push(event);
                    device.event_count = device.event_count + 1;
                    state.total_events_generated = state.total_events_generated + 1;
                };
            };

            // New key pressed
            if new_key != 0 {
                let event: InputEvent = InputEvent {
                    event_type: InputEventType::KeyDown,
                    device_id: device.device_id,
                    timestamp: timestamp,
                    key_code: new_key as u16,
                    key_modifiers: new_modifiers,
                    mouse_x: 0, mouse_y: 0, mouse_buttons: 0, scroll_delta: 0,
                    touch_points: 0, pressure: 0, report_id: 0,
                    raw_data: Array::zeroed(), raw_length: report.len(),
                    residual: ResidualRecord {
                        timestamp: timestamp,
                        event_type: 0x82,
                        event_data_hash: new_key as u64,
                        cause_identity: device.device_id,
                        prior_state_hash: 0,
                        new_state_hash: new_key as u64,
                        delta_description: String::from_bytes(Slice(u8)::from_str("key down")),
                        generation_at_event: device.generation,
                        verified: false,
                    },
                };

                if !device.event_queue.is_full() {
                    device.event_queue.push(event);
                    device.event_count = device.event_count + 1;
                    state.total_events_generated = state.total_events_generated + 1;
                };
            };
        };
    };

    // Update previous state
    for i in 0..8 {
        device.prev_keyboard_state[i] = if i < report.len() { report[i] } else { 0 };
    };

    device.last_event_timestamp = timestamp;

    return Result::Ok(device.event_count);
}

// ─────────────────────────────────────────────────────────────
// Process Mouse Report
// ─────────────────────────────────────────────────────────────

fn hid_process_mouse_report(
    state: Handle(HidDriverState),
    device_idx: u64,
    report: Slice(u8),
    timestamp: u64,
) -> Result(u64, HidError)
    effect [deterministic, residual]
    court "hid_process_mouse:v1"
{
    if device_idx >= state.device_count {
        return Result::Err(HidError::HidDeviceNotFound);
    };

    let device: Handle(HidDevice) = Handle(HidDevice)::from_ptr(&state.devices[device_idx]);

    if device.device_type != HidDeviceType::Mouse {
        return Result::Err(HidError::HidUnsupportedDevice);
    };

    // Standard boot protocol mouse report: [buttons, x_delta, y_delta, wheel]
    if report.len() < 3 {
        return Result::Err(HidError::HidReportUnknown);
    };

    let buttons: u8 = report[0];
    let x_delta: i8 = report[1] as i8;
    let y_delta: i8 = report[2] as i8;
    let wheel: i8 = if report.len() > 3 { report[3] as i8 } else { 0 };

    // Button changes
    let button_changed: u8 = buttons ^ device.mouse_buttons;
    if button_changed != 0 {
        for bit in 0..3 {
            let mask: u8 = 1 << bit;
            if (button_changed & mask) != 0 {
                let is_down: bool = (buttons & mask) != 0;
                let event_type: InputEventType = if is_down { InputEventType::MouseButtonDown } else { InputEventType::MouseButtonUp };

                let event: InputEvent = InputEvent {
                    event_type: event_type,
                    device_id: device.device_id,
                    timestamp: timestamp,
                    key_code: 0,
                    key_modifiers: 0,
                    mouse_x: x_delta as i64,
                    mouse_y: y_delta as i64,
                    mouse_buttons: buttons,
                    scroll_delta: 0,
                    touch_points: 0, pressure: 0, report_id: 0,
                    raw_data: Array::zeroed(), raw_length: report.len(),
                    residual: ResidualRecord {
                        timestamp: timestamp,
                        event_type: 0x83,
                        event_data_hash: bit as u64,
                        cause_identity: device.device_id,
                        prior_state_hash: device.mouse_buttons as u64,
                        new_state_hash: buttons as u64,
                        delta_description: String::from_bytes(Slice(u8)::from_str("mouse button")),
                        generation_at_event: device.generation,
                        verified: false,
                    },
                };

                if !device.event_queue.is_full() {
                    device.event_queue.push(event);
                    device.event_count = device.event_count + 1;
                    state.total_events_generated = state.total_events_generated + 1;
                };
            };
        };
    };

    device.mouse_buttons = buttons;

    // Mouse movement
    if x_delta != 0 || y_delta != 0 {
        device.mouse_x = device.mouse_x + x_delta as i64;
        device.mouse_y = device.mouse_y + y_delta as i64;

        let event: InputEvent = InputEvent {
            event_type: InputEventType::MouseMove,
            device_id: device.device_id,
            timestamp: timestamp,
            key_code: 0, key_modifiers: 0,
            mouse_x: x_delta as i64,
            mouse_y: y_delta as i64,
            mouse_buttons: buttons,
            scroll_delta: 0,
            touch_points: 0, pressure: 0, report_id: 0,
            raw_data: Array::zeroed(), raw_length: report.len(),
            residual: ResidualRecord {
                timestamp: timestamp,
                event_type: 0x84,
                event_data_hash: 0,
                cause_identity: device.device_id,
                prior_state_hash: 0,
                new_state_hash: 0,
                delta_description: String::from_bytes(Slice(u8)::from_str("mouse move")),
                generation_at_event: device.generation,
                verified: false,
            },
        };

        if !device.event_queue.is_full() {
            device.event_queue.push(event);
            device.event_count = device.event_count + 1;
            state.total_events_generated = state.total_events_generated + 1;
        };
    };

    // Scroll
    if wheel != 0 {
        device.scroll_accumulator = device.scroll_accumulator + wheel as i64;

        let event: InputEvent = InputEvent {
            event_type: InputEventType::MouseScroll,
            device_id: device.device_id,
            timestamp: timestamp,
            key_code: 0, key_modifiers: 0,
            mouse_x: 0, mouse_y: 0, mouse_buttons: buttons,
            scroll_delta: wheel as i64,
            touch_points: 0, pressure: 0, report_id: 0,
            raw_data: Array::zeroed(), raw_length: report.len(),
            residual: ResidualRecord {
                timestamp: timestamp,
                event_type: 0x85,
                event_data_hash: wheel as u64,
                cause_identity: device.device_id,
                prior_state_hash: 0,
                new_state_hash: wheel as u64,
                delta_description: String::from_bytes(Slice(u8)::from_str("mouse scroll")),
                generation_at_event: device.generation,
                verified: false,
            },
        };

        if !device.event_queue.is_full() {
            device.event_queue.push(event);
            device.event_count = device.event_count + 1;
            state.total_events_generated = state.total_events_generated + 1;
        };
    };

    device.last_event_timestamp = timestamp;

    return Result::Ok(device.event_count);
}

// ─────────────────────────────────────────────────────────────
// Read Input Event
// ─────────────────────────────────────────────────────────────

fn hid_read_event(
    state: Handle(HidDriverState),
    device_idx: u64,
    reader_cap: Cap(HidCapability),
    timestamp: u64,
) -> Result(InputEvent, HidError)
    effect [deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(HidError::HidDeviceNotFound);
    };

    let device: Handle(HidDevice) = Handle(HidDevice)::from_ptr(&state.devices[device_idx]);

    if !device.initialized || !device.connected {
        return Result::Err(HidError::HidDeviceDisconnected);
    };

    if device.event_queue.is_empty() {
        return Result::Err(HidError::HidQueueEmpty);
    };

    let event: InputEvent = device.event_queue.pop().unwrap();

    residual emit {
        op: "hid_driver.read_event",
        device_idx: device_idx,
        event_type: event.event_type as u64,
        event_count: device.event_count,
    };

    return Result::Ok(event);
}

// ─────────────────────────────────────────────────────────────
// Flush Input Events
// ─────────────────────────────────────────────────────────────

fn hid_flush_events(
    state: Handle(HidDriverState),
    device_idx: u64,
    flusher_cap: Cap(HidCapability),
) -> Result(u64, HidError)
    effect [deterministic, residual]
{
    if device_idx >= state.device_count {
        return Result::Err(HidError::HidDeviceNotFound);
    };

    let device: Handle(HidDevice) = Handle(HidDevice)::from_ptr(&state.devices[device_idx]);
    let mut flushed: u64 = 0;

    while !device.event_queue.is_empty() {
        device.event_queue.pop();
        flushed = flushed + 1;
    };

    residual emit {
        op: "hid_driver.flush_events",
        device_idx: device_idx,
        flushed: flushed,
    };

    return Result::Ok(flushed);
}

// ─────────────────────────────────────────────────────────────
// HID Self-Test
// ─────────────────────────────────────────────────────────────

fn hid_self_test(
    state: Handle(HidDriverState),
) -> Result(u64, HidError)
    effect [deterministic]
    court "hid_self_test:v1"
{
    let mut checks: u64 = 0;

    if state.initialized {
        checks = checks + 1;
    };

    if state.device_count <= 8 {
        checks = checks + 1;
    };

    let mut initialized_devices: u64 = 0;
    for i in 0..state.device_count {
        if state.devices[i].initialized {
            initialized_devices = initialized_devices + 1;
        };
    };

    if initialized_devices == state.device_count {
        checks = checks + 1;
    };

    residual emit {
        op: "hid_driver.self_test",
        checks_passed: checks,
        device_count: state.device_count,
        total_events: state.total_events_generated,
    };

    return Result::Ok(checks);
}

// ─────────────────────────────────────────────────────────────
// HID Diagnostic — Read device status and diagnostics
// ─────────────────────────────────────────────────────────────

struct HidDeviceDiagnostics {
    device_idx: u64,
    device_type: HidDeviceType,
    connected: bool,
    initialized: bool,
    descriptor_parsed: bool,
    descriptor_length: u64,
    event_queue_level: u64,
    total_events: u64,
    error_count: u64,
    vendor_id: u16,
    product_id: u16,
    device_name: String(64),
    keyboard_modifiers: u8,
    mouse_buttons: u8,
    mouse_x: i64,
    mouse_y: i64,
    trust_state: TrustState,
}

fn hid_diagnostics(
    state: Handle(HidDriverState),
    device_idx: u64,
    diag_cap: Cap(HidCapability),
) -> Result(HidDeviceDiagnostics, HidError)
    effect [deterministic]
{
    if device_idx >= state.device_count {
        return Result::Err(HidError::HidDeviceNotFound);
    };

    let dev: HidDevice = state.devices[device_idx];

    let diag: HidDeviceDiagnostics = HidDeviceDiagnostics {
        device_idx: device_idx,
        device_type: dev.device_type,
        connected: dev.connected,
        initialized: dev.initialized,
        descriptor_parsed: dev.descriptor_parsed,
        descriptor_length: dev.descriptor_length,
        event_queue_level: dev.event_queue.len(),
        total_events: dev.event_count,
        error_count: dev.error_count,
        vendor_id: dev.vendor_id,
        product_id: dev.product_id,
        device_name: dev.device_name,
        keyboard_modifiers: dev.keyboard_modifiers,
        mouse_buttons: dev.mouse_buttons,
        mouse_x: dev.mouse_x,
        mouse_y: dev.mouse_y,
        trust_state: dev.trust_state,
    };

    return Result::Ok(diag);
}
