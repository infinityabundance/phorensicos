// file: math.phor
// purpose: Bounded arithmetic, checked operations, overflow-safe math.
//          Provides checked, saturating, and wrapping arithmetic for all
//          core integer types with explicit bounds annotations on all loops.
// evidence: MATH-ARCH-001 through MATH-ARCH-120
// residual: All operations are deterministic; no allocation or unsafe.

use core::constants::*
use core::types::*
use core::errors::*

// ──────────────────────────────────────────────
// Checked Arithmetic Module
// ──────────────────────────────────────────────
// All functions return Result to propagate overflow errors.
// Evidence path: MATH-CHECKED-001 through MATH-CHECKED-045

// Checked addition for u64 with overflow detection.
pub fn checked_add_u64(a: u64, b: u64) -> Result[u64, OverflowError]
    effects: [deterministic]
{
    let (sum, overflow): (u64, bool) = __builtin_add_u64_overflow(a, b)
    if overflow {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x100),
            FixedString[128]::from_slice("u64 addition overflow")))
    }
    Result::Ok(sum)
}

// Checked subtraction for u64.
pub fn checked_sub_u64(a: u64, b: u64) -> Result[u64, OverflowError]
    effects: [deterministic]
{
    if b > a {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x101),
            FixedString[128]::from_slice("u64 subtraction underflow")))
    }
    Result::Ok(a - b)
}

// Checked multiplication for u64.
pub fn checked_mul_u64(a: u64, b: u64) -> Result[u64, OverflowError]
    effects: [deterministic]
{
    let (prod, overflow): (u64, bool) = __builtin_mul_u64_overflow(a, b)
    if overflow {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x102),
            FixedString[128]::from_slice("u64 multiplication overflow")))
    }
    Result::Ok(prod)
}

// Checked division for u64.
pub fn checked_div_u64(a: u64, b: u64) -> Result[u64, DivisionByZeroError]
    effects: [deterministic]
{
    if b == 0 {
        return Result::Err(DivisionByZeroError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x103),
            FixedString[128]::from_slice("u64 division by zero")))
    }
    Result::Ok(a / b)
}

// Checked remainder for u64.
pub fn checked_rem_u64(a: u64, b: u64) -> Result[u64, DivisionByZeroError]
    effects: [deterministic]
{
    if b == 0 {
        return Result::Err(DivisionByZeroError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x104),
            FixedString[128]::from_slice("u64 remainder by zero")))
    }
    Result::Ok(a % b)
}

