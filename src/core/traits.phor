// ──────────────────────────────────────────────
// Trait: Digestible
// ──────────────────────────────────────────────
// Types that can produce incremental digests.
// Evidence path: TRAIT-DIGEST-001 through TRAIT-DIGEST-015

pub trait Digestible : {
    // Initialize a digest computation.
    fn digest_init() -> Self
        effects: [deterministic]

    // Absorb data into the digest computation.
    fn digest_absorb(self: ref mut, data: Byte[], length: u32)
        effects: [deterministic, hash]

    // Finalize and return the digest.
    fn digest_finalize(self) -> Hash256
        effects: [deterministic, hash]

    // Absorb a single type implementing Hashable.
    fn digest_absorb_hashable[T: Hashable](self: ref mut, value: T)
        effects: [deterministic, hash]
    {
        let h: Hash256 = value.hash()
        let bytes: Byte[32] = h.as_slice()
        self.digest_absorb(bytes, 32)
    }

    // Get the current intermediate digest state.
    fn digest_state(self) -> Hash256
        effects: [deterministic, hash]
}

