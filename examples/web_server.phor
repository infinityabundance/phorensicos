    effect [compute, residual]
{
    let al: Str(64) = Str::from("Accept-Language: en-US,en;q=0.9,fr;q=0.8");
    assert(al.len() > 0, "http: accept-language header");
    residual emit { op: "http.test.lang", header: "en-US,fr", };
}

