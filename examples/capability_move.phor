// capability_move.phor — Example showing capability move and use-after-move rejection
//
// Demonstrates:
//   - Capability acquisition from kernel
//   - Affine move semantics (capability consumed on assignment/function call)
//   - Use-after-move rejection at compile time (E0301)
//   - Capability derivation via restrict (sub-capability with reduced rights)
//   - Capability move in function returns
//   - Multiple capability parameters
//   - Capability restrict chain with multiple steps
//   - Residual emission on capability derivation
//   - Unique ownership enforced by the compiler
//   - Capability as function parameter (consume vs borrow semantics)
//   - Capability cannot be stored in global/static
//   - Capability must be explicitly granted (no ambient authority)
//
// Expected outcomes:
//   - Line 45: cap moved into use_cap → OK
//   - Line 47: use_cap(cap) // COMPILE ERROR E0301: cap was moved on line 45
//   - Line 58: restrict derives sub-capability → OK
//   - Line 62: cap2 consumed by derive_readonly → OK
//   - Capability tracking: exactly one live binding at any point
//   - Capability derivation logged as residual
//   - Capabilities are the sole mechanism for accessing kernel objects
//   - No ambient authority: all authority is passed explicitly
//
// Compilation: accepted (with commented-out error lines noted)
// Trust state: Observed

package "phorensic:capability_move:v1.0";

struct Resource {}
struct ConfigResource {}
struct DataResource {}
struct NetworkResource {}

// Function that consumes a capability (affine move)
fn use_cap(cap: Cap(Resource)) -> u64
    effect [compute]
{
    // cap is moved here; calling function loses access
    // cap cannot be used after this function returns
    return 42;
}

// Function consuming multiple capabilities
fn combine_caps(a: Cap(ConfigResource), b: Cap(DataResource)) -> u64
    effect [compute, io:read]
{
    // Both capabilities are moved here
    return 100;
}

// Function with three capability parameters
fn process_three(a: Cap(Resource), b: Cap(ConfigResource), c: Cap(NetworkResource)) -> u64
    effect [compute, io:read, ipc:send]
{
    // All three capabilities are consumed
    return 300;
}

// Function demonstrating restrict (capability derivation)
fn derive_readonly(cap: Cap(Resource)) -> Cap(Resource)
    effect [io:write, residual]
{
    // Derive read-only sub-capability
    // full_cap is consumed; readonly_cap has reduced authority (0x01 = read only)
    let readonly: Cap(Resource) = cap.restrict(0x01);

    // The restrict operation emits a residual automatically
    residual emit {
        op: "capability.derive",
        from: "full_cap",
        to: "readonly_cap",
        original_rights: 0x07,
        new_rights: 0x01,
    };

    return readonly;
}

// Function returning a capability
fn create_and_return() -> Cap(Resource)
    effect [io:write]
{
    let cap: Cap(Resource) = kernel.create_capability(Resource{}, 0x03);
    return cap; // Capability moves to caller
}

// Restrict chain: full → read_write → read_only
fn restrict_chain_full_to_readonly(full: Cap(Resource)) -> Cap(Resource)
    effect [io:write, residual]
{
    let read_write: Cap(Resource) = full.restrict(0x03); // remove execute
    let read_only: Cap(Resource) = read_write.restrict(0x01); // remove write
    return read_only;
}

fn main() -> u64
    effect [io:write, residual]
{
    // Test 1: Basic move into function
    let cap: Cap(Resource) = kernel.create_capability(Resource{}, 0x07);

    // Valid: cap is moved into the function
    let result: u64 = use_cap(cap);

    // COMPILE ERROR E0301: cap was moved on previous line
    // let result2: u64 = use_cap(cap);

    // Test 2: Capability derivation via restrict
    let cap2: Cap(Resource) = kernel.create_capability(Resource{}, 0x07);
    let readonly: Cap(Resource) = derive_readonly(cap2);
    // cap2 is now consumed (moved into derive_readonly)
    // readonly has reduced authority

    // Test 3: Capability from function return
    let returned_cap: Cap(Resource) = create_and_return();
    // returned_cap is now owned by this scope

    // Test 4: Multiple capability parameters
    let config: Cap(ConfigResource) = kernel.create_capability(ConfigResource{}, 0x01);
    let data: Cap(DataResource) = kernel.create_capability(DataResource{}, 0x01);
    let combined: u64 = combine_caps(config, data);
    // Both config and data are consumed

    // Test 5: Three capability parameters
    let res: Cap(Resource) = kernel.create_capability(Resource{}, 0x07);
    let cfg: Cap(ConfigResource) = kernel.create_capability(ConfigResource{}, 0x01);
    let net: Cap(NetworkResource) = kernel.create_capability(NetworkResource{}, 0x01);
    let triple: u64 = process_three(res, cfg, net);
    assert(triple == 300, "cap: three capabilities consumed");

    // Test 6: Restrict chain
    let full: Cap(Resource) = kernel.create_capability(Resource{}, 0x07);
    let very_readonly: Cap(Resource) = restrict_chain_full_to_readonly(full);
    // full is consumed, very_readonly has only read right

    // COMPILE ERROR E0302: Cap does not implement Copy
    // let copy: Cap(Resource) = returned_cap;  // This is a MOVE, not a copy

    // Verify results from each capability test
    assert(result == 42, "cap: basic move returns 42");
    assert(combined == 100, "cap: multiple caps return 100");
    assert(triple == 300, "cap: three caps return 300");

    residual emit {
        op: "capability_move.demo",
        move_result: result,
        restrict_done: true,
        return_done: true,
        multiple_caps: combined,
        triple_caps: triple,
        restrict_chain_done: true,
        all_tests_passed: result + combined + triple,
    };

    return result;
}
