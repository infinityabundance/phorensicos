// ─────────────────────────────────────────────────────────────
// Build PRP Entries
// ─────────────────────────────────────────────────────────────

fn nvme_full_build_prp(
    controller: Handle(NvmeFullController),
    data_phys: u64,
    data_size: u64,
    prp1: Handle(u64),
    prp2: Handle(u64),
    prp_list: Handle(NvmeFullPrpList),
) -> Result(void, NvmeFullError)
    effect [deterministic]
    court "nvme_full_build_prp:v1"
{
    if data_size == 0 {
        prp1.val = 0;
        prp2.val = 0;
        return Result::Ok(void);
    };

    let page_size: u64 = 4096;
    let offset_in_page: u64 = data_phys & (page_size - 1);
    let first_page_remaining: u64 = page_size - offset_in_page;

    prp1.val = data_phys;

    if data_size <= first_page_remaining {
        prp2.val = 0;
        return Result::Ok(void);
    };

    let mut remaining: u64 = data_size - first_page_remaining;
    let next_page: u64 = (data_phys + first_page_remaining) & !(page_size - 1);

    if remaining <= page_size {
        prp2.val = next_page;
        return Result::Ok(void);
    };

    prp2.val = controller.prp_pool.list_phys_addr;
    let mut list_idx: u64 = 0;
    let mut current_page: u64 = next_page;

    loop bound 128 {
        if remaining == 0 || list_idx >= 128 {
            break;
        };
        controller.prp_pool.entries[list_idx] = NvmeFullPrpEntry { phys_addr: current_page };
        list_idx = list_idx + 1;
        current_page = current_page + page_size;
        if remaining >= page_size {
            remaining = remaining - page_size;
        } else {
            remaining = 0;
        };
    };

    controller.prp_pool.entry_count = list_idx;

    if remaining > 0 {
        return Result::Err(NvmeFullError::NvmePrpError);
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Ring SQ Doorbell
// ─────────────────────────────────────────────────────────────

fn nvme_full_ring_sq_doorbell(
    regs: NvmeFullMmioRegs,
    qp: Handle(NvmeFullQueuePair),
) -> void
    effect [memory:mmio]
    court "nvme_full_ring_doorbell:v1"
{
    let doorbell_val: u32 = qp.sq_tail as u32;
    trusted reason "NVMe doorbell write to notify controller of new submissions" {
        let ptr: *(u32) = qp.sq_doorbell as *(u32);
        *ptr = doorbell_val;
    };
}

// ─────────────────────────────────────────────────────────────
// Ring CQ Head Doorbell
// ─────────────────────────────────────────────────────────────

fn nvme_full_ring_cq_doorbell(
    qp: Handle(NvmeFullQueuePair),
) -> void
    effect [memory:mmio]
    court "nvme_full_ring_cq_doorbell:v1"
{
    trusted reason "NVMe CQ head doorbell write to free completion entries" {
        let ptr: *(u32) = qp.cq_doorbell as *(u32);
        *ptr = qp.cq_head as u32;
    };
}

// ─────────────────────────────────────────────────────────────
// Submit Admin Command
// ─────────────────────────────────────────────────────────────

fn nvme_full_submit_admin_cmd(
    controller: Handle(NvmeFullController),
    sqe: NvmeFullSqe,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u16, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_admin_cmd:v1"
{
    if !controller.initialized {
        return Result::Err(NvmeFullError::NvmeNotInitialized);
    };

    if !cap.can_admin {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let qp: Handle(NvmeFullQueuePair) = Handle(NvmeFullQueuePair)::from_ptr(&controller.admin_queue);

    if !qp.initialized {
        return Result::Err(NvmeFullError::NvmeInvalidQueue);
    };

    let tail: u16 = qp.sq_tail;
    let slot: u64 = tail as u64;
    let cmd_id: u16 = tail;

    let cmd: NvmeFullSqe = NvmeFullSqe {
        cdw0: sqe.cdw0 | (cmd_id as u32),
        nsid: sqe.nsid,
        cdw2: sqe.cdw2,
        cdw3: sqe.cdw3,
        metadata_ptr: sqe.metadata_ptr,
        data_ptr1: sqe.data_ptr1,
        data_ptr2: sqe.data_ptr2,
        cdw10: sqe.cdw10,
        cdw11: sqe.cdw11,
        cdw12: sqe.cdw12,
        cdw13: sqe.cdw13,
        cdw14: sqe.cdw14,
        cdw15: sqe.cdw15,
    };

    qp.submission_queue[slot] = cmd;

    let new_tail: u16 = (tail + 1) & (qp.sq_size - 1);
    qp.sq_tail = new_tail;
    qp.outstanding_commands = qp.outstanding_commands + 1;

    let regs: NvmeFullMmioRegs = NvmeFullMmioRegs { mmio_base: controller.mmio_base };
    nvme_full_ring_sq_doorbell(regs, qp);

    controller.total_io_operations = controller.total_io_operations + 1;

    residual emit {
        op: "nvme_full.submit_admin",
        cmd_id: cmd_id as u64,
        nsid: sqe.nsid as u64,
        opcode: sqe.cdw0 as u64,
        timestamp: timestamp,
    };

    return Result::Ok(cmd_id);
}

// ─────────────────────────────────────────────────────────────
// Poll for Completion
// ─────────────────────────────────────────────────────────────

fn nvme_full_poll_completion(
    qp: Handle(NvmeFullQueuePair),
    timeout_ms: u64,
) -> Result(NvmeFullCqe, NvmeFullError)
    effect [deterministic]
    court "nvme_full_poll_cq:v1"
{
    loop bound 10000 {
        if qp.outstanding_commands == 0 {
            break;
        };

        let head: u16 = qp.cq_head;
        let cqe: NvmeFullCqe = qp.completion_queue[head as u64];

        if cqe.phase_tag == qp.cq_phase {
            if cqe.status_code != 0 {
                qp.cq_head = (head + 1) & (qp.cq_size - 1);
                if qp.cq_head == 0 {
                    qp.cq_phase = !qp.cq_phase;
                };
                qp.outstanding_commands = qp.outstanding_commands - 1;
                return Result::Err(NvmeFullError::NvmeAdminCmdFailed);
            };
            return Result::Ok(cqe);
        };
    };

    return Result::Err(NvmeFullError::NvmeCompletionTimeout);
}

// ─────────────────────────────────────────────────────────────
// Acknowledge Completion
// ─────────────────────────────────────────────────────────────

fn nvme_full_ack_completion(
    controller: Handle(NvmeFullController),
    qp: Handle(NvmeFullQueuePair),
    cqe: NvmeFullCqe,
) -> void
    effect [memory:mmio]
{
    let new_head: u16 = (qp.cq_head + 1) & (qp.cq_size - 1);
    qp.cq_head = new_head;
    qp.outstanding_commands = qp.outstanding_commands - 1;

    if qp.cq_head == 0 {
        qp.cq_phase = !qp.cq_phase;
    };

    nvme_full_ring_cq_doorbell(qp);
}

// ─────────────────────────────────────────────────────────────
// Submit I/O Command (Generic)
// ─────────────────────────────────────────────────────────────

fn nvme_full_submit_io_cmd(
    controller: Handle(NvmeFullController),
    sqe: NvmeFullSqe,
    queue_idx: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u16, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_io_cmd:v1"
{
    if !controller.initialized {
        return Result::Err(NvmeFullError::NvmeNotInitialized);
    };

    if (queue_idx as u64) >= (controller.io_queue_count as u64) {
        return Result::Err(NvmeFullError::NvmeInvalidQueue);
    };

    let qp: Handle(NvmeFullQueuePair) = Handle(NvmeFullQueuePair)::from_ptr(&controller.io_queues[queue_idx as u64]);

    if !qp.initialized {
        return Result::Err(NvmeFullError::NvmeInvalidQueue);
    };

    let tail: u16 = qp.sq_tail;
    let slot: u64 = tail as u64;
    let cmd_id: u16 = tail;

    let cmd: NvmeFullSqe = NvmeFullSqe {
        cdw0: sqe.cdw0 | (cmd_id as u32),
        nsid: sqe.nsid,
        cdw2: sqe.cdw2,
        cdw3: sqe.cdw3,
        metadata_ptr: sqe.metadata_ptr,
        data_ptr1: sqe.data_ptr1,
        data_ptr2: sqe.data_ptr2,
        cdw10: sqe.cdw10,
        cdw11: sqe.cdw11,
        cdw12: sqe.cdw12,
        cdw13: sqe.cdw13,
        cdw14: sqe.cdw14,
        cdw15: sqe.cdw15,
    };

    qp.submission_queue[slot] = cmd;
    qp.sq_tail = (tail + 1) & (qp.sq_size - 1);
    qp.outstanding_commands = qp.outstanding_commands + 1;

    let regs: NvmeFullMmioRegs = NvmeFullMmioRegs { mmio_base: controller.mmio_base };
    nvme_full_ring_sq_doorbell(regs, qp);

    controller.total_io_operations = controller.total_io_operations + 1;

    return Result::Ok(cmd_id);
}

// ─────────────────────────────────────────────────────────────
// Admin: Get Log Page
// ─────────────────────────────────────────────────────────────

fn nvme_full_get_log_page(
    controller: Handle(NvmeFullController),
    log_id: NvmeFullLogPageId,
    lid: u8,
    num_dwords: u8,
    data_buffer: u64,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_get_log_page:v1"
{
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::GetLogPage as u32),
        nsid: 0xFFFFFFFF,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: data_buffer,
        data_ptr2: 0,
        cdw10: (lid as u32) | ((num_dwords as u32) << 16),
        cdw11: 0,
        cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(cmd_id) => {
            residual emit {
                op: "nvme_full.get_log_page",
                log_id: lid as u64,
                cmd_id: cmd_id as u64,
                data_buffer: data_buffer,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Admin: Identify Controller
// ─────────────────────────────────────────────────────────────

fn nvme_full_identify_controller(
    controller: Handle(NvmeFullController),
    data_buffer: u64,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_identify_ctrl:v1"
{
    if !cap.can_identify {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::Identify as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: data_buffer,
        data_ptr2: 0,
        cdw10: 0x00000001,
        cdw11: 0, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(cmd_id) => {
            residual emit {
                op: "nvme_full.identify_controller",
                cmd_id: cmd_id as u64,
                data_buffer: data_buffer,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Admin: Identify Namespace
// ─────────────────────────────────────────────────────────────

fn nvme_full_identify_namespace(
    controller: Handle(NvmeFullController),
    nsid: u32,
    data_buffer: u64,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_identify_ns:v1"
{
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::Identify as u32),
        nsid: nsid,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: data_buffer,
        data_ptr2: 0,
        cdw10: 0x00000000,
        cdw11: 0, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    return nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
}

// ─────────────────────────────────────────────────────────────
// Admin: Create I/O Completion Queue
// ─────────────────────────────────────────────────────────────

fn nvme_full_create_io_cq(
    controller: Handle(NvmeFullController),
    qid: u16,
    cq_size: u16,
    cq_phys: u64,
    irq_vector: u16,
    qprio: u8,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_create_io_cq:v1"
{
    let cdw11: u32 = (irq_vector as u32) | (1 << 1) | ((qprio as u32) << 1);
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::CreateIoCompletionQueue as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: cq_phys,
        data_ptr2: 0,
        cdw10: (qid as u32) | ((cq_size as u32 - 1) << 16),
        cdw11: cdw11,
        cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.create_io_cq",
                qid: qid as u64,
                cq_size: cq_size as u64,
                cq_phys: cq_phys,
                irq_vector: irq_vector as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Admin: Create I/O Submission Queue
// ─────────────────────────────────────────────────────────────

fn nvme_full_create_io_sq(
    controller: Handle(NvmeFullController),
    qid: u16,
    sq_size: u16,
    sq_phys: u64,
    cq_id: u16,
    qprio: u8,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_create_io_sq:v1"
{
    let cdw11: u32 = (cq_id as u32) | (1 << 1) | ((qprio as u32) << 1);
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::CreateIoSubmissionQueue as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: sq_phys,
        data_ptr2: 0,
        cdw10: (qid as u32) | ((sq_size as u32 - 1) << 16),
        cdw11: cdw11,
        cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.create_io_sq",
                qid: qid as u64,
                sq_size: sq_size as u64,
                sq_phys: sq_phys,
                cq_id: cq_id as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

