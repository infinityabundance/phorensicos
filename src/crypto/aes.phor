// Round constants (Rcon)
const AES_RCON : Byte[11] = [
    0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36
]

// ──────────────────────────────────────────────
// Type: AESKey (abstract key representation)
// ──────────────────────────────────────────────
// Evidence path: AES-KEY-001 through AES-KEY-025

pub type AESKeySize : u8 = enum {
    AES128 = 16,
    AES192 = 24,
    AES256 = 32,
}

pub type AESKey : struct {
    key_bytes: Byte[32],
    key_len: u32,
    rounds: u32,
}

impl AESKey {
    // Create an AES key from raw bytes with validation.
    pub fn from_bytes(bytes: ref Byte[], length: u32) -> Result[AESKey, CryptoError]
        effects: [deterministic]
    {
        if length != AES128_KEY_SIZE && length != AES192_KEY_SIZE && length != AES256_KEY_SIZE {
            return Result::Err(CryptoError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x010),
                FixedString[128]::from_slice("AES: invalid key size")))
        }
        let rounds: u32 = if length == AES128_KEY_SIZE { AES128_ROUNDS }
            else if length == AES192_KEY_SIZE { AES192_ROUNDS }
            else { AES256_ROUNDS }

        let mut key: AESKey = AESKey {
            key_bytes: [Byte::from_u8(0); 32],
            key_len: length,
            rounds: rounds,
        }
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..length {
            key.key_bytes[i as usize] = bytes[i as usize]
        }
        Result::Ok(key)
    }
}

// ──────────────────────────────────────────────
// Type: AESExpandedKey
// ──────────────────────────────────────────────
// Evidence path: AES-EXPAND-001 through AES-EXPAND-035

pub type AESExpandedKey : struct {
    round_keys: Byte[240],
    num_rounds: u32,
    key_len: u32,
}

impl AESExpandedKey {
    // SubWord: apply S-box to each byte of a word.
    fn sub_word(w: u32) -> u32
        effects: [deterministic]
    {
        let b0: u8 = ((w >> 24) & 0xFF) as u8
        let b1: u8 = ((w >> 16) & 0xFF) as u8
        let b2: u8 = ((w >> 8) & 0xFF) as u8
        let b3: u8 = (w & 0xFF) as u8
        let sb0: u8 = AES_SBOX[b0 as usize].to_u8()
        let sb1: u8 = AES_SBOX[b1 as usize].to_u8()
        let sb2: u8 = AES_SBOX[b2 as usize].to_u8()
        let sb3: u8 = AES_SBOX[b3 as usize].to_u8()
        ((sb0 as u32) << 24) | ((sb1 as u32) << 16) | ((sb2 as u32) << 8) | (sb3 as u32)
    }

    // RotWord: rotate word left by one byte.
    fn rot_word(w: u32) -> u32
        effects: [deterministic]
    {
        (w << 8) | (w >> 24)
    }

    // Load 4 bytes as a word (big-endian).
    fn load_word(bytes: ref Byte[4]) -> u32
        effects: [deterministic]
    {
        let b0: u32 = bytes[0].to_u8() as u32
        let b1: u32 = bytes[1].to_u8() as u32
        let b2: u32 = bytes[2].to_u8() as u32
        let b3: u32 = bytes[3].to_u8() as u32
        (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
    }

    // Store a word as 4 bytes (big-endian).
    fn store_word(value: u32, bytes: ref mut Byte[4])
        effects: [deterministic]
    {
        bytes[0] = Byte::from_u8(((value >> 24) & 0xFF) as u8)
        bytes[1] = Byte::from_u8(((value >> 16) & 0xFF) as u8)
        bytes[2] = Byte::from_u8(((value >> 8) & 0xFF) as u8)
        bytes[3] = Byte::from_u8((value & 0xFF) as u8)
    }

    // ──────────────────────────────────────────────
    // Key Expansion
    // ──────────────────────────────────────────────
    // Evidence path: AES-EXPAND-036 through AES-EXPAND-060

    pub fn expand(key: ref AESKey) -> AESExpandedKey
        effects: [deterministic]
    {
        let nk: u32 = key.key_len / 4
        let nr: u32 = key.rounds
        let total_words: u32 = 4 * (nr + 1)

        let mut w: FixedArray[60, u32] = FixedArray::new()

        // Copy initial words from key
        // loop: bounds[BOUND_SMALL] — bounded by 8 (max NK for AES256)
        loop: bounds[BOUND_SMALL] for i in 0..nk {
            let offset: u32 = i * 4
            let word_bytes: ref Byte[4] = key.key_bytes.as_ptr().offset(offset as usize) as ref Byte[4]
            let _ = w.push(AESExpandedKey::load_word(word_bytes))
        }

        // Expand remaining words
        // loop: bounds[BOUND_MEDIUM] — bounded by 60
        loop: bounds[BOUND_MEDIUM] for i in nk..total_words {
            let mut temp: u32 = w[(i - 1) as usize]
            if i % nk == 0 {
                temp = AESExpandedKey::sub_word(AESExpandedKey::rot_word(temp))
                let rcon_val: u32 = AES_RCON[(i / nk) as usize].to_u8() as u32
                temp = temp ^ (rcon_val << 24)
            } else if nk > 6 && i % nk == 4 {
                temp = AESExpandedKey::sub_word(temp)
            }
            let prev: u32 = w[(i - nk) as usize]
            let _ = w.push(prev ^ temp)
        }

        // Store expanded key as byte array
        let mut expanded: AESExpandedKey = AESExpandedKey {
            round_keys: [Byte::from_u8(0); 240],
            num_rounds: nr,
            key_len: key.key_len,
        }

        // loop: bounds[BOUND_MEDIUM] — bounded by total words
        loop: bounds[BOUND_MEDIUM] for i in 0..total_words {
            let offset: u32 = i * 4
            let word_val: u32 = w[i as usize]
            let mut dest: ref mut Byte[4] = expanded.round_keys.as_mut_ptr().offset(offset as usize) as ref mut Byte[4]
            AESExpandedKey::store_word(word_val, dest)
        }

        expanded
    }

    // Get the round key for a specific round.
    pub fn get_round_key(self, round: u32) -> Byte[16]
        effects: [deterministic]
    {
        let offset: u32 = round * 16
        let mut key: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            key[i as usize] = self.round_keys[(offset + i) as usize]
        }
        key
    }

    // AddRoundKey: XOR state with round key.
    fn add_round_key(state: ref mut Byte[16], round_key: ref Byte[16])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            state[i as usize] = Byte::from_u8(
                state[i as usize].to_u8() ^ round_key[i as usize].to_u8()
            )
        }
    }

    // ──────────────────────────────────────────────
    // AES Forward Operations (Encryption)
    // ──────────────────────────────────────────────

    fn sub_bytes(state: ref mut Byte[16])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            let idx: u8 = state[i as usize].to_u8()
            state[i as usize] = AES_SBOX[idx as usize]
        }
    }

    fn shift_rows(state: ref mut Byte[16])
        effects: [deterministic]
    {
        // Row 0: no shift
        // Row 1: shift left by 1
        let t1: Byte = state[1]
        state[1] = state[5]
        state[5] = state[9]
        state[9] = state[13]
        state[13] = t1
        // Row 2: shift left by 2
        let t2a: Byte = state[2]
        let t2b: Byte = state[6]
        state[2] = state[10]
        state[6] = state[14]
        state[10] = t2a
        state[14] = t2b
        // Row 3: shift left by 3 (right by 1)
        let t3: Byte = state[3]
        state[3] = state[15]
        state[15] = state[11]
        state[11] = state[7]
        state[7] = t3
    }

    fn gf_mul2(x: u8) -> u8
        effects: [deterministic]
    {
        let mut result: u8 = (x as u16 * 2) as u8
        if (x & 0x80) != 0 {
            result = result ^ 0x1B
        }
        result
    }

    fn gf_mul3(x: u8) -> u8
        effects: [deterministic]
    {
        AESExpandedKey::gf_mul2(x) ^ x
    }

    fn gf_mul(x: u8, y: u8) -> u8
        effects: [deterministic]
    {
        let mut result: u8 = 0
        let mut a: u8 = x
        let mut b: u8 = y
        // loop: bounds[BOUND_SMALL] — bounded by 8 bits
        loop: bounds[BOUND_SMALL] for _i in 0..8 {
            if (b & 1) != 0 {
                result = result ^ a
            }
            let hi: bool = (a & 0x80) != 0
            a = (a as u16 * 2) as u8
            if hi {
                a = a ^ 0x1B
            }
            b = b >> 1
        }
        result
    }

    fn mix_columns(state: ref mut Byte[16])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 4 columns
        loop: bounds[BOUND_SMALL] for c in 0..4 {
            let i: u32 = c * 4
            let a0: u8 = state[i as usize].to_u8()
            let a1: u8 = state[(i + 1) as usize].to_u8()
            let a2: u8 = state[(i + 2) as usize].to_u8()
            let a3: u8 = state[(i + 3) as usize].to_u8()
            state[i as usize] = Byte::from_u8(AESExpandedKey::gf_mul2(a0) ^ AESExpandedKey::gf_mul3(a1) ^ a2 ^ a3)
            state[(i + 1) as usize] = Byte::from_u8(a0 ^ AESExpandedKey::gf_mul2(a1) ^ AESExpandedKey::gf_mul3(a2) ^ a3)
            state[(i + 2) as usize] = Byte::from_u8(a0 ^ a1 ^ AESExpandedKey::gf_mul2(a2) ^ AESExpandedKey::gf_mul3(a3))
            state[(i + 3) as usize] = Byte::from_u8(AESExpandedKey::gf_mul3(a0) ^ a1 ^ a2 ^ AESExpandedKey::gf_mul2(a3))
        }
    }

    // ──────────────────────────────────────────────
    // AES Inverse Operations (Decryption)
    // ──────────────────────────────────────────────

    fn inv_sub_bytes(state: ref mut Byte[16])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            let idx: u8 = state[i as usize].to_u8()
            state[i as usize] = AES_INV_SBOX[idx as usize]
        }
    }

    fn inv_shift_rows(state: ref mut Byte[16])
        effects: [deterministic]
    {
        // Row 0: no shift
        // Row 1: shift right by 1
        let t1: Byte = state[1]
        state[1] = state[13]
        state[13] = state[9]
        state[9] = state[5]
        state[5] = t1
        // Row 2: shift right by 2
        let t2a: Byte = state[2]
        let t2b: Byte = state[6]
        state[2] = state[10]
        state[6] = state[14]
        state[10] = t2a
        state[14] = t2b
        // Row 3: shift right by 3 (left by 1)
        let t3: Byte = state[3]
        state[3] = state[7]
        state[7] = state[11]
        state[11] = state[15]
        state[15] = t3
    }

    fn inv_mix_columns(state: ref mut Byte[16])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 4 columns
        loop: bounds[BOUND_SMALL] for c in 0..4 {
            let i: u32 = c * 4
            let a0: u8 = state[i as usize].to_u8()
            let a1: u8 = state[(i + 1) as usize].to_u8()
            let a2: u8 = state[(i + 2) as usize].to_u8()
            let a3: u8 = state[(i + 3) as usize].to_u8()
            state[i as usize] = Byte::from_u8(
                AESExpandedKey::gf_mul(0x0E, a0) ^ AESExpandedKey::gf_mul(0x0B, a1) ^
                AESExpandedKey::gf_mul(0x0D, a2) ^ AESExpandedKey::gf_mul(0x09, a3))
            state[(i + 1) as usize] = Byte::from_u8(
                AESExpandedKey::gf_mul(0x09, a0) ^ AESExpandedKey::gf_mul(0x0E, a1) ^
                AESExpandedKey::gf_mul(0x0B, a2) ^ AESExpandedKey::gf_mul(0x0D, a3))
            state[(i + 2) as usize] = Byte::from_u8(
                AESExpandedKey::gf_mul(0x0D, a0) ^ AESExpandedKey::gf_mul(0x09, a1) ^
                AESExpandedKey::gf_mul(0x0E, a2) ^ AESExpandedKey::gf_mul(0x0B, a3))
            state[(i + 3) as usize] = Byte::from_u8(
                AESExpandedKey::gf_mul(0x0B, a0) ^ AESExpandedKey::gf_mul(0x0D, a1) ^
                AESExpandedKey::gf_mul(0x09, a2) ^ AESExpandedKey::gf_mul(0x0E, a3))
        }
    }

    // ──────────────────────────────────────────────
    // Encrypt / Decrypt Single Block
    // ──────────────────────────────────────────────
    // Evidence path: AES-BLOCK-001 through AES-BLOCK-040

    pub fn encrypt_block(self, plaintext: ref Byte[16]) -> Byte[16]
        effects: [deterministic]
    {
        let mut state: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            state[i as usize] = plaintext[i as usize]
        }

        // Initial round key
        let rk0: Byte[16] = self.get_round_key(0)
        AESExpandedKey::add_round_key(&mut state, &rk0)

        // Main rounds
        // loop: bounds[BOUND_SMALL] — bounded by 14 rounds
        loop: bounds[BOUND_SMALL] for round in 1..self.num_rounds {
            AESExpandedKey::sub_bytes(&mut state)
            AESExpandedKey::shift_rows(&mut state)
            AESExpandedKey::mix_columns(&mut state)
            let rk: Byte[16] = self.get_round_key(round)
            AESExpandedKey::add_round_key(&mut state, &rk)
        }

        // Final round (no MixColumns)
        AESExpandedKey::sub_bytes(&mut state)
        AESExpandedKey::shift_rows(&mut state)
        let rk_last: Byte[16] = self.get_round_key(self.num_rounds)
        AESExpandedKey::add_round_key(&mut state, &rk_last)

        state
    }

    pub fn decrypt_block(self, ciphertext: ref Byte[16]) -> Byte[16]
        effects: [deterministic]
    {
        let mut state: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            state[i as usize] = ciphertext[i as usize]
        }

        // Initial round key (last round)
        let rk_last: Byte[16] = self.get_round_key(self.num_rounds)
        AESExpandedKey::add_round_key(&mut state, &rk_last)

        // Main rounds (inverse)
        // loop: bounds[BOUND_SMALL] — bounded by 14 rounds
        loop: bounds[BOUND_SMALL] for round in (1..self.num_rounds).rev() {
            AESExpandedKey::inv_shift_rows(&mut state)
            AESExpandedKey::inv_sub_bytes(&mut state)
            let rk: Byte[16] = self.get_round_key(round)
            AESExpandedKey::add_round_key(&mut state, &rk)
            AESExpandedKey::inv_mix_columns(&mut state)
        }

        // Final round
        AESExpandedKey::inv_shift_rows(&mut state)
        AESExpandedKey::inv_sub_bytes(&mut state)
        let rk0: Byte[16] = self.get_round_key(0)
        AESExpandedKey::add_round_key(&mut state, &rk0)

        state
    }
}

// ──────────────────────────────────────────────
// Type: AESEngine (mode-based encryption)
// ──────────────────────────────────────────────
// Evidence path: AES-ENGINE-001 through AES-ENGINE-060

pub type AESMode : u8 = enum {
    ECB = 0,
    CBC = 1,
    CTR = 2,
    GCM = 3,
}

pub type AESEngine : struct {
    expanded_key: AESExpandedKey,
    mode: AESMode,
    iv: Byte[16],
    key: AESKey,
}

impl AESEngine {
    // Create a new AES engine.
    pub fn new(key: AESKey, mode: AESMode, iv: ref Byte[16]) -> AESEngine
        effects: [deterministic]
    {
        let expanded: AESExpandedKey = AESExpandedKey::expand(&key)
        let mut iv_copy: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            iv_copy[i as usize] = iv[i as usize]
        }

        AESEngine {
            expanded_key: expanded,
            mode: mode,
            iv: iv_copy,
            key: key,
        }
    }

    // ──────────────────────────────────────────────
    // ECB Mode
    // ──────────────────────────────────────────────

    pub fn encrypt_ecb(self, plaintext: ref Byte[], length: u32) -> Result[FixedArray[4096, Byte], CryptoError]
        effects: [deterministic]
    {
        if length % 16 != 0 {
            return Result::Err(CryptoError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x020),
                FixedString[128]::from_slice("AES: plaintext length must be multiple of 16")));
        }
        let mut output: FixedArray[4096, Byte] = FixedArray::new()
        // loop: bounds[BOUND_LARGE] — bounded by 256 blocks (4096/16)
        loop: bounds[BOUND_LARGE] for i in 0..(length / 16) {
            let offset: u32 = i * 16
            let block: ref Byte[16] = plaintext.as_ptr().offset(offset as usize) as ref Byte[16]
            let encrypted: Byte[16] = self.expanded_key.encrypt_block(block)
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..16 {
                let _ = output.push(encrypted[j as usize])
            }
        }
        Result::Ok(output)
    }

    pub fn decrypt_ecb(self, ciphertext: ref Byte[], length: u32) -> Result[FixedArray[4096, Byte], CryptoError]
        effects: [deterministic]
    {
        if length % 16 != 0 {
            return Result::Err(CryptoError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x021),
                FixedString[128]::from_slice("AES: ciphertext length must be multiple of 16")));
        }
        let mut output: FixedArray[4096, Byte] = FixedArray::new()
        // loop: bounds[BOUND_LARGE] — bounded by 256 blocks
        loop: bounds[BOUND_LARGE] for i in 0..(length / 16) {
            let offset: u32 = i * 16
            let block: ref Byte[16] = ciphertext.as_ptr().offset(offset as usize) as ref Byte[16]
            let decrypted: Byte[16] = self.expanded_key.decrypt_block(block)
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..16 {
                let _ = output.push(decrypted[j as usize])
            }
        }
        Result::Ok(output)
    }

    // ──────────────────────────────────────────────
    // CBC Mode
    // ──────────────────────────────────────────────

    pub fn encrypt_cbc(self, plaintext: ref Byte[], length: u32) -> Result[FixedArray[4096, Byte], CryptoError]
        effects: [deterministic]
    {
        if length % 16 != 0 {
            return Result::Err(CryptoError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x022),
                FixedString[128]::from_slice("AES: plaintext length must be multiple of 16")));
        }
        let mut output: FixedArray[4096, Byte] = FixedArray::new()
        let mut prev_block: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            prev_block[i as usize] = self.iv[i as usize]
        }

        // loop: bounds[BOUND_LARGE] — bounded by 256 blocks
        loop: bounds[BOUND_LARGE] for i in 0..(length / 16) {
            let offset: u32 = i * 16
            let mut block: Byte[16] = [Byte::from_u8(0); 16]
            // XOR with previous ciphertext (or IV)
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..16 {
                let p: u8 = plaintext[(offset + j) as usize].to_u8()
                let iv_b: u8 = prev_block[j as usize].to_u8()
                block[j as usize] = Byte::from_u8(p ^ iv_b)
            }
            let encrypted: Byte[16] = self.expanded_key.encrypt_block(&block)
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..16 {
                prev_block[j as usize] = encrypted[j as usize]
                let _ = output.push(encrypted[j as usize])
            }
        }
        Result::Ok(output)
    }

    pub fn decrypt_cbc(self, ciphertext: ref Byte[], length: u32) -> Result[FixedArray[4096, Byte], CryptoError]
        effects: [deterministic]
    {
        if length % 16 != 0 {
            return Result::Err(CryptoError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x023),
                FixedString[128]::from_slice("AES: ciphertext length must be multiple of 16")));
        }
        let mut output: FixedArray[4096, Byte] = FixedArray::new()
        let mut prev_block: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            prev_block[i as usize] = self.iv[i as usize]
        }

        // loop: bounds[BOUND_LARGE] — bounded by 256 blocks
        loop: bounds[BOUND_LARGE] for i in 0..(length / 16) {
            let offset: u32 = i * 16
            let block: ref Byte[16] = ciphertext.as_ptr().offset(offset as usize) as ref Byte[16]
            let decrypted: Byte[16] = self.expanded_key.decrypt_block(block)
            // XOR with previous ciphertext (or IV)
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..16 {
                let d: u8 = decrypted[j as usize].to_u8()
                let iv_b: u8 = prev_block[j as usize].to_u8()
                let _ = output.push(Byte::from_u8(d ^ iv_b))
                prev_block[j as usize] = ciphertext[(offset + j) as usize]
            }
        }
        Result::Ok(output)
    }

    // ──────────────────────────────────────────────
    // CTR Mode
    // ──────────────────────────────────────────────

    fn increment_counter(counter: ref mut Byte[16])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in (0..16).rev() {
            let val: u8 = counter[i as usize].to_u8()
            let new_val: u16 = (val as u16) + 1
            counter[i as usize] = Byte::from_u8((new_val & 0xFF) as u8)
            if new_val <= 0xFF {
                break
            }
        }
    }

    pub fn encrypt_ctr(self, plaintext: ref Byte[], length: u32) -> Result[FixedArray[4096, Byte], CryptoError>
        effects: [deterministic]
    {
        if length > 4096 {
            return Result::Err(CryptoError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x024),
                FixedString[128]::from_slice("AES-CTR: length exceeds buffer")));
        }
        let mut output: FixedArray[4096, Byte] = FixedArray::new()
        let mut counter: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            counter[i as usize] = self.iv[i as usize]
        }

        let mut remaining: u32 = length
        let mut in_offset: u32 = 0

        // loop: bounds[BOUND_LARGE] — bounded by 256 blocks
        loop: bounds[BOUND_LARGE] while remaining > 0 {
            let keystream: Byte[16] = self.expanded_key.encrypt_block(&counter)
            let chunk: u32 = if remaining >= 16 { 16 } else { remaining }
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..chunk {
                let p: u8 = plaintext[(in_offset + j) as usize].to_u8()
                let k: u8 = keystream[j as usize].to_u8()
                let _ = output.push(Byte::from_u8(p ^ k))
            }
            in_offset = in_offset + chunk
            remaining = remaining - chunk
            AESEngine::increment_counter(&mut counter)
        }
        Result::Ok(output)
    }

    // ──────────────────────────────────────────────
    // GCM Mode (simplified, for authenticated encryption)
    // ──────────────────────────────────────────────
    // Evidence path: AES-GCM-001 through AES-GCM-045

    pub fn encrypt_gcm(self, plaintext: ref Byte[], aad: ref Byte[], aad_len: u32, tag: ref mut Byte[16]) -> Result[FixedArray[4096, Byte], CryptoError>
        effects: [deterministic]
    {
        // CTR encryption with counter starting at 2
        let mut j0: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..12 {
            j0[i as usize] = self.iv[i as usize]
        }
        j0[12] = Byte::from_u8(0)
        j0[13] = Byte::from_u8(0)
        j0[14] = Byte::from_u8(0)
        j0[15] = Byte::from_u8(0x01)

        let mut ciphertext: FixedArray[4096, Byte] = FixedArray::new()
        let mut counter: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            counter[i as usize] = j0[i as usize]
        }

        // Increment counter (J0 + 1 for initial counter, which is J0 with last 32 bits = 2)
        counter[15] = Byte::from_u8(0x02)

        let mut remaining: u32 = plaintext.len() as u32
        let mut in_offset: u32 = 0

        // loop: bounds[BOUND_LARGE] — bounded by 256 blocks
        loop: bounds[BOUND_LARGE] while remaining > 0 {
            let keystream: Byte[16] = self.expanded_key.encrypt_block(&counter)
            let chunk: u32 = if remaining >= 16 { 16 } else { remaining }
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..chunk {
                let p: u8 = plaintext[(in_offset + j) as usize].to_u8()
                let k: u8 = keystream[j as usize].to_u8()
                let _ = ciphertext.push(Byte::from_u8(p ^ k))
            }
            in_offset = in_offset + chunk
            remaining = remaining - chunk
            AESEngine::increment_counter(&mut counter)
        }

        // Compute GHASH for authentication tag
        // Placeholder for full GHASH — simplified for bounded implementation
        // loop: bounds[BOUND_SMALL] — bounded by 16
        loop: bounds[BOUND_SMALL] for i in 0..16 {
            tag[i as usize] = Byte::from_u8(0)
        }

        Result::Ok(ciphertext)
    }

    pub fn decrypt_gcm(self, ciphertext: ref Byte[], aad: ref Byte[], aad_len: u32, tag: ref Byte[16]) -> Result[FixedArray[4096, Byte], CryptoError>
        effects: [deterministic]
    {
        let mut j0: Byte[16] = [Byte::from_u8(0); 16]
        // loop: bounds[BOUND_SMALL] — bounded by 12
        loop: bounds[BOUND_SMALL] for i in 0..12 {
            j0[i as usize] = self.iv[i as usize]
        }
        j0[12] = Byte::from_u8(0)
        j0[13] = Byte::from_u8(0)
        j0[14] = Byte::from_u8(0)
        j0[15] = Byte::from_u8(0x02)

        let mut plaintext: FixedArray[4096, Byte] = FixedArray::new()
        let mut counter: Byte[16] = j0

        let mut remaining: u32 = ciphertext.len() as u32
        let mut in_offset: u32 = 0

        // loop: bounds[BOUND_LARGE] — bounded by 256 blocks
        loop: bounds[BOUND_LARGE] while remaining > 0 {
            let keystream: Byte[16] = self.expanded_key.encrypt_block(&counter)
            let chunk: u32 = if remaining >= 16 { 16 } else { remaining }
            // loop: bounds[BOUND_SMALL] — bounded by 16
            loop: bounds[BOUND_SMALL] for j in 0..chunk {
                let c: u8 = ciphertext[(in_offset + j) as usize].to_u8()
                let k: u8 = keystream[j as usize].to_u8()
                let _ = plaintext.push(Byte::from_u8(c ^ k))
            }
            in_offset = in_offset + chunk
            remaining = remaining - chunk
            AESEngine::increment_counter(&mut counter)
        }
        Result::Ok(plaintext)
    }
}

// ──────────────────────────────────────────────
// Constant-Time Operations
// ──────────────────────────────────────────────
// Evidence path: AES-CTIME-001 through AES-CTIME-025

pub fn constant_time_compare(a: ref Byte[], b: ref Byte[], len: u32) -> bool
    effects: [deterministic]
{
    let mut diff: u8 = 0
    // loop: bounds[BOUND_MEDIUM] — bounded by comparison length, constant-time
    loop: bounds[BOUND_MEDIUM] for i in 0..len {
        diff = diff | (a[i as usize].to_u8() ^ b[i as usize].to_u8())
    }
    diff == 0
}

pub fn constant_time_select(cond: bool, true_val: Byte, false_val: Byte) -> Byte
    effects: [deterministic]
{
    let mask: u8 = if cond { 0xFF } else { 0x00 }
    Byte::from_u8((mask & true_val.to_u8()) | (!mask & false_val.to_u8()))
}

pub fn constant_time_zero(buf: ref mut Byte[], len: u32)
    effects: [deterministic]
{
    // loop: bounds[BOUND_MEDIUM] — bounded by length
    loop: bounds[BOUND_MEDIUM] for i in 0..len {
        buf[i as usize] = Byte::from_u8(0)
    }
}

// ──────────────────────────────────────────────
// AES Test Vectors (NIST FIPS-197)
// ──────────────────────────────────────────────
// Evidence path: AES-TEST-001 through AES-TEST-035

pub fn run_aes_test_vectors() -> bool
    effects: [deterministic, residual]
{
    // AES-128 test vector (FIPS-197 Appendix B)
    let key128_bytes: Byte[16] = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f
    ]
    let pt128: Byte[16] = [
        0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
        0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff
    ]
    let expected_ct128: Byte[16] = [
        0x69, 0xc4, 0xe0, 0xd8, 0x6a, 0x7b, 0x04, 0x30,
        0xd8, 0xcd, 0xb7, 0x80, 0x70, 0xb4, 0xc5, 0x5a
    ]

    let key128: AESKey = AESKey::from_bytes(&key128_bytes, 16)?
    let engine_ecb: AESEngine = AESEngine::new(key128, AESMode::ECB, &[Byte::from_u8(0); 16])

    let encrypted128: FixedArray[4096, Byte] = engine_ecb.encrypt_ecb(&pt128, 16)?
    assert(encrypted128.len() == 16, "aes128: output length correct")

    // Verify against known answer
    let mut tv1_ok: bool = true
    // loop: bounds[BOUND_SMALL] — bounded by 16
    loop: bounds[BOUND_SMALL] for i in 0..16 {
        if encrypted128[i as usize].to_u8() != expected_ct128[i as usize].to_u8() {
            tv1_ok = false
        }
    }
    assert(tv1_ok, "aes128: encrypt matches known answer")

    // Decrypt and verify
    let decrypted128: FixedArray[4096, Byte] = engine_ecb.decrypt_ecb(&encrypted128.data[0..16], 16)?
    let mut tv1_dec_ok: bool = true
    // loop: bounds[BOUND_SMALL] — bounded by 16
    loop: bounds[BOUND_SMALL] for i in 0..16 {
        if decrypted128[i as usize].to_u8() != pt128[i as usize].to_u8() {
            tv1_dec_ok = false
        }
    }
    assert(tv1_dec_ok, "aes128: decrypt round-trips correctly")

    // AES-256 test vector (ECB mode)
    let key256_bytes: Byte[32] = [
        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
        0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f
    ]
    let key256: AESKey = AESKey::from_bytes(&key256_bytes, 32)?
    let engine256: AESEngine = AESEngine::new(key256, AESMode::ECB, &[Byte::from_u8(0); 16])

    let enc256: FixedArray[4096, Byte] = engine256.encrypt_ecb(&pt128, 16)?
    assert(enc256.len() == 16, "aes256: encrypt produces output")

    let dec256: FixedArray[4096, Byte] = engine256.decrypt_ecb(&enc256.data[0..16], 16)?
    let mut tv256_ok: bool = true
    // loop: bounds[BOUND_SMALL] — bounded by 16
    loop: bounds[BOUND_SMALL] for i in 0..16 {
        if dec256[i as usize].to_u8() != pt128[i as usize].to_u8() {
            tv256_ok = false
        }
    }
    assert(tv256_ok, "aes256: decrypt round-trips correctly")

    // CBC mode test
    let iv: Byte[16] = [Byte::from_u8(0); 16]
    let key_cbc: AESKey = AESKey::from_bytes(&key128_bytes, 16)?
    let engine_cbc: AESEngine = AESEngine::new(key_cbc, AESMode::CBC, &iv)

    let long_pt: Byte[32] = [Byte::from_u8(0x42); 32]
    let enc_cbc: FixedArray[4096, Byte] = engine_cbc.encrypt_cbc(&long_pt, 32)?
    let dec_cbc: FixedArray[4096, Byte] = engine_cbc.decrypt_cbc(&enc_cbc.data[0..32], 32)?

    let mut cbc_ok: bool = true
    // loop: bounds[BOUND_SMALL] — bounded by 32
    loop: bounds[BOUND_SMALL] for i in 0..32 {
        if dec_cbc[i as usize].to_u8() != long_pt[i as usize].to_u8() {
            cbc_ok = false
        }
    }
    assert(cbc_ok, "aes-cbc: round-trip works")

    // CTR mode test
    let key_ctr: AESKey = AESKey::from_bytes(&key128_bytes, 16)?
    let nonce_ctr: Byte[16] = [Byte::from_u8(0); 16]
    let engine_ctr: AESEngine = AESEngine::new(key_ctr, AESMode::CTR, &nonce_ctr)

    let ctr_pt: Byte[48] = [Byte::from_u8(0xAB); 48]
    let enc_ctr: FixedArray[4096, Byte] = engine_ctr.encrypt_ctr(&ctr_pt, 48)?
    let mut dec_ctr: FixedArray[4096, Byte] = FixedArray::new()

    // Re-encrypt with same nonce to get keystream, XOR to decrypt
    let engine_ctr2: AESEngine = AESEngine::new(key_ctr, AESMode::CTR, &nonce_ctr)
    let keystream: FixedArray[4096, Byte] = engine_ctr2.encrypt_ctr(&ctr_pt, 48)?

    let mut ctr_ok: bool = true
    // loop: bounds[BOUND_SMALL] — bounded by 48
    loop: bounds[BOUND_SMALL] for i in 0..48 {
        let c: u8 = enc_ctr[i as usize].to_u8()
        let k: u8 = keystream[i as usize].to_u8()
        let p: u8 = c ^ k  // double-CTR = plaintext
        if p != ctr_pt[i as usize].to_u8() {
            ctr_ok = false
        }
    }
    assert(ctr_ok, "aes-ctr: encryption and decryption match")

    // Constant-time comparison test
    let a: Byte[16] = [Byte::from_u8(0x01); 16]
    let b: Byte[16] = [Byte::from_u8(0x01); 16]
    let c: Byte[16] = [Byte::from_u8(0x02); 16]
    assert(constant_time_compare(&a, &b, 16), "aes: constant-time equal")
    assert(!constant_time_compare(&a, &c, 16), "aes: constant-time not equal")

    // Constant-time select test
    let selected: Byte = constant_time_select(true, Byte::from_u8(0xAA), Byte::from_u8(0xBB))
    assert(selected.to_u8() == 0xAA, "aes: constant-time select true")
    let selected_f: Byte = constant_time_select(false, Byte::from_u8(0xAA), Byte::from_u8(0xBB))
    assert(selected_f.to_u8() == 0xBB, "aes: constant-time select false")

    // Key expansion verification
    let exp_key: AESExpandedKey = AESExpandedKey::expand(&key128)
    assert(exp_key.num_rounds == AES128_ROUNDS, "aes128: correct round count")

    residual emit {
        op: "aes.test_vectors",
        ecb128: tv1_ok,
        ecb128_roundtrip: tv1_dec_ok,
        ecb256: tv256_ok,
        cbc: cbc_ok,
        ctr: ctr_ok,
        ctime_cmp: true,
        ctime_select: true,
        key_expand: true,
    }

    true
}
