            timestamp: timestamp,
            event_type: event_type,
            actor: actor,
            target: target,
            details: details,
            evidence_hash: Hash256::zeroed(),
        }
    }
}

pub type AuditEventType : u8 = enum {
    Audit_CapabilityGrant  = 0x01,
    Audit_CapabilityRevoke = 0x02,
    Audit_CageCreate       = 0x03,
    Audit_CageDestroy      = 0x04,
    Audit_SealCreate       = 0x05,
    Audit_SealBreak        = 0x06,
    Audit_CourtVerdict     = 0x07,
    Audit_TrustChange      = 0x08,
    Audit_DriverRegister   = 0x09,
    Audit_DriverUnload     = 0x0A,
    Audit_PackageLoad      = 0x0B,
    Audit_PackageVerify    = 0x0C,
    Audit_SystemBoot       = 0x0D,
    Audit_SystemShutdown   = 0x0E,
    Audit_Panic            = 0x0F,
    Audit_UserDefined      = 0x80,
}

