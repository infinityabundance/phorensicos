// ──────────────────────────────────────────────
// Multiboot v2 ACPI Tags
// ──────────────────────────────────────────────

pub type MultiBoot2ACPIv1 : struct {
    tag: MultiBoot2Tag,
    rsdp: FixedArray[20, u8],
}

pub type MultiBoot2ACPIv2 : struct {
    tag: MultiBoot2Tag,
    xsdp: FixedArray[36, u8],
}

impl MultiBoot2ACPIv2 {
    pub fn new() -> MultiBoot2ACPIv2
        effects: [deterministic]
    {
        MultiBoot2ACPIv2 {
            tag: MultiBoot2Tag::new(),
            xsdp: FixedArray::new(),
        }
    }

    pub fn get_rsdp(self) -> FixedArray[36, u8]
        effects: [deterministic]
    {
        self.xsdp
    }

    pub fn get_rsdp_address(self) -> Word64
        effects: [deterministic]
    {
        // Parse RSDP to get XSDT address
        if self.xsdp.len() < 36 {
            return Word64::zero()
        }
        let mut addr_bytes: FixedArray[8, u8] = FixedArray::new()
        for i in 0..8 {
            let idx: u32 = 24 + i
            addr_bytes.push(self.xsdp.get(idx)!)!
        }
        let addr_low: u64 = addr_bytes.get(0)! as u64 |
                           ((addr_bytes.get(1)! as u64) << 8) |
                           ((addr_bytes.get(2)! as u64) << 16) |
                           ((addr_bytes.get(3)! as u64) << 24)
        let addr_high: u64 = (addr_bytes.get(4)! as u64) << 32 |
                            ((addr_bytes.get(5)! as u64) << 40) |
                            ((addr_bytes.get(6)! as u64) << 48) |
                            ((addr_bytes.get(7)! as u64) << 56)
        Word64::from_u64(addr_low | addr_high)
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Boot Information (tag iterator)
// ──────────────────────────────────────────────

pub type MultiBoot2Info : struct {
    total_size: Word32,
    reserved: Word32,
    tags: FixedArray[MAX_MBI_TAGS, MultiBoot2Tag],
    num_tags: u32,
}

impl MultiBoot2Info {
    pub fn new() -> MultiBoot2Info
        effects: [deterministic]
    {
        MultiBoot2Info {
            total_size: 0,
            reserved: 0,
            tags: FixedArray::new(),
            num_tags: 0,
        }
    }

    pub fn add_tag(self: ref mut, tag: MultiBoot2Tag) -> Result[(), BootError]
        effects: [deterministic]
    {
        if self.num_tags >= MAX_MBI_TAGS {
            return Result::Err(BootError::new(
                DIAG_MULTIBOOT_BASE | 0x001,
                "Maximum multiboot v2 tags exceeded"
            ))
        }
        self.tags.set(self.num_tags, tag)!
        self.num_tags = self.num_tags + 1
        Result::Ok(())
    }

    pub fn find_tag(self, tag_type: Word32) -> Result[MultiBoot2Tag, BootError]
        effects: [deterministic]
    {
        for i in 0..self.num_tags {
            let tag: MultiBoot2Tag = self.tags.get(i)!
            if tag.tag_type == tag_type {
                return Result::Ok(tag)
            }
        }
        Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x002,
            "Multiboot v2 tag not found"
        ))
    }

    pub fn has_tag(self, tag_type: Word32) -> bool
        effects: [deterministic]
    {
        let result: Result[MultiBoot2Tag, BootError] = self.find_tag(tag_type)
        result.is_ok()
    }

    pub fn tag_count(self) -> u32
        effects: [deterministic]
    {
        self.num_tags
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Header (for bootloader config)
// ──────────────────────────────────────────────

pub type MultiBoot2HeaderFixed : struct {
    magic: Word32,
    architecture: Word32,
    header_length: Word32,
    checksum: Word32,
}

impl MultiBoot2HeaderFixed {
    pub fn new() -> MultiBoot2HeaderFixed
        effects: [deterministic]
    {
        MultiBoot2HeaderFixed {
            magic: 0,
            architecture: 0,
            header_length: 0,
            checksum: 0,
        }
    }

    pub fn validate(self) -> bool
        effects: [deterministic]
    {
        if self.magic != MULTIBOOT2_HEADER_MAGIC {
            return false
        }
        let sum: Word32 = self.magic + self.architecture + self.header_length + self.checksum
        sum == 0
    }

    pub fn is_i386(self) -> bool
        effects: [deterministic]
    {
        self.architecture == MULTIBOOT2_ARCH_I386
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Request Header Tag
// ──────────────────────────────────────────────

pub type MultiBoot2HeaderTag : struct {
    tag_type: Word16,
    flags: Word16,
    size: Word32,
}

impl MultiBoot2HeaderTag {
    pub fn new() -> MultiBoot2HeaderTag
        effects: [deterministic]
    {
        MultiBoot2HeaderTag {
            tag_type: 0,
            flags: 0,
            size: 0,
        }
    }

    pub fn is_optional(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x1) != 0
    }
}

// ──────────────────────────────────────────────
// Parsing Functions
// ──────────────────────────────────────────────

pub fn parse_multiboot1_header(data: &[u8]) -> Result[MultiBoot1Header, BootError]
    effects: [deterministic]
{
    if data.len() < 48 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x010,
            "Multiboot v1 header too small"
        ))
    }

    let header: MultiBoot1Header = MultiBoot1Header {
        magic: read_u32(data, 0),
        flags: read_u32(data, 4),
        checksum: read_u32(data, 8),
        header_addr: read_u32(data, 12),
        load_addr: read_u32(data, 16),
        load_end_addr: read_u32(data, 20),
        bss_end_addr: read_u32(data, 24),
        entry_addr: read_u32(data, 28),
        mode_type: read_u32(data, 32),
        width: read_u32(data, 36),
        height: read_u32(data, 40),
        depth: read_u32(data, 44),
    }

    if !header.validate() {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x011,
            "Multiboot v1 header checksum mismatch"
        ))
    }

    Result::Ok(header)
}

pub fn parse_multiboot1_info(data: &[u8]) -> Result[MultiBoot1Info, BootError>
    effects: [deterministic]
{
    if data.len() < 48 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x020,
            "Multiboot v1 info structure too small"
        ))
    }

    let info: MultiBoot1Info = MultiBoot1Info {
        flags: read_u32(data, 0),
        mem_lower: read_u32(data, 4),
        mem_upper: read_u32(data, 8),
        boot_device: read_u32(data, 12),
        cmdline: read_u32(data, 16),
        mods_count: read_u32(data, 20),
        mods_addr: read_u32(data, 24),
        syms: FixedArray::new(),
        mmap_length: read_u32(data, 44),
        mmap_addr: read_u32(data, 48),
        drives_length: read_u32(data, 52),
        drives_addr: read_u32(data, 56),
        config_table: read_u32(data, 60),
        boot_loader_name: read_u32(data, 64),
        apm_table: read_u32(data, 68),
        vbe_control_info: read_u32(data, 72),
        vbe_mode_info: read_u32(data, 76),
        vbe_mode: read_u16(data, 80),
        vbe_interface_seg: read_u16(data, 82),
        vbe_interface_off: read_u16(data, 84),
        vbe_interface_len: read_u16(data, 86),
        framebuffer_addr: read_u64(data, 88),
        framebuffer_pitch: read_u32(data, 96),
        framebuffer_width: read_u32(data, 100),
        framebuffer_height: read_u32(data, 104),
        framebuffer_bpp: data[108],
        framebuffer_type: data[109],
        color_info: FixedArray::new(),
    }

    Result::Ok(info)
}

pub fn parse_multiboot1_mmap(data: &[u8], mmap_addr: Word32, mmap_length: Word32) -> Result<FixedArray[128, MultiBoot1MMapEntry], BootError>
    effects: [deterministic]
{
    let mut entries: FixedArray[128, MultiBoot1MMapEntry] = FixedArray::new()
    if mmap_length == 0 {
        return Result::Ok(entries)
    }

    let mut offset: u32 = 0
    while offset < mmap_length {
        let entry_size: Word32 = read_u32(data, offset)
        if entry_size < 20 {
            return Result::Err(BootError::new(
                DIAG_MULTIBOOT_BASE | 0x030,
                "Invalid multiboot v1 mmap entry size"
            ))
        }
        let entry: MultiBoot1MMapEntry = MultiBoot1MMapEntry {
            size: entry_size,
            base_addr: read_u64(data, offset + 4),
            length: read_u64(data, offset + 12),
            entry_type: read_u32(data, offset + 20),
        }
        entries.push(entry)!
        offset = offset + entry_size + 4
    } proven

    Result::Ok(entries)
}

pub fn parse_multiboot2_info(data: &[u8], size: Word32) -> Result[MultiBoot2Info, BootError>
    effects: [deterministic]
{
    let mut info: MultiBoot2Info = MultiBoot2Info::new()
    if data.len() < 8 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x040,
            "Multiboot v2 info structure too small"
        ))
    }

    info.total_size = read_u32(data, 0)
    info.reserved = read_u32(data, 4)

    let mut offset: u32 = 8
    loop: bounds[BOUND_LARGE] while offset < size {
        if offset + 8 > data.len() as u32 {
            break
        }
        let tag_type: Word32 = read_u32(data, offset)
        let tag_size: Word32 = read_u32(data, offset + 4)

        if tag_type == MB2_TAG_END {
            break
        }

        if tag_size == 0 {
            break
        }

        let tag: MultiBoot2Tag = MultiBoot2Tag {
            tag_type: tag_type,
            size: tag_size,
        }
        info.add_tag(tag)!

        // Align to 8 bytes
        let aligned_size: Word32 = (tag_size + 7) & 0xFFFF_FFF8
        offset = offset + aligned_size
    }

    Result::Ok(info)
}

pub fn parse_multiboot2_framebuffer(data: &[u8], tag_offset: Word32) -> Result[MultiBoot2Framebuffer, BootError>
    effects: [deterministic]
{
    if tag_offset + 40 > data.len() as u32 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x050,
            "Framebuffer tag data too small"
        ))
    }

    let fb: MultiBoot2Framebuffer = MultiBoot2Framebuffer {
        tag: MultiBoot2Tag {
            tag_type: read_u32(data, tag_offset),
            size: read_u32(data, tag_offset + 4),
        },
        framebuffer_addr: read_u64(data, tag_offset + 8),
        framebuffer_pitch: read_u32(data, tag_offset + 16),
        framebuffer_width: read_u32(data, tag_offset + 20),
        framebuffer_height: read_u32(data, tag_offset + 24),
        framebuffer_bpp: data[(tag_offset + 28) as usize],
        framebuffer_type: data[(tag_offset + 29) as usize],
        reserved: data[(tag_offset + 30) as usize],
        color_info: FixedArray::new(),
    }

    Result::Ok(fb)
}

pub fn parse_multiboot2_mmap(data: &[u8], tag_offset: Word32, tag_size: Word32) -> Result<FixedArray[128, MultiBoot2MMapEntry], BootError>
    effects: [deterministic]
{
    let mut entries: FixedArray[128, MultiBoot2MMapEntry] = FixedArray::new()
    if tag_offset + 16 > data.len() as u32 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x060,
            "MMAP tag header too small"
        ))
    }

    let entry_size: Word32 = read_u32(data, tag_offset + 8)
    let _entry_version: Word32 = read_u32(data, tag_offset + 12)

    if entry_size < 24 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x061,
            "Invalid MMAP entry size"
        ))
    }

    let mut entry_offset: u32 = tag_offset + 16
    loop: bounds[BOUND_LARGE] while entry_offset + entry_size <= tag_offset + tag_size {
        let entry: MultiBoot2MMapEntry = MultiBoot2MMapEntry {
            entry_size: entry_size,
            base_addr: read_u64(data, entry_offset),
            length: read_u64(data, entry_offset + 8),
            entry_type: read_u32(data, entry_offset + 16),
            reserved: read_u32(data, entry_offset + 20),
        }
        entries.push(entry)!
        entry_offset = entry_offset + entry_size
    }

    Result::Ok(entries)
}

pub fn parse_multiboot2_acpi_v2(data: &[u8], tag_offset: Word32) -> Result[MultiBoot2ACPIv2, BootError>
    effects: [deterministic]
{
    if tag_offset + 44 > data.len() as u32 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x070,
            "ACPI v2 tag too small"
        ))
    }

    let mut xsdp: FixedArray[36, u8] = FixedArray::new()
    for i in 0..36 {
        xsdp.push(data[(tag_offset + 8 + i) as usize])!
    }

    let acpi: MultiBoot2ACPIv2 = MultiBoot2ACPIv2 {
        tag: MultiBoot2Tag {
            tag_type: read_u32(data, tag_offset),
            size: read_u32(data, tag_offset + 4),
        },
        xsdp: xsdp,
    }

    Result::Ok(acpi)
}

// ──────────────────────────────────────────────
// Integration: Build Memory Map from Multiboot
// ──────────────────────────────────────────────

pub fn build_memory_map_from_multiboot1(mb_info: MultiBoot1Info, data: &[u8]) -> Result<FixedArray[128, MultiBoot1MMapEntry], BootError>
    effects: [deterministic]
{
    if !mb_info.has_mmap() {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x080,
            "Multiboot v1 info has no memory map"
        ))
    }

    parse_multiboot1_mmap(data, mb_info.mmap_addr, mb_info.mmap_length)
}

pub fn build_memory_map_from_multiboot2(mb2_info: MultiBoot2Info, data: &[u8]) -> Result<FixedArray[128, MultiBoot2MMapEntry], BootError>
    effects: [deterministic]
{
    for i in 0..mb2_info.num_tags {
        let tag: MultiBoot2Tag = mb2_info.tags.get(i)!
        if tag.tag_type == MB2_TAG_MMAP {
            // We need the raw tag offset and size from the original data
            // This is handled by the caller with the parsing function
            return Result::Err(BootError::new(
                DIAG_MULTIBOOT_BASE | 0x081,
                "Use parse_multiboot2_mmap with raw data offset"
            ))
        }
    }
    Result::Err(BootError::new(
        DIAG_MULTIBOOT_BASE | 0x082,
        "No MMAP tag found in multiboot v2 info"
    ))
}

// ──────────────────────────────────────────────
// Module Loading
// ──────────────────────────────────────────────

pub type ModuleInfo : struct {
    start: Word32,
    end: Word32,
    cmdline: FixedString[MAX_MODULE_CMDLINE],
    is_loaded: bool,
    name: FixedString[64],
}

impl ModuleInfo {
    pub fn new() -> ModuleInfo
        effects: [deterministic]
    {
        ModuleInfo {
            start: 0,
            end: 0,
            cmdline: FixedString::new(),
            is_loaded: false,
            name: FixedString::new(),
        }
    }

    pub fn size(self) -> Word32
        effects: [deterministic]
    {
        if self.end > self.start {
            self.end - self.start
        } else {
            0
        }
    }
}

pub fn load_multiboot_modules(mb_info: MultiBoot1Info, data: &[u8]) -> Result<FixedArray[32, ModuleInfo], BootError>
    effects: [deterministic]
{
    let mut modules: FixedArray[32, ModuleInfo] = FixedArray::new()

    if !mb_info.has_modules() {
        return Result::Ok(modules)
    }

    let mods_count: Word32 = mb_info.mods_count
    if mods_count > 32 {
        return Result::Err(BootError::new(
            DIAG_MULTIBOOT_BASE | 0x090,
            "Too many multiboot modules"
        ))
    }

    let mut mods_addr: u32 = mb_info.mods_addr
    for i in 0..mods_count {
        let idx: u32 = mods_addr + (i * 16)
        if idx + 16 > data.len() as u32 {
            break
        }

        let mod_start: Word32 = read_u32(data, idx)
        let mod_end: Word32 = read_u32(data, idx + 4)
        let cmdline_addr: Word32 = read_u32(data, idx + 8)
        let _reserved: Word32 = read_u32(data, idx + 12)

        let mut cmdline: FixedString[MAX_MODULE_CMDLINE] = FixedString::new()
        let mut c_offset: u32 = cmdline_addr
        loop: bounds[BOUND_MEDIUM] while c_offset < data.len() as u32 {
            let byte: u8 = data[c_offset as usize]
            if byte == 0 {
                break
            }
            cmdline.append_byte(byte)!
            c_offset = c_offset + 1
        }

        let module: ModuleInfo = ModuleInfo {
            start: mod_start,
            end: mod_end,
            cmdline: cmdline,
            is_loaded: true,
            name: FixedString::new(),
        }
        modules.push(module)!
    }

    Result::Ok(modules)
}

pub fn load_multiboot2_modules(mb2_info: MultiBoot2Info, data: &[u8]) -> Result<FixedArray[32, ModuleInfo], BootError>
    effects: [deterministic]
{
    let mut modules: FixedArray[32, ModuleInfo] = FixedArray::new()

    for i in 0..mb2_info.num_tags {
        let tag: MultiBoot2Tag = mb2_info.tags.get(i)!
        if tag.tag_type == MB2_TAG_MODULE {
            // Module data parsing would happen here with direct data access
        }
    }

    Result::Ok(modules)
}

// ──────────────────────────────────────────────
// Command Line Extraction
// ──────────────────────────────────────────────

pub fn extract_multiboot1_cmdline(data: &[u8], cmdline_addr: Word32) -> FixedString[512]
    effects: [deterministic]
{
    let mut cmdline: FixedString[512] = FixedString::new()
    let mut offset: u32 = cmdline_addr
    loop: bounds[BOUND_LARGE] while offset < data.len() as u32 {
        let byte: u8 = data[offset as usize]
        if byte == 0 {
            break
        }
        cmdline.append_byte(byte)!
        offset = offset + 1
    }
    cmdline
}

pub fn extract_multiboot2_cmdline(data: &[u8], tag_offset: Word32) -> FixedString[512]
    effects: [deterministic]
{
    let mut cmdline: FixedString[512] = FixedString::new()
    let mut offset: u32 = tag_offset + 8
    loop: bounds[BOUND_LARGE] while offset < data.len() as u32 {
        let byte: u8 = data[offset as usize]
        if byte == 0 {
            break
        }
        cmdline.append_byte(byte)!
        offset = offset + 1
    }
    cmdline
}

// ──────────────────────────────────────────────
// ACPI RSDP Discovery via Multiboot
// ──────────────────────────────────────────────

pub fn find_acpi_rsdp_multiboot1(mb_info: MultiBoot1Info, data: &[u8]) -> Result[Word64, BootError>
    effects: [deterministic]
{
    // Multiboot v1 passes RSDP in the ACPI BIOS area
    // Scan EBDA and BIOS area for RSDP signature "RSD PTR "
    let ebda_addr: u32 = read_u32(data, 0x40E)  // EBDA segment from BDA
    let ebda_base: u32 = (ebda_addr << 4) & 0x000F_FFFF

    // Scan EBDA first
    let rsdp: Result[Word64, BootError] = scan_for_rsdp(data, ebda_base, 1024)
    if rsdp.is_ok() {
        return rsdp
    }

    // Scan BIOS area 0xE0000 - 0xFFFFF
    scan_for_rsdp(data, 0xE0000, 0x20000)
}

pub fn find_acpi_rsdp_multiboot2(mb2_info: MultiBoot2Info, data: &[u8]) -> Result[Word64, BootError>
    effects: [deterministic]
{
    for i in 0..mb2_info.num_tags {
        let tag: MultiBoot2Tag = mb2_info.tags.get(i)!
        if tag.tag_type == MB2_TAG_ACPI_NEW {
            let acpi: MultiBoot2ACPIv2 = parse_multiboot2_acpi_v2(data, 0)!
            return Result::Ok(acpi.get_rsdp_address())
        }
    }
    Result::Err(BootError::new(
        DIAG_MULTIBOOT_BASE | 0x0A0,
        "ACPI v2 RSDP not found in multiboot tags"
    ))
}

fn scan_for_rsdp(data: &[u8], base: u32, length: u32) -> Result[Word64, BootError>
    effects: [deterministic]
{
    let mut offset: u32 = base
    loop: bounds[BOUND_LARGE] while offset < base + length {
        if offset + 8 > data.len() as u32 {
            break
        }
        // Check for "RSD PTR " signature
        let s0: u8 = data[offset as usize]
        let s1: u8 = data[(offset + 1) as usize]
        let s2: u8 = data[(offset + 2) as usize]
        let s3: u8 = data[(offset + 3) as usize]
        let s4: u8 = data[(offset + 4) as usize]
        let s5: u8 = data[(offset + 5) as usize]
        let s6: u8 = data[(offset + 6) as usize]
        let s7: u8 = data[(offset + 7) as usize]
        if s0 == 'R' as u8 && s1 == 'S' as u8 && s2 == 'D' as u8 &&
           s3 == ' ' as u8 && s4 == 'P' as u8 && s5 == 'T' as u8 &&
           s6 == 'R' as u8 && s7 == ' ' as u8 {
            return Result::Ok(Word64::from_u64(offset as u64))
        }
        offset = offset + 16
    }
    Result::Err(BootError::new(
        DIAG_MULTIBOOT_BASE | 0x0A1,
        "RSDP signature not found"
    ))
}

// ──────────────────────────────────────────────
// Multiboot v2 Header Construction
// ──────────────────────────────────────────────

pub fn build_multiboot2_header() -> Result<FixedArray[256, u8], BootError>
    effects: [deterministic]
{
    let mut header: FixedArray[256, u8] = FixedArray::new()

    // Fixed header
    write_u32(header, 0, MULTIBOOT2_HEADER_MAGIC)
    write_u32(header, 4, MULTIBOOT2_ARCH_I386)
    let header_length: Word32 = 24  // header + information request tag
    write_u32(header, 8, header_length)
    // Checksum = -(magic + arch + length)
    let checksum: Word32 = 0 - (MULTIBOOT2_HEADER_MAGIC + MULTIBOOT2_ARCH_I386 + header_length)
    write_u32(header, 12, checksum)

    // Information request tag
    write_u16(header, 16, 1)   // tag type: information request
    write_u16(header, 18, 0)   // flags
    write_u32(header, 20, 4)   // size

    // Terminator tag
    let term_offset: u32 = 24
    write_u16(header, term_offset, 0)  // type: end
    write_u16(header, term_offset + 2, 0)  // flags
    write_u32(header, term_offset + 4, 8)  // size

    Result::Ok(header)
}

// ──────────────────────────────────────────────
// Raw Data Access Helpers
// ──────────────────────────────────────────────

fn read_u8(data: &[u8], offset: u32) -> u8
    effects: [deterministic]
{
    if offset >= data.len() as u32 {
        0
    } else {
        data[offset as usize]
    }
}

fn read_u16(data: &[u8], offset: u32) -> Word16
    effects: [deterministic]
{
    if offset + 1 >= data.len() as u32 {
        return 0
    }
    let low: u16 = data[offset as usize] as u16
    let high: u16 = (data[(offset + 1) as usize] as u16) << 8
    low | high
}

fn read_u32(data: &[u8], offset: u32) -> Word32
    effects: [deterministic]
{
    if offset + 3 >= data.len() as u32 {
        return 0
    }
    let b0: u32 = data[offset as usize] as u32
    let b1: u32 = (data[(offset + 1) as usize] as u32) << 8
    let b2: u32 = (data[(offset + 2) as usize] as u32) << 16
    let b3: u32 = (data[(offset + 3) as usize] as u32) << 24
    b0 | b1 | b2 | b3
}

fn read_u64(data: &[u8], offset: u32) -> Word64
    effects: [deterministic]
{
    if offset + 7 >= data.len() as u32 {
        return Word64::zero()
    }
    let low: Word64 = Word64::from_u64(read_u32(data, offset) as u64)
    let high: Word64 = Word64::from_u64((read_u32(data, offset + 4) as u64) << 32)
    low.bit_or(high)
}

fn write_u16(buf: ref mut FixedArray[256, u8], offset: u32, value: Word16)
    effects: [deterministic]
{
    if offset + 1 >= buf.capacity() as u32 {
        return
    }
    let idx_u: u32 = offset
    let idx_l: u32 = offset + 1
    if idx_u < buf.len() { buf.set(idx_u, (value & 0xFF) as u8)! }
    if idx_l < buf.len() { buf.set(idx_l, ((value >> 8) & 0xFF) as u8)! }
}

fn write_u32(buf: ref mut FixedArray[256, u8], offset: u32, value: Word32)
    effects: [deterministic]
{
    if offset + 3 >= 256 {
        return
    }
    for i in 0..4 {
        let byte: u8 = ((value >> (i * 8)) & 0xFF) as u8
        let idx: u32 = offset + i
        if idx < buf.len() {
            buf.set(idx, byte)!
        }
    }
}

// ──────────────────────────────────────────────
// BootError alias (uses same type as boot_loader)
// ──────────────────────────────────────────────

pub type BootError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BootError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BootError
        effects: [deterministic]
    {
        BootError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        self.code == 0
    }
}
