//==============================================================================
// capability_abi.phor — Phorensic Capability ABI
//
// Defines capability encoding, transfer in IPC, delegation encoding,
// revocation notification, capability type tags, rights encoding,
// generation tag encoding, and all related wire-format structures.
//
// All capability operations are residual-recorded and effect-gated.
//==============================================================================

module capability_abi
  @[receipt("cap-abi-v1")]
  @[audit("CAP-ABI")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{syscall, audit, alloc, unsafe, io};
use core::residual::*;
use core::mem::*;
use core::sync::atomic;

//==============================================================================
// Capability Type Tags
//==============================================================================

/// Top-level capability type tag classification.
pub enum CapabilityTypeTag : u64 {
  // --- Memory Capabilities ---
  MemoryRegion          = 0x0000_0001,
  MemoryMap             = 0x0000_0002,
  SharedMemory          = 0x0000_0003,
  MappedFile            = 0x0000_0004,
  HeapRegion            = 0x0000_0005,
  StackRegion           = 0x0000_0006,
  GuardPage             = 0x0000_0007,
  DeviceMemory          = 0x0000_0008,

  // --- Object Capabilities ---
  Thread                = 0x0001_0001,
  Process               = 0x0001_0002,
  Channel               = 0x0001_0003,
  Socket                = 0x0001_0004,
  Pipe                  = 0x0001_0005,
  FileDescriptor        = 0x0001_0006,
  Timer                 = 0x0001_0007,
  Signal                = 0x0001_0008,
  Mutex                 = 0x0001_0009,
  Semaphore             = 0x0001_000A,
  Condition             = 0x0001_000B,
  Event                 = 0x0001_000C,
  Barrier               = 0x0001_000D,

  // --- Capability Capabilities ---
  CapabilitySlot        = 0x0002_0001,
  CapabilityDomain      = 0x0002_0002,
  CapabilityMint        = 0x0002_0003,
  CapabilityAuthority   = 0x0002_0004,
  CapabilitySeal        = 0x0002_0005,
  CapabilityUnseal      = 0x0002_0006,
  CapabilityRevoke      = 0x0002_0007,

  // --- IPC Capabilities ---
  MessageEndpoint       = 0x0003_0001,
  ServiceEndpoint       = 0x0003_0002,
  ClientEndpoint        = 0x0003_0003,
  GatewayEndpoint       = 0x0003_0004,
  NotificationEndpoint  = 0x0003_0005,

  // --- I/O Capabilities ---
  IOProtocol            = 0x0004_0001,
  IODevice              = 0x0004_0002,
  IOInterrupt           = 0x0004_0003,
  IOPort                = 0x0004_0004,
  IOMemory              = 0x0004_0005,

  // --- Hypervisor Capabilities ---
  VirtualMachine        = 0x0005_0001,
  VirtualCPU            = 0x0005_0002,
  VMMemory              = 0x0005_0003,
  VMDevice              = 0x0005_0004,
  VMInterrupt           = 0x0005_0005,
  HypervisorControl     = 0x0005_0006,

  // --- Audit / Security Capabilities ---
  AuditLog              = 0x0006_0001,
  AuditControl          = 0x0006_0002,
  SecurityPolicy        = 0x0006_0003,
  CapabilityDebug       = 0x0006_0004,
  ResidualChain         = 0x0006_0005,

  // --- Compatibility Capabilities ---
  LinuxCompat           = 0x0007_0001,
  Win32Compat           = 0x0007_0002,
  PosixCompat           = 0x0007_0003,
  XDGCompat             = 0x0007_0004,

  // --- Kernel Capabilities ---
  KernelService         = 0x0008_0001,
  SchedulerControl      = 0x0008_0002,
  MemoryManager         = 0x0008_0003,
  ModuleLoader          = 0x0008_0004,
  SystemInfo            = 0x0008_0005,

  // --- User-Defined Capabilities ---
  UserBase              = 0x8000_0000,
}

/// Check if a capability type tag is valid.
pub fn is_valid_capability_tag[tag: u64] -> bool : effect:(pure) {
  // Tags must have the upper 16 bits as the category, lower 16 bits as type
  let category: u64 = tag & 0xFFFF_0000;
  let subtype: u64 = tag & 0x0000_FFFF;
  if category == 0 || subtype == 0 {
    return false;
  }
  return true;
}

/// Get the category of a capability type tag.
pub fn capability_tag_category[tag: u64] -> u64 : effect:(pure) {
  return tag & 0xFFFF_0000;
}

/// Category identifiers for capability types.
pub enum CapCategory : u64 {
  Memory        = 0x0000_0000,
  Object        = 0x0001_0000,
  Capability    = 0x0002_0000,
  IPC           = 0x0003_0000,
  IO            = 0x0004_0000,
  Hypervisor    = 0x0005_0000,
  Audit         = 0x0006_0000,
  Compat        = 0x0007_0000,
  Kernel        = 0x0008_0000,
  User          = 0x8000_0000,
}

//==============================================================================
// Rights Encoding
//==============================================================================

/// Rights encoding for capabilities — a 64-bit bitfield.
pub struct CapRights(
  bits: u64,
) : effect:(pure);

// Basic rights
const RIGHT_READ: CapRights       = CapRights(1 << 0);
const RIGHT_WRITE: CapRights      = CapRights(1 << 1);
const RIGHT_EXECUTE: CapRights    = CapRights(1 << 2);
const RIGHT_DELETE: CapRights     = CapRights(1 << 3);
const RIGHT_CREATE: CapRights     = CapRights(1 << 4);
const RIGHT_DESTROY: CapRights    = CapRights(1 << 5);

// Capability rights
const RIGHT_CAP_INSPECT: CapRights  = CapRights(1 << 8);
const RIGHT_CAP_REDUCE: CapRights   = CapRights(1 << 9);
const RIGHT_CAP_COPY: CapRights     = CapRights(1 << 10);
const RIGHT_CAP_MOVE: CapRights     = CapRights(1 << 11);
const RIGHT_CAP_DERIVE: CapRights   = CapRights(1 << 12);
const RIGHT_CAP_DELETE: CapRights   = CapRights(1 << 13);
const RIGHT_CAP_TRANSFER: CapRights = CapRights(1 << 14);
const RIGHT_CAP_MINT: CapRights     = CapRights(1 << 15);
const RIGHT_CAP_BURN: CapRights     = CapRights(1 << 16);
const RIGHT_CAP_SEAL: CapRights     = CapRights(1 << 17);
const RIGHT_CAP_UNSEAL: CapRights   = CapRights(1 << 18);

// Memory rights
const RIGHT_MEM_MAP: CapRights     = CapRights(1 << 20);
const RIGHT_MEM_UNMAP: CapRights   = CapRights(1 << 21);
const RIGHT_MEM_PROTECT: CapRights = CapRights(1 << 22);
const RIGHT_MEM_SHARE: CapRights   = CapRights(1 << 23);
const RIGHT_MEM_GROW: CapRights    = CapRights(1 << 24);

// Process rights
const RIGHT_PROC_CREATE: CapRights = CapRights(1 << 28);
const RIGHT_PROC_DESTROY: CapRights = CapRights(1 << 29);
const RIGHT_PROC_SCHED: CapRights  = CapRights(1 << 30);
const RIGHT_PROC_DEBUG: CapRights  = CapRights(1UL << 31);

// IPC rights
const RIGHT_IPC_SEND: CapRights    = CapRights(1UL << 32);
const RIGHT_IPC_RECV: CapRights    = CapRights(1UL << 33);
const RIGHT_IPC_CREATE: CapRights  = CapRights(1UL << 34);

// Hypervisor rights
const RIGHT_HV_CREATE: CapRights   = CapRights(1UL << 40);
const RIGHT_HV_DESTROY: CapRights  = CapRights(1UL << 41);
const RIGHT_HV_RUN: CapRights      = CapRights(1UL << 42);
const RIGHT_HV_MEM: CapRights      = CapRights(1UL << 43);
const RIGHT_HV_IRQ: CapRights      = CapRights(1UL << 44);
const RIGHT_HV_MIGRATE: CapRights  = CapRights(1UL << 45);

// Audit rights
const RIGHT_AUDIT_READ: CapRights  = CapRights(1UL << 48);
const RIGHT_AUDIT_WRITE: CapRights = CapRights(1UL << 49);
const RIGHT_AUDIT_CONTROL: CapRights = CapRights(1UL << 50);

// All rights
const ALL_RIGHTS: CapRights        = CapRights(0xFFFF_FFFF_FFFF_FFFF);

/// Rights mask for a given capability type tag.
pub fn default_rights_for_tag[tag: CapabilityTypeTag] -> CapRights : effect:(pure) {
  match tag {
    CapabilityTypeTag::MemoryRegion => RIGHT_READ | RIGHT_WRITE | RIGHT_DELETE,
    CapabilityTypeTag::MemoryMap => RIGHT_READ | RIGHT_WRITE | RIGHT_MEM_MAP | RIGHT_MEM_UNMAP | RIGHT_MEM_PROTECT,
    CapabilityTypeTag::SharedMemory => RIGHT_READ | RIGHT_WRITE | RIGHT_MEM_SHARE,
    CapabilityTypeTag::Thread => RIGHT_PROC_SCHED | RIGHT_PROC_DEBUG,
    CapabilityTypeTag::Process => RIGHT_PROC_CREATE | RIGHT_PROC_DESTROY | RIGHT_PROC_DEBUG,
    CapabilityTypeTag::Channel => RIGHT_IPC_SEND | RIGHT_IPC_RECV | RIGHT_DELETE,
    CapabilityTypeTag::CapabilitySlot => RIGHT_CAP_INSPECT | RIGHT_CAP_REDUCE | RIGHT_CAP_COPY | RIGHT_CAP_MOVE | RIGHT_CAP_DELETE,
    CapabilityTypeTag::VirtualMachine => RIGHT_HV_CREATE | RIGHT_HV_DESTROY | RIGHT_HV_RUN | RIGHT_HV_MEM | RIGHT_HV_IRQ,
    CapabilityTypeTag::VirtualCPU => RIGHT_HV_RUN | RIGHT_HV_IRQ,
    CapabilityTypeTag::AuditLog => RIGHT_AUDIT_READ,
    CapabilityTypeTag::AuditControl => RIGHT_AUDIT_READ | RIGHT_AUDIT_WRITE | RIGHT_AUDIT_CONTROL,
    _ => CapRights(0),  // No default rights for unknown types
  }
}

//==============================================================================
// Generation Tag Encoding
//==============================================================================

/// Generation tag — monotonic counter for capability versioning.
pub struct GenerationTag(
  /// Monotonic generation number.
  generation: u64,
  /// Epoch (system boot epoch).
  epoch: u64,
  /// Random salt for collision resistance.
  salt: u64,
  /// Thread-local generation counter component.
  thread_local: u64,
) : effect:(pure);

/// Create a new generation tag.
pub fn new_generation_tag[] -> GenerationTag : effect:(syscall, alloc) {
  return GenerationTag(
    generation: atomic_fetch_add(&__global_generation_counter, 1),
    epoch: read_system_epoch(),
    salt: generate_random_u64(),
    thread_local: get_thread_local_generation(),
  );
}

/// Encode a generation tag as a 64-bit value for wire format.
pub fn encode_generation_tag[
  tag: GenerationTag,
] -> u64 : effect:(pure) {
  // Pack: 32 bits generation + 16 bits epoch + 16 bits hash(salt, tls)
  let gen_part: u64 = tag.generation & 0xFFFF_FFFF;
  let epoch_part: u64 = (tag.epoch & 0xFFFF) << 32;
  let hash_part: u64 = (hash_combine(tag.salt, tag.thread_local) & 0xFFFF) << 48;
  return gen_part | epoch_part | hash_part;
}

/// Decode a generation tag from a 64-bit wire format value.
pub fn decode_generation_tag[
  encoded: u64,
] -> GenerationTag : effect:(pure) {
  return GenerationTag(
    generation: encoded & 0xFFFF_FFFF,
    epoch: (encoded >> 32) & 0xFFFF,
    salt: 0,
    thread_local: 0,
  );
}

/// Validate that a generation tag is still valid (not stale/revoked).
pub fn validate_generation_tag[
  tag: GenerationTag,
  revocation_set: *RevocationSet,
] -> bool : effect:(unsafe) {
  if tag.generation == 0 {
    return false;  // Zero is invalid
  }
  if tag.epoch != read_system_epoch() {
    return false;  // Stale epoch
  }
  if is_revoked(revocation_set, tag) {
    return false;  // Revoked
  }
  return true;
}

//==============================================================================
// Capability Encoding (Wire Format)
//==============================================================================

/// Wire-format capability encoding (64 bytes total per capability slot).
pub struct EncodedCapability(
  /// Pointer / object identifier.
  pointer: u64,
  /// Base address (for memory capabilities).
  base: u64,
  /// Length / size of the object.
  length: u64,
  /// Type tag (high 16 bits = category, low 16 bits = type).
  type_tag: u64,
  /// Rights bitfield.
  rights: u64,
  /// Generation tag (packed 64-bit).
  generation: u64,
  /// Offset (for sub-region capabilities).
  offset: u64,
  /// Flags (valid, sealed, delegated, revocable, affine).
  flags: u64,
) : effect:(pure);

/// Flags for capability encoding.
pub const CAP_FLAG_VALID: u64     = 1 << 0;
pub const CAP_FLAG_SEALED: u64    = 1 << 1;
pub const CAP_FLAG_DELEGATED: u64 = 1 << 2;
pub const CAP_FLAG_REVOCABLE: u64 = 1 << 3;
pub const CAP_FLAG_AFFINE: u64    = 1 << 4;
pub const CAP_FLAG_MOVED: u64     = 1 << 5;
pub const CAP_FLAG_DERIVED: u64   = 1 << 6;
pub const CAP_FLAG_SYSTEM: u64    = 1 << 7;

/// Encode a capability into wire format.
pub fn encode_capability[
  slot: CapabilitySlot,
  base: u64,
  length: u64,
  offset: u64,
] -> EncodedCapability : effect:(unsafe) {
  let gen: GenerationTag = decode_generation_tag(slot.generation);

  return EncodedCapability(
    pointer: slot.value,
    base: base,
    length: length,
    type_tag: slot.type_tag as u64,
    rights: slot.rights as u64,
    generation: slot.generation,
    offset: offset,
    flags: if slot.valid { CAP_FLAG_VALID } else { 0 },
  );
}

/// Decode a capability from wire format.
pub fn decode_capability[
  encoded: EncodedCapability,
  caller_token: u64,
] -> Result[CapabilitySlot, CapDecodeError] : effect:(unsafe) {
  if (encoded.flags & CAP_FLAG_VALID) == 0 {
    return Err(CapDecodeError::InvalidCapability);
  }

  if (encoded.flags & CAP_FLAG_SEALED) != 0 {
    return Err(CapDecodeError::CapabilitySealed);
  }

  let cap: CapabilitySlot = CapabilitySlot(
    type_tag: CapabilityType(encoded.type_tag),
    rights: CapabilityRights(encoded.rights),
    value: encoded.pointer,
    generation: encoded.generation,
    valid: true,
  );

  return Ok(cap);
}

pub enum CapDecodeError : u64 {
  InvalidCapability   = 1,
  CapabilitySealed    = 2,
  GenerationStale     = 3,
  RightsMismatch      = 4,
  TypeMismatch        = 5,
  Revoked             = 6,
  BadPointer          = 7,
}

//==============================================================================
// Capability Transfer in IPC
//==============================================================================

/// Capability transfer descriptor for IPC messages.
pub struct CapTransferDescriptor(
  /// Index in the message's capability array.
  cap_index: u32,
  /// How the capability is being transferred.
  transfer_mode: CapTransferMode,
  /// Destination rights (if delegating/restricting).
  dest_rights: CapRights,
  /// Whether to generate a revocation notification.
  track_revocation: bool,
  /// Destination capability slot (filled by receiver).
  dest_slot: u32,
  /// Generation tag at transfer time.
  transfer_generation: u64,
) : effect:(pure);

pub enum CapTransferMode : u8 {
  /// Full capability transfer (moves the capability).
  Move         = 0,
  /// Copy the capability (both sender and receiver have it).
  Copy         = 1,
  /// Delegate with restricted rights.
  Delegate     = 2,
  /// Grant temporarily (revocable).
  Grant        = 3,
  /// Forward through an intermediary.
  Forward      = 4,
  /// Return capability to sender.
  Return       = 5,
}

/// Transfer a capability in an IPC message.
pub fn transfer_cap_in_ipc[
  cap: CapabilitySlot,
  descriptor: CapTransferDescriptor,
  sender_token: u64,
  message_buffer: *u8,
  buffer_capacity: u32,
] -> Result[u32, CapTransferError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Validate sender has transfer rights
  let sender_rights: CapRights = CapRights(cap.rights);
  if (sender_rights & RIGHT_CAP_TRANSFER) == 0 {
    return Err(CapTransferError::NoTransferRights);
  }

  // Encode the capability for transfer
  let encoded: EncodedCapability = encode_capability(
    slot: cap,
    base: 0,
    length: 0,
    offset: 0,
  );

  // Apply delegation restriction if needed
  let final_encoded: EncodedCapability = match descriptor.transfer_mode {
    CapTransferMode::Delegate | CapTransferMode::Grant => {
      let reduced_rights: CapRights = intersect_rights(sender_rights, descriptor.dest_rights);
      EncodedCapability(
        pointer: encoded.pointer,
        base: encoded.base,
        length: encoded.length,
        type_tag: encoded.type_tag,
        rights: reduced_rights.bits,
        generation: encoded.generation,
        offset: encoded.offset,
        flags: encoded.flags | CAP_FLAG_DELEGATED,
      )
    },
    CapTransferMode::Move => {
      // Mark original as moved
      EncodedCapability(
        pointer: encoded.pointer,
        base: encoded.base,
        length: encoded.length,
        type_tag: encoded.type_tag,
        rights: encoded.rights,
        generation: encoded.generation,
        offset: encoded.offset,
        flags: encoded.flags | CAP_FLAG_MOVED,
      )
    },
    _ => encoded,
  };

  // Write to message buffer
  let encoded_size: u32 = 64;  // sizeof(EncodedCapability)
  if encoded_size > buffer_capacity {
    return Err(CapTransferError::BufferTooSmall);
  }

  @memcpy(message_buffer, &final_encoded, encoded_size as u64);

  // Record the transfer in audit log
  record_cap_transfer_audit(
    cap_type: CapabilityTypeTag(cap.type_tag),
    transfer_mode: descriptor.transfer_mode,
    rights: final_encoded.rights,
    generation: cap.generation,
  );

  // Record residual
  record_capability_residual(
    op_type: CapResidualOp::Transfer,
    cap_type: CapabilityTypeTag(cap.type_tag),
    generation: cap.generation,
  );

  return Ok(encoded_size);
}

/// Receive a capability from an IPC message.
pub fn receive_cap_from_ipc[
  message_buffer: *u8,
  offset: u32,
  receiver_token: u64,
  expected_type: Option[CapabilityTypeTag],
] -> Result[(CapabilitySlot, u32), CapTransferError] : (syscall, unsafe)
  loop: bounded(1)
{
  let encoded: *EncodedCapability = @int_to_ptr(message_buffer + offset);

  if (encoded.flags & CAP_FLAG_VALID) == 0 {
    return Err(CapTransferError::InvalidCapability);
  }

  if let Some(expected) = expected_type {
    let actual_type: CapabilityTypeTag = CapabilityTypeTag(encoded.type_tag);
    if actual_type != expected {
      return Err(CapTransferError::TypeMismatch);
    }
  }

  let slot: CapabilitySlot = CapabilitySlot(
    type_tag: CapabilityType(encoded.type_tag),
    rights: CapabilityRights(encoded.rights),
    value: encoded.pointer,
    generation: encoded.generation,
    valid: true,
  );

  return Ok((slot, 64));
}

pub enum CapTransferError : u64 {
  NoTransferRights   = 1,
  BufferTooSmall     = 2,
  InvalidCapability  = 3,
  TypeMismatch       = 4,
  Revoked            = 5,
  Sealed             = 6,
  NotDelegatable     = 7,
  AffineViolation    = 8,
}

//==============================================================================
// Delegation Encoding
//==============================================================================

/// Delegation record — describes a capability delegation.
pub struct DelegationRecord(
  /// Original capability generation.
  original_generation: u64,
  /// Delegated generation (new capability).
  delegated_generation: u64,
  /// Original rights.
  original_rights: CapRights,
  /// Delegated rights (subset of original).
  delegated_rights: CapRights,
  /// Type tag of the delegated capability.
  type_tag: CapabilityTypeTag,
  /// Delegatee identifier.
  delegatee_id: u64,
  /// Delegation depth (max nesting).
  depth: u32,
  /// Whether this delegation is revocable.
  revocable: bool,
  /// Expiration timestamp (0 = no expiry).
  expires_at: u64,
) : effect:(pure);

/// Delegate a capability to another subject.
pub fn delegate_capability[
  cap: CapabilitySlot,
  delegate_rights: CapRights,
  delegatee_id: u64,
  revocable: bool,
  depth: u32,
] -> Result[DelegationRecord, DelegationError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Validate source capability
  if !cap.valid {
    return Err(DelegationError::InvalidSource);
  }

  let source_rights: CapRights = CapRights(cap.rights);
  let source_type: CapabilityTypeTag = CapabilityTypeTag(cap.type_tag);

  // Validate rights to delegate
  if (source_rights & RIGHT_CAP_DERIVE) == 0 {
    return Err(DelegationError::NoDeriveRights);
  }

  // Ensure delegate rights are a subset
  let effective_rights: CapRights = intersect_rights(source_rights, delegate_rights);

  if effective_rights.bits == 0 {
    return Err(DelegationError::NoRightsToDelegate);
  }

  // Check delegation depth (max 8 levels)
  if depth > 8 {
    return Err(DelegationError::MaxDepthExceeded);
  }

  // Create delegation record
  let record: DelegationRecord = DelegationRecord(
    original_generation: cap.generation,
    delegated_generation: new_generation_tag().generation,
    original_rights: source_rights,
    delegated_rights: effective_rights,
    type_tag: source_type,
    delegatee_id: delegatee_id,
    depth: depth,
    revocable: revocable,
    expires_at: if revocable { read_timestamp() + 3600_000_000_000 } else { 0 },
  );

  // Record the delegation
  record_delegation_event(&record);

  return Ok(record);
}

pub enum DelegationError : u64 {
  InvalidSource         = 1,
  NoDeriveRights        = 2,
  NoRightsToDelegate    = 3,
  MaxDepthExceeded      = 4,
  TypeNotDelegatable    = 5,
  RevokedSource         = 6,
}

//==============================================================================
// Revocation Notification
//==============================================================================

/// Revocation notification sent to capability holders.
pub struct RevocationNotification(
  /// Generation tag of the revoked capability.
  revoked_generation: u64,
  /// Type of revocation.
  revocation_type: RevocationType,
  /// Identifier of the revoker.
  revoker_id: u64,
  /// Timestamp of revocation.
  timestamp: u64,
  /// Whether all derived capabilities are also revoked.
  revoke_derived: bool,
  /// Reason for revocation.
  reason: RevocationReason,
  /// Signature from the revoker's authority.
  authority_signature: u64,
) : effect:(pure);

pub enum RevocationType : u8 {
  /// Explicit revocation by the granter.
  Explicit        = 0,
  /// Automatic revocation (grant expired).
  Expired         = 1,
  /// Cascade revocation (parent revoked).
  Cascade         = 2,
  /// Security policy revocation.
  Policy          = 3,
  /// System-wide revocation (epoch change).
  SystemEpoch     = 4,
  /// Debugger-requested revocation.
  Debug           = 5,
}

pub enum RevocationReason : u64 {
  ManualRevocation     = 0,
  GrantExpired         = 1,
  ParentRevoked        = 2,
  SecurityViolation    = 3,
  ProcessTerminated    = 4,
  ResourceReclaimed    = 5,
  PolicyUpdated        = 6,
  DebuggerRequest      = 7,
  SystemShutdown       = 8,
  CapabilityLeak       = 9,
  AuditTrigger         = 10,
}

/// Revocation set — tracks revoked generations.
pub struct RevocationSet(
  revoked_generations: [u64; 1024],
  count: u32,
  epoch: u64,
) : effect:(alloc, unsafe);

/// Check if a generation tag has been revoked.
pub fn is_revoked[
  set: *RevocationSet,
  tag: GenerationTag,
] -> bool : effect:(unsafe)
  loop: bounded(1024)
{
  for var i: u32 = 0; i < set.count; i += 1 {
    if set.revoked_generations[i] == tag.generation {
      return true;
    }
  }
  return tag.epoch != set.epoch;
}

/// Issue a revocation notification for a capability.
pub fn issue_revocation[
  cap_generation: u64,
  revoker_cap: CapabilitySlot,
  revoke_type: RevocationType,
  reason: RevocationReason,
  revoke_derived: bool,
] -> Result[RevocationNotification, RevocationError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Validate revoker has authority
  let rights: CapRights = CapRights(revoker_cap.rights);
  if (rights & RIGHT_CAP_BURN) == 0 {
    return Err(RevocationError::NoRevokeAuthority);
  }

  let notification: RevocationNotification = RevocationNotification(
    revoked_generation: cap_generation,
    revocation_type: revoke_type,
    revoker_id: get_current_thread_id(),
    timestamp: read_timestamp(),
    revoke_derived: revoke_derived,
    reason: reason,
    authority_signature: compute_revocation_signature(cap_generation, revoker_cap),
  );

  // Deliver to affected subjects
  deliver_revocation_notification(&notification);

  // Record in audit log
  audit_revocation(&notification);

  return Ok(notification);
}

pub enum RevocationError : u64 {
  NoRevokeAuthority    = 1,
  AlreadyRevoked       = 2,
  NotificationFailed   = 3,
  InvalidGeneration    = 4,
}

//==============================================================================
// Capability Validation and Inspection
//==============================================================================

/// Result of a capability inspection.
pub struct CapInspectionResult(
  type_tag: CapabilityTypeTag,
  rights: CapRights,
  pointer: u64,
  base: u64,
  length: u64,
  offset: u64,
  generation: GenerationTag,
  is_sealed: bool,
  is_delegated: bool,
  is_revocable: bool,
  is_affine: bool,
  delegate_depth: u32,
  creation_time: u64,
  last_used: u64,
) : effect:(pure);

/// Inspect a capability (requires RIGHT_CAP_INSPECT).
pub fn inspect_capability[
  cap: CapabilitySlot,
  inspector_cap: CapabilitySlot,
] -> Result[CapInspectionResult, CapInspectError] : (syscall, unsafe)
  loop: bounded(1)
{
  let inspector_rights: CapRights = CapRights(inspector_cap.rights);
  if (inspector_rights & RIGHT_CAP_INSPECT) == 0 {
    return Err(CapInspectError::NoInspectRights);
  }

  if !cap.valid {
    return Err(CapInspectError::InvalidCapability);
  }

  return Ok(CapInspectionResult(
    type_tag: CapabilityTypeTag(cap.type_tag),
    rights: CapRights(cap.rights),
    pointer: cap.value,
    base: 0,
    length: 0,
    offset: 0,
    generation: decode_generation_tag(cap.generation),
    is_sealed: false,
    is_delegated: false,
    is_revocable: false,
    is_affine: false,
    delegate_depth: 0,
    creation_time: 0,
    last_used: read_timestamp(),
  ));
}

pub enum CapInspectError : u64 {
  NoInspectRights    = 1,
  InvalidCapability  = 2,
  CapabilitySealed   = 3,
}

//==============================================================================
// Capability Rights Operations
//==============================================================================

/// Intersect two rights masks.
pub fn intersect_rights[
  a: CapRights,
  b: CapRights,
] -> CapRights : effect:(pure) {
  return CapRights(a.bits & b.bits);
}

/// Union two rights masks.
pub fn union_rights[
  a: CapRights,
  b: CapRights,
] -> CapRights : effect:(pure) {
  return CapRights(a.bits | b.bits);
}

/// Check if rights include a specific set.
pub fn has_rights[
  rights: CapRights,
  required: CapRights,
] -> bool : effect:(pure) {
  return (rights.bits & required.bits) == required.bits;
}

/// Remove specific rights from a mask.
pub fn remove_rights[
  rights: CapRights,
  to_remove: CapRights,
] -> CapRights : effect:(pure) {
  return CapRights(rights.bits & !to_remove.bits);
}

/// Check whether a capability with given rights can perform an operation.
pub fn check_cap_rights[
  cap: CapabilitySlot,
  required: CapRights,
] -> Result[(), CapRightsError] : effect:(pure) {
  let rights: CapRights = CapRights(cap.rights);
  if (rights.bits & required.bits) != required.bits {
    return Err(CapRightsError::InsufficientRights);
  }
  if !cap.valid {
    return Err(CapRightsError::InvalidCapability);
  }
  return Ok(());
}

pub enum CapRightsError : u64 {
  InsufficientRights = 1,
  InvalidCapability  = 2,
  Revoked            = 3,
}

//==============================================================================
// Capability Derivation
//==============================================================================

/// Derive a sub-capability with reduced rights and/or sub-range.
pub fn derive_capability[
  source: CapabilitySlot,
  new_rights: CapRights,
  new_offset: u64,
  new_length: u64,
  deriver_cap: CapabilitySlot,
] -> Result[CapabilitySlot, DeriveError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Validate deriver has derive rights
  let deriver_rights: CapRights = CapRights(deriver_cap.rights);
  if (deriver_rights & RIGHT_CAP_DERIVE) == 0 {
    return Err(DeriveError::NoDeriveRights);
  }

  // Validate source is valid
  if !source.valid {
    return Err(DeriveError::InvalidSource);
  }

  // New rights must be subset of source rights
  let source_rights: CapRights = CapRights(source.rights);
  let effective_rights: CapRights = intersect_rights(source_rights, new_rights);

  // New range must be within source range
  // (simplified — real implementation checks base/length)

  let derived: CapabilitySlot = CapabilitySlot(
    type_tag: source.type_tag,
    rights: effective_rights as u64,
    value: source.value + new_offset,
    generation: new_generation_tag().generation,
    valid: true,
  );

  record_capability_residual(
    op_type: CapResidualOp::Derive,
    cap_type: CapabilityTypeTag(source.type_tag),
    generation: derived.generation,
  );

  return Ok(derived);
}

pub enum DeriveError : u64 {
  NoDeriveRights    = 1,
  InvalidSource     = 2,
  RightsNotSubset   = 3,
  RangeOutOfBounds  = 4,
  NotDerivable      = 5,
}

//==============================================================================
// Capability Comparison
//==============================================================================

/// Compare two capabilities for equality (structural).
pub fn cap_equals[
  a: CapabilitySlot,
  b: CapabilitySlot,
] -> bool : effect:(pure) {
  return a.type_tag == b.type_tag
      && a.rights == b.rights
      && a.value == b.value
      && a.generation == b.generation
      && a.valid == b.valid;
}

/// Compare two capabilities for ordering (by value, for sorted structures).
pub fn cap_compare[
  a: CapabilitySlot,
  b: CapabilitySlot,
] -> Ordering : effect:(pure) {
  if a.value < b.value { return Ordering::Less; }
  if a.value > b.value { return Ordering::Greater; }
  if a.generation < b.generation { return Ordering::Less; }
  if a.generation > b.generation { return Ordering::Greater; }
  return Ordering::Equal;
}

pub enum Ordering : u8 {
  Less    = 0,
  Equal   = 1,
  Greater = 2,
}

//==============================================================================
// Capability Pool / Store
//==============================================================================

/// A fixed-capacity capability store.
pub struct CapabilityStore[
  cap: typevar,
  N: u32,
](
  slots: [CapabilitySlot; N],
  generation_tags: [u64; N],
  valid_mask: [u64; 1 + (N - 1) / 64],
  count: u32,
  capacity: u32,
  next_generation: u64,
) : effect:(alloc, unsafe);

const CAP_STORE_MAX_CAPACITY: u32 = 1024;

/// Allocate a new slot in the capability store.
pub fn cap_store_allocate[
  store: *CapabilityStore,
  cap: CapabilitySlot,
] -> Result[u32, CapStoreError] : effect:(alloc, unsafe)
  loop: bounded(1024)
{
  if store.count >= store.capacity {
    return Err(CapStoreError::StoreFull);
  }

  // Find a free slot
  for var i: u32 = 0; i < store.capacity; i += 1 {
    let word_idx: u32 = i / 64;
    let bit_idx: u32 = i % 64;
    if (store.valid_mask[word_idx] & (1 << bit_idx)) == 0 {
      // Slot is free — occupy it
      store.slots[i] = cap;
      store.generation_tags[i] = store.next_generation;
      store.next_generation += 1;
      store.valid_mask[word_idx] |= 1 << bit_idx;
      store.count += 1;

      record_capability_residual(
        op_type: CapResidualOp::Allocate,
        cap_type: CapabilityTypeTag(cap.type_tag),
        generation: store.generation_tags[i],
      );

      return Ok(i);
    }
  }

  return Err(CapStoreError::StoreFull);
}

/// Release a slot in the capability store.
pub fn cap_store_release[
  store: *CapabilityStore,
  index: u32,
] -> Result[(), CapStoreError] : effect:(unsafe)
  loop: bounded(1)
{
  if index >= store.capacity {
    return Err(CapStoreError::InvalidIndex);
  }

  let word_idx: u32 = index / 64;
  let bit_idx: u32 = index % 64;

  if (store.valid_mask[word_idx] & (1 << bit_idx)) == 0 {
    return Err(CapStoreError::SlotAlreadyFree);
  }

  let cap: CapabilitySlot = store.slots[index];

  // If affine, ensure it was consumed
  if (cap.rights & CAP_FLAG_AFFINE) != 0 {
    // In production, check affine consumption.
  }

  store.valid_mask[word_idx] &= !(1 << bit_idx);
  store.count -= 1;

  record_capability_residual(
    op_type: CapResidualOp::Release,
    cap_type: CapabilityTypeTag(cap.type_tag),
    generation: store.generation_tags[index],
  );

  return Ok(());
}

/// Lookup a capability slot by index.
pub fn cap_store_get[
  store: *CapabilityStore,
  index: u32,
] -> Option[CapabilitySlot] : effect:(unsafe)
  loop: bounded(1)
{
  if index >= store.capacity {
    return None;
  }

  let word_idx: u32 = index / 64;
  let bit_idx: u32 = index % 64;

  if (store.valid_mask[word_idx] & (1 << bit_idx)) == 0 {
    return None;
  }

  return Some(store.slots[index]);
}

pub enum CapStoreError : u64 {
  StoreFull       = 1,
  InvalidIndex    = 2,
  SlotAlreadyFree = 3,
  AffineNotConsumed = 4,
}

//==============================================================================
// Audit and Residual Recording for Capability Operations
//==============================================================================

/// Types of capability residual operations.
pub enum CapResidualOp : u8 {
  Allocate       = 0,
  Release        = 1,
  Transfer       = 2,
  Derive         = 3,
  Delegate       = 4,
  Revoke         = 5,
  Copy           = 6,
  Move           = 7,
  Seal           = 8,
  Unseal         = 9,
  Mint           = 10,
  Burn           = 11,
  Inspect        = 12,
  Reduce         = 13,
  Validate       = 14,
}

/// Record a capability operation in the residual chain.
fn record_capability_residual[
  op_type: CapResidualOp,
  cap_type: CapabilityTypeTag,
  generation: u64,
] : effect:(unsafe) {
  // In production, writes to the thread's residual chain.
  __cap_residual_write(op_type, cap_type as u64, generation);
}

/// Record a capability transfer in the audit log.
fn record_cap_transfer_audit[
  cap_type: CapabilityTypeTag,
  transfer_mode: CapTransferMode,
  rights: u64,
  generation: u64,
] : effect:(audit, unsafe) {
  __cap_audit_write(cap_type as u64, transfer_mode as u64, rights, generation);
}

/// Record a delegation event.
fn record_delegation_event[
  record: *DelegationRecord,
] : effect:(syscall, unsafe) {
  __cap_delegation_write(record);
}

/// Deliver a revocation notification.
fn deliver_revocation_notification[
  notification: *RevocationNotification,
] : effect:(syscall, alloc) {
  __cap_revoke_deliver(notification);
}

/// Audit a revocation.
fn audit_revocation[
  notification: *RevocationNotification,
] : effect:(audit) {
  __audit_revoke_write(notification);
}

/// Compute a revocation signature.
fn compute_revocation_signature[
  generation: u64,
  revoker: CapabilitySlot,
] -> u64 : effect:(pure) {
  return generation ^ revoker.value;
}

//==============================================================================
// Forward Declarations / External Imports
//==============================================================================

pub type CapabilitySlot = core::capabilities::CapabilitySlot;
pub type CapabilityType(:u64);
pub type CapabilityRights(:u64);

fn read_system_epoch[] -> u64 : (syscall) { return 0; }
fn generate_random_u64[] -> u64 : (syscall) { return 42; }
fn get_thread_local_generation[] -> u64 : (syscall) { return 0; }
fn hash_combine[a: u64, b: u64] -> u64 : (pure) { return a ^ (b * 0x9E3779B97F4A7C15); }
fn atomic_fetch_add[ptr: *u64, val: u64] -> u64 : (unsafe) { let old: u64 = *ptr; *ptr = old + val; return old; }
fn read_timestamp[] -> u64 : (syscall) { return 0; }
fn get_current_thread_id[] -> u64 : (syscall) { return 0; }

fn __cap_residual_write[op: u8, ty: u64, gen: u64] : (unsafe) {}
fn __cap_audit_write[ty: u64, mode: u64, rights: u64, gen: u64] : (audit) {}
fn __cap_delegation_write[record: *DelegationRecord] : (syscall, unsafe) {}
fn __cap_revoke_deliver[notification: *RevocationNotification] : (syscall, alloc) {}
fn __audit_revoke_write[notification: *RevocationNotification] : (audit) {}

var __global_generation_counter: u64 = 1;

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_capability_tag_validation[] : effect:(pure) {
  assert(is_valid_capability_tag(0x0000_0001));  // MemoryRegion
  assert(is_valid_capability_tag(0x0005_0001));  // VirtualMachine
  assert(!is_valid_capability_tag(0x0000_0000));  // Invalid
  assert(!is_valid_capability_tag(0x0001_0000));  // Category only, no type
}

@Test
pub fn test_rights_intersection[] : effect:(pure) {
  let a: CapRights = RIGHT_READ | RIGHT_WRITE;
  let b: CapRights = RIGHT_READ | RIGHT_EXECUTE;
  let c: CapRights = intersect_rights(a, b);
  assert(c.bits == RIGHT_READ.bits);
}

@Test
pub fn test_generation_tag_roundtrip[] : effect:(syscall) {
  let tag: GenerationTag = new_generation_tag();
  let encoded: u64 = encode_generation_tag(tag);
  let decoded: GenerationTag = decode_generation_tag(encoded);
  assert(decoded.generation == tag.generation);
}

@Test
pub fn test_default_rights[] : effect:(pure) {
  let mem_rights: CapRights = default_rights_for_tag(CapabilityTypeTag::MemoryRegion);
  assert(has_rights(mem_rights, RIGHT_READ));
  assert(has_rights(mem_rights, RIGHT_WRITE));
  assert(has_rights(mem_rights, RIGHT_DELETE));

  let hv_rights: CapRights = default_rights_for_tag(CapabilityTypeTag::VirtualMachine);
  assert(has_rights(hv_rights, RIGHT_HV_CREATE));
  assert(has_rights(hv_rights, RIGHT_HV_RUN));
}
