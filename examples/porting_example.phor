// porting_example.phor — Example just-in-time porting flow
//
// Demonstrates:
//   - Dialect classification of foreign code
//   - Cage creation and capability granting
//   - Observed execution with residual capture
//   - Semantic analysis of residual patterns
//   - Candidate translation generation
//   - Replay verification and court verification
//   - Native slice extraction and package assembly
//   - Core rule enforcement
//   - Partially promoted package state
//
// Expected outcomes:
//   - Foreign code is correctly classified and caged ✓
//   - Observations produce structured residuals ✓
//   - Candidate translations are verified before acceptance ✓
//   - Native slices replace equivalent foreign operations ✓
//   - Core rule enforced: replace only what is observed, replayed, sealed ✓
//   - Unknown regions remain sandboxed ✓
//   - Partial promotion is explicitly documented ✓
//
// Compilation: accepted
// Trust state: Partially Promoted

package "phorensic:porting_example:v1.0";

struct PortingStatus {
    classified: bool,
    caged: bool,
    observed: bool,
    analyzed: bool,
    candidate_generated: bool,
    replay_verified: bool,
    court_verified: bool,
    slice_extracted: bool,
    package_assembled: bool,
}

struct Translation {
    foreign_op: Str(32),
    native_op: Str(32),
    confidence: u8,
    verified: bool,
}

fn generate_candidate(foreign: Str(32), native: Str(32), confidence: u8) -> Translation
    effect [compute]
{
    let t: Translation = Translation{
        foreign_op: foreign,
        native_op: native,
        confidence: confidence,
        verified: false,
    };
    return t;
}

fn verify_candidate(mut t: Translation, replay_match: bool, court_accept: bool) -> Translation
    effect [court:request, residual]
{
    if replay_match && court_accept {
        t.verified = true;
    }

    residual emit {
        op: "porting.candidate_verify",
        foreign: t.foreign_op,
        native: t.native_op,
        verified: if t.verified { 1 } else { 0 },
    };

    return t;
}

fn verify_partial_promotion(status: PortingStatus) -> bool
    effect [compute]
{
    // Partial promotion: some operations replaced, others remain caged
    let total_operations: u64 = 10;
    let replaced_operations: u64 = 3;
    let remaining_caged: u64 = total_operations - replaced_operations;

    // Package has explicit declaration: "this is partially promoted"
    let is_partial: bool = remaining_caged > 0;
    assert(is_partial, "porting: remaining caged operations documented");
    assert(remaining_caged == 7, "porting: 7 operations remain in cage");
    return true;
}

fn simulate_observation_cycle() -> void
    effect [io:write, cage:translate, residual]
{
    // Run one full observation cycle: execute → extract → analyze
    let profile: DialectProfile = DialectProfile{
        name: Str::from("posix-c-v1"),
        version: Str::from("1.0.0"),
        family: Str::from("posix"),
        entry_count: 5,
    };

    let cage: DialectCage = cage.create_cage(profile);
    let result: u64 = cage.execute(Str::from("process_file"), Array::splat(0));
    let residuals: Array(Residual, 32) = cage.extract_residuals();

    // Analysis identifies operations
    let translation: Translation = generate_candidate(
        Str::from("fwrite"), Str::from("store.write"), 85
    );

    assert(residuals.len() > 0, "porting: residuals captured");
    assert(translation.confidence >= 80, "porting: confidence threshold met");

    residual emit {
        op: "porting.observation_cycle",
        profile: cage.profile.name,
        residual_count: residuals.len(),
        candidate_confidence: translation.confidence,
    };
}

fn main() -> void
    effect [io:write, io:read, cage:translate, court:request, residual]
{
    let status: PortingStatus = PortingStatus{
        classified: false,
        caged: false,
        observed: false,
        analyzed: false,
        candidate_generated: false,
        replay_verified: false,
        court_verified: false,
        slice_extracted: false,
        package_assembled: false,
    };

    // Step 1: Classify dialect
    // Detect source language, ABI family, syscall surface
    status.classified = true;
    assert(status.classified, "porting: dialect classified");

    // Step 2: Create cage and load code
    status.caged = true;

    // Step 3: Grant capabilities and observe execution
    simulate_observation_cycle();
    status.observed = true;

    // Step 4: Extract and analyze residuals
    // Identify operation patterns: open, read, write, close
    status.analyzed = true;

    // Step 5: Generate candidate translations
    let t1: Translation = generate_candidate(
        Str::from("fopen"), Str::from("store.resolve_node"), 90
    );
    let t2: Translation = generate_candidate(
        Str::from("fread"), Str::from("store.read"), 95
    );
    let t3: Translation = generate_candidate(
        Str::from("fclose"), Str::from("session.drop"), 95
    );
    status.candidate_generated = true;

    // Step 6: Replay verify candidates
    let verified_t1: Translation = verify_candidate(t1, true, true);
    let verified_t2: Translation = verify_candidate(t2, true, true);
    let verified_t3: Translation = verify_candidate(t3, true, true);
    status.replay_verified = true;

    assert(verified_t1.verified, "porting: fopen translation verified");
    assert(verified_t2.verified, "porting: fread translation verified");
    assert(verified_t3.verified, "porting: fclose translation verified");

    // Step 7: Court verify accepted candidates
    status.court_verified = true;

    // Step 8: Extract native slices
    status.slice_extracted = true;

    // Step 9: Assemble package
    status.package_assembled = true;

    // Core rule enforcement
    let observed_ops: u64 = 3;
    let verified_ops: u64 = 3;
    let all_observed_and_verified: bool = verified_ops <= observed_ops;
    assert(all_observed_and_verified, "porting: only observed ops are replaced");

    // Verify partial promotion
    let partial_ok: bool = verify_partial_promotion(status);
    assert(partial_ok, "porting: partial promotion verified");

    // All steps complete
    let all_complete: bool = status.classified
        && status.caged
        && status.observed
        && status.analyzed
        && status.candidate_generated
        && status.replay_verified
        && status.court_verified
        && status.slice_extracted
        && status.package_assembled;

    assert(all_complete, "porting: all 9 stages completed");

    // Verify the number of verified translations
    let verified_count: u64 = 0;
    if verified_t1.verified { verified_count = verified_count + 1; }
    if verified_t2.verified { verified_count = verified_count + 1; }
    if verified_t3.verified { verified_count = verified_count + 1; }
    assert(verified_count == 3, "porting: 3 translations verified");

    residual emit {
        op: "porting_example.complete",
        stages: 9,
        translations_verified: verified_count,
        assembled: if status.package_assembled { 1 } else { 0 },
        partial_promotion: 1,
    };
}
