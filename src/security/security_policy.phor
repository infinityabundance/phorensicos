// security_policy.phor — Security Policy Framework
//
// Provides:
//   - Policy definitions (allow, deny, audit, conditional)
//   - Rule types (subject, object, action, environment)
//   - Policy enforcement points (PEP) and decision engine
//   - Policy composition (conflict resolution, priority ordering)
//   - Policy verification (consistency, completeness, reachability)
//   - Runtime policy reload with atomic swap
//   - Full residual recording for every policy decision
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every security decision produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:security_policy:v1.0";

// ──────────────────────────────────────────────
// Types & Constants
// ──────────────────────────────────────────────

const MAX_POLICY_RULES: u64 = 4096;
const MAX_POLICY_NAMESPACES: u64 = 64;
const MAX_SUBJECT_TYPES: u64 = 256;
const MAX_OBJECT_TYPES: u64 = 256;
const MAX_ACTION_TYPES: u64 = 128;
const MAX_ENV_CONDITIONS: u64 = 64;
const MAX_RULE_CHAIN_DEPTH: u64 = 32;
const MAX_POLICY_FILE_SIZE: u64 = 65536;
const MAX_COMPOSITION_DEPTH: u64 = 16;
const MAX_VERIFICATION_CHECKS: u64 = 512;
const MAX_POLICY_VERSIONS: u64 = 32;
const MAX_RELOAD_HISTORY: u64 = 64;
const MAX_CONFLICT_CANDIDATES: u64 = 256;
const MAX_CONDITION_PARAMS: u64 = 16;
const MAX_POLICY_LABELS: u64 = 128;
const MAX_EXCEPTION_PATTERNS: u64 = 64;
const MAX_AUDIT_RULES: u64 = 256;
const MAX_ENFORCEMENT_POINTS: u64 = 128;
const MAX_POLICY_PRIORITY_LEVELS: u64 = 16;

type PolicyVersion = u64;
type RuleId = u64;
type PolicyNamespaceId = u64;
type SubjectId = u64;
type ObjectId = u64;
type ActionId = u64;
type PriorityLevel = u8;

// ──────────────────────────────────────────────
// Policy Effect Enum
// ──────────────────────────────────────────────

effect policy:load;
effect policy:evaluate;
effect policy:compose;
effect policy:verify;
effect policy:reload;
effect policy:audit;

// ──────────────────────────────────────────────
// Core Policy Types
// ──────────────────────────────────────────────

enum PolicyDecision {
    Allow,
    Deny,
    Audit,
    Conditional,
    Indeterminate,
    NotApplicable,
}

enum RuleEffect {
    Permit,
    Deny,
    AuditOnly,
    LogAndPermit,
    LogAndDeny,
}

enum SubjectCategory {
    User,
    Role,
    Group,
    Process,
    Service,
    Machine,
    Domain,
    TrustLevel,
}

enum ObjectCategory {
    File,
    Directory,
    Device,
    Network,
    Memory,
    IPC,
    Capability,
    Resource,
    Service,
    Database,
}

enum ActionCategory {
    Read,
    Write,
    Execute,
    Create,
    Delete,
    Modify,
    Admin,
    Audit,
    Access,
    Control,
    Spawn,
    Communicate,
}

enum EnvironmentConditionType {
    TimeRange,
    Location,
    NetworkZone,
    AuthenticationLevel,
    SessionState,
    TrustLevel,
    RiskScore,
    ComplianceMode,
}

enum PolicyCompositionStrategy {
    FirstApplicable,
    DenyOverrides,
    AllowOverrides,
    OnlyOneApplicable,
    OrderedPermitOverrides,
    OrderedDenyOverrides,
    LatticeBased,
}

enum PolicyVerifyStatus {
    Consistent,
    HasConflicts,
    Incomplete,
    UnreachableRules,
    RedundantRules,
    CircularDependency,
    VerificationFailed,
}

enum PolicyLoadState {
    NotLoaded,
    Loading,
    Active,
    Failed,
    RolledBack,
    Superseded,
}

enum ReloadStrategy {
    AtomicSwap,
    GradualRollout,
    StagedActivation,
    ShadowMode,
}

// ──────────────────────────────────────────────
// Policy Data Structures
// ──────────────────────────────────────────────

struct EnvironmentCondition {
    condition_type: EnvironmentConditionType,
    param_count: u64,
    params: Array(u64, MAX_CONDITION_PARAMS),
    negated: bool,
}

struct PolicyRule {
    rule_id: RuleId,
    namespace_id: PolicyNamespaceId,
    priority: PriorityLevel,
    subject_type: SubjectCategory,
    subject_pattern: u64,
    object_type: ObjectCategory,
    object_pattern: u64,
    action_type: ActionCategory,
    action_pattern: u64,
    effect: RuleEffect,
    conditional: bool,
    condition_count: u64,
    conditions: Array(EnvironmentCondition, MAX_ENV_CONDITIONS),
    audit_required: bool,
    log_level: u8,
    label: u64,
    version_added: PolicyVersion,
    version_removed: PolicyVersion,
    enabled: bool,
}

struct PolicyNamespace {
    namespace_id: PolicyNamespaceId,
    name: Str(64),
    version: PolicyVersion,
    description: Str(256),
    rule_count: u64,
    rules: Array(PolicyRule, MAX_POLICY_RULES),
    parent_namespace: PolicyNamespaceId,
    priority_base: PriorityLevel,
    load_state: PolicyLoadState,
    enabled: bool,
}

struct PolicyConflict {
    rule_a_id: RuleId,
    rule_b_id: RuleId,
    namespace_a: PolicyNamespaceId,
    namespace_b: PolicyNamespaceId,
    conflict_type: u8,
    resolution_strategy: PolicyCompositionStrategy,
    resolved_decision: PolicyDecision,
    resolved_effect: RuleEffect,
}

struct AuditRule {
    rule_id: RuleId,
    trigger_effect: RuleEffect,
    subject_pattern: u64,
    object_pattern: u64,
    action_pattern: u64,
    sample_rate: u64,
    detail_level: u8,
    include_decision: bool,
    include_context: bool,
    include_residuals: bool,
}

struct EnforcementPoint {
    point_id: u64,
    name: Str(64),
    namespace_id: PolicyNamespaceId,
    enabled: bool,
    decision_cache_enabled: bool,
    cache_size: u64,
    audit_enabled: bool,
    failure_mode: u8,
    residual_required: bool,
}

struct PolicyVerificationResult {
    status: PolicyVerifyStatus,
    conflict_count: u64,
    conflicts: Array(PolicyConflict, MAX_CONFLICT_CANDIDATES),
    unreachable_rule_ids: Array(RuleId, MAX_POLICY_RULES),
    unreachable_count: u64,
    redundant_rule_ids: Array(RuleId, MAX_POLICY_RULES),
    redundant_count: u64,
    completeness_score: u64,
    coverage_percent: u64,
    circular_dependency_found: bool,
    verification_time_ms: u64,
}

struct ReloadRecord {
    version: PolicyVersion,
    previous_version: PolicyVersion,
    timestamp: u64,
    strategy: ReloadStrategy,
    success: bool,
    rule_count_before: u64,
    rule_count_after: u64,
    namespace_count_before: u64,
    namespace_count_after: u64,
    reason: Str(256),
}

struct PolicyDecisionRecord {
    decision_id: u64,
    rule_id: RuleId,
    namespace_id: PolicyNamespaceId,
    subject_id: SubjectId,
    object_id: ObjectId,
    action_id: ActionId,
    decision: PolicyDecision,
    effect_applied: RuleEffect,
    matched_rule: bool,
    conditional_eval: bool,
    condition_results: u64,
    enforcement_point_id: u64,
    timestamp: u64,
    audit_emitted: bool,
    residual_emitted: bool,
}

struct PolicySet {
    namespace_count: u64,
    namespaces: Array(PolicyNamespace, MAX_POLICY_NAMESPACES),
    active_rule_count: u64,
    total_rule_capacity: u64,
    composition_strategy: PolicyCompositionStrategy,
    default_decision: PolicyDecision,
    audit_rule_count: u64,
    audit_rules: Array(AuditRule, MAX_AUDIT_RULES),
    enforcement_point_count: u64,
    enforcement_points: Array(EnforcementPoint, MAX_ENFORCEMENT_POINTS),
    version: PolicyVersion,
    load_state: PolicyLoadState,
    reload_history_count: u64,
    reload_history: Array(ReloadRecord, MAX_RELOAD_HISTORY),
}

// ──────────────────────────────────────────────
// Policy Evaluation Helpers
// ──────────────────────────────────────────────

fn policy_decision_to_u8(d: PolicyDecision) -> u8
    effect [compute]
{
    let result: u8 = match d {
        PolicyDecision::Allow => 0,
        PolicyDecision::Deny => 1,
        PolicyDecision::Audit => 2,
        PolicyDecision::Conditional => 3,
        PolicyDecision::Indeterminate => 4,
        PolicyDecision::NotApplicable => 5,
    };
    return result;
}

fn u8_to_policy_decision(val: u8) -> PolicyDecision
    effect [compute]
{
    let result: PolicyDecision = match val {
        0 => PolicyDecision::Allow,
        1 => PolicyDecision::Deny,
        2 => PolicyDecision::Audit,
        3 => PolicyDecision::Conditional,
        4 => PolicyDecision::Indeterminate,
        _ => PolicyDecision::NotApplicable,
    };
    return result;
}

fn rule_effect_to_decision(e: RuleEffect) -> PolicyDecision
    effect [compute]
{
    let result: PolicyDecision = match e {
        RuleEffect::Permit => PolicyDecision::Allow,
        RuleEffect::Deny => PolicyDecision::Deny,
        RuleEffect::AuditOnly => PolicyDecision::Audit,
        RuleEffect::LogAndPermit => PolicyDecision::Allow,
        RuleEffect::LogAndDeny => PolicyDecision::Deny,
    };
    return result;
}

fn match_subject_pattern(rule_subject: SubjectCategory, rule_pattern: u64, subject_id: SubjectId) -> bool
    effect [compute]
{
    if rule_pattern == 0xFFFFFFFFFFFFFFFF {
        return true;
    }
    if rule_pattern == subject_id {
        return true;
    }
    if rule_pattern & subject_id != 0 {
        return true;
    }
    return false;
}

fn match_object_pattern(rule_object: ObjectCategory, rule_pattern: u64, object_id: ObjectId) -> bool
    effect [compute]
{
    if rule_pattern == 0xFFFFFFFFFFFFFFFF {
        return true;
    }
    if rule_pattern == object_id {
        return true;
    }
    if rule_pattern & object_id != 0 {
        return true;
    }
    return false;
}

fn match_action_pattern(rule_action: ActionCategory, rule_pattern: u64, action_id: ActionId) -> bool
    effect [compute]
{
    if rule_pattern == 0xFFFFFFFFFFFFFFFF {
        return true;
    }
    if rule_pattern == action_id {
        return true;
    }
    if rule_pattern & action_id != 0 {
        return true;
    }
    return false;
}

fn evaluate_environment_conditions(conditions: Array(EnvironmentCondition, MAX_ENV_CONDITIONS), count: u64, context: u64) -> bool
    effect [compute]
{
    let mut all_match: bool = true;
    let mut i: u64 = 0;
    while i < count && i < MAX_ENV_CONDITIONS proven {
        let cond: EnvironmentCondition = conditions[i];
        let mut cond_match: bool = false;
        let mut j: u64 = 0;
        while j < cond.param_count && j < MAX_CONDITION_PARAMS proven {
            if cond.params[j] == context {
                cond_match = true;
            }
            j = j + 1;
        }
        if cond.negated {
            cond_match = !cond_match;
        }
        if !cond_match {
            all_match = false;
        }
        i = i + 1;
    }
    return all_match;
}

fn rule_is_active(rule: PolicyRule, current_version: PolicyVersion) -> bool
    effect [compute]
{
    if !rule.enabled {
        return false;
    }
    if current_version < rule.version_added {
        return false;
    }
    if rule.version_removed != 0 && current_version >= rule.version_removed {
        return false;
    }
    return true;
}

// ──────────────────────────────────────────────
// Policy Evaluation Engine
// ──────────────────────────────────────────────

fn evaluate_policy_rules(
    set: PolicySet,
    subject_type: SubjectCategory,
    subject_id: SubjectId,
    object_type: ObjectCategory,
    object_id: ObjectId,
    action_type: ActionCategory,
    action_id: ActionId,
    env_context: u64,
) -> PolicyDecisionRecord
    effect [policy:evaluate, compute, residual]
{
    let decision: PolicyDecision = set.default_decision;
    let mut matched_rule_id: RuleId = 0;
    let mut matched_namespace_id: PolicyNamespaceId = 0;
    let mut matched_effect: RuleEffect = RuleEffect::AuditOnly;
    let mut rule_matched: bool = false;
    let mut audit_needed: bool = false;

    for n_idx in 0..set.namespace_count {
        let ns: PolicyNamespace = set.namespaces[n_idx];
        if !ns.enabled {
            continue;
        }
        for r_idx in 0..ns.rule_count {
            let rule: PolicyRule = ns.rules[r_idx];
            if !rule_is_active(rule, set.version) {
                continue;
            }
            if rule.subject_type != subject_type && rule.subject_type != SubjectCategory::User {
                continue;
            }
            if !match_subject_pattern(rule.subject_type, rule.subject_pattern, subject_id) {
                continue;
            }
            if rule.object_type != object_type && rule.object_type != ObjectCategory::File {
                continue;
            }
            if !match_object_pattern(rule.object_type, rule.object_pattern, object_id) {
                continue;
            }
            if rule.action_type != action_type && rule.action_type != ActionCategory::Access {
                continue;
            }
            if !match_action_pattern(rule.action_type, rule.action_pattern, action_id) {
                continue;
            }
            let cond_match: bool = if rule.conditional {
                evaluate_environment_conditions(rule.conditions, rule.condition_count, env_context)
            } else {
                true
            };
            if cond_match {
                matched_rule_id = rule.rule_id;
                matched_namespace_id = rule.namespace_id;
                matched_effect = rule.effect;
                rule_matched = true;
                audit_needed = rule.audit_required;
                decision = rule_effect_to_decision(rule.effect);
                break;
            }
        }
        if rule_matched {
            break;
        }
    }

    let decision_id: u64 = set.version * 1000000 + matched_rule_id;

    residual emit {
        op: "policy.evaluate",
        decision_id: decision_id,
        subject: subject_id,
        object: object_id,
        action: action_id,
        decision: policy_decision_to_u8(decision),
        rule_matched: if rule_matched { 1 } else { 0 },
        matched_rule: matched_rule_id,
        timestamp: 0,
    };

    return PolicyDecisionRecord{
        decision_id: decision_id,
        rule_id: matched_rule_id,
        namespace_id: matched_namespace_id,
        subject_id: subject_id,
        object_id: object_id,
        action_id: action_id,
        decision: decision,
        effect_applied: matched_effect,
        matched_rule: rule_matched,
        conditional_eval: false,
        condition_results: 0,
        enforcement_point_id: 0,
        timestamp: 0,
        audit_emitted: audit_needed,
        residual_emitted: true,
    };
}

fn evaluate_audit_rules(
    set: PolicySet,
    decision: PolicyDecision,
    subject_id: SubjectId,
    object_id: ObjectId,
    action_id: ActionId,
) -> bool
    effect [policy:evaluate, compute]
{
    let mut should_audit: bool = false;
    for i in 0..set.audit_rule_count {
        let ar: AuditRule = set.audit_rules[i];
        let rule_decision: PolicyDecision = rule_effect_to_decision(ar.trigger_effect);
        if rule_decision != decision {
            continue;
        }
        if ar.subject_pattern != 0 && ar.subject_pattern != subject_id {
            continue;
        }
        if ar.object_pattern != 0 && ar.object_pattern != object_id {
            continue;
        }
        if ar.action_pattern != 0 && ar.action_pattern != action_id {
            continue;
        }
        should_audit = true;
        break;
    }
    return should_audit;
}

// ──────────────────────────────────────────────
// Policy Composition
// ──────────────────────────────────────────────

fn compose_policy_decisions(
    a: PolicyDecision,
    b: PolicyDecision,
    strategy: PolicyCompositionStrategy,
) -> PolicyDecision
    effect [policy:compose, compute]
{
    let result: PolicyDecision = match strategy {
        PolicyCompositionStrategy::FirstApplicable => {
            match a {
                PolicyDecision::NotApplicable => b,
                _ => a,
            }
        },
        PolicyCompositionStrategy::DenyOverrides => {
            if a == PolicyDecision::Deny || b == PolicyDecision::Deny {
                PolicyDecision::Deny
            } else {
                match a {
                    PolicyDecision::NotApplicable => b,
                    _ => a,
                }
            }
        },
        PolicyCompositionStrategy::AllowOverrides => {
            if a == PolicyDecision::Allow || b == PolicyDecision::Allow {
                PolicyDecision::Allow
            } else {
                match a {
                    PolicyDecision::NotApplicable => b,
                    _ => a,
                }
            }
        },
        PolicyCompositionStrategy::OnlyOneApplicable => {
            if a != PolicyDecision::NotApplicable && b != PolicyDecision::NotApplicable {
                PolicyDecision::Indeterminate
            } else {
                match a {
                    PolicyDecision::NotApplicable => b,
                    _ => a,
                }
            }
        },
        PolicyCompositionStrategy::LatticeBased => {
            if a == PolicyDecision::Deny || b == PolicyDecision::Deny {
                PolicyDecision::Deny
            } else if a == PolicyDecision::Allow && b == PolicyDecision::Allow {
                PolicyDecision::Allow
            } else {
                PolicyDecision::Audit
            }
        },
        _ => PolicyDecision::Indeterminate,
    };
    return result;
}

fn compose_namespace_policies(
    set: PolicySet,
    subject_type: SubjectCategory,
    subject_id: SubjectId,
    object_type: ObjectCategory,
    object_id: ObjectId,
    action_type: ActionCategory,
    action_id: ActionId,
    env_context: u64,
) -> PolicyDecisionRecord
    effect [policy:compose, policy:evaluate, compute, residual]
{
    let mut composite_decision: PolicyDecision = PolicyDecision::NotApplicable;
    let mut matched_rule_id: RuleId = 0;
    let mut matched_ns_id: PolicyNamespaceId = 0;
    let mut matched_effect: RuleEffect = RuleEffect::AuditOnly;

    for n_idx in 0..set.namespace_count {
        let ns: PolicyNamespace = set.namespaces[n_idx];
        if !ns.enabled {
            continue;
        }
        let ns_result: PolicyDecisionRecord = evaluate_policy_rules(
            set, subject_type, subject_id,
            object_type, object_id,
            action_type, action_id,
            env_context,
        );
        composite_decision = compose_policy_decisions(
            composite_decision,
            ns_result.decision,
            set.composition_strategy,
        );
        if ns_result.matched_rule {
            matched_rule_id = ns_result.rule_id;
            matched_ns_id = ns_result.namespace_id;
            matched_effect = ns_result.effect_applied;
        }
    }

    if composite_decision == PolicyDecision::NotApplicable {
        composite_decision = set.default_decision;
    }

    let decision_id: u64 = set.version * 1000000 + matched_rule_id;

    residual emit {
        op: "policy.compose",
        decision_id: decision_id,
        strategy: set.composition_strategy as u8,
        composite_decision: policy_decision_to_u8(composite_decision),
        namespace_count: set.namespace_count,
        matched_rule: matched_rule_id,
    };

    return PolicyDecisionRecord{
        decision_id: decision_id,
        rule_id: matched_rule_id,
        namespace_id: matched_ns_id,
        subject_id: subject_id,
        object_id: object_id,
        action_id: action_id,
        decision: composite_decision,
        effect_applied: matched_effect,
        matched_rule: matched_rule_id != 0,
        conditional_eval: false,
        condition_results: 0,
        enforcement_point_id: 0,
        timestamp: 0,
        audit_emitted: true,
        residual_emitted: true,
    };
}

// ──────────────────────────────────────────────
// Policy Enforcement Point Logic
// ──────────────────────────────────────────────

fn enforce_decision(
    decision: PolicyDecision,
    point: EnforcementPoint,
) -> bool
    effect [policy:evaluate, compute]
{
    let mut allow_access: bool = false;
    match decision {
        PolicyDecision::Allow => {
            allow_access = true;
        },
        PolicyDecision::Deny => {
            allow_access = false;
        },
        PolicyDecision::Audit => {
            allow_access = true;
        },
        PolicyDecision::Conditional => {
            allow_access = true;
        },
        PolicyDecision::Indeterminate => {
            allow_access = point.failure_mode == 0;
        },
        PolicyDecision::NotApplicable => {
            allow_access = point.failure_mode == 0;
        },
    };
    return allow_access;
}

fn check_enforcement_point_enabled(
    point_id: u64,
    set: PolicySet,
) -> bool
    effect [policy:evaluate, compute]
{
    let mut enabled: bool = false;
    for i in 0..set.enforcement_point_count {
        let ep: EnforcementPoint = set.enforcement_points[i];
        if ep.point_id == point_id {
            enabled = ep.enabled;
            break;
        }
    }
    return enabled;
}

fn enforcement_decision(
    set: PolicySet,
    point: EnforcementPoint,
    subject_type: SubjectCategory,
    subject_id: SubjectId,
    object_type: ObjectCategory,
    object_id: ObjectId,
    action_type: ActionCategory,
    action_id: ActionId,
    env_context: u64,
) -> (bool, PolicyDecisionRecord)
    effect [policy:evaluate, policy:compose, compute, residual]
{
    let record: PolicyDecisionRecord = compose_namespace_policies(
        set, subject_type, subject_id,
        object_type, object_id,
        action_type, action_id,
        env_context,
    );

    let allowed: bool = enforce_decision(record.decision, point);
    let audit_needed: bool = evaluate_audit_rules(
        set, record.decision,
        subject_id, object_id, action_id,
    );

    residual emit {
        op: "policy.enforce",
        point_id: point.point_id,
        allowed: if allowed { 1 } else { 0 },
        decision: policy_decision_to_u8(record.decision),
        subject: subject_id,
        object: object_id,
        action: action_id,
        audit: if audit_needed { 1 } else { 0 },
    };

    return (allowed, record);
}

// ──────────────────────────────────────────────
// Policy Verification
// ──────────────────────────────────────────────

fn find_policy_conflicts(set: PolicySet) -> Array(PolicyConflict, MAX_CONFLICT_CANDIDATES)
    effect [policy:verify, compute]
{
    let mut conflicts: Array(PolicyConflict, MAX_CONFLICT_CANDIDATES) = Array::zeroed();
    let mut conflict_count: u64 = 0;

    for n1_idx in 0..set.namespace_count {
        let ns1: PolicyNamespace = set.namespaces[n1_idx];
        if !ns1.enabled {
            continue;
        }
        for r1_idx in 0..ns1.rule_count {
            let rule1: PolicyRule = ns1.rules[r1_idx];
            if !rule1.enabled {
                continue;
            }
            for n2_idx in 0..set.namespace_count {
                if n2_idx == n1_idx {
                    continue;
                }
                let ns2: PolicyNamespace = set.namespaces[n2_idx];
                if !ns2.enabled {
                    continue;
                }
                for r2_idx in 0..ns2.rule_count {
                    let rule2: PolicyRule = ns2.rules[r2_idx];
                    if !rule2.enabled {
                        continue;
                    }
                    let same_subject: bool = rule1.subject_type == rule2.subject_type;
                    let same_object: bool = rule1.object_type == rule2.object_type;
                    let same_action: bool = rule1.action_type == rule2.action_type;
                    let different_effect: bool = rule1.effect != rule2.effect;

                    if same_subject && same_object && same_action && different_effect {
                        if conflict_count < MAX_CONFLICT_CANDIDATES {
                            let conflict: PolicyConflict = PolicyConflict{
                                rule_a_id: rule1.rule_id,
                                rule_b_id: rule2.rule_id,
                                namespace_a: ns1.namespace_id,
                                namespace_b: ns2.namespace_id,
                                conflict_type: 1,
                                resolution_strategy: set.composition_strategy,
                                resolved_decision: PolicyDecision::Indeterminate,
                                resolved_effect: RuleEffect::Deny,
                            };
                            conflicts[conflict_count] = conflict;
                            conflict_count = conflict_count + 1;
                        }
                    }
                }
            }
        }
    }
    return conflicts;
}

fn find_unreachable_rules(set: PolicySet) -> (Array(RuleId, MAX_POLICY_RULES), u64)
    effect [policy:verify, compute]
{
    let mut unreachable: Array(RuleId, MAX_POLICY_RULES) = Array::splat(0);
    let mut count: u64 = 0;

    for n_idx in 0..set.namespace_count {
        let ns: PolicyNamespace = set.namespaces[n_idx];
        for r_idx in 0..ns.rule_count {
            let rule: PolicyRule = ns.rules[r_idx];
            let is_covered: bool = rule.version_added > 0;
            if !is_covered {
                if count < MAX_POLICY_RULES {
                    unreachable[count] = rule.rule_id;
                    count = count + 1;
                }
            }
        }
    }
    return (unreachable, count);
}

fn find_redundant_rules(set: PolicySet) -> (Array(RuleId, MAX_POLICY_RULES), u64)
    effect [policy:verify, compute]
{
    let mut redundant: Array(RuleId, MAX_POLICY_RULES) = Array::splat(0);
    let mut count: u64 = 0;

    for n_idx in 0..set.namespace_count {
        let ns: PolicyNamespace = set.namespaces[n_idx];
        for r1_idx in 0..ns.rule_count {
            let r1: PolicyRule = ns.rules[r1_idx];
            for r2_idx in 0..ns.rule_count {
                if r1_idx == r2_idx {
                    continue;
                }
                let r2: PolicyRule = ns.rules[r2_idx];
                let same_subj: bool = r1.subject_type == r2.subject_type;
                let same_obj: bool = r1.object_type == r2.object_type;
                let same_act: bool = r1.action_type == r2.action_type;
                let same_eff: bool = r1.effect == r2.effect;
                let r2_higher_prio: bool = r2.priority > r1.priority;

                if same_subj && same_obj && same_act && same_eff && r2_higher_prio {
                    if count < MAX_POLICY_RULES {
                        redundant[count] = r1.rule_id;
                        count = count + 1;
                    }
                    break;
                }
            }
        }
    }
    return (redundant, count);
}

fn check_circular_policy_dependency(set: PolicySet) -> bool
    effect [policy:verify, compute]
{
    let mut visited: Array(u8, MAX_POLICY_NAMESPACES) = Array::splat(0);
    let mut in_stack: Array(u8, MAX_POLICY_NAMESPACES) = Array::splat(0);
    let mut circular: bool = false;

    for i in 0..set.namespace_count {
        if visited[i] == 0 {
            let ns: PolicyNamespace = set.namespaces[i];
            let parent: PolicyNamespaceId = ns.parent_namespace;
            if parent == ns.namespace_id {
                continue;
            }
            for j in 0..set.namespace_count {
                if set.namespaces[j].namespace_id == parent {
                    if in_stack[j] != 0 {
                        circular = true;
                    }
                    visited[j] = 1;
                    break;
                }
            }
            visited[i] = 1;
        }
    }
    return circular;
}

fn compute_coverage_score(set: PolicySet) -> u64
    effect [policy:verify, compute]
{
    let mut covered_subjects: Array(u8, MAX_SUBJECT_TYPES) = Array::splat(0);
    let mut covered_objects: Array(u8, MAX_OBJECT_TYPES) = Array::splat(0);
    let mut covered_actions: Array(u8, MAX_ACTION_TYPES) = Array::splat(0);
    let mut subject_count: u64 = 0;
    let mut object_count: u64 = 0;
    let mut action_count: u64 = 0;

    for n_idx in 0..set.namespace_count {
        let ns: PolicyNamespace = set.namespaces[n_idx];
        for r_idx in 0..ns.rule_count {
            let rule: PolicyRule = ns.rules[r_idx];
            if covered_subjects[rule.subject_type as u8] == 0 {
                covered_subjects[rule.subject_type as u8] = 1;
                subject_count = subject_count + 1;
            }
            if covered_objects[rule.object_type as u8] == 0 {
                covered_objects[rule.object_type as u8] = 1;
                object_count = object_count + 1;
            }
            if covered_actions[rule.action_type as u8] == 0 {
                covered_actions[rule.action_type as u8] = 1;
                action_count = action_count + 1;
            }
        }
    }

    let total_subject: u64 = 8;
    let total_object: u64 = 10;
    let total_action: u64 = 12;
    let s_score: u64 = subject_count * 100 / total_subject;
    let o_score: u64 = object_count * 100 / total_object;
    let a_score: u64 = action_count * 100 / total_action;
    let overall: u64 = (s_score + o_score + a_score) / 3;
    return overall;
}

fn verify_policy_set(set: PolicySet) -> PolicyVerificationResult
    effect [policy:verify, compute, residual]
{
    let conflicts: Array(PolicyConflict, MAX_CONFLICT_CANDIDATES) = find_policy_conflicts(set);
    let (unreachable, unreachable_count): (Array(RuleId, MAX_POLICY_RULES), u64) = find_unreachable_rules(set);
    let (redundant, redundant_count): (Array(RuleId, MAX_POLICY_RULES), u64) = find_redundant_rules(set);
    let circular: bool = check_circular_policy_dependency(set);
    let coverage: u64 = compute_coverage_score(set);

    let mut conflict_count: u64 = 0;
    for i in 0..MAX_CONFLICT_CANDIDATES {
        if conflicts[i].rule_a_id != 0 || conflicts[i].rule_b_id != 0 {
            conflict_count = i + 1;
        }
    }

    let status: PolicyVerifyStatus = if circular {
        PolicyVerifyStatus::CircularDependency
    } else if conflict_count > 0 {
        PolicyVerifyStatus::HasConflicts
    } else if unreachable_count > 0 {
        PolicyVerifyStatus::UnreachableRules
    } else if redundant_count > 0 {
        PolicyVerifyStatus::RedundantRules
    } else if coverage < 80 {
        PolicyVerifyStatus::Incomplete
    } else {
        PolicyVerifyStatus::Consistent
    };

    residual emit {
        op: "policy.verify",
        status: status as u8,
        conflicts: conflict_count,
        unreachable: unreachable_count,
        redundant: redundant_count,
        circular: if circular { 1 } else { 0 },
        coverage: coverage,
    };

    return PolicyVerificationResult{
        status: status,
        conflict_count: conflict_count,
        conflicts: conflicts,
        unreachable_rule_ids: unreachable,
        unreachable_count: unreachable_count,
        redundant_rule_ids: redundant,
        redundant_count: redundant_count,
        completeness_score: coverage,
        coverage_percent: coverage,
        circular_dependency_found: circular,
        verification_time_ms: 0,
    };
}

// ──────────────────────────────────────────────
// Policy Load & Reload
// ──────────────────────────────────────────────

fn create_empty_policy_set(version: PolicyVersion) -> PolicySet
    effect [policy:load, compute]
{
    let empty: PolicySet = PolicySet{
        namespace_count: 0,
        namespaces: Array::zeroed(),
        active_rule_count: 0,
        total_rule_capacity: MAX_POLICY_RULES,
        composition_strategy: PolicyCompositionStrategy::DenyOverrides,
        default_decision: PolicyDecision::Deny,
        audit_rule_count: 0,
        audit_rules: Array::zeroed(),
        enforcement_point_count: 0,
        enforcement_points: Array::zeroed(),
        version: version,
        load_state: PolicyLoadState::NotLoaded,
        reload_history_count: 0,
        reload_history: Array::zeroed(),
    };
    return empty;
}

fn add_namespace_to_set(set: PolicySet, ns: PolicyNamespace) -> PolicySet
    effect [policy:load, compute, residual]
{
    let mut updated: PolicySet = set;
    if updated.namespace_count < MAX_POLICY_NAMESPACES {
        updated.namespaces[updated.namespace_count] = ns;
        updated.namespace_count = updated.namespace_count + 1;
        updated.active_rule_count = updated.active_rule_count + ns.rule_count;

        residual emit {
            op: "policy.namespace_add",
            namespace: ns.namespace_id,
            name: ns.name,
            rules: ns.rule_count,
            total_rules: updated.active_rule_count,
        };
    }
    return updated;
}

fn add_rule_to_namespace(ns: PolicyNamespace, rule: PolicyRule) -> PolicyNamespace
    effect [policy:load, compute, residual]
{
    let mut updated: PolicyNamespace = ns;
    if updated.rule_count < MAX_POLICY_RULES {
        updated.rules[updated.rule_count] = rule;
        updated.rule_count = updated.rule_count + 1;

        residual emit {
            op: "policy.rule_add",
            namespace: ns.namespace_id,
            rule: rule.rule_id,
            effect: rule.effect as u8,
            priority: rule.priority,
        };
    }
    return updated;
}

fn remove_rule_from_namespace(ns: PolicyNamespace, rule_id: RuleId) -> PolicyNamespace
    effect [policy:load, compute, residual]
{
    let mut updated: PolicyNamespace = ns;
    let mut found: bool = false;
    let mut found_idx: u64 = 0;

    for i in 0..updated.rule_count {
        if updated.rules[i].rule_id == rule_id {
            found = true;
            found_idx = i;
            break;
        }
    }

    if found {
        for j in found_idx..updated.rule_count - 1 {
            updated.rules[j] = updated.rules[j + 1];
        }
        updated.rule_count = updated.rule_count - 1;

        residual emit {
            op: "policy.rule_remove",
            namespace: ns.namespace_id,
            rule: rule_id,
        };
    }
    return updated;
}

fn atomic_reload_policy(
    current: PolicySet,
    new_set: PolicySet,
    strategy: ReloadStrategy,
    reason: Str(256),
) -> PolicySet
    effect [policy:reload, policy:load, compute, residual]
{
    let old_version: PolicyVersion = current.version;
    let old_rule_count: u64 = current.active_rule_count;
    let old_ns_count: u64 = current.namespace_count;
    let new_version: PolicyVersion = new_set.version;

    let mut verified: PolicyVerificationResult = verify_policy_set(new_set);
    let reload_success: bool = verified.status == PolicyConsistent || verified.status == PolicyHasConflicts;

    let mut final_set: PolicySet = if reload_success {
        new_set
    } else {
        current
    };

    final_set.load_state = if reload_success {
        PolicyLoadState::Active
    } else {
        PolicyLoadState::Failed
    };

    if final_set.reload_history_count < MAX_RELOAD_HISTORY {
        let record: ReloadRecord = ReloadRecord{
            version: new_version,
            previous_version: old_version,
            timestamp: 0,
            strategy: strategy,
            success: reload_success,
            rule_count_before: old_rule_count,
            rule_count_after: new_set.active_rule_count,
            namespace_count_before: old_ns_count,
            namespace_count_after: new_set.namespace_count,
            reason: reason,
        };
        final_set.reload_history[final_set.reload_history_count] = record;
        final_set.reload_history_count = final_set.reload_history_count + 1;
    }

    residual emit {
        op: "policy.reload",
        old_version: old_version,
        new_version: new_version,
        success: if reload_success { 1 } else { 0 },
        reason: reason,
        old_rules: old_rule_count,
        new_rules: new_set.active_rule_count,
        strategy: strategy as u8,
    };

    return final_set;
}

fn gradual_reload_policy(
    current: PolicySet,
    new_rules: Array(PolicyRule, MAX_POLICY_RULES),
    new_rule_count: u64,
    namespace_id: PolicyNamespaceId,
    reason: Str(256),
) -> PolicySet
    effect [policy:reload, policy:load, compute, residual]
{
    let mut updated: PolicySet = current;
    let mut found_ns: bool = false;
    let mut ns_idx: u64 = 0;

    for i in 0..updated.namespace_count {
        if updated.namespaces[i].namespace_id == namespace_id {
            found_ns = true;
            ns_idx = i;
            break;
        }
    }

    if found_ns {
        let mut ns: PolicyNamespace = updated.namespaces[ns_idx];
        let old_count: u64 = ns.rule_count;
        for i in 0..new_rule_count {
            if ns.rule_count < MAX_POLICY_RULES {
                ns.rules[ns.rule_count] = new_rules[i];
                ns.rule_count = ns.rule_count + 1;
            }
        }
        updated.namespaces[ns_idx] = ns;
        updated.active_rule_count = updated.active_rule_count + (ns.rule_count - old_count);
        updated.version = updated.version + 1;
    }

    if updated.reload_history_count < MAX_RELOAD_HISTORY {
        let record: ReloadRecord = ReloadRecord{
            version: updated.version,
            previous_version: updated.version - 1,
            timestamp: 0,
            strategy: ReloadStrategy::GradualRollout,
            success: found_ns,
            rule_count_before: current.active_rule_count,
            rule_count_after: updated.active_rule_count,
            namespace_count_before: current.namespace_count,
            namespace_count_after: updated.namespace_count,
            reason: reason,
        };
        updated.reload_history[updated.reload_history_count] = record;
        updated.reload_history_count = updated.reload_history_count + 1;
    }

    residual emit {
        op: "policy.gradual_reload",
        namespace: namespace_id,
        added_rules: new_rule_count,
        total_rules: updated.active_rule_count,
        success: if found_ns { 1 } else { 0 },
    };

    return updated;
}

fn rollback_policy(
    current: PolicySet,
    target_version: PolicyVersion,
    reason: Str(256),
) -> PolicySet
    effect [policy:reload, compute, residual]
{
    let mut rolled_back: PolicySet = current;
    let found_version: bool = false;
    let mut target_rule_count: u64 = 0;
    let mut target_ns_count: u64 = 0;

    for i in 0..current.reload_history_count {
        let record: ReloadRecord = current.reload_history[i];
        if record.version == target_version {
            target_rule_count = record.rule_count_before;
            target_ns_count = record.namespace_count_before;
        }
    }

    rolled_back.active_rule_count = target_rule_count;
    rolled_back.version = target_version;
    rolled_back.load_state = PolicyLoadState::RolledBack;

    if rolled_back.reload_history_count < MAX_RELOAD_HISTORY {
        let rb_record: ReloadRecord = ReloadRecord{
            version: rolled_back.version,
            previous_version: current.version,
            timestamp: 0,
            strategy: ReloadStrategy::AtomicSwap,
            success: true,
            rule_count_before: current.active_rule_count,
            rule_count_after: target_rule_count,
            namespace_count_before: current.namespace_count,
            namespace_count_after: target_ns_count,
            reason: reason,
        };
        rolled_back.reload_history[rolled_back.reload_history_count] = rb_record;
        rolled_back.reload_history_count = rolled_back.reload_history_count + 1;
    }

    residual emit {
        op: "policy.rollback",
        from_version: current.version,
        to_version: target_version,
        reason: reason,
    };

    return rolled_back;
}

// ──────────────────────────────────────────────
// Policy Query & Introspection
// ──────────────────────────────────────────────

fn get_policy_rule_by_id(set: PolicySet, rule_id: RuleId) -> Option(PolicyRule)
    effect [policy:evaluate, compute]
{
    for n_idx in 0..set.namespace_count {
        let ns: PolicyNamespace = set.namespaces[n_idx];
        for r_idx in 0..ns.rule_count {
            if ns.rules[r_idx].rule_id == rule_id {
                return Option::Some(ns.rules[r_idx]);
            }
        }
    }
    return Option::None;
}

fn count_rules_by_effect(set: PolicySet, effect: RuleEffect) -> u64
    effect [policy:evaluate, compute]
{
    let mut count: u64 = 0;
    for n_idx in 0..set.namespace_count {
        let ns: PolicyNamespace = set.namespaces[n_idx];
        for r_idx in 0..ns.rule_count {
            if ns.rules[r_idx].effect == effect {
                count = count + 1;
            }
        }
    }
    return count;
}

fn count_rules_by_namespace(set: PolicySet, namespace_id: PolicyNamespaceId) -> u64
    effect [policy:evaluate, compute]
{
    for n_idx in 0..set.namespace_count {
        if set.namespaces[n_idx].namespace_id == namespace_id {
            return set.namespaces[n_idx].rule_count;
        }
    }
    return 0;
}

fn get_policy_summary(set: PolicySet) -> Str(512)
    effect [policy:evaluate, compute]
{
    let mut summary: Str(512) = Str::from("PolicySet v");
    let mut ver_str: Str(16) = Str::from("");
    let ver: u64 = set.version;
    if ver > 0 {
        let _: bool = ver_str.append("X");
    }
    let mut details: Str(512) = Str::from("");
    let _: bool = details.append(" namespaces:");
    let ns_str: Str(8) = Str::from("");
    let _: bool = details.append(ns_str);
    let _: bool = details.append(" rules:");
    let rl_str: Str(8) = Str::from("");
    let _: bool = details.append(rl_str);
    let _: bool = summary.append(details);
    return summary;
}

fn list_policy_namespaces(set: PolicySet) -> Array(PolicyNamespaceId, MAX_POLICY_NAMESPACES)
    effect [policy:evaluate, compute]
{
    let mut ids: Array(PolicyNamespaceId, MAX_POLICY_NAMESPACES) = Array::splat(0);
    for i in 0..set.namespace_count {
        ids[i] = set.namespaces[i].namespace_id;
    }
    return ids;
}

fn dump_enforcement_points(set: PolicySet) -> Array(EnforcementPoint, MAX_ENFORCEMENT_POINTS)
    effect [policy:evaluate, compute]
{
    let mut points: Array(EnforcementPoint, MAX_ENFORCEMENT_POINTS) = Array::zeroed();
    for i in 0..set.enforcement_point_count {
        points[i] = set.enforcement_points[i];
    }
    return points;
}

// ──────────────────────────────────────────────
// Policy Persistence Simulation
// ──────────────────────────────────────────────

fn serialize_policy_rule(rule: PolicyRule) -> Array(u8, 128)
    effect [policy:load, compute]
{
    let mut buf: Array(u8, 128) = Array::splat(0);
    buf[0] = (rule.rule_id & 0xFF) as u8;
    buf[1] = ((rule.rule_id >> 8) & 0xFF) as u8;
    buf[2] = ((rule.rule_id >> 16) & 0xFF) as u8;
    buf[3] = ((rule.rule_id >> 24) & 0xFF) as u8;
    buf[4] = rule.namespace_id as u8;
    buf[5] = rule.priority;
    buf[6] = rule.subject_type as u8;
    buf[7] = rule.effect as u8;
    return buf;
}

fn deserialize_policy_rule(buf: Array(u8, 128)) -> PolicyRule
    effect [policy:load, compute]
{
    let rule_id: u64 = (buf[0] as u64) | ((buf[1] as u64) << 8) | ((buf[2] as u64) << 16) | ((buf[3] as u64) << 24);
    let ns_id: PolicyNamespaceId = buf[4] as u64;
    let priority: PriorityLevel = buf[5];
    let subj_cat: SubjectCategory = match buf[6] {
        0 => SubjectCategory::User,
        1 => SubjectCategory::Role,
        2 => SubjectCategory::Group,
        3 => SubjectCategory::Process,
        _ => SubjectCategory::User,
    };
    let eff: RuleEffect = match buf[7] {
        0 => RuleEffect::Permit,
        1 => RuleEffect::Deny,
        _ => RuleEffect::AuditOnly,
    };

    return PolicyRule{
        rule_id: rule_id,
        namespace_id: ns_id,
        priority: priority,
        subject_type: subj_cat,
        subject_pattern: 0,
        object_type: ObjectCategory::File,
        object_pattern: 0,
        action_type: ActionCategory::Read,
        action_pattern: 0,
        effect: eff,
        conditional: false,
        condition_count: 0,
        conditions: Array::zeroed(),
        audit_required: false,
        log_level: 0,
        label: 0,
        version_added: 1,
        version_removed: 0,
        enabled: true,
    };
}

fn validate_policy_rule(rule: PolicyRule) -> bool
    effect [policy:verify, compute]
{
    if rule.rule_id == 0 {
        return false;
    }
    if rule.condition_count > MAX_ENV_CONDITIONS {
        return false;
    }
    return true;
}

// ──────────────────────────────────────────────
// Policy Audit & Logging
// ──────────────────────────────────────────────

fn add_audit_rule(set: PolicySet, rule: AuditRule) -> PolicySet
    effect [policy:load, compute, residual]
{
    let mut updated: PolicySet = set;
    if updated.audit_rule_count < MAX_AUDIT_RULES {
        updated.audit_rules[updated.audit_rule_count] = rule;
        updated.audit_rule_count = updated.audit_rule_count + 1;

        residual emit {
            op: "policy.audit_rule_add",
            rule: rule.rule_id,
            trigger: rule.trigger_effect as u8,
        };
    }
    return updated;
}

fn register_enforcement_point(set: PolicySet, point: EnforcementPoint) -> PolicySet
    effect [policy:load, compute, residual]
{
    let mut updated: PolicySet = set;
    if updated.enforcement_point_count < MAX_ENFORCEMENT_POINTS {
        updated.enforcement_points[updated.enforcement_point_count] = point;
        updated.enforcement_point_count = updated.enforcement_point_count + 1;

        residual emit {
            op: "policy.enforcement_point_register",
            point: point.point_id,
            name: point.name,
        };
    }
    return updated;
}

fn policy_decision_audit_trail(
    decision: PolicyDecisionRecord,
    allowed: bool,
) -> void
    effect [policy:audit, compute, residual]
{
    residual emit {
        op: "policy.audit",
        decision_id: decision.decision_id,
        rule: decision.rule_id,
        subject: decision.subject_id,
        object: decision.object_id,
        action: decision.action_id,
        result: if allowed { 1 } else { 0 },
        decision_type: policy_decision_to_u8(decision.decision),
        timestamp: 0,
    };
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main(policy_store: Cap(StoreNode)) -> PolicySet
    effect [policy:load, policy:evaluate, policy:compose, policy:verify, policy:reload, policy:audit, compute, io:write, residual]
{
    let default_policy: PolicySet = create_empty_policy_set(1);
    let mut active_policy: PolicySet = default_policy;

    let ns_default: PolicyNamespace = PolicyNamespace{
        namespace_id: 1,
        name: Str::from("default"),
        version: 1,
        description: Str::from("Default deny-all policy"),
        rule_count: 0,
        rules: Array::zeroed(),
        parent_namespace: 0,
        priority_base: 100,
        load_state: PolicyLoadState::Active,
        enabled: true,
    };
    active_policy = add_namespace_to_set(active_policy, ns_default);

    let audit_ep: EnforcementPoint = EnforcementPoint{
        point_id: 1,
        name: Str::from("audit_gate"),
        namespace_id: 1,
        enabled: true,
        decision_cache_enabled: true,
        cache_size: 256,
        audit_enabled: true,
        failure_mode: 0,
        residual_required: true,
    };
    active_policy = register_enforcement_point(active_policy, audit_ep);

    let verify_result: PolicyVerificationResult = verify_policy_set(active_policy);

    let test_subject: SubjectId = 1001;
    let test_object: ObjectId = 2001;
    let test_action: ActionId = 3001;

    let (allowed, decision_record): (bool, PolicyDecisionRecord) = enforcement_decision(
        active_policy, audit_ep,
        SubjectCategory::User, test_subject,
        ObjectCategory::File, test_object,
        ActionCategory::Read, test_action,
        0,
    );

    policy_decision_audit_trail(decision_record, allowed);

    let verify_status: u8 = verify_result.status as u8;
    let coverage: u64 = verify_result.coverage_percent;
    let has_conflicts: u64 = verify_result.conflict_count;

    assert(verify_result.status == PolicyConsistent || verify_result.status == PolicyHasConflicts, "security_policy: verification runs");
    assert(active_policy.namespace_count > 0, "security_policy: namespace added");
    assert(active_policy.enforcement_point_count > 0, "security_policy: enforcement points registered");

    residual emit {
        op: "security_policy.init_complete",
        version: active_policy.version,
        namespaces: active_policy.namespace_count,
        rules: active_policy.active_rule_count,
        enforcement_points: active_policy.enforcement_point_count,
        audit_rules: active_policy.audit_rule_count,
        verify_status: verify_status,
        coverage_percent: coverage,
        conflict_count: has_conflicts,
    };

    return active_policy;
}
