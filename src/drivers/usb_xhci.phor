// ─────────────────────────────────────────────────────────────
// Set TR Dequeue Pointer Command
// ─────────────────────────────────────────────────────────────

fn xhci_set_tr_dequeue(
    controller: Handle(XhciController),
    slot_id: u8,
    ep_index: u8,
    dequeue_ptr: u64,
    dcs: u8,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_set_tr_dequeue:v1"
{
    let param: u64 = dequeue_ptr | (dcs as u64);
    let status: u32 = (slot_id as u32) | ((ep_index as u32) << 8);

    let cmd_result: Result(void, XhciError) = xhci_enqueue_command_trb(
        Handle(XhciCommandRing)::from_ptr(&controller.cmd_ring),
        param, status, XhciTrbType::SetTrDequeuePointerCommand, controller.cmd_ring.cycle_state, true, timestamp,
    );
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let db_result: Result(void, XhciError) = xhci_ring_doorbell(controller, 0, 0, 0, timestamp);
    match db_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Port Management: Reset Port
// ─────────────────────────────────────────────────────────────

fn xhci_port_reset(
    controller: Handle(XhciController),
    port_num: u8,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_port_reset:v1"
{
    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };
    let portsc_off: u64 = XhciRegisters::portsc_offset(port_num);

    let portsc: u32 = regs.read32(portsc_off);
    regs.write32(portsc_off, portsc | (1 << 4));

    loop bound 1000 {
        let current: u32 = regs.read32(portsc_off);
        if (current & (1 << 4)) == 0 {
            let link_state: u8 = ((current >> 5) & 0x0F) as u8;
            if link_state == 0 {
                break;
            };
        };
    };

    let port: Handle(XhciPortState) = Handle(XhciPortState)::from_ptr(&controller.ports[port_num as u64]);
    let final_portsc: u32 = regs.read32(portsc_off);
    port.portsc = final_portsc;
    port.enabled = (final_portsc & (1 << 1)) != 0;
    port.connected = (final_portsc & 0x01) != 0;

    residual emit {
        op: "xhci.port_reset",
        port: port_num as u64,
        enabled: port.enabled,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// LPM: Enable Link Power Management
// ─────────────────────────────────────────────────────────────

fn xhci_enable_lpm(
    controller: Handle(XhciController),
    port_num: u8,
    lpm_state: u8,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_enable_lpm:v1"
{
    if !cap.can_lpm {
        return Result::Err(XhciError::XhciCapabilityError);
    };

    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };
    let portsc_off: u64 = XhciRegisters::portsc_offset(port_num);

    let portsc: u32 = regs.read32(portsc_off);
    let new_portsc: u32 = (portsc & !0x1E0) | ((lpm_state as u32) << 5);
    regs.write32(portsc_off, new_portsc);

    let port: Handle(XhciPortState) = Handle(XhciPortState)::from_ptr(&controller.ports[port_num as u64]);
    port.portsc = new_portsc;

    let lpm_bit: u32 = 1 << 14;
    regs.write32(portsc_off, new_portsc | lpm_bit);

    residual emit {
        op: "xhci.enable_lpm",
        port: port_num as u64,
        lpm_state: lpm_state as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Roothub Emulation: Get Port Status
// ─────────────────────────────────────────────────────────────

fn xhci_roothub_get_status(
    controller: Handle(XhciController),
    port_num: u8,
    timestamp: u64,
) -> Result(XhciPortState, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_roothub_get_status:v1"
{
    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };
    let portsc_off: u64 = XhciRegisters::portsc_offset(port_num);
    let portpmsc_off: u64 = XhciRegisters::portpmsc_offset(port_num);
    let portli_off: u64 = XhciRegisters::portli_offset(port_num);

    let portsc: u32 = regs.read32(portsc_off);
    let portpmsc: u32 = regs.read32(portpmsc_off);
    let portli: u32 = regs.read32(portli_off);

    let port: Handle(XhciPortState) = Handle(XhciPortState)::from_ptr(&controller.ports[port_num as u64]);
    port.portsc = portsc;
    port.portpmsc = portpmsc;
    port.portli = portli;
    port.connected = (portsc & 0x01) != 0;
    port.enabled = (portsc & (1 << 1)) != 0;

    residual emit {
        op: "xhci.roothub_get_status",
        port: port_num as u64,
        connected: port.connected,
        enabled: port.enabled,
        timestamp: timestamp,
    };

    return Result::Ok(port);
}

// ─────────────────────────────────────────────────────────────
// Roothub Emulation: Set Port Power
// ─────────────────────────────────────────────────────────────

fn xhci_roothub_set_power(
    controller: Handle(XhciController),
    port_num: u8,
    on: bool,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_roothub_set_power:v1"
{
    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };
    let portsc_off: u64 = XhciRegisters::portsc_offset(port_num);

    let portsc: u32 = regs.read32(portsc_off);
    if on {
        regs.write32(portsc_off, portsc | (1 << 8));
    } else {
        regs.write32(portsc_off, portsc & !(1 << 8));
    };

    let port: Handle(XhciPortState) = Handle(XhciPortState)::from_ptr(&controller.ports[port_num as u64]);
    port.power_ok = on;

    residual emit {
        op: "xhci.roothub_set_power",
        port: port_num as u64,
        power_on: on,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Discover Extended Capabilities
// ─────────────────────────────────────────────────────────────

fn xhci_discover_ext_caps(
    controller: Handle(XhciController),
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(u8, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_discover_ext_caps:v1"
{
    if !cap.can_ext_cap {
        return Result::Err(XhciError::XhciCapabilityError);
    };

    let ext_cap_ptr: u16 = controller.hccparams1.ext_cap_ptr;
    if ext_cap_ptr == 0 {
        return Result::Ok(0);
    };

    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };
    let mut cap_off: u64 = ext_cap_ptr as u64;
    let mut cap_count: u8 = 0;

    loop bound 16 {
        if cap_off == 0 || cap_count >= 16 {
            break;
        };

        let cap_entry: u32 = regs.read32(cap_off);
        let cap_id: u8 = (cap_entry & 0xFF) as u8;
        let next_off: u8 = ((cap_entry >> 8) & 0xFF) as u8;

        let entry: Handle(XhciExtCapEntry) = Handle(XhciExtCapEntry)::from_ptr(&controller.ext_caps[cap_count as u64]);
        entry.cap_id = cap_id;
        entry.next_off = next_off;

        loop bound 8 {
            let mut i: u64 = 0;
            if i >= 8 {
                break;
            };
            let data_off: u64 = cap_off + ((i + 1) * 4);
            entry.data[i] = regs.read32(data_off);
            i = i + 1;
        };

        cap_count = cap_count + 1;

        if next_off == 0 {
            break;
        };
        cap_off = cap_off + (next_off as u64) * 4;
    };

    controller.ext_cap_count = cap_count;

    residual emit {
        op: "xhci.discover_ext_caps",
        count: cap_count as u64,
        ext_cap_ptr: ext_cap_ptr as u64,
        timestamp: timestamp,
    };

    return Result::Ok(cap_count);
}

// ─────────────────────────────────────────────────────────────
// Interrupter: Initialize Primary Interrupter
// ─────────────────────────────────────────────────────────────

fn xhci_init_interrupter(
    controller: Handle(XhciController),
    intr_num: u16,
    erst_base: u64,
    erst_size: u16,
    imod_interval: u16,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_init_interrupter:v1"
{
    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };
    let rt_off: u64 = controller.rt_offset;

    let iman_off: u64 = rt_off + (intr_num as u64) * 32 + 0x00;
    let imod_off: u64 = rt_off + (intr_num as u64) * 32 + 0x04;
    let erstsz_off: u64 = rt_off + (intr_num as u64) * 32 + 0x08;
    let erstba_off: u64 = rt_off + (intr_num as u64) * 32 + 0x10;
    let erdp_off: u64 = rt_off + (intr_num as u64) * 32 + 0x18;

    regs.write32(erstsz_off, erst_size as u32);
    regs.write64(erstba_off, erst_base);
    regs.write64(erdp_off, erst_base);

    let imod_val: u32 = (imod_interval as u32) << 16;
    regs.write32(imod_off, imod_val);

    regs.write32(iman_off, 0x01);

    controller.interrupter.iman = 0x01;
    controller.interrupter.imod = imod_val;
    controller.interrupter.erst_size = erst_size as u32;
    controller.interrupter.erst_base = erst_base;
    controller.interrupter.enabled = true;

    residual emit {
        op: "xhci.init_interrupter",
        intr_num: intr_num as u64,
        erst_base: erst_base,
        erst_size: erst_size as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Controller Initialization
// ─────────────────────────────────────────────────────────────

fn xhci_controller_init(
    controller: Handle(XhciController),
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_controller_init:v1"
{
    let regs: XhciRegisters = XhciRegisters { mmio_base: controller.mmio_base };

    let caplength: u8 = regs.read32(XhciRegisters::caplength_offset()) as u8;
    controller.caplength = caplength;

    let hciver: u16 = regs.read32(XhciRegisters::hciversion_offset()) as u16;
    controller.hciversion = hciver;

    let hsp1: u32 = regs.read32(XhciRegisters::hcsparams1_offset());
    controller.hcsparams1 = xhci_parse_hcsparams1(hsp1);
    controller.max_slots = controller.hcsparams1.max_slots;
    controller.max_intrs = controller.hcsparams1.max_intrs;
    controller.max_ports = controller.hcsparams1.max_ports;

    let hcp1: u32 = regs.read32(XhciRegisters::hccparams1_offset());
    controller.hccparams1 = xhci_parse_hccparams1(hcp1);

    controller.db_offset = regs.read32(XhciRegisters::dboff_offset()) as u64;
    controller.rt_offset = regs.read32(XhciRegisters::rtsoff_offset()) as u64;

    if controller.hccparams1.ac64 {
        regs.write64(XhciRegisters::dcbaap_offset(), 0);
    } else {
        regs.write32(XhciRegisters::dcbaap_offset(), 0);
    };

    regs.write32(XhciRegisters::usbcmd_offset(), 0x00);

    loop bound 100 {
        let sts: u32 = regs.read32(XhciRegisters::usbsts_offset());
        if (sts & 0x01) == 0 {
            break;
        };
    };

    regs.write32(XhciRegisters::dnctrl_offset(), 0xFFFFFFFF);

    let pagesize: u32 = regs.read32(XhciRegisters::pagesize_offset());
    regs.write32(XhciRegisters::config_offset(), controller.max_slots as u32);

    let crcr: u64 = controller.cmd_ring.crcr;
    regs.write64(XhciRegisters::crcr_offset(), crcr);

    regs.write32(XhciRegisters::usbcmd_offset(), 0x02);

    loop bound 100 {
        let sts2: u32 = regs.read32(XhciRegisters::usbsts_offset());
        if (sts2 & 0x02) != 0 {
            break;
        };
    };

    regs.write32(XhciRegisters::usbcmd_offset(), 0x01);

    controller.operational = true;
    controller.initialized = true;

    residual emit {
        op: "xhci.controller_init",
        max_slots: controller.max_slots as u64,
        max_ports: controller.max_ports as u64,
        hci_version: hciver as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn xhci_driver_init(
    driver_identity: Identity,
    cap: XhciFullCapability,
    timestamp: u64,
) -> XhciDriverState
    effect [deterministic, residual]
    court "xhci_driver_init:v1"
{
    let state: XhciDriverState = XhciDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_transfers: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "xhci.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add Controller from PCI Discovery
// ─────────────────────────────────────────────────────────────

fn xhci_add_controller(
    state: Handle(XhciDriverState),
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(u64, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_add_controller:v1"
{
    if state.controller_count >= 4 {
        return Result::Err(XhciError::XhciMaxDevicesExceeded);
    };

    let idx: u64 = state.controller_count;
    let ctrl_identity: Identity = identity_new(0x584843, timestamp, idx, pci_bus as u64);

    let ctrl: XhciController = XhciController {
        controller_identity: ctrl_identity,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        irq_vector: irq_vector,
        caplength: 0,
        hciversion: 0,
        hcsparams1: XhciHcsParams1 { max_slots: 0, max_intrs: 0, max_ports: 0 },
        hccparams1: XhciHccParams1 { ac64: false, pne: false, csc: false, ppc: false, pind: false, lhrc: false, ltc: false, nss: false, pae: false, spc: false, sec: false, cfc: false, max_psa_size: 0, ext_cap_ptr: 0 },
        max_slots: 0,
        max_intrs: 0,
        max_ports: 0,
        db_offset: 0,
        rt_offset: 0,
        dcbaap: 0,
        config: 0,
        interrupter: XhciInterrupter { iman: 0, imod: 0, erst_size: 0, erst_base: 0, erst_dequeue: 0, tr_dequeue: 0, tr_ring_seg_count: 0, tr_ring_entries: Array::zeroed(), enabled: false, pending: false, event_trb_idx: 0, ist_index: 0 },
        intr_count: 0,
        devices: Array::zeroed(),
        device_count: 0,
        ports: Array::zeroed(),
        port_count: controller.max_ports,
        cmd_ring: XhciCommandRing { entries: Array::zeroed(), enqueue_idx: 0, dequeue_idx: 0, cycle_state: true, crcr: 0, cmd_pending: false },
        event_ring: XhciEventRingSegment { entries: Array::zeroed(), seg_base: 0, seg_size: 0, dequeue_idx: 0, cycle_state: true },
        ext_caps: Array::zeroed(),
        ext_cap_count: 0,
        operational: false,
        initialized: false,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.controllers[idx] = ctrl;
    let ctrl_handle: Handle(XhciController) = Handle(XhciController)::from_ptr(&state.controllers[idx]);

    let init_result: Result(void, XhciError) = xhci_controller_init(ctrl_handle, cap, timestamp);
    match init_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    state.controller_count = state.controller_count + 1;

    residual emit {
        op: "xhci.add_controller",
        controller_idx: idx,
        mmio_base: mmio_base,
        pci_bus: pci_bus as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// USB 3.0 Specific: Set Isochronous Delay
// ─────────────────────────────────────────────────────────────

fn xhci_set_isoch_delay(
    controller: Handle(XhciController),
    delay_ns: u16,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_set_isoch_delay:v1"
{
    if !cap.can_isochronous {
        return Result::Err(XhciError::XhciCapabilityError);
    };

    let param: u64 = delay_ns as u64;
    let cmd_result: Result(void, XhciError) = xhci_enqueue_command_trb(
        Handle(XhciCommandRing)::from_ptr(&controller.cmd_ring),
        param, 0, XhciTrbType::SetIsochDelay, controller.cmd_ring.cycle_state, true, timestamp,
    );
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let db_result: Result(void, XhciError) = xhci_ring_doorbell(controller, 0, 0, 0, timestamp);
    match db_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "xhci.set_isoch_delay",
        delay_ns: delay_ns as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}
