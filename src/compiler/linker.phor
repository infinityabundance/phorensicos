// linker.phor — Object File Linking, Relocation Resolution, Symbol Resolution
// Phorensic Compiler Infrastructure — Linking Phase
//
// This module implements the linker for the Phorensic compiler. It combines multiple
// object files into a single executable or library by:
// - Resolving symbol references across object files
// - Applying relocations with resolved addresses
// - Merging sections from multiple inputs
// - Performing layout and assigning final addresses
// - Generating the final binary image
// - Producing link receipts for the evidence chain
//
// Evidence semantics: Every linking operation produces a LinkerReceipt that records
// symbol resolutions, relocation applications, and section layouts. This enables
// full binary provenance verification.
//
// Boundedness: All linker operations are bounded by object count (64), section count
// (128), symbol count (256), and relocation count (256).

use core::fixed::Array128;
use core::fixed::Array256;
use core::fixed::Array64;
use core::result::Result;
use core::option::Option;
use core::string::FixedString256;

use compiler::diagnostics::*;
use compiler::codegen::*;

// --- Linker Configuration ---

pub struct LinkerConfig {
    /// Base address for the executable.
    pub base_address : u64,
    /// Whether to generate a shared library.
    pub shared : bool,
    /// Whether to strip debug symbols.
    pub strip : bool,
    /// Output format.
    pub output_format : OutputFormat,
    /// Entry point symbol name.
    pub entry_point : FixedString256,
    /// Library search paths (fixed array).
    pub library_paths : Array64<FixedString256>,
}

pub sealdatatype OutputFormat : u8 {
    ELF = 0u8,
    PE = 1u8,
    MachO = 2u8,
    Raw = 3u8,
}

impl LinkerConfig {
    pub fn new() -> LinkerConfig [pure] {
        LinkerConfig {
            base_address: 0x400000u64,
            shared: false,
            strip: false,
            output_format: OutputFormat::ELF,
            entry_point: FixedString256::from("_start"),
            library_paths: Array64::new(),
        }
    }
}

// --- Resolved Symbol ---

pub struct ResolvedSymbol {
    pub name : FixedString256,
    pub address : u64,
    pub section_index : u32,
    pub size : u64,
    pub is_defined : bool,
    pub is_extern : bool,
    pub is_weak : bool,
    pub generation : u64,
}

impl ResolvedSymbol {
    pub fn new(name : FixedString256) -> ResolvedSymbol [pure] {
        ResolvedSymbol {
            name: name,
            address: 0u64,
            section_index: 0u32,
            size: 0u64,
            is_defined: false,
            is_extern: false,
            is_weak: false,
            generation: 0u64,
        }
    }
}

// --- Merged Section ---

pub struct MergedSection {
    pub name : FixedString256,
    pub kind : SectionKind,
    pub data : Array256<u8>,
    pub virtual_address : u64,
    pub size : u64,
    pub alignment : u64,
    pub input_sections : Array64<u32>, // indices into input objects
}

impl MergedSection {
    pub fn new(name : FixedString256, kind : SectionKind) -> MergedSection [pure] {
        MergedSection {
            name: name,
            kind: kind,
            data: Array256::new(),
            virtual_address: 0u64,
            size: 0u64,
            alignment: 1u64,
            input_sections: Array64::new(),
        }
    }

    /// Append data from an input section.
    /// Effect: pure — bounded by Array256 capacity.
    pub fn append(mut self, data : Array256<u8>) -> MergedSection [pure] {
        // Bounded: at most 256 bytes total.
        for var i : u32 = 0u32; i < data.len(); i += 1u32 [data.len()] {
            if self.data.len() < self.data.capacity() {
                let _ = self.data.push(data.get(i));
            }
        }
        self.size = self.data.len() as u64;
        self
    }
}

// --- Linker State ---

pub struct LinkerState {
    /// Input object files.
    pub objects : Array64<ObjectFile>,
    /// Merged output sections.
    pub sections : Array64<MergedSection>,
    /// Resolved symbol table.
    pub symbols : Array64<ResolvedSymbol>,
    /// Pending relocations (to be applied).
    pub pending_relocations : Array64<RelocationEntry>,
    /// Linker configuration.
    pub config : LinkerConfig,
    /// Diagnostic bag.
    pub diagnostics : DiagnosticBag,
    /// Current layout address.
    pub current_address : u64,
    /// Number of symbols resolved.
    pub resolved_count : u32,
    /// Number of unresolved symbols.
    pub unresolved_count : u32,
    /// Number of relocations applied.
    pub relocations_applied : u32,
    /// Generation tag.
    pub generation : u64,
    /// Output file path.
    pub output_path : FixedString256,
}

impl LinkerState {
    pub fn new(output_path : FixedString256, config : LinkerConfig) -> LinkerState [pure] {
        LinkerState {
            objects: Array64::new(),
            sections: Array64::new(),
            symbols: Array64::new(),
            pending_relocations: Array64::new(),
            config: config,
            diagnostics: DiagnosticBag::new(),
            current_address: config.base_address,
            resolved_count: 0u32,
            unresolved_count: 0u32,
            relocations_applied: 0u32,
            generation: 0u64,
            output_path: output_path,
        }
    }

    /// Add an object file to the link.
    /// Effect: pure — bounded by Array64 capacity.
    pub fn add_object(mut self, obj : ObjectFile) -> Result<LinkerState, FixedString256> [pure] {
        if self.objects.len() >= self.objects.capacity() {
            Result::Err(FixedString256::from("object file limit reached"))
        } else {
            let _ = self.objects.push(obj);
            Result::Ok(self)
        }
    }

    /// Perform the full link.
    /// Effect: diag, pure — complete linking pipeline.
    pub fn link(&mut self) -> Result<(), FixedString256> [diag, pure] {
        // Phase 1: Collect all symbols from all object files.
        let _ = self.collect_symbols()?;

        // Phase 2: Resolve symbol references.
        let _ = self.resolve_symbols()?;

        // Phase 3: Merge sections.
        let _ = self.merge_sections()?;

        // Phase 4: Perform layout and assign addresses.
        let _ = self.perform_layout()?;

        // Phase 5: Apply relocations.
        let _ = self.apply_relocations()?;

        // Phase 6: Generate output binary.
        let _ = self.generate_output()?;

        self.generation += 1u64;
        Result::Ok(())
    }

    /// Phase 1: Collect all symbols from input objects.
    /// Effect: pure — bounded loop over objects.
    fn collect_symbols(&mut self) -> Result<(), FixedString256> [pure] {
        // Bounded: at most 64 object files.
        for var oi : u32 = 0u32; oi < self.objects.len(); oi += 1u32 [self.objects.len()] {
            let obj : ObjectFile = self.objects.get(oi);
            // Bounded: at most 256 symbols per object.
            for var si : u32 = 0u32; si < obj.symbol_table.len(); si += 1u32 [obj.symbol_table.len()] {
                let sym_entry : (FixedString256, u64, u64) = obj.symbol_table.get(si);
                let sym_name : FixedString256 = sym_entry.0;

                // Check for duplicate symbols.
                let mut found : bool = false;
                // Bounded: at most 256 total symbols.
                for var ei : u32 = 0u32; ei < self.symbols.len(); ei += 1u32 [self.symbols.len()] {
                    if self.symbols.get(ei).name == sym_name {
                        found = true;
                        if self.symbols.get(ei).is_defined {
                            // Duplicate definition.
                            let msg : FixedString256 = diag_messages::symbol_not_found(sym_name);
                            let diag : DiagnosticPayload = DiagnosticPayload::new(
                                DiagnosticCode::LinkDuplicateSymbol,
                                FixedString256::from("duplicate symbol: ") + sym_name,
                                SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                                DiagnosticSeverity::Error,
                                CompilerPhase::Linker,
                            );
                            let _ = self.diagnostics.emit(diag);
                        }
                        break;
                    }
                }

                if !found {
                    let mut sym : ResolvedSymbol = ResolvedSymbol::new(sym_name);
                    sym.address = sym_entry.1;
                    sym.size = sym_entry.2;
                    sym.is_defined = true;
                    sym.generation = self.generation;
                    let _ = self.symbols.push(sym);
                    self.resolved_count += 1u32;
                }
            }

            // Collect relocations.
            // Bounded: at most 256 relocations per object.
            for var ri : u32 = 0u32; ri < obj.relocations.len(); ri += 1u32 [obj.relocations.len()] {
                let reloc : RelocationEntry = obj.relocations.get(ri);
                let _ = self.pending_relocations.push(reloc);
            }
        }

        // Add entry point symbol.
        let entry : ResolvedSymbol = ResolvedSymbol::new(self.config.entry_point);
        // The entry point will be resolved if it exists in an input.
        let _ = self;
        Result::Ok(())
    }

    /// Phase 2: Resolve symbol references.
    /// Effect: diag, pure — symbol resolution with error reporting.
    fn resolve_symbols(&mut self) -> Result<(), FixedString256> [diag, pure] {
        // Bounded: at most 256 symbols.
        for var i : u32 = 0u32; i < self.symbols.len(); i += 1u32 [self.symbols.len()] {
            let sym : ResolvedSymbol = self.symbols.get(i);
            if !sym.is_defined && !sym.is_extern {
                // Unresolved symbol.
                self.unresolved_count += 1u32;
                let msg : FixedString256 = diag_messages::symbol_not_found(sym.name);
                let diag : DiagnosticPayload = DiagnosticPayload::new(
                    DiagnosticCode::LinkSymbolNotFound,
                    msg,
                    SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                    DiagnosticSeverity::Error,
                    CompilerPhase::Linker,
                );
                let _ = self.diagnostics.emit(diag);
            }
        }
        Result::Ok(())
    }

    /// Phase 3: Merge input sections into output sections.
    /// Effect: pure — section merging.
    fn merge_sections(&mut self) -> Result<(), FixedString256> [pure] {
        // Create standard output sections.
        let text_sec : MergedSection = MergedSection::new(
            FixedString256::from(".text"), SectionKind::Text,
        );
        let _ = self.sections.push(text_sec);
        let data_sec : MergedSection = MergedSection::new(
            FixedString256::from(".data"), SectionKind::Data,
        );
        let _ = self.sections.push(data_sec);
        let rodata_sec : MergedSection = MergedSection::new(
            FixedString256::from(".rodata"), SectionKind::ReadOnlyData,
        );
        let _ = self.sections.push(rodata_sec);

        // Bounded: at most 64 object files.
        for var oi : u32 = 0u32; oi < self.objects.len(); oi += 1u32 [self.objects.len()] {
            let obj : ObjectFile = self.objects.get(oi);
            // Bounded: at most 64 sections per object.
            for var si : u32 = 0u32; si < obj.sections.len(); si += 1u32 [obj.sections.len()] {
                let input_sec : Section = obj.sections.get(si);
                // Find matching output section by kind.
                for var mi : u32 = 0u32; mi < self.sections.len(); mi += 1u32 [self.sections.len()] {
                    let mut merged : MergedSection = self.sections.get(mi);
                    if merged.kind == input_sec.kind {
                        merged = merged.append(input_sec.data);
                        self.sections.set(mi, merged);
                        break;
                    }
                }
            }
        }

        Result::Ok(())
    }

    /// Phase 4: Perform memory layout (assign virtual addresses).
    /// Effect: pure — address assignment.
    fn perform_layout(&mut self) -> Result<(), FixedString256> [pure] {
        let mut addr : u64 = self.config.base_address;

        // Bounded: at most 64 sections.
        for var i : u32 = 0u32; i < self.sections.len(); i += 1u32 [self.sections.len()] {
            let mut sec : MergedSection = self.sections.get(i);
            // Align the section.
            let alignment : u64 = sec.alignment;
            let misalignment : u64 = addr % alignment;
            if misalignment != 0u64 {
                addr += alignment - misalignment;
            }
            sec.virtual_address = addr;
            self.sections.set(i, sec);
            addr += sec.size;
        }

        self.current_address = addr;
        Result::Ok(())
    }

    /// Phase 5: Apply relocations using resolved symbol addresses.
    /// Effect: diag, pure — relocation application.
    fn apply_relocations(&mut self) -> Result<(), FixedString256> [diag, pure] {
        // Bounded: at most 256 pending relocations.
        for var ri : u32 = 0u32; ri < self.pending_relocations.len(); ri += 1u32 [self.pending_relocations.len()] {
            let reloc : RelocationEntry = self.pending_relocations.get(ri);
            let sym_name : FixedString256 = reloc.symbol_name;

            // Look up the symbol address.
            let mut sym_addr : u64 = 0u64;
            let mut found : bool = false;
            // Bounded: at most 256 symbols.
            for var si : u32 = 0u32; si < self.symbols.len(); si += 1u32 [self.symbols.len()] {
                let sym : ResolvedSymbol = self.symbols.get(si);
                if sym.name == sym_name {
                    sym_addr = sym.address;
                    found = true;
                    break;
                }
            }

            if !found {
                self.unresolved_count += 1u32;
                let msg : FixedString256 = diag_messages::symbol_not_found(sym_name);
                let diag : DiagnosticPayload = DiagnosticPayload::new(
                    DiagnosticCode::LinkRelocationOutOfRange,
                    msg,
                    SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                    DiagnosticSeverity::Error,
                    CompilerPhase::Linker,
                );
                let _ = self.diagnostics.emit(diag);
            } else {
                // Apply relocation: patch the instruction at reloc.offset.
                // This would modify the actual bytes in the section.
                self.relocations_applied += 1u32;
                // Evidence: relocation applied for symbol.
                let _ = sym_addr;
            }
        }

        Result::Ok(())
    }

    /// Phase 6: Generate the final binary output.
    /// Effect: pure — produces output binary structure.
    fn generate_output(&mut self) -> Result<(), FixedString256> [pure] {
        // In a full implementation, this would serialize the output binary.
        // For the compiler infrastructure, we produce a LinkerOutput structure.
        Result::Ok(())
    }

    /// Get the final linked output.
    /// Effect: pure — produces linker output.
    pub fn emit_output(&mut self) -> LinkerOutput [pure] {
        let mut output : LinkerOutput = LinkerOutput::new(self.output_path);

        // Bounded: at most 64 sections.
        for var i : u32 = 0u32; i < self.sections.len(); i += 1u32 [self.sections.len()] {
            let sec : MergedSection = self.sections.get(i);
            let _ = output.add_section(sec);
        }

        // Bounded: at most 256 symbols.
        for var i : u32 = 0u32; i < self.symbols.len(); i += 1u32 [self.symbols.len()] {
            let sym : ResolvedSymbol = self.symbols.get(i);
            let _ = output.add_symbol(sym);
        }

        output
    }

    /// Create a linker receipt.
    /// Effect: pure — consumes state to produce receipt.
    pub fn into_receipt(self) -> LinkerReceipt [pure] {
        LinkerReceipt::new(
            self.objects.len(),
            self.sections.len(),
            self.symbols.len(),
            self.resolved_count,
            self.unresolved_count,
            self.relocations_applied,
            self.generation,
        )
    }
}

// --- Linker Output ---

pub struct LinkerOutput {
    pub file_path : FixedString256,
    pub sections : Array64<MergedSection>,
    pub symbols : Array64<ResolvedSymbol>,
    pub entry_point : u64,
    pub total_size : u64,
    pub generation : u64,
}

impl LinkerOutput {
    pub fn new(file_path : FixedString256) -> LinkerOutput [pure] {
        LinkerOutput {
            file_path: file_path,
            sections: Array64::new(),
            symbols: Array64::new(),
            entry_point: 0u64,
            total_size: 0u64,
            generation: 0u64,
        }
    }

    pub fn add_section(mut self, section : MergedSection) -> LinkerOutput [pure] {
        let _ = self.sections.push(section);
        self
    }

    pub fn add_symbol(mut self, symbol : ResolvedSymbol) -> LinkerOutput [pure] {
        let _ = self.symbols.push(symbol);
        self
    }

    /// Compute the total size of the output.
    /// Effect: pure — sum of section sizes.
    pub fn compute_size(&mut self) -> u64 [pure] {
        var total : u64 = 0u64;
        // Bounded: at most 64 sections.
        for var i : u32 = 0u32; i < self.sections.len(); i += 1u32 [self.sections.len()] {
            total += self.sections.get(i).size;
        }
        self.total_size = total;
        total
    }
}

// --- Linker Receipt ---

pub struct LinkerReceipt {
    pub objects_linked : u32,
    pub sections_merged : u32,
    pub symbols_total : u32,
    pub symbols_resolved : u32,
    pub symbols_unresolved : u32,
    pub relocations_applied : u32,
    pub linker_hash : u64,
    pub generation : u64,
}

impl LinkerReceipt {
    pub fn new(
        objects : u32,
        sections : u32,
        symbols : u32,
        resolved : u32,
        unresolved : u32,
        relocs : u32,
        generation : u64,
    ) -> LinkerReceipt [pure] {
        let hash : u64 = LinkerReceipt::compute_hash(
            objects, sections, symbols, resolved, unresolved, relocs, generation,
        );
        LinkerReceipt {
            objects_linked: objects,
            sections_merged: sections,
            symbols_total: symbols,
            symbols_resolved: resolved,
            symbols_unresolved: unresolved,
            relocations_applied: relocs,
            linker_hash: hash,
            generation: generation,
        }
    }

    fn compute_hash(
        objs : u32, secs : u32, syms : u32,
        res : u32, unres : u32, relocs : u32, gen : u64,
    ) -> u64 [pure] {
        var h : u64 = 14695981039346656037u64;
        h ^= objs as u64; h *= 1099511628211u64;
        h ^= secs as u64; h *= 1099511628211u64;
        h ^= syms as u64; h *= 1099511628211u64;
        h ^= res as u64; h *= 1099511628211u64;
        h ^= relocs as u64; h *= 1099511628211u64;
        h ^= gen; h *= 1099511628211u64;
        h
    }
}

// --- Linker Pipeline Entry Point ---

/// Link multiple object files into a single executable.
/// Effect: diag, pure — complete linking pipeline.
pub fn link_objects(
    objects : Array64<ObjectFile>,
    output_path : FixedString256,
    config : LinkerConfig,
) -> (LinkerOutput, DiagnosticBag, LinkerReceipt) [diag, pure] {
    let mut linker : LinkerState = LinkerState::new(output_path, config);

    // Add all objects.
    // Bounded: at most 64 objects.
    for var i : u32 = 0u32; i < objects.len(); i += 1u32 [objects.len()] {
        let obj : ObjectFile = objects.get(i);
        let result : Result<LinkerState, FixedString256> = linker.add_object(obj);
        match result {
            Result::Ok(l) => { linker = l; }
            Result::Err(msg) => {
                let diag : DiagnosticPayload = DiagnosticPayload::new(
                    DiagnosticCode::LinkDuplicateSymbol,
                    msg,
                    SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                    DiagnosticSeverity::Error,
                    CompilerPhase::Linker,
                );
                let _ = linker.diagnostics.emit(diag);
            }
        }
    }

    let link_result : Result<(), FixedString256> = linker.link();
    match link_result {
        Result::Ok(()) => {}
        Result::Err(msg) => {
            let diag : DiagnosticPayload = DiagnosticPayload::new(
                DiagnosticCode::LinkSymbolNotFound,
                msg,
                SourceLocation::new(FixedString256::new(), 0u32, 0u32, 0u64),
                DiagnosticSeverity::Error,
                CompilerPhase::Linker,
            );
            let _ = linker.diagnostics.emit(diag);
        }
    }

    let output : LinkerOutput = linker.emit_output();
    let diagnostics : DiagnosticBag = linker.diagnostics;
    let receipt : LinkerReceipt = linker.into_receipt();
    (output, diagnostics, receipt)
}

// --- Symbol Resolution Helpers ---

/// Perform a full symbol table lookup across all objects.
/// Effect: pure — bounded search.
pub fn lookup_symbol_in_objects(
    objects : &Array64<ObjectFile>,
    symbol_name : FixedString256,
) -> Option<ResolvedSymbol> [pure] {
    // Bounded: at most 64 objects.
    for var oi : u32 = 0u32; oi < objects.len(); oi += 1u32 [objects.len()] {
        let obj : ObjectFile = objects.get(oi);
        // Bounded: at most 256 symbols per object.
        for var si : u32 = 0u32; si < obj.symbol_table.len(); si += 1u32 [obj.symbol_table.len()] {
            let entry : (FixedString256, u64, u64) = obj.symbol_table.get(si);
            if entry.0 == symbol_name {
                let mut sym : ResolvedSymbol = ResolvedSymbol::new(symbol_name);
                sym.address = entry.1;
                sym.size = entry.2;
                sym.is_defined = true;
                sym.section_index = 0u32;
                sym.generation = 0u64;
                return Option::Some(sym);
            }
        }
    }
    Option::None
}

/// Check if address is within range of a relocation type.
/// Effect: pure — range checking.
pub fn relocation_in_range(address : u64, reloc_type : u8) -> bool [pure] {
    match reloc_type {
        0u8 => address <= 0xFFFFFFFFu64, // R_X86_64_32
        1u8 => address <= 0x7FFFFFFFu64, // R_X86_64_PC32
        2u8 => true,                     // R_X86_64_64
        3u8 => address <= 0xFFFFFFFFu64, // R_X86_64_GOT32
        _ => true,
    }
}

/// Get the size (in bytes) of a relocation entry's data.
/// Effect: pure — size lookup.
pub fn relocation_entry_size(reloc_type : u8) -> u8 [pure] {
    match reloc_type {
        0u8 => 4u8,  // R_X86_64_32
        1u8 => 4u8,  // R_X86_64_PC32
        2u8 => 8u8,  // R_X86_64_64
        3u8 => 4u8,  // R_X86_64_GOT32
        _ => 4u8,
    }
}

// --- Section Merging Helpers ---

/// Merge sections by kind, combining data from multiple input objects.
/// Effect: pure — bounded merging.
pub fn merge_sections_by_kind(
    objects : &Array64<ObjectFile>,
) -> Array64<MergedSection> [pure] {
    let mut result : Array64<MergedSection> = Array64::new();

    // Create merged sections for each kind.
    let text : MergedSection = MergedSection::new(
        FixedString256::from(".text"), SectionKind::Text,
    );
    let _ = result.push(text);
    let data : MergedSection = MergedSection::new(
        FixedString256::from(".data"), SectionKind::Data,
    );
    let _ = result.push(data);
    let rodata : MergedSection = MergedSection::new(
        FixedString256::from(".rodata"), SectionKind::ReadOnlyData,
    );
    let _ = result.push(rodata);
    let bss : MergedSection = MergedSection::new(
        FixedString256::from(".bss"), SectionKind::BSS,
    );
    let _ = result.push(bss);

    // Bounded: at most 64 objects.
    for var oi : u32 = 0u32; oi < objects.len(); oi += 1u32 [objects.len()] {
        let obj : ObjectFile = objects.get(oi);
        // Bounded: at most 64 sections per object.
        for var si : u32 = 0u32; si < obj.sections.len(); si += 1u32 [obj.sections.len()] {
            let input_sec : Section = obj.sections.get(si);
            // Find matching merged section by kind.
            for var mi : u32 = 0u32; mi < result.len(); mi += 1u32 [result.len()] {
                let mut merged : MergedSection = result.get(mi);
                if merged.kind == input_sec.kind {
                    merged = merged.append(input_sec.data);
                    result.set(mi, merged);
                    break;
                }
            }
        }
    }

    result
}

/// Compute the total memory image size from merged sections.
/// Effect: pure — size computation.
pub fn compute_total_image_size(sections : &Array64<MergedSection>) -> u64 [pure] {
    var total : u64 = 0u64;
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        total += sections.get(i).size;
    }
    total
}

/// Apply all pending relocations to the merged sections.
/// Effect: pure — relocation patching (simulated).
pub fn apply_relocations_to_sections(
    sections : &mut Array64<MergedSection>,
    relocations : &Array64<RelocationEntry>,
    symbols : &Array64<ResolvedSymbol>,
) -> u32 [pure] {
    var applied : u32 = 0u32;
    // Bounded: at most 256 relocations.
    for var ri : u32 = 0u32; ri < relocations.len(); ri += 1u32 [relocations.len()] {
        let reloc : RelocationEntry = relocations.get(ri);
        // Find the symbol address.
        for var si : u32 = 0u32; si < symbols.len(); si += 1u32 [symbols.len()] {
            let sym : ResolvedSymbol = symbols.get(si);
            if sym.name == reloc.symbol_name && sym.is_defined {
                // Apply relocation (simplified: patch bytes).
                applied += 1u32;
                break;
            }
        }
    }
    applied
}

/// Write the final binary image to an output buffer.
/// Effect: pure — binary serialization.
pub fn write_binary_image(
    sections : &Array64<MergedSection>,
    base_address : u64,
    output_buffer : &mut Array256<u8>,
) -> u64 [pure] {
    var written : u64 = 0u64;
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        let sec : MergedSection = sections.get(i);
        // Bounded: at most 256 bytes per section.
        for var j : u32 = 0u32; j < sec.data.len(); j += 1u32 [sec.data.len()] {
            if written < (output_buffer.capacity() as u64) {
                output_buffer.set(written as u32, sec.data.get(j));
                written += 1u64;
            }
        }
    }
    written
}

// --- ELF File Format Helpers ---

/// ELF identification bytes (e_ident).
pub fn create_elf_ident() -> Array256<u8> [pure] {
    let mut ident : Array256<u8> = Array256::new();
    let _ = ident.push(0x7Fu8); // ELF magic: \x7F E L F
    let _ = ident.push(69u8);   // 'E'
    let _ = ident.push(76u8);   // 'L'
    let _ = ident.push(70u8);   // 'F'
    let _ = ident.push(2u8);    // ELFCLASS64 (64-bit)
    let _ = ident.push(1u8);    // ELFDATA2LSB (little endian)
    let _ = ident.push(1u8);    // EV_CURRENT
    let _ = ident.push(0u8);    // ELFOSABI_SYSV
    let _ = ident.push(0u8);    // padding
    let _ = ident.push(0u8);    // padding
    let _ = ident.push(0u8);    // padding
    let _ = ident.push(0u8);    // padding
    let _ = ident.push(0u8);    // padding
    let _ = ident.push(0u8);    // padding
    let _ = ident.push(0u8);    // padding
    let _ = ident.push(0u8);    // padding
    ident
}

/// Create an ELF section header entry.
/// Effect: pure — section header construction.
pub fn create_elf_section_header(
    name_offset : u32,
    sh_type : u32,
    flags : u64,
    addr : u64,
    offset : u64,
    size : u64,
    link : u32,
    info : u32,
    addralign : u64,
    entsize : u64,
) -> Array256<u8> [pure] {
    let mut header : Array256<u8> = Array256::new();
    // sh_name (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((name_offset >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // sh_type (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((sh_type >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // sh_flags (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = header.push(((flags >> (i * 8u32)) & 0xFFu64) as u8);
    }
    // sh_addr (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = header.push(((addr >> (i * 8u32)) & 0xFFu64) as u8);
    }
    // sh_offset (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = header.push(((offset >> (i * 8u32)) & 0xFFu64) as u8);
    }
    // sh_size (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = header.push(((size >> (i * 8u32)) & 0xFFu64) as u8);
    }
    // sh_link (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((link >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // sh_info (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((info >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // sh_addralign (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = header.push(((addralign >> (i * 8u32)) & 0xFFu64) as u8);
    }
    // sh_entsize (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = header.push(((entsize >> (i * 8u32)) & 0xFFu64) as u8);
    }
    header
}

/// Create a symbol table entry.
/// Effect: pure — symbol entry construction.
pub fn create_elf_sym_entry(
    name_offset : u32,
    sym_size : u64,
    sym_value : u64,
    sym_info : u8,
    sym_other : u8,
    shndx : u16,
) -> Array256<u8> [pure] {
    let mut entry : Array256<u8> = Array256::new();
    // st_name (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = entry.push(((name_offset >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // st_info (1 byte)
    let _ = entry.push(sym_info);
    // st_other (1 byte)
    let _ = entry.push(sym_other);
    // st_shndx (2 bytes)
    let _ = entry.push((shndx & 0xFFu16) as u8);
    let _ = entry.push(((shndx >> 8u16) & 0xFFu16) as u8);
    // st_value (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = entry.push(((sym_value >> (i * 8u32)) & 0xFFu64) as u8);
    }
    // st_size (8 bytes)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        let _ = entry.push(((sym_size >> (i * 8u32)) & 0xFFu64) as u8);
    }
    entry
}

// --- PE/COFF Format Helpers ---

/// Create a PE section header.
/// Effect: pure — PE section header.
pub fn create_pe_section_header(
    name : FixedString256,
    virtual_size : u32,
    virtual_address : u32,
    size_of_raw_data : u32,
    pointer_to_raw_data : u32,
    characteristics : u32,
) -> Array256<u8> [pure] {
    let mut header : Array256<u8> = Array256::new();
    // Name (8 bytes, null-padded)
    for var i : u32 = 0u32; i < 8u32; i += 1u32 [8u32] {
        if i < name.len() {
            let _ = header.push(name.get_byte(i));
        } else {
            let _ = header.push(0u8);
        }
    }
    // VirtualSize (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((virtual_size >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // VirtualAddress (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((virtual_address >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // SizeOfRawData (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((size_of_raw_data >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // PointerToRawData (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((pointer_to_raw_data >> (i * 8u32)) & 0xFFu32) as u8);
    }
    // SizeOfRelocations (4 bytes) — zero
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] { let _ = header.push(0u8); }
    // PointerToLinenumbers (4 bytes) — zero
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] { let _ = header.push(0u8); }
    // NumberOfRelocations (2 bytes) — zero
    let _ = header.push(0u8); let _ = header.push(0u8);
    // NumberOfLinenumbers (2 bytes) — zero
    let _ = header.push(0u8); let _ = header.push(0u8);
    // Characteristics (4 bytes)
    for var i : u32 = 0u32; i < 4u32; i += 1u32 [4u32] {
        let _ = header.push(((characteristics >> (i * 8u32)) & 0xFFu32) as u8);
    }
    header
}

// --- Linker Map Output ---

/// Generate a linker map showing symbol addresses.
/// Effect: io — map generation.
pub fn generate_linker_map(
    symbols : &Array64<ResolvedSymbol>,
    sections : &Array64<MergedSection>,
) -> FixedString256 [io] {
    var map : FixedString256 = FixedString256::new();
    map.push_str(FixedString256::from("Linker Map:\n"));
    map.push_str(FixedString256::from("============\n"));
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        let sec : MergedSection = sections.get(i);
        map.push_str(sec.name);
        map.push_str(FixedString256::from(" at 0x"));
        map.push_u64(sec.virtual_address);
        map.push_str(FixedString256::from(", size "));
        map.push_u64(sec.size);
        map.push_str(FixedString256::from("\n"));
    }
    // Bounded: at most 256 symbols.
    for var i : u32 = 0u32; i < symbols.len(); i += 1u32 [symbols.len()] {
        let sym : ResolvedSymbol = symbols.get(i);
        if sym.is_defined {
            map.push_str(FixedString256::from("  0x"));
            map.push_u64(sym.address);
            map.push_str(FixedString256::from("  "));
            map.push_str(sym.name);
            map.push_str(FixedString256::from("\n"));
        }
    }
    map
}

// --- Linker Error Recovery ---

/// Attempt to recover from an unresolved symbol by searching library paths.
/// Effect: pure — recovery attempt.
pub fn try_resolve_from_libraries(
    symbol_name : FixedString256,
    library_paths : &Array64<FixedString256>,
) -> Option<u64> [pure] {
    // Bounded: at most 16 library paths.
    for var i : u32 = 0u32; i < library_paths.len(); i += 1u32 [library_paths.len()] {
        // Would search each library path for the symbol.
        let _ = library_paths.get(i);
    }
    Option::None
}

/// Generate a weak symbol as a fallback for missing symbols.
/// Effect: pure — weak symbol generation.
pub fn generate_weak_fallback(symbol_name : FixedString256) -> ResolvedSymbol [pure] {
    let mut sym : ResolvedSymbol = ResolvedSymbol::new(symbol_name);
    sym.is_weak = true;
    sym.is_defined = true;
    sym.address = 0u64;
    sym
}

/// Check if all sections have non-zero virtual addresses after layout.
/// Effect: pure — layout validation.
pub fn validate_layout(sections : &Array64<MergedSection>) -> bool [pure] {
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        if sections.get(i).virtual_address == 0u64 && sections.get(i).size > 0u64 {
            return false;
        }
    }
    true
}

/// Compute the loadable memory size from all sections.
/// Effect: pure — memory size.
pub fn compute_loadable_size(sections : &Array64<MergedSection>) -> u64 [pure] {
    var size : u64 = 0u64;
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        let sec : MergedSection = sections.get(i);
        let end : u64 = sec.virtual_address + sec.size;
        if end > size { size = end; }
    }
    size
}

/// Convert a linker output to a raw byte buffer.
/// Effect: pure — output serialization.
pub fn output_to_bytes(output : &LinkerOutput) -> Array256<u8> [pure] {
    let mut bytes : Array256<u8> = Array256::new();
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < output.sections.len(); i += 1u32 [output.sections.len()] {
        let sec : MergedSection = output.sections.get(i);
        // Bounded: at most 256 bytes per section.
        for var j : u32 = 0u32; j < sec.data.len(); j += 1u32 [sec.data.len()] {
            if bytes.len() < bytes.capacity() {
                let _ = bytes.push(sec.data.get(j));
            }
        }
    }
    bytes
}

/// Check if two linker outputs represent the same binary.
/// Effect: pure — equality check.
pub fn outputs_match(a : &LinkerOutput, b : &LinkerOutput) -> bool [pure] {
    if a.sections.len() != b.sections.len() { return false; }
    if a.symbols.len() != b.symbols.len() { return false; }
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < a.sections.len(); i += 1u32 [a.sections.len()] {
        if a.sections.get(i).size != b.sections.get(i).size { return false; }
    }
    true
}

/// Estimate the runtime memory footprint from sections.
/// Effect: pure — memory estimation.
pub fn estimate_memory_footprint(sections : &Array64<MergedSection>) -> u64 [pure] {
    var total : u64 = 0u64;
    // Bounded: at most 64 sections.
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        total += sections.get(i).size;
    }
    total
}

/// Calculate the entropy of a linker output (for verification).
/// Effect: pure — entropy calculation.
pub fn calculate_output_entropy(output : &LinkerOutput) -> f64 [pure] {
    var byte_counts : Array256<u32> = Array256::new();
    // Initialize counts to zero.
    for var i : u32 = 0u32; i < 256u32; i += 1u32 [256u32] {
        let _ = byte_counts.push(0u32);
    }
    var total_bytes : u32 = 0u32;
    // Count bytes.
    for var s : u32 = 0u32; s < output.sections.len(); s += 1u32 [output.sections.len()] {
        let sec : MergedSection = output.sections.get(s);
        for var b : u32 = 0u32; b < sec.data.len(); b += 1u32 [sec.data.len()] {
            let byte_val : u32 = sec.data.get(b) as u32;
            byte_counts.set(byte_val, byte_counts.get(byte_val) + 1u32);
            total_bytes += 1u32;
        }
    }
    var entropy : f64 = 0.0f64;
    if total_bytes > 0u32 {
        for var i : u32 = 0u32; i < 256u32; i += 1u32 [256u32] {
            let count : u32 = byte_counts.get(i);
            if count > 0u32 {
                let p : f64 = count as f64 / total_bytes as f64;
                entropy -= p * (p.log());
            }
        }
    }
    entropy
}

/// Normalize a symbol name for cross-platform linking.
/// Effect: pure — name normalization.
pub fn normalize_symbol_name(name : FixedString256) -> FixedString256 [pure] {
    var result : FixedString256 = FixedString256::new();
    for var i : u32 = 0u32; i < name.len() && i < 256u32; i += 1u32 [256u32] {
        let ch : u8 = name.get_byte(i);
        if ch == 46u8 { let _ = result.push_byte(95u8); }
        else if ch == 58u8 { let _ = result.push_byte(95u8); }
        else { let _ = result.push_byte(ch); }
    }
    result
}

/// Get the number of unresolved symbols.
pub fn unresolved_symbol_count(linker : &LinkerState) -> u32 [pure] {
    linker.unresolved_count
}

/// Get the number of applied relocations.
pub fn applied_relocation_count(linker : &LinkerState) -> u32 [pure] {
    linker.relocations_applied
}

/// Check if linking was successful (no unresolved symbols).
pub fn linking_successful(linker : &LinkerState) -> bool [pure] {
    linker.unresolved_count == 0u32
}

/// Format a linker summary string.
pub fn format_linker_summary(linker : &LinkerState) -> FixedString256 [io] {
    var s : FixedString256 = FixedString256::new();
    s.push_str(FixedString256::from("Linker Summary:\n"));
    s.push_str(FixedString256::from("  Objects: ")); s.push_u32(linker.objects.len()); s.push_str(FixedString256::from("\n"));
    s.push_str(FixedString256::from("  Sections: ")); s.push_u32(linker.sections.len()); s.push_str(FixedString256::from("\n"));
    s.push_str(FixedString256::from("  Symbols: ")); s.push_u32(linker.symbols.len()); s.push_str(FixedString256::from("\n"));
    s.push_str(FixedString256::from("  Resolved: ")); s.push_u32(linker.resolved_count); s.push_str(FixedString256::from("\n"));
    s.push_str(FixedString256::from("  Unresolved: ")); s.push_u32(linker.unresolved_count); s.push_str(FixedString256::from("\n"));
    s.push_str(FixedString256::from("  Relocations Applied: ")); s.push_u32(linker.relocations_applied); s.push_str(FixedString256::from("\n"));
    s
}

/// Check if a symbol has been fully resolved with a valid address.
pub fn symbol_is_resolved(sym : &ResolvedSymbol) -> bool [pure] {
    sym.is_defined && !sym.is_extern
}

/// Count defined vs undefined symbols.
pub fn count_symbols_by_status(symbols : &Array64<ResolvedSymbol>) -> (u32, u32) [pure] {
    var defined : u32 = 0u32;
    var undefined : u32 = 0u32;
    for var i : u32 = 0u32; i < symbols.len(); i += 1u32 [symbols.len()] {
        if symbols.get(i).is_defined { defined += 1u32; }
        else { undefined += 1u32; }
    }
    (defined, undefined)
}

/// Get the entry point address from a linker output.
pub fn get_entry_point(output : &LinkerOutput) -> u64 [pure] {
    output.entry_point
}

/// Set the entry point address in a linker output.
pub fn set_entry_point(mut output : LinkerOutput, addr : u64) -> LinkerOutput [pure] {
    output.entry_point = addr;
    output
}

/// Check if all sections have valid alignment.
pub fn validate_section_alignment(sections : &Array64<MergedSection>) -> bool [pure] {
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        let sec : MergedSection = sections.get(i);
        if sec.alignment == 0u64 { return false; }
        if sec.virtual_address % sec.alignment != 0u64 { return false; }
    }
    true
}

/// Check if the output address space overlaps between sections.
pub fn detect_address_overlap(sections : &Array64<MergedSection>) -> bool [pure] {
    for var i : u32 = 0u32; i < sections.len(); i += 1u32 [sections.len()] {
        let a : MergedSection = sections.get(i);
        for var j : u32 = i + 1u32; j < sections.len(); j += 1u32 [sections.len()] {
            let b : MergedSection = sections.get(j);
            let a_end : u64 = a.virtual_address + a.size;
            let b_end : u64 = b.virtual_address + b.size;
            if a.virtual_address < b_end && b.virtual_address < a_end {
                return true;
            }
        }
    }
    false
}

/// Get a resolved symbol's address by name.
pub fn lookup_symbol_address(symbols : &Array64<ResolvedSymbol>, name : FixedString256) -> Option<u64> [pure] {
    for var i : u32 = 0u32; i < symbols.len(); i += 1u32 [symbols.len()] {
        let sym : ResolvedSymbol = symbols.get(i);
        if sym.name == name && sym.is_defined {
            return Option::Some(sym.address);
        }
    }
    Option::None
}

/// Compute the total size of all sections in an output.
pub fn total_output_size(output : &LinkerOutput) -> u64 [pure] {
    var total : u64 = 0u64;
    for var i : u32 = 0u32; i < output.sections.len(); i += 1u32 [output.sections.len()] {
        total += output.sections.get(i).size;
    }
    total
}

/// Get the base address from the linker config.
pub fn get_base_address(config : &LinkerConfig) -> u64 [pure] {
    config.base_address
}

/// Check if output is shared library.
pub fn is_shared(config : &LinkerConfig) -> bool [pure] {
    config.shared
}

/// Get output format name.
pub fn output_format_name(config : &LinkerConfig) -> FixedString256 [pure] {
    match config.output_format {
        OutputFormat::ELF => FixedString256::from("ELF64"),
        OutputFormat::PE => FixedString256::from("PE32+"),
        OutputFormat::MachO => FixedString256::from("Mach-O 64"),
        OutputFormat::Raw => FixedString256::from("raw binary"),
    }
}

/// Get the entry point symbol name.
pub fn get_entry_symbol(config : &LinkerConfig) -> FixedString256 [pure] {
    config.entry_point
}

// --- Linker Error Recovery ---
