// ============================================================================
// verdict.phor — Verdict Types: Accept, Refine, Reject, More-Evidence;
//                 Trust Promotion
// ============================================================================
// Court verdicts are the formal outcome of forensic court sessions. They
// determine whether an object can be promoted to a higher trust state,
// requires refinement, is rejected entirely, or needs more evidence.
// Verdicts are signed, residualized, and form the basis for trust promotion.
// ============================================================================

package "phorensic:verdict:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type VerdictError = enum {
    VerdictAlreadySealed = 0x01,
    EvidenceChainBroken = 0x02,
    InsufficientEvidence = 0x03,
    ConflictingEvidence = 0x04,
    TrustPromotionDenied = 0x05,
    TrustDemotionDenied = 0x06,
    VerdictRequirementsNotMet = 0x07,
    InvalidVerdictForState = 0x08,
    VerdictNotApprovable = 0x09,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

type Option[T] = enum {
    Some(value: T),
    None,
}

// ============================================================================
// Trust State
// ============================================================================

type TrustState = enum {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

// ============================================================================
// Verdict Type
// ============================================================================

type VerdictType = enum {
    Accept = 0x01,
    Refine = 0x02,
    Reject = 0x03,
    MoreEvidence = 0x04,
    NotIssued = 0xFF,
}

// ============================================================================
// Verdict Requirements
// ============================================================================

type VerdictRequirements = struct {
    minimum_observations: u64,
    minimum_replays: u64,
    minimum_oracle_comparisons: u64,
    maximum_divergences: u64,
    requires_court_verification: bool,
    requires_evidence_chain: bool,
    requires_oracle: bool,
    requires_residual_stability: bool,
}

// ============================================================================
// Verdict Record
// ============================================================================

type VerdictRecord = struct {
    verdict_id: Hash256,
    session_id: Hash256,
    object_key: Hash256,
    verdict_type: VerdictType,
    target_trust_state: TrustState,
    current_trust_state: TrustState,
    reason: FixedString[2048],
    evidence_references: Array[Hash256, 32],
    evidence_ref_count: u64,
    additional_evidence_requested: FixedString[1024],
    issued_at: u64,
    issued_by: FixedString[128],
    is_sealed: bool,
    generation: u64,
}

// ============================================================================
// Ver Justification
// ============================================================================

type VerdictJustification = struct {
    verdict_type: VerdictType,
    observation_count: u64,
    replay_count: u64,
    oracle_comparison_count: u64,
    divergence_count: u64,
    evidence_count: u64,
    behavioral_match_ratio: u64,
    confidence_score: u64,
    summary: FixedString[1024],
}

// ============================================================================
// Create Verdict Record
// ============================================================================

fn create_verdict_record(session_id: Hash256, object_key: Hash256, verdict_type: VerdictType, reason: &FixedString[2048], additional_evidence: &FixedString[1024], judge: &FixedString[128]) -> VerdictRecord
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_refs: Array[Hash256, 32] = Array[Hash256, 32]::zeroed();

    // Generate verdict ID from session, object, and type
    let verdict_id: Hash256 = hash_verdict_combine(session_id, object_key, verdict_type as u64);

    let target: TrustState = determine_target_state_from_verdict(verdict_type);

    return VerdictRecord {
        verdict_id: verdict_id,
        session_id: session_id,
        object_key: object_key,
        verdict_type: verdict_type,
        target_trust_state: target,
        current_trust_state: TrustState::Unknown,
        reason: *reason,
        evidence_references: empty_refs,
        evidence_ref_count: 0,
        additional_evidence_requested: *additional_evidence,
        issued_at: kernel.tick_count(),
        issued_by: *judge,
        is_sealed: false,
        generation: 1,
    };
}

// ============================================================================
// Determine Target State from Verdict
// ============================================================================

fn determine_target_state_from_verdict(verdict_type: VerdictType) -> TrustState
    effects: [compute]
{
    match verdict_type {
        VerdictType::Accept => return TrustState::Promoted,
        VerdictType::Refine => return TrustState::Observed,
        VerdictType::Reject => return TrustState::Unknown,
        VerdictType::MoreEvidence => return TrustState::Unknown,
        VerdictType::NotIssued => return TrustState::Unknown,
    }
}

// ============================================================================
// Add Evidence Reference to Verdict
// ============================================================================

fn add_verdict_evidence(verdict: &mut VerdictRecord, evidence_hash: Hash256) -> Result<(), VerdictError>
    effects: [compute, residual]
{
    if verdict.is_sealed {
        return Err(VerdictError::VerdictAlreadySealed);
    }

    if verdict.evidence_ref_count >= 32 {
        return Err(VerdictError::EvidenceChainBroken);
    }

    verdict.evidence_references[verdict.evidence_ref_count] = evidence_hash;
    verdict.evidence_ref_count = verdict.evidence_ref_count + 1;

    return Ok(());
}

// ============================================================================
// Set Current Trust State
// ============================================================================

fn set_current_trust_state(verdict: &mut VerdictRecord, state: TrustState) -> Result<(), VerdictError>
    effects: [compute]
{
    if verdict.is_sealed {
        return Err(VerdictError::VerdictAlreadySealed);
    }

    verdict.current_trust_state = state;
    return Ok(());
}

// ============================================================================
// Seal Verdict Record
// ============================================================================

fn seal_verdict_record(verdict: &mut VerdictRecord) -> Result[Hash256, VerdictError]
    effects: [compute, residual]
{
    if verdict.is_sealed {
        return Err(VerdictError::VerdictAlreadySealed);
    }

    // Verify at least one evidence reference exists
    if verdict.evidence_ref_count == 0 {
        return Err(VerdictError::InsufficientEvidence);
    }

    verdict.is_sealed = true;

    @emit_residual("verdict.seal", "verdict_sealed", verdict.verdict_id);

    return Ok(verdict.verdict_id);
}

// ============================================================================
// Check if Verdict Allows Promotion
// ============================================================================

fn does_verdict_allow_promotion(verdict_type: VerdictType) -> bool
    effects: [compute]
{
    return verdict_type == VerdictType::Accept;
}

// ============================================================================
// Check if Verdict Requires Refinement
// ============================================================================

fn does_verdict_require_refinement(verdict_type: VerdictType) -> bool
    effects: [compute]
{
    return verdict_type == VerdictType::Refine || verdict_type == VerdictType::MoreEvidence;
}

// ============================================================================
// Generate Verdict Justification
// ============================================================================

fn generate_verdict_justification(verdict_type: VerdictType, observation_count: u64, replay_count: u64, oracle_count: u64, divergence_count: u64, evidence_count: u64) -> VerdictJustification
    effects: [compute]
{
    let behavioral_match: u64 = if oracle_count > 0 {
        if divergence_count <= oracle_count {
            ((oracle_count - divergence_count) * 100) / oracle_count
        } else {
            0
        }
    } else {
        if observation_count > 0 { 50 } else { 0 }
    };

    let confidence: u64 = compute_verdict_confidence(verdict_type, observation_count, replay_count, oracle_count, divergence_count);

    let mut summary: FixedString[1024] = FixedString[1024]::zeroed();

    match verdict_type {
        VerdictType::Accept => {
            let text: FixedString[40] = FixedString[40]::from_literal("Evidence sufficient for trust promotion");
            summary = text;
        }
        VerdictType::Refine => {
            let text: FixedString[50] = FixedString[50]::from_literal("Evidence suggests direction but is insufficient");
            summary = text;
        }
        VerdictType::Reject => {
            let text: FixedString[40] = FixedString[40]::from_literal("Evidence shows behavioral divergence");
            summary = text;
        }
        VerdictType::MoreEvidence => {
            let text: FixedString[50] = FixedString[50]::from_literal("Insufficient evidence to make a determination");
            summary = text;
        }
        VerdictType::NotIssued => {
            let text: FixedString[20] = FixedString[20]::from_literal("No verdict issued");
            summary = text;
        }
    }

    return VerdictJustification {
        verdict_type: verdict_type,
        observation_count: observation_count,
        replay_count: replay_count,
        oracle_comparison_count: oracle_count,
        divergence_count: divergence_count,
        evidence_count: evidence_count,
        behavioral_match_ratio: behavioral_match,
        confidence_score: confidence,
        summary: summary,
    };
}

// ============================================================================
// Compute Verdict Confidence
// ============================================================================

fn compute_verdict_confidence(verdict_type: VerdictType, observation_count: u64, replay_count: u64, oracle_count: u64, divergence_count: u64) -> u64
    effects: [compute]
{
    let mut confidence: u64 = 0;

    // Base confidence from observations
    if observation_count >= 10 {
        confidence = confidence + 30;
    } elif observation_count >= 5 {
        confidence = confidence + 20;
    } elif observation_count >= 2 {
        confidence = confidence + 10;
    } elif observation_count >= 1 {
        confidence = confidence + 5;
    }

    // Replay confidence
    if replay_count >= 3 {
        confidence = confidence + 25;
    } elif replay_count >= 1 {
        confidence = confidence + 15;
    }

    // Oracle confidence
    if oracle_count >= 100 {
        confidence = confidence + 30;
    } elif oracle_count >= 10 {
        confidence = confidence + 20;
    } elif oracle_count >= 1 {
        confidence = confidence + 10;
    }

    // Divergence penalty
    if divergence_count > 0 {
        let penalty: u64 = if divergence_count * 5 < confidence { divergence_count * 5 } else { confidence };
        confidence = confidence - penalty;
    }

    // Verdict type adjustment
    match verdict_type {
        VerdictType::Accept => confidence = confidence + 10,
        VerdictType::Reject => confidence = if confidence > 20 { confidence - 20 } else { 0 },
        VerdictType::Refine => confidence = if confidence > 5 { confidence - 5 } else { confidence },
        VerdictType::MoreEvidence => confidence = if confidence > 10 { confidence - 10 } else { confidence },
        VerdictType::NotIssued => confidence = 0,
    }

    // Cap at 100
    if confidence > 100 {
        confidence = 100;
    }

    return confidence;
}

// ============================================================================
// Check Verdict Requirements
// ============================================================================

fn check_verdict_requirements(verdict_type: VerdictType, requirements: &VerdictRequirements, observation_count: u64, replay_count: u64, oracle_count: u64, divergence_count: u64, is_court_verified: bool, has_evidence_chain: bool, has_oracle: bool, is_residual_stable: bool) -> Result<bool, VerdictError>
    effects: [compute]
{
    // Minimum observations
    if observation_count < requirements.minimum_observations {
        return Err(VerdictError::InsufficientEvidence);
    }

    // Minimum replays
    if replay_count < requirements.minimum_replays {
        return Err(VerdictError::InsufficientEvidence);
    }

    // Minimum oracle comparisons
    if oracle_count < requirements.minimum_oracle_comparisons {
        return Err(VerdictError::InsufficientEvidence);
    }

    // Maximum divergences
    if divergence_count > requirements.maximum_divergences {
        return Err(VerdictError::ConflictingEvidence);
    }

    // Requires court verification
    if requirements.requires_court_verification && !is_court_verified {
        return Err(VerdictError::VerdictRequirementsNotMet);
    }

    // Requires evidence chain
    if requirements.requires_evidence_chain && !has_evidence_chain {
        return Err(VerdictError::EvidenceChainBroken);
    }

    // Requires oracle
    if requirements.requires_oracle && !has_oracle {
        return Err(VerdictError::InsufficientEvidence);
    }

    // Requires residual stability
    if requirements.requires_residual_stability && !is_residual_stable {
        return Err(VerdictError::VerdictRequirementsNotMet);
    }

    return Ok(true);
}

// ============================================================================
// Get Default Requirements for Verdict Type
// ============================================================================

fn get_default_requirements(verdict_type: VerdictType) -> VerdictRequirements
    effects: [compute]
{
    match verdict_type {
        VerdictType::Accept => {
            return VerdictRequirements {
                minimum_observations: 3,
                minimum_replays: 3,
                minimum_oracle_comparisons: 10,
                maximum_divergences: 0,
                requires_court_verification: true,
                requires_evidence_chain: true,
                requires_oracle: true,
                requires_residual_stability: true,
            };
        }
        VerdictType::Refine => {
            return VerdictRequirements {
                minimum_observations: 1,
                minimum_replays: 1,
                minimum_oracle_comparisons: 1,
                maximum_divergences: 5,
                requires_court_verification: false,
                requires_evidence_chain: true,
                requires_oracle: false,
                requires_residual_stability: false,
            };
        }
        VerdictType::Reject => {
            return VerdictRequirements {
                minimum_observations: 1,
                minimum_replays: 0,
                minimum_oracle_comparisons: 1,
                maximum_divergences: 0,
                requires_court_verification: false,
                requires_evidence_chain: false,
                requires_oracle: false,
                requires_residual_stability: false,
            };
        }
        VerdictType::MoreEvidence => {
            return VerdictRequirements {
                minimum_observations: 0,
                minimum_replays: 0,
                minimum_oracle_comparisons: 0,
                maximum_divergences: 100,
                requires_court_verification: false,
                requires_evidence_chain: false,
                requires_oracle: false,
                requires_residual_stability: false,
            };
        }
        VerdictType::NotIssued => {
            return VerdictRequirements {
                minimum_observations: 0,
                minimum_replays: 0,
                minimum_oracle_comparisons: 0,
                maximum_divergences: 100,
                requires_court_verification: false,
                requires_evidence_chain: false,
                requires_oracle: false,
                requires_residual_stability: false,
            };
        }
    }
}

// ============================================================================
// Get Verdict Summary
// ============================================================================

type VerdictSummary = struct {
    verdict_id: Hash256,
    session_id: Hash256,
    object_key: Hash256,
    verdict_type: VerdictType,
    target_state: TrustState,
    current_state: TrustState,
    issued_by: FixedString[128],
    issued_at: u64,
    is_sealed: bool,
    evidence_count: u64,
    reason_preview: FixedString[256],
}

fn get_verdict_summary(verdict: &VerdictRecord) -> VerdictSummary
    effects: [compute]
{
    let mut reason_preview: FixedString[256] = FixedString[256]::zeroed();
    let preview_len: u64 = if verdict.reason.len < 256 { verdict.reason.len } else { 256 };
    for i in 0..preview_len {
        reason_preview.data[i] = verdict.reason.data[i];
    }
    reason_preview.len = preview_len;

    return VerdictSummary {
        verdict_id: verdict.verdict_id,
        session_id: verdict.session_id,
        object_key: verdict.object_key,
        verdict_type: verdict.verdict_type,
        target_state: verdict.target_trust_state,
        current_state: verdict.current_trust_state,
        issued_by: verdict.issued_by,
        issued_at: verdict.issued_at,
        is_sealed: verdict.is_sealed,
        evidence_count: verdict.evidence_ref_count,
        reason_preview: reason_preview,
    };
}

// ============================================================================
// Hash Helper
// ============================================================================

fn hash_verdict_combine(a: Hash256, b: Hash256, c: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    let mut tmp: u64 = c;
    for i in 0..8 {
        result.bytes[i] = result.bytes[i] ^ ((tmp >> (i * 8)) & 0xFF) as u8;
    }
    return result;
}

// ============================================================================
// Appeal a Verdict
// ============================================================================
// Allows appealing a verdict by providing new evidence that may change
// the outcome.

type VerdictAppeal = struct {
    original_verdict_id: Hash256,
    appeal_reason: FixedString[2048],
    new_evidence_hashes: Array[Hash256, 32],
    new_evidence_count: u64,
    appeal_status: AppealStatus,
    filed_at: u64,
    resolved_at: u64,
    resolution: FixedString[2048],
}

type AppealStatus = enum {
    Filed = 0x01,
    UnderReview = 0x02,
    Upheld = 0x03,
    Overturned = 0x04,
    Dismissed = 0x05,
}

fn create_verdict_appeal(original_verdict: &VerdictRecord, reason: &FixedString[2048]) -> VerdictAppeal
    effects: [compute]
{
    let empty_evidence: Array[Hash256, 32] = Array[Hash256, 32]::zeroed();

    return VerdictAppeal {
        original_verdict_id: original_verdict.verdict_id,
        appeal_reason: *reason,
        new_evidence_hashes: empty_evidence,
        new_evidence_count: 0,
        appeal_status: AppealStatus::Filed,
        filed_at: kernel.tick_count(),
        resolved_at: 0,
        resolution: FixedString[2048]::zeroed(),
    };
}

fn add_appeal_evidence(appeal: &mut VerdictAppeal, evidence_hash: Hash256) -> Result<(), VerdictError>
    effects: [compute]
{
    if appeal.new_evidence_count >= 32 {
        return Err(VerdictError::InsufficientEvidence);
    }
    appeal.new_evidence_hashes[appeal.new_evidence_count] = evidence_hash;
    appeal.new_evidence_count = appeal.new_evidence_count + 1;
    return Ok(());
}

fn resolve_appeal(appeal: &mut VerdictAppeal, status: AppealStatus, resolution: &FixedString[2048])
    effects: [compute, residual]
{
    appeal.appeal_status = status;
    appeal.resolution = *resolution;
    appeal.resolved_at = kernel.tick_count();

    @emit_residual("verdict.appeal_resolved", "appeal_resolved", status as u64);
}

// ============================================================================
// Verdict Chain
// ============================================================================
// Tracks the history of verdicts for an object across multiple court sessions.

type VerdictChain = struct {
    object_key: Hash256,
    verdicts: Array[VerdictRecord, 32],
    verdict_count: u64,
    current_trust_state: TrustState,
    chain_hash: Hash256,
}

fn create_verdict_chain(object_key: Hash256) -> VerdictChain
    effects: [compute]
{
    let empty_verdicts: Array[VerdictRecord, 32] = Array[VerdictRecord, 32]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    return VerdictChain {
        object_key: object_key,
        verdicts: empty_verdicts,
        verdict_count: 0,
        current_trust_state: TrustState::Unknown,
        chain_hash: zero_hash,
    };
}

fn add_verdict_to_chain(chain: &mut VerdictChain, verdict: VerdictRecord) -> Result<(), VerdictError>
    effects: [compute, residual]
{
    if chain.verdict_count >= 32 {
        return Err(VerdictError::VerdictAlreadySealed);
    }

    let idx: u64 = chain.verdict_count;
    chain.verdicts[idx] = verdict;
    chain.verdict_count = idx + 1;

    // Update current trust state based on latest verdict
    if verdict.verdict_type == VerdictType::Accept {
        if verdict.target_trust_state as u64 > chain.current_trust_state as u64 {
            chain.current_trust_state = verdict.target_trust_state;
        }
    } elif verdict.verdict_type == VerdictType::Reject {
        chain.current_trust_state = TrustState::Unknown;
    }

    // Update chain hash
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    chain.chain_hash = hash_verdict_combine(chain.chain_hash, verdict.verdict_id, idx);

    @emit_residual("verdict.chain_add", "verdict_added_to_chain", idx);

    return Ok(());
}

fn get_latest_verdict(chain: &VerdictChain) -> Option[VerdictRecord]
    effects: [compute]
{
    if chain.verdict_count == 0 {
        return Option::None;
    }
    return Option::Some(chain.verdicts[chain.verdict_count - 1]);
}

fn get_verdict_chain_summary(chain: &VerdictChain) -> FixedString[512]
    effects: [compute]
{
    let mut summary: FixedString[512] = FixedString[512]::zeroed();
    let text: FixedString[40] = FixedString[40]::from_literal("Verdict chain with ");
    for i in 0..40 {
        summary.data[i] = text.data[i];
    }
    summary.len = 40;
    // Append count (simplified)
    return summary;
}

// ============================================================================
// Check Verdict Chain Integrity
// ============================================================================

fn verify_verdict_chain(chain: &VerdictChain) -> bool
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut computed_hash: Hash256 = zero_hash;

    for i in 0..chain.verdict_count {
        let v: VerdictRecord = chain.verdicts[i];
        if !v.is_sealed {
            return false;
        }
        computed_hash = hash_verdict_combine(computed_hash, v.verdict_id, i);
    }

    return computed_hash == chain.chain_hash;
}

// ============================================================================
// Multi-Level Verdict Reasoning
// ============================================================================
// Combines multiple verdicts (e.g., from different oracles) into a
// single aggregated verdict.

type AggregatedVerdict = struct {
    verdict_count: u64,
    accept_count: u64,
    refine_count: u64,
    reject_count: u64,
    more_evidence_count: u64,
    consensus: VerdictType,
    consensus_confidence: u64,
    requires_human_review: bool,
}

fn aggregate_verdicts(verdicts: &Array[VerdictRecord, 16], count: u64) -> AggregatedVerdict
    effects: [compute]
{
    let mut accepts: u64 = 0;
    let mut refines: u64 = 0;
    let mut rejects: u64 = 0;
    let mut more_evidence: u64 = 0;

    for i in 0..count {
        match verdicts[i].verdict_type {
            VerdictType::Accept => accepts = accepts + 1,
            VerdictType::Refine => refines = refines + 1,
            VerdictType::Reject => rejects = rejects + 1,
            VerdictType::MoreEvidence => more_evidence = more_evidence + 1,
            VerdictType::NotIssued => {}
        }
    }

    let majority: u64 = count / 2 + 1;
    let mut consensus: VerdictType = VerdictType::MoreEvidence;
    let mut confidence: u64 = 0;
    let mut needs_review: bool = false;

    if accepts >= majority {
        consensus = VerdictType::Accept;
        confidence = (accepts * 100) / count;
    } elif rejects >= majority {
        consensus = VerdictType::Reject;
        confidence = (rejects * 100) / count;
    } elif refines >= majority {
        consensus = VerdictType::Refine;
        confidence = (refines * 100) / count;
    } else {
        consensus = VerdictType::MoreEvidence;
        confidence = ((accepts + refines) * 100) / count;
        needs_review = true;
    }

    return AggregatedVerdict {
        verdict_count: count,
        accept_count: accepts,
        refine_count: refines,
        reject_count: rejects,
        more_evidence_count: more_evidence,
        consensus: consensus,
        consensus_confidence: confidence,
        requires_human_review: needs_review,
    };
}

// ============================================================================
// Verdict Log
// ============================================================================
// Maintains a searchable log of all verdicts issued.

type VerdictLogEntry = struct {
    entry_index: u64,
    verdict_id: Hash256,
    object_key: Hash256,
    verdict_type: VerdictType,
    target_state: TrustState,
    issued_by: FixedString[128],
    issued_at: u64,
    summary: FixedString[256],
}

type VerdictLog = struct {
    entries: Array[VerdictLogEntry, 1024],
    entry_count: u64,
    generation: u64,
}

fn create_verdict_log() -> VerdictLog
    effects: [compute]
{
    let empty: Array[VerdictLogEntry, 1024] = Array[VerdictLogEntry, 1024]::zeroed();
    return VerdictLog { entries: empty, entry_count: 0, generation: 1 };
}

fn log_verdict(log: &mut VerdictLog, verdict: &VerdictRecord) -> Result<u64, VerdictError>
    effects: [compute, residual]
{
    if log.entry_count >= 1024 {
        return Err(VerdictError::VerdictAlreadySealed);
    }
    let idx: u64 = log.entry_count;
    let mut summary: FixedString[256] = FixedString[256]::zeroed();
    let slen: u64 = if verdict.reason.len < 256 { verdict.reason.len } else { 256 };
    for i in 0..slen {
        summary.data[i] = verdict.reason.data[i];
    }
    summary.len = slen;
    log.entries[idx] = VerdictLogEntry {
        entry_index: idx, verdict_id: verdict.verdict_id, object_key: verdict.object_key,
        verdict_type: verdict.verdict_type, target_state: verdict.target_trust_state,
        issued_by: verdict.issued_by, issued_at: verdict.issued_at, summary: summary,
    };
    log.entry_count = idx + 1;
    return Ok(idx);
}

fn find_verdicts_for_object(log: &VerdictLog, object_key: Hash256) -> Array[VerdictLogEntry, 1024]
    effects: [compute]
{
    let mut results: Array[VerdictLogEntry, 1024] = Array[VerdictLogEntry, 1024]::zeroed();
    let mut count: u64 = 0;
    for i in 0..log.entry_count {
        if log.entries[i].object_key == object_key && count < 1024 {
            results[count] = log.entries[i];
            count = count + 1;
        }
    }
    return results;
}
