// intrusion_detect.phor — Intrusion Detection Subsystem
//
// Provides:
//   - Anomaly detection via residual pattern matching
//   - Known-attack signature database (fixed-capacity)
//   - Behavioral baseline construction and comparison
//   - Alert generation with severity classification
//   - Response actions (block, quarantine, notify, escalate)
//   - Full residual recording on all detection events
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every detection decision produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:intrusion_detect:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_SIGNATURES: u64 = 2048;
const MAX_BASELINE_EVENTS: u64 = 4096;
const MAX_ANOMALY_FEATURES: u64 = 64;
const MAX_ALERTS: u64 = 1024;
const MAX_RESPONSE_ACTIONS: u64 = 64;
const MAX_BASELINE_DIMENSIONS: u64 = 32;
const MAX_ANOMALY_SCORE_HISTORY: u64 = 256;
const MAX_SIGNATURE_PATTERNS: u64 = 128;
const MAX_ALERT_CHAIN: u64 = 32;
const MAX_RESPONSE_PLAN_STEPS: u64 = 16;
const MAX_CORRELATION_GROUP_SIZE: u64 = 64;
const MAX_DETECTION_SOURCES: u64 = 16;
const MAX_ANOMALY_THRESHOLDS: u64 = 8;
const MAX_PATTERN_SEQUENCE_LEN: u64 = 32;
const MAX_BEHAVIORAL_FEATURES: u64 = 16;

effect ids:detect;
effect ids:baseline;
effect ids:alert;
effect ids:respond;

// ──────────────────────────────────────────────
// Intrusion Detection Types
// ──────────────────────────────────────────────

enum AlertSeverity {
    Critical,
    High,
    Medium,
    Low,
    Informational,
}

enum DetectionMethod {
    SignatureMatch,
    AnomalyScore,
    BehavioralDeviation,
    ResidualPattern,
    Heuristic,
    Correlation,
    ThresholdExceeded,
}

enum ResponseActionType {
    Block,
    Quarantine,
    Notify,
    Escalate,
    LogOnly,
    Terminate,
    Isolate,
    RateLimit,
    Capture,
    Investigate,
}

enum BaselineState {
    Learning,
    Established,
    Updating,
    Stale,
    Invalid,
}

enum AnomalyClass {
    NetworkScan,
    PrivilegeEscalation,
    DataExfiltration,
    MalwareActivity,
    PolicyViolation,
    AuthenticationAnomaly,
    ResourceAbuse,
    TimingAnomaly,
    Unknown,
}

enum AlertStatus {
    New,
    Acknowledged,
    Investigating,
    Resolved,
    FalsePositive,
    Dismissed,
}

// ──────────────────────────────────────────────
// Detection Data Structures
// ──────────────────────────────────────────────

struct SignaturePattern {
    pattern_id: u64,
    name: Str(64),
    description: Str(256),
    anomaly_class: AnomalyClass,
    severity: AlertSeverity,
    pattern_data: Array(u64, MAX_SIGNATURE_PATTERNS),
    pattern_length: u64,
    detection_method: DetectionMethod,
    false_positive_rate: u64,
    enabled: bool,
    version: u64,
}

struct BehavioralBaseline {
    baseline_id: u64,
    subject_id: u64,
    state: BaselineState,
    feature_count: u64,
    feature_means: Array(u64, MAX_BASELINE_DIMENSIONS),
    feature_stds: Array(u64, MAX_BASELINE_DIMENSIONS),
    feature_names: Array(Str(32), MAX_BASELINE_DIMENSIONS),
    sample_count: u64,
    last_update: u64,
    deviation_threshold: u64,
    learning_samples_required: u64,
}

struct AnomalyEvent {
    event_id: u64,
    timestamp: u64,
    subject_id: u64,
    object_id: u64,
    anomaly_class: AnomalyClass,
    detection_method: DetectionMethod,
    anomaly_score: u64,
    threshold: u64,
    feature_vector: Array(u64, MAX_ANOMALY_FEATURES),
    feature_count: u64,
    matching_signature: u64,
    baseline_deviation: u64,
    correlated_events: Array(u64, MAX_CORRELATION_GROUP_SIZE),
    correlation_count: u64,
}

struct Alert {
    alert_id: u64,
    timestamp: u64,
    severity: AlertSeverity,
    status: AlertStatus,
    detection_method: DetectionMethod,
    anomaly_class: AnomalyClass,
    subject_id: u64,
    object_id: u64,
    anomaly_score: u64,
    confidence: u64,
    description: Str(256),
    anomaly_event_id: u64,
    correlated_alert_ids: Array(u64, MAX_ALERT_CHAIN),
    correlation_count: u64,
    acknowledged_by: u64,
    acknowledged_time: u64,
    response_plan_id: u64,
}

struct ResponseAction {
    action_id: u64,
    alert_id: u64,
    action_type: ResponseActionType,
    target_subject: u64,
    target_resource: u64,
    duration: u64,
    immediate: bool,
    executed: bool,
    execution_time: u64,
    result: u64,
    reversed: bool,
    audit_emitted: bool,
}

struct DetectionThreshold {
    threshold_id: u64,
    anomaly_class: AnomalyClass,
    min_score: u64,
    max_score: u64,
    min_confidence: u64,
    alert_severity: AlertSeverity,
    auto_respond: bool,
    response_action: ResponseActionType,
}

struct CorrelationRule {
    rule_id: u64,
    name: Str(64),
    window_size: u64,
    min_events: u64,
    target_class: AnomalyClass,
    output_severity: AlertSeverity,
    enabled: bool,
}

struct IntrusionDetectState {
    signatures: Array(SignaturePattern, MAX_SIGNATURES),
    signature_count: u64,
    baselines: Array(BehavioralBaseline, MAX_BASELINE_EVENTS),
    baseline_count: u64,
    anomaly_events: Array(AnomalyEvent, MAX_ALERTS),
    anomaly_count: u64,
    alerts: Array(Alert, MAX_ALERTS),
    alert_count: u64,
    response_actions: Array(ResponseAction, MAX_RESPONSE_ACTIONS),
    action_count: u64,
    thresholds: Array(DetectionThreshold, MAX_ANOMALY_THRESHOLDS),
    threshold_count: u64,
    correlation_rules: Array(CorrelationRule, MAX_CORRELATION_GROUP_SIZE),
    correlation_count: u64,
    global_deviation_threshold: u64,
    learning_mode: bool,
    audit_required: bool,
}

// ──────────────────────────────────────────────
// Signature Management
// ──────────────────────────────────────────────

fn create_signature(
    pattern_id: u64,
    name: Str(64),
    description: Str(256),
    anomaly_class: AnomalyClass,
    severity: AlertSeverity,
    pattern: Array(u64, MAX_SIGNATURE_PATTERNS),
    pattern_len: u64,
) -> SignaturePattern
    effect [ids:detect, compute, residual]
{
    residual emit {
        op: "ids.signature_create",
        id: pattern_id,
        name: name,
        class: anomaly_class as u8,
        severity: severity as u8,
        length: pattern_len,
    };

    return SignaturePattern{
        pattern_id: pattern_id,
        name: name,
        description: description,
        anomaly_class: anomaly_class,
        severity: severity,
        pattern_data: pattern,
        pattern_length: pattern_len,
        detection_method: DetectionMethod::SignatureMatch,
        false_positive_rate: 0,
        enabled: true,
        version: 1,
    };
}

fn add_signature(state: IntrusionDetectState, sig: SignaturePattern) -> IntrusionDetectState
    effect [ids:detect, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    if updated.signature_count < MAX_SIGNATURES {
        updated.signatures[updated.signature_count] = sig;
        updated.signature_count = updated.signature_count + 1;

        residual emit {
            op: "ids.signature_add",
            id: sig.pattern_id,
            name: sig.name,
            total: updated.signature_count,
        };
    }
    return updated;
}

fn enable_signature(state: IntrusionDetectState, pattern_id: u64) -> IntrusionDetectState
    effect [ids:detect, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    for i in 0..updated.signature_count {
        if updated.signatures[i].pattern_id == pattern_id {
            updated.signatures[i].enabled = true;
            residual emit { op: "ids.signature_enable", id: pattern_id };
            break;
        }
    }
    return updated;
}

fn disable_signature(state: IntrusionDetectState, pattern_id: u64) -> IntrusionDetectState
    effect [ids:detect, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    for i in 0..updated.signature_count {
        if updated.signatures[i].pattern_id == pattern_id {
            updated.signatures[i].enabled = false;
            residual emit { op: "ids.signature_disable", id: pattern_id };
            break;
        }
    }
    return updated;
}

fn find_signature_by_id(state: IntrusionDetectState, pattern_id: u64) -> Option(SignaturePattern)
    effect [compute]
{
    for i in 0..state.signature_count {
        if state.signatures[i].pattern_id == pattern_id {
            return Option::Some(state.signatures[i]);
        }
    }
    return Option::None;
}

fn count_signatures_by_class(state: IntrusionDetectState, class: AnomalyClass) -> u64
    effect [compute]
{
    let mut count: u64 = 0;
    for i in 0..state.signature_count {
        if state.signatures[i].anomaly_class == class && state.signatures[i].enabled {
            count = count + 1;
        }
    }
    return count;
}

// ──────────────────────────────────────────────
// Pattern Matching
// ──────────────────────────────────────────────

fn match_signature_pattern(
    pattern: Array(u64, MAX_SIGNATURE_PATTERNS),
    pattern_len: u64,
    sequence: Array(u64, MAX_PATTERN_SEQUENCE_LEN),
    seq_len: u64,
) -> bool
    effect [ids:detect, compute]
{
    if pattern_len == 0 || seq_len == 0 || pattern_len > seq_len {
        return false;
    }
    for i in 0..(seq_len - pattern_len + 1) {
        let mut matches: bool = true;
        for j in 0..pattern_len {
            if sequence[i + j] != pattern[j] {
                matches = false;
                break;
            }
        }
        if matches {
            return true;
        }
    }
    return false;
}

fn signature_scan(
    state: IntrusionDetectState,
    sequence: Array(u64, MAX_PATTERN_SEQUENCE_LEN),
    seq_len: u64,
    subject_id: u64,
    object_id: u64,
) -> (IntrusionDetectState, Option(AnomalyEvent))
    effect [ids:detect, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    let mut matched: Option(AnomalyEvent) = Option::None;

    for i in 0..updated.signature_count {
        let sig: SignaturePattern = updated.signatures[i];
        if !sig.enabled {
            continue;
        }
        let found: bool = match_signature_pattern(
            sig.pattern_data, sig.pattern_length,
            sequence, seq_len,
        );
        if found {
            let event: AnomalyEvent = AnomalyEvent{
                event_id: updated.anomaly_count + 1,
                timestamp: 0,
                subject_id: subject_id,
                object_id: object_id,
                anomaly_class: sig.anomaly_class,
                detection_method: DetectionMethod::SignatureMatch,
                anomaly_score: 100,
                threshold: 50,
                feature_vector: Array::splat(0),
                feature_count: 0,
                matching_signature: sig.pattern_id,
                baseline_deviation: 0,
                correlated_events: Array::splat(0),
                correlation_count: 0,
            };

            if updated.anomaly_count < MAX_ALERTS {
                updated.anomaly_events[updated.anomaly_count] = event;
                updated.anomaly_count = updated.anomaly_count + 1;
            }

            matched = Option::Some(event);

            residual emit {
                op: "ids.signature_match",
                signature: sig.pattern_id,
                name: sig.name,
                subject: subject_id,
                object: object_id,
                severity: sig.severity as u8,
            };

            break;
        }
    }

    return (updated, matched);
}

// ──────────────────────────────────────────────
// Behavioral Baseline
// ──────────────────────────────────────────────

fn create_baseline(subject_id: u64, required_samples: u64) -> BehavioralBaseline
    effect [ids:baseline, compute, residual]
{
    let means: Array(u64, MAX_BASELINE_DIMENSIONS) = Array::splat(0);
    let stds: Array(u64, MAX_BASELINE_DIMENSIONS) = Array::splat(0);
    let names: Array(Str(32), MAX_BASELINE_DIMENSIONS) = Array::splat(Str::from(""));

    residual emit {
        op: "ids.baseline_create",
        subject: subject_id,
        required_samples: required_samples,
    };

    return BehavioralBaseline{
        baseline_id: 0,
        subject_id: subject_id,
        state: BaselineState::Learning,
        feature_count: 0,
        feature_means: means,
        feature_stds: stds,
        feature_names: names,
        sample_count: 0,
        last_update: 0,
        deviation_threshold: 30,
        learning_samples_required: required_samples,
    };
}

fn add_baseline(state: IntrusionDetectState, baseline: BehavioralBaseline) -> IntrusionDetectState
    effect [ids:baseline, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    if updated.baseline_count < MAX_BASELINE_EVENTS {
        updated.baselines[updated.baseline_count] = baseline;
        updated.baseline_count = updated.baseline_count + 1;

        residual emit {
            op: "ids.baseline_add",
            subject: baseline.subject_id,
            features: baseline.feature_count,
        };
    }
    return updated;
}

fn update_baseline(
    baseline: BehavioralBaseline,
    features: Array(u64, MAX_BASELINE_DIMENSIONS),
    feature_count: u64,
) -> BehavioralBaseline
    effect [ids:baseline, compute]
{
    let mut updated: BehavioralBaseline = baseline;
    let new_count: u64 = updated.sample_count + 1;
    updated.sample_count = new_count;

    for i in 0..feature_count {
        let old_mean: u64 = updated.feature_means[i];
        let new_val: u64 = features[i];
        let new_mean: u64 = old_mean + (new_val - old_mean) / new_count;
        updated.feature_means[i] = new_mean;
        let diff: u64 = if new_val > new_mean { new_val - new_mean } else { new_mean - new_val };
        updated.feature_stds[i] = updated.feature_stds[i] + (diff - updated.feature_stds[i]) / new_count;
    }

    if updated.sample_count >= updated.learning_samples_required && updated.state == BaselineState::Learning {
        updated.state = BaselineState::Established;
    }

    return updated;
}

fn compute_deviation_score(
    baseline: BehavioralBaseline,
    features: Array(u64, MAX_BASELINE_DIMENSIONS),
    feature_count: u64,
) -> u64
    effect [ids:detect, compute]
{
    if baseline.state == BaselineState::Learning {
        return 0;
    }
    let mut total_deviation: u64 = 0;
    let mut feature_count_used: u64 = 0;

    for i in 0..feature_count {
        let mean: u64 = baseline.feature_means[i];
        let std: u64 = if baseline.feature_stds[i] > 0 { baseline.feature_stds[i] } else { 1 };
        let val: u64 = features[i];
        let diff: u64 = if val > mean { val - mean } else { mean - val };
        let z_score: u64 = diff / std;
        total_deviation = total_deviation + z_score;
        feature_count_used = feature_count_used + 1;
    }

    let avg_deviation: u64 = if feature_count_used > 0 {
        total_deviation / feature_count_used
    } else {
        0
    };

    return avg_deviation;
}

fn find_baseline_for_subject(state: IntrusionDetectState, subject_id: u64) -> Option(BehavioralBaseline)
    effect [compute]
{
    for i in 0..state.baseline_count {
        if state.baselines[i].subject_id == subject_id {
            return Option::Some(state.baselines[i]);
        }
    }
    return Option::None;
}

// ──────────────────────────────────────────────
// Anomaly Detection
// ──────────────────────────────────────────────

fn detect_anomaly(
    state: IntrusionDetectState,
    subject_id: u64,
    object_id: u64,
    features: Array(u64, MAX_ANOMALY_FEATURES),
    feature_count: u64,
    sequence: Array(u64, MAX_PATTERN_SEQUENCE_LEN),
    seq_len: u64,
) -> (IntrusionDetectState, Option(AnomalyEvent))
    effect [ids:detect, ids:baseline, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    let mut detected: Option(AnomalyEvent) = Option::None;

    let (updated_sig, sig_match): (IntrusionDetectState, Option(AnomalyEvent)) = signature_scan(
        updated, sequence, seq_len, subject_id, object_id,
    );
    updated = updated_sig;
    match sig_match {
        Option::Some(ev) => {
            detected = Option::Some(ev);
        },
        Option::None => {},
    };

    let baseline_opt: Option(BehavioralBaseline) = find_baseline_for_subject(updated, subject_id);
    match baseline_opt {
        Option::Some(baseline) => {
            let deviation: u64 = compute_deviation_score(baseline, features, feature_count);
            if deviation > baseline.deviation_threshold && detected == Option::None {
                let anomaly_event: AnomalyEvent = AnomalyEvent{
                    event_id: updated.anomaly_count + 1,
                    timestamp: 0,
                    subject_id: subject_id,
                    object_id: object_id,
                    anomaly_class: AnomalyClass::Unknown,
                    detection_method: DetectionMethod::AnomalyScore,
                    anomaly_score: deviation,
                    threshold: baseline.deviation_threshold,
                    feature_vector: features,
                    feature_count: feature_count,
                    matching_signature: 0,
                    baseline_deviation: deviation,
                    correlated_events: Array::splat(0),
                    correlation_count: 0,
                };

                if updated.anomaly_count < MAX_ALERTS {
                    updated.anomaly_events[updated.anomaly_count] = anomaly_event;
                    updated.anomaly_count = updated.anomaly_count + 1;
                }
                detected = Option::Some(anomaly_event);
            }

            let updated_baseline: BehavioralBaseline = update_baseline(baseline, features, feature_count);
            for bi in 0..updated.baseline_count {
                if updated.baselines[bi].subject_id == subject_id {
                    updated.baselines[bi] = updated_baseline;
                    break;
                }
            }
        },
        Option::None => {
            let new_baseline: BehavioralBaseline = create_baseline(subject_id, 100);
            updated = add_baseline(updated, new_baseline);
        },
    };

    residual emit {
        op: "ids.anomaly_detect",
        subject: subject_id,
        anomaly_found: match detected {
            Option::Some(_) => 1,
            Option::None => 0,
        },
        baseline_found: match baseline_opt {
            Option::Some(_) => 1,
            Option::None => 0,
        },
    };

    return (updated, detected);
}

fn classify_anomaly(event: AnomalyEvent) -> AlertSeverity
    effect [compute]
{
    let severity: AlertSeverity = if event.anomaly_score >= 90 {
        AlertSeverity::Critical
    } else if event.anomaly_score >= 70 {
        AlertSeverity::High
    } else if event.anomaly_score >= 50 {
        AlertSeverity::Medium
    } else if event.anomaly_score >= 30 {
        AlertSeverity::Low
    } else {
        AlertSeverity::Informational
    };
    return severity;
}

fn compute_confidence(event: AnomalyEvent) -> u64
    effect [compute]
{
    let confidence: u64 = match event.detection_method {
        DetectionMethod::SignatureMatch => 95,
        DetectionMethod::AnomalyScore => {
            if event.anomaly_score > 80 { 80 } else { event.anomaly_score * 80 / 100 }
        },
        DetectionMethod::BehavioralDeviation => {
            if event.baseline_deviation > 50 { 70 } else { 50 }
        },
        DetectionMethod::ResidualPattern => 85,
        _ => 60,
    };
    return confidence;
}

// ──────────────────────────────────────────────
// Alert Management
// ──────────────────────────────────────────────

fn create_alert(
    event: AnomalyEvent,
    severity: AlertSeverity,
) -> Alert
    effect [ids:alert, compute, residual]
{
    residual emit {
        op: "ids.alert_create",
        event: event.event_id,
        severity: severity as u8,
        class: event.anomaly_class as u8,
        subject: event.subject_id,
        score: event.anomaly_score,
    };

    return Alert{
        alert_id: 0,
        timestamp: 0,
        severity: severity,
        status: AlertStatus::New,
        detection_method: event.detection_method,
        anomaly_class: event.anomaly_class,
        subject_id: event.subject_id,
        object_id: event.object_id,
        anomaly_score: event.anomaly_score,
        confidence: compute_confidence(event),
        description: Str::from("Intrusion detected"),
        anomaly_event_id: event.event_id,
        correlated_alert_ids: Array::splat(0),
        correlation_count: 0,
        acknowledged_by: 0,
        acknowledged_time: 0,
        response_plan_id: 0,
    };
}

fn add_alert(state: IntrusionDetectState, alert: Alert) -> IntrusionDetectState
    effect [ids:alert, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    if updated.alert_count < MAX_ALERTS {
        let mut a: Alert = alert;
        a.alert_id = updated.alert_count + 1;
        updated.alerts[updated.alert_count] = a;
        updated.alert_count = updated.alert_count + 1;

        residual emit {
            op: "ids.alert_add",
            id: a.alert_id,
            severity: a.severity as u8,
            subject: a.subject_id,
        };
    }
    return updated;
}

fn acknowledge_alert(state: IntrusionDetectState, alert_id: u64, user_id: u64) -> IntrusionDetectState
    effect [ids:alert, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    for i in 0..updated.alert_count {
        if updated.alerts[i].alert_id == alert_id {
            updated.alerts[i].status = AlertStatus::Acknowledged;
            updated.alerts[i].acknowledged_by = user_id;
            updated.alerts[i].acknowledged_time = 0;

            residual emit {
                op: "ids.alert_acknowledge",
                alert: alert_id,
                user: user_id,
            };

            break;
        }
    }
    return updated;
}

fn resolve_alert(state: IntrusionDetectState, alert_id: u64) -> IntrusionDetectState
    effect [ids:alert, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    for i in 0..updated.alert_count {
        if updated.alerts[i].alert_id == alert_id {
            updated.alerts[i].status = AlertStatus::Resolved;

            residual emit {
                op: "ids.alert_resolve",
                alert: alert_id,
            };

            break;
        }
    }
    return updated;
}

fn get_active_alerts(state: IntrusionDetectState) -> Array(Alert, MAX_ALERTS)
    effect [compute]
{
    let mut active: Array(Alert, MAX_ALERTS) = Array::zeroed();
    let mut count: u64 = 0;
    for i in 0..state.alert_count {
        let alert: Alert = state.alerts[i];
        if alert.status == AlertStatus::New || alert.status == AlertStatus::Acknowledged {
            if count < MAX_ALERTS {
                active[count] = alert;
                count = count + 1;
            }
        }
    }
    return active;
}

fn count_alerts_by_severity(state: IntrusionDetectState, severity: AlertSeverity) -> u64
    effect [compute]
{
    let mut count: u64 = 0;
    for i in 0..state.alert_count {
        if state.alerts[i].severity == severity {
            count = count + 1;
        }
    }
    return count;
}

fn correlate_alerts(state: IntrusionDetectState, window_size: u64) -> IntrusionDetectState
    effect [ids:detect, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    let mut correlated_count: u64 = 0;

    for i in 0..updated.alert_count {
        let alert_a: Alert = updated.alerts[i];
        if alert_a.correlation_count > 0 {
            continue;
        }
        for j in 0..updated.alert_count {
            if i == j {
                continue;
            }
            let alert_b: Alert = updated.alerts[j];
            if alert_a.subject_id == alert_b.subject_id &&
               alert_a.severity as u8 >= AlertSeverity::High as u8 &&
               alert_b.severity as u8 >= AlertSeverity::High as u8 {
                if alert_a.correlation_count < MAX_ALERT_CHAIN {
                    updated.alerts[i].correlated_alert_ids[alert_a.correlation_count] = alert_b.alert_id;
                    updated.alerts[i].correlation_count = updated.alerts[i].correlation_count + 1;
                    correlated_count = correlated_count + 1;
                }
            }
        }
    }

    residual emit {
        op: "ids.alert_correlate",
        correlated: correlated_count,
    };

    return updated;
}

// ──────────────────────────────────────────────
// Response Actions
// ──────────────────────────────────────────────

fn create_response_action(
    alert_id: u64,
    action_type: ResponseActionType,
    target_subject: u64,
    target_resource: u64,
    immediate: bool,
) -> ResponseAction
    effect [ids:respond, compute, residual]
{
    residual emit {
        op: "ids.response_create",
        alert: alert_id,
        action: action_type as u8,
        target_subject: target_subject,
        immediate: if immediate { 1 } else { 0 },
    };

    return ResponseAction{
        action_id: 0,
        alert_id: alert_id,
        action_type: action_type,
        target_subject: target_subject,
        target_resource: target_resource,
        duration: 3600,
        immediate: immediate,
        executed: false,
        execution_time: 0,
        result: 0,
        reversed: false,
        audit_emitted: true,
    };
}

fn add_response_action(state: IntrusionDetectState, action: ResponseAction) -> IntrusionDetectState
    effect [ids:respond, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    if updated.action_count < MAX_RESPONSE_ACTIONS {
        let mut a: ResponseAction = action;
        a.action_id = updated.action_count + 1;
        updated.response_actions[updated.action_count] = a;
        updated.action_count = updated.action_count + 1;

        residual emit {
            op: "ids.response_add",
            id: a.action_id,
            alert: a.alert_id,
            action_type: a.action_type as u8,
        };
    }
    return updated;
}

fn execute_response_action(
    state: IntrusionDetectState,
    action_id: u64,
) -> (IntrusionDetectState, bool)
    effect [ids:respond, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    let mut executed: bool = false;

    for i in 0..updated.action_count {
        if updated.response_actions[i].action_id == action_id && !updated.response_actions[i].executed {
            updated.response_actions[i].executed = true;
            updated.response_actions[i].execution_time = 0;
            updated.response_actions[i].result = 1;
            executed = true;

            residual emit {
                op: "ids.response_execute",
                action: action_id,
                type: updated.response_actions[i].action_type as u8,
                target: updated.response_actions[i].target_subject,
            };

            break;
        }
    }

    return (updated, executed);
}

fn reverse_response_action(
    state: IntrusionDetectState,
    action_id: u64,
) -> IntrusionDetectState
    effect [ids:respond, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    for i in 0..updated.action_count {
        if updated.response_actions[i].action_id == action_id && updated.response_actions[i].executed {
            updated.response_actions[i].reversed = true;
            updated.response_actions[i].executed = false;

            residual emit {
                op: "ids.response_reverse",
                action: action_id,
            };

            break;
        }
    }
    return updated;
}

fn auto_respond_to_alert(
    state: IntrusionDetectState,
    alert: Alert,
) -> (IntrusionDetectState, bool)
    effect [ids:respond, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    let mut responded: bool = false;

    for ti in 0..updated.threshold_count {
        let t: DetectionThreshold = updated.thresholds[ti];
        if t.anomaly_class == alert.anomaly_class &&
           alert.anomaly_score >= t.min_score &&
           alert.anomaly_score <= t.max_score &&
           alert.confidence >= t.min_confidence &&
           t.auto_respond {
            let action: ResponseAction = create_response_action(
                alert.alert_id, t.response_action,
                alert.subject_id, alert.object_id, true,
            );
            updated = add_response_action(updated, action);
            let (updated_act, exec_ok): (IntrusionDetectState, bool) = execute_response_action(updated, action.action_id);
            updated = updated_act;
            responded = exec_ok;

            residual emit {
                op: "ids.auto_respond",
                alert: alert.alert_id,
                threshold: t.threshold_id,
                action: t.response_action as u8,
                success: if exec_ok { 1 } else { 0 },
            };

            break;
        }
    }

    return (updated, responded);
}

// ──────────────────────────────────────────────
// Detection Thresholds
// ──────────────────────────────────────────────

fn add_threshold(state: IntrusionDetectState, threshold: DetectionThreshold) -> IntrusionDetectState
    effect [ids:detect, compute, residual]
{
    let mut updated: IntrusionDetectState = state;
    if updated.threshold_count < MAX_ANOMALY_THRESHOLDS {
        updated.thresholds[updated.threshold_count] = threshold;
        updated.threshold_count = updated.threshold_count + 1;

        residual emit {
            op: "ids.threshold_add",
            id: threshold.threshold_id,
            class: threshold.anomaly_class as u8,
            min: threshold.min_score,
            max: threshold.max_score,
        };
    }
    return updated;
}

// ──────────────────────────────────────────────
// End-to-End Detection Flow
// ──────────────────────────────────────────────

fn process_detection_event(
    state: IntrusionDetectState,
    subject_id: u64,
    object_id: u64,
    features: Array(u64, MAX_ANOMALY_FEATURES),
    feature_count: u64,
    sequence: Array(u64, MAX_PATTERN_SEQUENCE_LEN),
    seq_len: u64,
) -> (IntrusionDetectState, Option(Alert))
    effect [ids:detect, ids:baseline, ids:alert, ids:respond, compute, residual]
{
    let mut updated: IntrusionDetectState = state;

    let (updated_detect, anomaly): (IntrusionDetectState, Option(AnomalyEvent)) = detect_anomaly(
        updated, subject_id, object_id, features, feature_count, sequence, seq_len,
    );
    updated = updated_detect;

    let result_alert: Option(Alert) = match anomaly {
        Option::Some(event) => {
            let severity: AlertSeverity = classify_anomaly(event);
            let alert: Alert = create_alert(event, severity);
            updated = add_alert(updated, alert);
            let (updated_resp, _): (IntrusionDetectState, bool) = auto_respond_to_alert(updated, alert);
            updated = updated_resp;
            Option::Some(alert)
        },
        Option::None => Option::None,
    };

    residual emit {
        op: "ids.process_event",
        subject: subject_id,
        object: object_id,
        anomaly_found: match anomaly {
            Option::Some(_) => 1,
            Option::None => 0,
        },
        alert_generated: match result_alert {
            Option::Some(_) => 1,
            Option::None => 0,
        },
    };

    return (updated, result_alert);
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main() -> IntrusionDetectState
    effect [ids:detect, ids:baseline, ids:alert, ids:respond, compute, io:write, residual]
{
    let mut state: IntrusionDetectState = IntrusionDetectState{
        signatures: Array::zeroed(),
        signature_count: 0,
        baselines: Array::zeroed(),
        baseline_count: 0,
        anomaly_events: Array::zeroed(),
        anomaly_count: 0,
        alerts: Array::zeroed(),
        alert_count: 0,
        response_actions: Array::zeroed(),
        action_count: 0,
        thresholds: Array::zeroed(),
        threshold_count: 0,
        correlation_rules: Array::zeroed(),
        correlation_count: 0,
        global_deviation_threshold: 30,
        learning_mode: true,
        audit_required: true,
    };

    let sig_pattern: Array(u64, MAX_SIGNATURE_PATTERNS) = Array::splat(0);
    sig_pattern[0] = 0xDEAD;
    sig_pattern[1] = 0xBEEF;
    sig_pattern[2] = 0xCAFE;

    let sig: SignaturePattern = create_signature(
        1, Str::from("known_exploit"), Str::from("Detects known exploit pattern"),
        AnomalyClass::MalwareActivity, AlertSeverity::Critical,
        sig_pattern, 3,
    );
    state = add_signature(state, sig);

    let sig2: SignaturePattern = create_signature(
        2, Str::from("port_scan"), Str::from("Port scan detection"),
        AnomalyClass::NetworkScan, AlertSeverity::High,
        sig_pattern, 2,
    );
    state = add_signature(state, sig2);

    let t: DetectionThreshold = DetectionThreshold{
        threshold_id: 1,
        anomaly_class: AnomalyClass::MalwareActivity,
        min_score: 70, max_score: 100,
        min_confidence: 60,
        alert_severity: AlertSeverity::Critical,
        auto_respond: true,
        response_action: ResponseActionType::Quarantine,
    };
    state = add_threshold(state, t);

    let features: Array(u64, MAX_ANOMALY_FEATURES) = Array::splat(0);
    features[0] = 10;
    features[1] = 20;
    features[2] = 30;

    let seq: Array(u64, MAX_PATTERN_SEQUENCE_LEN) = Array::splat(0);
    seq[0] = 0xDEAD;
    seq[1] = 0xBEEF;
    seq[2] = 0xCAFE;

    let (state_after, alert_opt): (IntrusionDetectState, Option(Alert)) = process_detection_event(
        state, 1001, 2001, features, 3, seq, 3,
    );
    state = state_after;

    assert(state.signature_count >= 2, "intrusion_detect: signatures loaded");
    assert(state.alert_count >= 1, "intrusion_detect: alert generated");

    let critical_count: u64 = count_alerts_by_severity(state, AlertSeverity::Critical);

    residual emit {
        op: "intrusion_detect.init_complete",
        signatures: state.signature_count,
        baselines: state.baseline_count,
        anomaly_events: state.anomaly_count,
        alerts: state.alert_count,
        actions: state.action_count,
        thresholds: state.threshold_count,
        critical_alerts: critical_count,
    };

    return state;
}
