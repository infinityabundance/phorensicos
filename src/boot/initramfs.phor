// file: initramfs.phor
// purpose: initramfs — cpio archive parsing, file extraction, early
//          userspace, root filesystem detection, module loading, device
//          node creation, pivot_root
// effects: [io:read, io:write, memory:mmio, deterministic, residual]
// trust: TrustState_Bootstrap → TrustState_Loading

package "phorensic:initramfs:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const CPIO_HEADER_MAGIC: Word16 = 0x71C7
const CPIO_NEWC_MAGIC: FixedString[6] = "070701"
const CPIO_CRC_MAGIC: FixedString[6] = "070702"
const CPIO_TRAILER: FixedString[10] = "TRAILER!!!"
const MAX_CPIO_FILES: u32 = 512
const MAX_FILE_NAME_LEN: u32 = 256
const MAX_FILE_DATA_LEN: u32 = 65536
const INITRAMFS_MAX_SIZE: u32 = 8 * 1024 * 1024  // 8MB
const MAX_MODULE_PARAMS: u32 = 32
const MAX_MODULE_NAME: u32 = 64
const MAX_DEVICE_NODE_PATH: u32 = 128
const MAX_FS_DETECT_ENTRIES: u32 = 16
const EARLY_INIT_STACK_SIZE: u32 = 4096
const PIVOT_ROOT_DIR: FixedString[32] = "/new_root"
const OLD_ROOT_DIR: FixedString[32] = "/old_root"

// CPIO header field offsets (newc format)
const CPIO_OFF_MAGIC: u32 = 0
const CPIO_OFF_INO: u32 = 6
const CPIO_OFF_MODE: u32 = 12
const CPIO_OFF_UID: u32 = 18
const CPIO_OFF_GID: u32 = 24
const CPIO_OFF_NLINK: u32 = 30
const CPIO_OFF_MTIME: u32 = 36
const CPIO_OFF_FILESIZE: u32 = 42
const CPIO_OFF_DEVMAJ: u32 = 48
const CPIO_OFF_DEVMIN: u32 = 54
const CPIO_OFF_RDEVMAJ: u32 = 60
const CPIO_OFF_RDEVMIN: u32 = 66
const CPIO_OFF_NAMESIZE: u32 = 72
const CPIO_OFF_CHKSUM: u32 = 78
const CPIO_HEADER_SIZE: u32 = 110

// File types
const CPIO_MODE_IFMT: u32 = 0xF000
const CPIO_MODE_IFSOCK: u32 = 0xC000
const CPIO_MODE_IFLNK: u32 = 0xA000
const CPIO_MODE_IFREG: u32 = 0x8000
const CPIO_MODE_IFBLK: u32 = 0x6000
const CPIO_MODE_IFDIR: u32 = 0x4000
const CPIO_MODE_IFCHR: u32 = 0x2000
const CPIO_MODE_IFIFO: u32 = 0x1000

// Filesystem detection magic numbers
const FS_MAGIC_EXT2: Word16 = 0xEF53
const FS_MAGIC_BTRFS: u64 = 0x9123683E
const FS_MAGIC_F2FS: Word32 = 0xF2F52010

// ──────────────────────────────────────────────
// CPIO Entry
// ──────────────────────────────────────────────

pub type CPIOEntry : struct {
    ino: Word32,
    mode: Word32,
    uid: Word32,
    gid: Word32,
    nlink: Word32,
    mtime: Word32,
    file_size: Word32,
    dev_major: Word32,
    dev_minor: Word32,
    rdev_major: Word32,
    rdev_minor: Word32,
    name_size: Word32,
    checksum: Word32,
    name: FixedString[MAX_FILE_NAME_LEN],
    data: FixedArray[MAX_FILE_DATA_LEN, u8],
    data_length: u32,
    header_valid: bool,
}

impl CPIOEntry {
    pub fn new() -> CPIOEntry
        effects: [deterministic]
    {
        CPIOEntry {
            ino: 0,
            mode: 0,
            uid: 0,
            gid: 0,
            nlink: 0,
            mtime: 0,
            file_size: 0,
            dev_major: 0,
            dev_minor: 0,
            rdev_major: 0,
            rdev_minor: 0,
            name_size: 0,
            checksum: 0,
            name: FixedString::new(),
            data: FixedArray::new(),
            data_length: 0,
            header_valid: false,
        }
    }

    pub fn is_directory(self) -> bool
        effects: [deterministic]
    {
        (self.mode & CPIO_MODE_IFMT) == CPIO_MODE_IFDIR
    }

    pub fn is_regular_file(self) -> bool
        effects: [deterministic]
    {
        (self.mode & CPIO_MODE_IFMT) == CPIO_MODE_IFREG
    }

    pub fn is_symlink(self) -> bool
        effects: [deterministic]
    {
        (self.mode & CPIO_MODE_IFMT) == CPIO_MODE_IFLNK
    }

    pub fn is_block_device(self) -> bool
        effects: [deterministic]
    {
        (self.mode & CPIO_MODE_IFMT) == CPIO_MODE_IFBLK
    }

    pub fn is_char_device(self) -> bool
        effects: [deterministic]
    {
        (self.mode & CPIO_MODE_IFMT) == CPIO_MODE_IFCHR
    }

    pub fn is_fifo(self) -> bool
        effects: [deterministic]
    {
        (self.mode & CPIO_MODE_IFMT) == CPIO_MODE_IFIFO
    }

    pub fn is_trailer(self) -> bool
        effects: [deterministic]
    {
        self.name == FixedString::from("TRAILER!!!")
    }

    pub fn permissions(self) -> Word32
        effects: [deterministic]
    {
        self.mode & 0x0FFF
    }
}

// ──────────────────────────────────────────────
// CPIO Archive
// ──────────────────────────────────────────────

pub type CPIOArchive : struct {
    entries: FixedArray[MAX_CPIO_FILES, CPIOEntry],
    num_entries: u32,
    total_size: u32,
    valid: bool,
}

impl CPIOArchive {
    pub fn new() -> CPIOArchive
        effects: [deterministic]
    {
        CPIOArchive {
            entries: FixedArray::new(),
            num_entries: 0,
            total_size: 0,
            valid: false,
        }
    }

    pub fn add_entry(self: ref mut, entry: CPIOEntry) -> Result<(), BootError>
        effects: [deterministic]
    {
        if self.num_entries >= MAX_CPIO_FILES {
            return Result::Err(BootError::new(
                DIAG_INITRAMFS_BASE | 0x001,
                "Maximum CPIO entries exceeded"
            ))
        }
        self.entries.set(self.num_entries, entry)!
        self.num_entries = self.num_entries + 1
        self.total_size = self.total_size + entry.file_size
        Result::Ok(())
    }

    pub fn find_entry(self, name: FixedString[MAX_FILE_NAME_LEN]) -> Result[CPIOEntry, BootError>
        effects: [deterministic]
    {
        for i in 0..self.num_entries {
            let entry: CPIOEntry = self.entries.get(i)!
            if entry.name == name && !entry.is_trailer() {
                return Result::Ok(entry)
            }
        }
        Result::Err(BootError::new(
            DIAG_INITRAMFS_BASE | 0x002,
            "CPIO entry not found"
        ))
    }

    pub fn find_entries_by_prefix(self, prefix: FixedString[MAX_FILE_NAME_LEN]) -> FixedArray[MAX_CPIO_FILES, CPIOEntry>
        effects: [deterministic]
    {
        let mut matches: FixedArray[MAX_CPIO_FILES, CPIOEntry] = FixedArray::new()
        let prefix_len: u32 = prefix.len()

        for i in 0..self.num_entries {
            let entry: CPIOEntry = self.entries.get(i)!
            if entry.name.len() >= prefix_len {
                let name_prefix: FixedString[MAX_FILE_NAME_LEN] = entry.name.substring(0, prefix_len)
                if name_prefix == prefix {
                    matches.push(entry)!
                }
            }
        }

        matches
    }

    pub fn find_kernel_modules(self) -> FixedArray[MAX_CPIO_FILES, CPIOEntry>
        effects: [deterministic]
    {
        self.find_entries_by_prefix(FixedString::from("lib/modules/"))
    }

    pub fn find_firmware_files(self) -> FixedArray[MAX_CPIO_FILES, CPIOEntry>
        effects: [deterministic]
    {
        self.find_entries_by_prefix(FixedString::from("lib/firmware/"))
    }
}

// ──────────────────────────────────────────────
// CPIO Parser
// ──────────────────────────────────────────────

pub fn parse_cpio_archive(data: &[u8], size: u32) -> Result[CPIOArchive, BootError>
    effects: [deterministic]
{
    let mut archive: CPIOArchive = CPIOArchive::new()
    let mut offset: u32 = 0

    loop: bounds[BOUND_LARGE] while offset + CPIO_HEADER_SIZE <= size {
        // Read magic
        let magic_str: FixedString[6] = {
            let mut s: FixedString[6] = FixedString::new()
            for i in 0..6 {
                let idx: u32 = offset + i
                if idx < data.len() as u32 {
                    s.append_byte(data[idx as usize])!
                }
            }
            s
        }

        // Validate magic
        if magic_str != CPIO_NEWC_MAGIC && magic_str != CPIO_CRC_MAGIC {
            // Try to align - may be padding between entries
            offset = offset + 1
            if offset >= size {
                break
            }
            continue
        }

        // Parse header
        let entry: CPIOEntry = parse_cpio_header(data, offset)!

        let name_size: u32 = entry.name_size
        let aligned_name_size: u32 = (name_size + 3) & 0xFFFF_FFFC
        let file_size: u32 = entry.file_size
        let aligned_file_size: u32 = (file_size + 3) & 0xFFFF_FFFC

        // Read filename
        let name_offset: u32 = offset + CPIO_HEADER_SIZE
        let mut name: FixedString[MAX_FILE_NAME_LEN] = FixedString::new()
        for i in 0..name_size {
            if name_offset + i < data.len() as u32 {
                let ch: u8 = data[(name_offset + i) as usize]
                if ch == 0 { break }
                name.append_byte(ch)!
            }
        }

        let mut entry_with_name: CPIOEntry = entry
        entry_with_name.name = name

        // Check for trailer
        if entry_with_name.is_trailer() {
            archive.valid = true
            break
        }

        // Read file data
        let data_offset: u32 = name_offset + aligned_name_size
        for i in 0..file_size {
            if data_offset + i < data.len() as u32 && i < MAX_FILE_DATA_LEN {
                entry_with_name.data.push(data[(data_offset + i) as usize])!
            }
        }
        entry_with_name.data_length = file_size

        archive.add_entry(entry_with_name)!

        // Move to next entry
        offset = data_offset + aligned_file_size

        if offset >= size {
            break
        }
    }

    if !archive.valid {
        return Result::Err(BootError::new(
            DIAG_INITRAMFS_BASE | 0x010,
            "Invalid CPIO archive: no trailer entry found"
        ))
    }

    Result::Ok(archive)
}

fn parse_cpio_header(data: &[u8], offset: u32) -> Result[CPIOEntry, BootError>
    effects: [deterministic]
{
    if offset + CPIO_HEADER_SIZE > data.len() as u32 {
        return Result::Err(BootError::new(
            DIAG_INITRAMFS_BASE | 0x020,
            "CPIO header exceeds data buffer"
        ))
    }

    let entry: CPIOEntry = CPIOEntry {
        ino: parse_cpio_hex_word32(data, offset + CPIO_OFF_INO),
        mode: parse_cpio_hex_word32(data, offset + CPIO_OFF_MODE),
        uid: parse_cpio_hex_word32(data, offset + CPIO_OFF_UID),
        gid: parse_cpio_hex_word32(data, offset + CPIO_OFF_GID),
        nlink: parse_cpio_hex_word32(data, offset + CPIO_OFF_NLINK),
        mtime: parse_cpio_hex_word32(data, offset + CPIO_OFF_MTIME),
        file_size: parse_cpio_hex_word32(data, offset + CPIO_OFF_FILESIZE),
        dev_major: parse_cpio_hex_word32(data, offset + CPIO_OFF_DEVMAJ),
        dev_minor: parse_cpio_hex_word32(data, offset + CPIO_OFF_DEVMIN),
        rdev_major: parse_cpio_hex_word32(data, offset + CPIO_OFF_RDEVMAJ),
        rdev_minor: parse_cpio_hex_word32(data, offset + CPIO_OFF_RDEVMIN),
        name_size: parse_cpio_hex_word32(data, offset + CPIO_OFF_NAMESIZE),
        checksum: parse_cpio_hex_word32(data, offset + CPIO_OFF_CHKSUM),
        name: FixedString::new(),
        data: FixedArray::new(),
        data_length: 0,
        header_valid: true,
    }

    Result::Ok(entry)
}

fn parse_cpio_hex_word32(data: &[u8], offset: u32) -> Word32
    effects: [deterministic]
{
    let mut value: Word32 = 0
    for i in 0..8 {
        let idx: u32 = offset + i
        if idx >= data.len() as u32 { break }
        let ch: u8 = data[idx as usize]
        let digit: u32 = hex_char_to_u32(ch)
        value = (value << 4) | digit
    }
    value
}

fn hex_char_to_u32(ch: u8) -> Word32
    effects: [deterministic]
{
    if ch >= '0' as u8 && ch <= '9' as u8 {
        (ch - '0' as u8) as u32
    } else if ch >= 'a' as u8 && ch <= 'f' as u8 {
        (ch - 'a' as u8 + 10) as u32
    } else if ch >= 'A' as u8 && ch <= 'F' as u8 {
        (ch - 'A' as u8 + 10) as u32
    } else {
        0
    }
}

// ──────────────────────────────────────────────
// File Extraction
// ──────────────────────────────────────────────

pub fn extract_initramfs_files(archive: ref CPIOArchive, dest_base: FixedString[MAX_FILE_NAME_LEN]) -> Result<u32, BootError>
    effects: [io:write, memory:mmio, deterministic]
{
    let mut extracted_count: u32 = 0

    for i in 0..archive.num_entries {
        let entry: CPIOEntry = archive.entries.get(i)!
        if entry.is_trailer() { continue }

        let full_path: FixedString[512] = build_full_path(dest_base, entry.name)

        if entry.is_directory() {
            extract_directory(full_path)!
            extracted_count = extracted_count + 1
        } else if entry.is_regular_file() {
            extract_regular_file(full_path, entry.data, entry.data_length, entry.permissions())!
            extracted_count = extracted_count + 1
        } else if entry.is_symlink() {
            extract_symlink(full_path, entry.data, entry.data_length)!
            extracted_count = extracted_count + 1
        } else if entry.is_char_device() || entry.is_block_device() {
            extract_device_node(full_path, entry.mode, entry.rdev_major, entry.rdev_minor)!
            extracted_count = extracted_count + 1
        }
    }

    residual emit {
        event: "initramfs.extracted",
        file_count: extracted_count,
        total_entries: archive.num_entries,
    }

    Result::Ok(extracted_count)
}

fn build_full_path(base: FixedString[MAX_FILE_NAME_LEN], name: FixedString[MAX_FILE_NAME_LEN]) -> FixedString[512]
    effects: [deterministic]
{
    let mut path: FixedString[512] = FixedString::new()
    path.append_str(base)

    // Ensure base ends with /
    if base.len() > 0 && base.byte_at(base.len() - 1) != '/' as u8 {
        path.append_byte('/' as u8)!
    }

    path.append_str(name)
    path
}

fn extract_directory(path: FixedString[512]) -> Result<(), BootError>
    effects: [io:write, deterministic]
{
    trusted "initramfs: Create directory via early filesystem, posix mkdir equivalent"
    {
        Result::Ok(())
    }
}

fn extract_regular_file(path: FixedString[512], data: FixedArray[MAX_FILE_DATA_LEN, u8], size: u32, mode: Word32) -> Result<(), BootError>
    effects: [io:write, deterministic]
{
    trusted "initramfs: Write file with data and permissions to early filesystem"
    {
