    devices
}

// ──────────────────────────────────────────────
// Module Loading
// ──────────────────────────────────────────────

pub type KernelModule : struct {
    name: FixedString[MAX_MODULE_NAME],
    path: FixedString[CONFIG_PATH_LEN],
    data: FixedArray[MAX_FILE_DATA_LEN, u8],
    data_size: u32,
    params: FixedArray[MAX_MODULE_PARAMS, FixedString[128]],
    num_params: u32,
    dependencies: FixedArray[MAX_MODULE_PARAMS, FixedString[MAX_MODULE_NAME]],
    num_deps: u32,
}

impl KernelModule {
    pub fn new() -> KernelModule
        effects: [deterministic]
    {
        KernelModule {
            name: FixedString::new(),
            path: FixedString::new(),
            data: FixedArray::new(),
            data_size: 0,
            params: FixedArray::new(),
            num_params: 0,
            dependencies: FixedArray::new(),
            num_deps: 0,
        }
    }

    pub fn add_param(self: ref mut, param: FixedString[128]) -> Result<(), BootError>
        effects: [deterministic]
    {
        if self.num_params >= MAX_MODULE_PARAMS {
            return Result::Err(BootError::new(
                DIAG_INITRAMFS_BASE | 0x030,
                "Maximum module parameters exceeded"
            ))
        }
        self.params.set(self.num_params, param)!
        self.num_params = self.num_params + 1
        Result::Ok(())
    }

    pub fn add_dependency(self: ref mut, dep: FixedString[MAX_MODULE_NAME]) -> Result<(), BootError>
        effects: [deterministic]
    {
        if self.num_deps >= MAX_MODULE_PARAMS {
            return Result::Err(BootError::new(
                DIAG_INITRAMFS_BASE | 0x031,
                "Maximum module dependencies exceeded"
            ))
        }
        self.dependencies.set(self.num_deps, dep)!
        self.num_deps = self.num_deps + 1
        Result::Ok(())
    }
}

pub fn load_kernel_modules(archive: ref CPIOArchive, module_list: FixedArray[MAX_MODULE_PARAMS, FixedString[MAX_MODULE_NAME]], count: u32) -> Result<u32, BootError>
    effects: [io:write, deterministic]
{
    let mut loaded_count: u32 = 0

    for i in 0..count {
        let module_name: FixedString[MAX_MODULE_NAME] = module_list.get(i)!

        // Search for module in initramfs
        let mut search_path: FixedString[CONFIG_PATH_LEN] = FixedString::from("lib/modules/")
        search_path.append_str(module_name)
        search_path.append_str(FixedString::from(".ko"))

        let entry_result: Result[CPIOEntry, BootError> = archive.find_entry(search_path)
        if entry_result.is_ok() {
            let entry: CPIOEntry = entry_result.unwrap()
            load_single_kernel_module(module_name, entry.data, entry.data_length)!
            loaded_count = loaded_count + 1
        }
    }

    residual emit {
        event: "initramfs.modules_loaded",
        requested: count,
        loaded: loaded_count,
    }

    Result::Ok(loaded_count)
}

fn load_single_kernel_module(name: FixedString[MAX_MODULE_NAME], data: FixedArray[MAX_FILE_DATA_LEN, u8], size: u32) -> Result<(), BootError>
    effects: [io:write, deterministic]
{
    trusted "Kernel module loading: Allocate memory, copy ELF module, call module_init via sys_init_module, Linux kernel module loader §3.5"
    {
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Device Node Creation
// ──────────────────────────────────────────────

pub type DeviceNode : struct {
    path: FixedString[MAX_DEVICE_NODE_PATH],
    node_type: u32,  // 0 = char, 1 = block
    major: Word32,
    minor: Word32,
    permissions: Word32,
    uid: Word32,
    gid: Word32,
}

impl DeviceNode {
    pub fn new() -> DeviceNode
        effects: [deterministic]
    {
        DeviceNode {
            path: FixedString::new(),
            node_type: 0,
            major: 0,
            minor: 0,
            permissions: 0x0666,
            uid: 0,
            gid: 0,
        }
    }
}

pub fn create_early_device_nodes() -> Result<u32, BootError>
    effects: [io:write, deterministic]
{
    let mut created_count: u32 = 0

    // Essential device nodes
    let essential_nodes: FixedArray[8, DeviceNode] = {
        let mut nodes: FixedArray[8, DeviceNode] = FixedArray::new()

        let mut console_dev: DeviceNode = DeviceNode::new()
        console_dev.path = FixedString::from("/dev/console")
        console_dev.node_type = 0
        console_dev.major = 5
        console_dev.minor = 1
        console_dev.permissions = 0x0622
        nodes.push(console_dev)!

        let mut null_dev: DeviceNode = DeviceNode::new()
        null_dev.path = FixedString::from("/dev/null")
        null_dev.node_type = 0
        null_dev.major = 1
        null_dev.minor = 3
        null_dev.permissions = 0x0666
        nodes.push(null_dev)!

        let mut zero_dev: DeviceNode = DeviceNode::new()
        zero_dev.path = FixedString::from("/dev/zero")
        zero_dev.node_type = 0
        zero_dev.major = 1
        zero_dev.minor = 5
        zero_dev.permissions = 0x0666
        nodes.push(zero_dev)!

        let mut random_dev: DeviceNode = DeviceNode::new()
        random_dev.path = FixedString::from("/dev/random")
        random_dev.node_type = 0
        random_dev.major = 1
        random_dev.minor = 8
        random_dev.permissions = 0x0666
        nodes.push(random_dev)!

        let mut urandom_dev: DeviceNode = DeviceNode::new()
        urandom_dev.path = FixedString::from("/dev/urandom")
        urandom_dev.node_type = 0
        urandom_dev.major = 1
        urandom_dev.minor = 9
        urandom_dev.permissions = 0x0666
        nodes.push(urandom_dev)!

        let mut tty_dev: DeviceNode = DeviceNode::new()
        tty_dev.path = FixedString::from("/dev/tty")
        tty_dev.node_type = 0
        tty_dev.major = 5
        tty_dev.minor = 0
        tty_dev.permissions = 0x0666
        nodes.push(tty_dev)!

        let mut sda_dev: DeviceNode = DeviceNode::new()
        sda_dev.path = FixedString::from("/dev/sda")
        sda_dev.node_type = 1
        sda_dev.major = 8
        sda_dev.minor = 0
        sda_dev.permissions = 0x0660
        nodes.push(sda_dev)!

        let mut nvme_dev: DeviceNode = DeviceNode::new()
        nvme_dev.path = FixedString::from("/dev/nvme0n1")
        nvme_dev.node_type = 1
        nvme_dev.major = 259
        nvme_dev.minor = 0
        nvme_dev.permissions = 0x0660
        nodes.push(nvme_dev)!

        nodes
    }

    for i in 0..8 {
        let node: DeviceNode = essential_nodes.get(i)!
        create_single_device_node(node)!
        created_count = created_count + 1
    }

    residual emit {
        event: "initramfs.devices_created",
        count: created_count,
    }

    Result::Ok(created_count)
}

fn create_single_device_node(node: DeviceNode) -> Result<(), BootError>
    effects: [io:write, deterministic]
{
    trusted "Device node creation: mknod syscall in early init, Linux kernel mknod(2) documented in man-pages §2"
    {
        Result::Ok(())
    }
}

// ──────────────────────────────────────────────
// Early Userspace & pivot_root
// ──────────────────────────────────────────────

pub type EarlyUserspace : struct {
    initramfs_archive: CPIOArchive,
    root_device: RootDevice,
    console: Cap(Console),
    modules_loaded: u32,
    devices_created: u32,
    files_extracted: u32,
    init_path: FixedString[CONFIG_PATH_LEN],
}

impl EarlyUserspace {
    pub fn new(console: Cap(Console)) -> EarlyUserspace
        effects: [deterministic]
    {
        EarlyUserspace {
            initramfs_archive: CPIOArchive::new(),
            root_device: RootDevice::new(),
            console: console,
            modules_loaded: 0,
            devices_created: 0,
            files_extracted: 0,
            init_path: FixedString::from("/sbin/init"),
        }
    }

    pub fn initialize(self: ref mut, initramfs_data: &[u8], data_size: u32)
        effects: [io:write, io:read, residual]
    {
        self.console.write_line("initramfs: Initializing early userspace...")!

        // Parse CPIO archive
        let archive_result: Result[CPIOArchive, BootError> = parse_cpio_archive(initramfs_data, data_size)
        if archive_result.is_ok() {
            self.initramfs_archive = archive_result.unwrap()
            self.console.write_line(concat("initramfs: Archive parsed, ", self.initramfs_archive.num_entries, " entries"))!
        } else {
            self.console.write_error(FixedString::from("initramfs: Failed to parse CPIO archive"))!
            return
        }

        // Extract files to rootfs
        let extract_result: Result[u32, BootError> = extract_initramfs_files(self.initramfs_archive, FixedString::from("/"))
        if extract_result.is_ok() {
            self.files_extracted = extract_result.unwrap()
            self.console.write_line(concat("initramfs: Extracted ", self.files_extracted, " files"))!
        }

        // Create device nodes
        let dev_result: Result[u32, BootError> = create_early_device_nodes()
        if dev_result.is_ok() {
            self.devices_created = dev_result.unwrap()
            self.console.write_line(concat("initramfs: Created ", self.devices_created, " device nodes"))!
        }

        // Load essential modules
        let essential_modules: FixedArray[8, FixedString[MAX_MODULE_NAME]] = {
            let mut mods: FixedArray[8, FixedString[MAX_MODULE_NAME]] = FixedArray::new()
            mods.push(FixedString::from("ext4"))!
            mods.push(FixedString::from("ahci"))!
            mods.push(FixedString::from("nvme"))!
            mods
        }
        let mod_result: Result[u32, BootError> = load_kernel_modules(
            self.initramfs_archive, essential_modules, 3
        )
        if mod_result.is_ok() {
            self.modules_loaded = mod_result.unwrap()
        }

        residual emit {
            event: "initramfs.early_userspace_ready",
            archive_entries: self.initramfs_archive.num_entries,
            files_extracted: self.files_extracted,
            devices_created: self.devices_created,
            modules_loaded: self.modules_loaded,
        }
    }

    pub fn prepare_root_filesystem(self: ref mut, root_device_path: FixedString[CONFIG_PATH_LEN])
        effects: [io:write, io:read, deterministic]
    {
        self.console.write_line(concat("initramfs: Preparing root filesystem on ", root_device_path))!

        let device_result: Result[RootDevice, BootError> = detect_root_filesystem(root_device_path)
        if device_result.is_ok() {
            self.root_device = device_result.unwrap()
            self.console.write_line(concat("initramfs: Detected ", self.root_device.fs_type, " filesystem"))!
        }

        trusted "Root filesystem mount: mount syscall for detected filesystem type, Linux kernel mount(2) §2"
        {
            // In real implementation: mount(root_device_path, "/new_root", fs_type_str, 0, NULL)
            self.console.write_line("initramfs: Root filesystem mounted")!
        }
    }

    pub fn perform_pivot_root(self: ref mut) -> Result[(), BootError>
        effects: [io:write, deterministic]
    {
        self.console.write_line("initramfs: Performing pivot_root...")!

        trusted "pivot_root: Move current root to old_root and put new root in place. Linux kernel pivot_root(2) documented in man-pages §2"
        {
            // In real implementation:
            // 1. mkdir("/new_root", 0755)
            // 2. mkdir("/old_root", 0755)
            // 3. mount(root_device, "/new_root", ...)
            // 4. pivot_root("/new_root", "/old_root")
            // 5. chdir("/")
            // 6. umount("/old_root")
            // 7. exec(/sbin/init)
            self.console.write_line("initramfs: pivot_root complete, switching to root filesystem")!
            Result::Ok(())
        }
    }

    pub fn switch_to_root(self: ref mut)
        effects: [io:write, deterministic]
    {
        self.console.write_line("initramfs: Switching to root filesystem init...")!

        residual emit {
            event: "initramfs.switch_to_root",
            init_path: self.init_path,
            root_fs_type: self.root_device.fs_type,
        }

        trusted "exec(/sbin/init): Switch to real root init process. Linux kernel execve(2) §2"
        {
            // In real implementation: execve("/sbin/init", argv, envp)
            // This function does not return on success
        }
    }
}

// ──────────────────────────────────────────────
// Helper: concat with integer
// ──────────────────────────────────────────────

fn concat(a: FixedString[64], b: u32) -> FixedString[128]
    effects: [deterministic]
{
    let mut result: FixedString[128] = FixedString::new()
    result.append_str(a)
    result.append_int(b)
    result
}

fn concat(a: FixedString[64], b: FixedString[64]) -> FixedString[128]
    effects: [deterministic]
{
    let mut result: FixedString[128] = FixedString::new()
    result.append_str(a)
    result.append_str(b)
    result
}

// ──────────────────────────────────────────────
// Diagnostic base
// ──────────────────────────────────────────────

const DIAG_INITRAMFS_BASE: Word64 = 0x0800_0000_0000_0000
const DIAG_MENU_BASE: Word64 = 0x0700_0000_0000_0000
const DIAG_CONFIG_BASE: Word64 = 0x0600_0000_0000_0000

const CONFIG_PATH_LEN: u32 = 256

// ──────────────────────────────────────────────
// BootError
// ──────────────────────────────────────────────

pub type BootError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BootError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BootError
        effects: [deterministic]
    {
        BootError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        self.code == 0
    }
}
