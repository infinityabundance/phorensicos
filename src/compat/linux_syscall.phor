/// Maximum Linux syscall number we support.
const MAX_LINUX_SYSCALL: u64 = 400;

//==============================================================================
// Syscall Number Mapping
//==============================================================================

/// Map a Linux syscall number to a Phorensic syscall.
pub fn map_linux_to_phor[
  linux_num: LinuxSyscallNumber,
] -> Option[SyscallNumber] : effect:(pure)
  loop: bounded(1)
{
  match linux_num {
    LinuxSyscallNumber::Read    => Some(SyscallNumber::Read),
    LinuxSyscallNumber::Write   => Some(SyscallNumber::Write),
    LinuxSyscallNumber::Open    => Some(SyscallNumber::Open),
    LinuxSyscallNumber::Close   => Some(SyscallNumber::Close),
    LinuxSyscallNumber::LSeek   => Some(SyscallNumber::Seek),
    LinuxSyscallNumber::FStat   => Some(SyscallNumber::FStat),
    LinuxSyscallNumber::MMap    => Some(SyscallNumber::MapMemory),
    LinuxSyscallNumber::MUnmap  => Some(SyscallNumber::UnmapMemory),
    LinuxSyscallNumber::MProtect => Some(SyscallNumber::ProtectMemory),
    LinuxSyscallNumber::Ioctl   => Some(SyscallNumber::IOControl),
    LinuxSyscallNumber::Exit    => Some(SyscallNumber::Exit),
    LinuxSyscallNumber::Fork    => Some(SyscallNumber::Fork),
    LinuxSyscallNumber::Execve  => Some(SyscallNumber::Exec),
    LinuxSyscallNumber::Kill    => Some(SyscallNumber::Kill),
    LinuxSyscallNumber::GetPID  => Some(SyscallNumber::GetPid),
    LinuxSyscallNumber::GetTID  => Some(SyscallNumber::GetTid),
    LinuxSyscallNumber::NanoSleep => Some(SyscallNumber::Nanosleep),
    LinuxSyscallNumber::ClockGetTime => Some(SyscallNumber::ClockGetTime),
    LinuxSyscallNumber::SchedYield => Some(SyscallNumber::Yield),
    LinuxSyscallNumber::Dup     => Some(SyscallNumber::ReceiveMessage), // approximate
    LinuxSyscallNumber::Dup2    => Some(SyscallNumber::ReceiveMessage),
    LinuxSyscallNumber::Pipe    => Some(SyscallNumber::PipeCreate),
    LinuxSyscallNumber::Fcntl   => Some(SyscallNumber::IOControl),
    LinuxSyscallNumber::FSync   => Some(SyscallNumber::FSync),
    LinuxSyscallNumber::FTruncate => Some(SyscallNumber::FTruncate),
    LinuxSyscallNumber::GetCwd  => Some(SyscallNumber::DirectoryRead),
    LinuxSyscallNumber::ChDir   => Some(SyscallNumber::DirectoryCreate),
    LinuxSyscallNumber::Rename  => Some(SyscallNumber::Rename),
    LinuxSyscallNumber::MkDir   => Some(SyscallNumber::DirectoryCreate),
    LinuxSyscallNumber::Unlink  => Some(SyscallNumber::Unlink),
    LinuxSyscallNumber::Link    => Some(SyscallNumber::Link),
    LinuxSyscallNumber::Access  => Some(SyscallNumber::FStat),
    LinuxSyscallNumber::Stat    => Some(SyscallNumber::FStat),
    LinuxSyscallNumber::LStat   => Some(SyscallNumber::FStat),
    LinuxSyscallNumber::GetTimeOfDay => Some(SyscallNumber::ClockGetTime),
    LinuxSyscallNumber::GetRandom => Some(SyscallNumber::SecurityInfo),
    LinuxSyscallNumber::Futex   => Some(SyscallNumber::SignalWait),  // approximate
    LinuxSyscallNumber::Clone   => Some(SyscallNumber::CreateThread),
    LinuxSyscallNumber::ExitGroup => Some(SyscallNumber::Exit),
    LinuxSyscallNumber::Wait4   => Some(SyscallNumber::Wait),
    LinuxSyscallNumber::Kill    => Some(SyscallNumber::Kill),
    LinuxSyscallNumber::GetUID  => Some(SyscallNumber::GetPid),
    LinuxSyscallNumber::GetGID  => Some(SyscallNumber::GetPid),
    _ => None,
  }
}

//==============================================================================
// Argument Translation
//==============================================================================

/// Translate Linux syscall arguments to Phorensic equivalents.
pub struct LinuxSyscallArgs(
  number: u64,
  arg0: u64,
  arg1: u64,
  arg2: u64,
  arg3: u64,
  arg4: u64,
  arg5: u64,
) : effect:(pure);

pub struct TranslatedArgs(
  phor_syscall: SyscallNumber,
  phor_args: [u64; 6],
  num_args: u32,
  cap_arg: Option[CapabilitySlot],
  needs_fd_mapping: bool,
  needs_errno_translation: bool,
) : effect:(pure);

/// Translate a set of Linux syscall arguments.
pub fn translate_linux_args[
  linux_args: LinuxSyscallArgs,
  fd_table: *FdTable,
  cap: CapabilitySlot,
] -> Result[TranslatedArgs, TranslationError] : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  let linux_num: LinuxSyscallNumber = @int_to_enum(linux_args.number);
  let phor_num: Option[SyscallNumber> = map_linux_to_phor(linux_num);

  if phor_num.is_none() {
    return Err(TranslationError::UnsupportedSyscall);
  }

  let phor: SyscallNumber = phor_num.unwrap();
  var translated: TranslatedArgs = TranslatedArgs(
    phor_syscall: phor,
    phor_args: Default,
    num_args: 0,
    cap_arg: None,
    needs_fd_mapping: false,
    needs_errno_translation: true,
  );

  match linux_num {
    LinuxSyscallNumber::Read => {
      // read(fd, buf, count) -> Read(handle, buf, count)
      let phor_fd: u64 = translate_fd(linux_args.arg0, fd_table, FdDirection::Read)?;
      translated.phor_args[0] = phor_fd;
      translated.phor_args[1] = linux_args.arg1;  // buf pointer
      translated.phor_args[2] = linux_args.arg2;  // count
      translated.num_args = 3;
      translated.needs_fd_mapping = true;
    },
    LinuxSyscallNumber::Write => {
      let phor_fd: u64 = translate_fd(linux_args.arg0, fd_table, FdDirection::Write)?;
      translated.phor_args[0] = phor_fd;
      translated.phor_args[1] = linux_args.arg1;
      translated.phor_args[2] = linux_args.arg2;
      translated.num_args = 3;
      translated.needs_fd_mapping = true;
    },
    LinuxSyscallNumber::Open => {
      // open(pathname, flags, mode) -> Open(path, flags, mode)
      translated.phor_args[0] = linux_args.arg0;  // pathname pointer
      translated.phor_args[1] = translate_open_flags(linux_args.arg1);
      translated.phor_args[2] = linux_args.arg2;  // mode
      translated.num_args = 3;
    },
    LinuxSyscallNumber::Close => {
      let phor_fd: u64 = translate_fd(linux_args.arg0, fd_table, FdDirection::Any)?;
      translated.phor_args[0] = phor_fd;
      translated.num_args = 1;
      translated.needs_fd_mapping = true;
    },
    LinuxSyscallNumber::LSeek => {
      translated.phor_args[0] = linux_args.arg0;  // fd
      translated.phor_args[1] = linux_args.arg1;  // offset
      translated.phor_args[2] = translate_whence(linux_args.arg2);
      translated.num_args = 3;
    },
    LinuxSyscallNumber::MMap => {
      // mmap(addr, length, prot, flags, fd, offset)
      translated.phor_args[0] = linux_args.arg0;  // addr
      translated.phor_args[1] = linux_args.arg1;  // length
      translated.phor_args[2] = translate_mmap_prot(linux_args.arg2);
      translated.phor_args[3] = linux_args.arg4;  // fd (0xFFFFFFFF for anonymous)
      translated.phor_args[4] = linux_args.arg5;  // offset
      translated.num_args = 5;
    },
    LinuxSyscallNumber::MUnmap => {
      translated.phor_args[0] = linux_args.arg0;  // addr
      translated.phor_args[1] = linux_args.arg1;  // length
      translated.num_args = 2;
    },
    LinuxSyscallNumber::Ioctl => {
      translated.phor_args[0] = linux_args.arg0;  // fd
      translated.phor_args[1] = linux_args.arg1;  // request
      translated.phor_args[2] = linux_args.arg2;  // arg
      translated.num_args = 3;
    },
    LinuxSyscallNumber::Exit => {
      translated.phor_args[0] = linux_args.arg0;  // exit code
      translated.num_args = 1;
    },
    LinuxSyscallNumber::Fork => {
      // Fork is emulated via CreateThread + process state copy
      translated.num_args = 0;
    },
    LinuxSyscallNumber::Execve => {
      translated.phor_args[0] = linux_args.arg0;  // pathname
      translated.phor_args[1] = linux_args.arg1;  // argv
      translated.phor_args[2] = linux_args.arg2;  // envp
      translated.num_args = 3;
    },
    LinuxSyscallNumber::GetPID => {
      translated.num_args = 0;
    },
    LinuxSyscallNumber::NanoSleep => {
      translated.phor_args[0] = linux_args.arg0;  // req
      translated.phor_args[1] = linux_args.arg1;  // rem
      translated.num_args = 2;
    },
    LinuxSyscallNumber::GetTimeOfDay => {
      translated.phor_args[0] = linux_args.arg0;  // tv
      translated.phor_args[1] = linux_args.arg1;  // tz
      translated.num_args = 2;
    },
    LinuxSyscallNumber::Clone => {
      // clone(flags, stack, parent_tid, child_tls, child_tid)
      translated.phor_args[0] = linux_args.arg0;  // flags
      translated.phor_args[1] = linux_args.arg1;  // stack
      translated.phor_args[2] = linux_args.arg2;  // parent_tid
      translated.phor_args[3] = linux_args.arg3;  // child_tls
      translated.num_args = 4;
    },
    LinuxSyscallNumber::Futex => {
      // futex(uaddr, op, val, timeout, uaddr2, val3)
      translated.phor_args[0] = linux_args.arg0;  // uaddr
      translated.phor_args[1] = translate_futex_op(linux_args.arg1);
      translated.phor_args[2] = linux_args.arg2;  // val
      translated.phor_args[3] = linux_args.arg3;  // timeout
      translated.num_args = 4;
    },
    LinuxSyscallNumber::ClockGetTime => {
      translated.phor_args[0] = linux_args.arg0;  // clock_id
      translated.phor_args[1] = linux_args.arg1;  // tp
      translated.num_args = 2;
    },
    _ => {
      // Generic pass-through: map args as-is
      translated.phor_args[0] = linux_args.arg0;
      translated.phor_args[1] = linux_args.arg1;
      translated.phor_args[2] = linux_args.arg2;
      translated.phor_args[3] = linux_args.arg3;
      translated.num_args = 4;
    },
  }

  return Ok(translated);
}

pub enum TranslationError : u64 {
  UnsupportedSyscall = 1,
  InvalidArgument    = 2,
  BadFd              = 3,
  FdNotFound         = 4,
  CapabilityRequired = 5,
  OutOfMemory        = 6,
}

//==============================================================================
// Errno Mapping
//==============================================================================

/// Linux errno to Phorensic SyscallError mapping.
pub fn errno_to_syscall_error[linux_errno: i32] -> SyscallError : effect:(pure) {
  match linux_errno {
    0     => SyscallError::Success,
    1     => SyscallError::PermissionDenied,       // EPERM
    2     => SyscallError::NotFound,                // ENOENT
    3     => SyscallError::NotFound,                // ESRCH
    4     => SyscallError::Interrupted,             // EINTR
    5     => SyscallError::InvalidArgument,         // EIO
    6     => SyscallError::NotFound,                // ENXIO
    7     => SyscallError::InvalidArgument,         // E2BIG
    8     => SyscallError::NotSupported,            // ENOEXEC
    9     => SyscallError::InvalidArgument,         // EBADF
    10    => SyscallError::ResourceExhausted,       // ECHILD
    11    => SyscallError::WouldBlock,              // EAGAIN
    12    => SyscallError::ResourceExhausted,       // ENOMEM
    13    => SyscallError::PermissionDenied,        // EACCES
    14    => SyscallError::BadAddress,              // EFAULT
    15    => SyscallError::NotFound,                // ENOTBLK
    16    => SyscallError::AlreadyExists,           // EBUSY
    17    => SyscallError::AlreadyExists,           // EEXIST
    18    => SyscallError::InvalidArgument,         // EXDEV
    19    => SyscallError::NotSupported,            // ENODEV
    20    => SyscallError::NotFound,                // ENOTDIR
    21    => SyscallError::InvalidArgument,         // EISDIR
    22    => SyscallError::InvalidArgument,         // EINVAL
    23    => SyscallError::NotSupported,            // ENFILE
    24    => SyscallError::ResourceExhausted,       // EMFILE
    25    => SyscallError::NotSupported,            // ENOTTY
    26    => SyscallError::ResourceExhausted,       // ETXTBSY
    27    => SyscallError::ResourceExhausted,       // EFBIG
    28    => SyscallError::ResourceExhausted,       // ENOSPC
    29    => SyscallError::NotSupported,            // ESPIPE
    30    => SyscallError::AlreadyExists,           // EROFS
    31    => SyscallError::NotSupported,            // EMLINK
    32    => SyscallError::InvalidArgument,         // EPIPE
    33    => SyscallError::InvalidArgument,         // EDOM
    34    => SyscallError::InvalidArgument,         // ERANGE
    35    => SyscallError::WouldBlock,              // EDEADLK
    36    => SyscallError::NotFound,                // ENAMETOOLONG
    37    => SyscallError::ResourceExhausted,       // ENOLCK
    38    => SyscallError::NotSupported,            // ENOSYS
    39    => SyscallError::NotFound,                // ENOTEMPTY
    40    => SyscallError::WouldBlock,              // ELOOP
    41    => SyscallError::WouldBlock,              // EWOULDBLOCK
    42    => SyscallError::InvalidArgument,         // ENOMSG
    43    => SyscallError::InvalidArgument,         // EIDRM
    44    => SyscallError::InvalidArgument,         // ECHRNG
    45    => SyscallError::InvalidArgument,         // EL2NSYNC
    46    => SyscallError::InvalidArgument,         // EL3HLT
    47    => SyscallError::InvalidArgument,         // EL3RST
    48    => SyscallError::InvalidArgument,         // ELNRNG
    49    => SyscallError::InvalidArgument,         // EUNATCH
    50    => SyscallError::InvalidArgument,         // ENOCSI
    51    => SyscallError::InvalidArgument,         // EL2HLT
    52    => SyscallError::InvalidArgument,         // EBADE
    53    => SyscallError::InvalidArgument,         // EBADR
    54    => SyscallError::InvalidArgument,         // EXFULL
    55    => SyscallError::InvalidArgument,         // ENOANO
    56    => SyscallError::InvalidArgument,         // EBADRQC
    57    => SyscallError::InvalidArgument,         // EBADSLT
    59    => SyscallError::InvalidArgument,         // EBFONT
    60    => SyscallError::InvalidArgument,         // ENOSTR
    61    => SyscallError::InvalidArgument,         // ENODATA
    62    => SyscallError::InvalidArgument,         // ETIME
    63    => SyscallError::InvalidArgument,         // ENOSR
    64    => SyscallError::InvalidArgument,         // ENONET
    65    => SyscallError::InvalidArgument,         // ENOPKG
    66    => SyscallError::InvalidArgument,         // EREMOTE
    67    => SyscallError::InvalidArgument,         // ENOLINK
    68    => SyscallError::InvalidArgument,         // EADV
    69    => SyscallError::InvalidArgument,         // ESRMNT
    70    => SyscallError::InvalidArgument,         // ECOMM
    71    => SyscallError::InvalidArgument,         // EPROTO
    72    => SyscallError::ResourceExhausted,       // EMULTIHOP
    73    => SyscallError::InvalidArgument,         // EDOTDOT
    74    => SyscallError::InvalidArgument,         // EBADMSG
    75    => SyscallError::InvalidArgument,         // EOVERFLOW
    76    => SyscallError::NotFound,                // ENOTUNIQ
    77    => SyscallError::InvalidArgument,         // EBADFD
    78    => SyscallError::InvalidArgument,         // EREMCHG
    79    => SyscallError::InvalidArgument,         // ELIBACC
    80    => SyscallError::InvalidArgument,         // ELIBBAD
    81    => SyscallError::InvalidArgument,         // ELIBSCN
    82    => SyscallError::InvalidArgument,         // ELIBMAX
    83    => SyscallError::InvalidArgument,         // ELIBEXEC
    84    => SyscallError::InvalidArgument,         // EILSEQ
    85    => SyscallError::InvalidArgument,         // ERESTART
    86    => SyscallError::InvalidArgument,         // ESTRPIPE
    87    => SyscallError::InvalidArgument,         // EUSERS
    88    => SyscallError::NotSupported,            // ENOTSOCK
    89    => SyscallError::AlreadyExists,           // EDESTADDRREQ
    90    => SyscallError::InvalidArgument,         // EMSGSIZE
    91    => SyscallError::InvalidArgument,         // EPROTOTYPE
    92    => SyscallError::InvalidArgument,         // ENOPROTOOPT
    93    => SyscallError::InvalidArgument,         // EPROTONOSUPPORT
    94    => SyscallError::NotSupported,            // ESOCKTNOSUPPORT
    95    => SyscallError::NotSupported,            // EOPNOTSUPP
    96    => SyscallError::InvalidArgument,         // EPFNOSUPPORT
    97    => SyscallError::NotSupported,            // EAFNOSUPPORT
    98    => SyscallError::AlreadyExists,           // EADDRINUSE
    99    => SyscallError::InvalidArgument,         // EADDRNOTAVAIL
    100   => SyscallError::InvalidArgument,         // ENETDOWN
    101   => SyscallError::InvalidArgument,         // ENETUNREACH
    102   => SyscallError::InvalidArgument,         // ENETRESET
    103   => SyscallError::InvalidArgument,         // ECONNABORTED
    104   => SyscallError::InvalidArgument,         // ECONNRESET
    105   => SyscallError::InvalidArgument,         // ENOBUFS
    106   => SyscallError::InvalidArgument,         // EISCONN
    107   => SyscallError::InvalidArgument,         // ENOTCONN
    108   => SyscallError::InvalidArgument,         // ESHUTDOWN
    109   => SyscallError::InvalidArgument,         // ETOOMANYREFS
    110   => SyscallError::InvalidArgument,         // ETIMEDOUT
    111   => SyscallError::InvalidArgument,         // ECONNREFUSED
    112   => SyscallError::InvalidArgument,         // EHOSTDOWN
    113   => SyscallError::InvalidArgument,         // EHOSTUNREACH
    114   => SyscallError::InvalidArgument,         // EALREADY
    115   => SyscallError::WouldBlock,              // EINPROGRESS
    116   => SyscallError::InvalidArgument,         // ESTALE
    117   => SyscallError::InvalidArgument,         // EUCLEAN
    118   => SyscallError::InvalidArgument,         // ENOTNAM
    119   => SyscallError::InvalidArgument,         // ENAVAIL
    120   => SyscallError::InvalidArgument,         // EISNAM
    121   => SyscallError::InvalidArgument,         // EREMOTEIO
    122   => SyscallError::InvalidArgument,         // EDQUOT
    123   => SyscallError::InvalidArgument,         // ENOMEDIUM
    124   => SyscallError::InvalidArgument,         // EMEDIUMTYPE
    125   => SyscallError::InvalidArgument,         // ECANCELED
    126   => SyscallError::InvalidArgument,         // ENOKEY
    127   => SyscallError::InvalidArgument,         // EKEYEXPIRED
    128   => SyscallError::InvalidArgument,         // EKEYREVOKED
    129   => SyscallError::InvalidArgument,         // EKEYREJECTED
    130   => SyscallError::InvalidArgument,         // EOWNERDEAD
    131   => SyscallError::InvalidArgument,         // ENOTRECOVERABLE
    132   => SyscallError::InvalidArgument,         // ERFKILL
    133   => SyscallError::InvalidArgument,         // EHWPOISON
    _     => SyscallError::InvalidArgument,
  }
}

/// Map a Phorensic SyscallError back to a Linux errno.
pub fn syscall_error_to_errno[error: SyscallError] -> i32 : effect:(pure) {
  match error {
    SyscallError::Success => 0,
    SyscallError::InvalidNumber => 22,           // EINVAL
    SyscallError::InvalidArgument => 22,          // EINVAL
    SyscallError::InvalidCapability => 9,         // EBADF
    SyscallError::InsufficientRights => 1,        // EPERM
    SyscallError::BadAddress => 14,               // EFAULT
    SyscallError::ResourceExhausted => 12,        // ENOMEM
    SyscallError::NotFound => 2,                  // ENOENT
    SyscallError::AlreadyExists => 17,            // EEXIST
    SyscallError::PermissionDenied => 13,         // EACCES
    SyscallError::WouldBlock => 11,               // EAGAIN
    SyscallError::Interrupted => 4,               // EINTR
    SyscallError::NotSupported => 38,             // ENOSYS
    SyscallError::CapabilityViolation => 1,       // EPERM
    SyscallError::AffineViolation => 22,          // EINVAL
    SyscallError::ResidualOverflow => 12,         // ENOMEM
    SyscallError::AuditFailure => 22,             // EINVAL
    _ => 22,                                      // EINVAL
  }
}

//==============================================================================
// Ioctl Forwarding
//==============================================================================

/// Ioctl request descriptor.
pub struct IoctlRequest(
  /// The ioctl request number.
  request: u32,
  /// Direction of data transfer.
  direction: IoctlDirection,
  /// Magic/shared letter (8 bits).
  magic: u8,
  /// Command number.
  command: u8,
  /// Data size.
  data_size: u16,
  /// Whether this is a terminal ioctl.
  is_termios: bool,
  /// Whether this is a socket ioctl.
  is_socket: bool,
  /// Whether this is a block device ioctl.
  is_block: bool,
) : effect:(pure);

pub enum IoctlDirection : u8 {
  None    = 0,
  Read    = 1,
  Write   = 2,
  ReadWrite = 3,
}

/// Decode an ioctl request number.
pub fn decode_ioctl_request[request: u32] -> IoctlRequest : effect:(pure) {
  let direction: IoctlDirection = @int_to_enum((request >> 30) & 3);
  let size: u16 = ((request >> 16) & 0x3FFF) as u16;
  let magic: u8 = ((request >> 8) & 0xFF) as u8;
  let cmd: u8 = (request & 0xFF) as u8;

  let is_term: bool = magic == 'T' as u8;
  let is_sock: bool = magic == 'S' as u8 || magic == 's' as u8;
  let is_blk: bool = magic == 'B' as u8 || magic == 'b' as u8;

  return IoctlRequest(
    request: request,
    direction: direction,
    magic: magic,
    command: cmd,
    data_size: size,
    is_termios: is_term,
    is_socket: is_sock,
    is_block: is_blk,
  );
}

/// Forward an ioctl request to the appropriate Phorensic handler.
pub fn forward_ioctl[
  request: IoctlRequest,
  fd: u64,
  arg: u64,
  fd_table: *FdTable,
] -> Result<u64, SyscallError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  if request.is_termios {
    return forward_termios_ioctl(request, fd, arg, fd_table);
  } else if request.is_socket {
    return forward_socket_ioctl(request, fd, arg, fd_table);
  } else if request.is_block {
    return forward_block_ioctl(request, fd, arg, fd_table);
  } else {
    // Generic ioctl — pass through to underlying device
    let phor_fd: u64 = translate_fd(fd, fd_table, FdDirection::Any)?;
    return handle_ioctl(phor_fd, request.request, arg);
  }
}

fn forward_termios_ioctl[request: IoctlRequest, fd: u64, arg: u64, fd_table: *FdTable] -> Result<u64, SyscallError> : (syscall, unsafe) {
  Ok(0)
}

fn forward_socket_ioctl[request: IoctlRequest, fd: u64, arg: u64, fd_table: *FdTable] -> Result<u64, SyscallError> : (syscall, unsafe) {
  Ok(0)
}

fn forward_block_ioctl[request: IoctlRequest, fd: u64, arg: u64, fd_table: *FdTable] -> Result<u64, SyscallError> : (syscall, unsafe) {
  Ok(0)
}

fn handle_ioctl[fd: u64, request: u32, arg: u64] -> Result<u64, SyscallError> : (syscall, unsafe) {
  Ok(0)
}

//==============================================================================
// File Descriptor Emulation
//==============================================================================

/// File descriptor mapping table.
pub struct FdTable(
  /// Mappings from Linux fd -> Phorensic handle.
  mappings: [FdMapping; 1024],
  /// Number of mappings.
  count: u32,
  /// Next Linux fd to allocate.
  next_fd: i32,
  /// Process-local capability for this fd table.
  cap_token: u64,
) : effect:(alloc, unsafe);

pub struct FdMapping(
  linux_fd: i32,
  phor_handle: u64,
  type: FdType,
  flags: FdFlags,
  path_hash: u64,
  offset: u64,
  is_open: bool,
) : effect:(pure);

pub enum FdType : u8 {
  File       = 0,
  Dir        = 1,
  Socket     = 2,
  Pipe       = 3,
  Epoll      = 4,
  EventFd    = 5,
  TimerFd    = 6,
  Signalfd   = 7,
  Inotify    = 8,
  Memfd      = 9,
  DevNull    = 10,
  DevRandom  = 11,
  DevURandom = 12,
  DevZero    = 13,
  DevFull    = 14,
  DevTty     = 15,
  DevPts     = 16,
}

pub struct FdFlags(
  bits: u32,
) : effect:(pure);

const FD_CLOEXEC: FdFlags = FdFlags(1 << 0);
const FD_NONBLOCK: FdFlags = FdFlags(1 << 1);
const FD_APPEND: FdFlags = FdFlags(1 << 2);
const FD_ASYNC: FdFlags = FdFlags(1 << 3);
const FD_CLOSE_ON_EXEC: FdFlags = FdFlags(1 << 4);

/// Direction for fd translation.
pub enum FdDirection : u8 {
  Read  = 0,
  Write = 1,
  Any   = 2,
}

/// Translate a Linux fd to a Phorensic handle.
pub fn translate_fd[
  linux_fd: u64,
  fd_table: *FdTable,
  direction: FdDirection,
] -> Result<u64, TranslationError> : (unsafe)
  loop: bounded(1024)
{
  let fd: i32 = linux_fd as i32;

  // Handle special fds
  if fd == 0 || fd == 1 || fd == 2 {
    // stdin/stdout/stderr
    return Ok(fd as u64);
  }

  for var i: u32 = 0; i < fd_table.count; i += 1 {
    let mapping: FdMapping = fd_table.mappings[i];
    if mapping.linux_fd == fd && mapping.is_open {
      return Ok(mapping.phor_handle);
    }
  }

  return Err(TranslationError::BadFd);
}

/// Allocate a new Linux fd for a Phorensic handle.
pub fn allocate_linux_fd[
  phor_handle: u64,
  fd_type: FdType,
  flags: FdFlags,
  fd_table: *FdTable,
] -> Result<i32, TranslationError> : (alloc, unsafe)
  loop: bounded(1024)
{
  if fd_table.count >= 1024 {
    return Err(TranslationError::OutOfMemory);
  }

  let linux_fd: i32 = fd_table.next_fd;
  fd_table.next_fd += 1;

  fd_table.mappings[fd_table.count] = FdMapping(
    linux_fd: linux_fd,
    phor_handle: phor_handle,
    type: fd_type,
    flags: flags,
    path_hash: 0,
    offset: 0,
    is_open: true,
  );
  fd_table.count += 1;

  return Ok(linux_fd);
}

/// Close a Linux fd.
pub fn close_linux_fd[
  linux_fd: i32,
  fd_table: *FdTable,
] -> Result[(), TranslationError] : (unsafe)
  loop: bounded(1024)
{
  for var i: u32 = 0; i < fd_table.count; i += 1 {
    if fd_table.mappings[i].linux_fd == linux_fd && fd_table.mappings[i].is_open {
      fd_table.mappings[i].is_open = false;
      return Ok(());
    }
  }
  return Err(TranslationError::BadFd);
}

//==============================================================================
// Flag Translation Helpers
//==============================================================================

/// Translate Linux open flags to Phorensic flags.
pub fn translate_open_flags[linux_flags: u64] -> u64 : effect:(pure) {
  var phor_flags: u64 = 0;
  let oflags: u32 = linux_flags as u32;

  // Access mode
  match oflags & 3 {
    0 => phor_flags |= 0,  // O_RDONLY
    1 => phor_flags |= 1,  // O_WRONLY
    2 => phor_flags |= 2,  // O_RDWR
    _ => {},
  }

  // Creation flags
  if oflags & 0x40 != 0 { phor_flags |= 0x10; }   // O_CREAT
  if oflags & 0x80 != 0 { phor_flags |= 0x20; }   // O_EXCL
  if oflags & 0x200 != 0 { phor_flags |= 0x40; }  // O_TRUNC
  if oflags & 0x400 != 0 { phor_flags |= 0x80; }  // O_APPEND
  if oflags & 0x800 != 0 { phor_flags |= 0x100; } // O_NONBLOCK
  if oflags & 0x4000 != 0 { phor_flags |= 0x200; } // O_CLOEXEC
  if oflags & 0x20000 != 0 { phor_flags |= 0x400; } // O_TMPFILE
  if oflags & 0x100000 != 0 { phor_flags |= 0x800; } // O_DIRECTORY
  if oflags & 0x200000 != 0 { phor_flags |= 0x1000; } // O_NOFOLLOW
  if oflags & 0x400000 != 0 { phor_flags |= 0x2000; } // O_PATH

  return phor_flags;
}

/// Translate mmap prot flags.
pub fn translate_mmap_prot[linux_prot: u64] -> u64 : effect:(pure) {
  var phor_prot: u64 = 0;
  let prot: u32 = linux_prot as u32;

  if prot & 1 != 0 { phor_prot |= 1; }  // PROT_READ
  if prot & 2 != 0 { phor_prot |= 2; }  // PROT_WRITE
  if prot & 4 != 0 { phor_prot |= 4; }  // PROT_EXEC
  if prot & 8 != 0 { phor_prot |= 8; }  // PROT_NONE (Phorensic extension)
  if prot & 0x20 != 0 { phor_prot |= 0x10; }  // PROT_GROWSDOWN
  if prot & 0x40 != 0 { phor_prot |= 0x20; }  // PROT_GROWSUP

  return phor_prot;
}

/// Translate mmap flags.
pub fn translate_mmap_flags[linux_flags: u64] -> u64 : effect:(pure) {
  var phor_flags: u64 = 0;
  let flags: u32 = linux_flags as u32;

  if flags & 1 != 0 { phor_flags |= 0x1; }    // MAP_SHARED
  if flags & 2 != 0 { phor_flags |= 0x2; }    // MAP_PRIVATE
  if flags & 0x10 != 0 { phor_flags |= 0x10; } // MAP_FIXED
  if flags & 0x20 != 0 { phor_flags |= 0x20; } // MAP_ANONYMOUS
  if flags & 0x80 != 0 { phor_flags |= 0x80; } // MAP_GROWSDOWN
  if flags & 0x100 != 0 { phor_flags |= 0x100; } // MAP_DENYWRITE
  if flags & 0x200 != 0 { phor_flags |= 0x200; } // MAP_EXECUTABLE
  if flags & 0x400 != 0 { phor_flags |= 0x400; } // MAP_LOCKED
  if flags & 0x800 != 0 { phor_flags |= 0x800; } // MAP_NORESERVE
  if flags & 0x1000 != 0 { phor_flags |= 0x1000; } // MAP_POPULATE
  if flags & 0x2000 != 0 { phor_flags |= 0x2000; } // MAP_NONBLOCK
  if flags & 0x4000 != 0 { phor_flags |= 0x4000; } // MAP_STACK
  if flags & 0x8000 != 0 { phor_flags |= 0x8000; } // MAP_HUGETLB

  return phor_flags;
}

/// Translate lseek whence.
pub fn translate_whence[linux_whence: u64] -> u64 : effect:(pure) {
  match linux_whence {
    0 => 0,  // SEEK_SET
    1 => 1,  // SEEK_CUR
    2 => 2,  // SEEK_END
    3 => 3,  // SEEK_DATA (Phorensic extension)
    4 => 4,  // SEEK_HOLE (Phorensic extension)
    _ => 0,
  }
}

/// Translate futex operation.
pub fn translate_futex_op[linux_op: u64] -> u64 : effect:(pure) {
  let op: u32 = linux_op as u32;
  let cmd: u32 = op & 0x1F;

  match cmd {
    0 => 0,   // FUTEX_WAIT
    1 => 1,   // FUTEX_WAKE
    2 => 2,   // FUTEX_FD
    3 => 3,   // FUTEX_REQUEUE
    4 => 4,   // FUTEX_CMP_REQUEUE
    5 => 5,   // FUTEX_WAKE_OP
    6 => 6,   // FUTEX_LOCK_PI
    7 => 7,   // FUTEX_UNLOCK_PI
    8 => 8,   // FUTEX_TRYLOCK_PI
    9 => 9,   // FUTEX_WAIT_BITSET
    10 => 10, // FUTEX_WAKE_BITSET
    11 => 11, // FUTEX_WAIT_REQUEUE_PI
    12 => 12, // FUTEX_CMP_REQUEUE_PI
    _ => 0xFF, // Unknown
  }
}

//==============================================================================
// Signal Compatibility
//==============================================================================

/// Linux signal number to Phorensic signal mapping.
pub struct SignalMapping(
  linux_signal: i32,
  phor_signal: u64,
  supported: bool,
  default_action: SignalAction,
) : effect:(pure);

pub enum SignalAction : u8 {
  Terminate = 0,
  Ignore    = 1,
  Core      = 2,
  Stop      = 3,
  Continue  = 4,
}

/// Linux signal constants.
pub const LINUX_SIGHUP: i32    = 1;
pub const LINUX_SIGINT: i32    = 2;
pub const LINUX_SIGQUIT: i32   = 3;
pub const LINUX_SIGILL: i32    = 4;
pub const LINUX_SIGTRAP: i32   = 5;
pub const LINUX_SIGABRT: i32   = 6;
pub const LINUX_SIGBUS: i32    = 7;
pub const LINUX_SIGFPE: i32    = 8;
pub const LINUX_SIGKILL: i32   = 9;
pub const LINUX_SIGUSR1: i32   = 10;
pub const LINUX_SIGSEGV: i32   = 11;
pub const LINUX_SIGUSR2: i32   = 12;
pub const LINUX_SIGPIPE: i32   = 13;
pub const LINUX_SIGALRM: i32   = 14;
pub const LINUX_SIGTERM: i32   = 15;
pub const LINUX_SIGSTKFLT: i32 = 16;
pub const LINUX_SIGCHLD: i32   = 17;
pub const LINUX_SIGCONT: i32   = 18;
pub const LINUX_SIGSTOP: i32   = 19;
pub const LINUX_SIGTSTP: i32   = 20;
pub const LINUX_SIGTTIN: i32   = 21;
pub const LINUX_SIGTTOU: i32   = 22;
pub const LINUX_SIGURG: i32    = 23;
pub const LINUX_SIGXCPU: i32   = 24;
pub const LINUX_SIGXFSZ: i32   = 25;
pub const LINUX_SIGVTALRM: i32 = 26;
pub const LINUX_SIGPROF: i32   = 27;
pub const LINUX_SIGWINCH: i32  = 28;
pub const LINUX_SIGIO: i32     = 29;
pub const LINUX_SIGPWR: i32    = 30;
pub const LINUX_SIGSYS: i32    = 31;

/// Translate a Linux signal to Phorensic signal semantics.
pub fn translate_signal[
  linux_sig: i32,
  signal_cap: CapabilitySlot,
] -> Result[TranslatedSignal, SyscallError] : (syscall, unsafe)
  loop: bounded(1)
{
  // Validate capability
  let rights: CapRights = CapRights(signal_cap.rights);
  if (rights & RIGHT_IPC_SEND) == 0 {
    return Err(SyscallError::InsufficientRights);
  }

  var action: SignalAction = SignalAction::Terminate;
  var supported: bool = true;

  match linux_sig {
    x if x == LINUX_SIGKILL => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGSTOP => { action = SignalAction::Stop; },
    x if x == LINUX_SIGCONT => { action = SignalAction::Continue; },
    x if x == LINUX_SIGCHLD => { action = SignalAction::Ignore; },
    x if x == LINUX_SIGURG =>  { action = SignalAction::Ignore; },
    x if x == LINUX_SIGWINCH => { action = SignalAction::Ignore; },
    x if x == LINUX_SIGPIPE => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGSEGV => { action = SignalAction::Core; },
    x if x == LINUX_SIGILL =>  { action = SignalAction::Core; },
    x if x == LINUX_SIGFPE =>  { action = SignalAction::Core; },
    x if x == LINUX_SIGBUS =>  { action = SignalAction::Core; },
    x if x == LINUX_SIGABRT => { action = SignalAction::Core; },
    x if x == LINUX_SIGINT =>  { action = SignalAction::Terminate; },
    x if x == LINUX_SIGTERM => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGHUP =>  { action = SignalAction::Terminate; },
    x if x == LINUX_SIGUSR1 => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGUSR2 => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGALRM => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGPROF => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGVTALRM => { action = SignalAction::Terminate; },
    x if x == LINUX_SIGSYS =>  { action = SignalAction::Core; },
    x if x == LINUX_SIGTRAP => { action = SignalAction::Core; },
    x if x == LINUX_SIGXCPU => { action = SignalAction::Core; },
    x if x == LINUX_SIGXFSZ => { action = SignalAction::Core; },
    _ => { supported = false; },
  }

  return Ok(TranslatedSignal(
    linux_signal: linux_sig,
    phor_signal: signal_cap.value,
    action: action,
    supported: supported,
    handled: false,
  ));
}

pub struct TranslatedSignal(
  linux_signal: i32,
  phor_signal: u64,
  action: SignalAction,
  supported: bool,
  handled: bool,
) : effect:(pure);

//==============================================================================
// Fork/Exec Emulation
//==============================================================================

/// Emulate Linux fork() via Phorensic thread creation.
pub fn emulate_fork[
  thread_cap: CapabilitySlot,
  fd_table: *FdTable,
] -> Result<u64, SyscallError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Snapshot the current process state
  let process_state: ProcessState = capture_process_state(fd_table);

  // Create a new thread with copied state
  let child_tid: u64 = create_thread_with_state(
    thread_cap,
    &process_state,
  )?;

  record_residual_for_fork(child_tid);

  return Ok(child_tid);
}

/// Emulate Linux execve() via Phorensic module loading.
pub fn emulate_execve[
  pathname: *u8,
  argv: *u8,
  envp: *u8,
  fs_cap: CapabilitySlot,
] -> Result<u64, SyscallError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // 1. Load the ELF binary (translate to Phorensic module)
  // 2. Create new process image
  // 3. Set up argument strings
  // 4. Transfer control to entry point

  record_residual_for_exec();

  return Ok(0);
}

/// Emulate Linux wait4() via Phorensic thread join.
pub fn emulate_wait[
  pid: u64,
  wstatus: *u32,
  options: u32,
  rusage: *u8,
  thread_cap: CapabilitySlot,
] -> Result<u64, SyscallError> : (syscall)
  loop: bounded(1)
{
  record_residual_for_wait();
  return Ok(0);
}

//==============================================================================
// /proc/@self Emulation
//==============================================================================

/// Emulate /proc/self/ filesystem.
pub fn proc_self_emulation[
  inode: u64,
  buffer: *u8,
  buffer_size: u32,
] -> Result<u32, SyscallError> : (syscall, alloc, unsafe)
  loop: bounded(1)
{
  // Map well-known /proc/self/ inodes to emulated content
  match inode {
    1 => { // /proc/self/maps
      return write_proc_self_maps(buffer, buffer_size);
    },
    2 => { // /proc/self/status
      return write_proc_self_status(buffer, buffer_size);
    },
    3 => { // /proc/self/cmdline
      return write_proc_self_cmdline(buffer, buffer_size);
    },
    4 => { // /proc/self/fd/
      return write_proc_self_fd(buffer, buffer_size);
    },
    5 => { // /proc/self/mem
      return Err(SyscallError::PermissionDenied);
    },
    _ => {
      return Err(SyscallError::NotFound);
    },
  }
}

fn write_proc_self_maps[buffer: *u8, size: u32] -> Result<u32, SyscallError> : (alloc, unsafe) {
  // Write emulated memory maps
  let data: str = "00000000-00001000 r-xp 00000000 00:00 0 [phor_code]\n";
  @memcpy(buffer, data, data.len());
  return Ok(data.len() as u32);
}

fn write_proc_self_status[buffer: *u8, size: u32] -> Result<u32, SyscallError> : (alloc, unsafe) {
  let data: str = "Name:\tphor_task\nState:\tR (running)\nTgid:\t1\nNGid:\t1\nPid:\t1\n";
  @memcpy(buffer, data, data.len());
  return Ok(data.len() as u32);
}

fn write_proc_self_cmdline[buffer: *u8, size: u32] -> Result<u32, SyscallError> : (alloc, unsafe) {
  let data: [u8; 16] = [0x70, 0x68, 0x6F, 0x72, 0x5F, 0x61, 0x70, 0x70, 0x00];
  @memcpy(buffer, data, 9);
  return Ok(9);
}

fn write_proc_self_fd[buffer: *u8, size: u32] -> Result<u32, SyscallError> : (alloc, unsafe) {
  let data: str = "0\t-> /dev/stdin\n1\t-> /dev/stdout\n2\t-> /dev/stderr\n";
  @memcpy(buffer, data, data.len());
  return Ok(data.len() as u32);
}

//==============================================================================
// Process State Capture
//==============================================================================

pub struct ProcessState(
  fd_table_snapshot: [FdMapping; 128],
  num_fds: u32,
  thread_local_base: u64,
  capabilities: [CapabilitySlot; 64],
  num_caps: u32,
  signal_handlers: [SignalHandler; 32],
  num_handlers: u32,
) : effect:(alloc);

pub struct SignalHandler(
  signal: i32,
  handler: u64,
  flags: u32,
  mask: u64,
) : effect:(pure);

fn capture_process_state[fd_table: *FdTable] -> ProcessState : (alloc, unsafe) {
  return ProcessState(fd_table_snapshot: Default, num_fds: 0, thread_local_base: 0, capabilities: Default, num_caps: 0, signal_handlers: Default, num_handlers: 0);
}

fn create_thread_with_state[cap: CapabilitySlot, state: *ProcessState] -> Result<u64, SyscallError> : (syscall, alloc, unsafe) {
  return Ok(0);
}

fn record_residual_for_fork[child_tid: u64] : (syscall) {}
fn record_residual_for_exec[] : (syscall) {}
fn record_residual_for_wait[] : (syscall) {}

pub type CapRights = core::capabilities::CapRights;
pub type CapabilitySlot = core::capabilities::CapabilitySlot;
pub const RIGHT_IPC_SEND: CapRights = CapRights(1 << 32);

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_syscall_mapping[] : effect:(pure) {
  let phor_read: Option[SyscallNumber> = map_linux_to_phor(LinuxSyscallNumber::Read);
  assert(phor_read == Some(SyscallNumber::Read));

  let phor_exit: Option[SyscallNumber> = map_linux_to_phor(LinuxSyscallNumber::Exit);
  assert(phor_exit == Some(SyscallNumber::Exit));
}

@Test
pub fn test_errno_roundtrip[] : effect:(pure) {
  let phor_err: SyscallError = errno_to_syscall_error(2);  // ENOENT
  assert(phor_err == SyscallError::NotFound);

  let linux_errno: i32 = syscall_error_to_errno(phor_err);
  assert(linux_errno == 2);  // ENOENT
}

@Test
pub fn test_open_flags_translation[] : effect:(pure) {
  let rdonly: u64 = translate_open_flags(0);  // O_RDONLY
  assert(rdonly == 0);

  let creat: u64 = translate_open_flags(0x40);  // O_CREAT
  assert(creat & 0x10 != 0);
}
