// filesystem_tests.phor — Comprehensive filesystem tests
// Tests: inode operations, directory traversal, file read/write, path resolution,
//        buffer cache, block allocation, journal recovery, fsck
//
// Expected outcomes:
//   - Inode allocation/creation/deletion produces correct inode table state
//   - Directory traversal finds entries at all depths
//   - File read/write operations correctly transfer data through buffer cache
//   - Path resolution resolves absolute, relative, and dotted paths correctly
//   - Buffer cache evicts least-recently-used entries on capacity pressure
//   - Block allocation bitmap tracks free/used blocks accurately
//   - Journal commits and replays correctly after simulated crash
//   - fsck detects and repairs inode/block inconsistencies
//   - All operations bounded, effect-declared, and residual-recorded

package "phorensic:filesystem_tests:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*

// ============================================================================
// Constants
// ============================================================================

const FS_BLOCK_SIZE: u64 = 4096;
const FS_MAX_BLOCKS: u64 = 1048576;
const FS_MAX_FILES: u64 = 65536;
const FS_MAX_PATH: u64 = 4096;
const FS_MAX_NAME: u64 = 255;
const FS_DIRECT_BLOCKS: u64 = 12;
const FS_INDIRECT_BLOCKS: u64 = 3;
const FS_CACHE_SIZE: u64 = 64;
const FS_JOURNAL_SIZE: u64 = 1024;
const FS_MAX_DIR_ENTRIES: u64 = 512;

// ============================================================================
// Data Structures
// ============================================================================

struct Inode {
    ino: u64,
    mode: u16,
    uid: u32,
    gid: u32,
    size: u64,
    atime: u64,
    mtime: u64,
    ctime: u64,
    link_count: u32,
    block_count: u64,
    direct_blocks: Array(u64, 12),
    indirect_block: u64,
    double_indirect: u64,
    triple_indirect: u64,
    flags: u32,
    generation: u32,
}

enum FileType : u8 {
    Unknown   = 0,
    Regular   = 1,
    Directory = 2,
    CharDev   = 3,
    BlockDev  = 4,
    Fifo      = 5,
    Socket    = 6,
    Symlink   = 7,
}

struct DirectoryEntry {
    ino: u64,
    name: Str(255),
    file_type: FileType,
    entry_len: u16,
    name_len: u16,
}

struct DirectoryBlock {
    entries: Array(DirectoryEntry, 512),
    count: u64,
}

struct PathComponent {
    name: Str(255),
    len: u64,
}

struct ResolvedPath {
    components: Array(PathComponent, 32),
    depth: u64,
    is_absolute: bool,
    is_root: bool,
}

struct BufferCacheEntry {
    block_id: u64,
    data: Array(u8, 4096),
    is_dirty: bool,
    is_valid: bool,
    access_time: u64,
    ref_count: u32,
}

struct BufferCache {
    entries: Array(BufferCacheEntry, 64),
    count: u64,
    next_access: u64,
}

struct BlockBitmap {
    blocks: Array(u64, 16384),
    total_blocks: u64,
    free_blocks: u64,
}

struct JournalEntry {
    sequence: u64,
    operation: u8,
    block_id: u64,
    old_data: Array(u8, 4096),
    new_data: Array(u8, 4096),
    checksum: u32,
    timestamp: u64,
    committed: bool,
}

struct Journal {
    entries: Array(JournalEntry, 1024),
    head: u64,
    tail: u64,
    count: u64,
    next_sequence: u64,
}

struct FsckContext {
    inode_checked: u64,
    block_checked: u64,
    orphan_inodes: Array(u64, 64),
    orphan_count: u64,
    duplicate_blocks: Array(u64, 64),
    dup_count: u64,
    bad_blocks: Array(u64, 64),
    bad_count: u64,
    lost_blocks: Array(u64, 64),
    lost_count: u64,
    inode_count_mismatch: u64,
    block_ref_mismatch: u64,
}

// ============================================================================
// Filesystem Error Types
// ============================================================================

type FsError : u32 = enum {
    InodeNotFound     = 0x2001,
    InodeTableFull    = 0x2002,
    FileNotFound      = 0x2003,
    PathTooLong       = 0x2004,
    NameTooLong       = 0x2005,
    NotADirectory     = 0x2006,
    IsADirectory      = 0x2007,
    FileExists        = 0x2008,
    DiskFull          = 0x2009,
    BlockNotFound     = 0x200A,
    BlockAlreadyFree  = 0x200B,
    JournalFull       = 0x200C,
    JournalCorrupted  = 0x200D,
    CacheMiss         = 0x200E,
    CacheFull         = 0x200F,
    ReadOnly          = 0x2010,
    IoError           = 0x2011,
    ChecksumMismatch  = 0x2012,
    FsckInconsistency = 0x2013,
    DirectoryNotEmpty = 0x2014,
    LinkCountOverflow = 0x2015,
}

// ============================================================================
// Test: Inode Operations
// ============================================================================

fn test_inode_alloc() -> void
    effect [compute, residual]
{
    let mut inodes: Array(Inode, 16) = Array::zeroed();
    let mut inode_count: u64 = 0;

    // Allocate inode 1
    let mut ino1: Inode = Inode{
        ino: 1,
        mode: 0x81A4, // regular file, 0644
        uid: 0,
        gid: 0,
        size: 0,
        atime: 1000,
        mtime: 1000,
        ctime: 1000,
        link_count: 1,
        block_count: 0,
        direct_blocks: Array::zeroed(),
        indirect_block: 0,
        double_indirect: 0,
        triple_indirect: 0,
        flags: 0,
        generation: 1,
    };
    inodes[inode_count] = ino1;
    inode_count = inode_count + 1;

    // Allocate inode 2
    let ino2: Inode = Inode{
        ino: 2,
        mode: 0x41ED, // directory, 0755
        uid: 0,
        gid: 0,
        size: 4096,
        atime: 1000,
        mtime: 1000,
        ctime: 1000,
        link_count: 2,
        block_count: 1,
        direct_blocks: Array::zeroed(),
        indirect_block: 0,
        double_indirect: 0,
        triple_indirect: 0,
        flags: 0,
        generation: 1,
    };
    inodes[inode_count] = ino2;
    inode_count = inode_count + 1;

    assert(inode_count == 2, "fs: allocated 2 inodes");
    assert(inodes[0].ino == 1, "fs: inode 1 allocated");
    assert(inodes[1].ino == 2, "fs: inode 2 allocated");
    assert(inodes[0].link_count == 1, "fs: inode 1 has 1 link");
    assert(inodes[1].link_count == 2, "fs: directory inode 2 has 2 links (. and ..)");

    residual emit {
        op: "fs.test.inode_alloc",
        inodes_allocated: inode_count,
        inode_1_ino: inodes[0].ino,
        inode_2_ino: inodes[1].ino,
    };
}

fn test_inode_free() -> void
    effect [compute, residual]
{
    let mut inode: Inode = Inode{
        ino: 5,
        mode: 0x81A4,
        uid: 1000,
        gid: 1000,
        size: 8192,
        atime: 5000,
        mtime: 5000,
        ctime: 5000,
        link_count: 1,
        block_count: 2,
        direct_blocks: Array::zeroed(),
        indirect_block: 0,
        double_indirect: 0,
        triple_indirect: 0,
        flags: 0,
        generation: 3,
    };
    inode.direct_blocks[0] = 100;
    inode.direct_blocks[1] = 101;

    // Decrease link count
    inode.link_count = inode.link_count - 1;
    assert(inode.link_count == 0, "fs: link count zero, inode eligible for free");

    // Inode freed: zero out
    inode.size = 0;
    inode.block_count = 0;
    for i in 0..12 {
        inode.direct_blocks[i] = 0;
    }
    inode.generation = 0;

    assert(inode.size == 0, "fs: freed inode size zeroed");
    assert(inode.block_count == 0, "fs: freed inode block count zeroed");
    for i in 0..12 {
        assert(inode.direct_blocks[i] == 0, "fs: freed inode direct blocks zeroed");
    }

    residual emit {
        op: "fs.test.inode_free",
        freed_ino: 5,
        freed_blocks: 2,
    };
}

fn test_inode_read_write() -> void
    effect [compute, residual]
{
    let mut inode: Inode = Inode{
        ino: 10,
        mode: 0x81A4,
        uid: 0,
        gid: 0,
        size: 0,
        atime: 2000,
        mtime: 2000,
        ctime: 2000,
        link_count: 1,
        block_count: 0,
        direct_blocks: Array::zeroed(),
        indirect_block: 0,
        double_indirect: 0,
        triple_indirect: 0,
        flags: 0,
        generation: 2,
    };

    // Simulate writing 3 blocks of data
    for i in 0..3 {
        inode.direct_blocks[i] = 50 + (i as u64);
    }
    inode.size = 3 * FS_BLOCK_SIZE;
    inode.block_count = 3;

    assert(inode.block_count == 3, "fs: inode has 3 blocks");
    assert(inode.size == 12288, "fs: inode size = 3 * 4096");
    assert(inode.direct_blocks[0] == 50, "fs: direct block 0 = block 50");
    assert(inode.direct_blocks[1] == 51, "fs: direct block 1 = block 51");
    assert(inode.direct_blocks[2] == 52, "fs: direct block 2 = block 52");

    // Read back
    let block0: u64 = inode.direct_blocks[0];
    assert(block0 == 50, "fs: read direct block 0 = block 50");

    residual emit {
        op: "fs.test.inode_rw",
        blocks_written: 3,
        total_size: inode.size,
    };
}

fn test_inode_indirect_blocks() -> void
    effect [compute, residual]
{
    let mut inode: Inode = Inode{
        ino: 20,
        mode: 0x81A4,
        uid: 0,
        gid: 0,
        size: 0,
        atime: 3000,
        mtime: 3000,
        ctime: 3000,
        link_count: 1,
        block_count: 0,
        direct_blocks: Array::zeroed(),
        indirect_block: 0,
        double_indirect: 0,
        triple_indirect: 0,
        flags: 0,
        generation: 1,
    };

    // Fill 12 direct blocks
    for i in 0..12 {
        inode.direct_blocks[i] = 200 + (i as u64);
    }
    // Add single indirect block (points to block of block pointers)
    inode.indirect_block = 300;
    // Add double indirect
    inode.double_indirect = 400;
    // Add triple indirect
    inode.triple_indirect = 500;

    inode.block_count = 15;
    inode.size = 15 * FS_BLOCK_SIZE;

    assert(inode.direct_blocks[11] == 211, "fs: last direct block = block 211");
    assert(inode.indirect_block == 300, "fs: indirect block = 300");
    assert(inode.double_indirect == 400, "fs: double indirect = 400");
    assert(inode.triple_indirect == 500, "fs: triple indirect = 500");
    assert(inode.block_count == 15, "fs: 15 total blocks");
    assert(inode.size == 61440, "fs: 15 * 4096 = 61440");

    residual emit {
        op: "fs.test.inode_indirect",
        direct_count: 12,
        indirect: inode.indirect_block,
        double_indirect: inode.double_indirect,
        triple_indirect: inode.triple_indirect,
        total_blocks: inode.block_count,
    };
}

// ============================================================================
// Test: Directory Traversal
// ============================================================================

fn test_directory_create_and_list() -> void
    effect [compute, residual]
{
    let mut dir: DirectoryBlock = DirectoryBlock{
        entries: Array::zeroed(),
        count: 0,
    };

    // Add "." entry
    dir.entries[0] = DirectoryEntry{
        ino: 2,
        name: Str::from("."),
        file_type: FileType::Directory,
        entry_len: 12,
        name_len: 1,
    };
    dir.count = 1;

    // Add ".." entry
    dir.entries[1] = DirectoryEntry{
        ino: 1,
        name: Str::from(".."),
        file_type: FileType::Directory,
        entry_len: 12,
        name_len: 2,
    };
    dir.count = 2;

    // Add "file.txt"
    dir.entries[2] = DirectoryEntry{
        ino: 5,
        name: Str::from("file.txt"),
        file_type: FileType::Regular,
        entry_len: 24,
        name_len: 8,
    };
    dir.count = 3;

    // Add "subdir"
    dir.entries[3] = DirectoryEntry{
        ino: 7,
        name: Str::from("subdir"),
        file_type: FileType::Directory,
        entry_len: 16,
        name_len: 6,
    };
    dir.count = 4;

    assert(dir.count == 4, "fs: directory has 4 entries");
    assert(dir.entries[0].ino == 2, "fs: . entry inode = 2");
    assert(dir.entries[2].name == Str::from("file.txt"), "fs: file entry name");
    assert(dir.entries[3].file_type == FileType::Directory, "fs: subdir is directory");

    // List directory entries
    let mut regular_count: u64 = 0;
    let mut dir_count: u64 = 0;
    for i in 0..dir.count {
        match dir.entries[i].file_type {
            FileType::Regular => { regular_count = regular_count + 1; },
            FileType::Directory => { dir_count = dir_count + 1; },
            _ => {},
        }
    }
    assert(regular_count == 1, "fs: 1 regular file in directory");
    assert(dir_count == 2, "fs: 2 directory entries (. and subdir)");

    residual emit {
        op: "fs.test.dir_create_list",
        entries: dir.count,
        regular_files: regular_count,
        directories: dir_count,
    };
}

fn test_directory_lookup() -> void
    effect [compute, residual]
{
    let mut dir: DirectoryBlock = DirectoryBlock{
        entries: Array::zeroed(),
        count: 0,
    };
    dir.entries[0] = DirectoryEntry{
        ino: 10, name: Str::from("readme.md"), file_type: FileType::Regular, entry_len: 20, name_len: 9,
    };
    dir.entries[1] = DirectoryEntry{
        ino: 11, name: Str::from("src"), file_type: FileType::Directory, entry_len: 12, name_len: 3,
    };
    dir.entries[2] = DirectoryEntry{
        ino: 12, name: Str::from("config.json"), file_type: FileType::Regular, entry_len: 24, name_len: 11,
    };
    dir.count = 3;

    // Lookup "src"
    let lookup_name: Str(255) = Str::from("src");
    let mut found_ino: u64 = 0;
    let mut found_type: FileType = FileType::Unknown;
    let mut found: bool = false;
    for i in 0..dir.count {
        if dir.entries[i].name == lookup_name {
            found_ino = dir.entries[i].ino;
            found_type = dir.entries[i].file_type;
            found = true;
        }
    }
    assert(found, "fs: lookup 'src' found");
    assert(found_ino == 11, "fs: 'src' inode = 11");
    assert(found_type == FileType::Directory, "fs: 'src' is directory");

    // Lookup "readme.md"
    let lookup_rm: Str(255) = Str::from("readme.md");
    found = false;
    for i in 0..dir.count {
        if dir.entries[i].name == lookup_rm {
            found_ino = dir.entries[i].ino;
            found_type = dir.entries[i].file_type;
            found = true;
        }
    }
    assert(found, "fs: lookup 'readme.md' found");
    assert(found_ino == 10, "fs: 'readme.md' inode = 10");

    // Lookup nonexistent
    let lookup_nope: Str(255) = Str::from("nonexistent");
    found = false;
    for i in 0..dir.count {
        if dir.entries[i].name == lookup_nope {
            found = true;
        }
    }
    assert(!found, "fs: lookup nonexistent returns false");

    residual emit {
        op: "fs.test.dir_lookup",
        total_entries: dir.count,
        found_src: true,
        found_readme: true,
        found_nonexistent: false,
    };
}

// ============================================================================
// Test: File Read/Write
// ============================================================================

fn test_file_write_read_sequential() -> void
    effect [compute, residual]
{
    let mut blocks: Array(Array(u8, 4096), 4) = Array::zeroed();
    let mut file_size: u64 = 0;

    // Write 4 blocks of sequential data
    for block_idx in 0..4 {
        let mut block_data: Array(u8, 4096) = Array::zeroed();
        for byte_idx in 0..4096 {
            block_data[byte_idx] = ((block_idx * 4096 + byte_idx) & 0xFF) as u8;
        }
        blocks[block_idx] = block_data;
        file_size = file_size + 4096;
    }

    assert(file_size == 16384, "fs: wrote 16384 bytes (4 blocks)");

    // Read back and verify
    for block_idx in 0..4 {
        for byte_idx in 0..100 {
            let expected: u8 = ((block_idx * 4096 + byte_idx) & 0xFF) as u8;
            assert(blocks[block_idx][byte_idx] == expected, "fs: sequential read verify");
        }
    }

    residual emit {
        op: "fs.test.file_write_read_seq",
        blocks_written: 4,
        bytes_written: file_size,
        verified: true,
    };
}

fn test_file_write_sparse() -> void
    effect [compute, residual]
{
    let mut blocks: Array(u64, 100) = Array::splat(0);
    let mut file_blocks: Array(u64, 100) = Array::splat(0);

    // Write to blocks 0, 9, 49, 99 (sparse)
    blocks[0] = 777;
    blocks[9] = 888;
    blocks[49] = 999;
    blocks[99] = 111;

    // File has 100 block slots but only 4 are allocated
    let allocated_count: u64 = 4;
    assert(blocks[0] == 777, "fs: sparse block 0 has data");
    assert(blocks[9] == 888, "fs: sparse block 9 has data");
    assert(blocks[49] == 999, "fs: sparse block 49 has data");
    assert(blocks[99] == 111, "fs: sparse block 99 has data");

    // Blocks 1-8 are zero (unallocated)
    let mut all_zero: bool = true;
    for i in 1..9 {
        if blocks[i] != 0 {
            all_zero = false;
        }
    }
    assert(all_zero, "fs: blocks 1-8 are unallocated (sparse)");

    residual emit {
        op: "fs.test.file_write_sparse",
        total_slots: 100,
        allocated_slots: allocated_count,
        sparse_holes: 96,
    };
}

// ============================================================================
// Test: Path Resolution
// ============================================================================

fn test_path_resolve_absolute() -> void
    effect [compute, residual]
{
    let path: Str(256) = Str::from("/home/user/docs/file.txt");
    let mut components: Array(Str(255), 16) = Array::zeroed();
    let mut depth: u64 = 0;
    let is_absolute: bool = path[0] == '/';

    assert(is_absolute, "fs: path is absolute");

    // Parse path components (simplified)
    let mut start: u64 = 1;
    let path_len: u64 = path.len();
    for i in 1..=path_len {
        if i == path_len || path[i] == '/' {
            if i > start {
                let comp: Str(255) = path.slice_ref(start, i - start);
                components[depth] = comp;
                depth = depth + 1;
            }
            start = i + 1;
        }
    }

    assert(depth == 4, "fs: absolute path has 4 components");
    assert(components[0] == Str::from("home"), "fs: component 0 = home");
    assert(components[1] == Str::from("user"), "fs: component 1 = user");
    assert(components[2] == Str::from("docs"), "fs: component 2 = docs");
    assert(components[3] == Str::from("file.txt"), "fs: component 3 = file.txt");

    residual emit {
        op: "fs.test.path_absolute",
        depth: depth,
        root_components: 4,
    };
}

fn test_path_resolve_relative() -> void
    effect [compute, residual]
{
    let path: Str(256) = Str::from("src/main.rs");
    let is_absolute: bool = path[0] == '/';
    assert(!is_absolute, "fs: path is relative");

    let mut components: Array(Str(255), 8) = Array::zeroed();
    let mut depth: u64 = 0;
    let mut start: u64 = 0;
    let path_len: u64 = path.len();

    for i in 0..=path_len {
        if i == path_len || path[i] == '/' {
            if i > start {
                let comp: Str(255) = path.slice_ref(start, i - start);
                components[depth] = comp;
                depth = depth + 1;
            }
            start = i + 1;
        }
    }

    assert(depth == 2, "fs: relative path has 2 components");
    assert(components[0] == Str::from("src"), "fs: relative component 0 = src");
    assert(components[1] == Str::from("main.rs"), "fs: relative component 1 = main.rs");

    residual emit {
        op: "fs.test.path_relative",
        depth: depth,
        is_relative: true,
    };
}

fn test_path_resolve_dotdot() -> void
    effect [compute, residual]
{
    let mut components: Array(Str(255), 8) = Array::zeroed();
    components[0] = Str::from("home");
    components[1] = Str::from("user");
    components[2] = Str::from("..");
    components[3] = Str::from("docs");
    let mut depth: u64 = 4;

    // Resolve ".." by removing parent
    let mut resolved: Array(Str(255), 8) = Array::zeroed();
    let mut resolved_depth: u64 = 0;

    for i in 0..depth {
        if components[i] == Str::from("..") {
            if resolved_depth > 0 {
                resolved_depth = resolved_depth - 1;
            }
        } else if components[i] != Str::from(".") {
            resolved[resolved_depth] = components[i];
            resolved_depth = resolved_depth + 1;
        }
    }

    assert(resolved_depth == 2, "fs: resolved path has 2 components after ..");
    assert(resolved[0] == Str::from("home"), "fs: resolved[0] = home");
    assert(resolved[1] == Str::from("docs"), "fs: resolved[1] = docs");

    residual emit {
        op: "fs.test.path_dotdot",
        original_depth: depth,
        resolved_depth: resolved_depth,
        dotdot_resolved: true,
    };
}

// ============================================================================
// Test: Buffer Cache
// ============================================================================

fn test_buffer_cache_insert_lookup() -> void
    effect [compute, residual]
{
    let mut cache: BufferCache = BufferCache{
        entries: Array::zeroed(),
        count: 0,
        next_access: 1,
    };

    // Insert block 100
    let mut data100: Array(u8, 4096) = Array::zeroed();
    for i in 0..100 {
        data100[i] = 0xAB;
    }
    cache.entries[0] = BufferCacheEntry{
        block_id: 100,
        data: data100,
        is_dirty: false,
        is_valid: true,
        access_time: cache.next_access,
        ref_count: 1,
    };
    cache.next_access = cache.next_access + 1;
    cache.count = 1;

    // Insert block 200
    let mut data200: Array(u8, 4096) = Array::zeroed();
    for i in 0..200 {
        data200[i] = 0xCD;
    }
    cache.entries[1] = BufferCacheEntry{
        block_id: 200,
        data: data200,
        is_dirty: true,
        is_valid: true,
        access_time: cache.next_access,
        ref_count: 1,
    };
    cache.next_access = cache.next_access + 1;
    cache.count = 2;

    // Lookup block 100
    let mut found: bool = false;
    for i in 0..cache.count {
        if cache.entries[i].block_id == 100 {
            assert(cache.entries[i].data[0] == 0xAB, "fs: cache block 100 data valid");
            assert(cache.entries[i].is_valid, "fs: cache entry is valid");
            found = true;
        }
    }
    assert(found, "fs: cache lookup block 100 found");

    // Lookup block 200
    found = false;
    for i in 0..cache.count {
        if cache.entries[i].block_id == 200 {
            assert(cache.entries[i].data[0] == 0xCD, "fs: cache block 200 data valid");
            assert(cache.entries[i].is_dirty, "fs: cache dirty entry detected");
            found = true;
        }
    }
    assert(found, "fs: cache lookup block 200 found");

    residual emit {
        op: "fs.test.cache_insert_lookup",
        cache_size: cache.count,
        dirty_entries: 1,
        valid_entries: 2,
    };
}

fn test_buffer_cache_eviction() -> void
    effect [compute, residual]
{
    let mut cache: BufferCache = BufferCache{
        entries: Array::zeroed(),
        count: 0,
        next_access: 100,
    };
    let max_entries: u64 = 5;

    // Fill cache with 6 entries (trigger eviction)
    for i in 0..6 {
        if cache.count >= max_entries {
            // Find LRU entry
            let mut lru_idx: u64 = 0;
            let mut lru_time: u64 = cache.entries[0].access_time;
            for j in 1..cache.count {
                if cache.entries[j].access_time < lru_time {
                    lru_time = cache.entries[j].access_time;
                    lru_idx = j;
                }
            }
            // Evict LRU entry
            for j in lru_idx..cache.count - 1 {
                cache.entries[j] = cache.entries[j + 1];
            }
            cache.count = cache.count - 1;
        }
        cache.entries[cache.count] = BufferCacheEntry{
            block_id: 1000 + (i as u64),
            data: Array::zeroed(),
            is_dirty: false,
            is_valid: true,
            access_time: cache.next_access,
            ref_count: 1,
        };
        cache.next_access = cache.next_access + 1;
        cache.count = cache.count + 1;
    }

    assert(cache.count == max_entries, "fs: cache evicted to max_entries");
    // Block 1000 should be evicted (oldest)
    let mut old_evicted: bool = true;
    for i in 0..cache.count {
        if cache.entries[i].block_id == 1000 {
            old_evicted = false;
        }
    }
    assert(old_evicted, "fs: oldest entry 1000 evicted");

    residual emit {
        op: "fs.test.cache_eviction",
        max_entries: max_entries,
        current_entries: cache.count,
        lru_evicted: true,
    };
}

// ============================================================================
// Test: Block Allocation
// ============================================================================

fn test_block_alloc_free() -> void
    effect [compute, residual]
{
    let mut bitmap: BlockBitmap = BlockBitmap{
        blocks: Array::splat(0),
        total_blocks: 1024,
        free_blocks: 1024,
    };

    // Allocate block 42
    let block_to_alloc: u64 = 42;
    let word_idx: u64 = block_to_alloc / 64;
    let bit_idx: u64 = block_to_alloc % 64;
    let mask: u64 = 1 << bit_idx;
    bitmap.blocks[word_idx] = bitmap.blocks[word_idx] | mask;
    bitmap.free_blocks = bitmap.free_blocks - 1;

    assert(bitmap.free_blocks == 1023, "fs: 1023 free blocks after alloc");
    assert((bitmap.blocks[0] & (1 << 42)) != 0, "fs: block 42 marked allocated");

    // Free block 42
    bitmap.blocks[word_idx] = bitmap.blocks[word_idx] & !mask;
    bitmap.free_blocks = bitmap.free_blocks + 1;
    assert(bitmap.free_blocks == 1024, "fs: 1024 free blocks after free");
    assert((bitmap.blocks[0] & (1 << 42)) == 0, "fs: block 42 marked free");

    residual emit {
        op: "fs.test.block_alloc_free",
        total_blocks: bitmap.total_blocks,
        final_free: bitmap.free_blocks,
        ops_completed: 2,
    };
}

fn test_block_bitmap_contiguous() -> void
    effect [compute, residual]
{
    let mut bitmap: BlockBitmap = BlockBitmap{
        blocks: Array::splat(0),
        total_blocks: 256,
        free_blocks: 256,
    };

    // Allocate contiguous blocks 50-59
    let start_block: u64 = 50;
    let count: u64 = 10;
    for i in 0..count {
        let b: u64 = start_block + i;
        let w: u64 = b / 64;
        let bit: u64 = b % 64;
        bitmap.blocks[w] = bitmap.blocks[w] | (1 << bit);
    }
    bitmap.free_blocks = bitmap.free_blocks - count;

    assert(bitmap.free_blocks == 246, "fs: 246 free after 10 allocs");

    // Verify all 10 blocks allocated
    for i in 0..count {
        let b: u64 = start_block + i;
        let w: u64 = b / 64;
        let bit: u64 = b % 64;
        assert((bitmap.blocks[w] & (1 << bit)) != 0, "fs: contiguous block allocated");
    }

    // Free in reverse order
    for i in 0..count {
        let idx: u64 = count - 1 - i;
        let b: u64 = start_block + idx;
        let w: u64 = b / 64;
        let bit: u64 = b % 64;
        bitmap.blocks[w] = bitmap.blocks[w] & !(1 << bit);
    }
    bitmap.free_blocks = bitmap.free_blocks + count;

    assert(bitmap.free_blocks == 256, "fs: all blocks freed");
    assert(bitmap.blocks[0] == 0, "fs: bitmap word 0 is zero");

    residual emit {
        op: "fs.test.block_contiguous",
        allocated: count,
        freed: count,
        final_free: bitmap.free_blocks,
    };
}

// ============================================================================
// Test: Journal Recovery
// ============================================================================

fn test_journal_commit() -> void
    effect [compute, residual]
{
    let mut journal: Journal = Journal{
        entries: Array::zeroed(),
        head: 0,
        tail: 0,
        count: 0,
        next_sequence: 1,
    };

    // Commit transaction: write block 200
    journal.entries[0] = JournalEntry{
        sequence: journal.next_sequence,
        operation: 1, // write
        block_id: 200,
        old_data: Array::zeroed(),
        new_data: Array::splat(0xFF),
        checksum: 0xAABBCCDD,
        timestamp: 5000,
        committed: true,
    };
    journal.next_sequence = journal.next_sequence + 1;
    journal.count = 1;

    // Commit transaction: write block 201
    journal.entries[1] = JournalEntry{
        sequence: journal.next_sequence,
        operation: 1,
        block_id: 201,
        old_data: Array::zeroed(),
        new_data: Array::splat(0xEE),
        checksum: 0x11223344,
        timestamp: 5001,
        committed: true,
    };
    journal.next_sequence = journal.next_sequence + 1;
    journal.count = 2;

    assert(journal.count == 2, "fs: journal has 2 committed entries");
    assert(journal.entries[0].block_id == 200, "fs: journal entry 0 is block 200");
    assert(journal.entries[0].committed, "fs: journal entry 0 committed");
    assert(journal.entries[1].block_id == 201, "fs: journal entry 1 is block 201");

    residual emit {
        op: "fs.test.journal_commit",
        committed_entries: journal.count,
        last_sequence: journal.next_sequence - 1,
    };
}

fn test_journal_replay() -> void
    effect [compute, residual]
{
    let mut journal: Journal = Journal{
        entries: Array::zeroed(),
        head: 0,
        tail: 0,
        count: 0,
        next_sequence: 5,
    };
    // Simulate blocks on disk
    let mut disk_blocks: Array(Array(u8, 4096), 4) = Array::zeroed();

    // Populate journal with committed entries
    journal.entries[0] = JournalEntry{
        sequence: 1, operation: 1, block_id: 10,
        old_data: Array::zeroed(),
        new_data: Array::zeroed(),
        checksum: 0, timestamp: 6000, committed: true,
    };
    journal.entries[0].new_data[0] = 0xAA;
    journal.entries[1] = JournalEntry{
        sequence: 2, operation: 1, block_id: 11,
        old_data: Array::zeroed(),
        new_data: Array::zeroed(),
        checksum: 0, timestamp: 6001, committed: true,
    };
    journal.entries[1].new_data[0] = 0xBB;
    journal.entries[2] = JournalEntry{
        sequence: 3, operation: 1, block_id: 12,
        old_data: Array::zeroed(),
        new_data: Array::zeroed(),
        checksum: 0, timestamp: 6002, committed: true,
    };
    journal.entries[2].new_data[0] = 0xCC;
    journal.count = 3;

    // Simulate replay: apply committed entries to disk blocks
    for i in 0..journal.count {
        if journal.entries[i].committed {
            let bidx: u64 = journal.entries[i].block_id - 10;
            if bidx < 4 {
                disk_blocks[bidx] = journal.entries[i].new_data;
            }
        }
    }

    assert(disk_blocks[0][0] == 0xAA, "fs: replay block 10 data = 0xAA");
    assert(disk_blocks[1][0] == 0xBB, "fs: replay block 11 data = 0xBB");
    assert(disk_blocks[2][0] == 0xCC, "fs: replay block 12 data = 0xCC");

    // Simulate crash: uncommitted entry at position 3 should NOT be applied
    journal.entries[3] = JournalEntry{
        sequence: 4, operation: 1, block_id: 13,
        old_data: Array::zeroed(),
        new_data: Array::zeroed(),
        checksum: 0, timestamp: 6003, committed: false,
    };
    journal.entries[3].new_data[0] = 0xDD;

    // Replay again - uncommitted entry should be skipped
    let mut uncommitted_applied: bool = false;
    for i in 0..4 {
        if journal.entries[i].committed {
            let bidx: u64 = journal.entries[i].block_id - 10;
            if bidx < 4 {
                disk_blocks[bidx] = journal.entries[i].new_data;
            }
        } else {
            uncommitted_applied = true; // Would be skipped in real replay
        }
    }
    assert(disk_blocks[3][0] != 0xDD, "fs: uncommitted entry not replayed");

    residual emit {
        op: "fs.test.journal_replay",
        entries_replayed: 3,
        entries_skipped: 1,
        replay_successful: true,
    };
}

// ============================================================================
// Test: fsck
// ============================================================================

fn test_fsck_check_inodes() -> void
    effect [compute, residual]
{
    let mut fsck: FsckContext = FsckContext{
        inode_checked: 0,
        block_checked: 0,
        orphan_inodes: Array::zeroed(),
        orphan_count: 0,
        duplicate_blocks: Array::zeroed(),
        dup_count: 0,
        bad_blocks: Array::zeroed(),
        bad_count: 0,
        lost_blocks: Array::zeroed(),
        lost_count: 0,
        inode_count_mismatch: 0,
        block_ref_mismatch: 0,
    };

    // Simulate checking 10 inodes
    let total_inodes: u64 = 10;
    for i in 0..total_inodes {
        fsck.inode_checked = fsck.inode_checked + 1;
        // Check each inode's link count
        let link_count: u32 = 1;
        if link_count == 0 {
            fsck.orphan_inodes[fsck.orphan_count] = (i + 1) as u64;
            fsck.orphan_count = fsck.orphan_count + 1;
        }
    }

    assert(fsck.inode_checked == 10, "fs: fsck checked 10 inodes");
    assert(fsck.orphan_count == 0, "fs: no orphan inodes found");

    residual emit {
        op: "fs.test.fsck_inodes",
        inodes_checked: fsck.inode_checked,
        orphans_found: fsck.orphan_count,
    };
}

fn test_fsck_block_consistency() -> void
    effect [compute, residual]
{
    let mut fsck: FsckContext = FsckContext{
        inode_checked: 10,
        block_checked: 0,
        orphan_inodes: Array::zeroed(),
        orphan_count: 1,
        duplicate_blocks: Array::zeroed(),
        dup_count: 0,
        bad_blocks: Array::zeroed(),
        bad_count: 0,
        lost_blocks: Array::zeroed(),
        lost_count: 0,
        inode_count_mismatch: 0,
        block_ref_mismatch: 0,
    };

    // Simulate block reference counting
    let mut block_refs: Array(u32, 50) = Array::splat(0);
    // Inode 1 references block 5, 10, 15
    block_refs[5] = 1;
    block_refs[10] = 1;
    block_refs[15] = 1;
    // Inode 2 references block 10, 20 (duplicate ref to 10!)
    block_refs[10] = block_refs[10] + 1;
    block_refs[20] = 1;

    // Check for duplicate blocks (refcount > 1)
    for i in 0..50 {
        if block_refs[i] > 1 {
            fsck.duplicate_blocks[fsck.dup_count] = i as u64;
            fsck.dup_count = fsck.dup_count + 1;
            fsck.block_ref_mismatch = fsck.block_ref_mismatch + 1;
        }
        if block_refs[i] > 0 {
            fsck.block_checked = fsck.block_checked + 1;
        }
    }

    assert(fsck.duplicate_blocks[0] == 10, "fs: duplicate block 10 detected");
    assert(fsck.dup_count == 1, "fs: 1 duplicate block found");
    assert(fsck.block_checked == 4, "fs: 4 referenced blocks checked");

    // Fix: remove duplicate reference
    block_refs[10] = 1;
    fsck.block_ref_mismatch = 0;
    assert(fsck.block_ref_mismatch == 0, "fs: block consistency restored");

    residual emit {
        op: "fs.test.fsck_blocks",
        blocks_checked: fsck.block_checked,
        duplicates_found: fsck.dup_count,
        repaired: true,
    };
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, FsError)
    effects: [compute, io:write, residual]
{
    console.write_line("Filesystem Tests")!;
    console.write_line("=================")!;

    // Inode tests
    test_inode_alloc();
    console.write_line("  [PASS] Inode allocation")!;
    test_inode_free();
    console.write_line("  [PASS] Inode free")!;
    test_inode_read_write();
    console.write_line("  [PASS] Inode read/write")!;
    test_inode_indirect_blocks();
    console.write_line("  [PASS] Inode indirect blocks")!;

    // Directory tests
    test_directory_create_and_list();
    console.write_line("  [PASS] Directory create/list")!;
    test_directory_lookup();
    console.write_line("  [PASS] Directory lookup")!;

    // File read/write tests
    test_file_write_read_sequential();
    console.write_line("  [PASS] File write/read sequential")!;
    test_file_write_sparse();
    console.write_line("  [PASS] File sparse write")!;

    // Path resolution tests
    test_path_resolve_absolute();
    console.write_line("  [PASS] Path resolve absolute")!;
    test_path_resolve_relative();
    console.write_line("  [PASS] Path resolve relative")!;
    test_path_resolve_dotdot();
    console.write_line("  [PASS] Path resolve dotdot")!;

    // Buffer cache tests
    test_buffer_cache_insert_lookup();
    console.write_line("  [PASS] Buffer cache insert/lookup")!;
    test_buffer_cache_eviction();
    console.write_line("  [PASS] Buffer cache eviction")!;

    // Block allocation tests
    test_block_alloc_free();
    console.write_line("  [PASS] Block alloc/free")!;
    test_block_bitmap_contiguous();
    console.write_line("  [PASS] Block bitmap contiguous")!;

    // Journal tests
    test_journal_commit();
    console.write_line("  [PASS] Journal commit")!;
    test_journal_replay();
    console.write_line("  [PASS] Journal replay")!;

    // fsck tests
    test_fsck_check_inodes();
    console.write_line("  [PASS] fsck inode check")!;
    test_fsck_block_consistency();
    console.write_line("  [PASS] fsck block consistency")!;

    residual emit {
        op: "filesystem_tests.complete",
        inode_tests: 4,
        directory_tests: 2,
        file_rw_tests: 2,
        path_tests: 3,
        cache_tests: 2,
        block_tests: 2,
        journal_tests: 2,
        fsck_tests: 2,
        total_tests: 19,
        result: "all_passed",
    };

    console.write_line("")!;
    console.write_line("All 19 filesystem tests passed!")!;
    return Ok(void);
}
