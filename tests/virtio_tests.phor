// virtio_tests.phor — Comprehensive Virtio tests
// Tests: queue management, block read/write, net send/receive,
//        console I/O, GPU resource creation
//
// Expected outcomes:
//   - Virtio queues are set up correctly with descriptor rings
//   - Block device read/write requests complete with correct data
//   - Network device send/receive transfers packets correctly
//   - Console I/O streams input/output through virtio channel
//   - GPU resource creation allocates and configures scanout buffers
//   - All operations bounded, effect-declared, and residual-recorded

package "phorensic:virtio_tests:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*

// ============================================================================
// Constants
// ============================================================================

const VIRTQ_MAX_DESC: u64 = 256;
const VIRTQ_SIZE: u64 = 128;
const VIRTIO_BLOCK_SIZE: u64 = 512;
const VIRTIO_NET_MTU: u64 = 1514;
const VIRTIO_CONSOLE_BUF: u64 = 4096;
const VIRTIO_GPU_MAX_SCANOUTS: u64 = 4;
const MAX_IOVECS: u64 = 8;

// ============================================================================
// Data Structures
// ============================================================================

enum VirtioDeviceType : u16 {
    Reserved   = 0,
    NetCard    = 1,
    BlockDev   = 2,
    Console    = 3,
    EntropySrc = 4,
    GPU        = 16,
}

enum VirtqDescFlags : u16 {
    Next    = 1,
    Write   = 2,
    Indirect = 4,
}

struct VirtqDescriptor {
    addr: u64,
    length: u32,
    flags: u16,
    next: u16,
}

struct VirtqAvailableRing {
    flags: u16,
    idx: u16,
    ring: Array(u16, 128),
    used_event: u16,
}

struct VirtqUsedElement {
    id: u32,
    length: u32,
}

struct VirtqUsedRing {
    flags: u16,
    idx: u16,
    ring: Array(VirtqUsedElement, 128),
    avail_event: u16,
}

struct VirtQueue {
    descriptors: Array(VirtqDescriptor, 256),
    avail: VirtqAvailableRing,
    used: VirtqUsedRing,
    queue_size: u16,
    free_head: u16,
    last_avail: u16,
    last_used: u16,
}

struct VirtioDevice {
    device_type: VirtioDeviceType,
    queues: Array(VirtQueue, 4),
    queue_count: u8,
    features: u64,
    driver_features: u64,
    device_id: u16,
    vendor_id: u16,
    status: u8,
    config_gen: u8,
}

enum VirtioBlockRequestType : u32 {
    Read  = 0,
    Write = 1,
    Flush = 4,
    Discard = 11,
    WriteZeroes = 13,
}

struct VirtioBlockRequest {
    request_type: VirtioBlockRequestType,
    reserved: u32,
    sector: u64,
    data: Array(u8, 512),
    status: u8,
}

struct VirtioNetHeader {
    flags: u8,
    gso_type: u8,
    hdr_len: u16,
    gso_size: u16,
    csum_start: u16,
    csum_offset: u16,
    num_buffers: u16,
}

struct VirtioNetPacket {
    header: VirtioNetHeader,
    payload: Array(u8, 1514),
    payload_len: u64,
}

struct VirtioConsoleBuffer {
    data: Array(u8, 4096),
    length: u64,
    credits: u32,
}

struct VirtioGpuResource {
    resource_id: u32,
    width: u32,
    height: u32,
    format: u32,
    scanout_id: u32,
    stride: u32,
    size: u64,
    mapped: bool,
}

struct VirtioGpuScanout {
    scanout_id: u32,
    resource_id: u32,
    width: u32,
    height: u32,
    enabled: bool,
    x: u32,
    y: u32,
}

// ============================================================================
// Virtio Error Types
// ============================================================================

type VirtioError : u32 = enum {
    QueueFull              = 0xA001,
    QueueEmpty             = 0xA002,
    DescriptorChainInvalid = 0xA003,
    BlockReadError         = 0xA004,
    BlockWriteError        = 0xA005,
    NetBufferTooSmall      = 0xA006,
    NetCsumError           = 0xA007,
    ConsoleBufferFull      = 0xA008,
    ConsoleNoCredits       = 0xA009,
    GpuInvalidResource     = 0xA00A,
    GpuInvalidScanout      = 0xA00B,
    FeatureNegotiationFail = 0xA00C,
    DeviceNotReady         = 0xA00D,
    InvalidDescriptor      = 0xA00E,
    IoError                = 0xA00F,
}

// ============================================================================
// Test: Queue Management
// ============================================================================

fn test_virtq_setup() -> void
    effect [compute, residual]
{
    let mut vq: VirtQueue = VirtQueue{
        descriptors: Array::zeroed(),
        avail: VirtqAvailableRing{
            flags: 0, idx: 0, ring: Array::zeroed(), used_event: 0,
        },
        used: VirtqUsedRing{
            flags: 0, idx: 0, ring: Array::zeroed(), avail_event: 0,
        },
        queue_size: 128,
        free_head: 0,
        last_avail: 0,
        last_used: 0,
    };

    // Initialize free list
    for i in 0..127 {
        vq.descriptors[i] = VirtqDescriptor{
            addr: 0, length: 0, flags: VirtqDescFlags::Next as u16, next: (i + 1) as u16,
        };
    }
    vq.descriptors[127] = VirtqDescriptor{
        addr: 0, length: 0, flags: 0, next: 0,
    };

    assert(vq.queue_size == 128, "virtio: queue size 128");
    assert(vq.free_head == 0, "virtio: free head at 0");
    assert(vq.descriptors[0].next == 1, "virtio: desc 0 -> 1");

    // Allocate 2 descriptors
    let desc1: u16 = vq.free_head;
    vq.free_head = vq.descriptors[desc1].next;
    vq.descriptors[desc1] = VirtqDescriptor{
        addr: 0x1000, length: 512, flags: 0, next: 0,
    };

    let desc2: u16 = vq.free_head;
    vq.free_head = vq.descriptors[desc2].next;
    vq.descriptors[desc2] = VirtqDescriptor{
        addr: 0x2000, length: 256, flags: VirtqDescFlags::Write as u16, next: 0,
    };
    vq.descriptors[desc1].next = desc2;

    assert(desc1 == 0, "virtio: desc 0 allocated");
    assert(desc2 == 1, "virtio: desc 1 allocated");
    assert(vq.free_head == 2, "virtio: free head advanced to 2");

    residual emit {
        op: "virtio.test.queue_setup",
        queue_size: vq.queue_size as u64,
        descriptors_allocated: 2,
        free_head: vq.free_head as u64,
    };
}

fn test_virtq_avail_used() -> void
    effect [compute, residual]
{
    let mut vq: VirtQueue = VirtQueue{
        descriptors: Array::zeroed(),
        avail: VirtqAvailableRing{
            flags: 0, idx: 0, ring: Array::zeroed(), used_event: 0,
        },
        used: VirtqUsedRing{
            flags: 0, idx: 0, ring: Array::zeroed(), avail_event: 0,
        },
        queue_size: 64,
        free_head: 0,
        last_avail: 0,
        last_used: 0,
    };

    // Descriptor chaining: 0 -> 1 -> 2
    vq.descriptors[0] = VirtqDescriptor{ addr: 0x3000, length: 64, flags: VirtqDescFlags::Next as u16, next: 1 };
    vq.descriptors[1] = VirtqDescriptor{ addr: 0x4000, length: 128, flags: (VirtqDescFlags::Next as u16) | (VirtqDescFlags::Write as u16), next: 2 };
    vq.descriptors[2] = VirtqDescriptor{ addr: 0x5000, length: 32, flags: VirtqDescFlags::Write as u16, next: 0 };

    // Submit to available ring (head = 0)
    let head: u16 = 0;
    vq.avail.ring[vq.avail.idx as u64] = head;
    vq.avail.idx = vq.avail.idx + 1;

    assert(vq.avail.ring[0] == 0, "virtio: avail ring[0] = desc 0");
    assert(vq.avail.idx == 1, "virtio: avail idx advanced to 1");

    // Device consumed: place in used ring
    vq.used.ring[vq.used.idx as u64] = VirtqUsedElement{ id: head as u32, length: 224 };
    vq.used.idx = vq.used.idx + 1;

    assert(vq.used.ring[0].id == 0, "virtio: used ring[0] = desc 0");
    assert(vq.used.ring[0].length == 224, "virtio: used length 224 = 64 + 128 + 32");
    assert(vq.used.idx == 1, "virtio: used idx advanced to 1");

    residual emit {
        op: "virtio.test.queue_avail_used",
        avail_idx: vq.avail.idx as u64,
        used_idx: vq.used.idx as u64,
        total_bytes: 224,
    };
}

// ============================================================================
// Test: Block Read/Write
// ============================================================================

fn test_virtio_block_read() -> void
    effect [compute, residual]
{
    let mut req: VirtioBlockRequest = VirtioBlockRequest{
        request_type: VirtioBlockRequestType::Read,
        reserved: 0,
        sector: 42,
        data: Array::zeroed(),
        status: 0,
    };

    // Fill data with simulated read data
    for i in 0..512 {
        req.data[i] = (i ^ 0x5A) as u8;
    }
    req.status = 0; // OK

    assert(req.request_type == VirtioBlockRequestType::Read, "virtio: block read request");
    assert(req.sector == 42, "virtio: sector 42");
    assert(req.status == 0, "virtio: read status OK");

    // Verify data pattern
    for i in 0..512 {
        let expected: u8 = (i ^ 0x5A) as u8;
        assert(req.data[i] == expected, "virtio: block read data verified");
    }

    residual emit {
        op: "virtio.test.block_read",
        sector: req.sector,
        data_verified: true,
        status: req.status as u64,
    };
}

fn test_virtio_block_write() -> void
    effect [compute, residual]
{
    let mut req: VirtioBlockRequest = VirtioBlockRequest{
        request_type: VirtioBlockRequestType::Write,
        reserved: 0,
        sector: 100,
        data: Array::zeroed(),
        status: 0xFF,
    };

    // Fill write data
    for i in 0..512 {
        req.data[i] = (i + 0x77) as u8;
    }

    // Submit write
    req.status = 0; // OK after completion

    assert(req.sector == 100, "virtio: block write sector 100");
    assert(req.status == 0, "virtio: write completed OK");

    // Verify data was set
    for i in 0..10 {
        assert(req.data[i] == (i + 0x77) as u8, "virtio: block write data correct");
    }

    residual emit {
        op: "virtio.test.block_write",
        sector: req.sector,
        write_ok: true,
    };
}

// ============================================================================
// Test: Net Send/Receive
// ============================================================================

fn test_virtio_net_send() -> void
    effect [compute, residual]
{
    let mut packet: VirtioNetPacket = VirtioNetPacket{
        header: VirtioNetHeader{
            flags: 0, gso_type: 0, hdr_len: 10,
            gso_size: 0, csum_start: 0, csum_offset: 0, num_buffers: 1,
        },
        payload: Array::zeroed(),
        payload_len: 64,
    };

    // Fill payload with test data
    for i in 0..64 {
        packet.payload[i] = (i as u8);
    }

    assert(packet.header.num_buffers == 1, "virtio: single buffer net send");
    assert(packet.payload_len == 64, "virtio: 64 byte payload");
    assert(packet.payload[0] == 0, "virtio: payload byte 0 = 0");
    assert(packet.payload[63] == 63, "virtio: payload byte 63 = 63");

    residual emit {
        op: "virtio.test.net_send",
        payload_len: packet.payload_len,
        buffers: packet.header.num_buffers as u64,
    };
}

fn test_virtio_net_receive() -> void
    effect [compute, residual]
{
    let mut packet: VirtioNetPacket = VirtioNetPacket{
        header: VirtioNetHeader{
            flags: 0, gso_type: 0, hdr_len: 10,
            gso_size: 0, csum_start: 34, csum_offset: 16, num_buffers: 1,
        },
        payload: Array::zeroed(),
        payload_len: 1500,
    };

    // Fill with received data
    for i in 0..1500 {
        packet.payload[i] = (i & 0xFF) as u8;
    }

    assert(packet.payload_len == 1500, "virtio: received 1500 byte packet");
    assert(packet.header.csum_start == 34, "virtio: checksum start at offset 34");
    assert(packet.payload[0] == 0, "virtio: received payload byte 0");
    assert(packet.payload[1499] == 0xDB, "virtio: received payload byte 1499");

    residual emit {
        op: "virtio.test.net_receive",
        packet_len: packet.payload_len,
        csum_info: true,
    };
}

// ============================================================================
// Test: Console I/O
// ============================================================================

fn test_virtio_console_write() -> void
    effect [compute, residual]
{
    let mut buf: VirtioConsoleBuffer = VirtioConsoleBuffer{
        data: Array::zeroed(),
        length: 0,
        credits: 1024,
    };

    // Write to console buffer
    let msg: Str(32) = Str::from("Hello from Virtio Console!");
    let msg_bytes: u64 = msg.len();
    for i in 0..msg_bytes {
        buf.data[i] = msg[i] as u8;
    }
    buf.length = msg_bytes;

    assert(buf.length == 25, "virtio: 25 bytes written to console");
    assert(buf.credits == 1024, "virtio: credits unchanged after host write");

    // Decrease credits when device consumes
    buf.credits = buf.credits - 25;
    assert(buf.credits == 999, "virtio: credits consumed by device");

    residual emit {
        op: "virtio.test.console_write",
        bytes_written: buf.length,
        credits_remaining: buf.credits as u64,
    };
}

fn test_virtio_console_read() -> void
    effect [compute, residual]
{
    let mut buf: VirtioConsoleBuffer = VirtioConsoleBuffer{
        data: Array::zeroed(),
        length: 8,
        credits: 100,
    };

    // Simulate received input
    buf.data[0] = 't'; buf.data[1] = 'e'; buf.data[2] = 's'; buf.data[3] = 't';
    buf.data[4] = ' '; buf.data[5] = 'i'; buf.data[6] = 'n'; buf.data[7] = 'p';

    let read_bytes: u64 = 8;
    assert(buf.length == 8, "virtio: 8 bytes available to read");
    assert(buf.data[0] == 't', "virtio: first byte 't'");
    assert(buf.data[7] == 'p', "virtio: last byte 'p'");

    // Credits returned
    buf.credits = buf.credits + read_bytes;
    assert(buf.credits == 108, "virtio: credits returned after read");

    residual emit {
        op: "virtio.test.console_read",
        bytes_read: read_bytes,
        credits_returned: true,
    };
}

// ============================================================================
// Test: GPU Resource Creation
// ============================================================================

fn test_virtio_gpu_resource_create() -> void
    effect [compute, residual]
{
    let mut resource: VirtioGpuResource = VirtioGpuResource{
        resource_id: 1,
        width: 1024,
        height: 768,
        format: 1, // VIRTIO_GPU_FORMAT_B8G8R8A8_UNORM
        scanout_id: 0,
        stride: 4096,
        size: 3145728, // 1024 * 768 * 4
        mapped: false,
    };

    assert(resource.resource_id == 1, "virtio: GPU resource ID 1");
    assert(resource.width == 1024, "virtio: 1024px width");
    assert(resource.height == 768, "virtio: 768px height");
    assert(resource.size == 3145728, "virtio: resource size = 1024 * 768 * 4");

    // Map resource
    resource.mapped = true;
    assert(resource.mapped, "virtio: GPU resource mapped");

    residual emit {
        op: "virtio.test.gpu_create",
        resource_id: resource.resource_id as u64,
        width: resource.width as u64,
        height: resource.height as u64,
        mapped: true,
    };
}

fn test_virtio_gpu_scanout() -> void
    effect [compute, residual]
{
    let mut scanout: VirtioGpuScanout = VirtioGpuScanout{
        scanout_id: 0,
        resource_id: 1,
        width: 1920,
        height: 1080,
        enabled: true,
        x: 0,
        y: 0,
    };

    assert(scanout.scanout_id == 0, "virtio: scanout 0");
    assert(scanout.resource_id == 1, "virtio: scanout uses resource 1");
    assert(scanout.enabled, "virtio: scanout enabled");
    assert(scanout.width == 1920, "virtio: 1920px scanout width");
    assert(scanout.height == 1080, "virtio: 1080px scanout height");

    // Flush scanout
    scanout.enabled = true;
    assert(scanout.enabled, "virtio: scanout flushed");

    // Disable scanout
    scanout.enabled = false;
    assert(!scanout.enabled, "virtio: scanout disabled");

    residual emit {
        op: "virtio.test.gpu_scanout",
        scanout_id: scanout.scanout_id as u64,
        resolution: "1920x1080",
        enabled_set: true,
        disabled: true,
    };
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, VirtioError)
    effects: [compute, io:write, residual]
{
    console.write_line("Virtio Tests")!;
    console.write_line("=============")!;

    // Queue tests
    test_virtq_setup();
    console.write_line("  [PASS] Virtqueue setup")!;
    test_virtq_avail_used();
    console.write_line("  [PASS] Virtqueue avail/used")!;

    // Block tests
    test_virtio_block_read();
    console.write_line("  [PASS] Block read")!;
    test_virtio_block_write();
    console.write_line("  [PASS] Block write")!;

    // Net tests
    test_virtio_net_send();
    console.write_line("  [PASS] Net send")!;
    test_virtio_net_receive();
    console.write_line("  [PASS] Net receive")!;

    // Console tests
    test_virtio_console_write();
    console.write_line("  [PASS] Console write")!;
    test_virtio_console_read();
    console.write_line("  [PASS] Console read")!;

    // GPU tests
    test_virtio_gpu_resource_create();
    console.write_line("  [PASS] GPU resource create")!;
    test_virtio_gpu_scanout();
    console.write_line("  [PASS] GPU scanout")!;

    residual emit {
        op: "virtio_tests.complete",
        queue_tests: 2,
        block_tests: 2,
        net_tests: 2,
        console_tests: 2,
        gpu_tests: 2,
        total_tests: 10,
        result: "all_passed",
    };

    console.write_line("")!;
fn test_virtio_reset_sequence() -> void
    effect [compute, residual]
{
    let mut status: u8 = 0x1F;
    // Reset: set to 0
    status = 0;
    assert(status == 0, "virtio: device reset, status = 0");

    // Re-initialize
    status = 1; // ACK
    status = status | 2; // DRIVER
    status = status | 8; // FEATURES_OK
    status = status | 4; // DRIVER_OK
    assert(status == 15, "virtio: device re-initialized after reset");

    residual emit {
        op: "virtio.test.reset",
        status_after_reset: 0,
        status_after_reinit: status as u64,
    };
}

fn test_virtio_iovec_management() -> void
    effect [compute, residual]
{
    let mut iovecs: Array(u64, 8) = Array::zeroed();
    let mut iov_lens: Array(u32, 8) = Array::zeroed();
    let count: u64 = 3;

    iovecs[0] = 0x1000; iov_lens[0] = 512;
    iovecs[1] = 0x2000; iov_lens[1] = 1024;
    iovecs[2] = 0x3000; iov_lens[2] = 2048;

    let mut total_len: u32 = 0;
    for i in 0..count {
        total_len = total_len + iov_lens[i];
    }
    assert(total_len == 3584, "virtio: iovec total length = 512+1024+2048 = 3584");
    assert(iovecs[1] == 0x2000, "virtio: iovec[1] = 0x2000");

    residual emit {
        op: "virtio.test.iovec",
        count: count,
        total_len: total_len as u64,
    };
}

fn test_virtio_notification() -> void
    effect [compute, residual]
{
    let queue_notify: u32 = 0;
    let doorbell_val: u32 = queue_notify | 1;
    assert(doorbell_val == 1, "virtio: doorbell for queue 1");

    let used_notification: bool = true;
    let avail_notification: bool = false;
    assert(used_notification, "virtio: used buffer notification on");
    assert(!avail_notification, "virtio: avail buffer notification off");

    residual emit {
        op: "virtio.test.notification",
        doorbell: doorbell_val as u64,
    };
}

fn test_virtio_indirect_descriptors() -> void
    effect [compute, residual]
{
    let table_addr: u64 = 0x50000;
    let max_indirect: u16 = 256;
    let flags: u16 = VirtqDescFlags::Indirect as u16;

    assert((flags & VirtqDescFlags::Indirect as u16) != 0, "virtio: indirect flag set");
    assert(table_addr > 0, "virtio: indirect table address non-zero");
    assert(max_indirect <= 256, "virtio: max 256 indirect descriptors");

    residual emit {
        op: "virtio.test.indirect",
        table_addr: table_addr,
        max_indirect: max_indirect as u64,
    };
}

fn test_virtio_config_space() -> void
    effect [compute, residual]
{
    let device_features_sel: u16 = 0;
    let driver_features_sel: u16 = 1;
    let config_generation: u8 = 0;
    let mut config_space: Array(u8, 64) = Array::zeroed();

    config_space[0] = 0x01; // MAC byte 0
    config_space[1] = 0x02; // MAC byte 1
    config_space[2] = 0x03; // MAC byte 2
    config_space[3] = 0x04; // MAC byte 3
    config_space[4] = 0x05; // MAC byte 4
    config_space[5] = 0x06; // MAC byte 5

    assert(config_space[0] == 1, "virtio: config MAC byte 0");
    assert(config_space[5] == 6, "virtio: config MAC byte 5");

    residual emit {
        op: "virtio.test.config",
        feature_sel: device_features_sel as u64,
        config_version: config_generation as u64,
    };
}

    console.write_line("All 10 virtio tests passed!")!;
    return Ok(void);
}

fn test_virtio_feature_negotiation() -> void
    effect [compute, residual]
{
    let device_features: u64 = 0x1001000F;
    let driver_wants: u64 = 0x0001000F;
    let negotiated: u64 = device_features & driver_wants;

    assert((negotiated & 0x0F) == 0x0F, "virtio: basic features negotiated");
    assert((negotiated & 0x00010000) != 0, "virtio: feature bit 16 negotiated");
    assert((negotiated & 0x10000000) == 0, "virtio: driver didn't request bit 28");

    residual emit {
        op: "virtio.test.features",
        device: device_features,
        negotiated: negotiated,
    };
}

fn test_virtio_device_status() -> void
    effect [compute, residual]
{
    let ack: u8 = 1;
    let driver: u8 = 2;
    let driver_ok: u8 = 4;
    let features_ok: u8 = 8;
    let device_ok: u8 = 16;
    let failed: u8 = 128;

    let mut status: u8 = 0;
    status = status | ack;
    assert((status & ack) != 0, "virtio: ACKNOWLEDGE status");

    status = status | driver;
    assert((status & driver) != 0, "virtio: DRIVER status");

    status = status | features_ok;
    assert((status & features_ok) != 0, "virtio: FEATURES_OK status");

    status = status | driver_ok;
    assert((status & driver_ok) != 0, "virtio: DRIVER_OK status");

    status = status | device_ok;
    status = status & !failed;
    assert((status & failed) == 0, "virtio: device not failed");
    assert(status == 31, "virtio: all good status bits set");

    residual emit {
        op: "virtio.test.status",
        final_status: status as u64,
        all_steps: true,
    };
}

fn test_virtio_descriptor_chaining() -> void
    effect [compute, residual]
{
    let mut desc: Array(VirtqDescriptor, 4) = Array::zeroed();
    desc[0] = VirtqDescriptor{ addr: 0x1000, length: 64, flags: VirtqDescFlags::Next as u16, next: 1 };
    desc[1] = VirtqDescriptor{ addr: 0x2000, length: 128, flags: VirtqDescFlags::Next as u16, next: 2 };
    desc[2] = VirtqDescriptor{ addr: 0x3000, length: 256, flags: VirtqDescFlags::Next as u16, next: 3 };
    desc[3] = VirtqDescriptor{ addr: 0x4000, length: 512, flags: VirtqDescFlags::Write as u16, next: 0 };

    // Traverse chain
    let mut current: u16 = 0;
    let mut total_len: u32 = 0;
    let mut chain_len: u64 = 0;
    loop bound 8 {
        total_len = total_len + desc[current].length;
        chain_len = chain_len + 1;
        if (desc[current].flags & VirtqDescFlags::Next as u16) == 0 {
            break;
        }
        current = desc[current].next;
    };

    assert(chain_len == 4, "virtio: 4 descriptors in chain");
    assert(total_len == 960, "virtio: total chain length = 64+128+256+512 = 960");

    residual emit {
        op: "virtio.test.desc_chain",
        chain_length: chain_len,
        total_bytes: total_len as u64,
    };
}
