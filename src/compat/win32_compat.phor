//==============================================================================
// Utility Functions
//==============================================================================

pub enum Win32Op : u8 {
  PeLoad        = 0,
  ComInit       = 1,
  ComUninit     = 2,
  ComCreate     = 3,
  CreateProcess = 4,
  GdiCreateDC   = 5,
  RegOpen       = 6,
}

pub enum CapRights(:u64);
pub const RIGHT_PROC_CREATE: CapRights = CapRights(1 << 28);

fn hash_name[name: *u8] -> u64 : effect:(pure) {
  var h: u64 = 0;
  for var i: u32 = 0; i < 256; i += 1 {
    if name[i] == 0 { break; }
    h = h * 31 + name[i] as u64;
  }
  return h;
}

fn string_to_fixed[s: *u8] -> [u8; 256] : effect:(pure) {
  var result: [u8; 256] = Default;
  for var i: u32 = 0; i < 255; i += 1 {
    result[i] = s[i];
    if s[i] == 0 { break; }
  }
  return result;
}

fn string_matches[a: [u8; 256], b: *u8] -> bool : effect:(pure) {
  for var i: u32 = 0; i < 256; i += 1 {
    if a[i] != b[i] { return false; }
    if a[i] == 0 { return true; }
  }
  return b[255] == 0;
}

fn record_win32_residual[op: Win32Op, arg1: u64, arg2: u64] : effect:(unsafe) {
  __win32_residual_write(op as u64, arg1, arg2);
}

pub fn __win32_residual_write[op: u64, a1: u64, a2: u64] : effect:(unsafe) {}

