}

pub fn load_device_tree(env: ref BootEnvironment, console: Cap(Console)) -> Result[(), BootError>
    effects: [io:write, io:read, deterministic]
{
    console.write_line("BootLoader: Loading device tree...")!
    // Delegated to device_tree module
    Result::Ok(())
}

fn read_timestamp() -> Word64
    effects: [machine:ioport]
{
    trusted "TSC read: RDTSC instruction, Intel SDM Vol 3 §17.15"
    {
        Word64::from_u64(0)
    }
}

// ──────────────────────────────────────────────
// String/Display Helpers
// ──────────────────────────────────────────────

fn concat(a: FixedString[128], b: FixedString[128]) -> FixedString[256]
    effects: [deterministic]
{
    let mut result: FixedString[256] = FixedString::new()
    result.append_str(a)
    result.append_str(b)
    result
}

fn hex(val: Word64) -> FixedString[32]
    effects: [deterministic]
{
    let mut result: FixedString[32] = FixedString::new()
    let hex_chars: FixedArray[16, u8] = {
        let mut chars: FixedArray[16, u8] = FixedArray::new()
        chars.push('0' as u8)!
        chars.push('1' as u8)!
        chars.push('2' as u8)!
        chars.push('3' as u8)!
        chars.push('4' as u8)!
        chars.push('5' as u8)!
        chars.push('6' as u8)!
        chars.push('7' as u8)!
        chars.push('8' as u8)!
        chars.push('9' as u8)!
        chars.push('A' as u8)!
        chars.push('B' as u8)!
        chars.push('C' as u8)!
        chars.push('D' as u8)!
        chars.push('E' as u8)!
        chars.push('F' as u8)!
        chars
    }
    let mut v: Word64 = val
    let mut digits: FixedArray[16, u8] = FixedArray::new()
    for i in 0..16 {
        let nibble: u8 = (v.to_u64() & 0xF) as u8
        digits.push(hex_chars.get(nibble as u32)!)!
        v = v.shr(4)
    }
    for i in 0..16 {
        let idx: u32 = 15 - i
        result.append_byte(digits.get(idx)!)!
    }
    result
}
