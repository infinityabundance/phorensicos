// ──────────────────────────────────────────────
// UEFI Boot Services Table Initialization
// ──────────────────────────────────────────────

pub fn parse_uefi_boot_services(st_ptr: Word64) -> Result[EFI_BOOT_SERVICES, BootError>
    effects: [io:read, deterministic]
{
    trusted "Parse UEFI Boot Services Table from System Table: UEFI Spec §4.6, boot_services field at offset 104 in system table"
    {
        let bs: EFI_BOOT_SERVICES = EFI_BOOT_SERVICES::new()
        if !bs.validate() {
            return Result::Err(BootError::new(
                DIAG_UEFI_BASE | 0x030,
                "Invalid UEFI boot services table signature"
            ))
        }
        Result::Ok(bs)
    }
}

// ──────────────────────────────────────────────
// UEFI System Table Parsing
// ──────────────────────────────────────────────

pub fn parse_uefi_system_table(table_ptr: Word64) -> Result[EFI_SYSTEM_TABLE, BootError>
    effects: [io:read, deterministic]
{
    trusted "Parse UEFI System Table: UEFI Spec §4.3, system table layout defined in table 4-1"
    {
        let st: EFI_SYSTEM_TABLE = EFI_SYSTEM_TABLE::new()
        if !st.validate_system_table() {
            return Result::Err(BootError::new(
                DIAG_UEFI_BASE | 0x040,
                "Invalid UEFI system table signature"
            ))
        }
        Result::Ok(st)
    }
}

// ──────────────────────────────────────────────
// BootError for UEFI module
// ──────────────────────────────────────────────

pub type BootError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BootError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BootError
        effects: [deterministic]
    {
        BootError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }

    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }

    pub fn is_ok(self) -> bool
        effects: [deterministic]
    {
        self.code == 0
    }
}
