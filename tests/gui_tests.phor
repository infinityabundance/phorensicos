// gui_tests.phor — Tests for the Phorensic native GUI system
// Tests: compositor, surfaces, input, window manager, widgets
//
// Expected outcomes:
//   - Compositor correctly manages surface creation/destruction and compositing
//   - Surfaces follow state machine: initial → configured → mapped → unmapped → destroyed
//   - Input handler routes events to focused client via capability-gated channels
//   - Window manager configures surface position, size, focus, z-order
//   - Widget system provides buttons, labels, text inputs, containers with bounds checking
//   - Presentation scheduling produces present receipts with residuals
//   - All operations are capability-gated

package "phorensic:gui_tests:v1.0";

// ============================================================================
// Section 1: Compositor Tests
// ============================================================================

struct Surface {
    id: u64,
    width: u32,
    height: u32,
    format: u8,        // 0=RGBA, 1=BGRA, 2=XRGB
    state: u8,         // 0=initial, 1=configured, 2=mapped, 3=unmapped, 4=destroyed
    buffer: Array(u8, 4096),
    damage_rects: u32,
}

struct Compositor {
    surface_count: u32,
    max_surfaces: u32,
    outputs: Array(u32, 4),
    present_count: u64,
}

fn test_compositor_create() -> void
    effect [io:write, memory:mmio, residual]
{
    let compositor: Compositor = Compositor{
        surface_count: 0,
        max_surfaces: 64,
        outputs: Array::splat(0),
        present_count: 0,
    };

    compositor.outputs[0] = 0; // Primary output

    assert(compositor.max_surfaces == 64, "gui: compositor max 64 surfaces");
    assert(compositor.surface_count == 0, "gui: compositor starts empty");

    residual emit {
        op: "gui.compositor_create",
        max_surfaces: compositor.max_surfaces,
    };
}

fn test_compositor_surface_create_destroy() -> void
    effect [io:write, memory:mmio, residual]
{
    let mut compositor: Compositor = Compositor{
        surface_count: 0,
        max_surfaces: 64,
        outputs: Array::splat(0),
        present_count: 0,
    };

    // Create a surface
    let surface: Surface = Surface{
        id: 1,
        width: 800,
        height: 600,
        format: 0,
        state: 0, // initial
        buffer: Array::zeroed(),
        damage_rects: 0,
    };

    compositor.surface_count = compositor.surface_count + 1;
    assert(compositor.surface_count == 1, "gui: surface created");

    // Destroy surface
    compositor.surface_count = compositor.surface_count - 1;
    assert(compositor.surface_count == 0, "gui: surface destroyed");

    residual emit {
        op: "gui.surface_create_destroy",
        created: 1,
        destroyed: 1,
    };
}

fn test_compositor_present() -> void
    effect [io:write, memory:mmio, residual]
{
    let mut compositor: Compositor = Compositor{
        surface_count: 1,
        max_surfaces: 64,
        outputs: Array::splat(0),
        present_count: 0,
    };

    // Composite all surfaces and present
    compositor.present_count = compositor.present_count + 1;
    assert(compositor.present_count == 1, "gui: compositor presented frame");

    residual emit {
        op: "gui.compositor_present",
        frame: compositor.present_count,
        surfaces: compositor.surface_count,
    };
}

// ============================================================================
// Section 2: Surface State Machine Tests
// ============================================================================

fn test_surface_state_machine() -> void
    effect [io:write, residual]
{
    let mut surface: Surface = Surface{
        id: 1,
        width: 800,
        height: 600,
        format: 0,
        state: 0, // initial
        buffer: Array::zeroed(),
        damage_rects: 0,
    };

    // initial → configured
    surface.state = 1;
    assert(surface.state == 1, "gui: surface configured");

    // configured → mapped
    surface.state = 2;
    assert(surface.state == 2, "gui: surface mapped");

    // mapped → unmapped
    surface.state = 3;
    assert(surface.state == 3, "gui: surface unmapped");

    // unmapped → destroyed
    surface.state = 4;
    assert(surface.state == 4, "gui: surface destroyed");

    residual emit {
        op: "gui.surface_state_machine",
        id: surface.id,
        states: "initial→configured→mapped→unmapped→destroyed",
    };
}

fn test_surface_damage_tracking() -> void
    effect [io:write, residual]
{
    let mut surface: Surface = Surface{
        id: 2,
        width: 1024,
        height: 768,
        format: 0,
        state: 2, // mapped
        buffer: Array::zeroed(),
        damage_rects: 0,
    };

    // Mark damaged regions for efficient compositing
    surface.damage_rects = surface.damage_rects + 1; // Rect(10, 10, 100, 100)
    surface.damage_rects = surface.damage_rects + 1; // Rect(200, 50, 50, 50)

    assert(surface.damage_rects == 2, "gui: 2 damaged regions tracked");

    residual emit {
        op: "gui.surface_damage",
        rects: surface.damage_rects,
    };
}

// ============================================================================
// Section 3: Input Handler Tests
// ============================================================================

struct InputEvent {
    event_type: u8,    // 0=keyboard, 1=pointer, 2=touch
    code: u32,
    value: i32,
    timestamp: u64,
}

struct InputHandler {
    device_count: u32,
    keyboard_focus: u64,
    event_queue: Array(InputEvent, 64),
    queue_pos: u32,
}

fn test_input_event_routing() -> void
    effect [io:write, residual]
{
    let mut handler: InputHandler = InputHandler{
        device_count: 2,
        keyboard_focus: 1, // surface ID 1 has focus
        event_queue: Array::splat(InputEvent{
            event_type: 0,
            code: 0,
            value: 0,
            timestamp: 0,
        }),
        queue_pos: 0,
    };

    // Capture keyboard event
    let event: InputEvent = InputEvent{
        event_type: 0,
        code: 0x1E, // 'A' key
        value: 1,    // pressed
        timestamp: 1000,
    };

    handler.event_queue[handler.queue_pos] = event;
    handler.queue_pos = handler.queue_pos + 1;

    assert(handler.queue_pos == 1, "gui: input event queued");
    assert(handler.event_queue[0].code == 0x1E, "gui: 'A' key event");

    residual emit {
        op: "gui.input_event",
        type: event.event_type,
        code: event.code,
        focused_surface: handler.keyboard_focus,
    };
}

fn test_input_focus_management() -> void
    effect [io:write, residual]
{
    let mut handler: InputHandler = InputHandler{
        device_count: 2,
        keyboard_focus: 0,
        event_queue: Array::splat(InputEvent{ event_type: 0, code: 0, value: 0, timestamp: 0 }),
        queue_pos: 0,
    };

    // Focus surface 1
    handler.keyboard_focus = 1;
    assert(handler.keyboard_focus == 1, "gui: focus set to surface 1");

    // Focus surface 2 (surface 1 loses focus)
    handler.keyboard_focus = 2;
    assert(handler.keyboard_focus == 2, "gui: focus transferred to surface 2");

    residual emit {
        op: "gui.input_focus",
        surface: handler.keyboard_focus,
    };
}

// ============================================================================
// Section 4: Window Manager Tests
// ============================================================================

struct Window {
    surface_id: u64,
    x: i32,
    y: i32,
    width: u32,
    height: u32,
    z_order: u32,
    visible: bool,
    has_focus: bool,
}

struct WindowManager {
    windows: Array(Window, 64),
    window_count: u32,
    next_z: u32,
}

fn test_window_create_configure() -> void
    effect [io:write, residual]
{
    let mut wm: WindowManager = WindowManager{
        windows: Array::splat(Window{
            surface_id: 0,
            x: 0, y: 0,
            width: 0, height: 0,
            z_order: 0,
            visible: false,
            has_focus: false,
        }),
        window_count: 0,
        next_z: 0,
    };

    // Create window
    let window: Window = Window{
        surface_id: 1,
        x: 100, y: 100,
        width: 800, height: 600,
        z_order: wm.next_z,
        visible: true,
        has_focus: false,
    };

    wm.windows[0] = window;
    wm.window_count = 1;
    wm.next_z = wm.next_z + 1;

    assert(wm.window_count == 1, "gui: window created");
    assert(window.visible, "gui: window visible");
    assert(window.z_order == 0, "gui: window at z=0");

    // Configure window
    wm.windows[0].x = 200;
    wm.windows[0].y = 150;
    assert(wm.windows[0].x == 200, "gui: window repositioned");

    residual emit {
        op: "gui.window_create",
        surface: window.surface_id,
        x: window.x, y: window.y,
        w: window.width, h: window.height,
    };
}

fn test_window_stack_management() -> void
    effect [io:write, residual]
{
    let mut wm: WindowManager = WindowManager{
        windows: Array::splat(Window{
            surface_id: 0, x: 0, y: 0,
            width: 0, height: 0,
            z_order: 0, visible: false,
            has_focus: false,
        }),
        window_count: 0,
        next_z: 0,
    };

    // Window A (behind)
    wm.windows[0] = Window{ surface_id: 1, x: 0, y: 0, width: 400, height: 300, z_order: 0, visible: true, has_focus: false };
    wm.window_count = 1;
    wm.next_z = 1;

    // Window B (above)
    wm.windows[1] = Window{ surface_id: 2, x: 50, y: 50, width: 400, height: 300, z_order: 1, visible: true, has_focus: false };
    wm.window_count = 2;
    wm.next_z = 2;

    // B is above A
    assert(wm.windows[0].z_order < wm.windows[1].z_order, "gui: window B above window A");

    // Raise window A to top
    wm.windows[0].z_order = 2;
    wm.next_z = 3;
    assert(wm.windows[0].z_order > wm.windows[1].z_order, "gui: window A raised above B");

    residual emit {
        op: "gui.window_stack",
        count: wm.window_count,
        top_z: wm.next_z - 1,
    };
}

// ============================================================================
// Section 5: Widget System Tests
// ============================================================================

struct Button {
    id: u64,
    x: i32, y: i32,
    width: u32, height: u32,
    label: Str(64),
    enabled: bool,
    pressed: bool,
}

struct Label {
    id: u64,
    x: i32, y: i32,
    text: Str(256),
    font_size: u8,
}

struct Container {
    id: u64,
    x: i32, y: i32,
    width: u32, height: u32,
    children: Array(u64, 16),
    child_count: u32,
}

fn test_widget_button() -> void
    effect [io:write, residual]
{
    let button: Button = Button{
        id: 1,
        x: 10, y: 10,
        width: 120, height: 32,
        label: Str::from("Click Me"),
        enabled: true,
        pressed: false,
    };

    assert(button.enabled, "gui: button enabled");
    assert(button.width == 120, "gui: button width");

    // Click button
    // Check if (click_x, click_y) is inside button bounds
    let click_x: i32 = 50;
    let click_y: i32 = 25;
    let inside: bool = click_x >= button.x
        && click_x < button.x + (button.width as i32)
        && click_y >= button.y
        && click_y < button.y + (button.height as i32);
    assert(inside, "gui: click inside button bounds");

    residual emit {
        op: "gui.widget_button",
        id: button.id,
        label: button.label,
        clicked: 1,
    };
}

fn test_widget_label() -> void
    effect [io:write, residual]
{
    let label: Label = Label{
        id: 2,
        x: 10, y: 50,
        text: Str::from("Hello, Phorensic GUI!"),
        font_size: 14,
    };

    assert(label.text.len() > 0, "gui: label has text");
    assert(label.font_size == 14, "gui: label font size 14");

    residual emit {
        op: "gui.widget_label",
        id: label.id,
        text_len: label.text.len(),
    };
}

fn test_widget_container() -> void
    effect [io:write, residual]
{
    let mut container: Container = Container{
        id: 3,
        x: 0, y: 0,
        width: 400, height: 300,
        children: Array::splat(0),
        child_count: 0,
    };

    // Add widgets to container
    container.children[0] = 1; // Button
    container.children[1] = 2; // Label
    container.child_count = 2;

    assert(container.child_count == 2, "gui: container has 2 children");

    // Child bounds check: children must be within container
    let child_x: i32 = 10;
    let child_y: i32 = 50;
    let in_container: bool = child_x >= container.x
        && child_x < container.x + (container.width as i32)
        && child_y >= container.y
        && child_y < container.y + (container.height as i32);
    assert(in_container, "gui: child within container bounds");

    residual emit {
        op: "gui.widget_container",
        id: container.id,
        children: container.child_count,
    };
}

// ============================================================================
// Section 6: Display Protocol Tests
// ============================================================================

fn test_display_capability_gating() -> void
    effect [io:write, residual]
{
    // The display protocol is capability-based:
    //   - create_surface: requires Cap(Compositor)
    //   - present: requires surface capability
    //   - receive_input: requires input focus
    //   - configure: requires window management capability

    let has_compositor_cap: bool = true;
    let has_surface_cap: bool = true;

    let can_create_surface: bool = has_compositor_cap;
    let can_present: bool = has_surface_cap;

    assert(can_create_surface, "gui: compositor cap allows surface creation");
    assert(can_present, "gui: surface cap allows present");

    residual emit {
        op: "gui.display_cap_gating",
        compositor_cap: if has_compositor_cap { 1 } else { 0 },
        surface_cap: if has_surface_cap { 1 } else { 0 },
    };
}

fn test_widget_text_input() -> void
    effect [io:write, residual]
{
    let input_id: u64 = 4;
    let text: Str(256) = Str::from("Hello");
    let cursor_pos: u32 = 5;

    // Text input has fixed capacity
    assert(text.capacity() == 256, "gui: text input capacity 256");
    assert(text.len() == 5, "gui: initial text length 5");

    // Append character (bounded by capacity)
    // In a real system: text.append_char('!')
    assert(cursor_pos == 5, "gui: cursor at end of text");

    residual emit {
        op: "gui.widget_text_input",
        id: input_id,
        text_len: text.len(),
    };
}

fn test_widget_containment_hierarchy() -> void
    effect [io:write, residual]
{
    // Widgets can be nested in containers with bounds checking
    let outer: Container = Container{
        id: 10,
        x: 0, y: 0,
        width: 500, height: 400,
        children: Array::splat(0),
        child_count: 0,
    };

    let inner: Container = Container{
        id: 11,
        x: 50, y: 50,
        width: 200, height: 150,
        children: Array::splat(0),
        child_count: 0,
    };

    // Inner must be within outer bounds
    let inner_in_outer: bool = inner.x >= outer.x
        && inner.y >= outer.y
        && inner.x + (inner.width as i32) <= outer.x + (outer.width as i32)
        && inner.y + (inner.height as i32) <= outer.y + (outer.height as i32);
    assert(inner_in_outer, "gui: inner container within outer bounds");

    // Widget at (450, 350) in outer is valid
    let widget_x: i32 = 450;
    let widget_y: i32 = 350;
    let in_bounds: bool = widget_x >= outer.x
        && widget_x < outer.x + (outer.width as i32)
        && widget_y >= outer.y
        && widget_y < outer.y + (outer.height as i32);
    assert(in_bounds, "gui: widget within outer container");

    // Widget at (600, 500) is OUT of bounds
    let out_x: i32 = 600;
    let out_y: i32 = 500;
    let out_of_bounds: bool = out_x < outer.x
        || out_x >= outer.x + (outer.width as i32)
        || out_y < outer.y
        || out_y >= outer.y + (outer.height as i32);
    assert(out_of_bounds, "gui: out-of-bounds widget detected");

    residual emit {
        op: "gui.widget_hierarchy",
        outer_width: outer.width,
        outer_height: outer.height,
        children: outer.child_count,
    };
}

fn test_compositor_multi_output() -> void
    effect [io:write, memory:mmio, residual]
{
    // Compositor can manage multiple outputs (displays)
    let compositor: Compositor = Compositor{
        surface_count: 2,
        max_surfaces: 64,
        outputs: Array::splat(0),
        present_count: 0,
    };

    compositor.outputs[0] = 0; // Primary
    compositor.outputs[1] = 1; // Secondary

    assert(compositor.outputs[0] == 0, "gui: primary output");
    assert(compositor.outputs[1] == 1, "gui: secondary output");

    residual emit {
        op: "gui.compositor_multi_output",
        output_count: 2,
    };
}

fn test_compositor_surface_damage_optimization() -> void
    effect [io:write, memory:mmio, residual]
{
    // Only damaged regions are recomposited
    let mut surface: Surface = Surface{
        id: 3,
        width: 800,
        height: 600,
        format: 0,
        state: 2, // mapped
        buffer: Array::zeroed(),
        damage_rects: 0,
    };

    // Only region (10,10,100,50) is damaged
    surface.damage_rects = 1; // Represents one damage rectangle
    assert(surface.damage_rects == 1, "gui: one damage region");

    residual emit {
        op: "gui.damage_optimization",
        damage_rects: surface.damage_rects,
    };
}

// ============================================================================
// Main: Run all GUI tests
// ============================================================================

fn main() -> void
    effect [compute, io:write, io:read, memory:mmio, residual]
{
    // Section 1: Compositor
    test_compositor_create();
    test_compositor_surface_create_destroy();
    test_compositor_present();
    test_compositor_multi_output();
    test_compositor_surface_damage_optimization();

    // Section 2: Surfaces
    test_surface_state_machine();
    test_surface_damage_tracking();

    // Section 3: Input
    test_input_event_routing();
    test_input_focus_management();

    // Section 4: Window Manager
    test_window_create_configure();
    test_window_stack_management();

    // Section 5: Widgets
    test_widget_button();
    test_widget_label();
    test_widget_container();
    test_widget_text_input();
    test_widget_containment_hierarchy();

    // Section 6: Display Protocol
    test_display_capability_gating();

    residual emit {
        op: "gui_tests.complete",
        total_sections: 6,
        status: "pass",
    };
}
