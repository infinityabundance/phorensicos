}

pub fn verify_audit_chain(adb: ref AuditDatabase) -> bool
    effects: [deterministic, residual]
{
    let result: bool = AuditDatabase::verify_integrity(adb)
    result
}

pub fn perform_audit_trail_audit(adb: ref mut AuditDatabase, current_time: Word64) -> FixedString[1024]
    effects: [deterministic, residual]
{
    let mut report: FixedString[1024] = FixedString::new()
    report.append(FixedString[32]::from_slice("Audit Trail Audit\n"))
    report.append(FixedString[32]::from_slice("==================\n"))

    let intact: bool = adb.chain.verify_chain()
    report.append(FixedString[16]::from_slice("Chain intact: "))
    report.append(if intact {
        FixedString[3]::from_slice("YES")
    } else {
        FixedString[4]::from_slice("FAIL")
    })

    if !intact {
        let tamper_idx: u32 = adb.chain.detect_tamper_since(0)
        report.append(FixedString[16]::from_slice("\nTamper detected at index: "))
        report.append_u64(tamper_idx as u64)
    }

    report.append(FixedString[16]::from_slice("\nTotal entries: "))
    report.append_u64(adb.total_entries.to_u64())
    report.append(FixedString[16]::from_slice("\nChain length: "))
    report.append_u64(adb.chain.entry_count as u64)
    report.append(FixedString[16]::from_slice("\nArchived: "))
    report.append_u64(adb.archive_mgr.total_archived.to_u64())

    residual emit {
        audit_op: "trail.audit.complete",
        intact: if intact { 1 } else { 0 },
        chain_length: adb.chain.entry_count as u64,
    }

    report
}

// ──────────────────────────────────────────────
// Module Initialization
// ──────────────────────────────────────────────
pub fn init_audit_database(max_age_ns: Word64, max_entries: u32, min_severity: AuditSeverity) -> AuditDatabase
    effects: [deterministic, residual]
{
    let db: AuditDatabase = AuditDatabase::new(max_age_ns, max_entries, min_severity)
    residual emit {
        audit_op: "audit.subsystem.init",
        max_entries: AUDIT_MAX_ENTRIES as u64,
        chain_depth: AUDIT_CHAIN_DEPTH as u64,
        min_severity: min_severity as u64,
    }

    // Record initialization event in the audit log itself
    let msg: FixedString[512] = FixedString[512]::from_slice("Audit database initialized with tamper-evident chain")
    let _ = db.record_event(AuditSeverity::AuditSeverity_Info,
        FixedString[AUDIT_NAME_CAP]::from_slice("system"),
        msg,
        FixedString[AUDIT_NAME_CAP]::from_slice("audit_db"),
        Word64::zero())

    db
}
