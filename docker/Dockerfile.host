# phorensicos — host image
#
# Builds and tests the bootstrap compiler (phorc) and the host/runtime library
# (phost), then runs and verifies the JIT-Porting Court.
#
#   docker compose run --rm host
#
FROM rust:1.98.0-slim-bookworm

# build-essential: linker/cc for Rust crates.
# python3 + jq: used by the evidence verifiers.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential ca-certificates python3 jq \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Copy the source tree (see .dockerignore for exclusions).
COPY . .

# Warm the dependency graph so the CI step is fast and deterministic.
RUN cargo fetch --locked || cargo fetch

CMD ["bash", "-c", "./scripts/ci_host.sh"]
