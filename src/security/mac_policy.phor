// mac_policy.phor — Mandatory Access Control (MAC) Policy
//
// Provides:
//   - Label-based enforcement (security labels on subjects/objects)
//   - Multi-level security (MLS) with hierarchical classification
//   - Category-based access (compartment/need-to-know)
//   - Label transition rules (upgrade/downgrade)
//   - Integrity labels (Biba-style integrity enforcement)
//   - Full residual recording on every MAC decision
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every MAC decision produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:mac_policy:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_LABELS: u64 = 1024;
const MAX_SUBJECT_LABELS: u64 = 256;
const MAX_OBJECT_LABELS: u64 = 512;
const MAX_LABEL_CATEGORIES: u64 = 256;
const MAX_CLASSIFICATION_LEVELS: u64 = 16;
const MAX_INTEGRITY_LEVELS: u64 = 16;
const MAX_LABEL_TRANSITION_RULES: u64 = 128;
const MAX_DOMINANCE_CHECKS: u64 = 256;
const MAX_CATEGORY_SETS: u64 = 128;
const MAX_SENSITIVITY_LABELS: u64 = 32;
const MAX_COMPARTMENT_BITMAP: u64 = 16;
const MAX_LABEL_COMPARISONS: u64 = 256;
const MAX_MLS_POLICIES: u64 = 16;
const MAX_INTEGRITY_POLICIES: u64 = 16;
const MAX_LABEL_CHANGE_HISTORY: u64 = 128;
const MAX_MAC_DECISIONS: u64 = 1024;

effect mac:label;
effect mac:enforce;
effect mac:transition;
effect mac:integrity;

// ──────────────────────────────────────────────
// MAC Types
// ──────────────────────────────────────────────

enum ClassificationLevel {
    Unclassified,
    Confidential,
    Restricted,
    Secret,
    TopSecret,
    Critical,
    Compartmented,
}

enum IntegrityLevel {
    Untrusted,
    Low,
    Medium,
    High,
    System,
    Trusted,
}

enum MACDecision {
    Allowed,
    Denied,
    NeedUpgrade,
    NeedDowngrade,
    CategoryMismatch,
    IntegrityViolation,
    TransitionDenied,
}

enum LabelType {
    Sensitivity,
    Integrity,
    Category,
    Composite,
}

enum LabelScope {
    Subject,
    Object,
    Both,
    Transition,
}

// ──────────────────────────────────────────────
// MAC Data Structures
// ──────────────────────────────────────────────

struct ClassificationLabel {
    label_id: u64,
    name: Str(64),
    level: ClassificationLevel,
    level_number: u8,
    category_bitmap: Array(u8, MAX_COMPARTMENT_BITMAP),
    category_count: u64,
    compartments: Array(u64, MAX_LABEL_CATEGORIES),
    color: u8,
}

struct IntegrityLabel {
    label_id: u64,
    name: Str(64),
    level: IntegrityLevel,
    level_number: u8,
    trusted: bool,
    audit_required: bool,
    origin: u64,
}

struct MACSubjectLabel {
    subject_id: u64,
    classification: ClassificationLabel,
    integrity: IntegrityLabel,
    clearance_level: u8,
    max_category_bitmap: Array(u8, MAX_COMPARTMENT_BITMAP),
    current_categories: Array(u64, MAX_LABEL_CATEGORIES),
    category_count: u64,
    downgrade_allowed: bool,
    upgrade_allowed: bool,
    audit_all: bool,
    label_version: u64,
}

struct MACObjectLabel {
    object_id: u64,
    classification: ClassificationLabel,
    integrity: IntegrityLabel,
    categories: Array(u64, MAX_LABEL_CATEGORIES),
    category_count: u64,
    sensitivity: u8,
    filenames: Array(Str(64), MAX_LABEL_CATEGORIES),
    label_version: u64,
}

struct LabelTransitionRule {
    rule_id: u64,
    source_label_id: u64,
    target_label_id: u64,
    from_level: ClassificationLevel,
    to_level: ClassificationLevel,
    transition_type: u8,
    requires_approval: bool,
    approver_role: u64,
    audit_required: bool,
    enabled: bool,
    justification_required: bool,
}

struct MACDecisionRecord {
    decision_id: u64,
    subject_id: u64,
    object_id: u64,
    action_id: u64,
    decision: MACDecision,
    subject_level: u8,
    object_level: u8,
    subject_integrity: u8,
    object_integrity: u8,
    category_match: bool,
    integrity_ok: bool,
    label_version_subject: u64,
    label_version_object: u64,
    audit_emitted: bool,
    residual_id: u64,
}

struct MACPolicy {
    classification_labels: Array(ClassificationLabel, MAX_CLASSIFICATION_LEVELS),
    classification_count: u64,
    integrity_labels: Array(IntegrityLabel, MAX_INTEGRITY_LEVELS),
    integrity_count: u64,
    subject_labels: Array(MACSubjectLabel, MAX_SUBJECT_LABELS),
    subject_count: u64,
    object_labels: Array(MACObjectLabel, MAX_OBJECT_LABELS),
    object_count: u64,
    transition_rules: Array(LabelTransitionRule, MAX_LABEL_TRANSITION_RULES),
    transition_count: u64,
    decision_history: Array(MACDecisionRecord, MAX_MAC_DECISIONS),
    decision_count: u64,
    default_decision: MACDecision,
    strict_integrity: bool,
    mls_enabled: bool,
    integrity_enabled: bool,
    audit_all_decisions: bool,
    policy_version: u64,
}

// ──────────────────────────────────────────────
// Label Creation
// ──────────────────────────────────────────────

fn create_classification_label(
    label_id: u64,
    name: Str(64),
    level: ClassificationLevel,
    level_num: u8,
) -> ClassificationLabel
    effect [mac:label, compute, residual]
{
    residual emit {
        op: "mac.classification_create",
        id: label_id,
        name: name,
        level: level as u8,
        level_num: level_num,
    };

    return ClassificationLabel{
        label_id: label_id,
        name: name,
        level: level,
        level_number: level_num,
        category_bitmap: Array::splat(0),
        category_count: 0,
        compartments: Array::splat(0),
        color: 0,
    };
}

fn create_integrity_label(
    label_id: u64,
    name: Str(64),
    level: IntegrityLevel,
    level_num: u8,
) -> IntegrityLabel
    effect [mac:label, compute, residual]
{
    residual emit {
        op: "mac.integrity_create",
        id: label_id,
        name: name,
        level: level as u8,
        level_num: level_num,
    };

    return IntegrityLabel{
        label_id: label_id,
        name: name,
        level: level,
        level_number: level_num,
        trusted: level_num >= 4,
        audit_required: true,
        origin: 0,
    };
}

fn assign_subject_label(
    subject_id: u64,
    classification: ClassificationLabel,
    integrity: IntegrityLabel,
    clearance: u8,
) -> MACSubjectLabel
    effect [mac:label, compute, residual]
{
    residual emit {
        op: "mac.subject_label_assign",
        subject: subject_id,
        classification: classification.label_id,
        integrity: integrity.label_id,
        clearance: clearance,
    };

    return MACSubjectLabel{
        subject_id: subject_id,
        classification: classification,
        integrity: integrity,
        clearance_level: clearance,
        max_category_bitmap: Array::splat(0),
        current_categories: Array::splat(0),
        category_count: 0,
        downgrade_allowed: false,
        upgrade_allowed: false,
        audit_all: true,
        label_version: 1,
    };
}

fn assign_object_label(
    object_id: u64,
    classification: ClassificationLabel,
    integrity: IntegrityLabel,
) -> MACObjectLabel
    effect [mac:label, compute, residual]
{
    residual emit {
        op: "mac.object_label_assign",
        object: object_id,
        classification: classification.label_id,
        integrity: integrity.label_id,
    };

    return MACObjectLabel{
        object_id: object_id,
        classification: classification,
        integrity: integrity,
        categories: Array::splat(0),
        category_count: 0,
        sensitivity: classification.level_number,
        filenames: Array::splat(Str::from("")),
        label_version: 1,
    };
}

// ──────────────────────────────────────────────
// Dominance Checking
// ──────────────────────────────────────────────

fn classification_dominates(subject_level: u8, object_level: u8) -> bool
    effect [compute]
{
    return subject_level >= object_level;
}

fn category_coverage(
    subject_cats: Array(u64, MAX_LABEL_CATEGORIES),
    subj_count: u64,
    object_cats: Array(u64, MAX_LABEL_CATEGORIES),
    obj_count: u64,
) -> bool
    effect [compute]
{
    if obj_count == 0 {
        return true;
    }
    for i in 0..obj_count {
        let mut found: bool = false;
        for j in 0..subj_count {
            if subject_cats[j] == object_cats[i] {
                found = true;
                break;
            }
        }
        if !found {
            return false;
        }
    }
    return true;
}

fn integrity_dominates(subject_level: u8, object_level: u8, write_operation: bool) -> bool
    effect [compute]
{
    if write_operation {
        return subject_level <= object_level;
    }
    return subject_level >= object_level;
}

fn check_dominance(
    subject: MACSubjectLabel,
    object: MACObjectLabel,
    is_write: bool,
) -> bool
    effect [compute]
{
    if !classification_dominates(subject.clearance_level, object.sensitivity) {
        return false;
    }
    if !category_coverage(
        subject.current_categories, subject.category_count,
        object.categories, object.category_count,
    ) {
        return false;
    }
    if !integrity_dominates(
        subject.integrity.level_number,
        object.integrity.level_number,
        is_write,
    ) {
        return false;
    }
    return true;
}

fn check_simple_security_property(subject: MACSubjectLabel, object: MACObjectLabel) -> bool
    effect [compute]
{
    return classification_dominates(subject.clearance_level, object.sensitivity);
}

fn check_star_security_property(subject: MACSubjectLabel, object: MACObjectLabel) -> bool
    effect [compute]
{
    return classification_dominates(object.sensitivity, subject.clearance_level);
}

fn check_integrity_read(subject: MACSubjectLabel, object: MACObjectLabel) -> bool
    effect [compute]
{
    return integrity_dominates(subject.integrity.level_number, object.integrity.level_number, false);
}

fn check_integrity_write(subject: MACSubjectLabel, object: MACObjectLabel) -> bool
    effect [compute]
{
    return integrity_dominates(subject.integrity.level_number, object.integrity.level_number, true);
}

// ──────────────────────────────────────────────
// MAC Enforcement
// ──────────────────────────────────────────────

fn enforce_mac_read(
    subject: MACSubjectLabel,
    object: MACObjectLabel,
) -> MACDecision
    effect [mac:enforce, compute, residual]
{
    let mut decision: MACDecision = MACDecision::Allowed;

    if !check_simple_security_property(subject, object) {
        decision = MACDecision::Denied;
    }

    if decision == MACDecision::Allowed {
        if !category_coverage(
            subject.current_categories, subject.category_count,
            object.categories, object.category_count,
        ) {
            decision = MACDecision::CategoryMismatch;
        }
    }

    if decision == MACDecision::Allowed {
        if !check_integrity_read(subject, object) {
            decision = MACDecision::IntegrityViolation;
        }
    }

    residual emit {
        op: "mac.enforce_read",
        subject: subject.subject_id,
        object: object.object_id,
        subj_level: subject.clearance_level,
        obj_level: object.sensitivity,
        decision: decision as u8,
    };

    return decision;
}

fn enforce_mac_write(
    subject: MACSubjectLabel,
    object: MACObjectLabel,
) -> MACDecision
    effect [mac:enforce, compute, residual]
{
    let mut decision: MACDecision = MACDecision::Allowed;

    if !check_star_security_property(subject, object) {
        decision = MACDecision::Denied;
    }

    if decision == MACDecision::Allowed {
        if !category_coverage(
            subject.current_categories, subject.category_count,
            object.categories, object.category_count,
        ) {
            decision = MACDecision::CategoryMismatch;
        }
    }

    if decision == MACDecision::Allowed {
        if !check_integrity_write(subject, object) {
            decision = MACDecision::IntegrityViolation;
        }
    }

    residual emit {
        op: "mac.enforce_write",
        subject: subject.subject_id,
        object: object.object_id,
        decision: decision as u8,
    };

    return decision;
}

fn enforce_mac_execute(
    subject: MACSubjectLabel,
    object: MACObjectLabel,
) -> MACDecision
    effect [mac:enforce, compute]
{
    if !check_simple_security_property(subject, object) {
        return MACDecision::Denied;
    }
    if !check_integrity_read(subject, object) {
        return MACDecision::IntegrityViolation;
    }
    return MACDecision::Allowed;
}

fn mac_decide(
    subject: MACSubjectLabel,
    object: MACObjectLabel,
    action: u64,
) -> MACDecision
    effect [mac:enforce, compute, residual]
{
    let decision: MACDecision = match action {
        0x01 => enforce_mac_read(subject, object),
        0x02 => enforce_mac_write(subject, object),
        0x04 => enforce_mac_execute(subject, object),
        _ => MACDecision::Denied,
    };

    residual emit {
        op: "mac.decide",
        subject: subject.subject_id,
        object: object.object_id,
        action: action,
        decision: decision as u8,
    };

    return decision;
}

// ──────────────────────────────────────────────
// Label Transition
// ──────────────────────────────────────────────

fn add_label_transition_rule(
    policy: MACPolicy,
    rule: LabelTransitionRule,
) -> MACPolicy
    effect [mac:transition, compute, residual]
{
    let mut updated: MACPolicy = policy;
    if updated.transition_count < MAX_LABEL_TRANSITION_RULES {
        updated.transition_rules[updated.transition_count] = rule;
        updated.transition_count = updated.transition_count + 1;

        residual emit {
            op: "mac.transition_rule_add",
            rule: rule.rule_id,
            from: rule.from_level as u8,
            to: rule.to_level as u8,
            requires_approval: if rule.requires_approval { 1 } else { 0 },
        };
    }
    return updated;
}

fn check_transition_allowed(
    policy: MACPolicy,
    subject: MACSubjectLabel,
    target_level: ClassificationLevel,
) -> (bool, u64)
    effect [mac:transition, compute]
{
    let mut allowed: bool = false;
    let mut rule_id: u64 = 0;

    for i in 0..policy.transition_count {
        let rule: LabelTransitionRule = policy.transition_rules[i];
        if !rule.enabled {
            continue;
        }
        if rule.source_label_id == subject.classification.label_id &&
           rule.to_level == target_level {
            allowed = true;
            rule_id = rule.rule_id;
            break;
        }
    }

    return (allowed, rule_id);
}

fn perform_label_upgrade(
    policy: MACPolicy,
    subject_id: u64,
    target_level: ClassificationLevel,
) -> (MACPolicy, bool)
    effect [mac:transition, compute, residual]
{
    let mut updated: MACPolicy = policy;
    let mut upgraded: bool = false;

    let mut subj_idx: u64 = 0;
    let mut found_subject: bool = false;
    for i in 0..updated.subject_count {
        if updated.subject_labels[i].subject_id == subject_id {
            subj_idx = i;
            found_subject = true;
            break;
        }
    }

    if found_subject {
        let subject: MACSubjectLabel = updated.subject_labels[subj_idx];
        let (allowed, rule_id): (bool, u64) = check_transition_allowed(updated, subject, target_level);
        if allowed && subject.upgrade_allowed {
            let mut new_label: MACSubjectLabel = subject;
            new_label.classification.level = target_level;
            new_label.classification.level_number = target_level as u8;
            new_label.clearance_level = target_level as u8;
            new_label.label_version = new_label.label_version + 1;
            updated.subject_labels[subj_idx] = new_label;
            upgraded = true;

            residual emit {
                op: "mac.label_upgrade",
                subject: subject_id,
                from: subject.classification.level as u8,
                to: target_level as u8,
                rule: rule_id,
            };
        }
    }

    return (updated, upgraded);
}

fn perform_label_downgrade(
    policy: MACPolicy,
    subject_id: u64,
    target_level: ClassificationLevel,
) -> (MACPolicy, bool)
    effect [mac:transition, compute, residual]
{
    let mut updated: MACPolicy = policy;
    let mut downgraded: bool = false;

    let mut subj_idx: u64 = 0;
    let mut found_subject: bool = false;
    for i in 0..updated.subject_count {
        if updated.subject_labels[i].subject_id == subject_id {
            subj_idx = i;
            found_subject = true;
            break;
        }
    }

    if found_subject {
        let subject: MACSubjectLabel = updated.subject_labels[subj_idx];
        let (allowed, rule_id): (bool, u64) = check_transition_allowed(updated, subject, target_level);
        if allowed && subject.downgrade_allowed {
            let mut new_label: MACSubjectLabel = subject;
            new_label.classification.level = target_level;
            new_label.classification.level_number = target_level as u8;
            new_label.clearance_level = target_level as u8;
            new_label.label_version = new_label.label_version + 1;
            updated.subject_labels[subj_idx] = new_label;
            downgraded = true;

            residual emit {
                op: "mac.label_downgrade",
                subject: subject_id,
                from: subject.classification.level as u8,
                to: target_level as u8,
                rule: rule_id,
            };
        }
    }

    return (updated, downgraded);
}

// ──────────────────────────────────────────────
// Category Management
// ──────────────────────────────────────────────

fn add_category_to_subject(
    policy: MACPolicy,
    subject_id: u64,
    category_id: u64,
) -> MACPolicy
    effect [mac:label, compute, residual]
{
    let mut updated: MACPolicy = policy;
    for i in 0..updated.subject_count {
        if updated.subject_labels[i].subject_id == subject_id {
            let mut subj: MACSubjectLabel = updated.subject_labels[i];
            if subj.category_count < MAX_LABEL_CATEGORIES {
                subj.current_categories[subj.category_count] = category_id;
                subj.category_count = subj.category_count + 1;
                subj.label_version = subj.label_version + 1;
                updated.subject_labels[i] = subj;
            }
            break;
        }
    }

    residual emit {
        op: "mac.category_add_subject",
        subject: subject_id,
        category: category_id,
    };

    return updated;
}

fn add_category_to_object(
    policy: MACPolicy,
    object_id: u64,
    category_id: u64,
) -> MACPolicy
    effect [mac:label, compute, residual]
{
    let mut updated: MACPolicy = policy;
    for i in 0..updated.object_count {
        if updated.object_labels[i].object_id == object_id {
            let mut obj: MACObjectLabel = updated.object_labels[i];
            if obj.category_count < MAX_LABEL_CATEGORIES {
                obj.categories[obj.category_count] = category_id;
                obj.category_count = obj.category_count + 1;
                updated.object_labels[i] = obj;
            }
            break;
        }
    }

    residual emit {
        op: "mac.category_add_object",
        object: object_id,
        category: category_id,
    };

    return updated;
}

fn remove_category_from_subject(
    policy: MACPolicy,
    subject_id: u64,
    category_id: u64,
) -> MACPolicy
    effect [mac:label, compute, residual]
{
    let mut updated: MACPolicy = policy;
    for i in 0..updated.subject_count {
        if updated.subject_labels[i].subject_id == subject_id {
            let mut subj: MACSubjectLabel = updated.subject_labels[i];
            let mut new_cats: Array(u64, MAX_LABEL_CATEGORIES) = Array::splat(0);
            let mut new_count: u64 = 0;
            for j in 0..subj.category_count {
                if subj.current_categories[j] != category_id {
                    new_cats[new_count] = subj.current_categories[j];
                    new_count = new_count + 1;
                }
            }
            subj.current_categories = new_cats;
            subj.category_count = new_count;
            subj.label_version = subj.label_version + 1;
            updated.subject_labels[i] = subj;
            break;
        }
    }

    residual emit {
        op: "mac.category_remove_subject",
        subject: subject_id,
        category: category_id,
    };

    return updated;
}

// ──────────────────────────────────────────────
// Policy Management
// ──────────────────────────────────────────────

fn create_mac_policy() -> MACPolicy
    effect [mac:label, compute, residual]
{
    residual emit {
        op: "mac.policy_create",
    };

    return MACPolicy{
        classification_labels: Array::zeroed(),
        classification_count: 0,
        integrity_labels: Array::zeroed(),
        integrity_count: 0,
        subject_labels: Array::zeroed(),
        subject_count: 0,
        object_labels: Array::zeroed(),
        object_count: 0,
        transition_rules: Array::zeroed(),
        transition_count: 0,
        decision_history: Array::zeroed(),
        decision_count: 0,
        default_decision: MACDecision::Denied,
        strict_integrity: true,
        mls_enabled: true,
        integrity_enabled: true,
        audit_all_decisions: true,
        policy_version: 1,
    };
}

fn add_classification_to_policy(
    policy: MACPolicy,
    label: ClassificationLabel,
) -> MACPolicy
    effect [mac:label, compute, residual]
{
    let mut updated: MACPolicy = policy;
    if updated.classification_count < MAX_CLASSIFICATION_LEVELS {
        updated.classification_labels[updated.classification_count] = label;
        updated.classification_count = updated.classification_count + 1;

        residual emit {
            op: "mac.classification_add",
            id: label.label_id,
            name: label.name,
            level: label.level_number,
        };
    }
    return updated;
}

fn add_integrity_to_policy(
    policy: MACPolicy,
    label: IntegrityLabel,
) -> MACPolicy
    effect [mac:label, compute, residual]
{
    let mut updated: MACPolicy = policy;
    if updated.integrity_count < MAX_INTEGRITY_LEVELS {
        updated.integrity_labels[updated.integrity_count] = label;
        updated.integrity_count = updated.integrity_count + 1;

        residual emit {
            op: "mac.integrity_add",
            id: label.label_id,
            name: label.name,
            level: label.level_number,
        };
    }
    return updated;
}

fn add_subject_to_policy(
    policy: MACPolicy,
    subject: MACSubjectLabel,
) -> MACPolicy
    effect [mac:label, compute, residual]
{
    let mut updated: MACPolicy = policy;
    if updated.subject_count < MAX_SUBJECT_LABELS {
        updated.subject_labels[updated.subject_count] = subject;
        updated.subject_count = updated.subject_count + 1;

        residual emit {
            op: "mac.subject_add",
            id: subject.subject_id,
            clearance: subject.clearance_level,
        };
    }
    return updated;
}

fn add_object_to_policy(
    policy: MACPolicy,
    object: MACObjectLabel,
) -> MACPolicy
    effect [mac:label, compute, residual]
{
    let mut updated: MACPolicy = policy;
    if updated.object_count < MAX_OBJECT_LABELS {
        updated.object_labels[updated.object_count] = object;
        updated.object_count = updated.object_count + 1;

        residual emit {
            op: "mac.object_add",
            id: object.object_id,
            sensitivity: object.sensitivity,
        };
    }
    return updated;
}

fn record_mac_decision(
    policy: MACPolicy,
    subject_id: u64,
    object_id: u64,
    action: u64,
    decision: MACDecision,
    subject_level: u8,
    object_level: u8,
) -> MACPolicy
    effect [mac:enforce, compute, residual]
{
    let mut updated: MACPolicy = policy;
    if updated.decision_count < MAX_MAC_DECISIONS {
        let record: MACDecisionRecord = MACDecisionRecord{
            decision_id: updated.decision_count + 1,
            subject_id: subject_id,
            object_id: object_id,
            action_id: action,
            decision: decision,
            subject_level: subject_level,
            object_level: object_level,
            subject_integrity: 0,
            object_integrity: 0,
            category_match: true,
            integrity_ok: true,
            label_version_subject: 0,
            label_version_object: 0,
            audit_emitted: true,
            residual_id: 0,
        };
        updated.decision_history[updated.decision_count] = record;
        updated.decision_count = updated.decision_count + 1;
    }

    residual emit {
        op: "mac.decision_record",
        subject: subject_id,
        object: object_id,
        action: action,
        decision: decision as u8,
    };

    return updated;
}

// ──────────────────────────────────────────────
// Policy Query
// ──────────────────────────────────────────────

fn find_subject_label(policy: MACPolicy, subject_id: u64) -> Option(MACSubjectLabel)
    effect [compute]
{
    for i in 0..policy.subject_count {
        if policy.subject_labels[i].subject_id == subject_id {
            return Option::Some(policy.subject_labels[i]);
        }
    }
    return Option::None;
}

fn find_object_label(policy: MACPolicy, object_id: u64) -> Option(MACObjectLabel)
    effect [compute]
{
    for i in 0..policy.object_count {
        if policy.object_labels[i].object_id == object_id {
            return Option::Some(policy.object_labels[i]);
        }
    }
    return Option::None;
}

fn get_classification_by_level(policy: MACPolicy, level: ClassificationLevel) -> Option(ClassificationLabel)
    effect [compute]
{
    for i in 0..policy.classification_count {
        if policy.classification_labels[i].level == level {
            return Option::Some(policy.classification_labels[i]);
        }
    }
    return Option::None;
}

fn get_integrity_by_level(policy: MACPolicy, level: IntegrityLevel) -> Option(IntegrityLabel)
    effect [compute]
{
    for i in 0..policy.integrity_count {
        if policy.integrity_labels[i].level == level {
            return Option::Some(policy.integrity_labels[i]);
        }
    }
    return Option::None;
}

fn policy_summary(policy: MACPolicy) -> Str(256)
    effect [compute]
{
    let mut s: Str(256) = Str::from("MACPolicy v");
    let _: bool = s.append(Str::from("X"));
    let _: bool = s.append(Str::from(" classes="));
    let _: bool = s.append(Str::from("X"));
    let _: bool = s.append(Str::from(" int="));
    let _: bool = s.append(Str::from("X"));
    let _: bool = s.append(Str::from(" subj="));
    let _: bool = s.append(Str::from("X"));
    let _: bool = s.append(Str::from(" obj="));
    let _: bool = s.append(Str::from("X"));
    let _: bool = s.append(Str::from(" transitions="));
    let _: bool = s.append(Str::from("X"));
    return s;
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main() -> MACPolicy
    effect [mac:label, mac:enforce, mac:transition, mac:integrity, compute, io:write, residual]
{
    let mut policy: MACPolicy = create_mac_policy();

    let unclassified: ClassificationLabel = create_classification_label(
        1, Str::from("Unclassified"), ClassificationLevel::Unclassified, 0,
    );
    policy = add_classification_to_policy(policy, unclassified);

    let confidential: ClassificationLabel = create_classification_label(
        2, Str::from("Confidential"), ClassificationLevel::Confidential, 1,
    );
    policy = add_classification_to_policy(policy, confidential);

    let secret: ClassificationLabel = create_classification_label(
        3, Str::from("Secret"), ClassificationLevel::Secret, 2,
    );
    policy = add_classification_to_policy(policy, secret);

    let top_secret: ClassificationLabel = create_classification_label(
        4, Str::from("TopSecret"), ClassificationLevel::TopSecret, 3,
    );
    policy = add_classification_to_policy(policy, top_secret);

    let untrusted_int: IntegrityLabel = create_integrity_label(
        1, Str::from("Untrusted"), IntegrityLevel::Untrusted, 0,
    );
    policy = add_integrity_to_policy(policy, untrusted_int);

    let high_int: IntegrityLabel = create_integrity_label(
        2, Str::from("HighIntegrity"), IntegrityLevel::High, 3,
    );
    policy = add_integrity_to_policy(policy, high_int);

    let system_int: IntegrityLabel = create_integrity_label(
        3, Str::from("SystemIntegrity"), IntegrityLevel::System, 4,
    );
    policy = add_integrity_to_policy(policy, system_int);

    let admin_subj: MACSubjectLabel = assign_subject_label(1001, top_secret, system_int, 3);
    admin_subj.upgrade_allowed = true;
    admin_subj.category_count = 2;
    admin_subj.current_categories[0] = 10;
    admin_subj.current_categories[1] = 20;

    policy = add_subject_to_policy(policy, admin_subj);

    let user_subj: MACSubjectLabel = assign_subject_label(1002, confidential, high_int, 1);
    policy = add_subject_to_policy(policy, user_subj);

    let secret_doc: MACObjectLabel = assign_object_label(2001, secret, high_int);
    let mut sec_doc: MACObjectLabel = secret_doc;
    sec_doc.categories[0] = 10;
    sec_doc.category_count = 1;
    policy = add_object_to_policy(policy, sec_doc);

    let unclass_doc: MACObjectLabel = assign_object_label(2002, unclassified, untrusted_int);
    policy = add_object_to_policy(policy, unclass_doc);

    let tr_rule: LabelTransitionRule = LabelTransitionRule{
        rule_id: 1,
        source_label_id: 2,
        target_label_id: 3,
        from_level: ClassificationLevel::Confidential,
        to_level: ClassificationLevel::Secret,
        transition_type: 0,
        requires_approval: true,
        approver_role: 1,
        audit_required: true,
        enabled: true,
        justification_required: true,
    };
    policy = add_label_transition_rule(policy, tr_rule);

    let read_decision: MACDecision = mac_decide(admin_subj, sec_doc, 0x01);
    let write_decision: MACDecision = mac_decide(user_subj, sec_doc, 0x02);

    assert(read_decision == MACDecision::Allowed, "mac_policy: admin can read secret");
    assert(write_decision == MACDecision::Denied || write_decision == MACDecision::IntegrityViolation, "mac_policy: user denied write to secret");

    policy = record_mac_decision(policy, 1001, 2001, 0x01, read_decision, 3, 2);
    policy = record_mac_decision(policy, 1002, 2001, 0x02, write_decision, 1, 2);

    let (upgraded_policy, upgraded): (MACPolicy, bool) = perform_label_upgrade(
        policy, 1002, ClassificationLevel::Secret,
    );
    policy = upgraded_policy;

    assert(policy.classification_count >= 4, "mac_policy: classification labels loaded");
    assert(policy.integrity_count >= 3, "mac_policy: integrity labels loaded");
    assert(policy.subject_count >= 2, "mac_policy: subjects assigned");
    assert(policy.object_count >= 2, "mac_policy: objects assigned");

    residual emit {
        op: "mac_policy.init_complete",
        classifications: policy.classification_count,
        integrities: policy.integrity_count,
        subjects: policy.subject_count,
        objects: policy.object_count,
        transitions: policy.transition_count,
        decisions: policy.decision_count,
    };

    return policy;
}
