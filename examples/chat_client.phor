fn test_chat_message_codes() -> void
    effect [compute, residual]
{
    let codes: Array(u16, 3) = [200, 400, 500];
    assert(codes[0] == 200, "chat: success code");
    assert(codes[1] == 400, "chat: client error");
    assert(codes[2] == 500, "chat: server error");
    residual emit { op: "chat.test.codes", codes: 3, };
}

fn test_chat_keepalive() -> void
    effect [compute, residual]
{
    let interval_sec: u64 = 30;
    assert(interval_sec == 30, "chat: keepalive interval 30s");
    residual emit { op: "chat.test.keepalive", interval: interval_sec, };
}

fn test_chat_latency_monitoring() -> void
    effect [compute, residual]
{
    let latency_ms: u64 = 45;
    assert(latency_ms < 100, "chat: latency under 100ms");
    residual emit { op: "chat.test.latency", ms: latency_ms, };
}

fn test_chat_message_queue() -> void
    effect [compute, residual]
{
    let queue_size: u64 = 10;
    let sent: u64 = 8;
    let remaining: u64 = queue_size - sent;
    assert(remaining == 2, "chat: 2 messages queued");
    residual emit { op: "chat.test.queue", remaining: remaining, };
}

    compositor.write_line("Chat client shut down.")!;
}
