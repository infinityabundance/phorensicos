// ============================================================================
// Section 3: Category Filtering (Lines 501–700)
// ============================================================================

// Check if a test matches the active category filter
fn test_matches_filter(descriptor: TestDescriptor, filter: CategoryFilter) -> bool
    effect [compute]
{
    // match_all includes everything
    if filter.match_all {
        return true;
    }

    // match_none excludes everything
    if filter.match_none {
        return false;
    }

    // Check exclude first (takes priority)
    let exclude_active: bool = filter.exclude_category.len() > 0;
    if exclude_active {
        let is_excluded: bool = descriptor.category == filter.exclude_category;
        if is_excluded {
            return false;
        }
    }

    // Check include
    let include_active: bool = filter.include_category.len() > 0;
    if include_active {
        let is_included: bool = descriptor.category == filter.include_category;
        if !is_included {
            return false;
        }
    }

    // Check tag requirement
    let tag_required_active: bool = filter.tag_required.len() > 0;
    if tag_required_active {
        let mut found_tag: bool = false;
        for i in 0..MAX_TAGS {
            let tag: Str(32) = descriptor.tags[i];
            if tag == filter.tag_required {
                found_tag = true;
                break;
            }
        }
        if !found_tag {
            return false;
        }
    }

    return true;
}

// Count how many tests in a list match a filter
fn count_matching_tests(descriptors: Array(TestDescriptor, 256), count: u32, filter: CategoryFilter) -> u32
    effect [compute]
{
    let mut matching: u32 = 0;
    for i in 0..count {
        let d: TestDescriptor = descriptors[i];
        if test_matches_filter(d, filter) {
            matching = matching + 1;
        }
    }
    return matching;
}

// Check if a category string matches one of the known categories
fn is_known_category(category: Str(64)) -> bool
    effect [compute]
{
    let known: Array(Str(16), 11) = Array::splat(Str::from(""));
    known[0] = CATEGORY_CORE;
    known[1] = CATEGORY_KERNEL;
    known[2] = CATEGORY_COURT;
    known[3] = CATEGORY_STORE;
    known[4] = CATEGORY_DRIVER;
    known[5] = CATEGORY_CAGE;
    known[6] = CATEGORY_GUI;
    known[7] = CATEGORY_PACKAGE;
    known[8] = CATEGORY_REGRESSION;
    known[9] = CATEGORY_EDGE;
    known[10] = CATEGORY_INTEGRATION;

    let mut result: bool = false;
    for i in 0..11 {
        if category == known[i] {
            result = true;
            break;
        }
    }
    return result;
}

// Compute a simple hash for a test descriptor
fn descriptor_hash(d: TestDescriptor) -> u64
    effect [compute]
{
    let mut h: u64 = 0;
    let name_len: u64 = d.name.len() as u64;
    let file_len: u64 = d.file.len() as u64;
    h = h + name_len;
    h = h * 31 + (d.line_number as u64);
    h = h * 31 + file_len;
    h = h * 31 + (d.required_trust as u64);
    h = h * 31 + (d.category.len() as u64);
    if d.is_replay_test {
        h = h ^ 0x12345678;
    }
    if d.is_court_test {
        h = h ^ 0x87654321;
    }
    return h;
}

