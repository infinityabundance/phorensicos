// receipts.phor — Receipt Types, Receipt Chain, Hash Chain Verification
// Phorensic Compiler Infrastructure — Receipt & Evidence Subsystem
//
// This module defines the complete receipt and evidence infrastructure for the Phorensic
// compiler. Receipts are the fundamental units of evidence: each compiler phase produces
// a receipt that cryptographically commits to its output. The receipt chain links all
// phases together, forming an auditable trail from source code to sealed binary.
//
// Receipt types:
// - CompilerReceipt: union of all phase-specific receipts
// - ReceiptChain: ordered sequence of receipts with hash linking
// - HashLink: a single link in the chain (prev_hash + receipt_hash + next_hash)
// - EvidenceReceipt: base receipt with generation tag and payload hash
//
// Evidence semantics:
// Each receipt contains a payload_hash that commits to the phase's output. The receipt
// chain links these hashes together using FNV-1a hashing. Breaking any link (changing
// a phase's output) changes the chain hash and invalidates the seal. This provides
// tamper-evident provenance for the entire compilation.
//
// Boundedness: All receipt operations are bounded by chain length (16 receipts max,
// one per compiler phase) and receipt array capacity (256).

use core::fixed::Array256;
use core::fixed::Array64;
use core::result::Result;
use core::option::Option;
use core::string::FixedString256;

use compiler::diagnostics::*;

// --- Evidence Receipt Base — fundamental receipt structure ---

pub struct EvidenceReceipt {
    /// The compiler phase that generated this receipt.
    pub phase : CompilerPhase,
    /// Hash of the payload this receipt represents.
    pub payload_hash : u64,
    /// Deterministic generation tag (monotonic counter).
    pub generation : u64,
    /// Timestamp (compile-time monotonic counter).
    pub timestamp : u64,
    /// Domain separator for hash computation.
    pub domain : FixedString256,
    /// Whether this receipt has been verified.
    pub verified : bool,
}

impl EvidenceReceipt {
    /// Create a new evidence receipt.
    /// Effect: pure — deterministic construction.
    pub fn new(
        phase : CompilerPhase,
        payload_hash : u64,
        generation : u64,
        timestamp : u64,
    ) -> EvidenceReceipt [pure] {
        let domain : FixedString256 = EvidenceReceipt::domain_for_phase(phase);
        EvidenceReceipt {
            phase: phase,
            payload_hash: payload_hash,
            generation: generation,
            timestamp: timestamp,
            domain: domain,
            verified: false,
        }
    }

    /// Get the domain separator string for a phase.
    /// Effect: pure — domain string selection.
    fn domain_for_phase(phase : CompilerPhase) -> FixedString256 [pure] {
        match phase {
            CompilerPhase::Lexer => FixedString256::from("phor:lex"),
            CompilerPhase::Parser => FixedString256::from("phor:parse"),
            CompilerPhase::Expander => FixedString256::from("phor:expand"),
            CompilerPhase::Lowerer => FixedString256::from("phor:lower"),
            CompilerPhase::Optimizer => FixedString256::from("phor:opt"),
            CompilerPhase::Codegen => FixedString256::from("phor:codegen"),
            CompilerPhase::Linker => FixedString256::from("phor:link"),
            CompilerPhase::Sealer => FixedString256::from("phor:seal"),
            CompilerPhase::PreCompile => FixedString256::from("phor:precompile"),
        }
    }

    /// Compute the full hash of this receipt (for chain linking).
    /// Effect: pure — FNV-1a hash of receipt fields.
    pub fn compute_hash(&self) -> u64 [pure] {
        var hash : u64 = 14695981039346656037u64; // FNV offset basis
        hash ^= self.phase as u64;
        hash *= 1099511628211u64; // FNV prime
        hash ^= self.payload_hash;
        hash *= 1099511628211u64;
        hash ^= self.generation;
        hash *= 1099511628211u64;
        hash ^= self.timestamp;
        hash *= 1099511628211u64;
        // Incorporate domain string bytes.
        for var i : u32 = 0u32; i < self.domain.len(); i += 1u32 [self.domain.len()] {
            hash ^= self.domain.get_byte(i) as u64;
            hash *= 1099511628211u64;
        }
        hash
    }

    /// Verify this receipt against a payload hash.
    /// Effect: pure — deterministic verification.
    pub fn verify(&mut self, expected_payload_hash : u64) -> bool [pure] {
        let valid : bool = self.payload_hash == expected_payload_hash;
        self.verified = valid;
        valid
    }

    /// Format this receipt for debugging.
    /// Effect: io — string formatting.
    pub fn format(&self) -> FixedString256 [io] {
        var result : FixedString256 = FixedString256::new();
        result.push_str(self.phase.name());
        result.push_str(FixedString256::from("["));
        result.push_str(self.domain);
        result.push_str(FixedString256::from("] hash=0x"));
        result.push_u64(self.payload_hash);
        result
    }
}

// --- Phase-Specific Receipt Wrappers ---

pub struct LexerReceipt {
    pub evidence : EvidenceReceipt,
    pub token_count : u32,
    pub error_count : u32,
    pub source_length : u64,
}

impl LexerReceipt {
    pub fn new(
        token_count : u32,
        error_count : u32,
        source_length : u64,
        generation : u64,
        timestamp : u64,
    ) -> LexerReceipt [pure] {
        var payload_hash : u64 = 14695981039346656037u64;
        payload_hash ^= token_count as u64;
        payload_hash *= 1099511628211u64;
        payload_hash ^= error_count as u64;
        payload_hash *= 1099511628211u64;
        payload_hash ^= source_length;
        payload_hash *= 1099511628211u64;

        LexerReceipt {
            evidence: EvidenceReceipt::new(
                CompilerPhase::Lexer, payload_hash, generation, timestamp,
            ),
            token_count: token_count,
            error_count: error_count,
            source_length: source_length,
        }
    }
}

