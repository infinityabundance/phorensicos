    assert(tags[2] == "needs_review", "forensic: needs_review tag");
    residual emit { op: "forensic.test.tags", count: 3, };
}

fn test_forensic_export_formats() -> void
    effect [compute, residual]
{
    let formats: Array(Str(8), 3) = ["json", "csv", "html"];
    assert(formats[0] == "json", "forensic: JSON export");
    assert(formats[1] == "csv", "forensic: CSV export");
    assert(formats[2] == "html", "forensic: HTML export");
    residual emit { op: "forensic.test.export", formats: 3, };
}

fn test_forensic_chain_of_custody() -> void
    effect [compute, residual]
{
    let handler: Str(32) = Str::from("alice");
    let action: Str(16) = Str::from("acquired");
    let timestamp: u64 = 1000;
    assert(handler.len() > 0, "forensic: handler recorded");
    assert(action.len() > 0, "forensic: action recorded");
    assert(timestamp > 0, "forensic: timestamp recorded");
    residual emit { op: "forensic.test.custody", handler: handler, action: action, };
}

