fn test_echo_tcp_keepalive(net: Cap(NetworkStack)) -> void
    effects: [network, io:write, residual]
{
    let fd: u64 = net.socket_create(2, 1, 0)!;
    net.socket_setsockopt(fd, 1, 9, 1)!;
    net.socket_setsockopt(fd, 1, 4, 5)!;
    net.socket_setsockopt(fd, 1, 5, 3)!;
    net.socket_setsockopt(fd, 1, 6, 10)!;
    net.socket_bind(fd, [0, 0, 0, 0], 12355)!;
    net.socket_listen(fd, 1)!;
    net.socket_close(fd)!;
    residual emit { op: "echo.test.keepalive", enabled: 1, };
}

