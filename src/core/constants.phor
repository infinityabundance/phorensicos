const CAP_RIGHT_FS_MOUNT  : Word64 = 0x0000_0040_0000_0000
const CAP_RIGHT_FS_UNMOUNT: Word64 = 0x0000_0080_0000_0000
const CAP_RIGHT_COURT     : Word64 = 0x0000_0100_0000_0000
const CAP_RIGHT_DRIVER    : Word64 = 0x0000_0200_0000_0000
const CAP_RIGHT_ADMIN     : Word64 = 0x0000_0400_0000_0000
const CAP_RIGHT_OWNER     : Word64 = 0x0000_0800_0000_0000

// Composite right groups
const CAP_RIGHT_FILE_BASIC   : Word64 = CAP_RIGHT_READ | CAP_RIGHT_WRITE
                                       | CAP_RIGHT_CREATE | CAP_RIGHT_DELETE
                                       | CAP_RIGHT_MODIFY | CAP_RIGHT_APPEND

const CAP_RIGHT_FILE_FULL    : Word64 = CAP_RIGHT_FILE_BASIC | CAP_RIGHT_OPEN
                                       | CAP_RIGHT_CLOSE | CAP_RIGHT_SEAL
                                       | CAP_RIGHT_UNSEAL | CAP_RIGHT_VERIFY

const CAP_RIGHT_NET_BASIC    : Word64 = CAP_RIGHT_NET_READ | CAP_RIGHT_NET_WRITE
                                       | CAP_RIGHT_NET_BIND | CAP_RIGHT_NET_CONN

const CAP_RIGHT_IPC_BASIC    : Word64 = CAP_RIGHT_IPC_SEND | CAP_RIGHT_IPC_RECV

const CAP_RIGHT_CRYPTO_BASIC : Word64 = CAP_RIGHT_HASH | CAP_RIGHT_SIGN
                                       | CAP_RIGHT_VERIFY | CAP_RIGHT_ENCRYPT
                                       | CAP_RIGHT_DECRYPT

const CAP_RIGHT_PROCESS_BASIC: Word64 = CAP_RIGHT_SPAWN | CAP_RIGHT_TERMINATE
                                       | CAP_RIGHT_SUSPEND | CAP_RIGHT_RESUME

const CAP_RIGHT_MGMT_BASIC   : Word64 = CAP_RIGHT_AUDIT | CAP_RIGHT_INSPECT
                                       | CAP_RIGHT_GRANT | CAP_RIGHT_DENY

const CAP_RIGHT_ALL           : Word64 = 0xFFFF_FFFF_FFFF_FFFF

