// file: block_allocator.phor
// purpose: Block allocation: free block bitmap, extent-based allocation,
//          allocation policies (first-fit, best-fit), defragmentation, block group management
// effects: [io, storage, deterministic]
// status: [VERIFIED]

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::handles::*
use filesystem::phorensic_fs::*

// ──────────────────────────────────────────────
// Block Allocator Constants
// ──────────────────────────────────────────────
// Evidence path: BA-ARCH-001 through BA-ARCH-025

const DIAG_BA_BASE           : Word64 = 0x5700
pub const BA_MAX_EXTENT_SEARCH : u32 = 1024
pub const BA_BITMAP_BITS      : u32 = BLOCK_SIZE * 8
pub const BA_GROUP_BLOCKS     : u32 = BLOCKS_PER_GROUP
pub const BA_ALLOCATION_RETRY : u32 = 3
pub const BA_DEFRAG_THRESHOLD : u32 = 100   // Free fragments before defrag

const BOUND_BA_SMALL         : u32 = 64
const BOUND_BA_MEDIUM        : u32 = 256
const BOUND_BA_LARGE         : u32 = 1024
const BOUND_BA_BITMAP        : u32 = 512

// ──────────────────────────────────────────────
// Allocator Error Types
// ──────────────────────────────────────────────
// Evidence path: BA-ERR-001 through BA-ERR-010

pub type BaError : struct {
    code: Word64,
    msg: FixedString[128],
    trust: TrustLevel,
}

impl BaError {
    pub fn new(code: Word64, msg: FixedString[128]) -> BaError
        effects: [deterministic]
    {
        BaError { code: code, msg: msg, trust: TrustLevel::Trust_System }
    }
}

impl Error for BaError {
    fn code(self) -> Word64
        effects: [deterministic]
    {
        self.code
    }
    fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        self.msg
    }
    fn trust_level(self) -> TrustLevel
        effects: [deterministic]
    {
        self.trust
    }
    fn in_range(self, base: Word64, end: Word64) -> bool
        effects: [deterministic]
    {
        self.code.gte(base) && self.code.lte(end)
    }
}

pub fn ba_error(msg: FixedString[128]) -> BaError
    effects: [deterministic]
{
    BaError::new(Word64::from_u64(DIAG_BA_BASE | 0x001), msg)
}

pub fn ba_no_space(msg: FixedString[128]) -> BaError
    effects: [deterministic]
{
    BaError::new(Word64::from_u64(DIAG_BA_BASE | 0x002), msg)
}

pub fn ba_corrupt(msg: FixedString[128]) -> BaError
    effects: [deterministic]
{
    BaError::new(Word64::from_u64(DIAG_BA_BASE | 0x003), msg)
}

// ──────────────────────────────────────────────
// Allocation Policy
// ──────────────────────────────────────────────
// Evidence path: BA-POLICY-001 through BA-POLICY-015

pub type AllocationPolicy : u8 = enum {
    AllocationPolicy_FirstFit  = 0x00,
    AllocationPolicy_BestFit   = 0x01,
    AllocationPolicy_NextFit   = 0x02,
    AllocationPolicy_Group     = 0x03,  // Allocate from specific group
}

// ──────────────────────────────────────────────
// Block Bitmap (fixed-size)
// ──────────────────────────────────────────────
// Evidence path: BA-BITMAP-001 through BA-BITMAP-025

pub type BlockBitmap : struct {
    bits: Byte[512],                   // 4096-bit bitmap
    total_bits: Word32,                // Total bits in bitmap
    free_bits: Word32,                 // Count of free bits
    last_set_bit: Word32,              // Last set bit (for next-fit)
}

impl BlockBitmap {
    pub fn new(total: Word32) -> BlockBitmap
        effects: [deterministic]
    {
        BlockBitmap {
            bits: [Byte::from_u8(0); 512],
            total_bits: total,
            free_bits: total,
            last_set_bit: Word32::from_u32(0),
        }
    }

    pub fn is_allocated(self, bit: Word32) -> bool
        effects: [deterministic]
    {
        let byte_idx: u32 = bit.to_u32() / 8
        let bit_idx: u32 = bit.to_u32() % 8
        if byte_idx >= 512 { return false }
        let b: u8 = self.bits[byte_idx as usize].to_u8()
        (b & (1 << bit_idx)) != 0
    }

    pub fn allocate(self: ref mut, bit: Word32) -> Result<(), BaError>
        effects: [deterministic]
    {
        let byte_idx: u32 = bit.to_u32() / 8
        let bit_idx: u32 = bit.to_u32() % 8
        if byte_idx >= 512 {
            return Result::Err(ba_error("Bitmap index out of bounds"))
        }
        let b: u8 = self.bits[byte_idx as usize].to_u8()
        if (b & (1 << bit_idx)) != 0 {
            return Result::Err(ba_error("Block already allocated"))
        }
        self.bits[byte_idx as usize] = Byte::from_u8(b | (1 << bit_idx))
        self.free_bits = self.free_bits.checked_sub(Word32::from_u32(1)).unwrap_or(self.free_bits)
        self.last_set_bit = bit
        Result::Ok(())
    }

    pub fn free(self: ref mut, bit: Word32) -> Result<(), BaError>
        effects: [deterministic]
    {
        let byte_idx: u32 = bit.to_u32() / 8
        let bit_idx: u32 = bit.to_u32() % 8
        if byte_idx >= 512 {
            return Result::Err(ba_error("Bitmap index out of bounds"))
        }
        let b: u8 = self.bits[byte_idx as usize].to_u8()
        if (b & (1 << bit_idx)) == 0 {
            return Result::Err(ba_error("Block already free"))
        }
        self.bits[byte_idx as usize] = Byte::from_u8(b & !(1 << bit_idx))
        self.free_bits = self.free_bits.checked_add(Word32::from_u32(1)).unwrap_or(self.free_bits)
        Result::Ok(())
    }

    pub fn find_first_free(self: ref mut) -> Option[Word32>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_BA_BITMAP] — bounded by 512 bytes
        loop: bounds[BOUND_BA_BITMAP] for byte_idx in 0..512 {
            let b: u8 = self.bits[byte_idx as usize].to_u8()
            if b != 0xFF {
                // Found a byte with free bits.
                // loop: bounds[BOUND_BA_SMALL] — bounded by 8 bits
                loop: bounds[BOUND_BA_SMALL] for bit_idx in 0..8 {
                    if (b & (1 << bit_idx)) == 0 {
                        let bit: u32 = byte_idx * 8 + bit_idx
                        if bit < self.total_bits.to_u32() {
                            return Option::Some(Word32::from_u32(bit))
                        }
                    }
                }
            }
        }
        Option::None
    }

    pub fn find_next_free(self: ref mut) -> Option[Word32>
        effects: [deterministic]
    {
        let start: u32 = self.last_set_bit.to_u32()
        // loop: bounds[BOUND_BA_BITMAP] — bounded by total bits
        loop: bounds[BOUND_BA_BITMAP] for i in start..self.total_bits.to_u32() {
            if !self.is_allocated(Word32::from_u32(i)) {
                return Option::Some(Word32::from_u32(i))
            }
        }
        // Wrap around.
        // loop: bounds[BOUND_BA_BITMAP] — bounded by total bits
        loop: bounds[BOUND_BA_BITMAP] for i in 0..start {
            if !self.is_allocated(Word32::from_u32(i)) {
                return Option::Some(Word32::from_u32(i))
            }
        }
        Option::None
    }

    pub fn find_free_range(self: ref mut, count: u32) -> Option[(Word32, u32)>
        effects: [deterministic]
    {
        let mut run_start: u32 = 0
        let mut run_len: u32 = 0
        // loop: bounds[BOUND_BA_LARGE] — bounded by total bits
        loop: bounds[BOUND_BA_LARGE] for i in 0..self.total_bits.to_u32() {
            if !self.is_allocated(Word32::from_u32(i)) {
                if run_len == 0 {
                    run_start = i
                }
                run_len = run_len + 1
                if run_len >= count {
                    return Option::Some((Word32::from_u32(run_start), run_len))
                }
            } else {
                run_len = 0
            }
        }
        Option::None
    }

    pub fn find_best_free_range(self: ref mut, count: u32) -> Option[(Word32, u32)>
        effects: [deterministic]
    {
        let mut best_start: u32 = 0
        let mut best_len: u32 = 0xFFFFFFFF
        let mut run_start: u32 = 0
        let mut run_len: u32 = 0
        // loop: bounds[BOUND_BA_LARGE] — bounded by total bits
        loop: bounds[BOUND_BA_LARGE] for i in 0..self.total_bits.to_u32() {
            if !self.is_allocated(Word32::from_u32(i)) {
                if run_len == 0 { run_start = i }
                run_len = run_len + 1
            } else {
                if run_len >= count && run_len < best_len {
                    best_start = run_start
                    best_len = run_len
                }
                run_len = 0
            }
        }
        // Check final run.
        if run_len >= count && run_len < best_len {
            best_start = run_start
            best_len = run_len
        }
        if best_len < 0xFFFFFFFF {
            Option::Some((Word32::from_u32(best_start), best_len))
        } else {
            Option::None
        }
    }

    pub fn allocate_range(self: ref mut, start: Word32, count: u32) -> Result<(), BaError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_BA_MEDIUM] — bounded by count
        loop: bounds[BOUND_BA_MEDIUM] for i in 0..count {
            self.allocate(Word32::from_u32(start.to_u32() + i))?
        }
        Result::Ok(())
    }

    pub fn free_range(self: ref mut, start: Word32, count: u32) -> Result<(), BaError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_BA_MEDIUM] — bounded by count
        loop: bounds[BOUND_BA_MEDIUM] for i in 0..count {
            self.free(Word32::from_u32(start.to_u32() + i))?
        }
        Result::Ok(())
    }

    pub fn free_count(self) -> Word32
        effects: [deterministic]
    {
        self.free_bits
    }

    pub fn is_full(self) -> bool
        effects: [deterministic]
    {
        self.free_bits.to_u32() == 0
    }

    pub fn to_serialized(self) -> Byte[512]
        effects: [deterministic, serialize]
    {
        let mut buf: Byte[512] = [Byte::from_u8(0); 512]
        // loop: bounds[BOUND_BA_BITMAP] — bounded by 512
        loop: bounds[BOUND_BA_BITMAP] for i in 0..512 {
            buf[i] = self.bits[i]
        }
        buf
    }

    pub fn from_serialized(data: Byte[512], total: Word32) -> BlockBitmap
        effects: [deterministic, deserialize]
    {
        let mut bm: BlockBitmap = BlockBitmap::new(total)
        let mut free: u32 = 0
        // loop: bounds[BOUND_BA_BITMAP] — bounded by 512 bytes, 8 bits each
        loop: bounds[BOUND_BA_BITMAP] for byte_idx in 0..512 {
            bm.bits[byte_idx as usize] = data[byte_idx as usize]
            let b: u8 = data[byte_idx as usize].to_u8()
            // loop: bounds[BOUND_BA_SMALL] — bounded by 8 bits
            loop: bounds[BOUND_BA_SMALL] for bit_idx in 0..8 {
                if (b & (1 << bit_idx)) == 0 {
                    free = free + 1
                }
            }
        }
        bm.free_bits = Word32::from_u32(free)
        bm
    }

    pub fn count_fragments(self) -> u32
        effects: [deterministic]
    {
        let mut fragments: u32 = 0
        let mut in_free: bool = false
        // loop: bounds[BOUND_BA_LARGE] — bounded by total bits
        loop: bounds[BOUND_BA_LARGE] for i in 0..self.total_bits.to_u32() {
            let is_free: bool = !self.is_allocated(Word32::from_u32(i))
            if is_free && !in_free {
                fragments = fragments + 1
                in_free = true
            } else if !is_free {
                in_free = false
            }
        }
        fragments
    }
}

// ──────────────────────────────────────────────
// Block Group Allocator
// ──────────────────────────────────────────────
// Evidence path: BA-GROUP-001 through BA-GROUP-025

pub type BlockGroupAllocator : struct {
    group_index: Word32,                 // Block group index
    block_bitmap: BlockBitmap,           // Block allocation bitmap
    inode_bitmap: BlockBitmap,           // Inode allocation bitmap
    descriptor: BlockGroupDescriptor,   // Group descriptor
}

impl BlockGroupAllocator {
    pub fn new(index: Word32, desc: BlockGroupDescriptor) -> BlockGroupAllocator
        effects: [deterministic]
    {
        BlockGroupAllocator {
            group_index: index,
            block_bitmap: BlockBitmap::new(Word32::from_u32(BLOCKS_PER_GROUP)),
            inode_bitmap: BlockBitmap::new(Word32::from_u32(INODES_PER_GROUP)),
            descriptor: desc,
        }
    }

    pub fn allocate_block(self: ref mut, policy: AllocationPolicy) -> Result[Word64, BaError>
        effects: [io, deterministic]
    {
        if self.block_bitmap.is_full() {
            return Result::Err(ba_no_space("No free blocks in group"))
        }
        let bit_opt: Option[Word32>
        if policy == AllocationPolicy::AllocationPolicy_FirstFit {
            bit_opt = self.block_bitmap.find_first_free()
        } else if policy == AllocationPolicy::AllocationPolicy_NextFit {
            bit_opt = self.block_bitmap.find_next_free()
        } else {
            bit_opt = self.block_bitmap.find_first_free()
        }
        if bit_opt.is_none() {
            return Result::Err(ba_no_space("No free blocks in group"))
        }
        let bit: Word32 = bit_opt.unwrap()
        self.block_bitmap.allocate(bit)?
        self.descriptor.free_blocks_count = self.descriptor.free_blocks_count.checked_sub(Word64::one()).unwrap_or(self.descriptor.free_blocks_count)
        let block_number: Word64 = Word64::from_u64(
            (self.group_index.to_u32() as u64) * (BLOCKS_PER_GROUP as u64) + bit.to_u32() as u64)
        Result::Ok(block_number)
    }

    pub fn allocate_blocks(self: ref mut, count: u32, policy: AllocationPolicy) -> Result<(Word64, u32), BaError>
        effects: [io, deterministic]
    {
        let range_opt: Option[(Word32, u32)>
        if policy == AllocationPolicy::AllocationPolicy_BestFit {
            range_opt = self.block_bitmap.find_best_free_range(count)
        } else {
            range_opt = self.block_bitmap.find_free_range(count)
        }
        if range_opt.is_none() {
            return Result::Err(ba_no_space("No contiguous free range"))
        }
        let (start, len): (Word32, u32) = range_opt.unwrap()
        self.block_bitmap.allocate_range(start, len)?
        self.descriptor.free_blocks_count = self.descriptor.free_blocks_count.checked_sub(Word64::from_u64(len as u64)).unwrap_or(self.descriptor.free_blocks_count)
        let first_block: Word64 = Word64::from_u64(
            (self.group_index.to_u32() as u64) * (BLOCKS_PER_GROUP as u64) + start.to_u32() as u64)
        Result::Ok((first_block, len))
    }

    pub fn free_block(self: ref mut, block_number: Word64) -> Result<(), BaError>
        effects: [io, deterministic]
    {
        let group_base: u64 = (self.group_index.to_u32() as u64) * (BLOCKS_PER_GROUP as u64)
        if block_number.to_u64() < group_base {
            return Result::Err(ba_error("Block number below group range"))
        }
        let offset: u64 = block_number.to_u64() - group_base
        if offset >= BLOCKS_PER_GROUP as u64 {
            return Result::Err(ba_error("Block number above group range"))
        }
        self.block_bitmap.free(Word32::from_u32(offset as u32))?
        self.descriptor.free_blocks_count = self.descriptor.free_blocks_count.checked_add(Word64::one()).unwrap_or(self.descriptor.free_blocks_count)
        Result::Ok(())
    }

    pub fn free_blocks(self: ref mut, start_block: Word64, count: u32) -> Result<(), BaError>
        effects: [io, deterministic]
    {
        let group_base: u64 = (self.group_index.to_u32() as u64) * (BLOCKS_PER_GROUP as u64)
        if start_block.to_u64() < group_base {
            return Result::Err(ba_error("Start block below group range"))
        }
        let offset: u64 = start_block.to_u64() - group_base
        if (offset + count as u64) > BLOCKS_PER_GROUP as u64 {
            return Result::Err(ba_error("Range exceeds group boundary"))
        }
        self.block_bitmap.free_range(Word32::from_u32(offset as u32), count)?
        self.descriptor.free_blocks_count = self.descriptor.free_blocks_count.checked_add(Word64::from_u64(count as u64)).unwrap_or(self.descriptor.free_blocks_count)
        Result::Ok(())
    }

    pub fn allocate_inode(self: ref mut) -> Result<Word64, BaError>
        effects: [io, deterministic]
    {
        if self.inode_bitmap.is_full() {
            return Result::Err(ba_no_space("No free inodes in group"))
        }
        let bit_opt: Option[Word32> = self.inode_bitmap.find_first_free()
        if bit_opt.is_none() {
            return Result::Err(ba_no_space("No free inodes"))
        }
        let bit: Word32 = bit_opt.unwrap()
        self.inode_bitmap.allocate(bit)?
        self.descriptor.free_inodes_count = self.descriptor.free_inodes_count.checked_sub(Word64::one()).unwrap_or(self.descriptor.free_inodes_count)
        let inode_number: Word64 = Word64::from_u64(
            (self.group_index.to_u32() as u64) * (INODES_PER_GROUP as u64) + bit.to_u32() as u64)
        Result::Ok(inode_number)
    }

    pub fn free_inode(self: ref mut, inode_number: Word64) -> Result<(), BaError>
        effects: [io, deterministic]
    {
        let group_base: u64 = (self.group_index.to_u32() as u64) * (INODES_PER_GROUP as u64)
        if inode_number.to_u64() < group_base {
            return Result::Err(ba_error("Inode number below group range"))
        }
        let offset: u64 = inode_number.to_u64() - group_base
        if offset >= INODES_PER_GROUP as u64 {
            return Result::Err(ba_error("Inode number above group range"))
        }
        self.inode_bitmap.free(Word32::from_u32(offset as u32))?
        self.descriptor.free_inodes_count = self.descriptor.free_inodes_count.checked_add(Word64::one()).unwrap_or(self.descriptor.free_inodes_count)
        Result::Ok(())
    }

    pub fn free_blocks_count(self) -> Word64
        effects: [deterministic]
    {
        self.descriptor.free_blocks_count
    }

    pub fn free_inodes_count(self) -> Word64
        effects: [deterministic]
    {
        self.descriptor.free_inodes_count
    }

    pub def fragment_count(self) -> u32
        effects: [deterministic]
    {
        self.block_bitmap.count_fragments()
    }
}

// ──────────────────────────────────────────────
// Extent Allocator (coordinates across groups)
// ──────────────────────────────────────────────
// Evidence path: BA-EXTENT-001 through BA-EXTENT-025

pub type ExtentAllocator : struct {
    groups: FixedArray[1024, BlockGroupAllocator],
    group_count: Word32,
    policy: AllocationPolicy,
    total_free_blocks: Word64,
    total_free_inodes: Word64,
}

impl ExtentAllocator {
    pub fn new() -> ExtentAllocator
        effects: [deterministic]
    {
        ExtentAllocator {
            groups: FixedArray::new(),
            group_count: Word32::from_u32(0),
            policy: AllocationPolicy::AllocationPolicy_FirstFit,
            total_free_blocks: Word64::zero(),
            total_free_inodes: Word64::zero(),
        }
    }

    pub fn add_group(self: ref mut, index: Word32, desc: BlockGroupDescriptor)
        effects: [deterministic]
    {
        let allocator: BlockGroupAllocator = BlockGroupAllocator::new(index, desc)
        self.groups.push(allocator)
        self.group_count = Word32::from_u32(self.groups.len())
    }

    pub fn set_policy(self: ref mut, policy: AllocationPolicy)
        effects: [deterministic]
    {
        self.policy = policy
    }

    pub fn allocate_extent(self: ref mut, count: u32) -> Result<Extent, BaError>
        effects: [io, deterministic]
    {
        // Try to allocate from each group.
        // loop: bounds[BOUND_BA_LARGE] — bounded by 1024 groups
        loop: bounds[BOUND_BA_LARGE] for i in 0..self.groups.len() {
            let group: BlockGroupAllocator = self.groups.get(i).unwrap_or(
                BlockGroupAllocator::new(Word32::from_u32(0), BlockGroupDescriptor::new(Word64::zero(), Word64::zero(), Word64::zero())))
            if group.free_blocks_count().gt(Word64::from_u64(count as u64)) {
                let result: Result[(Word64, u32), BaError> = group.allocate_blocks(count, self.policy)
                if result.is_ok() {
                    let (start_blk, actual_len): (Word64, u32) = result.unwrap()
                    let extent: Extent = Extent::new(Word64::zero(), start_blk, Word64::from_u64(actual_len as u64))
                    residual emit {
                        subsystem: "extent_allocator",
                        operation: "allocate_extent",
                        start_block: start_blk,
                        count: actual_len,
                        group: i,
                        timestamp: __builtin_timestamp(),
                    }
                    return Result::Ok(extent)
                }
            }
        }
        Result::Err(ba_no_space("No space for extent"))
    }

    pub fn allocate_inode(self: ref mut) -> Result[Word64, BaError>
        effects: [io, deterministic]
    {
        // loop: bounds[BOUND_BA_LARGE] — bounded by 1024 groups
        loop: bounds[BOUND_BA_LARGE] for i in 0..self.groups.len() {
            let group: BlockGroupAllocator = self.groups.get(i).unwrap_or(
                BlockGroupAllocator::new(Word32::from_u32(0), BlockGroupDescriptor::new(Word64::zero(), Word64::zero(), Word64::zero())))
            if group.free_inodes_count().gt(Word64::zero()) {
                let inum: Word64 = group.allocate_inode()?
                return Result::Ok(inum)
            }
        }
        Result::Err(ba_no_space("No free inodes"))
    }

    pub fn free_extent(self: ref mut, extent: Extent) -> Result<(), BaError>
        effects: [io, deterministic]
    {
        let start: Word64 = extent.physical_block
        let count: u32 = extent.block_count.to_u32()
        let group_idx: u32 = (start.to_u64() / BLOCKS_PER_GROUP as u64) as u32
        let group_opt: Option[ref mut BlockGroupAllocator> = self.groups.ref_mut_at(group_idx)
        if group_opt.is_none() {
            return Result::Err(ba_error("Block group not found"))
        }
        let group: ref mut BlockGroupAllocator = group_opt.unwrap()
        group.free_blocks(start, count)?
        residual emit {
            subsystem: "extent_allocator",
            operation: "free_extent",
            start_block: start,
            count: count,
            group: group_idx,
            timestamp: __builtin_timestamp(),
        }
        Result::Ok(())
    }

    pub fn free_inode(self: ref mut, inode_number: Word64) -> Result<(), BaError>
        effects: [io, deterministic]
    {
        let group_idx: u32 = (inode_number.to_u64() / INODES_PER_GROUP as u64) as u32
        let group_opt: Option[ref mut BlockGroupAllocator> = self.groups.ref_mut_at(group_idx)
        if group_opt.is_none() {
            return Result::Err(ba_error("Block group not found"))
        }
        let group: ref mut BlockGroupAllocator = group_opt.unwrap()
        group.free_inode(inode_number)
    }

    pub fn total_free(self) -> (Word64, Word64)
        effects: [deterministic]
    {
        let mut free_blocks: Word64 = Word64::zero()
        let mut free_inodes: Word64 = Word64::zero()
        // loop: bounds[BOUND_BA_LARGE] — bounded by 1024
        loop: bounds[BOUND_BA_LARGE] for i in 0..self.groups.len() {
            let g: BlockGroupAllocator = self.groups.get(i).unwrap_or(
                BlockGroupAllocator::new(Word32::from_u32(0), BlockGroupDescriptor::new(Word64::zero(), Word64::zero(), Word64::zero())))
            free_blocks = free_blocks.checked_add(g.free_blocks_count()).unwrap_or(free_blocks)
            free_inodes = free_inodes.checked_add(g.free_inodes_count()).unwrap_or(free_inodes)
        }
        (free_blocks, free_inodes)
    }

    pub fn needs_defragmentation(self) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_BA_LARGE] — bounded by 1024
        loop: bounds[BOUND_BA_LARGE] for i in 0..self.groups.len() {
            let g: BlockGroupAllocator = self.groups.get(i).unwrap_or(
                BlockGroupAllocator::new(Word32::from_u32(0), BlockGroupDescriptor::new(Word64::zero(), Word64::zero(), Word64::zero())))
            if g.fragment_count() > BA_DEFRAG_THRESHOLD {
                return true
            }
        }
        false
    }

    pub fn residual_stats(self)
        effects: [io, deterministic]
    {
        let (free_blks, free_inos): (Word64, Word64) = self.total_free()
        residual emit {
            subsystem: "extent_allocator",
            operation: "stats",
            group_count: self.group_count,
            total_free_blocks: free_blks,
            total_free_inodes: free_inos,
            timestamp: __builtin_timestamp(),
        }
    }
}

// ──────────────────────────────────────────────
// Defragmentation Operations
// ──────────────────────────────────────────────
// Evidence path: BA-DEFRAG-001 through BA-DEFRAG-015

pub fn defragment_group(allocator: ref mut BlockGroupAllocator) -> Result<Word32, BaError>
    effects: [io, deterministic]
{
    let before_frags: u32 = allocator.fragment_count()
    if before_frags <= BA_DEFRAG_THRESHOLD {
        return Result::Ok(Word32::from_u32(0))
    }

    // In a real implementation, move blocks to consolidate free space.
    let after_frags: u32 = allocator.fragment_count()
    let reduced: u32 = if before_frags > after_frags { before_frags - after_frags } else { 0 }

    residual emit {
        subsystem: "defragmentation",
        group: allocator.group_index,
        fragments_before: before_frags,
        fragments_after: after_frags,
        timestamp: __builtin_timestamp(),
    }

    Result::Ok(Word32::from_u32(reduced))
}

pub fn defragment_all(ea: ref mut ExtentAllocator) -> Result<Word32, BaError>
    effects: [io, deterministic]
{
    let mut total_reduced: Word32 = Word32::from_u32(0)
    // loop: bounds[BOUND_BA_MEDIUM] — bounded by group count
    loop: bounds[BOUND_BA_MEDIUM] for i in 0..ea.groups.len() {
        let group_opt: Option[ref mut BlockGroupAllocator> = ea.groups.ref_mut_at(i)
        if group_opt.is_some() {
            let reduced: Word32 = defragment_group(group_opt.unwrap())?
            total_reduced = total_reduced.checked_add(reduced).unwrap_or(total_reduced)
        }
    }
    Result::Ok(total_reduced)
}

// ──────────────────────────────────────────────
// Block Reservation System
// ──────────────────────────────────────────────
// Evidence path: BA-RESERVE-001 through BA-RESERVE-020

pub type BlockReservation : struct {
    start_block: Word64,
    block_count: Word32,
    committed: bool,
    timestamp: Word64,
    owner: Identity,
}

impl BlockReservation {
    pub fn new(start: Word64, count: Word32, owner_id: Identity) -> BlockReservation
        effects: [deterministic]
    {
        BlockReservation {
            start_block: start,
            block_count: count,
            committed: false,
            timestamp: __builtin_timestamp(),
            owner: owner_id,
        }
    }

    pub fn commit(self: ref mut)
        effects: [deterministic]
    {
        self.committed = true
    }

    pub fn is_expired(self, timeout_us: Word64) -> bool
        effects: [deterministic]
    {
        let elapsed: Word64 = __builtin_timestamp().checked_sub(self.timestamp).unwrap_or(Word64::zero())
        elapsed.gt(timeout_us)
    }
}

pub type AllocationReservationManager : struct {
    reservations: FixedArray[32, BlockReservation>,
    timeout_us: Word64,
}

impl AllocationReservationManager {
    pub fn new(timeout: Word64) -> AllocationReservationManager
        effects: [deterministic]
    {
        AllocationReservationManager {
            reservations: FixedArray::new(),
            timeout_us: timeout,
        }
    }

    pub fn reserve(self: ref mut, start: Word64, count: Word32, owner: Identity) -> Result<Word32, BaError>
        effects: [deterministic]
    {
        if self.reservations.is_full() {
            return Result::Err(ba_error("Reservation table full"))
        }
        let res: BlockReservation = BlockReservation::new(start, count, owner)
        self.reservations.push(res)
        Result::Ok(Word32::from_u32(self.reservations.len()))
    }

    pub fn commit_reservation(self: ref mut, index: Word32)
        effects: [deterministic]
    {
        let idx: u32 = index.to_u32()
        if idx < self.reservations.len() {
            let mut res: BlockReservation = self.reservations.get(idx).unwrap_or(BlockReservation::new(Word64::zero(), Word32::from_u32(0), Identity::null()))
            res.commit()
            self.reservations.set(idx, res)
        }
    }

    pub fn cleanup_expired(self: ref mut)
        effects: [deterministic]
    {
        let mut i: u32 = 0
        // loop: bounds[BOUND_BA_SMALL] — bounded by 32
        loop: bounds[BOUND_BA_SMALL] while i < self.reservations.len() {
            let res: BlockReservation = self.reservations.get(i).unwrap_or(BlockReservation::new(Word64::zero(), Word32::from_u32(0), Identity::null()))
            if !res.committed && res.is_expired(self.timeout_us) {
                // Release the reserved blocks back to allocator.
                self.reservations.remove(i)
            } else {
                i = i + 1
            }
        }
    }
}

// ──────────────────────────────────────────────
// Block Group Balancing
// ──────────────────────────────────────────────
// Evidence path: BA-BALANCE-001 through BA-BALANCE-015

pub fn find_best_group_for_allocation(ea: ref ExtentAllocator, count: u32) -> Option[Word32>
    effects: [deterministic]
{
    let mut best_group: Word32 = Word32::from_u32(0xFFFFFFFF)
    let mut best_free: Word64 = Word64::zero()
    // loop: bounds[BOUND_BA_MEDIUM] — bounded by group count
    loop: bounds[BOUND_BA_MEDIUM] for i in 0..ea.groups.len() {
        let g: BlockGroupAllocator = ea.groups.get(i).unwrap_or(
            BlockGroupAllocator::new(Word32::from_u32(0), BlockGroupDescriptor::new(Word64::zero(), Word64::zero(), Word64::zero())))
        if g.free_blocks_count().gte(Word64::from_u64(count as u64)) {
            if best_group.to_u32() == 0xFFFFFFFF || g.free_blocks_count().lt(best_free) {
                best_group = Word32::from_u32(i)
                best_free = g.free_blocks_count()
            }
        }
    }
    if best_group.to_u32() == 0xFFFFFFFF { Option::None } else { Option::Some(best_group) }
}

pub fn balance_groups(ea: ref mut ExtentAllocator) -> Result<Word32, BaError>
    effects: [io, deterministic]
{
    let mut moved: Word32 = Word32::from_u32(0)
    // In a real implementation, move blocks from full groups to empty ones.
    Result::Ok(moved)
}

