// ─────────────────────────────────────────────────────────────
// NVM: Dataset Management (Trim/Deallocate)
// ─────────────────────────────────────────────────────────────

struct NvmeFullDatasetRange {
    ctx_attr: u32,
    lba: u64,
    length: u64,
    attr: u32,
    ref_tag: u32,
    app_tag: u32,
    app_tag_mask: u32,
}

fn nvme_full_dataset_management(
    controller: Handle(NvmeFullController),
    nsid: u32,
    nr_ranges: u8,
    range_buffer_phys: u64,
    queue_idx: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u16, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_dsm:v1"
{
    if !cap.can_dsm {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let idw: u32 = (nr_ranges as u32) & 0xFF;
    let cdw11: u32 = 0;

    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullIoOpcode::DatasetManagement as u32),
        nsid: nsid,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: range_buffer_phys,
        data_ptr2: 0,
        cdw10: idw,
        cdw11: cdw11,
        cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_io_cmd(controller, sqe, queue_idx, cap, timestamp);
    match result {
        Result::Ok(cmd_id) => {
            residual emit {
                op: "nvme_full.dsm",
                nsid: nsid as u64,
                nr_ranges: nr_ranges as u64,
                timestamp: timestamp,
            };
            return Result::Ok(cmd_id);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// NVM: Flush
// ─────────────────────────────────────────────────────────────

fn nvme_full_flush(
    controller: Handle(NvmeFullController),
    nsid: u32,
    queue_idx: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u16, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_flush:v1"
{
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullIoOpcode::Flush as u32),
        nsid: nsid,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: 0, data_ptr2: 0,
        cdw10: 0, cdw11: 0, cdw12: 0,
        cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_io_cmd(controller, sqe, queue_idx, cap, timestamp);
    match result {
        Result::Ok(cmd_id) => {
            residual emit {
                op: "nvme_full.flush",
                nsid: nsid as u64,
                timestamp: timestamp,
            };
            return Result::Ok(cmd_id);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Arbitration Configuration
// ─────────────────────────────────────────────────────────────

fn nvme_full_set_arbitration(
    controller: Handle(NvmeFullController),
    arb: NvmeFullArbitrationFeature,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_set_arbitration:v1"
{
    if !cap.can_arbitration {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let cdw11: u32 = (arb.hpw as u32) |
                     ((arb.mpw as u32) << 8) |
                     ((arb.lpw as u32) << 16) |
                     ((arb.ab as u32) << 24);

    let result: Result(u32, NvmeFullError) = nvme_full_set_features(
        controller,
        NvmeFullFeatureId::Arbitration,
        cdw11,
        0,
        cap,
        timestamp,
    );
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.set_arbitration",
                hpw: arb.hpw as u64,
                mpw: arb.mpw as u64,
                lpw: arb.lpw as u64,
                ab: arb.ab as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Power Management: Set Power State
// ─────────────────────────────────────────────────────────────

fn nvme_full_set_power_state(
    controller: Handle(NvmeFullController),
    power_state_id: u8,
    workload_hint: u8,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_set_power:v1"
{
    if !cap.can_power_mgmt {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let cdw11: u32 = (power_state_id as u32) | ((workload_hint as u32) << 8);

    let result: Result(u32, NvmeFullError) = nvme_full_set_features(
        controller,
        NvmeFullFeatureId::PowerManagement,
        cdw11,
        0,
        cap,
        timestamp,
    );
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.set_power_state",
                power_state: power_state_id as u64,
                workload_hint: workload_hint as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Power Management: Autonomous Power State Transition
// ─────────────────────────────────────────────────────────────

fn nvme_full_set_apst(
    controller: Handle(NvmeFullController),
    entries: Array(NvmeFullApstEntry, 32),
    entry_count: u8,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_set_apst:v1"
{
    if !cap.can_power_mgmt {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let cdw11: u32 = 0;
    loop bound 32 {
        if (entry_count as u64) <= 0 {
            break;
        };
        let idx: u64 = 0;
        let entry: NvmeFullApstEntry = entries[idx];
        if entry.enable {
            cdw11 = cdw11 | (entry.idle_power_state as u32) << (idx as u32 * 2);
        };
    };

    let result: Result(u32, NvmeFullError) = nvme_full_set_features(
        controller,
        NvmeFullFeatureId::AutonomousPowerStateTransition,
        cdw11,
        0,
        cap,
        timestamp,
    );
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.set_apst",
                entry_count: entry_count as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Temperature: Set Temperature Threshold
// ─────────────────────────────────────────────────────────────

fn nvme_full_set_temperature_threshold(
    controller: Handle(NvmeFullController),
    threshold: NvmeFullTemperatureThreshold,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_set_temp_threshold:v1"
{
    if !cap.can_temperature {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let cdw11: u32 = (threshold.temperature_threshold as u32) |
                     ((threshold.temperature_sensor as u32) << 16) |
                     ((threshold.threshold_type as u32) << 20);

    let result: Result(u32, NvmeFullError) = nvme_full_set_features(
        controller,
        NvmeFullFeatureId::TemperatureThreshold,
        cdw11,
        0,
        cap,
        timestamp,
    );
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.set_temp_threshold",
                threshold: threshold.temperature_threshold as u64,
                sensor: threshold.temperature_sensor as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Temperature: Read S.M.A.R.T. / Health Log
// ─────────────────────────────────────────────────────────────

fn nvme_full_read_smart_log(
    controller: Handle(NvmeFullController),
    data_buffer: u64,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(NvmeFullSmartHealthLog, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_smart_log:v1"
{
    let log_result: Result(void, NvmeFullError) = nvme_full_get_log_page(
        controller,
        NvmeFullLogPageId::SmartHealth,
        0x02,
        128,
        data_buffer,
        cap,
        timestamp,
    );
    match log_result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.read_smart",
                timestamp: timestamp,
            };
            let raw_data: Array(u8, 512) = Array::zeroed();
            return Result::Ok(nvme_full_parse_smart_log(raw_data));
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Check Temperature Critical Warning
// ─────────────────────────────────────────────────────────────

fn nvme_full_check_temperature(
    controller: Handle(NvmeFullController),
    smart_log: NvmeFullSmartHealthLog,
) -> Result(void, NvmeFullError)
    effect [deterministic]
    court "nvme_full_check_temp:v1"
{
    if (smart_log.critical_warning & 0x01) != 0 {
        return Result::Err(NvmeFullError::NvmeTemperatureCritical);
    };
    if (smart_log.critical_warning & 0x02) != 0 {
        return Result::Err(NvmeFullError::NvmeTemperatureCritical);
    };

    if smart_log.temperature_ktemp > 358 {
        return Result::Err(NvmeFullError::NvmeTemperatureCritical);
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Persistent Event Log: Read Log Header
// ─────────────────────────────────────────────────────────────

fn nvme_full_read_persistent_event_log(
    controller: Handle(NvmeFullController),
    data_buffer: u64,
    offset: u32,
    num_dwords: u32,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(NvmeFullPersistentEventLog, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_persistent_log:v1"
{
    if !cap.can_persistent_log {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::GetLogPage as u32),
        nsid: 0xFFFFFFFF,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: data_buffer,
        data_ptr2: 0,
        cdw10: (NvmeFullLogPageId::PersistentEventLog as u32) | (num_dwords << 16),
        cdw11: offset,
        cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.persistent_event_log",
                offset: offset as u64,
                num_dwords: num_dwords as u64,
                timestamp: timestamp,
            };
            let log: NvmeFullPersistentEventLog = NvmeFullPersistentEventLog {
                log_identifier: 0x0D,
                log_revision: 1,
                num_events: 0,
                event_count: 0,
                log_size: 0,
                ttl: 0,
                next_event_offset: 0,
            };
            return Result::Ok(log);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Sanitize: Get Status
// ─────────────────────────────────────────────────────────────

fn nvme_full_get_sanitize_status(
    controller: Handle(NvmeFullController),
    data_buffer: u64,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(NvmeFullSanitizeStatus, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_sanitize_status:v1"
{
    let log_result: Result(void, NvmeFullError) = nvme_full_get_log_page(
        controller,
        NvmeFullLogPageId::SanitizeStatus,
        0x15,
        64,
        data_buffer,
        cap,
        timestamp,
    );
    match log_result {
        Result::Ok(_) => {
            let status: NvmeFullSanitizeStatus = NvmeFullSanitizeStatus {
                sanitize_progress: 0,
                sanitize_status: 0,
                no_dealloc_remaining: 0,
                sanitize_command: 0,
                estimated_time: 0,
            };
            return Result::Ok(status);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Initialize Admin Queue Pair
// ─────────────────────────────────────────────────────────────

fn nvme_full_init_admin_queue(
    controller: Handle(NvmeFullController),
    admin_sq_phys: u64,
    admin_cq_phys: u64,
    queue_size: u16,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_init_admin_q:v1"
{
    let regs: NvmeFullMmioRegs = NvmeFullMmioRegs { mmio_base: controller.mmio_base };
    let doorbell_stride: u8 = controller.cap.dstrd;

    let sq_doorbell: u64 = controller.mmio_base + NvmeFullMmioRegs::sq0_tdb_offset();
    let cq_doorbell: u64 = controller.mmio_base + NvmeFullMmioRegs::cq0_hdb_offset();

    let aqa: u32 = ((queue_size as u32) << 16) | (queue_size as u32);
    regs.write32(NvmeFullMmioRegs::aqa_offset(), aqa);
    regs.write64(NvmeFullMmioRegs::asq_offset(), admin_sq_phys);
    regs.write64(NvmeFullMmioRegs::acq_offset(), admin_cq_phys);

    controller.admin_queue = NvmeFullQueuePair {
        queue_id: 0,
        submission_queue: Array::zeroed(),
        completion_queue: Array::zeroed(),
        sq_tail: 0,
        sq_head: 0,
        cq_head: 0,
        cq_phase: true,
        sq_phys_addr: admin_sq_phys,
        cq_phys_addr: admin_cq_phys,
        sq_size: queue_size,
        cq_size: queue_size,
        sq_doorbell: sq_doorbell,
        cq_doorbell: cq_doorbell,
        qprio: 1,
        doorbell_stride: doorbell_stride,
        initialized: true,
        is_admin: true,
        outstanding_commands: 0,
    };

    residual emit {
        op: "nvme_full.init_admin_queue",
        mmio_base: controller.mmio_base,
        sq_size: queue_size as u64,
        sq_phys: admin_sq_phys,
        cq_phys: admin_cq_phys,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Initialize I/O Queue Pair
// ─────────────────────────────────────────────────────────────

fn nvme_full_init_io_queue(
    controller: Handle(NvmeFullController),
    qid: u16,
    sq_size: u16,
    cq_size: u16,
    sq_phys: u64,
    cq_phys: u64,
    qprio: u8,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_init_io_queue:v1"
{
    if (qid as u64) >= 64 {
        return Result::Err(NvmeFullError::NvmeMaxQueuesExceeded);
    };

    let cq_result: Result(void, NvmeFullError) = nvme_full_create_io_cq(
        controller, qid, cq_size, cq_phys, 1, qprio, cap, timestamp,
    );
    match cq_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let sq_result: Result(void, NvmeFullError) = nvme_full_create_io_sq(
        controller, qid, sq_size, sq_phys, qid, qprio, cap, timestamp,
    );
    match sq_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let sq_doorbell: u64 = controller.mmio_base + NvmeFullMmioRegs::sq_tdb_offset(qid as u32);
    let cq_doorbell: u64 = controller.mmio_base + NvmeFullMmioRegs::cq_hdb_offset(qid as u32);

    let idx: u64 = qid as u64;
    controller.io_queues[idx] = NvmeFullQueuePair {
        queue_id: qid,
        submission_queue: Array::zeroed(),
        completion_queue: Array::zeroed(),
        sq_tail: 0,
        sq_head: 0,
        cq_head: 0,
        cq_phase: true,
        sq_phys_addr: sq_phys,
        cq_phys_addr: cq_phys,
        sq_size: sq_size,
        cq_size: cq_size,
        sq_doorbell: sq_doorbell,
        cq_doorbell: cq_doorbell,
        qprio: qprio,
        doorbell_stride: controller.cap.dstrd,
        initialized: true,
        is_admin: false,
        outstanding_commands: 0,
    };

    if qid >= controller.io_queue_count {
        controller.io_queue_count = qid + 1;
    };

    residual emit {
        op: "nvme_full.init_io_queue",
        qid: qid as u64,
        sq_size: sq_size as u64,
        cq_size: cq_size as u64,
        sq_phys: sq_phys,
        cq_phys: cq_phys,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Controller Initialization (Full)
// ─────────────────────────────────────────────────────────────

fn nvme_full_controller_init(
    controller: Handle(NvmeFullController),
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_controller_init:v1"
{
    let regs: NvmeFullMmioRegs = NvmeFullMmioRegs { mmio_base: controller.mmio_base };

    let cap_raw: u64 = regs.read64(NvmeFullMmioRegs::cap_offset());
    controller.cap = nvme_full_parse_cap(cap_raw);

    let ver_raw: u32 = regs.read32(NvmeFullMmioRegs::vs_offset());
    controller.version = nvme_full_parse_version(ver_raw);

    let timeout_500ms: u64 = controller.cap.timeout as u64;
    controller.ready_timeout_ms = timeout_500ms * 500;

    let cc: u32 = regs.read32(NvmeFullMmioRegs::cc_offset());
    regs.write32(NvmeFullMmioRegs::cc_offset(), cc & !0x01);

    loop bound 200 {
        let csts: u32 = regs.read32(NvmeFullMmioRegs::csts_offset());
        if (csts & 0x01) == 0 {
            break;
        };
    };

    let arb: u32 = 0;
    let mps: u32 = 0;
    let css: u32 = 0;
    let new_cc: u32 = (arb << 11) | (mps << 7) | (css << 4) | 0x01;
    regs.write32(NvmeFullMmioRegs::cc_offset(), new_cc);

    loop bound 200 {
        let csts: u32 = regs.read32(NvmeFullMmioRegs::csts_offset());
        if (csts & 0x01) != 0 {
            break;
        };
    };

    let admin_sq_phys: u64 = controller.dma_base;
    let admin_cq_phys: u64 = controller.dma_base + 4096;
    let init_q_result: Result(void, NvmeFullError) = nvme_full_init_admin_queue(
        controller, admin_sq_phys, admin_cq_phys, 64,
    );
    match init_q_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    controller.initialized = true;

    residual emit {
        op: "nvme_full.controller_init",
        mmio_base: controller.mmio_base,
        version_major: controller.version.major as u64,
        version_minor: controller.version.minor as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn nvme_full_driver_init(
    driver_identity: Identity,
    dma_base: u64,
    dma_size: u64,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> NvmeFullDriverState
    effect [deterministic, residual]
    court "nvme_full_driver_init:v1"
{
    let state: NvmeFullDriverState = NvmeFullDriverState {
        driver_identity: driver_identity,
        controllers: Array::zeroed(),
        controller_count: 0,
        default_dma_base: dma_base,
        default_dma_size: dma_size,
        initialized: true,
        initialization_timestamp: timestamp,
        total_io_operations: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "nvme_full.driver_init",
        driver_identity: driver_identity.id_hash,
        dma_base: dma_base,
        dma_size: dma_size,
        timestamp: timestamp,
    };

    return state;
}

// ─────────────────────────────────────────────────────────────
// Add Controller from PCI Discovery
// ─────────────────────────────────────────────────────────────

fn nvme_full_add_controller(
    state: Handle(NvmeFullDriverState),
    mmio_base: u64,
    mmio_size: u64,
    pci_bus: u8,
    pci_device: u8,
    pci_func: u8,
    irq_vector: u8,
    dma_base: u64,
    dma_size: u64,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u64, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_add_controller:v1"
{
    if state.controller_count >= 8 {
        return Result::Err(NvmeFullError::NvmeMaxQueuesExceeded);
    };

    let idx: u64 = state.controller_count;
    let ctrl_identity: Identity = identity_new(0x4E564D, timestamp, idx, pci_bus as u64);

    let prp_pool: NvmeFullPrpList = NvmeFullPrpList {
        entries: Array::zeroed(),
        entry_count: 0,
        list_phys_addr: dma_base + 0x2000,
    };

    let controller: NvmeFullController = NvmeFullController {
        controller_identity: ctrl_identity,
        mmio_base: mmio_base,
        mmio_size: mmio_size,
        pci_bus: pci_bus,
        pci_device: pci_device,
        pci_func: pci_func,
        irq_vector: irq_vector,
        cap: NvmeFullCap { mqes: 0, timeout: 0, css_nvm: false, dstrd: 0, to: 0, ams: 0, cqr: false, css: 0, bins: 0, crto: 0, pmrs: false, pmru: false, nsscc: 0 },
        version: NvmeFullVersion { major: 0, minor: 0, tertiary: 0 },
        admin_queue: NvmeFullQueuePair { queue_id: 0, submission_queue: Array::zeroed(), completion_queue: Array::zeroed(), sq_tail: 0, sq_head: 0, cq_head: 0, cq_phase: true, sq_phys_addr: 0, cq_phys_addr: 0, sq_size: 0, cq_size: 0, sq_doorbell: 0, cq_doorbell: 0, qprio: 0, doorbell_stride: 0, initialized: false, is_admin: true, outstanding_commands: 0 },
        io_queues: Array::zeroed(),
        io_queue_count: 0,
        namespaces: Array::zeroed(),
        namespace_count: 0,
        dma_base: dma_base,
        dma_size: dma_size,
        prp_pool: prp_pool,
        ctrl_data: NvmeFullIdentifyControllerData { vid: 0, ssvid: 0, sn: [0u8; 20], mn: [0u8; 40], fr: [0u8; 8], rab: 0, ieee: [0u8; 3], cmic: 0, mdts: 0, cntlid: 0, ver: 0, oacs: 0, abd: 0, max_namespaces: 0, sqes: 0, cqes: 0, nn: 0, oncs: 0, fuses: 0, fna: 0, vwc: 0, awun: 0, awupf: 0, acwu: 0, sgls: 0, nvm_sr: 0, power_states: Array::zeroed(), vs_00: 0, vs_01: 0, vs_02: 0, vs_03: 0, vs_04: 0, vs_05: 0 },
        ready_timeout_ms: 0,
        sanitize_status: NvmeFullSanitizeStatus { sanitize_progress: 0, sanitize_status: 0, no_dealloc_remaining: 0, sanitize_command: 0, estimated_time: 0 },
        initialized: false,
        fatal_error: false,
        residual_log: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    state.controllers[idx] = controller;

    let ctrl_handle: Handle(NvmeFullController) = Handle(NvmeFullController)::from_ptr(&state.controllers[idx]);
    let init_result: Result(void, NvmeFullError) = nvme_full_controller_init(ctrl_handle, cap, timestamp);
    match init_result {
        Result::Err(e) => {
            state.controllers[idx].fatal_error = true;
            return Result::Err(e);
        },
        Result::Ok(_) => {},
    };

    state.controller_count = state.controller_count + 1;

    residual emit {
        op: "nvme_full.add_controller",
        controller_idx: idx,
        mmio_base: mmio_base,
        pci_bus: pci_bus as u64,
        pci_device: pci_device as u64,
        pci_func: pci_func as u64,
        timestamp: timestamp,
    };

    return Result::Ok(idx);
}

// ─────────────────────────────────────────────────────────────
// Discover Namespaces
// ─────────────────────────────────────────────────────────────

fn nvme_full_discover_namespaces(
    controller: Handle(NvmeFullController),
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u32, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_discover_ns:v1"
{
    let nn: u32 = controller.ctrl_data.nn;
    let mut discovered: u32 = 0;

    loop bound 32 {
        if discovered >= nn {
            break;
        };
        if discovered >= 32 {
            break;
        };
        let nsid: u32 = discovered + 1;
        let data_buf: u64 = controller.dma_base + 0x4000 + ((discovered as u64) * 4096);
        let ns_result: Result(void, NvmeFullError) = nvme_full_identify_namespace(controller, nsid, data_buf, cap, timestamp);
        match ns_result {
            Result::Ok(_) => {
                let ns: NvmeFullNamespace = NvmeFullNamespace {
                    nsid: nsid,
                    identify_data: NvmeFullIdentifyNamespaceData {
                        nsze: 0, ncap: 0, nuse: 0, nsfeat: 0, nlbaf: 0, flbas: 0,
                        mc: 0, dpc: 0, dps: 0, nmic: 0, rescap: 0, fpi: 0, dlfeat: 0,
                        nawun: 0, nawupf: 0, nacwu: 0, nabsn: 0, nabo: 0, nabspf: 0,
                        noiob: 0, nvmcap: 0, nsattr: 0, nvmsetid: 0, anagrpid: 0,
                        endgid: 0, nguid: [0u8; 16], eui64: 0, lbaf: Array::zeroed(),
                        vs: [0u8; 3712],
                    },
                    block_size: 512,
                    block_count: 0,
                    lba_shift: 9,
                    active: true,
                    write_protected: false,
                };
                controller.namespaces[discovered as u64] = ns;
                discovered = discovered + 1;
            },
            Result::Err(_) => {
                break;
            },
        };
    };

    controller.namespace_count = discovered;

    residual emit {
        op: "nvme_full.discover_namespaces",
        count: discovered as u64,
        timestamp: timestamp,
    };

    return Result::Ok(discovered);
}

// ─────────────────────────────────────────────────────────────
// Setup I/O Queues (Batch)
// ─────────────────────────────────────────────────────────────

fn nvme_full_setup_io_queues(
    controller: Handle(NvmeFullController),
    num_queues: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u16, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_setup_queues:v1"
{
    let mut qid: u16 = 1;
    loop bound 64 {
        if qid > num_queues {
            break;
        };
        let sq_phys: u64 = controller.dma_base + ((qid as u64) * 2 * 4096);
        let cq_phys: u64 = controller.dma_base + ((qid as u64) * 2 * 4096) + 4096;
        let q_result: Result(void, NvmeFullError) = nvme_full_init_io_queue(
            controller, qid, 256, 256, sq_phys, cq_phys, 1, cap, timestamp,
        );
        match q_result {
            Result::Err(_) => { break; },
            Result::Ok(_) => {},
        };
        qid = qid + 1;
    };

    let created: u16 = qid - 1;

    residual emit {
        op: "nvme_full.setup_io_queues",
        requested: num_queues as u64,
        created: created as u64,
        timestamp: timestamp,
    };

    return Result::Ok(created);
}

// ─────────────────────────────────────────────────────────────
// Controller Shutdown
// ─────────────────────────────────────────────────────────────

fn nvme_full_shutdown(
    controller: Handle(NvmeFullController),
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_shutdown:v1"
{
    if !controller.initialized {
        return Result::Ok(void);
    };

    let regs: NvmeFullMmioRegs = NvmeFullMmioRegs { mmio_base: controller.mmio_base };

    let nss_val: u32 = 0x01;
    regs.write32(NvmeFullMmioRegs::nss_offset(), nss_val);

    loop bound 100 {
        let csts: u32 = regs.read32(NvmeFullMmioRegs::csts_offset());
        if (csts & 0x02) != 0 {
            break;
        };
    };

    let cc: u32 = regs.read32(NvmeFullMmioRegs::cc_offset());
    regs.write32(NvmeFullMmioRegs::cc_offset(), cc & !0x01);

    controller.initialized = false;

    residual emit {
        op: "nvme_full.shutdown",
        mmio_base: controller.mmio_base,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}
