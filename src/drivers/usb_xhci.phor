    effect [memory:mmio, deterministic, residual]
    court "xhci_configure_endpoint:v1"
{
    let param: u64 = input_ctx_phys;
    let status: u32;
    if deconfigure {
        status = 0x01;
    } else {
        status = 0x00;
    };

    let cmd_result: Result(void, XhciError) = xhci_enqueue_command_trb(
        Handle(XhciCommandRing)::from_ptr(&controller.cmd_ring),
        param, status, XhciTrbType::ConfigureEndpointCommand, controller.cmd_ring.cycle_state, true, timestamp,
    );
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let db_result: Result(void, XhciError) = xhci_ring_doorbell(controller, 0, 0, 0, timestamp);
    match db_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    residual emit {
        op: "xhci.configure_endpoint",
        slot_id: slot_id as u64,
        deconfigure: deconfigure,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Stop Endpoint Command
// ─────────────────────────────────────────────────────────────

fn xhci_stop_endpoint(
    controller: Handle(XhciController),
    slot_id: u8,
    ep_index: u8,
    suspend: bool,
    cap: XhciFullCapability,
    timestamp: u64,
) -> Result(void, XhciError)
    effect [memory:mmio, deterministic, residual]
    court "xhci_stop_endpoint:v1"
{
    let param: u64 = (slot_id as u64) | ((ep_index as u64) << 8);
    let status: u32;
    if suspend {
        status = 0x01;
    } else {
        status = 0x00;
    };

    let cmd_result: Result(void, XhciError) = xhci_enqueue_command_trb(
        Handle(XhciCommandRing)::from_ptr(&controller.cmd_ring),
        param, status, XhciTrbType::StopEndpointCommand, controller.cmd_ring.cycle_state, true, timestamp,
    );
    match cmd_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let db_result: Result(void, XhciError) = xhci_ring_doorbell(controller, 0, 0, 0, timestamp);
    match db_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    return Result::Ok(void);
}

