// file: multiboot.phor
// purpose: Multiboot protocol (v1 and v2) — header parsing, boot information
//          structure, memory map, module loading, command line, ELF sections,
//          ACPI RSDP discovery, framebuffer info
// effects: [deterministic, io:read, io:write]
// trust: TrustState_Bootstrap

package "phorensic:multiboot:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*
use core::traits::*
use core::math::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MULTIBOOT1_MAGIC: Word32 = 0x2BADB002
const MULTIBOOT2_MAGIC: Word32 = 0x36D76289
const MULTIBOOT2_ARCH_I386: u32 = 0
const MULTIBOOT2_ARCH_MIPS: u32 = 4
const MULTIBOOT1_HEADER_MAGIC: Word32 = 0x1BADB002
const MULTIBOOT2_HEADER_MAGIC: Word32 = 0xE85250D6
const MAX_MBI_TAGS: u32 = 64
const MAX_MODULE_CMDLINE: u32 = 256
const MAX_MMAP_ENTRIES: u32 = 128
const MAX_ELF_SECTIONS: u32 = 64
const MAX_RSDP_LENGTH: u32 = 36
const MAX_ACPI_RSDT_ENTRIES: u32 = 256

// Multiboot v1 flags
const MB1_FLAG_PAGE_ALIGN: u32 = 0x0000_0001
const MB1_FLAG_MEMORY_INFO: u32 = 0x0000_0002
const MB1_FLAG_VIDEO_MODE: u32 = 0x0000_0004
const MB1_FLAG_AOUT_KLUDGE: u32 = 0x0001_0000

// Multiboot v2 tag types
const MB2_TAG_END: u32 = 0
const MB2_TAG_CMDLINE: u32 = 1
const MB2_TAG_BOOT_LOADER_NAME: u32 = 2
const MB2_TAG_MODULE: u32 = 3
const MB2_TAG_BASIC_MEMINFO: u32 = 4
const MB2_TAG_BOOTDEV: u32 = 5
const MB2_TAG_MMAP: u32 = 6
const MB2_TAG_VBE: u32 = 7
const MB2_TAG_FRAMEBUFFER: u32 = 8
const MB2_TAG_ELF_SECTIONS: u32 = 9
const MB2_TAG_APM: u32 = 10
const MB2_TAG_EFI32: u32 = 11
const MB2_TAG_EFI64: u32 = 12
const MB2_TAG_SMBIOS: u32 = 13
const MB2_TAG_ACPI_OLD: u32 = 14
const MB2_TAG_ACPI_NEW: u32 = 15
const MB2_TAG_NETWORK: u32 = 16
const MB2_TAG_EFI_MMAP: u32 = 17
const MB2_TAG_EFI_BS: u32 = 18
const MB2_TAG_EFI32_IH: u32 = 19
const MB2_TAG_EFI64_IH: u32 = 20
const MB2_TAG_LOAD_BASE_ADDR: u32 = 21

// Memory region types
const MULTIBOOT_MEMORY_AVAILABLE: u32 = 1
const MULTIBOOT_MEMORY_RESERVED: u32 = 2
const MULTIBOOT_MEMORY_ACPI_RECLAIM: u32 = 3
const MULTIBOOT_MEMORY_NVS: u32 = 4
const MULTIBOOT_MEMORY_BADRAM: u32 = 5

// Framebuffer types
const FRAMEBUFFER_TYPE_INDEXED: u8 = 0
const FRAMEBUFFER_TYPE_RGB: u8 = 1
const FRAMEBUFFER_TYPE_EGA_TEXT: u8 = 2

// ──────────────────────────────────────────────
// Multiboot v1 Header
// ──────────────────────────────────────────────

pub type MultiBoot1Header : struct {
    magic: Word32,
    flags: Word32,
    checksum: Word32,
    header_addr: Word32,
    load_addr: Word32,
    load_end_addr: Word32,
    bss_end_addr: Word32,
    entry_addr: Word32,
    mode_type: Word32,
    width: Word32,
    height: Word32,
    depth: Word32,
}

impl MultiBoot1Header {
    pub fn new() -> MultiBoot1Header
        effects: [deterministic]
    {
        MultiBoot1Header {
            magic: 0,
            flags: 0,
            checksum: 0,
            header_addr: 0,
            load_addr: 0,
            load_end_addr: 0,
            bss_end_addr: 0,
            entry_addr: 0,
            mode_type: 0,
            width: 0,
            height: 0,
            depth: 0,
        }
    }

    pub fn validate(self) -> bool
        effects: [deterministic]
    {
        self.magic == MULTIBOOT1_HEADER_MAGIC &&
        (self.magic + self.flags + self.checksum) == 0
    }

    pub fn wants_memory_info(self) -> bool
        effects: [deterministic]
    {
        (self.flags & MB1_FLAG_MEMORY_INFO) != 0
    }

    pub fn wants_video_mode(self) -> bool
        effects: [deterministic]
    {
        (self.flags & MB1_FLAG_VIDEO_MODE) != 0
    }

    pub fn page_align(self) -> bool
        effects: [deterministic]
    {
        (self.flags & MB1_FLAG_PAGE_ALIGN) != 0
    }
}

// ──────────────────────────────────────────────
// Multiboot v1 Boot Information
// ──────────────────────────────────────────────

pub type MultiBoot1Info : struct {
    flags: Word32,
    mem_lower: Word32,
    mem_upper: Word32,
    boot_device: Word32,
    cmdline: Word32,
    mods_count: Word32,
    mods_addr: Word32,
    syms: FixedArray[4, Word32],
    mmap_length: Word32,
    mmap_addr: Word32,
    drives_length: Word32,
    drives_addr: Word32,
    config_table: Word32,
    boot_loader_name: Word32,
    apm_table: Word32,
    vbe_control_info: Word32,
    vbe_mode_info: Word32,
    vbe_mode: Word16,
    vbe_interface_seg: Word16,
    vbe_interface_off: Word16,
    vbe_interface_len: Word16,
    framebuffer_addr: Word64,
    framebuffer_pitch: Word32,
    framebuffer_width: Word32,
    framebuffer_height: Word32,
    framebuffer_bpp: u8,
    framebuffer_type: u8,
    color_info: FixedArray[6, u8],
}

impl MultiBoot1Info {
    pub fn new() -> MultiBoot1Info
        effects: [deterministic]
    {
        MultiBoot1Info {
            flags: 0,
            mem_lower: 0,
            mem_upper: 0,
            boot_device: 0,
            cmdline: 0,
            mods_count: 0,
            mods_addr: 0,
            syms: FixedArray::new(),
            mmap_length: 0,
            mmap_addr: 0,
            drives_length: 0,
            drives_addr: 0,
            config_table: 0,
            boot_loader_name: 0,
            apm_table: 0,
            vbe_control_info: 0,
            vbe_mode_info: 0,
            vbe_mode: 0,
            vbe_interface_seg: 0,
            vbe_interface_off: 0,
            vbe_interface_len: 0,
            framebuffer_addr: Word64::zero(),
            framebuffer_pitch: 0,
            framebuffer_width: 0,
            framebuffer_height: 0,
            framebuffer_bpp: 0,
            framebuffer_type: 0,
            color_info: FixedArray::new(),
        }
    }

    pub fn has_mem_info(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x1) != 0
    }

    pub fn has_boot_device(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x2) != 0
    }

    pub fn has_cmdline(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x4) != 0
    }

    pub fn has_modules(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x8) != 0
    }

    pub fn has_mmap(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x40) != 0
    }

    pub fn has_framebuffer(self) -> bool
        effects: [deterministic]
    {
        (self.flags & 0x2000000) != 0
    }

    pub fn get_upper_mem_kb(self) -> Word32
        effects: [deterministic]
    {
        self.mem_upper
    }

    pub fn get_lower_mem_kb(self) -> Word32
        effects: [deterministic]
    {
        self.mem_lower
    }
}

// ──────────────────────────────────────────────
// Multiboot v1 Memory Map Entry
// ──────────────────────────────────────────────

pub type MultiBoot1MMapEntry : struct {
    size: Word32,
    base_addr: Word64,
    length: Word64,
    entry_type: Word32,
}

impl MultiBoot1MMapEntry {
    pub fn new() -> MultiBoot1MMapEntry
        effects: [deterministic]
    {
        MultiBoot1MMapEntry {
            size: 0,
            base_addr: Word64::zero(),
            length: Word64::zero(),
            entry_type: 0,
        }
    }

    pub fn is_available(self) -> bool
        effects: [deterministic]
    {
        self.entry_type == MULTIBOOT_MEMORY_AVAILABLE
    }

    pub fn is_reserved(self) -> bool
        effects: [deterministic]
    {
        self.entry_type == MULTIBOOT_MEMORY_RESERVED
    }

    pub fn is_acpi_reclaim(self) -> bool
        effects: [deterministic]
    {
        self.entry_type == MULTIBOOT_MEMORY_ACPI_RECLAIM
    }

    pub fn is_nvs(self) -> bool
        effects: [deterministic]
    {
        self.entry_type == MULTIBOOT_MEMORY_NVS
    }

    pub fn is_badram(self) -> bool
        effects: [deterministic]
    {
        self.entry_type == MULTIBOOT_MEMORY_BADRAM
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Tag Structure
// ──────────────────────────────────────────────

pub type MultiBoot2Tag : struct {
    tag_type: Word32,
    size: Word32,
}

impl MultiBoot2Tag {
    pub fn new() -> MultiBoot2Tag
        effects: [deterministic]
    {
        MultiBoot2Tag {
            tag_type: 0,
            size: 0,
        }
    }

    pub fn is_end(self) -> bool
        effects: [deterministic]
    {
        self.tag_type == MB2_TAG_END
    }

    pub fn tag_id(self) -> Word32
        effects: [deterministic]
    {
        self.tag_type
    }

    pub fn total_size(self) -> Word32
        effects: [deterministic]
    {
        self.size
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Framebuffer Tag
// ──────────────────────────────────────────────

pub type MultiBoot2Framebuffer : struct {
    tag: MultiBoot2Tag,
    framebuffer_addr: Word64,
    framebuffer_pitch: Word32,
    framebuffer_width: Word32,
    framebuffer_height: Word32,
    framebuffer_bpp: u8,
    framebuffer_type: u8,
    reserved: u8,
    color_info: FixedArray[8, u8],
}

impl MultiBoot2Framebuffer {
    pub fn new() -> MultiBoot2Framebuffer
        effects: [deterministic]
    {
        MultiBoot2Framebuffer {
            tag: MultiBoot2Tag::new(),
            framebuffer_addr: Word64::zero(),
            framebuffer_pitch: 0,
            framebuffer_width: 0,
            framebuffer_height: 0,
            framebuffer_bpp: 0,
            framebuffer_type: 0,
            reserved: 0,
            color_info: FixedArray::new(),
        }
    }

    pub fn is_rgb(self) -> bool
        effects: [deterministic]
    {
        self.framebuffer_type == FRAMEBUFFER_TYPE_RGB
    }

    pub fn is_text_mode(self) -> bool
        effects: [deterministic]
    {
        self.framebuffer_type == FRAMEBUFFER_TYPE_EGA_TEXT
    }

    pub fn addr(self) -> Word64
        effects: [deterministic]
    {
        self.framebuffer_addr
    }

    pub fn pitch(self) -> Word32
        effects: [deterministic]
    {
        self.framebuffer_pitch
    }

    pub fn width(self) -> Word32
        effects: [deterministic]
    {
        self.framebuffer_width
    }

    pub fn height(self) -> Word32
        effects: [deterministic]
    {
        self.framebuffer_height
    }

    pub fn bpp(self) -> u8
        effects: [deterministic]
    {
        self.framebuffer_bpp
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Memory Map Tag
// ──────────────────────────────────────────────

pub type MultiBoot2MMapTag : struct {
    tag: MultiBoot2Tag,
    entry_size: Word32,
    entry_version: Word32,
}

impl MultiBoot2MMapTag {
    pub fn new() -> MultiBoot2MMapTag
        effects: [deterministic]
    {
        MultiBoot2MMapTag {
            tag: MultiBoot2Tag::new(),
            entry_size: 0,
            entry_version: 0,
        }
    }

    pub fn entry_count(self, total_size: Word32) -> Word32
        effects: [deterministic]
    {
        let header_size: Word32 = 16
        if total_size <= header_size {
            return 0
        }
        if self.entry_size == 0 {
            return 0
        }
        (total_size - header_size) / self.entry_size
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Memory Map Entry
// ──────────────────────────────────────────────

pub type MultiBoot2MMapEntry : struct {
    entry_size: Word32,
    base_addr: Word64,
    length: Word64,
    entry_type: Word32,
    reserved: Word32,
}

impl MultiBoot2MMapEntry {
    pub fn new() -> MultiBoot2MMapEntry
        effects: [deterministic]
    {
        MultiBoot2MMapEntry {
            entry_size: 0,
            base_addr: Word64::zero(),
            length: Word64::zero(),
            entry_type: 0,
            reserved: 0,
        }
    }

    pub fn is_available(self) -> bool
        effects: [deterministic]
    {
        self.entry_type == MULTIBOOT_MEMORY_AVAILABLE
    }
}

// ──────────────────────────────────────────────
// Multiboot v2 Module Tag
// ──────────────────────────────────────────────

pub type MultiBoot2Module : struct {
    tag: MultiBoot2Tag,
    mod_start: Word32,
    mod_end: Word32,
    cmdline_offset: FixedString[MAX_MODULE_CMDLINE],
}

impl MultiBoot2Module {
    pub fn new() -> MultiBoot2Module
        effects: [deterministic]
    {
        MultiBoot2Module {
            tag: MultiBoot2Tag::new(),
            mod_start: 0,
            mod_end: 0,
            cmdline_offset: FixedString::new(),
        }
    }

    pub fn start_addr(self) -> Word32
        effects: [deterministic]
    {
        self.mod_start
    }

    pub fn end_addr(self) -> Word32
        effects: [deterministic]
    {
        self.mod_end
    }

    pub fn size(self) -> Word32
        effects: [deterministic]
    {
        if self.mod_end > self.mod_start {
            self.mod_end - self.mod_start
        } else {
            0
        }
    }

    pub fn cmdline(self) -> FixedString[MAX_MODULE_CMDLINE]
        effects: [deterministic]
    {
        self.cmdline_offset
    }
}

