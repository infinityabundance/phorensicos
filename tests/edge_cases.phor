// Section 10: Package Seal with Missing Optional Fields (Lines 1261–1400)
// ============================================================================

struct PackageSealState {
    has_source_evidence: bool,
    has_build_evidence: bool,
    has_binary_evidence: bool,
    has_signatures: bool,
    has_court_evidence: bool,
    has_replay_evidence: bool,
    has_expansion_receipts: bool,
    seal_valid: bool,
    missing_fields: Array(Str(32), 8),
    missing_count: u32,
}

fn test_package_seal_missing_court_evidence() -> void
    effect [io:write, residual]
{
    // Court evidence is optional — seal should still be valid
    let mut pkg: PackageSealState = PackageSealState{
        has_source_evidence: true,
        has_build_evidence: true,
        has_binary_evidence: true,
        has_signatures: true,
        has_court_evidence: false,
        has_replay_evidence: true,
        has_expansion_receipts: true,
        seal_valid: false,
        missing_fields: Array::splat(Str::from("")),
        missing_count: 0,
    };

    // Determine seal validity: court evidence is optional
    let has_required: bool = pkg.has_source_evidence
                          && pkg.has_build_evidence
                          && pkg.has_binary_evidence
                          && pkg.has_signatures;
    pkg.seal_valid = has_required;

    assert(pkg.seal_valid, "edge: seal valid without court evidence (optional)");

    residual emit {
        op: "edge.pkg_missing_court",
        seal_valid: if pkg.seal_valid { 1 } else { 0 },
        missing_court: if !pkg.has_court_evidence { 1 } else { 0 },
    };
}

fn test_package_seal_missing_replay_evidence() -> void
    effect [io:write, residual]
{
    // Replay evidence is optional — seal should still be valid
    let mut pkg: PackageSealState = PackageSealState{
        has_source_evidence: true,
        has_build_evidence: true,
        has_binary_evidence: true,
        has_signatures: true,
        has_court_evidence: true,
        has_replay_evidence: false,
        has_expansion_receipts: true,
        seal_valid: false,
        missing_fields: Array::splat(Str::from("")),
        missing_count: 0,
    };

    let has_required: bool = pkg.has_source_evidence
                          && pkg.has_build_evidence
                          && pkg.has_binary_evidence
                          && pkg.has_signatures;
    pkg.seal_valid = has_required;

    assert(pkg.seal_valid, "edge: seal valid without replay evidence (optional)");

    residual emit {
        op: "edge.pkg_missing_replay",
        seal_valid: if pkg.seal_valid { 1 } else { 0 },
    };
}

fn test_package_seal_missing_source_evidence() -> void
    effect [io:write, residual]
{
    // Source evidence is REQUIRED — seal must be invalid
    let mut pkg: PackageSealState = PackageSealState{
        has_source_evidence: false,
        has_build_evidence: true,
        has_binary_evidence: true,
        has_signatures: true,
        has_court_evidence: true,
        has_replay_evidence: true,
        has_expansion_receipts: true,
        seal_valid: true,
        missing_fields: Array::splat(Str::from("")),
        missing_count: 0,
    };

    // Source-seal rule: no source → invalid
    let has_required: bool = pkg.has_source_evidence
                          && pkg.has_build_evidence
                          && pkg.has_binary_evidence
                          && pkg.has_signatures;
    pkg.seal_valid = has_required;

    assert(!pkg.seal_valid, "edge: seal invalid without source evidence (required)");

    pkg.missing_fields[0] = Str::from("source_evidence");
    pkg.missing_count = 1;

    residual emit {
        op: "edge.pkg_missing_source",
        seal_valid: if pkg.seal_valid { 1 } else { 0 },
        missing_count: pkg.missing_count,
    };
}

fn test_package_seal_missing_multiple_optional() -> void
    effect [io:write, residual]
{
    // Multiple optional fields missing: should still seal
    let mut pkg: PackageSealState = PackageSealState{
        has_source_evidence: true,
        has_build_evidence: true,
        has_binary_evidence: true,
