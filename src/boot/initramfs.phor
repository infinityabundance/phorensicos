    }
}

fn extract_symlink(path: FixedString[512], target_data: FixedArray[MAX_FILE_DATA_LEN, u8], size: u32) -> Result<(), BootError>
    effects: [io:write, deterministic]
{
    trusted "initramfs: Create symbolic link in early filesystem"
    {
        Result::Ok(())
    }
}

fn extract_device_node(path: FixedString[512], mode: Word32, major: Word32, minor: Word32) -> Result<(), BootError>
    effects: [io:write, deterministic]
{
