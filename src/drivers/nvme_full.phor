// ─────────────────────────────────────────────────────────────
// Admin: Format NVM
// ─────────────────────────────────────────────────────────────

fn nvme_full_format_nvm(
    controller: Handle(NvmeFullController),
    nsid: u32,
    lbaf: u8,
    ses: u8,
    pi: u8,
    pil: u8,
    ms_et: u8,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_format_nvm:v1"
{
    if !cap.can_format {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let cdw10: u32 = (lbaf as u32) | ((ses as u32) << 9) | ((pi as u32) << 13) | ((pil as u32) << 16) | ((ms_et as u32) << 17);
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::FormatNvm as u32),
        nsid: nsid,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: 0, data_ptr2: 0,
        cdw10: cdw10,
        cdw11: 0, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.format_nvm",
                nsid: nsid as u64,
                lbaf: lbaf as u64,
                ses: ses as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Admin: Firmware Image Download
// ─────────────────────────────────────────────────────────────

fn nvme_full_fw_download(
    controller: Handle(NvmeFullController),
    data_buffer: u64,
    data_size: u32,
    offset: u32,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_fw_download:v1"
{
    if !cap.can_fw_download {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::FirmwareImageDownload as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: data_buffer,
        data_ptr2: 0,
        cdw10: (data_size >> 2) & 0xFFFFFFFF,
        cdw11: offset,
        cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.fw_download",
                data_size: data_size as u64,
                offset: offset as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Admin: Firmware Activate
// ─────────────────────────────────────────────────────────────

fn nvme_full_fw_activate(
    controller: Handle(NvmeFullController),
    fs: u8,
    slot: u8,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_fw_activate:v1"
{
    if !cap.can_fw_activate {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let cdw10: u32 = (fs as u32) | ((slot as u32) << 3);
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::FirmwareActivate as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: 0, data_ptr2: 0,
        cdw10: cdw10,
        cdw11: 0, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.fw_activate",
                fs: fs as u64,
                slot: slot as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

