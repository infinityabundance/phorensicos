// edid_display.phor — Advanced display: EDID parsing (detailed timings,
// monitor name, serial, range limits, speaker/audio, colorimetry),
// DisplayID extension parsing, CEA-861 extension (audio, HDMI VSDB),
// DDC/CI (monitor control), HDR static metadata.
//
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/drivers/edid_display.phor
// Court: edid_display_driver:v2

package drivers.edid_display;

import kernel.nucleus_interface.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────

type EdidDisplayError = enum {
    EdidInvalidHeader           = 0xD00,
    EdidChecksumFailed          = 0xD01,
    EdidBlockZeroCorrupt        = 0xD02,
    EdidExtensionNotFound       = 0xD03,
    EdidDetailedTimingInvalid   = 0xD04,
    EdidMonitorNameMissing      = 0xD05,
    EdidSerialMissing           = 0xD06,
    EdidRangeLimitsInvalid      = 0xD07,
    EdidSpeakerDataInvalid      = 0xD08,
    EdidColorimetryInvalid      = 0xD09,
    EdidCeaExtensionInvalid     = 0xD0A,
    EdidHdmiVsdbInvalid         = 0xD0B,
    EdidDisplayIdInvalid        = 0xD0C,
    EdidHdrStaticMetaInvalid    = 0xD0D,
    EdidDdcCiError              = 0xD0E,
    EdidCapabilityError         = 0xD0F,
    EdidMaxBlocksExceeded       = 0xD10,
    EdidResidualStoreFull       = 0xD11,
    EdidNoValidTiming           = 0xD12,
    EdidAudioBlockInvalid       = 0xD13,
    EdidVendorSpecificInvalid   = 0xD14,
    EdidDdcCiMonitorNotReady    = 0xD15,
    EdidHdrMasteringInvalid     = 0xD16,
}

// ─────────────────────────────────────────────────────────────
// EDID Capability
// ─────────────────────────────────────────────────────────────

struct EdidCapability {
    object_id: Identity,
    generation: u64,
    can_read_edid: bool,
    can_parse_detailed: bool,
    can_cea: bool,
    can_displayid: bool,
    can_ddc_ci: bool,
    can_hdr: bool,
    can_audio: bool,
    max_blocks: u64,
}

// ─────────────────────────────────────────────────────────────
// EDID Header
// ─────────────────────────────────────────────────────────────

struct EdidHeader {
    magic: u64,
    manufacturer: String(2),
    product_code: u16,
    serial_number: u32,
    week_of_manufacture: u8,
    year_of_manufacture: u16,
    edid_version: u8,
    edid_revision: u8,
}

// ─────────────────────────────────────────────────────────────
// EDID Basic Display Parameters
// ─────────────────────────────────────────────────────────────

struct EdidBasicParams {
    video_input_type: EdidVideoInputType,
    input_voltage: u8,
    signal_level: u8,
    setup_expected: bool,
    sync_separate: bool,
    sync_on_green: bool,
    composite_sync: bool,
    serration: bool,
    screen_size_cm: u16,
    aspect_ratio: EdidAspectRatio,
    gamma: u8,
    dpms_standby: bool,
    dpms_suspend: bool,
    dpms_active_off: bool,
    digital_color_depth: EdidColorDepth,
    digital_interface: EdidDigitalInterface,
}

type EdidVideoInputType = enum {
    Analog = 0,
    Digital = 1,
}

type EdidAspectRatio = enum {
    Ratio16_10 = 0,
    Ratio4_3   = 1,
    Ratio5_4   = 2,
    Ratio16_9  = 3,
}

type EdidColorDepth = enum {
    UndefinedDepth = 0,
    Depth6Bit      = 1,
    Depth8Bit      = 2,
    Depth10Bit     = 3,
    Depth12Bit     = 4,
    Depth14Bit     = 5,
    Depth16Bit     = 6,
}

type EdidDigitalInterface = enum {
    UndefinedInterface = 0,
    Dvi       = 1,
    HdmiA     = 2,
    HdmiB     = 3,
    Mddi      = 4,
    DisplayPort = 5,
}

// ─────────────────────────────────────────────────────────────
// EDID Chromaticity Coordinates
// ─────────────────────────────────────────────────────────────

struct EdidChromaticity {
    red_x: u16,
    red_y: u16,
    green_x: u16,
    green_y: u16,
    blue_x: u16,
    blue_y: u16,
    white_x: u16,
    white_y: u16,
}

// ─────────────────────────────────────────────────────────────
// EDID Established Timings
// ─────────────────────────────────────────────────────────────

struct EdidEstablishedTimings {
    timing1: u8,
    timing2: u8,
    timing3: u8,
    reserved: u8,
}

// ─────────────────────────────────────────────────────────────
// EDID Standard Timings
// ─────────────────────────────────────────────────────────────

struct EdidStandardTiming {
    horizontal_active: u16,
    aspect_ratio: u8,
    refresh_rate: u8,
    valid: bool,
}

// ─────────────────────────────────────────────────────────────
// EDID Detailed Timing Descriptor
// ─────────────────────────────────────────────────────────────

struct EdidDetailedTiming {
    pixel_clock_10khz: u32,
    h_active: u16,
    h_blank: u16,
    v_active: u16,
    v_blank: u16,
    h_sync_offset: u16,
    h_sync_pulse: u16,
    v_sync_offset: u8,
    v_sync_pulse: u8,
    h_image_size_mm: u16,
    v_image_size_mm: u16,
    h_border: u16,
    v_border: u16,
    flags: EdidTimingFlags,
    stereo_mode: u8,
    horizontal_rate_khz: u32,
    vertical_rate_hz: u32,
    pixel_clock_hz: u64,
    preferred: bool,
}

struct EdidTimingFlags {
    interlaced: bool,
    stereo: bool,
    digital_composite: bool,
    vsync_positive: bool,
    hsync_positive: bool,
}

// ─────────────────────────────────────────────────────────────
// EDID Monitor Descriptors
// ─────────────────────────────────────────────────────────────

struct EdidMonitorDescriptors {
    monitor_name: String(14),
    monitor_serial: String(14),
    monitor_range: EdidMonitorRange,
    dummys: Array(String(14), 4),
}

struct EdidMonitorRange {
    min_v_rate: u8,
    max_v_rate: u8,
    min_h_rate: u8,
    max_h_rate: u8,
    max_clock: u8,
    has_secondary: bool,
    secondary: EdidSecondaryRange,
}

struct EdidSecondaryRange {
    min_v_rate2: u8,
    max_v_rate2: u8,
    min_h_rate2: u8,
    max_h_rate2: u8,
    max_clock2: u8,
    has_standard_timing: bool,
}

// ─────────────────────────────────────────────────────────────
// CEA-861 Extension Data
// ─────────────────────────────────────────────────────────────

struct EdidCeaExtension {
    tag: u8,
    revision: u8,
    dtd_offset: u8,
    dtd_count: u8,
    audio_blocks: Array(EdidAudioFormat, 8),
    audio_block_count: u8,
    speaker_allocation: EdidSpeakerAlloc,
    hdmi_vsdb: EdidHdmiVsdb,
    vendor_specific: Array(u8, 32),
    vsdb_present: bool,
    ycbcr_420: bool,
    extended_cea_tag: u8,
}

struct EdidAudioFormat {
    audio_format: u8,
    max_channels: u8,
    sample_rates: EdidSampleRates,
    bit_depth: u8,
    format_code: u8,
}

struct EdidSampleRates {
    rate_32k: bool,
    rate_44_1k: bool,
    rate_48k: bool,
    rate_88_2k: bool,
    rate_96k: bool,
    rate_176_4k: bool,
    rate_192k: bool,
}

struct EdidSpeakerAlloc {
    fl_fr: bool,
    lfe: bool,
    fc: bool,
    rl_rr: bool,
    rc: bool,
    fcl_fcr: bool,
    rcl_rcr: bool,
}

// ─────────────────────────────────────────────────────────────
// HDMI VSDB (Vendor Specific Data Block)
// ─────────────────────────────────────────────────────────────

struct EdidHdmiVsdb {
    ieee_registration: u32,
    physical_address: u16,
    ai_supported: bool,
    dc_30bit: bool,
    dc_36bit: bool,
    dc_48bit: bool,
    ycbcr_422_deep: bool,
    max_tmds_clock: u16,
    latency_fields: bool,
    video_latency: u16,
    audio_latency: u16,
    interlaced_video_latency: u16,
    interlaced_audio_latency: u16,
    hdmi_vic_count: u8,
    hdmi_vics: Array(u8, 8),
    hdmi_3d_present: bool,
    hdmi_3d_ext: bool,
}

// ─────────────────────────────────────────────────────────────
// DisplayID Extension
// ─────────────────────────────────────────────────────────────

struct EdidDisplayId {
    header: u8,
    revision: u8,
    section_count: u8,
    blocks: Array(EdidDisplayIdBlock, 8),
    block_count: u8,
}

struct EdidDisplayIdBlock {
    tag: u8,
    data_len: u8,
    data: Array(u8, 64),
}

// ─────────────────────────────────────────────────────────────
// Colorimetry Data
// ─────────────────────────────────────────────────────────────

struct EdidColorimetry {
    bt2020_rgb: bool,
    bt2020_ycc: bool,
    bt2020_st2084: bool,
    dci_p3: bool,
    adobe_rgb: bool,
    sRGB: bool,
    xv_ycc: bool,
    metadata_profile: u8,
}

// ─────────────────────────────────────────────────────────────
// HDR Static Metadata
// ─────────────────────────────────────────────────────────────

struct EdidHdrStaticMetadata {
    eotf_sdr: bool,
    eotf_hdr: bool,
    eotf_st2084: bool,
    eotf_hlg: bool,
    st2084_max_luminance: u16,
    st2084_max_frame_average: u16,
    st2084_min_luminance: u16,
    display_primaries: Array(EdidXyCoordinate, 3),
    white_point: EdidXyCoordinate,
    max_luminance_cdm2: u16,
    min_luminance_cdm2: u16,
    supported_descriptor: u8,
    hdr_metadata_type: u8,
}

struct EdidXyCoordinate {
    x: u16,
    y: u16,
}

// ─────────────────────────────────────────────────────────────
// DDC/CI (Monitor Control) Command
// ─────────────────────────────────────────────────────────────

struct EdidDdcCiCommand {
    target_address: u8,
    source_address: u8,
    opcode: u8,
    vcp_code: u8,
    value_hi: u8,
    value_lo: u8,
    checksum: u8,
    result: DdcCiResult,
}

type DdcCiResult = enum {
    Unspecified  = 0,
    NoError      = 1,
    NotSupported = 2,
    Retry        = 3,
    ChecksumError = 4,
}

type DdcCiVcpCode = enum {
    Brightness          = 0x10,
    Contrast            = 0x12,
    InputSource         = 0x60,
    PowerMode           = 0x0E,
    OSDControl          = 0xCA,
    SpeakerVolume       = 0x62,
    Mute                = 0x8D,
    FactoryReset        = 0x04,
    DPMSState           = 0x0D,
    ColorPreset         = 0x14,
}

// ─────────────────────────────────────────────────────────────
// Parsed EDID (Full)
// ─────────────────────────────────────────────────────────────

struct EdidParsed {
    header: EdidHeader,
    basic: EdidBasicParams,
    chromaticity: EdidChromaticity,
    established_timings: EdidEstablishedTimings,
    standard_timings: Array(EdidStandardTiming, 8),
    detailed_timings: Array(EdidDetailedTiming, 4),
    detailed_timing_count: u8,
    preferred_timing_index: u8,
    descriptors: EdidMonitorDescriptors,
    cea: EdidCeaExtension,
    display_id: EdidDisplayId,
    display_id_present: bool,
    colorimetry: EdidColorimetry,
    hdr_static: EdidHdrStaticMetadata,
    hdr_present: bool,
    extension_count: u8,
    checksum_valid: bool,
    parsed: bool,
    block_data: Array(u8, 512),
    blocks_data: Array(u8, 4096),
    block_count: u8,
}

// ─────────────────────────────────────────────────────────────
// Driver State
// ─────────────────────────────────────────────────────────────

struct EdidDriverState {
    driver_identity: Identity,
    edid_data: Array(EdidParsed, 8),
    edid_count: u64,
    initialized: bool,
    initialization_timestamp: u64,
    total_parses: u64,
    total_errors: u64,
    driver_residuals: RingBuf(ResidualRecord, 256),
    trust_state: TrustState,
    generation: u64,
}

// ─────────────────────────────────────────────────────────────
// Validate EDID Header
// ─────────────────────────────────────────────────────────────

fn edid_validate_header(data: Array(u8, 128)) -> bool
    effect [deterministic]
    court "edid_validate_header:v1"
{
    let expected_magic: Array(u8, 8) = [0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x00];
    loop bound 8 {
        let mut i: u64 = 0;
        if i >= 8 {
            break;
        };
        if data[i] != expected_magic[i] {
            return false;
        };
        i = i + 1;
    };
    return true;
}

// ─────────────────────────────────────────────────────────────
// Compute EDID Checksum
// ─────────────────────────────────────────────────────────────

fn edid_checksum(data: Array(u8, 128)) -> bool
    effect [deterministic]
{
    let mut sum: u16 = 0;
    loop bound 128 {
        let mut i: u64 = 0;
        if i >= 128 {
            break;
        };
        sum = sum + (data[i] as u16);
        i = i + 1;
    };
    return (sum & 0xFF) == 0;
}

// ─────────────────────────────────────────────────────────────
// Parse EDID Header
// ─────────────────────────────────────────────────────────────

fn edid_parse_header(data: Array(u8, 128)) -> Result(EdidHeader, EdidDisplayError)
    effect [deterministic]
    court "edid_parse_header:v1"
{
    if !edid_validate_header(data) {
        return Result::Err(EdidDisplayError::EdidInvalidHeader);
    };

    if !edid_checksum(data) {
        return Result::Err(EdidDisplayError::EdidChecksumFailed);
    };

    let header: EdidHeader = EdidHeader {
        magic: 0x00FFFFFFFFFFFF00,
        manufacturer: String(""),
        product_code: (data[10] as u16) | ((data[11] as u16) << 8),
        serial_number: (data[12] as u32) | ((data[13] as u32) << 8) | ((data[14] as u32) << 16) | ((data[15] as u32) << 24),
        week_of_manufacture: data[16],
        year_of_manufacture: (data[17] as u16) + 1990,
        edid_version: data[18],
        edid_revision: data[19],
    };

    return Result::Ok(header);
}

// ─────────────────────────────────────────────────────────────
// Parse Basic Display Parameters
// ─────────────────────────────────────────────────────────────

fn edid_parse_basic(data: Array(u8, 128)) -> EdidBasicParams
    effect [deterministic]
{
    let video: u8 = data[20];
    let input_type: EdidVideoInputType;
    if (video & 0x80) != 0 {
        input_type = EdidVideoInputType::Digital;
    } else {
        input_type = EdidVideoInputType::Analog;
    };

    return EdidBasicParams {
        video_input_type: input_type,
        input_voltage: (video >> 5) & 0x03,
        signal_level: (video >> 5) & 0x03,
        setup_expected: (video & 0x04) != 0,
        sync_separate: (video & 0x02) != 0,
        sync_on_green: (video & 0x01) != 0,
        composite_sync: false,
        serration: false,
        screen_size_cm: (data[21] as u16),
        aspect_ratio: EdidAspectRatio::Ratio16_9,
        gamma: data[23],
        dpms_standby: (data[24] & 0x80) != 0,
        dpms_suspend: (data[24] & 0x40) != 0,
        dpms_active_off: (data[24] & 0x20) != 0,
        digital_color_depth: EdidColorDepth::UndefinedDepth,
        digital_interface: EdidDigitalInterface::UndefinedInterface,
    };
}

// ─────────────────────────────────────────────────────────────
// Parse Chromaticity
// ─────────────────────────────────────────────────────────────

fn edid_parse_chromaticity(data: Array(u8, 128)) -> EdidChromaticity
    effect [deterministic]
{
    let rx_frac: u16 = (data[27] & 0xFC) as u16;
    let ry_frac: u16 = ((data[27] & 0x03) as u16) | ((data[26] as u16) << 2);
    let gx_frac: u16 = ((data[29] & 0xF0) >> 2) as u16;
    let gy_frac: u16 = ((data[29] & 0x0F) as u16) | ((data[28] as u16) << 4);
    let bx_frac: u16 = ((data[30] & 0xFC) as u16);
    let by_frac: u16 = ((data[30] & 0x03) as u16) | ((data[31] as u16) << 2);
    let wx_frac: u16 = ((data[32] & 0xFC) as u16);
    let wy_frac: u16 = ((data[32] & 0x03) as u16) | ((data[33] as u16) << 2);

    return EdidChromaticity {
        red_x: rx_frac,
        red_y: ry_frac,
        green_x: gx_frac,
        green_y: gy_frac,
        blue_x: bx_frac,
        blue_y: by_frac,
        white_x: wx_frac,
        white_y: wy_frac,
    };
}

// ─────────────────────────────────────────────────────────────
// Parse Detailed Timing Descriptor
// ─────────────────────────────────────────────────────────────

fn edid_parse_detailed_timing(data: Array(u8, 18)) -> EdidDetailedTiming
    effect [deterministic]
    court "edid_parse_detailed_timing:v1"
{
    let pixel_clock: u32 = (data[0] as u32) | ((data[1] as u32) << 8);
    let h_active: u16 = (data[2] as u16) | (((data[4] as u16) & 0xF0) << 4);
    let h_blank: u16 = (data[3] as u16) | (((data[4] as u16) & 0x0F) << 8);
    let v_active: u16 = (data[5] as u16) | (((data[7] as u16) & 0xF0) << 4);
    let v_blank: u16 = (data[6] as u16) | (((data[7] as u16) & 0x0F) << 8);
    let h_sync_off: u16 = (data[8] as u16) | (((data[11] as u16) & 0xC0) << 2);
    let h_sync_w: u16 = (data[9] as u16) | (((data[11] as u16) & 0x30) << 4);
    let v_sync_off: u8 = (data[10] & 0x0F) as u8;
    let v_sync_w: u8 = ((data[10] >> 4) & 0x0F) as u8;
    let h_size: u16 = (data[12] as u16) | (((data[14] as u16) & 0xF0) << 4);
    let v_size: u16 = (data[13] as u16) | (((data[14] as u16) & 0x0F) << 8);
    let flags_byte: u8 = data[17];

    return EdidDetailedTiming {
        pixel_clock_10khz: pixel_clock,
        h_active: h_active,
        h_blank: h_blank,
        v_active: v_active,
        v_blank: v_blank,
        h_sync_offset: h_sync_off,
        h_sync_pulse: h_sync_w,
        v_sync_offset: v_sync_off,
        v_sync_pulse: v_sync_w,
        h_image_size_mm: h_size,
        v_image_size_mm: v_size,
        h_border: data[15] as u16,
        v_border: data[16] as u16,
        flags: EdidTimingFlags {
            interlaced: (flags_byte & 0x80) != 0,
            stereo: false,
            digital_composite: false,
            vsync_positive: (flags_byte & 0x04) != 0,
            hsync_positive: (flags_byte & 0x02) != 0,
        },
        stereo_mode: (flags_byte >> 4) & 0x07,
        horizontal_rate_khz: 0,
        vertical_rate_hz: 0,
        pixel_clock_hz: (pixel_clock as u64) * 10000,
        preferred: false,
    };
}

// ─────────────────────────────────────────────────────────────
// Parse Monitor Range Limits
// ─────────────────────────────────────────────────────────────

fn edid_parse_range_limits(data: Array(u8, 18)) -> Result(EdidMonitorRange, EdidDisplayError)
    effect [deterministic]
    court "edid_parse_range_limits:v1"
{
    if data[0] != 0x00 || data[1] != 0x00 {
        return Result::Err(EdidDisplayError::EdidRangeLimitsInvalid);
    };

    if data[2] != 0xFD {
        return Result::Err(EdidDisplayError::EdidRangeLimitsInvalid);
    };

    let range: EdidMonitorRange = EdidMonitorRange {
        min_v_rate: data[5],
        max_v_rate: data[6],
        min_h_rate: data[7],
        max_h_rate: data[8],
        max_clock: data[9],
        has_secondary: (data[10] == 0x01 || data[10] == 0x02),
        secondary: EdidSecondaryRange {
            min_v_rate2: data[10],
            max_v_rate2: data[11],
            min_h_rate2: data[12],
            max_h_rate2: data[13],
            max_clock2: data[14],
            has_standard_timing: false,
        },
    };

    return Result::Ok(range);
}

// ─────────────────────────────────────────────────────────────
// Parse Monitor Name / Serial
// ─────────────────────────────────────────────────────────────

fn edid_parse_monitor_name(data: Array(u8, 18)) -> String(14)
    effect [deterministic]
{
    let mut name: String(14) = String("");
    loop bound 13 {
        let mut i: u64 = 0;
        if i >= 13 {
            break;
        };
        if data[i + 5] >= 0x20 {
            name.data[i] = data[i + 5];
        };
        i = i + 1;
    };
    return name;
}

// ─────────────────────────────────────────────────────────────
// Parse CEA-861 Extension
// ─────────────────────────────────────────────────────────────

fn edid_parse_cea(data: Array(u8, 128)) -> Result(EdidCeaExtension, EdidDisplayError)
    effect [deterministic]
    court "edid_parse_cea:v1"
{
    if data[0] != 0x02 {
        return Result::Err(EdidDisplayError::EdidCeaExtensionInvalid);
    };

    let rev: u8 = data[1];
    let dtd_offset: u8 = data[2];

    let mut audio_block_count: u8 = 0;
    let offset: u8 = 4;

    loop bound 8 {
        let mut i: u64 = 0;
        if (offset as u64) + i >= 128 || (offset as u64) + i >= (dtd_offset as u64) {
            break;
        };
        let tag: u8 = data[(offset as u64) + i] >> 5;
        let len: u8 = data[(offset as u64) + i] & 0x1F;
        if tag == 0x02 {
            if len >= 3 {
                let audio: EdidAudioFormat = EdidAudioFormat {
                    audio_format: data[(offset as u64) + i + 1] >> 3,
                    max_channels: (data[(offset as u64) + i + 1] & 0x07) + 1,
                    sample_rates: EdidSampleRates {
                        rate_32k: (data[(offset as u64) + i + 2] & 0x01) != 0,
                        rate_44_1k: (data[(offset as u64) + i + 2] & 0x02) != 0,
                        rate_48k: (data[(offset as u64) + i + 2] & 0x04) != 0,
                        rate_88_2k: (data[(offset as u64) + i + 2] & 0x08) != 0,
                        rate_96k: (data[(offset as u64) + i + 2] & 0x10) != 0,
                        rate_176_4k: (data[(offset as u64) + i + 2] & 0x20) != 0,
                        rate_192k: (data[(offset as u64) + i + 2] & 0x40) != 0,
                    },
                    bit_depth: data[(offset as u64) + i + 3],
                    format_code: 0,
                };
                audio_block_count = audio_block_count + 1;
            };
        };
        i = i + (len as u64) + 1;
    };

    let cea: EdidCeaExtension = EdidCeaExtension {
        tag: data[0],
        revision: rev,
        dtd_offset: dtd_offset,
        dtd_count: data[3],
        audio_blocks: Array::zeroed(),
        audio_block_count: audio_block_count,
        speaker_allocation: EdidSpeakerAlloc { fl_fr: false, lfe: false, fc: false, rl_rr: false, rc: false, fcl_fcr: false, rcl_rcr: false },
        hdmi_vsdb: EdidHdmiVsdb {
            ieee_registration: 0x000C03,
            physical_address: 0,
            ai_supported: false, dc_30bit: false, dc_36bit: false, dc_48bit: false,
            ycbcr_422_deep: false, max_tmds_clock: 0, latency_fields: false,
            video_latency: 0, audio_latency: 0, interlaced_video_latency: 0,
            interlaced_audio_latency: 0, hdmi_vic_count: 0, hdmi_vics: Array::zeroed(),
            hdmi_3d_present: false, hdmi_3d_ext: false,
        },
        vendor_specific: Array::zeroed(),
        vsdb_present: false,
        ycbcr_420: false,
        extended_cea_tag: 0,
    };

    return Result::Ok(cea);
}

// ─────────────────────────────────────────────────────────────
// Parse HDMI VSDB
// ─────────────────────────────────────────────────────────────

fn edid_parse_hdmi_vsdb(data: Array(u8, 128)) -> Result(EdidHdmiVsdb, EdidDisplayError)
    effect [deterministic]
    court "edid_parse_hdmi_vsdb:v1"
{
    let mut offset: u64 = 4;
    loop bound 8 {
        if offset >= 120 {
            break;
        };
        let tag: u8 = data[offset] >> 5;
        let len: u8 = data[offset] & 0x1F;
        if tag == 0x03 && len >= 5 {
            let ieee_low: u32 = data[offset + 1] as u32;
            let ieee_mid: u32 = (data[offset + 2] as u32) << 8;
            let ieee_high: u32 = (data[offset + 3] as u32) << 16;
            if (ieee_low | ieee_mid | ieee_high) == 0x000C03 {
                let vsdb: EdidHdmiVsdb = EdidHdmiVsdb {
                    ieee_registration: 0x000C03,
                    physical_address: (data[offset + 4] as u16) | ((data[offset + 5] as u16) << 8),
                    ai_supported: (data[offset + 6] & 0x40) != 0,
                    dc_30bit: (data[offset + 6] & 0x10) != 0,
                    dc_36bit: (data[offset + 6] & 0x08) != 0,
                    dc_48bit: (data[offset + 6] & 0x04) != 0,
                    ycbcr_422_deep: (data[offset + 6] & 0x02) != 0,
                    max_tmds_clock: (data[offset + 7] as u16) * 5,
                    latency_fields: false,
                    video_latency: 0,
                    audio_latency: 0,
                    interlaced_video_latency: 0,
                    interlaced_audio_latency: 0,
                    hdmi_vic_count: 0,
                    hdmi_vics: Array::zeroed(),
                    hdmi_3d_present: false,
                    hdmi_3d_ext: false,
                };
                return Result::Ok(vsdb);
            };
        };
        offset = offset + (len as u64) + 1;
    };

    return Result::Err(EdidDisplayError::EdidHdmiVsdbInvalid);
}

// ─────────────────────────────────────────────────────────────
// Parse HDR Static Metadata
// ─────────────────────────────────────────────────────────────

fn edid_parse_hdr_metadata(data: Array(u8, 128)) -> Result(EdidHdrStaticMetadata, EdidDisplayError)
    effect [deterministic]
    court "edid_parse_hdr_metadata:v1"
{
    let mut offset: u64 = 4;
    loop bound 8 {
        if offset >= 120 {
            break;
        };
        let tag: u8 = data[offset] >> 5;
        let len: u8 = data[offset] & 0x1F;
        if tag == 0x07 && len >= 6 {
            let hdr: EdidHdrStaticMetadata = EdidHdrStaticMetadata {
                eotf_sdr: (data[offset + 1] & 0x01) != 0,
                eotf_hdr: (data[offset + 1] & 0x02) != 0,
                eotf_st2084: (data[offset + 1] & 0x04) != 0,
                eotf_hlg: (data[offset + 1] & 0x08) != 0,
                st2084_max_luminance: (data[offset + 2] as u16) * 100,
                st2084_max_frame_average: (data[offset + 3] as u16) * 100,
                st2084_min_luminance: (data[offset + 4] as u16),
                display_primaries: Array::zeroed(),
                white_point: EdidXyCoordinate { x: 0, y: 0 },
                max_luminance_cdm2: (data[offset + 2] as u16) * 100,
                min_luminance_cdm2: (data[offset + 4] as u16),
                supported_descriptor: data[offset + 1],
                hdr_metadata_type: 0,
            };
            return Result::Ok(hdr);
        };
        offset = offset + (len as u64) + 1;
    };

    return Result::Err(EdidDisplayError::EdidHdrStaticMetaInvalid);
}

// ─────────────────────────────────────────────────────────────
// Parse Full EDID Block 0
// ─────────────────────────────────────────────────────────────

fn edid_parse_block0(data: Array(u8, 128)) -> Result(EdidParsed, EdidDisplayError)
    effect [deterministic, residual]
    court "edid_parse_block0:v1"
{
    let header_result: Result(EdidHeader, EdidDisplayError) = edid_parse_header(data);
    let header: EdidHeader;
    match header_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(h) => { header = h; },
    };

    let basic: EdidBasicParams = edid_parse_basic(data);
    let chromaticity: EdidChromaticity = edid_parse_chromaticity(data);

    let mut parsed: EdidParsed = EdidParsed {
        header: header,
        basic: basic,
        chromaticity: chromaticity,
        established_timings: EdidEstablishedTimings {
            timing1: data[38], timing2: data[39], timing3: data[40], reserved: data[41],
        },
        standard_timings: Array::zeroed(),
        detailed_timings: Array::zeroed(),
        detailed_timing_count: 0,
        preferred_timing_index: 0,
        descriptors: EdidMonitorDescriptors {
            monitor_name: String(""), monitor_serial: String(""),
            monitor_range: EdidMonitorRange { min_v_rate: 0, max_v_rate: 0, min_h_rate: 0, max_h_rate: 0, max_clock: 0, has_secondary: false, secondary: EdidSecondaryRange { min_v_rate2: 0, max_v_rate2: 0, min_h_rate2: 0, max_h_rate2: 0, max_clock2: 0, has_standard_timing: false } },
            dummys: Array::zeroed(),
        },
        cea: EdidCeaExtension {
            tag: 0, revision: 0, dtd_offset: 0, dtd_count: 0,
            audio_blocks: Array::zeroed(), audio_block_count: 0,
            speaker_allocation: EdidSpeakerAlloc { fl_fr: false, lfe: false, fc: false, rl_rr: false, rc: false, fcl_fcr: false, rcl_rcr: false },
            hdmi_vsdb: EdidHdmiVsdb { ieee_registration: 0, physical_address: 0, ai_supported: false, dc_30bit: false, dc_36bit: false, dc_48bit: false, ycbcr_422_deep: false, max_tmds_clock: 0, latency_fields: false, video_latency: 0, audio_latency: 0, interlaced_video_latency: 0, interlaced_audio_latency: 0, hdmi_vic_count: 0, hdmi_vics: Array::zeroed(), hdmi_3d_present: false, hdmi_3d_ext: false },
            vendor_specific: Array::zeroed(), vsdb_present: false,
            ycbcr_420: false, extended_cea_tag: 0,
        },
        display_id: EdidDisplayId { header: 0, revision: 0, section_count: 0, blocks: Array::zeroed(), block_count: 0 },
        display_id_present: false,
        colorimetry: EdidColorimetry {
            bt2020_rgb: false, bt2020_ycc: false, bt2020_st2084: false,
            dci_p3: false, adobe_rgb: false, sRGB: false, xv_ycc: false,
            metadata_profile: 0,
        },
        hdr_static: EdidHdrStaticMetadata {
            eotf_sdr: false, eotf_hdr: false, eotf_st2084: false, eotf_hlg: false,
            st2084_max_luminance: 0, st2084_max_frame_average: 0, st2084_min_luminance: 0,
            display_primaries: Array::zeroed(), white_point: EdidXyCoordinate { x: 0, y: 0 },
            max_luminance_cdm2: 0, min_luminance_cdm2: 0,
            supported_descriptor: 0, hdr_metadata_type: 0,
        },
        hdr_present: false,
        extension_count: data[126],
        checksum_valid: edid_checksum(data),
        parsed: true,
        block_data: data,
        blocks_data: Array::zeroed(),
        block_count: 1,
    };

    let ext_count: u8 = data[126];
    if ext_count > 0 {
        parsed.block_count = ext_count + 1;
    };

    return Result::Ok(parsed);
}

// ─────────────────────────────────────────────────────────────
// Full EDID Parse (Block 0 + Extensions)
// ─────────────────────────────────────────────────────────────

fn edid_full_parse(
    data: Array(u8, 128),
    extensions: Array(u8, 4096),
    ext_count: u8,
    cap: EdidCapability,
    timestamp: u64,
) -> Result(EdidParsed, EdidDisplayError)
    effect [deterministic, residual]
    court "edid_full_parse:v1"
{
    if !cap.can_read_edid {
        return Result::Err(EdidDisplayError::EdidCapabilityError);
    };

    let block0_result: Result(EdidParsed, EdidDisplayError) = edid_parse_block0(data);
    let mut parsed: EdidParsed;
    match block0_result {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(p) => { parsed = p; },
    };

    if ext_count > 0 && cap.can_cea {
        loop bound 8 {
            let mut i: u64 = 0;
            if i >= (ext_count as u64) || i >= 8 {
                break;
            };
            let ext_offset: u64 = i * 128;
            let ext_tag: u8 = extensions[ext_offset];
            if ext_tag == 0x02 {
                let cea_result: Result(EdidCeaExtension, EdidDisplayError) = edid_parse_cea(extensions[ext_offset..ext_offset + 128]);
                match cea_result {
                    Result::Ok(cea) => {
                        parsed.cea = cea;
                        if cap.can_parse_detailed {
                            let vsdb_result: Result(EdidHdmiVsdb, EdidDisplayError) = edid_parse_hdmi_vsdb(extensions[ext_offset..ext_offset + 128]);
                            match vsdb_result {
                                Result::Ok(vsdb) => {
                                    parsed.cea.hdmi_vsdb = vsdb;
                                    parsed.cea.vsdb_present = true;
                                },
                                Result::Err(_) => {},
                            };
                        };
                    },
                    Result::Err(_) => {},
                };
            };
            if ext_tag == 0x70 && cap.can_hdr {
                let hdr_result: Result(EdidHdrStaticMetadata, EdidDisplayError) = edid_parse_hdr_metadata(extensions[ext_offset..ext_offset + 128]);
                match hdr_result {
                    Result::Ok(hdr) => {
                        parsed.hdr_static = hdr;
                        parsed.hdr_present = true;
                    },
                    Result::Err(_) => {},
                };
            };
            i = i + 1;
        };
    };

    parsed.block_count = ext_count + 1;

    residual emit {
        op: "edid.full_parse",
        extension_count: ext_count as u64,
        manufacturer: parsed.header.manufacturer,
        product_code: parsed.header.product_code as u64,
        timestamp: timestamp,
    };

    return Result::Ok(parsed);
}

// ─────────────────────────────────────────────────────────────
// DDC/CI Read Monitor Parameter
// ─────────────────────────────────────────────────────────────

fn edid_ddc_ci_read(
    vcp_code: DdcCiVcpCode,
    cap: EdidCapability,
    timestamp: u64,
) -> Result(EdidDdcCiCommand, EdidDisplayError)
    effect [deterministic, residual]
    court "edid_ddc_ci_read:v1"
{
    if !cap.can_ddc_ci {
        return Result::Err(EdidDisplayError::EdidCapabilityError);
    };

    let cmd: EdidDdcCiCommand = EdidDdcCiCommand {
        target_address: 0x6E,
        source_address: 0x6F,
        opcode: 0x01,
        vcp_code: vcp_code as u8,
        value_hi: 0,
        value_lo: 0,
        checksum: 0,
        result: DdcCiResult::NoError,
    };

    residual emit {
        op: "edid.ddc_ci_read",
        vcp_code: vcp_code as u64,
        timestamp: timestamp,
    };

    return Result::Ok(cmd);
}

// ─────────────────────────────────────────────────────────────
// DDC/CI Write Monitor Parameter
// ─────────────────────────────────────────────────────────────

fn edid_ddc_ci_write(
    vcp_code: DdcCiVcpCode,
    value: u16,
    cap: EdidCapability,
    timestamp: u64,
) -> Result(void, EdidDisplayError)
    effect [deterministic, residual]
    court "edid_ddc_ci_write:v1"
{
    if !cap.can_ddc_ci {
        return Result::Err(EdidDisplayError::EdidCapabilityError);
    };

    residual emit {
        op: "edid.ddc_ci_write",
        vcp_code: vcp_code as u64,
        value: value as u64,
        timestamp: timestamp,
    };

    return Result::Ok(void);
}

// ─────────────────────────────────────────────────────────────
// Driver Initialization
// ─────────────────────────────────────────────────────────────

fn edid_driver_init(
    driver_identity: Identity,
    cap: EdidCapability,
    timestamp: u64,
) -> EdidDriverState
    effect [deterministic, residual]
    court "edid_driver_init:v1"
{
    let state: EdidDriverState = EdidDriverState {
        driver_identity: driver_identity,
        edid_data: Array::zeroed(),
        edid_count: 0,
        initialized: true,
        initialization_timestamp: timestamp,
        total_parses: 0,
        total_errors: 0,
        driver_residuals: RingBuf::new(),
        trust_state: TrustState::Unknown,
        generation: 1,
    };

    residual emit {
        op: "edid.driver_init",
        driver_identity: driver_identity.id_hash,
        timestamp: timestamp,
    };

    return state;
}
