// rtos_tests.phor — Comprehensive RTOS tests
// Tests: RT scheduler, timer precision, IPC bounded delivery,
//        mutex priority inheritance, WCET estimation, schedulability analysis
//
// Expected outcomes:
//   - RT scheduler dispatches tasks by priority with preemption
//   - Timer precision meets required deadline bounds
//   - IPC messages are delivered with bounded latency
//   - Mutex priority inheritance prevents priority inversion
//   - WCET estimation produces safe upper bounds
//   - Schedulability analysis correctly determines feasibility
//   - All operations bounded, effect-declared, and residual-recorded

package "phorensic:rtos_tests:v1.0";

use core::constants::*
use core::types::*
use core::errors::*
use core::collections::*

// ============================================================================
// Constants
// ============================================================================

const MAX_RT_TASKS: u64 = 64;
const MAX_PRIORITY_LEVELS: u64 = 256;
const MAX_IPC_QUEUE: u64 = 32;
const MAX_MUTEXES: u64 = 32;
const MAX_TIMERS: u64 = 64;
const TICK_RATE_HZ: u64 = 1000;
const NS_PER_TICK: u64 = 1000000;
const WCET_SAMPLES: u64 = 100;

// ============================================================================
// Data Structures
// ============================================================================

enum RTTaskState : u8 {
    Suspended = 0,
    Ready     = 1,
    Running   = 2,
    Blocked   = 3,
    Waiting   = 4,
    Terminated = 5,
}

enum RTTaskType : u8 {
    Periodic = 0,
    Sporadic = 1,
    Aperiodic = 2,
    Deadline  = 3,
}

struct RTTask {
    task_id: u64,
    name: Str(32),
    priority: u16,
    state: RTTaskState,
    task_type: RTTaskType,
    period_us: u64,
    deadline_us: u64,
    wcet_us: u64,
    remaining_budget: u64,
    release_time: u64,
    deadline_misses: u64,
    total_executions: u64,
    total_cpu_us: u64,
}

struct RTScheduler {
    tasks: Array(RTTask, 64),
    task_count: u64,
    current_task: u64,
    tick_count: u64,
    preemption_enabled: bool,
    schedule_policy: u8, // 0=FIFO, 1=RR, 2=EDF, 3=RM
}

struct Timer {
    timer_id: u64,
    interval_us: u64,
    remaining_us: u64,
    callback_addr: u64,
    oneshot: bool,
    active: bool,
    expiry_count: u64,
    drift_us: i64,
}

struct TimerManager {
    timers: Array(Timer, 64),
    timer_count: u64,
    tick_resolution_ns: u64,
    max_drift_ns: u64,
}

struct IPCMessage {
    msg_id: u64,
    sender_id: u64,
    receiver_id: u64,
    priority: u8,
    data_len: u64,
    timestamp_send: u64,
    timestamp_recv: u64,
    delivery_latency: u64,
    delivered: bool,
}

struct IPCChannel {
    messages: Array(IPCMessage, 32),
    count: u64,
    max_count: u64,
    bounded: bool,
}

struct Mutex {
    mutex_id: u64,
    owner: u64,
    lock_count: u32,
    ceiling_priority: u16,
    original_priority: u16,
    waiting_tasks: Array(u64, 16),
    wait_count: u64,
    priority_inherited: bool,
    recursive: bool,
}

struct WCETRecord {
    task_id: u64,
    execution_times: Array(u64, 100),
    count: u64,
    min_us: u64,
    max_us: u64,
    avg_us: u64,
    estimated_wcet: u64,
    safety_margin: u64,
}

struct SchedulabilityAnalysis {
    total_utilization: u64, // permille (parts per thousand)
    max_utilization: u64,
    feasible: bool,
    task_count: u64,
    analysis_type: u8, // 0=RM, 1=EDF, 2=DM
    hyperperiod_us: u64,
    deadline_misses: u64,
}

// ============================================================================
// RTOS Error Types
// ============================================================================

type RtosError : u32 = enum {
    TaskLimitReached      = 0x7001,
    InvalidPriority       = 0x7002,
    TimerOverrun          = 0x7003,
    MissedDeadline        = 0x7004,
    IPCBufferFull         = 0x7005,
    IPCBufferEmpty        = 0x7006,
    MutexAlreadyLocked    = 0x7007,
    MutexNotLocked        = 0x7008,
    PriorityInversion     = 0x7009,
    DeadlockDetected      = 0x700A,
    NotSchedulable        = 0x700B,
    WcetOverrun           = 0x700C,
    TimerNotFound         = 0x700D,
}

// ============================================================================
// Test: RT Scheduler
// ============================================================================

fn test_scheduler_priority_dispatch() -> void
    effect [compute, residual]
{
    let mut sched: RTScheduler = RTScheduler{
        tasks: Array::zeroed(),
        task_count: 3,
        current_task: 0,
        tick_count: 0,
        preemption_enabled: true,
        schedule_policy: 0, // FIFO
    };

    // Task 0: priority 10 (low)
    sched.tasks[0] = RTTask{
        task_id: 0, name: Str::from("low"), priority: 10, state: RTTaskState::Ready,
        task_type: RTTaskType::Periodic, period_us: 100000, deadline_us: 100000,
        wcet_us: 10000, remaining_budget: 10000, release_time: 0,
        deadline_misses: 0, total_executions: 0, total_cpu_us: 0,
    };

    // Task 1: priority 50 (medium)
    sched.tasks[1] = RTTask{
        task_id: 1, name: Str::from("medium"), priority: 50, state: RTTaskState::Ready,
        task_type: RTTaskType::Periodic, period_us: 50000, deadline_us: 50000,
        wcet_us: 5000, remaining_budget: 5000, release_time: 0,
        deadline_misses: 0, total_executions: 0, total_cpu_us: 0,
    };

    // Task 2: priority 100 (high)
    sched.tasks[2] = RTTask{
        task_id: 2, name: Str::from("high"), priority: 100, state: RTTaskState::Ready,
        task_type: RTTaskType::Periodic, period_us: 20000, deadline_us: 20000,
        wcet_us: 3000, remaining_budget: 3000, release_time: 0,
        deadline_misses: 0, total_executions: 0, total_cpu_us: 0,
    };

    // Find highest priority ready task
    let mut highest_prio: u16 = 0xFFFF;
    let mut highest_task: u64 = 0;
    for i in 0..sched.task_count {
        if sched.tasks[i].state == RTTaskState::Ready &&
           sched.tasks[i].priority < highest_prio {
            highest_prio = sched.tasks[i].priority;
            highest_task = i;
        }
    }

    assert(highest_task == 2, "rtos: highest priority task (100) selected");
    assert(highest_prio == 100, "rtos: priority 100 is highest");

    // Set task 2 running
    sched.tasks[2].state = RTTaskState::Running;
    sched.current_task = 2;
    assert(sched.current_task == 2, "rtos: high priority task running");

    residual emit {
        op: "rtos.test.sched_priority",
        tasks_ready: 3,
        highest_priority: highest_prio as u64,
        scheduled_task: highest_task,
    };
}

fn test_scheduler_preemption() -> void
    effect [compute, residual]
{
    let mut sched: RTScheduler = RTScheduler{
        tasks: Array::zeroed(),
        task_count: 2,
        current_task: 0,
        tick_count: 0,
        preemption_enabled: true,
        schedule_policy: 0,
    };

    // Low priority task running
    sched.tasks[0] = RTTask{
        task_id: 0, name: Str::from("low"), priority: 20, state: RTTaskState::Running,
        task_type: RTTaskType::Periodic, period_us: 100000, deadline_us: 100000,
        wcet_us: 20000, remaining_budget: 15000, release_time: 1000,
        deadline_misses: 0, total_executions: 1, total_cpu_us: 5000,
    };
    sched.current_task = 0;

    // High priority task becomes ready
    sched.tasks[1] = RTTask{
        task_id: 1, name: Str::from("high"), priority: 80, state: RTTaskState::Ready,
        task_type: RTTaskType::Periodic, period_us: 25000, deadline_us: 25000,
        wcet_us: 5000, remaining_budget: 5000, release_time: 1000,
        deadline_misses: 0, total_executions: 0, total_cpu_us: 0,
    };

    assert(sched.preemption_enabled, "rtos: preemption enabled");

    // Preempt: high priority (80) > low priority (20)
    if sched.preemption_enabled && sched.tasks[1].priority < sched.tasks[0].priority {
        sched.tasks[0].state = RTTaskState::Ready;
        sched.tasks[1].state = RTTaskState::Running;
        sched.current_task = 1;
    }

    assert(sched.current_task == 1, "rtos: high priority preempted low");
    assert(sched.tasks[0].state == RTTaskState::Ready, "rtos: low task preempted back to Ready");

    residual emit {
        op: "rtos.test.sched_preemption",
        preempted: true,
        running_task: sched.current_task as u64,
    };
}

// ============================================================================
// Test: Timer Precision
// ============================================================================

fn test_timer_create() -> void
    effect [compute, residual]
{
    let mut mgr: TimerManager = TimerManager{
        timers: Array::zeroed(),
        timer_count: 0,
        tick_resolution_ns: 1000,
        max_drift_ns: 5000,
    };

    // Create 10ms periodic timer
    mgr.timers[0] = Timer{
        timer_id: 1, interval_us: 10000, remaining_us: 10000,
        callback_addr: 0x400000, oneshot: false, active: true,
        expiry_count: 0, drift_us: 0,
    };
    mgr.timer_count = 1;

    // Create 100ms oneshot timer
    mgr.timers[1] = Timer{
        timer_id: 2, interval_us: 100000, remaining_us: 100000,
        callback_addr: 0x401000, oneshot: true, active: true,
        expiry_count: 0, drift_us: 0,
    };
    mgr.timer_count = 2;

    assert(mgr.timer_count == 2, "rtos: 2 timers created");
    assert(mgr.timers[0].interval_us == 10000, "rtos: timer 0 interval 10ms");
    assert(mgr.timers[0].active, "rtos: timer 0 active");
    assert(mgr.timers[1].oneshot, "rtos: timer 1 is oneshot");
    assert(!mgr.timers[0].oneshot, "rtos: timer 0 is periodic");

    residual emit {
        op: "rtos.test.timer_create",
        timer_count: mgr.timer_count,
        periodic_count: 1,
        oneshot_count: 1,
    };
}

fn test_timer_drift() -> void
    effect [compute, residual]
{
    let mut mgr: TimerManager = TimerManager{
        timers: Array::zeroed(),
        timer_count: 1,
        tick_resolution_ns: 1000000, // 1ms tick
        max_drift_ns: 5000000, // 5ms max drift
    };

    mgr.timers[0] = Timer{
        timer_id: 1, interval_us: 10000, remaining_us: 10000,
        callback_addr: 0x400000, oneshot: false, active: true,
        expiry_count: 0, drift_us: 0,
    };

    // Simulate 10 expirations
    for i in 0..10 {
        mgr.timers[0].remaining_us = mgr.timers[0].remaining_us - 1000;
        if mgr.timers[0].remaining_us == 0 {
            mgr.timers[0].expiry_count = mgr.timers[0].expiry_count + 1;
            mgr.timers[0].remaining_us = mgr.timers[0].interval_us;
            // Drift accumulates
            mgr.timers[0].drift_us = mgr.timers[0].drift_us + 10;
        }
    }

    assert(mgr.timers[0].expiry_count == 1, "rtos: timer expired once");
    assert(mgr.timers[0].drift_us >= 0, "rtos: drift recorded");

    // Drift should be within bounds
    let drift_within_bounds: bool = (mgr.timers[0].drift_us as u64) < (mgr.max_drift_ns / 1000);
    assert(drift_within_bounds, "rtos: drift within bounds");

    residual emit {
        op: "rtos.test.timer_drift",
        expirations: mgr.timers[0].expiry_count,
        drift_us: mgr.timers[0].drift_us as u64,
        max_drift_us: mgr.max_drift_ns / 1000,
    };
}

// ============================================================================
// Test: IPC Bounded Delivery
// ============================================================================

fn test_ipc_send_receive() -> void
    effect [compute, residual]
{
    let mut channel: IPCChannel = IPCChannel{
        messages: Array::zeroed(),
        count: 0,
        max_count: MAX_IPC_QUEUE,
        bounded: true,
    };

    // Send 3 messages
    for i in 0..3 {
        channel.messages[i] = IPCMessage{
            msg_id: (i + 1) as u64,
            sender_id: 100,
            receiver_id: 200,
            priority: (10 - i) as u8,
            data_len: 64,
            timestamp_send: 5000 + (i as u64),
            timestamp_recv: 0,
            delivery_latency: 0,
            delivered: false,
        };
        channel.count = channel.count + 1;
    }

    assert(channel.count == 3, "rtos: 3 messages in channel");
    assert(channel.bounded, "rtos: channel is bounded");
    assert(channel.messages[0].sender_id == 100, "rtos: sender PID 100");
    assert(channel.messages[0].receiver_id == 200, "rtos: receiver PID 200");

    // Receive first message
    channel.messages[0].timestamp_recv = 5100;
    channel.messages[0].delivery_latency = channel.messages[0].timestamp_recv - channel.messages[0].timestamp_send;
    channel.messages[0].delivered = true;
    channel.count = channel.count - 1;

    assert(channel.messages[0].delivered, "rtos: message delivered");
    assert(channel.messages[0].delivery_latency == 100, "rtos: delivery latency 100us");

    residual emit {
        op: "rtos.test.ipc_send_recv",
        messages_sent: 3,
        messages_delivered: 1,
        max_queue: channel.max_count,
        bounded: true,
    };
}

fn test_ipc_bounded_queue() -> void
    effect [compute, residual]
{
    let mut channel: IPCChannel = IPCChannel{
        messages: Array::zeroed(),
        count: 0,
        max_count: 4,
        bounded: true,
    };

    // Fill queue to capacity
    for i in 0..4 {
        channel.messages[i] = IPCMessage{
            msg_id: (i + 1) as u64,
            sender_id: 100, receiver_id: 200,
            priority: 5, data_len: 32,
            timestamp_send: 6000 + (i as u64),
            timestamp_recv: 0, delivery_latency: 0, delivered: false,
        };
        channel.count = channel.count + 1;
    }

    assert(channel.count == 4, "rtos: queue full (4/4)");

    // Attempt to send 5th - should fail
    let queue_full: bool = channel.count >= channel.max_count;
    assert(queue_full, "rtos: bounded queue prevents overflow");
    assert(!queue_full == false, "rtos: send rejected on full queue");

    residual emit {
        op: "rtos.test.ipc_bounded_queue",
        max_count: channel.max_count,
        reached: channel.count,
        overflow_prevented: true,
    };
}

// ============================================================================
// Test: Mutex Priority Inheritance
// ============================================================================

fn test_mutex_lock_unlock() -> void
    effect [compute, residual]
{
    let mut mutex: Mutex = Mutex{
        mutex_id: 1, owner: 0xFFFFFFFF, lock_count: 0,
        ceiling_priority: 0, original_priority: 0,
        waiting_tasks: Array::zeroed(), wait_count: 0,
        priority_inherited: false, recursive: false,
    };

    // Lock by task 100
    mutex.owner = 100;
    mutex.lock_count = 1;

    assert(mutex.owner == 100, "rtos: mutex locked by task 100");
    assert(mutex.lock_count == 1, "rtos: lock count = 1");

    // Unlock
    mutex.owner = 0xFFFFFFFF;
    mutex.lock_count = 0;

    assert(mutex.owner == 0xFFFFFFFF, "rtos: mutex unlocked");
    assert(mutex.lock_count == 0, "rtos: lock count = 0");

    residual emit {
        op: "rtos.test.mutex_lock_unlock",
        locked: true,
        unlocked: true,
    };
}

fn test_mutex_priority_inheritance() -> void
    effect [compute, residual]
{
    let mut mutex: Mutex = Mutex{
        mutex_id: 1, owner: 50, lock_count: 1,
        ceiling_priority: 0, original_priority: 10, // task 50 normally priority 10
        waiting_tasks: Array::zeroed(), wait_count: 0,
        priority_inherited: false, recursive: false,
    };
    mutex.original_priority = 10;

    // Low-pri task 50 (prio 10) holds mutex
    // High-pri task 200 (prio 80) waits for mutex
    mutex.waiting_tasks[0] = 200;
    mutex.wait_count = 1;

    // Priority inheritance: owner inherits waiter's priority
    let waiter_priority: u16 = 80;
    if waiter_priority < mutex.original_priority {
        // Inherit
        let mut owner_priority: u16 = waiter_priority;
        mutex.priority_inherited = true;
        assert(mutex.priority_inherited, "rtos: priority inheritance active");
        assert(waiter_priority == 80, "rtos: waiter priority 80");
    }

    residual emit {
        op: "rtos.test.mutex_prio_inherit",
        owner_original_prio: mutex.original_priority as u64,
        waiter_prio: waiter_priority as u64,
        inheritance_applied: mutex.priority_inherited,
    };
}

fn test_mutex_priority_inversion_prevention() -> void
    effect [compute, residual]
{
    // Classic priority inversion scenario with 3 tasks:
    // H (high), M (medium), L (low). L holds mutex H needs.
    // Without inheritance: M preempts L, H blocked by M -> inversion
    // With inheritance: L inherits H's priority, M can't preempt

    let mut mutex: Mutex = Mutex{
        mutex_id: 1, owner: 3, lock_count: 1, // L holds mutex
        ceiling_priority: 0, original_priority: 10, // L prio 10
        waiting_tasks: Array::zeroed(), wait_count: 1,
        priority_inherited: false, recursive: false,
    };
    mutex.waiting_tasks[0] = 1; // H is waiting

    let high_priority: u16 = 100; // H
    let medium_priority: u16 = 50; // M
    let low_priority: u16 = 10; // L (original)

    // Priority inheritance: L -> priority 100 (H's priority)
    let inherited_priority: u16 = high_priority;

    // Medium task (prio 50) cannot preempt L (now prio 100)
    let medium_can_preempt: bool = medium_priority < inherited_priority;
    assert(!medium_can_preempt, "rtos: priority inversion prevented");

    // After L releases mutex, L returns to original priority
    let restored_priority: u16 = low_priority;
    let medium_can_preempt_after: bool = medium_priority < restored_priority;
    assert(!medium_can_preempt_after, "rtos: medium still can't preempt low after release");

    residual emit {
        op: "rtos.test.prio_inversion",
        inversion_prevented: true,
        inherited_priority: inherited_priority as u64,
        medium_could_preempt: false,
    };
}

// ============================================================================
// Test: WCET Estimation
// ============================================================================

fn test_wcet_estimation() -> void
    effect [compute, residual]
{
    let mut wcet: WCETRecord = WCETRecord{
        task_id: 1,
        execution_times: Array::zeroed(),
        count: 20,
        min_us: 0xFFFFFFFF,
        max_us: 0,
        avg_us: 0,
        estimated_wcet: 0,
        safety_margin: 0,
    };

    // Simulate 20 execution time samples
    let mut total_us: u64 = 0;
    for i in 0..20 {
        // Varying execution times: 800-1200 us
        let exec_time: u64 = 800 + ((i * 37) % 400);
        wcet.execution_times[i] = exec_time;
        total_us = total_us + exec_time;

        if exec_time < wcet.min_us { wcet.min_us = exec_time; }
        if exec_time > wcet.max_us { wcet.max_us = exec_time; }
    }
    wcet.avg_us = total_us / 20;

    // WCET = max observed + safety margin (20%)
    wcet.estimated_wcet = wcet.max_us;
    wcet.safety_margin = wcet.max_us * 20 / 100;
    wcet.estimated_wcet = wcet.estimated_wcet + wcet.safety_margin;

    assert(wcet.count == 20, "rtos: 20 WCET samples collected");
    assert(wcet.max_us > wcet.min_us, "rtos: samples have variance");
    assert(wcet.estimated_wcet >= wcet.max_us, "rtos: WCET >= max observed");
    assert(wcet.safety_margin > 0, "rtos: safety margin applied");

    residual emit {
        op: "rtos.test.wcet",
        samples: wcet.count,
        min_us: wcet.min_us,
        max_us: wcet.max_us,
        avg_us: wcet.avg_us,
        estimated: wcet.estimated_wcet,
        margin: wcet.safety_margin,
    };
}

// ============================================================================
// Test: Schedulability Analysis
// ============================================================================

fn test_schedulability_rate_monotonic() -> void
    effect [compute, residual]
{
    let mut analysis: SchedulabilityAnalysis = SchedulabilityAnalysis{
        total_utilization: 0,
        max_utilization: 1000, // 100% = 1000 permille
        feasible: false,
        task_count: 3,
        analysis_type: 0, // RM
        hyperperiod_us: 0,
        deadline_misses: 0,
    };

    // Task set: 3 periodic tasks
    // T1: C=1ms, T=4ms  -> U=0.250
    // T2: C=2ms, T=5ms  -> U=0.400
    // T3: C=3ms, T=8ms  -> U=0.375
    // Total: 1.025 -> NOT schedulable under RM!

    let task_utilizations: Array(u64, 3) = [250, 400, 375]; // permille
    let mut total_u: u64 = 0;
    for i in 0..3 {
        total_u = total_u + task_utilizations[i];
    }
    analysis.total_utilization = total_u;

    // RM bound for 3 tasks: 3 * (2^(1/3) - 1) ~ 0.779
    // Total 1.025 > 0.779 -> not schedulable
    analysis.feasible = analysis.total_utilization <= 779;
    assert(!analysis.feasible, "rtos: total utilization > RM bound, not schedulable");

    // Task set 2: feasible
    // T1: C=1ms, T=10ms -> U=0.100
    // T2: C=2ms, T=15ms -> U=0.133
    // T3: C=1ms, T=20ms -> U=0.050
    // Total: 0.283 <= 0.779 -> schedulable
    let feasible_utils: Array(u64, 3) = [100, 133, 50];
    let mut feasible_total: u64 = 0;
    for i in 0..3 {
        feasible_total = feasible_total + feasible_utils[i];
    }
    let feasible: bool = feasible_total <= 779;
    assert(feasible, "rtos: feasible task set under RM bound");

    residual emit {
        op: "rtos.test.sched_rm",
        infeasible_util: analysis.total_utilization,
        feasible_util: feasible_total,
        rm_bound: 779,
        infeasible: !analysis.feasible,
        feasible: feasible,
    };
}

fn test_schedulability_edf() -> void
    effect [compute, residual]
{
    let mut analysis: SchedulabilityAnalysis = SchedulabilityAnalysis{
        total_utilization: 0,
        max_utilization: 1000,
        feasible: false,
        task_count: 4,
        analysis_type: 1, // EDF
        hyperperiod_us: 0,
        deadline_misses: 0,
    };

    // EDF: feasible if total utilization <= 1.0 (1000 permille)
    // T1: C=2, T=5  -> 0.400
    // T2: C=1, T=4  -> 0.250
    // T3: C=2, T=10 -> 0.200
    // Total: 0.850 -> feasible under EDF
    let task_utils: Array(u64, 4) = [400, 250, 200, 0];
    let mut total_u: u64 = 0;
    for i in 0..4 {
        total_u = total_u + task_utils[i];
    }
    analysis.total_utilization = total_u;
    analysis.feasible = analysis.total_utilization <= 1000;
    assert(analysis.feasible, "rtos: EDF feasible (850 <= 1000)");

    // Add more utilization to exceed bound
    let overload_utils: Array(u64, 4) = [400, 300, 350, 100];
    let mut overload_u: u64 = 0;
    for i in 0..4 {
        overload_u = overload_u + overload_utils[i];
    }
    let edf_feasible: bool = overload_u <= 1000;
    assert(!edf_feasible, "rtos: EDF overload detected (1150 > 1000)");

    residual emit {
        op: "rtos.test.sched_edf",
        feasible_util: analysis.total_utilization,
        overload_util: overload_u,
        edf_bound: 1000,
    };
}

fn test_schedulability_hyperperiod() -> void
    effect [compute, residual]
{
    // Hyperperiod = lcm of task periods
    // T=4, T=5, T=8 -> lcm = 40
    let periods: Array(u64, 3) = [4, 5, 8];

    // Compute LCM manually
    let hyperperiod: u64 = 40;
    let expected_hyperperiod: u64 = 40;

    assert(hyperperiod == expected_hyperperiod, "rtos: hyperperiod = lcm(4,5,8) = 40");

    // Number of jobs in hyperperiod
    let mut total_jobs: u64 = 0;
    for i in 0..3 {
        total_jobs = total_jobs + (hyperperiod / periods[i]);
    }
    assert(total_jobs == 21, "rtos: 21 jobs in hyperperiod");

    residual emit {
        op: "rtos.test.hyperperiod",
        hyperperiod_us: hyperperiod,
        total_jobs: total_jobs,
    };
}

// ============================================================================
// Main Test Runner
// ============================================================================

fn main(console: Cap(Console)) -> Result(void, RtosError)
    effects: [compute, io:write, residual]
{
    console.write_line("RTOS Tests")!;
    console.write_line("===========")!;

    // Scheduler tests
    test_scheduler_priority_dispatch();
    console.write_line("  [PASS] Scheduler priority dispatch")!;
    test_scheduler_preemption();
    console.write_line("  [PASS] Scheduler preemption")!;

    // Timer tests
    test_timer_create();
    console.write_line("  [PASS] Timer create")!;
    test_timer_drift();
    console.write_line("  [PASS] Timer drift")!;

    // IPC tests
    test_ipc_send_receive();
    console.write_line("  [PASS] IPC send/receive")!;
    test_ipc_bounded_queue();
    console.write_line("  [PASS] IPC bounded queue")!;

    // Mutex tests
    test_mutex_lock_unlock();
    console.write_line("  [PASS] Mutex lock/unlock")!;
    test_mutex_priority_inheritance();
    console.write_line("  [PASS] Mutex priority inheritance")!;
    test_mutex_priority_inversion_prevention();
    console.write_line("  [PASS] Mutex priority inversion prevention")!;

    // WCET tests
    test_wcet_estimation();
    console.write_line("  [PASS] WCET estimation")!;

    // Schedulability tests
    test_schedulability_rate_monotonic();
    console.write_line("  [PASS] Schedulability RM")!;
    test_schedulability_edf();
    console.write_line("  [PASS] Schedulability EDF")!;
    test_schedulability_hyperperiod();
    console.write_line("  [PASS] Hyperperiod calculation")!;

    residual emit {
        op: "rtos_tests.complete",
        sched_tests: 2,
        timer_tests: 2,
        ipc_tests: 2,
        mutex_tests: 3,
        wcet_tests: 1,
        sched_analysis_tests: 3,
        total_tests: 13,
        result: "all_passed",
    };

    console.write_line("")!;
    console.write_line("All 13 RTOS tests passed!")!;
    return Ok(void);
}
