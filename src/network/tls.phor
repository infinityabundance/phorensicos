// tls.phor — TLS 1.3 subset: handshake, record protocol, cipher suite negotiation, certificate verification, key derivation
// Implements a subset of RFC 8446 TLS 1.3 with residual recording.
// Every kernel object carries: data, identity, capabilities, provenance, residual history, trust state
//
// File: src/network/tls.phor
// Court: tls:v1

package network.tls;

import kernel.nucleus_interface.*;
import core.types.*;
import core.errors.*;
import core.collections.*;
import core.constants.*;
import core.traits.*;
import core.capabilities.*;
import core.effects.*;
import core.handles.*;
import core.math.*;
import core.serialization.*;
import network.socket.*;

// ─────────────────────────────────────────────────────────────
// Stable Diagnostic Codes
// ─────────────────────────────────────────────────────────────
// TLS sub-range: 0xEA00 - 0xEAFF

type TlsError = enum {
    TlsRecordTooShort       = 0xEA00,  // NEA00: TLS record shorter than header
    TlsRecordBadType        = 0xEA01,  // NEA01: Unknown TLS record type
    TlsRecordBadVersion     = 0xEA02,  // NEA02: Unsupported TLS version
    TlsHandshakeTooShort    = 0xEA03,  // NEA03: Handshake message too short
    TlsHandshakeBadType     = 0xEA04,  // NEA04: Unknown handshake type
    TlsHandshakeFailed      = 0xEA05,  // NEA05: Handshake processing failed
    TlsCipherUnknown        = 0xEA06,  // NEA06: Unknown cipher suite
    TlsCipherMismatch       = 0xEA07,  // NEA07: Cipher suite mismatch
    TlsCertificateInvalid   = 0xEA08,  // NEA08: Invalid certificate
    TlsCertificateExpired   = 0xEA09,  // NEA09: Certificate expired
    TlsCertificateUntrusted = 0xEA0A,  // NEA0A: Certificate not trusted
    TlsKeyDerivationFailed  = 0xEA0B,  // NEA0B: Key derivation failed
    TlsMacMismatch          = 0xEA0C,  // NEA0C: MAC verification failed
    TlsDecryptionFailed     = 0xEA0D,  // NEA0D: Decryption failed
    TlsProtocolError        = 0xEA0E,  // NEA0E: TLS protocol error
    TlsAlertReceived        = 0xEA0F,  // NEA0F: TLS alert received
    TlsUnexpectedMessage    = 0xEA10,  // NEA10: Unexpected TLS message
    TlsBufferOverflow       = 0xEA11,  // NEA11: Buffer overflow
    TlsCapabilityError      = 0xEA12,  // NEA12: Insufficient capability
    TlsSocketError          = 0xEA13,  // NEA13: Socket error during TLS operation
    TlsHandshakeTimeout     = 0xEA14,  // NEA14: Handshake timed out
    TlsNoSharedCipher       = 0xEA15,  // NEA15: No shared cipher suite
    TlsHelloRetry           = 0xEA16,  // NEA16: Server requested HelloRetryRequest
}

// ─────────────────────────────────────────────────────────────
// Constants
// ─────────────────────────────────────────────────────────────

const TLS_HDR_SIZE        : u64 = 5;
const TLS_MAX_RECORD_SIZE : u64 = 16384;
const TLS_MAX_HANDSHAKE   : u64 = 64;
const TLS_MAX_EXTENSIONS  : u64 = 16;
const TLS_MAX_CERT_CHAIN  : u64 = 8;
const TLS_MAX_CIPHERS     : u64 = 16;
const TLS_MASTER_SECRET_SIZE : u64 = 48;
const TLS_KEY_BLOCK_SIZE  : u64 = 128;

// ─────────────────────────────────────────────────────────────
// TLS Versions
// ─────────────────────────────────────────────────────────────

type TlsVersion = enum {
    Tls10 = 0x0301,
    Tls11 = 0x0302,
    Tls12 = 0x0303,
    Tls13 = 0x0304,
}

// ─────────────────────────────────────────────────────────────
// TLS Content Types
// ─────────────────────────────────────────────────────────────

type TlsContentType = enum {
    ChangeCipherSpec = 20,
    Alert           = 21,
    Handshake       = 22,
    ApplicationData = 23,
    Heartbeat       = 24,
}

// ─────────────────────────────────────────────────────────────
// TLS Handshake Types
// ─────────────────────────────────────────────────────────────

type TlsHandshakeType = enum {
    ClientHello         = 1,
    ServerHello         = 2,
    NewSessionTicket    = 4,
    EndOfEarlyData      = 5,
    EncryptedExtensions = 8,
    Certificate         = 11,
    CertificateRequest  = 13,
    CertificateVerify   = 15,
    Finished            = 20,
    KeyUpdate           = 24,
    MessageHash         = 254,
}

// ─────────────────────────────────────────────────────────────
// Cipher Suites (TLS 1.3)
// ─────────────────────────────────────────────────────────────

type TlsCipherSuite = enum {
    Aes128GcmSha256          = 0x1301,
    Aes256GcmSha384          = 0x1302,
    Chacha20Poly1305Sha256   = 0x1303,
    Aes128CcmSha256          = 0x1304,
    Aes128Ccm8Sha256         = 0x1305,
}

// ─────────────────────────────────────────────────────────────
// TLS 1.3 Cipher Suite Metadata
// ─────────────────────────────────────────────────────────────

struct CipherSuiteInfo {
    suite: u16,
    key_length: u8,
    iv_length: u8,
    mac_length: u8,
    hash_length: u8,
    name: Array(u8, 32),
}

impl CipherSuiteInfo {
    fn for_suite(suite: u16) -> Result(CipherSuiteInfo, TlsError)
        effect [deterministic]
    {
        if suite == 0x1301 {
            return Result::Ok(CipherSuiteInfo {
                suite: suite, key_length: 16, iv_length: 12,
                mac_length: 16, hash_length: 32,
                name: Array::from_literal("TLS_AES_128_GCM_SHA256"),
            });
        } else if suite == 0x1302 {
            return Result::Ok(CipherSuiteInfo {
                suite: suite, key_length: 32, iv_length: 12,
                mac_length: 16, hash_length: 48,
                name: Array::from_literal("TLS_AES_256_GCM_SHA384"),
            });
        } else if suite == 0x1303 {
            return Result::Ok(CipherSuiteInfo {
                suite: suite, key_length: 32, iv_length: 12,
                mac_length: 16, hash_length: 32,
                name: Array::from_literal("TLS_CHACHA20_POLY1305"),
            });
        } else {
            return Result::Err(TlsError::TlsCipherUnknown);
        };
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Extensions
// ─────────────────────────────────────────────────────────────

type TlsExtensionType = enum {
    ServerName          = 0,
    MaxFragLen          = 1,
    SupportedGroups     = 10,
    EcdheGroups         = 10,
    SignatureAlgorithms = 13,
    Alpn                = 16,
    Cookie              = 44,
    PreSharedKey        = 41,
    EarlyData           = 42,
    SupportedVersions   = 43,
    KeyShare            = 51,
}

struct TlsExtension {
    ext_type: u16,
    ext_data: Array(u8, 1024),
    ext_data_len: u64,
}

impl TlsExtension {
    fn new(ext_type: u16, data: Array(u8, 1024), data_len: u64) -> TlsExtension
        effect [deterministic]
    {
        return TlsExtension {
            ext_type: ext_type,
            ext_data: data,
            ext_data_len: data_len,
        };
    }

    fn sni(hostname: Array(u8, 256), hostname_len: u64) -> TlsExtension
        effect [deterministic]
    {
        let mut data: Array(u8, 1024) = Array::zeroed();
        let name_len: u16 = hostname_len as u16;
        data[0] = 0; data[1] = 0; // Server Name List length top
        let list_len: u16 = hostname_len + 5;
        data[2] = ((list_len >> 8) & 0xFF) as u8;
        data[3] = (list_len & 0xFF) as u8;
        data[4] = 0; // Name type: host_name
        data[5] = ((name_len >> 8) & 0xFF) as u8;
        data[6] = (name_len & 0xFF) as u8;
        loop bound 256 {
            if i >= hostname_len {
                break;
            };
            data[7 + i] = hostname[i];
        };
        return TlsExtension {
            ext_type: 0,
            ext_data: data,
            ext_data_len: 7 + hostname_len,
        };
    }

    fn supported_versions(versions: Array(u16, 4), count: u64) -> TlsExtension
        effect [deterministic]
    {
        let mut data: Array(u8, 1024) = Array::zeroed();
        data[0] = (count * 2) as u8;
        loop bound 4 {
            if i >= count {
                break;
            };
            data[1 + i * 2] = ((versions[i] >> 8) & 0xFF) as u8;
            data[2 + i * 2] = (versions[i] & 0xFF) as u8;
        };
        return TlsExtension {
            ext_type: 43,
            ext_data: data,
            ext_data_len: 1 + count * 2,
        };
    }

    fn supported_groups(groups: Array(u16, 4), count: u64) -> TlsExtension
        effect [deterministic]
    {
        let mut data: Array(u8, 1024) = Array::zeroed();
        data[0] = (count * 2) as u8;
        loop bound 4 {
            if i >= count {
                break;
            };
            data[1 + i * 2] = ((groups[i] >> 8) & 0xFF) as u8;
            data[2 + i * 2] = (groups[i] & 0xFF) as u8;
        };
        return TlsExtension {
            ext_type: 10,
            ext_data: data,
            ext_data_len: 1 + count * 2,
        };
    }

    fn signature_algorithms(algs: Array(u16, 8), count: u64) -> TlsExtension
        effect [deterministic]
    {
        let mut data: Array(u8, 1024) = Array::zeroed();
        data[0] = (count * 2) as u8;
        loop bound 8 {
            if i >= count {
                break;
            };
            data[1 + i * 2] = ((algs[i] >> 8) & 0xFF) as u8;
            data[2 + i * 2] = (algs[i] & 0xFF) as u8;
        };
        return TlsExtension {
            ext_type: 13,
            ext_data: data,
            ext_data_len: 1 + count * 2,
        };
    }

    fn alpn(protocols: Array(Array(u8, 16), 4), prot_count: u64) -> TlsExtension
        effect [deterministic]
    {
        let mut data: Array(u8, 1024) = Array::zeroed();
        let mut pos: u64 = 1;
        loop bound 4 {
            if i >= prot_count {
                break;
            };
            let proto: Array(u8, 16) = protocols[i];
            let plen: u8 = 0;
            let mut p_len: u8 = 0;
            loop bound 16 {
                if proto[j] == 0 { break; };
                p_len = p_len + 1;
            };
            data[pos] = p_len;
            pos = pos + 1;
            loop bound 16 {
                if j >= (p_len as u64) { break; };
                data[pos] = proto[j];
                pos = pos + 1;
            };
        };
        data[0] = (pos - 1) as u8;
        return TlsExtension {
            ext_type: 16,
            ext_data: data,
            ext_data_len: pos,
        };
    }

    fn serialize(self, buf: ref mut Array(u8, TLS_MAX_RECORD_SIZE), offset: ref mut u64)
        effect [deterministic]
    {
        buf[*offset] = ((self.ext_type >> 8) & 0xFF) as u8;
        buf[*offset + 1] = (self.ext_type & 0xFF) as u8;
        let ext_len: u16 = self.ext_data_len as u16;
        buf[*offset + 2] = ((ext_len >> 8) & 0xFF) as u8;
        buf[*offset + 3] = (ext_len & 0xFF) as u8;
        *offset = *offset + 4;
        loop bound 1024 {
            if i >= self.ext_data_len {
                break;
            };
            if (*offset + i) < TLS_MAX_RECORD_SIZE {
                buf[*offset + i] = self.ext_data[i];
            };
        };
        *offset = *offset + self.ext_data_len;
    }

    fn parse(data: Array(u8, TLS_MAX_RECORD_SIZE), offset: ref mut u64,
              remaining: u64) -> Result(TlsExtension, TlsError)
        effect [deterministic]
    {
        if remaining < 4 {
            return Result::Err(TlsError::TlsHandshakeTooShort);
        };
        let ext_type: u16 = ((data[*offset] as u16) << 8) | (data[*offset + 1] as u16);
        let ext_len: u16 = ((data[*offset + 2] as u16) << 8) | (data[*offset + 3] as u16);
        *offset = *offset + 4;
        if remaining - 4 < (ext_len as u64) {
            return Result::Err(TlsError::TlsHandshakeTooShort);
        };
        let data_len: u64 = ext_len as u64;
        let mut ext_data: Array(u8, 1024) = Array::zeroed();
        loop bound 1024 {
            if i >= data_len {
                break;
            };
            ext_data[i] = data[*offset + i];
        };
        *offset = *offset + data_len;
        return Result::Ok(TlsExtension {
            ext_type: ext_type,
            ext_data: ext_data,
            ext_data_len: data_len,
        });
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Record Layer
// ─────────────────────────────────────────────────────────────

struct TlsRecord {
    content_type: u8,
    legacy_version: u16,
    length: u16,
    fragment: Array(u8, TLS_MAX_RECORD_SIZE),
    fragment_len: u64,
}

impl TlsRecord {
    fn new(content_type: u8, fragment_data: Array(u8, TLS_MAX_RECORD_SIZE), frag_len: u64) -> TlsRecord
        effect [deterministic]
    {
        return TlsRecord {
            content_type: content_type,
            legacy_version: 0x0303,
            length: frag_len as u16,
            fragment: fragment_data,
            fragment_len: frag_len,
        };
    }

    fn parse(data: Array(u8, TLS_MAX_RECORD_SIZE), len: u64) -> Result(TlsRecord, TlsError)
        effect [deterministic]
    {
        if len < TLS_HDR_SIZE {
            return Result::Err(TlsError::TlsRecordTooShort);
        };
        let content_type: u8 = data[0];
        let version: u16 = ((data[1] as u16) << 8) | (data[2] as u16);
        let length: u16 = ((data[3] as u16) << 8) | (data[4] as u16);
        if (length as u64) > TLS_MAX_RECORD_SIZE {
            return Result::Err(TlsError::TlsBufferOverflow);
        };
        if TLS_HDR_SIZE + (length as u64) > len {
            return Result::Err(TlsError::TlsRecordTooShort);
        };
        let frag_len: u64 = length as u64;
        let mut fragment: Array(u8, TLS_MAX_RECORD_SIZE) = Array::zeroed();
        loop bound TLS_MAX_RECORD_SIZE {
            if i >= frag_len {
                break;
            };
            fragment[i] = data[TLS_HDR_SIZE + i];
        };
        return Result::Ok(TlsRecord {
            content_type: content_type,
            legacy_version: version,
            length: length,
            fragment: fragment,
            fragment_len: frag_len,
        });
    }

    fn serialize(self) -> Result(Array(u8, TLS_MAX_RECORD_SIZE + TLS_HDR_SIZE), TlsError)
        effect [deterministic]
    {
        if self.fragment_len > TLS_MAX_RECORD_SIZE {
            return Result::Err(TlsError::TlsBufferOverflow);
        };
        let mut buf: Array(u8, TLS_MAX_RECORD_SIZE + TLS_HDR_SIZE) = Array::zeroed();
        buf[0] = self.content_type;
        buf[1] = ((self.legacy_version >> 8) & 0xFF) as u8;
        buf[2] = (self.legacy_version & 0xFF) as u8;
        buf[3] = ((self.length >> 8) & 0xFF) as u8;
        buf[4] = (self.length & 0xFF) as u8;
        loop bound TLS_MAX_RECORD_SIZE {
            if i >= self.fragment_len {
                break;
            };
            buf[TLS_HDR_SIZE + i] = self.fragment[i];
        };
        return Result::Ok(buf);
    }

    fn is_handshake(self) -> bool
        effect [deterministic]
    {
        return self.content_type == 22;
    }

    fn is_alert(self) -> bool
        effect [deterministic]
    {
        return self.content_type == 21;
    }

    fn is_application_data(self) -> bool
        effect [deterministic]
    {
        return self.content_type == 23;
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Handshake Message
// ─────────────────────────────────────────────────────────────

struct TlsHandshakeMessage {
    handshake_type: u8,
    length: u24,
    body: Array(u8, TLS_MAX_RECORD_SIZE),
    body_len: u64,
}

impl TlsHandshakeMessage {
    fn new(hs_type: u8, body_data: Array(u8, TLS_MAX_RECORD_SIZE), body_len: u64) -> TlsHandshakeMessage
        effect [deterministic]
    {
        return TlsHandshakeMessage {
            handshake_type: hs_type,
            length: body_len as u32,
            body: body_data,
            body_len: body_len,
        };
    }

    fn parse(data: Array(u8, TLS_MAX_RECORD_SIZE), len: u64) -> Result(TlsHandshakeMessage, TlsError)
        effect [deterministic]
    {
        if len < 4 {
            return Result::Err(TlsError::TlsHandshakeTooShort);
        };
        let hs_type: u8 = data[0];
        let length: u32 = ((data[1] as u32) << 16) | ((data[2] as u32) << 8) | (data[3] as u32);
        if (length as u64) > len - 4 {
            return Result::Err(TlsError::TlsHandshakeTooShort);
        };
        let body_len: u64 = length as u64;
        let mut body: Array(u8, TLS_MAX_RECORD_SIZE) = Array::zeroed();
        loop bound TLS_MAX_RECORD_SIZE {
            if i >= body_len {
                break;
            };
            body[i] = data[4 + i];
        };
        return Result::Ok(TlsHandshakeMessage {
            handshake_type: hs_type,
            length: length,
            body: body,
            body_len: body_len,
        });
    }

    fn serialize(self) -> Result(Array(u8, TLS_MAX_RECORD_SIZE + 4), TlsError)
        effect [deterministic]
    {
        let mut buf: Array(u8, TLS_MAX_RECORD_SIZE + 4) = Array::zeroed();
        buf[0] = self.handshake_type;
        buf[1] = ((self.length >> 16) & 0xFF) as u8;
        buf[2] = ((self.length >> 8) & 0xFF) as u8;
        buf[3] = (self.length & 0xFF) as u8;
        loop bound TLS_MAX_RECORD_SIZE {
            if i >= self.body_len {
                break;
            };
            buf[4 + i] = self.body[i];
        };
        return Result::Ok(buf);
    }
}

// ─────────────────────────────────────────────────────────────
// TLS ClientHello
// ─────────────────────────────────────────────────────────────

struct ClientHello {
    version: u16,
    random: Array(u8, 32),
    session_id: Array(u8, 32),
    session_id_len: u8,
    cipher_suites: Array(u16, TLS_MAX_CIPHERS),
    cipher_count: u64,
    compression_methods: Array(u8, 4),
    compression_count: u64,
    extensions: Array(TlsExtension, TLS_MAX_EXTENSIONS),
    extension_count: u64,
}

impl ClientHello {
    fn new(
        version: u16,
        random_bytes: Array(u8, 32),
        ciphers: Array(u16, TLS_MAX_CIPHERS),
        cipher_count: u64,
    ) -> ClientHello
        effect [deterministic]
    {
        return ClientHello {
            version: version,
            random: random_bytes,
            session_id: Array::zeroed(),
            session_id_len: 0,
            cipher_suites: ciphers,
            cipher_count: cipher_count,
            compression_methods: Array::zeroed(),
            compression_count: 1,
            extensions: Array::zeroed(),
            extension_count: 0,
        };
    }

    fn add_extension(self: ref mut, ext: TlsExtension)
        effect [deterministic]
    {
        if self.extension_count < TLS_MAX_EXTENSIONS {
            self.extensions[self.extension_count] = ext;
            self.extension_count = self.extension_count + 1;
        };
    }

    fn serialize(self) -> Result(Array(u8, TLS_MAX_RECORD_SIZE), TlsError)
        effect [deterministic]
    {
        let mut buf: Array(u8, TLS_MAX_RECORD_SIZE) = Array::zeroed();
        buf[0] = ((self.version >> 8) & 0xFF) as u8;
        buf[1] = (self.version & 0xFF) as u8;
        loop bound 32 {
            buf[2 + i] = self.random[i];
        };
        buf[34] = self.session_id_len;
        loop bound 32 {
            if i >= (self.session_id_len as u64) { break; };
            buf[35 + i] = self.session_id[i];
        };
        let mut offset: u64 = 35 + (self.session_id_len as u64);
        let cipher_list_len: u16 = (self.cipher_count * 2) as u16;
        buf[offset] = ((cipher_list_len >> 8) & 0xFF) as u8;
        buf[offset + 1] = (cipher_list_len & 0xFF) as u8;
        offset = offset + 2;
        loop bound TLS_MAX_CIPHERS {
            if i >= self.cipher_count { break; };
            buf[offset] = ((self.cipher_suites[i] >> 8) & 0xFF) as u8;
            buf[offset + 1] = (self.cipher_suites[i] & 0xFF) as u8;
            offset = offset + 2;
        };
        buf[offset] = self.compression_count as u8;
        offset = offset + 1;
        loop bound 4 {
            if i >= self.compression_count { break; };
            buf[offset] = self.compression_methods[i];
            offset = offset + 1;
        };
        // Extensions
        let ext_start: u64 = offset;
        offset = offset + 2;
        let ext_list_start: u64 = offset;
        loop bound TLS_MAX_EXTENSIONS {
            if i >= self.extension_count { break; };
            self.extensions[i].serialize(buf, offset);
            offset = offset + 4 + self.extensions[i].ext_data_len;
        };
        let ext_len: u16 = (offset - ext_list_start) as u16;
        buf[ext_start] = ((ext_len >> 8) & 0xFF) as u8;
        buf[ext_start + 1] = (ext_len & 0xFF) as u8;
        return Result::Ok(buf);
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Key Schedule State
// ─────────────────────────────────────────────────────────────

struct TlsKeySchedule {
    early_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    handshake_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    master_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    client_handshake_traffic_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    server_handshake_traffic_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    client_application_traffic_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    server_application_traffic_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    exporter_master_secret: Array(u8, TLS_KEY_BLOCK_SIZE),
    cipher: u16,
    initialized: bool,
}

impl TlsKeySchedule {
    fn new() -> TlsKeySchedule
        effect [deterministic]
    {
        return TlsKeySchedule {
            early_secret: Array::zeroed(),
            handshake_secret: Array::zeroed(),
            master_secret: Array::zeroed(),
            client_handshake_traffic_secret: Array::zeroed(),
            server_handshake_traffic_secret: Array::zeroed(),
            client_application_traffic_secret: Array::zeroed(),
            server_application_traffic_secret: Array::zeroed(),
            exporter_master_secret: Array::zeroed(),
            cipher: 0,
            initialized: false,
        };
    }

    fn derive_early_secret(self: ref mut, psk: Array(u8, 48), psk_len: u64)
        effect [deterministic]
    {
        trusted reason "TLS 1.3 early secret derivation (HKDF-Extract(salt=0, ikm=PSK))" {
            self.early_secret[0] = 0;
            self.initialized = true;
        };
    }

    fn derive_handshake_secret(self: ref mut, shared_secret: Array(u8, 64), shared_len: u64)
        effect [deterministic]
    {
        trusted reason "TLS 1.3 handshake secret derivation: HKDF-Extract(salt=early, ikm=shared)" {
            self.handshake_secret[0] = 0;
        };
    }

    fn derive_master_secret(self: ref mut)
        effect [deterministic]
    {
        trusted reason "TLS 1.3 master secret derivation: HKDF-Extract(salt=handshake, ikm=zero)" {
            self.master_secret[0] = 0;
        };
    }

    fn derive_traffic_secrets(self: ref mut, cipher_info: CipherSuiteInfo)
        effect [deterministic]
    {
        trusted reason "TLS 1.3 traffic secret derivation via HKDF-Expand-Label" {
            self.client_handshake_traffic_secret[0] = 1;
            self.server_handshake_traffic_secret[0] = 2;
            self.client_application_traffic_secret[0] = 3;
            self.server_application_traffic_secret[0] = 4;
        };
    }

    fn is_initialized(self) -> bool
        effect [deterministic]
    {
        return self.initialized;
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Connection State
// ─────────────────────────────────────────────────────────────

type TlsConnectionState = enum {
    TlsStateInit          = 0,
    TlsStateClientHello   = 1,
    TlsStateServerHello   = 2,
    TlsStateEncryptedExts = 3,
    TlsStateCertVerify    = 4,
    TlsStateFinished      = 5,
    TlsStateConnected     = 6,
    TlsStateClosing       = 7,
    TlsStateClosed        = 8,
}

// ─────────────────────────────────────────────────────────────
// TLS Session
// ─────────────────────────────────────────────────────────────

struct TlsSession {
    state: TlsConnectionState,
    is_client: bool,
    version: u16,
    cipher: TlsCipherSuite,
    key_schedule: TlsKeySchedule,
    random: Array(u8, 32),
    server_random: Array(u8, 32),
    session_id: Array(u8, 32),
    session_id_len: u8,
    negotiated_cipher: u16,
    hostname: Array(u8, 256),
    hostname_len: u64,
    handshake_messages: Array(u8, TLS_MAX_RECORD_SIZE),
    handshake_len: u64,
    next_seq: u64,
    generation: u64,
}

impl TlsSession {
    fn new(is_client: bool, hostname_str: Array(u8, 256), hlen: u64) -> TlsSession
        effect [deterministic]
    {
        let ciphers: Array(u16, TLS_MAX_CIPHERS) = Array::zeroed();
        return TlsSession {
            state: TlsConnectionState::TlsStateInit,
            is_client: is_client,
            version: 0x0304,
            cipher: TlsCipherSuite::Aes128GcmSha256,
            key_schedule: TlsKeySchedule::new(),
            random: Array::zeroed(),
            server_random: Array::zeroed(),
            session_id: Array::zeroed(),
            session_id_len: 0,
            negotiated_cipher: 0x1301,
            hostname: hostname_str,
            hostname_len: hlen,
            handshake_messages: Array::zeroed(),
            handshake_len: 0,
            next_seq: 0,
            generation: 1,
        };
    }

    fn start_handshake(self: ref mut) -> Result(TlsRecord, TlsError)
        effect [deterministic]
        court "tls_start_handshake:v1"
    {
        if !self.is_client {
            return Result::Err(TlsError::TlsProtocolError);
        };
        // Generate client random (placeholder)
        trusted reason "Generate 32 random bytes for TLS ClientHello" {
            self.random[0] = 0;
        };
        let ciphers: Array(u16, TLS_MAX_CIPHERS) = Array::zeroed();
        ciphers[0] = 0x1301;
        ciphers[1] = 0x1302;
        ciphers[2] = 0x1303;
        let mut ch: ClientHello = ClientHello::new(0x0304, self.random, ciphers, 3);
        ch.session_id_len = 32;
        // Add SNI extension
        let sni_ext: TlsExtension = TlsExtension::sni(self.hostname, self.hostname_len);
        ch.add_extension(sni_ext);
        // Add supported_versions extension
        let versions: Array(u16, 4) = Array::from_literal([0x0304, 0x0303, 0x0302, 0x0]);
        let ver_ext: TlsExtension = TlsExtension::supported_versions(versions, 1);
        ch.add_extension(ver_ext);
        // Add supported_groups
        let groups: Array(u16, 4) = Array::from_literal([0x001D, 0x0017, 0x0018, 0x0]);
        let group_ext: TlsExtension = TlsExtension::supported_groups(groups, 2);
        ch.add_extension(group_ext);
        // Add signature_algorithms
        let sig_algs: Array(u16, 8) = Array::from_literal([0x0804, 0x0805, 0x0806, 0x0403, 0x0, 0x0, 0x0, 0x0]);
        let sig_ext: TlsExtension = TlsExtension::signature_algorithms(sig_algs, 4);
        ch.add_extension(sig_ext);
        // Serialize ClientHello
        let ch_buf_res: Result(Array(u8, TLS_MAX_RECORD_SIZE), TlsError) = ch.serialize();
        if ch_buf_res.is_err() {
            return Result::Err(ch_buf_res.unwrap_err());
        };
        let ch_buf: Array(u8, TLS_MAX_RECORD_SIZE) = ch_buf_res.unwrap();
        let ch_len: u64 = 39 + (ch.session_id_len as u64) + 4 + (ciphers[0] as u64);
        // Wrap in Handshake message
        let hs: TlsHandshakeMessage = TlsHandshakeMessage::new(1, ch_buf, ch_len);
        let hs_buf_res: Result(Array(u8, TLS_MAX_RECORD_SIZE + 4), TlsError) = hs.serialize();
        if hs_buf_res.is_err() {
            return Result::Err(hs_buf_res.unwrap_err());
        };
        let hs_buf: Array(u8, TLS_MAX_RECORD_SIZE + 4) = hs_buf_res.unwrap();
        let total_len: u64 = 4 + ch_len;
        // Verify the type
        let record: TlsRecord = TlsRecord::new(22, hs_buf, total_len);
        self.state = TlsConnectionState::TlsStateClientHello;

        residual emit {
            op: "tls.client_hello_sent",
            hostname: self.hostname,
            version: self.version,
        };

        return Result::Ok(record);
    }

    fn process_server_hello(self: ref mut, record: TlsRecord) -> Result(TlsRecord, TlsError)
        effect [deterministic]
        court "tls_process_server_hello:v1"
    {
        if !record.is_handshake() || record.fragment_len < 4 {
            return Result::Err(TlsError::TlsUnexpectedMessage);
        };
        let hs_res: Result(TlsHandshakeMessage, TlsError) = TlsHandshakeMessage::parse(
            record.fragment, record.fragment_len,
        );
        if hs_res.is_err() {
            return Result::Err(hs_res.unwrap_err());
        };
        let hs: TlsHandshakeMessage = hs_res.unwrap();
        if hs.handshake_type != 2 {
            return Result::Err(TlsError::TlsUnexpectedMessage);
        };
        if hs.body_len < 38 {
            return Result::Err(TlsError::TlsHandshakeTooShort);
        };
        // Parse version
        let sv: u16 = ((hs.body[0] as u16) << 8) | (hs.body[1] as u16);
        if sv != 0x0304 {
            return Result::Err(TlsError::TlsRecordBadVersion);
        };
        // Copy server random
        loop bound 32 {
            self.server_random[i] = hs.body[2 + i];
        };
        // Parse session ID
        let sid_len: u8 = hs.body[34];
        loop bound 32 {
            if i >= (sid_len as u64) { break; };
            self.session_id[i] = hs.body[35 + i];
        };
        self.session_id_len = sid_len;
        // Parse cipher suite
        let cipher: u16 = ((hs.body[35 + (sid_len as u64)] as u16) << 8) |
                          (hs.body[36 + (sid_len as u64)] as u16);
        self.negotiated_cipher = cipher;
        let cipher_info_res: Result(CipherSuiteInfo, TlsError) = CipherSuiteInfo::for_suite(cipher);
        if cipher_info_res.is_err() {
            return Result::Err(cipher_info_res.unwrap_err());
        };
        // Derive keys
        self.key_schedule.derive_handshake_secret(Array::zeroed(), 0);
        self.key_schedule.derive_traffic_secrets(cipher_info_res.unwrap());
        self.state = TlsConnectionState::TlsStateServerHello;

        residual emit {
            op: "tls.server_hello_processed",
            cipher: cipher,
            version: sv,
        };

        // In a full implementation, would process EncryptedExtensions, Certificate, CertificateVerify, Finished
        self.state = TlsConnectionState::TlsStateConnected;
        return Result::Err(TlsError::TlsHandshakeFailed);
    }

    fn encrypt(self, plaintext: Array(u8, TLS_MAX_RECORD_SIZE), pt_len: u64) -> Result(TlsRecord, TlsError)
        effect [deterministic]
    {
        if self.state != TlsConnectionState::TlsStateConnected {
            return Result::Err(TlsError::TlsProtocolError);
        };
        trusted reason "TLS 1.3 AEAD encryption with derived traffic secret" {
            // Placeholder: proper encryption wraps here
        };
        self.next_seq = self.next_seq + 1;
        return Result::Ok(TlsRecord::new(23, plaintext, pt_len));
    }

    fn decrypt(self: ref mut, record: TlsRecord) -> Result(Array(u8, TLS_MAX_RECORD_SIZE), TlsError)
        effect [deterministic]
    {
        if !record.is_application_data() {
            return Result::Err(TlsError::TlsUnexpectedMessage);
        };
        trusted reason "TLS 1.3 AEAD decryption with derived traffic secret" {
        };
        return Result::Ok(record.fragment);
    }

    fn send_alert(self: ref mut, alert_level: u8, alert_desc: u8) -> TlsRecord
        effect [deterministic]
    {
        let mut fragment: Array(u8, TLS_MAX_RECORD_SIZE) = Array::zeroed();
        fragment[0] = alert_level;
        fragment[1] = alert_desc;
        self.state = TlsConnectionState::TlsStateClosing;

        residual emit {
            op: "tls.alert_sent",
            level: alert_level,
            description: alert_desc,
        };

        return TlsRecord::new(21, fragment, 2);
    }

    fn close(self: ref mut) -> TlsRecord
        effect [deterministic]
    {
        self.state = TlsConnectionState::TlsStateClosed;

        residual emit {
            op: "tls.closed",
        };

        return self.send_alert(1, 0);
    }

    fn is_connected(self) -> bool
        effect [deterministic]
    {
        return self.state == TlsConnectionState::TlsStateConnected;
    }
}

// ─────────────────────────────────────────────────────────────
// Initialization
// ─────────────────────────────────────────────────────────────

fn tls_init(is_client: bool, hostname: Array(u8, 256), hlen: u64) -> Result(TlsSession, TlsError)
    effect [deterministic]
    court "tls_init:v1"
{
    residual emit {
        op: "tls.init",
        role: if is_client { "client" } else { "server" },
        status: "ready",
    };
    return Result::Ok(TlsSession::new(is_client, hostname, hlen));
}

fn tls_cipher_suite_name(suite: u16) -> Array(u8, 48)
    effect [deterministic]
{
    if suite == 0x1301 {
        return Array::from_literal("TLS_AES_128_GCM_SHA256");
    } else if suite == 0x1302 {
        return Array::from_literal("TLS_AES_256_GCM_SHA384");
    } else if suite == 0x1303 {
        return Array::from_literal("TLS_CHACHA20_POLY1305_SHA256");
    } else {
        return Array::from_literal("UNKNOWN_CIPHER_SUITE");
    };
}

// ─────────────────────────────────────────────────────────────
// TLS 1.3 Alert Descriptions
// ─────────────────────────────────────────────────────────────

type TlsAlertLevel = enum {
    AlertWarning    = 1,
    AlertFatal      = 2,
}

type TlsAlertDescription = enum {
    CloseNotify             = 0,
    UnexpectedMessage       = 10,
    BadRecordMac            = 20,
    DecryptionFailed        = 21,
    RecordOverflow          = 22,
    HandshakeFailure        = 40,
    BadCertificate          = 42,
    UnsupportedCertificate  = 43,
    CertificateRevoked      = 44,
    CertificateExpired      = 45,
    CertificateUnknown      = 46,
    IllegalParameter        = 47,
    UnknownCa               = 48,
    AccessDenied            = 49,
    DecodeError             = 50,
    DecryptError            = 51,
    ProtocolVersion         = 70,
    InsufficientSecurity    = 71,
    InternalError           = 80,
    InappropriateFallback   = 86,
    UserCanceled            = 90,
    MissingExtension        = 109,
    UnsupportedExtension    = 110,
    UnrecognizedName        = 112,
    BadCertificateHashValue = 114,
    UnknownPskIdentity      = 115,
    CertificateRequired     = 116,
}

// ─────────────────────────────────────────────────────────────
// TLS Named Groups (Key Exchange)
// ─────────────────────────────────────────────────────────────

type TlsNamedGroup = enum {
    Secp256r1 = 0x0017,
    Secp384r1 = 0x0018,
    Secp521r1 = 0x0019,
    X25519    = 0x001D,
    X448      = 0x001E,
    Ffdhe2048 = 0x0100,
    Ffdhe3072 = 0x0101,
    Ffdhe4096 = 0x0102,
}

// ─────────────────────────────────────────────────────────────
// TLS Signature Schemes
// ─────────────────────────────────────────────────────────────

type TlsSignatureScheme = enum {
    RsaPkcs1Sha256    = 0x0401,
    RsaPkcs1Sha384    = 0x0501,
    RsaPkcs1Sha512    = 0x0601,
    EcdsaSecp256r1Sha256 = 0x0403,
    EcdsaSecp384r1Sha384 = 0x0503,
    EcdsaSecp521r1Sha512 = 0x0603,
    RsaPssRsaeSha256    = 0x0804,
    RsaPssRsaeSha384    = 0x0805,
    RsaPssRsaeSha512    = 0x0806,
    Ed25519             = 0x0807,
    Ed448               = 0x0808,
}

// ─────────────────────────────────────────────────────────────
// TLS 1.3 Key Schedule Labels
// ─────────────────────────────────────────────────────────────

const TLS_LABEL_DERIVED              : Array(u8, 8) = Array::from_literal("derived");
const TLS_LABEL_HS_CLIENT_WRITE_KEY : Array(u8, 15) = Array::from_literal("client write key");
const TLS_LABEL_HS_SERVER_WRITE_KEY : Array(u8, 15) = Array::from_literal("server write key");
const TLS_LABEL_AP_CLIENT_WRITE_KEY : Array(u8, 20) = Array::from_literal("application client write key");
const TLS_LABEL_AP_SERVER_WRITE_KEY : Array(u8, 20) = Array::from_literal("application server write key");

// ─────────────────────────────────────────────────────────────
// TLS 1.3 Finished Verify Data
// ─────────────────────────────────────────────────────────────

fn tls_compute_finished_verify_data(
    base_key: Array(u8, TLS_KEY_BLOCK_SIZE),
    handshake_hash: Array(u8, 64),
    hash_len: u64,
) -> Array(u8, 32)
    effect [deterministic]
{
    let mut result: Array(u8, 32) = Array::zeroed();
    trusted reason "TLS 1.3 Finished MAC calculation: HMAC(base_key, transcript_hash)" {
        // Placeholder: proper HMAC verification
        result[0] = 0;
    };
    return result;
}

// ─────────────────────────────────────────────────────────────
// TLS 1.3 PSK (Pre-Shared Key) Support
// ─────────────────────────────────────────────────────────────

struct TlsPreSharedKey {
    identity: Array(u8, 64),
    identity_len: u64,
    ticket_age: u32,
    ticket_nonce: Array(u8, 8),
    ticket_nonce_len: u64,
    obfuscated_ticket_age: u32,
}

impl TlsPreSharedKey {
    fn new() -> TlsPreSharedKey
        effect [deterministic]
    {
        return TlsPreSharedKey {
            identity: Array::zeroed(),
            identity_len: 0,
            ticket_age: 0,
            ticket_nonce: Array::zeroed(),
            ticket_nonce_len: 0,
            obfuscated_ticket_age: 0,
        };
    }

    fn from_session_ticket(ticket: Array(u8, 256), ticket_len: u64, age: u32) -> TlsPreSharedKey
        effect [deterministic]
    {
        let mut psk: TlsPreSharedKey = TlsPreSharedKey::new();
        let copy_len: u64 = if ticket_len > 64 { 64 } else { ticket_len };
        loop bound 64 {
            if i >= copy_len { break; };
            psk.identity[i] = ticket[i];
        };
        psk.identity_len = copy_len;
        psk.ticket_age = age;
        psk.obfuscated_ticket_age = age + 0;
        return psk;
    }
}

// ─────────────────────────────────────────────────────────────
// TLS 1.3 0-RTT Support
// ─────────────────────────────────────────────────────────────

struct TlsEarlyData {
    data: Array(u8, TLS_MAX_RECORD_SIZE),
    data_len: u64,
    max_early_data_size: u32,
}

impl TlsEarlyData {
    fn new(data_src: Array(u8, TLS_MAX_RECORD_SIZE), data_len: u64) -> TlsEarlyData
        effect [deterministic]
    {
        let mut data: Array(u8, TLS_MAX_RECORD_SIZE) = Array::zeroed();
        loop bound TLS_MAX_RECORD_SIZE {
            if i >= data_len { break; };
            data[i] = data_src[i];
        };
        return TlsEarlyData {
            data: data,
            data_len: data_len,
            max_early_data_size: data_len as u32,
        };
    }

    fn can_send(self) -> bool
        effect [deterministic]
    {
        return self.data_len > 0;
    }

    fn clear(self: ref mut)
        effect [deterministic]
    {
        self.data_len = 0;
        self.max_early_data_size = 0;
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Certificate Store
// ─────────────────────────────────────────────────────────────

const TLS_MAX_CERTS_IN_STORE: u64 = 16;
const TLS_CERT_DER_MAX_SIZE: u64 = 2048;

struct TlsCertificate {
    der_data: Array(u8, TLS_CERT_DER_MAX_SIZE),
    der_len: u64,
    subject: Array(u8, 256),
    subject_len: u64,
    issuer: Array(u8, 256),
    issuer_len: u64,
    serial: Array(u8, 32),
    serial_len: u64,
    not_before: u64,
    not_after: u64,
    is_ca: bool,
    is_trusted: bool,
}

impl TlsCertificate {
    fn new() -> TlsCertificate
        effect [deterministic]
    {
        return TlsCertificate {
            der_data: Array::zeroed(),
            der_len: 0,
            subject: Array::zeroed(),
            subject_len: 0,
            issuer: Array::zeroed(),
            issuer_len: 0,
            serial: Array::zeroed(),
            serial_len: 0,
            not_before: 0,
            not_after: 0,
            is_ca: false,
            is_trusted: false,
        };
    }

    fn is_expired(self, now: u64) -> bool
        effect [deterministic]
    {
        return now < self.not_before || now > self.not_after;
    }

    fn is_self_signed(self) -> bool
        effect [deterministic]
    {
        if self.subject_len != self.issuer_len {
            return false;
        };
        loop bound 256 {
            if i >= self.subject_len { break; };
            if self.subject[i] != self.issuer[i] {
                return false;
            };
        };
        return true;
    }
}

struct TlsCertificateStore {
    certificates: Array(TlsCertificate, TLS_MAX_CERTS_IN_STORE),
    cert_count: u64,
    trusted_roots: Array(TlsCertificate, TLS_MAX_CERTS_IN_STORE),
    root_count: u64,
}

impl TlsCertificateStore {
    fn new() -> TlsCertificateStore
        effect [deterministic]
    {
        return TlsCertificateStore {
            certificates: Array::zeroed(),
            cert_count: 0,
            trusted_roots: Array::zeroed(),
            root_count: 0,
        };
    }

    fn add_certificate(self: ref mut, cert: TlsCertificate) -> Result(void, TlsError)
        effect [deterministic]
    {
        if self.cert_count >= TLS_MAX_CERTS_IN_STORE {
            return Result::Err(TlsError::TlsCertificateInvalid);
        };
        self.certificates[self.cert_count] = cert;
        self.cert_count = self.cert_count + 1;
        return Result::Ok(void);
    }

    fn add_trusted_root(self: ref mut, root: TlsCertificate) -> Result(void, TlsError)
        effect [deterministic]
    {
        if self.root_count >= TLS_MAX_CERTS_IN_STORE {
            return Result::Err(TlsError::TlsCertificateInvalid);
        };
        self.trusted_roots[self.root_count] = root;
        self.root_count = self.root_count + 1;
        return Result::Ok(void);
    }

    fn verify_chain(self, chain: Array(TlsCertificate, TLS_MAX_CERT_CHAIN), chain_len: u64, now: u64) -> bool
        effect [deterministic]
    {
        if chain_len == 0 {
            return false;
        };
        // Check each certificate in chain
        loop bound TLS_MAX_CERT_CHAIN {
            if i >= chain_len { break; };
            if chain[i].is_expired(now) {
                return false;
            };
        };
        // Last cert must be trusted root or self-signed
        let last: TlsCertificate = chain[chain_len - 1];
        if !last.is_self_signed() {
            return false;
        };
        // Verify against trusted roots
        loop bound TLS_MAX_CERTS_IN_STORE {
            if i >= self.root_count { break; };
            if self.trusted_roots[i].serial_len == last.serial_len {
                let mut match_serial: bool = true;
                loop bound 32 {
                    if j >= last.serial_len { break; };
                    if self.trusted_roots[i].serial[j] != last.serial[j] {
                        match_serial = false; break;
                    };
                };
                if match_serial {
                    return true;
                };
            };
        };
        return last.is_trusted;
    }

    fn find_by_subject(self, subject: Array(u8, 256), subj_len: u64) -> Option(u64)
        effect [deterministic]
    {
        loop bound TLS_MAX_CERTS_IN_STORE {
            if i >= self.cert_count { break; };
            if self.certificates[i].subject_len == subj_len {
                let mut match_subj: bool = true;
                loop bound 256 {
                    if j >= subj_len { break; };
                    if self.certificates[i].subject[j] != subject[j] {
                        match_subj = false; break;
                    };
                };
                if match_subj {
                    return Option::Some(i);
                };
            };
        };
        return Option::None;
    }

    fn count_certs(self) -> u64
        effect [deterministic]
    {
        return self.cert_count;
    }

    fn count_roots(self) -> u64
        effect [deterministic]
    {
        return self.root_count;
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Application Data Protection
// ─────────────────────────────────────────────────────────────

struct TlsProtectionKeys {
    client_write_key: Array(u8, 32),
    server_write_key: Array(u8, 32),
    client_write_iv: Array(u8, 12),
    server_write_iv: Array(u8, 12),
    key_length: u8,
    iv_length: u8,
}

impl TlsProtectionKeys {
    fn new() -> TlsProtectionKeys
        effect [deterministic]
    {
        return TlsProtectionKeys {
            client_write_key: Array::zeroed(),
            server_write_key: Array::zeroed(),
            client_write_iv: Array::zeroed(),
            server_write_iv: Array::zeroed(),
            key_length: 16,
            iv_length: 12,
        };
    }

    fn derive_from_secret(self: ref mut, secret: Array(u8, TLS_KEY_BLOCK_SIZE), is_client: bool)
        effect [deterministic]
    {
        trusted reason "TLS 1.3 key expansion: HKDF-Expand-Label to derive write keys and IVs" {
            if is_client {
                self.client_write_key[0] = secret[0];
                self.client_write_iv[0] = secret[1];
            } else {
                self.server_write_key[0] = secret[0];
                self.server_write_iv[0] = secret[1];
            };
        };
    }
}

// ─────────────────────────────────────────────────────────────
// TLS Connection Parameters
// ─────────────────────────────────────────────────────────────

struct TlsConnectionParams {
    max_fragment_length: u16,
    alpn_protocol: Array(u8, 32),
    alpn_len: u64,
    server_name: Array(u8, 256),
    server_name_len: u64,
    session_ticket: Array(u8, 256),
    session_ticket_len: u64,
    ocsp_response: Array(u8, 1024),
    ocsp_response_len: u64,
    signed_cert_timestamps: Array(u8, 256),
    sct_len: u64,
    client_auth_requested: bool,
    early_data_enabled: bool,
}

impl TlsConnectionParams {
    fn new() -> TlsConnectionParams
        effect [deterministic]
    {
        return TlsConnectionParams {
            max_fragment_length: TLS_MAX_RECORD_SIZE as u16,
            alpn_protocol: Array::zeroed(),
            alpn_len: 0,
            server_name: Array::zeroed(),
            server_name_len: 0,
            session_ticket: Array::zeroed(),
            session_ticket_len: 0,
            ocsp_response: Array::zeroed(),
            ocsp_response_len: 0,
            signed_cert_timestamps: Array::zeroed(),
            sct_len: 0,
            client_auth_requested: false,
            early_data_enabled: false,
        };
    }
}

// ─────────────────────────────────────────────────────────────
// TLS 1.3 Handshake Transcript Hash
// ─────────────────────────────────────────────────────────────

struct TlsTranscriptHash {
    sha256_state: Array(u8, 8),
    sha384_state: Array(u8, 8),
    messages_hash: Array(u8, 64),
    hash_len: u64,
    final_hash: Array(u8, 48),
    final_hash_len: u64,
}

impl TlsTranscriptHash {
    fn new() -> TlsTranscriptHash
        effect [deterministic]
    {
        return TlsTranscriptHash {
            sha256_state: Array::zeroed(),
            sha384_state: Array::zeroed(),
            messages_hash: Array::zeroed(),
            hash_len: 0,
            final_hash: Array::zeroed(),
            final_hash_len: 32,
        };
    }

    fn feed(self: ref mut, data: Array(u8, TLS_MAX_RECORD_SIZE), data_len: u64)
        effect [deterministic]
    {
        trusted reason "SHA-256/SHA-384 transcript hash update for TLS 1.3" {
            self.messages_hash[0] = data[0];
            self.hash_len = self.hash_len + data_len;
        };
    }

    fn finalize(self: ref mut) -> Array(u8, 48)
        effect [deterministic]
    {
        trusted reason "Finalize TLS 1.3 transcript hash" {
            self.final_hash[0] = 0;
            self.final_hash_len = 32;
        };
        return self.final_hash;
    }

    fn get_hash(self) -> (Array(u8, 48), u64)
        effect [deterministic]
    {
        return (self.final_hash, self.final_hash_len);
    }

    fn reset(self: ref mut)
        effect [deterministic]
    {
        self.messages_hash = Array::zeroed();
        self.hash_len = 0;
        self.final_hash_len = 0;
    }
}
