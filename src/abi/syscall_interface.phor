fn handle_read_residual[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, alloc, unsafe) { default_return() }
fn handle_clear_residual[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, unsafe) { default_return() }
fn handle_query_residual_stats[args: *MarshaledSyscall] -> SyscallReturnValue : (syscall, pure) { default_return() }
