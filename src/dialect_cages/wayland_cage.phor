// ============================================================================
// wayland_cage.phor — Wayland Protocol Cage: Protocol Messages,
//                      Surface Management, Input Events
// ============================================================================
// The Wayland Protocol Cage handles foreign code that uses the Wayland
// display protocol. It intercepts Wayland protocol messages, translates
// them to native compositor operations, and records all interactions as
// residuals for progressive trust building.
//
// Wayland is an import dialect, not a native protocol. Each protocol
// message is observed, translated, and recorded for eventual native
// replacement.
// ============================================================================

package "phorensic:wayland_cage:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type WaylandCageError = enum {
    ProtocolNotMapped = 0x01,
    ObjectNotFound = 0x02,
    SurfaceNotFound = 0x03,
    BufferNotFound = 0x04,
    InvalidProtocolMessage = 0x05,
    ResourceExhausted = 0x06,
    CapabilityMissing = 0x07,
    UnsupportedProtocolVersion = 0x08,
    InvalidObjectID = 0x09,
    InvalidSurfaceState = 0x0A,
    ShmBufferInvalid = 0x0B,
    DmaBufInvalid = 0x0C,
    RegionInvalid = 0x0D,
    SeatNotFound = 0x0E,
    PointerNotFound = 0x0F,
    KeyboardNotFound = 0x10,
    TouchNotFound = 0x11,
    DataDeviceNotFound = 0x12,
    OutputNotFound = 0x13,
    ProtocolViolation = 0x14,
    InternalError = 0xFF,
}

// ============================================================================
// Wayland Protocol Constants
// ============================================================================

type WLObjectType = enum {
    Display = 0x01,
    Registry = 0x02,
    Callback = 0x03,
    Compositor = 0x04,
    ShmPool = 0x05,
    ShmBuffer = 0x06,
    Surface = 0x07,
    Region = 0x08,
    Subcompositor = 0x09,
    Subsurface = 0x0A,
    Shell = 0x0B,
    ShellSurface = 0x0C,
    Seat = 0x0D,
    Pointer = 0x0E,
    Keyboard = 0x0F,
    Touch = 0x10,
    Output = 0x11,
    DataDevice = 0x12,
    DataSource = 0x13,
    DataOffer = 0x14,
    WlBuffer = 0x15,
    XdgWmBase = 0x16,
    XdgSurface = 0x17,
    XdgToplevel = 0x18,
    XdgPopup = 0x19,
    ZxdgShellV6 = 0x1A,
    ZxdgSurfaceV6 = 0x1B,
    ZxdgToplevelV6 = 0x1C,
    ZxdgPopupV6 = 0x1D,
    Unknown = 0xFF,
}

type WLSurfaceState = enum {
    Initial = 0x01,
    Configured = 0x02,
    Mapped = 0x03,
    Unmapped = 0x04,
    Destroyed = 0x05,
}

type WLBufferType = enum {
    Shm = 0x01,
    DmaBuf = 0x02,
    EGLImage = 0x03,
    Custom = 0xFF,
}

// ============================================================================
// Hash256 and FixedString
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Wayland Protocol Objects
// ============================================================================

type WLObject = struct {
    object_id: u64,
    object_type: WLObjectType,
    protocol_name: FixedString[128],
    protocol_version: u64,
    is_alive: bool,
    parent_id: u64,
    creation_residual: Hash256,
}

type WLSurface = struct {
    surface_id: u64,
    state: WLSurfaceState,
    attached_buffer_id: Option[u64],
    damage_region: WLRect,
    opaque_region: WLRect,
    input_region: WLRect,
    scale: u64,
    transform: u64,
    buffer_transform: u64,
    buffer_scale: u64,
    frame_callbacks: Array[u64, 64],
    callback_count: u64,
    role: FixedString[64],
    role_object_id: u64,
    commit_count: u64,
    attach_count: u64,
    creation_residual: Hash256,
}

type WLRect = struct {
    x: i64,
    y: i64,
    width: u64,
    height: u64,
}

type WLBuffer = struct {
    buffer_id: u64,
    buffer_type: WLBufferType,
    width: u64,
    height: u64,
    stride: u64,
    shm_pool_id: u64,
    shm_offset: u64,
    is_released: bool,
    creation_residual: Hash256,
}

type WLShmPool = struct {
    pool_id: u64,
    fd: u64,
    size: u64,
    is_alive: bool,
}

type WLInputEvent = struct {
    event_type: FixedString[64],
    timestamp: u64,
    surface_id: u64,
    serial: u64,
    x: fixed_point,
    y: fixed_point,
    button: u64,
    state: u64,
    key: u64,
    key_state: u64,
    axis: u64,
    axis_value: fixed_point,
    touch_id: u64,
    touch_x: fixed_point,
    touch_y: fixed_point,
}

type fixed_point = struct {
    integer: i64,
    fractional: u64,
}

// ============================================================================
// Option Type
// ============================================================================

type Option[T] = enum {
    Some(value: T),
    None,
}

// ============================================================================
// Wayland Protocol Message
// ============================================================================

type WLProtocolMessage = struct {
    object_id: u64,
    opcode: u64,
    message_name: FixedString[256],
    args_hash: Hash256,
    timestamp: u64,
    serial: u64,
}

// ============================================================================
// Wayland Native Translation
// ============================================================================

type WLNativeTranslation = struct {
    wl_message: FixedString[256],
    wl_object_type: WLObjectType,
    wl_opcode: u64,
    native_operation: FixedString[256],
    confidence_score: u64,
    is_observed: bool,
    is_translated: bool,
    needs_capability: FixedString[128],
    residual_hash: Hash256,
}

// ============================================================================
// Wayland Cage
// ============================================================================

type WaylandCage = struct {
    cage_id: Hash256,
    objects: Array[WLObject, 256],
    object_count: u64,
    surfaces: Array[WLSurface, 64],
    surface_count: u64,
    buffers: Array[WLBuffer, 128],
    buffer_count: u64,
    shm_pools: Array[WLShmPool, 32],
    shm_pool_count: u64,
    input_events: Array[WLInputEvent, 512],
    input_event_count: u64,
    translations: Array[WLNativeTranslation, 512],
    translation_count: u64,
    protocol_version: u64,
    observation_count: u64,
    successful_translations: u64,
    failed_translations: u64,
    capabilities_granted: Array[FixedString[128], 64],
    cap_count: u64,
    generation: u64,
    compositor_name: FixedString[256],
    display_name: FixedString[256],
    is_connected: bool,
}

// ============================================================================
// Create Wayland Cage
// ============================================================================

fn create_wayland_cage(protocol_version: u64) -> WaylandCage
    effects: [compute]
{
    let empty_objects: Array[WLObject, 256] = Array[WLObject, 256]::zeroed();
    let empty_surfaces: Array[WLSurface, 64] = Array[WLSurface, 64]::zeroed();
    let empty_buffers: Array[WLBuffer, 128] = Array[WLBuffer, 128]::zeroed();
    let empty_pools: Array[WLShmPool, 32] = Array[WLShmPool, 32]::zeroed();
    let empty_events: Array[WLInputEvent, 512] = Array[WLInputEvent, 512]::zeroed();
    let empty_translations: Array[WLNativeTranslation, 512] = Array[WLNativeTranslation, 512]::zeroed();
    let empty_caps: Array[FixedString[128], 64] = Array[FixedString[128], 64]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    return WaylandCage {
        cage_id: zero_hash,
        objects: empty_objects,
        object_count: 0,
        surfaces: empty_surfaces,
        surface_count: 0,
        buffers: empty_buffers,
        buffer_count: 0,
        shm_pools: empty_pools,
        shm_pool_count: 0,
        input_events: empty_events,
        input_event_count: 0,
        translations: empty_translations,
        translation_count: 0,
        protocol_version: protocol_version,
        observation_count: 0,
        successful_translations: 0,
        failed_translations: 0,
        capabilities_granted: empty_caps,
        cap_count: 0,
        generation: 1,
        compositor_name: FixedString[256]::from_literal("phorensic-compositor"),
        display_name: FixedString[256]::from_literal("wayland-0"),
        is_connected: false,
    };
}

// ============================================================================
// Connect Wayland Display
// ============================================================================

fn wl_connect_display(cage: &mut WaylandCage, display_name: &FixedString[256]) -> Result[u64, WaylandCageError]
    effects: [compute, io, residual]
{
    cage.display_name = *display_name;
    cage.is_connected = true;

    // Create display object
    if cage.object_count < 256 {
        let display_obj: WLObject = WLObject {
            object_id: 1,
            object_type: WLObjectType::Display,
            protocol_name: FixedString[128]::from_literal("wl_display"),
            protocol_version: cage.protocol_version,
            is_alive: true,
            parent_id: 0,
            creation_residual: Hash256 { bytes: Array[u8, 32]::zeroed() },
        };
        cage.objects[cage.object_count] = display_obj;
        cage.object_count = cage.object_count + 1;
    }

    // Create registry object
    if cage.object_count < 256 {
        let registry_obj: WLObject = WLObject {
            object_id: 2,
            object_type: WLObjectType::Registry,
            protocol_name: FixedString[128]::from_literal("wl_registry"),
            protocol_version: cage.protocol_version,
            is_alive: true,
            parent_id: 1,
            creation_residual: Hash256 { bytes: Array[u8, 32]::zeroed() },
        };
        cage.objects[cage.object_count] = registry_obj;
        cage.object_count = cage.object_count + 1;
    }

    @emit_residual("wayland_cage.connect", "display_connected", 0);

    return Ok(cage.object_count);
}

// ============================================================================
// Map Wayland Message to Native Operation
// ============================================================================

fn map_wayland_message(object_type: WLObjectType, opcode: u64, message_name: &FixedString[256]) -> Result[WLNativeTranslation, WaylandCageError]
    effects: [compute, residual]
{
    let mut native_op: FixedString[256] = FixedString[256]::zeroed();
    let mut confidence: u64 = 50;
    let mut needs_cap: FixedString[128] = FixedString[128]::zeroed();

    match object_type {
        WLObjectType::Display => {
            if opcode == 0 {  // sync
                native_op = FixedString[256]::from_literal("compositor.roundtrip");
                confidence = 90;
            } elif opcode == 1 {  // get_registry
                native_op = FixedString[256]::from_literal("compositor.get_registry");
                confidence = 95;
            }
        }
        WLObjectType::Registry => {
            if opcode == 0 {  // bind
                native_op = FixedString[256]::from_literal("compositor.bind_global");
                confidence = 80;
                needs_cap = FixedString[128]::from_literal("compositor_bind");
            }
        }
        WLObjectType::Compositor => {
            if opcode == 0 {  // create_surface
                native_op = FixedString[256]::from_literal("compositor.create_surface");
                confidence = 95;
                needs_cap = FixedString[128]::from_literal("compositor_surface");
            } elif opcode == 1 {  // create_region
                native_op = FixedString[256]::from_literal("compositor.create_region");
                confidence = 90;
            }
        }
        WLObjectType::Surface => {
            if opcode == 0 {  // destroy
                native_op = FixedString[256]::from_literal("compositor.destroy_surface");
                confidence = 95;
            } elif opcode == 1 {  // attach
                native_op = FixedString[256]::from_literal("compositor.attach_buffer");
                confidence = 85;
            } elif opcode == 2 {  // damage
                native_op = FixedString[256]::from_literal("compositor.damage_surface");
                confidence = 85;
            } elif opcode == 3 {  // frame
                native_op = FixedString[256]::from_literal("compositor.request_frame");
                confidence = 90;
            } elif opcode == 4 {  // set_opaque_region
                native_op = FixedString[256]::from_literal("compositor.set_opaque_region");
                confidence = 80;
            } elif opcode == 5 {  // set_input_region
                native_op = FixedString[256]::from_literal("compositor.set_input_region");
                confidence = 80;
            } elif opcode == 6 {  // commit
                native_op = FixedString[256]::from_literal("compositor.commit_surface");
                confidence = 95;
            } elif opcode == 7 {  // set_buffer_transform
                native_op = FixedString[256]::from_literal("compositor.set_buffer_transform");
                confidence = 75;
            } elif opcode == 8 {  // set_buffer_scale
                native_op = FixedString[256]::from_literal("compositor.set_buffer_scale");
                confidence = 75;
            } elif opcode == 9 {  // damage_buffer
                native_op = FixedString[256]::from_literal("compositor.damage_buffer");
                confidence = 85;
            }
        }
        WLObjectType::Seat => {
            if opcode == 0 {  // get_pointer
                native_op = FixedString[256]::from_literal("seat.get_pointer");
                confidence = 90;
            } elif opcode == 1 {  // get_keyboard
                native_op = FixedString[256]::from_literal("seat.get_keyboard");
                confidence = 90;
            } elif opcode == 2 {  // get_touch
                native_op = FixedString[256]::from_literal("seat.get_touch");
                confidence = 90;
            }
        }
        WLObjectType::Pointer => {
            if opcode == 0 {  // set_cursor
                native_op = FixedString[256]::from_literal("pointer.set_cursor");
                confidence = 85;
            } elif opcode == 1 {  // release
                native_op = FixedString[256]::from_literal("pointer.release");
                confidence = 95;
            }
        }
        WLObjectType::XdgToplevel => {
            if opcode == 0 {  // destroy
                native_op = FixedString[256]::from_literal("xdg.destroy_toplevel");
                confidence = 95;
            } elif opcode == 1 {  // set_parent
                native_op = FixedString[256]::from_literal("xdg.set_parent");
                confidence = 85;
            } elif opcode == 2 {  // set_title
                native_op = FixedString[256]::from_literal("xdg.set_title");
                confidence = 95;
            } elif opcode == 3 {  // set_app_id
                native_op = FixedString[256]::from_literal("xdg.set_app_id");
                confidence = 90;
            } elif opcode == 4 {  // show_window_menu
                native_op = FixedString[256]::from_literal("xdg.show_window_menu");
                confidence = 70;
            } elif opcode == 5 {  // move
                native_op = FixedString[256]::from_literal("xdg.move");
                confidence = 75;
            } elif opcode == 6 {  // resize
                native_op = FixedString[256]::from_literal("xdg.resize");
                confidence = 75;
            } elif opcode == 7 {  // set_max_size
                native_op = FixedString[256]::from_literal("xdg.set_max_size");
                confidence = 85;
            } elif opcode == 8 {  // set_min_size
                native_op = FixedString[256]::from_literal("xdg.set_min_size");
                confidence = 85;
            } elif opcode == 9 {  // set_maximized
                native_op = FixedString[256]::from_literal("xdg.set_maximized");
                confidence = 85;
            } elif opcode == 10 {  // unset_maximized
                native_op = FixedString[256]::from_literal("xdg.unset_maximized");
                confidence = 85;
            } elif opcode == 11 {  // set_fullscreen
                native_op = FixedString[256]::from_literal("xdg.set_fullscreen");
                confidence = 85;
            } elif opcode == 12 {  // unset_fullscreen
                native_op = FixedString[256]::from_literal("xdg.unset_fullscreen");
                confidence = 85;
            } elif opcode == 13 {  // set_minimized
                native_op = FixedString[256]::from_literal("xdg.set_minimized");
                confidence = 80;
            }
        }
        WLObjectType::Output => {
            if opcode == 0 {  // release
                native_op = FixedString[256]::from_literal("output.release");
                confidence = 95;
            }
        }
        WLObjectType::ShmPool => {
            if opcode == 0 {  // create_buffer
                native_op = FixedString[256]::from_literal("shm.create_buffer");
                confidence = 90;
            } elif opcode == 1 {  // destroy
                native_op = FixedString[256]::from_literal("shm.destroy_pool");
                confidence = 95;
            } elif opcode == 2 {  // resize
                native_op = FixedString[256]::from_literal("shm.resize_pool");
                confidence = 80;
            }
        }
        _ => {
            native_op = FixedString[256]::from_literal("wayland.generic_message");
            confidence = 20;
        }
    }

    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    let translation: WLNativeTranslation = WLNativeTranslation {
        wl_message: *message_name,
        wl_object_type: object_type,
        wl_opcode: opcode,
        native_operation: native_op,
        confidence_score: confidence,
        is_observed: true,
        is_translated: confidence >= 50,
        needs_capability: needs_cap,
        residual_hash: zero_hash,
    };

    @emit_residual("wayland_cage.translate", "message_mapped", opcode);

    return Ok(translation);
}

// ============================================================================
// Intercept Wayland Message
// ============================================================================
// Intercepts a Wayland protocol message and translates it.

fn intercept_wayland_message(cage: &mut WaylandCage, msg: &WLProtocolMessage) -> Result[WLNativeTranslation, WaylandCageError]
    effects: [compute, residual]
{
    // Find the object
    let mut obj_type: WLObjectType = WLObjectType::Unknown;
    for i in 0..cage.object_count {
        if cage.objects[i].object_id == msg.object_id && cage.objects[i].is_alive {
            obj_type = cage.objects[i].object_type;
            break;
        }
    }

    if obj_type == WLObjectType::Unknown {
        return Err(WaylandCageError::ObjectNotFound);
    }

    // Check if translation already exists
    for i in 0..cage.translation_count {
        if cage.translations[i].wl_opcode == msg.opcode &&
           cage.translations[i].wl_object_type == obj_type {
            cage.observation_count = cage.observation_count + 1;
            cage.translations[i].is_observed = true;

            @emit_residual("wayland_cage.intercept", "message_reobserved", msg.opcode);
            return Ok(cage.translations[i]);
        }
    }

    // Create new translation
    let translation: WLNativeTranslation = map_wayland_message(obj_type, msg.opcode, &msg.message_name)?;

    if cage.translation_count < 512 {
        cage.translations[cage.translation_count] = translation;
        cage.translation_count = cage.translation_count + 1;

        if translation.is_translated {
            cage.successful_translations = cage.successful_translations + 1;
        } else {
            cage.failed_translations = cage.failed_translations + 1;
        }
    }

    cage.observation_count = cage.observation_count + 1;

    @emit_residual("wayland_cage.intercept", "new_message_intercepted", msg.opcode);

    return Ok(translation);
}

// ============================================================================
// Surface Management
// ============================================================================

fn create_wl_surface(cage: &mut WaylandCage, surface_id: u64, object_id: u64) -> Result[u64, WaylandCageError]
    effects: [compute, residual]
{
    if cage.surface_count >= 64 {
        return Err(WaylandCageError::ResourceExhausted);
    }

    // Check for duplicate surface ID
    for i in 0..cage.surface_count {
        if cage.surfaces[i].surface_id == surface_id {
            return Err(WaylandCageError::SurfaceNotFound);
        }
    }

    let surface: WLSurface = WLSurface {
        surface_id: surface_id,
        state: WLSurfaceState::Initial,
        attached_buffer_id: Option::None,
        damage_region: WLRect { x: 0, y: 0, width: 0, height: 0 },
        opaque_region: WLRect { x: 0, y: 0, width: 0, height: 0 },
        input_region: WLRect { x: 0, y: 0, width: 0, height: 0 },
        scale: 1,
        transform: 0,
        buffer_transform: 0,
        buffer_scale: 1,
        frame_callbacks: Array[u64, 64]::zeroed(),
        callback_count: 0,
        role: FixedString[64]::zeroed(),
        role_object_id: 0,
        commit_count: 0,
        attach_count: 0,
        creation_residual: Hash256 { bytes: Array[u8, 32]::zeroed() },
    };

    cage.surfaces[cage.surface_count] = surface;
    cage.surface_count = cage.surface_count + 1;

    @emit_residual("wayland_cage.surface_create", "surface_created", surface_id);

    return Ok(surface_id);
}

fn attach_buffer_to_surface(cage: &mut WaylandCage, surface_id: u64, buffer_id: u64) -> Result[(), WaylandCageError]
    effects: [compute, residual]
{
    // Find the surface
    let mut surface_found: bool = false;
    for i in 0..cage.surface_count {
        if cage.surfaces[i].surface_id == surface_id {
            if cage.surfaces[i].state == WLSurfaceState::Destroyed {
                return Err(WaylandCageError::InvalidSurfaceState);
            }
            cage.surfaces[i].attached_buffer_id = Option::Some(buffer_id);
            cage.surfaces[i].attach_count = cage.surfaces[i].attach_count + 1;
            surface_found = true;
            break;
        }
    }

    if !surface_found {
        return Err(WaylandCageError::SurfaceNotFound);
    }

    // Verify buffer exists (but don't require it — Wayland allows null buffer)
    if buffer_id != 0 {
        let mut buffer_found: bool = false;
        for i in 0..cage.buffer_count {
            if cage.buffers[i].buffer_id == buffer_id {
                buffer_found = true;
                break;
            }
        }
        if !buffer_found {
            return Err(WaylandCageError::BufferNotFound);
        }
    }

    @emit_residual("wayland_cage.surface_attach", "buffer_attached", surface_id);

    return Ok(());
}

fn commit_wl_surface(cage: &mut WaylandCage, surface_id: u64) -> Result[WLSurfaceState, WaylandCageError]
    effects: [compute, io, residual]
{
    for i in 0..cage.surface_count {
        if cage.surfaces[i].surface_id == surface_id {
            if cage.surfaces[i].state == WLSurfaceState::Destroyed {
                return Err(WaylandCageError::InvalidSurfaceState);
            }

            // Transition state
            if cage.surfaces[i].state == WLSurfaceState::Initial {
                cage.surfaces[i].state = WLSurfaceState::Configured;
            }

            if cage.surfaces[i].attached_buffer_id != Option::None {
                cage.surfaces[i].state = WLSurfaceState::Mapped;
            }

            cage.surfaces[i].commit_count = cage.surfaces[i].commit_count + 1;

            @emit_residual("wayland_cage.surface_commit", "surface_committed", surface_id);

            return Ok(cage.surfaces[i].state);
        }
    }

    return Err(WaylandCageError::SurfaceNotFound);
}

fn damage_wl_surface(cage: &mut WaylandCage, surface_id: u64, x: i64, y: i64, width: u64, height: u64) -> Result[(), WaylandCageError]
    effects: [compute, residual]
{
    for i in 0..cage.surface_count {
        if cage.surfaces[i].surface_id == surface_id {
            cage.surfaces[i].damage_region = WLRect { x: x, y: y, width: width, height: height };

            @emit_residual("wayland_cage.surface_damage", "surface_damaged", surface_id);
            return Ok(());
        }
    }

    return Err(WaylandCageError::SurfaceNotFound);
}

fn destroy_wl_surface(cage: &mut WaylandCage, surface_id: u64) -> Result[(), WaylandCageError]
    effects: [compute, residual]
{
    for i in 0..cage.surface_count {
        if cage.surfaces[i].surface_id == surface_id {
            cage.surfaces[i].state = WLSurfaceState::Destroyed;
            cage.surfaces[i].attached_buffer_id = Option::None;

            @emit_residual("wayland_cage.surface_destroy", "surface_destroyed", surface_id);
            return Ok(());
        }
    }

    return Err(WaylandCageError::SurfaceNotFound);
}

// ============================================================================
// Buffer Management
// ============================================================================

fn create_wl_shm_buffer(cage: &mut WaylandCage, buffer_id: u64, pool_id: u64, offset: u64, width: u64, height: u64, stride: u64) -> Result[u64, WaylandCageError]
    effects: [compute, residual]
{
    if cage.buffer_count >= 128 {
        return Err(WaylandCageError::ResourceExhausted);
    }

    // Verify SHM pool exists
    let mut pool_found: bool = false;
    for i in 0..cage.shm_pool_count {
        if cage.shm_pools[i].pool_id == pool_id && cage.shm_pools[i].is_alive {
            pool_found = true;
            break;
        }
    }

    if !pool_found {
        return Err(WaylandCageError::ShmBufferInvalid);
    }

    let buffer: WLBuffer = WLBuffer {
        buffer_id: buffer_id,
        buffer_type: WLBufferType::Shm,
        width: width,
        height: height,
        stride: stride,
        shm_pool_id: pool_id,
        shm_offset: offset,
        is_released: false,
        creation_residual: Hash256 { bytes: Array[u8, 32]::zeroed() },
    };

    cage.buffers[cage.buffer_count] = buffer;
    cage.buffer_count = cage.buffer_count + 1;

    @emit_residual("wayland_cage.buffer_create_shm", "shm_buffer_created", buffer_id);

    return Ok(buffer_id);
}

fn release_wl_buffer(cage: &mut WaylandCage, buffer_id: u64) -> Result[(), WaylandCageError]
    effects: [compute, residual]
{
    for i in 0..cage.buffer_count {
        if cage.buffers[i].buffer_id == buffer_id {
            cage.buffers[i].is_released = true;

            @emit_residual("wayland_cage.buffer_release", "buffer_released", buffer_id);
            return Ok(());
        }
    }

    return Err(WaylandCageError::BufferNotFound);
}

// ============================================================================
// SHM Pool Management
// ============================================================================

fn create_wl_shm_pool(cage: &mut WaylandCage, pool_id: u64, fd: u64, size: u64) -> Result[u64, WaylandCageError]
    effects: [compute, io, residual]
{
    if cage.shm_pool_count >= 32 {
        return Err(WaylandCageError::ResourceExhausted);
    }

    let pool: WLShmPool = WLShmPool {
        pool_id: pool_id,
        fd: fd,
        size: size,
        is_alive: true,
    };

    cage.shm_pools[cage.shm_pool_count] = pool;
    cage.shm_pool_count = cage.shm_pool_count + 1;

    @emit_residual("wayland_cage.shm_pool_create", "shm_pool_created", pool_id);

    return Ok(pool_id);
}

fn resize_wl_shm_pool(cage: &mut WaylandCage, pool_id: u64, new_size: u64) -> Result[(), WaylandCageError]
    effects: [compute, residual]
{
    for i in 0..cage.shm_pool_count {
        if cage.shm_pools[i].pool_id == pool_id && cage.shm_pools[i].is_alive {
            cage.shm_pools[i].size = new_size;

            @emit_residual("wayland_cage.shm_pool_resize", "shm_pool_resized", pool_id);
            return Ok(());
        }
    }

    return Err(WaylandCageError::ShmBufferInvalid);
}

// ============================================================================
// Input Event Handling
// ============================================================================

fn record_input_event(cage: &mut WaylandCage, event: WLInputEvent) -> Result[u64, WaylandCageError]
    effects: [compute, residual]
{
    if cage.input_event_count >= 512 {
        return Err(WaylandCageError::ResourceExhausted);
    }

    cage.input_events[cage.input_event_count] = event;
    cage.input_event_count = cage.input_event_count + 1;

    @emit_residual("wayland_cage.input_event", "input_event_recorded", cage.input_event_count);

    return Ok(cage.input_event_count);
}

fn process_pointer_event(cage: &mut WaylandCage, surface_id: u64, event_type: &FixedString[64], x: i64, y: i64, serial: u64) -> Result[u64, WaylandCageError]
    effects: [compute, io, residual]
{
    let event: WLInputEvent = WLInputEvent {
        event_type: *event_type,
        timestamp: kernel.tick_count(),
        surface_id: surface_id,
        serial: serial,
        x: fixed_point { integer: x, fractional: 0 },
        y: fixed_point { integer: y, fractional: 0 },
        button: 0,
        state: 0,
        key: 0,
        key_state: 0,
        axis: 0,
        axis_value: fixed_point { integer: 0, fractional: 0 },
        touch_id: 0,
        touch_x: fixed_point { integer: 0, fractional: 0 },
        touch_y: fixed_point { integer: 0, fractional: 0 },
    };

    return record_input_event(cage, event);
}

fn process_keyboard_event(cage: &mut WaylandCage, surface_id: u64, event_type: &FixedString[64], key: u64, key_state: u64, serial: u64) -> Result[u64, WaylandCageError]
    effects: [compute, io, residual]
{
    let event: WLInputEvent = WLInputEvent {
        event_type: *event_type,
        timestamp: kernel.tick_count(),
        surface_id: surface_id,
        serial: serial,
        x: fixed_point { integer: 0, fractional: 0 },
        y: fixed_point { integer: 0, fractional: 0 },
        button: 0,
        state: 0,
        key: key,
        key_state: key_state,
        axis: 0,
        axis_value: fixed_point { integer: 0, fractional: 0 },
        touch_id: 0,
        touch_x: fixed_point { integer: 0, fractional: 0 },
        touch_y: fixed_point { integer: 0, fractional: 0 },
    };

    return record_input_event(cage, event);
}

fn process_touch_event(cage: &mut WaylandCage, surface_id: u64, event_type: &FixedString[64], touch_id: u64, x: i64, y: i64, serial: u64) -> Result[u64, WaylandCageError]
    effects: [compute, io, residual]
{
    let event: WLInputEvent = WLInputEvent {
        event_type: *event_type,
        timestamp: kernel.tick_count(),
        surface_id: surface_id,
        serial: serial,
        x: fixed_point { integer: 0, fractional: 0 },
        y: fixed_point { integer: 0, fractional: 0 },
        button: 0,
        state: 0,
        key: 0,
        key_state: 0,
        axis: 0,
        axis_value: fixed_point { integer: 0, fractional: 0 },
        touch_id: touch_id,
        touch_x: fixed_point { integer: x, fractional: 0 },
        touch_y: fixed_point { integer: y, fractional: 0 },
    };

    return record_input_event(cage, event);
}

// ============================================================================
// Wayland Object Management
// ============================================================================

fn create_wl_object(cage: &mut WaylandCage, object_id: u64, object_type: WLObjectType, parent_id: u64) -> Result[u64, WaylandCageError]
    effects: [compute, residual]
{
    if cage.object_count >= 256 {
        return Err(WaylandCageError::ResourceExhausted);
    }

    // Check for duplicate
    for i in 0..cage.object_count {
        if cage.objects[i].object_id == object_id {
            return Err(WaylandCageError::InvalidObjectID);
        }
    }

    let obj: WLObject = WLObject {
        object_id: object_id,
        object_type: object_type,
        protocol_name: FixedString[128]::zeroed(),
        protocol_version: cage.protocol_version,
        is_alive: true,
        parent_id: parent_id,
        creation_residual: Hash256 { bytes: Array[u8, 32]::zeroed() },
    };

    cage.objects[cage.object_count] = obj;
    cage.object_count = cage.object_count + 1;

    return Ok(object_id);
}

fn destroy_wl_object(cage: &mut WaylandCage, object_id: u64) -> Result[(), WaylandCageError]
    effects: [compute, residual]
{
    for i in 0..cage.object_count {
        if cage.objects[i].object_id == object_id {
            cage.objects[i].is_alive = false;

            @emit_residual("wayland_cage.object_destroy", "object_destroyed", object_id);
            return Ok(());
        }
    }

    return Err(WaylandCageError::ObjectNotFound);
}

// ============================================================================
// Grant Wayland Capability
// ============================================================================

fn grant_wayland_capability(cage: &mut WaylandCage, cap_name: &FixedString[128]) -> Result[(), WaylandCageError]
    effects: [compute, residual]
{
    if cage.cap_count >= 64 {
        return Err(WaylandCageError::ResourceExhausted);
    }

    cage.capabilities_granted[cage.cap_count] = *cap_name;
    cage.cap_count = cage.cap_count + 1;

    @emit_residual("wayland_cage.grant_cap", "capability_granted", cage.cap_count);

    return Ok(());
}

// ============================================================================
// Get Wayland Cage Statistics
// ============================================================================

type WaylandCageStats = struct {
    object_count: u64,
    surface_count: u64,
    buffer_count: u64,
    shm_pool_count: u64,
    input_event_count: u64,
    translation_count: u64,
    successful_translations: u64,
    failed_translations: u64,
    observation_count: u64,
    protocol_version: u64,
    is_connected: bool,
    mapped_surfaces: u64,
    configured_surfaces: u64,
    destroyed_surfaces: u64,
    total_commits: u64,
    total_attaches: u64,
}

fn get_wayland_cage_stats(cage: &WaylandCage) -> WaylandCageStats
    effects: [compute]
{
    let mut mapped: u64 = 0;
    let mut configured: u64 = 0;
    let mut destroyed: u64 = 0;
    let mut total_commits: u64 = 0;
    let mut total_attaches: u64 = 0;

    for i in 0..cage.surface_count {
        match cage.surfaces[i].state {
            WLSurfaceState::Mapped => mapped = mapped + 1,
            WLSurfaceState::Configured => configured = configured + 1,
            WLSurfaceState::Destroyed => destroyed = destroyed + 1,
            _ => {}
        }
        total_commits = total_commits + cage.surfaces[i].commit_count;
        total_attaches = total_attaches + cage.surfaces[i].attach_count;
    }

    return WaylandCageStats {
        object_count: cage.object_count,
        surface_count: cage.surface_count,
        buffer_count: cage.buffer_count,
        shm_pool_count: cage.shm_pool_count,
        input_event_count: cage.input_event_count,
        translation_count: cage.translation_count,
        successful_translations: cage.successful_translations,
        failed_translations: cage.failed_translations,
        observation_count: cage.observation_count,
        protocol_version: cage.protocol_version,
        is_connected: cage.is_connected,
        mapped_surfaces: mapped,
        configured_surfaces: configured,
        destroyed_surfaces: destroyed,
        total_commits: total_commits,
        total_attaches: total_attaches,
    };
}

// ============================================================================
// Init Wayland Cage with Common Protocol Bindings
// ============================================================================
// Pre-populates a Wayland cage with standard protocol bindings.

fn init_wayland_protocol_bindings(cage: &mut WaylandCage) -> Result[u64, WaylandCageError>
    effects: [compute, residual]
{
    let mut initialized_count: u64 = 0;

    // Pre-populate standard Wayland core protocol message translations
    let core_messages: Array[(WLObjectType, u64, FixedString[128]), 64] = fixed_buf! [
        (WLObjectType::Display, 0, "sync"),
        (WLObjectType::Display, 1, "get_registry"),
        (WLObjectType::Registry, 0, "bind"),
        (WLObjectType::Compositor, 0, "create_surface"),
        (WLObjectType::Compositor, 1, "create_region"),
        (WLObjectType::Surface, 0, "destroy"),
        (WLObjectType::Surface, 1, "attach"),
        (WLObjectType::Surface, 2, "damage"),
        (WLObjectType::Surface, 3, "frame"),
        (WLObjectType::Surface, 4, "set_opaque_region"),
        (WLObjectType::Surface, 5, "set_input_region"),
        (WLObjectType::Surface, 6, "commit"),
        (WLObjectType::Surface, 7, "set_buffer_transform"),
        (WLObjectType::Surface, 8, "set_buffer_scale"),
        (WLObjectType::Surface, 9, "damage_buffer"),
        (WLObjectType::Seat, 0, "get_pointer"),
        (WLObjectType::Seat, 1, "get_keyboard"),
        (WLObjectType::Seat, 2, "get_touch"),
        (WLObjectType::Pointer, 0, "set_cursor"),
        (WLObjectType::Pointer, 1, "release"),
        (WLObjectType::ShmPool, 0, "create_buffer"),
        (WLObjectType::ShmPool, 1, "destroy"),
        (WLObjectType::ShmPool, 2, "resize"),
        (WLObjectType::XdgToplevel, 0, "destroy"),
        (WLObjectType::XdgToplevel, 1, "set_parent"),
        (WLObjectType::XdgToplevel, 2, "set_title"),
        (WLObjectType::XdgToplevel, 3, "set_app_id"),
        (WLObjectType::XdgToplevel, 4, "show_window_menu"),
        (WLObjectType::XdgToplevel, 5, "move"),
        (WLObjectType::XdgToplevel, 6, "resize"),
        (WLObjectType::XdgToplevel, 7, "set_max_size"),
        (WLObjectType::XdgToplevel, 8, "set_min_size"),
        (WLObjectType::XdgToplevel, 9, "set_maximized"),
        (WLObjectType::XdgToplevel, 10, "unset_maximized"),
        (WLObjectType::XdgToplevel, 11, "set_fullscreen"),
        (WLObjectType::XdgToplevel, 12, "unset_fullscreen"),
        (WLObjectType::XdgToplevel, 13, "set_minimized"),
        (WLObjectType::Output, 0, "release"),
    ];

    for i in 0..38 {
        let (obj_type, opcode, msg_name): (WLObjectType, u64, FixedString[128]) = core_messages[i];
        if msg_name.len == 0 {
            break;
        }

        let translation: WLNativeTranslation = map_wayland_message(obj_type, opcode, &msg_name)?;
        if cage.translation_count < 512 {
            cage.translations[cage.translation_count] = translation;
            cage.translation_count = cage.translation_count + 1;
            initialized_count = initialized_count + 1;
        }
    }

    @emit_residual("wayland_cage.init", "protocol_bindings_initialized", initialized_count);

    return Ok(initialized_count);
}
