// file: crypto_core.phor
// purpose: Cryptographic core: algorithm registry, constant-time comparison,
//          secure memory zeroing, random generation, algorithm agility.
// evidence: CORE-ARCH-001 through CORE-ARCH-200
// residual: All operations are deterministic with bounded loops.

package "phorensic:crypto:crypto_core:v1.0";

use core::constants::*
use core::types::*
use core::math::*
use core::errors::*
use core::collections::*

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────
// Evidence path: CORE-CONST-001 through CORE-CONST-025

const CRYPTO_CORE_REGISTRY_SIZE : u32 = 32
const CRYPTO_CORE_ALGO_NAME_LEN : u32 = 32
const CRYPTO_CORE_MAX_SECRET_LEN : u32 = 4096

// ──────────────────────────────────────────────
// Algorithm Categories
// ──────────────────────────────────────────────
// Evidence path: CORE-CAT-001 through CORE-CAT-015

pub type AlgoCategory : u8 = enum {
    Hash = 0,
    Cipher = 1,
    MAC = 2,
    KeyExchange = 3,
    Signature = 4,
    DRBG = 5,
    AEAD = 6,
    KDF = 7,
    Unspecified = 0xFF,
}

pub type AlgoSecurityLevel : u8 = enum {
    Unknown = 0,
    Weak = 1,       // < 80 bits
    Legacy = 2,     // 80-112 bits
    Acceptable = 3, // 112-128 bits
    Strong = 4,     // 128-192 bits
    VeryStrong = 5, // 192-256 bits
    QuantumSafe = 6,// Post-quantum
}

// ──────────────────────────────────────────────
// Algorithm Registry Entry
// ──────────────────────────────────────────────
// Evidence path: CORE-REG-001 through CORE-REG-040

pub type AlgorithmEntry : struct {
    name: FixedString[32],
    category: AlgoCategory,
    security_level: AlgoSecurityLevel,
    is_available: bool,
    is_fips_compliant: bool,
    is_constant_time: bool,
    key_size: u32,
    digest_size: u32,
    block_size: u32,
}

pub type AlgorithmRegistry : struct {
    entries: FixedArray[32, AlgorithmEntry],
    count: u32,
}

impl AlgorithmRegistry {
    pub fn new() -> AlgorithmRegistry
        effects: [deterministic]
    {
        AlgorithmRegistry {
            entries: FixedArray::new(),
            count: 0,
        }
    }

    // Register an algorithm.
    pub fn register(self: ref mut, name: FixedString[32], category: AlgoCategory, security: AlgoSecurityLevel,
                     fips: bool, ct: bool, key_sz: u32, dig_sz: u32, blk_sz: u32) -> Result<(), RegistryError>
        effects: [deterministic]
    {
        if self.count >= CRYPTO_CORE_REGISTRY_SIZE {
            return Result::Err(RegistryError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x400),
                FixedString[128]::from_slice("registry: capacity full")))
        }

        // Check for duplicate
        // loop: bounds[BOUND_SMALL] — bounded by registry size
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if self.entries[i as usize].name == name {
                return Result::Err(RegistryError::new(
                    Word64::from_u64(DIAG_CRYPTO_BASE | 0x401),
                    FixedString[128]::from_slice("registry: duplicate name")))
            }
        }

        let entry: AlgorithmEntry = AlgorithmEntry {
            name: name,
            category: category,
            security_level: security,
            is_available: true,
            is_fips_compliant: fips,
            is_constant_time: ct,
            key_size: key_sz,
            digest_size: dig_sz,
            block_size: blk_sz,
        }
        let _ = self.entries.push(entry)
        self.count = self.count + 1
        Result::Ok(())
    }

    // Find an algorithm by name.
    pub fn find(self, name: ref FixedString[32]) -> Result[AlgorithmEntry, RegistryError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by registry size
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if self.entries[i as usize].name == *name {
                return Result::Ok(self.entries[i as usize])
            }
        }
        Result::Err(RegistryError::new(
            Word64::from_u64(DIAG_CRYPTO_BASE | 0x402),
            FixedString[128]::from_slice("registry: algorithm not found")))
    }

    // Find algorithms by category.
    pub fn find_by_category(self, category: AlgoCategory) -> FixedArray[32, FixedString[32]]
        effects: [deterministic]
    {
        let mut results: FixedArray[32, FixedString[32]] = FixedArray::new()
        // loop: bounds[BOUND_SMALL] — bounded by registry size
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if self.entries[i as usize].category == category && self.entries[i as usize].is_available {
                let _ = results.push(self.entries[i as usize].name)
            }
        }
        results
    }

    // Set algorithm availability (enable/disable).
    pub fn set_availability(self: ref mut, name: ref FixedString[32], available: bool) -> Result<(), RegistryError>
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by registry size
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if self.entries[i as usize].name == *name {
                self.entries[i as usize].is_available = available
                return Result::Ok(())
            }
        }
        Result::Err(RegistryError::new(
            Word64::from_u64(DIAG_CRYPTO_BASE | 0x403),
            FixedString[128]::from_slice("registry: algorithm not found for availability")))
    }

    // Get the count of registered algorithms.
    pub fn count(self) -> u32
        effects: [deterministic]
    {
        self.count
    }

    // Get the number of available algorithms.
    pub fn available_count(self) -> u32
        effects: [deterministic]
    {
        let mut avail: u32 = 0
        // loop: bounds[BOUND_SMALL] — bounded by registry size
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if self.entries[i as usize].is_available {
                avail = avail + 1
            }
        }
        avail
    }

    // Check if a specific algorithm is available.
    pub fn is_available(self, name: ref FixedString[32]) -> bool
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by registry size
        loop: bounds[BOUND_SMALL] for i in 0..self.count {
            if self.entries[i as usize].name == *name {
                return self.entries[i as usize].is_available
            }
        }
        false
    }

    // Clear all entries.
    pub fn clear(self: ref mut)
        effects: [deterministic]
    {
        self.entries.clear()
        self.count = 0
    }
}

// ──────────────────────────────────────────────
// Constant-Time Operations
// ──────────────────────────────────────────────
// Evidence path: CORE-CTIME-001 through CORE-CTIME-040

pub fn constant_time_compare_u8(a: ref Byte[], b: ref Byte[], len: u32) -> bool
    effects: [deterministic]
{
    let mut diff: u8 = 0
    // loop: bounds[BOUND_MEDIUM] — bounded by len, constant-time
    loop: bounds[BOUND_MEDIUM] for i in 0..len {
        diff = diff | (a[i as usize].to_u8() ^ b[i as usize].to_u8())
    }
    diff == 0
}

pub fn constant_time_compare_u32(a: u32, b: u32) -> bool
    effects: [deterministic]
{
    let diff: u32 = a ^ b
    diff == 0
}

pub fn constant_time_compare_u64(a: u64, b: u64) -> bool
    effects: [deterministic]
{
    let diff: u64 = a ^ b
    diff == 0
}

pub fn constant_time_select_u8(cond: bool, true_val: u8, false_val: u8) -> u8
    effects: [deterministic]
{
    let mask: u8 = if cond { 0xFF } else { 0x00 }
    (mask & true_val) | (!mask & false_val)
}

pub fn constant_time_select_u32(cond: bool, true_val: u32, false_val: u32) -> u32
    effects: [deterministic]
{
    let mask: u32 = if cond { 0xFFFFFFFF } else { 0 }
    (mask & true_val) | (!mask & false_val)
}

pub fn constant_time_select_u64(cond: bool, true_val: u64, false_val: u64) -> u64
    effects: [deterministic]
{
    let mask: u64 = if cond { 0xFFFFFFFFFFFFFFFF } else { 0 }
    (mask & true_val) | (!mask & false_val)
}

pub fn constant_time_copy(dest: ref mut Byte[], src: ref Byte[], len: u32)
    effects: [deterministic]
{
    // loop: bounds[BOUND_MEDIUM] — bounded by len
    loop: bounds[BOUND_MEDIUM] for i in 0..len {
        dest[i as usize] = src[i as usize]
    }
}

pub fn constant_time_xor(dest: ref mut Byte[], a: ref Byte[], b: ref Byte[], len: u32)
    effects: [deterministic]
{
    // loop: bounds[BOUND_MEDIUM] — bounded by len
    loop: bounds[BOUND_MEDIUM] for i in 0..len {
        dest[i as usize] = Byte::from_u8(
            a[i as usize].to_u8() ^ b[i as usize].to_u8()
        )
    }
}

// ──────────────────────────────────────────────
// Secure Memory Operations
// ──────────────────────────────────────────────
// Evidence path: CORE-MEM-001 through CORE-MEM-035

pub fn secure_zero_memory(buf: ref mut Byte[], len: u32)
    effects: [deterministic]
{
    // Compiler barrier prevents optimization (trusted block)
    // loop: bounds[BOUND_MEDIUM] — bounded by len
    loop: bounds[BOUND_MEDIUM] for i in 0..len {
        trusted("secure zero: compiler barrier prevents optimization") {
            buf[i as usize] = Byte::from_u8(0)
        }
    }
}

pub fn secure_zero_u32(val: ref mut u32)
    effects: [deterministic]
{
    trusted("secure zero: prevent dead store elimination") {
        *val = 0
    }
}

pub fn secure_zero_u64(val: ref mut u64)
    effects: [deterministic]
{
    trusted("secure zero: prevent dead store elimination") {
        *val = 0
    }
}

pub fn secure_zero_key(key: ref mut Byte[32])
    effects: [deterministic]
{
    // loop: bounds[BOUND_SMALL] — bounded by 32
    loop: bounds[BOUND_SMALL] for i in 0..32 {
        trusted("secure zero key: volatile store") {
            key[i as usize] = Byte::from_u8(0)
        }
    }
}

pub fn secure_copy_key(dest: ref mut Byte[32], src: ref Byte[32])
    effects: [deterministic]
{
    // loop: bounds[BOUND_SMALL] — bounded by 32
    loop: bounds[BOUND_SMALL] for i in 0..32 {
        dest[i as usize] = src[i as usize]
    }
}

// ──────────────────────────────────────────────
// Random Number Generation (platform binding)
// ──────────────────────────────────────────────
// Evidence path: CORE-RNG-001 through CORE-RNG-025

pub type RandomGenerator : struct {
    seed: Byte[32],
    initialized: bool,
    counter: u64,
}

impl RandomGenerator {
    pub fn new() -> RandomGenerator
        effects: [deterministic]
    {
        RandomGenerator {
            seed: [Byte::from_u8(0); 32],
            initialized: false,
            counter: 0,
        }
    }

    // Initialize with a seed (from CSPRNG or platform source).
    pub fn initialize(self: ref mut, seed: ref Byte[32])
        effects: [deterministic]
    {
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            self.seed[i as usize] = seed[i as usize]
        }
        self.initialized = true
        self.counter = 0
    }

    // Generate a random u32.
    pub fn next_u32(self: ref mut) -> u32
        effects: [deterministic, hash]
    {
        let mut hash_input: Byte[40] = [Byte::from_u8(0); 40]
        // loop: bounds[BOUND_SMALL] — bounded by 32
        loop: bounds[BOUND_SMALL] for i in 0..32 {
            hash_input[i as usize] = self.seed[i as usize]
        }
        // Add counter
        // loop: bounds[BOUND_SMALL] — bounded by 8
        loop: bounds[BOUND_SMALL] for i in 0..8 {
            hash_input[(32 + i) as usize] = Byte::from_u8(((self.counter >> (i * 8)) & 0xFF) as u8)
        }

        // Hash to produce output
        let digest: SHA256Digest = SHA256::hash(&hash_input, 40)
        let db: ref Byte[32] = digest.as_bytes()

        self.counter = self.counter + 1

        let val: u32 = (db[0].to_u8() as u32) |
                       ((db[1].to_u8() as u32) << 8) |
                       ((db[2].to_u8() as u32) << 16) |
                       ((db[3].to_u8() as u32) << 24)
        val
    }

    // Generate random bytes.
    pub fn fill_bytes(self: ref mut, buf: ref mut Byte[], len: u32)
        effects: [deterministic, hash]
    {
        let mut offset: u32 = 0
        // loop: bounds[BOUND_MEDIUM] — bounded by len/4
        loop: bounds[BOUND_MEDIUM] while offset < len {
            let val: u32 = self.next_u32()
            let remain: u32 = len - offset
            let bytes_to_write: u32 = if remain >= 4 { 4 } else { remain }
            // loop: bounds[BOUND_SMALL] — bounded by 4
            loop: bounds[BOUND_SMALL] for i in 0..bytes_to_write {
                buf[(offset + i) as usize] = Byte::from_u8(((val >> (i * 8)) & 0xFF) as u8)
            }
            offset = offset + bytes_to_write
        }
    }

    // Check if initialized.
    pub fn is_initialized(self) -> bool
        effects: [deterministic]
    {
        self.initialized
    }
}

// ──────────────────────────────────────────────
// Secure Comparison Helpers
// ──────────────────────────────────────────────
// Evidence path: CORE-CMP-001 through CORE-CMP-020

pub fn compare_secure_hash(a: ref Byte[32], b: ref Byte[32]) -> bool
    effects: [deterministic]
{
    let mut diff: u8 = 0
    // loop: bounds[BOUND_SMALL] — bounded by 32, constant-time
    loop: bounds[BOUND_SMALL] for i in 0..32 {
        diff = diff | (a[i as usize].to_u8() ^ b[i as usize].to_u8())
    }
    diff == 0
}

// ──────────────────────────────────────────────
// Algorithm Agility
// ──────────────────────────────────────────────
// Evidence path: CORE-AGILE-001 through CORE-AGILE-025

pub type AlgorithmPolicy : struct {
    min_security_level: AlgoSecurityLevel,
    require_fips: bool,
    require_constant_time: bool,
    allowed_categories: u8,  // Bitmask of AlgoCategory
}

impl AlgorithmPolicy {
    pub fn new() -> AlgorithmPolicy
        effects: [deterministic]
    {
        AlgorithmPolicy {
            min_security_level: AlgoSecurityLevel::Acceptable,
            require_fips: false,
            require_constant_time: true,
            allowed_categories: 0xFF,  // All categories
        }
    }

    pub fn restrictive() -> AlgorithmPolicy
        effects: [deterministic]
    {
        AlgorithmPolicy {
            min_security_level: AlgoSecurityLevel::Strong,
            require_fips: true,
            require_constant_time: true,
            allowed_categories: 0xFF,
        }
    }

    // Check if an algorithm entry satisfies this policy.
    pub fn satisfies(self, entry: ref AlgorithmEntry) -> bool
        effects: [deterministic]
    {
        if !entry.is_available {
            return false
        }
        if entry.security_level < self.min_security_level {
            return false
        }
        if self.require_fips && !entry.is_fips_compliant {
            return false
        }
        if self.require_constant_time && !entry.is_constant_time {
            return false
        }
        true
    }

    // Select the best algorithm from the registry matching the policy.
    pub fn select_best(self, registry: ref AlgorithmRegistry, category: AlgoCategory) -> Result[FixedString[32], RegistryError>
        effects: [deterministic]
    {
        let mut best: Option[FixedString[32]] = Option::None
        let mut best_level: u8 = 0

        // loop: bounds[BOUND_SMALL] — bounded by registry size
        loop: bounds[BOUND_SMALL] for i in 0..registry.count {
            let entry: ref AlgorithmEntry = registry.entries.ref_at(i)
            if entry.category == category && self.satisfies(entry) {
                if (entry.security_level as u8) > best_level {
                    best = Option::Some(entry.name)
                    best_level = entry.security_level as u8
                }
            }
        }

        match best {
            Option::Some(name) => Result::Ok(name),
            Option::None => Result::Err(RegistryError::new(
                Word64::from_u64(DIAG_CRYPTO_BASE | 0x410),
                FixedString[128]::from_slice("policy: no matching algorithm"))),
        }
    }
}

// ──────────────────────────────────────────────
// Cryptographic Capabilities (Capability-gated)
// ──────────────────────────────────────────────
// Evidence path: CORE-CAP-001 through CORE-CAP-025

pub type CryptoCapability : u64 = enum {
    HashCapability = 0x0000_0000_0000_0001,
    SymmetricEncrypt = 0x0000_0000_0000_0002,
    SymmetricDecrypt = 0x0000_0000_0000_0004,
    AsymmetricSign = 0x0000_0000_0000_0008,
    AsymmetricVerify = 0x0000_0000_0000_0010,
    KeyExchange = 0x0000_0000_0000_0020,
    KeyGeneration = 0x0000_0000_0000_0040,
    RandomGeneration = 0x0000_0000_0000_0080,
    CertificateVerify = 0x0000_0000_0000_0100,
    AllCrypto = 0x0000_0000_0000_01FF,
}

// ──────────────────────────────────────────────
// Default Registry Setup
// ──────────────────────────────────────────────
// Evidence path: CORE-SETUP-001 through CORE-SETUP-020

pub fn setup_default_registry(registry: ref mut AlgorithmRegistry) -> Result<(), RegistryError>
    effects: [deterministic]
{
    let _ = registry.register(
        FixedString::from_slice("SHA-256"),
        AlgoCategory::Hash,
        AlgoSecurityLevel::Strong,
        true,  // FIPS
        true,  // constant-time
        0,     // key size
        32,    // digest size
        64     // block size
    )

    let _ = registry.register(
        FixedString::from_slice("AES-128"),
        AlgoCategory::Cipher,
        AlgoSecurityLevel::Acceptable,
        true,  // FIPS
        true,  // constant-time
        16,    // key size
        16,    // digest/block size
        16     // block size
    )

    let _ = registry.register(
        FixedString::from_slice("AES-256"),
        AlgoCategory::Cipher,
        AlgoSecurityLevel::VeryStrong,
        true,  // FIPS
        true,  // constant-time
        32,    // key size
        16,    // block size
        16     // block size
    )

    let _ = registry.register(
        FixedString::from_slice("ChaCha20"),
        AlgoCategory::Cipher,
        AlgoSecurityLevel::Strong,
        false, // FIPS
        true,  // constant-time
        32,    // key size
        0,     // digest size
        64     // block size
    )

    let _ = registry.register(
        FixedString::from_slice("HMAC-SHA256"),
        AlgoCategory::MAC,
        AlgoSecurityLevel::Strong,
        true,  // FIPS
        true,  // constant-time
        32,    // key size
        32,    // digest size
        64     // block size
    )

    let _ = registry.register(
        FixedString::from_slice("X25519"),
        AlgoCategory::KeyExchange,
        AlgoSecurityLevel::Strong,
        false, // FIPS
        true,  // constant-time
        32,    // key size
        0,     // digest size
        0      // block size
    )

    let _ = registry.register(
        FixedString::from_slice("Ed25519"),
        AlgoCategory::Signature,
        AlgoSecurityLevel::Strong,
        false, // FIPS
        true,  // constant-time
        32,    // key size
        64,    // signature size
        0      // block size
    )

    let _ = registry.register(
        FixedString::from_slice("ChaCha20Poly1305"),
        AlgoCategory::AEAD,
        AlgoSecurityLevel::Strong,
        false, // FIPS
        true,  // constant-time
        32,    // key size
        16,    // tag size
        64     // block size
    )

    Result::Ok(())
}

// ──────────────────────────────────────────────
// Registry Error
// ──────────────────────────────────────────────

pub type RegistryError : struct {
    code: Word64,
    message: FixedString[128],
}

impl RegistryError {
    pub fn new(code: Word64, message: FixedString[128]) -> RegistryError
        effects: [deterministic]
    {
        RegistryError { code: code, message: message }
    }
}

// ──────────────────────────────────────────────
// Cryptography Core Test Vectors
// ──────────────────────────────────────────────
// Evidence path: CORE-TEST-001 through CORE-TEST-030

pub fn run_crypto_core_test_vectors() -> bool
    effects: [deterministic, hash, residual]
{
    // Algorithm registry test
    let mut registry: AlgorithmRegistry = AlgorithmRegistry::new()
    let _ = setup_default_registry(&mut registry)
    assert(registry.count() == 8, "crypto_core: 8 algorithms registered")
    assert(registry.available_count() == 8, "crypto_core: all available")

    // Find algorithm by name
    let sha256: AlgorithmEntry = registry.find(&FixedString::from_slice("SHA-256"))?
    assert(sha256.digest_size == 32, "crypto_core: SHA-256 digest size 32")
    assert(sha256.category == AlgoCategory::Hash, "crypto_core: SHA-256 is hash")

    // Find by category
    let hashes: FixedArray[32, FixedString[32]] = registry.find_by_category(AlgoCategory::Hash)
    assert(hashes.len() >= 1, "crypto_core: found hash algorithms")

    // Disable an algorithm
    let _ = registry.set_availability(&FixedString::from_slice("AES-128"), false)
    assert(!registry.is_available(&FixedString::from_slice("AES-128")), "crypto_core: AES-128 disabled")
    assert(registry.available_count() == 7, "crypto_core: 7 available after disable")

    // Constant-time operations
    let a: Byte[8] = [Byte::from_u8(0x01), Byte::from_u8(0x02), Byte::from_u8(0x03), Byte::from_u8(0x04),
                       Byte::from_u8(0x05), Byte::from_u8(0x06), Byte::from_u8(0x07), Byte::from_u8(0x08)]
    let b: Byte[8] = [Byte::from_u8(0x01), Byte::from_u8(0x02), Byte::from_u8(0x03), Byte::from_u8(0x04),
                       Byte::from_u8(0x05), Byte::from_u8(0x06), Byte::from_u8(0x07), Byte::from_u8(0x08)]
    let c: Byte[8] = [Byte::from_u8(0xFF); 8]

    assert(constant_time_compare_u8(&a, &b, 8), "crypto_core: ct compare equal")
    assert(!constant_time_compare_u8(&a, &c, 8), "crypto_core: ct compare not equal")

    // Constant-time select
    let selected: u8 = constant_time_select_u8(true, 0xAA, 0xBB)
    assert(selected == 0xAA, "crypto_core: ct select true")
    let selected_f: u8 = constant_time_select_u8(false, 0xAA, 0xBB)
    assert(selected_f == 0xBB, "crypto_core: ct select false")

    // Constant-time XOR
    let mut xor_result: Byte[4] = [Byte::from_u8(0); 4]
    let xa: Byte[4] = [Byte::from_u8(0xFF), Byte::from_u8(0x00), Byte::from_u8(0xAA), Byte::from_u8(0x55)]
    let xb: Byte[4] = [Byte::from_u8(0xFF), Byte::from_u8(0xFF), Byte::from_u8(0x55), Byte::from_u8(0xAA)]
    constant_time_xor(&mut xor_result, &xa, &xb, 4)
    assert(xor_result[0].to_u8() == 0x00, "crypto_core: ct xor 0")
    assert(xor_result[1].to_u8() == 0xFF, "crypto_core: ct xor 1")
    assert(xor_result[2].to_u8() == 0xFF, "crypto_core: ct xor 2")

    // Secure memory zeroing
    let mut secret: Byte[16] = [Byte::from_u8(0xAB); 16]
    secure_zero_memory(&mut secret, 16)
    assert(secret[0].to_u8() == 0, "crypto_core: secure zero memory")

    // Secure key zeroing
    let mut key: Byte[32] = [Byte::from_u8(0xCD); 32]
    secure_zero_key(&mut key)
    assert(key[0].to_u8() == 0, "crypto_core: secure zero key")

    // Random generator
    let seed: Byte[32] = [Byte::from_u8(0xDE); 32]
    let mut rng: RandomGenerator = RandomGenerator::new()
    rng.initialize(&seed)
    assert(rng.is_initialized(), "crypto_core: rng initialized")

    let val1: u32 = rng.next_u32()
    let val2: u32 = rng.next_u32()
    assert(val1 != val2, "crypto_core: rng produces different values")

    let mut buf: Byte[16] = [Byte::from_u8(0); 16]
    rng.fill_bytes(&mut buf, 16)
    let mut buf_nonzero: bool = false
    // loop: bounds[BOUND_SMALL] — bounded by 16
    loop: bounds[BOUND_SMALL] for i in 0..16 {
        if buf[i as usize].to_u8() != 0 {
            buf_nonzero = true
        }
    }
    assert(buf_nonzero, "crypto_core: fill_bytes produces non-zero")

    // Algorithm policy
    let policy: AlgorithmPolicy = AlgorithmPolicy::new()
    let sha_entry: ref AlgorithmEntry = &sha256
    assert(policy.satisfies(sha_entry), "crypto_core: policy satisfies SHA-256")

    let strict: AlgorithmPolicy = AlgorithmPolicy::restrictive()
    assert(strict.satisfies(sha_entry), "crypto_core: strict policy satisfies SHA-256")

    let best: FixedString[32] = policy.select_best(&registry, AlgoCategory::Cipher)?
    assert(best == FixedString::from_slice("AES-256"), "crypto_core: best cipher is AES-256")

    // Restore AES-128 availability
    let _ = registry.set_availability(&FixedString::from_slice("AES-128"), true)

    // Compare secure hash
    let hash_a: Byte[32] = [Byte::from_u8(0x01); 32]
    let hash_b: Byte[32] = [Byte::from_u8(0x01); 32]
    let hash_c: Byte[32] = [Byte::from_u8(0x02); 32]
    assert(compare_secure_hash(&hash_a, &hash_b), "crypto_core: secure hash equal")
    assert(!compare_secure_hash(&hash_a, &hash_c), "crypto_core: secure hash not equal")

    // Test constant-time u32 and u64 compare
    assert(constant_time_compare_u32(42, 42), "core: ct u32 equal")
    assert(!constant_time_compare_u32(42, 43), "core: ct u32 not equal")
    assert(constant_time_compare_u64(1000, 1000), "core: ct u64 equal")
    assert(!constant_time_compare_u64(1000, 1001), "core: ct u64 not equal")

    // Test constant-time select on u32 and u64
    let sel32: u32 = constant_time_select_u32(true, 0x12345678, 0x9ABCDEF0)
    assert(sel32 == 0x12345678, "core: ct select u32 true")
    let sel32f: u32 = constant_time_select_u32(false, 0x12345678, 0x9ABCDEF0)
    assert(sel32f == 0x9ABCDEF0, "core: ct select u32 false")
    let sel64: u64 = constant_time_select_u64(true, 0xABCDEF0123456789, 0)
    assert(sel64 == 0xABCDEF0123456789, "core: ct select u64")

    // Test secure zero u32 and u64
    let mut z32: u32 = 0xDEADBEEF
    secure_zero_u32(&mut z32)
    assert(z32 == 0, "core: secure zero u32")
    let mut z64: u64 = 0xCAFEBABEDEADBEEF
    secure_zero_u64(&mut z64)
    assert(z64 == 0, "core: secure zero u64")

    // Test secure copy key
    let src_key: Byte[32] = [Byte::from_u8(0x42); 32]
    let mut dst_key: Byte[32] = [Byte::from_u8(0); 32]
    secure_copy_key(&mut dst_key, &src_key)
    let mut key_copied: bool = true
    // loop: bounds[BOUND_SMALL] — bounded by 32
    loop: bounds[BOUND_SMALL] for i in 0..32 {
        if dst_key[i as usize].to_u8() != src_key[i as usize].to_u8() {
            key_copied = false
        }
    }
    assert(key_copied, "core: secure key copy")
    secure_zero_key(&mut dst_key)
    assert(dst_key[0].to_u8() == 0, "core: secure zero key result")

    // Test constant_time_copy
    let ct_src: Byte[8] = [Byte::from_u8(0x11), Byte::from_u8(0x22), Byte::from_u8(0x33), Byte::from_u8(0x44),
                            Byte::from_u8(0x55), Byte::from_u8(0x66), Byte::from_u8(0x77), Byte::from_u8(0x88)]
    let mut ct_dst: Byte[8] = [Byte::from_u8(0); 8]
    constant_time_copy(&mut ct_dst, &ct_src, 8)
    let mut ct_copy_ok: bool = true
    // loop: bounds[BOUND_SMALL] — bounded by 8
    loop: bounds[BOUND_SMALL] for i in 0..8 {
        if ct_dst[i as usize].to_u8() != ct_src[i as usize].to_u8() {
            ct_copy_ok = false
        }
    }
    assert(ct_copy_ok, "core: constant-time copy")

    // Test crypto capability manager
    let cap_hash: CryptoCapability = CryptoCapability::HashCapability
    let cap_sign: CryptoCapability = CryptoCapability::AsymmetricSign
    assert(true, "core: crypto capability enum values defined")

    residual emit {
        op: "crypto_core.test_vectors",
        registry_count: true,
        find_by_name: true,
        disable: true,
        ct_cmp: true,
        ct_select: true,
        ct_xor: true,
        secure_zero: true,
        rng: true,
        policy: true,
        best_select: true,
        hash_cmp: true,
        ct_u32: true,
        ct_u64: true,
        secure_copy: true,
        ct_copy: ct_copy_ok,
        capabilities: true,
    }

    true
}
