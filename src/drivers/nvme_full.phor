    effect [memory:mmio, deterministic, residual]
    court "nvme_full_write:v1"
{
    if !cap.can_write {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let prp1: u64 = 0;
    let prp2: u64 = 0;
    let prp_res: Result(void, NvmeFullError) = nvme_full_build_prp(
        controller, data_phys, data_size,
        Handle(u64)::from_ptr(&prp1),
        Handle(u64)::from_ptr(&prp2),
        Handle(NvmeFullPrpList)::from_ptr(&controller.prp_pool),
    );
    match prp_res {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let sqe: NvmeFullSqe = nvme_full_build_rw_sqe(NvmeFullIoOpcode::Write, nsid, slba, block_count, prp1, prp2);
    let result: Result(u16, NvmeFullError) = nvme_full_submit_io_cmd(controller, sqe, queue_idx, cap, timestamp);
    match result {
        Result::Ok(cmd_id) => {
            residual emit {
                op: "nvme_full.write",
                nsid: nsid as u64,
                slba: slba,
                block_count: block_count as u64,
                data_phys: data_phys,
                qid: queue_idx as u64,
                cmd_id: cmd_id as u64,
                timestamp: timestamp,
            };
            return Result::Ok(cmd_id);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// NVM: Compare
// ─────────────────────────────────────────────────────────────

fn nvme_full_compare(
    controller: Handle(NvmeFullController),
    nsid: u32,
    slba: u64,
    block_count: u16,
    data_phys: u64,
    data_size: u64,
    queue_idx: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u16, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_compare:v1"
{
    if !cap.can_compare {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let prp1: u64 = 0;
    let prp2: u64 = 0;
    let prp_res: Result(void, NvmeFullError) = nvme_full_build_prp(
        controller, data_phys, data_size,
        Handle(u64)::from_ptr(&prp1),
        Handle(u64)::from_ptr(&prp2),
        Handle(NvmeFullPrpList)::from_ptr(&controller.prp_pool),
    );
    match prp_res {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let sqe: NvmeFullSqe = nvme_full_build_rw_sqe(NvmeFullIoOpcode::Compare, nsid, slba, block_count, prp1, prp2);
    let result: Result(u16, NvmeFullError) = nvme_full_submit_io_cmd(controller, sqe, queue_idx, cap, timestamp);
    match result {
        Result::Ok(cmd_id) => {
            residual emit {
                op: "nvme_full.compare",
                nsid: nsid as u64,
                slba: slba,
                block_count: block_count as u64,
                timestamp: timestamp,
            };
            return Result::Ok(cmd_id);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// NVM: Write Zeroes
