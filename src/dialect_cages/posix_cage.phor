// ============================================================================
// POSIX Call Classification
// ============================================================================

type POSIXCallClass = enum {
    FileIO = 0x01,
    MemoryManagement = 0x02,
    ProcessManagement = 0x03,
    SignalHandling = 0x04,
    Networking = 0x05,
    IPC = 0x06,
    FileSystem = 0x07,
    Time = 0x08,
    Security = 0x09,
    TerminalIO = 0x0A,
    Threading = 0x0B,
    Syslog = 0x0C,
    SystemInfo = 0x0D,
    ResourceLimits = 0x0E,
    Unsupported = 0xFF,
}

// ============================================================================
// POSIX to Native Translation
// ============================================================================

type POSIXTranslation = struct {
    posix_call: FixedString[128],
    posix_syscall_number: u64,
    call_class: POSIXCallClass,
    native_operation: FixedString[256],
    argument_count: u64,
    needs_capability: FixedString[128],
    is_observed: bool,
    is_translated: bool,
    confidence_score: u64,
    residual_hash: Hash256,
}

type POSIXCage = struct {
    cage_id: Hash256,
    translations: Array[POSIXTranslation, 512],
    translation_count: u64,
    observation_count: u64,
    successful_translations: u64,
    failed_translations: u64,
    capabilities_granted: Array[FixedString[128], 64],
    cap_count: u64,
    generation: u64,
}

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Create POSIX Cage
// ============================================================================

fn create_posix_cage() -> POSIXCage
    effects: [compute]
{
    let empty_translations: Array[POSIXTranslation, 512] = Array[POSIXTranslation, 512]::zeroed();
    let empty_caps: Array[FixedString[128], 64] = Array[FixedString[128], 64]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    return POSIXCage {
        cage_id: zero_hash,
        translations: empty_translations,
        translation_count: 0,
        observation_count: 0,
        successful_translations: 0,
        failed_translations: 0,
        capabilities_granted: empty_caps,
        cap_count: 0,
        generation: 1,
    };
}

// ============================================================================
// Classify POSIX Call
// ============================================================================

fn classify_posix_call(syscall_number: u64) -> POSIXCallClass
    effects: [compute]
{
    if syscall_number <= 22 || syscall_number == 72 || syscall_number == 73 ||
       syscall_number == 74 || syscall_number == 75 || syscall_number == 76 ||
       syscall_number == 77 || syscall_number == 78 || syscall_number == 85 {
        // File I/O related: read, write, open, close, stat, lseek, etc.
        return POSIXCallClass::FileIO;
    }

    if syscall_number == 9 || syscall_number == 10 || syscall_number == 11 ||
       syscall_number == 12 || syscall_number == 25 || syscall_number == 26 ||
       syscall_number == 27 || syscall_number == 28 || syscall_number == 149 ||
       syscall_number == 150 || syscall_number == 151 || syscall_number == 152 {
        return POSIXCallClass::MemoryManagement;
    }

    if syscall_number == 39 || syscall_number == 56 || syscall_number == 57 ||
       syscall_number == 58 || syscall_number == 59 || syscall_number == 60 ||
       syscall_number == 61 || syscall_number == 62 || syscall_number == 186 ||
       syscall_number == 231 {
        return POSIXCallClass::ProcessManagement;
    }

    if syscall_number == 13 || syscall_number == 14 || syscall_number == 15 ||
       syscall_number == 127 || syscall_number == 128 || syscall_number == 129 ||
       syscall_number == 130 || syscall_number == 131 {
        return POSIXCallClass::SignalHandling;
    }

    if syscall_number >= 41 && syscall_number <= 55 {
        return POSIXCallClass::Networking;
    }

    if syscall_number == 29 || syscall_number == 30 || syscall_number == 31 ||
       syscall_number == 64 || syscall_number == 65 || syscall_number == 66 ||
       syscall_number == 67 || syscall_number == 68 || syscall_number == 69 ||
       syscall_number == 70 || syscall_number == 22 {
        return POSIXCallClass::IPC;
    }

    if syscall_number >= 82 && syscall_number <= 95 {
        // mkdir, rmdir, rename, link, unlink, symlink, chmod, chown, etc.
        return POSIXCallClass::FileSystem;
    }

    if syscall_number == 96 || syscall_number == 35 || syscall_number == 36 ||
       syscall_number == 37 || syscall_number == 38 || syscall_number == 201 ||
       syscall_number == 100 {
        return POSIXCallClass::Time;
    }

    if syscall_number >= 102 && syscall_number <= 126 {
        return POSIXCallClass::Security;
    }

    if syscall_number == 97 || syscall_number == 98 || syscall_number == 99 ||
       syscall_number == 63 || syscall_number == 160 {
        return POSIXCallClass::ResourceLimits;
    }

    return POSIXCallClass::Unsupported;
}

// ============================================================================
// Map POSIX Syscall to Native Operation
// ============================================================================
// Core mapping function: translates a POSIX syscall number and name
// to the corresponding native Phorensic operation.

fn map_posix_to_native(syscall_number: u64, call_name: &FixedString[128], args_hash: Hash256) -> Result[POSIXTranslation, POSIXCageError]
    effects: [compute, residual]
{
    let call_class: POSIXCallClass = classify_posix_call(syscall_number);

    let mut native_op: FixedString[256] = FixedString[256]::zeroed();
    let mut needs_cap: FixedString[128] = FixedString[128]::zeroed();
    let mut confidence: u64 = 50;

    // Map specific syscalls to native operations
    match call_class {
        POSIXCallClass::FileIO => {
            if syscall_number == 0 {  // read
                native_op = FixedString[256]::from_literal("store.read_bytes");
                needs_cap = FixedString[128]::from_literal("filesystem_read");
                confidence = 80;
            } else if syscall_number == 1 {  // write
                native_op = FixedString[256]::from_literal("store.write_bytes");
                needs_cap = FixedString[128]::from_literal("filesystem_write");
                confidence = 80;
            } else if syscall_number == 2 {  // open
                native_op = FixedString[256]::from_literal("store.resolve_node");
                needs_cap = FixedString[128]::from_literal("filesystem_read");
                confidence = 75;
            } else if syscall_number == 3 {  // close
                native_op = FixedString[256]::from_literal("capability.drop");
                needs_cap = FixedString[128]::from_literal("filesystem_read");
                confidence = 85;
            } else if syscall_number == 8 {  // lseek
                native_op = FixedString[256]::from_literal("store.seek_position");
                needs_cap = FixedString[128]::from_literal("filesystem_read");
                confidence = 70;
            } else if syscall_number == 17 {  // pread64
                native_op = FixedString[256]::from_literal("store.read_at");
                needs_cap = FixedString[128]::from_literal("filesystem_read");
                confidence = 80;
            } else if syscall_number == 18 {  // pwrite64
                native_op = FixedString[256]::from_literal("store.write_at");
                needs_cap = FixedString[128]::from_literal("filesystem_write");
                confidence = 80;
            } else {
                native_op = FixedString[256]::from_literal("file_io.generic");
                needs_cap = FixedString[128]::from_literal("filesystem");
                confidence = 30;
            }
        }
        POSIXCallClass::MemoryManagement => {
            if syscall_number == 9 {  // mmap
                native_op = FixedString[256]::from_literal("memory.map_region");
                needs_cap = FixedString[128]::from_literal("memory_mapping");
                confidence = 60;
            } else if syscall_number == 11 {  // munmap
                native_op = FixedString[256]::from_literal("memory.unmap_region");
                needs_cap = FixedString[128]::from_literal("memory_mapping");
                confidence = 65;
            } else {
                native_op = FixedString[256]::from_literal("memory.generic");
                needs_cap = FixedString[128]::from_literal("memory");
                confidence = 25;
            }
        }
        POSIXCallClass::ProcessManagement => {
            if syscall_number == 59 {  // execve
                native_op = FixedString[256]::from_literal("process.spawn_sealed");
                needs_cap = FixedString[128]::from_literal("process_spawn");
                confidence = 30;  // Low — execve semantics are complex
            } else if syscall_number == 60 {  // exit
                native_op = FixedString[256]::from_literal("process.exit");
                needs_cap = FixedString[128]::zeroed();
                confidence = 90;
            } else if syscall_number == 39 {  // getpid
                native_op = FixedString[256]::from_literal("process.get_id");
                needs_cap = FixedString[128]::zeroed();
                confidence = 95;
            } else {
                native_op = FixedString[256]::from_literal("process.unsupported");
                needs_cap = FixedString[128]::zeroed();
                confidence = 5;  // Very low — most process operations unsupported
            }
        }
        POSIXCallClass::Networking => {
            if syscall_number == 41 {  // socket
                native_op = FixedString[256]::from_literal("ipc.create_channel");
                needs_cap = FixedString[128]::from_literal("networking");
                confidence = 40;
            } else if syscall_number == 42 {  // connect
                native_op = FixedString[256]::from_literal("ipc.connect");
                needs_cap = FixedString[128]::from_literal("networking");
                confidence = 40;
            } else {
                native_op = FixedString[256]::from_literal("networking.generic");
                needs_cap = FixedString[128]::from_literal("networking");
                confidence = 20;
            }
        }
        POSIXCallClass::IPC => {
            if syscall_number == 22 {  // pipe
                native_op = FixedString[256]::from_literal("ipc.create_pipe");
                needs_cap = FixedString[128]::from_literal("ipc");
                confidence = 60;
            } else {
                native_op = FixedString[256]::from_literal("ipc.generic");
                needs_cap = FixedString[128]::from_literal("ipc");
                confidence = 25;
            }
        }
        POSIXCallClass::FileSystem => {
            if syscall_number == 82 {  // rename
                native_op = FixedString[256]::from_literal("store.rename_node");
                needs_cap = FixedString[128]::from_literal("filesystem_write");
                confidence = 75;
            } else if syscall_number == 83 {  // mkdir
                native_op = FixedString[256]::from_literal("store.create_directory");
                needs_cap = FixedString[128]::from_literal("filesystem_write");
                confidence = 75;
            } else if syscall_number == 84 {  // rmdir
                native_op = FixedString[256]::from_literal("store.remove_directory");
                needs_cap = FixedString[128]::from_literal("filesystem_write");
                confidence = 75;
            } else if syscall_number == 87 {  // unlink
                native_op = FixedString[256]::from_literal("store.unlink_node");
                needs_cap = FixedString[128]::from_literal("filesystem_write");
                confidence = 75;
            } else {
                native_op = FixedString[256]::from_literal("filesystem.generic");
                needs_cap = FixedString[128]::from_literal("filesystem");
                confidence = 35;
            }
        }
        POSIXCallClass::Time => {
            if syscall_number == 96 {  // gettimeofday
                native_op = FixedString[256]::from_literal("time.get_wall_clock");
                needs_cap = FixedString[128]::zeroed();
                confidence = 90;
            } else if syscall_number == 201 {  // time
                native_op = FixedString[256]::from_literal("time.get_timestamp");
                needs_cap = FixedString[128]::zeroed();
                confidence = 95;
            } else if syscall_number == 35 {  // nanosleep
                native_op = FixedString[256]::from_literal("time.sleep");
                needs_cap = FixedString[128]::from_literal("timer");
                confidence = 85;
            } else {
                native_op = FixedString[256]::from_literal("time.generic");
                needs_cap = FixedString[128]::from_literal("timer");
                confidence = 50;
            }
        }
        POSIXCallClass::Security => {
            native_op = FixedString[256]::from_literal("security.posix_shim");
            needs_cap = FixedString[128]::from_literal("security");
            confidence = 15;  // Very low — POSIX security model differs significantly
        }
        POSIXCallClass::ResourceLimits => {
            if syscall_number == 97 {  // getrlimit
                native_op = FixedString[256]::from_literal("resource.get_limit");
                needs_cap = FixedString[128]::from_literal("resource_management");
                confidence = 60;
            } else if syscall_number == 160 {  // setrlimit
                native_op = FixedString[256]::from_literal("resource.set_limit");
                needs_cap = FixedString[128]::from_literal("resource_management");
                confidence = 50;
            } else {
                native_op = FixedString[256]::from_literal("resource.generic");
                needs_cap = FixedString[128]::from_literal("resource_management");
                confidence = 30;
            }
        }
        POSIXCallClass::Unsupported => {
            native_op = FixedString[256]::from_literal("unsupported.posix_syscall");
            confidence = 0;
            return Err(POSIXCageError::SyscallNotMapped);
        }
        POSIXCallClass::TerminalIO => {
            native_op = FixedString[256]::from_literal("terminal.io.shim");
            needs_cap = FixedString[128]::from_literal("terminal");
            confidence = 20;
        }
        POSIXCallClass::Threading => {
            native_op = FixedString[256]::from_literal("threading.generic");
            needs_cap = FixedString[128]::from_literal("threads");
            confidence = 15;
        }
        POSIXCallClass::Syslog => {
            native_op = FixedString[256]::from_literal("logging.syslog_shim");
            needs_cap = FixedString[128]::from_literal("logging");
            confidence = 70;
        }
        POSIXCallClass::SystemInfo => {
            native_op = FixedString[256]::from_literal("system.info");
            needs_cap = FixedString[128]::zeroed();
            confidence = 80;
        }
    }

    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    let translation: POSIXTranslation = POSIXTranslation {
        posix_call: *call_name,
        posix_syscall_number: syscall_number,
        call_class: call_class,
        native_operation: native_op,
        argument_count: 0,
        needs_capability: needs_cap,
        is_observed: true,
        is_translated: confidence >= 50,
        confidence_score: confidence,
        residual_hash: zero_hash,
    };

    @emit_residual("posix_cage.translate", "syscall_mapped", syscall_number);

    return Ok(translation);
}

// ============================================================================
// Observe POSIX Call
// ============================================================================
// Records the observation of a POSIX call in the cage.

fn observe_posix_call(cage: &mut POSIXCage, syscall_number: u64, call_name: &FixedString[128], args_hash: Hash256) -> Result[u64, POSIXCageError]
    effects: [compute, residual]
{
    // Check if translation already exists
    for i in 0..cage.translation_count {
        if cage.translations[i].posix_syscall_number == syscall_number {
            // Update observation
            cage.translations[i].is_observed = true;
            cage.observation_count = cage.observation_count + 1;

            @emit_residual("posix_cage.observe", "call_reobserved", syscall_number);
            return Ok(cage.translations[i].confidence_score);
        }
    }

    // Create new translation mapping
    let translation: POSIXTranslation = map_posix_to_native(syscall_number, call_name, args_hash)?;

    if cage.translation_count < 512 {
        cage.translations[cage.translation_count] = translation;
        cage.translation_count = cage.translation_count + 1;

        if translation.is_translated {
            cage.successful_translations = cage.successful_translations + 1;
        } else {
            cage.failed_translations = cage.failed_translations + 1;
        }
    }

    cage.observation_count = cage.observation_count + 1;

    @emit_residual("posix_cage.observe", "new_call_observed", syscall_number);

    return Ok(translation.confidence_score);
}

// ============================================================================
// Execute POSIX Call Through Cage
// ============================================================================

type POSIXCallResult = struct {
    native_operation: FixedString[256],
    call_class: POSIXCallClass,
    confidence_score: u64,
    needs_capability: FixedString[128],
    translation_success: bool,
    residual_hash: Hash256,
}

fn execute_posix_call(cage: &mut POSIXCage, syscall_number: u64, call_name: &FixedString[128], args_hash: Hash256) -> Result[POSIXCallResult, POSIXCageError]
    effects: [compute, io, residual]
{
    let confidence: u64 = observe_posix_call(cage, syscall_number, call_name, args_hash)?;

    // Find the translation
    for i in 0..cage.translation_count {
        if cage.translations[i].posix_syscall_number == syscall_number {
            let result: POSIXCallResult = POSIXCallResult {
                native_operation: cage.translations[i].native_operation,
                call_class: cage.translations[i].call_class,
                confidence_score: cage.translations[i].confidence_score,
                needs_capability: cage.translations[i].needs_capability,
                translation_success: cage.translations[i].is_translated,
                residual_hash: cage.translations[i].residual_hash,
            };

            @emit_residual("posix_cage.execute", "call_executed", syscall_number);
            return Ok(result);
        }
    }

    return Err(POSIXCageError::SyscallNotMapped);
}

// ============================================================================
// POSIX Path Translation
// ============================================================================
// Translates a POSIX path to a native Phorensic store path.

fn translate_posix_path(posix_path: &FixedString[512]) -> Result[FixedString[512], POSIXCageError]
    effects: [compute, residual]
{
    let mut native_path: FixedString[512] = FixedString[512]::zeroed();

    // Simple path translation: strip POSIX conventions, map to store
    // POSIX / → store root
    // POSIX /tmp → store:/volatile
    // POSIX /dev → store:/device
    // POSIX /proc → store:/process
    // Other paths → store prefix

    let is_root: bool = posix_path.len == 1 && posix_path.data[0] == '/' as u8;

    if is_root {
        let prefix: FixedString[7] = FixedString[7]::from_literal("store:/");
        for i in 0..7 {
            native_path.data[i] = prefix.data[i];
        }
        native_path.len = 7;
    } else if posix_path.len >= 5 && posix_path.data[0] == '/' as u8 &&
              posix_path.data[1] == 't' as u8 &&
              posix_path.data[2] == 'm' as u8 &&
              posix_path.data[3] == 'p' as u8 {
        // /tmp → store:/volatile
        let prefix: FixedString[15] = FixedString[15]::from_literal("store:/volatile");
        for i in 0..15 {
            native_path.data[i] = prefix.data[i];
        }
        // Append the rest after /tmp
        let rest_start: u64 = 4;  // skip "/tmp"
        if rest_start < posix_path.len {
            for i in rest_start..posix_path.len {
                if 15 + (i - rest_start) < 512 {
                    native_path.data[15 + (i - rest_start)] = posix_path.data[i];
                }
            }
            native_path.len = 15 + (posix_path.len - rest_start);
        } else {
            native_path.len = 15;
        }
    } else {
        // Default: store: + path
        let prefix: FixedString[7] = FixedString[7]::from_literal("store:/");
        for i in 0..7 {
            native_path.data[i] = prefix.data[i];
        }
        let start_idx: u64 = if posix_path.data[0] == '/' as u8 { 1 } else { 0 };
        for i in start_idx..posix_path.len {
            if 7 + (i - start_idx) < 512 {
                native_path.data[7 + (i - start_idx)] = posix_path.data[i];
            }
        }
        native_path.len = 7 + (posix_path.len - start_idx);
    }

    @emit_residual("posix_cage.path_translate", "path_translated", posix_path.len);

    return Ok(native_path);
}

// ============================================================================
// POSIX Errno Translation
// ============================================================================
// Maps POSIX errno values to native error codes.

fn translate_posix_errno(posix_errno: u64) -> FixedString[128]
    effects: [compute]
{
    match posix_errno {
        0 => return FixedString[128]::from_literal("success"),
        1 => return FixedString[128]::from_literal("operation_not_permitted"),
        2 => return FixedString[128]::from_literal("no_such_file"),
        3 => return FixedString[128]::from_literal("no_such_process"),
        4 => return FixedString[128]::from_literal("interrupted_syscall"),
        5 => return FixedString[128]::from_literal("io_error"),
        6 => return FixedString[128]::from_literal("no_such_device"),
        7 => return FixedString[128]::from_literal("argument_list_too_long"),
        8 => return FixedString[128]::from_literal("exec_format_error"),
        9 => return FixedString[128]::from_literal("bad_file_descriptor"),
        10 => return FixedString[128]::from_literal("no_child_process"),
        11 => return FixedString[128]::from_literal("try_again"),
        12 => return FixedString[128]::from_literal("out_of_memory"),
        13 => return FixedString[128]::from_literal("permission_denied"),
        14 => return FixedString[128]::from_literal("bad_address"),
        15 => return FixedString[128]::from_literal("block_device_required"),
        16 => return FixedString[128]::from_literal("device_busy"),
        17 => return FixedString[128]::from_literal("file_exists"),
        18 => return FixedString[128]::from_literal("cross_device_link"),
        19 => return FixedString[128]::from_literal("no_such_device"),
        20 => return FixedString[128]::from_literal("not_a_directory"),
        21 => return FixedString[128]::from_literal("is_a_directory"),
        22 => return FixedString[128]::from_literal("invalid_argument"),
        23 => return FixedString[128]::from_literal("file_table_overflow"),
        24 => return FixedString[128]::from_literal("too_many_open_files"),
        25 => return FixedString[128]::from_literal("not_a_tty"),
        26 => return FixedString[128]::from_literal("text_file_busy"),
        27 => return FixedString[128]::from_literal("file_too_large"),
        28 => return FixedString[128]::from_literal("no_space_left"),
        29 => return FixedString[128]::from_literal("illegal_seek"),
        30 => return FixedString[128]::from_literal("read_only_filesystem"),
        31 => return FixedString[128]::from_literal("too_many_links"),
        32 => return FixedString[128]::from_literal("broken_pipe"),
        _ => return FixedString[128]::from_literal("unknown_posix_error"),
    }
}

// ============================================================================
// Grant POSIX Capability
// ============================================================================

fn grant_posix_capability(cage: &mut POSIXCage, cap_name: &FixedString[128]) -> Result[(), POSIXCageError]
    effects: [compute, residual]
{
    if cage.cap_count >= 64 {
        return Err(POSIXCageError::ResourceLimitExceeded);
    }

    cage.capabilities_granted[cage.cap_count] = *cap_name;
    cage.cap_count = cage.cap_count + 1;

    @emit_residual("posix_cage.grant_cap", "capability_granted", cage.cap_count);

    return Ok(());
}

// ============================================================================
// Check Capability
// ============================================================================

fn check_posix_capability(cage: &POSIXCage, cap_name: &FixedString[128]) -> bool
    effects: [compute]
{
    for i in 0..cage.cap_count {
        if cage.capabilities_granted[i] == *cap_name {
            return true;
        }
    }
    return false;
}

// ============================================================================
// Get POSIX Cage Statistics
// ============================================================================

type POSIXCageStats = struct {
    total_translations: u64,
    successful_translations: u64,
    failed_translations: u64,
    observation_count: u64,
    capabilities_granted: Array[FixedString[128], 64],
    cap_count: u64,
    file_io_count: u64,
    memory_count: u64,
    process_count: u64,
    network_count: u64,
    filesystem_count: u64,
    unsupported_count: u64,
}

fn get_posix_cage_stats(cage: &POSIXCage) -> POSIXCageStats
    effects: [compute]
{
    let mut file_io: u64 = 0;
    let mut memory: u64 = 0;
    let mut process: u64 = 0;
    let mut network: u64 = 0;
    let mut filesystem: u64 = 0;
    let mut unsupported: u64 = 0;

    for i in 0..cage.translation_count {
        match cage.translations[i].call_class {
            POSIXCallClass::FileIO => file_io = file_io + 1,
            POSIXCallClass::MemoryManagement => memory = memory + 1,
            POSIXCallClass::ProcessManagement => process = process + 1,
            POSIXCallClass::Networking => network = network + 1,
            POSIXCallClass::FileSystem => filesystem = filesystem + 1,
            POSIXCallClass::Unsupported => unsupported = unsupported + 1,
            _ => {}
        }
    }

    return POSIXCageStats {
        total_translations: cage.translation_count,
        successful_translations: cage.successful_translations,
        failed_translations: cage.failed_translations,
        observation_count: cage.observation_count,
        capabilities_granted: cage.capabilities_granted,
        cap_count: cage.cap_count,
        file_io_count: file_io,
        memory_count: memory,
        process_count: process,
        network_count: network,
        filesystem_count: filesystem,
        unsupported_count: unsupported,
    };
}

// ============================================================================
// Init POSIX Cage with Common Mappings
// ============================================================================
// Pre-populates a POSIX cage with the most common syscall mappings.

fn init_common_posix_mappings(cage: &mut POSIXCage) -> Result[u64, POSIXCageError>
    effects: [compute, residual]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut initialized_count: u64 = 0;

    // Pre-populate common syscall mappings
    let common_syscalls: Array[u64, 32] = fixed_buf! [
        0, 1, 2, 3, 4, 5, 8, 9, 11, 12, 17, 18, 22, 32, 33,
        35, 39, 41, 42, 43, 44, 45, 49, 50, 59, 60, 72, 78,
        79, 80, 82, 83
    ];

    for i in 0..32 {
        let syscall_num: u64 = common_syscalls[i];
        if syscall_num == 0 && i > 0 {
            break;  // Remaining entries are 0
        }

        let mut call_name: FixedString[128] = FixedString[128]::zeroed();
        if syscall_num == 0 { call_name = FixedString[128]::from_literal("read"); }
        elif syscall_num == 1 { call_name = FixedString[128]::from_literal("write"); }
        elif syscall_num == 2 { call_name = FixedString[128]::from_literal("open"); }
        elif syscall_num == 3 { call_name = FixedString[128]::from_literal("close"); }
        elif syscall_num == 4 { call_name = FixedString[128]::from_literal("stat"); }
        elif syscall_num == 5 { call_name = FixedString[128]::from_literal("fstat"); }
        elif syscall_num == 8 { call_name = FixedString[128]::from_literal("lseek"); }
        elif syscall_num == 9 { call_name = FixedString[128]::from_literal("mmap"); }
        elif syscall_num == 11 { call_name = FixedString[128]::from_literal("munmap"); }
        elif syscall_num == 12 { call_name = FixedString[128]::from_literal("brk"); }
        elif syscall_num == 17 { call_name = FixedString[128]::from_literal("pread64"); }
        elif syscall_num == 18 { call_name = FixedString[128]::from_literal("pwrite64"); }
        elif syscall_num == 22 { call_name = FixedString[128]::from_literal("pipe"); }
        elif syscall_num == 32 { call_name = FixedString[128]::from_literal("dup"); }
        elif syscall_num == 33 { call_name = FixedString[128]::from_literal("dup2"); }
        elif syscall_num == 35 { call_name = FixedString[128]::from_literal("nanosleep"); }
        elif syscall_num == 39 { call_name = FixedString[128]::from_literal("getpid"); }
        elif syscall_num == 41 { call_name = FixedString[128]::from_literal("socket"); }
        elif syscall_num == 42 { call_name = FixedString[128]::from_literal("connect"); }
        elif syscall_num == 43 { call_name = FixedString[128]::from_literal("accept"); }
        elif syscall_num == 44 { call_name = FixedString[128]::from_literal("sendto"); }
        elif syscall_num == 45 { call_name = FixedString[128]::from_literal("recvfrom"); }
        elif syscall_num == 49 { call_name = FixedString[128]::from_literal("bind"); }
        elif syscall_num == 50 { call_name = FixedString[128]::from_literal("listen"); }
        elif syscall_num == 59 { call_name = FixedString[128]::from_literal("execve"); }
        elif syscall_num == 60 { call_name = FixedString[128]::from_literal("exit"); }
        elif syscall_num == 72 { call_name = FixedString[128]::from_literal("fcntl"); }
        elif syscall_num == 78 { call_name = FixedString[128]::from_literal("getdents"); }
        elif syscall_num == 79 { call_name = FixedString[128]::from_literal("getcwd"); }
        elif syscall_num == 80 { call_name = FixedString[128]::from_literal("chdir"); }
        elif syscall_num == 82 { call_name = FixedString[128]::from_literal("rename"); }
        elif syscall_num == 83 { call_name = FixedString[128]::from_literal("mkdir"); }
        else { call_name = FixedString[128]::from_literal("unknown"); }

        let translation: POSIXTranslation = map_posix_to_native(syscall_num, &call_name, zero_hash)?;
        if cage.translation_count < 512 {
            cage.translations[cage.translation_count] = translation;
            cage.translation_count = cage.translation_count + 1;
            initialized_count = initialized_count + 1;
        }
    }

    @emit_residual("posix_cage.init", "common_mappings_initialized", initialized_count);

    return Ok(initialized_count);
}
