// ============================================================================
// Check 7: Source↔Binary Seal Signature Valid
// ============================================================================

fn check_seal_signature(
    pkg: PackageContainer,
    trusted_keys: Array[Hash256, 64],
    trusted_key_count: u32,
) -> PkgVerificationCheck
    effect [compute, residual]
{
    let name: Array[u8, 64] = Array[u8, 64]::from_literal("seal_signature_valid");
    let desc: Array[u8, 256] = Array[u8, 256]::from_literal("Source↔binary seal signature over (source_hash || binary_hash) is valid");
    let mut ok: bool = false;

    if pkg.binary_evidence.source_to_binary_seal.seal_present {
        let seal: SourceToBinarySeal = pkg.binary_evidence.source_to_binary_seal;
        let sig: Signature = seal.seal_signature;
        for i in 0..trusted_key_count as u64 {
            if hash256_equal(sig.signer_key, trusted_keys[i]) {
                let mut non_zero: bool = false;
                for j in 0..sig.sig_bytes_len as u64 {
                    if sig.sig_bytes[j] != 0 { non_zero = true; }
                }
                if non_zero { ok = true; }
            }
        }
    }

    let result: PkgCheckResult;
    let fail_detail: Array[u8, 512] = Array[u8, 512]::zeroed();
    let fail_len: u32 = 0;
    if ok {
        result = PkgCheckResult::Pass;
    } else {
        result = PkgCheckResult::Fail;
        let msg: Array[u8, 512] = Array[u8, 512]::from_literal("Source↔binary seal is missing or not properly signed — mandatory seal requirement");
        for i in 0..84 { fail_detail[i] = msg[i]; }
        fail_len = 84;
    }

    residual emit { op: "pkg_check.7.seal_sig", result: result as u64; };
    return PkgVerificationCheck {
        check_number: 7, check_name: name, check_name_len: 20,
        description: desc, description_len: 95,
        result: result,
        failure_reason: fail_detail, failure_reason_len: fail_len,
    };
}

