// ─────────────────────────────────────────────────────────────
// Admin: Abort Command
// ─────────────────────────────────────────────────────────────

fn nvme_full_abort(
    controller: Handle(NvmeFullController),
    sqid: u16,
    cid: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_abort:v1"
{
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::Abort as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: 0, data_ptr2: 0,
        cdw10: (sqid as u32) | ((cid as u32) << 16),
        cdw11: 0, cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    return nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
}

// ─────────────────────────────────────────────────────────────
// Admin: Sanitize
// ─────────────────────────────────────────────────────────────

fn nvme_full_sanitize(
    controller: Handle(NvmeFullController),
    action: NvmeFullSanitizeAction,
    ovrpat: u32,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_sanitize:v1"
{
    if !cap.can_sanitize {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let cdw10: u32 = (action as u32) | (0x01 << 3);
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::Sanitize as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: 0, data_ptr2: 0,
        cdw10: cdw10,
        cdw11: ovrpat,
        cdw12: 0, cdw13: 0, cdw14: 0, cdw15: 0,
    };

    let result: Result(u16, NvmeFullError) = nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
    match result {
        Result::Ok(_) => {
            residual emit {
                op: "nvme_full.sanitize",
                action: action as u64,
                timestamp: timestamp,
            };
            return Result::Ok(void);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// Admin: Async Event Request
// ─────────────────────────────────────────────────────────────

fn nvme_full_async_event_request(
    controller: Handle(NvmeFullController),
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(void, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_aer:v1"
{
    let sqe: NvmeFullSqe = NvmeFullSqe {
        cdw0: (NvmeFullAdminOpcode::AsyncEventRequest as u32),
        nsid: 0,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: 0, data_ptr2: 0,
        cdw10: 0, cdw11: 0, cdw12: 0,
        cdw13: 0, cdw14: 0, cdw15: 0,
    };

    return nvme_full_submit_admin_cmd(controller, sqe, cap, timestamp);
}

// ─────────────────────────────────────────────────────────────
// NVM: Build Read/Write SQE
// ─────────────────────────────────────────────────────────────

fn nvme_full_build_rw_sqe(
    opcode: NvmeFullIoOpcode,
    nsid: u32,
    slba: u64,
    block_count: u16,
    prp1: u64,
    prp2: u64,
) -> NvmeFullSqe
    effect [deterministic]
{
    let cmd: u32 = (opcode as u32);
    let bcnt: u32 = (block_count as u32) - 1;

    return NvmeFullSqe {
        cdw0: cmd,
        nsid: nsid,
        cdw2: 0, cdw3: 0,
        metadata_ptr: 0,
        data_ptr1: prp1,
        data_ptr2: prp2,
        cdw10: (slba & 0xFFFFFFFF) as u32,
        cdw11: ((slba >> 32) & 0xFFFFFFFF) as u32,
        cdw12: bcnt,
        cdw13: 0,
        cdw14: 0,
        cdw15: 0,
    };
}

// ─────────────────────────────────────────────────────────────
// NVM: Read
// ─────────────────────────────────────────────────────────────

fn nvme_full_read(
    controller: Handle(NvmeFullController),
    nsid: u32,
    slba: u64,
    block_count: u16,
    data_phys: u64,
    data_size: u64,
    queue_idx: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
) -> Result(u16, NvmeFullError)
    effect [memory:mmio, deterministic, residual]
    court "nvme_full_read:v1"
{
    if !cap.can_read {
        return Result::Err(NvmeFullError::NvmeCapabilityError);
    };

    let prp1: u64 = 0;
    let prp2: u64 = 0;
    let prp_res: Result(void, NvmeFullError) = nvme_full_build_prp(
        controller, data_phys, data_size,
        Handle(u64)::from_ptr(&prp1),
        Handle(u64)::from_ptr(&prp2),
        Handle(NvmeFullPrpList)::from_ptr(&controller.prp_pool),
    );
    match prp_res {
        Result::Err(e) => { return Result::Err(e); },
        Result::Ok(_) => {},
    };

    let sqe: NvmeFullSqe = nvme_full_build_rw_sqe(NvmeFullIoOpcode::Read, nsid, slba, block_count, prp1, prp2);
    let result: Result(u16, NvmeFullError) = nvme_full_submit_io_cmd(controller, sqe, queue_idx, cap, timestamp);
    match result {
        Result::Ok(cmd_id) => {
            residual emit {
                op: "nvme_full.read",
                nsid: nsid as u64,
                slba: slba,
                block_count: block_count as u64,
                data_phys: data_phys,
                qid: queue_idx as u64,
                cmd_id: cmd_id as u64,
                timestamp: timestamp,
            };
            return Result::Ok(cmd_id);
        },
        Result::Err(e) => { return Result::Err(e); },
    };
}

// ─────────────────────────────────────────────────────────────
// NVM: Write
// ─────────────────────────────────────────────────────────────

fn nvme_full_write(
    controller: Handle(NvmeFullController),
    nsid: u32,
    slba: u64,
    block_count: u16,
    data_phys: u64,
    data_size: u64,
    queue_idx: u16,
    cap: NvmeFullCapability,
    timestamp: u64,
