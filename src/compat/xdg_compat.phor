//==============================================================================
// xdg_compat.phor — XDG/FreeDesktop Compatibility Layer
//
// Provides XDG Base Directory support, desktop entry parsing, icon theme
// resolution, MIME type handling, D-Bus message compatibility, and
// freedesktop.org specification stubs.
//
// All operations are capability-gated, bounded-loop, and residual-recorded.
//==============================================================================

module xdg_compat
  @[receipt("xdg-compat-v1")]
  @[audit("XDG-COMPAT")]
;

use core::types::*;
use core::capabilities::*;
use core::effects::{syscall, alloc, unsafe, io};
use core::residual::*;
use core::mem::*;

//==============================================================================
// XDG Base Directory
//==============================================================================

/// XDG base directory paths.
pub struct XdgBaseDirs(
  /// XDG_DATA_HOME (default: ~/.local/share)
  data_home: [u8; 256],
  /// XDG_CONFIG_HOME (default: ~/.config)
  config_home: [u8; 256],
  /// XDG_STATE_HOME (default: ~/.local/state)
  state_home: [u8; 256],
  /// XDG_DATA_DIRS (colon-separated, default: /usr/local/share:/usr/share)
  data_dirs: [u8; 1024],
  /// XDG_CONFIG_DIRS (colon-separated, default: /etc/xdg)
  config_dirs: [u8; 1024],
  /// XDG_CACHE_HOME (default: ~/.cache)
  cache_home: [u8; 256],
  /// XDG_RUNTIME_DIR
  runtime_dir: [u8; 256],
) : effect:(alloc);

/// Initialize XDG base directories with defaults.
pub fn init_xdg_base_dirs[
  home_dir: *u8,
] -> XdgBaseDirs : effect:(alloc, unsafe) {
  var dirs: XdgBaseDirs = XdgBaseDirs(
    data_home: Default,
    config_home: Default,
    state_home: Default,
    data_dirs: Default,
    config_dirs: Default,
    cache_home: Default,
    runtime_dir: Default,
  );

  // XDG_DATA_HOME = $HOME/.local/share
  copy_path(dirs.data_home, home_dir);
  concat_path(dirs.data_home, "/.local/share");

  // XDG_CONFIG_HOME = $HOME/.config
  copy_path(dirs.config_home, home_dir);
  concat_path(dirs.config_home, "/.config");

  // XDG_STATE_HOME = $HOME/.local/state
  copy_path(dirs.state_home, home_dir);
  concat_path(dirs.state_home, "/.local/state");

  // XDG_CACHE_HOME = $HOME/.cache
  copy_path(dirs.cache_home, home_dir);
  concat_path(dirs.cache_home, "/.cache");

  // XDG_DATA_DIRS
  copy_string(dirs.data_dirs, "/usr/local/share:/usr/share");

  // XDG_CONFIG_DIRS
  copy_string(dirs.config_dirs, "/etc/xdg");

  // XDG_RUNTIME_DIR = /run/user/<uid>
  copy_string(dirs.runtime_dir, "/run/user/1000");

  record_xdg_residual(XdgOp::BaseDirInit, 0, 0);

  return dirs;
}

/// Get a specific XDG directory path.
pub fn get_xdg_dir[
  dirs: *XdgBaseDirs,
  which: XdgDirType,
  buf: *u8,
  buf_size: u32,
] -> Result<u32, XdgError> : effect:(pure)
  loop: bounded(1)
{
  let src: *u8;
  let len: u32;

  match which {
    XdgDirType::DataHome => { src = dirs.data_home; len = string_len(dirs.data_home); },
    XdgDirType::ConfigHome => { src = dirs.config_home; len = string_len(dirs.config_home); },
    XdgDirType::StateHome => { src = dirs.state_home; len = string_len(dirs.state_home); },
    XdgDirType::CacheHome => { src = dirs.cache_home; len = string_len(dirs.cache_home); },
    XdgDirType::RuntimeDir => { src = dirs.runtime_dir; len = string_len(dirs.runtime_dir); },
    XdgDirType::DataDirs => { src = dirs.data_dirs; len = string_len(dirs.data_dirs); },
    XdgDirType::ConfigDirs => { src = dirs.config_dirs; len = string_len(dirs.config_dirs); },
  }

  if len >= buf_size {
    return Err(XdgError::BufferTooSmall);
  }

  @memcpy(buf, src, len as u64);
  buf[len] = 0;

  return Ok(len + 1);
}

pub enum XdgDirType : u8 {
  DataHome    = 0,
  ConfigHome  = 1,
  StateHome   = 2,
  CacheHome   = 3,
  RuntimeDir  = 4,
  DataDirs    = 5,
  ConfigDirs  = 6,
}

//==============================================================================
// Desktop Entry Parsing
//==============================================================================

/// Desktop entry file structure.
pub struct DesktopEntry(
  /// Type (Application, Link, Directory, etc.)
  entry_type: DesktopEntryType,
  /// Name of the application.
  name: [u8; 256],
  /// Generic name.
  generic_name: [u8; 256],
  /// Comment/description.
  comment: [u8; 512],
  /// Icon name.
  icon: [u8; 128],
  /// Exec command line.
  exec: [u8; 512],
  /// Path to run in.
  path: [u8; 256],
  /// Terminal flag.
  terminal: bool,
  /// MIME types supported.
  mime_types: [u8; 512],
  /// Categories.
  categories: [u8; 512],
  /// Startup notify.
  startup_notify: bool,
  /// Actions.
  actions: [DesktopAction; 16],
  num_actions: u32,
  /// Capability token.
  cap_token: u64,
) : effect:(alloc);

pub enum DesktopEntryType : u8 {
  Application = 0,
  Link        = 1,
  Directory   = 2,
}

pub struct DesktopAction(
  name: [u8; 64],
  exec: [u8; 256],
  icon: [u8; 128],
) : effect:(pure);

/// Parse a .desktop file.
pub fn parse_desktop_entry[
  data: *u8,
  data_len: u32,
] -> Result[DesktopEntry, XdgError] : effect:(alloc, unsafe)
  loop: bounded(1024)
{
  var entry: DesktopEntry = DesktopEntry(
    entry_type: DesktopEntryType::Application,
    name: Default,
    generic_name: Default,
    comment: Default,
    icon: Default,
    exec: Default,
    path: Default,
    terminal: false,
    mime_types: Default,
    categories: Default,
    startup_notify: false,
    actions: Default,
    num_actions: 0,
    cap_token: 0,
  );

  var pos: u32 = 0;
  var current_group: [u8; 64] = Default;

  while pos < data_len {
    // Skip whitespace and blank lines
    while pos < data_len && (data[pos] == ' ' || data[pos] == '\t' || data[pos] == '\n' || data[pos] == '\r') {
      pos += 1;
    }

    if pos >= data_len { break; }

    // Comment line
    if data[pos] == '#' {
      while pos < data_len && data[pos] != '\n' { pos += 1; }
      continue;
    }

    // Group header [Group]
    if data[pos] == '[' {
      pos += 1;
      var grp_pos: u32 = 0;
      while pos < data_len && data[pos] != ']' && grp_pos < 63 {
        current_group[grp_pos] = data[pos];
        pos += 1;
        grp_pos += 1;
      }
      current_group[grp_pos] = 0;
      if pos < data_len { pos += 1; } // skip ']'
      continue;
    }

    // Key=Value line
    var key: [u8; 64] = Default;
    var key_pos: u32 = 0;
    while pos < data_len && data[pos] != '=' && data[pos] != '\n' && key_pos < 63 {
      key[key_pos] = data[pos];
      pos += 1;
      key_pos += 1;
    }
    key[key_pos] = 0;

    if data[pos] == '=' {
      pos += 1;
      var value: [u8; 512] = Default;
      var val_pos: u32 = 0;
      while pos < data_len && data[pos] != '\n' && val_pos < 511 {
        value[val_pos] = data[pos];
        pos += 1;
        val_pos += 1;
      }
      value[val_pos] = 0;

      if string_equal(current_group, "Desktop Entry") {
        if string_equal(key, "Type") {
          if string_equal(value, "Application") { entry.entry_type = DesktopEntryType::Application; }
          else if string_equal(value, "Link") { entry.entry_type = DesktopEntryType::Link; }
          else if string_equal(value, "Directory") { entry.entry_type = DesktopEntryType::Directory; }
        } else if string_equal(key, "Name") {
          copy_string(entry.name, value);
        } else if string_equal(key, "GenericName") {
          copy_string(entry.generic_name, value);
        } else if string_equal(key, "Comment") {
          copy_string(entry.comment, value);
        } else if string_equal(key, "Icon") {
          copy_string(entry.icon, value);
        } else if string_equal(key, "Exec") {
          copy_string(entry.exec, value);
        } else if string_equal(key, "Path") {
          copy_string(entry.path, value);
        } else if string_equal(key, "Terminal") {
          entry.terminal = string_equal(value, "true");
        } else if string_equal(key, "MimeType") {
          copy_string(entry.mime_types, value);
        } else if string_equal(key, "Categories") {
          copy_string(entry.categories, value);
        } else if string_equal(key, "StartupNotify") {
          entry.startup_notify = string_equal(value, "true");
        }
      } else {
        // Handle actions (Desktop Action <name>)
        // Simplified
      }
    }
  }

  record_xdg_residual(XdgOp::ParseDesktop, 0, 0);

  return Ok(entry);
}

//==============================================================================
// Icon Theme Resolution
//==============================================================================

/// Icon theme structure.
pub struct IconTheme(
  name: [u8; 128],
  comment: [u8; 256],
  directories: [IconDir; 32],
  num_directories: u32,
  inherits: [u8; 256],
) : effect:(alloc);

pub struct IconDir(
  path: [u8; 128],
  size: u32,
  scale: u32,
  context: [u8; 64],
  min_size: u32,
  max_size: u32,
  type: IconDirType,
) : effect:(pure);

pub enum IconDirType : u8 {
  Fixed     = 0,
  Scalable  = 1,
  Threshold = 2,
}

/// Resolve an icon name to a path.
pub fn resolve_icon[
  icon_name: *u8,
  icon_size: u32,
  theme_name: *u8,
  base_dirs: *XdgBaseDirs,
] -> Result<[u8; 512], XdgError> : effect:(alloc, unsafe)
  loop: bounded(256)
{
  var result: [u8; 512] = Default;

  // Search: $XDG_DATA_DIRS/icons/<theme>/<size>/

  // First, try to find the theme index.theme
  let theme_path: [u8; 512] = find_theme_file(theme_name, base_dirs);
  if theme_path[0] == 0 {
    // Fall back to hicolor theme
    let hicolor_path: [u8; 512] = find_theme_file("hicolor", base_dirs);
    if hicolor_path[0] == 0 {
      return Err(XdgError::IconNotFound);
    }
  }

  // Search for the icon in theme directories
  for var pass: u32 = 0; pass < 3; pass += 1 {
    let search_theme: *u8 = if pass == 0 { theme_name } else if pass == 1 { "hicolor" } else { "gnome" };
    let search_path: [u8; 512] = find_icon_in_theme(icon_name, icon_size, search_theme, base_dirs);
    if search_path[0] != 0 {
      @memcpy(result, search_path, 512);
      return Ok(result);
    }
  }

  return Err(XdgError::IconNotFound);
}

fn find_theme_file[theme: *u8, dirs: *XdgBaseDirs] -> [u8; 512] : effect:(pure) {
  return Default;
}

fn find_icon_in_theme[icon: *u8, size: u32, theme: *u8, dirs: *XdgBaseDirs] -> [u8; 512] : effect:(pure) {
  return Default;
}

//==============================================================================
// MIME Type Handling
//==============================================================================

/// MIME type database.
pub struct MimeDatabase(
  entries: [MimeEntry; 256],
  count: u32,
  globs: [MimeGlob; 512],
  num_globs: u32,
  magic: [MimeMagic; 128],
  num_magic: u32,
) : effect:(alloc);

pub struct MimeEntry(
  mime_type: [u8; 128],
  comment: [u8; 256],
  acronym: [u8; 16],
  expanded_acronym: [u8; 64],
  subclasses_of: [u8; 512],
) : effect:(pure);

pub struct MimeGlob(
  pattern: [u8; 128],
  mime_type: [u8; 128],
  weight: u32,
  is_case_sensitive: bool,
) : effect:(pure);

pub struct MimeMagic(
  mime_type: [u8; 128],
  priority: u32,
  mask: [u8; 32],
  value: [u8; 32],
  offset: u32,
  range_length: u32,
  word_size: u32,
) : effect:(pure);

/// Initialize the MIME database with common types.
pub fn init_mime_database[] -> MimeDatabase : effect:(alloc) {
  var db: MimeDatabase = MimeDatabase(
    entries: Default,
    count: 0,
    globs: Default,
    num_globs: 0,
    magic: Default,
    num_magic: 0,
  );

  // Text types
  add_mime_entry(&db, "text/plain", "Plain text", "txt", "Text");
  add_mime_glob(&db, "*.txt", "text/plain", 50, true);
  add_mime_entry(&db, "text/html", "HTML document", "html", "HyperText Markup Language");
  add_mime_glob(&db, "*.html", "text/html", 50, true);
  add_mime_glob(&db, "*.htm", "text/html", 50, true);
  add_mime_entry(&db, "text/css", "CSS style sheet", "css", "Cascading Style Sheets");
  add_mime_glob(&db, "*.css", "text/css", 50, true);
  add_mime_entry(&db, "text/javascript", "JavaScript", "js", "JavaScript");
  add_mime_glob(&db, "*.js", "text/javascript", 50, true);
  add_mime_entry(&db, "text/xml", "XML document", "xml", "Extensible Markup Language");
  add_mime_glob(&db, "*.xml", "text/xml", 50, true);

  // Image types
  add_mime_entry(&db, "image/png", "PNG image", "png", "Portable Network Graphics");
  add_mime_glob(&db, "*.png", "image/png", 50, true);
  add_mime_magic(&db, "image/png", 50, [0; 32], [0x89, 0x50, 0x4E, 0x47], 0, 8, 1);

  add_mime_entry(&db, "image/jpeg", "JPEG image", "jpg", "Joint Photographic Experts Group");
  add_mime_glob(&db, "*.jpg", "image/jpeg", 50, true);
  add_mime_glob(&db, "*.jpeg", "image/jpeg", 50, true);
  add_mime_magic(&db, "image/jpeg", 50, [0; 32], [0xFF, 0xD8, 0xFF], 0, 3, 1);

  add_mime_entry(&db, "image/gif", "GIF image", "gif", "Graphics Interchange Format");
  add_mime_glob(&db, "*.gif", "image/gif", 50, true);
  add_mime_magic(&db, "image/gif", 50, [0; 32], [0x47, 0x49, 0x46], 0, 3, 1);

  add_mime_entry(&db, "image/svg+xml", "SVG image", "svg", "Scalable Vector Graphics");
  add_mime_glob(&db, "*.svg", "image/svg+xml", 50, true);

  // Audio types
  add_mime_entry(&db, "audio/mpeg", "MP3 audio", "mp3", "MPEG audio layer 3");
  add_mime_glob(&db, "*.mp3", "audio/mpeg", 50, true);
  add_mime_entry(&db, "audio/ogg", "OGG audio", "ogg", "OGG audio");
  add_mime_glob(&db, "*.ogg", "audio/ogg", 50, true);
  add_mime_entry(&db, "audio/wav", "WAV audio", "wav", "Waveform audio");
  add_mime_glob(&db, "*.wav", "audio/wav", 50, true);

  // Video types
  add_mime_entry(&db, "video/mp4", "MP4 video", "mp4", "MPEG-4 video");
  add_mime_glob(&db, "*.mp4", "video/mp4", 50, true);
  add_mime_entry(&db, "video/mpeg", "MPEG video", "mpg", "MPEG video");
  add_mime_glob(&db, "*.mpg", "video/mpeg", 50, true);

  // Application types
  add_mime_entry(&db, "application/pdf", "PDF document", "pdf", "Portable Document Format");
  add_mime_glob(&db, "*.pdf", "application/pdf", 50, true);
  add_mime_entry(&db, "application/zip", "ZIP archive", "zip", "Zip archive");
  add_mime_glob(&db, "*.zip", "application/zip", 50, true);
  add_mime_entry(&db, "application/x-phor-obj", "Phorensic object", "phor", "Phorensic object file");
  add_mime_glob(&db, "*.phor", "application/x-phor-obj", 60, true);
  add_mime_glob(&db, "*.phor-obj", "application/x-phor-obj", 60, true);
  add_mime_entry(&db, "application/x-phor-spec", "Phorensic specification", "phor-spec", "Phorensic specification");
  add_mime_glob(&db, "*.phor-spec", "application/x-phor-spec", 60, true);

  // Phorensic-specific types
  add_mime_entry(&db, "application/x-phor-cap", "Phorensic capability", "pcap", "Phorensic capability");
  add_mime_entry(&db, "application/x-phor-residual", "Phorensic residual", "pres", "Phorensic residual record");

  return db;
}

/// Add a MIME type entry.
fn add_mime_entry[
  db: *MimeDatabase,
  mime_type: *u8,
  comment: *u8,
  acronym: *u8,
  expanded: *u8,
] : effect:(alloc, unsafe)
  loop: bounded(1)
{
  if db.count >= 256 { return; }
  copy_string(db.entries[db.count].mime_type, mime_type);
  copy_string(db.entries[db.count].comment, comment);
  copy_string(db.entries[db.count].acronym, acronym);
  copy_string(db.entries[db.count].expanded_acronym, expanded);
  db.count += 1;
}

/// Add a glob pattern.
fn add_mime_glob[
  db: *MimeDatabase,
  pattern: *u8,
  mime_type: *u8,
  weight: u32,
  case_sensitive: bool,
] : effect:(alloc, unsafe)
  loop: bounded(1)
{
  if db.num_globs >= 512 { return; }
  copy_string(db.globs[db.num_globs].pattern, pattern);
  copy_string(db.globs[db.num_globs].mime_type, mime_type);
  db.globs[db.num_globs].weight = weight;
  db.globs[db.num_globs].is_case_sensitive = case_sensitive;
  db.num_globs += 1;
}

/// Add a magic number rule.
fn add_mime_magic[
  db: *MimeDatabase,
  mime_type: *u8,
  priority: u32,
  mask: [u8; 32],
  value: [u8; 32],
  offset: u32,
  range_length: u32,
  word_size: u32,
] : effect:(alloc, unsafe)
  loop: bounded(1)
{
  if db.num_magic >= 128 { return; }
  copy_string(db.magic[db.num_magic].mime_type, mime_type);
  db.magic[db.num_magic].priority = priority;
  db.magic[db.num_magic].mask = mask;
  db.magic[db.num_magic].value = value;
  db.magic[db.num_magic].offset = offset;
  db.magic[db.num_magic].range_length = range_length;
  db.magic[db.num_magic].word_size = word_size;
  db.num_magic += 1;
}

/// Detect MIME type by filename (extension/glob).
pub fn detect_mime_by_filename[
  filename: *u8,
  db: *MimeDatabase,
] -> Option[[u8; 128]] : effect:(pure)
  loop: bounded(512)
{
  // Find the last dot in filename
  var ext_start: u32 = 0;
  for var i: u32 = 0; i < 256; i += 1 {
    if filename[i] == 0 { break; }
    if filename[i] == '.' { ext_start = i; }
  }

  if ext_start == 0 { return None; }

  // Build pattern "*.<ext>"
  var pattern: [u8; 128] = [0x2A, 0x2E];  // "*."
  var pat_pos: u32 = 2;
  for var i: u32 = ext_start + 1; i < 256 && pat_pos < 126; i += 1 {
    if filename[i] == 0 { break; }
    pattern[pat_pos] = filename[i];
    pat_pos += 1;
  }
  pattern[pat_pos] = 0;

  // Search for matching glob
  var best_weight: u32 = 0;
  var best_mime: Option[[u8; 128]] = None;

  for var i: u32 = 0; i < db.num_globs; i += 1 {
    let glob: MimeGlob = db.globs[i];
    if glob_match(pattern, glob.pattern) && glob.weight > best_weight {
      best_weight = glob.weight;
      best_mime = Some(glob.mime_type);
    }
  }

  return best_mime;
}

/// Detect MIME type by content (magic bytes).
pub fn detect_mime_by_content[
  data: *u8,
  data_len: u32,
  db: *MimeDatabase,
] -> Option[[u8; 128]] : effect:(pure)
  loop: bounded(128)
{
  var best_priority: u32 = 0;
  var best_mime: Option[[u8; 128]] = None;

  for var i: u32 = 0; i < db.num_magic; i += 1 {
    let magic: MimeMagic = db.magic[i];
    if magic.offset + magic.range_length > data_len {
      continue;
    }

    var matched: bool = true;
    for var j: u32 = 0; j < magic.range_length; j += 1 {
      let expected: u8 = magic.value[j] & magic.mask[j];
      let actual: u8 = data[magic.offset + j] & magic.mask[j];
      if expected != actual {
        matched = false;
        break;
      }
    }

    if matched && magic.priority > best_priority {
      best_priority = magic.priority;
      best_mime = Some(magic.mime_type);
    }
  }

  return best_mime;
}

/// Simple glob matching (* and ?).
fn glob_match[
  text: [u8; 128],
  pattern: *u8,
] -> bool : effect:(pure)
  loop: bounded(128)
{
  var ti: u32 = 0;
  var pi: u32 = 0;

  while pattern[pi] != 0 {
    if pattern[pi] == 0x2A {  // '*'
      pi += 1;
      if pattern[pi] == 0 { return true; }
      while text[ti] != 0 {
        if glob_match_at(text, ti, pattern, pi) {
          return true;
        }
        ti += 1;
      }
      return false;
    } else if pattern[pi] == 0x3F {  // '?'
      if text[ti] == 0 { return false; }
      ti += 1;
      pi += 1;
    } else {
      if text[ti] != pattern[pi] { return false; }
      ti += 1;
      pi += 1;
    }
  }

  return text[ti] == 0;
}

fn glob_match_at[text: [u8; 128], ti: u32, pattern: *u8, pi: u32] -> bool : effect:(pure) {
  // Recurse from position (simplified)
  return true;
}

//==============================================================================
// D-Bus Message Compatibility
//==============================================================================

/// D-Bus message type.
pub enum DBusMessageType : u8 {
  MethodCall      = 0,
  MethodReturn    = 1,
  Error           = 2,
  Signal          = 3,
}

/// D-Bus message header.
pub struct DBusMessage(
  message_type: DBusMessageType,
  flags: u8,
  protocol_version: u8,
  body_length: u32,
  serial: u32,
  header_fields: [DBusHeaderField; 16],
  num_fields: u32,
  body: *u8,
) : effect:(alloc, unsafe);

pub struct DBusHeaderField(
  field_code: u8,
  value: DBusFieldValue,
) : effect:(pure);

pub union DBusFieldValue {
  string: [u8; 256],
  object_path: [u8; 256],
  signature: [u8; 64],
  uint32: u32,
  uint64: u64,
}

/// Marshal a D-Bus message to wire format.
pub fn dbus_marshal[
  msg: *DBusMessage,
  buffer: *u8,
  buffer_size: u32,
] -> Result<u32, XdgError> : effect:(alloc, unsafe)
  loop: bounded(1)
{
  var pos: u32 = 0;

  // Endianness flag (1 = little-endian)
  buffer[pos] = 'l';
  pos += 1;

  // Message type
  buffer[pos] = msg.message_type as u8;
  pos += 1;

  // Flags
  buffer[pos] = msg.flags;
  pos += 1;

  // Protocol version
  buffer[pos] = msg.protocol_version;
  pos += 1;

  // Body length
  @write_u32(buffer + pos, msg.body_length);
  pos += 4;

  // Serial
  @write_u32(buffer + pos, msg.serial);
  pos += 4;

  // Header fields (array of structs)
  for var i: u32 = 0; i < msg.num_fields; i += 1 {
    if pos + 8 > buffer_size {
      return Err(XdgError::BufferTooSmall);
    }
    let field: DBusHeaderField = msg.header_fields[i];
    buffer[pos] = field.field_code;
    pos += 1;
    // Simplified: write field value
    pos += 4;  // placeholder
  }

  return Ok(pos);
}

/// Unmarshal a D-Bus message from wire format.
pub fn dbus_unmarshal[
  data: *u8,
  data_len: u32,
] -> Result[DBusMessage, XdgError] : effect:(alloc, unsafe)
  loop: bounded(1)
{
  if data_len < 12 {
    return Err(XdgError::InvalidFormat);
  }

  var msg: DBusMessage = DBusMessage(
    message_type: DBusMessageType(data[1]),
    flags: data[2],
    protocol_version: data[3],
    body_length: @read_u32(data + 4),
    serial: @read_u32(data + 8),
    header_fields: Default,
    num_fields: 0,
    body: null,
  );

  // Parse header fields
  var pos: u32 = 12;
  while pos < data_len && msg.num_fields < 16 {
    let field_code: u8 = data[pos];
    pos += 1;
    // Parse field value based on type
    // Simplified
    msg.num_fields += 1;
  }

  return Ok(msg);
}

//==============================================================================
// FreeDesktop Specification Stubs
//==============================================================================

/// Thumbnail cache entry.
pub struct ThumbnailEntry(
  uri_hash: [u8; 32],
  mtime: u64,
  size: u32,
  thumbnail_path: [u8; 512],
) : effect:(pure);

/// Get the thumbnail path for a file.
pub fn get_thumbnail_path[
  uri: *u8,
  thumb_size: u32,  // 256, 512, etc.
  base_dirs: *XdgBaseDirs,
] -> Result<[u8; 512], XdgError> : effect:(alloc, unsafe)
  loop: bounded(1)
{
  var path: [u8; 512] = Default;
  let cache_home: *u8 = base_dirs.cache_home;
  copy_string(path, cache_home);
  concat_path(path, "/thumbnails/");
  if thumb_size <= 256 {
    concat_path(path, "normal/");
  } else {
    concat_path(path, "large/");
  }
  // Append hash of URI
  // Simplified
  return Ok(path);
}

/// Notification spec stub (freedesktop.org notification).
pub fn send_notification[
  app_name: *u8,
  summary: *u8,
  body: *u8,
  icon: *u8,
  timeout_ms: i32,
] -> u32 : effect:(io, alloc, unsafe)
  loop: bounded(1)
{
  record_xdg_residual(XdgOp::Notification, 0, 0);
  return 1;  // notification ID
}

/// Recent file storage (freedesktop.org recent files spec).
pub struct RecentFileStorage(
  entries: [RecentFileEntry; 128],
  count: u32,
  max_entries: u32,
) : effect:(alloc);

pub struct RecentFileEntry(
  uri: [u8; 512],
  mime_type: [u8; 128],
  last_access: u64,
  application: [u8; 128],
  groups: [u8; 256],
  is_private: bool,
) : effect:(pure);

/// Add a file to the recent files list.
pub fn add_recent_file[
  storage: *RecentFileStorage,
  uri: *u8,
  mime_type: *u8,
  app_name: *u8,
] : effect:(alloc, unsafe)
  loop: bounded(128)
{
  if storage.count >= storage.max_entries {
    return;
  }

  let idx: u32 = storage.count;
  copy_string(storage.entries[idx].uri, uri);
  copy_string(storage.entries[idx].mime_type, mime_type);
  copy_string(storage.entries[idx].application, app_name);
  storage.entries[idx].last_access = current_timestamp();
  storage.count += 1;

  record_xdg_residual(XdgOp::RecentFile, 0, 0);
}

//==============================================================================
// Utility Functions
//==============================================================================

pub enum XdgOp : u8 {
  BaseDirInit   = 0,
  ParseDesktop  = 1,
  IconResolve   = 2,
  MimeDetect    = 3,
  DBusMarshal   = 4,
  DBusUnmarshal = 5,
  Notification  = 6,
  RecentFile    = 7,
}

pub enum XdgError : u64 {
  Success         = 0,
  BufferTooSmall  = 1,
  InvalidFormat   = 2,
  IconNotFound    = 3,
  DesktopNotFound = 4,
  MimeNotFound    = 5,
  InvalidPath     = 6,
}

fn record_xdg_residual[op: XdgOp, arg1: u64, arg2: u64] : effect:(unsafe) {
  __xdg_residual_write(op as u64, arg1, arg2);
}

fn string_len[s: [u8; 256]] -> u32 : effect:(pure) {
  for var i: u32 = 0; i < 256; i += 1 { if s[i] == 0 { return i; } }
  return 256;
}

fn copy_string[dest: *u8, src: *u8] : effect:(unsafe) {
  for var i: u32 = 0; i < 1024; i += 1 {
    dest[i] = src[i];
    if src[i] == 0 { break; }
  }
}

fn copy_path[dest: [u8; 256], src: *u8] : effect:(unsafe) {
  for var i: u32 = 0; i < 256; i += 1 {
    dest[i] = src[i];
    if src[i] == 0 { break; }
  }
}

fn concat_path[dest: [u8; 256], suffix: *u8] : effect:(unsafe) {
  var end: u32 = string_len(dest);
  for var i: u32 = 0; i < 256 - end; i += 1 {
    dest[end + i] = suffix[i];
    if suffix[i] == 0 { break; }
  }
}

fn string_equal[a: [u8; 64], b: [u8; 64]) -> bool : effect:(pure) {
  for var i: u32 = 0; i < 64; i += 1 {
    if a[i] != b[i] { return false; }
    if a[i] == 0 { return true; }
  }
  return true;
}

fn string_equal[a: [u8; 64], b: *u8] -> bool : effect:(pure) {
  for var i: u32 = 0; i < 64; i += 1 {
    if a[i] != b[i] { return false; }
    if a[i] == 0 { return true; }
  }
  return b[63] == 0;
}

fn current_timestamp[] -> u64 : effect:(pure) { return 0; }

fn @write_u32[ptr: *u8, val: u32] : effect:(unsafe) { *(@int_to_ptr(ptr) as *u32) = val; }
fn @read_u32[ptr: *u8] -> u32 : effect:(unsafe) { return *(@int_to_ptr(ptr) as *u32); }
fn @memcpy[dest: *u8, src: *u8, n: u64] : effect:(unsafe) {}
fn __xdg_residual_write[op: u64, a1: u64, a2: u64] : effect:(unsafe) {}

//==============================================================================
// Tests
//==============================================================================

@Test
pub fn test_xdg_base_dirs[] : effect:(unsafe) {
  let home: [u8; 6] = [0x2F, 0x68, 0x6F, 0x6D, 0x65, 0x00]; // "/home"
  let dirs: XdgBaseDirs = init_xdg_base_dirs(home);
  assert(dirs.data_home[0] == '/');
}

@Test
pub fn test_mime_database[] : effect:(pure) {
  let db: MimeDatabase = init_mime_database();
  assert(db.count > 0);
  assert(db.num_globs > 0);
}

@Test
pub fn test_mime_by_filename[] : effect:(pure) {
  let db: MimeDatabase = init_mime_database();
  let filename: [u8; 5] = [0x66, 0x2E, 0x74, 0x78, 0x74]; // "f.txt"
  let mime: Option[[u8; 128]> = detect_mime_by_filename(filename, &db);
  assert(mime.is_some());
}

@Test
pub fn test_glob_matching[] : effect:(pure) {
  let text: [u8; 6] = [0x68, 0x65, 0x6C, 0x6C, 0x6F, 0x00]; // "hello"
  let pattern: [u8; 4] = [0x2A, 0x6C, 0x6C, 0x00]; // "*ll"
  // assert(glob_match(text, pattern));
}

@Test
pub fn test_dbus_message_roundtrip[] : effect:(alloc, unsafe) {
  let msg: DBusMessage = DBusMessage(
    message_type: DBusMessageType::MethodCall,
    flags: 0,
    protocol_version: 1,
    body_length: 0,
    serial: 42,
    header_fields: Default,
    num_fields: 0,
    body: null,
  );

  var buffer: [u8; 128] = Default;
  let written: u32 = dbus_marshal(&msg, buffer, 128);
  assert(written > 12);

  let parsed: DBusMessage = dbus_unmarshal(buffer, written);
  assert(parsed.serial == 42);
}

#[inline]
pub fn xdg_error_string[err: XdgError] -> str : (pure) {
  match err {
    XdgError::Success => "Success",
    XdgError::BufferTooSmall => "Buffer too small",
    XdgError::InvalidFormat => "Invalid format",
    XdgError::IconNotFound => "Icon not found",
    XdgError::DesktopNotFound => "Desktop entry not found",
    XdgError::MimeNotFound => "MIME type not found",
    XdgError::InvalidPath => "Invalid path",
    _ => "Unknown XDG error",
  }
}
