    line.append(Str::from("  Avg trust level: "));
    line.append(ts.avg_trust_level as Str(16));
    line.append(Str::from("\n"));
    console.write(line);

    let mut line2: Str(256) = Str::from("Unknown: ");
    line2.append(ts.unknown_count as Str(16));
    line2.append(Str::from("  Observed: "));
    line2.append(ts.observed_count as Str(16));
    line2.append(Str::from("  Replayed: "));
    line2.append(ts.replayed_count as Str(16));
    line2.append(Str::from("  OracleCmp: "));
    line2.append(ts.oracle_compared_count as Str(16));
    line2.append(Str::from("\n"));
    console.write(line2);

    let mut line3: Str(256) = Str::from("ResidualStable: ");
