// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const SMBIOS_ANCHOR_32: FixedString[4] = "_SM_"
const SMBIOS_ANCHOR_64: FixedString[5] = "_SM3_"
const SMBIOS_INTERMEDIATE_32: FixedString[5] = "_DMI_"
const SMBIOS_INTERMEDIATE_64: FixedString[5] = "_DMI_"
const MAX_STRUCTURE_TYPES: u32 = 48
const MAX_DMI_STRINGS: u32 = 32
const MAX_STRING_LEN: u32 = 128
const MAX_SMBIOS_STRUCTURES: u32 = 256
const MAX_MEMORY_DEVICES: u32 = 32
const MAX_PROCESSORS: u32 = 8
const MAX_CACHE_DEVICES: u32 = 16
const MAX_SLOTS: u32 = 16
const MAX_PORT_CONNECTORS: u32 = 16
const MAX_OEM_STRINGS: u32 = 16

// SMBIOS Structure Types
const SMBIOS_TYPE_BIOS_INFO: u8 = 0
const SMBIOS_TYPE_SYSTEM_INFO: u8 = 1
const SMBIOS_TYPE_BASEBOARD: u8 = 2
const SMBIOS_TYPE_CHASSIS: u8 = 3
const SMBIOS_TYPE_PROCESSOR: u8 = 4
const SMBIOS_TYPE_MEMORY_CONTROLLER: u8 = 5
const SMBIOS_TYPE_MEMORY_MODULE: u8 = 6
const SMBIOS_TYPE_CACHE: u8 = 7
const SMBIOS_TYPE_PORT_CONNECTOR: u8 = 8
const SMBIOS_TYPE_SLOT: u8 = 9
const SMBIOS_TYPE_ONBOARD_DEVICES: u8 = 10
const SMBIOS_TYPE_OEM_STRINGS: u8 = 11
const SMBIOS_TYPE_SYSTEM_CONFIG: u8 = 12
const SMBIOS_TYPE_BIOS_LANGUAGE: u8 = 13
const SMBIOS_TYPE_GROUP_ASSOC: u8 = 14
const SMBIOS_TYPE_SYSTEM_EVENT_LOG: u8 = 15
const SMBIOS_TYPE_PHYSICAL_MEMORY_ARRAY: u8 = 16
const SMBIOS_TYPE_MEMORY_DEVICE: u8 = 17
const SMBIOS_TYPE_32BIT_MEMORY_ERR: u8 = 18
const SMBIOS_TYPE_MEMORY_ARRAY_MAPPED: u8 = 19
const SMBIOS_TYPE_MEMORY_DEVICE_MAPPED: u8 = 20
const SMBIOS_TYPE_BUILTIN_POINTING: u8 = 21
const SMBIOS_TYPE_PORTABLE_BATTERY: u8 = 22
const SMBIOS_TYPE_SYSTEM_RESET: u8 = 23
const SMBIOS_TYPE_HW_SECURITY: u8 = 24
const SMBIOS_TYPE_SYSTEM_POWER_CONTROLS: u8 = 25
const SMBIOS_TYPE_VOLTAGE_PROBE: u8 = 26
