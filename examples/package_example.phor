// package_example.phor — Example package definition
//
// Demonstrates:
//   - Package declaration with name and version
//   - Source evidence structure
//   - Build recipe specification
//   - Compilation evidence sections
//   - Source↔binary seal rule
//   - Signature and trust state documentation
//   - Replay evidence structure
//   - Court evidence references
//   - Package verification steps
//   - Multi-section container structure
//   - Dependency graph verification
//   - Evidence chain validation
//   - Auditor stamp verification
//   - Container hash consistency
//   - Package activation prerequisites
//
// Expected outcomes:
//   - Package is a valid .phor-spec container structure ✓
//   - All required evidence sections are present ✓
//   - Source-seal chain is documented ✓
//   - Signatures cover source, binary, and evidence chain ✓
//   - Trust state is consistent with evidence ✓
//   - Audit stamps are valid and match policy ✓
//
// Compilation: accepted (descriptive package manifest)
// Trust state: Sealed (by construction)

package "phorensic:package_example:v1.0";

struct PackageManifest {
    name: Str(64),
    version: Str(16),
    source_files: u32,
    dialect: Str(32),
    compiler: Str(32),
    target_arch: Str(16),
    trust_state: u8,
}

struct SourceEvidence {
    file_count: u32,
    total_size: u64,
    source_hash: u64,
    has_manifest: bool,
    archive_format: Str(8),
}

struct BuildEvidence {
    recipe: Str(128),
    recipe_hash: u64,
    compiler_version: Str(32),
    compiler_hash: u64,
    dependency_count: u32,
    environment_hash: u64,
}

struct BinaryEvidence {
    binary_size: u64,
    binary_hash: u64,
    seal_type: Str(32),
    seal_hash: u64,
    byte_comparison_count: u32,
}

struct SignatureEvidence {
    developer_present: bool,
    developer_valid: bool,
    auditor_count: u32,
    auditors_passed: u32,
    evidence_chain_valid: bool,
}

struct ReplayEvidence {
    has_checkpoints: bool,
    has_residual_graph: bool,
    has_verification_report: bool,
    replay_status: Str(16),
}

fn describe_source_evidence() -> SourceEvidence
    effect [compute]
{
    let evidence: SourceEvidence = SourceEvidence{
        file_count: 3,
        total_size: 2048,
        source_hash: 0xAABBCCDD,
        has_manifest: true,
        archive_format: Str::from("tar.gz"),
    };
    return evidence;
}

fn describe_build_evidence() -> BuildEvidence
    effect [compute]
{
    let evidence: BuildEvidence = BuildEvidence{
        recipe: Str::from("phorensic-build -c default -t x86_64"),
        recipe_hash: 0xBBBBBBBB,
        compiler_version: Str::from("phc 2.1.0"),
        compiler_hash: 0xABCD1234,
        dependency_count: 2,
        environment_hash: 0xCCCCCCCC,
    };
    return evidence;
}

fn describe_binary_evidence() -> BinaryEvidence
    effect [compute]
{
    let evidence: BinaryEvidence = BinaryEvidence{
        binary_size: 2560,
        binary_hash: 0x11223344,
        seal_type: Str::from("ed25519"),
        seal_hash: 0xDEADC0DE,
        byte_comparison_count: 5,
    };
    return evidence;
}

fn describe_signature_evidence() -> SignatureEvidence
    effect [compute]
{
    let evidence: SignatureEvidence = SignatureEvidence{
        developer_present: true,
        developer_valid: true,
        auditor_count: 3,
        auditors_passed: 3,
        evidence_chain_valid: true,
    };
    return evidence;
}

fn verify_evidence_chain(src: SourceEvidence, build: BuildEvidence, binary: BinaryEvidence) -> bool
    effect [compute]
{
    // The evidence chain must link: source → build → binary
    let source_links_to_build: bool = src.file_count > 0 && build.dependency_count > 0;
    let build_links_to_binary: bool = build.compiler_hash != 0 && binary.binary_hash != 0;
    let chain_valid: bool = source_links_to_build && build_links_to_binary;
    return chain_valid;
}

fn check_package_activation_prerequisites(trust_state: u8, sig: SignatureEvidence) -> bool
    effect [compute]
{
    // Activation requires: Sealed (5) or above, all signatures valid
    let trust_ok: bool = trust_state >= 5;
    let sigs_ok: bool = sig.developer_valid && sig.auditors_passed >= 2;
    return trust_ok && sigs_ok;
}

fn main() -> void
    effect [io:write, compute]
{
    let manifest: PackageManifest = PackageManifest{
        name: Str::from("example-utility"),
        version: Str::from("1.0.0"),
        source_files: 3,
        dialect: Str::from("native-phorensic-v1"),
        compiler: Str::from("phc 2.1.0"),
        target_arch: Str::from("x86_64"),
        trust_state: 5, // Sealed
    };

    let src: SourceEvidence = describe_source_evidence();
    let build: BuildEvidence = describe_build_evidence();
    let binary: BinaryEvidence = describe_binary_evidence();
    let sig: SignatureEvidence = describe_signature_evidence();

    assert(src.file_count == 3, "pkg: 3 source files in manifest");
    assert(build.dependency_count == 2, "pkg: 2 build dependencies");
    assert(src.has_manifest, "pkg: source manifest present");
    assert(manifest.trust_state == 5, "pkg: Sealed trust state");
    assert(binary.binary_size == 2560, "pkg: binary size 2560 bytes");
    assert(binary.byte_comparison_count == 5, "pkg: 5 byte provenance mappings");

    // Verify evidence chain
    let chain_valid: bool = verify_evidence_chain(src, build, binary);
    assert(chain_valid, "pkg: evidence chain valid");

    // Verify signatures
    assert(sig.developer_present, "pkg: developer signature present");
    assert(sig.developer_valid, "pkg: developer signature valid");
    assert(sig.auditors_passed == sig.auditor_count, "pkg: all auditors passed");
    assert(sig.evidence_chain_valid, "pkg: evidence chain signature valid");

    // Check activation prerequisites
    let can_activate: bool = check_package_activation_prerequisites(manifest.trust_state, sig);
    assert(can_activate, "pkg: package meets activation prerequisites");

    // Check replay evidence
    let replay: ReplayEvidence = ReplayEvidence{
        has_checkpoints: true,
        has_residual_graph: true,
        has_verification_report: true,
        replay_status: Str::from("full"),
    };
    assert(replay.has_checkpoints, "pkg: replay checkpoints present");
    assert(replay.replay_status == Str::from("full"), "pkg: full replay match");

    // Validate all evidence together
    let all_evidence_valid: bool = src.has_manifest
        && build.dependency_count > 0
        && binary.seal_hash != 0
        && sig.evidence_chain_valid
        && replay.has_verification_report;
    assert(all_evidence_valid, "pkg: all evidence sections valid");

    // Verify trust state vs activation threshold
    let activation_threshold: u8 = 5; // Sealed
    let can_activate_pkg: bool = manifest.trust_state >= activation_threshold;
    assert(can_activate_pkg, "pkg: trust meets activation threshold");

    // Verify that a package below threshold would be rejected
    let low_trust: u8 = 3; // OracleCompared
    let low_can_activate: bool = low_trust >= activation_threshold;
    assert(!low_can_activate, "pkg: low trust cannot activate");

    // In a real build, the compiler would populate all evidence sections:
    //   - source-evidence/ with source snapshot and manifest
    //   - build-evidence/ with recipe and environment capsule
    //   - expansion-evidence/ with expansion receipts
    //   - compilation-evidence/ with pass receipts
    //   - binary-evidence/ with binary and seals
    //   - replay-evidence/ with replay checkpoints
    //   - court-evidence/ with verdicts
    //   - signatures/ with full container signature
}
