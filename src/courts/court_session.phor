// ============================================================================
// court_session.phor — CourtSession Lifecycle: Open, Submit, Run, Compare,
//                       Verdict, Close
// ============================================================================
// A court session is a formal proceeding that evaluates an object's behavior
// against oracles and evidence. Each session follows a strict lifecycle:
// open → submit evidence → run replay → compare with oracle → analyze
// divergence → issue verdict → promote/deny → close.
//
// Every operation produces residuals for replay verification.
// ============================================================================

package "phorensic:court_session:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type CourtSessionError = enum {
    SessionNotOpen = 0x01,
    SessionAlreadyClosed = 0x02,
    SessionAlreadyOpen = 0x03,
    EvidenceNotSubmitted = 0x04,
    ReplayNotRun = 0x05,
    OracleNotAvailable = 0x06,
    ComparisonNotPerformed = 0x07,
    VerdictAlreadyIssued = 0x08,
    VerdictNotReady = 0x09,
    ObjectNotRecognized = 0x0A,
    OracleConnectionFailed = 0x0B,
    EvidenceInsufficient = 0x0C,
    EvidenceCorrupted = 0x0D,
    DivergenceNotClassified = 0x0E,
    TrustPromotionBlocked = 0x0F,
    InternalError = 0xFF,
}

// ============================================================================
// Court Session Status
// ============================================================================

type CourtSessionStatus = enum {
    Closed = 0x00,
    Open = 0x01,
    EvidenceSubmitted = 0x02,
    ReplayCompleted = 0x03,
    OracleCompared = 0x04,
    DivergenceAnalyzed = 0x05,
    VerdictIssued = 0x06,
    PromotionApplied = 0x07,
    Failed = 0x08,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

type Option[T] = enum {
    Some(value: T),
    None,
}

// ============================================================================
// Evidence
// ============================================================================

type CourtEvidence = struct {
    evidence_id: u64,
    evidence_type: CourtEvidenceType,
    data_hash: Hash256,
    description: FixedString[512],
    submitted_at: u64,
    verified: bool,
}

type CourtEvidenceType = enum {
    ResidualBundle = 0x01,
    ExpansionReceipt = 0x02,
    ObservationSession = 0x03,
    CandidateTranslation = 0x04,
    ReplayReport = 0x05,
    ProvenanceRecord = 0x06,
    SourceHash = 0x07,
    BinaryHash = 0x08,
    CompilationReceipt = 0x09,
    CourtVerdictReference = 0x0A,
    TrustPromotionRecord = 0x0B,
    AuditorStatement = 0x0C,
    ManualReview = 0x0D,
    Unknown = 0xFF,
}

// ============================================================================
// Court Session
// ============================================================================

type CourtSession = struct {
    session_id: Hash256,
    object_under_judgment: Hash256,
    object_description: FixedString[256],
    oracle: OracleConnection,
    status: CourtSessionStatus,
    evidence_log: Array[CourtEvidence, 128],
    evidence_count: u64,
    replay_result: CourtReplayResult,
    comparison_results: Array[CourtComparison, 256],
    comparison_count: u64,
    divergence_analysis: Array[DivergenceEntry, 128],
    divergence_count: u64,
    verdict: Option[CourtVerdict],
    residuals: Array[CourtResidual, 512],
    residual_count: u64,
    opened_at: u64,
    closed_at: u64,
    generation: u64,
}

// ============================================================================
// Oracle Connection
// ============================================================================

type OracleConnection = struct {
    oracle_id: Hash256,
    oracle_type: FixedString[64],
    oracle_version: FixedString[32],
    oracle_key: FixedString[256],
    is_connected: bool,
    connection_time: u64,
}

// ============================================================================
// Court Replay Result
// ============================================================================

type CourtReplayResult = struct {
    replayed: bool,
    replay_hash: Hash256,
    hash_chain: Array[Hash256, 64],
    chain_length: u64,
    chain_matches_original: bool,
    status: FixedString[32],
    full_replay: bool,
}

// ============================================================================
// Court Comparison
// ============================================================================

type CourtComparison = struct {
    comparison_id: u64,
    oracle_id: Hash256,
    native_output_hash: Hash256,
    oracle_output_hash: Hash256,
    comparison_type: ComparisonType,
    divergence: DivergenceClass,
    test_case_id: u64,
    timestamp: u64,
}

type ComparisonType = enum {
    ByteIdentical = 0x01,
    StructurallyEquivalent = 0x02,
    BehaviorallyEquivalent = 0x03,
    Divergent = 0x04,
    NotCompared = 0xFF,
}

type DivergenceClass = enum {
    None = 0x00,
    Semantic = 0x01,
    Optimization = 0x02,
    Dialect = 0x03,
    Nondeterministic = 0x04,
    Acceptable = 0x05,
    Unclassified = 0xFF,
}

// ============================================================================
// Divergence Entry
// ============================================================================

type DivergenceEntry = struct {
    divergence_id: u64,
    comparison_id: u64,
    divergence_class: DivergenceClass,
    severity: DivergenceSeverity,
    description: FixedString[1024],
    expected_hash: Hash256,
    actual_hash: Hash256,
    resolved: bool,
    resolution: FixedString[512],
}

type DivergenceSeverity = enum {
    Acceptable = 0x01,
    Minor = 0x02,
    Significant = 0x03,
    Critical = 0x04,
}

// ============================================================================
// Court Verdict
// ============================================================================

type CourtVerdict = struct {
    verdict_type: VerdictType,
    target_trust_state: TrustState,
    current_trust_state: TrustState,
    reason: FixedString[2048],
    evidence_references: Array[Hash256, 32],
    evidence_ref_count: u64,
    additional_evidence_requested: FixedString[1024],
    issued_at: u64,
    issued_by: FixedString[128],
}

type VerdictType = enum {
    Accept = 0x01,
    Refine = 0x02,
    Reject = 0x03,
    MoreEvidence = 0x04,
    NotIssued = 0xFF,
}

type TrustState = enum {
    Unknown = 0,
    Observed = 1,
    Replayed = 2,
    OracleCompared = 3,
    ResidualStable = 4,
    Sealed = 5,
    Promoted = 6,
}

// ============================================================================
// Court Residual
// ============================================================================

type CourtResidual = struct {
    residual_id: Hash256,
    session_id: Hash256,
    operation: FixedString[32],
    input_hash: Hash256,
    output_hash: Hash256,
    verdict: Option[VerdictType],
    timestamp: u64,
    generation: u64,
}

// ============================================================================
// Create Open Session
// ============================================================================

fn open_court_session(object_key: Hash256, object_desc: &FixedString[256], oracle_id: Hash256, oracle_type: &FixedString[64], oracle_version: &FixedString[32]) -> CourtSession
    effects: [compute, residual]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let empty_evidence: Array[CourtEvidence, 128] = Array[CourtEvidence, 128]::zeroed();
    let empty_comparisons: Array[CourtComparison, 256] = Array[CourtComparison, 256]::zeroed();
    let empty_divergences: Array[DivergenceEntry, 128] = Array[DivergenceEntry, 128]::zeroed();
    let empty_residuals: Array[CourtResidual, 512] = Array[CourtResidual, 512]::zeroed();
    let empty_hash_chain: Array[Hash256, 64] = Array[Hash256, 64]::zeroed();

    let session_id: Hash256 = hash_court_combine(object_key, oracle_id);

    let session: CourtSession = CourtSession {
        session_id: session_id,
        object_under_judgment: object_key,
        object_description: *object_desc,
        oracle: OracleConnection {
            oracle_id: oracle_id,
            oracle_type: *oracle_type,
            oracle_version: *oracle_version,
            oracle_key: FixedString[256]::zeroed(),
            is_connected: true,
            connection_time: kernel.tick_count(),
        },
        status: CourtSessionStatus::Open,
        evidence_log: empty_evidence,
        evidence_count: 0,
        replay_result: CourtReplayResult {
            replayed: false,
            replay_hash: zero_hash,
            hash_chain: empty_hash_chain,
            chain_length: 0,
            chain_matches_original: false,
            status: FixedString[32]::from_literal("pending"),
            full_replay: false,
        },
        comparison_results: empty_comparisons,
        comparison_count: 0,
        divergence_analysis: empty_divergences,
        divergence_count: 0,
        verdict: Option::None,
        residuals: empty_residuals,
        residual_count: 0,
        opened_at: kernel.tick_count(),
        closed_at: 0,
        generation: 1,
    };

    // Record session opening residual
    let open_residual: CourtResidual = CourtResidual {
        residual_id: hash_court_combine(session_id, 0),
        session_id: session_id,
        operation: FixedString[32]::from_literal("open"),
        input_hash: object_key,
        output_hash: session_id,
        verdict: Option::None,
        timestamp: kernel.tick_count(),
        generation: 1,
    };

    // Note: residual would be emitted via @emit_residual in real impl
    // Using a comment placeholder to indicate residual emission

    return session;
}

// ============================================================================
// Submit Evidence
// ============================================================================

fn submit_evidence(session: &mut CourtSession, evidence_type: CourtEvidenceType, data_hash: Hash256, desc: &FixedString[512]) -> Result<u64, CourtSessionError>
    effects: [compute, residual]
{
    if session.status == CourtSessionStatus::Closed {
        return Err(CourtSessionError::SessionAlreadyClosed);
    }

    if session.evidence_count >= 128 {
        return Err(CourtSessionError::EvidenceInsufficient);
    }

    let evidence: CourtEvidence = CourtEvidence {
        evidence_id: session.evidence_count,
        evidence_type: evidence_type,
        data_hash: data_hash,
        description: *desc,
        submitted_at: kernel.tick_count(),
        verified: true,
    };

    session.evidence_log[session.evidence_count] = evidence;
    session.evidence_count = session.evidence_count + 1;

    // Update status if we're in Open state
    if session.status == CourtSessionStatus::Open {
        session.status = CourtSessionStatus::EvidenceSubmitted;
    }

    // Record submit evidence residual
    record_court_residual(session, FixedString[32]::from_literal("submit_evidence"), data_hash, data_hash, Option::None);

    @emit_residual("court_session.submit_evidence", "evidence_submitted", session.evidence_count);

    return Ok(session.evidence_count);
}

// ============================================================================
// Run Replay
// ============================================================================
// Re-executes the object's compilation or execution to verify determinism.

fn run_court_replay(session: &mut CourtSession) -> Result[CourtReplayResult, CourtSessionError]
    effects: [compute, io, residual]
{
    if session.evidence_count == 0 {
        return Err(CourtSessionError::EvidenceNotSubmitted);
    }

    if session.status == CourtSessionStatus::Closed {
        return Err(CourtSessionError::SessionAlreadyClosed);
    }

    // Simulate replay — in real implementation, re-executes the compilation
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut chain: Array[Hash256, 64] = Array[Hash256, 64]::zeroed();

    // Build hash chain from evidence
    for i in 0..session.evidence_count {
        if i < 64 {
            chain[i] = session.evidence_log[i].data_hash;
        }
    }

    let replay_hash: Hash256 = hash_court_combine(session.object_under_judgment, session.evidence_count);

    session.replay_result = CourtReplayResult {
        replayed: true,
        replay_hash: replay_hash,
        hash_chain: chain,
        chain_length: if session.evidence_count < 64 { session.evidence_count } else { 64 },
        chain_matches_original: true,
        status: FixedString[32]::from_literal("full"),
        full_replay: true,
    };

    session.status = CourtSessionStatus::ReplayCompleted;

    record_court_residual(session, FixedString[32]::from_literal("run_replay"), session.object_under_judgment, replay_hash, Option::None);

    @emit_residual("court_session.run_replay", "replay_completed", replay_hash);

    return Ok(session.replay_result);
}

// ============================================================================
// Compare With Oracle
// ============================================================================
// Runs the oracle on the same inputs and compares the results.

fn compare_with_oracle(session: &mut CourtSession, native_hash: Hash256, oracle_hash: Hash256, test_case_count: u64) -> Result<u64, CourtSessionError>
    effects: [compute, io, residual]
{
    if !session.replay_result.replayed {
        return Err(CourtSessionError::ReplayNotRun);
    }

    if session.status == CourtSessionStatus::Closed {
        return Err(CourtSessionError::SessionAlreadyClosed);
    }

    let match_count: u64 = 0;
    let mut comp_count: u64 = 0;

    for i in 0..test_case_count {
        if comp_count >= 256 {
            break;
        }

        // Simulated comparison — in real impl, execute both and compare
        let is_byte_identical: bool = native_hash == oracle_hash;
        let comp_type: ComparisonType;
        let div_class: DivergenceClass;

        if is_byte_identical {
            comp_type = ComparisonType::ByteIdentical;
            div_class = DivergenceClass::None;
        } else {
            // Simulate structural equivalence check
            comp_type = ComparisonType::StructurallyEquivalent;
            div_class = DivergenceClass::Acceptable;
        }

        session.comparison_results[comp_count] = CourtComparison {
            comparison_id: comp_count,
            oracle_id: session.oracle.oracle_id,
            native_output_hash: native_hash,
            oracle_output_hash: oracle_hash,
            comparison_type: comp_type,
            divergence: div_class,
            test_case_id: i,
            timestamp: kernel.tick_count(),
        };
        comp_count = comp_count + 1;
    }

    session.comparison_count = comp_count;
    session.status = CourtSessionStatus::OracleCompared;

    record_court_residual(session, FixedString[32]::from_literal("compare"), native_hash, oracle_hash, Option::None);

    @emit_residual("court_session.compare", "oracle_comparison_complete", comp_count);

    return Ok(comp_count);
}

// ============================================================================
// Analyze Divergence
// ============================================================================

fn analyze_divergence(session: &mut CourtSession) -> Result<u64, CourtSessionError>
    effects: [compute, residual]
{
    if session.comparison_count == 0 {
        return Err(CourtSessionError::ComparisonNotPerformed);
    }

    if session.status == CourtSessionStatus::Closed {
        return Err(CourtSessionError::SessionAlreadyClosed);
    }

    let mut div_count: u64 = 0;

    for i in 0..session.comparison_count {
        if session.comparison_results[i].divergence != DivergenceClass::None {
            if div_count < 128 {
                let comp: CourtComparison = session.comparison_results[i];
                let severity: DivergenceSeverity;

                match comp.divergence {
                    DivergenceClass::Acceptable => severity = DivergenceSeverity::Acceptable,
                    DivergenceClass::Semantic => severity = DivergenceSeverity::Critical,
                    DivergenceClass::Optimization => severity = DivergenceSeverity::Minor,
                    DivergenceClass::Dialect => severity = DivergenceSeverity::Significant,
                    DivergenceClass::Nondeterministic => severity = DivergenceSeverity::Significant,
                    DivergenceClass::None => severity = DivergenceSeverity::Acceptable,
                    DivergenceClass::Unclassified => severity = DivergenceSeverity::Significant,
                }

                session.divergence_analysis[div_count] = DivergenceEntry {
                    divergence_id: div_count,
                    comparison_id: comp.comparison_id,
                    divergence_class: comp.divergence,
                    severity: severity,
                    description: FixedString[1024]::from_literal("Divergence detected during oracle comparison"),
                    expected_hash: comp.oracle_output_hash,
                    actual_hash: comp.native_output_hash,
                    resolved: false,
                    resolution: FixedString[512]::zeroed(),
                };
                div_count = div_count + 1;
            }
        }
    }

    session.divergence_count = div_count;
    session.status = CourtSessionStatus::DivergenceAnalyzed;

    record_court_residual(session, FixedString[32]::from_literal("analyze_divergence"), hash_from_u64(div_count), hash_from_u64(div_count), Option::None);

    @emit_residual("court_session.analyze_divergence", "divergence_analyzed", div_count);

    return Ok(div_count);
}

// ============================================================================
// Issue Verdict
// ============================================================================

fn issue_verdict(session: &mut CourtSession, verdict_type: VerdictType, reason: &FixedString[2048], additional_evidence: &FixedString[1024], judge: &FixedString[128]) -> Result[CourtVerdict, CourtSessionError]
    effects: [compute, residual]
{
    if session.status == CourtSessionStatus::Closed || session.status == CourtSessionStatus::VerdictIssued {
        return Err(CourtSessionError::VerdictAlreadyIssued);
    }

    if session.status < CourtSessionStatus::DivergenceAnalyzed && verdict_type != VerdictType::MoreEvidence {
        return Err(CourtSessionError::VerdictNotReady);
    }

    // Determine target trust state based on verdict
    let current: TrustState = TrustState::Unknown;
    let target: TrustState = determine_target_state(verdict_type, session.comparison_count, session.divergence_count);

    let mut evidence_refs: Array[Hash256, 32] = Array[Hash256, 32]::zeroed();
    let ref_count: u64 = if session.evidence_count < 32 { session.evidence_count } else { 32 };
    for i in 0..ref_count {
        evidence_refs[i] = session.evidence_log[i].data_hash;
    }

    let verdict: CourtVerdict = CourtVerdict {
        verdict_type: verdict_type,
        target_trust_state: target,
        current_trust_state: current,
        reason: *reason,
        evidence_references: evidence_refs,
        evidence_ref_count: ref_count,
        additional_evidence_requested: *additional_evidence,
        issued_at: kernel.tick_count(),
        issued_by: *judge,
    };

    session.verdict = Option::Some(verdict);
    session.status = CourtSessionStatus::VerdictIssued;

    record_court_residual(session, FixedString[32]::from_literal("verdict"), hash_from_u64(verdict_type as u64), hash_from_u64(target as u64), Option::Some(verdict_type));

    @emit_residual("court_session.verdict", "verdict_issued", verdict_type as u64);

    return Ok(verdict);
}

// ============================================================================
// Determine Target Trust State
// ============================================================================

fn determine_target_state(verdict_type: VerdictType, comparison_count: u64, divergence_count: u64) -> TrustState
    effects: [compute]
{
    match verdict_type {
        VerdictType::Accept => {
            if comparison_count > 0 && divergence_count == 0 {
                return TrustState::OracleCompared;
            } elif divergence_count > 0 {
                return TrustState::Replayed;
            } else {
                return TrustState::Observed;
            }
        }
        VerdictType::Refine => {
            return TrustState::Observed;
        }
        VerdictType::Reject => {
            return TrustState::Unknown;
        }
        VerdictType::MoreEvidence => {
            return TrustState::Unknown;
        }
        VerdictType::NotIssued => {
            return TrustState::Unknown;
        }
    }
}

// ============================================================================
// Promote Trust State
// ============================================================================
// Applies trust promotion based on the court verdict.

fn promote_trust_state(session: &mut CourtSession, store_cap: Hash256) -> Result[TrustState, CourtSessionError]
    effects: [compute, io, residual]
{
    if session.status < CourtSessionStatus::VerdictIssued {
        return Err(CourtSessionError::VerdictNotReady);
    }

    match session.verdict {
        Option::Some(verdict) => {
            if verdict.verdict_type == VerdictType::Accept {
                session.status = CourtSessionStatus::PromotionApplied;

                record_court_residual(session, FixedString[32]::from_literal("promote"), hash_from_u64(verdict.target_trust_state as u64), store_cap, Option::Some(verdict.verdict_type));

                @emit_residual("court_session.promote", "trust_promoted", verdict.target_trust_state as u64);

                return Ok(verdict.target_trust_state);
            } else {
                return Err(CourtSessionError::TrustPromotionBlocked);
            }
        }
        Option::None => {
            return Err(CourtSessionError::VerdictNotReady);
        }
    }
}

// ============================================================================
// Close Session
// ============================================================================
// Finalizes the court session and seals all evidence.

fn close_court_session(session: &mut CourtSession) -> Result[Hash256, CourtSessionError]
    effects: [compute, residual]
{
    if session.status == CourtSessionStatus::Closed {
        return Err(CourtSessionError::SessionAlreadyClosed);
    }

    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut seal_hash: Hash256 = zero_hash;

    // Hash all evidence
    for i in 0..session.evidence_count {
        seal_hash = hash_court_combine(seal_hash, session.evidence_log[i].data_hash);
    }

    // Hash all comparisons
    for i in 0..session.comparison_count {
        seal_hash = hash_court_combine(seal_hash, session.comparison_results[i].native_output_hash);
        seal_hash = hash_court_combine(seal_hash, session.comparison_results[i].oracle_output_hash);
    }

    // Hash verdict if present
    match session.verdict {
        Option::Some(verdict) => {
            seal_hash = hash_court_combine(seal_hash, hash_from_u64(verdict.verdict_type as u64));
        }
        Option::None => {}
    }

    session.closed_at = kernel.tick_count();
    session.status = CourtSessionStatus::Closed;

    record_court_residual(session, FixedString[32]::from_literal("close"), session.object_under_judgment, seal_hash, Option::None);

    @emit_residual("court_session.close", "session_closed", seal_hash);

    return Ok(seal_hash);
}

// ============================================================================
// Record Court Residual
// ============================================================================

fn record_court_residual(session: &mut CourtSession, operation: FixedString[32], input_hash: Hash256, output_hash: Hash256, verdict: Option[VerdictType])
    effects: [compute]
{
    if session.residual_count >= 512 {
        return;  // Buffer full, silently drop
    }

    let residual: CourtResidual = CourtResidual {
        residual_id: hash_court_combine(session.session_id, session.residual_count),
        session_id: session.session_id,
        operation: operation,
        input_hash: input_hash,
        output_hash: output_hash,
        verdict: verdict,
        timestamp: kernel.tick_count(),
        generation: session.generation,
    };

    session.residuals[session.residual_count] = residual;
    session.residual_count = session.residual_count + 1;
}

// ============================================================================
// Get Session Status
// ============================================================================

fn get_session_status(session: &CourtSession) -> CourtSessionStatus
    effects: [compute]
{
    return session.status;
}

// ============================================================================
// Get Verdict Summary
// ============================================================================

type VerdictSummary = struct {
    session_id: Hash256,
    object_key: Hash256,
    object_desc: FixedString[256],
    status: CourtSessionStatus,
    evidence_count: u64,
    comparison_count: u64,
    divergence_count: u64,
    has_verdict: bool,
    verdict_type: VerdictType,
    target_state: TrustState,
    reason: FixedString[2048],
    duration_us: u64,
}

fn get_verdict_summary(session: &CourtSession) -> VerdictSummary
    effects: [compute]
{
    let has_verdict: bool;
    let vtype: VerdictType;
    let target: TrustState;
    let reason: FixedString[2048];

    match session.verdict {
        Option::Some(verdict) => {
            has_verdict = true;
            vtype = verdict.verdict_type;
            target = verdict.target_trust_state;
            reason = verdict.reason;
        }
        Option::None => {
            has_verdict = false;
            vtype = VerdictType::NotIssued;
            target = TrustState::Unknown;
            reason = FixedString[2048]::zeroed();
        }
    }

    let duration: u64 = if session.status == CourtSessionStatus::Closed {
        session.closed_at - session.opened_at
    } else {
        kernel.tick_count() - session.opened_at
    };

    return VerdictSummary {
        session_id: session.session_id,
        object_key: session.object_under_judgment,
        object_desc: session.object_description,
        status: session.status,
        evidence_count: session.evidence_count,
        comparison_count: session.comparison_count,
        divergence_count: session.divergence_count,
        has_verdict: has_verdict,
        verdict_type: vtype,
        target_state: target,
        reason: reason,
        duration_us: duration,
    };
}

// ============================================================================
// Multi-Oracle Session
// ============================================================================
// Runs multiple oracle sessions and aggregates the results.

type MultiOracleResult = struct {
    session_ids: Array[Hash256, 16],
    session_count: u64,
    all_accepted: bool,
    consensus_verdict: VerdictType,
    consensus_target: TrustState,
}

fn run_multi_oracle_session(object_key: Hash256, oracles: &Array[(Hash256, FixedString[64], FixedString[32]), 16], oracle_count: u64, judge: &FixedString[128]) -> Result[MultiOracleResult, CourtSessionError>
    effects: [compute, io, residual]
{
    let mut result: MultiOracleResult = MultiOracleResult {
        session_ids: Array[Hash256, 16]::zeroed(),
        session_count: 0,
        all_accepted: true,
        consensus_verdict: VerdictType::Accept,
        consensus_target: TrustState::Promoted,
    };

    for i in 0..oracle_count {
        let (oid, otype, over): (Hash256, FixedString[64], FixedString[32]) = oracles[i];

        let mut session: CourtSession = open_court_session(object_key, &FixedString[256]::from_literal("multi-oracle-object"), oid, &otype, &over);

        // Submit default evidence
        submit_evidence(&mut session, CourtEvidenceType::ProvenanceRecord, object_key, &FixedString[512]::from_literal("Multi-oracle session evidence"))?;

        // Run replay
        let replay: CourtReplayResult = run_court_replay(&mut session)?;

        // Compare with oracle
        let comp_count: u64 = compare_with_oracle(&mut session, object_key, oid, 100)?;

        // Analyze divergence
        let div_count: u64 = analyze_divergence(&mut session)?;

        // Issue verdict
        let no_divergences: bool = div_count == 0;
        let vtype: VerdictType = if no_divergences { VerdictType::Accept } else { VerdictType::Refine };
        let verdict: CourtVerdict = issue_verdict(&mut session, vtype, &FixedString[2048]::from_literal("Multi-oracle verdict"), &FixedString[1024]::zeroed(), judge)?;

        // Close
        let _ = close_court_session(&mut session)?;

        result.session_ids[result.session_count] = session.session_id;
        result.session_count = result.session_count + 1;

        if vtype != VerdictType::Accept {
            result.all_accepted = false;
        }
    }

    if result.all_accepted {
        result.consensus_verdict = VerdictType::Accept;
        result.consensus_target = TrustState::Promoted;
    } else {
        result.consensus_verdict = VerdictType::Refine;
        result.consensus_target = TrustState::OracleCompared;
    }

    @emit_residual("court_session.multi_oracle", "multi_oracle_session_complete", result.session_count);

    return Ok(result);
}

// ============================================================================
// Hash Helpers
// ============================================================================

fn hash_court_combine(a: Hash256, b: Hash256) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    for i in 0..32 {
        result.bytes[i] = a.bytes[i] ^ b.bytes[i];
    }
    return result;
}

fn hash_court_combine(a: Hash256, b: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut tmp: u64 = b;
    for i in 0..8 {
        result.bytes[i] = a.bytes[i] ^ ((tmp >> (i * 8)) & 0xFF) as u8;
    }
    for i in 8..32 {
        result.bytes[i] = a.bytes[i];
    }
    return result;
}

fn hash_from_u64(val: u64) -> Hash256
    effects: [compute]
{
    let mut result: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut tmp: u64 = val;
    for i in 0..8 {
        result.bytes[i] = (tmp & 0xFF) as u8;
        tmp = tmp >> 8;
    }
    return result;
}
