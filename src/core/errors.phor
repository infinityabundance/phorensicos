}

pub fn compile_effect_mismatch(expected: FixedString[128], actual: FixedString[128]) -> CompilerError
    effects: [deterministic]
{
    let full_msg: FixedString[128] = FixedString[128]::new()
    full_msg.append(FixedString[128]::from_slice("Effect mismatch: expected "))
    full_msg.append(expected)
    full_msg.append(FixedString[128]::from_slice(", got "))
    full_msg.append(actual)
    CompilerError::new(Word64::from_u64(DIAG_COMPILER_BASE | 0x007), full_msg)
}

