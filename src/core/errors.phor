// ──────────────────────────────────────────────
// Generic System Error union (for convenience)
// ──────────────────────────────────────────────
// A tagged union that can hold any system error.
// Evidence path: ERR-UNION-001 through ERR-UNION-010

pub type SystemError : enum {
    Kernel(KernelError),
    Compiler(CompilerError),
    Store(StoreError),
    Cage(CageError),
    Court(CourtError),
    Driver(DriverError),
    Package(PackageError),
    Overflow(OverflowError),
    DivisionByZero(DivisionByZeroError),
    Arithmetic(ArithmeticError),
    Bounds(BoundsError),
    Parse(ParseError),
    Serialization(SerializationError),
    Capability(CapabilityError),
    Trust(TrustError),
    Effect(EffectError),
    Handle(HandleError),
}

impl SystemError {
    pub fn code(self) -> Word64
        effects: [deterministic]
    {
        match self {
            SystemError::Kernel(e) => e.code(),
            SystemError::Compiler(e) => e.code(),
            SystemError::Store(e) => e.code(),
            SystemError::Cage(e) => e.code(),
            SystemError::Court(e) => e.code(),
            SystemError::Driver(e) => e.code(),
            SystemError::Package(e) => e.code(),
            SystemError::Overflow(e) => e.code(),
            SystemError::DivisionByZero(e) => e.code(),
            SystemError::Arithmetic(e) => e.code(),
            SystemError::Bounds(e) => e.code(),
            SystemError::Parse(e) => e.code(),
            SystemError::Serialization(e) => e.code(),
            SystemError::Capability(e) => e.code(),
            SystemError::Trust(e) => e.code(),
            SystemError::Effect(e) => e.code(),
            SystemError::Handle(e) => e.code(),
        }
    }

    pub fn message(self) -> FixedString[128]
        effects: [deterministic]
    {
        match self {
            SystemError::Kernel(e) => e.message(),
            SystemError::Compiler(e) => e.message(),
            SystemError::Store(e) => e.message(),
            SystemError::Cage(e) => e.message(),
            SystemError::Court(e) => e.message(),
            SystemError::Driver(e) => e.message(),
            SystemError::Package(e) => e.message(),
            SystemError::Overflow(e) => e.message(),
            SystemError::DivisionByZero(e) => e.message(),
            SystemError::Arithmetic(e) => e.message(),
            SystemError::Bounds(e) => e.message(),
            SystemError::Parse(e) => e.message(),
            SystemError::Serialization(e) => e.message(),
            SystemError::Capability(e) => e.message(),
            SystemError::Trust(e) => e.message(),
            SystemError::Effect(e) => e.message(),
            SystemError::Handle(e) => e.message(),
        }
    }

    pub fn is_kernel(self) -> bool { match self { SystemError::Kernel(_) => true, _ => false } }
    pub fn is_store(self) -> bool { match self { SystemError::Store(_) => true, _ => false } }
    pub fn is_cage(self) -> bool { match self { SystemError::Cage(_) => true, _ => false } }
    pub fn is_court(self) -> bool { match self { SystemError::Court(_) => true, _ => false } }
    pub fn is_driver(self) -> bool { match self { SystemError::Driver(_) => true, _ => false } }
    pub fn is_package(self) -> bool { match self { SystemError::Package(_) => true, _ => false } }
    pub fn is_bounds(self) -> bool { match self { SystemError::Bounds(_) => true, _ => false } }
    pub fn is_serialization(self) -> bool { match self { SystemError::Serialization(_) => true, _ => false } }
}
