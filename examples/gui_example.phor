// gui_example.phor — Example GUI application
//
// Demonstrates:
//   - Capability-gated surface creation
//   - Window creation and configuration
//   - Widget placement (button, label, text input)
//   - Input event handling
//   - Compositor presentation with damage tracking
//   - Window stacking and focus management
//   - Surface state machine
//   - Widget hit testing
//
// Expected outcomes:
//   - GUI application creates a window with button and label
//   - Input events are routed to the focused widget
//   - Compositor presents frames with damage tracking
//   - All operations are capability-gated
//   - Surface follows state machine: initial→configured→mapped→unmapped→destroyed
//   - Window manager handles z-ordering correctly
//
// Compilation: accepted
// Trust state: Observed

package "phorensic:gui_example:v1.0";

struct WindowConfig {
    title: Str(64),
    width: u32,
    height: u32,
    x: i32,
    y: i32,
    visible: bool,
}

struct AppState {
    window_id: u64,
    button_clicked: bool,
    label_text: Str(64),
    counter: u64,
}

fn handle_click(mut state: AppState) -> AppState
    effect [io:write, residual]
{
    state.button_clicked = true;
    state.counter = state.counter + 1;
    state.label_text = Str::from("Clicked: ");
    // Append counter (in a real app, convert to string)

    residual emit {
        op: "gui.button_click",
        window: state.window_id,
        count: state.counter,
    };

    return state;
}

fn main(compositor: Cap(Compositor)) -> void
    effect [io:write, memory:mmio, residual]
{
    // Create window configuration
    let config: WindowConfig = WindowConfig{
        title: Str::from("Phorensic App"),
        width: 640,
        height: 480,
        x: 100,
        y: 100,
        visible: true,
    };

    // Create window (requires Cap(Compositor))
    let surface_id: u64 = compositor.create_surface(config.width, config.height);
    assert(surface_id > 0, "gui: surface created");
    assert(surface_id > 0, "gui: non-zero surface ID");

    // Window manager: configure position
    compositor.configure_window(surface_id, config.x, config.y);
    compositor.set_window_title(surface_id, config.title);

    // Create widgets
    // Button at (10, 10), 120x32
    let button_id: u64 = compositor.create_button(surface_id, 10, 10, 120, 32, Str::from("Click Me"));

    // Label at (10, 50), displaying welcome text
    let label_id: u64 = compositor.create_label(surface_id, 10, 50, Str::from("Welcome to Phorensic GUI"), 14);

    // Text input at (10, 80), 200x24
    let input_id: u64 = compositor.create_text_input(surface_id, 10, 80, 200, 24);

    // Set focus to the button
    compositor.set_focus(surface_id, button_id);

    // Show the window
    compositor.show_window(surface_id);

    // Present the first frame
    compositor.mark_damage(surface_id, 0, 0, config.width, config.height);
    compositor.present();

    // Simulate a button click event
    let app_state: AppState = AppState{
        window_id: surface_id,
        button_clicked: false,
        label_text: Str::from("initial"),
        counter: 0,
    };

    let updated_state: AppState = handle_click(app_state);
    assert(updated_state.button_clicked, "gui: button was clicked");
    assert(updated_state.counter == 1, "gui: counter incremented");

    // Present updated frame with damage rects only
    compositor.mark_damage(surface_id, 10, 10, 120, 32);
    compositor.present();

    // Simulate keyboard input
    let key_event: InputEvent = InputEvent{
        event_type: 0,
        code: 0x10, // 'A'
        value: 1,   // pressed
        timestamp: 2000,
    };

    // Route input to focused widget
    compositor.send_key_event(surface_id, key_event);

    // Window management: raise to top
    compositor.raise_window(surface_id);

    // Window management: resize
    compositor.resize_window(surface_id, 800, 600);
    assert(compositor.get_window_width(surface_id) == 800, "gui: window resized");

    // Check all widgets
    let widget_count: u64 = compositor.get_widget_count(surface_id);
    assert(widget_count == 3, "gui: 3 widgets on surface");

    // Minimize and restore window
    compositor.minimize_window(surface_id);
    assert(!compositor.is_window_visible(surface_id), "gui: window minimized");
    compositor.restore_window(surface_id);
    assert(compositor.is_window_visible(surface_id), "gui: window restored");

    // Close window
    compositor.close_window(surface_id);
    assert(!compositor.is_window_open(surface_id), "gui: window closed");

    residual emit {
        op: "gui_example.frame",
        surface: surface_id,
        width: config.width,
        height: config.height,
        visible: if config.visible { 1 } else { 0 },
        widgets: 3,
        clicks: updated_state.counter,
        resize_width: 800,
        resize_height: 600,
        window_lifecycle: "create_minimize_restore_close",
        final_widget_count: widget_count,
        events_processed: 2,
    };
}
