// ──────────────────────────────────────────────
// UEFI Graphics Output Protocol (GOP)
// ──────────────────────────────────────────────

pub type GOP_MODE_INFO : struct {
    version: Word32,
    horizontal_resolution: Word32,
    vertical_resolution: Word32,
    pixel_format: Word32,
    pixel_information: FixedArray[4, u32],
    pixels_per_scan_line: Word32,
}

impl GOP_MODE_INFO {
    pub fn new() -> GOP_MODE_INFO
        effects: [deterministic]
    {
        GOP_MODE_INFO {
            version: 0,
            horizontal_resolution: 0,
            vertical_resolution: 0,
            pixel_format: 0,
            pixel_information: FixedArray::new(),
            pixels_per_scan_line: 0,
        }
    }

    pub fn width(self) -> Word32
        effects: [deterministic]
    {
        self.horizontal_resolution
    }

    pub fn height(self) -> Word32
        effects: [deterministic]
    {
        self.vertical_resolution
    }

    pub fn pixels_per_line(self) -> Word32
        effects: [deterministic]
    {
        self.pixels_per_scan_line
    }

    pub fn is_rgb(self) -> bool
        effects: [deterministic]
    {
        self.pixel_format == 0  // PixelRedGreenBlueReserved8BitPerColor
    }

    pub fn is_bgr(self) -> bool
        effects: [deterministic]
    {
        self.pixel_format == 1  // PixelBlueGreenRedReserved8BitPerColor
    }
}

