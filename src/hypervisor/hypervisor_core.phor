#[test]
pub fn test_guest_state_init[] : effect:(pure) {
  let gs: GuestState = GuestState(
    cr0: 0x80050033, cr2: 0, cr3: 0, cr4: 0x202668, cr8: 0,
    dr0: 0, dr1: 0, dr2: 0, dr3: 0, dr6: 0, dr7: 0,
    gp_regs: Default, cs: SegmentReg(selector: 0, base: 0, limit: 0, flags: SegmentFlags(0)),
    ds: Default, es: Default, fs: Default, gs: Default, ss: Default,
    ldtr: SegmentReg(selector: 0, base: 0, limit: 0, flags: SegmentFlags(0)),
    tr: SegmentReg(selector: 0, base: 0, limit: 0, flags: SegmentFlags(0)),
    gdtr: TableReg(base: 0, limit: 0), idtr: TableReg(base: 0, limit: 0),
    sysenter_cs: 0, sysenter_esp: 0, sysenter_eip: 0, efer: 0, pat: 0,
    star: 0, lstar: 0, cstar: 0, sfmask: 0, kernel_gs_base: 0, tsc_offset: 0,
    rflags: 0x02, rip: 0x100000, interruptibility: 0, activity_state: 0,
    pending_debug_exceptions: 0, vmcs_link: 0, virtual_cpuid: 0, cap_state: CapabilityState(0),
  );
  assert(gs.cr0 == 0x80050033);
  assert(gs.rip == 0x100000);
}
