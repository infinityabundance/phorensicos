// trusted_block.phor — Example showing trusted block with and without rationale
//
// Demonstrates:
//   - Trusted block with documented rationale (accepted)
//   - Trusted block with court citation and receipt (accepted)
//   - Trusted block without rationale (REJECTED with E0601)
//   - Machine block inside trusted block
//   - Effects allowed in trusted block even if not in function signature
//   - Trusted block with multiple operations
//   - Nested trusted blocks with different rationales
//   - Trusted block for interrupt handler setup
//   - Trusted block for DMA descriptor programming
//   - Trusted block for TLB/cache control operations
//   - Machine block declaration with arch, instructions, court citations
//
// Expected outcomes:
//   - Trusted block with rationale compiles successfully ✓
//   - Trusted block without rationale produces E0601 ✗
//   - Machine blocks are only valid in trusted context ✓
//   - Rationale must name a verifiable source (CPU manual, court casefile) ✓
//   - Trusted block body may use effects not declared in function signature ✓
//   - Each trusted block is auditable via its rationale string ✓
//
// Compilation: accepted (with noted error lines)
// Trust state: Observed (requires court promotion for Sealed)

package "phorensic:trusted_block:v1.0";

// Trusted block with rationale — accepted
fn read_cpu_model() -> u64
    effect [machine:ioport]
{
    trusted reason "IA-32 CPUID instruction documented in Intel SDM Vol 2A §3.2, casefile CPUID_001"
    {
        // In a real system, this would execute CPUID with EAX=0
        // mov rax, 0
        // cpuid
        // return (rax, rbx, rcx, rdx)
        return 42; // Placeholder for actual CPUID result
    }
}

// Trusted block with court and receipt — accepted
fn read_msr_safe(msr: u32) -> u64
    effect [machine:ioport]
{
    trusted
        reason "RDMSR for MSR 0x1A (IA32_CLOCK_MODULATION) documented at Intel SDM Vol 4 §2.1"
        court "cpu_reference_court"
        receipt "MSR_CLOCK_MODULATION_V1"
    {
        // RDMSR instruction (in real system):
        // mov ecx, msr
        // rdmsr
        // return (edx << 32) | eax
        return 0;
    }
}

// Trusted block with hardware register write — accepted
fn write_uart_byte(port: u16, byte: u8) -> void
    effect [machine:ioport]
{
    trusted reason "UART 16550 TX register write documented in National Semiconductor PC16550D datasheet §3.2"
    {
        // OUT DX, AL  (write byte to UART port)
    }
}

// Trusted block with MMIO access — accepted
fn read_mmio_register(base: u64, offset: u32) -> u64
    effect [memory:mmio]
{
    trusted reason "MMIO register access documented in PCIe Base Spec Rev 5.0 §7.3, verified by hardware oracle session HW_MMIO_003"
    {
        // Memory-mapped I/O read at base + offset
        // mov rax, [rdi + rsi]
        return 0;
    }
}

// Trusted block for interrupt handler registration — accepted
fn install_interrupt_handler(vector: u8, handler_addr: u64) -> void
    effect [machine:ioport, memory:mmio]
{
    trusted reason "IDT entry setup documented in Intel SDM Vol 3A §6.10-6.11, casefile IDT_SETUP_002"
    {
        // Write IDT entry: base address, segment selector, gate type, DPL
        // lidt [idtr]
    }
}

// Trusted block for DMA descriptor setup — accepted
fn setup_dma_descriptor(src: u64, dst: u64, size: u32) -> void
    effect [memory:mmio, dma]
{
    trusted reason "DMA descriptor format documented in Intel IOAT Spec §3.2.1, verified by hardware oracle session DMA_ORACLE_001"
    {
        // Write DMA descriptor: src_addr, dst_addr, size, control flags
        // dma_register_write(DMA_CHAN0_BASE + 0x00, src)
        // dma_register_write(DMA_CHAN0_BASE + 0x08, dst)
        // dma_register_write(DMA_CHAN0_BASE + 0x10, size | DMA_CTL_START)
    }
}

// Trusted block for TLB flush — accepted
fn flush_tlb() -> void
    effect [machine:ioport]
{
    trusted reason "TLB flush via CR3 reload documented in Intel SDM Vol 3A §4.10.4, casefile TLB_FLUSH_001"
    {
        // mov rax, cr3
        // mov cr3, rax
    }
}

// Machine block declaration (at source-file level)
machine {
    reason "x86_64 CPUID, RDMSR, WRMSR, IN/OUT instructions for kernel trusted path"
    arch: ["x86_64"]
    instructions: [
        "CPUID",
        "RDMSR",
        "WRMSR",
        "IN",
        "OUT",
        "MOV CRn",
        "LIDT",
        "CLI/STI"
    ]
    courts: ["cpu_reference_court", "pcie_spec_court", "dma_oracle_court"]
    receipts: [
        "CPUID_001",
        "MSR_CLOCK_MODULATION_V1",
        "IDT_SETUP_002",
        "DMA_ORACLE_001",
        "TLB_FLUSH_001"
    ]
    // Source file functions:
    //   read_cpu_model — CPUID instruction
    //   read_msr_safe — RDMSR instruction
    //   write_uart_byte — OUT instruction
    //   install_interrupt_handler — LIDT, MOV CRn
    //   setup_dma_descriptor — MMIO writes
    //   flush_tlb — CR3 reload
}

// fn trusted_block_no_rationale() -> void
//     effect [machine:ioport]
// {
//     // COMPILE ERROR E0601: trusted block requires documented rationale
//     trusted {
//         // machine operations here
//         let x: u64 = 0;
//     }
// }

fn main() -> u64
    effect [machine:ioport, memory:mmio, dma]
{
    let model: u64 = read_cpu_model();
    let msr_val: u64 = read_msr_safe(0x1A);
    let mmio_val: u64 = read_mmio_register(0xFD000000, 0x100);

    // Install interrupt handler for keyboard (IRQ 1)
    install_interrupt_handler(0x21, 0x1000);

    // Set up DMA transfer
    setup_dma_descriptor(0x10000, 0x20000, 512);

    // Flush TLB after page table changes
    flush_tlb();

    // Verify all trusted operations return expected values
    assert(model == 42, "trusted: CPUID model value");
    assert(msr_val == 0, "trusted: MSR read value");
    assert(mmio_val == 0, "trusted: MMIO read value");

    // Verify the main total
    let total: u64 = model + msr_val + mmio_val;
    assert(total == 42, "trusted: total of all operations = 42");

    return total;
}
