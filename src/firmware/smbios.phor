    size: Word16,
    form_factor: u8,
    device_set: u8,
    device_locator: FixedString[MAX_STRING_LEN],
    bank_locator: FixedString[MAX_STRING_LEN],
    memory_type: u8,
    type_detail: Word16,
    speed: Word16,
    manufacturer: FixedString[MAX_STRING_LEN],
    serial_number: FixedString[MAX_STRING_LEN],
    asset_tag: FixedString[MAX_STRING_LEN],
    part_number: FixedString[MAX_STRING_LEN],
    attributes: u8,
    extended_size: Word32,
    configured_memory_clock_speed: Word16,
    minimum_voltage: Word16,
    maximum_voltage: Word16,
    configured_voltage: Word16,
    memory_technology: u8,
    memory_operating_mode_capability: Word16,
    firmware_version: FixedString[MAX_STRING_LEN],
    module_manufacturer_id: Word16,
    module_product_id: Word16,
    memory_subsystem_controller_manufacturer_id: Word16,
    memory_subsystem_controller_product_id: Word16,
    non_volatile_size: u64,
    volatile_size: u64,
    cache_size: u64,
    logical_size: u64,
}

impl MemoryDevice {
    pub fn new() -> MemoryDevice
        effects: [deterministic]
    {
        MemoryDevice {
            header: SMBIOSHeader::new(),
            physical_memory_array_handle: 0,
            memory_error_info_handle: 0,
            total_width: 0,
            data_width: 0,
            size: 0,
            form_factor: 0,
            device_set: 0,
            device_locator: FixedString::new(),
            bank_locator: FixedString::new(),
            memory_type: 0,
            type_detail: 0,
            speed: 0,
            manufacturer: FixedString::new(),
            serial_number: FixedString::new(),
            asset_tag: FixedString::new(),
            part_number: FixedString::new(),
            attributes: 0,
            extended_size: 0,
            configured_memory_clock_speed: 0,
            minimum_voltage: 0,
            maximum_voltage: 0,
            configured_voltage: 0,
            memory_technology: 0,
            memory_operating_mode_capability: 0,
            firmware_version: FixedString::new(),
            module_manufacturer_id: 0,
            module_product_id: 0,
            memory_subsystem_controller_manufacturer_id: 0,
            memory_subsystem_controller_product_id: 0,
            non_volatile_size: 0,
            volatile_size: 0,
            cache_size: 0,
            logical_size: 0,
        }
    }

    pub fn is_populated(self) -> bool
        effects: [deterministic]
    {
        self.size != 0
    }

    pub fn size_mb(self) -> u64
        effects: [deterministic]
    {
        if self.size == 0x7FFF {
            // Extended size field
            self.extended_size as u64
        } else if self.size & 0x8000 != 0 {
            // Size in MB (bit 15 set = megabytes)
            (self.size & 0x7FFF) as u64
        } else {
            // Size in KB
            (self.size as u64) * 1024 / 1024
        }
    }

    pub fn speed_mhz(self) -> Word16
        effects: [deterministic]
    {
        self.speed
    }

    pub fn memory_type_name(self) -> FixedString[16]
        effects: [deterministic]
    {
        match self.memory_type {
            0x00 => FixedString::from("Unknown"),
            0x01 => FixedString::from("Other"),
            0x02 => FixedString::from("DRAM"),
            0x03 => FixedString::from("EDRAM"),
            0x04 => FixedString::from("VRAM"),
            0x05 => FixedString::from("SRAM"),
            0x06 => FixedString::from("RAM"),
            0x07 => FixedString::from("ROM"),
            0x08 => FixedString::from("Flash"),
            0x09 => FixedString::from("EEPROM"),
            0x0A => FixedString::from("FEPROM"),
            0x0B => FixedString::from("EPROM"),
            0x0C => FixedString::from("CDRAM"),
            0x0D => FixedString::from("3DRAM"),
            0x0E => FixedString::from("SDRAM"),
            0x0F => FixedString::from("SGRAM"),
            0x10 => FixedString::from("RDRAM"),
            0x11 => FixedString::from("DDR"),
            0x12 => FixedString::from("DDR2"),
            0x13 => FixedString::from("DDR2 FB-DIMM"),
            0x14 => FixedString::from("DDR3"),
            0x15 => FixedString::from("FBD2"),
            0x16 => FixedString::from("DDR4"),
            0x17 => FixedString::from("LPDDR"),
            0x18 => FixedString::from("LPDDR2"),
            0x19 => FixedString::from("LPDDR3"),
            0x1A => FixedString::from("LPDDR4"),
            0x1B => FixedString::from("DDR5"),
            0x1C => FixedString::from("LPDDR5"),
            _ => FixedString::from("Unknown"),
        }
    }

    pub fn form_factor_name(self) -> FixedString[32]
        effects: [deterministic]
    {
        match self.form_factor {
            0x01 => FixedString::from("Other"),
            0x02 => FixedString::from("Unknown"),
            0x03 => FixedString::from("SIMM"),
            0x04 => FixedString::from("SIP"),
            0x05 => FixedString::from("Chip"),
            0x06 => FixedString::from("DIP"),
            0x07 => FixedString::from("ZIP"),
            0x08 => FixedString::from("Proprietary Card"),
            0x09 => FixedString::from("DIMM"),
            0x0A => FixedString::from("TSOP"),
            0x0B => FixedString::from("Row of Chips"),
            0x0C => FixedString::from("RIMM"),
            0x0D => FixedString::from("SODIMM"),
            0x0E => FixedString::from("SRIMM"),
            0x0F => FixedString::from("FB-DIMM"),
            _ => FixedString::from("Unknown"),
        }
    }
}

// ──────────────────────────────────────────────
// Cache Information (Type 7)
// ──────────────────────────────────────────────

pub type CacheInfo : struct {
    header: SMBIOSHeader,
    socket_designation: FixedString[MAX_STRING_LEN],
    cache_configuration: Word16,
    maximum_cache_size: Word16,
    installed_size: Word16,
    supported_sram_type: Word16,
    current_sram_type: Word16,
    cache_speed: u8,
    error_correction_type: u8,
    system_cache_type: u8,
    associativity: u8,
    maximum_cache_size_2: Word32,
    installed_size_2: Word32,
}

impl CacheInfo {
    pub fn new() -> CacheInfo
        effects: [deterministic]
    {
        CacheInfo {
            header: SMBIOSHeader::new(),
            socket_designation: FixedString::new(),
            cache_configuration: 0,
            maximum_cache_size: 0,
            installed_size: 0,
            supported_sram_type: 0,
            current_sram_type: 0,
            cache_speed: 0,
            error_correction_type: 0,
            system_cache_type: 0,
            associativity: 0,
            maximum_cache_size_2: 0,
            installed_size_2: 0,
        }
    }

    pub fn cache_level(self) -> u8
        effects: [deterministic]
    {
        ((self.cache_configuration >> 5) & 0x07) as u8
    }

    pub fn is_split_cache(self) -> bool
        effects: [deterministic]
    {
        (self.cache_configuration & 0x0080) != 0
    }

    pub fn installed_size_kb(self) -> u64
        effects: [deterministic]
    {
        if self.installed_size & 0x8000 != 0 {
            // Size in KB
            (self.installed_size & 0x7FFF) as u64
        } else {
            // Size in 64K blocks
            (self.installed_size as u64) * 64
        }
    }
}

