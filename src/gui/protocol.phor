// protocol.phor — Native Phorensic Display Protocol Types
// Capability-based display protocol: messages, capabilities, events, serialization
// All operations bounded to fixed capacities. Every function declares effects.
// Part of the Phorensic OS GUI subsystem.

package gui.protocol;

// ──────────────────────────────────────────────
// Protocol Version and Identifiers
// ──────────────────────────────────────────────

const PROTOCOL_MAJOR: u64 = 0;
const PROTOCOL_MINOR: u64 = 1;
const MAX_SURFACES: u64 = 4096;
const MAX_OUTPUTS: u64 = 16;
const MAX_CLIENTS: u64 = 256;
const MAX_EVENT_QUEUE: u64 = 1024;
const MAX_PROTOCOL_MSG_SIZE: u64 = 4096;
const MAX_CAP_GRANTS: u64 = 64;
const MAX_SURFACE_PER_CLIENT: u64 = 128;
const HANDLE_GEN_BITS: u64 = 16;

// ──────────────────────────────────────────────
// Capability Identifiers
// ──────────────────────────────────────────────

enum CapabilityId {
    SurfaceCreate,
    SurfaceDestroy(u64),
    SurfaceConfigure(u64),
    SurfaceAttachBuffer(u64),
    SurfacePresent(u64),
    InputReceive(u64),
    InputSubscribe(u64, u64),
    OutputEnumerate,
    OutputModeSet(u64),
    CompositorInfo,
    SessionCreate,
    SessionDestroy(u64),
    BufferAlloc(u64),
    BufferShare(u64),
    ClipboardAccess,
    PointerConstrain(u64),
    CursorSet(u64),
    WindowManagerEnumerate,
    WindowManagerConfigure,
    WindowManagerFocus,
    WindowManagerStack,
    WindowManagerDecorate,
    ShellPanelAccess,
    ShellNotificationSend,
    ShellLauncherQuery,
    InspectorDumpSurfaces,
    InspectorDumpCaptures,
    InspectorDumpResiduals,
    InspectorDumpProvenance,
}

// ──────────────────────────────────────────────
// Surface Types
// ──────────────────────────────────────────────

enum SurfaceType {
    Window,
    Overlay,
    Cursor,
    Popup,
}

enum SurfaceState {
    Initial,
    Configured,
    Mapped,
    Focused,
    Unfocused,
    Unmapped,
    Destroyed,
}

enum SurfaceRole {
    TopLevel,
    Transient(u64),
    Modal(u64),
    Dropdown(u64),
    Tooltip(u64),
    Menu(u64),
    Dock,
    Panel,
    Desktop,
    LockScreen,
}

// ──────────────────────────────────────────────
// Geometry Types
// ──────────────────────────────────────────────

struct Point {
    x: i32,
    y: i32,
}

struct Size {
    width: u32,
    height: u32,
}

struct Rectangle {
    x: i32,
    y: i32,
    width: u32,
    height: u32,
}

struct Margins {
    left: u32,
    right: u32,
    top: u32,
    bottom: u32,
}

struct Scale {
    x: f64,
    y: f64,
}

// ──────────────────────────────────────────────
