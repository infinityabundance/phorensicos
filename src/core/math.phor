// Safe Conversion Helpers
// ──────────────────────────────────────────────
// Evidence path: MATH-CONV-001 through MATH-CONV-020

// Convert u64 to u32 with bounds check.
pub fn u64_to_u32(value: u64) -> Result[u32, OverflowError>
    effects: [deterministic]
{
    if value > 0xFFFF_FFFF {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x200),
            FixedString[128]::from_slice("u64 to u32 conversion overflow")))
    }
    Result::Ok(value as u32)
}

// Convert u64 to u16 with bounds check.
pub fn u64_to_u16(value: u64) -> Result[u16, OverflowError>
    effects: [deterministic]
{
    if value > 0xFFFF {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x201),
            FixedString[128]::from_slice("u64 to u16 conversion overflow")))
    }
    Result::Ok(value as u16)
}

// Convert u64 to u8 with bounds check.
pub fn u64_to_u8(value: u64) -> Result[u8, OverflowError>
    effects: [deterministic]
{
    if value > 0xFF {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x202),
            FixedString[128]::from_slice("u64 to u8 conversion overflow")))
    }
    Result::Ok(value as u8)
}

// Convert u32 to u16 with bounds check.
pub fn u32_to_u16(value: u32) -> Result[u16, OverflowError>
    effects: [deterministic]
{
    if value > 0xFFFF {
        return Result::Err(OverflowError::new(
            Word64::from_u64(DIAG_MATH_BASE | 0x203),
            FixedString[128]::from_slice("u32 to u16 conversion overflow")))
    }
    Result::Ok(value as u16)
}

// Convert u32 to u8 with bounds check.
pub fn u32_to_u8(value: u32) -> Result[u8, OverflowError>
    effects: [deterministic]
{
    if value > 0xFF {
        return Result::Err(OverflowError::new(
