// file: forensic_inference.phor
// purpose: Forensic inference engine for evidence graph reasoning,
//          causal inference, root cause analysis, timeline reconstruction,
//          provenance analysis, and automated report generation.
//          Fully deterministic for court-verifiable results.
// evidence: FORENSIC-INFERENCE-ARCH-001 through FORENSIC-INFERENCE-ARCH-250
// residual: Every inference step, causal link, and conclusion is recorded.

use core::constants::*
use core::types::*
use core::errors::*
use core::effects::*
use core::collections::*
use core::math::*
use core::traits::*
use core::serialization::*

// ──────────────────────────────────────────────
// Forensic Inference Diagnostic Ranges
// ──────────────────────────────────────────────
const DIAG_FORENSIC_INFERENCE : Word64 = DIAG_AI_BASE | 0x0400

const INFERENCE_MAX_EVIDENCE     : u32 = 1024
const INFERENCE_GRAPH_CAP        : u32 = 256
const INFERENCE_CAUSAL_DEPTH     : u32 = 64
const INFERENCE_TIMELINE_CAP     : u32 = 256
const INFERENCE_HYPOTHESIS_CAP   : u32 = 16
const INFERENCE_CONCLUSION_CAP   : u32 = 32
const INFERENCE_NAME_CAP         : u32 = 64
const INFERENCE_REPORT_CAP       : u32 = 4096
const INFERENCE_RESIDUAL_LOG     : u32 = 64
const INFERENCE_PROVENANCE_DEPTH : u32 = 32

// ──────────────────────────────────────────────
// Evidence Item
// ──────────────────────────────────────────────
pub type EvidenceItem : struct {
    id: Word32,
    timestamp: Word64,
    source: FixedString[INFERENCE_NAME_CAP],
    evidence_type: FixedString[INFERENCE_NAME_CAP],
    description: FixedString[256],
    confidence: u8,
    weight: u8,
    is_direct: bool,
}

impl EvidenceItem {
    pub fn new(eid: Word32, ts: Word64, src: FixedString[INFERENCE_NAME_CAP], etype: FixedString[INFERENCE_NAME_CAP]) -> EvidenceItem
        effects: [deterministic]
    {
        EvidenceItem {
            id: eid,
            timestamp: ts,
            source: src,
            evidence_type: etype,
            description: FixedString::new(),
            confidence: 100,
            weight: 50,
            is_direct: false,
        }
    }

    pub fn set_description(self: ref mut, desc: FixedString[256])
        effects: [deterministic]
    {
        self.description = desc
    }

    pub fn set_confidence(self: ref mut, conf: u8)
        effects: [deterministic]
    {
        self.confidence = if conf > 100 { 100 } else { conf }
    }

    pub fn set_weight(self: ref mut, w: u8)
        effects: [deterministic]
    {
        self.weight = if w > 100 { 100 } else { w }
    }

    pub fn mark_direct(self: ref mut)
        effects: [deterministic]
    {
        self.is_direct = true
    }
}

// ──────────────────────────────────────────────
// Evidence Graph Node
// ──────────────────────────────────────────────
pub type EvidenceNode : struct {
    id: Word32,
    evidence_id: Word32,
    node_type: u8,
    label: FixedString[INFERENCE_NAME_CAP],
    strength: u8,
}

impl EvidenceNode {
    pub fn new(nid: Word32, eid: Word32, ntype: u8, lbl: FixedString[INFERENCE_NAME_CAP]) -> EvidenceNode
        effects: [deterministic]
    {
        EvidenceNode {
            id: nid,
            evidence_id: eid,
            node_type: ntype,
            label: lbl,
            strength: 50,
        }
    }
}

// ──────────────────────────────────────────────
// Evidence Graph Edge (causal link)
// ──────────────────────────────────────────────
pub type EvidenceEdge : struct {
    id: Word32,
    source_node: Word32,
    target_node: Word32,
    relationship: FixedString[INFERENCE_NAME_CAP],
    confidence: u8,
    causal_strength: u8,
}

impl EvidenceEdge {
    pub fn new(eid: Word32, src: Word32, tgt: Word32, rel: FixedString[INFERENCE_NAME_CAP]) -> EvidenceEdge
        effects: [deterministic]
    {
        EvidenceEdge {
            id: eid,
            source_node: src,
            target_node: tgt,
            relationship: rel,
            confidence: 100,
            causal_strength: 50,
        }
    }

    pub fn record(self: ref mut)
        effects: [residual]
    {
        residual emit {
            ai_op: "forensic.edge.created",
            edge_id: self.id as u64,
            source: self.source_node as u64,
            target: self.target_node as u64,
            relationship: self.relationship,
            confidence: self.confidence as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Evidence Graph
// ──────────────────────────────────────────────
pub type EvidenceGraph : struct {
    nodes: FixedArray[EvidenceNode, INFERENCE_GRAPH_CAP],
    node_count: u32,
    edges: FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP],
    edge_count: u32,
    next_node_id: Word32,
    next_edge_id: Word32,
}

impl EvidenceGraph {
    pub fn new() -> EvidenceGraph
        effects: [deterministic]
    {
        EvidenceGraph {
            nodes: FixedArray::new(),
            node_count: 0,
            edges: FixedArray::new(),
            edge_count: 0,
            next_node_id: Word32::from_u32(1),
            next_edge_id: Word32::from_u32(1),
        }
    }

    pub fn add_node(self: ref mut, eid: Word32, ntype: u8, lbl: FixedString[INFERENCE_NAME_CAP]) -> Result[Word32, BoundsError>
        effects: [deterministic]
    {
        if self.node_count >= INFERENCE_GRAPH_CAP {
            return Result::Err(bounds_capacity_exceeded(INFERENCE_GRAPH_CAP))
        }
        let nid: Word32 = self.next_node_id
        self.next_node_id = Word32::from_u32(self.next_node_id.to_u32() + 1)
        let node: EvidenceNode = EvidenceNode::new(nid, eid, ntype, lbl)
        let r: Result<(), BoundsError> = self.nodes.set(self.node_count, node)
        if r.is_ok() {
            self.node_count = self.node_count + 1
        }
        Result::Ok(nid)
    }

    pub fn add_edge(self: ref mut, src: Word32, tgt: Word32, rel: FixedString[INFERENCE_NAME_CAP]) -> Result[Word32, BoundsError>
        effects: [deterministic, residual]
    {
        if self.edge_count >= INFERENCE_GRAPH_CAP {
            return Result::Err(bounds_capacity_exceeded(INFERENCE_GRAPH_CAP))
        }
        let eid: Word32 = self.next_edge_id
        self.next_edge_id = Word32::from_u32(self.next_edge_id.to_u32() + 1)
        let mut edge: EvidenceEdge = EvidenceEdge::new(eid, src, tgt, rel)
        let r: Result<(), BoundsError> = self.edges.set(self.edge_count, edge)
        if r.is_ok() {
            self.edge_count = self.edge_count + 1
            edge.record()
        }
        Result::Ok(eid)
    }

    pub fn get_outgoing(self, node_id: Word32) -> FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP]
        effects: [deterministic]
    {
        let mut results: FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP] = FixedArray::new()
        let mut count: u32 = 0
        for i in 0..self.edge_count {
            let edge: EvidenceEdge = match self.edges.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if edge.source_node.eq(node_id) {
                if count < INFERENCE_GRAPH_CAP {
                    let _ = results.set(count, edge)
                    count = count + 1
                }
            }
        }
        results
    }

    pub fn get_incoming(self, node_id: Word32) -> FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP]
        effects: [deterministic]
    {
        let mut results: FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP] = FixedArray::new()
        let mut count: u32 = 0
        for i in 0..self.edge_count {
            let edge: EvidenceEdge = match self.edges.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if edge.target_node.eq(node_id) {
                if count < INFERENCE_GRAPH_CAP {
                    let _ = results.set(count, edge)
                    count = count + 1
                }
            }
        }
        results
    }
}

// ──────────────────────────────────────────────
// Causal Inference Engine
// ──────────────────────────────────────────────
pub type CausalInference : struct {
    graph: EvidenceGraph,
    causal_chains: FixedArray[Word32, INFERENCE_CAUSAL_DEPTH],
    chain_count: u32,
}

impl CausalInference {
    pub fn new() -> CausalInference
        effects: [deterministic]
    {
        CausalInference {
            graph: EvidenceGraph::new(),
            causal_chains: FixedArray::new(),
            chain_count: 0,
        }
    }

    pub fn infer_causes(self: ref mut, target_node: Word32) -> FixedArray[EvidenceEdge, INFERENCE_CAUSAL_DEPTH]
        effects: [deterministic, residual]
    {
        let mut causes: FixedArray[EvidenceEdge, INFERENCE_CAUSAL_DEPTH] = FixedArray::new()
        let mut count: u32 = 0
        let incoming: FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP> = self.graph.get_incoming(target_node)
        for i in 0..INFERENCE_GRAPH_CAP {
            let edge: EvidenceEdge = match incoming.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            if edge.id.to_u32() == 0 { continue }
            if count < INFERENCE_CAUSAL_DEPTH {
                let _ = causes.set(count, edge)
                count = count + 1
            }
        }
        residual emit {
            ai_op: "forensic.causal.inference",
            target_node: target_node as u64,
            causes_found: count as u64,
        }
        causes
    }

    pub fn trace_causal_chain(self: ref mut, start_node: Word32) -> FixedArray[Word32, INFERENCE_CAUSAL_DEPTH]
        effects: [deterministic]
    {
        let mut chain: FixedArray[Word32, INFERENCE_CAUSAL_DEPTH] = FixedArray::new()
        let mut count: u32 = 0
        let mut current: Word32 = start_node
        for _ in 0..INFERENCE_CAUSAL_DEPTH {
            if count < INFERENCE_CAUSAL_DEPTH {
                let _ = chain.set(count, current)
                count = count + 1
            }
            let incoming: FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP> = self.graph.get_incoming(current)
            let mut next_found: bool = false
            for i in 0..INFERENCE_GRAPH_CAP {
                let edge: EvidenceEdge = match incoming.get(i) {
                    Result::Ok(e) => e,
                    Result::Err(_) => continue,
                }
                if edge.id.to_u32() != 0 {
                    current = edge.source_node
                    next_found = true
                }
            }
            if !next_found { break }
        }
        chain
    }
}

// ──────────────────────────────────────────────
// Root Cause Analysis
// ──────────────────────────────────────────────
pub type RootCauseResult : struct {
    cause_node: Word32,
    evidence_id: Word32,
    confidence: u8,
    score: u16,
    description: FixedString[256],
    depth: u32,
}

impl RootCauseResult {
    pub fn new(cn: Word32, eid: Word32, conf: u8, sc: u16) -> RootCauseResult
        effects: [deterministic]
    {
        RootCauseResult {
            cause_node: cn,
            evidence_id: eid,
            confidence: conf,
            score: sc,
            description: FixedString::new(),
            depth: 0,
        }
    }
}

pub type RootCauseAnalysis : struct {
    results: FixedArray[RootCauseResult, INFERENCE_HYPOTHESIS_CAP],
    result_count: u32,
    primary_cause: RootCauseResult,
}

impl RootCauseAnalysis {
    pub fn new() -> RootCauseAnalysis
        effects: [deterministic]
    {
        RootCauseAnalysis {
            results: FixedArray::new(),
            result_count: 0,
            primary_cause: RootCauseResult::new(0, 0, 0, 0),
        }
    }

    pub fn analyze(self: ref mut, causal: ref CausalInference, target_node: Word32, evidence: FixedArray[EvidenceItem, INFERENCE_MAX_EVIDENCE], evidence_count: u32)
        effects: [deterministic, residual]
    {
        self.result_count = 0
        let chain: FixedArray[Word32, INFERENCE_CAUSAL_DEPTH> = causal.trace_causal_chain(target_node)
        for i in 0..INFERENCE_CAUSAL_DEPTH {
            let node_id: Word32 = match chain.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if node_id.to_u32() == 0 { continue }
            // Find evidence for this node
            for j in 0..evidence_count {
                let ev: EvidenceItem = match evidence.get(j) {
                    Result::Ok(e) => e,
                    Result::Err(_) => continue,
                }
                // Calculate root cause score
                let score: u16 = ((ev.confidence as u32) * (ev.weight as u32) / (100 - (i * 10) + 1)) as u16
                let result: RootCauseResult = RootCauseResult::new(node_id, ev.id, ev.confidence, score)
                if self.result_count < INFERENCE_HYPOTHESIS_CAP {
                    let _ = self.results.set(self.result_count, result)
                    self.result_count = self.result_count + 1
                }
            }
        }
        // Sort by score descending
        for i in 0..self.result_count {
            for j in 0..(self.result_count - 1 - i) {
                let a: RootCauseResult = match self.results.get(j) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                let b: RootCauseResult = match self.results.get(j + 1) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                if b.score > a.score {
                    let _ = self.results.set(j, b)
                    let _ = self.results.set(j + 1, a)
                }
            }
        }
        if self.result_count > 0 {
            self.primary_cause = match self.results.get(0) {
                Result::Ok(v) => v,
                Result::Err(_) => RootCauseResult::new(0, 0, 0, 0),
            }
        }
        residual emit {
            ai_op: "forensic.root_cause",
            target: target_node as u64,
            candidates: self.result_count as u64,
            primary_score: self.primary_cause.score as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Timeline Reconstruction
// ──────────────────────────────────────────────
pub type TimelineEntry : struct {
    timestamp: Word64,
    evidence_id: Word32,
    event_type: FixedString[INFERENCE_NAME_CAP],
    description: FixedString[256],
    sequence: u32,
}

impl TimelineEntry {
    pub fn new(ts: Word64, eid: Word32, etype: FixedString[INFERENCE_NAME_CAP]) -> TimelineEntry
        effects: [deterministic]
    {
        TimelineEntry {
            timestamp: ts,
            evidence_id: eid,
            event_type: etype,
            description: FixedString::new(),
            sequence: 0,
        }
    }
}

pub type TimelineReconstructor : struct {
    entries: FixedArray[TimelineEntry, INFERENCE_TIMELINE_CAP],
    entry_count: u32,
}

impl TimelineReconstructor {
    pub fn new() -> TimelineReconstructor
        effects: [deterministic]
    {
        TimelineReconstructor {
            entries: FixedArray::new(),
            entry_count: 0,
        }
    }

    pub fn reconstruct(self: ref mut, evidence: FixedArray[EvidenceItem, INFERENCE_MAX_EVIDENCE], count: u32)
        effects: [deterministic, residual]
    {
        self.entry_count = 0
        for i in 0..count {
            let ev: EvidenceItem = match evidence.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            let entry: TimelineEntry = TimelineEntry::new(ev.timestamp, ev.id, ev.evidence_type)
            if self.entry_count < INFERENCE_TIMELINE_CAP {
                let _ = self.entries.set(self.entry_count, entry)
                self.entry_count = self.entry_count + 1
            }
        }
        // Sort by timestamp
        for i in 0..self.entry_count {
            for j in 0..(self.entry_count - 1 - i) {
                let a: TimelineEntry = match self.entries.get(j) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                let b: TimelineEntry = match self.entries.get(j + 1) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                if b.timestamp.lt(a.timestamp) {
                    let _ = self.entries.set(j, b)
                    let _ = self.entries.set(j + 1, a)
                }
            }
        }
        // Assign sequence numbers
        for i in 0..self.entry_count {
            let entry: ref mut TimelineEntry = match self.entries.ref_at_mut(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            entry.sequence = i
        }
        residual emit {
            ai_op: "forensic.timeline.reconstructed",
            entries: self.entry_count as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Provenance Analyzer
// ──────────────────────────────────────────────
pub type ProvenanceAnalyzer : struct {
    analyzed_nodes: FixedArray[Word32, INFERENCE_PROVENANCE_DEPTH],
    analyzed_count: u32,
}

impl ProvenanceAnalyzer {
    pub fn new() -> ProvenanceAnalyzer
        effects: [deterministic]
    {
        ProvenanceAnalyzer {
            analyzed_nodes: FixedArray::new(),
            analyzed_count: 0,
        }
    }

    pub fn analyze_chain(self: ref mut, graph: ref EvidenceGraph, start_node: Word32)
        effects: [deterministic, residual]
    {
        self.analyzed_count = 0
        let mut current: Word32 = start_node
        for _ in 0..INFERENCE_PROVENANCE_DEPTH {
            if current.to_u32() == 0 { break }
            if self.analyzed_count < INFERENCE_PROVENANCE_DEPTH {
                let _ = self.analyzed_nodes.set(self.analyzed_count, current)
                self.analyzed_count = self.analyzed_count + 1
            }
            let incoming: FixedArray[EvidenceEdge, INFERENCE_GRAPH_CAP> = graph.get_incoming(current)
            let mut found: bool = false
            for i in 0..INFERENCE_GRAPH_CAP {
                let edge: EvidenceEdge = match incoming.get(i) {
                    Result::Ok(e) => e,
                    Result::Err(_) => continue,
                }
                if edge.id.to_u32() != 0 {
                    current = edge.source_node
                    found = true
                }
            }
            if !found { break }
        }
        residual emit {
            ai_op: "forensic.provenance.analyzed",
            start_node: start_node as u64,
            chain_length: self.analyzed_count as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Forensic Inference Engine (Main)
// ──────────────────────────────────────────────
pub type ForensicInferenceEngine : struct {
    evidence: FixedArray[EvidenceItem, INFERENCE_MAX_EVIDENCE],
    evidence_count: u32,
    next_evidence_id: Word32,
    graph: EvidenceGraph,
    causal: CausalInference,
    rca: RootCauseAnalysis,
    timeline: TimelineReconstructor,
    provenance: ProvenanceAnalyzer,
    name: FixedString[INFERENCE_NAME_CAP],
    residuals: FixedArray[EvidenceItem, INFERENCE_RESIDUAL_LOG],
}

impl ForensicInferenceEngine {
    pub fn new(engine_name: FixedString[INFERENCE_NAME_CAP]) -> ForensicInferenceEngine
        effects: [deterministic, residual]
    {
        let engine: ForensicInferenceEngine = ForensicInferenceEngine {
            evidence: FixedArray::new(),
            evidence_count: 0,
            next_evidence_id: Word32::from_u32(1),
            graph: EvidenceGraph::new(),
            causal: CausalInference::new(),
            rca: RootCauseAnalysis::new(),
            timeline: TimelineReconstructor::new(),
            provenance: ProvenanceAnalyzer::new(),
            name: engine_name,
            residuals: FixedArray::new(),
        }
        residual emit {
            ai_op: "forensic.engine.init",
            name: engine_name,
            max_evidence: INFERENCE_MAX_EVIDENCE as u64,
            graph_capacity: INFERENCE_GRAPH_CAP as u64,
        }
        engine
    }

    pub fn add_evidence(en: ref mut ForensicInferenceEngine, ts: Word64, src: FixedString[INFERENCE_NAME_CAP], etype: FixedString[INFERENCE_NAME_CAP]) -> Result[Word32, BoundsError>
        effects: [deterministic, residual]
    {
        if en.evidence_count >= INFERENCE_MAX_EVIDENCE {
            return Result::Err(bounds_capacity_exceeded(INFERENCE_MAX_EVIDENCE))
        }
        let eid: Word32 = en.next_evidence_id
        en.next_evidence_id = Word32::from_u32(en.next_evidence_id.to_u32() + 1)
        let item: EvidenceItem = EvidenceItem::new(eid, ts, src, etype)
        let r: Result<(), BoundsError> = en.evidence.set(en.evidence_count, item)
        if r.is_ok() {
            en.evidence_count = en.evidence_count + 1
            // Create graph node for this evidence
            let _ = en.graph.add_node(eid, 0, etype)
            residual emit {
                ai_op: "forensic.evidence.added",
                evidence_id: eid as u64,
                source: src,
                evidence_type: etype,
                timestamp: ts.to_u64(),
            }
        }
        Result::Ok(eid)
    }

    pub fn link_evidence(en: ref mut ForensicInferenceEngine, from_eid: Word32, to_eid: Word32, relationship: FixedString[INFERENCE_NAME_CAP]) -> Result<Word32, BoundsError>
        effects: [deterministic, residual]
    {
        en.graph.add_edge(from_eid, to_eid, relationship)
    }

    pub fn run_causal_inference(en: ref mut ForensicInferenceEngine, target_evidence_id: Word32)
        effects: [deterministic, residual]
    {
        en.causal.infer_causes(target_evidence_id)
    }

    pub fn run_root_cause_analysis(en: ref mut ForensicInferenceEngine, target_node: Word32)
        effects: [deterministic, residual]
    {
        en.rca.analyze(&en.causal, target_node, en.evidence, en.evidence_count)
    }

    pub fn reconstruct_timeline(en: ref mut ForensicInferenceEngine)
        effects: [deterministic, residual]
    {
        en.timeline.reconstruct(en.evidence, en.evidence_count)
    }

    pub fn analyze_provenance(en: ref mut ForensicInferenceEngine, start_node: Word32)
        effects: [deterministic, residual]
    {
        en.provenance.analyze_chain(&en.graph, start_node)
    }

    pub fn generate_report(en: ref ForensicInferenceEngine) -> FixedString[INFERENCE_REPORT_CAP]
        effects: [deterministic]
    {
        let mut report: FixedString[INFERENCE_REPORT_CAP] = FixedString::new()
        report.append(FixedString[32]::from_slice("Forensic Inference Report\n"))
        report.append(FixedString[32]::from_slice("==========================\n"))
        report.append(FixedString[16]::from_slice("Engine: "))
        report.append(en.name)
        report.append(FixedString[16]::from_slice("\nEvidence items: "))
        report.append_u64(en.evidence_count as u64)
        report.append(FixedString[16]::from_slice("\nGraph nodes: "))
        report.append_u64(en.graph.node_count as u64)
        report.append(FixedString[16]::from_slice("\nGraph edges: "))
        report.append_u64(en.graph.edge_count as u64)

        report.append(FixedString[16]::from_slice("\n\nTimeline:\n"))
        for i in 0..en.timeline.entry_count {
            let entry: TimelineEntry = match en.timeline.entries.get(i) {
                Result::Ok(e) => e,
                Result::Err(_) => continue,
            }
            report.append(FixedString[4]::from_slice("  T"))
            report.append_u64(entry.sequence as u64)
            report.append(FixedString[4]::from_slice(": "))
            report.append_u64(entry.timestamp.to_u64())
            report.append(FixedString[4]::from_slice(" "))
            report.append(entry.event_type)
            report.append(FixedString[2]::from_slice("\n"))
        }

        report.append(FixedString[16]::from_slice("\nRoot Cause Analysis:\n"))
        if en.rca.result_count > 0 {
            report.append(FixedString[16]::from_slice("  Primary cause score: "))
            report.append_u64(en.rca.primary_cause.score as u64)
            report.append(FixedString[16]::from_slice("\n  Top candidates:\n"))
            for i in 0..en.rca.result_count {
                let rc: RootCauseResult = match en.rca.results.get(i) {
                    Result::Ok(v) => v,
                    Result::Err(_) => continue,
                }
                report.append(FixedString[8]::from_slice("    ["))
                report.append_u64(rc.score as u64)
                report.append(FixedString[4]::from_slice("] node="))
                report.append_u64(rc.cause_node as u64)
                report.append(FixedString[4]::from_slice(" conf="))
                report.append_u64(rc.confidence as u64)
                report.append(FixedString[2]::from_slice("\n"))
            }
        }

        report.append(FixedString[16]::from_slice("\nProvenance Chain:\n"))
        for i in 0..en.provenance.analyzed_count {
            let nid: Word32 = match en.provenance.analyzed_nodes.get(i) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            report.append(FixedString[8]::from_slice("  Step "))
            report.append_u64(i as u64)
            report.append(FixedString[4]::from_slice(": node "))
            report.append_u64(nid as u64)
            report.append(FixedString[2]::from_slice("\n"))
        }

        report
    }

    pub fn flush_residuals(en: ref mut ForensicInferenceEngine)
        effects: [residual]
    {
        residual emit {
            ai_op: "forensic.residuals.flushed",
            name: en.name,
            total_evidence: en.evidence_count as u64,
            graph_nodes: en.graph.node_count as u64,
            graph_edges: en.graph.edge_count as u64,
            timeline_entries: en.timeline.entry_count as u64,
        }
    }
}

// ──────────────────────────────────────────────
// Evidence Consistency Verification
// ──────────────────────────────────────────────
pub fn verify_evidence_consistency(en: ref ForensicInferenceEngine) -> bool
    effects: [deterministic]
{
    // Check all evidence items have valid IDs
    for i in 0..en.evidence_count {
        let ev: EvidenceItem = match en.evidence.get(i) {
            Result::Ok(v) => v,
            Result::Err(_) => return false,
        }
        if ev.id.to_u32() == 0 {
            return false
        }
        if ev.confidence > 100 {
            return false
        }
        if ev.weight > 100 {
            return false
        }
    }
    // Check graph edges reference valid nodes
    for i in 0..en.graph.edge_count {
        let edge: EvidenceEdge = match en.graph.edges.get(i) {
            Result::Ok(v) => v,
            Result::Err(_) => return false,
        }
        let mut src_found: bool = false
        let mut tgt_found: bool = false
        for j in 0..en.graph.node_count {
            let node: EvidenceNode = match en.graph.nodes.get(j) {
                Result::Ok(v) => v,
                Result::Err(_) => continue,
            }
            if node.id.eq(edge.source_node) { src_found = true }
            if node.id.eq(edge.target_node) { tgt_found = true }
        }
        if !src_found || !tgt_found {
            return false
        }
    }
    true
}

pub fn evidence_confidence_distribution(en: ref ForensicInferenceEngine) -> FixedString[1024]
    effects: [deterministic]
{
    let mut dist: FixedString[1024] = FixedString::new()
    dist.append(FixedString[32]::from_slice("Evidence Confidence Distribution\n"))
    dist.append(FixedString[32]::from_slice("================================\n"))
    let mut high_conf: u32 = 0
    let mut med_conf: u32 = 0
    let mut low_conf: u32 = 0
    for i in 0..en.evidence_count {
        let ev: EvidenceItem = match en.evidence.get(i) {
            Result::Ok(v) => v,
            Result::Err(_) => continue,
        }
        if ev.confidence >= 80 { high_conf = high_conf + 1 }
        else if ev.confidence >= 50 { med_conf = med_conf + 1 }
        else { low_conf = low_conf + 1 }
    }
    dist.append(FixedString[16]::from_slice("High confidence (80-100): "))
    dist.append_u64(high_conf as u64)
    dist.append(FixedString[16]::from_slice("\nMedium confidence (50-79): "))
    dist.append_u64(med_conf as u64)
    dist.append(FixedString[16]::from_slice("\nLow confidence (0-49): "))
    dist.append_u64(low_conf as u64)
    dist
}

pub fn export_evidence_json(en: ref ForensicInferenceEngine, limit: u32) -> FixedString[4096]
    effects: [deterministic]
{
    let mut output: FixedString[4096] = FixedString::new()
    output.append(FixedString[2]::from_slice("[\n"))
    let max: u32 = if limit > en.evidence_count { en.evidence_count } else { limit }
    for i in 0..max {
        let ev: EvidenceItem = match en.evidence.get(i) {
            Result::Ok(v) => v,
            Result::Err(_) => continue,
        }
        output.append(FixedString[8]::from_slice("  {\n"))
        output.append(FixedString[16]::from_slice("    \"id\": ")))
        output.append_u64(ev.id as u64)
        output.append(FixedString[2]::from_slice(",\n"))
        output.append(FixedString[16]::from_slice("    \"timestamp\": ")))
        output.append_u64(ev.timestamp.to_u64())
        output.append(FixedString[2]::from_slice(",\n"))
        output.append(FixedString[16]::from_slice("    \"source\": \""))
        output.append(ev.source)
        output.append(FixedString[4]::from_slice("\",\n"))
        output.append(FixedString[16]::from_slice("    \"type\": \""))
        output.append(ev.evidence_type)
        output.append(FixedString[4]::from_slice("\",\n"))
        output.append(FixedString[16]::from_slice("    \"confidence\": ")))
        output.append_u64(ev.confidence as u64)
        output.append(FixedString[2]::from_slice(",\n"))
        output.append(FixedString[16]::from_slice("    \"weight\": ")))
        output.append_u64(ev.weight as u64)
        output.append(FixedString[2]::from_slice(",\n"))
        output.append(FixedString[16]::from_slice("    \"direct\": ")))
        output.append(if ev.is_direct { FixedString[4]::from_slice("true") } else { FixedString[5]::from_slice("false") })
        output.append(FixedString[2]::from_slice("\n"))
        if i < max - 1 {
            output.append(FixedString[4]::from_slice("  },\n"))
        } else {
            output.append(FixedString[4]::from_slice("  }\n"))
        }
    }
    output.append(FixedString[2]::from_slice("]\n"))
    output
}

// ──────────────────────────────────────────────
// Module Initialization
// ──────────────────────────────────────────────
pub fn init_forensic_inference(name: FixedString[INFERENCE_NAME_CAP]) -> ForensicInferenceEngine
    effects: [deterministic, residual]
{
    let engine: ForensicInferenceEngine = ForensicInferenceEngine::new(name)
    residual emit {
        ai_op: "forensic.subsystem.init",
        name: name,
        max_evidence: INFERENCE_MAX_EVIDENCE as u64,
        graph_capacity: INFERENCE_GRAPH_CAP as u64,
        causal_depth: INFERENCE_CAUSAL_DEPTH as u64,
    }
    engine
}
