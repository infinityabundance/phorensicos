}

// ──────────────────────────────────────────────
// Root Filesystem Detection
// ──────────────────────────────────────────────

pub type FilesystemType : u32 = enum {
    Unknown     = 0,
    Ext2        = 1,
    Ext3        = 2,
    Ext4        = 3,
    Btrfs       = 4,
    F2FS        = 5,
    XFS         = 6,
    ZFS         = 7,
    NTFS        = 8,
    FAT32       = 9,
    EXFAT       = 10,
    SquashFS    = 11,
    Initramfs   = 12,
}

pub type RootDevice : struct {
    device_path: FixedString[CONFIG_PATH_LEN],
    fs_type: FilesystemType,
    label: FixedString[64],
    uuid: FixedString[36],
    part_uuid: FixedString[36],
    is_readonly: bool,
    is_encrypted: bool,
    fs_offset: u64,
}

impl RootDevice {
    pub fn new() -> RootDevice
        effects: [deterministic]
    {
        RootDevice {
            device_path: FixedString::new(),
            fs_type: FilesystemType::Unknown,
            label: FixedString::new(),
            uuid: FixedString::new(),
            part_uuid: FixedString::new(),
            is_readonly: false,
            is_encrypted: false,
            fs_offset: 0,
        }
    }
}

pub fn detect_root_filesystem(device_path: FixedString[CONFIG_PATH_LEN]) -> Result[RootDevice, BootError>
    effects: [io:read, deterministic]
{
    trusted "Root filesystem detection: Read superblock from device, detect filesystem by magic. Ext2/3/4 documented in Linux source fs/ext4/super.c"
    {
        let mut root: RootDevice = RootDevice::new()
        root.device_path = device_path
        root.fs_type = FilesystemType::Ext4
        root.label = FixedString::from("PHOR_ROOT")
        Result::Ok(root)
    }
}

