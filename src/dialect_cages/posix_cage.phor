// ============================================================================
// posix_cage.phor — POSIX Dialect Cage: Syscall Mapping, POSIX→Native Trans
// ============================================================================
// The POSIX Dialect Cage handles POSIX-compatible foreign code by mapping
// POSIX syscalls and library calls to native Phorensic operations.
//
// POSIX is an import dialect, not native OS law. Every POSIX call is
// observed, translated, and recorded as a residual for progressive
// replacement with native operations.
// ============================================================================

package "phorensic:posix_cage:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type POSIXCageError = enum {
    SyscallNotMapped = 0x01,
    SyscallArgumentMismatch = 0x02,
    ErrnoNotSupported = 0x03,
    SignalNotSupported = 0x04,
    ProcessForkNotSupported = 0x05,
    FileDescriptorInvalid = 0x06,
    PathTranslationFailed = 0x07,
    PermissionDeniedPOSIX = 0x08,
    ResourceLimitExceeded = 0x09,
    UnsupportedPOSIXFeature = 0x0A,
    ThreadNotSupported = 0x0B,
    IPCOperationFailed = 0x0C,
    TerminalIOUnsupported = 0x0D,
    InternalError = 0xFF,
}

// ============================================================================
// POSIX Syscall Numbers (x86_64)
// ============================================================================

