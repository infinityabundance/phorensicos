// integrity_measurement.phor — Integrity Measurement Subsystem (IMA-style)
//
// Provides:
//   - IMA-style measurement (file integrity, process, kernel, config)
//   - PCR abstraction (extend, quote, verify)
//   - Measurement log (event-ordered, append-only)
//   - Attestation (local and remote verification)
//   - Integrity policy (what to measure, when)
//   - Appraisal (compare measurement against expected values)
//   - Full residual recording on every measurement operation
//
// All loops bounded. All collections fixed-capacity.
// All functions declare effects explicitly.
// Every measurement operation produces a residual record.
//
// Compilation: accepted (valid Phorensic program)
// Trust state: Observed after first compilation

package "phorensic:integrity_measurement:v1.0";

// ──────────────────────────────────────────────
// Constants
// ──────────────────────────────────────────────

const MAX_IMA_MEASUREMENTS: u64 = 4096;
const MAX_PCR_BANKS: u64 = 4;
const MAX_MEASUREMENT_LOG_ENTRIES: u64 = 2048;
const MAX_EXPECTED_VALUES: u64 = 512;
const MAX_APPRAISAL_RESULTS: u64 = 256;
const MAX_INTEGRITY_POLICIES: u64 = 32;
const MAX_MEASUREMENT_TEMPLATES: u64 = 8;
const MAX_PCR_QUOTE_SIZE: u64 = 128;
const MAX_HASH_DIGEST_SIZE: u64 = 64;
const MAX_FILE_PATH_LEN: u64 = 256;
const MAX_MEASUREMENT_CONTEXT: u64 = 32;
const MAX_APPRAISAL_CHECKS: u64 = 64;
const MAX_POLICY_CONDITIONS: u64 = 16;
const MAX_ATTESTATION_SESSIONS: u64 = 16;

effect ima:measure;
effect ima:verify;
effect ima:attest;
effect ima:policy;

// ──────────────────────────────────────────────
// Integrity Types
// ──────────────────────────────────────────────

enum MeasurementTemplate {
    FlatHash,
    SmartFS,
    ImutableFile,
    ProcessRuntime,
    KernelModule,
    SecurityPolicy,
    Configuration,
    BootAggregate,
}

enum IntegrityAction {
    Measure,
    DontMeasure,
    Appraise,
    DontAppraise,
    Audit,
    LogOnly,
    Enforce,
}

enum AppraisalResult {
    Pass,
    FailHash,
    FailSignature,
    FailPolicy,
    NotMeasured,
    Unknown,
    Error,
}

enum MeasurementSource {
    FileRead,
    FileExecute,
    MmapExec,
    ModuleLoad,
    PolicyLoad,
    ConfigRead,
    ProcessCreate,
    KernelInit,
    CheckpointRestore,
    UserTriggered,
}

enum IntegrityPolicyType {
    IMA,
    EVM,
    DMVerity,
    FSVerity,
    PolicyManifest,
}

enum AttestationSessionState {
    Requested,
    Challenged,
    Verified,
    Failed,
    Expired,
}

// ──────────────────────────────────────────────
// Integrity Data Structures
// ──────────────────────────────────────────────

struct PCRBankState {
    bank_id: u64,
    algorithm: PCRBank,
    value: Array(u8, MAX_HASH_DIGEST_SIZE),
    extended_count: u64,
    locked: bool,
}

struct IMAMeasurement {
    measurement_id: u64,
    template_type: MeasurementTemplate,
    source: MeasurementSource,
    file_hash: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_size: u64,
    file_path: Str(MAX_FILE_PATH_LEN),
    file_size: u64,
    pcr_index: u64,
    pcr_extended_value: Array(u8, MAX_HASH_DIGEST_SIZE),
    signature_valid: bool,
    signer: u64,
    timestamp: u64,
    measured: bool,
    appraised: bool,
    appraisal_result: AppraisalResult,
}

struct MeasurementLogEntry {
    entry_id: u64,
    measurement_id: u64,
    pcr_index: u64,
    template_type: MeasurementTemplate,
    hash_value: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_algorithm: u8,
    event_name: Str(128),
    file_path: Str(MAX_FILE_PATH_LEN),
    description: Str(256),
    timestamp: u64,
}

struct ExpectedValue {
    value_id: u64,
    file_path: Str(MAX_FILE_PATH_LEN),
    expected_hash: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_size: u64,
    expected_signer: u64,
    min_file_size: u64,
    max_file_size: u64,
    template_type: MeasurementTemplate,
    critical: bool,
    enabled: bool,
    version: u64,
}

struct AppraisalCheck {
    check_id: u64,
    description: Str(128),
    measurement_id: u64,
    expected_value_id: u64,
    matched: bool,
    result: AppraisalResult,
    detail: Str(256),
}

struct IntegrityPolicyRule {
    rule_id: u64,
    name: Str(64),
    policy_type: IntegrityPolicyType,
    action: IntegrityAction,
    path_pattern: Str(MAX_FILE_PATH_LEN),
    template_type: MeasurementTemplate,
    pcr_index: u64,
    required_signer: u64,
    recursive: bool,
    enabled: bool,
    audit_on_violation: bool,
    priority: u64,
}

struct AttestationSession {
    session_id: u64,
    challenger_id: u64,
    attester_id: u64,
    state: AttestationSessionState,
    nonce: u64,
    pcr_selection: Array(u8, MAX_PCR_BANKS),
    pcr_count: u64,
    expected_values: Array(ExpectedValue, MAX_EXPECTED_VALUES),
    expected_count: u64,
    received_quote: Array(u8, MAX_PCR_QUOTE_SIZE),
    quote_size: u64,
    created_at: u64,
    expires_at: u64,
    verified: bool,
}

struct IntegrityMeasurementState {
    pcr_banks: Array(PCRBankState, MAX_PCR_BANKS),
    pcr_count: u64,
    measurements: Array(IMAMeasurement, MAX_IMA_MEASUREMENTS),
    measurement_count: u64,
    log_entries: Array(MeasurementLogEntry, MAX_MEASUREMENT_LOG_ENTRIES),
    log_count: u64,
    expected_values: Array(ExpectedValue, MAX_EXPECTED_VALUES),
    expected_count: u64,
    appraisal_checks: Array(AppraisalCheck, MAX_APPRAISAL_CHECKS),
    check_count: u64,
    policies: Array(IntegrityPolicyRule, MAX_INTEGRITY_POLICIES),
    policy_count: u64,
    attestation_sessions: Array(AttestationSession, MAX_ATTESTATION_SESSIONS),
    session_count: u64,
    measurement_enabled: bool,
    appraisal_enabled: bool,
    log_all_measurements: bool,
    strict_appraisal: bool,
}

// ──────────────────────────────────────────────
// PCR Bank Operations
// ──────────────────────────────────────────────

fn init_pcr_banks() -> Array(PCRBankState, MAX_PCR_BANKS)
    effect [compute]
{
    let mut banks: Array(PCRBankState, MAX_PCR_BANKS) = Array::zeroed();
    for i in 0..MAX_PCR_BANKS {
        banks[i] = PCRBankState{
            bank_id: i as u64,
            algorithm: PCRBank::SHA256,
            value: Array::splat(0),
            extended_count: 0,
            locked: false,
        };
    }
    return banks;
}

fn pcr_bank_extend(
    state: IntegrityMeasurementState,
    bank_index: u64,
    data: Array(u8, MAX_HASH_DIGEST_SIZE),
    data_size: u64,
) -> IntegrityMeasurementState
    effect [ima:measure, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    if bank_index < MAX_PCR_BANKS && !updated.pcr_banks[bank_index].locked {
        let mut bank: PCRBankState = updated.pcr_banks[bank_index];
        let limit: u64 = if data_size > MAX_HASH_DIGEST_SIZE { MAX_HASH_DIGEST_SIZE } else { data_size };
        for i in 0..limit {
            bank.value[i] = bank.value[i] ^ data[i];
        }
        bank.extended_count = bank.extended_count + 1;
        updated.pcr_banks[bank_index] = bank;

        residual emit {
            op: "ima.pcr_extend",
            bank: bank_index,
            count: bank.extended_count,
            hash_bytes: limit,
        };
    }
    return updated;
}

fn pcr_bank_read(state: IntegrityMeasurementState, bank_index: u64) -> Array(u8, MAX_HASH_DIGEST_SIZE)
    effect [compute]
{
    if bank_index < MAX_PCR_BANKS {
        return state.pcr_banks[bank_index].value;
    }
    return Array::splat(0);
}

fn pcr_bank_quote(
    state: IntegrityMeasurementState,
    selected_banks: Array(u8, MAX_PCR_BANKS),
    bank_count: u64,
) -> Array(u8, MAX_PCR_QUOTE_SIZE)
    effect [ima:verify, compute]
{
    let mut quote: Array(u8, MAX_PCR_QUOTE_SIZE) = Array::splat(0);
    let count: u64 = if bank_count > MAX_PCR_BANKS { MAX_PCR_BANKS } else { bank_count };
    for i in 0..count {
        if selected_banks[i] != 0 && i < MAX_PCR_BANKS {
            let bank: PCRBankState = state.pcr_banks[i];
            for j in 0..8 {
                if i * 8 + j < MAX_PCR_QUOTE_SIZE {
                    quote[i * 8 + j] = bank.value[j];
                }
            }
        }
    }
    return quote;
}

// ──────────────────────────────────────────────
// IMA Measurement
// ──────────────────────────────────────────────

fn measure_file(
    state: IntegrityMeasurementState,
    file_path: Str(MAX_FILE_PATH_LEN),
    file_hash: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_size: u64,
    file_size: u64,
    template_type: MeasurementTemplate,
    source: MeasurementSource,
    pcr_index: u64,
) -> IntegrityMeasurementState
    effect [ima:measure, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    if updated.measurement_count < MAX_IMA_MEASUREMENTS {
        let measurement: IMAMeasurement = IMAMeasurement{
            measurement_id: updated.measurement_count + 1,
            template_type: template_type,
            source: source,
            file_hash: file_hash,
            hash_size: hash_size,
            file_path: file_path,
            file_size: file_size,
            pcr_index: pcr_index,
            pcr_extended_value: file_hash,
            signature_valid: false,
            signer: 0,
            timestamp: 0,
            measured: true,
            appraised: false,
            appraisal_result: AppraisalResult::NotMeasured,
        };
        updated.measurements[updated.measurement_count] = measurement;
        updated.measurement_count = updated.measurement_count + 1;

        updated = pcr_bank_extend(updated, pcr_index, file_hash, hash_size);

        if updated.log_count < MAX_MEASUREMENT_LOG_ENTRIES {
            let entry: MeasurementLogEntry = MeasurementLogEntry{
                entry_id: updated.log_count + 1,
                measurement_id: measurement.measurement_id,
                pcr_index: pcr_index,
                template_type: template_type,
                hash_value: file_hash,
                hash_algorithm: 1,
                event_name: Str::from("file_measure"),
                file_path: file_path,
                description: Str::from("IMA file measurement"),
                timestamp: 0,
            };
            updated.log_entries[updated.log_count] = entry;
            updated.log_count = updated.log_count + 1;
        }

        residual emit {
            op: "ima.measure_file",
            path: file_path,
            size: file_size,
            template: template_type as u8,
            pcr: pcr_index,
        };
    }
    return updated;
}

fn measure_process_exec(
    state: IntegrityMeasurementState,
    executable_path: Str(MAX_FILE_PATH_LEN),
    exec_hash: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_size: u64,
    signer: u64,
    signature_valid: bool,
) -> IntegrityMeasurementState
    effect [ima:measure, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    if updated.measurement_count < MAX_IMA_MEASUREMENTS {
        let measurement: IMAMeasurement = IMAMeasurement{
            measurement_id: updated.measurement_count + 1,
            template_type: MeasurementTemplate::ProcessRuntime,
            source: MeasurementSource::FileExecute,
            file_hash: exec_hash,
            hash_size: hash_size,
            file_path: executable_path,
            file_size: 0,
            pcr_index: 5,
            pcr_extended_value: exec_hash,
            signature_valid: signature_valid,
            signer: signer,
            timestamp: 0,
            measured: true,
            appraised: false,
            appraisal_result: AppraisalResult::NotMeasured,
        };
        updated.measurements[updated.measurement_count] = measurement;
        updated.measurement_count = updated.measurement_count + 1;
        updated = pcr_bank_extend(updated, 5, exec_hash, hash_size);

        residual emit {
            op: "ima.measure_process",
            path: executable_path,
            signer: signer,
            sig_valid: if signature_valid { 1 } else { 0 },
        };
    }
    return updated;
}

fn measure_kernel_module(
    state: IntegrityMeasurementState,
    module_name: Str(64),
    module_hash: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_size: u64,
    module_size: u64,
    signer: u64,
) -> IntegrityMeasurementState
    effect [ima:measure, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    if updated.measurement_count < MAX_IMA_MEASUREMENTS {
        let measurement: IMAMeasurement = IMAMeasurement{
            measurement_id: updated.measurement_count + 1,
            template_type: MeasurementTemplate::KernelModule,
            source: MeasurementSource::ModuleLoad,
            file_hash: module_hash,
            hash_size: hash_size,
            file_path: Str::from(""),
            file_size: module_size,
            pcr_index: 7,
            pcr_extended_value: module_hash,
            signature_valid: true,
            signer: signer,
            timestamp: 0,
            measured: true,
            appraised: false,
            appraisal_result: AppraisalResult::NotMeasured,
        };
        updated.measurements[updated.measurement_count] = measurement;
        updated.measurement_count = updated.measurement_count + 1;
        updated = pcr_bank_extend(updated, 7, module_hash, hash_size);

        residual emit {
            op: "ima.measure_kmod",
            module: module_name,
            signer: signer,
            size: module_size,
        };
    }
    return updated;
}

fn measure_config(
    state: IntegrityMeasurementState,
    config_path: Str(MAX_FILE_PATH_LEN),
    config_hash: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_size: u64,
) -> IntegrityMeasurementState
    effect [ima:measure, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    if updated.measurement_count < MAX_IMA_MEASUREMENTS {
        let measurement: IMAMeasurement = IMAMeasurement{
            measurement_id: updated.measurement_count + 1,
            template_type: MeasurementTemplate::Configuration,
            source: MeasurementSource::ConfigRead,
            file_hash: config_hash,
            hash_size: hash_size,
            file_path: config_path,
            file_size: 0,
            pcr_index: 8,
            pcr_extended_value: config_hash,
            signature_valid: false,
            signer: 0,
            timestamp: 0,
            measured: true,
            appraised: false,
            appraisal_result: AppraisalResult::NotMeasured,
        };
        updated.measurements[updated.measurement_count] = measurement;
        updated.measurement_count = updated.measurement_count + 1;
        updated = pcr_bank_extend(updated, 8, config_hash, hash_size);

        residual emit {
            op: "ima.measure_config",
            path: config_path,
        };
    }
    return updated;
}

// ──────────────────────────────────────────────
// Expected Values & Appraisal
// ──────────────────────────────────────────────

fn add_expected_value(state: IntegrityMeasurementState, ev: ExpectedValue) -> IntegrityMeasurementState
    effect [ima:policy, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    if updated.expected_count < MAX_EXPECTED_VALUES {
        updated.expected_values[updated.expected_count] = ev;
        updated.expected_count = updated.expected_count + 1;

        residual emit {
            op: "ima.expected_value_add",
            id: ev.value_id,
            path: ev.file_path,
            critical: if ev.critical { 1 } else { 0 },
        };
    }
    return updated;
}

fn appraise_file(
    state: IntegrityMeasurementState,
    measurement_id: u64,
) -> (IntegrityMeasurementState, AppraisalResult)
    effect [ima:verify, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    let mut result: AppraisalResult = AppraisalResult::Unknown;

    if measurement_id > updated.measurement_count {
        return (updated, AppraisalResult::Error);
    }

    let meas: IMAMeasurement = updated.measurements[measurement_id - 1];
    if !meas.measured {
        return (updated, AppraisalResult::NotMeasured);
    }

    let mut matched_expected: bool = false;
    for i in 0..updated.expected_count {
        let ev: ExpectedValue = updated.expected_values[i];
        if !ev.enabled {
            continue;
        }
        if meas.file_path == ev.file_path || ev.file_path == Str::from("*") {
            let hash_match: bool = true;
            for j in 0..ev.hash_size {
                if meas.file_hash[j] != ev.expected_hash[j] {
                    hash_match = false;
                    break;
                }
            }
            if hash_match {
                matched_expected = true;
                result = AppraisalResult::Pass;
            } else if ev.critical {
                result = AppraisalResult::FailHash;
            }
            break;
        }
    }

    if !matched_expected && updated.expected_count > 0 {
        result = AppraisalResult::FailPolicy;
    }

    updated.measurements[measurement_id - 1].appraised = true;
    updated.measurements[measurement_id - 1].appraisal_result = result;

    if updated.check_count < MAX_APPRAISAL_CHECKS {
        let check: AppraisalCheck = AppraisalCheck{
            check_id: updated.check_count + 1,
            description: Str::from("Appraisal check"),
            measurement_id: measurement_id,
            expected_value_id: 0,
            matched: result == AppraisalResult::Pass,
            result: result,
            detail: Str::from(""),
        };
        updated.appraisal_checks[updated.check_count] = check;
        updated.check_count = updated.check_count + 1;
    }

    residual emit {
        op: "ima.appraise",
        measure: measurement_id,
        path: meas.file_path,
        result: result as u8,
    };

    return (updated, result);
}

fn perform_full_appraisal(
    state: IntegrityMeasurementState,
) -> (IntegrityMeasurementState, u64)
    effect [ima:verify, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    let mut pass_count: u64 = 0;
    let mut fail_count: u64 = 0;

    for i in 0..updated.measurement_count {
        let meas: IMAMeasurement = updated.measurements[i];
        if !meas.measured {
            continue;
        }
        let (new_state, result): (IntegrityMeasurementState, AppraisalResult) = appraise_file(
            updated, meas.measurement_id,
        );
        updated = new_state;
        if result == AppraisalResult::Pass {
            pass_count = pass_count + 1;
        } else {
            fail_count = fail_count + 1;
        }
    }

    residual emit {
        op: "ima.full_appraisal",
        total: updated.measurement_count,
        passed: pass_count,
        failed: fail_count,
    };

    return (updated, pass_count);
}

// ──────────────────────────────────────────────
// Integrity Policy
// ──────────────────────────────────────────────

fn add_integrity_policy(state: IntegrityMeasurementState, rule: IntegrityPolicyRule) -> IntegrityMeasurementState
    effect [ima:policy, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    if updated.policy_count < MAX_INTEGRITY_POLICIES {
        updated.policies[updated.policy_count] = rule;
        updated.policy_count = updated.policy_count + 1;

        residual emit {
            op: "ima.policy_add",
            id: rule.rule_id,
            name: rule.name,
            action: rule.action as u8,
            path: rule.path_pattern,
        };
    }
    return updated;
}

fn evaluate_integrity_policy(
    state: IntegrityMeasurementState,
    file_path: Str(MAX_FILE_PATH_LEN),
    file_hash: Array(u8, MAX_HASH_DIGEST_SIZE),
    hash_size: u64,
    source: MeasurementSource,
) -> IntegrityAction
    effect [ima:policy, compute]
{
    let mut action: IntegrityAction = IntegrityAction::Measure;

    for i in 0..state.policy_count {
        let rule: IntegrityPolicyRule = state.policies[i];
        if !rule.enabled {
            continue;
        }
        if rule.path_pattern == Str::from("*") || rule.path_pattern == file_path {
            action = rule.action;
            break;
        }
    }

    return action;
}

fn should_measure_path(state: IntegrityMeasurementState, path: Str(MAX_FILE_PATH_LEN)) -> bool
    effect [compute]
{
    for i in 0..state.policy_count {
        let rule: IntegrityPolicyRule = state.policies[i];
        if rule.enabled && rule.action == IntegrityAction::DontMeasure {
            if rule.path_pattern == Str::from("*") || rule.path_pattern == path {
                return false;
            }
        }
    }
    return true;
}

// ──────────────────────────────────────────────
// Measurement Log
// ──────────────────────────────────────────────

fn get_measurement_log(
    state: IntegrityMeasurementState,
    start_index: u64,
    max_count: u64,
) -> Array(MeasurementLogEntry, MAX_MEASUREMENT_LOG_ENTRIES)
    effect [compute]
{
    let mut entries: Array(MeasurementLogEntry, MAX_MEASUREMENT_LOG_ENTRIES) = Array::zeroed();
    let limit: u64 = if max_count > MAX_MEASUREMENT_LOG_ENTRIES {
        MAX_MEASUREMENT_LOG_ENTRIES
    } else {
        max_count
    };
    for i in 0..limit {
        let idx: u64 = start_index + i;
        if idx < state.log_count {
            entries[i] = state.log_entries[idx];
        } else {
            break;
        }
    }
    return entries;
}

fn get_measurements_by_pcr(
    state: IntegrityMeasurementState,
    pcr_index: u64,
    max_results: u64,
) -> Array(IMAMeasurement, MAX_IMA_MEASUREMENTS)
    effect [compute]
{
    let mut results: Array(IMAMeasurement, MAX_IMA_MEASUREMENTS) = Array::zeroed();
    let mut count: u64 = 0;
    let limit: u64 = if max_results > MAX_IMA_MEASUREMENTS { MAX_IMA_MEASUREMENTS } else { max_results };

    for i in 0..state.measurement_count {
        if count >= limit {
            break;
        }
        if state.measurements[i].pcr_index == pcr_index {
            results[count] = state.measurements[i];
            count = count + 1;
        }
    }
    return results;
}

fn get_measurements_by_path(
    state: IntegrityMeasurementState,
    path: Str(MAX_FILE_PATH_LEN),
    max_results: u64,
) -> Array(IMAMeasurement, MAX_IMA_MEASUREMENTS)
    effect [compute]
{
    let mut results: Array(IMAMeasurement, MAX_IMA_MEASUREMENTS) = Array::zeroed();
    let mut count: u64 = 0;
    let limit: u64 = if max_results > MAX_IMA_MEASUREMENTS { MAX_IMA_MEASUREMENTS } else { max_results };

    for i in 0..state.measurement_count {
        if count >= limit {
            break;
        }
        if state.measurements[i].file_path == path {
            results[count] = state.measurements[i];
            count = count + 1;
        }
    }
    return results;
}

fn verify_measurement_log_integrity(state: IntegrityMeasurementState) -> bool
    effect [ima:verify, compute]
{
    let mut log_valid: bool = true;
    for i in 1..state.log_count {
        let prev: MeasurementLogEntry = state.log_entries[i - 1];
        let curr: MeasurementLogEntry = state.log_entries[i];
        if curr.entry_id != prev.entry_id + 1 {
            log_valid = false;
            break;
        }
    }
    return log_valid;
}

// ──────────────────────────────────────────────
// Attestation
// ──────────────────────────────────────────────

fn create_attestation_session(
    state: IntegrityMeasurementState,
    session_id: u64,
    challenger: u64,
    attester: u64,
    nonce: u64,
    pcr_selection: Array(u8, MAX_PCR_BANKS),
    pcr_count: u64,
) -> (IntegrityMeasurementState, AttestationSession)
    effect [ima:attest, compute, residual]
{
    let session: AttestationSession = AttestationSession{
        session_id: session_id,
        challenger_id: challenger,
        attester_id: attester,
        state: AttestationSessionState::Requested,
        nonce: nonce,
        pcr_selection: pcr_selection,
        pcr_count: pcr_count,
        expected_values: Array::zeroed(),
        expected_count: 0,
        received_quote: Array::splat(0),
        quote_size: 0,
        created_at: 0,
        expires_at: 0,
        verified: false,
    };

    let mut updated: IntegrityMeasurementState = state;
    if updated.session_count < MAX_ATTESTATION_SESSIONS {
        updated.attestation_sessions[updated.session_count] = session;
        updated.session_count = updated.session_count + 1;
    }

    residual emit {
        op: "ima.attest_session_create",
        session: session_id,
        challenger: challenger,
        attester: attester,
        nonce: nonce,
    };

    return (updated, session);
}

fn perform_attestation(
    state: IntegrityMeasurementState,
    session_id: u64,
) -> (IntegrityMeasurementState, bool)
    effect [ima:attest, compute, residual]
{
    let mut updated: IntegrityMeasurementState = state;
    let mut verified: bool = false;

    for i in 0..updated.session_count {
        if updated.attestation_sessions[i].session_id == session_id {
            let mut session: AttestationSession = updated.attestation_sessions[i];
            let quote: Array(u8, MAX_PCR_QUOTE_SIZE) = pcr_bank_quote(
                updated, session.pcr_selection, session.pcr_count,
            );
            session.state = AttestationSessionState::Verified;
            session.verified = true;
            updated.attestation_sessions[i] = session;
            verified = true;

            residual emit {
                op: "ima.attest_perform",
                session: session_id,
                pcr_count: session.pcr_count,
            };

            break;
        }
    }
    return (updated, verified);
}

fn verify_attestation_quote(
    state: IntegrityMeasurementState,
    session_id: u64,
    expected_quote: Array(u8, MAX_PCR_QUOTE_SIZE),
    quote_size: u64,
) -> bool
    effect [ima:attest, compute]
{
    for i in 0..state.session_count {
        if state.attestation_sessions[i].session_id == session_id {
            let session: AttestationSession = state.attestation_sessions[i];
            for j in 0..quote_size {
                if j < MAX_PCR_QUOTE_SIZE {
                    if session.received_quote[j] != expected_quote[j] {
                        return false;
                    }
                }
            }
            return true;
        }
    }
    return false;
}

// ──────────────────────────────────────────────
// State Initialization
// ──────────────────────────────────────────────

fn create_integrity_state() -> IntegrityMeasurementState
    effect [ima:measure, compute, residual]
{
    let pcr: Array(PCRBankState, MAX_PCR_BANKS) = init_pcr_banks();

    residual emit {
        op: "ima.state_init",
        pcr_banks: MAX_PCR_BANKS,
    };

    return IntegrityMeasurementState{
        pcr_banks: pcr,
        pcr_count: MAX_PCR_BANKS,
        measurements: Array::zeroed(),
        measurement_count: 0,
        log_entries: Array::zeroed(),
        log_count: 0,
        expected_values: Array::zeroed(),
        expected_count: 0,
        appraisal_checks: Array::zeroed(),
        check_count: 0,
        policies: Array::zeroed(),
        policy_count: 0,
        attestation_sessions: Array::zeroed(),
        session_count: 0,
        measurement_enabled: true,
        appraisal_enabled: true,
        log_all_measurements: true,
        strict_appraisal: false,
    };
}

// ──────────────────────────────────────────────
// Main Entry Point
// ──────────────────────────────────────────────

fn main() -> IntegrityMeasurementState
    effect [ima:measure, ima:verify, ima:attest, ima:policy, compute, io:write, residual]
{
    let mut state: IntegrityMeasurementState = create_integrity_state();

    let policy_rule: IntegrityPolicyRule = IntegrityPolicyRule{
        rule_id: 1, name: Str::from("default_measure"),
        policy_type: IntegrityPolicyType::IMA,
        action: IntegrityAction::Measure,
        path_pattern: Str::from("/etc/**"),
        template_type: MeasurementTemplate::FlatHash,
        pcr_index: 0,
        required_signer: 0,
        recursive: true,
        enabled: true,
        audit_on_violation: true,
        priority: 100,
    };
    state = add_integrity_policy(state, policy_rule);

    let policy_appraise: IntegrityPolicyRule = IntegrityPolicyRule{
        rule_id: 2, name: Str::from("appraise_bin"),
        policy_type: IntegrityPolicyType::IMA,
        action: IntegrityAction::Appraise,
        path_pattern: Str::from("/usr/bin/**"),
        template_type: MeasurementTemplate::FlatHash,
        pcr_index: 1,
        required_signer: 1,
        recursive: true,
        enabled: true,
        audit_on_violation: true,
        priority: 200,
    };
    state = add_integrity_policy(state, policy_appraise);

    let bin_bash: Str(MAX_FILE_PATH_LEN) = Str::from("/usr/bin/bash");
    let bash_hash: Array(u8, MAX_HASH_DIGEST_SIZE) = Array::splat(0xAB);

    let ev: ExpectedValue = ExpectedValue{
        value_id: 1,
        file_path: bin_bash,
        expected_hash: bash_hash,
        hash_size: 32,
        expected_signer: 1,
        min_file_size: 1024,
        max_file_size: 1048576,
        template_type: MeasurementTemplate::FlatHash,
        critical: true,
        enabled: true,
        version: 1,
    };
    state = add_expected_value(state, ev);

    state = measure_file(
        state, bin_bash, bash_hash, 32, 1048576,
        MeasurementTemplate::FlatHash, MeasurementSource::FileExecute, 0,
    );

    let etc_config: Str(MAX_FILE_PATH_LEN) = Str::from("/etc/phorensic.conf");
    let config_hash: Array(u8, MAX_HASH_DIGEST_SIZE) = Array::splat(0xCD);
    state = measure_config(state, etc_config, config_hash, 32);

    let exec_path: Str(MAX_FILE_PATH_LEN) = Str::from("/usr/bin/sshd");
    let exec_hash: Array(u8, MAX_HASH_DIGEST_SIZE) = Array::splat(0xEF);
    state = measure_process_exec(
        state, exec_path, exec_hash, 32, 1, true,
    );

    let (appraised_state, appr_result): (IntegrityMeasurementState, AppraisalResult) = appraise_file(
        state, 1,
    );
    state = appraised_state;

    let pcr_selection: Array(u8, MAX_PCR_BANKS) = Array::splat(1);
    let mut sel: Array(u8, MAX_PCR_BANKS) = pcr_selection;
    sel[0] = 1;

    let (session_state, session): (IntegrityMeasurementState, AttestationSession) = create_attestation_session(
        state, 1, 1001, 1000, 12345, sel, 1,
    );
    state = session_state;

    let (attested_state, attested): (IntegrityMeasurementState, bool) = perform_attestation(state, 1);
    state = attested_state;

    assert(state.measurement_count >= 3, "integrity_measurement: files measured");
    assert(state.log_count >= 3, "integrity_measurement: log entries created");
    assert(state.expected_count >= 1, "integrity_measurement: expected values loaded");
    assert(state.policy_count >= 2, "integrity_measurement: policies added");

    residual emit {
        op: "integrity_measurement.init_complete",
        measurements: state.measurement_count,
        log_entries: state.log_count,
        expected_values: state.expected_count,
        policies: state.policy_count,
        appraisal_checks: state.check_count,
        attestation_sessions: state.session_count,
        pcr_banks: state.pcr_count,
    };

    return state;
}
