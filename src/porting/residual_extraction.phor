// ============================================================================
// residual_extraction.phor — Residual Extraction: Operation Vectors, Data
//                            Flow, Boundary Tracking
// ============================================================================
// Residual extraction structures all observed behavior into residual records.
// It builds operation vectors (sequence of all operations), data flow graphs
// (which operations depend on which), capability usage patterns, effect
// signatures, boundary transitions, and oracle deltas.
// ============================================================================

package "phorensic:residual_extraction:v1.0";

// ============================================================================
// Error Types
// ============================================================================

type ResidualExtractionError = enum {
    NoOperationsToExtract = 0x01,
    OperationVectorFull = 0x02,
    DataFlowGraphFull = 0x03,
    CapabilityPatternOverflow = 0x04,
    BoundaryTrackingOverflow = 0x05,
    OracleDeltaMismatch = 0x06,
    InconsistentState = 0x07,
    ExtractionLimitExceeded = 0x08,
    InternalError = 0xFF,
}

// ============================================================================
// Core Types
// ============================================================================

type Hash256 = struct {
    bytes: Array[u8, 32],
}

type FixedString[cap: u64] = struct {
    len: u64,
    data: Array[u8, cap],
}

// ============================================================================
// Operation Vector
// ============================================================================

type OperationVectorEntry = struct {
    vector_index: u64,
    operation_name: FixedString[128],
    operation_class: FixedString[64],
    argument_hash: Hash256,
    result_hash: Hash256,
    effect_set_hash: Hash256,
    timestamp: u64,
    sequence_number: u64,
}

type OperationVector = struct {
    entries: Array[OperationVectorEntry, 4096],
    entry_count: u64,
    sequence_hash: Hash256,
}

// ============================================================================
// Data Flow Edge
// ============================================================================

type DataFlowEdge = struct {
    edge_id: u64,
    source_op_index: u64,
    target_op_index: u64,
    dependency_type: DependencyType,
    data_hash: Hash256,
    is_control_dependency: bool,
    is_data_dependency: bool,
    weight: u64,
}

type DependencyType = enum {
    DataProduced = 0x01,
    DataConsumed = 0x02,
    ControlFlow = 0x03,
    CapabilityBorrow = 0x04,
    CapabilityTransfer = 0x05,
    EffectOrder = 0x06,
    MemoryRead = 0x07,
    MemoryWrite = 0x08,
    SyncPoint = 0x09,
    Unknown = 0xFF,
}

// ============================================================================
// Data Flow Graph
// ============================================================================

type DataFlowGraph = struct {
    edges: Array[DataFlowEdge, 8192],
    edge_count: u64,
    node_count: u64,
    entry_node: u64,
    exit_nodes: Array[u64, 256],
    exit_node_count: u64,
    graph_hash: Hash256,
    is_acyclic: bool,
}

// ============================================================================
// Capability Usage Pattern
// ============================================================================

type CapabilityUsagePattern = struct {
    capability_name: FixedString[128],
    first_used_at: u64,
    last_used_at: u64,
    use_count: u64,
    operations_using: Array[u64, 256],
    operation_count: u64,
    is_granted_externally: bool,
    is_required: bool,
}

// ============================================================================
// Effect Signature
// ============================================================================

type EffectSignature = struct {
    effect_name: FixedString[64],
    total_occurrences: u64,
    unique_operations: u64,
    first_observed_at: u64,
    last_observed_at: u64,
    observed_during: Array[u64, 512],
    observed_count: u64,
}

// ============================================================================
// Boundary Transition
// ============================================================================

type BoundaryTransition = struct {
    transition_index: u64,
    op_index: u64,
    boundary_type: BoundaryType,
    direction: BoundaryDirection,
    dialect_from: FixedString[64],
    dialect_to: FixedString[64],
    data_crossed_hash: Hash256,
    timestamp: u64,
}

type BoundaryType = enum {
    Dialect = 0x01,
    Capability = 0x02,
    Trust = 0x03,
    Effect = 0x04,
    Memory = 0x05,
    Process = 0x06,
    Network = 0x07,
    Unknown = 0xFF,
}

type BoundaryDirection = enum {
    Enter = 0x01,
    Exit = 0x02,
    Cross = 0x03,
    Unknown = 0xFF,
}

// ============================================================================
// Oracle Delta
// ============================================================================

type OracleDelta = struct {
    operation_name: FixedString[128],
    foreign_result_hash: Hash256,
    oracle_result_hash: Hash256,
    is_match: bool,
    divergence_severity: DivergenceSeverity,
    divergence_description: FixedString[512],
    test_case_id: u64,
}

type DivergenceSeverity = enum {
    Acceptable = 0x01,
    Minor = 0x02,
    Significant = 0x03,
    Critical = 0x04,
}

// ============================================================================
// Extraction Bundle
// ============================================================================

type ExtractionBundle = struct {
    bundle_id: Hash256,
    cage_id: Hash256,
    operation_vector: OperationVector,
    data_flow_graph: DataFlowGraph,
    capability_patterns: Array[CapabilityUsagePattern, 64],
    capability_count: u64,
    effect_signatures: Array[EffectSignature, 32],
    effect_count: u64,
    boundary_transitions: Array[BoundaryTransition, 512],
    boundary_count: u64,
    oracle_deltas: Array[OracleDelta, 256],
    oracle_delta_count: u64,
    extraction_timestamp: u64,
    bundle_hash: Hash256,
    is_sealed: bool,
}

// ============================================================================
// Create Empty Extraction Bundle
// ============================================================================

fn create_extraction_bundle(cage_id: Hash256) -> ExtractionBundle
    effects: [compute]
{
    let empty_vector: OperationVector = OperationVector {
        entries: Array[OperationVectorEntry, 4096]::zeroed(),
        entry_count: 0,
        sequence_hash: Hash256 { bytes: Array[u8, 32]::zeroed() },
    };

    let empty_graph: DataFlowGraph = DataFlowGraph {
        edges: Array[DataFlowEdge, 8192]::zeroed(),
        edge_count: 0,
        node_count: 0,
        entry_node: 0,
        exit_nodes: Array[u64, 256]::zeroed(),
        exit_node_count: 0,
        graph_hash: Hash256 { bytes: Array[u8, 32]::zeroed() },
        is_acyclic: true,
    };

    let empty_caps: Array[CapabilityUsagePattern, 64] = Array[CapabilityUsagePattern, 64]::zeroed();
    let empty_effects: Array[EffectSignature, 32] = Array[EffectSignature, 32]::zeroed();
    let empty_boundaries: Array[BoundaryTransition, 512] = Array[BoundaryTransition, 512]::zeroed();
    let empty_deltas: Array[OracleDelta, 256] = Array[OracleDelta, 256]::zeroed();
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };

    return ExtractionBundle {
        bundle_id: zero_hash,
        cage_id: cage_id,
        operation_vector: empty_vector,
        data_flow_graph: empty_graph,
        capability_patterns: empty_caps,
        capability_count: 0,
        effect_signatures: empty_effects,
        effect_count: 0,
        boundary_transitions: empty_boundaries,
        boundary_count: 0,
        oracle_deltas: empty_deltas,
        oracle_delta_count: 0,
        extraction_timestamp: kernel.tick_count(),
        bundle_hash: zero_hash,
        is_sealed: false,
    };
}

// ============================================================================
// Add Operation To Vector
// ============================================================================

fn add_to_operation_vector(bundle: &mut ExtractionBundle, op_name: &FixedString[128], op_class: &FixedString[64], args_hash: Hash256, result_hash: Hash256, effect_set_hash: Hash256) -> Result[u64, ResidualExtractionError]
    effects: [compute, residual]
{
    if bundle.operation_vector.entry_count >= 4096 {
        return Err(ResidualExtractionError::OperationVectorFull);
    }

    let idx: u64 = bundle.operation_vector.entry_count;

    let entry: OperationVectorEntry = OperationVectorEntry {
        vector_index: idx,
        operation_name: *op_name,
        operation_class: *op_class,
        argument_hash: args_hash,
        result_hash: result_hash,
        effect_set_hash: effect_set_hash,
        timestamp: kernel.tick_count(),
        sequence_number: idx,
    };

    bundle.operation_vector.entries[idx] = entry;
    bundle.operation_vector.entry_count = idx + 1;

    @emit_residual("residual_extraction.add_op", "operation_added_to_vector", idx);

    return Ok(idx);
}

// ============================================================================
// Add Data Flow Edge
// ============================================================================

fn add_data_flow_edge(bundle: &mut ExtractionBundle, source: u64, target: u64, dep_type: DependencyType, data_hash: Hash256, is_control: bool, is_data: bool) -> Result[u64, ResidualExtractionError]
    effects: [compute, residual]
{
    if bundle.data_flow_graph.edge_count >= 8192 {
        return Err(ResidualExtractionError::DataFlowGraphFull);
    }

    let edge_id: u64 = bundle.data_flow_graph.edge_count;

    let edge: DataFlowEdge = DataFlowEdge {
        edge_id: edge_id,
        source_op_index: source,
        target_op_index: target,
        dependency_type: dep_type,
        data_hash: data_hash,
        is_control_dependency: is_control,
        is_data_dependency: is_data,
        weight: 1,
    };

    bundle.data_flow_graph.edges[edge_id] = edge;
    bundle.data_flow_graph.edge_count = edge_id + 1;

    // Update node count
    let max_node: u64 = if source > target { source } else { target };
    if max_node + 1 > bundle.data_flow_graph.node_count {
        bundle.data_flow_graph.node_count = max_node + 1;
    }

    @emit_residual("residual_extraction.add_edge", "data_flow_edge_added", edge_id);

    return Ok(edge_id);
}

// ============================================================================
// Record Capability Pattern
// ============================================================================

fn record_capability_pattern(bundle: &mut ExtractionBundle, cap_name: &FixedString[128], op_index: u64) -> Result<u64, ResidualExtractionError>
    effects: [compute, residual]
{
    // Check if capability already tracked
    for i in 0..bundle.capability_count {
        if bundle.capability_patterns[i].capability_name == *cap_name {
            let idx: u64 = bundle.capability_patterns[i].operation_count;
            if idx < 256 {
                bundle.capability_patterns[i].operations_using[idx] = op_index;
                bundle.capability_patterns[i].operation_count = idx + 1;
                bundle.capability_patterns[i].use_count = bundle.capability_patterns[i].use_count + 1;
                bundle.capability_patterns[i].last_used_at = kernel.tick_count();
            }
            return Ok(i);
        }
    }

    if bundle.capability_count >= 64 {
        return Err(ResidualExtractionError::CapabilityPatternOverflow);
    }

    let idx: u64 = bundle.capability_count;
    let mut ops: Array[u64, 256] = Array[u64, 256]::zeroed();
    ops[0] = op_index;

    bundle.capability_patterns[idx] = CapabilityUsagePattern {
        capability_name: *cap_name,
        first_used_at: kernel.tick_count(),
        last_used_at: kernel.tick_count(),
        use_count: 1,
        operations_using: ops,
        operation_count: 1,
        is_granted_externally: false,
        is_required: true,
    };

    bundle.capability_count = idx + 1;

    @emit_residual("residual_extraction.cap_pattern", "capability_pattern_recorded", idx);

    return Ok(idx);
}

// ============================================================================
// Record Effect Signature
// ============================================================================

fn record_effect_signature(bundle: &mut ExtractionBundle, effect_name: &FixedString[64], op_index: u64) -> Result<u64, ResidualExtractionError>
    effects: [compute, residual]
{
    for i in 0..bundle.effect_count {
        if bundle.effect_signatures[i].effect_name == *effect_name {
            let idx: u64 = bundle.effect_signatures[i].observed_count;
            if idx < 512 {
                bundle.effect_signatures[i].observed_during[idx] = op_index;
                bundle.effect_signatures[i].observed_count = idx + 1;
                bundle.effect_signatures[i].total_occurrences = bundle.effect_signatures[i].total_occurrences + 1;
                bundle.effect_signatures[i].last_observed_at = kernel.tick_count();
            }
            return Ok(i);
        }
    }

    if bundle.effect_count >= 32 {
        return Err(ResidualExtractionError::ExtractionLimitExceeded);
    }

    let idx: u64 = bundle.effect_count;
    let mut ops: Array[u64, 512] = Array[u64, 512]::zeroed();
    ops[0] = op_index;

    bundle.effect_signatures[idx] = EffectSignature {
        effect_name: *effect_name,
        total_occurrences: 1,
        unique_operations: 1,
        first_observed_at: kernel.tick_count(),
        last_observed_at: kernel.tick_count(),
        observed_during: ops,
        observed_count: 1,
    };

    bundle.effect_count = idx + 1;

    return Ok(idx);
}

// ============================================================================
// Record Boundary Transition
// ============================================================================

fn record_boundary_transition(bundle: &mut ExtractionBundle, op_index: u64, boundary_type: BoundaryType, direction: BoundaryDirection, dialect_from: &FixedString[64], dialect_to: &FixedString[64], data_hash: Hash256) -> Result[u64, ResidualExtractionError]
    effects: [compute, residual]
{
    if bundle.boundary_count >= 512 {
        return Err(ResidualExtractionError::BoundaryTrackingOverflow);
    }

    let idx: u64 = bundle.boundary_count;

    bundle.boundary_transitions[idx] = BoundaryTransition {
        transition_index: idx,
        op_index: op_index,
        boundary_type: boundary_type,
        direction: direction,
        dialect_from: *dialect_from,
        dialect_to: *dialect_to,
        data_crossed_hash: data_hash,
        timestamp: kernel.tick_count(),
    };

    bundle.boundary_count = idx + 1;

    @emit_residual("residual_extraction.boundary", "boundary_transition_recorded", idx);

    return Ok(idx);
}

// ============================================================================
// Record Oracle Delta
// ============================================================================

fn record_oracle_delta(bundle: &mut ExtractionBundle, op_name: &FixedString[128], foreign_hash: Hash256, oracle_hash: Hash256, severity: DivergenceSeverity, desc: &FixedString[512], test_case_id: u64) -> Result[u64, ResidualExtractionError]
    effects: [compute, residual]
{
    if bundle.oracle_delta_count >= 256 {
        return Err(ResidualExtractionError::ExtractionLimitExceeded);
    }

    let idx: u64 = bundle.oracle_delta_count;
    let is_match: bool = foreign_hash == oracle_hash;

    bundle.oracle_deltas[idx] = OracleDelta {
        operation_name: *op_name,
        foreign_result_hash: foreign_hash,
        oracle_result_hash: oracle_hash,
        is_match: is_match,
        divergence_severity: if is_match { DivergenceSeverity::Acceptable } else { severity },
        divergence_description: *desc,
        test_case_id: test_case_id,
    };

    bundle.oracle_delta_count = idx + 1;

    @emit_residual("residual_extraction.oracle_delta", "oracle_delta_recorded", idx);

    return Ok(idx);
}

// ============================================================================
// Compute Data Flow Subgraph
// ============================================================================
// Extracts the subgraph of operations that flow into or out of a given
// operation.

fn compute_subgraph(bundle: &ExtractionBundle, center_op: u64, max_depth: u64) -> Result[Array[u64, 4096], ResidualExtractionError]
    effects: [compute]
{
    let mut nodes: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let mut node_count: u64 = 0;
    let mut current_depth: u64 = 0;
    let mut queue: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let mut queue_head: u64 = 0;
    let mut queue_tail: u64 = 0;
    let mut visited: Array[bool, 4096] = Array[bool, 4096]::zeroed();

    // BFS to find connected nodes
    queue[queue_tail] = center_op;
    queue_tail = queue_tail + 1;
    visited[center_op] = true;

    while queue_head < queue_tail && current_depth < max_depth {
        let current: u64 = queue[queue_head];
        queue_head = queue_head + 1;

        if node_count < 4096 {
            nodes[node_count] = current;
            node_count = node_count + 1;
        }

        // Find edges connected to this node
        for i in 0..bundle.data_flow_graph.edge_count {
            let edge: DataFlowEdge = bundle.data_flow_graph.edges[i];
            let neighbor: u64;

            if edge.source_op_index == current && !visited[edge.target_op_index] {
                neighbor = edge.target_op_index;
            } elif edge.target_op_index == current && !visited[edge.source_op_index] {
                neighbor = edge.source_op_index;
            } else {
                continue;
            }

            visited[neighbor] = true;
            if queue_tail < 4096 {
                queue[queue_tail] = neighbor;
                queue_tail = queue_tail + 1;
            }
        }

        current_depth = current_depth + 1;
    }

    return Ok(nodes);
}

// ============================================================================
// Compute Topological Ordering
// ============================================================================
// Produces a topological ordering of the data flow graph nodes.

fn compute_topological_order(bundle: &ExtractionBundle) -> Result[Array[u64, 4096], ResidualExtractionError]
    effects: [compute]
{
    let mut order: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let mut order_count: u64 = 0;
    let mut in_degree: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let mut queue: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let mut queue_head: u64 = 0;
    let mut queue_tail: u64 = 0;

    // Compute in-degree for each node
    let node_limit: u64 = if bundle.data_flow_graph.node_count < 4096 { bundle.data_flow_graph.node_count } else { 4096 };

    for i in 0..bundle.data_flow_graph.edge_count {
        let target: u64 = bundle.data_flow_graph.edges[i].target_op_index;
        if target < 4096 {
            in_degree[target] = in_degree[target] + 1;
        }
    }

    // Add nodes with in-degree 0 to queue
    for i in 0..node_limit {
        if in_degree[i] == 0 {
            if queue_tail < 4096 {
                queue[queue_tail] = i;
                queue_tail = queue_tail + 1;
            }
        }
    }

    // Process queue
    while queue_head < queue_tail {
        let current: u64 = queue[queue_head];
        queue_head = queue_head + 1;

        if order_count < 4096 {
            order[order_count] = current;
            order_count = order_count + 1;
        }

        // Decrease in-degree of neighbors
        for i in 0..bundle.data_flow_graph.edge_count {
            if bundle.data_flow_graph.edges[i].source_op_index == current {
                let target: u64 = bundle.data_flow_graph.edges[i].target_op_index;
                if target < 4096 {
                    in_degree[target] = if in_degree[target] > 0 { in_degree[target] - 1 } else { 0 };
                    if in_degree[target] == 0 {
                        if queue_tail < 4096 {
                            queue[queue_tail] = target;
                            queue_tail = queue_tail + 1;
                        }
                    }
                }
            }
        }
    }

    return Ok(order);
}

// ============================================================================
// Compute Bundle Hash
// ============================================================================

fn compute_bundle_hash(bundle: &mut ExtractionBundle) -> Hash256
    effects: [compute]
{
    let zero_hash: Hash256 = Hash256 { bytes: Array[u8, 32]::zeroed() };
    let mut hash: Hash256 = zero_hash;

    // Hash operation vector count
    let op_count_bytes: Array[u8, 8] = u64_to_bytes(bundle.operation_vector.entry_count);
    for i in 0..8 {
        hash.bytes[i] = hash.bytes[i] ^ op_count_bytes[i];
    }

    // Hash edge count
    let edge_count_bytes: Array[u8, 8] = u64_to_bytes(bundle.data_flow_graph.edge_count);
    for i in 0..8 {
        hash.bytes[i + 8] = hash.bytes[i + 8] ^ edge_count_bytes[i];
    }

    // Hash capability count
    let cap_count_bytes: Array[u8, 8] = u64_to_bytes(bundle.capability_count);
    for i in 0..8 {
        hash.bytes[i + 16] = hash.bytes[i + 16] ^ cap_count_bytes[i];
    }

    // Hash boundary count
    let boundary_count_bytes: Array[u8, 8] = u64_to_bytes(bundle.boundary_count);
    for i in 0..8 {
        hash.bytes[i + 24] = hash.bytes[i + 24] ^ boundary_count_bytes[i];
    }

    bundle.bundle_hash = hash;
    return hash;
}

// ============================================================================
// Seal Extraction Bundle
// ============================================================================

fn seal_extraction_bundle(bundle: &mut ExtractionBundle) -> Result[Hash256, ResidualExtractionError]
    effects: [compute, residual]
{
    if bundle.is_sealed {
        return Err(ResidualExtractionError::InconsistentState);
    }

    let hash: Hash256 = compute_bundle_hash(bundle);
    bundle.is_sealed = true;

    @emit_residual("residual_extraction.seal", "bundle_sealed", hash);

    return Ok(hash);
}

// ============================================================================
// Get Bundle Summary
// ============================================================================

type ExtractionBundleSummary = struct {
    operation_count: u64,
    edge_count: u64,
    node_count: u64,
    capability_pattern_count: u64,
    effect_signature_count: u64,
    boundary_transition_count: u64,
    oracle_delta_count: u64,
    total_divergences: u64,
    is_acyclic: bool,
    bundle_hash: Hash256,
    is_sealed: bool,
}

fn get_bundle_summary(bundle: &ExtractionBundle) -> ExtractionBundleSummary
    effects: [compute]
{
    let mut divergences: u64 = 0;
    for i in 0..bundle.oracle_delta_count {
        if !bundle.oracle_deltas[i].is_match {
            divergences = divergences + 1;
        }
    }

    return ExtractionBundleSummary {
        operation_count: bundle.operation_vector.entry_count,
        edge_count: bundle.data_flow_graph.edge_count,
        node_count: bundle.data_flow_graph.node_count,
        capability_pattern_count: bundle.capability_count,
        effect_signature_count: bundle.effect_count,
        boundary_transition_count: bundle.boundary_count,
        oracle_delta_count: bundle.oracle_delta_count,
        total_divergences: divergences,
        is_acyclic: bundle.data_flow_graph.is_acyclic,
        bundle_hash: bundle.bundle_hash,
        is_sealed: bundle.is_sealed,
    };
}

// ============================================================================
// Helper: u64 to Bytes
// ============================================================================

fn u64_to_bytes(val: u64) -> Array[u8, 8]
    effects: [compute]
{
    let mut result: Array[u8, 8] = Array[u8, 8]::zeroed();
    let mut tmp: u64 = val;
    for i in 0..8 {
        result[i] = (tmp & 0xFF) as u8;
        tmp = tmp >> 8;
    }
    return result;
}

// ============================================================================
// Find Critical Path in Data Flow Graph
// ============================================================================
// Identifies the longest dependency chain in the data flow graph.

type CriticalPathInfo = struct {
    path_length: u64,
    path_nodes: Array[u64, 4096],
    node_count: u64,
    total_weight: u64,
    entry_node: u64,
    exit_node: u64,
}

fn find_critical_path(bundle: &ExtractionBundle) -> CriticalPathInfo
    effects: [compute]
{
    let mut max_len: u64 = 0;
    let mut critical_nodes: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let mut node_count: u64 = 0;
    let mut total_weight: u64 = 0;
    let mut entry: u64 = 0;
    let mut exit: u64 = 0;

    // Compute longest path using DP on topological order
    let order: Array[u64, 4096] = compute_topological_order(bundle)?;
    let order_count: u64 = bundle.data_flow_graph.node_count;
    let mut dist: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let mut prev: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    let max_u64: u64 = 18446744073709551615;

    for i in 0..order_count {
        let u: u64 = order[i];
        for j in 0..bundle.data_flow_graph.edge_count {
            if bundle.data_flow_graph.edges[j].source_op_index == u {
                let v: u64 = bundle.data_flow_graph.edges[j].target_op_index;
                let w: u64 = bundle.data_flow_graph.edges[j].weight;
                if dist[u] + w > dist[v] {
                    dist[v] = dist[u] + w;
                    prev[v] = u;
                }
            }
        }
    }

    // Find max distance node
    for i in 0..order_count {
        if dist[i] > max_len {
            max_len = dist[i];
            exit = i;
        }
    }

    // Trace back to build path
    let mut current: u64 = exit;
    while current != 0 && node_count < 4096 {
        critical_nodes[node_count] = current;
        node_count = node_count + 1;
        current = prev[current];
    }
    if node_count < 4096 {
        critical_nodes[node_count] = current;
        node_count = node_count + 1;
        entry = current;
    }

    // Reverse to get entry→exit order
    let mut reversed: Array[u64, 4096] = Array[u64, 4096]::zeroed();
    for i in 0..node_count {
        reversed[i] = critical_nodes[node_count - 1 - i];
    }

    for i in 0..node_count {
        total_weight = total_weight + dist[reversed[i]];
        critical_nodes[i] = reversed[i];
    }

    return CriticalPathInfo {
        path_length: max_len,
        path_nodes: critical_nodes,
        node_count: node_count,
        total_weight: total_weight,
        entry_node: entry,
        exit_node: exit,
    };
}

// ============================================================================
// Merge Two Extraction Bundles
// ============================================================================

fn merge_extraction_bundles(dest: &mut ExtractionBundle, src: &ExtractionBundle) -> Result[Hash256, ResidualExtractionError]
    effects: [compute, residual]
{
    // Merge operation vectors
    let src_op_count: u64 = src.operation_vector.entry_count;
    for i in 0..src_op_count {
        if dest.operation_vector.entry_count >= 4096 {
            return Err(ResidualExtractionError::OperationVectorFull);
        }
        dest.operation_vector.entries[dest.operation_vector.entry_count] = src.operation_vector.entries[i];
        dest.operation_vector.entry_count = dest.operation_vector.entry_count + 1;
    }

    // Merge data flow edges
    let src_edge_count: u64 = src.data_flow_graph.edge_count;
    for i in 0..src_edge_count {
        if dest.data_flow_graph.edge_count >= 8192 {
            return Err(ResidualExtractionError::DataFlowGraphFull);
        }
        dest.data_flow_graph.edges[dest.data_flow_graph.edge_count] = src.data_flow_graph.edges[i];
        dest.data_flow_graph.edge_count = dest.data_flow_graph.edge_count + 1;
    }

    // Merge capability patterns
    for i in 0..src.capability_count {
        if dest.capability_count >= 64 {
            return Err(ResidualExtractionError::CapabilityPatternOverflow);
        }
        dest.capability_patterns[dest.capability_count] = src.capability_patterns[i];
        dest.capability_count = dest.capability_count + 1;
    }

    // Merge boundary transitions
    for i in 0..src.boundary_count {
        if dest.boundary_count >= 512 {
            return Err(ResidualExtractionError::BoundaryTrackingOverflow);
        }
        dest.boundary_transitions[dest.boundary_count] = src.boundary_transitions[i];
        dest.boundary_count = dest.boundary_count + 1;
    }

    // Recompute bundle hash
    let hash: Hash256 = compute_bundle_hash(dest);

    @emit_residual("residual_extraction.merge", "bundles_merged", hash);

    return Ok(hash);
}
